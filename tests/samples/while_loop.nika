// Kap 3.3: the `while` loop, which Part I documents with this shape.
fn countdown(start: i32) -> i32 {
    let mut n = start
    let mut steps = 0
    while n > 0 {
        n = n - 1
        steps += 1
    }
    return steps
}

fn main() throws {
    let mut seen = 0
    // Nested, and with a `for` inside it - the two loops are statements of the
    // same kind and neither is an expression.
    while seen < 3 {
        for k in 0..<2 { seen += 1 }
    }
    println(f"{countdown(5)} {seen}")
}
