fn longest(a: String, b: String) -> String {
    if a.len() >= b.len() {
        return a
    }
    return b
}

fn main() {
    let t = f"t{1}"
    for n in 0..<3 {
        let r = longest(if n == 0 { "lit" } else { f"n{n}" }, "ab")
        println(r)
        let q = longest(t, "abcdefg")
        println(q)
    }
}
