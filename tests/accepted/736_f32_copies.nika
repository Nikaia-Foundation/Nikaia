// #736: an `f32` is copied as an `f64` is: bound again, handed to a
// parameter twice, read out of a field, an option and a list.

struct Box2 {
    w: f32,
}

fn twice(v: f32) -> f32 {
    return v * 2.0
}

fn main() {
    let a: f32 = 0.5
    let b = a
    let s = Box2 { w: a }
    let w = s.w
    let o: f32? = 1.5
    if o != null {
        println(f"{o + 1.0}")
    }
    let xs: Vec[f32] = [a, b, w]
    let first = xs[0]
    println(f"{a} {b} {s.w} {w} {twice(a)} {twice(a)} {first} {xs.len()}")
}
