// #704 item 7: a fold's start written as a value - a struct literal, a
// number - is the accumulator's first value, not a function to call.
grammar Lines {
    @frame(boundary: "\n")
    rule LINE -> i64 = d:dec[i64](digit+) frame_end { d }
    entry rule file -> Tally = fold(LINE, Tally { lines: 0, total: 0 }, fn(acc, n) { acc.lines += 1
        acc.total += n })
}

grammar Sums {
    rule N -> i64 = d:dec[i64](digit+) "\n" { d }
    entry rule file -> i64 = fold(N, 10, fn(acc, n) { acc + n })
}

struct Tally {
    lines: i64,
    total: i64,
}

fn main() {
    let t = Lines::file("1\n2\n") catch {
        return
    }
    println(f"{t.lines} {t.total}")
    let s = Sums::file("3\n4\n") catch {
        return
    }
    println(f"{s}")
}
