// #686: the same with an untyped `let`.

struct L {
    from: String?,
}

fn word(n: i64) -> String {
    return f"w{n}"
}

fn main() {
    let mut l = L { from: null }
    for i in 0..<3 {
        if i >= 1 {
            let key = word(i)
            l.from = key
        }
    }
    println(l.from ?? "-")
}
