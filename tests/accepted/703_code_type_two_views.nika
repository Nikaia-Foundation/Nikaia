// A function type handing back a view of one of two views (#703).
fn pick(f: fn(a: String, b: String) -> String from a | b sync, a: String, b: String) -> i64 {
    return f(a, b).len()
}

fn longer(a: String, b: String) -> String {
    if a.len() >= b.len() {
        return a
    }
    return b
}

fn main() throws {
    println(f"{pick(fn(a, _) { a }, "one", "three")}")
    println(f"{pick(longer, "one", "three")}")
}
