// #694: `a[k] ?? b[k] ?? return x` over maps in fields of a parameter, with
// a value type that is not a copy; the key in the first map, in the second, in neither.

use std::collections

struct E {
    n: i64,
    tags: Vec[String],
}

struct L {
    types: collections::BTreeMap[String, E],
}

struct Ask {
    own: L,
    library: L,
}

fn either(ask: Ask, name: String) -> i64 {
    let found = ask.own.types[name] ?? ask.library.types[name] ?? return -1
    return found.n * 10 + found.tags.len()
}

fn main() {
    let mut a: collections::BTreeMap[String, E] = collections::BTreeMap()
    a.insert("j", E { n: 4, tags: ["j"] })
    let mut b: collections::BTreeMap[String, E] = collections::BTreeMap()
    b.insert("k", E { n: 3, tags: ["k", "k2"] })
    let ask = Ask { own: L { types: a }, library: L { types: b } }
    let k = f"k"
    println(f"{either(ask, "j")} {either(ask, k)} {either(ask, "z")} {ask.own.types.len()}")
}
