// #721: a `catch` handles every error that arrives at it, also one from a
// call inside the expression it guards: an argument, a receiver, an operand.
enum Low { Bad(i64) }
impl Error for Low { fn message(ref self) -> String { return "low" } }

enum High { Empty }
impl Error for High { fn message(ref self) -> String { return "high" } }

struct Box2 { n: i64 }

impl Box2 {
    fn word(ref self) -> String throws {
        if self.n < 0 { throw Low::Bad(self.n) }
        return "word"
    }
}

fn f(n: i64) -> String throws {
    if n < 0 { throw Low::Bad(n) }
    if n == 0 { return "" }
    return "abc"
}

fn g(s: String) -> i64 throws {
    if s.len() == 0 { throw High::Empty }
    return s.len()
}

fn run(n: i64) -> i64 {
    let a = g(f(n)) catch {
        match error {
            Low::Bad(k) => {
                println(f"low {k}")
                return -1
            }
            High::Empty => {
                println("empty")
                return -2
            }
        }
    }
    return a
}

fn quiet(n: i64) {
    let a = g(f(n)) catch {
        println("caught")
        return
    }
    println(f"quiet {a}")
}

fn main() throws {
    quiet(1)
    quiet(-1)
    println(f"{run(1)}")
    println(f"{run(-5)}")
    println(f"{run(0)}")
    let b = Box2 { n: -1 }
    let c = g(b.word()) catch {
        println(f"method: {error}")
        7
    }
    println(f"{c}")
    let d = g(f(-1) catch { "inner" }) catch { 0 }
    println(f"{d}")
    let e = g(f(2) + f(3)) catch { 0 }
    println(f"{e}")
}
