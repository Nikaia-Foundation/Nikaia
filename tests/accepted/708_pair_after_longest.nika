// #708: Part I 6.5's `pair` lends `part` though its result keeps it: `r`,
// a view of `part` too, is read after `pair` is called.

struct Pair { left: String, right: String }

fn pair(a: String, b: String) -> Pair {
    return Pair { left: a, right: b }
}

fn longest(a: String, b: String) -> String {
    if a.len() >= b.len() {
        return a
    }
    return b
}

fn main() {
    let part = f"p{1}"
    let owned = f"own{2}"
    let r = longest(part, owned)
    let p = pair(part, "lit")
    println(f"{r} {p.left} {p.right}")
}
