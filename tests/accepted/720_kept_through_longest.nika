// #720: `longest` keeps `a` (a literal flows into its result beside it), so
// `show` keeps `s` and hands it on; no `ref` is written anywhere.

fn longest(keep a: String, keep b: String) -> String {
    if a.len() >= b.len() { return a }
    return b
}

fn show(keep s: String) {
    let r = longest(s, "ab")
    println(r)
}

fn main() {
    show(f"base{1}")
}
