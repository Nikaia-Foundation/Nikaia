// #694: `a[k] ?? b[k] ?? return x` over maps handed as parameters, with a
// value type that is not a copy; the key in the first map, in the second, in neither.

use std::collections

struct E {
    n: i64,
    tags: Vec[String],
}

fn either(a: collections::BTreeMap[String, E], b: collections::BTreeMap[String, E], name: String) -> i64 {
    let found = a[name] ?? b[name] ?? return -1
    return found.n * 10 + found.tags.len()
}

fn main() {
    let mut a: collections::BTreeMap[String, E] = collections::BTreeMap()
    a.insert("j", E { n: 4, tags: ["j"] })
    let mut b: collections::BTreeMap[String, E] = collections::BTreeMap()
    b.insert("k", E { n: 3, tags: ["k", "k2"] })
    let k = f"k"
    println(f"{either(a, b, "j")} {either(a, b, k)} {either(a, b, "z")} {a.len()} {b.len()}")
}
