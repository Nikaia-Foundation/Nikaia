// #706: views of a parameter pushed into a `mut` parameter's list (ADR-283
// D27). The argument made in the call lives in the caller's keep.

fn words(s: String, mut v: Vec[String]) {
    for w in s.split(" ") {
        v.push(w)
    }
}

fn main() {
    let mut v: Vec[String] = []
    words(f"a b {1}", v)
    println(v.len())
    for w in v {
        println(w)
    }
}
