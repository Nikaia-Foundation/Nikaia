// #707: `drain` on a `mut` parameter that is a map: Rust's `drain()` takes no range.

use std::collections

fn take(mut m: collections::HashMap[String, i64]) -> i64 {
    let mut n = 0
    for (k, v) in m.drain() {
        n += k.len() + v
    }
    return n + m.len()
}

fn main() {
    let mut m: collections::HashMap[String, i64] = collections::HashMap()
    m.insert(f"x{1}", 3)
    println(f"{take(m)} {m.len()}")
}
