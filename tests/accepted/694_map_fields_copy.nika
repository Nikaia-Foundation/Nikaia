// #694: `a[k] ?? b[k] ?? return x` over maps in fields of a parameter, with
// a value type that is a copy; the key in the first map, in the second, in neither.

use std::collections


struct L {
    types: collections::BTreeMap[String, i64],
}

struct Ask {
    own: L,
    library: L,
}

fn either(ask: Ask, name: String) -> i64 {
    let found = ask.own.types[name] ?? ask.library.types[name] ?? return -1
    return found
}

fn main() {
    let mut a: collections::BTreeMap[String, i64] = collections::BTreeMap()
    a.insert("j", 4)
    let mut b: collections::BTreeMap[String, i64] = collections::BTreeMap()
    b.insert("k", 3)
    let ask = Ask { own: L { types: a }, library: L { types: b } }
    let k = f"k"
    println(f"{either(ask, "j")} {either(ask, k)} {either(ask, "z")} {ask.own.types.len()}")
}
