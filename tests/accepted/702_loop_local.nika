// #702: a loop local's `tag(v)` pushed into a list outside the loop.

struct Tag {
    label: String,
}

struct Box {
    items: Vec[Tag],
}

fn tag(s: String) -> Tag {
    return Tag { label: s }
}

fn show(b: Box) -> String {
    let mut out = f"{b.items.len()}"
    for t in b.items {
        out = f"{out} {t.label}"
    }
    return out
}

fn main() {
    let mut b = Box { items: [] }
    for i in 0..<3 {
        let v = f"x{i}"
        b.items.push(tag(v))
    }
    println(show(b))
}
