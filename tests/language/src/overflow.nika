// Arithmetic that says what happens at the edge (ADR-285, ADR-315): wrapping,
// saturating and counted lengths, as the numbers a program computes. What
// aborts, what the manifest and the lowering say, and what the shipping build
// does is `crates/nikaia/tests/overflow.rs`.

// **Wrapping and saturating arithmetic, run.**
//
// ADR-285 D6 and D7. These exist because D1 aborts: a hash function wraps on
// purpose and has to be able to say so. Run rather than read, because what is
// under test is a number and not a spelling - and the pair with the plain `*`
// in `overflow.rs` is the whole point, since the same arithmetic two ways must
// give two answers.
fn overflow_hash(seed: i32, c: i32) -> i32 {
    return seed.wrapping_mul(31).wrapping_add(c)
}

fn overflow_clamp(level: i32, rise: i32) -> i32 {
    return level.saturating_add(rise)
}

fn overflow_shifted(n: i64) -> i64 {
    return n.wrapping_shl(2)
}

test "wrapping and saturating say what the operator would refuse" {
    let wrapped = overflow_hash(2147483647, 7)
    let saturated = overflow_clamp(2147483647, 5)
    let shifted = overflow_shifted(3)
    assert(wrapped == 2147483624)
    assert(saturated == 2147483647)
    assert(shifted == 12)
}

// **A length is an `i64` and an index takes one, and neither conversion is
// written** (ADR-285 D1).
//
// The program below is the shape D1 is about: a loop over a length, an index by
// the loop variable, a length in arithmetic and a length in a comparison. Before
// this, every one of those lines carried an `as i64` the user wrote and that
// could not fail.
test "a length is an i64 and the conversions are emitted" {
    let mut xs = Vec()
    xs.push(10)
    xs.push(20)
    xs.push(30)
    let mut sum = 0
    for i in 0..<xs.len() {
        sum = sum + xs[i]
    }
    let last = xs[xs.len() - 1]
    let short = xs.len() < 2
    let fits = 1 + xs.len() < 5
    let printed = f"{sum} {last} {short} {fits} {xs.len()}"
    assert(printed == "60 30 false true 3")
}

// **A count goes in as an `i64` and the conversion is emitted** (ADR-285 D15)
// — the parameter direction of ADR-285 D1: the user writes **no** conversion,
// and a **literal** count is left alone.
test "a count is written as an i64 and the conversion is emitted" {
    let indent: i64 = 2
    let pad = "  ".repeat(indent)
    let rule = "-".repeat(3)
    let printed = f"[{pad}][{rule}]"
    assert(printed == "[    ][---]")
}

// **A named method on a number written as its receiver** (#417): the number
// takes the integer type its use asks for - a `let`'s, a parameter's, a
// `return`'s - as `7 + 1` would, and the first type that holds it where
// nothing asks; a negative one keeps its sign. `(-7).wrapping_add(2)` came out
// as `-7.wrapping_add(2)`, which is `-(7.wrapping_add(2))` below, and the
// function was taken to pause on a method of nothing known.
fn overflow_f() -> i32 {
    return (-7).wrapping_add(2)
}

fn overflow_g() -> i64 {
    return 7.wrapping_mul(3)
}

fn overflow_h(n: u64) -> u64 {
    return n + 1
}

test "a named method on a written number takes the type its use asks" {
    let x: i64 = 7.wrapping_add(1)
    let printed = f"{overflow_f()} {overflow_g()} {x} {overflow_h(5.saturating_add(1))} {7.checked_mul(3) ?? 0}"
    assert(printed == "-5 21 8 7 21")
}

// **The same bits, read with the other sign** (ADR-285 D42): `bits_as_` keeps
// every bit, so a number both types hold keeps its value and any other comes
// out on the other side of zero.
fn overflow_word(x: u32) -> i32 {
    return x.bits_as_i32()
}

fn overflow_key(x: i64) -> u64 {
    return x.bits_as_u64()
}

test "bits_as reads the same bits with the other sign" {
    let big: u32 = 4000000000
    assert(overflow_word(big) == -294967296)
    assert(overflow_key(-1 as i64) == 18446744073709551615)
    assert(overflow_word(big).bits_as_u32() == big)
    let small: u32 = 7
    assert(small.bits_as_i32() == 7)
    let hash: u64 = 18446744073709551615
    assert(hash.bits_as_i64() == -1)
}

// **`truncating_` only narrows** (ADR-285 D42): out of a wider integer of
// either sign, and out of an `f64` toward zero and clamped.
fn overflow_low(x: u64) -> i32 {
    return x.truncating_i32()
}

fn overflow_floored(x: f64) -> u32 {
    return x.truncating_u32()
}

fn overflow_floored_wide(x: f64) -> u64 {
    return x.truncating_u64()
}

test "truncating keeps the low digits and clamps a float" {
    assert(overflow_low(4294967297) == 1)
    assert(overflow_low(4294967295) == -1)
    assert(overflow_floored(-1.5) == 0)
    assert(overflow_floored(1e20) == 4294967295)
    assert(overflow_floored(7.9) == 7)
    assert(overflow_floored_wide(-3.0) == 0)
    assert(overflow_floored_wide(12.5) == 12)
}

// **`u8` has every name the other widths have** (ADR-285 D41).
fn overflow_digit(c: u8) -> u8 {
    return c.wrapping_sub(48)
}

test "u8 wraps, stops and asks as the other widths do" {
    let c: u8 = 55
    assert(c.wrapping_sub(48) == 7)
    assert(overflow_digit(c) == 7)
    assert((3 as u8).wrapping_sub(5) == 254)
    assert((200 as u8).wrapping_add(100) == 44)
    assert((16 as u8).wrapping_mul(17) == 16)
    assert((250 as u8).saturating_add(10) == 255)
    assert((3 as u8).saturating_sub(5) == 0)
    assert((250 as u8).checked_add(10) == null)
    assert(((250 as u8).checked_add(5) ?? 0) == 255)
    assert((7 as u8).checked_div(0) == null)
}

test "truncating_u8 and checked_u8 convert into a byte" {
    assert(300.truncating_u8() == 44)
    assert(300.checked_u8() == null)
    assert((200.checked_u8() ?? 0) == 200)
    assert((-1.5).truncating_u8() == 0)
    let big: u64 = 513
    assert(big.truncating_u8() == 1)
    assert(big.checked_u8() == null)
    let n: i64 = -1
    assert(n.truncating_u8() == 255)
}
