// `a + b` where one side is text (ADR-081): every shape a program can write
// concatenates. What a `+` lowers to and what the checker says is
// `crates/nikaia/tests/concatenation.rs`.

// All four shapes, run. Three of them did not compile at all.
test "every shape concatenates and prints" {
    let s = "left-"
    let t = "right"
    let u = "p"
    let v = "q"

    let both_literals = "x" + "y"
    let literal_left = "x" + t
    let literal_right = s + "y"
    let neither = u + v
    assert(both_literals == "xy")
    assert(literal_left == "xright")
    assert(literal_right == "left-y")
    assert(neither == "pq")
}
