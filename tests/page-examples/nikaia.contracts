# AUTO-GENERATED by `nikaia`. Commit this file like a lockfile.
# Do not edit by hand - it is regenerated on every build.
#
# What a caller has to know about a function it cannot see the body of:
# whether it may pause (`sync`), whether it may fail and with what
# (`throws`), and what its result may point into (`returns`). Part III, 13.5.
#
# A `"?"` among the errors is the absence of a claim: it fails, with
# something this compiler cannot name.
version = 4

[fn."an_item"]
sync = "inferred"
touches = []
views = ["line: borrowed"]
signature = "(line: ref String) -> bool"

[fn."codes_in"]
sync = "inferred"
touches = []
views = ["said: borrowed"]
signature = "(said: String) -> Vec[String]"

[fn."examples_under"]
throws = ["io::IoError"]
views = ["dir: borrowed"]
signature = "(dir: String) -> Vec[Block]"

[fn."fenced"]
sync = "inferred"
touches = []
views = ["page: borrowed", "text: borrowed"]
signature = "(page: String, text: String) -> Vec[Block]"

[fn."is_a_sketch"]
sync = "inferred"
touches = []
views = ["code: borrowed"]
signature = "(code: String) -> bool"

[fn."main"]
throws = ["?", "io::IoError"]
locks = true
signature = "()"

[fn."opening"]
sync = "inferred"
touches = []
views = ["code: borrowed"]
signature = "(code: String) -> String"

[fn."reach"]
throws = ["io::IoError"]
views = ["dir: borrowed", "source: borrowed"]
signature = "(dir: String, root: fs::Root, source: String) -> Reached"

[fn."readings"]
sync = "inferred"
touches = []
views = ["code: borrowed"]
signature = "(code: String) -> Vec[Reading]"

[fn."report"]
throws = ["?", "io::IoError"]
locks = "?"
signature = "() -> String"

[fn."split_at_the_first_statement"]
sync = "inferred"
touches = []
views = ["code: borrowed"]
signature = "(code: String) -> Vec[String]"

[fn."tagged"]
sync = "inferred"
touches = []
views = ["page: borrowed", "text: borrowed"]
signature = "(page: String, text: String) -> Vec[Block]"

[fn."unescaped"]
sync = "inferred"
touches = []
views = ["html: borrowed"]
signature = "(html: String) -> String"

[fn."word"]
sync = "inferred"
touches = []
signature = "(stage: i64) -> ref String"

[fn."wrapped"]
sync = "inferred"
touches = []
views = ["body: borrowed"]
signature = "(body: String) -> String"

[type."Block"]
fields = ["page: String", "code: String", "sketch: bool"]

[type."Reached"]
fields = ["stage: i64", "codes: Vec[String]"]

[type."Reading"]
fields = ["name: ref String", "source: String"]
