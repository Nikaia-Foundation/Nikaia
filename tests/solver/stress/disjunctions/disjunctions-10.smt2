(set-logic QF_LIA)
(set-info :status unsat)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(declare-const x4 Int)
(declare-const x5 Int)
(declare-const x6 Int)
(declare-const x7 Int)
(declare-const x8 Int)
(declare-const x9 Int)
(declare-const x10 Int)
(declare-const i Int)
(declare-const k Int)
(assert (or (= x1 0) (= x1 1)))
(assert (or (= x2 0) (= x2 1)))
(assert (or (= x3 0) (= x3 1)))
(assert (or (= x4 0) (= x4 1)))
(assert (or (= x5 0) (= x5 1)))
(assert (or (= x6 0) (= x6 1)))
(assert (or (= x7 0) (= x7 1)))
(assert (or (= x8 0) (= x8 1)))
(assert (or (= x9 0) (= x9 1)))
(assert (or (= x10 0) (= x10 1)))
(assert (<= 0 i))
(assert (< i k))
(assert (not (< i (+ k 1))))
(check-sat)
(exit)
