(set-logic QF_LIA)
(set-info :status sat)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(declare-const x4 Int)
(declare-const x5 Int)
(declare-const x6 Int)
(declare-const x7 Int)
(declare-const i Int)
(declare-const k Int)
(assert (or (= x1 0) (= x1 1)))
(assert (or (= x2 0) (= x2 1)))
(assert (or (= x3 0) (= x3 1)))
(assert (or (= x4 0) (= x4 1)))
(assert (or (= x5 0) (= x5 1)))
(assert (or (= x6 0) (= x6 1)))
(assert (or (= x7 0) (= x7 1)))
(assert (<= 0 i))
(assert (< i k))
(check-sat)
(exit)
