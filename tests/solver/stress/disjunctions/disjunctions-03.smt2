(set-logic QF_LIA)
(set-info :status sat)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(declare-const i Int)
(declare-const k Int)
(assert (or (= x1 0) (= x1 1)))
(assert (or (= x2 0) (= x2 1)))
(assert (or (= x3 0) (= x3 1)))
(assert (<= 0 i))
(assert (< i k))
(check-sat)
(exit)
