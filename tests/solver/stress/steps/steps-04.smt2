(set-logic QF_LIA)
(set-info :status unsat)
(declare-const c0 Int)
(declare-const c1 Int)
(declare-const c2 Int)
(declare-const c3 Int)
(declare-const c4 Int)
(assert (= c0 0))
(assert (or (= c1 (+ c0 1)) (= c1 (+ c0 2))))
(assert (or (= c2 (+ c1 1)) (= c2 (+ c1 2))))
(assert (or (= c3 (+ c2 1)) (= c3 (+ c2 2))))
(assert (or (= c4 (+ c3 1)) (= c4 (+ c3 2))))
(assert (> c4 8))
(check-sat)
(exit)
