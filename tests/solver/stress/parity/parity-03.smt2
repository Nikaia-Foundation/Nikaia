(set-logic QF_LIA)
(set-info :status sat)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(declare-const m Int)
(assert (or (= x1 (- 1)) (= x1 1)))
(assert (or (= x2 (- 1)) (= x2 1)))
(assert (or (= x3 (- 1)) (= x3 1)))
(assert (= (+ x1 x2 x3 0) (+ (* 2 m) 1)))
(check-sat)
(exit)
