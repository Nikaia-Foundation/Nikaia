(set-logic QF_LIA)
(set-info :status sat)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(declare-const x4 Int)
(declare-const x5 Int)
(declare-const x6 Int)
(declare-const x7 Int)
(declare-const m Int)
(assert (or (= x1 (- 1)) (= x1 1)))
(assert (or (= x2 (- 1)) (= x2 1)))
(assert (or (= x3 (- 1)) (= x3 1)))
(assert (or (= x4 (- 1)) (= x4 1)))
(assert (or (= x5 (- 1)) (= x5 1)))
(assert (or (= x6 (- 1)) (= x6 1)))
(assert (or (= x7 (- 1)) (= x7 1)))
(assert (= (+ x1 x2 x3 x4 x5 x6 x7 0) (+ (* 2 m) 1)))
(check-sat)
(exit)
