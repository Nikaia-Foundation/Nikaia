(set-logic QF_LIA)
(set-info :status sat)
(declare-const b1 Int)
(declare-const b2 Int)
(declare-const b3 Int)
(declare-const k1 Int)
(declare-const k2 Int)
(declare-const k3 Int)
(declare-const m Int)
(assert (= b1 (* 2 k1)))
(assert (= b2 (* 2 k2)))
(assert (= b3 (* 2 k3)))
(assert (= (+ b1 b2 b3 0) (+ (* 2 m) 2)))
(check-sat)
(exit)
