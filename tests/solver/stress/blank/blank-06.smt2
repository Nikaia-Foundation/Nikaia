(set-logic QF_LIA)
(set-info :status unsat)
(declare-const b1 Int)
(declare-const b2 Int)
(declare-const b3 Int)
(declare-const b4 Int)
(declare-const b5 Int)
(declare-const b6 Int)
(declare-const k1 Int)
(declare-const k2 Int)
(declare-const k3 Int)
(declare-const k4 Int)
(declare-const k5 Int)
(declare-const k6 Int)
(declare-const m Int)
(assert (= b1 (* 2 k1)))
(assert (= b2 (* 2 k2)))
(assert (= b3 (* 2 k3)))
(assert (= b4 (* 2 k4)))
(assert (= b5 (* 2 k5)))
(assert (= b6 (* 2 k6)))
(assert (= (+ b1 b2 b3 b4 b5 b6 0) (+ (* 2 m) 1)))
(check-sat)
(exit)
