(set-logic QF_LIA)
(set-info :status unsat)
(declare-const x0 Int)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(declare-const x4 Int)
(declare-const y0 Int)
(declare-const y1 Int)
(declare-const y2 Int)
(declare-const y3 Int)
(declare-const y4 Int)
(assert (= y0 0))
(assert (or (and (< x0 x1) (= y1 (+ y0 1))) (and (>= x0 x1) (= y1 y0))))
(assert (or (and (< x1 x2) (= y2 (+ y1 1))) (and (>= x1 x2) (= y2 y1))))
(assert (or (and (< x2 x3) (= y3 (+ y2 1))) (and (>= x2 x3) (= y3 y2))))
(assert (or (and (< x3 x4) (= y4 (+ y3 1))) (and (>= x3 x4) (= y4 y3))))
(assert (> y4 4))
(check-sat)
(exit)
