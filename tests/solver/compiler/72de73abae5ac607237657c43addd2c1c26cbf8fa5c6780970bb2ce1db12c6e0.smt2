(set-logic QF_LIA)
(set-info :status unsat)
(declare-const v0 Int)
(declare-const v1 Int)
(declare-const v2 Int)
(declare-const v3 Int)
(declare-const v4 Int)
(assert (<= 0 v0))
(assert (<= 0 v1))
(assert (<= v2 v0))
(assert (= v2 0))
(assert (= v3 1))
(assert (not (<= v4 v0)))
(assert (not (<= 0 1)))
(check-sat)
