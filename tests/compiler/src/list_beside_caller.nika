/// An element of a list a function of another file of the package handed
/// back (`src/list_beside.nika`), handed back: the list moves into the
/// caller's keep and the element is a view of it, as within one file
/// (#1510, ADR-283 D23).
pub fn list_beside_first(a: String) -> String {
	let xs = list_beside_words(a)
	return xs[0]
}

pub fn list_beside_last(a: String) -> String {
	let xs = list_beside_words(a)
	xs[1]
}

pub fn list_beside_through_a_let(a: String) -> String {
	let xs = list_beside_words(a)
	let e = xs[0]
	return e
}

pub fn list_beside_grown(a: String) -> String {
	let mut xs = list_beside_words(a)
	xs.push(a + " 2")
	return xs[2]
}

pub fn list_beside_private(a: String) -> String {
	let xs = list_beside_hidden(a)
	return xs[0]
}

pub fn list_beside_by_method(m: ListBesideMaker, a: String) -> String {
	let xs = m.list_beside_made(a)
	return xs[0]
}
