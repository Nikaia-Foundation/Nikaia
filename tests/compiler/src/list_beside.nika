/// Lists of text of their own, handed to the callers in
/// `src/list_beside_caller.nika`, which hand back an element of them (#1510).
pub fn list_beside_words(a: String) -> Vec[String] {
	let xs: Vec[String] = [a + " 0", a + " 1"]
	return xs
}

fn list_beside_hidden(a: String) -> Vec[String] {
	let mut xs: Vec[String] = []
	xs.push(a + " hidden")
	return xs
}

pub struct ListBesideMaker {
	pub tag: String,
}

impl ListBesideMaker {
	pub fn list_beside_made(self, a: String) -> Vec[String] {
		let xs: Vec[String] = [a + self.tag]
		return xs
	}
}
