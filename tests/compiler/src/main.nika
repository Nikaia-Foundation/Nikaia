use std::fs

pub struct Places {
	pub a: String?,
	pub b: String?,
	pub value: PlacesValue,
}

pub enum PlacesValue {
	Bool(bool),
	Str(String),
}

pub fn places(s: String) -> Vec[Places] {
	return [Places { a: s.strip_prefix("l"), b: null, value: PlacesValue::Bool(true) }, Places { a: null, b: s.trim(), value: PlacesValue::Str(s.trim()) }]
}

/// Each of `places` copied from a lent `Places`, its view fields handed on,
/// out of a list that ends here (`view_fields_of_a_lent_package_struct_handed_on`, #1063).
pub fn places_copied(s: String) -> Vec[Places] {
	let found = places(s)
	let mut out: Vec[Places] = []
	for p in found {
		out.push(copy_places(p))
	}
	return out
}

fn copy_places(p: ref Places) -> Places {
	let value = match p.value {
		PlacesValue::Bool(b) => PlacesValue::Bool(!b)
		other => other.clone()
	}
	return Places { a: p.a, b: p.b, value: value }
}

/// A generic function whose type only brackets can say, reached by a path
/// (`type_arguments_on_a_path`, ADR-grammar-2 D11).
pub fn none_of[T](_n: i64) -> Vec[T] {
	let found: Vec[T] = []
	return found
}

/// A generic function whose value says the type (`type_arguments_on_a_path_warned`).
pub fn same[T](x: T) -> T {
	return x
}

fn main() {
}

/// Two methods of one type in two files that call each other and pause
/// (`pausing_cycle_across_files`): the cycle is boxed although neither file
/// holds it whole (`nest_beside.nika` holds `close`).
pub struct Nest {
	pub depth: i64,
}

impl Nest {
	pub fn open(ref mut self, k: i64) -> String {
		if k <= 0 {
			return fs::read_to_string("/dev/null", fs::Root::Anywhere) catch { "" }
		}
		self.depth += 1
		return f"<{self.close(k - 1)}>"
	}
}

/// One half of a call cycle that hands a new lambda on each round, through
/// two files (`a_lambda_round_a_cycle_across_files`, #1129): `cycle_pong` is
/// in `cycle_beside.nika`, and the parameter must be `&dyn Fn` in both.
pub fn cycle_alt(name: String) -> i64? sync { return name.len() }

pub fn cycle_ping(n: i64, known: fn(ref String) -> i64? sync) -> i64 sync {
	if n == 0 { return known("a") ?? 0 }
	let more = fn(name) { known(name) ?? cycle_alt(name) }
	return cycle_pong(n - 1, more)
}
