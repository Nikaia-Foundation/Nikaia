// The trivia of `tools/parser_grammar.nika` (#557 step 4c), read through its
// `tokens` scan: `//`, nested `/* */` (ADR-307 D1, D2), `///` docs as a rule
// of their own (ADR-grammar-syntax-v1 D19), and the line break `same_line` sees before a
// token (ADR-135 D3). The grammar file, `parse_numbers.nika` and the
// `slice` it calls are copied beside a small driver and run, the way a later
// chunk compares it with the Rust grammar.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// Each argument a file: a whole program counted, any other input shown
// token by token.
fn driver() -> String {
    let lines: Vec[String] = [
        f"fn main() throws {{",
        f"    let mut first = true",
        f"    for a in cli::args() {{",
        f"        if first {{ first = false; continue }}",
        f"        println(f\"== {{a}}\")",
        f"        let s = fs::read_to_string(a.clone(), fs::Root::Anywhere)",
        f"        if a.ends_with(\".nika\") {{ println(pg_count(s)) }} else {{ println(pg_render(s)) }}",
        f"    }}",
        f"}}",
    ]
    return lines.join("\n")
}

// The `slice` of `ledger.nika` that `parse_numbers.nika` calls.
fn slice_fn(ledger: String) -> String {
    let at = ledger.find("\nfn slice(") ?? return ""
    let rest = ledger.after(at.start)
    let end = rest.find("\n}\n") ?? return ""
    return f"{rest.before(end.start)}\n}}\n"
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    let tools = fs::Root::Dir(f"{repo}/crates/nikaia-std/src/compiler")
    let rules = fs::read_to_string("parser_grammar.nika", tools)
    let numbers = fs::read_to_string("parse_numbers.nika", tools)
    let slice = slice_fn(fs::read_to_string("ledger.nika", tools))
    fs::write("main.nika", tmp, f"use std::cli\nuse std::fs\n{rules}\n{numbers}\n{slice}\n{driver()}\n")
    let cases: Vec[String] = [
        "a // to the end\nb",
        "a //// four slashes are a comment\nb",
        "a /* x /* nested */ still the outer */ b",
        "a /* // a line comment inside\n */ b",
        "a /** two stars */ /*! a bang */ b",
        "\"/* in a string */\"",
        "/// one\n// between\n\n///  two\nfn f",
        "x /* never closed",
        "x /* outer /* inner */ y",
        "xs[0]",
        "xs\n[0]",
        "xs // a comment\n[0]",
        "xs /* a comment */ [0]",
        "xs /* across\n a line */ [0]",
    ]
    let mut args: Vec[String] = ["run", "main.nika", "--"]
    let mut i = 0
    for c in cases {
        i += 1
        fs::write(f"case{i}.txt", tmp, c)
        args.push(f"case{i}.txt")
    }
    for p in ["tests/errors/A1.nika", "tests/compiler/tests/drive_docs.nika", "tests/compiler/tests/grammar_same_line.nika"] {
        let name = p.split("/").last() ?? p
        fs::write(f"{name}", tmp, fs::read_to_string(f"{p}", fs::Root::Dir(repo.clone())))
        args.push(name.clone())
    }
    let out = process::run(nikaia, args; dir: tmp.path().to_text())
    println(out.stdout.trim())
}
