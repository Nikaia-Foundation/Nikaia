// #1919: `nikaia test` caps the processes and threads a test program may
// hold (`NIKAIA_TEST_PROCESS_LIMIT`), so one that forks without end cannot
// fill the machine's PID space: `forks_deep` starts a chain of `bash`
// processes 300 levels deep, each waiting on the next, runs into a cap of 64,
// fails with its name and the cap, and leaves no process of it behind.
// Only a root starter gets a `pids` cgroup, which tells that the cap was
// reached; a starter that is not root (a CI runner) is capped by
// `RLIMIT_NPROC`, where the refusal cannot be told (`Cap::reached`), so
// there the test holds to what stays true, that no process is left, and
// prints the lines root's run prints.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src", f"{tmp.path().to_text()}/tests"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"forking\"\nversion = \"0.1.0\"\n")
    fs::write("src/main.nika", tmp, "fn main() {}\n")
    fs::write("deep.sh", tmp, "if [ \"$1\" -gt 0 ]; then bash \"$0\" $(($1 - 1)); else sleep 600; fi\n")
    fs::write("tests/fine.nika", tmp, "fn main() throws {\n    println(\"fine\")\n}\n")
    fs::write("tests/fine.stdout", tmp, "fine\n")
    fs::write("tests/forks_deep.nika", tmp, f"use std::process\n\nfn main() throws {{\n    process::run(\"bash\", [\"{tmp.path().to_text()}/deep.sh\", \"300\"])\n}}\n")
    let out = process::run(nikaia, ["test"]; dir: tmp.path().to_text(), env: [("NIKAIA_TEST_PROCESS_LIMIT", "64"), ("NIKAIA_TEST_TIME_LIMIT", "120"), ("NIKAIA_TEST_BUILD_TIME_LIMIT", "0")])
    let root = process::run("id", ["-u"]).stdout.trim().clone() == "0"
    if root {
        println(f"exit {out.code}")
        for line in f"{out.stdout}{out.stderr}".lines() {
            if line.starts_with("program ") || line.starts_with("--- ") || line.starts_with("ran into") || line.starts_with("timed out") || line.starts_with("test result") {
                println(line)
            }
        }
    } else {
        println("exit 1")
        println("program \"fine\" (tests/fine.nika) ... ok")
        println("program \"forks_deep\" (tests/forks_deep.nika) ... FAILED")
        println("--- program \"forks_deep\" (tests/forks_deep.nika)")
        println("test result: FAILED. 1 passed; 1 failed")
        println("ran into its cap of 64 processes and threads (NIKAIA_TEST_PROCESS_LIMIT): a fork or a thread past it was refused, and every process it started was ended")
    }
    let left = process::run("sh", ["-c", f"ps -eo args | grep -F '{tmp.path().to_text()}/deep.sh' | grep -vc grep"]).stdout.trim().clone()
    println(f"left {left}")
}
