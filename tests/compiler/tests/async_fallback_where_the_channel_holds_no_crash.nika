// A group whose every task has a fallback, in a function whose channel holds
// no `task::Crashed` (ADR-328 D8, ADR-392, #1360): `throws` is inferred, so
// no crash can leave; the group is the plain one, and the function's own
// failures (a print's `io::IoError`, a thrown `Oops`) leave through its value.

struct Oops {}

impl Error for Oops {
	fn message(self) -> String {
		return "oops"
	}
}

fn work(n: i64) -> i64 throws {
	if n > 5 {
		throw Oops {}
	}
	return n * 2
}

// Two errors, neither of them the crash: a sum without `task::Crashed`.
fn compute(limit: i64) -> i64 throws {
	if limit < 0 {
		throw Oops {}
	}
	println("computing")
	let a = async work(7) catch { 0 }
	let b = async work(limit) catch { 100 }
	return a + b
}

fn main() throws {
	println(f"{compute(2)}")
	println(f"{compute(9)}")
	let failed = compute(-1) catch { -1 }
	println(f"{failed}")
	// An `async { }` in a function whose only error is `io::IoError`.
	let total = async {
		let a = async work(7) catch { 0 }
		let b = async work(2) catch { 0 }
		println("in the group")
		a + b
	}
	println(f"{total}")
}
