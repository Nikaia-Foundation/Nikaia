// scripts/drive.nika --rewrite: a builder's `Pushed: rejected` becomes the sha
// when the driver's log holds the report's commit; no git here.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, tmp: ref fs::Root, name: String, report: String) throws {
    fs::write("r.md", tmp, report)
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--rewrite", f"{tmp.path().to_text()}/r.md", f"{tmp.path().to_text()}/log"]; dir: repo)
    println(f"== {name}")
    println(out.stdout.trim())
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    fs::write("log", tmp, "abc1234\tother subject\ndef5678\tdrive: the subject\n")
    case(nikaia.clone(), repo.clone(), tmp, "found", "Result: done\nCommit: drive: the subject\nPushed: rejected\nTests: ok\n")
    case(nikaia.clone(), repo.clone(), tmp, "none found", "Result: done\nCommit: drive: the subject\nPushed: none\nTests: ok\n")
    case(nikaia.clone(), repo.clone(), tmp, "not found", "Result: done\nCommit: another subject\nPushed: rejected\nTests: ok\n")
    case(nikaia.clone(), repo.clone(), tmp, "pushed", "Result: done\nCommit: drive: the subject\nPushed: 9999999\nTests: ok\n")
    case(nikaia.clone(), repo.clone(), tmp, "partial", "Result: partial\nCommit: drive: the subject\nPushed: rejected\nTests: ok\n")
}
