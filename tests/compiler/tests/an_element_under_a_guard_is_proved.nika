// #1596 (ADR-306 D33): an element `xs[c]` of a whole-number type is a number
// of its own, so a guard on it bounds `xs[c] += 1`, and the add is written
// without its check.

fn bump(c: i64) -> i32 {
	let mut xs: Vec[i32] = [1, 2, 3]
	if c >= 0 && c < 3 {
		if xs[c] < 100 {
			xs[c] += 1
		}
		return xs[c]
	}
	return 0
}

fn main() throws {
	println(bump(1))
}
