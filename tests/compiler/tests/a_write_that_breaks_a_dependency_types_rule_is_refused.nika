// A write to a `pub` field of a type of a dependency that breaks the rule
// the type publishes is refused (ADR-369 D2, ADR-269 D8, #2766): `l.v = 11`
// directly, and `put(l, 12)` through the precondition the write in `put`
// carries back, are shown false; `l.v = l.v + 1` in `grow`, where
// nothing shows the value keeps it, is not proved. All were built unchecked.
use std::env
use std::fs
use std::process

// The running `nikaia` (`env::current_exe`, ADR-program-path-1 D3).
fn toolchain() -> String throws {
	return env::current_exe()?.display() ?? "target/fast/nikaia"
}

fn root() -> String throws {
	return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
	let nikaia = toolchain()
	let repo = root()
	let scratch = fs::scratch()
	let tmp = f"{scratch.path().display()}"
	fs::create_dir("level", scratch)
	fs::create_dir("level/src", scratch)
	fs::create_dir("app", scratch)
	fs::create_dir("app/src", scratch)
	fs::write("level/nikaia.toml", scratch, "[package]\nname = \"level\"\nversion = \"0.1.0\"\n")
	fs::write(
		"level/src/lib.nika",
		scratch,
		"pub struct Level {\n    pub v: i64,\n    assert(0 <= v && v <= 10; message: \"a level is between 0 and 10\")\n}\n\npub fn level() -> Level {\n    return Level { v: 0 }\n}\n",
	)
	fs::write(
		"app/nikaia.toml",
		scratch,
		f"[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nlevel = {{ path = \"{tmp}/level\" }}\n",
	)
	fs::write(
		"app/src/main.nika",
		scratch,
		"use level\n\nfn put(mut l: level::Level, x: i64) {\n    l.v = x\n}\n\nfn grow(mut l: level::Level) {\n    l.v = l.v + 1\n}\n\nfn main() {\n    let mut l = level::level()\n    l.v = 11\n    put(l, 12)\n    grow(l)\n}\n",
	)
	let out = process::run(
		nikaia,
		["check", "src/main.nika"]; dir: f"{tmp}/app",
		env: [("RUST_BACKTRACE", "0")],
	)
	println(f"exit {out.code}")
	for line in f"{out.stdout}{out.stderr}".lines() {
		if line.contains("NK") || line.contains(" --> ") {
			println(line.replace(tmp, "TMP").replace(repo, "REPO").trim())
		}
	}
}
