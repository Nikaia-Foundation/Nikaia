// scripts/commit.nika with `Partial: FILE` commits only the hunks the agent
// staged of a file another agent also edits, and leaves the rest in the tree;
// with nothing of it staged it refuses (#1704).
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn git(dir: String, args: Vec[String]) -> String throws {
    let mut all: Vec[String] = ["-c", "user.name=T", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    return process::run("git", all; dir: dir).stdout.trim().clone()
}

fn run_commit(nikaia: String, repo: String, tmp: ref fs::Root) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/commit.nika", "--", f"{tmp.path().to_text()}/X.md.report.md"]; dir: tmp.path().to_text(), env: [("GIT_AUTHOR_NAME", "T"), ("GIT_AUTHOR_EMAIL", "t@example.com"), ("GIT_COMMITTER_NAME", "T"), ("GIT_COMMITTER_EMAIL", "t@example.com")])
    return out.stdout.trim().clone()
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    git(tmp.path().to_text(), ["init", "-q", "-b", "develop"])
    fs::write("a.txt", tmp, "1\n2\n3\n4\n5\n6\n7\n8\n9\n")
    git(tmp.path().to_text(), ["add", "a.txt"])
    git(tmp.path().to_text(), ["commit", "-q", "-m", "base"])
    fs::write("X.md.report.md", tmp, "Result: done\nPartial: a.txt\nCommit: mine only\nChangelog: none\nPushed: none\n")
    // Nothing staged yet: refused.
    fs::write("a.txt", tmp, "mine\n2\n3\n4\n5\n6\n7\n8\ntheirs\n")
    println(run_commit(nikaia.clone(), repo.clone(), tmp))
    // Stage only the first hunk, as an agent does with `git apply --cached`.
    fs::write("p.diff", tmp, "--- a/a.txt\n+++ b/a.txt\n@@ -1,3 +1,3 @@\n-1\n+mine\n 2\n 3\n")
    git(tmp.path().to_text(), ["apply", "--cached", "p.diff"])
    let short = run_commit(nikaia.clone(), repo.clone(), tmp)
    println(short.replace(git(tmp.path().to_text(), ["rev-parse", "--short=8", "HEAD"]), "SHA8"))
    println(git(tmp.path().to_text(), ["log", "--format=%s"]))
    println("committed:")
    println(git(tmp.path().to_text(), ["show", "HEAD:a.txt"]))
    println("left in the tree:")
    println(git(tmp.path().to_text(), ["diff", "--numstat", "--", "a.txt"]))
    println(git(tmp.path().to_text(), ["diff", "--cached", "--name-only"]))
}
