// A rust-library package with `[rust-library] root = "rust/lib.rs"` (ADR-393
// D7, #1438): `nikaia build` copies `rust/` into the crate's `src/`, writes
// the lowered package as `src/native/mod.rs` and makes `rust/lib.rs` the
// crate root with `pub mod native;` below it. Every feature alone builds with
// the hand-written root (D6), and the Rust crate `rust_library_splice/user`
// calls its re-exports, its own function and `nikaia_demo::native`.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// The tests' cache entry cargo builds in, `<kind>/<toolchain key>` under
// target/nikaia-project-tests: stamped as `use_entry` stamps one
// (`.nikaia-used`), so `nikaia cache prune` counts it and removes it when it
// was used longest ago (#1521); cargo's lock on it keeps it while it builds.
// One per toolchain, so what an older compiler built goes as a whole.
fn cache_entry(repo: String, nikaia: String, kind: String) -> String throws {
    let key = process::run("sha256sum", [nikaia]).stdout.split(" ").collect()[0].clone()
    let entry = f"{repo}/target/nikaia-project-tests/{kind}/{key}"
    process::run("mkdir", ["-p", entry.clone()])
    fs::write(f"target/nikaia-project-tests/{kind}/{key}/.nikaia-used", fs::Root::Dir(repo.clone()), "")
    return entry
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    let from = f"{repo}/tests/compiler/rust_library_splice"
    process::run("cp", ["-r", f"{from}/demo", f"{from}/user", tmp.path().to_text()])
    let cache = cache_entry(repo.clone(), nikaia.clone(), "rust-library-splice")
    let mut env: Vec[(String, String)] = []
    env.push(("CARGO_TARGET_DIR", cache.clone()))
    env.push(("CARGO_NET_OFFLINE", "true"))
    let built = process::run(nikaia, ["build"]; dir: f"{tmp.path().to_text()}/demo", env: env.clone())
    println(built.stdout.trim().replace(tmp.path().to_text(), "TMP"))
    if built.code != 0 { println(built.stderr.trim().replace(tmp.path().to_text(), "TMP")) }
    let made = tmp.join("demo/target/rust-library/nikaia_demo")
    let listed = process::run("sh", ["-c", "find src -type f | sort"]; dir: made.path().to_text())
    println(listed.stdout.trim())
    let lib = fs::read_to_string("src/lib.rs", made)
    let lines: Vec[String] = lib.lines().collect()
    if lines.len() > 0 {
        println(f"src/lib.rs ends: {lines[lines.len() - 1]}")
    }
    let native = fs::read_to_string("src/native/mod.rs", made)
    for line in native.lines() {
        if line.starts_with("#[cfg(") { println(f"src/native/mod.rs: {line.split(" {").next() ?? ""}") }
    }
    let ran = process::run("cargo", ["run", "-q"]; dir: f"{tmp.path().to_text()}/user", env: env.clone())
    println(ran.stdout.trim())
    if ran.code != 0 { println(ran.stderr.trim()) }
}
