// An emitting `@stream` entry whose item type can view the input writes its
// item rule's result at the grammar's lifetime, `Option<Item<'a>>`, not the
// fold closure's `'_`, which rustc refused as a missing lifetime (#2835,
// ADR-grammar-typed-read-v2 D7: an item views the input it is parsed from).

struct Item {
	word: String,
}

fn view(w: String) -> Item sync {
	return Item { word: w }
}

grammar Words {
	@stream entry rule items -> Item = group*
	rule group = until(";") ";" -> { emit Item { word: "one" } }
}

fn main() throws {
	let mut text = String()
	text.push_str("ab;c;")
	println(view(text).word)
	for it in Words::items(text) {
		println(it.word)
	}
}
