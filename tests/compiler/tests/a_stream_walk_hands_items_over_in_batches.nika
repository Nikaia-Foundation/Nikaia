// A walk of a `@stream` entry over a `String` hands its items over in
// batches, not one at a time (ADR-grammar-typed-read-v2 D7, #2433): the
// order stays, a `break` after the third item of many sees three items and
// ends, and an error after item N is seen after those N items, whether N is
// a whole number of batches (512), more (600) or fewer (3).

struct Item {
	word: String,
}

grammar Words {
	@stream entry rule items -> Item = item*
	rule item -> Item = "[" w:until("]") "]" ";" -> { Item { word: w.clone() } }
}

fn many(n: i64, tail: String) -> String {
	let mut text = String()
	for i in 0..<n {
		text.push_str(f"[w{i}];")
	}
	text.push_str(tail)
	return text
}

fn first_three(text: String) -> i64 throws {
	let mut seen = 0
	for it in Words::items(text) {
		if seen == 3 {
			break
		}
		println(it.word)
		seen += 1
	}
	return seen
}

struct Seen {
	n: i64,
}

// Counts into `seen` the items the walk hands over before it ends, and says
// any that comes out of order.
fn walk(text: String, mut seen: Seen) throws {
	for it in Words::items(text) {
		if it.word != f"w{seen.n}" {
			println(f"out of order: {it.word} at {seen.n}")
		}
		seen.n += 1
	}
}

fn main() throws {
	println(f"stopped after {first_three(many(2000, "x"))}")
	for n in [3, 512, 600, 2000] {
		let mut failing = Seen { n: 0 }
		walk(many(n, "x"), failing) catch {
			println(f"{n}: failed after {failing.n} items: {error}")
		}
		let mut whole = Seen { n: 0 }
		walk(many(n, ""), whole)
		println(f"{n}: walked {whole.n}")
	}
}
