// scripts/drive.nika --pull LOWER BUILD BADGES (#1717): the merge of
// `origin/develop` the driver makes before each issue and each suite, in a
// temp repository with a bare remote. Nothing new prints nothing. A remote
// change with no local commits is a fast-forward (no merge commit for the
// suite to test) and names the `scripts/*.nika` it brought, so the driver
// restarts with them; with local commits it is a merge commit, the
// uncommitted local change back after it; a conflict aborts the merge and
// escalates, naming the merge, with no merge left open. A conflict in sources
// and lowered files names only the sources (#1820). A merge git refuses for an
// untracked file in the way names git's own words, or, when that file is
// generated (a badge), moves it aside and merges again (#1820). An uncommitted
// change the merge also changed conflicts when git puts it back after the
// merge (#1862): in a lowered file, that file takes HEAD's copy and nothing
// is left staged; in a source, the driver escalates, naming it and the stash.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn sh(dir: String, script: String) -> String throws {
    let out = process::run("sh", ["-c", f"set -e; {script}"]; dir: dir)
    if !out.ok { println(f"setup failed: {script}\n{out.stderr}") }
    return out.stdout.trim().clone()
}

// A repository `work` and a clone `other`, both from the bare `origin`;
// `other` pushes THEIRS (shell, may be empty), `work` runs OURS, keeps an
// uncommitted change and runs LOOSE (shell, may be empty: untracked files).
fn setup(tmp: ref fs::Root, name: String, theirs: String, ours: String, loose: String) -> String throws {
    let base = f"{tmp.path().to_text()}/{name}"
    let id = "git config user.email t@t; git config user.name t; git config commit.gpgsign false"
    sh(tmp.path().to_text(), f"mkdir -p {name}; cd {name}; git init -q --bare origin.git; git init -q -b develop work")
    let work = f"{base}/work"
    sh(work.clone(), f"{id}; mkdir -p scripts; echo base > scripts/batch.nika; echo notes > notes.txt; echo base > shared.txt; mkdir -p crates/nikaia-std/src/compiler; echo base > crates/nikaia-std/src/compiler/lowered.rs; git add -A; git commit -q -m base; git remote add origin ../origin.git; git push -q origin develop")
    sh(base.clone(), "git clone -q -b develop origin.git other")
    if theirs != "" {
        sh(f"{base}/other", f"{id}; {theirs}; git add -A; git commit -q -m theirs; git push -q origin develop")
    }
    if ours != "" { sh(work.clone(), f"{ours}; git add -A; git commit -q -m ours") }
    sh(work.clone(), "echo local > notes.txt")
    if loose != "" { sh(work.clone(), loose) }
    return work
}

fn case(nikaia: String, repo: String, tmp: ref fs::Root, name: String, theirs: String, ours: String, loose: String) throws {
    let work = setup(tmp, name.replace(" ", "-").replace(",", ""), theirs, ours, loose)
    let out = process::run(nikaia, ["run", f"{repo}/scripts/drive.nika", "--", "--pull", "false", "true", "true"]; dir: work.clone())
    let head = sh(work.clone(), "git rev-parse HEAD").bytes[0..<8].text().clone()
    println(f"== {name}")
    let aside = sh(work.clone(), "ls .git | grep drive-aside || true")
    let mut said = out.stdout.trim().replace(head, "SHA")
    if aside != "" { said = said.replace(aside, "drive-aside-STAMP") }
    let stash = sh(work.clone(), "git stash list -1 --format=%h")
    if stash != "" { said = said.replace(stash, "STASH") }
    println(said)
    println(f"exit ok: {out.ok}")
    println(sh(work, "git log --format=%s -1; git log --format=%p -1 | wc -w; test -f .git/MERGE_HEAD && echo merge open || echo no merge open; git status --porcelain --untracked-files=all; cat scripts/batch.nika shared.txt; ls .git | grep -c drive-aside || true"))
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    case(nikaia.clone(), repo.clone(), tmp, "nothing new", "", "", "")
    case(nikaia.clone(), repo.clone(), tmp, "no local commits, a script", "echo theirs > scripts/batch.nika", "", "")
    case(nikaia.clone(), repo.clone(), tmp, "local commits, a script and a note", "echo theirs > scripts/batch.nika; mkdir -p docs; echo theirs > docs/x.md", "echo ours > ours.txt", "")
    case(nikaia.clone(), repo.clone(), tmp, "conflict", "echo theirs > shared.txt", "echo ours > shared.txt", "")
    let lowered = "mkdir -p crates/nikaia-std/src/compiler/lowered; echo {} > crates/nikaia-std/src/compiler/lowered/a.rs; echo {} > shared.txt"
    case(nikaia.clone(), repo.clone(), tmp, "conflict in a source and a lowered file", lowered.replace("{}", "theirs"), lowered.replace("{}", "ours"), "")
    case(nikaia.clone(), repo.clone(), tmp, "an untracked source in the way", "mkdir -p docs; echo theirs > docs/y.md", "echo ours > ours.txt", "mkdir -p docs; echo loose > docs/y.md")
    let index = "echo {} > crates/nikaia-std/src/compiler/lowered.rs"
    case(nikaia.clone(), repo.clone(), tmp, "an uncommitted lowered change the merge changed too", index.replace("{}", "theirs"), "", index.replace("{}", "loose"))
    case(nikaia.clone(), repo.clone(), tmp, "an uncommitted source the merge changed too", "echo theirs > shared.txt", "", "echo loose > shared.txt")
    case(nikaia, repo, tmp, "an untracked badge in the way", "mkdir -p assets/badges; echo theirs > assets/badges/b.svg", "echo ours > ours.txt", "mkdir -p assets/badges; echo loose > assets/badges/b.svg")
}
