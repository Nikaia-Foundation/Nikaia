// #99, ADR-286 D24, D26: a crate `nikaia_fake` with no `.nika` sources and no
// ledger is refused by name, not trusted for its prefix; a key by version is a
// `use` name, so an identifier; a table by version says `version` or `git`.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn refusal(nikaia: String, app: ref fs::Root, dependencies: String) -> String throws {
    let at = app.path().to_text()
    fs::write("nikaia.toml", app, f"[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n{dependencies}")
    let out = process::run(nikaia, ["build"]; dir: at.clone(), env: [("CARGO_NET_OFFLINE", "true")])
    let said: Vec[String] = out.stderr.lines().filter(fn(line) { line.contains("nikaia_fake") || line.contains("Dependency `") }).map(fn(line) { line.replace(at, "APP") }).collect()
    return f"ok: {out.ok}\n{said.join("\n")}"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/fake", f"{tmp.path().to_text()}/app/src", f"{tmp.path().to_text()}/app/.cargo"])
    fs::write("fake/Cargo.toml", tmp, "[package]\nname = \"nikaia_fake\"\nversion = \"1.0.0\"\nedition = \"2024\"\n\n[lib]\npath = \"lib.rs\"\n\n[workspace]\n")
    fs::write("fake/lib.rs", tmp, "")
    fs::write("app/.cargo/config.toml", tmp, f"[patch.crates-io]\nnikaia_fake = {{ path = \"{tmp.path().to_text()}/fake\" }}\n")
    fs::write("app/src/main.nika", tmp, "fn main() throws {\n    println(1)\n}\n")
    println(refusal(nikaia, tmp.join("app"), "fake = \"1\"\n").replace(tmp.path().to_text(), "TMP"))
    println(refusal(nikaia, tmp.join("app"), "http-server = \"1.2\"\n"))
    println(refusal(nikaia, tmp.join("app"), "fake = { features = [\"x\"] }\n"))
    println(refusal(nikaia, tmp.join("app"), "fake = { tag = \"v1\" }\n"))
}
