// An `i64` `-` that data from outside reaches, after a guard on the
// difference itself: the bounds walk's ranges of `a` and `b` alone do not
// bound it, the prover's goal within `±2^62` does, and `--bounds` names the
// guard (ADR-396 D8 step 2, #1810).
use std::io
use std::text

fn main() throws {
    let a = text::parse_i64(io::read_to_string().trim()) ?? 0
    let b = text::parse_i64(io::read_to_string().trim()) ?? 0
    if a - b > 10 || b - a > 10 {
        return
    }
    println(a - b)
}
