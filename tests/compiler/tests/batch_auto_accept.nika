// batch.nika: a done or partial report with a commit, `Gate: green`,
// `Needs: none` and `Owner: none` is auto-accepted (owner, 2026-11-15,
// #1694): the line is appended, a partial's name goes into review.txt and
// status.nika counts its changelog line; blocked, Pushed none, a red or
// missing gate, a Needs or an Owner that asks for something still stop.
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn first(nikaia: String, repo: String, tmp: ref fs::Root) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/batch.nika", "--", "."]; dir: tmp.path().to_text())
    return out.stdout.trim().split("\n").collect()[0].replace(tmp.path().to_text(), "T")
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn report(tmp: ref fs::Root, text: String) throws {
    fs::write("a.report.md", tmp, text)
    process::run("rm", ["-f", f"{tmp.path().to_text()}/review.txt"])
}

fn read(tmp: ref fs::Root, name: String) -> String throws {
    if !fs::exists(name.clone(), tmp) { return "(none)\n" }
    return fs::read_to_string(name, tmp)
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    // The scripts run in their lane's directory, which lies below the
    // working directory; they find the toolchain and scripts under the
    // checkout's names.
    process::run("ln", ["-s", f"{repo}/target", f"{tmp.path().to_text()}/target"])
    process::run("ln", ["-s", f"{repo}/scripts", f"{tmp.path().to_text()}/scripts"])
    fs::write("batch.txt", tmp, "a.md\n")
    fs::write("a.md", tmp, "body\n")
    fs::write("released.txt", tmp, "")
    let tail = "Needs: none\nOwner: none\nChangelog: Something.\n"
    report(tmp, "Result: partial, rest in #2\nPushed: local abc\nGate: green\nDeviation: x\n" + tail)
    println(f"partial: {first(nikaia.clone(), repo.clone(), tmp)}")
    let text = read(tmp, "a.report.md")
    let lines = text.trim().split("\n").collect()
    let last = lines[lines.len() - 1].clone()
    let words = last.split(" ").collect()
    println(f"appended: {words[0]} DATE {words[2]} {words[3]} {words[4]} {words[5]}")
    print(f"review.txt: {read(tmp, "review.txt")}")
    let status = process::run(nikaia.clone(), ["run", f"{repo}/scripts/status.nika", "--", "."]; dir: tmp.path().to_text())
    println(f"status: {status.stdout.trim().split("\n").collect()[2]}")
    println(f"again: {first(nikaia.clone(), repo.clone(), tmp)}")
    println(f"lines after a second run: {read(tmp, "a.report.md").trim().split("\n").count()}")
    report(tmp, "Result: done\nPushed: local abc\nGate: green\nDeviation: x\n" + tail)
    println(f"done with a deviation: {first(nikaia.clone(), repo.clone(), tmp)}")
    print(f"review.txt: {read(tmp, "review.txt")}")
    let names = ["blocked", "pushed none", "gate red", "no gate", "needs", "owner"]
    let texts: Vec[String] = [
        "Result: blocked\nPushed: none\nGate: green\nDeviation: none\n" + tail,
        "Result: partial\nPushed: none\nGate: green\nDeviation: none\n" + tail,
        "Result: partial\nPushed: local abc\nGate: red x\nDeviation: none\n" + tail,
        "Result: partial\nPushed: local abc\nDeviation: none\n" + tail,
        "Result: partial\nPushed: local abc\nGate: green\nDeviation: none\nNeeds: supervisor decision\nOwner: none\n",
        "Result: partial\nPushed: local abc\nGate: green\nDeviation: none\nNeeds: none\nOwner: which way?\n",
    ]
    for i in 0..<names.len() {
        report(tmp, texts[i].clone())
        let got = first(nikaia.clone(), repo.clone(), tmp)
        let untouched = read(tmp, "a.report.md") == texts[i]
        println(f"{names[i]}: {got} (report untouched: {untouched})")
    }
}
