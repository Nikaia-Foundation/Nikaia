// batch.nika: a report with Result done or partial, a commit, Gate green,
// Needs none and Owner none is accepted by the driver itself (owner,
// 2026-11-15, #1694): no cut, a `Supervisor: <date>: auto-accepted` line
// appended once and the report named in DIR/review.txt. Result: blocked,
// Pushed: none, a red gate, Needs and Owner still cut.
use std::fs
use std::process

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/batch.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/batch.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn first(nikaia: String, repo: String, tmp: String) -> String throws {
    let out = process::run(nikaia, ["run", "scripts/batch.nika", "--", tmp.clone()]; dir: repo)
    return out.stdout.trim().split("\n").collect()[0].replace(tmp, "T")
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    let release = f"{repo}/target/release/nikaia"
    if fs::exists(release.clone(), fs::Root::Anywhere) { return release }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    fs::write(f"{tmp}/batch.txt", fs::Root::Anywhere, "a.md\n")
    fs::write(f"{tmp}/a.md", fs::Root::Anywhere, "body\n")
    let ok = "Gate: green\nNeeds: none\nOwner: none\n"
    let cases = [
        ["partial", f"Result: partial, rest in #2\nPushed: local abc\nDeviation: item 2 left\n{ok}"],
        ["deviation", f"Result: done\nPushed: local abc\nDeviation: x\n{ok}"],
        ["no owner line", f"Result: partial\nPushed: local abc\nDeviation: none\nGate: green\nNeeds: none\n"],
        ["clean", f"Result: done\nPushed: local abc\nDeviation: none\n{ok}"],
        ["gate red", f"Result: partial\nPushed: local abc\nDeviation: none\nGate: red x\nNeeds: none\nOwner: none\n"],
        ["needs", f"Result: partial\nPushed: local abc\nDeviation: none\nGate: green\nNeeds: supervisor decision\nOwner: none\n"],
        ["no needs line", f"Result: partial\nPushed: local abc\nDeviation: none\nGate: green\n"],
        ["owner", f"Result: partial\nPushed: local abc\nDeviation: none\nGate: green\nNeeds: none\nOwner: which way?\n"],
        ["blocked", f"Result: blocked\nPushed: none\nDeviation: none\n{ok}"],
        ["not pushed", f"Result: partial\nPushed: none\nDeviation: none\n{ok}"],
    ]
    for c in cases {
        process::run("rm", ["-f", f"{tmp}/review.txt"])
        fs::write(f"{tmp}/a.report.md", fs::Root::Anywhere, c[1].clone())
        let once = first(nikaia.clone(), repo.clone(), tmp.clone())
        let again = first(nikaia.clone(), repo.clone(), tmp.clone())
        let report = fs::read_to_string(f"{tmp}/a.report.md", fs::Root::Anywhere)
        let lines = report.split("\n").filter(fn(l) { l.contains("auto-accepted (Result/Deviation as written)") }).count()
        let mut review: String = "no review.txt"
        if fs::exists(f"{tmp}/review.txt", fs::Root::Anywhere) { review = fs::read_to_string(f"{tmp}/review.txt", fs::Root::Anywhere).trim().replace("\n", " ").clone() }
        println(f"{c[0]}: {once} | again: {again} | accept lines: {lines} | {review}")
    }
    process::run("rm", ["-rf", tmp])
}
