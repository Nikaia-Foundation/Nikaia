// #847 step 3: batch.nika and cycle.nika pass a brief's frontmatter on in
// `NEXT`, and a report's `Owner:` becomes an OWNER line and DIR/QUESTION.
use std::env
use std::fs
use std::process

// The checkout: the working directory, or (under `nikaia test`, which runs a
// test in a directory of its own) the one `nikaia` was started in.
fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn pick(out: String, tmp: ref fs::Root) -> String throws {
    let mut kept: Vec[String] = []
    for l in out.split("\n") {
        if l.starts_with("NEXT") || l.starts_with("OWNER") || l.starts_with("CUT") { kept.push(l.replace(tmp.path().to_text(), "T")) }
    }
    return kept.join(" | ")
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    fs::write("a.md", tmp, "---\nagent: qa\nmodel: opus\nmax_turns: 7\nbudget_usd: 5\n---\nbody\n")
    fs::write("p.md", tmp, "no frontmatter\n")
    fs::write("batch.txt", tmp, "a.md\np.md\n")
    let first = process::run(nikaia.clone(), ["run", "scripts/batch.nika", "--", tmp.path().to_text()]; dir: repo.clone())
    println(f"with frontmatter: {pick(first.stdout.clone(), tmp)}")
    let report = "Result: done\nPushed: abc\nFound: none\nDeviation: none\nChangelog: none\n"
    fs::write("a.report.md", tmp, report)
    let second = process::run(nikaia.clone(), ["run", "scripts/batch.nika", "--", tmp.path().to_text()]; dir: repo.clone())
    println(f"without frontmatter, report without Owner: {pick(second.stdout.clone(), tmp)}")
    fs::write("a.report.md", tmp, report + "Owner: none\n")
    let third = process::run(nikaia.clone(), ["run", "scripts/batch.nika", "--", tmp.path().to_text()]; dir: repo.clone())
    println(f"Owner none: {pick(third.stdout.clone(), tmp)}")
    fs::write("a.report.md", tmp, report + "Owner: opus or sonnet?\n")
    let ask = process::run(nikaia.clone(), ["run", "scripts/batch.nika", "--", tmp.path().to_text()]; dir: repo.clone())
    println(f"Owner question: {pick(ask.stdout.clone(), tmp)}")
    let one = process::run(nikaia.clone(), ["run", "scripts/cycle.nika", "--", tmp.path().to_text()]; dir: repo.clone())
    println(f"cycle: {pick(one.stdout.clone(), tmp)}")
    println(f"question file: {fs::read_to_string("QUESTION", tmp).trim()}")
    let two = process::run(nikaia.clone(), ["run", "scripts/cycle.nika", "--", tmp.path().to_text()]; dir: repo.clone())
    println(f"cycle again: {pick(two.stdout.clone(), tmp)}")
}
