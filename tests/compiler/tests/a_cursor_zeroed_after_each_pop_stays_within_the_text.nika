/// A whole-number field set to `0` after each shortening of a list field
/// (#1642): `pop` forgets what was known of `text`'s length, but not that
/// it is never negative, so `cursor <= text.len()` is a found rule of
/// `Editor` and the read before the cursor is proved.
struct Editor {
	text: Vec[scalar],
	cursor: i64,
}

impl Editor {
	fn type_one(mut self, c: scalar) {
		self.text.push(c)
		self.cursor = self.text.len()
	}

	fn delete_last(mut self) {
		self.text.pop()
		self.cursor = 0
	}

	fn before_cursor(self) -> scalar {
		if self.cursor < 1 { return ' ' }
		return self.text[self.cursor - 1]
	}
}

fn main() throws {
	let mut e = Editor { text: [], cursor: 0 }
	e.type_one('a')
	e.type_one('b')
	println(f"{e.before_cursor()}")
	e.delete_last()
	println(f"{e.before_cursor()}")
}
