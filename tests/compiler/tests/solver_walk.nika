// The local search for models (ADR-270 D14, #1284 item 3,
// `tools/sv_walk.nika`): a walk over integer assignments that scores the
// clauses its atoms leave false. Each line shows the walk on a file's query
// - whether every clause held at its end, the moves it made, whether a walk
// from the same seed makes the same moves to the same values, and what
// `lg_consistent_answer` says of its values (an answer only where that
// refutes the query, D3) - then the runner's line for the new engine.
// `problem__003` (a random system of ten columns from `tests/solver/qflia`)
// overflows the search after two checks; the strategy runs the walk first on
// it (`sv_strategy.nika`), which finds the model (`/walk`). `unsat` gives a walk nothing to find; `real` has a real column,
// so it gets no walk (D27) and makes no move.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "// The walk on each file's query, then the runner's line.
fn each(path: String) throws {
	let name = path.split(\"/\").last() ?? path
	let source = fs::read_to_string(path.clone(), fs::Root::Anywhere)
	let mut reals: collections::BTreeSet[String] = collections::BTreeSet()
	let script = match sv_smtlib_script(source) {
		SvSmtRead::Script(s, sorts) => {
			reals = sorts.reals.clone()
			s.clone()
		},
		else => {
			println(f\"{name}: unreadable\")
			return
		},
	}
	let mut arena = script.arena.clone()
	let goal = arena.boolean(false)
	let mut why = lg_why()
	let line = sv_line(source, \"new\")
	let read = sv_cnf_sorted(arena, script.assertions, goal, reals, why)
	if read == null {
		println(f\"{name}: no query; {line}\")
		return
	}
	let cnf = read ?? return
	let none: Vec[Vec[u32]] = []
	let params = sv_walk_params()
	let first = sv_walk(cnf.query, none, params, 5000)
	let again = sv_walk(cnf.query, none, params, 5000)
	let same = first.moves == again.moves && first.values == again.values
	let mut values: collections::BTreeMap[String, i64] = collections::BTreeMap()
	let mut col = 0
	while col < first.values.len() && col < cnf.names.len() {
		values.insert(cnf.names[col].clone(), first.values[col])
		col += 1
	}
	let verdict = match lg_consistent_answer(arena, script.assertions, goal, true, values) {
		LgAnswer::Refuted { .. } => \"a model\",
		else => \"no model\",
	}
	println(f\"{name}: walk found {first.found} in {first.moves} moves, same again {same}, {verdict}; {line}\")
}

fn main() throws {
	let mut args: Vec[String] = []
	for a in cli::args() {
		args.push(a)
	}
	for i in 1..<args.len() {
		each(args[i].clone())
	}
}
"
}

// A file of status `status` over the constants `names` of sort `sort`
// asserting `body`.
fn smt(status: String, sort: String, names: Vec[String], body: String) -> String {
	let logic = if sort == "Real" { "QF_LRA" } else { "QF_LIA" }
	let mut text = f"(set-logic {logic})\n(set-info :status {status})\n"
	for n in names {
		text = text + f"(declare-const {n} {sort})\n"
	}
	return text + body + "(check-sat)\n"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_walk", "sv_strategy", "sv_smt", "sv_smtlib", "sv_lemma", "sv_nl", "sv_rod"] {
		let dir = if name == "sv_rod" { "solver" } else { "tools" }
		paths.push(f"{repo}/crates/nikaia-std/src/{dir}/{name}.nika")
	}
	let mut uses: Vec[String] = []
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver())
	let files = [
		(
			"problem__003",
			fs::read_to_string(
				f"{repo}/tests/solver/qflia/regress1-arith-problem__003.smt2",
				fs::Root::Anywhere,
			),
		),
		(
			"equation",
			smt(
				"sat",
				"Int",
				["x", "y"],
				"(assert (= (+ (* 3 x) (* 5 y)) 7))\n(assert (distinct x y))\n(assert (or (> x 4) (< y (- 3))))\n",
			),
		),
		("unsat", smt("unsat", "Int", ["x"], "(assert (>= x 1))\n(assert (<= x 0))\n")),
		("real", smt("sat", "Real", ["x"], "(assert (< 0 x 1))\n")),
	]
	let mut args: Vec[String] = ["run", "main.nika", "--"]
	for (name, text) in files {
		fs::write(f"{tmp}/{name}.smt2", fs::Root::Anywhere, text)
		args.push(f"{tmp}/{name}.smt2")
	}
	let out = process::run(nikaia, args; dir: tmp.clone())
	println(out.stdout.trim())
	if out.stdout.trim().len() == 0 {
		println(out.stderr.trim())
	}
	process::run("rm", ["-rf", tmp])
}
