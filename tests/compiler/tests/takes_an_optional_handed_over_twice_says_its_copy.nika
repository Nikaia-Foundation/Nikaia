// An optional handed over and read again (#1056): NK2105's help writes the
// copy that compiles, `t?.clone()`, not `t.clone()`.
struct Node { name: String }

struct Held { node: Node? }

fn keep(t: Node?) -> i64 {
	let held = Held { node: t }
	return match held.node {
		null => 0
		v => v.name.len()
	}
}

fn main() {
	let t: Node? = Node { name: "a" }
	println(keep(t))
	println(keep(t))
}
