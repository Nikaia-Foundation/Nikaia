// A call's slice result that is a view of its parameter, handed to a lent
// `Array[T]`, is a view already (ADR-views-3 D8, D11, #1254), as a part
// `v[1..]` is; so are a `Bytes` result (D15) and a text result.
fn rest(xs: Array[i64]) -> Array[i64] {
    return xs[1..]
}

fn total(xs: Array[i64]) -> i64 {
    let mut sum = 0
    for x in xs {
        sum += x
    }
    return sum
}

fn tail(b: Bytes) -> Bytes {
    return b[1..]
}

fn size(b: Bytes) -> i64 {
    return b.len()
}

fn trimmed(s: String) -> String {
    return s.trim()
}

fn count(s: String) -> i64 {
    return s.len()
}

fn main() throws {
    let v: Array[i64, 4] = [1, 2, 3, 4]
    let w: Vec[i64] = [5, 6, 7]
    println(f"{total(rest(v))} {total(rest(w))} {total(rest(rest(v)))}")
    let r = rest(v)
    println(f"{total(r)} {total(v[1..])}")
    let b: Bytes = Bytes([1, 2, 3, 4])
    println(f"{size(tail(b))}")
    println(f"{count(trimmed("  hi  "))}")
}
