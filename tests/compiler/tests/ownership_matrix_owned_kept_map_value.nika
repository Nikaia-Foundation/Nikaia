// Ownership matrix (#1404): a owned value, kept, in the position `map_value`.
// Generated by scripts/ownership_matrix.nika: change the generator, not this file.

use std::collections

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

fn fill(mut m: collections::HashMap[String, String], keep v: String) {
    m.insert("k", v)
}

fn main() throws {
    let s = make()
    let mut m: collections::HashMap[String, String] = collections::HashMap()
    fill(m, s)
    println(m["k"] ?? "none")
}
