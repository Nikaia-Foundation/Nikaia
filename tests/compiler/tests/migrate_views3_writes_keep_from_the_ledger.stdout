pub struct Bag { items: Vec[String] }

pub fn put(mut b: Bag, keep s: String) { b.items.push(s) }
-- pkg/src/main.nika
fn through(mut b: Bag, keep s: String) { put(b, s) }

fn main() {
    let mut b = Bag { items: [] }
    through(b, "x")
}
