-- alone.nika
struct Bag { items: Vec[String] }

impl Bag {
    fn add(mut self, keep s: String) { self.items.push(s) }
    fn has(self, s: String) -> bool { return self.items.contains(s) }
}

fn store(mut b: Bag, keep s: String, keep t: String) {
    b.items.push(s)
    b.items.push(t)
}

fn main() {
    let mut b = Bag { items: [] }
    b.add("a")
    store(b, "b", "c")
    println(b.has("a"))
}
