// A value with a cleanup that dies at a block's end is cleaned up there, in
// the order the values died (the last first), each `drop` right after its
// cleanup; a failing cleanup is what the block throws, and one failing while
// the body throws joins the body's failure; `close` runs it at once and
// leaves nothing for the end; a stop runs only the `drop`s (ADR-async-v6,
// Part II 9). Moved from the `nikaia-std` unit tests `cleanup::tests::*`
// (#2082).

enum FlushError {
    Refused(String),
}

impl Error for FlushError {
    fn message(ref self) -> String {
        match self {
            FlushError::Refused(name) => f"{name} would not flush"
        }
    }
}

struct Noted {
    name: String,
    fails: bool,
}

impl Cleanup for Noted {
    fn cleanup(ref mut self) throws {
        println(f"cleanup {self.name}")
        if self.fails {
            throw FlushError::Refused(f"{self.name}")
        }
    }
}

impl Drop for Noted {
    fn drop(ref mut self) {
        println(f"drop {self.name}") catch { }
    }
}

fn two() throws {
    let _a = Noted { name: f"a", fails: false }
    let _b = Noted { name: f"b", fails: false }
    println("before the end")
}

fn failing() throws {
    let _a = Noted { name: f"f", fails: true }
}

fn closing() throws {
    let c = Noted { name: f"c", fails: false }
    c.close()
    println("after close")
}

fn both() throws {
    let _b = Noted { name: f"g", fails: true }
    throw FlushError::Refused(f"the body")
}

fn stopping() throws {
    let _p = Noted { name: f"p", fails: false }
    panic("a bug")
}

fn main() throws {
    both() catch { println(f"failed: {error}") }
    two()
    println("after two")
    failing() catch { println(f"failed: {error}") }
    closing()
    stopping()
}
