// A `pub extern fn` of a C library whose body runs its code parameter one call
// at a time lowers it to `&mut impl FnMut` (ADR-views-v4 D17), so the C export
// wrapper binds the C callback `let mut` and lends it `&mut` (#2076). Before,
// the wrapper lent `&` and the library reached rustc as NK1343. The C caller
// counts the calls through its context.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let nikaia = toolchain()
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"steps\"\nversion = \"0.1.0\"\n\n[build]\nartifact = \"c-library\"\n")
    fs::write("src/main.nika", tmp, "pub extern fn each_up_to(n: i64, each: fn(i64) -> bool sync) -> i64 sync {\n    let mut at = 0\n    while at < n {\n        if !each(at) {\n            return at\n        }\n        at = at + 1\n    }\n    return at\n}\n")
    fs::write("use.c", tmp, "#include <stdio.h>\n#include \"steps.h\"\n\nstatic bool seen(int64_t at, void *ctx) {\n    int64_t *sum = ctx;\n    *sum += at;\n    return at < 3;\n}\n\nint main(void) {\n    int64_t sum = 0;\n    int64_t out = 0;\n    int status = steps_each_up_to(10, seen, &sum, &out);\n    printf(\"status %d, stopped at %lld, sum %lld\\n\", status, (long long) out, (long long) sum);\n    return 0;\n}\n")
    let built = process::run(nikaia, ["build"]; dir: tmp.path().to_text(), env: [("RUST_BACKTRACE", "0")])
    println(f"build: exit {built.code}")
    if built.code != 0 { println(built.stderr.trim().replace(tmp.path().to_text(), "TMP")) }
    let lib = tmp.join("target/nikaia/c-library")
    let cc = process::run("cc", ["-I", lib.path().to_text(), "use.c", "-L", lib.path().to_text(), "-lsteps", "-o", "use"]; dir: tmp.path().to_text())
    println(f"cc: exit {cc.code}")
    if cc.code != 0 { println(cc.stderr.trim().replace(tmp.path().to_text(), "TMP")) }
    let ran = process::run(f"{tmp.path().to_text()}/use", []; dir: tmp.path().to_text(), env: [("LD_LIBRARY_PATH", lib.path().to_text())])
    print(ran.stdout)
}
