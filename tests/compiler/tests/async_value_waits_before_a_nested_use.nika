// `let x = async e` is waited for just before the first statement of its
// block that names `x`, nested in an `if` too (ADR-async-5 D6, #986): the
// task is joined before the `if` (#988).

fn load(n: i64) -> i64 {
	return n * 2
}

fn main() {
	let a = async load(1)
	let b = load(2)
	if b > 0 {
		println(f"{a}")
	}
}
