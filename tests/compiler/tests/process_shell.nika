// `process::shell(command)` runs `/bin/sh -c command` and hands back what
// `process::run` would (ADR-raw-sinks-1 §4, #1253). A text written in the
// program is no part from outside, so it needs no proof.

use std::process

fn main() throws {
    let out = process::shell("echo hi; echo there | tr a-z A-Z")
    print(out.stdout)
    println(out.code)
}
