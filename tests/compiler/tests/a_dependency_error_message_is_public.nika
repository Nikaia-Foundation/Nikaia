// #1408: the `message` an error of a dependency writes in its `impl Error`
// is called from another package: Rust sees it `pub`, as the type is,
// not private to the dependency's crate.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/lib/src", f"{tmp.path().to_text()}/app/src"])
    fs::write("lib/nikaia.toml", tmp, "[package]\nname = \"lib\"\nversion = \"0.1.0\"\n")
    fs::write("lib/src/main.nika", tmp, "pub struct Fault {\n    pub why: String,\n}\n\nimpl Error for Fault {\n    fn message(self) -> String {\n        return self.why\n    }\n}\n\npub fn half(n: i64) -> i64 throws {\n    if n % 2 != 0 { throw Fault { why: f\"{n} is odd\" } }\n    return n / 2\n}\n")
    fs::write("app/nikaia.toml", tmp, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nlib = { path = \"../lib\" }\n")
    fs::write("app/src/main.nika", tmp, "use lib\n\nfn quarter(n: i64) -> i64 throws {\n    return lib::half(lib::half(n))\n}\n\nfn main() throws {\n    println(quarter(8))\n    let odd = quarter(6) catch {\n        println(f\"caught: {error.message()}\")\n        return\n    }\n    println(odd)\n}\n")
    let out = process::run(toolchain(), ["run", "src/main.nika"]; dir: f"{tmp.path().to_text()}/app")
    println(out.stdout)
    if out.code != 0 { print(out.stderr.replace(tmp.path().to_text(), "TMP")) }
    println(f"exit {out.code}")
}
