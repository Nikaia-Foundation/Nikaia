// scripts/commit.nika and the shared lowered index (#1709): a staged lowered
// set whose `lowered.rs` is not listed is refused, a staged `lowered.rs` that
// includes another agent's uncommitted lowered file is refused, and a staged
// `LOWERED_DIGEST` computed on the shared tree is rewritten to the digest of
// the set as committed, the one `lower-std` writes there.
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/commit.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/commit.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn git(dir: String, args: Vec[String]) -> String throws {
    let mut all: Vec[String] = ["-c", "user.name=T", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    return process::run("git", all; dir: dir).stdout.trim().clone()
}

fn run_commit(nikaia: String, repo: String, tmp: String) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/commit.nika", "--", f"{tmp}/X.md.report.md"]; dir: tmp.clone(), env: [("GIT_AUTHOR_NAME", "T"), ("GIT_AUTHOR_EMAIL", "t@example.com"), ("GIT_COMMITTER_NAME", "T"), ("GIT_COMMITTER_EMAIL", "t@example.com")])
    return out.stdout.trim().clone()
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let d = "crates/nikaia-std/src/compiler"
    let block = "\n/// **The digest of this lowered set** (#1610): every file `lower-std` wrote\n/// beside this index, and the index above this line. Compiled into the same\n/// crate as the code it names, it is the compiler's identity for its caches.\npub const LOWERED_DIGEST: &str = \""
    git(tmp.clone(), ["init", "-q", "-b", "develop"])
    process::run("mkdir", ["-p", f"{tmp}/{d}/lowered"])
    fs::write(f"{tmp}/{d}/lowered/a.rs", fs::Root::Anywhere, "fn a() {}\n")
    fs::write(f"{tmp}/{d}/lowered.rs", fs::Root::Anywhere, "include!(\"lowered/a.rs\");\n" + block + "0\";\n")
    git(tmp.clone(), ["add", "."])
    git(tmp.clone(), ["commit", "-q", "-m", "base"])
    // Another agent's uncommitted lowered file, which the tree's index includes;
    // its lower-std wrote a digest of the tree, which holds that file.
    fs::write(f"{tmp}/{d}/lowered/b.rs", fs::Root::Anywhere, "fn b() {}\n")
    fs::write(f"{tmp}/{d}/lowered.rs", fs::Root::Anywhere, "include!(\"lowered/a.rs\");\ninclude!(\"lowered/b.rs\");\n" + block + "1\";\n")
    // My own change to a lowered file.
    fs::write(f"{tmp}/{d}/lowered/a.rs", fs::Root::Anywhere, "fn a() { mine() }\n")
    // The lowered file without its index: refused.
    fs::write(f"{tmp}/X.md.report.md", fs::Root::Anywhere, f"Result: done\nFiles: {d}/lowered/a.rs\nCommit: mine\nChangelog: none\nPushed: none\n")
    println(run_commit(nikaia.clone(), repo.clone(), tmp.clone()))
    // The whole index, with the other agent's include: refused.
    fs::write(f"{tmp}/X.md.report.md", fs::Root::Anywhere, f"Result: done\nFiles: {d}/lowered/a.rs {d}/lowered.rs\nCommit: mine\nChangelog: none\nPushed: none\n")
    println(run_commit(nikaia.clone(), repo.clone(), tmp.clone()))
    git(tmp.clone(), ["restore", "--staged", f"{d}/lowered.rs"])
    // Only the digest hunk staged: committed with the digest of the set as committed.
    fs::write(f"{tmp}/p.diff", fs::Root::Anywhere, f"--- a/{d}/lowered.rs\n+++ b/{d}/lowered.rs\n@@ -5 +5 @@\n-pub const LOWERED_DIGEST: &str = \"0\";\n+pub const LOWERED_DIGEST: &str = \"1\";\n")
    git(tmp.clone(), ["apply", "--cached", "p.diff"])
    fs::write(f"{tmp}/X.md.report.md", fs::Root::Anywhere, f"Result: done\nFiles: {d}/lowered/a.rs\nPartial: {d}/lowered.rs\nCommit: mine\nChangelog: none\nPushed: none\n")
    let out = run_commit(nikaia.clone(), repo.clone(), tmp.clone())
    // The digest `lower-std` writes on the committed tree, by sha256sum.
    let script = f"cd {d} && {{ git show HEAD:./lowered.rs | head -n -5 | sha256sum | cut -c1-64; for p in lowered/a.rs; do echo $p; git show HEAD:./$p | sha256sum | cut -c1-64; done; }} | sha256sum | cut -c1-64"
    let want = process::run("sh", ["-c", script]; dir: tmp.clone()).stdout.trim().clone()
    println(out.replace(want.clone(), "DIGEST").replace(git(tmp.clone(), ["rev-parse", "--short=8", "HEAD"]), "SHA8"))
    println("committed:")
    println(git(tmp.clone(), ["show", f"HEAD:{d}/lowered.rs"]).replace(want, "DIGEST"))
    println("left in the tree:")
    println(git(tmp.clone(), ["status", "--short"]))
    process::run("rm", ["-rf", tmp])
}
