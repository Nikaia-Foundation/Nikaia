/// **A private method takes its bounds from its callers** (ADR-391 D1):
/// every call of `upto` hands an `at` no larger than the receiver's
/// `arms.len()`, so `self.arms[before]` needs no check; `first_of` takes
/// `at < xs.len()` for its list parameter. One call of `over` hands one too
/// many, so `self.arms[k]` keeps its check.
struct Table {
	arms: Vec[i64],
}

impl Table {
	// Every caller passes `at <= self.arms.len()`.
	fn upto(ref self, at: i64) -> i64 {
		let mut before = 0
		let mut sum = 0
		while before < at {
			sum += self.arms[before]
			before += 1
		}
		return sum
	}

	// A list parameter beside `self`.
	fn first_of(ref self, xs: ref Vec[i64], at: i64) -> i64 {
		if at < 0 { return 0 }
		return xs[at] + self.arms.len()
	}

	// One caller passes one too many: its check stays.
	fn over(ref self, at: i64) -> i64 {
		let mut k = 0
		let mut sum = 0
		while k + 1 < at {
			sum += self.arms[k]
			k += 1
		}
		return sum
	}

	fn run(ref self) -> i64 {
		let n = self.arms.len()
		let mut total = self.upto(n)
		let mut k = 0
		while k < self.arms.len() {
			total += self.upto(k)
			total += self.first_of(self.arms, k)
			k += 1
		}
		total += self.over(n + 1)
		return total
	}
}

fn main() throws {
	let t = Table { arms: [1, 2, 3] }
	println(t.run())
	let u = Table { arms: [4, 5] }
	println(u.upto(u.arms.len()))
}
