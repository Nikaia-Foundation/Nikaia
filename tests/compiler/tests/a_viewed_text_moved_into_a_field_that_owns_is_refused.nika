struct View { head: String }
struct Cursor { input: String, pos: i64 }

fn parse(t: String) -> View {
    return View { head: t }
}

fn advance(mut c: Cursor) {
    c.input.push_str("!")
    println(c.input)
}

// ADR-353 D9 (#942): `advance` changes a `Cursor`'s `input` in place, so that
// field must own its text; `text` moved there while `v` still reads it is
// refused at the move.
fn main() {
    let n = 1
    let text = f"a: {n}"
    let v = parse(text)
    let c = Cursor { input: text, pos: 0 }
    println(f"{c.pos}")
    println(v.head)
    println(c.input)
    let other = f"b: {n}"
    advance(Cursor { input: other, pos: 1 })
}
