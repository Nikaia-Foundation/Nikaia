// An index is an `i64` (or a narrower integer) the access converts, a key goes
// through untouched, a text range is converted at both ends, and a negative
// index stops the program naming the index, not the number `as usize` would
// have made of it (ADR-298 D1). Moved from the `nikaia-std` unit tests
// `index::tests::*` (#2082).
use std::collections
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run(
        "sh",
        [
            "-c",
            "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
        ],
    ).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let xs = [10, 20, 30]
    let two: i64 = 2
    let none: i32 = 0
    println(f"{xs[two]} {xs[none]}")
    let mut counts: collections::HashMap[String, i64] = collections::HashMap()
    counts.insert("host", 7)
    println(f"{counts["host"] ?? -1}")
    let text = "abcdef"
    let b = text.find("b") ?? return
    let d = text.find("d") ?? return
    println(f"{text.between(b.start, d.start)} {text.between(b.start, d.end)}")
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    fs::write(
        f"{tmp}/neg.nika",
        fs::Root::Anywhere,
        "use std::cli\n\nfn main() throws {\n    let xs = [10, 20, 30]\n    let mut i = -2\n    for _ in cli::args() { i += 1 }\n    println(xs[i])\n}\n",
    )
    let out = process::run(
        "sh",
        ["-c", "\"$0\" run --unproved-claims=warn neg.nika", toolchain()]; dir: tmp.clone(),
    )
    println(f"exit {out.code}")
    for line in out.stderr.lines() {
        if line.contains("the program stopped") {
            println(line)
            println(f"wrapped: {line.contains("18446744073709551615")}")
        }
    }
    process::run("rm", ["-rf", tmp])
}
