// An `impl` of a trait whose result writes `from a` hands back the parameter
// `b` it takes by value: NK2302 refuses it in the trait's words (ADR-views-3
// D14), and the checker adds no NK1104 asking for `ref`, which left the
// language (D4) (#1386). A type with no text in it is no view source, so
// handing it back where a view is declared stays an NK1104.

trait Pick {
    fn pick(self, a: String, b: String) -> String from a
}

trait PickAll {
    fn pick_all(self, a: Vec[i64], b: Vec[i64]) -> Vec[i64] from a
}

struct Named {
    s: String
}

trait PickNamed {
    fn pick_named(self, a: Named, b: Named) -> Named from a
}

struct Number {
    n: i64
}

trait PickNumber {
    fn pick_number(self, a: Number, b: Number) -> Number from a
}

struct P {
    k: i64
}

impl Pick for P {
    fn pick(self, a: String, b: String) -> String from a {
        return b
    }
}

impl PickAll for P {
    fn pick_all(self, a: Vec[i64], b: Vec[i64]) -> Vec[i64] from a {
        b
    }
}

impl PickNamed for P {
    fn pick_named(self, a: Named, b: Named) -> Named from a {
        return b
    }
}

impl PickNumber for P {
    fn pick_number(self, a: Number, b: Number) -> Number from a {
        return b
    }
}

fn main() throws {
    let p = P { k: 1 }
    println(p.pick("x", "y"))
    println(p.pick_all([1], [2]).len())
    println(p.pick_named(Named { s: f"x" }, Named { s: f"y" }).s)
    println(p.pick_number(Number { n: 1 }, Number { n: 2 }).n)
}
