// An `impl` of a trait whose result writes `from a` hands back the plain
// parameter `b`: refused once, in the trait's words (ADR-views-3 D14), and
// the checker adds no NK1104 asking for `ref`, which left the language (D4)
// (#1386). `b` is lent (ADR-277 D17, #1498), so it is NK1335's view outside
// the `from`, for a type of any kind (D12), one with no text in it too.

trait Pick {
    fn pick(self, a: String, b: String) -> String from a
}

trait PickAll {
    fn pick_all(self, a: Vec[i64], b: Vec[i64]) -> Vec[i64] from a
}

struct Named {
    s: String
}

trait PickNamed {
    fn pick_named(self, a: Named, b: Named) -> Named from a
}

struct Number {
    n: i64
}

trait PickNumber {
    fn pick_number(self, a: Number, b: Number) -> Number from a
}

struct P {
    k: i64
}

impl Pick for P {
    fn pick(self, a: String, b: String) -> String from a {
        return b
    }
}

impl PickAll for P {
    fn pick_all(self, a: Vec[i64], b: Vec[i64]) -> Vec[i64] from a {
        b
    }
}

impl PickNamed for P {
    fn pick_named(self, a: Named, b: Named) -> Named from a {
        return b
    }
}

impl PickNumber for P {
    fn pick_number(self, a: Number, b: Number) -> Number from a {
        return b
    }
}

fn main() throws {
    let p = P { k: 1 }
    println(p.pick("x", "y"))
    println(p.pick_all([1], [2]).len())
    println(p.pick_named(Named { s: f"x" }, Named { s: f"y" }).s)
    println(p.pick_number(Number { n: 1 }, Number { n: 2 }).n)
}
