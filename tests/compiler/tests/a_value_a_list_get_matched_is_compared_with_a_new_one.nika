// A value a list's `get` hands to a `match` arm is lent, bound straight from
// the call or through a `let`, and `==` with a value made fresh compares them
// (#1609: rustc refused `&P == P`).
struct P {
	name: String,
}

fn make() -> P {
	let mut g = String()
	g.push_str("a")
	return P { name: g }
}

fn main() throws {
	let mut xs: Vec[P] = []
	xs.push(make())
	match xs.get(0) {
		null => println("none"),
		y => {
			if y == make() {
				println("same")
			} else {
				println("other")
			}
		},
	}
	let o = xs.get(0)
	match o {
		null => println("none"),
		y => {
			if y == make() {
				println("same")
			} else {
				println("other")
			}
		},
	}
	let c: P? = xs.get(0)?.clone()
	match c {
		null => println("none"),
		y => println(y.name),
	}
}
