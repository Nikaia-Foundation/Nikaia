/// A call `self.kind(t)` to the type's own method reads its result summary
/// in the bounds walk (ADR-359 D14, #1904), and the exit that reads a field
/// gives no fact without dropping the summary: the exit `0` when
/// `t.len() != 1` proves `t[0]` past `k == 0`.
struct Reader {
	base: i64,
}

impl Reader {
	fn kind(ref self, t: ref Vec[i64]) -> i64 sync {
		if t.len() != 1 {
			return 0
		}
		return self.base + 1
	}

	pub fn first(ref self, t: ref Vec[i64]) -> i64 sync {
		let k = self.kind(t)
		if k == 0 {
			return self.base
		}
		return t[0]
	}
}

fn main() throws {
	let r = Reader { base: 9 }
	let one: Vec[i64] = [4]
	println(f"{r.first(one)}")
}
