// The doors of one shared value and of two (ADR-281 D1, D2, D18): `get`,
// `set`, `update` and `access` on a value; `access_all` and `update_all`
// over two, which take the two locks in one order whichever is written
// first, so two tasks moving amounts both ways keep the total and never
// wait for each other for ever. The values cross to `spawn`s, so at
// `user_parallelism = yes` they are the crossing shape and at `no` the plain
// one; four tasks adding to one list lose no step.
fn move_left(a: SharedMut[i64], b: SharedMut[i64]) -> i64 {
	for _ in 0..<400 {
		update_all(a, b) fn(mut from, mut to) {
			from -= 1
			to += 1
		}
	}
	return 400
}

fn move_right(a: SharedMut[i64], b: SharedMut[i64]) -> i64 {
	for _ in 0..<400 {
		update_all(b, a) fn(mut from, mut to) {
			from -= 1
			to += 1
		}
	}
	return 400
}

fn count(n: SharedMut[Vec[i64]]) -> i64 {
	for _ in 0..<1000 {
		n.update fn(mut v) { v[0] += 1 }
	}
	return 1000
}

fn main() throws {
	let n: SharedMut[Vec[i64]] = SharedMut([1])
	let seen = spawn fn { n.get().len() }
	println(f"get: {seen.join()}")
	n.set([15])
	n.update fn(mut v) { v[0] += 100 }
	let read = n.access fn(v) { v[0] }
	println(f"set, update, access: {read}")

	let a = SharedMut(5)
	let b = SharedMut(7)
	let one = access_all(a, b) fn(x, y) { x * 10 + y }
	let other = access_all(b, a) fn(y, x) { x * 10 + y }
	println(f"the two orders: {one} {other}")

	let name = SharedMut("kasse")
	let cash = SharedMut(5)
	let said = access_all(name, cash) fn(s, c) { f"{s} {c}" }
	println(f"two types: {said}")

	let left = SharedMut(1000)
	let right = SharedMut(1000)
	let l = spawn fn { move_left(left, right) }
	let r = spawn fn { move_right(left, right) }
	let moved = l.join() + r.join()
	println(f"both ways keep the total: {left.get() + right.get()} ({moved} moves)")

	let total: SharedMut[Vec[i64]] = SharedMut([0])
	let t1 = spawn fn { count(total) }
	let t2 = spawn fn { count(total) }
	let t3 = spawn fn { count(total) }
	let t4 = spawn fn { count(total) }
	let steps = t1.join() + t2.join() + t3.join() + t4.join()
	println(f"four tasks: {total.access fn(v) { v[0] }} ({steps} steps)")
}
