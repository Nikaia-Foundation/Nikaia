// #1533, ADR-326 D7: the body's rate counts from its first byte, not from
// the end of the head. A client that sends the head, waits longer than the
// start-up period (two seconds) and then sends the whole body at once keeps
// the rate and is answered `200`. The wait before the first byte is held to
// `idle_timeout` (D8). The server runs in a package of its own that depends
// on `examples/http` by path.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let repo = process::run("git", ["rev-parse", "--show-toplevel"]).stdout.trim().clone()
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    process::run("mkdir", ["-p", f"{tmp}/app/src"])
    fs::write(f"{tmp}/app/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nhttp = { path = \"" + repo + "/examples/http\" }\n")
    fs::write(f"{tmp}/app/src/main.nika", fs::Root::Anywhere, "use http\nuse std::net\nuse std::time\n\nfn free() -> String throws {\n\tlet probe = net::listen(\"127.0.0.1:0\")\n\treturn probe.address()\n}\n\n// What the server sent until it closed, as its first line and its last.\nfn until_closed(mut conn: net::Connection) -> String throws {\n\tlet mut got = String()\n\twhile true {\n\t\tlet more = conn.read()\n\t\tif more.len() == 0 {\n\t\t\tbreak\n\t\t}\n\t\tgot.push_str(more.text())\n\t}\n\tif got.len() == 0 {\n\t\treturn \"closed without an answer\"\n\t}\n\tlet lines: Vec[String] = got.lines().collect()\n\treturn f\"{lines[0]} / {lines[lines.len() - 1]}\"\n}\n\n// The server binds after this task starts: wait for it to listen.\nfn dial(at: String) -> net::Connection throws {\n\tlet mut tries = 0\n\twhile tries < 500 {\n\t\tlet conn = net::connect(at) catch {\n\t\t\ttries += 1\n\t\t\ttime::sleep(10.millis())\n\t\t\tcontinue\n\t\t}\n\t\treturn conn\n\t}\n\treturn net::connect(at)\n}\n\n// The head, then a wait past the start-up period, then the whole body.\nfn clients(at: String) throws {\n\tlet mut late = dial(at)\n\tlate.write(\"POST /late HTTP/1.1\\r\\nhost: x\\r\\ncontent-length: 100\\r\\nconnection: close\\r\\n\\r\\n\")\n\ttime::sleep(2500.millis())\n\tlate.write(\"a body that begins late and then arrives at once, all one hundred bytes of it in a single write ....\")\n\tprintln(f\"a body that begins late: {until_closed(late)}\")\n}\n\nfn main() throws {\n\tlet at = free()\n\tlet copy = at.clone()\n\tlet client = spawn fn { clients(copy) }\n\thttp::listen(at; head_timeout: 400.millis(), body_bytes_per_second: 50, connections: 1) fn(request) {\n\t\treturn http::Response::text(f\"answered {request.path()} with {request.body().len()} bytes\")\n\t}\n\tclient.join()\n\tprintln(\"listen returned after one connection\")\n}\n")
    let out = process::run(toolchain(), ["run"]; dir: f"{tmp}/app")
    for line in out.stdout.lines() {
        if !line.starts_with("http: listening on ") {
            println(line)
        }
    }
    println(f"exit {out.code}")
    if out.code != 0 {
        println(out.stderr.replace(tmp, "TMP"))
    }
    process::run("rm", ["-rf", tmp])
}
