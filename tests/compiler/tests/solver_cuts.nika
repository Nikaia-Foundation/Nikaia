// Certified cuts (ADR-270 D5, #1284 item 1): problems over the simplex
// whose rational relaxation holds and whose integer one does not, refuted
// by the GCD test of a tableau row, by Gomory's fractional cut (a
// Chvátal-Gomory derivation: a combination rounded) and by Gomory's
// mixed-integer cut (a split cut: the split, one Farkas lemma per side, and
// the resolution), and by branch-and-bound alone for comparison. Each line
// counts the log's steps by kind and says whether `sv_check` replays it;
// the simplex is exact, so a cut is written as it was found. Then each kind
// broken: a rounding left out, and a mixed-integer cut made one too strong
// (its constant rounded the wrong way), each log rejected. The logic
// layer's files, `solver/sv_*.nika` and the driver below make one program,
// as `scripts/solver.nika` makes it.
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
		],
	).stdout.trim().clone()
	if exe.len() > 0 { return exe }
	return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "fn row1(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn le(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row1(ks, c), rel: SvRel::Le }
}

fn eq(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row1(ks, c), rel: SvRel::Eq }
}

// The log's steps by kind: Farkas, Combine, Round, Split, Learn.
fn kinds(steps: ref Vec[SvStep]) -> String {
	let mut f = 0
	let mut c = 0
	let mut r = 0
	let mut s = 0
	let mut l = 0
	for st in steps {
		match st {
			SvStep::Farkas(..) => { f += 1 },
			SvStep::Combine(..) => { c += 1 },
			SvStep::Round(..) => { r += 1 },
			SvStep::Split(..) => { s += 1 },
			SvStep::Learn(..) => { l += 1 },
			else => {},
		}
	}
	return f\"{f} farkas, {c} combine, {r} round, {s} split, {l} learn\"
}

// The log with one step broken: `round` the first rounding by 1, `strong`
// the cut's split (the second) one too strong.
fn broken(steps: ref Vec[SvStep], how: String) -> Vec[SvStep] {
	let mut out: Vec[SvStep] = []
	let mut rounds = 0
	let mut splits = 0
	for st in steps {
		let mut next = st.clone()
		match st {
			SvStep::Round(id, d) => {
				rounds += 1
				if how == \"round\" && rounds == 1 {
					next = SvStep::Round(id, 1)
				}
			},
			SvStep::Split(a, b) => {
				splits += 1
				if how == \"strong\" && splits == 2 {
					let hold = sv_row_sum(1, a, 1, sv_row_constant(1)) ?? a.clone()
					let fail = sv_row_sum(1, b, 1, sv_row_constant(-1)) ?? b.clone()
					next = SvStep::Split(hold, fail)
				}
			},
			else => {},
		}
		out.push(next)
	}
	return out
}

// Every atom asserted, one level, then a final check under `kind`
// (`gcd`: the GCD test alone; `cg`, `gmi`: the test and that cut;
// `branch`: neither); a conflict closed by one learned clause, the log
// replayed, broken as `how` says where it is not `\"\"`.
fn run(title: String, names: Vec[String], atoms: Vec[SvAtom], kind: String, how: String) {
	let n = atoms.len()
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	while (a as i64) < n {
		clauses.push([sv_lit(a, false)])
		a += 1
	}
	let query = SvQuery { atoms: atoms, clauses: clauses, columns: names.len().checked_u32() ?? 0, reals: [] }
	let mut book = sv_book(query) ?? return
	let mut inputs: Vec[u32] = []
	let mut i: u32 = 0
	while (i as i64) < n {
		inputs.push(book.input(i))
		i += 1
	}
	let budget = lg_budget()
	let mut theory = sv_simplex(names)
	theory.gcd_test = kind != \"branch\"
	theory.cut_kind = if kind == \"cg\" || kind == \"gmi\" { kind.clone() } else { \"none\" }
	theory.push_level()
	let mut got = SvChecked::Consistent
	let mut j: u32 = 0
	while (j as i64) < n {
		got = theory.assert(sv_lit(j, false), book)
		match got {
			SvChecked::Consistent => {},
			else => {
				break
			},
		}
		j += 1
	}
	match got {
		SvChecked::Consistent => {
			got = theory.check(true, budget, book)
		},
		else => {},
	}
	let work = f\"{theory.splits} splits, {theory.cuts} cuts, {theory.gcd_conflicts} gcd\"
	match got {
		SvChecked::Conflict(c) => {
			let mut hints: Vec[u32] = []
			for l in c.lits {
				hints.push(inputs[(l / 2) as i64])
			}
			hints.push(c.id)
			book.learn([], hints)
			let steps = if how == \"\" { book.log.steps.clone() } else { broken(book.log.steps, how) }
			let v = sv_check(query, steps)
			let said = if v.ok { \"checked\" } else { f\"rejected at {v.step}: {v.reason}\" }
			let label = if how == \"\" { kind.clone() } else { f\"{kind}, {how}\" }
			println(f\"  {label}: conflict, {work}; {kinds(steps)}; {said}\")
		},
		SvChecked::Consistent => {
			let mut values: Vec[String] = []
			for (name, v) in theory.model() {
				values.push(f\"{name} = {v}\")
			}
			println(f\"  {kind}: consistent, {values.join(\", \")}, {work}\")
		},
		SvChecked::Unknown(why) => {
			println(f\"  {kind}: {sv_unknown(why)}, {work}\")
		},
		else => {
			println(f\"  {kind}: lemmas, {work}\")
		},
	}
}

fn every(title: String, names: Vec[String], atoms: Vec[SvAtom]) {
	println(title)
	for kind in [\"gcd\", \"cg\", \"gmi\", \"branch\"] {
		run(title.clone(), names.clone(), atoms.clone(), kind.to_string(), \"\")
	}
}

fn main() throws {
	every(\"x = y, x + y - 2z = 1\", [\"x\", \"y\", \"z\"], [eq([1, -1], 0), eq([1, 1, -2], -1)])
	every(\"1 <= 3x - 3y <= 2, 0 <= x, y <= 3\", [\"x\", \"y\"], [le([-3, 3], 1), le([3, -3], -2), le([-1], 0), le([1], -3), le([0, -1], 0), le([0, 1], -3)])
	every(\"1 <= 3x + 5y <= 2, 0 <= x, y <= 1\", [\"x\", \"y\"], [le([-3, -5], 1), le([3, 5], -2), le([-1], 0), le([1], -1), le([0, -1], 0), le([0, 1], -1)])
	every(\"2x + 3y = 7, x >= 0, y >= 0\", [\"x\", \"y\"], [eq([2, 3], -7), le([-1], 0), le([0, -1], 0)])
	println(\"broken: the first rounding by 1 (none), the mixed-integer cut one too strong\")
	run(\"\", [\"x\", \"y\", \"z\"], [eq([1, -1], 0), eq([1, 1, -2], -1)], \"gcd\", \"round\")
	run(\"\", [\"x\", \"y\"], [le([-3, -5], 1), le([3, 5], -2), le([-1], 0), le([1], -1), le([0, -1], 0), le([0, 1], -1)], \"cg\", \"round\")
	run(\"\", [\"x\", \"y\"], [le([-3, -5], 1), le([3, 5], -2), le([-1], 0), le([1], -1), le([0, -1], 0), le([0, 1], -1)], \"gmi\", \"strong\")
}
"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain(repo.clone())
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_smt", "sv_smtlib", "sv_rod"] {
		paths.push(f"{repo}/crates/nikaia-std/src/solver/{name}.nika")
	}
	let mut uses: Vec[String] = []
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver())
	let args: Vec[String] = ["run", "main.nika"]
	let out = process::run(nikaia, args; dir: tmp.clone())
	println(out.stdout.trim())
	process::run("rm", ["-rf", tmp])
}
