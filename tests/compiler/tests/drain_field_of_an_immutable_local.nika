use std::collections

struct Tally {
    counts: collections::HashMap[String, i64],
}

struct Bag {
    items: collections::BTreeMap[String, i64],
}

fn main() {
    let mut m: collections::HashMap[String, i64] = collections::HashMap()
    m.insert("a", 2)
    let t = Tally { counts: m }
    let mut n = 0
    for (k, v) in t.counts.drain() {
        n += v + k.len()
    }
    println(f"{n}")

    let mut b: collections::BTreeMap[String, i64] = collections::BTreeMap()
    b.insert("xy", 5)
    let bag = Bag { items: b }
    for (k, v) in bag.items.drain() {
        println(f"{k} {v}")
    }
}
