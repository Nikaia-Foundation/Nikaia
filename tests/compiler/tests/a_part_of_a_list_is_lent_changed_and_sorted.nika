// A part of a list goes to a lent and a `mut` `Array[T]`, a part sorts in
// place and a list fills (ADR-views-3 D11, #1209).

fn sum(xs: Array[u32]) -> u32 {
    let mut s: u32 = 0
    for x in xs { s += x }
    return s
}

fn zero(mut xs: Array[u32]) {
    for i in 0..<xs.len() { xs[i] = 0 }
}

fn main() {
    let mut v: Vec[u32] = [1, 2, 3, 4]
    print(f"{sum(v[1..<4])} ")
    zero(v[1..<3])
    print(f"{sum(v[1..<3])} ")
    v[2..<4].sort()
    v.fill(4)
    println(f"{v[0]}")
}
