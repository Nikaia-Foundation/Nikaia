// A word read from a `Bytes` outside it stops as the cut does, with the cut's
// message and the program's line (ADR-320 D12, ADR-300 D10): one past the end
// and one before the start. Moved from the `nikaia-std` unit tests
// `bytes::tests::{a_word_past_the_end_stops, a_word_before_the_start_stops}`
// (#2082).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn stops(text: String) -> String {
    for line in text.lines() {
        if line.contains("the program stopped") {
            return line.clone()
        }
    }
    return "(no stop)"
}

fn main() throws {
    let tmp = fs::scratch()
    fs::write(
        "word.nika",
        tmp,
        "use std::cli\n\nfn main() throws {\n    let mut n = 0\n    for a in cli::args() { n += 1 }\n    let b = Bytes([0, 0, 0, 0, 0, 0, 0, 0])\n    if n == 2 {\n        println(b.u64_le(1))\n    }\n    if n == 3 {\n        println(b.u32_le(n - 4))\n    }\n}\n",
    )
    for args in ["past", "before start"] {
        let out = process::run(
            "sh",
            ["-c", f"\"$0\" run word.nika -- {args}", toolchain()]; dir: tmp.path().to_text(),
        )
        println(f"{args}: exit {out.code}, {out.stdout.trim()}{stops(out.stderr)}")
    }
}
