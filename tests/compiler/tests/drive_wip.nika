// scripts/drive.nika --wip-after and --found-issue (owner, 2026-11-06): what
// a run's end does to its issue's `wip` label by the report's Result and
// Fixes (keep, block, remove), and the title, labels and body of an issue the
// driver files from a report's `Found:`; --improve-issue (owner, 2026-11-15):
// the issue it files for the improvement lane from a report's `Issue:`,
// `Deviation:`, `Needs:` and `Friction:`, and `none` for a clean report;
// --comment-issue (#1698): the comment it posts on issue N for a report's
// `Comment: #N <text>`, and a `Comment:` without a number filed as improvement;
// an improvement issue names the run's report and commit (#1706); an `Issue:`
// answer marked `(built)` is not filed (#1739), nor one that says nothing was
// missing (`meets I1-I13`, #1753; `fits docs/issues.md`, #1837); a
// `Needs: supervisor decision: <gap>` without a Found is filed as the Found,
// not here (#1744); a Found that says `no decision yet` is labelled `decision` (#1745);
// --found-issues: a report's `Needs:` goes with its only Found, not with
// each of several (#1769); an improvement issue quotes the run's Found
// lines, with the issue numbers found.txt pairs them with (#1783), and
// the whole report, which may be gone from docs/briefs/ (#1791). A `broke I<n>`
// answer goes to the run's issue (#1818, drive_improve_plan). A Found that
// names a scratchpad path is filed with a note that its probe is gone (#1824).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn drive(repo: String, nikaia: String, args: Vec[String]) throws {
    let mut all: Vec[String] = ["run", "scripts/drive.nika", "--"]
    for a in args { all.push(a.clone()) }
    let out = process::run(nikaia, all; dir: repo)
    if !out.ok { println(f"drive.nika failed, code {out.code}: {out.stderr.trim()}") }
    println(out.stdout.trim())
}

// A hook that takes a report reads it on standard input (#2577).
fn drive_in(repo: String, nikaia: String, args: Vec[String], text: String) throws {
    let mut all: Vec[String] = ["run", "scripts/drive.nika", "--"]
    for a in args { all.push(a.clone()) }
    let out = process::run(nikaia, all; dir: repo, stdin: process::Input::Text(text))
    if !out.ok { println(f"drive.nika failed, code {out.code}: {out.stderr.trim()}") }
    println(out.stdout.trim())
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "done", "#1267", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "done", "#1260, #1267", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "done", "none", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "blocked", "none", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "partial: two items left", "#1267", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "", "", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--found-issue", "issue-1267", "1267", "a Bytes field filled from a[1..] fails at rustc (Into &[u8] -> Bytes), not covered by the issue", "none"])
    drive(repo.clone(), nikaia.clone(), ["--found-issue", "v45-x", "", "a short gap", "supervisor decision"])
    // A Found that says it has no decision is a `decision` issue (#1745).
    drive(repo.clone(), nikaia.clone(), ["--found-issue", "v45-y", "", "a struct result's fields: no decision yet in ADR-306", "none"])
    // A Found that names its probe by a scratchpad path says it is gone (#1824).
    drive(repo.clone(), nikaia.clone(), ["--found-issue", "issue-1751", "1751", "a churn of SharedMut runs over the budget: /tmp/claude-0/x/scratchpad/issue-1751/p.nika", "none"])
    // A report with two Founds gives neither its one `Needs:` (#1769).
    let reports = fs::scratch()
    fs::write("two.md", reports, "Result: done\nFound: guide/views.md example uses the old ref syntax\nFound: NK1131 refuses a lent field\nNeeds: group D of #1531\n")
    drive_in(repo.clone(), nikaia.clone(), ["--found-issues", "issue-1675", "1675"], fs::read_to_string("two.md", reports))
    fs::write("bad.md", reports, "Result: done\nCommit: drive: a partial run stays in batch.txt\nPushed: local 1a827e65\nIssue: wrong I8: item 3 was built already\nDeviation: none\nNeeds: none\nFriction: pre-push red on a badge that was not mine\n")
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1624", "1624"], fs::read_to_string("bad.md", reports))
    fs::write("good.md", reports, "Result: done\nIssue: complete\nDeviation: none\nNeeds: none\nFriction: none\n")
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1625", "1625"], fs::read_to_string("good.md", reports))
    drive_in(repo.clone(), nikaia.clone(), ["--comment-issue", "issue-1625", "1625"], fs::read_to_string("good.md", reports))
    fs::write("said.md", reports, "Result: done\nNeeds: none\nComment: #1531 group D waits on group C, from #1634\nComment: none\nComment: on the plan, no number\n")
    drive_in(repo.clone(), nikaia.clone(), ["--comment-issue", "issue-1676", "1676"], fs::read_to_string("said.md", reports))
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1676", ""], fs::read_to_string("said.md", reports))
    fs::write("built.md", reports, "Result: done\nIssue: rules-gap (built): no rule said an item needs no GitHub; wrong I5: the probe passed\nFriction: none\n")
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1707", "1707"], fs::read_to_string("built.md", reports))
    fs::write("built.md", reports, "Result: done\nIssue: rules-gap (built): no rule said an item needs no GitHub\nFriction: none\n")
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1708", "1708"], fs::read_to_string("built.md", reports))
    fs::write("built.md", reports, "Result: done\nIssue: meets I1-I13; complete\nFriction: none\n")
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1740", "1740"], fs::read_to_string("built.md", reports))
    fs::write("built.md", reports, "Result: done\nIssue: Fits docs/issues.md; item 3's cause turned out to be a compiler defect\nFriction: none\n")
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1820", "1820"], fs::read_to_string("built.md", reports))
    fs::write("built.md", reports, "Result: blocked\nFound: none\nNeeds: supervisor decision: ADR-306 has no rule for a struct result's fields\nFriction: none\n")
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1557", "1557"], fs::read_to_string("built.md", reports))
    let batch = fs::scratch()
    fs::write("found.txt", batch, "issue-1700: filed #9\nissue-1749: filed #1801\nissue-1749: filed #1802\n")
    fs::write("built.md", reports, "Result: done\nFound: `xs.sort_by(f)` on an untyped list is NK1171\nFound: none\nFound: a stale guide example\nIssue: rules-gap: the second defect, see Found\nFriction: none\n")
    drive_in(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1749", "1749", batch.path().to_text()], fs::read_to_string("built.md", reports))
    fs::write("found.txt", batch, "issue-1749: filed #1801\n")
    drive_in(repo, nikaia, ["--improve-issue", "issue-1749", "1749", batch.path().to_text()], fs::read_to_string("built.md", reports))
}
