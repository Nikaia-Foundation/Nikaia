// scripts/drive.nika --wip-after and --found-issue (owner, 2026-11-06): what
// a run's end does to its issue's `wip` label by the report's Result and
// Fixes (keep, block, remove), and the title, labels and body of an issue the
// driver files from a report's `Found:`; --improve-issue (owner, 2026-11-15):
// the issue it files for the improvement lane from a report's `Issue:`,
// `Deviation:`, `Needs:` and `Friction:`, and `none` for a clean report;
// --comment-issue (#1698): the comment it posts on issue N for a report's
// `Comment: #N <text>`, and a `Comment:` without a number filed as improvement;
// an improvement issue names the run's report and commit (#1706); an `Issue:`
// answer marked `(built)` is not filed (#1739), nor one that says nothing was
// missing (`meets I1-I13`, #1753); a `Needs: supervisor
// decision: <gap>` without a Found is filed as the Found, not here (#1744);
// a Found that says `no decision yet` is labelled `decision` (#1745);
// --found-issues: a report's `Needs:` goes with its only Found, not with
// each of several (#1769); an improvement issue quotes the run's Found
// lines, with the issue numbers found.txt pairs them with (#1783), and
// the whole report, which may be gone from docs/briefs/ (#1791).
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/drive.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/drive.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn drive(repo: String, nikaia: String, args: Vec[String]) throws {
    let mut all: Vec[String] = ["run", "scripts/drive.nika", "--"]
    for a in args { all.push(a.clone()) }
    let out = process::run(nikaia, all; dir: repo)
    if !out.ok { println(f"drive.nika failed, code {out.code}: {out.stderr.trim()}") }
    println(out.stdout.trim())
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "done", "#1267", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "done", "#1260, #1267", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "done", "none", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "blocked", "none", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "partial: two items left", "#1267", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--wip-after", "", "", "1267"])
    drive(repo.clone(), nikaia.clone(), ["--found-issue", "issue-1267", "1267", "a Bytes field filled from a[1..] fails at rustc (Into &[u8] -> Bytes), not covered by the issue", "none"])
    drive(repo.clone(), nikaia.clone(), ["--found-issue", "v45-x", "", "a short gap", "supervisor decision"])
    // A Found that says it has no decision is a `decision` issue (#1745).
    drive(repo.clone(), nikaia.clone(), ["--found-issue", "v45-y", "", "a struct result's fields: no decision yet in ADR-306", "none"])
    // A report with two Founds gives neither its one `Needs:` (#1769).
    let two = process::run("mktemp", []).stdout.trim().clone()
    fs::write(two.clone(), fs::Root::Anywhere, "Result: done\nFound: guide/views.md example uses the old ref syntax\nFound: NK1131 refuses a lent field\nNeeds: group D of #1531\n")
    drive(repo.clone(), nikaia.clone(), ["--found-issues", "issue-1675", "1675", two.clone()])
    process::run("rm", ["-f", two])
    let bad = process::run("mktemp", []).stdout.trim().clone()
    fs::write(bad.clone(), fs::Root::Anywhere, "Result: done\nCommit: drive: a partial run stays in batch.txt\nPushed: local 1a827e65\nIssue: wrong I8: item 3 was built already\nDeviation: none\nNeeds: none\nFriction: pre-push red on a badge that was not mine\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1624", "1624", bad.clone()])
    let good = process::run("mktemp", []).stdout.trim().clone()
    fs::write(good.clone(), fs::Root::Anywhere, "Result: done\nIssue: complete\nDeviation: none\nNeeds: none\nFriction: none\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1625", "1625", good.clone()])
    drive(repo.clone(), nikaia.clone(), ["--comment-issue", "issue-1625", "1625", good.clone()])
    let said = process::run("mktemp", []).stdout.trim().clone()
    fs::write(said.clone(), fs::Root::Anywhere, "Result: done\nNeeds: none\nComment: #1531 group D waits on group C, from #1634\nComment: none\nComment: on the plan, no number\n")
    drive(repo.clone(), nikaia.clone(), ["--comment-issue", "issue-1676", "1676", said.clone()])
    drive(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1676", "", said.clone()])
    let built = process::run("mktemp", []).stdout.trim().clone()
    fs::write(built.clone(), fs::Root::Anywhere, "Result: done\nIssue: rules-gap (built): no rule said an item needs no GitHub; wrong I5: the probe passed\nFriction: none\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1707", "1707", built.clone()])
    fs::write(built.clone(), fs::Root::Anywhere, "Result: done\nIssue: rules-gap (built): no rule said an item needs no GitHub\nFriction: none\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1708", "1708", built.clone()])
    fs::write(built.clone(), fs::Root::Anywhere, "Result: done\nIssue: meets I1-I13; complete\nFriction: none\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1740", "1740", built.clone()])
    fs::write(built.clone(), fs::Root::Anywhere, "Result: blocked\nFound: none\nNeeds: supervisor decision: ADR-306 has no rule for a struct result's fields\nFriction: none\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1557", "1557", built.clone()])
    let batch = process::run("mktemp", ["-d"]).stdout.trim().clone()
    fs::write(f"{batch}/found.txt", fs::Root::Anywhere, "issue-1700: filed #9\nissue-1749: filed #1801\nissue-1749: filed #1802\n")
    fs::write(built.clone(), fs::Root::Anywhere, "Result: done\nFound: `xs.sort_by(f)` on an untyped list is NK1171\nFound: none\nFound: a stale guide example\nIssue: broke I5: the second defect, see Found\nFriction: none\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-issue", "issue-1749", "1749", built.clone(), batch.clone()])
    fs::write(f"{batch}/found.txt", fs::Root::Anywhere, "issue-1749: filed #1801\n")
    drive(repo, nikaia, ["--improve-issue", "issue-1749", "1749", built.clone(), batch.clone()])
    process::run("rm", ["-rf", bad, good, said, built, batch])
}
