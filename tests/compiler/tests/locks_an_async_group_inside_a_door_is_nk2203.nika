// An `async` form inside a door's block is refused (Part I 8.1.2, Part III
// C.6, NK2203, #677): the block waits for the tasks with the lock held. Said
// once per form, at the outermost. The tasks cannot panic (`same` has no
// panic site), so the door's lambda does not fail (ADR-async-5 D35).
fn same(n: i64) -> i64 sync {
    return n
}

fn main() {
    let a = SharedMut(4)
    a.access fn(x) {
        async {
            let t = async same(x)
            let u = async same(x)
            let r = t + u
        }
    }
}
