// The theory interface (ADR-270 D12, #1282 item 5): its calls one by one on
// three bounds over one column - `assert`, `propagate`, `explain`, `check`
// with a model, a conflict written as a Farkas lemma, `backtrack`, `shared` -
// and the log they leave replayed by `sv_check`; then the smoke files of #1281
// and two of the disjunction family answered by `lg_check` and by the
// CDCL(T) engine of `sv_smt.nika` over the interface (Fourier-Motzkin), each
// *proved* a log `sv_check` accepts. The logic layer's files, `solver/sv_*.nika` and the driver below
// make one program, as `scripts/solver.nika` makes it.
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
		],
	).stdout.trim().clone()
	if exe.len() > 0 { return exe }
	return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "// A file answered both ways: `lg_check`, and the CDCL(T) engine over the
// theory interface with its log replayed by `sv_check`.
fn answer_kind(answer: ref LgAnswer) -> String {
	return match answer {
		LgAnswer::Proved { .. } => \"proved\",
		LgAnswer::Refuted { .. } => \"refuted\",
		LgAnswer::Unknown { why } => sv_unknown(why),
	}
}

fn both(path: String) throws {
	let name = path.split(\"/\").last() ?? path
	let script = match lg_smtlib_read(fs::read_to_string(path.clone(), fs::Root::Anywhere)) {
		LgRead::Script(s) => s.clone(),
		LgRead::Failed(_) => {
			println(f\"{name}: unreadable\")
			return
		},
	}
	let mut arena = script.arena.clone()
	let goal = arena.boolean(false)
	let budget = lg_budget()
	let old = answer_kind(lg_check(arena, script.assertions, goal, budget))
	let run = sv_smt_engine(arena, script.assertions, goal, budget, \"fm\")
	let new = match run.driven {
		SvDriven::Proved(query, steps) => {
			let v = sv_check(query, steps)
			if v.ok { f\"proved, log of {steps.len()} steps checked\" } else { f\"log rejected: {v.reason}\" }
		},
		SvDriven::Answer(answer) => answer_kind(answer),
		SvDriven::RealModel(_) => \"refuted\",
	}
	println(f\"{name}: lg_check {old}; interface {new}\")
}

fn row1(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn lits_text(ls: ref Vec[u32]) -> String {
	let mut parts: Vec[String] = []
	for l in ls {
		parts.push(f\"{l}\")
	}
	return \"[\" + parts.join(\", \") + \"]\"
}

fn said_by(checked: ref SvChecked) -> String {
	return match checked {
		SvChecked::Consistent => \"consistent\",
		SvChecked::Conflict(c) => f\"conflict {lits_text(c.lits)}\",
		SvChecked::Lemmas(ls) => f\"{ls.len()} lemmas\",
		SvChecked::Unknown(why) => sv_unknown(why),
	}
}

// The interface's calls one by one on x <= 2, x <= 5, x >= 3 over one
// column: the conflict of x <= 2 and x >= 3 written as a Farkas lemma, the
// log closed by one learned clause and replayed.
fn calls() {
	let atoms = [
		SvAtom { row: row1([1], -2), rel: SvRel::Le },
		SvAtom { row: row1([1], -5), rel: SvRel::Le },
		SvAtom { row: row1([-1], 3), rel: SvRel::Le },
	]
	let query = SvQuery { atoms: atoms, clauses: [[0], [4]], columns: 1, reals: [] }
	let mut book = sv_book(query) ?? return
	let c0 = book.input(0)
	let c1 = book.input(1)
	let budget = lg_budget()
	let mut theory = sv_theory([\"x\"])
	theory.push_level()
	println(f\"assert x <= 2: {said_by(theory.assert(0, book))}\")
	let implied = theory.propagate(book)
	println(f\"propagate: {lits_text(implied)}\")
	let why = theory.explain(2, book) ?? return
	println(f\"explain x <= 5: {lits_text(why.lits)}\")
	let first = theory.check(true, budget, book)
	let x: i64 = theory.model().get(\"x\") ?? -1
	println(f\"check: {said_by(first)}, model x = {x}\")
	theory.push_level()
	println(f\"assert x >= 3 at level {theory.level()}: {said_by(theory.assert(4, book))}\")
	let conflict = theory.check(true, budget, book)
	println(f\"check: {said_by(conflict)}\")
	theory.backtrack(1)
	let again = theory.check(true, budget, book)
	println(f\"backtrack to 1, check: {said_by(again)}, shared {lits_text(theory.shared())}\")
	match conflict {
		SvChecked::Conflict(c) => {
			book.learn([], [c0, c1, c.id])
		},
		else => {},
	}
	let v = sv_check(query, book.log.steps)
	let said = if v.ok { \"checked\" } else { v.reason.clone() }
	println(f\"log of {book.log.steps.len()} steps: {said}\")
}

fn main() throws {
	calls()
	let mut args: Vec[String] = []
	for a in cli::args() {
		args.push(a)
	}
	for i in 1..<args.len() {
		both(args[i].clone())
	}
}
"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain(repo.clone())
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_walk", "sv_strategy", "sv_smt", "sv_smtlib", "sv_rod"] {
		paths.push(f"{repo}/crates/nikaia-std/src/solver/{name}.nika")
	}
	let mut uses: Vec[String] = []
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver())
	let mut args: Vec[String] = ["run", "main.nika", "--"]
	for file in ["smoke/refused-function", "smoke/sat-interval", "smoke/unsat-bounds", "stress/disjunctions/disjunctions-03", "stress/disjunctions/disjunctions-04"] {
		args.push(f"{repo}/tests/solver/{file}.smt2")
	}
	let out = process::run(nikaia, args; dir: tmp.clone())
	println(out.stdout.trim())
	process::run("rm", ["-rf", tmp])
}
