// The settings a loader hands back outlive the text they point into, and the
// text lives in a keep beside the call that asked for them (ADR-tether-v1 D2).
// Moved from the Rust test `tether_keep::loader` (#2849).
use std::fs

struct Setting {
    key: String,
    value: String,
}

fn load(path: String, root: fs::Root) -> Vec[Setting] throws {
    let text = fs::read_to_string(path, root)
    let mut settings: Vec[Setting] = []
    for line in text.lines() {
        if line.starts_with("#") { continue }
        let parts: Vec[String] = line.split("=").collect()
        if parts.len() == 2 {
            settings.push(Setting { key: parts[0].trim(), value: parts[1].trim() })
        }
    }
    return settings
}

fn files() -> fs::Root throws {
    let root = fs::scratch()
    fs::write("app.conf", root, "# settings\nhost = example.org\nport = 8080\ninclude = extra.conf\n")
    fs::write("extra.conf", root, "mode = fast\nhost = override.org\n")
    return root
}

fn main() throws {
    let root = files()
    for s in load("app.conf", root) {
        println(f"{s.key} -> {s.value}")
    }
}
