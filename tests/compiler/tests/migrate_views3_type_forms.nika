// ADR-views-v4 D4, D14, #1254: `nikaia migrate views-3` drops `ref` from a
// parameter's and a `comptime`'s type, and writes a function type
// with a `ref` result as D14 does: its parameters named by position, its
// result `from` the old `ref` ones, and the result of the function that
// takes it `from` its own old `ref` parameters. The migrated file checks.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    fs::write("a.nika", tmp, "fn total(xs: ref Array[i64]) -> i64 {\n    let mut s = 0\n    for x in xs {\n        s = s + x\n    }\n    return s\n}\n\nfn size(b: ref Bytes) -> i64 {\n    return b.len()\n}\n\ncomptime GREETING: ref String = \"hi\"\n\nfn same(s: ref String) -> ref String {\n    return s\n}\n\nfn apply(f: fn(ref String) -> ref String, s: ref String) -> ref String {\n    return f(s)\n}\n\nfn main() throws {\n    let a: Array[i64, 3] = [1, 2, 3]\n    println(total(a))\n    let text: String = \"abc\"\n    println(size(text.bytes))\n    let g: String = \"hi\"\n    println(GREETING)\n    println(apply(same, g))\n}\n")
    let out = process::run(nikaia, ["migrate", "views-3", f"{tmp.path().to_text()}/a.nika"])
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    print(fs::read_to_string("a.nika", tmp))
    let checked = process::run(nikaia, ["check", f"{tmp.path().to_text()}/a.nika"])
    print(f"check: {checked.stdout}{checked.stderr}".replace(tmp.path().to_text(), "TMP"))
}
