// ADR-392, #1360: a write to a closed pipe throws `io::IoError`, never a
// panic. A program printing in a loop, its standard output closed, ends with
// status 1 and the error on standard error; one that catches the failure of
// its `println` runs its handler and ends normally.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn closed(nikaia: String, tmp: ref fs::Root, name: String) throws {
    let out = process::run("sh", ["-c", f"({nikaia} run {tmp.path().to_text()}/{name}.nika 2>{tmp.path().to_text()}/{name}.err; echo $? >{tmp.path().to_text()}/{name}.status) | true"])
    let status = fs::read_to_string(f"{name}.status", tmp).trim().clone()
    let said = fs::read_to_string(f"{name}.err", tmp)
    print(f"{name}: status {status}\n{said}{out.stderr}")
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    fs::write("looping.nika", tmp, "fn main() throws {\n    let mut n = 0\n    while true {\n        println(f\"line {n}\")\n        n += 1\n    }\n}\n")
    fs::write("caught.nika", tmp, "fn main() {\n    let mut n = 0\n    let mut failed = false\n    while !failed {\n        println(f\"line {n}\") catch {\n            failed = true\n        }\n        n += 1\n    }\n    eprintln(\"caught\") catch { }\n}\n")
    closed(nikaia, tmp, "looping")
    closed(nikaia, tmp, "caught")
}
