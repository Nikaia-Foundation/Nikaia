// Two tasks of one group call a function that writes one file named by a
// literal: NK2104, the same as writing it in the task (Part I 8.1.2, #1354).
use std::fs

fn put(text: String) throws {
	fs::write("a.txt", fs::Root::Anywhere, text)
}

fn main() throws {
	async {
		async put("a")
		async put("b")
	}
}
