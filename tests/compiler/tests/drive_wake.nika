// scripts/drive.nika --wake DIR LINE...: the WAKE line of each kind names
// what to read and what to do, so the session reads nothing else (#1821).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    let tmp = fs::scratch()
    // b1 ran: its report is the one to read; b0 has none yet.
    fs::write("b1.md", tmp, "brief\n")
    fs::write("b1.md.report.md", tmp, "Result: partial\n")
    let lines = [
        "PUSHED 1234abcd, release BUMP 0.0.9: a title",
        "STOP drive: time limit after 106 min",
        "ESCALATE drive: --max 8 agent runs reached (drive.nika SHA)",
        "ESCALATE CUT b1.md: Result: partial -> SUPERVISOR: the supervisor accepts the report with a Supervisor line or files what it names (drive.nika SHA)",
        "ESCALATE CUT b1.md: Result: blocked -> SUPERVISOR: the supervisor files or decides what `Found:` names and writes its `#M` under the report's `Needs:`; the driver then drops the brief and blocks the issue until `#M` is closed (drive.nika SHA)",
        "ESCALATE CUT b2.md: brief missing -> SUPERVISOR: the supervisor puts the issue's `#N` line in its place or drops the line from batch.txt (drive.nika SHA)",
        "ESCALATE OWNER b0: which model? (drive.nika SHA)",
        "ESCALATE OWNER second: b1.md: which model? (drive.nika SHA)",
        "ESCALATE OWNER 2 open: which model? (drive.nika SHA)",
        "ESCALATE RED 1234abcd test -> SUPERVISOR: the supervisor files the failed jobs as a `ready` issue, its `#N` line first in batch.txt (drive.nika SHA)",
        "ESCALATE drive: suite red after 2 QA rounds: test (drive.nika SHA)",
        "ESCALATE drive: push rejected, merge conflicted in a.nika, merge aborted (drive.nika SHA)",
        "ESCALATE drive: merge left open: push rejected, merge conflicted in a.nika, and git merge --abort did not finish (x) (drive.nika SHA)",
        "ESCALATE BATCH DONE: no ready issue left in the lane, the supervisor decides or files the waiting ones (`ready`) (drive.nika SHA)",
        "ESCALATE focus: every area empty (drive.nika SHA)",
        "ESCALATE drive: cycle.nika failed (drive.nika SHA)",
    ]
    let mut argv: Vec[String] = ["run", "scripts/drive.nika", "--", "--wake", tmp.path().to_text()]
    for l in lines { argv.push(l.clone()) }
    let out = process::run(nikaia, argv; dir: repo)
    println(out.stdout.trim().replace(tmp.path().to_text(), "T"))
    // Where the lane is not known (the time limit), nothing names a file.
    let none = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--wake", "", "ESCALATE CUT b1.md: Result: partial"]; dir: repo)
    println(none.stdout.trim())
}
