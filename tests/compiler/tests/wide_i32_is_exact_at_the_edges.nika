// `Wide[i32]`, std's exact value of twice the width of `i32` (Part I 2.2,
// #2619): each method at the edges, the least value, `-1`, `0`,
// the greatest product and a quotient that does not fit. A value is shown as
// its halves (high, low) and its sign; `none` is a `null`.
fn show(w: Wide[i32]) throws {
	let (low, high) = w.halves()
	println(f"{high} {low} {w.sign()}")
}

fn maybe(w: Wide[i32]?) throws {
	if w == null {
		println("none")
		return
	}
	show(w ?? return)
}

fn shown(n: i32?) -> String {
	return if n == null { "none" } else { f"{n ?? 0}" }
}

fn quotient(pair: (Wide[i32], i32)?) throws {
	if pair == null {
		println("none")
		return
	}
	let (q, r) = pair ?? return
	let (low, high) = q.halves()
	println(f"{high} {low} {q.sign()} rest {r}")
}

fn show_abs(w: Wide[u32]) throws {
	let (low, high) = w.halves()
	println(f"{high} {low}")
}

fn main() throws {
	let least: i32 = i32::MIN
	let most: i32 = i32::MAX
	let zero: i32 = 0
	let one: i32 = 1
	let ten: i32 = 10
	let full: u32 = u32::MAX
	let nothing: u32 = 0
	let low_of_top: u32 = 0
	let minus: i32 = -1
	let two: i32 = 2
	let lowest = Wide::from_halves(nothing, least)
	let top = Wide::product(least, least)
	show(top)
	println(shown(top.narrow()))
	show(Wide::of(least))
	println(shown(Wide::of(least).narrow()))
	println(Wide::of(zero).sign())
	maybe(top.add(top))
	maybe(Wide::of(least).add(Wide::of(most)))
	maybe(Wide::of(zero).sub(Wide::of(one)))
	show(Wide::from_halves(full, most))
	maybe(Wide::from_halves(full, most).add(Wide::of(one)))
	maybe(Wide::of(zero).neg())
	maybe(Wide::of(one).neg())
	maybe(top.mul(most))
	maybe(Wide::of(most).mul(most))
	quotient(top.div_rem(most))
	quotient(top.div_rem(zero))
	println(shown(top.rem(zero)))
	println(shown(top.rem(ten)))
	println(top == Wide::product(most, most))
	println(Wide::of(zero) < top)
	println(top < Wide::of(one))
	println(top.halves().0 == low_of_top)
	println(Wide::of(minus).sign())
	show(Wide::of(minus))
	println(Wide::from_halves(full, minus) == Wide::of(minus))
	maybe(lowest.neg())
	maybe(Wide::of(least).neg())
	maybe(lowest.sub(Wide::of(one)))
	maybe(top.mul(minus))
	maybe(top.mul(least))
	quotient(lowest.div_rem(minus))
	quotient(Wide::of(minus).div_rem(two))
	quotient(lowest.div_rem(most))
	println(shown(lowest.rem(minus)))
	println(shown(Wide::product(least, most).rem(ten)))
	show_abs(lowest.abs())
	show_abs(Wide::of(minus).abs())
	println(lowest < Wide::of(least))
}
