// A view of a local that is no text, handed back bare or in a struct's
// field, outlives the local: refused at the `return` (NK2304), not left to
// rustc (#1155).
struct L { n: i64 }
struct W { own: ref L, k: i64 }

fn make() -> W {
    let xs = [L { n: 3 }]
    let first: ref L = xs[0]
    return W { own: first, k: 1 }
}

fn first(a: Array[i64]) -> ref Array[i64] {
    let v: Vec[i64] = [1, 2, 3]
    return v[0..1]
}

fn built() -> W {
    let xs = [L { n: 4 }]
    let one: ref L = xs[0]
    let w = W { own: one, k: 2 }
    return w
}

fn main() {
    println(make().own.n + built().k)
    println(first([1]).len())
}
