// ADR-403 D1, D2 (#2135): a program in a package's own `tests/` reaches the
// package's non-`pub` names; every other program is still refused (`NK1110`).
// `pk` has a private `secret`; `user` depends on `pk`, and neither its own
// `tests/` program nor its `src/main.nika` is one of `pk`'s tests.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn checked(nikaia: String, dir: String, command: String, file: String) throws {
    let args = if command == "test" { ["test", "--filter", file.clone()] } else { [command.clone(), file.clone()] }
    let out = process::run(nikaia, args; dir: dir)
    let refused = f"{out.stdout}{out.stderr}".contains("NK1110")
    println(f"{command} {file}: exit {out.code}, NK1110 {refused}")
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp}/pk/src", f"{tmp}/pk/tests", f"{tmp}/user/src", f"{tmp}/user/tests"])
    fs::write(f"{tmp}/pk/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"pk\"\nversion = \"0.1.0\"\n")
    fs::write(f"{tmp}/pk/src/lib.nika", fs::Root::Anywhere, "pub fn shown() -> i64 {\n    return secret() + 1\n}\n\nfn secret() -> i64 {\n    return 2\n}\n")
    let calls = "use pk\n\nfn main() throws {\n    println(f\"{pk::secret()}\")\n}\n"
    fs::write(f"{tmp}/pk/tests/own.nika", fs::Root::Anywhere, calls)
    fs::write(f"{tmp}/user/nikaia.toml", fs::Root::Anywhere, f"[package]\nname = \"user\"\nversion = \"0.1.0\"\n\n[dependencies]\npk = {{ path = \"{tmp}/pk\" }}\n")
    fs::write(f"{tmp}/user/src/main.nika", fs::Root::Anywhere, calls)
    fs::write(f"{tmp}/user/tests/other.nika", fs::Root::Anywhere, calls)
    // A test program is built by `nikaia test`, as its package's test.
    checked(nikaia, f"{tmp}/pk", "test", "own")
    checked(nikaia, f"{tmp}/user", "test", "other")
    checked(nikaia, f"{tmp}/user", "check", "src/main.nika")
    process::run("rm", ["-rf", tmp])
}
