// ADR-403 D1, D2 (#2135): a program in a package's own `tests/` reaches the
// package's non-`pub` names; every other program is still refused (`NK1110`).
// `pk` has a private `secret`; `user` depends on `pk`, and neither its own
// `tests/` program nor its `src/main.nika` is one of `pk`'s tests.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn checked(nikaia: String, dir: String, command: String, file: String) throws {
    let args = if command == "test" { ["test", "--filter", file.clone()] } else { [command.clone(), file.clone()] }
    let out = process::run(nikaia, args; dir: dir)
    let refused = f"{out.stdout}{out.stderr}".contains("NK1110")
    println(f"{command} {file}: exit {out.code}, NK1110 {refused}")
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/pk/src", f"{tmp.path().to_text()}/pk/tests", f"{tmp.path().to_text()}/user/src", f"{tmp.path().to_text()}/user/tests"])
    fs::write("pk/nikaia.toml", tmp, "[package]\nname = \"pk\"\nversion = \"0.1.0\"\n")
    fs::write("pk/src/lib.nika", tmp, "pub fn shown() -> i64 {\n    return secret() + 1\n}\n\nfn secret() -> i64 {\n    return 2\n}\n")
    let calls = "use pk\n\nfn main() throws {\n    println(f\"{pk::secret()}\")\n}\n"
    fs::write("pk/tests/own.nika", tmp, calls)
    fs::write("user/nikaia.toml", tmp, f"[package]\nname = \"user\"\nversion = \"0.1.0\"\n\n[dependencies]\npk = {{ path = \"{tmp.path().to_text()}/pk\" }}\n")
    fs::write("user/src/main.nika", tmp, calls)
    fs::write("user/tests/other.nika", tmp, calls)
    // A test program is built by `nikaia test`, as its package's test.
    checked(nikaia, f"{tmp.path().to_text()}/pk", "test", "own")
    checked(nikaia, f"{tmp.path().to_text()}/user", "test", "other")
    checked(nikaia, f"{tmp.path().to_text()}/user", "check", "src/main.nika")
}
