// #2367: `keep b: Bytes` kept through a cut or a clone is kept (ADR-373
// D4): no NK1334, the function takes the `Bytes` with its owner, and the cut
// shares the mapping. The file stays mapped while the kept cut lives, and
// the caller still has `b`.
use std::fs

fn mapped_count(name: String) -> i64 throws {
    let maps = fs::read_to_string("/proc/self/maps", fs::Root::Anywhere)
    let mut n = 0
    for line in maps.split("\n") {
        if line.ends_with(name) { n += 1 }
    }
    return n
}

fn keep_cut(keep b: Bytes, mut out: Vec[Bytes]) {
    out.push(b[7..<13])
}

fn keep_clone(keep b: Bytes, mut out: Vec[Bytes]) {
    out.push(b.clone())
}

fn cuts(root: ref fs::Root) -> Vec[Bytes] throws {
    let whole: Bytes = fs::map("page", root)
    let mut out: Vec[Bytes] = []
    keep_cut(whole, out)
    keep_clone(whole, out)
    println(f"caller still has {whole.len()} bytes")
    return out
}

fn show(root: ref fs::Root) throws {
    let kept = cuts(root)
    println(f"{kept[0].text()} {kept[1].len()} mapped: {mapped_count("/page")}")
}

fn main() throws {
    let root = fs::scratch()
    fs::write("page", root, "Oslo;3\nRome;9\nmore text to make it a page or so")
    show(root)
    println(f"after: {mapped_count("/page")}")
}
