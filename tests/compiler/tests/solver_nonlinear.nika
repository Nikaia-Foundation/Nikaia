// Non-linear terms (ADR-270 D28, #1339): the reader abstracts each product
// of two terms, each division by a term or by zero, `div`, `mod` and
// `int.pow2` to a variable, equal terms to one; the loop of `sv_nl.nika`
// holds each model of the abstraction against the terms' exact meaning and
// adds refinement lemmas the model violates. Each line is the runner's
// answer, then the lemmas the last round used. `sat-abstraction` is
// answered by the abstraction's first model, `unsat-abstraction` by the
// abstraction alone (the two products are one term), `sat-repaired` by the
// model with the exponent moved to the power's value, `sat-refined` after
// lemmas, `arguments` over a product of sums (each a fresh variable), `square` (`x*x < 0`) needs the square lemma, `division` and
// `remainder` the division identity, `free` a division by zero whose value
// is open but the same for equal arguments. `point` is proved with a lemma
// that has a number: changed by one, the checker re-derives another formula
// and the proof log fails on it (`changed ...: refused`). `irrational`
// (`x*x = 2`) has no rational model: the loop gives up after its rounds. The two malformed
// scripts are refused with their reason and place.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "// Each file answered as `scripts/solver.nika` answers it, then the
// lemmas and, where one has a number, the check of the proof with it changed.
fn each(path: String) throws {
	let name = path.split(\"/\").last() ?? path
	let source = fs::read_to_string(path.clone(), fs::Root::Anywhere)
	println(f\"{name}: {sv_line(source, \"new\")}{lemmas(source)}\")
}

fn lemmas(source: String) -> String {
	let mut reals: collections::BTreeSet[String] = collections::BTreeSet()
	let mut defs: Vec[SvNl] = []
	let script = match sv_smtlib_script(source) {
		SvSmtRead::Script(s, sorts) => {
			reals = sorts.reals.clone()
			defs = sorts.nl.clone()
			s.clone()
		},
		SvSmtRead::Failed(_) => {
			return \"\"
		},
	}
	let mut arena = script.arena.clone()
	let goal = arena.boolean(false)
	let nl = sv_nl_engine(arena, script.assertions, goal, lg_budget(), \"both\", reals, \"\", defs) ?? return \"\"
	let mut names: Vec[String] = []
	for l in nl.lemmas {
		names.push(l.schema.clone())
	}
	let mut out = f\"; lemmas [{names.join(\", \")}]\"
	let steps = match nl.run.driven {
		SvDriven::Proved(_, s) => s.clone(),
		else => {
			return out
		},
	}
	let mut changed = nl.lemmas.clone()
	for i in 0..<changed.len() {
		let s = changed[i].schema.clone()
		if s == \"point\" || s == \"tangent\" || s == \"pow2-point\" {
			changed[i].a = sv_rat_add(changed[i].a, sv_int(1)) ?? return out
		} else if s == \"divpoint\" || s == \"division\" {
			changed[i].b = sv_rat_add(changed[i].b, sv_int(1)) ?? return out
		} else {
			continue
		}
		let verdict = match sv_lemma_check(arena, script.assertions, goal, reals, defs, changed, steps) {
			null => \"refused (not an instance)\",
			v => if v.ok { \"accepted\" } else { \"refused\" },
		}
		return f\"{out}; changed {s}: {verdict}\"
	}
	return out
}

fn main() throws {
	let mut args: Vec[String] = []
	for a in cli::args() {
		args.push(a)
	}
	for i in 1..<args.len() {
		each(args[i].clone())
	}
}
"
}

fn script(logic: String, status: String, sort: String, names: String, asserts: String) -> String {
	let mut text = f"(set-logic {logic})\n(set-info :status {status})\n"
	for n in names.split(" ") {
		text = text + f"(declare-const {n} {sort})\n"
	}
	return text + asserts + "(check-sat)\n"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_walk", "sv_strategy", "sv_smt", "sv_smtlib", "sv_lemma", "sv_nl", "sv_rod"] {
		let dir = if name == "sv_rod" { "solver" } else { "tools" }
		paths.push(f"{repo}/crates/nikaia-std/src/{dir}/{name}.nika")
	}
	let mut uses: Vec[String] = []
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver())
	let files = [
		("sat-abstraction", script("QF_NIA", "sat", "Int", "x y", "(assert (= (* x y) 0))\n(assert (= x 0))\n")),
		("unsat-abstraction", script("QF_NIA", "unsat", "Int", "x y", "(assert (> (* x y) 5))\n(assert (< (* y x) 3))\n")),
		("sat-repaired", script("QF_NIA", "sat", "Int", "x y", "(assert (= (int.pow2 x) 8))\n(assert (> y x))\n")),
		("sat-refined", script("QF_NIA", "sat", "Int", "x y", "(assert (= (- x y) (int.pow2 x)))\n")),
		("arguments", script("QF_NIA", "unsat", "Int", "x y", "(assert (= (* (+ x 1) (* 2 y)) 6))\n(assert (= x 0))\n(assert (= y 2))\n")),
		("square", script("QF_NRA", "unsat", "Real", "x", "(assert (< (* x x) 0))\n")),
		("division", script("QF_NIA", "unsat", "Int", "x", "(assert (= (mod x 3) 4))\n")),
		("remainder", script("QF_NIA", "unsat", "Int", "x", "(assert (= (div x 3) 2))\n(assert (= (mod x 3) 1))\n(assert (distinct x 7))\n")),
		("free", script("QF_NRA", "unsat", "Real", "x y", "(assert (= (/ x 0) 1))\n(assert (= (/ y 0) 2))\n(assert (= x y))\n")),
		("point", script("QF_NIA", "unsat", "Int", "x y", "(assert (= x 3))\n(assert (= y 2))\n(assert (= (* x y) 7))\n")),
		("irrational", script("QF_NRA", "sat", "Real", "x", "(assert (= (* x x) 2))\n")),
		("parallel-let", script("QF_LIA", "unknown", "Int", "x", "(assert (let ((a x) (b (+ a x))) (> b a)))\n")),
		("zero-denominator", script("QF_LRA", "unknown", "Real", "x y", "(assert (= (+ x y) 5/0))\n")),
	]
	let mut args: Vec[String] = ["run", "main.nika", "--"]
	for (name, text) in files {
		fs::write(f"{tmp}/{name}.smt2", fs::Root::Anywhere, text)
		args.push(f"{tmp}/{name}.smt2")
	}
	let out = process::run(nikaia, args; dir: tmp.clone())
	println(out.stdout.trim())
	if out.stdout.trim().len() == 0 {
		println(out.stderr.trim())
	}
	process::run("rm", ["-rf", tmp])
}
