// scripts/drive.nika --docs-only FILE: the path rule of scripts/ci-changes.sh by
// which the driver pushes unpushed documentation commits without the suite.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, tmp: ref fs::Root, name: String, paths: String) throws {
    fs::write(f"{name}", tmp, paths)
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--docs-only", f"{tmp.path().to_text()}/{name}"]; dir: repo)
    println(f"== {name}")
    println(out.stdout.trim())
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    case(nikaia.clone(), repo.clone(), tmp, "docs", "docs/briefs/b1.md.report.md\nguide/intro.txt\nwebsite/index.html\nREADME.md\n")
    case(nikaia.clone(), repo.clone(), tmp, "run-json", "docs/briefs/b1.md.report.md\ndocs/briefs/b1.md.run.json\n")
    case(nikaia.clone(), repo.clone(), tmp, "trees", "CHANGELOG.md\ncrates/nikaia/README.md\ndocs/specification/part1.md\n")
    case(nikaia.clone(), repo.clone(), tmp, "workflow", "docs/a.md\n.github/workflows/nikaia.yml\n")
    case(nikaia.clone(), repo.clone(), tmp, "ci-changes", "docs/a.md\nscripts/ci-changes.sh\n")
    case(nikaia.clone(), repo.clone(), tmp, "empty", "\n")
}
