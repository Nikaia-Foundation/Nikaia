// scripts/drive.nika --post-body BRIEF: the comment that puts a queued brief
// on its issue (#1252); the post itself is not run here.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    fs::write("d1-1252-briefs.md", tmp, "---\nagent: builder\n---\n\n# d1: the brief\n\nTo build.\n\n")
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--post-body", f"{tmp.path().to_text()}/d1-1252-briefs.md"]; dir: repo)
    print(out.stdout)
}
