// scripts/drive.nika --post-body BRIEF: the comment that puts a queued brief
// on its issue (#1252); the post itself is not run here.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--post-body", "d1-1252-briefs.md"]; dir: repo, stdin: process::Input::Text("---\nagent: builder\n---\n\n# d1: the brief\n\nTo build.\n\n"))
    print(out.stdout)
}
