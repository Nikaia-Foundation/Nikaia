// Code that changes what it captures, handed on: a parameter lent on to a
// parameter of the same kind, and a lambda that runs one (ADR-views-3 D17,
// #1553). Code that changes nothing still fits.
fn each(xs: Vec[i64], f: fn(i64)) { for x in xs { f(x) } }

fn twice(f: fn(i64)) {
    each([1], f)
    f(2)
}

fn around(g: fn(i64)) { each([10, 20], fn(v) { g(v) }) }

fn nothing(v: i64) { }

fn main() throws {
    let mut total = 0
    twice(fn(v) { total = total + v })
    around(fn(v) { total = total + v })
    each([5], nothing)
    println(total)
}
