// #99, ADR-286 D23-D25, D27: `demo = "0.1"` is the crate `nikaia_demo`, found
// through Cargo (here a `[patch.crates-io]`, offline) and read where it landed;
// its own `base = "0.2"`, named in its published `Cargo.toml`, comes in the
// same resolution, and so does the `base` of a package by path.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

// A published package: its stub `Cargo.toml`, `nikaia.toml`, one source and
// a ledger.
fn published(dir: String, name: String, version: String, depends: String, source: String) throws {
    process::run("mkdir", ["-p", f"{dir}/src"])
    fs::write(f"{dir}/Cargo.toml", fs::Root::Anywhere, f"[package]\nname = \"nikaia_{name}\"\nversion = \"{version}\"\nedition = \"2024\"\n\n[lib]\npath = \"lib.rs\"\n\n[workspace]\n\n[dependencies]\n{depends}")
    fs::write(f"{dir}/lib.rs", fs::Root::Anywhere, "")
    fs::write(f"{dir}/nikaia.toml", fs::Root::Anywhere, f"[package]\nname = \"{name}\"\nversion = \"{version}\"\n\n[dependencies]\n{depends.replace(f"package = \"nikaia_base\", ", "")}")
    fs::write(f"{dir}/src/lib.nika", fs::Root::Anywhere, source)
    fs::write(f"{dir}/nikaia.contracts", fs::Root::Anywhere, "")
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    published(f"{tmp}/base", "base", "0.2.4", "", "pub fn one() -> i64 {\n    return 1\n}\n")
    published(f"{tmp}/demo", "demo", "0.1.3", "base = { package = \"nikaia_base\", version = \"0.2\" }\n", "use base\n\npub fn twice(x: i64) -> i64 {\n    return x * 2 + base::one() - 1\n}\n")
    process::run("mkdir", ["-p", f"{tmp}/mid/src", f"{tmp}/app/src", f"{tmp}/app/.cargo"])
    fs::write(f"{tmp}/mid/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"mid\"\nversion = \"0.1.0\"\n\n[dependencies]\nbase = \"0.2\"\n")
    fs::write(f"{tmp}/mid/src/lib.nika", fs::Root::Anywhere, "use base\n\npub fn more(x: i64) -> i64 {\n    return x + base::one()\n}\n")
    fs::write(f"{tmp}/app/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\ndemo = \"0.1\"\nmid = { path = \"../mid\" }\n")
    fs::write(f"{tmp}/app/.cargo/config.toml", fs::Root::Anywhere, f"[patch.crates-io]\nnikaia_demo = {{ path = \"{tmp}/demo\" }}\nnikaia_base = {{ path = \"{tmp}/base\" }}\n")
    fs::write(f"{tmp}/app/src/main.nika", fs::Root::Anywhere, "use demo\nuse mid\n\nfn main() throws {\n    println(mid::more(demo::twice(20)))\n}\n")
    let out = process::run(nikaia, ["run"]; dir: f"{tmp}/app", env: [("CARGO_NET_OFFLINE", "true")])
    println(out.stdout.trim())
    if !out.ok {
        println(out.stderr)
    }
    let resolver = fs::read_to_string(f"{tmp}/app/target/nikaia/resolve/Cargo.toml", fs::Root::Anywhere)
    println(f"renamed: {resolver.contains("{ package = \"nikaia_demo\", version = \"0.1\" }")}, {resolver.contains("{ package = \"nikaia_base\", version = \"0.2\" }")}")
    // The fetched package's directory is Cargo's: its ledger is read, not written.
    println(f"ledger untouched: {fs::read_to_string(f"{tmp}/demo/nikaia.contracts", fs::Root::Anywhere).len() == 0}")
    process::run("rm", ["-rf", tmp])
}
