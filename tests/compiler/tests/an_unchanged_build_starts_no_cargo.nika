// #1750: a build with nothing changed still started Cargo, which only found
// everything fresh: most of a second a call, and `nikaia test` paid it for
// every test program again on every run, in a directory of a new name each
// time. The build now keeps a record of what it handed Cargo and of every
// file Cargo read (`project_drive_fresh`), and a test program is built in a
// place kept from one run to the next (`project_tests_places`). Through a
// Cargo that counts its calls: a program built twice, then built again
// after its source changed; a package's test program tested twice.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

/// How many times Cargo was started since the last call, and the log emptied.
fn calls(log: String) -> String throws {
	let counted = process::run(
		"sh",
		["-c", f"cat {log} 2>/dev/null | wc -l; rm -f {log}"],
	).stdout.trim().clone()
	return counted
}

fn main() throws {
	let tmp = fs::scratch()
	let nikaia = toolchain()
	let real = process::run(
		"sh",
		["-c", "echo ${CARGO:-$(command -v cargo)}"],
	).stdout.trim().clone()
	let path = process::run("sh", ["-c", "echo $PATH"]).stdout.trim().clone()
	process::run(
		"mkdir",
		["-p", f"{tmp.path().to_text()}/p/src", f"{tmp.path().to_text()}/lib/src", f"{tmp.path().to_text()}/lib/tests", f"{tmp.path().to_text()}/bin"],
	)
	let shim = tmp.join("bin/cargo")
	fs::write("bin/cargo", tmp, SHIM)
	process::run("chmod", ["+x", shim.path().to_text()])
	let log = f"{tmp.path().to_text()}/cargo.log"
	let env = [
		("RUST_BACKTRACE", "0"),
		("CARGO_TERM_COLOR", "never"),
		("NIKAIA_CACHE_DIR", f"{tmp.path().to_text()}/cache"),
		("CARGO", shim.path().to_text()),
		("REAL_CARGO", real),
		("SHIM_LOG", log.clone()),
		("PATH", f"{tmp.path().to_text()}/bin:{path}"),
	]

	let p = tmp.join("p")
	fs::write(
		"nikaia.toml",
		p,
		"[package]\nname = \"unchanged\"\nversion = \"0.1.0\"\n",
	)
	fs::write(
		"src/main.nika",
		p,
		"fn main() throws {\n\tprintln(\"one\")\n}\n",
	)
	let first = process::run(nikaia, ["build"]; dir: p.path().to_text(), env: env.clone())
	println(f"build: {first.code}, Cargo started: {calls(log)}")
	let second = process::run(nikaia, ["build"]; dir: p.path().to_text(), env: env.clone())
	println(f"build again: {second.code}, Cargo started: {calls(log)}")
	fs::write(
		"src/main.nika",
		p,
		"fn main() throws {\n\tprintln(\"two\")\n}\n",
	)
	let changed = process::run(nikaia, ["build"]; dir: p.path().to_text(), env: env.clone())
	println(f"build after a change: {changed.code}, Cargo started: {calls(log)}")
	let ran = process::run(f"{p.path().to_text()}/target/nikaia/bin/unchanged", [])
	println(f"the program prints: {ran.stdout.trim()}")

	let lib = tmp.join("lib")
	fs::write(
		"nikaia.toml",
		lib,
		"[package]\nname = \"kept\"\nversion = \"0.1.0\"\n",
	)
	fs::write("src/lib.nika", lib, "pub fn two() -> i64 {\n\treturn 2\n}\n")
	fs::write(
		"tests/twice.nika",
		lib,
		"fn main() throws {\n\tprintln(f\"{kept::two() * 2}\")\n}\n",
	)
	fs::write("tests/twice.stdout", lib, "4\n")
	let tested = process::run(nikaia, ["test"]; dir: lib.path().to_text(), env: env.clone())
	println(f"test: {tested.code}, Cargo started: {calls(log)}")
	let again = process::run(nikaia, ["test"]; dir: lib.path().to_text(), env: env)
	println(f"test again: {again.code}, Cargo started: {calls(log)}")
}

comptime SHIM: ref String = "#!/bin/bash\n# Cargo, with each start counted.\necho \"$1\" >> \"$SHIM_LOG\"\nexec \"$REAL_CARGO\" \"$@\"\n"
