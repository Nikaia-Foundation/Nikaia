// scripts/drive.nika: which cycle line leads to which action; a run commits
// nothing under docs/briefs/ (#1252). Each case is one `--dry-run` step on a scratch directory.
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// An ESCALATE line ends with the commit of the drive.nika that ran (#1801),
// which changes with each commit: it is printed as SHA.
fn unsha(text: String) -> String throws {
    let mut lines: Vec[String] = []
    for line in text.split("\n") {
        let mut first = true
        for part in line.split(" (drive.nika ") {
            if first { if part.len() < line.len() { lines.push(part + " (drive.nika SHA)") } else { lines.push(part.clone()) } }
            first = false
        }
    }
    return lines.join("\n")
}

// A lane of this test's own under the checkout's target/drive-test/ (#2577):
// drive opens every name under fs::Root::Dir("."), the checkout it runs in, so
// it gets the lane's names relative to it. The scratch directory's name keeps
// the two runs of `--both-settings` apart.
fn test_lane(repo: String, name: String) -> String throws {
    let id = fs::scratch().path().file_name()?.to_text() ?? "run"
    let lane = f"target/drive-test/{name}/{id}"
    fs::create_dir(lane, fs::Root::Dir(repo); recursive: true)
    return lane
}

fn case(nikaia: String, repo: String, tmp: ref fs::Root, lane: String, name: String, cycle: String) throws {
    case_with(nikaia, repo, tmp, lane, name, cycle, "--dry-run")
}

// `flag`: one more argument to the driver (`--dry-run` when none is meant).
fn case_with(nikaia: String, repo: String, tmp: ref fs::Root, lane: String, name: String, cycle: String, flag: String) throws {
    fs::write("lines", tmp, cycle.replace("%T", lane.clone()) + "\n")
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", lane.clone(), "--lines", f"{lane}/lines", flag]; dir: repo, env_remove: ["NIKAIA_SUITE_DIR"])
    println(f"== {name} (exit {out.code})")
    println(unblock(unsha(out.stdout.trim().clone())).replace(tmp.path().to_text(), "T").replace(lane, "T").replace("target/release/nikaia", "target/fast/nikaia"))
}

// The block size comes from the local, untracked docs/briefs/focus.txt
// (`block N`, 2 without it): it is printed as B, so the test does not
// depend on the checkout's settings.
fn unblock(text: String) -> String throws {
    let mut out = text.clone()
    for n in 1..<10 {
        out = out.replace(f"a block of {n} (drive_lane_block); at {n}:", "a block of B (drive_lane_block); at B:")
    }
    return out
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let repo = root()
    let lane = test_lane(repo.clone(), "drive_actions")
    let tmp = fs::Root::Dir(f"{repo}/{lane}")
    let nikaia = toolchain(repo.clone())
    fs::write("b1.md", tmp, "x\n")
    fs::write("b1.md.report.md", tmp, "Result: done\n")
    fs::write("b1.md.run.json", tmp, "{}\n")
    fs::write("cost.txt", tmp, "2026-10-26 1.0\n")
    case(nikaia.clone(), repo.clone(), tmp, lane.clone(), "next", "CI aaaa1111 green\nNEXT %T/b1.md builder sonnet 80 12\nBUMP pending 2 changelog lines")
    case(nikaia.clone(), repo.clone(), tmp, lane.clone(), "batch done", "CI aaaa1111 green\nBATCH DONE")
    case(nikaia.clone(), repo.clone(), tmp, lane.clone(), "cut", "CI aaaa1111 running\nCUT b1: too big -> SUPERVISOR")
    case(nikaia.clone(), repo.clone(), tmp, lane.clone(), "red", "CI aaaa1111 red\nRED aaaa1111 test -> SUPERVISOR\nNEXT %T/b1.md builder sonnet 80 12")
    case(nikaia.clone(), repo.clone(), tmp, lane.clone(), "red, nothing queued", "CI aaaa1111 red\nRED aaaa1111 test -> SUPERVISOR\nBATCH DONE")
    case_with(nikaia.clone(), repo.clone(), tmp, lane.clone(), "red ignored", "CI aaaa1111 red\nRED aaaa1111 test -> SUPERVISOR\nNEXT %T/b1.md builder sonnet 80 12", "--ignore-ci-red")
    case(nikaia.clone(), repo.clone(), tmp, lane.clone(), "bump green", "CI aaaa1111 green\nBATCH DONE\nBUMP pending 3 changelog lines")
    case(nikaia.clone(), repo.clone(), tmp, lane.clone(), "owner", "CI aaaa1111 green\nNEXT %T/b1.md builder sonnet 80 12\nOWNER b0: which model?")
    case(nikaia.clone(), repo.clone(), tmp, lane.clone(), "unknown", "CI aaaa1111 green\nBATCH none (no batch.txt)")
    fs::remove(lane, fs::Root::Dir(repo); recursive: true)
}
