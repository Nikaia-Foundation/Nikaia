// A function value read from a list by index is a copy: it shares the one
// closure, and the list keeps its own (Part I, #1018).
fn main() {
    let mut fs: Vec[fn(i64) -> i64] = []
    fs.push(fn(x) { x + 1 })
    let f = fs[0]
    println(f(2))
    let g = fs[0]
    println(g(2))
    println(g(2))
}
