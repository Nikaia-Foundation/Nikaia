// Real variables (ADR-270 D27, #1299 item 4): the engine reads the sorts
// `sv_smtlib` gives. `2x = 1` has the model x = 1/2 over the reals and is
// proved over the integers; `x < 1 and x > 0` has a model strictly inside,
// `δ` replaced by a rational; `x < 0 and x > 0` is proved by a Farkas sum
// the checker accepts; Fourier-Motzkin answers a real script *unknown*
// (theory). Under `== logs`, `sv_check` accepts a split and a rounding on an
// integer row and refuses them on a real one. The logic layer's files,
// `solver/sv_*.nika` and the driver below make one program, as
// `scripts/solver.nika` makes it.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "// Each file answered over both theories, the sorts taken; then the lines
// the measuring rod writes for it.
fn answer(source: String) -> String {
	let mut reals: collections::BTreeSet[String] = collections::BTreeSet()
	let script = match sv_smtlib_script(source) {
		SvSmtRead::Script(s, sorts) => {
			reals = sorts.reals.clone()
			s.clone()
		},
		else => {
			return \"unreadable\"
		},
	}
	let mut arena = script.arena.clone()
	let goal = arena.boolean(false)
	let run = sv_smt_engine_sorted(arena, script.assertions, goal, lg_budget(), \"both\", reals)
	return match run.driven {
		SvDriven::Proved(query, steps) => {
			let v = sv_check(query, steps)
			if v.ok { f\"proved, log of {steps.len()} steps checked\" } else { f\"log rejected: {v.reason}\" }
		},
		SvDriven::RealModel(values) => {
			let mut parts: Vec[String] = []
			for (name, v) in values {
				parts.push(f\"{name} = {sv_rat_text(v)}\")
			}
			let held = sv_real_model_holds(arena, script.assertions, goal, values)
			let checked = if held { \"checked\" } else { \"rejected\" }
			f\"refuted, model {parts.join(\", \")} {checked}\"
		},
		SvDriven::Answer(LgAnswer::Refuted { .. }) => \"refuted over the integers\",
		SvDriven::Answer(LgAnswer::Unknown { why }) => sv_unknown(why),
		SvDriven::Answer(_) => \"proved without a log\",
	}
}

fn each(path: String) throws {
	let name = path.split(\"/\").last() ?? path
	let source = fs::read_to_string(path.clone(), fs::Root::Anywhere)
	println(f\"{name}: {answer(source.clone())}\")
	let simplex = sv_line(source.clone(), \"new-simplex\")
	let fm = sv_line(source.clone(), \"new-fm\")
	let both = sv_line(source.clone(), \"new\")
	let old = sv_line(source, \"fm\")
	println(f\"  rod: simplex {simplex}; new-fm {fm}; both {both}; fm {old}\")
}

fn row(ks: Vec[i64], c: i64) -> SvRow {
	let mut cols: Vec[u32] = []
	let mut out: Vec[i64] = []
	let mut i: u32 = 0
	for k in ks {
		if k != 0 {
			cols.push(i)
			out.push(k)
		}
		i += 1
	}
	return SvRow { cols: cols, ks: out, constant: c }
}

fn units(atoms: Vec[SvAtom], columns: u32, reals: Vec[u32]) -> SvQuery {
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	for _ in atoms {
		clauses.push([sv_lit(a, false)])
		a += 1
	}
	return SvQuery { atoms: atoms, clauses: clauses, columns: columns, reals: reals }
}

fn report(name: String, query: ref SvQuery, log: ref SvLog) {
	let v = sv_check(query, log.steps)
	if v.ok {
		println(f\"{name}: accepted ({log.steps.len()} steps)\")
	} else {
		println(f\"{name}: rejected at step {v.step}: {v.reason}\")
	}
}

// 2x <= 1 and 2x >= 1.
fn half(reals: Vec[u32]) -> SvQuery {
	return units(
		[SvAtom { row: row([2], -1), rel: SvRel::Le }, SvAtom { row: row([-2], 1), rel: SvRel::Le }],
		1,
		reals,
	)
}

// Refuted by the split x <= 0 or x >= 1, each side by a Farkas sum.
fn split_log(query: ref SvQuery) -> SvLog {
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let s = log.split(row([1], 0), row([-1], 1))
	let low = log.farkas(
		[sv_lit(1, true), sv_lit(2, true)],
		[SvSrc::Lit(sv_lit(1, false)), SvSrc::Lit(sv_lit(2, false))],
		[1, 2],
		1,
	)
	let high = log.farkas(
		[sv_lit(0, true), sv_lit(3, true)],
		[SvSrc::Lit(sv_lit(0, false)), SvSrc::Lit(sv_lit(3, false))],
		[1, 2],
		1,
	)
	log.learn([], [a, b, low, high, s])
	return log
}

// Refuted by rounding each bound: x <= 0 and x >= 1.
fn round_log(query: ref SvQuery) -> SvLog {
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let up = log.combine([SvSrc::Lit(sv_lit(0, false))], [1])
	let r1 = log.round(up, 2)
	let down = log.combine([SvSrc::Lit(sv_lit(1, false))], [1])
	let r2 = log.round(down, 2)
	let f = log.farkas([sv_lit(0, true), sv_lit(1, true)], [SvSrc::Fact(r1), SvSrc::Fact(r2)], [1, 1], 1)
	log.learn([], [a, b, f])
	return log
}

// x < 0 and x > 0 over the reals: their Farkas sum is 0 < 0.
fn empty() -> SvQuery {
	return units(
		[SvAtom { row: row([1], 0), rel: SvRel::Lt }, SvAtom { row: row([-1], 0), rel: SvRel::Lt }],
		1,
		[0],
	)
}

fn empty_log(query: ref SvQuery) -> SvLog {
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let f = log.farkas(
		[sv_lit(0, true), sv_lit(1, true)],
		[SvSrc::Lit(sv_lit(0, false)), SvSrc::Lit(sv_lit(1, false))],
		[1, 1],
		1,
	)
	log.learn([], [a, b, f])
	return log
}

fn main() throws {
	let mut args: Vec[String] = []
	for a in cli::args() {
		args.push(a)
	}
	for i in 1..<args.len() {
		each(args[i].clone())
	}
	println(\"== logs\")
	report(\"2x = 1, x integer: split\", half([]), split_log(half([])))
	report(\"2x = 1, x real: split\", half([0]), split_log(half([0])))
	report(\"2x = 1, x integer: round\", half([]), round_log(half([])))
	report(\"2x = 1, x real: round\", half([0]), round_log(half([0])))
	report(\"x < 0 and x > 0, x real: farkas\", empty(), empty_log(empty()))
}
"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_walk", "sv_strategy", "sv_smt", "sv_smtlib", "sv_rod"] {
		paths.push(f"{repo}/crates/nikaia-std/src/solver/{name}.nika")
	}
	let mut uses: Vec[String] = []
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver())
	let real = "(set-logic QF_LRA)\n(declare-const x Real)\n"
	let files = [
		("half", f"{real}(set-info :status sat)\n(assert (= (* 2 x) 1))\n(check-sat)\n"),
		(
			"half-int",
			"(set-logic QF_LIA)\n(set-info :status unsat)\n(declare-const x Int)\n(assert (= (* 2 x) 1))\n(check-sat)\n",
		),
		(
			"inside",
			f"{real}(set-info :status sat)\n(assert (< x 1))\n(assert (> x 0))\n(check-sat)\n",
		),
		(
			"empty",
			f"{real}(set-info :status unsat)\n(assert (< x 0))\n(assert (> x 0))\n(check-sat)\n",
		),
		(
			"mixed",
			"(set-logic QF_LIRA)\n(set-info :status sat)\n(declare-const x Real)\n(declare-const n Int)\n(assert (= (* 3 x) n))\n(assert (< 0 x 1))\n(check-sat)\n",
		),
	]
	let mut args: Vec[String] = ["run", "main.nika", "--"]
	for (name, text) in files {
		fs::write(f"{tmp}/{name}.smt2", fs::Root::Anywhere, text)
		args.push(f"{tmp}/{name}.smt2")
	}
	let out = process::run(nikaia, args; dir: tmp.clone())
	println(out.stdout.trim())
	if out.stdout.trim().len() == 0 {
		println(out.stderr.trim())
	}
	process::run("rm", ["-rf", tmp])
}
