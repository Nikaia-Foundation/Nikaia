// #539: a `use` of an official package that neither `[dependencies]` nor a
// project directory names takes it in at the version `std` lists, offline,
// and records it in `nikaia.lock` (ADR-338 D2, D3); a declared entry of the
// same name wins over the list.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/app/src", f"{tmp.path().to_text()}/own/src", f"{tmp.path().to_text()}/mine/src"])
    let program = "use json\n\nfn main() throws {\n    let v = json::parse(\"[1, {\\\"a\\\": true}]\")\n    println(json::to_string(v))\n}\n"
    fs::write("app/nikaia.toml", tmp, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    fs::write("app/src/main.nika", tmp, program)
    let out = process::run(toolchain(), ["run", "src/main.nika"]; dir: f"{tmp.path().to_text()}/app")
    print(out.stdout)
    if out.code != 0 { print(out.stderr.replace(tmp.path().to_text(), "TMP")) }
    println(f"exit {out.code}")
    let lock = process::run("cat", [f"{tmp.path().to_text()}/app/nikaia.lock"]).stdout
    for line in lock.lines() {
        if line.contains("json") { println(f"lock: {line}") }
    }
    // A `[dependencies]` entry named `json` is the package that `use` takes.
    fs::write("mine/nikaia.toml", tmp, "[package]\nname = \"json\"\nversion = \"0.1.0\"\n")
    fs::write("mine/src/main.nika", tmp, "pub fn parse(text: String) -> String throws {\n    return f\"mine {text}\"\n}\n\npub fn to_string(text: String) -> String {\n    return text\n}\n")
    fs::write("own/nikaia.toml", tmp, "[package]\nname = \"own\"\nversion = \"0.1.0\"\n\n[dependencies]\njson = { path = \"../mine\" }\n")
    fs::write("own/src/main.nika", tmp, program)
    let declared = process::run(toolchain(), ["run", "src/main.nika"]; dir: f"{tmp.path().to_text()}/own")
    print(declared.stdout)
    if declared.code != 0 { print(declared.stderr.replace(tmp.path().to_text(), "TMP")) }
    println(f"exit {declared.code}")
}
