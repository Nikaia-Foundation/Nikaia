// The measuring rod of the solver (#1281, ADR-270 D17): `scripts/solver.nika
// run --engine fm` on the three smoke files (one sat, one unsat, one the
// reader refuses), then the summary of the stress families: Fourier-Motzkin's
// counts of the day, unknowns included (the baseline and cross-check of the
// engine issues); then the default engine, CDCL(T) (#1283), on the smoke
// files, the preprocessing's, and the files that must be refused (#2258):
// each `refused` and solved; and two sums of fractions whose cross products
// leave `i64` while the reduced sum fits (#2013), and two seeds files whose
// simplex rows leave `i64` while the reduced row fits (#2307).
use std::env
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	for args in [["run", "--engine", "fm", "tests/solver/smoke"], ["run", "--engine", "fm", "--summary", "tests/solver/stress"], ["run", "tests/solver/smoke"], ["run", "tests/solver/pre"], ["run", "tests/solver/malformed"], ["run", "tests/solver/exact"]] {
		let mut all: Vec[String] = ["run", "scripts/solver.nika", "--"]
		for a in args { all.push(a.clone()) }
		let out = process::run(nikaia.clone(), all.clone(); dir: repo.clone())
		println(out.stdout.trim())
		// A failed inner run names its cause in the diff (#1305).
		if !out.ok || out.stderr.trim().len() > 0 {
			println(f"inner run `nikaia {all.join(" ")}` exited {out.code}, stderr:")
			if out.stderr.trim().len()
				== 0 { println("(empty)") } else { println(out.stderr.trim()) }
		}
	}
}
