// scripts/commit.nika run again on a report an earlier attempt already
// committed (#1794): every listed file unchanged and a recent commit with the
// report's subject touching them gives `already committed <sha8> local` and
// `Pushed: local <sha>`, and no second commit; another subject is still
// refused as unchanged.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn git(dir: String, args: Vec[String]) -> String throws {
    let mut all: Vec[String] = ["-c", "user.name=T", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    return process::run("git", all; dir: dir).stdout.trim().clone()
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let env = [("GIT_AUTHOR_NAME", "T"), ("GIT_AUTHOR_EMAIL", "t@example.com"), ("GIT_COMMITTER_NAME", "T"), ("GIT_COMMITTER_EMAIL", "t@example.com")]
    git(tmp.path().to_text(), ["init", "-q", "-b", "develop"])
    fs::write("b.txt", tmp, "base\n")
    git(tmp.path().to_text(), ["add", "b.txt"])
    git(tmp.path().to_text(), ["commit", "-q", "-m", "base"])
    fs::write("a.txt", tmp, "x\n")
    let report = "Result: done\nFiles: a.txt\nCommit: a subject\nChangelog: none\nPushed: none\n"
    fs::write("X.md.report.md", tmp, report)
    process::run(nikaia.clone(), ["run", f"{repo}/scripts/commit.nika", "--", f"{tmp.path().to_text()}/X.md.report.md"]; dir: tmp.path().to_text(), env: env.clone())
    let sha = git(tmp.path().to_text(), ["rev-parse", "HEAD"])
    let short = git(tmp.path().to_text(), ["rev-parse", "--short=8", "HEAD"])
    // The resumed attempt: the report as it was before the commit.
    fs::write("X.md.report.md", tmp, report)
    let again = process::run(nikaia.clone(), ["run", f"{repo}/scripts/commit.nika", "--", f"{tmp.path().to_text()}/X.md.report.md"]; dir: tmp.path().to_text(), env: env.clone())
    println(again.stdout.trim().replace(short, "SHA8"))
    println(fs::read_to_string("X.md.report.md", tmp).trim().replace(sha, "SHA"))
    fs::write("Y.md.report.md", tmp, "Result: done\nFiles: a.txt\nCommit: another subject\nChangelog: none\nPushed: none\n")
    let other = process::run(nikaia, ["run", f"{repo}/scripts/commit.nika", "--", f"{tmp.path().to_text()}/Y.md.report.md"]; dir: tmp.path().to_text(), env: env)
    println(other.stdout.trim())
    println(git(tmp.path().to_text(), ["log", "--format=%s"]))
}
