// #2395: a cache hit trusts its record. A build lowers each crate in the
// driver and again in Cargo's `rustc` wrapper; the wrapper's lowering is a
// cache hit, and it inferred the crate's ledger all the same (about 28 s of
// the solver's `logic` package). What a hit's notes and warnings are made
// of is stored with the entry, so only a miss infers a ledger: the build's
// trace (`NIKAIA_WRAPPER_TRACE`) says `ledger inferred` once per crate on a
// cold build, never for the wrapper's hits, and the build says the same
// either way.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

// The ledgers inferred since the last call, and the trace emptied.
fn inferred(trace: ref fs::Root) -> String throws {
	let said = process::run(
		"sh",
		["-c", f"grep ' ledger inferred' {trace.path().to_text()} | sort; rm -f {trace.path().to_text()}"],
	).stdout.trim().clone()
	if said.len() == 0 { return "none inferred" }
	return said.replace("\n", ", ")
}

// What a build said of the program: its warnings and notes, without Cargo's
// lines.
fn build(nikaia: String, p: String, cache: ref fs::Root, trace: ref fs::Root) -> String throws {
	let built = process::run(
		nikaia,
		["build"]; dir: p.clone(),
		env: [
			("RUST_BACKTRACE", "0"),
			("CARGO_TERM_COLOR", "never"),
			("NIKAIA_CACHE_DIR", cache.path().to_text()),
			("NIKAIA_WRAPPER_TRACE", trace.path().to_text()),
		],
	)
	if built.code != 0 {
		eprintln(built.stderr)
	}
	let said = process::run(
		"sh",
		["-c", "grep -vE '^ +[A-Z][a-z]+ ' || true"]; stdin: process::Input::Text(built.stderr.clone()),
	).stdout
	return f"built {built.code}\n{said}"
}

fn main() throws {
	let tmp = fs::scratch()
	let nikaia = toolchain()
	let cache = tmp.join("cache")
	let trace = tmp.join("trace")
	process::run("mkdir", ["-p", f"{tmp.path().to_text()}/lib/src", f"{tmp.path().to_text()}/app/src"])
	fs::write(
		"lib/nikaia.toml",
		tmp,
		"[package]\nname = \"lib\"\nversion = \"0.1.0\"\n",
	)
	fs::write(
		"lib/src/main.nika",
		tmp,
		"pub fn word() -> i64 {\n\treturn 1\n}\n",
	)
	fs::write(
		"app/nikaia.toml",
		tmp,
		"[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nlib = { path = \"../lib\" }\n",
	)
	fs::write(
		"app/src/main.nika",
		tmp,
		"use lib\n\npub fn twice(n: i64) -> i64 {\n\treturn n * 2\n}\n\nfn main() throws {\n\tprintln(twice(lib::word()))\n}\n",
	)
	let app = tmp.join("app")
	// A first build writes each package's `nikaia.proofs`; only a lowering
	// whose proofs are settled is recorded (ADR-270 D4), as with the
	// committed `nikaia.proofs` of the solver's `logic`. Then a cold one:
	// another cache, no `target`.
	build(nikaia, app.path().to_text(), tmp.join("first"), trace)
	inferred(trace)
	process::run("rm", ["-rf", f"{tmp.path().to_text()}/app/target", f"{tmp.path().to_text()}/lib/target"])
	let cold = build(nikaia, app.path().to_text(), cache, trace)
	println(f"cold: {inferred(trace)}")
	print(cold)
	// Cargo's record of a fresh crate dropped: the wrapper lowers each
	// crate again, and the cache answers.
	process::run("sh", ["-c", "find target -name cargo-fresh -delete"]; dir: app.path().to_text())
	let again = build(nikaia, app.path().to_text(), cache, trace)
	println(f"wrapper again: {inferred(trace)}; says the same {again == cold}")
	let warm = build(nikaia, app.path().to_text(), cache, trace)
	println(f"warm: {inferred(trace)}; says the same {warm == cold}")
}
