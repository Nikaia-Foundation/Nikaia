/// A method's top-of-body assert over its receiver's fields is a
/// precondition (ADR-269 D15, #2231), proved at each call with the receiver
/// put in for `self`: `b.below(3)` on `k: 5`, a call on `self` inside
/// `twice`, and a `pub` method over a `pub` field.
struct Box { k: i64 }

impl Box {
	fn below(ref self, i: i64) -> i64 sync {
		assert(i < self.k)
		return self.k - i
	}

	fn twice(ref self) -> i64 sync {
		return self.below(2) * 2
	}
}

pub struct Open { pub k: i64 }

impl Open {
	pub fn below(ref self, i: i64) -> i64 sync {
		assert(i < self.k)
		return self.k - i
	}
}

fn main() throws {
	let b = Box { k: 5 }
	println(b.below(3).to_string())
	println(b.twice().to_string())
	let o = Open { k: 4 }
	println(o.below(1).to_string())
}
