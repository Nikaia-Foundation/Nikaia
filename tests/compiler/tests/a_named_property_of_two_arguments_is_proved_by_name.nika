// #2175 (ADR-381 D1): a property with several arguments is one name of the
// prover, keyed by the function and every argument: `assert(within(xs, n))`
// reached once proves the second, known from the first; `within(xs, m)`
// names another property and stays open.
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
		],
	).stdout.trim().clone()
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn shown(tmp: String, text: String) -> String {
	let mut lines: Vec[String] = []
	for line in text.replace(tmp, "TMP").lines() {
		let t = line.trim()
		if t.starts_with("Compiling") || t.starts_with("Finished") || t.starts_with("Running") {
			continue
		}
		lines.push(line.clone())
	}
	return lines.join("\n")
}

fn ran(tmp: String, file: String, text: String, args: Vec[String]) throws {
	fs::write(f"{tmp}/{file}", fs::Root::Anywhere, text)
	println(f"== {args.join(" ")}")
	let out = process::run(toolchain(), args; dir: tmp)
	println(shown(tmp, out.stdout))
	println(f"exit {out.code}")
}

fn main() throws {
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	ran(tmp, "two.nika", "fn within(xs: ref Vec[i64], n: i64) -> bool sync {\n\treturn n < xs.len()\n}\n\nfn main() throws {\n\tlet xs = [1, 2, 3]\n\tlet n = 1\n\tlet m = 2\n\tassert(within(xs, n))\n\tassert(within(xs, n))\n\tassert(within(xs, m))\n\tprintln(\"ok\")\n}\n", ["check", "--asserts", "--unproved-claims=warn", "two.nika"])
	process::run("rm", ["-rf", tmp])
}
