/// `--asserts` lists a derived precondition too (ADR-391 D4): `pick`'s
/// callers both hand it an `at` of at most `arms.len()`, so it is listed,
/// marked `derived`, with the lines of its calls, as `--bounds` lists it.
/// `pick_pub` has the same shape, but a `pub` function can be called from
/// where the walk does not see, so nothing is derived for it.
fn pick(arms: ref Vec[i64], at: i64) -> i64 {
	let mut before = 0
	let mut sum = 0
	while before < at {
		sum = arms[before]
		before += 1
	}
	return sum
}

pub fn pick_pub(arms: ref Vec[i64], at: i64) -> i64 {
	let mut before = 0
	let mut sum = 0
	while before < at && before < arms.len() {
		sum = arms[before]
		before += 1
	}
	return sum
}

fn main() {
	let xs = [1, 2, 3]
	assert(xs.len() == 3)
	println(f"{pick(xs, 2)}")
	println(f"{pick(xs, xs.len())}")
	println(f"{pick_pub(xs, 2)}")
}
