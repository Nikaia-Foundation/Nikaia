struct View { head: String }
struct Cursor { input: String, pos: i64 }

fn parse(t: String) -> View {
    return View { head: t }
}

// ADR-353 (#942): a view itself, stored in a field that is changed in place,
// is still a type error (`NK1106`), not a moved text.
fn main() {
    let n = 1
    let text = f"a: {n}"
    let v = parse(text)
    let mut c = Cursor { input: v.head, pos: 0 }
    c.input.push_str("!")
    println(c.input)
}
