// #1974: `chars()` on text is refused, `NK1353`, an error whose edit writes
// `.scalars` for `.chars()` (ADR-320 D3), which `nikaia fix` makes. Four
// uses on text (a `for`, a count, a literal collected, a trimmed text) are
// refused, each typed as `.scalars` so nothing after it is refused too; a
// type's own `chars` method is not text and is left alone.
struct W { n: i64 }

impl W {
    fn chars(ref self) -> i64 {
        return self.n
    }
}

fn vowels(s: ref str) -> i64 {
    let mut n = 0
    for c in s.chars() {
        if c == 'a' || c == 'e' {
            n += 1
        }
    }
    return n
}

fn main() throws {
    let s = "tea"
    println(vowels(s))
    println(s.chars().count())
    let v: Vec[scalar] = "abc".chars().collect()
    println(v.len())
    println("  hi ".trim().chars().all(fn(c) { c.is_alphabetic() }))
    let w = W { n: 7 }
    println(w.chars())
}
