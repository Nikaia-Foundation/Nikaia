// A `@stream` entry whose items come from `emit` in the rules it reaches
// (ADR-grammar-typed-read-v2 D7, amended 2026-11-18, #2061): the walk sees them in the
// order the parse emits them, one at a time, and a `break` ends the parse
// there, so what follows is never read.

struct Event {
	word: String,
	depth: i64,
}

grammar Events {
	@stream entry rule events -> Event = "[" group* "]"
	rule group = "(" => inner* ")" -> { emit Event { word: "close", depth: 1 } }
	rule inner = "-" => w:until(";") ";" -> {
		emit Event { word: w.clone(), depth: 2 }
		if w == "twice" {
			emit Event { word: "again", depth: 2 }
		}
	}
}

fn words(text: String, stop: String) -> i64 throws {
	let mut seen = 0
	for ev in Events::events(text) {
		if ev.word == stop {
			break
		}
		println(f"{ev.depth} {ev.word}")
		seen += 1
	}
	return seen
}

fn main() throws {
	println(f"walked {words("[(-a;-twice;)(-b;)]", "")}")
	println(f"read {words("[(-a;-stop;)(-this has no end", "stop")} before the stop")
	let all = words("[(-a;-stop;)(-this has no end", "") catch { -1 }
	println(f"walked to the end: {all}")
}
