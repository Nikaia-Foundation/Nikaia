use std::collections
fn main() {
    let mut m: collections::HashMap[String, (i64, i64, String)] = collections::HashMap()
    m.insert("a", (1, 2, "q"))
    let (a, b, s) = m.get("a") ?? (0, 0, "none")
    println(f"{a} {b} {s}")
    let (a, b, s) = m.get("b") ?? (0, 0, "none")
    println(f"{a} {b} {s}")
}
