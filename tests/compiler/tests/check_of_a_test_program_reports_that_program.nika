// #972, ADR-269 D22: `nikaia check tests/NAME.nika` inside a project checks
// that test program as `nikaia test` builds it, a program of its own that may
// `use` the package, and so reports its own refusal, never the one of
// another test program beside it.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn check(nikaia: String, tmp: ref fs::Root, file: String) throws {
    println(f"-- check {file}")
    let out = process::run(nikaia, ["check", file]; dir: tmp.path().to_text())
    for line in f"{out.stdout}{out.stderr}".lines() {
        if line.starts_with("error") || line.trim().starts_with("-->") || line.starts_with("Checked") {
            println(line.replace(tmp.path().to_text(), "TMP"))
        }
    }
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src", f"{tmp.path().to_text()}/tests"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"doubling\"\nversion = \"0.1.0\"\n")
    fs::write("src/main.nika", tmp, "pub fn double(x: i64) -> i64 {\n    return x * 2\n}\n\nfn main() throws {\n    println(double(1))\n}\n")
    fs::write("tests/a_bang.nika", tmp, "fn main() {\n    println!(\"hi\")\n}\n")
    fs::write("tests/b_wrong_type.nika", tmp, "fn main() throws {\n    let x: i64 = \"text\"\n    println(x)\n}\n")
    fs::write("tests/c_uses_the_package.nika", tmp, "use doubling\n\nfn main() throws {\n    println(doubling::double(2))\n}\n")
    check(nikaia, tmp, "tests/b_wrong_type.nika")
    check(nikaia, tmp, "tests/a_bang.nika")
    check(nikaia, tmp, "tests/c_uses_the_package.nika")
    check(nikaia, tmp, "src/main.nika")
}
