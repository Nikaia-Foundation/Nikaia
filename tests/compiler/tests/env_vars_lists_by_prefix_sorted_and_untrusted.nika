// #1601, ADR-397: `env::vars(prefix)` lists the variables whose name starts
// with `prefix`, sorted by name, and leaves out an empty value as `env::var`
// does. The child gets its variables through `process::run`'s `env:`. The
// values are the operator's (ADR-397 D1, #2216): an `assert` about one is a
// claim as any other (`NK1300`), unless a name a CGI host fills can start
// with the prefix (D2): `env::vars("")`, `env::vars("HTTP")` and
// `env::vars("REMOTE")` are untrusted, an `assert` about one is `NK1202`.
//
// A value that is not Unicode is not tested: `env:` is `Vec[(String,
// String)]` and cannot hand a child one.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn said(nikaia: String, tmp: ref fs::Root, label: String, source: String, verb: Vec[String]) throws {
    fs::write("p.nika", tmp, source)
    let mut args = verb.clone()
    args.push("p.nika")
    let env = [("NKV_ZETA", "26"), ("NKV_ALPHA", "1"), ("NKV_EMPTY", ""), ("NKV_MID", "13"), ("NKW_OTHER", "x")]
    let out = process::run(nikaia, args; dir: tmp.path().to_text(), env: env)
    println(f"-- {label}")
    for line in f"{out.stdout}{out.stderr}".lines() {
        let kept = line.starts_with("error") || line.starts_with("Checked") || line.starts_with("NKV") || line.starts_with("count") || line.starts_with("input provenance") || line.starts_with("    ") && line.contains(" is ")
        if kept {
            println(line.replace(tmp.path().to_text(), "TMP"))
        }
    }
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    let head = "use std::env\nuse std::text\n\nfn main() throws {\n"
    let listed = "    for (name, value) in env::vars(\"NKV_\") {\n        println(f\"{name}={value}\")\n    }\n    println(f\"count {env::vars(\"\").len() > 3}\")\n}\n"
    said(nikaia, tmp, "the prefix, the order, no empty value", f"{head}{listed}", ["run"])
    let tail = "    assert(n > 0)\n    println(n)\n}\n"
    for prefix in ["NKV_MID", "", "HTTP", "REMOTE"] {
        let read = f"    let n: i64 = text::parse_i64(env::vars(\"{prefix}\")[0].1) ?? 8\n"
        said(nikaia, tmp, f"an assert on env::vars(\"{prefix}\")", f"{head}{read}{tail}", ["check"])
    }
    let map = "use std::env\nuse std::collections\n\nfn main() throws {\n    let mut m = collections::HashMap()\n    for (name, value) in env::vars(\""
    let rest = "\") {\n        m.insert(value, name)\n    }\n    println(m.len())\n}\n"
    said(nikaia, tmp, "a map keyed by env::vars(\"NKV_\")", f"{map}NKV_{rest}", ["lower", "--trust", "-o", "p.rs"])
    said(nikaia, tmp, "a map keyed by env::vars(\"\")", f"{map}{rest}", ["lower", "--trust", "-o", "p.rs"])
}
