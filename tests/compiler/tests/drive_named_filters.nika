// scripts/drive.nika --named-filters FILE: the tests named after the changed
// scripts, which the driver runs before a suite goes to CI.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, tmp: ref fs::Root, name: String, paths: String) throws {
    fs::write(f"{name}", tmp, paths)
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--named-filters", f"{tmp.path().to_text()}/{name}"]; dir: repo)
    println(f"== {name}")
    println(out.stdout.trim())
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    case(nikaia.clone(), repo.clone(), tmp, "drive", "scripts/drive.nika\ndocs/a.md\n")
    case(nikaia.clone(), repo.clone(), tmp, "first-word", "scripts/agent-facts.nika\n")
    case(nikaia.clone(), repo.clone(), tmp, "untested", "scripts/zz-nothing.nika\ncrates/nikaia/src/main.rs\n")
    case(nikaia.clone(), repo.clone(), tmp, "nested", "scripts/sub/drive.nika\n")
    case(nikaia.clone(), repo.clone(), tmp, "twice", "scripts/drive.nika\nscripts/drive.nika\n")
}
