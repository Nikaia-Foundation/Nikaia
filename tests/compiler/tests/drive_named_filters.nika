// scripts/drive.nika --named-filters FILE: the tests named after the changed
// scripts, which the driver runs before a suite goes to CI.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/drive.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/drive.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn case(nikaia: String, repo: String, tmp: String, name: String, paths: String) throws {
    fs::write(f"{tmp}/{name}", fs::Root::Anywhere, paths)
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--named-filters", f"{tmp}/{name}"]; dir: repo)
    println(f"== {name}")
    println(out.stdout.trim())
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let repo = root()
    let nikaia = toolchain()
    case(nikaia.clone(), repo.clone(), tmp.clone(), "drive", "scripts/drive.nika\ndocs/a.md\n")
    case(nikaia.clone(), repo.clone(), tmp.clone(), "first-word", "scripts/agent-facts.nika\n")
    case(nikaia.clone(), repo.clone(), tmp.clone(), "untested", "scripts/zz-nothing.nika\ncrates/nikaia/src/main.rs\n")
    case(nikaia.clone(), repo.clone(), tmp.clone(), "nested", "scripts/sub/drive.nika\n")
    case(nikaia.clone(), repo.clone(), tmp.clone(), "twice", "scripts/drive.nika\nscripts/drive.nika\n")
    process::run("rm", ["-rf", tmp])
}
