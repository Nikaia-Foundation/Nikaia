// scripts/gate.nika --full --dry-run: which steps run, from the files changed
// against the base, the files named after --files and the tests after --tests;
// with --all, the complete suite.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn git(tmp: ref fs::Root, args: Vec[String]) throws {
    let mut all: Vec[String] = ["-c", "user.name=t", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    process::run("git", all; dir: tmp.path().to_text())
}

fn case(nikaia: String, gate: String, tmp: ref fs::Root, name: String, extra: Vec[String]) throws {
    let mut args: Vec[String] = ["run", gate, "--", "--full", "--dry-run", "--base", "base"]
    for a in extra { args.push(a.clone()) }
    let out = process::run(nikaia, args; dir: tmp.path().to_text())
    println(f"== {name}")
    println(out.stdout.trim())
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let gate = f"{repo}/scripts/gate.nika"
    let nikaia = toolchain(repo)
    git(tmp, ["init", "-q"])
    fs::write("a.txt", tmp, "x\n")
    git(tmp, ["add", "a.txt"])
    git(tmp, ["commit", "-q", "-m", "base"])
    git(tmp, ["branch", "base"])
    case(nikaia.clone(), gate.clone(), tmp, "nothing changed", [])
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/tests/compiler/tests", f"{tmp.path().to_text()}/crates/nikaia-std/src/compiler"])
    for f in ["tests/compiler/tests/foo.nika", "tests/compiler/tests/foo.stdout", "crates/nikaia-std/src/compiler/x.nika"] {
        fs::write(f"{f}", tmp, "x\n")
        git(tmp, ["add", f])
    }
    git(tmp, ["commit", "-q", "-m", "change"])
    for f in ["tests/compiler/tests/bar.nika", "tests/compiler/tests/bar.stderr", "tests/compiler/tests/baz.nika", "other.txt"] {
        fs::write(f"{f}", tmp, "x\n")
    }
    case(nikaia.clone(), gate.clone(), tmp, "a tools file and tests", ["--files", "tests/compiler/tests/bar.stderr", "--tests", "baz", "qux"])
    case(nikaia.clone(), gate.clone(), tmp, "the emitter", ["--files", "crates/nikaia/src/emit/mod.rs"])
    case(nikaia.clone(), gate.clone(), tmp, "the complete suite", ["--all"])
}
