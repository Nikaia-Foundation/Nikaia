/// The perfect-hash table builder of `crates/nikaia-std/src/compiler/fixed.nika`,
/// copied whole: its reads and its arithmetic stay proved (#1763, where a
/// fresh `lower-std` once lowered `lowered/fixed.rs` with three proofs fewer
/// than the committed file). A walk that loses one shows in the `.bounds`.
pub comptime HASHED_FROM: i64 = 12

pub struct Table {
	pub seed: u64,
	pub disps: Vec[(u32, u32)],
	pub keys: Vec[String],
	pub order: Vec[i64],
}

pub fn fnv(key: ref String, seed: u64) -> u64 sync {
	let mut hash: u64 = 0xcbf29ce484222325 ^ seed
	for b in key.bytes() {
		hash ^= b as u64
		hash = hash.wrapping_mul(0x100000001b3)
	}
	return hash
}

pub fn displace(f1: u32, f2: u32, d1: u32, d2: u32) -> u32 sync {
	return d2.wrapping_add(f1.wrapping_mul(d1)).wrapping_add(f2)
}

pub fn build(keys: ref Array[String]) -> Table? sync {
	let n = keys.len()
	if n < HASHED_FROM {
		let mut written: Vec[String] = []
		let mut order: Vec[i64] = []
		for at in 0..<n {
			written.push(keys[at].clone())
			order.push(at)
		}
		return Table { seed: 0, disps: [], keys: written, order }
	}
	let mut buckets = (n + 4) / 5
	if buckets < 1 {
		buckets = 1
	}
	for seed in 0..<200 {
		let table = attempt(keys, seed as u64, buckets, n)
		if table != null {
			return table
		}
	}
	return null
}

fn attempt(keys: ref Array[String], seed: u64, buckets: i64, n: i64) -> Table? sync {
	let mut by_bucket: Vec[Vec[(i64, u32, u32)]] = []
	for _ in 0..<buckets {
		by_bucket.push([])
	}
	for at in 0..<n {
		let hash = fnv(keys[at], seed)
		let g = (hash >> 32).truncating_u32()
		let f1 = hash.truncating_u32()
		let f2 = (hash >> 16).truncating_u32()
		by_bucket[(g as i64) % buckets].push((at, f1, f2))
	}

	let mut order: Vec[(i64, i64)] = []
	for b in 0..<buckets {
		let size = by_bucket[b].len()
		if size > 0 {
			order.push((0 - size, b))
		}
	}
	order.sort()

	let mut disps: Vec[(u32, u32)] = []
	for _ in 0..<buckets {
		disps.push((0, 0))
	}
	let mut slots: Vec[i64] = []
	for _ in 0..<n {
		slots.push(-1)
	}
	for (_, bucket) in order {
		let mut placed = false
		let mut d1: u32 = 0
		while !placed && (d1 as i64) < n {
			let mut d2: u32 = 0
			while !placed && (d2 as i64) < n {
				let mut taken: Vec[(i64, i64)] = []
				let mut fits = true
				for (at, f1, f2) in by_bucket[bucket] {
					let slot = (displace(f1, f2, d1, d2) as i64) % n
					let mut clash = slots[slot] >= 0
					for t in taken {
						if t.0 == slot {
							clash = true
						}
					}
					if clash {
						fits = false
						break
					}
					taken.push((slot, at))
				}
				if fits {
					disps[bucket] = (d1, d2)
					for (slot, at) in taken {
						slots[slot] = at
					}
					placed = true
				}
				d2 += 1
			}
			d1 += 1
		}
		if !placed {
			return null
		}
	}

	let mut written: Vec[String] = []
	let mut at_of: Vec[i64] = []
	for slot in slots {
		if slot < 0 {
			return null
		}
		written.push(keys[slot].clone())
		at_of.push(slot)
	}
	return Table { seed, disps, keys: written, order: at_of }
}

fn word(at: i64) -> String {
	let mut s = String()
	s.push_str("key")
	s.push_str(at.to_string())
	return s
}

fn main() throws {
	let mut keys: Vec[String] = []
	for at in 0..<20 {
		keys.push(word(at))
	}
	let small = build(keys[0..<3])
	if small != null {
		println(f"small: {small.keys.len()} keys, {small.disps.len()} buckets")
	}
	let large = build(keys)
	if large != null {
		let mut sorted = large.order.clone()
		sorted.sort()
		println(f"large: {large.keys.len()} keys, {large.disps.len()} buckets, first slot holds key {sorted[0]}")
	}
}
