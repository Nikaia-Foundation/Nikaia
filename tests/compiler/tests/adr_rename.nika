// scripts/adr-rename.nika moves ADR citations to their new record from a
// table (#2262, ADR-decision-records-v2 D3). Shown on a fixture tree given
// with `--root`: a single decision, a list, a range (`-` and `–`), a `'s`
// citation, a link from inside the records' directory, a record moved whole
// (its decisions keep their numbers), a citation whose decisions start on the
// next comment line (#2298), and what it lists instead of rewriting: a list
// split over two records, a `§` citation, a decision the table does not name,
// a list that goes on past a line break, a link whose path reaches neither
// record directory (#2363). A package's source is searched like a crate's;
// a link to the history's copy and `docs/history/` stay as they are.
// `--dry-run` prints the same and writes nothing.
//
// The fixture is written here, with `~` for the `-` of its citations, and
// what is shown is written back so: the made-up records 901 and 902 would
// otherwise be dangling citations to check-adr-refs.nika, which reads tests/.
use std::env
use std::fs
use std::process

// The running `nikaia` (`env::current_exe`, ADR-program-path-1 D3), no outside
// data where it runs a program (ADR-397 D1).
fn toolchain() -> String throws {
	return env::current_exe()?.display() ?? "target/fast/nikaia"
}

// The repository: a test program runs in its package's directory,
// `tests/compiler`, two below the root; `.` where it is run from the root.
// Literal paths, so nothing from outside names a file (ADR-raw-sinks-1 D11).
fn root() -> String throws {
	return if fs::exists("scripts/drive.nika", fs::Root::Dir(".")) { "." } else { "../.." }
}

fn masked(s: String) -> String {
	return s.replace("ADR-", "ADR~").replace("adr-", "adr~")
}

// Writes `file` under `tree`, a root joined to a directory `std` made
// (ADR-raw-sinks-1 D12, D13), its directories first.
fn put(tree: fs::Root, file: String, text: String) throws {
	let path = file.replace("~", "-")
	let (dir, _) = path.rsplit_once("/") ?? (".", "")
	fs::create_dir(dir, tree; recursive: true)
	fs::write(path, tree, text.replace("~", "-"))
}

fn show(tree: fs::Root, file: String) throws {
	println(f"--- {file}")
	print(masked(fs::read_to_string(file, tree)))
}

// Runs the script in `dir`, where its copy and the fixture are: it takes
// names below the directory it runs in only (ADR-raw-sinks-1 D14).
fn run(dir: String, nikaia: String, args: Vec[String]) throws {
	let mut all: Vec[String] = ["run", "adr-rename.nika", "--"]
	for a in args { all.push(a.clone()) }
	let out = process::run(nikaia, all; dir: dir)
	println(masked(out.stdout.trim()))
	if out.stderr.trim().len() > 0 { println(masked(out.stderr.trim())) }
	println(f"exit {out.code}")
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let dir = fs::scratch()
	fs::create_dir("tree", dir; recursive: true)
	let tree = dir.join("tree")
	let base = f"{dir.path().display()}"
	fs::write(
		"adr-rename.nika",
		dir,
		fs::read_to_string("scripts/adr-rename.nika", fs::Root::Dir(repo)),
	)
	fs::write(
		"table.txt",
		dir,
		"# the decisions of 901 move apart; 902 moves whole\n901 D3 -> moved-v1 D1\n901 D4 -> moved-v1 D2\n901 D5 -> other-v1 D7\n902 -> moved-v1\n",
	)
	put(
		tree.clone(),
		"docs/notes.md",
		"One: ADR~901 D3.\nList: ADR~901 D3, D4.\nRange: ADR~901 D3-D4, ADR~901 D3–D4.\nOwn: ADR~901's D4.\nWhole: ADR~902, and ADR~902 D6.\nSplit: ADR~901 D3, D5.\nSection: ADR~901 §2.\nUnknown: ADR~901 D9.\nHistory: [ADR~901](../docs/history/adr/adr~901.md) D3.\nAstray: [ADR~901](adr~901.md) D3.\n",
	)
	put(
		tree.clone(),
		"docs/specification/adr/adr~903.md",
		"Links: [ADR~901](adr~901.md) D3, [901](adr~901.md) D4, [902](adr~902.md).\n",
	)
	put(
		tree.clone(),
		"crates/a/src/lib.rs",
		"// ADR~902 D2 and ADR~901 D5\n    // a rule (ADR~901\n    // D4), and more\n// ADR~901 D3,\n// D4 past the break\n",
	)
	put(tree.clone(), "packages/p/src/main.nika", "// ADR~901 D4 in a package\n")
	put(tree.clone(), "docs/history/adr/README.md", "ADR~901 D3 is archived.\n")
	put(tree.clone(), "src/main.nika", "// ADR~901 D3 outside the searched files\n")
	run(base.clone(), nikaia.clone(), ["table.txt", "--root", "tree", "--dry-run"])
	show(tree.clone(), "docs/notes.md")
	run(base, nikaia, ["table.txt", "--root", "tree"])
	for file in ["docs/notes.md", "docs/specification/adr/adr~903.md", "crates/a/src/lib.rs", "packages/p/src/main.nika", "docs/history/adr/README.md", "src/main.nika"] {
		show(tree.clone(), file.replace("~", "-"))
	}
}
