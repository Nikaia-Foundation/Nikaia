// batch.nika: a `Supervisor: <date>: accepted ...` line clears a cut on
// Result, Gate, Deviation or Pushed: none (nothing to build), never on
// Result: blocked, Pushed: rejected or Owner.
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn first(nikaia: String, repo: String, tmp: ref fs::Root) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/batch.nika", "--", "."]; dir: tmp.path().to_text())
    return out.stdout.trim().split("\n").collect()[0].replace(tmp.path().to_text(), "T")
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    // The scripts run in their lane's directory, which lies below the
    // working directory; they find the toolchain and scripts under the
    // checkout's names.
    process::run("ln", ["-s", f"{repo}/target", f"{tmp.path().to_text()}/target"])
    process::run("ln", ["-s", f"{repo}/scripts", f"{tmp.path().to_text()}/scripts"])
    fs::write("batch.txt", tmp, "a.md\n")
    fs::write("a.md", tmp, "body\n")
    let ok = "Supervisor: 2026-11-10: accepted, see #1\n"
    let cases = [
        ["deviation", "Result: done\nPushed: abc\nDeviation: x\n"],
        ["gate red", "Result: done\nPushed: abc\nGate: red x\nDeviation: none\n"],
        ["partial", "Result: partial, rest in #2\nPushed: abc\nDeviation: none\n"],
        ["blocked", "Result: blocked\nPushed: none\nDeviation: none\n"],
        ["rejected", "Result: done\nPushed: rejected\nDeviation: x\n"],
        ["nothing pushed", "Result: done\nFiles: none\nPushed: none\nDeviation: none\n"],
    ]
    for c in cases {
        fs::write("a.report.md", tmp, c[1].clone())
        println(f"{c[0]}: {first(nikaia.clone(), repo.clone(), tmp)}")
        fs::write("a.report.md", tmp, c[1].clone() + ok)
        println(f"{c[0]} accepted: {first(nikaia.clone(), repo.clone(), tmp)}")
    }
    fs::write("a.report.md", tmp, "Result: done\nPushed: abc\nDeviation: x\nSupervisor: 2026-11-10: noted, not decided\n")
    println(f"not accepted: {first(nikaia.clone(), repo.clone(), tmp)}")
    fs::write("a.report.md", tmp, "Result: done\nPushed: abc\nDeviation: none\nOwner: which way?\n" + ok)
    println(f"owner: {first(nikaia.clone(), repo.clone(), tmp)}")
}
