// Every build asks a check a loop leaves open through the loop (ADR-361 D14,
// #1473): the word `prove-through-loops` that once chose it is refused, in
// `[build] optimization` and on the command line alike, naming the decision.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let nikaia = toolchain()
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"loops\"\nversion = \"0.1.0\"\n\n[build]\noptimization = \"remove-bounds-checks:on,prove-through-loops:on\"\n")
    fs::write("src/main.nika", tmp, "fn main() throws {\n    println(\"never\")\n}\n")
    let out = process::run(nikaia, ["build"]; dir: tmp.path().to_text(), env: [("RUST_BACKTRACE", "0")])
    println(f"exit {out.code}")
    println(out.stderr.trim().replace(tmp.path().to_text(), "TMP"))
    fs::write("nikaia.toml", tmp, "[package]\nname = \"loops\"\nversion = \"0.1.0\"\n")
    let flag = process::run(nikaia, ["check", "--optimization", "prove-through-loops:off", "src/main.nika"]; dir: tmp.path().to_text(), env: [("RUST_BACKTRACE", "0")])
    println(f"exit {flag.code}")
    println(flag.stderr.trim().replace(tmp.path().to_text(), "TMP"))
}
