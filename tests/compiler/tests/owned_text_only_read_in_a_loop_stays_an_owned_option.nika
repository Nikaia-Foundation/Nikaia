// Owned text only read inside a loop stays an owned option (#686). The second
// run of `tether_keep::owned_text_assigned_to_a_field_is_moved_not_kept`, whose
// check of the lowered Rust stays there (#2849).
struct L {
    from: String?,
}

fn word(n: i64) -> String {
    return f"w{n}"
}

fn main() throws {
    let l = L { from: null }
    for i in 0..<2 {
        if i == 1 {
            let key: String? = word(i)
            println(key ?? "")
        }
    }
    println(l.from ?? "-")
}
