// A `[build]` switch written under `[package]` is read by nothing, so the
// build would run at the switch's default without a word (#1772): it is
// refused, naming `[build]`, like a key `[build]` does not know (Part III).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let nikaia = toolchain()
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"p\"\nversion = \"0.1.0\"\nuser-parallelism = \"yes\"\n")
    fs::write("src/main.nika", tmp, "fn main() throws { println(\"hi\") }\n")
    let out = process::run(nikaia, ["build"]; dir: tmp.path().to_text(), env: [("RUST_BACKTRACE", "0")])
    println(f"exit {out.code}")
    println(out.stderr.trim().replace(tmp.path().to_text(), "TMP"))
}
