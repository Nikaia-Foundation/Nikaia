// The solver's regression set (`tests/solver/regress`, #1961): files of the
// SMT-LIB set (`tests/solver/SOURCES.md`) a fix brought within the limit,
// run under a work budget of 300000 steps of the proof log (`--budget`,
// #2107), so a file whose elimination or search grows past it shows as
// `unknown (steps)` in the diff. A count, not a wall-clock limit: the arm64
// CI runner overran 10 s on the two SMPT files that take 4 s and 2 s on an
// x86 machine (`docs/measuring.md`: count, never time). The files need 31128
// (Diffusion2D), 225922 (Referendum), 851 (c_inference, which its cases stop
// first), 9967 (bofill) and 79 steps (clock_synchro), the same on every
// machine.
// QF_LIA bofill-scheduling SMT_real_LIA-ex2360_2400_100 took about 25 s on the rod before c29e706e1
// (the equality elimination compared every pair of bounds each round, #1957)
// and about 2 s since. QF_LIA 20231117-c_inference 30_30_86_7_sat ran past
// its time limit while only the theory checks that pivot counted toward the
// budget (#2011); since a check costs one case and two more a pivot (#2048)
// it ends `unknown (cases)` within about 3 s.
// QF_LIA 20220307-SMPT Diffusion2D-PT-D50N010-RC-00 took about 19 s while
// each round of the equality elimination copied and tidied every bound
// again; since it substitutes in place and tidies only what changed, about
// 4 s (#2012). Referendum-PT-0200-RF-00 took about 20 s while each
// combination looked every assumed literal up in the other set, in the
// engine and in the certificate checker; since the two sorted sets are
// merged, about 2 s (#2012).
// QF_LRA sal carpark-Carpark2-ausgabe-6 (#1967) took about 6 s on the rod
// until 310f645c6 (the simplex's propagation scanned the trail for each
// atom), and QF_LRA spider_benchmarks current_frame.base (#1968) about 8 s;
// at opt-level 3 (c41d26781, #2004) both take under 0.1 s. They need 7983
// and 4541 steps. Their old cost was the price of each step, not the number
// of steps, so the budget does not catch its return; the measuring rod's
// count of instructions does (`docs/measuring.md`).
// QF_LRA clock_synchro clocksynchro_8clocks.main_invar.base answered
// `unknown (overflow)` until 45c6fe94b (#2307, #2400): every pivot of its
// simplex formed a row past `i64` in single width; combined in double width
// and reduced by its gcd it fits, and the file is proved in 79 steps.
// QF_LIA rings_preprocessed ring_2exp4_5vars_3ite_unsat needs 31150 cases,
// past the build-time 1024 (its line in the first run is `unknown (cases)`),
// so a second run gives it alone a case budget of 65536 (`--cases`, #1962):
// `compare` scored it unknown at 10 s until fe3e835a5 (#2090) ran ours there
// under the time limit alone, and dfbb7772a (the simplex refreshes only the
// rows a changed variable stands in) brought it to about 8 s.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let ring = "tests/solver/regress/rings_preprocessed-ring_2exp4_5vars_3ite_unsat.smt2"
	for extra in [["tests/solver/regress"], ["--cases", "65536", ring]] {
		let mut all: Vec[String] = ["run", "scripts/solver.nika", "--", "run", "--budget", "300000"]
		for a in extra { all.push(a.clone()) }
		let out = process::run(nikaia.clone(), all.clone(); dir: repo.clone())
		println(out.stdout.trim())
		// A failed inner run names its cause in the diff (#1305).
		if !out.ok || out.stderr.trim().len() > 0 {
			println(f"inner run `nikaia {all.join(" ")}` exited {out.code}, stderr:")
			let said = out.stderr.trim()
			if said.len() == 0 { println("(empty)") } else { println(said) }
		}
	}
}
