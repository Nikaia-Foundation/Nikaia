// A walk is not handed to a function of the program's own (ADR-105 D4): no
// program writes `Par[T]` or `Seq[T]`, so no function ends a walk whose
// `within:` its checker has not seen (ADR-async-5 D27, #1423).
use std::time

fn total(p: Par[i64]) -> i64 { return p.fold(0, fn(a, x) { a + x }, fn(a, b) { a + b }) }

fn main() throws {
    let xs = [1, 2, 3]
    println(f"{total(xs.par_iter(within: 1.millis()))}")
}
