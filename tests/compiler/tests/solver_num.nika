// The solver's numbers (ADR-270 D11, #1282 items 1-2): `i64` only, kept
// small by gcd reduction and the smallest cancelling multipliers, never
// wrapped. A 40-step elimination chain stays within 32 bits where the same
// chain without the gcd leaves them at step 28 and is refused, not wrapped,
// at step 60; rationals are normalised and compared without overflow, and
// `δ` orders strict bounds. `solver/sv_num.nika` is run beside a driver.
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
		],
	).stdout.trim().clone()
	if exe.len() > 0 { return exe }
	return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "// The other bound of step `n`, reduced (gcd 1): its first column, `-2`,
// cancels the current row's `2`; the others have the row's sign, so the
// first is the only column two bounds may be combined on.
fn partner(n: i64) -> Vec[i64] {
    return [-2, 1, 5, 1 + n % 7]
}

// Without the gcd: the multipliers are the two coefficients themselves.
fn naive(x: ref Vec[i64], y: ref Vec[i64], j: i64) -> Vec[i64]? {
    let mut a = y[j]
    let mut b = x[j]
    if a < 0 { a = -a } else { b = -b }
    let mut out: Vec[i64] = []
    let mut i = 0
    while i < x.len() {
        out.push(sv_mul_add(a, x[i], b, y[i]) ?? return null)
        i += 1
    }
    return out
}

fn chain(reduce: bool, steps: i64) -> String {
    let mut c: Vec[i64] = [2, 1, 3, 4]
    let mut n = 0
    let mut largest: i64 = 0
    let mut left32: i64 = -1
    while n < steps {
        let f = partner(n)
        let j = sv_pick_column(c, f, 3, true)
        if j < 0 {
            return f\"step {n}: no column\"
        }
        let next = if reduce { sv_dense_eliminate(c, f, j) } else { naive(c, f, j) }
        let made = next ?? return f\"step {n + 1}: refused, would leave i64 (left 32 bits at step {left32}, largest so far {largest})\"
        c = made
        largest = sv_max_abs(c) ?? -1
        if left32 < 0 && !sv_fits32(largest) {
            left32 = n + 1
        }
        if c[j] != 0 {
            return f\"step {n}: column {j} left\"
        }
        // The eliminated column comes back with the next bound.
        c[j] = 2
        n += 1
    }
    return f\"{steps} steps, largest coefficient {largest}, within 32 bits: {sv_fits32(largest)}\"
}

fn show(r: SvRat?) -> String {
    let v = r ?? return \"refused\"
    return sv_rat_text(v)
}

fn order(a: ref SvRat, b: ref SvRat) -> String {
    let c = sv_rat_cmp(a, b)
    let op = if c < 0 { \"<\" } else if c > 0 { \">\" } else { \"=\" }
    return f\"{sv_rat_text(a)} {op} {sv_rat_text(b)}\"
}

fn dorder(a: ref SvDelta, b: ref SvDelta) -> String {
    let c = sv_delta_cmp(a, b)
    let op = if c < 0 { \"<\" } else if c > 0 { \">\" } else { \"=\" }
    return f\"{sv_delta_text(a)} {op} {sv_delta_text(b)}\"
}

fn main() {
    println(\"== item 1: i64 kept small\")
    println(f\"reduced chain: {chain(true, 40)}\")
    println(f\"unreduced chain: {chain(false, 40)}\")
    println(f\"unreduced chain, longer: {chain(false, 80)}\")
    let big: i64 = 4611686018427387904
    let sum = sv_mul_add(1, big, 1, big)
    println(f\"2^62 + 2^62: {if sum == null { \"refused\" } else { \"wrapped\" }}\")
    let wide: Vec[i64] = [3037000500, 1]
    let square = sv_dense_combine(3037000500, wide, 0, wide)
    println(f\"3037000500 * 3037000500: {if square == null { \"refused\" } else { \"wrapped\" }}\")
    let least: i64 = -9223372036854775807 - 1
    println(f\"gcd(-12, 18) = {sv_gcd(-12, 18) ?? -1}, gcd(i64 least, 0): {if sv_gcd(least, 0) == null { \"refused\" } else { \"wrapped\" }}\")
    let row: Vec[i64] = [6, -9, 12, 3]
    let shown = sv_reduced(row).iter().join(\", \")
    println(f\"reduced [6, -9, 12, 3]: [{shown}]\")
    println(f\"column cost unit {sv_column_cost(1, -7) ?? -1}, 4 vs -6: {sv_column_cost(4, -6) ?? -1}\")
    let x: Vec[i64] = [4, 1, -6]
    let y: Vec[i64] = [-6, -1, 9]
    println(f\"picked column of [4, 1, -6] and [-6, -1, 9]: {sv_pick_column(x, y, 3, true)}\")
    println(f\"floor(-7/2) = {sv_floor_div(-7, 2) ?? 0}, ceil(-7/2) = {sv_ceil_div(-7, 2) ?? 0}, floor by 0: {if sv_floor_div(1, 0) == null { \"refused\" } else { \"?\" }}\")

    println(\"== item 2: rationals and delta\")
    println(f\"6/-4 = {show(sv_rat(6, -4))}, 0/-5 = {show(sv_rat(0, -5))}, 1/0: {show(sv_rat(1, 0))}\")
    let sixth = sv_rat(1, 6) ?? sv_int(0)
    let tenth = sv_rat(1, 10) ?? sv_int(0)
    println(f\"1/6 + 1/10 = {show(sv_rat_add(sixth, tenth))}, 1/6 - 1/10 = {show(sv_rat_sub(sixth, tenth))}\")
    let p = sv_rat(3037000499, 2) ?? sv_int(0)
    let q = sv_rat(2, 3037000499) ?? sv_int(0)
    println(f\"3037000499/2 * 2/3037000499 = {show(sv_rat_mul(p, q))}, divided = {show(sv_rat_div(p, q))}\")
    let huge = sv_int(9223372036854775807)
    println(f\"i64 max + 1/2: {show(sv_rat_add(huge, sv_rat(1, 2) ?? sv_int(0)))}\")
    println(f\"divided by 0: {show(sv_rat_div(sixth, sv_int(0)))}\")
    let third = sv_rat(1, 3) ?? sv_int(0)
    let half = sv_rat(1, 2) ?? sv_int(0)
    println(order(third, half))
    println(order(sv_rat_neg(third) ?? third, sv_rat_neg(half) ?? half))
    let m: i64 = 9223372036854775807
    let a = sv_rat(m - 1, m) ?? sv_int(0)
    let b = sv_rat(m - 2, m - 1) ?? sv_int(0)
    println(order(a, b))
    println(order(sv_rat(-7, 2) ?? half, sv_rat(-14, 4) ?? half))
    let r = sv_rat(-7, 2) ?? half
    println(f\"floor(-7/2) = {sv_rat_floor(r)}, ceil = {sv_rat_ceil(r)}, integer: {sv_rat_is_int(r)}\")
    let five = sv_delta(sv_int(5), sv_int(0))
    let below = sv_delta(sv_int(5), sv_int(-1))
    let above = sv_delta(sv_int(5), sv_int(1))
    let four = sv_delta(sv_int(4), sv_int(1000))
    println(dorder(below, five))
    println(dorder(five, above))
    println(dorder(below, four))
    println(dorder(sv_delta_sub(above, five) ?? five, sv_delta(sv_int(0), sv_int(1))))
    println(f\"(5 - δ) * -2 = {sv_delta_text(sv_delta_scale(below, sv_int(-2)) ?? five)}\")
    println(f\"(5 - δ) + (4 + 1000δ) = {sv_delta_text(sv_delta_add(below, four) ?? five)}\")
}
"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain(repo.clone())
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut program = "use std::collections\n"
	for file in ["crates/nikaia-std/src/solver/sv_num.nika"] {
		program.push_str(fs::read_to_string(f"{repo}/{file}", fs::Root::Anywhere))
		program.push_str("\n")
	}
	program.push_str(driver())
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, program)
	let out = process::run(nikaia, ["run", "main.nika"]; dir: tmp)
	println(out.stdout.trim())
	process::run("rm", ["-rf", tmp])
}
