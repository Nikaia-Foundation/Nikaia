// ADR-392, #1360: `nikaia migrate print-throws` writes `throws` on each
// function that prints, on a trait's method whose impl prints, and on every
// caller the failure reaches (one calling `generic[T]()` too), a caller of a
// function that already said `throws` too; a function that only computes, a
// comment and a Markdown block of another language stay as written. The
// tool names each lambda that prints, in a `.nika` file and in a Markdown
// block, and writes nothing into it (supervisor, 2026-11-07); the migrated
// file checks, since `for_each` fails where its lambda does (#2736: it was
// NK2606).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    fs::write("a.nika", tmp, "trait Show {\n    fn draw(self)\n}\n\nstruct P {\n    x: i64,\n}\n\nimpl Show for P {\n    fn draw(self) {\n        println(f\"P {self.x}\")\n    }\n}\n\nfn quiet(x: i64) -> i64 sync {\n    return x + 1\n}\n\nfn uses(p: P) {\n    p.draw()\n}\n\nfn already() -> i64 throws {\n    eprintln(\"e\")\n    return 1\n}\n\nfn calls_already() -> i64 {\n    return already()\n}\n\nfn each(items: Vec[i64]) {\n    items.iter().for_each fn(v) { print(f\"{v} \") }\n}\n\nfn generic[T]() {\n    println(\"g\")\n}\n\nfn main() {\n    // println(\"in a comment\") is left alone\n    uses(P { x: quiet(1) })\n    generic[i64]()\n    let n = calls_already()\n    each([n])\n}\n")
    fs::write("b.md", tmp, "# A page\n\n```nika\nfn main() {\n    println(\"hi\")\n}\n```\n\n```nika\nfn show(xs: Vec[i64]) {\n    xs.iter().for_each fn(v) { println(f\"{v}\") }\n}\n```\n\n```rust\nfn main() {\n    println!(\"hi\");\n}\n```\n")
    let out = process::run(nikaia, ["migrate", "print-throws", f"{tmp.path().to_text()}/a.nika", f"{tmp.path().to_text()}/b.md"])
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    print(fs::read_to_string("a.nika", tmp))
    print(fs::read_to_string("b.md", tmp))
    let checked = process::run(nikaia, ["check", f"{tmp.path().to_text()}/a.nika"])
    print(f"check: {checked.stdout}{checked.stderr}".replace(tmp.path().to_text(), "TMP"))
}
