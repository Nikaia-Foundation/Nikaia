// ADR-392, #1360: `nikaia migrate print-throws` writes `throws` on each
// function that prints, on a trait's method whose impl prints, and on every
// caller the failure reaches (one calling `generic[T]()` too), a caller of a
// function that already said `throws` too; a function that only computes, a
// comment and a Markdown block of another language stay as written. The
// migrated file checks but for one place the tool does not move: a lambda
// that prints, handed to a parameter that does not say `throws` (`for_each`),
// is NK2606. The tool names each such lambda, in a `.nika` file and in a
// Markdown block, and writes nothing into it (supervisor, 2026-11-07).
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    fs::write(f"{tmp}/a.nika", fs::Root::Anywhere, "trait Show {\n    fn draw(self)\n}\n\nstruct P {\n    x: i64,\n}\n\nimpl Show for P {\n    fn draw(self) {\n        println(f\"P {self.x}\")\n    }\n}\n\nfn quiet(x: i64) -> i64 sync {\n    return x + 1\n}\n\nfn uses(p: P) {\n    p.draw()\n}\n\nfn already() -> i64 throws {\n    eprintln(\"e\")\n    return 1\n}\n\nfn calls_already() -> i64 {\n    return already()\n}\n\nfn each(items: Vec[i64]) {\n    items.iter().for_each fn(v) { print(f\"{v} \") }\n}\n\nfn generic[T]() {\n    println(\"g\")\n}\n\nfn main() {\n    // println(\"in a comment\") is left alone\n    uses(P { x: quiet(1) })\n    generic[i64]()\n    let n = calls_already()\n    each([n])\n}\n")
    fs::write(f"{tmp}/b.md", fs::Root::Anywhere, "# A page\n\n```nika\nfn main() {\n    println(\"hi\")\n}\n```\n\n```nika\nfn show(xs: Vec[i64]) {\n    xs.iter().for_each fn(v) { println(f\"{v}\") }\n}\n```\n\n```rust\nfn main() {\n    println!(\"hi\");\n}\n```\n")
    let out = process::run(nikaia, ["migrate", "print-throws", f"{tmp}/a.nika", f"{tmp}/b.md"])
    print(f"{out.stdout}{out.stderr}".replace(tmp, "TMP"))
    print(fs::read_to_string(f"{tmp}/a.nika", fs::Root::Anywhere))
    print(fs::read_to_string(f"{tmp}/b.md", fs::Root::Anywhere))
    let checked = process::run(nikaia, ["check", f"{tmp}/a.nika"])
    print(f"check: {checked.stdout}{checked.stderr}".replace(tmp, "TMP"))
    process::run("rm", ["-rf", tmp])
}
