// A pattern that does not compile (ADR-regex-1 D3, D8): `regex::dynamic`
// throws a `regex::Error`, named by its path in the handler, and its message
// is the engine's.
use std::regex

fn main() throws {
    let re = regex::dynamic("(") catch {
        match error {
            regex::Error => {
                println(f"{error}")
                return
            }
        }
    }
    println(f"compiled {re.is_match("(")}")
}
