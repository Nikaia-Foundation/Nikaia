// scripts/commit.nika (#2173): --dry-run writes Reviewed: (and the commit
// Pushed:) before Attribution:, so neither becomes a trailer of the commit
// message; a Reviewed: an older run appended below the trailers is moved up and
// left out of the message too.
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/commit.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/commit.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn git(dir: String, args: Vec[String]) -> String throws {
    let mut all: Vec[String] = ["-c", "user.name=T", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    return process::run("git", all; dir: dir).stdout.trim().clone()
}

fn commit(nikaia: String, repo: String, tmp: String, dry: bool) -> String throws {
    let mut args: Vec[String] = ["run", f"{repo}/scripts/commit.nika", "--"]
    if dry { args.push("--dry-run") }
    args.push(f"{tmp}/X.md.report.md")
    let out = process::run(nikaia, args; dir: tmp.clone(), env: [("GIT_AUTHOR_NAME", "T"), ("GIT_AUTHOR_EMAIL", "t@example.com"), ("GIT_COMMITTER_NAME", "T"), ("GIT_COMMITTER_EMAIL", "t@example.com")])
    return out.stdout.trim().clone()
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    git(tmp.clone(), ["init", "-q", "-b", "develop"])
    fs::write(f"{tmp}/a.txt", fs::Root::Anywhere, "one\n")
    git(tmp.clone(), ["add", "a.txt"])
    git(tmp.clone(), ["commit", "-q", "-m", "base"])
    fs::write(f"{tmp}/a.txt", fs::Root::Anywhere, "ONE\n")
    fs::write(f"{tmp}/X.md.report.md", fs::Root::Anywhere, "Result: done\nFiles: a.txt\nCommit: a subject\nChangelog: none\nAttribution:\nCo-Authored-By: T <t@example.com>\n")
    commit(nikaia.clone(), repo.clone(), tmp.clone(), true)
    let short = commit(nikaia.clone(), repo.clone(), tmp.clone(), false)
    println(short.replace(git(tmp.clone(), ["rev-parse", "--short=8", "HEAD"]), "SHA8"))
    println("-- message")
    println(git(tmp.clone(), ["log", "-1", "--format=%B"]))
    println("-- report")
    let report = fs::read_to_string(f"{tmp}/X.md.report.md", fs::Root::Anywhere)
    for line in report.trim_end().split("\n") {
        if line.starts_with("Reviewed:") { println("Reviewed: DIGEST") } else if line.starts_with("Pushed:") { println("Pushed: local SHA") } else { println(line) }
    }
    println("-- a Reviewed: below the trailers")
    fs::write(f"{tmp}/a.txt", fs::Root::Anywhere, "TWO\n")
    fs::write(f"{tmp}/X.md.report.md", fs::Root::Anywhere, "Result: done\nFiles: a.txt\nCommit: second\nAttribution:\nCo-Authored-By: T <t@example.com>\nReviewed: old\n")
    commit(nikaia.clone(), repo.clone(), tmp.clone(), true)
    commit(nikaia.clone(), repo.clone(), tmp.clone(), false)
    println(git(tmp.clone(), ["log", "-1", "--format=%B"]))
    let again = fs::read_to_string(f"{tmp}/X.md.report.md", fs::Root::Anywhere)
    for line in again.trim_end().split("\n") {
        if line.starts_with("Reviewed:") { println("Reviewed: DIGEST") } else if line.starts_with("Pushed:") { println("Pushed: local SHA") } else { println(line) }
    }
    process::run("rm", ["-rf", tmp])
}
