// #706: the parts of `split_once` of a `String` parameter pushed into a
// `mut Vec[String]` parameter, with an f-string and a literal caller.
fn parts(s: String, mut v: Vec[String]) {
    let (a, b) = s.split_once("=") ?? ("", "")
    v.push(a)
    v.push(b)
}

fn main() {
    let mut v: Vec[String] = []
    parts(f"k={1}", v)
    parts("x=y", v)
    for w in "c d".split(" ") {
        v.push(w)
    }
    println(v.len())
    println(v[1])
}
