// #1572 (ADR-396 D3): at `unproved-claims = "warn"` an index reached by data
// from outside, not proved, builds with NK1302 as a warning, and the index is
// checked when the program runs: a month read as 12 stops it there; and
// `--bounds` lists the index as checked because of the switch (D5).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn shown(tmp: ref fs::Root, text: String) -> String throws {
	let mut lines: Vec[String] = []
	for line in text.replace(tmp.path().to_text(), "TMP").lines() {
		let t = line.trim()
		if t.starts_with("Compiling") || t.starts_with("Finished") || t.starts_with("Running") {
			continue
		}
		lines.push(line.clone())
	}
	return lines.join("\n")
}

fn main() throws {
	let tmp = fs::scratch()
	fs::write(
		"month.nika",
		tmp,
		"use std::io\nuse std::text\n\nfn month_name(month: int) -> String {\n\tlet names = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\n\treturn names[month]\n}\n\nfn main() throws {\n\tlet month = text::parse_i64(io::read_to_string().trim()) ?? 1\n\treturn if !(month >= 0 && month <= 12)\n\tprintln(month_name(month))\n}\n",
	)
	for input in ["5", "12"] {
		let out = process::run(
			"sh",
			["-c", f"echo {input} | \"$0\" run --unproved-claims=warn month.nika", toolchain()]; dir: tmp.path().to_text(),
		)
		println(shown(tmp, f"{out.stdout}{out.stderr}"))
		println(f"exit {out.code}")
	}
	// `--bounds` lists the index as checked because of the switch
	// (ADR-396 D5).
	let report = process::run(
		"sh",
		["-c", "\"$0\" check --bounds --unproved-claims=warn month.nika", toolchain()]; dir: tmp.path().to_text(),
	)
	println(shown(tmp, report.stdout))
}
