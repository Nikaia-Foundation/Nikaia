// An integer literal handed to an option no integer goes in is the `i64` it
// would be, and refused there (#1452), at a function and at a method alike,
// as it is at a parameter: before, `on: 3` reached rustc.
fn f(x: i64; on: bool = false, label: String = "none") -> i64 {
    return if on { x } else { label.bytes.len() as i64 }
}

struct P {
    x: i64,
}

impl P {
    fn g(ref self; on: bool = false) -> i64 {
        return if on { self.x } else { 0 }
    }
}

fn main() throws {
    println(f(1; on: 3))
    println(f(1; label: 3))
    let p = P { x: 1 }
    println(p.g(on: 3))
    println("abcb".find("b"; from: 3) != null)
}
