// Equalities without overflow (ADR-270 D5, D11, #1312 item 1): the exact
// theory eliminates an equality through its coefficient of least magnitude
// with Pugh's symmetric step, an `Extend` with `m = |a| + 1` whose two
// bounds, combined with the equality's sides and one rounded, give a unit
// column; then the columns the steps introduced are reduced pairwise, each
// an `Extend` with `m = 1`. The first problem is the one that overflowed
// i64 before (`replay-early-close-depth-range` of `tests/solver/qflia`: two
// equalities with five-digit coefficients over `[-5, 5]`), refuted; then
// the omega test's example, consistent, its model checked against the
// atoms; then the GCD test alone. Each line counts the log's steps by kind
// and says whether `sv_check` replays it. Then the first log broken twice:
// an extension's divisor one too large, a rounding left out; each rejected.
// The logic layer's files, `tools/sv_*.nika` and the driver below make one
// program, as `scripts/solver.nika` makes it.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "fn row1(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn le(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row1(ks, c), rel: SvRel::Le }
}

// `Σ ks_i·x_i + c = 0` as two atoms, `<=` and `>=`, as the reader gives
// an equality to the exact theory.
fn eq(mut atoms: Vec[SvAtom], ks: Vec[i64], c: i64) {
	let mut neg: Vec[i64] = []
	for k in ks {
		neg.push(-k)
	}
	atoms.push(le(ks, c))
	atoms.push(le(neg, -c))
}

// `lo <= x_i <= hi` as two atoms, `x_i` of `n` columns.
fn boxed(mut atoms: Vec[SvAtom], n: i64, i: i64, lo: i64, hi: i64) {
	let mut down: Vec[i64] = []
	let mut up: Vec[i64] = []
	let mut j = 0
	while j < n {
		down.push(if j == i { -1 } else { 0 })
		up.push(if j == i { 1 } else { 0 })
		j += 1
	}
	atoms.push(le(down, lo))
	atoms.push(le(up, -hi))
}

// The log's steps by kind.
fn kinds(steps: ref Vec[SvStep]) -> String {
	let mut e = 0
	let mut c = 0
	let mut r = 0
	let mut f = 0
	let mut l = 0
	for st in steps {
		match st {
			SvStep::Extend(..) => { e += 1 },
			SvStep::Combine(..) => { c += 1 },
			SvStep::Round(..) => { r += 1 },
			SvStep::Farkas(..) => { f += 1 },
			SvStep::Learn(..) => { l += 1 },
			else => {},
		}
	}
	return f\"{e} extend, {c} combine, {r} round, {f} farkas, {l} learn\"
}

// The log with one step broken: `divisor` the first extension's divisor
// one too large, `round` the first rounding by 1 (none).
fn broken(steps: ref Vec[SvStep], how: String) -> Vec[SvStep] {
	let mut out: Vec[SvStep] = []
	let mut extends = 0
	let mut rounds = 0
	for st in steps {
		let mut next = st.clone()
		match st {
			SvStep::Extend(l, m, q) => {
				extends += 1
				if how == \"divisor\" && extends == 1 {
					next = SvStep::Extend(l.clone(), m + 1, q)
				}
			},
			SvStep::Round(id, d) => {
				rounds += 1
				if how == \"round\" && rounds == 1 {
					next = SvStep::Round(id, 1)
				}
			},
			else => {},
		}
		out.push(next)
	}
	return out
}

// Whether every atom holds under `values` (the columns by name).
fn holds(atoms: ref Vec[SvAtom], names: ref Vec[String], values: ref collections::BTreeMap[String, i64]) -> bool {
	for a in atoms {
		let mut sum = a.row.constant
		let mut i = 0
		while i < a.row.cols.len() {
			let name = names[a.row.cols[i] as i64].clone()
			let v = values.get(name) ?? return false
			sum = sum + a.row.ks[i] * v
			i += 1
		}
		if sum > 0 {
			return false
		}
	}
	return true
}

// Every atom asserted to the exact theory at one level, then a final check;
// a conflict closed by one learned clause and the log replayed, broken as
// `how` says where it is not `\"\"`.
fn run(title: String, names: Vec[String], atoms: Vec[SvAtom], how: String) throws {
	let n = atoms.len()
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	while (a as i64) < n {
		clauses.push([sv_lit(a, false)])
		a += 1
	}
	let query = SvQuery { atoms: atoms.clone(), clauses: clauses, columns: names.len().checked_u32() ?? 0, reals: [] }
	let mut book = sv_book(query) ?? return
	let mut inputs: Vec[u32] = []
	let mut i: u32 = 0
	while (i as i64) < n {
		inputs.push(book.input(i))
		i += 1
	}
	let budget = lg_budget()
	let mut theory = sv_theory(names.clone())
	theory.push_level()
	let mut got = SvChecked::Consistent
	let mut j: u32 = 0
	while (j as i64) < n {
		got = theory.assert(sv_lit(j, false), book)
		match got {
			SvChecked::Consistent => {},
			else => {
				break
			},
		}
		j += 1
	}
	match got {
		SvChecked::Consistent => {
			got = theory.check(true, budget, book)
		},
		else => {},
	}
	let label = if how == \"\" { title.clone() } else { f\"{title}, {how}\" }
	match got {
		SvChecked::Conflict(c) => {
			let mut hints: Vec[u32] = []
			for l in c.lits {
				hints.push(inputs[(l / 2) as i64])
			}
			hints.push(c.id)
			book.learn([], hints)
			let steps = if how == \"\" { book.log.steps.clone() } else { broken(book.log.steps, how) }
			let v = sv_check(query, steps)
			let said = if v.ok { \"checked\" } else { f\"rejected at {v.step}: {v.reason}\" }
			println(f\"  {label}: conflict; {kinds(steps)}; {said}\")
		},
		SvChecked::Consistent => {
			let model = theory.model()
			let mut values: Vec[String] = []
			for name in names {
				let v = model.get(name.clone()) ?? 0
				values.push(f\"{name} = {v}\")
			}
			let ok = if holds(atoms, names, model) { \"the atoms hold\" } else { \"an atom fails\" }
			println(f\"  {label}: consistent, {values.join(\", \")}; {ok}\")
		},
		SvChecked::Unknown(why) => {
			println(f\"  {label}: {sv_unknown(why)}\")
		},
		else => {
			println(f\"  {label}: lemmas\")
		},
	}
}

fn main() throws {
	println(\"70241a + 76389b + 66512c + 11267d + 9158e = 82, 55644a + 74117b - 29262c - 76416d - 75644e = -175, -5 <= a..e <= 5\")
	let names: Vec[String] = [\"a\", \"b\", \"c\", \"d\", \"e\"]
	let mut big: Vec[SvAtom] = []
	eq(big, [70241, 76389, 66512, 11267, 9158], -82)
	eq(big, [55644, 74117, -29262, -76416, -75644], 175)
	let mut v = 0
	while v < 5 {
		boxed(big, 5, v, -5, 5)
		v += 1
	}
	run(\"exact\", names.clone(), big.clone(), \"\")
	println(\"7x + 12y + 31z = 17, 3x + 5y + 14z = 7, 1 <= x <= 40, -50 <= y <= 50\")
	let mut omega: Vec[SvAtom] = []
	eq(omega, [7, 12, 31], -17)
	eq(omega, [3, 5, 14], -7)
	boxed(omega, 3, 0, 1, 40)
	boxed(omega, 3, 1, -50, 50)
	run(\"exact\", [\"x\", \"y\", \"z\"], omega, \"\")
	println(\"4x + 6y = 5\")
	let mut gcd: Vec[SvAtom] = []
	eq(gcd, [4, 6], -5)
	run(\"exact\", [\"x\", \"y\"], gcd, \"\")
	println(\"broken: the first extension's divisor one too large, the first rounding by 1 (none)\")
	run(\"exact\", names.clone(), big.clone(), \"divisor\")
	run(\"exact\", names.clone(), big.clone(), \"round\")
}
"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_walk", "sv_strategy", "sv_smt", "sv_smtlib", "sv_lemma", "sv_nl", "sv_rod"] {
		let dir = if name == "sv_rod" { "solver" } else { "tools" }
		paths.push(f"{repo}/crates/nikaia-std/src/{dir}/{name}.nika")
	}
	let mut uses: Vec[String] = []
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver())
	let args: Vec[String] = ["run", "main.nika"]
	let out = process::run(nikaia, args; dir: tmp.clone())
	println(out.stdout.trim())
	process::run("rm", ["-rf", tmp])
}
