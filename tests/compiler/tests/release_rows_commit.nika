// release.nika `--rows`: a driver under `--no-bump` commits the Runs rows the
// agents added to docs/tokenspeed.md, alone (what else is staged stays
// staged), and leaves the file alone when it changed otherwise.
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn git(tmp: ref fs::Root, args: Vec[String]) -> String throws {
    return process::run("git", args; dir: tmp.path().to_text()).stdout
}

fn rows(nikaia: String, repo: String, tmp: ref fs::Root, label: String) throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/release.nika", "--", "--rows"]; dir: tmp.path().to_text()).stdout.trim().clone()
    println(f"{label}: {out}")
    println(f"  committed: {git(tmp, ["show", "--name-only", "--format=%s", "HEAD"]).trim().replace("\n", " ")}")
    println(f"  still staged: {git(tmp, ["diff", "--cached", "--name-only"]).trim()}")
    println(f"  uncommitted: {git(tmp, ["diff", "--name-only"]).trim()}")
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    let doc = "docs/tokenspeed.md"
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/docs"])
    git(tmp, ["init", "-q"])
    git(tmp, ["config", "user.email", "t@t"])
    git(tmp, ["config", "user.name", "t"])
    fs::write(f"{doc}", tmp, "# T\n\n## Runs\n\n| a | b |\n| 1 | 2 |\n\n## After\n")
    fs::write("other.txt", tmp, "1\n")
    git(tmp, ["add", doc.clone(), "other.txt"])
    git(tmp, ["commit", "-q", "-m", "base"])
    rows(nikaia.clone(), repo.clone(), tmp, "nothing added")
    // A builder's staged file beside the agents' row.
    fs::write("other.txt", tmp, "2\n")
    git(tmp, ["add", "other.txt"])
    fs::write(f"{doc}", tmp, "# T\n\n## Runs\n\n| a | b |\n| 1 | 2 |\n| 3 | 4 |\n\n## After\n")
    rows(nikaia.clone(), repo.clone(), tmp, "a row added")
    fs::write(f"{doc}", tmp, "# T\n\n## Runs\n\n| a | b |\n| 1 | 9 |\n| 3 | 4 |\n\n## After\n")
    rows(nikaia, repo, tmp, "a row changed")
}
