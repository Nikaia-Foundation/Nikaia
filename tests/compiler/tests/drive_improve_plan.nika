// scripts/drive.nika --improve-plan (#1818): where each point of a report goes
// instead of a new improvement issue for every one. A deviation is dropped, a
// `broke I<n>` answer is a comment on the run's issue (filed when the run has
// none), a point the report says it closed or built is dropped, and so is one
// that names a rules file the run's commit changed; a point an open
// improvement issue already has (its title or a `## Reported` line) is a
// comment there; only a new point is filed. A report like issue-1760's, whose
// points were closed with nothing to build, files nothing.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/drive.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/drive.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn drive(repo: String, nikaia: String, args: Vec[String]) throws {
    let mut all: Vec[String] = ["run", "scripts/drive.nika", "--"]
    for a in args { all.push(a.clone()) }
    let out = process::run(nikaia, all; dir: repo)
    if !out.ok { println(f"drive.nika failed, code {out.code}: {out.stderr.trim()}") }
    println(out.stdout.trim())
}

fn report(text: String) -> String throws {
    let file = process::run("mktemp", []).stdout.trim().clone()
    fs::write(file.clone(), fs::Root::Anywhere, text)
    return file
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    let existing = report("#1800\tAfter #1790: pre-push red on the self-hosted badge that is not mine\n\t- Friction: lower-std re-proves std after another agent's bounds file change\n#1801\tAfter #1795: something else entirely here\n")
    let each = report("Result: done\nFiles: scripts/drive.nika docs/issues.md tests/compiler/tests/x.nika\nDeviation: item 2 built as a flag, not a file\nIssue: broke I3: the title named no function; I4b not followed: no expected output; rules-gap: no rule says which binary a probe ran on; rules-gap (built): I9 lacked the GitHub note; wrong I5: the probe passed, closed as noise in Body; rules-gap: issues.md I9 says nothing of a Rust test file\nNeeds: none\nFriction: pre-push turns red on the self-hosted badge that was not mine, every run\nComment: the plan lacks a step, nothing to build\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-plan", "issue-1700", "1700", each.clone(), existing.clone()])
    // Without an issue, a `broke` answer has nowhere to go but the lane.
    drive(repo.clone(), nikaia.clone(), ["--improve-plan", "v50-a", "", each.clone(), existing.clone()])
    let seen = report("Result: done\nIssue: rules-gap: the open form of a point\nFriction: each lower-std re-proves std after a bounds file change by another agent\nNeeds: supervisor decision on the ledger order\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-plan", "issue-1701", "1701", seen.clone(), existing.clone()])
    let settled = report("Result: done\nIssue: rules-gap: the issue named no driver test, closed, only information for #1750, nothing to build\nDeviation: closed, the Rust added falls under the spec-first exception\nNeeds: none\nFriction: none\n")
    drive(repo.clone(), nikaia.clone(), ["--improve-plan", "issue-1760", "1760", settled.clone(), existing.clone()])
    drive(repo, nikaia, ["--improve-issue", "issue-1760", "1760", settled.clone()])
    process::run("rm", ["-f", existing, each, seen, settled])
}
