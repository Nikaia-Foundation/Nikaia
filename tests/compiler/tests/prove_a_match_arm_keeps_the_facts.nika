/// **An arm of a `match` keeps what is known outside it** (#1470): `xs[i]`
/// in an arm is proved by the `if` before the `match`, as it is in a branch
/// of an `if`. A name the arm's pattern binds hides the outer one, so what
/// was known of that does not reach the arm: `xs[i]` under the pattern `i`
/// stays checked.
pub fn in_arm(xs: ref Vec[i64], i: i64, k: i64) -> i64 {
	if i < 0 || i >= xs.len() {
		return 0
	}
	return match k {
		0 => 0,
		else => xs[i],
	}
}

pub fn in_optional_arm(xs: ref Vec[i64], i: i64, step: i64?) -> i64 {
	if i < 0 || i >= xs.len() {
		return 0
	}
	return match step {
		null => 0,
		else => xs[i] + 1,
	}
}

pub fn hidden(xs: ref Vec[i64], i: i64, other: i64) -> i64 {
	if i < 0 || i >= xs.len() {
		return 0
	}
	return match other {
		0 => 0,
		i => xs[i],
	}
}

fn main() throws {
	let xs = [4, 5, 6]
	println(f"{in_arm(xs, 1, 2)} {in_optional_arm(xs, 2, 7)} {hidden(xs, 1, 2)}")
}
