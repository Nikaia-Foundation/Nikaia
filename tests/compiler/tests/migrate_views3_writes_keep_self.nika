// #1213 step 6, ADR-views-v4 D2: `nikaia migrate views-3` writes `keep self`
// where the old by-value `self` is consumed by the body, and leaves a `self`
// that only looks, and a `ref self`, without it.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    fs::write("cart.nika", tmp, "struct Cart {\n    items: Vec[String],\n}\n\nimpl Cart {\n    fn into_items(self) -> Vec[String] {\n        return self.items\n    }\n\n    fn count(ref self) -> i64 {\n        return self.items.len() as i64\n    }\n\n    fn first(self) -> String {\n        return self.items[0].clone()\n    }\n}\n\nfn main() throws {\n    let cart = Cart { items: [\"a\", \"b\"] }\n    println(cart.count())\n    println(cart.first())\n    let items = cart.into_items()\n    println(items.len())\n}\n")
    let out = process::run(nikaia, ["migrate", "views-3", f"{tmp.path().to_text()}/cart.nika"])
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    print(fs::read_to_string("cart.nika", tmp))
    let checked = process::run(nikaia, ["check", f"{tmp.path().to_text()}/cart.nika"])
    println(f"-- check: {checked.code}")
    print(f"{checked.stdout}{checked.stderr}".replace(tmp.path().to_text(), "TMP"))
}
