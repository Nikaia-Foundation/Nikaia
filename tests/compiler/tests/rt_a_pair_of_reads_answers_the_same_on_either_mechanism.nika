// Two reads and a missing file answer the same bytes, in the order asked, on
// either I/O mechanism (ADR-292 D6, ADR-303 D5): what a mechanism costs differs,
// what it answers may not. A runtime config named by `NIKAIA_RUNTIME_CONFIG`
// pins `io-method`; the child reads both files and a missing one, which fails
// in its own read and not in the other's, once under `blocking` and once under
// `auto`. Moved from the `nikaia-std` unit tests
// `a_pair_is_answered_in_order_on_either_mechanism` and
// `the_compilers_pair_answers_the_same_either_way` (#2316).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn main() throws {
	let tmp = fs::scratch()
	fs::write("eins", tmp, "eins")
	fs::write("zwei", tmp, "zwei zwei")
	fs::write(
		"child.nika",
		tmp,
		"use std::fs\n\nfn main() throws {\n\tlet first = fs::read(\"eins\", fs::Root::Anywhere)\n\tlet second = fs::read(\"zwei\", fs::Root::Anywhere)\n\tprintln(f\"first: {first.text()}\")\n\tprintln(f\"second: {second.text()}\")\n\tfs::read(\"nicht-da\", fs::Root::Anywhere) catch {\n\t\tprintln(\"missing: an error\")\n\t\treturn\n\t}\n\tprintln(\"missing: read\")\n}\n",
	)
	for method in ["blocking", "auto"] {
		fs::write("runtime.toml", tmp, f"io-method = \"{method}\"\n")
		let out = process::run(
			toolchain(),
			["run", "child.nika"]; dir: tmp.path().to_text(), env: [("NIKAIA_RUNTIME_CONFIG", f"{tmp.path().to_text()}/runtime.toml")],
		)
		println(f"{method}:")
		print(out.stdout)
	}
}
