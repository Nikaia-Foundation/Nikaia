// The fuzzer of the measuring rod (#1281, ADR-270 D17): `scripts/solver.nika
// fuzz --self-test` generates eight queries from a fixed seed, growing in
// size, and the five mutants of each (#1989: shuffle, rename, scale,
// redundant, negate; those of the first query are printed), answers them
// with the CDCL(T) engine (#1283) and compares with a stubbed oracle (z3 is
// not in CI; it calls every third question `unsat`, so its disagreements are
// the stub's): the same seed gives the same queries, answers and
// disagreements, and a disagreement makes the run exit 1.
//
// `oracle` (#1989 item 1) is run with `$Z3` a stub that answers only when
// given `rlimit=123`: `sat`, `unknown` for `unsat-gcd`, an `(error ...)` for
// `unsat-fixed`, printed with the stub's reason and our engine's answer
// (#2258). Each file stating `unsat` is then a disagreement and the run
// exits 1; a file stating `sat` alone exits 0.
use std::env
use std::fs
use std::process

// The running `nikaia`: the one `nikaia test` started this program with
// (`env::current_exe`, ADR-program-path-1 D3), which is no outside data
// where it runs a program (ADR-397 D1). No path is guessed: without one the
// test stops and says why.
fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		eprintln("no running nikaia: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

// The repository: a test program runs in its package's directory,
// `tests/compiler` (#1398), two below the root; `.` where it is run from the
// root. Literal paths, so nothing from outside names a file
// (ADR-raw-sinks-1 D11).
fn root() -> String throws {
	return if fs::exists("scripts/gate.nika", fs::Root::Dir(".")) { "." } else { "../.." }
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	// The stub z3 is written into a directory `std` made
	// (ADR-raw-sinks-1 D12), inside the test's own, removed with it.
	let stub_dir = fs::scratch()
	let stub = f"{stub_dir.path().display()}/z3"
	fs::write(
		"z3",
		stub_dir,
		"#!/bin/sh\ncase \"$*\" in *rlimit=123*) ;; *) echo '(error \"no rlimit\")'; exit 0;; esac\ncase \"$*\" in *unsat-gcd*) echo unknown;; *unsat-fixed*) echo '(error \"stub\")'; echo unsat;; *) echo sat;; esac\n",
	)
	process::run("chmod", ["+x", stub.clone()])
	let runs: Vec[Vec[String]] = [
		["fuzz", "--self-test"],
		["oracle", "--rlimit", "123", "tests/solver/smoke", "tests/solver/pre"],
		["oracle", "--rlimit", "123", "tests/solver/smoke/sat-interval.smt2"],
	]
	for args in runs {
		let mut all: Vec[String] = [
			f"Z3={stub}",
			nikaia.clone(),
			"run",
			"scripts/solver.nika",
			"--",
		]
		for a in args { all.push(a.clone()) }
		let out = process::run("env", all; dir: repo.clone())
		println(f"$ solver.nika {args.join(" ")}")
		println(out.stdout.trim())
		println(f"exit {out.code}")
		// A failed inner run names its cause in the diff (#1305).
		if out.stderr.trim().len() > 0 {
			println("stderr:")
			println(out.stderr.trim())
		}
	}
}
