// #2205, ADR-010 D5: a map of text keys no untrusted key reaches is a
// `TrustedMap`, hashed by std's fixed-seed hash (`runtime/hash.nika`), and it
// answers its lookups as the keyed map does: the same five names, written
// into the program in one child and read from the command line in the other,
// give the same length, the same value and the same miss.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

/// The map's lines of the Rust `--trust` writes for `name`, and what its run
/// prints with `args`.
fn shown(nikaia: String, tmp: ref fs::Root, name: String, args: Vec[String]) throws {
    let out = process::run(nikaia, ["lower", "--trust", "-o", f"{name}.rs", f"{name}.nika"]; dir: tmp.path().to_text())
    println(f"-- {name}: --trust")
    for line in fs::read_to_string(f"{name}.rs", tmp).lines() {
        if line.contains("let mut names") {
            println(line.trim())
        }
    }
    if !out.ok {
        println(f"{out.stdout}{out.stderr}")
    }
    let mut run_args = ["run", f"{name}.nika", "--"]
    for a in args {
        run_args.push(a.clone())
    }
    let ran = process::run(nikaia, run_args; dir: tmp.path().to_text())
    println(f"-- {name}: run\n{ran.stdout.trim()}{ran.stderr.trim()}")
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    let lookups = "    println(f\"{names.len()}\")
    println(f\"東京: {names[\"東京\"] ?? -1}\")
    match names.get(\"nowhere\") {
        null => println(\"nowhere: none\"),
        i => println(f\"nowhere: {i}\"),
    }
}
"
    let trusted = "use std::collections

fn main() throws {
    let mut names: collections::HashMap[String, i64] = collections::HashMap()
    let keys = [\"Hamburg\", \"Bulawayo\", \"Palembang\", \"St. John's\", \"東京\"]
    for i in 0..<keys.len() {
        names.insert(keys[i], i)
    }
" + lookups
    let keyed = "use std::cli
use std::collections

fn main() throws {
    let mut names: collections::HashMap[String, i64] = collections::HashMap()
    for i in 1..<6 {
        names.insert(cli::args().nth(i) ?? \"\", i - 1)
    }
" + lookups
    fs::write("trusted.nika", tmp, trusted)
    fs::write("keyed.nika", tmp, keyed)
    shown(nikaia, tmp, "trusted", [])
    shown(nikaia, tmp, "keyed", ["Hamburg", "Bulawayo", "Palembang", "St. John's", "東京"])
}
