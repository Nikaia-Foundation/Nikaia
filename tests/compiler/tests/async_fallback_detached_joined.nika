// The fallback of a detached task (Part I 8.1.2, ADR-async-5 D22, #986): the
// task fails, and the fallback stands in for its value where the failure
// arrives, the `join`; a crash would still pass to `main`.

struct Oops {}

impl Error for Oops {
	fn message(self) -> String {
		return "oops"
	}
}

fn work(n: i64) -> i64 throws {
	if n > 5 {
		throw Oops {}
	}
	return n * 2
}

fn main() throws {
	let h = async(detached) fn { work(7) } catch {
		println(f"fallback: {error}")
		100
	}
	let g = async(detached) fn { work(2) } catch { 100 }
	println(f"{h.join()} {g.join()}")
}
