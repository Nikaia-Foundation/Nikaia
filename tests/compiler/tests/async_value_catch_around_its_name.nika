struct Oops {}
impl Error for Oops {
    fn message(self) -> String {
        return "oops"
    }
}
fn work(n: i64) -> i64 throws {
    if n > 5 {
        throw Oops {}
    }
    return n * 2
}
fn other() -> i64 {
    return 1
}
fn main() throws {
    let a = async work(7)
    let b = other()
    let c = (a + b) catch { 0 }
    println(f"{c}")
}
