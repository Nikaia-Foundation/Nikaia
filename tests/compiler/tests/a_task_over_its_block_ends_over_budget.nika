// A list a task keeps to itself is built in the task's block, 16 pages of
// 4 KiB (ADR-327 D12), and one that outgrows it ends the task: whoever waits
// for it gets `task::OverBudget` (ADR-327 D13). Its strategy gives it one
// segment (D15).
// A strategy that gives each task one segment, 64 KiB (ADR-327 D15).
struct Small {}

impl task::Admission for Small {
    fn decide(mut self, load: task::Load) -> task::Decision sync {
        return task::Decision { start: 1, budget: 65536 }
    }
}

fn fill() -> i64 {
    let mut xs: Vec[i64] = []
    for i in 0..<100000 {
        xs.push(i)
    }
    return xs.len()
}

fn main() throws {
    let a = async(admission: Small {}) fill() catch {
        match error {
            task::OverBudget => println(f"over budget: {error}"),
            else => println(f"failed: {error}"),
        }
        0
    }
    let b = 1
    println(f"after: {a + b}")
}
