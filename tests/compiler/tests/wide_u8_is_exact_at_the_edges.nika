// `Wide[u8]`, std's exact value of twice the width of `u8` (Part I 2.2,
// #2619): each method at the edges, the least value, `0`,
// the greatest product and a quotient that does not fit. A value is shown as
// its halves (high, low) and its sign; `none` is a `null`.
fn show(w: Wide[u8]) throws {
	let (low, high) = w.halves()
	println(f"{high} {low} {w.sign()}")
}

fn maybe(w: Wide[u8]?) throws {
	if w == null {
		println("none")
		return
	}
	show(w ?? return)
}

fn shown(n: u8?) -> String {
	return if n == null { "none" } else { f"{n ?? 0}" }
}

fn quotient(pair: (Wide[u8], u8)?) throws {
	if pair == null {
		println("none")
		return
	}
	let (q, r) = pair ?? return
	let (low, high) = q.halves()
	println(f"{high} {low} {q.sign()} rest {r}")
}

fn main() throws {
	let least: u8 = u8::MIN
	let most: u8 = u8::MAX
	let zero: u8 = 0
	let one: u8 = 1
	let ten: u8 = 10
	let full: u8 = u8::MAX
	let nothing: u8 = 0
	let low_of_top: u8 = 1
	let top = Wide::product(most, most)
	show(top)
	println(shown(top.narrow()))
	show(Wide::of(least))
	println(shown(Wide::of(least).narrow()))
	println(Wide::of(zero).sign())
	maybe(top.add(top))
	maybe(Wide::of(least).add(Wide::of(most)))
	maybe(Wide::of(zero).sub(Wide::of(one)))
	show(Wide::from_halves(full, most))
	maybe(Wide::from_halves(full, most).add(Wide::of(one)))
	maybe(Wide::of(zero).neg())
	maybe(Wide::of(one).neg())
	maybe(top.mul(most))
	maybe(Wide::of(most).mul(most))
	quotient(top.div_rem(most))
	quotient(top.div_rem(zero))
	println(shown(top.rem(zero)))
	println(shown(top.rem(ten)))
	println(top == Wide::product(most, most))
	println(Wide::of(zero) < top)
	println(top < Wide::of(one))
	println(top.halves().0 == low_of_top)
}
