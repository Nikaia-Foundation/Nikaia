struct Holder {
    name: String,
}

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

struct Act {
    f: fn(keep a: String) -> i64,
}

fn eat(keep a: String) -> i64 {
    let v: Vec[String] = [a]
    return v[0].len()
}

fn main() throws {
    let h = Holder { name: make() }
    let s = h.name
    let a = Act { f: eat }
    println(a.f(s))
    println(s)
}
