// #1287: a loop over `.lines()` or `.split(..)` of a call's result walks a
// temporary the loop drops at its end. Its views are copied with `.clone()`
// where text of its own is kept (ADR-282 D8); `.to_string()` or the bare
// view there is refused with NK1102 (for_over_lines_of_a_throwing_call_refused),
// never left to rustc.
use std::fs

fn names(tmp: ref fs::Root, name: String) -> Vec[String] throws {
    let mut out: Vec[String] = []
    for line in fs::read_to_string(name, tmp).lines() {
        out.push(line.clone())
    }
    return out
}

fn main() throws {
    let tmp = fs::scratch()
    fs::write("uses.txt", tmp, "use a\nb\nuse a\n")
    let mut uses: Vec[String] = []
    for line in fs::read_to_string("uses.txt", tmp).lines() {
        if line.starts_with("use ") {
            if !uses.contains(line) { uses.push(line.clone()) }
        }
    }
    println(uses.len())
    let mut parts: Vec[String] = []
    for part in fs::read_to_string("uses.txt", tmp).trim().split("\n") {
        parts.push(part.clone())
    }
    println(parts.len())
    let mut counted = 0
    for line in fs::read_to_string("uses.txt", tmp).lines() {
        if line.starts_with("use ") { counted += 1 }
    }
    println(counted)
    let mut named: Vec[String] = []
    for name in names(tmp, "uses.txt").iter() {
        named.push(name.trim().clone())
    }
    println(named.len())
}
