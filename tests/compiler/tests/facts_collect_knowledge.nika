// A `knowledge: <section> | <fact>` answer (the debrief's question (5), or the
// `Issue:` field of the report beside the debrief) is entered as a facts line
// of its section by `facts-collect.nika -- --apply`, as a `Fact:` line is; a
// wrapped line starting `#N]` does not end a section (#2002).
use std::env
use std::fs
use std::process

// The checkout: the working directory, or (under `nikaia test`, which runs a
// test in a directory of its own) the one `nikaia` was started in.
fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/docs/briefs/lane"])
    fs::write("docs/builder-facts.md", tmp, "# Builder facts\n\n## Core\n\n### Every run\n\n* a core fact\n")
    fs::write("docs/builder-facts-lookup.md", tmp, "# Lookup\n\n### Packages\n\nPaths: `nikaia.toml`\n\n* a package trap\n\n### Lowering and lower-std\n\nPaths: `lowered/`\n\nA paragraph wrapped at **[defect\n#N]**: still the same paragraph.\n")
    fs::write("docs/briefs/lane/issue-1.md.debrief.md", tmp, "(5) knowledge: Packages | cargo judges path crates by mtime.\n(6) Fact: none\n")
    fs::write("docs/briefs/lane/issue-1.md.report.md", tmp, "Result: done\nIssue: rules-gap: no rule names it; knowledge: Lowering | a lowered file names its source.\n")
    let out = process::run(nikaia, ["run", f"{repo}/scripts/facts-collect.nika", "--", "--apply"]; dir: tmp.path().to_text())
    println(out.stdout.trim())
    println(fs::read_to_string("docs/builder-facts-lookup.md", tmp))
}
