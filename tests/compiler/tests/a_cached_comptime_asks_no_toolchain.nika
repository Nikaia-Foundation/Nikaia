// #2151: a check whose build-time bundle and `comptime` answer are on disk
// starts no `rustc`: the toolchain's answers are kept under the user cache
// with a stamp of what decides the toolchain, read with a few `stat` calls.
// A wrapper `rustc` first on `PATH` logs each start; the first check may ask,
// the second asks nothing, and after the wrapper changed (`touch`) the third
// asks again. `RUSTC` is unset, so Cargo's own fingerprint is unchanged.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

/// How many times the wrapper ran during one check, and the log emptied.
fn checked(nikaia: String, tmp: ref fs::Root, path: String) -> i64 throws {
	let out = process::run("env", ["-u", "RUSTC", f"PATH={path}", nikaia, "check", "main.nika"]; dir: tmp.path().to_text())
	if out.code != 0 {
		println(f"check failed: {out.stdout}{out.stderr}")
	}
	let log = process::run("sh", ["-c", "cat log 2>/dev/null; rm -f log"]; dir: tmp.path().to_text()).stdout
	return log.lines().count()
}

fn main() throws {
	let tmp = fs::scratch()
	let nikaia = toolchain()
	let real = process::run("sh", ["-c", "command -v rustc"]).stdout.trim().clone()
	let old_path = process::run("sh", ["-c", "printf %s \"$PATH\""]).stdout
	process::run("mkdir", ["-p", f"{tmp.path().to_text()}/bin"])
	fs::write("bin/rustc", tmp, f"#!/bin/sh\necho \"$*\" >> {tmp.path().to_text()}/log\nexec {real} \"$@\"\n")
	process::run("chmod", ["+x", f"{tmp.path().to_text()}/bin/rustc"])
	fs::write("main.nika", tmp, "fn square(n: i64) -> i64 sync {\n\treturn n * n\n}\n\ncomptime SIDE: i64 = square(12)\n\nfn main() throws {\n\tprintln(SIDE)\n}\n")
	let path = f"{tmp.path().to_text()}/bin:{old_path}"
	checked(nikaia.clone(), tmp, path.clone())
	println(f"second check asked rustc: {checked(nikaia.clone(), tmp, path.clone())}")
	process::run("touch", ["-d", "@1", f"{tmp.path().to_text()}/bin/rustc"])
	println(f"after the toolchain changed, asked again: {checked(nikaia, tmp, path) > 0}")
}
