// release.nika (#1896): a specification part with another lane's paragraph in
// the working file gets only its version and date lines staged; the
// paragraph stays in the working file, unstaged.
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn git(tmp: ref fs::Root, args: Vec[String]) -> String throws {
    return process::run("git", args; dir: tmp.path().to_text()).stdout
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    let part = "docs/specification/30-nikaia-tooling.md"
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/docs/specification"])
    git(tmp, ["init", "-q"])
    git(tmp, ["config", "user.email", "t@t"])
    git(tmp, ["config", "user.name", "t"])
    fs::write(f"{part}", tmp, "# Tooling\n\n**Version:** 0.0.1 (Draft)\n**Date:** 2026-11-01\n\n## D14\n\nOld text.\n")
    git(tmp, ["add", part.clone()])
    git(tmp, ["commit", "-q", "-m", "base"])
    // The other lane's paragraph and the release's bump, both in the working file.
    fs::write(f"{part}", tmp, "# Tooling\n\n**Version:** 0.0.2 (Draft)\n**Date:** 2026-11-16\n\n## D14\n\nOld text.\n\n## D15\n\nUnfinished paragraph.\n")
    let out = process::run(nikaia, ["run", f"{repo}/scripts/release.nika", "--", "--stage-version", part.clone()]; dir: tmp.path().to_text())
    println(f"staged: {out.stdout.trim()}")
    println("index:")
    print(git(tmp, ["show", f":{part}"]))
    println("unstaged:")
    for line in git(tmp, ["diff", "--unified=0", part.clone()]).split("\n") {
        if line.starts_with("+") && !line.starts_with("+++") { println(line) }
    }
    println("working file:")
    print(fs::read_to_string(f"{part}", tmp))
}
