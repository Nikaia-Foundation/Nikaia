// Ownership matrix (#1404): a view value, given, in the position `for`.
// Generated by scripts/ownership_matrix.nika: change the generator, not this file.

struct Holder {
    name: String,
}

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

fn store(keep a: String, mut into: Vec[String]) {
    into.push(a)
}

fn main() throws {
    let h = Holder { name: make() }
    let s = h.name
    let xs: Vec[String] = [s]
    let mut all: Vec[String] = []
    for x in xs {
        store(x, all)
    }
    println(all.len())
    println(s)
}
