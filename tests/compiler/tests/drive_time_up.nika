// scripts/drive.nika --time-up: the time limit after which the driver starts
// no new agent (NIKAIA_DRIVE_LIMIT_MIN, default 105 minutes, counted from
// NIKAIA_DRIVE_STARTED where a restart set it); `--time-up DIR` (#1885): an
// agent of DIR starts only where the minutes left until the task's end
// (NIKAIA_DRIVE_TASK_MIN, default 120) cover a builder of DIR
// (BRIEF.posted to BRIEF.run.json, else its duration_ms, the line
// `--run-record DIR BRIEF` appends to DIR/runs.txt after each run, #2459), the
// median of the last nine lines, 60 with none.
use std::env
use std::fs
use std::process
use std::text

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, name: String, ago: i64, limit: String) throws {
    let now = text::parse_i64(process::run("date", ["+%s"]).stdout.trim()) ?? 0
    let started = f"{now - ago}"
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--time-up"]; dir: repo, env: [("NIKAIA_DRIVE_STARTED", started), ("NIKAIA_DRIVE_LIMIT_MIN", limit)])
    println(f"{name}: {out.stdout.trim()}")
}

fn lane(nikaia: String, repo: String, dir: String, name: String, ago: i64, task: String) throws {
    let now = text::parse_i64(process::run("date", ["+%s"]).stdout.trim()) ?? 0
    let started = f"{now - ago}"
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--time-up", dir.clone()]; dir: repo, env: [("NIKAIA_DRIVE_STARTED", started), ("NIKAIA_DRIVE_TASK_MIN", task)])
    println(f"{name}: {out.stdout.trim().replace(dir, "DIR")}")
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    case(nikaia.clone(), repo.clone(), "a minute in", 60, "")
    case(nikaia.clone(), repo.clone(), "an hour and 50 in", 6600, "")
    case(nikaia.clone(), repo.clone(), "limit 0", 60, "0")
    case(nikaia.clone(), repo.clone(), "limit 120, an hour and 50 in", 6600, "120")
    // A lane without runs: a run is taken as 60 minutes.
    let empty = fs::scratch()
    lane(nikaia.clone(), repo.clone(), empty.path().to_text(), "no runs, 50 min in", 3030, "")
    lane(nikaia.clone(), repo.clone(), empty.path().to_text(), "no runs, 65 min in", 3930, "")
    // Runs of 40 minutes (posted to run.json), of 10 and of 100 (duration_ms
    // only, no posted marker): the median counts, not the longest (#2022: a
    // lane with one long run stopped after 22 minutes of merges).
    let runs = fs::scratch()
    let now = text::parse_i64(process::run("date", ["+%s"]).stdout.trim()) ?? 0
    process::run("sh", ["-c", f"cd {runs.path().to_text()} && echo '\"duration_ms\":45000,' > a.md.run.json && touch a.md.posted && touch -d @{now - 3000} a.md.posted && touch -d @{now - 600} a.md.run.json && echo '\"duration_ms\":600000,' > b.md.run.json && echo '\"duration_ms\":6000000,' > c.md.run.json"])
    for b in ["a", "b", "c", "missing"] {
        process::run(nikaia.clone(), ["run", "scripts/drive.nika", "--", "--run-record", runs.path().to_text(), f"{runs.path().to_text()}/{b}.md"]; dir: repo.clone())
    }
    let today = process::run("date", ["+%F"]).stdout.trim().clone()
    print(fs::read_to_string("runs.txt", runs).replace(today, "DATE"))
    // The run files are not read: only runs.txt counts.
    process::run("sh", ["-c", f"rm -f {runs.path().to_text()}/*.run.json"])
    lane(nikaia.clone(), repo.clone(), runs.path().to_text(), "runs of 40, 22 min in", 1350, "")
    lane(nikaia.clone(), repo.clone(), runs.path().to_text(), "runs of 40, 75 min in", 4530, "")
    lane(nikaia.clone(), repo.clone(), runs.path().to_text(), "runs of 40, 85 min in", 5130, "")
    lane(nikaia.clone(), repo.clone(), runs.path().to_text(), "runs of 40, 85 min in, task 180", 5130, "180")
    lane(nikaia, repo, runs.path().to_text(), "runs of 40, 110 min in", 6630, "")
    process::run("rm", ["-rf", empty.path().to_text(), runs.path().to_text()])
}
