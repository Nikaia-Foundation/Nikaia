// scripts/drive.nika --time-up (the cases without a lane's runs; the runs' cases are
// in drive_time_up_runs, each program under the 300 s a test may take on a slow runner): the time limit after which the driver starts
// no new agent (NIKAIA_DRIVE_LIMIT_MIN, default 105 minutes, counted from
// NIKAIA_DRIVE_STARTED where a restart set it); `--time-up DIR` (#1885): an
// agent of DIR starts only where the minutes left until the task's end
// (NIKAIA_DRIVE_TASK_MIN, default 120) cover a builder of DIR
// (BRIEF.posted to BRIEF.run.json, else its duration_ms, the line
// `--run-record DIR BRIEF` appends to DIR/runs.txt after each run, #2459), the
// median of the last nine lines, 60 with none.
use std::env
use std::fs
use std::process
use std::text

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, name: String, ago: i64, limit: String) throws {
    let now = text::parse_i64(process::run("date", ["+%s"]).stdout.trim()) ?? 0
    let started = f"{now - ago}"
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--time-up"]; dir: repo, env: [("NIKAIA_DRIVE_STARTED", started), ("NIKAIA_DRIVE_LIMIT_MIN", limit), ("NIKAIA_DRIVE_TASK_MIN", "120")])
    println(f"{name}: {out.stdout.trim()}")
}

fn lane(nikaia: String, repo: String, dir: String, name: String, ago: i64, task: String) throws {
    let now = text::parse_i64(process::run("date", ["+%s"]).stdout.trim()) ?? 0
    let started = f"{now - ago}"
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--time-up", dir.clone()]; dir: repo, env: [("NIKAIA_DRIVE_STARTED", started), ("NIKAIA_DRIVE_TASK_MIN", task), ("NIKAIA_DRIVE_LIMIT_MIN", "105")])
    println(f"{name}: {out.stdout.trim().replace(dir, "DIR")}")
}

// A lane of this test's own under the checkout's target/drive-test/ (#2577):
// drive opens every name under fs::Root::Dir("."), the checkout it runs in, so
// it gets the lane's names relative to it. The scratch directory's name keeps
// the two runs of `--both-settings` apart.
fn test_lane(repo: String, name: String) -> String throws {
    let id = fs::scratch().path().file_name()?.to_text() ?? "run"
    let lane = f"target/drive-test/{name}/{id}"
    fs::create_dir(lane, fs::Root::Dir(repo); recursive: true)
    return lane
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    case(nikaia.clone(), repo.clone(), "a minute in", 60, "")
    case(nikaia.clone(), repo.clone(), "an hour and 50 in", 6600, "")
    case(nikaia.clone(), repo.clone(), "limit 0", 60, "0")
    case(nikaia.clone(), repo.clone(), "limit 120, an hour and 50 in", 6600, "120")
    // A lane without runs: a run is taken as 60 minutes.
    let empty = test_lane(repo.clone(), "drive_time_up/empty")
    lane(nikaia.clone(), repo.clone(), empty.clone(), "no runs, 50 min in", 3030, "")
    lane(nikaia.clone(), repo.clone(), empty.clone(), "no runs, 65 min in", 3930, "")
    fs::remove(empty, fs::Root::Dir(repo); recursive: true)
}
