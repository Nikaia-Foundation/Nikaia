// scripts/probe.nika (#1866): a `target/fast/nikaia` older than a compiler
// source in the tree may predate HEAD, so the probe names it in a first
// `note:` line before the output; a binary newer than every source gets none.
// In a temp tree with a stub binary that prints what it was asked.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn root() -> String throws {
	return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, tmp: ref fs::Root, name: String, setup: String) throws {
	process::run("sh", ["-c", setup]; dir: tmp.path().to_text())
	let out = process::run(
		nikaia,
		["run", f"{repo}/scripts/probe.nika", "--", "println(1)"]; dir: tmp.path().to_text(),
	)
	println(f"== {name}")
	println(out.stdout.trim())
}

fn main() throws {
	let tmp = fs::scratch()
	let repo = root()
	let nikaia = toolchain()
	process::run(
		"sh",
		[
			"-c",
			"mkdir -p target/fast crates/c/src; printf '#!/bin/sh\\necho stub $1\\n' > target/fast/nikaia; chmod +x target/fast/nikaia; echo a > crates/c/src/a.nika",
		]; dir: tmp.path().to_text(),
	)
	case(
		nikaia.clone(),
		repo.clone(),
		tmp,
		"binary newer than the sources",
		"touch -d '1 hour ago' crates/c/src/a.nika",
	)
	case(
		nikaia,
		repo,
		tmp,
		"a source newer than the binary",
		"touch -d '2 hours ago' target/fast/nikaia",
	)
}
