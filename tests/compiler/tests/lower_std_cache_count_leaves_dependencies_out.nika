// `lower-std` says how many of the package's own files came from the cache:
// a dependency it lowers first (#1163) has a cache of its own, and its files
// are not among the package's, so they are not counted (#1909: a full hit
// on the toolchain said "297 of 296", the `json` file counted too).
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

// Lowers the sysroot in `tmp` and prints how many files came from the cache.
fn lower(nikaia: String, tmp: String, what: String) throws {
    let out = process::run(nikaia, ["lower-std", "--sysroot", f"{tmp}/crates"]; dir: tmp.clone(), env: [("NIKAIA_CACHE_DIR", f"{tmp}/cache"), ("NIKAIA_LOWER_CACHE_SALT", "count")])
    for line in out.stderr.lines() {
        if line.contains(" files from the cache") {
            let parts: Vec[String] = line.split(": ").collect()
            println(f"{what}: {parts.last() ?? ""}")
            return
        }
    }
    println(f"{what}: exit {out.code}")
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    let dir = f"{tmp}/crates/nikaia-std/src/compiler"
    process::run("mkdir", ["-p", dir.clone(), f"{tmp}/dep/src"])
    fs::write(f"{tmp}/dep/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"dep\"\nversion = \"0.1.0\"\n\n[build]\nartifact = \"rust-library\"\n")
    fs::write(f"{tmp}/dep/src/main.nika", fs::Root::Anywhere, "pub fn dep_one() -> i64 sync {\n    return 1\n}\n")
    fs::write(f"{dir}/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"compiler\"\nwithin = \"std\"\n\n[dependencies]\ndep = { path = \"../../../../dep\" }\n")
    fs::write(f"{dir}/a.nika", fs::Root::Anywhere, "use dep\n\npub fn a_one() -> i64 sync {\n    return dep::dep_one()\n}\n")
    lower(nikaia, tmp, "cold")
    fs::write(f"{dir}/a.nika", fs::Root::Anywhere, "use dep\n\npub fn a_one() -> i64 sync {\n    let x = dep::dep_one()\n    return x\n}\n")
    lower(nikaia, tmp, "body edit")
    process::run("rm", ["-rf", tmp])
}
