// `lower-std` says how many of the package's own files came from the cache:
// a dependency it lowers first (#1163) has a cache of its own, and its files
// are not among the package's, so they are not counted (#1909: a full hit
// on the toolchain said "297 of 296", the `json` file counted too).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

// Lowers the sysroot in `tmp` and prints how many files came from the cache.
fn lower(nikaia: String, tmp: ref fs::Root, what: String) throws {
    let out = process::run(nikaia, ["lower-std", "--sysroot", f"{tmp.path().to_text()}/crates"]; dir: tmp.path().to_text(), env: [("NIKAIA_CACHE_DIR", f"{tmp.path().to_text()}/cache"), ("NIKAIA_LOWER_CACHE_SALT", "count")])
    for line in out.stderr.lines() {
        if line.contains(" files from the cache") {
            let parts: Vec[String] = line.split(": ").collect()
            println(f"{what}: {parts.last() ?? ""}")
            return
        }
    }
    println(f"{what}: exit {out.code}")
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    let dir = tmp.join("crates/nikaia-std/src/compiler")
    process::run("mkdir", ["-p", dir.path().to_text(), f"{tmp.path().to_text()}/dep/src"])
    fs::write("dep/nikaia.toml", tmp, "[package]\nname = \"dep\"\nversion = \"0.1.0\"\n\n[build]\nartifact = \"rust-library\"\n")
    fs::write("dep/src/main.nika", tmp, "pub fn dep_one() -> i64 sync {\n    return 1\n}\n")
    fs::write("nikaia.toml", dir, "[package]\nname = \"compiler\"\nwithin = \"std\"\n\n[dependencies]\ndep = { path = \"../../../../dep\" }\n")
    fs::write("a.nika", dir, "use dep\n\npub fn a_one() -> i64 sync {\n    return dep::dep_one()\n}\n")
    lower(nikaia, tmp, "cold")
    fs::write("a.nika", dir, "use dep\n\npub fn a_one() -> i64 sync {\n    let x = dep::dep_one()\n    return x\n}\n")
    lower(nikaia, tmp, "body edit")
}
