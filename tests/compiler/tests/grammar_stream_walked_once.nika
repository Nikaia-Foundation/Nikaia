// An entry marked `@stream` is a sequence of its items, walked once
// (ADR-grammar-typed-read-v2 D7, #1440): a `for` lends each item from the
// input (#2708), so one kept past the loop is a copy, and a `break` stops the
// walk. The same call held in a name is that sequence, and walking it a
// second time is NK2702, the only refusal here.

struct Item {
	word: String,
}

grammar Words {
	@stream entry rule items -> Item = item*
	rule item -> Item = w:until(";") ";" -> { Item { word: w.clone() } }
}

grammar Listed {
	@stream entry rule items -> Item = "[" => list(item, ",") "]"
	rule item -> Item = w:until("," | "]") -> { Item { word: w.clone() } }
}

fn main() throws {
	let mut kept: Vec[Item] = []
	for it in Words::items("a;b;stop;c;") {
		if it.word == "stop" {
			break
		}
		kept.push(it.clone())
	}
	for it in Listed::items("[x,y]") {
		kept.push(it.clone())
	}
	for k in kept {
		println(k.word)
	}
	let all = Words::items("a;b;")
	for it in all {
		println(it.word)
	}
	for it in all {
		println(it.word)
	}
}
