// #1604, Part III 13.5, ADR-270 D4, D22: `packages/yaml/nikaia.proofs` went
// stale on `develop` after the prover's questions changed, and so had the
// contracts of `packages/json` and `tests/page-examples` (`places`,
// `panics`), and nothing noticed: CI runs `build --locked` only on
// `tests/compiler`. Their ledgers are committed like a lockfile too, so each
// is built `--locked` here, in a copy with no `target/` and its own cache,
// where no warm entry can hide a question the book does not hold. A change
// that asks new questions or infers new contracts fails this test until it
// commits the new entries. Only the ledger verdict is printed. `json` has no
// `main`, and a program build of it is refused with NK1351 before its ledger
// is read (#1622, Part III 13.3), so it is checked `--locked` with `rustc`
// instead, which compares its ledgers the same way.
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/packages/yaml/nikaia.toml", fs::Root::Anywhere) { return here }
	let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
	if fs::exists(f"{parent}/packages/yaml/nikaia.toml", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// Builds (or checks, with `verb`) the copy of `{repo}/{dir}` at `{tmp}/{dir}`
// with `--locked`.
fn locked(nikaia: String, repo: String, tmp: String, dir: String, verb: Vec[String]) throws {
	process::run("sh", ["-c", f"mkdir -p {tmp}/{dir} && tar -C {repo}/{dir} --exclude=./target -cf - . | tar -xf - -C {tmp}/{dir}"])
	let out = process::run(nikaia, verb; dir: f"{tmp}/{dir}", env: [("RUST_BACKTRACE", "0"), ("NIKAIA_CACHE_DIR", f"{tmp}/cache")])
	println(f"{dir}: ledger current: {!out.stderr.contains("--locked:")}")
}

fn main() throws {
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let nikaia = toolchain()
	let repo = root()
	locked(nikaia, repo, tmp, "packages/json", ["check", "--rustc", "--locked", "src/main.nika"])
	locked(nikaia, repo, tmp, "packages/yaml", ["build", "--locked"])
	locked(nikaia, repo, tmp, "tests/page-examples", ["build", "--locked"])
	process::run("rm", ["-rf", tmp])
}
