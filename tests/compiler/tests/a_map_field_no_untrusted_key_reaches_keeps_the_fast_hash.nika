// #1607, ADR-010 D9: a map held in a field of a struct the file declares is a
// position of its own. Where no untrusted key reaches the field, it keeps the
// fast hash under an untrusted `cli::args`, as a `let` of that class does; a
// field the command line's words reach stays keyed. `--trust` names
// `cli::args` as the source and not each method of the `Args` it returns.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    let source = "use std::cli
use std::collections

struct Tally {
    counts: collections::HashMap[String, i64],
}

struct Seen {
    words: collections::HashSet[String],
}

fn main() throws {
    let name = cli::args().nth(1) ?? \"x\"
    let mut t = Tally { counts: collections::HashMap() }
    t.counts.insert(\"a\", 1)
    t.counts[\"b\"] = 2
    let mut s = Seen { words: collections::HashSet() }
    s.words.insert(name)
    println(f\"{t.counts.len()} {s.words.len()}\")
}
"
    fs::write("p.nika", tmp, source)
    let out = process::run(nikaia, ["lower", "--trust", "-o", "p.rs", "p.nika"]; dir: tmp.path().to_text())
    println("-- --trust")
    for line in f"{out.stdout}{out.stderr}".lines() {
        if line.starts_with("input provenance") || line.starts_with("    ") && line.contains(" is ") {
            println(line)
        }
    }
    println("-- the fields")
    for line in fs::read_to_string("p.rs", tmp).lines() {
        if line.contains("counts:") || line.contains("words:") {
            println(line.trim())
        }
    }
    let ran = process::run(nikaia, ["run", "p.nika", "--", "w"]; dir: tmp.path().to_text())
    println(f"-- run\n{ran.stdout.trim()}")
}
