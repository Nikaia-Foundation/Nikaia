// A `join(within:)` on a `task::ChildHandle` whose task ends in time gives its
// value (Part I 8.2, ADR-async-5 D17), for a task that pauses and for one
// that never does, with or without `on_timeout:`.

use std::time

fn slow() -> i64 {
	time::sleep(5.millis())
	return 7
}

fn work() -> i64 {
	return 3
}

fn main() throws {
	let h = async(handle) fn { slow() }
	let w = async(handle) fn { work() }
	let v = h.join(within: 2.seconds())
	let u = w.join(within: 2.seconds(), on_timeout: task::OnTimeout::Cancel)
	println(f"{v} {u}")
}
