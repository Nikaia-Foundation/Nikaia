// `find`, `rfind`, `replace` and `replacen` take one scalar as their needle,
// as `contains` and `split` do (#877).
fn main() {
    let s = "a,b;c,ä;d"
    let first = s.find(',') ?? return
    let last = s.rfind(',') ?? return
    println(f"{first} {last}")
    let later = s.find(';'; from: first + 1) ?? return
    println(f"{later}")
    let umlaut = s.find('ä') ?? return
    println(f"{umlaut}")
    println(f"{s.find('x') == null} {s.rfind('x') == null}")
    println(s.replace(';', "-"))
    println(s.replacen(',', "+", 1))
    let needle = ","
    println(f"{s.find(needle) ?? -1} {needle}")
}
