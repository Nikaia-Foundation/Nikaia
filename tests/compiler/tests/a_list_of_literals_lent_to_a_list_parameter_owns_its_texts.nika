// #803: a list of text literals handed to a `ref Vec[String]` parameter is text of its own (ADR-282 D4), as a typed `let` of it is.
struct Score {
    kinds: Vec[String],
}
fn kind_of(t: String) -> String {
    if t.starts_with("x") { return "ex" }
    return "other"
}
fn stats(hits: ref Vec[String]) -> String {
    return f"{hits.len()}"
}
fn score(lines: ref Vec[String]) -> Score {
    let mut kinds: Vec[String] = []
    for t in lines {
        kinds.push(kind_of(t))
    }
    return Score { kinds: kinds }
}
fn main() {
    let s = score(["xa", "b"])
    let kinds: Vec[String] = s.kinds.clone()
    print(stats(kinds))
}
