// `process::exit(code)` ends the program with that code, after what it
// printed (#2215; it was a Rust test of `process.rs`).
use std::env
use std::fs
use std::process

// The `nikaia` that runs this test, found among its ancestors.
fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    fs::write("ends.nika", tmp, "use std::process\n\nfn main() throws {\n    println(\"before\")\n    process::exit(3)\n    println(\"after\")\n}\n")
    let out = process::run(toolchain(), ["run", "ends.nika"]; dir: tmp.path().to_text())
    println(f"exit {out.code}")
    print(out.stdout)
}
