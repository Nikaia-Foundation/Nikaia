// #847 step 2: scripts/agent.nika builds the claude command from a brief's
// frontmatter and escalates a failed run, checked with a fake `claude`.
use std::env
use std::fs
use std::process

// The checkout: the working directory, or (under `nikaia test`, which runs a
// test in a directory of its own) the one `nikaia` was started in.
fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let fake = tmp.join("claude")
    let json = "{\"is_error\":false,\"num_turns\":3,\"session_id\":\"SID\",\"total_cost_usd\":1.5,\"terminal_reason\":\"completed\",\"result\":\"held up by builds\",\"usage\":{\"input_tokens\":10,\"cache_creation_input_tokens\":20,\"cache_read_input_tokens\":30,\"output_tokens\":40}" + "}"
    let script = f"#!/bin/sh\nsid=\"\"\nwhile [ $# -gt 0 ]; do if [ \"$1\" = --session-id ]; then sid=$2; fi; shift; done\necho '{json}' | sed \"s/SID/$sid/\"\ntouch {tmp.path().to_text()}/b.report.md\n"
    fs::write("claude", tmp, script.clone())
    process::run("chmod", ["+x", fake.path().to_text()]; dir: repo.clone())
    fs::write("b.md", tmp, "---\nagent: qa\nmodel: opus\nmax_turns: 7\n---\nbody\n")
    fs::write("plain.md", tmp, "no frontmatter\n")

    let dry = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dry-run"]; dir: repo.clone())
    let (_, qa_flags) = dry.stdout.trim().split_once(" --agent ") ?? ("", "")
    let qa_line = "--agent " + qa_flags
    let words = qa_line.split(" ").collect()
    println(f"qa: {words[0]} {words[1]} {words[2]} {words[3]} {words[4]} {words[5]} {words[6]} {words[7]}")
    println(f"tools: {words.len() > 13} {words[words.len() - 1]}")
    let plain = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/plain.md", "--dry-run"]; dir: repo.clone())
    let (_, plain_flags) = plain.stdout.trim().split_once(" --agent ") ?? ("", "")
    let plain_line = "--agent " + plain_flags
    let pw = plain_line.split(" ").collect()
    println(f"plain: {pw[0]} {pw[1]} {pw[2]} {pw[3]} {pw[4]} {pw[5]} {pw[6]} {pw[7]}")

    let ran = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--claude", fake.path().to_text()]; dir: repo.clone())
    let line = ran.stdout.trim().split(" ").collect()
    println(f"run: ok={ran.ok} {line[0]} cost {line[5]} turns {line[7]}")
    println(fs::read_to_string("tokens.txt", tmp).trim().split(" ").collect()[1])
    println(f"debrief: {fs::read_to_string("b.debrief.md", tmp).trim()} {fs::read_to_string("cost.txt", tmp).trim().split("\n").count()}")
    fs::remove("b.report.md", tmp)
    let silent = tmp.join("silent")
    fs::write("silent", tmp, script.replace("touch", "true"))
    process::run("chmod", ["+x", silent.path().to_text()])
    let again = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--claude", silent.path().to_text()]; dir: repo.clone())
    println(f"no report: code={again.code} {again.stdout.trim().split(' ').collect()[1]} {again.stdout.trim().split(' ').collect()[2]} escalate={fs::exists("ESCALATE", tmp)}")
    let refused = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--claude", fake.path().to_text()]; dir: repo.clone())
    println(f"refused: code={refused.code}")
    let today = process::run("date", ["+%F"]).stdout.trim().clone()
    process::run("mkdir", [f"{tmp.path().to_text()}/cap"])
    fs::write("cap/cost.txt", tmp, f"{today} 500.6\n{today} 499.6\n")
    let capped = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dir", f"{tmp.path().to_text()}/cap", "--claude", fake.path().to_text()]; dir: repo.clone())
    println(f"cap: code={capped.code} {capped.stdout.trim().split(' ').collect()[0]} escalate={fs::exists("cap/ESCALATE", tmp)}")
    process::run("mkdir", [f"{tmp.path().to_text()}/small"])
    fs::write("small/cost.txt", tmp, f"{today} 0.9\n{today} 0.95\n{today} 12.5\n")
    let small = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dir", f"{tmp.path().to_text()}/small", "--claude", fake.path().to_text()]; dir: repo.clone())
    println(f"small: code={small.code} escalate={fs::exists("small/ESCALATE", tmp)}")

    // An interrupted run (record, transcript, no report) resumes its session
    // once; a resume that fails at once starts fresh.
    fs::remove("b.report.md", tmp)
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/res"])
    let conf = tmp.join("conf")
    let mangled = process::run("sh", ["-c", "pwd | sed 's/[^a-zA-Z0-9]/-/g'"]; dir: repo.clone()).stdout.trim().clone()
    process::run("mkdir", ["-p", f"{conf.path().to_text()}/projects/{mangled}"])
    fs::write(f"projects/{mangled}/old-sid.jsonl", conf, "")
    let sum = process::run("cksum", [f"{tmp.path().to_text()}/b.md"]).stdout.trim().split(" ").collect()[0].clone()
    fs::write("b.md.session", tmp, f"old-sid {sum}\n")
    let rdry = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dry-run"]; dir: repo.clone(), env: [("CLAUDE_CONFIG_DIR", conf.path().to_text())])
    println(f"resume dry: {rdry.stdout.contains("--resume old-sid")} {rdry.stdout.contains("--session-id")} {rdry.stdout.contains("--model opus --max-turns 7")} {rdry.stdout.contains("was interrupted")}")
    let resumer = tmp.join("resumer")
    fs::write("resumer", tmp, script.replace("--session-id", "--resume"))
    process::run("chmod", ["+x", resumer.path().to_text()])
    let res = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dir", f"{tmp.path().to_text()}/res", "--claude", resumer.path().to_text()]; dir: repo.clone(), env: [("CLAUDE_CONFIG_DIR", conf.path().to_text())])
    println(f"resumed: code={res.code} {res.stdout.trim().split(' ').collect()[0]} record={fs::exists("b.md.session", tmp)} {fs::read_to_string("b.md.run.json", tmp).contains("old-sid")}")
    fs::remove("b.report.md", tmp)
    fs::write("b.md.session", tmp, f"old-sid {sum} resumed\n")
    let once = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dry-run"]; dir: repo.clone(), env: [("CLAUDE_CONFIG_DIR", conf.path().to_text())])
    println(f"resumed once: {once.stdout.contains("--resume")}")
    fs::write("b.md.session", tmp, f"old-sid 1{sum}\n")
    let edited = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dry-run"]; dir: repo.clone(), env: [("CLAUDE_CONFIG_DIR", conf.path().to_text())])
    println(f"brief changed: {edited.stdout.contains("--resume")}")
    fs::write("b.md.session", tmp, f"old-sid {sum}\n")
    let failing = tmp.join("failing")
    fs::write("failing", tmp, "#!/bin/sh\nfor a in \"$@\"; do if [ \"$a\" = --resume ]; then exit 1; fi; done\nexec " + fake.path().to_text() + " \"$@\"\n")
    process::run("chmod", ["+x", failing.path().to_text()])
    let fresh = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dir", f"{tmp.path().to_text()}/res", "--claude", failing.path().to_text()]; dir: repo.clone(), env: [("CLAUDE_CONFIG_DIR", conf.path().to_text())])
    let flines = fresh.stdout.trim().split("\n").collect()
    println(f"fallback: code={fresh.code} {flines[0].contains("starting fresh")} {flines[flines.len() - 1].split(' ').collect()[0]} {fs::read_to_string("b.md.run.json", tmp).contains("old-sid")}")

    // A session whose claude still runs (a killed driver's) is neither resumed
    // nor started again beside it (#1796).
    fs::remove("b.report.md", tmp)
    process::run("sh", ["-c", "(sleep 60; : live-sid-1796) > /dev/null 2>&1 &"])
    fs::write("b.md.session", tmp, f"live-sid-1796 {sum}\n")
    let busy = process::run(nikaia.clone(), ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/b.md", "--dir", f"{tmp.path().to_text()}/res", "--claude", fake.path().to_text()]; dir: repo.clone(), env: [("CLAUDE_CONFIG_DIR", conf.path().to_text())])
    println(f"live session: code={busy.code} {busy.stdout.contains("is still running")} report={fs::exists("b.report.md", tmp)}")
    process::run("pkill", ["-f", "live-sid-1796"])
}
