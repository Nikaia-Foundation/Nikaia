// ADR-views-v4 D4, D11, #1254: `nikaia migrate views-3` drops `ref` from a
// slice parameter and a slice result. The migrated file runs: the parameter
// is lent an `Array[T, N]` and a `Vec`, the result `xs[1..]` is a view, so
// is one chosen between two parameters (D8), and a call's slice result is
// handed on to a slice parameter.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    fs::write("a.nika", tmp, "fn total(xs: ref Array[i64]) -> i64 {\n    let mut s = 0\n    for x in xs {\n        s = s + x\n    }\n    return s\n}\n\nfn rest(xs: ref Array[i64]) -> ref Array[i64] {\n    return xs[1..]\n}\n\nfn longer(a: ref Array[i64], b: ref Array[i64]) -> ref Array[i64] {\n    if a.len() > b.len() {\n        return a\n    }\n    return b\n}\n\nfn main() throws {\n    let a: Array[i64, 3] = [1, 2, 3]\n    let v: Vec[i64] = [4, 5, 6]\n    println(total(a))\n    println(total(v))\n    println(rest(a).len())\n    for x in rest(v) {\n        println(x)\n    }\n    println(longer(a, v[1..]).len())\n    println(total(rest(v)))\n}\n")
    let out = process::run(nikaia, ["migrate", "views-3", f"{tmp.path().to_text()}/a.nika"])
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    print(fs::read_to_string("a.nika", tmp))
    let ran = process::run(nikaia, ["run", f"{tmp.path().to_text()}/a.nika"])
    print(f"run:\n{ran.stdout}{ran.stderr}".replace(tmp.path().to_text(), "TMP"))
}
