// `[features]` is a rust-library's (ADR-393 D5, #1393): a program has no
// user who chooses its parts, so the table is `NK1346`.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

/// Builds a package with `[features]` `table`, and says how it ended.
fn built(nikaia: String, build: String, table: String, source: String) throws {
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src"])
    fs::write("nikaia.toml", tmp, f"[package]\nname = \"demo\"\nversion = \"0.1.0\"\n\n[build]\n{build}\n[features]\n{table}")
    fs::write(f"src/{source}", tmp, "pub fn make(v: i64) -> i64 sync {\n    return helper(v)\n}\n\nfn helper(v: i64) -> i64 sync {\n    return v + 1\n}\n\nfn main() {\n    println(f\"{make(1)}\")\n}\n")
    let out = process::run(nikaia, ["build"]; dir: tmp.path().to_text(), env: [("RUST_BACKTRACE", "0")])
    println(f"exit {out.code}")
    println(out.stderr.trim().replace(tmp.path().to_text(), "TMP"))
}

fn main() throws {
    let nikaia = toolchain()
    built(nikaia, "", "tree = [\"demo::make\"]\n", "main.nika")
}
