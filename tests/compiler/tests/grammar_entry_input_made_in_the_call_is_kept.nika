// A grammar entry's input made in the call is kept beside the call (Part II
// 10.6, ADR-283 D24, #2496): the result views it, so a `Bytes(…)` or an
// `f"…"` handed straight to the entry lives as long as the result does. The
// lowered call borrowed a temporary before, and rustc refused it (NK1343,
// *temporary value dropped while borrowed*).
struct Pair { key: String, val: String, }
grammar Pairs {
    rule WS = "" -> { }
    entry rule p -> Pair = k:until(":") ":" v:until(eof) eof -> { Pair { key: k, val: v } }
}
fn main() throws {
    let given = "a:1"
    let p = Pairs::p(Bytes(given.bytes().collect())) catch { return }
    println(f"{p.key}={p.val}")
    let n = 2
    let q = Pairs::p(f"b:{n}") catch { return }
    println(f"{q.key}={q.val}")
}
