// #797 (ADR-381 D3): `is_sorted(v)` at the top of `c`, `b` and `a` is each
// one's precondition, carried back to the caller: at `warn` the list is
// checked once, at `a`'s call in `main`, and a list that is not sorted stops
// the program there; at `error` that call is refused, naming the property.
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
		],
	).stdout.trim().clone()
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn shown(tmp: String, text: String) -> String {
	let mut lines: Vec[String] = []
	for line in text.replace(tmp, "TMP").lines() {
		let t = line.trim()
		if t.starts_with("Compiling") || t.starts_with("Finished") || t.starts_with("Running") {
			continue
		}
		lines.push(line.clone())
	}
	return lines.join("\n")
}

fn ran(tmp: String, file: String, text: String, args: Vec[String]) throws {
	fs::write(f"{tmp}/{file}", fs::Root::Anywhere, text)
	println(f"== {args.join(" ")}")
	let out = process::run(toolchain(), args; dir: tmp)
	println(shown(tmp, f"{out.stdout}{out.stderr}"))
	println(f"exit {out.code}")
}

fn main() throws {
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	ran(tmp, "chain.nika", "fn is_sorted(v: Vec[i64]) -> bool sync {\n\tlet mut i = 1\n\twhile i < v.len() {\n\t\tif v[i - 1] > v[i] { return false }\n\t\ti = i + 1\n\t}\n\ttrue\n}\n\nfn c(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn v.len()\n}\n\nfn b(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn c(v)\n}\n\nfn a(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn b(v)\n}\n\nfn main() throws {\n\tlet v = [1, 2, 3]\n\tprintln(a(v))\n\tlet w = [3, 1]\n\tprintln(a(w))\n}\n", ["check", "--asserts", "--unproved-claims=warn", "chain.nika"])
	ran(tmp, "chain.nika", "fn is_sorted(v: Vec[i64]) -> bool sync {\n\tlet mut i = 1\n\twhile i < v.len() {\n\t\tif v[i - 1] > v[i] { return false }\n\t\ti = i + 1\n\t}\n\ttrue\n}\n\nfn c(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn v.len()\n}\n\nfn b(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn c(v)\n}\n\nfn a(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn b(v)\n}\n\nfn main() throws {\n\tlet v = [1, 2, 3]\n\tprintln(a(v))\n\tlet w = [3, 1]\n\tprintln(a(w))\n}\n", ["run", "--unproved-claims=warn", "chain.nika"])
	ran(tmp, "chain.nika", "fn is_sorted(v: Vec[i64]) -> bool sync {\n\tlet mut i = 1\n\twhile i < v.len() {\n\t\tif v[i - 1] > v[i] { return false }\n\t\ti = i + 1\n\t}\n\ttrue\n}\n\nfn c(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn v.len()\n}\n\nfn b(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn c(v)\n}\n\nfn a(v: Vec[i64]) -> i64 {\n\tassert(is_sorted(v))\n\treturn b(v)\n}\n\nfn main() throws {\n\tlet v = [1, 2, 3]\n\tprintln(a(v))\n\tlet w = [3, 1]\n\tprintln(a(w))\n}\n", ["check", "chain.nika"])
	process::run("rm", ["-rf", tmp])
}
