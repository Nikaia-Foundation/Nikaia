// #1621: a path dependency's ledger is believed only while its sources hash
// as recorded and its record names the inference and format version this
// compiler writes (ADR-100 D3). Its contract is edited to `throws = []`: with
// its own record it is believed (the caller checks), with another inference
// or another format version it is derived again (NK2605).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn checked(tmp: ref fs::Root, label: String) throws {
    let out = process::run(toolchain(), ["check", "src/main.nika"]; dir: f"{tmp.path().to_text()}/app")
    let mut first = String()
    for line in f"{out.stdout}{out.stderr}".lines() {
        if first.len() == 0 && !line.trim().starts_with("Compiling") {
            first.push_str(line.trim())
        }
    }
    println(f"{label}: {first} (exit {out.code})")
}

fn main() throws {
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/lib/src", f"{tmp.path().to_text()}/app/src"])
    fs::write("lib/nikaia.toml", tmp, "[package]\nname = \"lib\"\nversion = \"0.1.0\"\n\n[build]\nartifact = \"rust-library\"\n")
    fs::write("lib/src/main.nika", tmp, "pub fn hello() throws {\n\tprintln(\"hi\")\n}\n")
    fs::write("app/nikaia.toml", tmp, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nlib = { path = \"../lib\" }\n")
    fs::write("app/src/main.nika", tmp, "use lib\n\nfn main() {\n\tlib::hello()\n}\n")
    let built = process::run(toolchain(), ["build"]; dir: f"{tmp.path().to_text()}/lib")
    println(f"lib built: exit {built.code}")
    process::run("sed", ["-i", "s/^throws = .*/throws = []/", f"{tmp.path().to_text()}/lib/nikaia.contracts"])
    process::run("cp", [f"{tmp.path().to_text()}/lib/nikaia.derived", f"{tmp.path().to_text()}/own.derived"])
    process::run("cp", [f"{tmp.path().to_text()}/lib/nikaia.contracts", f"{tmp.path().to_text()}/own.contracts"])
    checked(tmp, "own record")
    process::run("sed", ["-i", "s/^inference = .*/inference = \"stage0-signatures\"/", f"{tmp.path().to_text()}/lib/nikaia.derived"])
    checked(tmp, "another inference")
    process::run("cp", [f"{tmp.path().to_text()}/own.derived", f"{tmp.path().to_text()}/lib/nikaia.derived"])
    process::run("sed", ["-i", "s/^version = .*/version = 3/", f"{tmp.path().to_text()}/lib/nikaia.contracts"])
    checked(tmp, "another format version")
}
