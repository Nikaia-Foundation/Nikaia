// scripts/drive.nika --changed OLDFILE: RESTART when the file differs from the script.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, name: String, old: String) throws {
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--changed", old]; dir: repo)
    println(f"== {name}")
    println(out.stdout.trim())
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    fs::write("old", tmp, "an older script\n")
    process::run("cp", [f"{repo}/scripts/drive.nika", f"{tmp.path().to_text()}/same"])
    case(nikaia.clone(), repo.clone(), "changed", f"{tmp.path().to_text()}/old")
    case(nikaia.clone(), repo.clone(), "same", f"{tmp.path().to_text()}/same")
}
