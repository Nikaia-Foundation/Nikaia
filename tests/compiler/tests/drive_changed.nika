// scripts/drive.nika --changed: RESTART when the old script on standard input
// differs from the script (#2577).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, name: String, old: String) throws {
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--changed"]; dir: repo, stdin: process::Input::Text(old))
    println(f"== {name}")
    println(out.stdout.trim())
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    let same = fs::read_to_string("scripts/drive.nika", fs::Root::Dir(repo.clone()))
    case(nikaia.clone(), repo.clone(), "changed", "an older script\n")
    case(nikaia.clone(), repo.clone(), "same", same)
}
