// ADR-369 D4 (#1943): another file of the package that writes a field of
// the same name through an item of a list (`next[0].values`), a `clone()`
// (`let mut p = path.clone()`), a `for` binding's field (`end.path`) or a
// field of a parameter (`x.path.values`), each of another type, does not
// take the rule away: the scan names each write with the type it can tell,
// so `Sx::mark`'s read is proved. `spoil` writes `values` on an item of a
// list of `Sz`, so `Sz::mark`'s stays checked.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp}/src"])
    fs::write(f"{tmp}/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"paths\"\nversion = \"0.1.0\"\n\n[build]\nartifact = \"rust-library\"\n")
    let lib = "pub struct Sx {\n    keys: Vec[i64],\n    values: Vec[i64],\n}\n\nimpl Sx {\n    pub fn add(mut self, key: i64) -> i64 sync {\n        let at = self.keys.len()\n        self.keys.push(key)\n        self.values.push(0)\n        return at\n    }\n\n    pub fn mark(mut self, key: i64) sync {\n        let at = self.add(key)\n        self.values[at] = 1\n    }\n}\n\npub struct Sz {\n    keys: Vec[i64],\n    values: Vec[i64],\n}\n\nimpl Sz {\n    pub fn add(mut self, key: i64) -> i64 sync {\n        let at = self.keys.len()\n        self.keys.push(key)\n        self.values.push(0)\n        return at\n    }\n\n    pub fn mark(mut self, key: i64) sync {\n        let at = self.add(key)\n        self.values[at] = 1\n    }\n}\n"
    fs::write(f"{tmp}/src/lib.nika", fs::Root::Anywhere, lib)
    let other = "pub struct P {\n    pub values: collections::BTreeMap[String, i64],\n}\n\npub struct E {\n    pub path: P,\n}\n\npub fn by_item(mut next: Vec[P]) {\n    next[0].values.insert(\"a\", 1)\n}\n\npub fn by_clone(path: ref P) -> P {\n    let mut p = path.clone()\n    p.values.insert(\"b\", 2)\n    return p\n}\n\npub fn by_binding(ends: ref Vec[E]) {\n    for end in ends {\n        let mut p = end.path.clone()\n        p.values.insert(\"c\", 3)\n    }\n}\n\npub fn by_field(mut x: E) {\n    x.path.values.insert(\"d\", 4)\n}\n\npub fn spoil(mut zs: Vec[Sz]) {\n    zs[0].values.push(1)\n}\n"
    fs::write(f"{tmp}/src/other.nika", fs::Root::Anywhere, other)
    let out = process::run(nikaia, ["check", "--bounds", "src/lib.nika"]; dir: tmp.clone())
    for line in f"{out.stdout}{out.stderr}".lines() {
        if line.contains("self.values[") || line.contains("error") {
            println(line.trim())
        }
    }
    process::run("rm", ["-rf", tmp])
}
