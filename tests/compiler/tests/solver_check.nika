// The proof log and its checker (ADR-270 D5, #1282 item 4): a valid proof of
// each step kind accepted (input, learn, delete, Farkas over a denominator and
// on an equality, combine, extension, rounding with the GCD test, split), and
// broken ones rejected with their reasons: a negative multiplier, a missing
// hint, a split leaving out an alternative, a rounding by zero, and more.
// `tools/sv_num.nika`, `sv_row.nika`, `sv_proof.nika`, `sv_check.nika` and
// the `LgLin` struct are run beside a driver.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The item of `text` that starts with the line `start`, up to its closing
// brace.
fn item(text: String, start: String) -> String {
	let at = text.find(f"\n{start}") ?? return ""
	let rest = text[at..]
	let end = rest.find("\n}\n") ?? return ""
	return f"{rest[0..<end]}\n}}\n"
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "// `Σ ks[i]·x_i + c` over the first columns.
fn row(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn le(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row(ks, c), rel: SvRel::Le }
}

fn eq(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row(ks, c), rel: SvRel::Eq }
}

fn lt(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row(ks, c), rel: SvRel::Lt }
}

fn pos(a: u32) -> u32 {
	return sv_lit(a, false)
}

fn neg(a: u32) -> u32 {
	return sv_lit(a, true)
}

// Every atom of `atoms` a unit clause.
fn units(atoms: Vec[SvAtom], columns: u32) -> SvQuery {
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	for _ in atoms {
		clauses.push([pos(a)])
		a += 1
	}
	return SvQuery { atoms: atoms, clauses: clauses, columns: columns, reals: [] }
}

fn report(name: String, query: ref SvQuery, log: ref SvLog) {
	let v = sv_check(query, log.steps)
	if v.ok {
		println(f\"{name}: accepted ({log.steps.len()} steps)\")
	} else {
		println(f\"{name}: rejected at step {v.step}: {v.reason}\")
	}
}

// p and q both ways: four clauses, refuted by two learned ones.
fn clauses() -> SvQuery {
	let clauses: Vec[Vec[u32]] = [
		[pos(0), pos(1)],
		[pos(0), neg(1)],
		[neg(0), pos(1)],
		[neg(0), neg(1)],
	]
	return SvQuery { atoms: [le([1], 0), le([0, 1], 0)], clauses: clauses, columns: 2, reals: [] }
}

fn clause_log(drop_hint: bool) -> SvLog {
	let query = clauses()
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let c0 = log.input(0)
	let c1 = log.input(1)
	let c2 = log.input(2)
	let c3 = log.input(3)
	let p = log.learn([pos(0)], [c0, c1])
	log.delete(c0)
	let hints: Vec[u32] = if drop_hint { [p, c2] } else { [p, c2, c3] }
	log.learn([], hints)
	return log
}

// x <= 2 and x >= 3.
fn bounds() -> SvQuery {
	return units([le([1], -2), le([-1], 3)], 1)
}

fn farkas_log(m: i64, den: i64, lits: Vec[u32]) -> SvLog {
	let mut log = sv_log(bounds()) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let f = log.farkas(lits, [SvSrc::Lit(pos(0)), SvSrc::Lit(pos(1))], [m, m], den)
	log.learn([], [a, b, f])
	return log
}

// 2x < 3 and 2x >= 3, multipliers 1/2 each over the denominator 2.
fn strict() -> SvQuery {
	return units([lt([2], -3), le([-2], 3)], 1)
}

// x - y = 0 and x - y >= 1, the equality with -1 written as y - x = 0.
fn equal() -> SvQuery {
	return units([eq([-1, 1], 0), le([-1, 1], 1)], 2)
}

fn lemma_log(query: ref SvQuery, m: Vec[i64], den: i64) -> SvLog {
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let f = log.farkas([neg(0), neg(1)], [SvSrc::Lit(pos(0)), SvSrc::Lit(pos(1))], m, den)
	log.learn([], [a, b, f])
	return log
}

// x = 2y and x = 5: odd and even.
fn parity() -> SvQuery {
	return units([eq([1, -2], 0), eq([1], -5)], 2)
}

// The parity refuted by a combination and the GCD test, after an extension
// `q = ⌊x / 2⌋` pins `q` to 2 on the way.
fn parity_log(divisor: i64, m: i64, q: u32) -> SvLog {
	let mut log = sv_log(parity()) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let ext = log.extend(row([1], 0), m)
	if q != 2 {
		log.steps.pop()
		log.steps.push(SvStep::Extend(row([1], 0), m, q))
	}
	// 2q - x <= 0 and x = 5: 2q - 5 <= 0, rounded: q - 2 <= 0.
	let upper = log.combine([SvSrc::Fact(ext), SvSrc::Lit(pos(1))], [1, 1])
	log.round(upper, 2)
	// x - 2q - 1 <= 0 and x = 5: -2q + 4 <= 0.
	log.combine([SvSrc::Fact(ext + 1), SvSrc::Lit(pos(1))], [1, -1])
	// x - 2y = 0 minus x - 5 = 0: -2y + 5 = 0, not even.
	let odd = log.combine([SvSrc::Lit(pos(0)), SvSrc::Lit(pos(1))], [1, -1])
	let none = log.round(odd, divisor)
	let f = log.farkas([neg(0), neg(1)], [SvSrc::Fact(none)], [1], 1)
	log.learn([], [a, b, f])
	return log
}

// x <= 2 and x >= 1: no contradiction.
fn fits() -> SvQuery {
	return units([le([1], -2), le([-1], 1)], 1)
}

// 2x <= 1 and 2x >= 1: x = 1/2 over the rationals, no integer.
fn half() -> SvQuery {
	return units([le([2], -1), le([-2], 1)], 1)
}

// Split on x <= 0 or x >= 1 (`ge_constant` 1); each side refuted.
fn split_log(ge_constant: i64) -> SvLog {
	let mut log = sv_log(half()) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let s = log.split(row([1], 0), row([-1], ge_constant))
	let low = log.farkas([neg(1), neg(2)], [SvSrc::Lit(pos(1)), SvSrc::Lit(pos(2))], [1, 2], 1)
	let high = log.farkas([neg(0), neg(3)], [SvSrc::Lit(pos(0)), SvSrc::Lit(pos(3))], [1, 2], 1)
	log.learn([], [a, b, low, high, s])
	return log
}

fn single(query: ref SvQuery, steps: Vec[SvStep]) -> SvLog {
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	log.steps = steps
	return log
}

fn main() {
	println(\"== accepted\")
	report(\"clauses (input, learn, delete)\", clauses(), clause_log(false))
	report(\"farkas\", bounds(), farkas_log(1, 1, [neg(0), neg(1)]))
	report(\"farkas, strict, over a denominator\", strict(), lemma_log(strict(), [1, 1], 2))
	report(\"farkas, equality with a negative multiplier\", equal(), lemma_log(equal(), [-1, 1], 1))
	report(\"extension, combine, round and the GCD test\", parity(), parity_log(2, 2, 2))
	report(\"split\", half(), split_log(1))

	println(\"== rejected\")
	report(\"negative multiplier on an inequality\", bounds(), farkas_log(-1, 1, [neg(0), neg(1)]))
	report(\"missing hint\", clauses(), clause_log(true))
	report(\"split leaving out an alternative\", half(), split_log(2))
	report(\"split with overlapping sides\", half(), split_log(0))
	report(\"rounding by zero\", parity(), parity_log(0, 2, 2))
	report(\"rounding by an indivisible divisor\", parity(), parity_log(3, 2, 2))
	report(\"extension by zero\", parity(), parity_log(2, 0, 2))
	report(\"extension on a column in use\", parity(), parity_log(2, 2, 1))
	report(\"farkas over a denominator of zero\", bounds(), farkas_log(1, 0, [neg(0), neg(1)]))
	report(\"farkas leaving a literal out of its clause\", bounds(), farkas_log(1, 1, [neg(0)]))
	report(\"farkas without a contradiction\", fits(), lemma_log(fits(), [1, 1], 1))
	report(\"farkas leaving a variable\", equal(), lemma_log(equal(), [1, 1], 1))
	report(
		\"farkas on a negated equality\",
		equal(),
		single(equal(), [SvStep::Farkas([], [SvSrc::Lit(neg(0))], [1], 1)]),
	)
	report(\"input the query does not hold\", bounds(), single(bounds(), [SvStep::Input(2)]))
	report(
		\"learn without hints\",
		bounds(),
		single(bounds(), [SvStep::Input(0), SvStep::Learn([], [])]),
	)
	report(
		\"hint that is a bound\",
		parity(),
		single(parity(), [SvStep::Combine([SvSrc::Lit(pos(0))], [1]), SvStep::Learn([], [0])]),
	)
	report(
		\"deleting twice\",
		bounds(),
		single(bounds(), [SvStep::Input(0), SvStep::Delete(0), SvStep::Delete(0)]),
	)
	let big: i64 = 4611686018427387904
	report(
		\"a combination leaving i64\",
		bounds(),
		single(bounds(), [SvStep::Combine([SvSrc::Lit(pos(0)), SvSrc::Lit(pos(0))], [big, big])]),
	)
	report(
		\"a log without the empty clause\",
		bounds(),
		single(bounds(), [SvStep::Input(0), SvStep::Input(1)]),
	)
}
"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut program = "use std::collections\n"
	for file in ["crates/nikaia-std/src/tools/sv_num.nika", "crates/nikaia-std/src/tools/sv_row.nika", "crates/nikaia-std/src/tools/sv_proof.nika", "crates/nikaia-std/src/tools/sv_check.nika"] {
		program.push_str(fs::read_to_string(f"{repo}/{file}", fs::Root::Anywhere))
		program.push_str("\n")
	}
	program.push_str(item(
		fs::read_to_string(
			f"{repo}/crates/nikaia-std/src/tools/logic_lia.nika",
			fs::Root::Anywhere,
		),
		"pub struct LgLin {",
	))
	program.push_str(driver())
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, program)
	let out = process::run(nikaia, ["run", "main.nika"]; dir: tmp)
	println(out.stdout.trim())
	process::run("rm", ["-rf", tmp])
}
