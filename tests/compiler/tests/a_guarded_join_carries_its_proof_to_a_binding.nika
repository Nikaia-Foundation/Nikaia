// A name from outside that passed `path::is_component` and is joined after a
// clean part is admitted at a path or program sink (ADR-raw-sinks-1 D14),
// and a binding made from that text carries the proof to the sink: `kept`,
// `kept.clone()`, `f"{kept}/y"`, a binding of `kept` and `"/r/" + k` pass
// under `fs::Root::Anywhere` and as the program of `process::run` (#2370).
// The join with no clean part before the name (`f"{k}/x"`, `k + "/x"`,
// relative to where the program runs), bound or written at the sink, and
// the join of an unguarded name stay `NK1308`, here warnings under
// `raw-sinks = "warn"`, the default, and are checked where they run as
// under `Dir(".")` (D7): the unguarded `loose` leaves `.` and throws
// `io::IoError::Outside`. The program runs in a branch not taken.
use std::cli
use std::fs
use std::io
use std::path
use std::process

fn main() throws {
    let raw = cli::args().nth(1) ?? "abc"
    let loose = f"/nikaia-none/{raw}/x"
    let there = fs::exists(loose, fs::Root::Anywhere) catch {
        match error {
            io::IoError::Outside(_) => println("Outside"),
            else => println("another error"),
        }
        false
    }
    println(there)
    let k = raw.clone()
    return if !path::is_component(k)
    let kept = f"/nikaia-none/{k}/x"
    println(fs::exists(kept.clone(), fs::Root::Anywhere))
    println(fs::exists(f"{kept}/y", fs::Root::Anywhere))
    let again = kept.clone()
    println(fs::exists(again, fs::Root::Anywhere))
    let added = "/nikaia-none/" + k
    println(fs::exists(added, fs::Root::Anywhere))
    let here = f"{k}/x"
    println(fs::exists(here, fs::Root::Anywhere))
    println(fs::exists(f"{k}/x", fs::Root::Anywhere))
    println(fs::exists(k + "/x", fs::Root::Anywhere))
    if cli::args().nth(5) != null {
        process::run(kept, [])
    }
}
