// **A function field called with an owned `String` hands back owned text**
// (ADR-views-3 D2, D14, #1356): `h.f(g)` with `g: String` and
// `f: fn(s: String) -> String` was a rustc E0308 ("consider borrowing").
struct Holder {
    f: fn(s: String) -> String,
}

fn make() -> String {
    "  made "
}

fn main() throws {
    let h = Holder { f: fn(s) { s.trim().clone() } }
    let g = make()
    println(h.f(g))
    println(h.f(make()))
    let mut all: Vec[String] = Vec()
    all.push(" a ")
    for t in all {
        println(h.f(t))
    }
}
