// #797 (ADR-381 D2): `assert(is_sorted(r))` before `made` returns `r` is
// its postcondition, known of `let c = made(3)`; a struct's rule
// `assert(is_sorted(items))` holds of `b.items` wherever a `Bag` is seen.
// `--asserts` says where each proved claim is known from.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn shown(tmp: ref fs::Root, text: String) -> String throws {
	let mut lines: Vec[String] = []
	for line in text.replace(tmp.path().to_text(), "TMP").lines() {
		let t = line.trim()
		if t.starts_with("Compiling") || t.starts_with("Finished") || t.starts_with("Running") {
			continue
		}
		lines.push(line.clone())
	}
	return lines.join("\n")
}

fn ran(tmp: ref fs::Root, file: String, text: String, args: Vec[String]) throws {
	fs::write(f"{file}", tmp, text)
	println(f"== {args.join(" ")}")
	let out = process::run(toolchain(), args; dir: tmp.path().to_text())
	println(shown(tmp, f"{out.stdout}{out.stderr}"))
	println(f"exit {out.code}")
}

fn main() throws {
	let tmp = fs::scratch()
	ran(tmp, "post.nika", "fn is_sorted(v: Vec[i64]) -> bool sync {\n\tlet mut i = 1\n\twhile i < v.len() {\n\t\tif v[i - 1] > v[i] { return false }\n\t\ti = i + 1\n\t}\n\ttrue\n}\n\nfn made(n: i64) -> Vec[i64] {\n\tlet mut r: Vec[i64] = []\n\tfor i in 0..<n {\n\t\tr.push(i)\n\t}\n\tassert(is_sorted(r))\n\treturn r\n}\n\nstruct Bag {\n\titems: Vec[i64],\n\tassert(is_sorted(items)),\n}\n\nfn top(b: Bag) -> i64 {\n\tassert(is_sorted(b.items))\n\treturn b.items.len()\n}\n\nfn main() throws {\n\tlet c = made(3)\n\tassert(is_sorted(c))\n\tlet bag = Bag { items: c }\n\tprintln(top(bag))\n}\n", ["check", "--asserts", "--unproved-claims=warn", "post.nika"])
}
