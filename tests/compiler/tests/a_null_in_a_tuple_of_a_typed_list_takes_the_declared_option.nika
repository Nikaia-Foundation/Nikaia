// #957: a `null` part of a tuple in a list literal takes the option the
// declared element holds there, wherever in the list it stands.
fn main() {
    let c: Vec[(String, String?)] = [("a", "y"), ("b", null)]
    println(f"{c.len()}")
    let d: Vec[(String?, i64)] = [(null, 1), ("y", 2)]
    let e: Vec[(i64, String?)] = [(1, "x"), (2, null), (3, "z")]
    for each in c {
        let shown = each.1?.clone() ?? "none"
        println(f"{each.0} {shown}")
    }
    for each in d {
        let shown = each.0?.clone() ?? "none"
        println(f"{shown} {each.1}")
    }
    for each in e {
        let shown = each.1?.clone() ?? "none"
        println(f"{each.0} {shown}")
    }
}
