// A value whose views point into two buffers carries a handle on each, and
// neither buffer is copied (ADR-tether-v1 D14, D15). The run of the Rust test of
// the same name, whose check of the lowered Rust stays there (#2849).
use std::fs

struct Pair {
    key: String,
    value: String,
}

fn files() -> fs::Root throws {
    let root = fs::scratch()
    fs::write("app.conf", root, "# settings\nhost = example.org\nport = 8080\ninclude = extra.conf\n")
    fs::write("extra.conf", root, "mode = fast\nhost = override.org\n")
    return root
}

fn main() throws {
    let root = files()
    let mut pairs: Vec[Pair] = Vec()
    let mut round = 0
    while round < 100 {
        let a = fs::read_to_string("app.conf", root)
        let b = fs::read_to_string("extra.conf", root)
        pairs.push(Pair { key: a.trim(), value: b.trim() })
        if pairs.len() > 2 { pairs.remove(0) }
        round = round + 1
    }
    println(f"{pairs.len()} {pairs[0].key.len()} {pairs[1].value.len()}")
}
