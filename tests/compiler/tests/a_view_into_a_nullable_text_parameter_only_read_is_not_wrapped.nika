// A view into a text parameter that is only read is not wrapped in `either(..)`.
fn size(x: String?) -> i64 {
    return (x ?? "").len()
}

fn main() {
    let owned: String = "abc"
    let s = owned[..<(owned.find("c") ?? return)]
    let none: String? = null
    println(f"{size(s) + size(owned) + size(none)}")
}
