// scripts/drive.nika --issue NAME...: the issue a brief is posted on, the
// first part of four digits of its name after the prefix (#1252).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    let names = ["docs/briefs/views/d1-1252-briefs-off-the-tree.md", "b44-1206-fn-type.md", "x/p1198-words-table.md", "r4-grammar-red.md", "c2-12345-five-then-1100.md"]
    let mut argv: Vec[String] = ["run", "scripts/drive.nika", "--", "--issue"]
    for n in names { argv.push(n.clone()) }
    let out = process::run(nikaia, argv; dir: repo)
    println(out.stdout.trim())
}
