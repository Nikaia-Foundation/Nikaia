// #843: a view fills a declared `String`; a lent one is copied with `.clone()`, since `.to_string()` on text is refused (ADR-text-reuse-1 D1).
fn first(ws: ref Vec[String]) -> String {
    for w in ws {
        return w.clone()
    }
    return ""
}

fn copied(ws: ref Vec[String]) -> i64 {
    let mut v: Vec[String] = []
    for w in ws {
        v.push(w.clone())
    }
    return v.len()
}

fn main() throws {
    let abc = "abc"
    let d = "d"
    let words: Vec[String] = [abc, d]
    println(words.len())
    println(words[1])
    let lit: Vec[String] = ["p", "q"]
    println(first(lit))
    println(copied(lit))
    let xyz = "xyz"
    let name = xyz
    println(name)
}
