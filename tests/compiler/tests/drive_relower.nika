// scripts/drive.nika --merge-fetched LOWER BUILD BADGES (#1430, #1333): the
// merge of a rejected push, in a temp repository with a bare remote. A
// conflict only in the generated lowered files is resolved by re-lowering
// (here a stub that writes them from the `.nika` source) and committed, the
// autostashed local change back after it; a conflict also in a `.nika`, or a
// lowering that fails, aborts and escalates with no merge left open. A clean
// merge that brought a change under `crates/` is re-lowered and its badges
// regenerated (a stub that lists the sources) in the merge commit, before it
// could be pushed; one of documentation only is merged as it is. A clean
// merge that brought a change under `examples/` has its ledgers refreshed
// (#1591; here a stub `scripts/ledgers.nika` that writes one) and committed
// in the merge too. A conflict only in the lowered index `lowered.rs` beside
// the lowered directory (both sides moved its digest line) is re-lowered too
// (#1784), and named once.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/drive.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/drive.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn sh(dir: String, script: String) -> String throws {
    let out = process::run("sh", ["-c", f"set -e; {script}"]; dir: dir)
    if !out.ok { println(f"setup failed: {script}\n{out.stderr}") }
    return out.stdout.trim().clone()
}

// A repository `work` and a clone `other`, both from the bare `origin`;
// `other` pushes, `work` commits, keeps an uncommitted change and fetches.
// KIND "lowered": both sides change the lowered file, theirs a new source;
// "both": both also change the same source; "clean": theirs a new source,
// ours another file; "docs": theirs only a note in `docs/`; "index": both
// change only the lowered index `lowered.rs`, theirs a new source.
fn setup(tmp: String, name: String, kind: String) -> String throws {
    let base = f"{tmp}/{name}"
    let low = "crates/nikaia-std/src/compiler/lowered"
    let id = "git config user.email t@t; git config user.name t; git config commit.gpgsign false"
    sh(tmp.clone(), f"mkdir -p {name}; cd {name}; git init -q --bare origin.git; git init -q -b develop work")
    let work = f"{base}/work"
    sh(work.clone(), f"{id}; mkdir -p {low} crates/src; echo base > {low}/a.rs; echo index > {low}.rs; echo base > crates/src/a.nika; echo notes > notes.txt; mkdir -p assets/badges; echo old > assets/badges/self-hosted.svg; git add -A; git commit -q -m base; git remote add origin ../origin.git; git push -q origin develop")
    sh(base.clone(), "git clone -q -b develop origin.git other")
    let other = f"{base}/other"
    let lowered = kind == "lowered" || kind == "both"
    let mut theirs = if kind == "both" { "echo theirs > crates/src/a.nika; " } else { "echo theirs-side > crates/src/b.nika; " }
    if kind == "docs" { theirs = "mkdir -p docs; echo theirs > docs/x.md; " }
    if kind == "example" { theirs = "mkdir -p examples/a/src; echo theirs > examples/a/src/main.nika; " }
    if lowered { theirs = f"echo theirs > {low}/a.rs; {theirs}" }
    if kind == "index" { theirs = f"echo theirs > {low}.rs; {theirs}" }
    sh(other, f"{id}; {theirs}git add -A; git commit -q -m theirs; git push -q origin develop")
    let mut ours = if kind == "both" { "echo ours > crates/src/a.nika; " } else { "echo ours > ours.txt; " }
    if lowered { ours = f"echo ours > {low}/a.rs; {ours}" }
    if kind == "index" { ours = f"echo ours > {low}.rs; {ours}" }
    sh(work.clone(), f"{ours}git add -A; git commit -q -m ours; echo local > notes.txt; git fetch -q origin develop")
    return work
}

fn case(nikaia: String, repo: String, tmp: String, name: String, kind: String, lower: String) throws {
    let work = setup(tmp.clone(), name.replace(" ", "-"), kind.clone())
    if kind == "example" {
        // The stub ledgers script: it rewrites one ledger and says so, run by
        // this compiler as the checkout's `target/fast/nikaia`.
        let stub = "use std::fs\n\nfn main() throws {\n    fs::write(\"examples/a/nikaia.contracts\", fs::Root::Anywhere, \"refreshed\\n\")\n    println(\"refreshed examples/a/nikaia.contracts\")\n}\n"
        sh(work.clone(), f"mkdir -p scripts target/fast; ln -s {nikaia} target/fast/nikaia; printf 'target/\\nscripts/\\n' > .git/info/exclude")
        fs::write(f"{work}/scripts/ledgers.nika", fs::Root::Anywhere, stub)
        // The driver builds the compiler of the tree in a worktree of its own
        // (#1665) with `cargo build`; a stub `cargo` first on PATH makes that
        // compiler this one and puts the stub ledgers script in the worktree
        // (`scripts/` is not tracked here).
        sh(work.clone(), f"mkdir -p bin; printf '#!/bin/sh\\nmkdir -p scripts \"$CARGO_TARGET_DIR/fast\"\\ncp {work}/scripts/ledgers.nika scripts/\\nln -sf {nikaia} \"$CARGO_TARGET_DIR/fast/nikaia\"\\n' > bin/cargo; chmod +x bin/cargo; echo bin/ >> .git/info/exclude")
    }
    // The stub badges: the sources of the tree they are measured on.
    let badges = "ls crates/src | tr '\\n' ' ' > assets/badges/self-hosted.svg"
    let path = process::run("sh", ["-c", "echo $PATH"]).stdout.trim().clone()
    let out = process::run(nikaia, ["run", f"{repo}/scripts/drive.nika", "--", "--merge-fetched", lower, "true", badges]; dir: work.clone(), env: [("PATH", f"{work}/bin:{path}")])
    let head = sh(work.clone(), "git rev-parse HEAD").bytes[0..<8].text().clone()
    println(f"== {name}")
    println(out.stdout.trim().replace(head, "SHA"))
    println(f"exit ok: {out.ok}")
    let state = sh(work, "git log --format=%s -1; git log --format=%p -1 | wc -w; test -f .git/MERGE_HEAD && echo merge open || echo no merge open; git status --porcelain --untracked-files=all; git show --format= --name-only HEAD | sort; cat crates/nikaia-std/src/compiler/lowered/a.rs; cat crates/nikaia-std/src/compiler/lowered.rs; cat assets/badges/self-hosted.svg; echo; cat notes.txt; cat examples/a/nikaia.contracts 2>/dev/null || true")
    println(state)
}

fn main() throws {
    let tmp = process::run("sh", ["-c", "realpath $(mktemp -d)"]).stdout.trim().clone()
    let repo = root()
    let nikaia = toolchain()
    let low = "crates/nikaia-std/src/compiler/lowered"
    // The stub lowering: the lowered file from the sources, and a new file.
    let lower = f"cat crates/src/*.nika > {low}/a.rs; echo new > {low}/new.rs"
    case(nikaia.clone(), repo.clone(), tmp.clone(), "lowered only", "lowered", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp.clone(), "also a nika", "both", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp.clone(), "lowering fails", "lowered", f"echo new > {low}/new.rs; false")
    case(nikaia.clone(), repo.clone(), tmp.clone(), "clean, a source", "clean", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp.clone(), "clean, docs only", "docs", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp.clone(), "clean, lowering fails", "clean", f"echo new > {low}/new.rs; false")
    case(nikaia.clone(), repo.clone(), tmp.clone(), "clean, an example", "example", lower.clone())
    // The stub lowering of the index: its digest from the sources.
    case(nikaia, repo, tmp.clone(), "index only", "index", f"{lower}; cat crates/src/*.nika | wc -l > {low}.rs")
    process::run("rm", ["-rf", tmp])
}
