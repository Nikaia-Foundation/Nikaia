// scripts/drive.nika --merge-fetched LOWER BUILD BADGES (#1430, #1333): the
// merge of a rejected push, in a temp repository with a bare remote. A
// conflict only in the generated lowered files is resolved by re-lowering
// (here a stub that writes them from the `.nika` source) and committed, the
// autostashed local change back after it; a conflict also in a `.nika`, or a
// lowering that fails, aborts and escalates with no merge left open. A clean
// merge that brought a change under `crates/` is re-lowered and its badges
// regenerated (a stub that lists the sources) in the merge commit, before it
// could be pushed; one of documentation only is merged as it is. A clean
// merge that brought a change under `examples/` has its ledgers refreshed
// (#1591; here a stub `scripts/ledgers.nika` that writes one) and committed
// in the merge too, with the compiler the lowering settled on where the
// merge's BUILD built it in the tree target (#2154). A conflict only in the
// lowered index `lowered.rs` beside the lowered directory (both sides moved
// its digest line) is re-lowered too (#1784), and named once; a round that
// changed only its `LOWERED_DIGEST` line settles the lowering (#2154). A
// conflict whose regeneration fails from their side of the lowered files is
// regenerated from ours (#2253); when ours fails too, with the compiler of
// their commit (#2432: their emitter change), and it escalates only when all
// fail. Each
// step's seconds are logged. A conflict only in the runtime's lowered index
// `runtime/lowered.rs`, which `lower-std` writes too, is re-lowered, not
// escalated as a source (#2256).
use std::env
use std::fs
use std::process
use std::text

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// The output with each step's seconds of `MERGE timing` (#2154) as `Ns`:
// the steps and their order stay checked, the seconds vary.
fn untimed(said: String) -> String throws {
    let mut lines: Vec[String] = []
    for line in said.split("\n") {
        if !line.starts_with("MERGE timing ") {
            lines.push(line.clone())
            continue
        }
        let mut words: Vec[String] = []
        for word in line.split(" ") {
            let bare = word.strip_suffix(",") ?? word
            let digits = bare.strip_suffix("s") ?? "x"
            let comma = if word.ends_with(",") { "," } else { "" }
            if text::parse_i64(digits) != null { words.push(f"Ns{comma}") } else { words.push(word.clone()) }
        }
        lines.push(words.join(" "))
    }
    return lines.join("\n")
}

fn sh(dir: String, script: String) -> String throws {
    let out = process::run("sh", ["-c", f"set -e; {script}"]; dir: dir)
    if !out.ok { println(f"setup failed: {script}\n{out.stderr}") }
    return out.stdout.trim().clone()
}

// A repository `work` and a clone `other`, both from the bare `origin`;
// `other` pushes, `work` commits, keeps an uncommitted change and fetches.
// KIND "lowered": both sides change the lowered file, theirs a new source;
// "both": both also change the same source; "clean": theirs a new source,
// ours another file; "docs": theirs only a note in `docs/`; "index": both
// change only the lowered index `lowered.rs`, theirs a new source;
// "runtime": both change only the runtime's lowered index, theirs a new source;
// "emitter": as "lowered" (theirs brings the new emitter, #2432).
fn setup(tmp: ref fs::Root, name: String, kind: String) -> String throws {
    let base = f"{tmp.path().to_text()}/{name}"
    let low = "crates/nikaia-std/src/compiler/lowered"
    let rt = "crates/nikaia-std/src/runtime/lowered"
    let id = "git config user.email t@t; git config user.name t; git config commit.gpgsign false"
    sh(tmp.path().to_text(), f"mkdir -p {name}; cd {name}; git init -q --bare origin.git; git init -q -b develop work")
    let work = f"{base}/work"
    sh(work.clone(), f"{id}; mkdir -p {low} crates/src; echo base > {low}/a.rs; echo file > crates/nikaia-std/src/abort.rs; echo index > {low}.rs; echo base > crates/src/a.nika; echo notes > notes.txt; mkdir -p assets/badges; echo old > assets/badges/self-hosted.svg; git add -A; git commit -q -m base; git remote add origin ../origin.git; git push -q origin develop; echo target/ >> .git/info/exclude")
    if kind == "runtime" { sh(work.clone(), f"mkdir -p {rt}; echo index > {rt}.rs; git add -A; git commit -q -m runtime; git push -q origin develop") }
    sh(base.clone(), "git clone -q -b develop origin.git other")
    let other = f"{base}/other"
    let lowered = kind == "lowered" || kind == "both" || kind == "emitter"
    let mut theirs = if kind == "both" { "echo theirs > crates/src/a.nika; " } else { "echo theirs-side > crates/src/b.nika; " }
    if kind == "docs" { theirs = "mkdir -p docs; echo theirs > docs/x.md; " }
    if kind.starts_with("example") { theirs = "mkdir -p examples/a/src; echo theirs > examples/a/src/main.nika; " }
    if lowered { theirs = f"echo theirs > {low}/a.rs; {theirs}" }
    if kind == "index" { theirs = f"echo theirs > {low}.rs; {theirs}" }
    if kind == "runtime" { theirs = f"echo theirs > {rt}.rs; {theirs}" }
    sh(other, f"{id}; {theirs}git add -A; git commit -q -m theirs; git push -q origin develop")
    let mut ours = if kind == "both" { "echo ours > crates/src/a.nika; " } else { "echo ours > ours.txt; " }
    if lowered { ours = f"echo ours > {low}/a.rs; {ours}" }
    if kind == "index" { ours = f"echo ours > {low}.rs; {ours}" }
    if kind == "runtime" { ours = f"echo ours > {rt}.rs; {ours}" }
    sh(work.clone(), f"{ours}git add -A; git commit -q -m ours; echo local > notes.txt; git fetch -q origin develop")
    return work
}

fn case(nikaia: String, repo: String, tmp: ref fs::Root, name: String, kind: String, lower: String) throws {
    case_built(nikaia, repo, tmp, name, kind, lower, "true")
}

// BUILD, where not "true": a stub build command run in the tree worktree.
fn case_built(nikaia: String, repo: String, tmp: ref fs::Root, name: String, kind: String, lower: String, stub_build: String) throws {
    let work = setup(tmp, name.replace(" ", "-"), kind.clone())
    // BUILD: none here, or for "example built" the merge's own, into the tree
    // target, whose binary the ledgers then take unbuilt (#2154).
    let mut build = stub_build
    if kind == "example built" { build = f"CARGO_TARGET_DIR='{work}/target/ledger-target' cargo build -q --profile fast -p nikaia" }
    if kind.starts_with("example") {
        // The stub ledgers script: it rewrites one ledger and says so, run by
        // this compiler as the checkout's `target/fast/nikaia`.
        let stub = "use std::fs\n\nfn main() throws {\n    fs::write(\"examples/a/nikaia.contracts\", fs::Root::Anywhere, \"refreshed\\n\")\n    println(\"refreshed examples/a/nikaia.contracts\")\n}\n"
        sh(work.clone(), f"mkdir -p scripts target/fast; cp {nikaia} target/fast/nikaia; printf 'target/\\nscripts/\\n' > .git/info/exclude")
        fs::write(f"{name.replace(" ", "-")}/work/scripts/ledgers.nika", tmp, stub)
        // The driver builds the compiler of the tree in a worktree of its own
        // (#1665) with `cargo build`; a stub `cargo` first on PATH makes that
        // compiler this one and puts the stub ledgers script in the worktree
        // (`scripts/` is not tracked here); it counts its runs. A copy, not a
        // link: drive opens the compiler under fs::Root::Dir("."), which
        // refuses a link that leaves the checkout (ADR-raw-sinks-1 D11).
        sh(work.clone(), f"mkdir -p bin; printf '#!/bin/sh\\necho run >> {work}/target/cargo-runs\\nmkdir -p scripts \"$CARGO_TARGET_DIR/fast\"\\ncp {work}/scripts/ledgers.nika scripts/\\nrm -f \"$CARGO_TARGET_DIR/fast/nikaia\"; cp {nikaia} \"$CARGO_TARGET_DIR/fast/nikaia\"\\n' > bin/cargo; chmod +x bin/cargo; echo bin/ >> .git/info/exclude")
    }
    if !kind.starts_with("example") {
        // A conflict both sides fail to regenerate builds the compiler of
        // their commit with `cargo build` in the tree worktree (drive_tree_exe,
        // #2432); the stub `cargo` writes as that "compiler" the sources of
        // the tree it was built from.
        sh(work.clone(), "mkdir -p bin; printf '#!/bin/sh\\nmkdir -p \"$CARGO_TARGET_DIR/fast\"\\nls crates/src > \"$CARGO_TARGET_DIR/fast/nikaia\"\\n' > bin/cargo; chmod +x bin/cargo; echo bin/ >> .git/info/exclude")
    }
    // The stub badges: the sources of the tree they are measured on.
    let badges = "ls crates/src | tr '\\n' ' ' > assets/badges/self-hosted.svg"
    let path = process::run("sh", ["-c", "echo $PATH"]).stdout.trim().clone()
    let out = process::run(nikaia, ["run", f"{repo}/scripts/drive.nika", "--", "--merge-fetched", lower, build, badges]; dir: work.clone(), env: [("PATH", f"{work}/bin:{path}")])
    let head = sh(work.clone(), "git rev-parse HEAD").bytes[0..<8].text().clone()
    println(f"== {name}")
    println(untimed(out.stdout.trim().replace(head, "SHA")))
    println(f"exit ok: {out.ok}")
    let state = sh(work, "git log --format=%s -1; git log --format=%p -1 | wc -w; test -f .git/MERGE_HEAD && echo merge open || echo no merge open; git status --porcelain --untracked-files=all; git show --format= --name-only HEAD | sort; cat crates/nikaia-std/src/compiler/lowered/a.rs; cat crates/nikaia-std/src/compiler/lowered.rs; cat crates/nikaia-std/src/runtime/lowered.rs 2>/dev/null || true; cat assets/badges/self-hosted.svg; echo; cat notes.txt; cat examples/a/nikaia.contracts 2>/dev/null || true")
    println(state)
    if kind.starts_with("example") { println("cargo runs: " + sh(work, "cat target/cargo-runs 2>/dev/null | wc -l")) }
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    let low = "crates/nikaia-std/src/compiler/lowered"
    // The stub lowering: the lowered file from the sources, and a new file.
    let lower = f"cat crates/src/*.nika > {low}/a.rs; echo new > {low}/new.rs"
    case(nikaia.clone(), repo.clone(), tmp, "lowered only", "lowered", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp, "also a nika", "both", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp, "lowering fails", "lowered", f"echo new > {low}/new.rs; false")
    case(nikaia.clone(), repo.clone(), tmp, "clean, a source", "clean", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp, "clean, docs only", "docs", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp, "clean, lowering fails", "clean", f"echo new > {low}/new.rs; false")
    case(nikaia.clone(), repo.clone(), tmp, "clean, an example", "example", lower.clone())
    case(nikaia.clone(), repo.clone(), tmp, "clean, an example, merge build", "example built", lower.clone())
    // The stub lowering of the index: its digest from the sources.
    case(nikaia.clone(), repo.clone(), tmp, "index only", "index", f"{lower}; cat crates/src/*.nika | wc -l > {low}.rs")
    // A lowering that writes a new `LOWERED_DIGEST` line each round (#2154):
    // a set that differs only there is settled, after two rounds, not five.
    case(nikaia.clone(), repo.clone(), tmp, "index digest only", "index", f"{lower}; mkdir -p target; echo $(( $(cat target/rounds 2>/dev/null || echo 0) + 1 )) > target/rounds; echo \"pub const LOWERED_DIGEST: &str = \\\"round $(cat target/rounds)\\\";\" > {low}.rs")
    // The runtime's lowered index (#2256): lowered from the sources too.
    let rt = "crates/nikaia-std/src/runtime/lowered"
    case(nikaia.clone(), repo.clone(), tmp, "runtime index only", "runtime", f"{lower}; cat crates/src/*.nika | wc -l > {rt}.rs")
    // Their lowered emitter lacks our change (#2253): from their side of the
    // lowered file the build fails and their lowering keeps the broken file;
    // from ours it builds and settles.
    let theirs_broken = f"if grep -qx theirs {low}/a.rs; then echo theirs > {low}/a.rs; else cat crates/src/*.nika > {low}/a.rs; fi; echo new > {low}/new.rs"
    let refuses_theirs = f"if grep -qx theirs {low}/a.rs; then echo 'error[E0603]: function `file` is private'; false; fi"
    case_built(nikaia.clone(), repo.clone(), tmp, "theirs fails, ours builds", "lowered", theirs_broken, refuses_theirs)
    // Both sides fail to build: one escalation, naming both.
    case_built(nikaia.clone(), repo.clone(), tmp, "both sides fail", "lowered", lower.clone(), "echo 'error: broken'; false")
    // Their side changed the emitter (#2432): either side's lowered file is
    // the old emitter's, which the merged Rust refuses, and the lowering
    // fails unless the compiler in the tree target is the one built from
    // their commit (which has `b.nika`); with it the merge settles.
    let target = f"{tmp.path().to_text()}/their-emitter/work/target/ledger-target/fast/nikaia"
    let their_lower = f"if ! grep -qx b.nika '{target}' 2>/dev/null; then echo 'error: the old emitter'; exit 1; fi; {lower}"
    let refuses_old = f"if grep -qx -e theirs -e ours {low}/a.rs; then echo 'error[E0433]: failed to resolve: Box'; false; fi"
    case_built(nikaia, repo, tmp, "their emitter", "emitter", their_lower, refuses_old)
}
