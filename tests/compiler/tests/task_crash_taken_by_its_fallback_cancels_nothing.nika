// A crash its fallback took cancels nothing (ADR-async-5 D36, #1355): `a`
// panics and its fallback stands in, and `b`, started after it, cannot panic
// and still runs; its value is read, and the group ends without a crash.

fn boom(n: int) -> int {
    if n > 0 { panic("boom") }
    return 1
}

fn one() -> int { return 1 }

fn total() -> int {
    let a = async boom(1) catch { 7 }
    let b = async one()
    return a + b
}

fn main() throws {
    println(f"total: {total()}")
}
