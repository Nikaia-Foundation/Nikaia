// The `--bounds` report takes the proof the ledger made for the unit when it
// asks the same question (#2711): through loops, no trace, the same facts and
// contracts. Its rows are those a walk of its own gives. The guards are `if`s,
// not `assert`s: an `assert` publishes a `requires` the ledger's check does
// not see, and the report would ask another question and walk again.
pub fn loops(a: ref Vec[i64], lo: i64, hi: i64) -> Vec[i64] sync {
	let mut out: Vec[i64] = []
	if lo < 0 || hi < lo || hi > a.len() {
		return out
	}
	let mut i1 = lo
	for j in lo..<hi { if a[j] < 1 { i1 = i1 + 1 } }
	if i1 < a.len() { out.push(a[i1]) }
	let mut i2 = lo
	for j in lo..<hi { if a[j] < 2 { i2 = i2 + 1 } }
	out.push(a[i2])
	let mut i3 = lo
	for j in lo..<hi { if a[j] < 3 { i3 = i3 + 1 } }
	out.push(a[i3])
	return out
}

fn main() throws {
	let a: Vec[i64] = [0, 1, 2, 3, 4, 5]
	println(loops(a, 1, 3).len())
}
