// #1364: a `use` of a file of the same package is `NK1340`, at the `use`
// line: the files of a package already see each other (ADR-286 D1).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"pk\"\nversion = \"0.1.0\"\n")
    fs::write("src/helpers.nika", tmp, "pub fn one() -> i64 {\n    return 1\n}\n")
    fs::write("src/main.nika", tmp, "use helpers\n\nfn main() {}\n")
    let out = process::run(toolchain(), ["check", "src/main.nika"]; dir: tmp.path().to_text())
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    println(f"exit {out.code}")
}
