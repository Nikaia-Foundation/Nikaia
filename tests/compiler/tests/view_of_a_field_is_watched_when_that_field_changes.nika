struct View { head: String }
struct Cursor { input: String, pos: i64 }

fn parse(t: String) -> View {
    return View { head: t }
}

// ADR-353 D4 (#944): `v` is made from `c.input`, so changing that field in
// place while `v` is still used stays refused.
fn main() {
    let n = 1
    let text = f"a: {n}"
    let mut c = Cursor { input: text, pos: 0 }
    let v = parse(c.input)
    c.input.push_str("x")
    println(v.head)
    println(c.input)
}
