// #990: `spawn fn { … }` warns `NK2123`, with the edit to
// `async(detached) fn { … }` (ADR-async-5 D39); inside a loop's body the
// warning has no edit, since `async` is refused there (`NK2120`).
use std::task

fn work(n: i64) -> i64 sync {
    return n * 2
}

fn main() throws {
    let h = spawn fn { work(1) }
    println(h.join())
    for i in [1, 2] {
        let g = spawn fn { work(i) }
        println(g.join())
    }
    println("done")
}
