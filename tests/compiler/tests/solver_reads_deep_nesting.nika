// The solver's SMT-LIB reader on terms nested deep (#1959): QF_LIA's
// nec-smt/large-int_from_list-prp-53-48.smt2 nests 963 deep and overflowed
// the rod's stack. `lets` nests 1100 `let`s and is proved; `nots` nests 5000
// `not`s, past the reader's limit, and is unknown (unreadable); `folds`
// chains 5000 `ite`s through `define-fun`, which the fold pushes into its
// branches only up to that limit, and is proved by its contradiction. Each
// crashed the rod before.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name
// (#1305).
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn lets(n: i64) -> String {
	let mut s = "(set-logic QF_LIA)\n(set-info :status unsat)\n(declare-fun x () Int)\n(assert (let ((a0 x)) "
	for i in 1..<n + 1 {
		s = s + f"(let ((a{i} (+ a{i - 1} 1))) "
	}
	s = s + f"(< a{n} x)"
	for _ in 0..<n + 1 {
		s = s + ")"
	}
	return s + ")\n(check-sat)\n"
}

fn nots(n: i64) -> String {
	let mut s = "(set-logic QF_LIA)\n(set-info :status sat)\n(declare-fun x () Int)\n(assert "
	for _ in 1..<n + 1 {
		s = s + "(not "
	}
	s = s + "(= x x)"
	for _ in 1..<n + 1 {
		s = s + ")"
	}
	return s + ")\n(check-sat)\n"
}

fn folds(n: i64) -> String {
	let mut s = "(set-logic QF_LIA)\n(set-info :status unsat)\n"
	for i in 1..<n + 1 {
		s = s + f"(declare-fun x{i} () Int)\n"
	}
	s = s + "(define-fun a0 () Int 0)\n"
	for i in 1..<n + 1 {
		s = s + f"(define-fun a{i} () Int (ite (= x{i} 0) a{i - 1} 1))\n"
	}
	return s + f"(assert (= a{n} 2))\n(assert (< x1 x1))\n(check-sat)\n"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let dir = f"{tmp}/deep"
	process::run("mkdir", [dir.clone()])
	fs::write(f"{dir}/lets.smt2", fs::Root::Anywhere, lets(1100))
	fs::write(f"{dir}/nots.smt2", fs::Root::Anywhere, nots(5000))
	fs::write(f"{dir}/folds.smt2", fs::Root::Anywhere, folds(5000))
	let all = ["run", "scripts/solver.nika", "--", "run", dir.clone()]
	let out = process::run(nikaia, all.clone(); dir: repo)
	println(out.stdout.trim())
	if !out.ok || out.stderr.trim().len() > 0 {
		println(f"inner run `nikaia {all.join(" ")}` exited {out.code}, stderr:")
		if out.stderr.trim().len() == 0 { println("(empty)") } else { println(out.stderr.trim()) }
	}
	process::run("rm", ["-rf", tmp])
}
