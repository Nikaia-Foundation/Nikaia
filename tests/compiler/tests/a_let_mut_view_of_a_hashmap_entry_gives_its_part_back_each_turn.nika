// #949, ADR-views-1 D1, D2: a view of a `HashMap` entry in a `for` over the
// keys, with `?? continue`: each turn takes the list out of its entry and gives
// a new one back before the turn ends.
use std::collections
struct C { pub names: Vec[String], pub total: i64 }
fn keep(names: Vec[String]) -> Vec[String] sync {
    let mut out: Vec[String] = []
    for n in names.drain() { out.push(n) }
    return out
}
fn main() {
    let mut m: collections::HashMap[String, C] = collections::HashMap()
    m.insert("a", C { names: [f"a{1}", f"a{2}"], total: 0 })
    m.insert("b", C { names: [f"b{1}"], total: 0 })
    let keys: Vec[String] = ["a", "b", "c"]
    let mut seen = 0
    for k in keys {
        let mut c = m[k] ?? continue
        let old = keep(c.names)
        c.total = old.len()
        c.names = [f"{k}!"]
        seen += old.len()
    }
    let a = m["a"] ?? return
    let b = m["b"] ?? return
    println(f"{seen} {a.total} {b.total} {a.names[0]} {b.names[0]}")
}
