// #1328 (ADR-391 D2): a call forgets only what its callee may write, its
// frame, found over the call graph. `walk`'s `self.note(1)` writes
// `self.hits` alone, so `self.rows[r]` and `r += 1` are proved; so are
// `deep`'s, whose callee writes `hits` through a recursion, and `handed`'s,
// whose free function writes the `hits` of what it is handed `mut`.
// `grows`' callee pushes to `rows` through another method, so its
// `self.rows[r]` and `r += 1` stay checked.
struct Book {
	rows: Vec[i64],
	hits: i64,
}

impl Book {
	fn note(ref mut self, r: i64) {
		self.hits = self.hits + r
	}

	fn count(ref mut self, n: i64) {
		if n > 0 {
			self.hits += 1
			self.count(n - 1)
		}
	}

	fn put(ref mut self, v: i64) {
		self.rows.push(v)
	}

	fn add(ref mut self, v: i64) {
		self.put(v)
	}

	fn walk(ref mut self) -> i64 {
		let mut r = 0
		let mut sum = 0
		while r < self.rows.len() {
			self.note(1)
			sum = self.rows[r]
			r += 1
		}
		return sum
	}

	fn deep(ref mut self) -> i64 {
		let mut r = 0
		let mut sum = 0
		while r < self.rows.len() {
			self.count(2)
			sum = self.rows[r]
			r += 1
		}
		return sum
	}

	fn handed(ref mut self) -> i64 {
		let mut r = 0
		let mut sum = 0
		while r < self.rows.len() {
			tally(self)
			sum = self.rows[r]
			r += 1
		}
		return sum
	}

	fn grows(ref mut self) -> i64 {
		let mut r = 0
		let mut sum = 0
		while r < self.rows.len() && r < 5 {
			self.add(r)
			sum = self.rows[r]
			r += 1
		}
		return sum
	}
}

fn tally(mut b: Book) {
	b.hits += 1
}

fn main() throws {
	let mut b = Book { rows: [1, 2, 3], hits: 0 }
	println(f"{b.walk()} {b.deep()} {b.handed()} {b.grows()} {b.hits} {b.rows.len()}")
}
