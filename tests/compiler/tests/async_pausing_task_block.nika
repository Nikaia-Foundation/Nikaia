// A task block that pauses, in a group: its statement task runs to its end
// before the group ends, and the group's value is the block's (ADR-async-5
// D9, D20, #1226).
use std::time

fn slow(n: i64) -> i64 {
	time::sleep(1.millis())
	return n + 1
}

fn main() {
	let total = async {
		async fn {
			let x = slow(1)
			println(f"task {x}")
		}
		let y = async slow(10)
		println("beside")
		y
	}
	println(f"total {total}")
}
