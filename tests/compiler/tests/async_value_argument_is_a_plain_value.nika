// A task as an argument, an operand and a tuple part (ADR-async-5 D6, #986):
// `add` takes a plain `i64`, the callee never sees a pending value. The
// checker takes it; the lowering says it is not built yet.

fn load(n: i64) -> i64 {
	return n * 2
}

fn add(x: i64, y: i64) -> i64 {
	return x + y
}

fn main() {
	let s: i64 = add(async load(1), load(2))
	let t = async load(3) + async load(4)
	let (c, d) = (async load(5), async load(6))
	println(f"{s} {t} {c} {d}")
}
