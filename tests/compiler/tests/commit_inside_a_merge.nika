// scripts/commit.nika refuses while a merge is in progress (#1901): during
// the driver's `git merge --no-commit --autostash` a `git commit` would record
// a merge commit whose tree is HEAD plus the listed files, so the merged
// side's changes would be dropped. Once the merge is gone, it commits.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn git(dir: String, args: Vec[String]) -> String throws {
    let mut all: Vec[String] = ["-c", "user.name=T", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    return process::run("git", all; dir: dir).stdout.trim().clone()
}

fn run_commit(nikaia: String, repo: String, tmp: ref fs::Root) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/commit.nika", "--", f"{tmp.path().to_text()}/X.md.report.md"]; dir: tmp.path().to_text(), env: [("GIT_AUTHOR_NAME", "T"), ("GIT_AUTHOR_EMAIL", "t@example.com"), ("GIT_COMMITTER_NAME", "T"), ("GIT_COMMITTER_EMAIL", "t@example.com")])
    return out.stdout.trim().clone()
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    git(tmp.path().to_text(), ["init", "-q", "-b", "develop"])
    fs::write("a.txt", tmp, "a\n")
    fs::write("b.txt", tmp, "b\n")
    git(tmp.path().to_text(), ["add", "a.txt", "b.txt"])
    git(tmp.path().to_text(), ["commit", "-q", "-m", "base"])
    // origin's side changes b.txt.
    git(tmp.path().to_text(), ["checkout", "-q", "-b", "origin"])
    fs::write("b.txt", tmp, "origin\n")
    git(tmp.path().to_text(), ["commit", "-q", "-am", "origin"])
    git(tmp.path().to_text(), ["checkout", "-q", "develop"])
    fs::write("c.txt", tmp, "c\n")
    git(tmp.path().to_text(), ["add", "c.txt"])
    git(tmp.path().to_text(), ["commit", "-q", "-m", "local"])
    let before = git(tmp.path().to_text(), ["rev-parse", "HEAD"])
    // The driver's merge, not yet committed.
    git(tmp.path().to_text(), ["merge", "-q", "--no-ff", "--no-commit", "origin"])
    fs::write("a.txt", tmp, "mine\n")
    fs::write("X.md.report.md", tmp, "Result: done\nFiles: a.txt\nCommit: mine\nChangelog: none\nPushed: none\n")
    println("== merging")
    println(run_commit(nikaia.clone(), repo.clone(), tmp))
    println(f"HEAD moved: {git(tmp.path().to_text(), ["rev-parse", "HEAD"]) != before}")
    // The driver commits its merge; then the builder's commit goes in.
    git(tmp.path().to_text(), ["commit", "-q", "-m", "merge"])
    println("== merged")
    println(run_commit(nikaia, repo, tmp).replace(git(tmp.path().to_text(), ["rev-parse", "--short=8", "HEAD"]), "SHA8"))
    println(f"parents: {git(tmp.path().to_text(), ["log", "-1", "--format=%p"]).split(" ").count()}")
    println(f"b.txt: {git(tmp.path().to_text(), ["show", "HEAD:b.txt"])}")
    println(f"a.txt: {git(tmp.path().to_text(), ["show", "HEAD:a.txt"])}")
}
