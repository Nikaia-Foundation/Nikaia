// scripts/commit.nika refuses while a merge is in progress (#1901): during
// the driver's `git merge --no-commit --autostash` a `git commit` would record
// a merge commit whose tree is HEAD plus the listed files, so the merged
// side's changes would be dropped. Once the merge is gone, it commits.
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/commit.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/commit.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn git(dir: String, args: Vec[String]) -> String throws {
    let mut all: Vec[String] = ["-c", "user.name=T", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    return process::run("git", all; dir: dir).stdout.trim().clone()
}

fn run_commit(nikaia: String, repo: String, tmp: String) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/commit.nika", "--", f"{tmp}/X.md.report.md"]; dir: tmp.clone(), env: [("GIT_AUTHOR_NAME", "T"), ("GIT_AUTHOR_EMAIL", "t@example.com"), ("GIT_COMMITTER_NAME", "T"), ("GIT_COMMITTER_EMAIL", "t@example.com")])
    return out.stdout.trim().clone()
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    git(tmp.clone(), ["init", "-q", "-b", "develop"])
    fs::write(f"{tmp}/a.txt", fs::Root::Anywhere, "a\n")
    fs::write(f"{tmp}/b.txt", fs::Root::Anywhere, "b\n")
    git(tmp.clone(), ["add", "a.txt", "b.txt"])
    git(tmp.clone(), ["commit", "-q", "-m", "base"])
    // origin's side changes b.txt.
    git(tmp.clone(), ["checkout", "-q", "-b", "origin"])
    fs::write(f"{tmp}/b.txt", fs::Root::Anywhere, "origin\n")
    git(tmp.clone(), ["commit", "-q", "-am", "origin"])
    git(tmp.clone(), ["checkout", "-q", "develop"])
    fs::write(f"{tmp}/c.txt", fs::Root::Anywhere, "c\n")
    git(tmp.clone(), ["add", "c.txt"])
    git(tmp.clone(), ["commit", "-q", "-m", "local"])
    let before = git(tmp.clone(), ["rev-parse", "HEAD"])
    // The driver's merge, not yet committed.
    git(tmp.clone(), ["merge", "-q", "--no-ff", "--no-commit", "origin"])
    fs::write(f"{tmp}/a.txt", fs::Root::Anywhere, "mine\n")
    fs::write(f"{tmp}/X.md.report.md", fs::Root::Anywhere, "Result: done\nFiles: a.txt\nCommit: mine\nChangelog: none\nPushed: none\n")
    println("== merging")
    println(run_commit(nikaia.clone(), repo.clone(), tmp.clone()))
    println(f"HEAD moved: {git(tmp.clone(), ["rev-parse", "HEAD"]) != before}")
    // The driver commits its merge; then the builder's commit goes in.
    git(tmp.clone(), ["commit", "-q", "-m", "merge"])
    println("== merged")
    println(run_commit(nikaia, repo, tmp.clone()).replace(git(tmp.clone(), ["rev-parse", "--short=8", "HEAD"]), "SHA8"))
    println(f"parents: {git(tmp.clone(), ["log", "-1", "--format=%p"]).split(" ").count()}")
    println(f"b.txt: {git(tmp.clone(), ["show", "HEAD:b.txt"])}")
    println(f"a.txt: {git(tmp.clone(), ["show", "HEAD:a.txt"])}")
    process::run("rm", ["-rf", tmp])
}
