// #1213 step 6, ADR-views-v4 D2: `nikaia migrate views-3` writes `keep` on a
// parameter the keep inference finds kept (the checker's own, which refuses
// it unmarked with NK2302 once a file writes `keep`), and not on one only
// read; in a package it reads the other files, so a call into one that keeps
// is seen. In Markdown it rewrites only the `nika` blocks.
use std::env
use std::fs
use std::process

// The running `nikaia` (`env::current_exe`, ADR-program-path-1 D3), no outside
// data where it runs a program (ADR-397 D1).
fn toolchain() -> String throws {
	return env::current_exe()?.display() ?? "target/fast/nikaia"
}

fn show(root: fs::Root, path: String) throws {
	println(f"-- {path}")
	print(fs::read_to_string(path, root))
}

fn main() throws {
	let root = fs::scratch()
	let tmp = f"{root.path().display()}"
	let nikaia = toolchain()
	fs::create_dir("pkg", root.clone())
	fs::create_dir("pkg/src", root.clone())
	fs::write(
		"alone.nika",
		root.clone(),
		"struct Bag { items: Vec[String] }\n\nimpl Bag {\n    fn add(ref mut self, s: String) { self.items.push(s) }\n    fn has(ref self, s: ref String) -> bool { return self.items.contains(s) }\n}\n\nfn store(b: ref mut Bag, s: String, keep t: String) {\n    b.items.push(s)\n    b.items.push(t)\n}\n\nfn main() throws {\n    let mut b = Bag { items: [] }\n    b.add(\"a\")\n    store(b, \"b\", \"c\")\n    println(b.has(\"a\"))\n}\n",
	)
	fs::write(
		"guide.md",
		root.clone(),
		"# Prose: ref self stays\n\n```nika\nfn store(v: ref mut Vec[String], s: String) { v.push(s) }\n```\n\n```rust\nfn f(x: &ref) {}\n```\n\nText `x: ref T` stays.\n",
	)
	fs::write("pkg/nikaia.toml", root.clone(), "[package]\nname = \"pkg\"\nversion = \"0.1.0\"\n")
	fs::write(
		"pkg/src/bag.nika",
		root.clone(),
		"pub struct Bag { items: Vec[String] }\n\npub fn put(b: ref mut Bag, s: String) { b.items.push(s) }\n",
	)
	fs::write(
		"pkg/src/main.nika",
		root.clone(),
		"fn through(b: ref mut Bag, s: String) { put(b, s) }\n\nfn main() throws {\n    let mut b = Bag { items: [] }\n    through(b, \"x\")\n}\n",
	)
	let out = process::run(
		nikaia,
		["migrate", "views-3", f"{tmp}/alone.nika", f"{tmp}/guide.md", f"{tmp}/pkg"],
	)
	print(f"{out.stdout}{out.stderr}".replace(tmp, "TMP"))
	show(root.clone(), "alone.nika")
	show(root.clone(), "guide.md")
	show(root.clone(), "pkg/src/bag.nika")
	show(root, "pkg/src/main.nika")
	let checked = process::run(nikaia, ["check", f"{tmp}/alone.nika"])
	println(f"-- check: {checked.code}")
	print(f"{checked.stdout}{checked.stderr}".replace(tmp, "TMP"))
	let again = process::run(
		nikaia,
		["migrate", "views-3", f"{tmp}/alone.nika", f"{tmp}/guide.md", f"{tmp}/pkg"],
	)
	println(f"second run: [{again.stdout}{again.stderr}]")
}
