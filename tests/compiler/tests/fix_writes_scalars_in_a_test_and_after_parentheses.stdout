fn shout(word: ref str) -> i64 {
    return (word + "!").scalars.count()
}

test "a count of scalars" {
    let n = "tea".scalars.count()
    assert(n == 3)
    assert(shout("hi") == 3)
}

fn main() throws {
    println(shout("tea"))
}
