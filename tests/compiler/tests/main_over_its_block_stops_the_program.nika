// `main` is the root task (ADR-327 D14): a list it keeps to itself is
// built in a block of its own, 64 KiB, and one that outgrows it ends the
// program as a full block ends a task, with `task::OverBudget`'s message.
fn main() throws {
    let mut xs: Vec[i64] = []
    for i in 0..<100000 {
        xs.push(i)
    }
    println(f"{xs.len()}")
}
