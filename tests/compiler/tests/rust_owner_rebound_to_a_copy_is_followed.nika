// A name rebound to a copy holds no more what a `pub` function was handed
// (#1699): NK2506 follows the binding a use reads, not every binding of its
// name. A shadowing `let` of a copy, an assignment of a copy and a copy
// shadowed in a branch are accepted; an assignment of the parameter, the
// outer binding after an inner shadow, a copy on one branch only and a
// shadow back to the parameter are still refused. Before #1699 all seven
// were refused. In a loop (#1713), a name handed a copy each turn is
// accepted, and one the parameter reaches only on the second turn is
// refused through the walk's fixpoint, in a `for` and a `while`: the
// parameter is moved into a local before the loop, and each moved name
// gets a new value before the turn ends, so NK2105 does not fire.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

/// The crate `keeper`, whose functions own a list, a text, a list of texts,
/// an option, a tuple and a list of lists, and a program beside it,
/// described by hand (`nikaia describe` writes a tuple parameter as `?`).
fn project(tmp: ref fs::Root) throws {
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/rs/src", f"{tmp.path().to_text()}/app/src", f"{tmp.path().to_text()}/app/contracts"])
    fs::write("rs/Cargo.toml", tmp, "[package]\nname = \"keeper\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n\n[workspace]\n")
    fs::write("rs/src/lib.rs", tmp, "pub fn owns_list(items: Vec<u8>) -> u64 { items.len() as u64 }\npub fn owns_text(text: String) -> u64 { text.len() as u64 }\npub fn owns_names(names: Vec<String>) -> u64 { names.len() as u64 }\npub fn owns_maybe(items: Option<Vec<u8>>) -> u64 { items.map(|v| v.len() as u64).unwrap_or(9) }\npub fn owns_pair(pair: (Vec<u8>, u64)) -> u64 { pair.0.len() as u64 + pair.1 }\npub struct Sink { pub n: u64 }\nimpl Sink {\n    pub fn opened() -> Sink { Sink { n: 0 } }\n    pub fn take(&mut self, items: Vec<u8>) -> u64 { self.n += items.len() as u64; self.n }\n}\npub fn owns_rows(rows: Vec<Vec<u8>>) -> u64 { rows.len() as u64 }\npub fn names() -> Vec<String> { vec![\"a\".to_string(), \"b\".to_string()] }\npub fn maybe() -> Option<Vec<u8>> { Some(vec![1, 2]) }\n")
    fs::write("app/nikaia.toml", tmp, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nkeeper = { type = \"rust\", path = \"../rs\" }\n")
    fs::write("app/contracts/keeper.contracts", tmp, "version = 4\n\n[fn.\"keeper::owns_list\"]\npub = true\nsync = true\nkeeps = [\"items\"]\nsignature = \"(items: Vec[u8]) -> u64\"\n\n[fn.\"keeper::owns_maybe\"]\npub = true\nsync = true\nkeeps = [\"items\"]\nsignature = \"(items: Vec[u8]?) -> u64\"\n\n[fn.\"keeper::owns_names\"]\npub = true\nsync = true\nkeeps = [\"names\"]\nsignature = \"(names: Vec[String]) -> u64\"\n\n[fn.\"keeper::owns_pair\"]\npub = true\nsync = true\nkeeps = [\"pair\"]\nsignature = \"(pair: (Vec[u8], u64)) -> u64\"\n\n[fn.\"keeper::owns_text\"]\npub = true\nsync = true\nkeeps = [\"text\"]\nsignature = \"(text: String) -> u64\"\n\n[type.\"keeper::Sink\"]\npub = true\nfields = [\"n: u64\"]\n\n[fn.\"keeper::Sink::opened\"]\npub = true\nsync = true\nsignature = \"() -> Sink\"\n\n[fn.\"keeper::Sink::take\"]\npub = true\nsync = true\nkeeps = [\"items\"]\nsignature = \"(mut self, items: Vec[u8]) -> u64\"\n\n[fn.\"keeper::owns_rows\"]\npub = true\nsync = true\nkeeps = [\"rows\"]\nsignature = \"(rows: Vec[Vec[u8]]) -> u64\"\n\n[fn.\"keeper::names\"]\npub = true\nsync = true\nsignature = \"() -> Vec[String]\"\n\n[fn.\"keeper::maybe\"]\npub = true\nsync = true\nsignature = \"() -> Vec[u8]?\"\n")
    let hash = process::run("sh", ["-c", f"sha256sum {tmp.path().to_text()}/rs/src/lib.rs | cut -d' ' -f1"]).stdout.trim().clone()
    fs::write("app/contracts/keeper.derived", tmp, "version = 3\ntoolchain = \"nikaia 0.1.0\"\ninference = \"described-from-signatures\"\n\n[sources]\n\"src/lib.rs\" = \"" + hash + "\"\n")
}

fn shown(tmp: ref fs::Root, command: String, main: String) throws {
    fs::write("app/src/main.nika", tmp, main)
    let out = process::run(toolchain(), [command, "src/main.nika"]; dir: f"{tmp.path().to_text()}/app")
    let mut lines: Vec[String] = []
    for line in f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP").lines() {
        let t = line.trim()
        if !t.starts_with("Compiling") && !t.starts_with("Finished") && !t.starts_with("Running") && !t.starts_with("Locking") && !t.starts_with("Adding") {
            lines.push(line.clone())
        }
    }
    println(lines.join("\n"))
    println(f"exit {out.code}")
}

fn main() throws {
    let tmp = fs::scratch()
    project(tmp)
    shown(tmp, "check", "use keeper\n\n// accepted\npub fn shadowed(items: Vec[u8]) -> u64 sync {\n\tlet items = items.clone()\n\treturn keeper::owns_list(items)\n}\n\n// accepted\npub fn reassigned(items: Vec[u8]) -> u64 sync {\n\tlet mut x = items\n\tx = x.clone()\n\treturn keeper::owns_list(x)\n}\n\n// accepted: the inner shadow is a copy\npub fn inner_shadow(items: Vec[u8], c: bool) -> u64 sync {\n\tif c {\n\t\tlet items = items.clone()\n\t\treturn keeper::owns_list(items)\n\t}\n\treturn 0\n}\n\n// refused: assigned the parameter\npub fn assigned_back(items: Vec[u8]) -> u64 sync {\n\tlet mut x = items.clone()\n\tx = items\n\treturn keeper::owns_list(x)\n}\n\n// refused: the outer binding after an inner shadow\npub fn outer_after(items: Vec[u8], c: bool) -> u64 sync {\n\tlet x = items\n\tif c {\n\t\tlet x: Vec[u8] = [1]\n\t\tif x.len() > 5 { return 0 }\n\t}\n\treturn keeper::owns_list(x)\n}\n\n// refused: a copy only on one branch\npub fn one_branch(items: Vec[u8], c: bool) -> u64 sync {\n\tlet mut x = items\n\tif c {\n\t\tx = x.clone()\n\t}\n\treturn keeper::owns_list(x)\n}\n\n// refused: shadowed to the parameter again\npub fn shadow_back(items: Vec[u8]) -> u64 sync {\n\tlet x = items.clone()\n\tlet x = items\n\treturn keeper::owns_list(x)\n}\n\n// accepted: each turn hands a copy\npub fn loop_copy(items: Vec[u8], n: i64) -> u64 sync {\n\tlet y = items\n\tlet mut x: Vec[u8] = [1]\n\tlet mut total: u64 = 0\n\tfor _i in 0..<n {\n\t\ttotal = total + keeper::owns_list(x)\n\t\tx = y.clone()\n\t}\n\treturn total\n}\n\n// refused: the parameter reaches x only on the second turn\npub fn loop_later(items: Vec[u8], n: i64) -> u64 sync {\n\tlet mut y = items\n\tlet mut x: Vec[u8] = [1]\n\tlet mut total: u64 = 0\n\tfor _i in 0..<n {\n\t\ttotal = total + keeper::owns_list(x)\n\t\tx = y\n\t\ty = [2]\n\t}\n\treturn total\n}\n\n// refused: the same through a while\npub fn while_later(items: Vec[u8], n: i64) -> u64 sync {\n\tlet mut y = items\n\tlet mut x: Vec[u8] = [1]\n\tlet mut total: u64 = 0\n\tlet mut i = 0\n\twhile i < n {\n\t\ttotal = total + keeper::owns_list(x)\n\t\tx = y\n\t\ty = [2]\n\t\ti = i + 1\n\t}\n\treturn total\n}\n\nfn main() throws {\n\tprintln(f\"{shadowed([1])} {reassigned([1])} {inner_shadow([1], true)} {assigned_back([1])} {outer_after([1], true)} {one_branch([1], true)} {shadow_back([1])} {loop_copy([1], 2)} {loop_later([1], 2)} {while_later([1], 2)}\")\n}\n")
}
