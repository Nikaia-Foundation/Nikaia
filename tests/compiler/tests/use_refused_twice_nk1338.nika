// #1364: two `use` lines that give one name are `NK1338`, at the second
// (ADR-286 D14).
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    process::run("mkdir", ["-p", f"{tmp}/src"])
    fs::write(f"{tmp}/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"pk\"\nversion = \"0.1.0\"\n")
    fs::write(f"{tmp}/src/main.nika", fs::Root::Anywhere, "use std::fs\nuse helpers\nuse other as helpers\n\nfn main() {}\n")
    let out = process::run(toolchain(), ["check", "src/main.nika"]; dir: tmp.clone())
    print(f"{out.stdout}{out.stderr}".replace(tmp, "TMP"))
    println(f"exit {out.code}")
    process::run("rm", ["-rf", tmp])
}
