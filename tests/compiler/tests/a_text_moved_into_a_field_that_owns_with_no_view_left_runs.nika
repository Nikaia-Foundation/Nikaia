struct View { head: String }
struct Cursor { input: String, pos: i64 }

fn parse(t: String) -> View {
    return View { head: t }
}

fn advance(mut c: Cursor) {
    c.input.push_str("!")
    println(c.input)
}

// ADR-353 D9 (#942): with `v` no longer read after the move, `text` is
// simply handed to the field that owns it.
fn main() {
    let n = 1
    let text = f"a: {n}"
    let v = parse(text)
    println(v.head)
    let c = Cursor { input: text, pos: 0 }
    println(f"{c.pos}")
    println(c.input)
    let other = f"b: {n}"
    advance(Cursor { input: other, pos: 1 })
}
