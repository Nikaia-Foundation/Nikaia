// scripts/commit.nika --dry-run: the lines under the report's last field
// `Attribution:` end the message, and the report's Body: is a paragraph.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    process::run("git", ["init", "-q", tmp.path().to_text()])
    fs::write("a.txt", tmp, "x\n")
    fs::write("X.md", tmp, "# Brief\n")
    fs::write("X.md.report.md", tmp, "Result: done\nFiles: a.txt\nCommit: a subject\nBody: A paragraph for the body.\nChangelog: none\nAttribution:\nCo-Authored-By: Test <t@example.com>\nClaude-Session: https://example.com/s\n")
    let out = process::run(nikaia, ["run", f"{repo}/scripts/commit.nika", "--", "--dry-run", f"{tmp.path().to_text()}/X.md.report.md"]; dir: tmp.path().to_text())
    println(out.stdout.trim())
}
