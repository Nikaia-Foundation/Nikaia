// #2163 (ADR-381 D2): a guard that leaves when a named property is false
// makes it known after it, as a comparison's guard does: `return if
// !is_sorted(xs)`, `if !is_sorted(xs) { return }` and an `else` that
// leaves each prove the `assert(is_sorted(xs))` after them, known from the
// guard. A branch that does not leave teaches nothing, and `w.push(0)` after
// the guard may change `w`, so both claims there stay open.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn shown(tmp: ref fs::Root, text: String) -> String throws {
	let mut lines: Vec[String] = []
	for line in text.replace(tmp.path().to_text(), "TMP").lines() {
		let t = line.trim()
		if t.starts_with("Compiling") || t.starts_with("Finished") || t.starts_with("Running") {
			continue
		}
		lines.push(line.clone())
	}
	return lines.join("\n")
}

fn ran(tmp: ref fs::Root, file: String, text: String, args: Vec[String]) throws {
	fs::write(f"{file}", tmp, text)
	println(f"== {args.join(" ")}")
	let out = process::run(toolchain(), args; dir: tmp.path().to_text())
	println(shown(tmp, f"{out.stdout}{out.stderr}"))
	println(f"exit {out.code}")
}

fn main() throws {
	let tmp = fs::scratch()
	ran(tmp, "guards.nika", "fn is_sorted(v: Vec[i64]) -> bool sync {\n\tlet mut i = 1\n\twhile i < v.len() {\n\t\tif v[i - 1] > v[i] { return false }\n\t\ti = i + 1\n\t}\n\ttrue\n}\n\nfn by_return(xs: Vec[i64]) {\n\treturn if !is_sorted(xs)\n\tassert(is_sorted(xs))\n}\n\nfn by_block(xs: Vec[i64]) {\n\tif !is_sorted(xs) { return }\n\tassert(is_sorted(xs))\n}\n\nfn by_else(xs: Vec[i64]) throws {\n\tif is_sorted(xs) {\n\t\tprintln(\"sorted\")\n\t} else {\n\t\treturn\n\t}\n\tassert(is_sorted(xs))\n}\n\nfn main() throws {\n\tlet xs = [3, 1, 2]\n\treturn if !is_sorted(xs)\n\tassert(is_sorted(xs))\n\tby_return([1, 2])\n\tby_block([1, 2])\n\tby_else([1, 2])\n\tprintln(\"ok\")\n}\n", ["check", "--asserts", "guards.nika"])
	ran(tmp, "open.nika", "fn is_sorted(v: Vec[i64]) -> bool sync {\n\tlet mut i = 1\n\twhile i < v.len() {\n\t\tif v[i - 1] > v[i] { return false }\n\t\ti = i + 1\n\t}\n\ttrue\n}\n\nfn stays(xs: Vec[i64]) throws {\n\tif !is_sorted(xs) { println(\"unsorted\") }\n\tassert(is_sorted(xs))\n}\n\nfn changed(xs: Vec[i64]) {\n\tlet mut w = xs.clone()\n\treturn if !is_sorted(w)\n\tw.push(0)\n\tassert(is_sorted(w))\n}\n\nfn main() throws {\n\tstays([1, 2])\n\tchanged([1, 2])\n}\n", ["check", "--asserts", "--unproved-claims=warn", "open.nika"])
}
