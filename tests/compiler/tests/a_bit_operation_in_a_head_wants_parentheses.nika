// #939: a shift or a bit operation beside a comparison in a guard, an `if`
// head or a `while` head is refused with NK1197, as in a `let`, where it used
// to be a parse error.
fn main() {
	let m: i64 = 8
	let s = match true {
		true if m == 1 << 3 => "eight",
		else => "other",
	}
	println(s)
	if m & 8 == 8 {
		println("yes")
	}
	while m >> 1 == 4 {
		println("once")
	}
}
