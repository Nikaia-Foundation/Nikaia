// scripts/drive.nika --scripts-only (the paths on standard input, #2577):
// the batches of helper scripts (and
// documentation) the driver pushes after their named tests, without the suite (#2347).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn case(nikaia: String, repo: String, tmp: ref fs::Root, name: String, paths: String) throws {
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--scripts-only"]; dir: repo, stdin: process::Input::Text(paths))
    println(f"== {name}")
    println(out.stdout.trim())
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    case(nikaia.clone(), repo.clone(), tmp, "drive", "scripts/drive.nika\n")
    case(nikaia.clone(), repo.clone(), tmp, "drive-doc", "scripts/drive.nika\ndocs/supervisor.md\n")
    case(nikaia.clone(), repo.clone(), tmp, "workflow-run", "scripts/drive.nika\nscripts/solver.nika\n")
    case(nikaia.clone(), repo.clone(), tmp, "workflows", "scripts/check-adr-refs.nika\nscripts/java_binding.nika\nscripts/ledgers.nika\n")
    case(nikaia.clone(), repo.clone(), tmp, "tools", "tools/x.nika\n")
    case(nikaia.clone(), repo.clone(), tmp, "untested", "scripts/drive.nika\nscripts/zz-nothing.nika\n")
    case(nikaia.clone(), repo.clone(), tmp, "ci-changes", "scripts/drive.nika\nscripts/ci-changes.sh\n")
    case(nikaia.clone(), repo.clone(), tmp, "pre-push", "scripts/pre-push.nika\n")
    case(nikaia.clone(), repo.clone(), tmp, "docs", "docs/a.md\n")
    case(nikaia.clone(), repo.clone(), tmp, "test", "scripts/drive.nika\ntests/compiler/tests/drive_docs.nika\n")
}
