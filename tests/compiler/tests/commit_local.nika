// scripts/commit.nika without --push commits locally: `Pushed: local <sha>` in
// the report and `committed <sha8> local` (owner, 2026-10-31: the driver pushes
// once the suite is green). The scratch repository has no remote.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn git(dir: String, args: Vec[String]) -> String throws {
    let mut all: Vec[String] = ["-c", "user.name=T", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    return process::run("git", all; dir: dir).stdout.trim().clone()
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    git(tmp.path().to_text(), ["init", "-q", "-b", "develop"])
    fs::write("a.txt", tmp, "x\n")
    fs::write("X.md", tmp, "# Brief\n\nAttribution:\nCo-Authored-By: Test <t@example.com>\n")
    fs::write("X.md.report.md", tmp, "Result: done\nFiles: a.txt\nCommit: a subject\nChangelog: none\nPushed: none\n")
    let out = process::run(nikaia, ["run", f"{repo}/scripts/commit.nika", "--", f"{tmp.path().to_text()}/X.md.report.md"]; dir: tmp.path().to_text(), env: [("GIT_AUTHOR_NAME", "T"), ("GIT_AUTHOR_EMAIL", "t@example.com"), ("GIT_COMMITTER_NAME", "T"), ("GIT_COMMITTER_EMAIL", "t@example.com")])
    let sha = git(tmp.path().to_text(), ["rev-parse", "HEAD"])
    let short = git(tmp.path().to_text(), ["rev-parse", "--short=8", "HEAD"])
    println(out.stdout.trim().replace(short, "SHA8"))
    let report = fs::read_to_string("X.md.report.md", tmp)
    println(report.trim().replace(sha, "SHA"))
    println(git(tmp.path().to_text(), ["log", "--format=%s"]))
}
