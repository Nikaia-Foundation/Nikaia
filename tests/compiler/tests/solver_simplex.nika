// The simplex theory (ADR-270 D12, #1283 item 3): the theory interface's
// calls one by one on three bounds over one column, then problems asserted
// whole and checked. Each conflict is a Farkas lemma, and its log, closed by
// one learned clause, is replayed by `sv_check`; an integer column goes by
// branch-and-bound, each split a D5 step; a literal implied through a row is
// explained by a Farkas lemma; one problem runs under Bland's rule from the
// start and under the smallest-coefficient rule alone; coefficients near
// 2^40 answer *unknown (overflow)*, never a wrong answer. The logic layer's
// files, `solver/sv_*.nika` and the driver below make one program, as
// `scripts/solver.nika` makes it.
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
		],
	).stdout.trim().clone()
	if exe.len() > 0 { return exe }
	return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "fn row1(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn le(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row1(ks, c), rel: SvRel::Le }
}

fn lt(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row1(ks, c), rel: SvRel::Lt }
}

fn eq(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: row1(ks, c), rel: SvRel::Eq }
}

fn lits_text(ls: ref Vec[u32]) -> String {
	let mut parts: Vec[String] = []
	for l in ls {
		parts.push(f\"{l}\")
	}
	return \"[\" + parts.join(\", \") + \"]\"
}

fn said_by(checked: ref SvChecked) -> String {
	return match checked {
		SvChecked::Consistent => \"consistent\",
		SvChecked::Conflict(c) => f\"conflict {lits_text(c.lits)}\",
		SvChecked::Lemmas(ls) => f\"{ls.len()} lemmas\",
		SvChecked::Unknown(why) => sv_unknown(why),
	}
}

fn model_text(m: ref collections::BTreeMap[String, i64]) -> String {
	let mut parts: Vec[String] = []
	for (name, v) in m {
		parts.push(f\"{name} = {v}\")
	}
	return parts.join(\", \")
}

// Every atom asserted as it stands, one level, then a final check; a
// conflict closed by one learned clause and the log replayed.
fn scenario(title: String, names: Vec[String], atoms: Vec[SvAtom], bland_after: i64) {
	let n = atoms.len()
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	while (a as i64) < n {
		clauses.push([sv_lit(a, false)])
		a += 1
	}
	let query = SvQuery { atoms: atoms, clauses: clauses, columns: names.len().checked_u32() ?? 0, reals: [] }
	let mut book = sv_book(query) ?? return
	let mut inputs: Vec[u32] = []
	let mut i: u32 = 0
	while (i as i64) < n {
		inputs.push(book.input(i))
		i += 1
	}
	let budget = lg_budget()
	let mut theory = sv_simplex(names)
	theory.bland_after = bland_after
	theory.push_level()
	let mut got = SvChecked::Consistent
	let mut j: u32 = 0
	while (j as i64) < n {
		got = theory.assert(sv_lit(j, false), book)
		match got {
			SvChecked::Consistent => {},
			else => {
				break
			},
		}
		j += 1
	}
	match got {
		SvChecked::Consistent => {
			got = theory.check(true, budget, book)
		},
		else => {},
	}
	let work = f\"{theory.pivots} pivots, {theory.splits} splits\"
	match got {
		SvChecked::Conflict(c) => {
			let mut hints: Vec[u32] = []
			for l in c.lits {
				hints.push(inputs[(l / 2) as i64])
			}
			hints.push(c.id)
			book.learn([], hints)
			let v = sv_check(query, book.log.steps)
			let said = if v.ok { \"checked\" } else { f\"rejected at {v.step}: {v.reason}\" }
			println(f\"{title}: conflict {lits_text(c.lits)}, {work}, log of {book.log.steps.len()} steps {said}\")
		},
		SvChecked::Consistent => {
			println(f\"{title}: consistent, {model_text(theory.model())}, {work}\")
		},
		else => {
			println(f\"{title}: {said_by(got)}, {work}\")
		},
	}
}

fn calls() {
	let atoms = [le([1], -2), le([1], -5), le([-1], 3)]
	let query = SvQuery { atoms: atoms, clauses: [[0], [4]], columns: 1, reals: [] }
	let mut book = sv_book(query) ?? return
	let c0 = book.input(0)
	let c1 = book.input(1)
	let budget = lg_budget()
	let mut theory = sv_simplex([\"x\"])
	theory.push_level()
	println(f\"assert x <= 2: {said_by(theory.assert(0, book))}\")
	let implied = theory.propagate(book)
	println(f\"propagate: {lits_text(implied)}\")
	let why = theory.explain(2, book) ?? return
	println(f\"explain x <= 5: {lits_text(why.lits)}\")
	let first = theory.check(true, budget, book)
	println(f\"check: {said_by(first)}, model {model_text(theory.model())}\")
	theory.push_level()
	let conflict = theory.assert(4, book)
	println(f\"assert x >= 3 at level {theory.level()}: {said_by(conflict)}\")
	theory.backtrack(1)
	let again = theory.check(true, budget, book)
	println(f\"backtrack to 1, check: {said_by(again)}, shared {lits_text(theory.shared())}\")
	match conflict {
		SvChecked::Conflict(c) => {
			book.learn([], [c0, c1, c.id])
		},
		else => {},
	}
	let v = sv_check(query, book.log.steps)
	let said = if v.ok { \"checked\" } else { v.reason.clone() }
	println(f\"log of {book.log.steps.len()} steps: {said}\")
}

// Propagation through a row: x <= 1 and y <= 1 bound the slack of x + y, so
// x + y <= 4 is implied; its explanation is a Farkas lemma, and the log closed
// against the negated atom is replayed.
fn through_a_row() {
	let atoms = [le([1], -1), le([0, 1], -1), le([1, 1], -4)]
	let query = SvQuery { atoms: atoms, clauses: [[0], [2], [5]], columns: 2, reals: [] }
	let mut book = sv_book(query) ?? return
	let c0 = book.input(0)
	let c1 = book.input(1)
	let c2 = book.input(2)
	let mut theory = sv_simplex([\"x\", \"y\"])
	theory.push_level()
	theory.assert(0, book)
	theory.assert(2, book)
	let implied = theory.propagate(book)
	println(f\"x <= 1, y <= 1, propagate: {lits_text(implied)}\")
	let why = theory.explain(4, book) ?? return
	println(f\"explain x + y <= 4: {lits_text(why.lits)}\")
	book.learn([], [c0, c1, c2, why.id])
	let v = sv_check(query, book.log.steps)
	let said = if v.ok { \"checked\" } else { f\"rejected at {v.step}: {v.reason}\" }
	println(f\"log of {book.log.steps.len()} steps: {said}\")
}

fn main() throws {
	calls()
	scenario(\"x + y >= 5, x <= 2, y <= 2\", [\"x\", \"y\"], [le([-1, -1], 5), le([1], -2), le([0, 1], -2)], 64)
	scenario(\"x + y < 3, x >= 1, y >= 2\", [\"x\", \"y\"], [lt([1, 1], -3), le([-1], 1), le([0, -1], 2)], 64)
	scenario(\"x + y <= 3, x >= 1, y >= 2\", [\"x\", \"y\"], [le([1, 1], -3), le([-1], 1), le([0, -1], 2)], 64)
	scenario(\"2x = 1\", [\"x\"], [eq([2], -1)], 64)
	scenario(\"2x + 3y = 7, x >= 0, y >= 0\", [\"x\", \"y\"], [eq([2, 3], -7), le([-1], 0), le([0, -1], 0)], 64)
	scenario(\"1 <= 3x - 3y <= 2, 0 <= x, y <= 3\", [\"x\", \"y\"], [le([-3, 3], 1), le([3, -3], -2), le([-1], 0), le([1], -3), le([0, -1], 0), le([0, 1], -3)], 64)
	through_a_row()
	scenario(\"the same, Bland's rule from the start\", [\"x\", \"y\"], [le([-3, 3], 1), le([3, -3], -2), le([-1], 0), le([1], -3), le([0, -1], 0), le([0, 1], -3)], 0)
	scenario(\"the same, smallest coefficient only\", [\"x\", \"y\"], [le([-3, 3], 1), le([3, -3], -2), le([-1], 0), le([1], -3), le([0, -1], 0), le([0, 1], -3)], 1000000)
	scenario(\"two equalities, coefficients near 2^40\", [\"x\", \"y\", \"z\"], [eq([1099511627689, 1099511627791, 1099511627773], -1), eq([1099511627497, -1099511627543, 1099511627531], -3), le([-1], 0), le([0, -1], 0), le([0, 0, -1], 0)], 64)
}
"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain(repo.clone())
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_walk", "sv_smt", "sv_smtlib", "sv_rod"] {
		paths.push(f"{repo}/crates/nikaia-std/src/solver/{name}.nika")
	}
	let mut uses: Vec[String] = []
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver())
	let args: Vec[String] = ["run", "main.nika"]
	let out = process::run(nikaia, args; dir: tmp.clone())
	println(out.stdout.trim())
	process::run("rm", ["-rf", tmp])
}
