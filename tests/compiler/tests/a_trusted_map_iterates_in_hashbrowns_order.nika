// A map whose text keys no untrusted key reaches lowers to std's `TrustedMap`
// (ADR-010 D5), `hashbrown`'s table with the `Fast` hasher. The same 500
// `entry`/`insert`/`remove` steps as map.rs's Rust test
// `the_order_is_hashbrowns` (#2315); the `.stdout` was recorded while that
// test still compared with `hashbrown::HashMap<&str, usize, Fast>` and is
// that map's order, so a change to the order shows here.
use std::collections

fn main() throws {
	let mut keys: Vec[String] = Vec()
	for i in 0..<500 {
		keys.push(f"k{i * 7919 % 1000}")
	}
	let mut m: collections::HashMap[String, i64] = collections::HashMap()
	let mut i = 0
	while i < 500 {
		m.entry(keys[i].clone()).or_insert(i)
		if i % 3 == 0 {
			m.insert(keys[i].clone(), i)
		}
		if i % 5 == 0 {
			m.remove(keys[i / 2])
		}
		i += 1
	}
	for (k, v) in m {
		println(f"{k} {v}")
	}
}
