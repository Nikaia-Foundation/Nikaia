// #1597, #2216, ADR-397 D1, D2: the environment is the operator's. An
// `assert` about `env::var("DEPTH")` is a claim the compiler checks as any
// other (`NK1300` where it is not proved); a name a CGI host fills
// (`HTTP_`, RFC 3875's) is untrusted (`NK1202`), and so is `env::vars("")`,
// whose list can hold such a name. A map keyed by an operator's value takes
// the fast hash, one keyed by a host's value the keyed one. The `trusted:`
// option of `env::var` is gone. A project whose `[build]` says
// `environment = "untrusted"`, or a build given `--environment=untrusted`,
// takes every variable as data from outside (D4).
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn said(nikaia: String, tmp: String, label: String, source: String, verb: Vec[String]) throws {
    fs::write(f"{tmp}/p.nika", fs::Root::Anywhere, source)
    let mut args = verb.clone()
    args.push("p.nika")
    let out = process::run(nikaia, args; dir: tmp.clone())
    println(f"-- {label}")
    for line in f"{out.stdout}{out.stderr}".lines() {
        let kept = line.starts_with("error") || line.starts_with("Checked") || line.starts_with("input provenance") || line.starts_with("    ") && line.contains(" is ") || line.starts_with("hash for")
        if kept {
            println(line.replace(tmp, "TMP"))
        }
    }
}

fn built(nikaia: String, tmp: String, label: String, manifest: String, source: String, verb: Vec[String]) throws {
    process::run("mkdir", ["-p", f"{tmp}/app/src"])
    fs::write(f"{tmp}/app/nikaia.toml", fs::Root::Anywhere, manifest)
    fs::write(f"{tmp}/app/src/main.nika", fs::Root::Anywhere, source)
    let out = process::run(nikaia, verb; dir: f"{tmp}/app")
    println(f"-- {label}")
    for line in f"{out.stdout}{out.stderr}".lines() {
        if line.starts_with("error") || line.contains("environment") {
            println(line.replace(tmp, "TMP"))
        }
    }
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    let head = "use std::env\nuse std::text\n\nfn main() throws {\n"
    let operator = "    let n: i64 = text::parse_i64(env::var(\"DEPTH\") ?? \"8\") ?? 8\n"
    let host = "    let n: i64 = text::parse_i64(env::var(\"HTTP_X_DEPTH\") ?? \"8\") ?? 8\n"
    let meta = "    let n: i64 = text::parse_i64(env::var(\"QUERY_STRING\") ?? \"8\") ?? 8\n"
    let all = "    let n: i64 = env::vars(\"\").len()\n"
    let marked = "    let n: i64 = text::parse_i64(env::var(\"DEPTH\"; trusted: true) ?? \"8\") ?? 8\n"
    let tail = "    assert(n > 0)\n    println(n)\n}\n"
    said(nikaia, tmp, "an operator's name, a claim as any other", f"{head}{operator}{tail}", ["check"])
    said(nikaia, tmp, "an operator's name after the guard", f"{head}{operator}    return if !(n > 0)\n{tail}", ["check"])
    said(nikaia, tmp, "an HTTP_ name", f"{head}{host}{tail}", ["check"])
    said(nikaia, tmp, "an RFC 3875 name", f"{head}{meta}{tail}", ["check"])
    said(nikaia, tmp, "env::vars(\"\")", f"{head}{all}{tail}", ["check"])
    said(nikaia, tmp, "the trusted: option is gone", f"{head}{marked}{tail}", ["check"])
    let map = "use std::env\nuse std::collections\n\nfn main() throws {\n    let mut m = collections::HashMap()\n    m.insert(env::var(\""
    let rest = "\") ?? \"\", 1)\n    println(m.len())\n}\n"
    said(nikaia, tmp, "a map keyed by HOME", f"{map}HOME{rest}", ["lower", "--trust", "-o", "p.rs"])
    said(nikaia, tmp, "a map keyed by HTTP_COOKIE", f"{map}HTTP_COOKIE{rest}", ["lower", "--trust", "-o", "p.rs"])
    let package = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n"
    let program = f"{head}{operator}{tail}"
    built(nikaia, tmp, "a project, the operator's by default", package, program, ["check", "src/main.nika"])
    built(nikaia, tmp, "[build] environment = \"untrusted\"", f"{package}\n[build]\nenvironment = \"untrusted\"\n", program, ["check", "src/main.nika"])
    built(nikaia, tmp, "--environment=untrusted", package, program, ["check", "--environment=untrusted", "src/main.nika"])
    built(nikaia, tmp, "another word", f"{package}\n[build]\nenvironment = \"stranger\"\n", program, ["check", "src/main.nika"])
    process::run("rm", ["-rf", tmp])
}
