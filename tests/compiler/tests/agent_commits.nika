// scripts/agent.nika --commits N: the section of a builder's prompt that lists
// the commits on HEAD naming issue #N, with a `Fixes #N` line called out first
// (#1682: #1665 was briefed after a commit had fixed it). `#16650` names
// another issue; an issue no commit names gives an empty line. Run in a git
// repository of its own.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn commit(tmp: ref fs::Root, message: String) throws {
    process::run("git", ["-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "--allow-empty", "-m", message]; dir: tmp.path().to_text())
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    let tmp = fs::scratch()
    process::run("git", ["init", "-q"]; dir: tmp.path().to_text())
    commit(tmp, "drive: a first step\n\nPart of #1665")
    commit(tmp, "drive: another issue\n\nFixes #16650")
    commit(tmp, "drive: the rest\n\nFixes #1500, #1665")
    for n in ["1665", "1500", "1400"] {
        let cmd = f"{nikaia} run {repo}/scripts/agent.nika -- --commits {n} 2>/dev/null | sed -E 's/[0-9a-f]{{7,}}/SHA/g'"
        let out = process::run("sh", ["-c", cmd]; dir: tmp.path().to_text())
        println(f"[{n}]")
        println(out.stdout.trim())
    }
}
