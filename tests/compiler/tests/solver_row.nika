// Sparse rows over `u32` variables (ADR-270 D10, #1282 item 3): built from
// terms in any order, combined by a sorted merge and divided by their gcd,
// scaled, tightened over the integers, a column eliminated with the
// smallest multipliers, evaluated, every overflow refused; and `logic_lia`'s
// `LgLin` atoms translated into rows. `tools/sv_num.nika`,
// `tools/sv_row.nika` and the `LgLin` struct are run beside a driver.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The item of `text` that starts with the line `start`, up to its closing
// brace.
fn item(text: String, start: String) -> String {
	let at = text.find(f"\n{start}") ?? return ""
	let rest = text[at..]
	let end = rest.find("\n}\n") ?? return ""
	return f"{rest[0..<end]}\n}}\n"
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "fn t(col: u32, k: i64) -> SvTerm {
    return SvTerm { col: col, k: k }
}

fn show(r: SvRow?) -> String {
    let row = r ?? return \"refused\"
    return sv_row_text(row)
}

fn main() throws {
    println(\"== building\")
    let r = sv_row_of([t(5, 2), t(1, -3), t(5, 4), t(9, 0), t(2, 7), t(2, -7)], 4) ?? sv_row_constant(0)
    println(f\"2·x5 - 3·x1 + 4·x5 + 0·x9 + 7·x2 - 7·x2 + 4 = {sv_row_text(r)}\")
    println(f\"columns ascending: {r.cols.iter().join(\" \")}; coefficient of x5 {sv_row_coef(r, 5)}, of x2 {sv_row_coef(r, 2)}\")
    let big: i64 = 9223372036854775807
    println(f\"x0 + x0 at i64 max: {show(sv_row_of([t(0, big), t(0, 1)], 0))}\")

    println(\"== combining\")
    let s = sv_row_of([t(1, 6), t(3, 2), t(5, -4)], -2) ?? sv_row_constant(0)
    println(f\"r = {sv_row_text(r)}, s = {sv_row_text(s)}\")
    println(f\"2·r + s = {show(sv_row_combine(2, r, 1, s))}\")
    println(f\"r + s unreduced = {show(sv_row_sum(1, r, 1, s))}\")
    println(f\"r - r = {show(sv_row_combine(1, r, -1, r))}\")
    println(f\"-3·s = {show(sv_row_scale(s, -3))}\")
    println(f\"s · 2^62: {show(sv_row_scale(s, 4611686018427387904))}\")
    println(f\"x1 eliminated between r and s: {show(sv_row_eliminate(r, s, 1))}\")
    println(f\"x5 eliminated between r and s: {show(sv_row_eliminate(r, s, 5))}\")
    println(f\"x9 eliminated (neither holds it): {show(sv_row_eliminate(r, s, 9))}\")
    println(f\"column picked between r and s, opposite signs: {sv_row_pick(r, s, true) ?? 99}\")
    let u = sv_row_of([t(0, 1), t(1, 4)], 0) ?? sv_row_constant(0)
    let w = sv_row_of([t(0, -3), t(1, -6)], 0) ?? sv_row_constant(0)
    println(f\"column picked between {sv_row_text(u)} and {sv_row_text(w)}: x{sv_row_pick(u, w, false) ?? 99}\")

    println(\"== reducing\")
    let even = sv_row_of([t(0, 4), t(2, -6)], 10) ?? sv_row_constant(0)
    println(f\"{sv_row_text(even)} reduced: {sv_row_text(sv_row_reduced(even.clone()))}\")
    let odd = sv_row_of([t(0, 4), t(2, -6)], 3) ?? sv_row_constant(0)
    println(f\"{sv_row_text(odd)} reduced: {sv_row_text(sv_row_reduced(odd.clone()))}, tightened (<= 0): {sv_row_text(sv_row_tightened(odd))}\")
    let minus = sv_row_of([t(0, 2)], -3) ?? sv_row_constant(0)
    println(f\"{sv_row_text(minus)} tightened: {sv_row_text(sv_row_tightened(minus))}\")

    println(\"== evaluating\")
    let values: Vec[SvRat] = [sv_rat(1, 2) ?? sv_int(0), sv_int(3), sv_int(-1)]
    let e = sv_row_of([t(0, 4), t(1, -1), t(2, 2)], 1) ?? sv_row_constant(0)
    println(f\"{sv_row_text(e)} at x0 = 1/2, x1 = 3, x2 = -1: {sv_rat_text(sv_row_eval(e, values) ?? sv_int(99))}\")
    let missing = sv_row_eval(r, values)
    println(f\"{sv_row_text(r)} there: {if missing == null { \"refused, x5 has no value\" } else { \"?\" }}\")

    println(\"== from logic_lia's LgLin\")
    let mut vars = sv_vars()
    let mut terms: collections::BTreeMap[String, i64] = collections::BTreeMap()
    terms.insert(\"y\", 3)
    terms.insert(\"blank\", -2)
    let first = sv_row_of_lin(LgLin { terms: terms, constant: 7 }, vars) ?? sv_row_constant(0)
    let mut more: collections::BTreeMap[String, i64] = collections::BTreeMap()
    more.insert(\"x\", 1)
    more.insert(\"y\", -1)
    let second = sv_row_of_lin(LgLin { terms: more, constant: 0 }, vars) ?? sv_row_constant(0)
    println(f\"3·y - 2·blank + 7 = {sv_row_text(first)}; x - y = {sv_row_text(second)}\")
    println(f\"columns: {vars.names.iter().join(\", \")}\")
}
"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut program = "use std::collections\n"
	for file in ["crates/nikaia-std/src/tools/sv_num.nika", "crates/nikaia-std/src/tools/sv_row.nika"] {
		program.push_str(fs::read_to_string(f"{repo}/{file}", fs::Root::Anywhere))
		program.push_str("\n")
	}
	program.push_str(item(
		fs::read_to_string(
			f"{repo}/crates/nikaia-std/src/tools/logic_lia.nika",
			fs::Root::Anywhere,
		),
		"pub struct LgLin {",
	))
	program.push_str(driver())
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, program)
	let out = process::run(nikaia, ["run", "main.nika"]; dir: tmp)
	println(out.stdout.trim())
	process::run("rm", ["-rf", tmp])
}
