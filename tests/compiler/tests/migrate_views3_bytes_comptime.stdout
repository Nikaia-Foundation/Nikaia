fn size(b: Bytes) -> i64 {
    return b.len()
}

fn tail(b: Bytes) -> Bytes {
    return b[1..]
}

comptime NAME: String = "nikaia"

fn main() {
    let text: String = "abc"
    println(size(text.bytes))
    let t = tail(text.bytes)
    println(t.len())
    println(size(tail(text.bytes)))
    println(NAME)
    println(NAME.len())
    let names: Vec[String] = [NAME]
    println(names.len())
}
