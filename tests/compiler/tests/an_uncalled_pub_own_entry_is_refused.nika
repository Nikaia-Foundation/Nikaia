// An entry of the package's own Rust saying `pub = true` is refused at the
// entry, once, whether anything calls it or not (ADR-rust-boundary-1 D26,
// #2297): `words::thrice`, which no Nikaia code calls, is `NK2508` at its
// line in `contracts/crate.contracts`; and `words::twice`, which `quad` calls
// twice, is refused once there too, not again at its calls.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn checked(nikaia: String, tmp: ref fs::Root, case: String) throws {
    let ran = process::run(nikaia, ["check", "src/demo.nika"]; dir: f"{tmp.path().to_text()}/demo")
    println(f"--- {case}: exit {ran.code}")
    print(ran.stdout.replace(tmp.path().to_text(), "TMP"))
    print(ran.stderr.replace(tmp.path().to_text(), "TMP"))
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    process::run("cp", ["-r", f"{repo}/tests/compiler/own_rust/demo", tmp.path().to_text()])
    let demo = tmp.join("demo")
    let entries = fs::read_to_string("contracts/crate.contracts", demo)
    let thrice: String = "\n[fn.\"words::thrice\"]\npub = true\nsync = true\ntouches = []\nlocks = false\nthreads = false\nsignature = \"(x: i64) -> i64\"\n"
    fs::write("contracts/crate.contracts", demo, f"{entries}{thrice}")
    checked(nikaia.clone(), tmp, "uncalled")
    fs::write("contracts/crate.contracts", demo, f"{entries.replace("pub = false", "pub = true")}{thrice}")
    checked(nikaia, tmp, "called and uncalled")
}
