// #1285 item 3, ADR-270 D9: with `NIKAIA_DUMP_QUERIES` naming a directory,
// each question the compiler asks its solvers is written there as SMT-LIB 2
// (`lg_smtlib_write`), one file per normal form, named by the key of
// `nikaia.proofs` and stating the answer the compiler took as its
// `:status` (`unsat` proved, `sat` refuted). `scripts/solver.nika run DIR`
// measures them.
use std::env
use std::fs
use std::process
use std::text

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn main() throws {
	let tmp = fs::scratch()
	let nikaia = toolchain()
	process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src"])
	fs::write("nikaia.toml", tmp, "[package]\nname = \"dumped\"\nversion = \"0.1.0\"\n")
	fs::write("src/main.nika", tmp, "fn step(n: i64) -> i64 sync {\n\tif n > 0 && n < 10 {\n\t\tassert(n + 1 > 1)\n\t}\n\treturn 0\n}\n\nfn main() throws {\n\tprintln(step(3))\n}\n")
	let built = process::run(nikaia, ["build", "--no-cache"]; dir: tmp.path().to_text(), env: [("NIKAIA_DUMP_QUERIES", f"{tmp.path().to_text()}/dump")])
	println(f"built: {built.stderr.contains("error") == false}")
	// Each file in the order of its name, a SHA-256 key: whether it is one,
	// then the file.
	let shown = process::run("sh", ["-c", "for f in dump/*.smt2; do echo \"named by a key: $(basename $f .smt2 | grep -cE '^[0-9a-f]{64}$')\"; cat $f; done"]; dir: tmp.path().to_text())
	print(shown.stdout)
}
