// #1888 (ADR-306 D23): a literal that gives the lists of a `Row` by clones
// of two different `Row`s' fields builds them of unrelated lengths, so the
// length rule fails and `row.ks[0]` under `row.cols.len() == 1` stays
// checked.
struct Row {
	cols: Vec[u32],
	ks: Vec[i64],
	constant: i64,
}

fn first_k(row: ref Row) -> i64 {
	if row.cols.len() == 1 && row.ks[0] == 1 {
		return 1
	}
	return 0
}

fn mixed(a: ref Row, b: ref Row) -> Row {
	return Row { cols: a.cols.clone(), ks: b.ks.clone(), constant: 0 }
}

fn main() throws {
	let a = Row { cols: [7], ks: [1], constant: 0 }
	let b = Row { cols: [7, 8], ks: [1, 2], constant: 0 }
	println(first_k(mixed(a, b)))
}
