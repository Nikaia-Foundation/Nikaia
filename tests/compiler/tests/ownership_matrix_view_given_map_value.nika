use std::collections

struct Holder {
    name: String,
}

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

fn fill(mut m: collections::HashMap[String, String], keep v: String) {
    m.insert("k", v)
}

fn main() throws {
    let h = Holder { name: make() }
    let s = h.name
    let mut m: collections::HashMap[String, String] = collections::HashMap()
    fill(m, s)
    println(m["k"] ?? "none")
    println(s)
}
