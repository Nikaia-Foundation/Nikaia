exit 0
[fn."keeper::checked"]
throws = ["?"]
signature = "(n: u64)"
[fn."keeper::nested"]
keeps = ["pair"]
signature = "(pair: (String?, ref Array[u8])) -> u64"
[fn."keeper::owns_pair"]
keeps = ["pair"]
signature = "(pair: (Vec[u8], u64)) -> u64"
[fn."keeper::sums"]
signature = "(pair: (u64, u64)) -> u64"
