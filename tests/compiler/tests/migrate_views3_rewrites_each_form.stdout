struct Bag { items: Vec[String], pair: (i64, i64), }

impl Bag {
    fn count(self) -> i64 { return self.items.len() }
    fn clear(mut self) { self.items.clear() }
    fn at(self, i: i64) -> String { return self.items[i] }
}

fn grow(mut b: Bag, n: i64) { b.clear() }

