fn make(i: i64) -> String {
	let mut g = String()
	g.push_str(f"w{i % 50} ")
	for _k in 0..<64 {
		g.push_str("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk ")
	}
	return g
}

fn main() throws {
	let mut kept: Vec[String] = []
	let mut total = 0
	for i in 0..<4000 {
		let text = make(i)
		for w in text.split(" ") {
			if w.len() > 0 {
				if kept.len() >= 64 {
					total += kept.swap_remove(0).len()
				}
				kept.push(w)
				break
			}
		}
	}
	println(f"{kept.len()} {total}")
}
