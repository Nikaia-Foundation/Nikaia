// A task's own error reaches the caller through the function that starts
// it (Part II 12.7, ADR-328 D8, #988). `work` cannot panic, so `run` throws
// no `task::Crashed` (ADR-async-5 D35, #1355): the task fails in `run`'s
// own channel.

enum Bad { Oops(i64) }
impl Error for Bad {
	fn message(ref self) -> String {
		return match self {
			Bad::Oops(n) => f"task {n} failed",
		}
	}
}

fn work(n: i64) -> i64 throws {
	if n > 5 {
		throw Bad::Oops(n)
	}
	return n
}

fn run(n: i64) -> i64 throws {
	let a = async work(n)
	println("the window's statement")
	return a + 1
}

fn main() throws {
	for n in [1, 7] {
		let m = run(n) catch {
			println(f"caught: {error}")
			0
		}
		println(f"{m}")
	}
}
