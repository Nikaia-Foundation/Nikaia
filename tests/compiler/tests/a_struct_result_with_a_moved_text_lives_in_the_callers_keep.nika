struct View { head: String }
struct Cursor { input: String, pos: i64 }

fn parse(t: String) -> View {
    return View { head: t }
}

// ADR-353 D8, D10 (#942): `make` builds a text, views it, moves it into the
// `Cursor` it returns; the text lives in the caller's keep.
fn make(n: i64) -> Cursor {
    let text = f"a: {n}"
    let v = parse(text)
    let c = Cursor { input: text, pos: 0 }
    println(v.head)
    return c
}

fn main() {
    let c = make(1)
    println(f"{c.input} {c.pos}")
}
