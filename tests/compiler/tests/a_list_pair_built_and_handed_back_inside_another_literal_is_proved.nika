// #1653 (ADR-306 D23, ADR-369 D4): a builder that hands its `Row` back as a
// field of another literal keeps `cols.len() == ks.len()`, so `first_k`
// reads `ks[0]` under `cols.len() == 1` without a check; by the field's name
// alone too.
struct Row {
	cols: Vec[u32],
	ks: Vec[i64],
	constant: i64,
}

struct Reading {
	form: Row,
	scale: i64,
}

struct Outer {
	reading: Reading,
}

fn first_k(row: ref Row) -> i64 {
	if row.cols.len() == 1 && row.ks[0] == 1 {
		return 1
	}
	return 0
}

fn reading(row: ref Row, scale: i64) -> Reading? {
	if scale == 0 {
		return null
	}
	let mut form = Row { cols: row.cols.clone(), ks: [], constant: 0 }
	for k in row.ks {
		form.ks.push(k / scale)
	}
	return Reading { form: form, scale: scale }
}

fn outer(row: ref Row) -> Outer {
	let mut form = Row { cols: row.cols.clone(), ks: [], constant: 1 }
	for k in row.ks {
		form.ks.push(k)
	}
	Outer { reading: Reading { form, scale: 1 } }
}

fn main() throws {
	let row = Row { cols: [7], ks: [2], constant: 0 }
	let r = reading(row, 2) ?? return
	println(first_k(r.form))
	println(first_k(outer(row).reading.form))
}
