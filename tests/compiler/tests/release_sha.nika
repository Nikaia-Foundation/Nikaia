// release.nika: a report's `Pushed:` may name its commits after the sha,
// `local <sha> (<sha> <subject>; ...)`; the release takes the first word, so
// the version's heading is the commit's subject (0.0.1467 had none).
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    for pushed in ["local 8dd3d1da", "local 8dd3d1da (56c79be2 A check; 8dd3d1da its CI)", "8dd3d1da", "  local  8dd3d1da  "] {
        let out = process::run(nikaia.clone(), ["run", "scripts/release.nika", "--", "--sha", pushed.clone()]; dir: repo.clone()).stdout.trim().clone()
        println(f"[{pushed}] -> {out}")
    }
}
