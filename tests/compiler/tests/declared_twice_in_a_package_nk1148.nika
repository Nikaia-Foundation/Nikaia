// #1364: a name two files of one package declare is `NK1148`, the rule of a
// name declared twice in one file, at the second declaration (ADR-286 D4, D6).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"pk\"\nversion = \"0.1.0\"\n")
    fs::write("src/a.nika", tmp, "pub struct Row {\n    pub id: i64\n}\n")
    fs::write("src/main.nika", tmp, "fn main() {}\n\nstruct Row {\n    id: i64\n}\n")
    let out = process::run(toolchain(), ["check", "src/main.nika"]; dir: tmp.path().to_text())
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    println(f"exit {out.code}")
}
