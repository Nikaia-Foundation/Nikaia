// #1589: `.to_string()` on text is refused (NK1301, ADR-text-reuse-1 D1): a
// view is a `String` already. A number keeps its text form.
fn tail(line: String) -> String {
    let m = line.find(";") ?? return ""
    return line.after(m.end).to_string()
}

fn main() throws {
    let n: i64 = 7
    let city = f"Kiel {n}"
    let own: String = city.to_string()
    println(f"{tail(f"Hamburg;{n}")} {own.trim().to_string()} {n.to_string()}")
}
