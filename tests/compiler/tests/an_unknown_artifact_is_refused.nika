// `[build] artifact` names `program`, `c-library` or `rust-library` (ADR-393
// D1, #1392); any other word is refused with the three it may be.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let nikaia = toolchain()
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"odd\"\nversion = \"0.1.0\"\n\n[build]\nartifact = \"dylib\"\n")
    fs::write("src/main.nika", tmp, "fn main() {\n    println(\"never\")\n}\n")
    let out = process::run(nikaia, ["build"]; dir: tmp.path().to_text(), env: [("RUST_BACKTRACE", "0")])
    println(f"exit {out.code}")
    println(out.stderr.trim().replace(tmp.path().to_text(), "TMP"))
}
