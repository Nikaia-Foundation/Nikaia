// A view of a call's result (`.to_string()` on it is refused, ADR-text-reuse-1 D1)
// is a view, which a function's `String` result cannot hand back.
fn made(n: i64) -> String {
    return f" x{n} "
}

fn trimmed(n: i64) -> String {
    return made(n).trim()
}

fn main() throws {
    println(trimmed(1))
}
