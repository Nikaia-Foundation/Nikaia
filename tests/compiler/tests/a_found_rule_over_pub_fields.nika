/// A found rule over `pub` fields (ADR-306 D22, ADR-369 D4, #1755): in a
/// program every write to them is in the build, so `n <= cols.len()`,
/// which every literal builds and every method keeps, proves `last`'s
/// read. A method taking a `mut` parameter of a type no field has (`Book`)
/// cannot be handed a field of another `Tally`, so `cols` and `rows` stay
/// found as long as each other; `mix` takes a `mut` list, which may be
/// another `Tally`'s field, and `Mixed`'s read stays checked.
struct Book {
	pub log: Vec[i64],
}

struct Tally {
	pub cols: Vec[i64],
	pub n: i64,
}

impl Tally {
	fn add(ref mut self, c: i64) {
		self.cols.push(c)
		self.n += 1
	}

	fn last(self) -> i64 {
		if self.n > 0 {
			return self.cols[self.n - 1]
		}
		return 0
	}
}

struct Pair {
	cols: Vec[i64],
	rows: Vec[i64],
}

impl Pair {
	fn add(ref mut self, c: i64, mut book: Book) -> i64 {
		let v = self.cols.len()
		self.cols.push(c)
		self.rows.push(c)
		book.log.push(v)
		return v
	}

	fn put(ref mut self, c: i64, mut book: Book) {
		let s = self.add(c, book)
		self.rows[s] = c
	}
}

struct Mixed {
	cols: Vec[i64],
	rows: Vec[i64],
}

impl Mixed {
	fn add(ref mut self, c: i64, mut log: Vec[i64]) -> i64 {
		let v = self.cols.len()
		self.cols.push(c)
		self.rows.push(c)
		log.push(v)
		return v
	}

	fn put(ref mut self, c: i64, mut log: Vec[i64]) {
		let s = self.add(c, log)
		self.rows[s] = c
	}
}

fn main() throws {
	let mut t = Tally { cols: [], n: 0 }
	t.add(4)
	t.add(5)
	println(t.last())
	let mut p = Pair { cols: [], rows: [] }
	let mut b = Book { log: [] }
	p.put(6, b)
	println(p.rows[0])
	let mut m = Mixed { cols: [], rows: [] }
	let mut log: Vec[i64] = []
	m.put(7, log)
	println(m.rows[0])
}
