// What `io::read_line` and `io::read_exact` hand back comes from outside the
// program, as `io::read_to_string` does (ADR-365, #2242): an `assert` about a
// line or a body waits for a guard (NK1202), and `trusted: true` marks a
// read whose sender the program trusts.
use std::io

fn main() throws {
    let line = io::read_line() ?? ""
    assert(line.len() > 0)
    let body = io::read_exact(4)
    assert(body.len() == 4)
    let marked = io::read_line(trusted: true) ?? ""
    println(f"{line} {marked}")
}
