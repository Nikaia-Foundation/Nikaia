// `h.join(within: d)` on a `task::ChildHandle` limits the wait, not the task
// (Part I 8.2, ADR-async-5 D17): on time-out it throws `task::TimedOut`, the
// task keeps running, and the handle stays live, so the handler joins it
// again and gets the value.

use std::time

fn slow() -> i64 {
	time::sleep(300.millis())
	return 7
}

fn main() {
	let h = async(handle) fn { slow() }
	let v = h.join(within: 10.millis()) catch {
		match error {
			task::TimedOut => {
				println("timed out, the task runs on")
				h.join() catch { -1 }
			},
			else => -1,
		}
	}
	println(f"{v}")
}
