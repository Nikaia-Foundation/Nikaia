struct W { n: i64 }

impl W {
    fn chars(ref self) -> i64 {
        return self.n
    }
}

fn vowels(s: ref str) -> i64 {
    let mut n = 0
    for c in s.scalars {
        if c == 'a' || c == 'e' {
            n += 1
        }
    }
    return n
}

fn main() throws {
    let s = "tea"
    println(vowels(s))
    println(s.scalars.count())
    let v: Vec[scalar] = "abc".scalars.collect()
    println(v.len())
    println("  hi ".trim().scalars.all(fn(c) { c.is_alphabetic() }))
    let w = W { n: 7 }
    println(w.chars())
}
