// #1672: `nikaia test` ends a test program that runs past its time limit
// (`NIKAIA_TEST_TIME_LIMIT` seconds), with every process it started, fails
// it with its name and `timed out after N s`, and goes on with the next.
// `waits_on_a_child` starts a `sleep` that shares its output streams: killed
// alone, the program would leave the `sleep` holding the runner's pipes.
// The build gets no limit (0, #1775): ten times 2 s could end a cold build.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp}/src", f"{tmp}/tests"])
    fs::write(f"{tmp}/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"hanging\"\nversion = \"0.1.0\"\n")
    fs::write(f"{tmp}/src/main.nika", fs::Root::Anywhere, "fn main() {}\n")
    fs::write(f"{tmp}/tests/fine.nika", fs::Root::Anywhere, "fn main() throws {\n    println(\"fine\")\n}\n")
    fs::write(f"{tmp}/tests/fine.stdout", fs::Root::Anywhere, "fine\n")
    fs::write(f"{tmp}/tests/spins.nika", fs::Root::Anywhere, "fn main() {\n    while true {}\n}\n")
    fs::write(f"{tmp}/tests/waits_on_a_child.nika", fs::Root::Anywhere, "use std::process\n\nfn main() throws {\n    process::run(\"sleep\", [\"600\"]; stdout: process::Stream::Inherited, stderr: process::Stream::Inherited)\n}\n")
    let out = process::run(nikaia, ["test"]; dir: tmp.clone(), env: [("NIKAIA_TEST_TIME_LIMIT", "2"), ("NIKAIA_TEST_BUILD_TIME_LIMIT", "0")])
    println(f"exit {out.code}")
    for line in f"{out.stdout}{out.stderr}".lines() {
        if line.starts_with("program ") || line.starts_with("--- ") || line.starts_with("timed out") || line.starts_with("test result") {
            println(line)
        }
    }
    process::run("rm", ["-rf", tmp])
}
