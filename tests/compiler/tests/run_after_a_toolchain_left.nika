// #1584: a program `nikaia run` builds starts with no LD_LIBRARY_PATH even
// when the run bundle's record was written under another toolchain that is
// gone since. A first run resolves a copy of the toolchain under a home of
// its own (as a test that moves HOME does) and writes the record; the copy is
// removed; a second run in the same cache must not link the program against
// the removed copy's `std`.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() > 0 { return exe }
	return "nikaia"
}

fn main() throws {
	let nikaia = toolchain()
	let tmp = fs::scratch()
	let sysroot = process::run("rustc", ["--print", "sysroot"]).stdout.trim().clone()
	let name = process::run("basename", [sysroot.clone()]).stdout.trim().clone()
	let home = tmp.join("home")
	process::run("mkdir", ["-p", f"{home.path().to_text()}/.rustup/toolchains", f"{tmp.path().to_text()}/a", f"{tmp.path().to_text()}/b"])
	// Hard links: a copy of the toolchain at another path, at no cost.
	let copied = process::run("cp", ["-al", sysroot, f"{home.path().to_text()}/.rustup/toolchains/{name}"])
	if !copied.ok {
		println(copied.stderr.trim())
		process::exit(1)
	}
	fs::write("a/main.nika", tmp, "fn main() throws {\n    println(\"a\")\n}\n")
	fs::write("b/main.nika", tmp, "fn main() throws {\n    println(\"b\")\n}\n")
	let cache = tmp.join("cache")
	let moved: Vec[(String, String)] = [("HOME", home.path().to_text()), ("RUSTUP_HOME", f"{home.path().to_text()}/.rustup"), ("RUSTUP_TOOLCHAIN", name.clone()), ("NIKAIA_CACHE_DIR", cache.path().to_text())]
	let first = process::run(nikaia.clone(), ["run", "main.nika"]; dir: f"{tmp.path().to_text()}/a", env: moved, env_remove: ["LD_LIBRARY_PATH"])
	println(f"first: {first.stdout.trim()} (exit {first.code})")
	let back: Vec[(String, String)] = [("NIKAIA_CACHE_DIR", cache.path().to_text())]
	let second = process::run(nikaia, ["run", "main.nika"]; dir: f"{tmp.path().to_text()}/b", env: back, env_remove: ["LD_LIBRARY_PATH"])
	println(f"second: {second.stdout.trim()} (exit {second.code})")
	if !second.ok {
		println(second.stderr.trim().replace(tmp.path().to_text(), "T"))
	}
}
