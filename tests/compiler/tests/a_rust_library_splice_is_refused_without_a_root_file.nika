// `[rust-library]` refused with NK1348 (ADR-rust-boundary-1 D23, #1438): in a package
// whose artifact is not a rust-library, without `root`, and with a `root`
// that names no file of the package. Each package of
// `rust_library_splice/` is built in a scratch copy and its refusal printed.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    for package in ["not_a_library", "no_root", "missing_root"] {
        process::run("cp", ["-r", f"{repo}/tests/compiler/rust_library_splice/{package}", tmp.path().to_text()])
        let built = process::run(nikaia, ["build"]; dir: f"{tmp.path().to_text()}/{package}")
        println(f"{package}: exit {built.code}")
        println(built.stderr.trim().replace(tmp.path().to_text(), "TMP"))
    }
}
