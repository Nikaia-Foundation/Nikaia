// `async { … }`, a group, with an `async e` statement in it, and
// `async fn { … }`, whose value is the lambda's result (ADR-async-5 D9, D10,
// #986): both run on the group runtime (#988).

fn work(n: i64) throws {
	println(f"{n}")
}

fn main() throws {
	let n = async {
		async work(1)
		3
	}
	// The main line's `work(2)` follows the group: beside the task it would
	// write stdout in the task's window (Part I 8.1.2, #1259).
	work(2)
	let v: i64 = async fn { 4 }
	let w = work(5)
	println(f"{n} {v}")
}
