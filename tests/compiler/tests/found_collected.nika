// batch.nika and drive.nika (supervisor, 2026-11-06): a report's `Found:` no
// longer cuts the batch; the driver appends `<brief>: Found: ...` to
// DIR/found.txt (created when missing) and prints a `FOUND` line, one per
// `Found:` line (#1677). A
// `Deviation:` still cuts. A report with no Found whose `Needs: supervisor
// decision: <gap>` names its gap gives that gap as its Found (#1744).
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    // The scripts run in their lane's directory, which lies below the
    // working directory; they find the toolchain and scripts under the
    // checkout's names.
    process::run("ln", ["-s", f"{repo}/target", f"{tmp.path().to_text()}/target"])
    process::run("ln", ["-s", f"{repo}/scripts", f"{tmp.path().to_text()}/scripts"])
    fs::write("batch.txt", tmp, "a.md\n")
    fs::write("a.md", tmp, "body\n")
    let head = "Result: done\nPushed: local abc\nGate: green\n"
    fs::write("a.md.report.md", tmp, head + "Found: NK1131 refuses a lent field (probe p.nika)\nDeviation: none\nChangelog: none\n")
    let batch = process::run(nikaia.clone(), ["run", f"{repo}/scripts/batch.nika", "--", "."]; dir: tmp.path().to_text())
    print(f"batch: {batch.stdout}")
    for k in 0..<2 {
        let found = process::run(nikaia.clone(), ["run", "scripts/drive.nika", "--", "--found", tmp.path().to_text(), f"{tmp.path().to_text()}/a.md"]; dir: repo.clone())
        print(f"drive {k}: {found.stdout}")
    }
    print("found.txt:\n" + fs::read_to_string("found.txt", tmp))
    // One defect per `Found:` line (#1677): two lines are two findings.
    fs::write("b.md.report.md", tmp, head + "Found: NK1131 refuses a lent field (probe p.nika)\nFound: describe writes ? for [T; N] (probe q.nika)\nFound: none\nDeviation: none\n")
    let two = process::run(nikaia.clone(), ["run", "scripts/drive.nika", "--", "--found", tmp.path().to_text(), f"{tmp.path().to_text()}/b.md"]; dir: repo.clone())
    print(f"two: {two.stdout}")
    fs::write("c.md.report.md", tmp, head + "Found: none\nNeeds: supervisor decision: ADR-306 has no rule for a struct result's fields\n")
    let gap = process::run(nikaia.clone(), ["run", "scripts/drive.nika", "--", "--found", tmp.path().to_text(), f"{tmp.path().to_text()}/c.md"]; dir: repo.clone())
    print(f"needs gap: {gap.stdout}")
    fs::write("c.md.report.md", tmp, head + "Found: none\nNeeds: supervisor decision\n")
    let bare = process::run(nikaia.clone(), ["run", "scripts/drive.nika", "--", "--found", tmp.path().to_text(), f"{tmp.path().to_text()}/c.md"]; dir: repo.clone())
    print(f"needs bare: {bare.stdout}")
    fs::write("a.md.report.md", tmp, head + "Found: none\nDeviation: step 2 not built\nChangelog: none\n")
    let cut = process::run(nikaia.clone(), ["run", f"{repo}/scripts/batch.nika", "--", "."]; dir: tmp.path().to_text())
    print(f"deviation: {cut.stdout}")
    let none = process::run(nikaia.clone(), ["run", "scripts/drive.nika", "--", "--found", tmp.path().to_text(), f"{tmp.path().to_text()}/a.md"]; dir: repo.clone())
    print(f"no found: {none.stdout}")
}
