// #1213 step 6, ADR-views-v4 D2: `nikaia migrate views-3` reads a package's
// `tests/*.nika` as `nikaia test` does, with the package's ledger: a call into
// the package keeps what the package says, so the tool run over a package
// writes no `keep` into a test that only reads through the package's call
// (read alone, every call into the package failed closed to `keep`). The
// package is written here, small, so what `packages/json` later does with its
// own fields (a `ref` field, which the migration drops) does not move the test.
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
		],
	).stdout.trim().clone()
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn main() throws {
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let nikaia = toolchain()
	process::run("mkdir", ["-p", f"{tmp}/words/src", f"{tmp}/words/tests"])
	fs::write(
		f"{tmp}/words/nikaia.toml",
		fs::Root::Anywhere,
		"[package]\nname = \"words\"\nversion = \"0.1.0\"\n\n[build]\nartifact = \"rust-library\"\n",
	)
	fs::write(
		f"{tmp}/words/src/main.nika",
		fs::Root::Anywhere,
		"pub fn count(text: String) -> i64 {\n    let mut n = 0\n    for _w in text.split(\" \") {\n        n = n + 1\n    }\n    return n\n}\n",
	)
	fs::write(
		f"{tmp}/words/tests/count.nika",
		fs::Root::Anywhere,
		"use words\n\nfn line(text: String) throws {\n    println(words::count(text))\n}\n\nfn main() throws {\n    line(\"a b\")\n}\n",
	)
	let out = process::run(nikaia, ["migrate", "views-3", f"{tmp}/words/tests"])
	println(f"exit: {out.code}")
	print(out.stderr.replace(tmp, "TMP"))
	let kept = process::run(
		"sh",
		["-c", f"cd {tmp}/words/tests && grep -n '\\bkeep\\b' *.nika"],
	).stdout
	print(kept)
	process::run("rm", ["-rf", tmp])
}
