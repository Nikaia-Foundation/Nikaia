// ADR-views-3 D14, #1295: a fenced `nika` or `nikaia` block of a Markdown
// file is code under the same rule as a `.nika` file. A trait `ref` result
// whose source the old declaration does not fix keeps its `ref`, and
// `nikaia migrate views-3` names it with its line in the Markdown file and
// exits 1. A block of another language is not read.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    fs::write(f"{tmp}/p.md", fs::Root::Anywhere, "Intro\n\n```nika\ntrait Pick {\n    fn pick(a: ref String, b: ref String) -> ref String\n}\n```\n\n```rust\ntrait X { fn x(a: ref String, b: ref String) -> ref String }\n```\n\n```nikaia\n// second\ntrait Q {\n    fn none() -> ref String\n    fn one(a: ref String) -> ref String\n}\n```\n")
    let out = process::run(nikaia, ["migrate", "views-3", f"{tmp}/p.md"])
    print(f"{out.stdout}{out.stderr}".replace(tmp, "TMP"))
    println(f"exit {out.code}")
    print(fs::read_to_string(f"{tmp}/p.md", fs::Root::Anywhere))
    process::run("rm", ["-rf", tmp])
}
