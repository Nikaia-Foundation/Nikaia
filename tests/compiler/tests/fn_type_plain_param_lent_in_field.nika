// ADR-views-3 D2: a declared function whose plain text parameter is lent fits
// a struct field of a function type that lends it (#1254).
struct Tools { measure: fn(s: String) -> i64 sync }

fn count(s: String) -> i64 {
    return s.len()
}

fn main() {
    let t = Tools { measure: count }
    let g = "four ".trim().to_string()
    println(t.measure(g))
    println(g)
}
