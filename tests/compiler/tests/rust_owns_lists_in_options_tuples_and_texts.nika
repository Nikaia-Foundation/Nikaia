// A list or text built in the package crosses to a Rust owner as it is,
// however it gets there (ADR-327 D8, #1547): through private functions and
// fields, to a method of a described type, in an option, a tuple, a list of
// texts and a list of lists, and back as a list of texts and an option.
// Before #1547 the method, the option, the tuple, the list of texts and the
// list of lists each left a rustc error.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

/// The crate `keeper`, whose functions own a list, a text, a list of texts,
/// an option, a tuple and a list of lists, and a program beside it,
/// described by hand (`nikaia describe` writes a tuple parameter as `?`).
fn project(tmp: ref fs::Root) throws {
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/rs/src", f"{tmp.path().to_text()}/app/src", f"{tmp.path().to_text()}/app/contracts"])
    fs::write("rs/Cargo.toml", tmp, "[package]\nname = \"keeper\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n\n[workspace]\n")
    fs::write("rs/src/lib.rs", tmp, "pub fn owns_list(items: Vec<u8>) -> u64 { items.len() as u64 }\npub fn owns_text(text: String) -> u64 { text.len() as u64 }\npub fn owns_names(names: Vec<String>) -> u64 { names.len() as u64 }\npub fn owns_maybe(items: Option<Vec<u8>>) -> u64 { items.map(|v| v.len() as u64).unwrap_or(9) }\npub fn owns_pair(pair: (Vec<u8>, u64)) -> u64 { pair.0.len() as u64 + pair.1 }\npub struct Sink { pub n: u64 }\nimpl Sink {\n    pub fn opened() -> Sink { Sink { n: 0 } }\n    pub fn take(&mut self, items: Vec<u8>) -> u64 { self.n += items.len() as u64; self.n }\n}\npub fn owns_rows(rows: Vec<Vec<u8>>) -> u64 { rows.len() as u64 }\npub fn names() -> Vec<String> { vec![\"a\".to_string(), \"b\".to_string()] }\npub fn maybe() -> Option<Vec<u8>> { Some(vec![1, 2]) }\n")
    fs::write("app/nikaia.toml", tmp, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nkeeper = { type = \"rust\", path = \"../rs\" }\n")
    fs::write("app/contracts/keeper.contracts", tmp, "version = 4\n\n[fn.\"keeper::owns_list\"]\npub = true\nsync = true\nkeeps = [\"items\"]\nsignature = \"(items: Vec[u8]) -> u64\"\n\n[fn.\"keeper::owns_maybe\"]\npub = true\nsync = true\nkeeps = [\"items\"]\nsignature = \"(items: Vec[u8]?) -> u64\"\n\n[fn.\"keeper::owns_names\"]\npub = true\nsync = true\nkeeps = [\"names\"]\nsignature = \"(names: Vec[String]) -> u64\"\n\n[fn.\"keeper::owns_pair\"]\npub = true\nsync = true\nkeeps = [\"pair\"]\nsignature = \"(pair: (Vec[u8], u64)) -> u64\"\n\n[fn.\"keeper::owns_text\"]\npub = true\nsync = true\nkeeps = [\"text\"]\nsignature = \"(text: String) -> u64\"\n\n[type.\"keeper::Sink\"]\npub = true\nfields = [\"n: u64\"]\n\n[fn.\"keeper::Sink::opened\"]\npub = true\nsync = true\nsignature = \"() -> Sink\"\n\n[fn.\"keeper::Sink::take\"]\npub = true\nsync = true\nkeeps = [\"items\"]\nsignature = \"(mut self, items: Vec[u8]) -> u64\"\n\n[fn.\"keeper::owns_rows\"]\npub = true\nsync = true\nkeeps = [\"rows\"]\nsignature = \"(rows: Vec[Vec[u8]]) -> u64\"\n\n[fn.\"keeper::names\"]\npub = true\nsync = true\nsignature = \"() -> Vec[String]\"\n\n[fn.\"keeper::maybe\"]\npub = true\nsync = true\nsignature = \"() -> Vec[u8]?\"\n")
    let hash = process::run("sh", ["-c", f"sha256sum {tmp.path().to_text()}/rs/src/lib.rs | cut -d' ' -f1"]).stdout.trim().clone()
    fs::write("app/contracts/keeper.derived", tmp, "version = 3\ntoolchain = \"nikaia 0.1.0\"\ninference = \"described-from-signatures\"\n\n[sources]\n\"src/lib.rs\" = \"" + hash + "\"\n")
}

fn shown(tmp: ref fs::Root, command: String, main: String) throws {
    fs::write("app/src/main.nika", tmp, main)
    let out = process::run(toolchain(), [command, "src/main.nika"]; dir: f"{tmp.path().to_text()}/app")
    let mut lines: Vec[String] = []
    for line in f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP").lines() {
        let t = line.trim()
        if !t.starts_with("Compiling") && !t.starts_with("Finished") && !t.starts_with("Running") && !t.starts_with("Locking") && !t.starts_with("Adding") {
            lines.push(line.clone())
        }
    }
    println(lines.join("\n"))
    println(f"exit {out.code}")
}

fn main() throws {
    let tmp = fs::scratch()
    project(tmp)
    shown(tmp, "run", "use keeper\n\nstruct Bag {\n\titems: Vec[u8],\n}\n\nfn give(items: Vec[u8]) -> u64 sync {\n\treturn keeper::owns_list(items)\n}\n\nfn give_on(items: Vec[u8]) -> u64 sync {\n\treturn give(items)\n}\n\nfn give_bag(bag: Bag) -> u64 sync {\n\treturn keeper::owns_list(bag.items)\n}\n\nfn word(n: i64) -> String {\n\tlet mut s = String()\n\ts.push_str(f\"w{n}\")\n\treturn s\n}\n\nfn main() throws {\n\tlet mut a: Vec[u8] = [1, 2]\n\ta.push(3)\n\tprintln(f\"two levels: {give_on(a)}\")\n\tlet mut b: Vec[u8] = [4]\n\tb.push(5)\n\tlet bag = Bag { items: b }\n\tprintln(f\"field of a bag: {give_bag(bag)}\")\n\tlet mut c: Vec[u8] = [6]\n\tc.push(7)\n\tlet held = Bag { items: c }\n\tprintln(f\"field here: {keeper::owns_list(held.items)}\")\n\tlet mut s = keeper::Sink::opened()\n\tlet mut d: Vec[u8] = [8]\n\td.push(9)\n\tprintln(f\"method: {s.take(d)}\")\n\tlet mut e: Vec[u8] = [1]\n\te.push(2)\n\tlet m: Vec[u8]? = e\n\tprintln(f\"option: {keeper::owns_maybe(m)}\")\n\tprintln(f\"none: {keeper::owns_maybe(null)}\")\n\tlet mut f: Vec[u8] = [1]\n\tf.push(2)\n\tprintln(f\"pair: {keeper::owns_pair((f, 1))}\")\n\tlet mut g: Vec[String] = []\n\tg.push(word(1))\n\tg.push(word(2))\n\tprintln(f\"names: {keeper::owns_names(g)}\")\n\tlet mut h: Vec[Vec[u8]] = []\n\th.push([1, 2])\n\tprintln(f\"rows: {keeper::owns_rows(h)}\")\n\tlet back = keeper::names()\n\tprintln(f\"names back: {back.len()} {back[0]}\")\n\tlet mb = keeper::maybe()\n\tprintln(f\"maybe back: {(mb ?? []).len()}\")\n}\n")
}
