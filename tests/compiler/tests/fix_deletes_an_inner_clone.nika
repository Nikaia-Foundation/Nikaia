// #1977: a needless `.clone()` that is an inner step of a chain carries its
// own span, so `NK1350` stands at the step and `nikaia fix` deletes it: the
// last use of a `let` (`x.clone().len()`) and the clone of a type that copies
// (`p.clone().x`). The file then checks with no `NK1350` and runs with the
// output it had.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    let file = f"{tmp}/main.nika"
    fs::write(file, fs::Root::Anywhere, "struct P { x: i64, y: i64 }\n\nfn make() -> String {\n    let mut g = String()\n    g.push_str(\"abc\")\n    return g\n}\n\nfn main() throws {\n    let x = make()\n    println(x.clone().len())\n    let p = P { x: 1, y: 2 }\n    println(p.clone().x + p.y)\n}\n")
    let before = process::run(nikaia, ["run", f"{tmp}/main.nika"])
    let warned = process::run(nikaia, ["check", f"{tmp}/main.nika"])
    print(f"before: {warned.stdout}{warned.stderr}".replace(tmp, "TMP"))
    let fixed = process::run(nikaia, ["fix", f"{tmp}/main.nika"])
    print(f"fix: {fixed.stdout}{fixed.stderr}".replace(tmp, "TMP"))
    print(fs::read_to_string(file, fs::Root::Anywhere))
    let checked = process::run(nikaia, ["check", f"{tmp}/main.nika"])
    print(f"check: {checked.stdout}{checked.stderr}".replace(tmp, "TMP"))
    let after = process::run(nikaia, ["run", f"{tmp}/main.nika"])
    println(f"same output: {after.stdout == before.stdout}")
    print(after.stdout)
    process::run("rm", ["-rf", tmp])
}
