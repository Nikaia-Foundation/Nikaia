// #1977: a needless `.clone()` that is an inner step of a chain carries its
// own span, so `NK1350` stands at the step and `nikaia fix` deletes it: the
// last use of a `let` (`x.clone().len()`) and the clone of a type that copies
// (`p.clone().x`). The file then checks with no `NK1350` and runs with the
// output it had.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    let file = f"{tmp.path().to_text()}/main.nika"
    fs::write("main.nika", tmp, "struct P { x: i64, y: i64 }\n\nfn make() -> String {\n    let mut g = String()\n    g.push_str(\"abc\")\n    return g\n}\n\nfn main() throws {\n    let x = make()\n    println(x.clone().len())\n    let p = P { x: 1, y: 2 }\n    println(p.clone().x + p.y)\n}\n")
    let before = process::run(nikaia, ["run", f"{tmp.path().to_text()}/main.nika"])
    let warned = process::run(nikaia, ["check", f"{tmp.path().to_text()}/main.nika"])
    print(f"before: {warned.stdout}{warned.stderr}".replace(tmp.path().to_text(), "TMP"))
    let fixed = process::run(nikaia, ["fix", f"{tmp.path().to_text()}/main.nika"])
    print(f"fix: {fixed.stdout}{fixed.stderr}".replace(tmp.path().to_text(), "TMP"))
    print(fs::read_to_string("main.nika", tmp))
    let checked = process::run(nikaia, ["check", f"{tmp.path().to_text()}/main.nika"])
    print(f"check: {checked.stdout}{checked.stderr}".replace(tmp.path().to_text(), "TMP"))
    let after = process::run(nikaia, ["run", f"{tmp.path().to_text()}/main.nika"])
    println(f"same output: {after.stdout == before.stdout}")
    print(after.stdout)
}
