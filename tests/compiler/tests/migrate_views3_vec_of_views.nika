// ADR-views-v4 D4, D5, D15, #1254: `nikaia migrate views-3` writes
// `Vec[ref String]` as `Vec[String]`. The migrated file runs: a field and a
// local filled from a parameter's `split` and `lines`, and from a `comptime`.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    fs::write("a.nika", tmp, "comptime SEP: ref String = \"-\"\n\nstruct Parts {\n    all: Vec[ref String],\n}\n\nfn words(s: ref String) -> Parts {\n    let mut all: Vec[ref String] = []\n    for w in s.split(\" \") {\n        all.push(w)\n    }\n    return Parts { all: all }\n}\n\nfn rows(s: ref String) -> Vec[ref String] {\n    let mut out: Vec[ref String] = []\n    for line in s.lines() {\n        out.push(line)\n    }\n    return out\n}\n\nstruct Marks {\n    all: Vec[ref String],\n}\n\nfn marks() -> Marks {\n    return Marks { all: [SEP, SEP] }\n}\n\nfn main() throws {\n    let text: String = \"a b c\"\n    println(words(text).all.len())\n    let block: String = \"x\\ny\"\n    println(rows(block).join(\",\"))\n    println(marks().all.join(\"\"))\n    let seps: Vec[ref String] = [SEP]\n    println(seps.len())\n}\n")
    let out = process::run(nikaia, ["migrate", "views-3", f"{tmp.path().to_text()}/a.nika"])
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    print(fs::read_to_string("a.nika", tmp))
    let ran = process::run(nikaia, ["run", f"{tmp.path().to_text()}/a.nika"])
    print(f"run:\n{ran.stdout}{ran.stderr}".replace(tmp.path().to_text(), "TMP"))
}
