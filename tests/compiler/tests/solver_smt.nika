// The CDCL(T) engine (ADR-270 D12, #1283 item A): the clauses of `sv_cnf`
// searched by the SAT core of `sv_sat`, a theory deciding the atoms through
// the interface, one search over the simplex, over Fourier-Motzkin with the
// equality elimination, and over both. Each line is the runner's: a *proved*
// is a log `sv_check` replayed, a *refuted* a model evaluated against the
// query, then the theory checks the search ran. `bits-20` holds twenty
// two-way disjunctions, 2^20 cases for an enumeration (its budget is 1024),
// proved by the search with learned clauses; `threes-10` is proved by the
// congruence its disjunctions give (`x ≡ 0 (mod 3)`) before the search where
// Fourier-Motzkin's elimination sees it, over the simplex alone by the GCD
// test of a tableau row (#1284); `branch-depth` is an equality without a unit coefficient that the
// elimination extended for ever before it preferred the unit coefficient of
// the extension. Under each line the search's counters over both, as
// `scripts/solver.nika run --stats` prints them (#1312 item 2). The logic
// layer's files, `solver/sv_*.nika` and the driver below make one program, as
// `scripts/solver.nika` makes it.
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver, run after the solver's files.
fn driver() -> String {
	return "// Each file answered over each theory, as `scripts/solver.nika` answers it.
fn each(path: String) throws {
	let name = path.split(\"/\").last() ?? path
	let source = fs::read_to_string(path.clone(), fs::Root::Anywhere)
	let simplex = sv_line(source, \"new-simplex\")
	let fm = sv_line(source, \"new-fm\")
	let both = sv_line(source, \"new\")
	println(f\"{name}: simplex {simplex}; fm {fm}; both {both}\")
	// The search's counters, as `--stats` prints them (#1312 item 2).
	for line in sv_line_stats(source, \"new\", true).lines() {
		if line.starts_with(\"stats:\") {
			println(f\"  {line}\")
		}
	}
}

fn main() throws {
	let mut args: Vec[String] = []
	for a in cli::args() {
		args.push(a)
	}
	for i in 1..<args.len() {
		each(args[i].clone())
	}
}
"
}

// `n` values `xᵢ ∈ {0, k}` whose sum is `total`, of status `status`, and
// `extra` assertions.
fn family(n: i64, k: i64, total: i64, status: String, extra: String) -> String {
	let mut text = f"(set-logic QF_LIA)\n(set-info :status {status})\n"
	let mut terms = ""
	for i in 1..<n + 1 {
		text = text + f"(declare-const x{i} Int)\n"
		terms = terms + f" x{i}"
	}
	for i in 1..<n + 1 {
		text = text + f"(assert (or (= x{i} 0) (= x{i} {k})))\n"
	}
	return text + extra + f"(assert (= (+{terms}) {total}))\n(check-sat)\n"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_walk", "sv_strategy", "sv_smt", "sv_smtlib", "sv_rod"] {
		paths.push(f"{repo}/crates/nikaia-std/src/solver/{name}.nika")
	}
	let mut uses: Vec[String] = []
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver())
	let files = [
		("bits-20", family(20, 1, 21, "unsat", "")),
		(
			"bits-sat",
			family(12, 1, 5, "sat", "(assert (<= (+ x1 x2 x3) 1))\n(assert (>= (+ x4 x5) 2))\n"),
		),
		("threes-10", family(10, 3, 16, "unsat", "")),
		(
			"branch-depth",
			"(set-logic QF_LIA)\n(set-info :status sat)\n(declare-fun x () Int)\n(declare-fun x6 () Int)\n(declare-fun x4 () Int)\n(assert (and (= 0 (+ x6 1 (* 2 x4))) (= 0 (+ (* x 51725) (* x6 241)))))\n(check-sat)\n",
		),
		(
			"bounds",
			"(set-logic QF_LIA)\n(set-info :status unsat)\n(declare-const x Int)\n(declare-const y Int)\n(assert (or (< x 0) (> x 10)))\n(assert (<= 0 x 10))\n(assert (= y (+ x 1)))\n(check-sat)\n",
		),
	]
	let mut args: Vec[String] = ["run", "main.nika", "--"]
	for (name, text) in files {
		fs::write(f"{tmp}/{name}.smt2", fs::Root::Anywhere, text)
		args.push(f"{tmp}/{name}.smt2")
	}
	let out = process::run(nikaia, args; dir: tmp.clone())
	println(out.stdout.trim())
	if out.stdout.trim().len() == 0 {
		println(out.stderr.trim())
	}
	process::run("rm", ["-rf", tmp])
}
