// The blocking fallback is a real path, not a hypothetical (ADR-303 D3): a
// runtime config named by `NIKAIA_RUNTIME_CONFIG` that pins
// `io-method = "blocking"` (ADR-303 D5) reads a file through the I/O workers
// and answers the same bytes as `auto`, which takes the completion ring where
// the machine has one. The child reads a file of 10000 lines and prints its
// length and its line count, once under each mechanism. Moved from the
// `nikaia-std` unit test
// `the_blocking_fallback_reads_what_the_completion_path_reads` (#2210).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn main() throws {
	let tmp = fs::scratch()
	fs::write("cities.txt", tmp, "Hamburg;12.0\n".repeat(10000))
	fs::write(
		"child.nika",
		tmp,
		"use std::fs\n\nfn main() throws {\n\tlet bytes = fs::read(\"cities.txt\", fs::Root::Anywhere)\n\tlet size = bytes.len()\n\tlet count = bytes.text().lines().count()\n\tprintln(f\"{size} bytes, {count} lines\")\n}\n",
	)
	let mut answers: Vec[String] = []
	for method in ["auto", "blocking"] {
		fs::write("runtime.toml", tmp, f"io-method = \"{method}\"\n")
		let out = process::run(
			toolchain(),
			["run", "child.nika"]; dir: tmp.path().to_text(), env: [("NIKAIA_RUNTIME_CONFIG", f"{tmp.path().to_text()}/runtime.toml")],
		)
		let answer = out.stdout.trim().clone()
		println(f"{method}: {answer}")
		answers.push(answer)
	}
	println(f"the same: {answers[0] == answers[1]}")
}
