// #1422: an error that leaves `main` through a sum of error types (ADR-280
// D15) is printed in its member's long form, the message and its site,
// without the sum's variant around it (Part I 7.1).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/app/src"])
    fs::write("app/nikaia.toml", tmp, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    fs::write("app/src/main.nika", tmp, "struct Fault {\n\tline: i64,\n}\n\nimpl Error for Fault {\n\tfn message(ref self) -> String {\n\t\treturn f\"fault at line {self.line}\"\n\t}\n}\n\nstruct Other {}\n\nimpl Error for Other {\n\tfn message(ref self) -> String {\n\t\treturn \"other\"\n\t}\n}\n\nfn step(x: i64) throws {\n\tif x == 1 {\n\t\tthrow Fault { line: 7 }\n\t}\n\tif x == 2 {\n\t\tthrow Other {}\n\t}\n}\n\nfn main() throws {\n\tstep(1)\n}\n")
    let out = process::run(toolchain(), ["run"]; dir: f"{tmp.path().to_text()}/app")
    let mut shown: Vec[String] = []
    for line in f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP").lines() {
        if !line.trim().starts_with("Compiling") {
            shown.push(line.clone())
        }
    }
    println(shown.join("\n"))
    println(f"exit {out.code}")
}
