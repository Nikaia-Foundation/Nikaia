// A `let` over a part of a parameter this function owns, then pushed: a move, not a loan (#665).
struct P { items: Vec[i64] }
fn back(p: P) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = []
    let k = p.items
    out.push(k)
    return out
}
fn main() {
    let v = back(P { items: [1, 2, 3] })
    print(v.len())
}
