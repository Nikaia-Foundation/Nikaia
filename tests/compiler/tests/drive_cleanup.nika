// scripts/drive.nika --cleanup (#1521): in a scratch directory, the cleanup
// removes target/debug (not while a cargo builds into it) and
// target/nikaia-example-tests and, in the temp
// directory, the sandbox of a `nikaia test` run whose process is gone, and
// keeps one of a live process (pid 1) and what is not a sandbox. The free
// figure is faked, so the CLEANUP line reads the same on every machine; with
// it faked low, a dry run shows the cleanup and the stop before an agent.
// `--cleanup DIR` (#2459) in a git repository: of target/bins/<sha>, HEAD's,
// the 2 newest of its history and one a running process names stay; of DIR's
// briefs, those of a closed issue go with their run files and claude session
// dir, unless their debrief is not reviewed yet; an open issue's and an
// unposted brief stay.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// An ESCALATE line ends with the commit of the drive.nika that ran (#1801),
// which changes with each commit: it is printed as SHA.
fn unsha(text: String) -> String throws {
    let mut lines: Vec[String] = []
    for line in text.split("\n") {
        let mut first = true
        for part in line.split(" (drive.nika ") {
            if first { if part.len() < line.len() { lines.push(part + " (drive.nika SHA)") } else { lines.push(part.clone()) } }
            first = false
        }
    }
    return lines.join("\n")
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    let paths = ["target/debug", "target/nikaia-example-tests", "tmp/nikaia-test-999999999-0", "tmp/nikaia-test-1-0", "tmp/other"]
    for path in paths { process::run("mkdir", ["-p", f"{tmp.path().to_text()}/{path}/inner"]) }
    let env: Vec[(String, String)] = [("TMPDIR", f"{tmp.path().to_text()}/tmp"), ("HOME", tmp.path().to_text()), ("NIKAIA_DRIVE_FREE_MB", "9000")]
    let out = process::run(nikaia, ["run", f"{repo}/scripts/drive.nika", "--", "--cleanup"]; dir: tmp.path().to_text(), env: env.clone())
    println(f"exit {out.code}")
    println(out.stdout.trim())
    for path in paths {
        let there = fs::exists(f"{path}", tmp)
        println(f"{path}: {there}")
    }
    // A cargo started in the directory without another profile (a builder's
    // clippy) builds into target/debug: the cleanup keeps it (#1800).
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/target/debug/inner", f"{tmp.path().to_text()}/bin"])
    fs::write("bin/cargo", tmp, "#!/bin/sh\nsleep 60\n")
    process::run("chmod", ["+x", f"{tmp.path().to_text()}/bin/cargo"])
    let pid = process::run("sh", ["-c", "./bin/cargo clippy --all-targets >/dev/null 2>&1 & echo $!"]; dir: tmp.path().to_text()).stdout.trim().clone()
    let busy = process::run(nikaia, ["run", f"{repo}/scripts/drive.nika", "--", "--cleanup"]; dir: tmp.path().to_text(), env: env)
    process::run("kill", [pid])
    println(busy.stdout.trim())
    let kept = fs::exists("target/debug", tmp)
    println(f"target/debug with a cargo running: {kept}")
    // Before an agent (a dry run of a NEXT line): under 6 GB free the cleanup
    // runs at once; still under 3 GB after it, the driver escalates.
    fs::write("b1.md", tmp, "x\n")
    fs::write("lines", tmp, f"CI aaaa1111 green\nNEXT {tmp.path().to_text()}/b1.md builder sonnet 80 12\n")
    for free in ["5000", "2000"] {
        let faked: Vec[(String, String)] = [("HOME", tmp.path().to_text()), ("NIKAIA_DRIVE_FREE_MB", free.clone())]
        let dry = process::run(nikaia, ["run", "scripts/drive.nika", "--", tmp.path().to_text(), "--lines", f"{tmp.path().to_text()}/lines", "--dry-run"]; dir: repo.clone(), env: faked, env_remove: ["NIKAIA_SUITE_DIR"])
        println(f"== {free} MB free (exit {dry.code})")
        for line in dry.stdout.trim().split("\n") {
            if line.starts_with("DISK") || line.starts_with("ESCALATE") || line.starts_with("DRY-RUN") || line.contains("cache prune") { println(unsha(line.clone()).replace(tmp.path().to_text(), "T").replace("target/release/nikaia", "target/fast/nikaia")) }
        }
    }
    // The old variants in a deps directory (#2318): a name's files of an
    // older hash go when over 3 h old; the newest hash stays at any age, a
    // recent older hash stays, and a file without a hash stays.
    let deps = tmp.join("deps")
    process::run("mkdir", ["-p", deps.path().to_text()])
    let files = [
        ("nikaia-0000000000000001", "-5 hours"), ("nikaia-0000000000000001.d", "-5 hours"),
        ("nikaia-0000000000000002", "-4 hours"), ("nikaia-00000000000000a3", "-1 hours"),
        ("libfoo-00000000000000b1.rlib", "-9 hours"), ("libfoo-00000000000000b2.rlib", "-8 hours"),
        ("libfoo-00000000000000b2.rmeta", "-8 hours"), ("libbar-00000000000000c1.rlib", "-9 hours"),
        ("plain", "-9 hours"),
    ]
    for (name, age) in files { process::run("touch", ["-d", f"{age}", f"{deps.path().to_text()}/{name}"]) }
    let git = tmp.join("git")
    let g = git.path().to_text()
    process::run("mkdir", ["-p", g.clone()])
    process::run("sh", ["-c", "git init -q . && git config user.email t@t && git config user.name t && for i in 1 2 3 4 5; do git commit -q --allow-empty -m c$i; done"]; dir: g.clone())
    let shas: Vec[String] = process::run("git", ["log", "--format=%h", "--abbrev=12"]; dir: g.clone()).stdout.trim().split("\n").collect()
    for sha in shas { process::run("mkdir", ["-p", f"{g}/target/bins/{sha}"]) }
    process::run("mkdir", ["-p", f"{g}/target/bins/0123456789ab"])
    let user = process::run("sh", ["-c", f"sh -c 'sleep 60; :' {g}/target/bins/{shas[4]}/nikaia >/dev/null 2>&1 & echo $!"]).stdout.trim().clone()
    process::run("mkdir", ["-p", f"{g}/gh", f"{g}/docs/briefs/lane", f"{g}/tmp"])
    fs::write("gh/gh", git, "#!/bin/sh\ncase \"$2\" in */issues/1|*/issues/4) echo closed;; *) echo open;; esac\n")
    process::run("chmod", ["+x", f"{g}/gh/gh"])
    fs::write("docs/briefs/facts-reviewed.txt", git, "docs/briefs/lane/issue-1.debrief.md")
    let base = process::run("sh", ["-c", f"echo \"tmp/claude-$(id -u)/$(cd {g} && pwd -P | sed 's/[^a-zA-Z0-9]/-/g')\""]).stdout.trim().clone()
    let lane_files = [
        "issue-1.md", "issue-1.md.posted", "issue-1.md.run.json", "issue-1.md.report.md", "issue-1.md.run2.report.md", "issue-1.debrief.md",
        "issue-2.md", "issue-2.md.posted", "issue-3.md", "issue-4.md", "issue-4.md.posted", "issue-4.debrief.md", "cost.txt",
    ]
    for name in lane_files { fs::write(f"docs/briefs/lane/{name}", git, "x\n") }
    fs::write("docs/briefs/lane/issue-1.md.run.json", git, "{\"session_id\":\"ab-12\",\"x\":1}\n")
    process::run("mkdir", ["-p", f"{g}/{base}/ab-12", f"{g}/{base}/cd-34"])
    let path = env::var("PATH") ?? "/usr/local/bin:/usr/bin:/bin"
    let genv: Vec[(String, String)] = [("TMPDIR", f"{g}/tmp"), ("HOME", g.clone()), ("NIKAIA_DRIVE_FREE_MB", "9000"), ("PATH", f"{g}/gh:{path}")]
    let lane = process::run(nikaia.clone(), ["run", f"{repo}/scripts/drive.nika", "--", "--cleanup", "docs/briefs/lane"]; dir: g.clone(), env: genv)
    process::run("kill", [user])
    println(lane.stdout.trim().split("\n").collect()[0])
    for i in 0..<shas.len() { println(f"bins of HEAD~{i}: {fs::exists(f"target/bins/{shas[i]}", git)}") }
    println(f"bins of another commit: {fs::exists("target/bins/0123456789ab", git)}")
    for name in lane_files { println(f"{name}: {fs::exists(f"docs/briefs/lane/{name}", git)}") }
    println(f"session of issue 1: {fs::exists(f"{base}/ab-12", git)}, another: {fs::exists(f"{base}/cd-34", git)}")
    let old = process::run(nikaia, ["run", f"{repo}/scripts/drive.nika", "--", "--old-deps", deps.path().to_text(), f"{tmp.path().to_text()}/missing"]; dir: tmp.path().to_text())
    println(old.stdout.trim())
    for (name, _age) in files { println(f"{name}: {fs::exists(f"{name}", deps)}") }
}
