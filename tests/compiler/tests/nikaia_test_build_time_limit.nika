// #1774: `nikaia test` ends a test program's build that runs past its time
// limit (`NIKAIA_TEST_BUILD_TIME_LIMIT` seconds), with every process it
// started, and fails the program with its name and `build timed out after
// N s`, as #1672 does for a run. `builds_long`'s `comptime` spins until its
// step budget ends, over a minute of build on any machine: without the limit
// the program fails on that refusal instead, a minute later.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp}/src", f"{tmp}/tests"])
    fs::write(f"{tmp}/nikaia.toml", fs::Root::Anywhere, "[package]\nname = \"building\"\nversion = \"0.1.0\"\n")
    fs::write(f"{tmp}/src/main.nika", fs::Root::Anywhere, "fn main() {}\n")
    fs::write(f"{tmp}/tests/builds_long.nika", fs::Root::Anywhere, "fn spin() -> i64 {\n    let mut n: i64 = 0\n    while true {\n        n = n + 1\n    }\n    return n\n}\n\ncomptime X: i64 = spin()\n\nfn main() throws {\n    println(f\"{X}\")\n}\n")
    let out = process::run(nikaia, ["test"]; dir: tmp.clone(), env: [("NIKAIA_TEST_BUILD_TIME_LIMIT", "2")])
    println(f"exit {out.code}")
    for line in f"{out.stdout}{out.stderr}".lines() {
        if line.starts_with("program ") || line.starts_with("--- ") || line.starts_with("build timed out") || line.starts_with("test result") {
            println(line)
        }
    }
    process::run("rm", ["-rf", tmp])
}
