// #1774: `nikaia test` ends a test program's build that runs past its time
// limit (`NIKAIA_TEST_BUILD_TIME_LIMIT` seconds), with every process it
// started, and fails the program with its name and `build timed out after
// N s`, as #1672 does for a run. `builds_long`'s `comptime` spins until its
// step budget ends, over a minute of build on any machine: without the limit
// the program fails on that refusal instead, a minute later. #1775: the
// failure names the switch and the likely cause, a Cargo lock, and with no
// `NIKAIA_TEST_BUILD_TIME_LIMIT` (empty is none) the limit is ten times
// `NIKAIA_TEST_TIME_LIMIT`.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn shown(code: i64, said: String) throws {
    println(f"exit {code}")
    for line in said.lines() {
        if line.starts_with("program ") || line.starts_with("--- ") || line.starts_with("build timed out") || line.starts_with("hint: ") || line.starts_with("test result") {
            println(line)
        }
    }
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/src", f"{tmp.path().to_text()}/tests"])
    fs::write("nikaia.toml", tmp, "[package]\nname = \"building\"\nversion = \"0.1.0\"\n")
    fs::write("src/main.nika", tmp, "fn main() {}\n")
    fs::write("tests/builds_long.nika", tmp, "fn spin() -> i64 {\n    let mut n: i64 = 0\n    while true {\n        n = n + 1\n    }\n    return n\n}\n\ncomptime X: i64 = spin()\n\nfn main() throws {\n    println(f\"{X}\")\n}\n")
    let given = process::run(nikaia, ["test"]; dir: tmp.path().to_text(), env: [("NIKAIA_TEST_BUILD_TIME_LIMIT", "2")])
    shown(given.code, f"{given.stdout}{given.stderr}")
    let derived = process::run(nikaia, ["test"]; dir: tmp.path().to_text(), env: [("NIKAIA_TEST_BUILD_TIME_LIMIT", ""), ("NIKAIA_TEST_TIME_LIMIT", "1")])
    shown(derived.code, f"{derived.stdout}{derived.stderr}")
}
