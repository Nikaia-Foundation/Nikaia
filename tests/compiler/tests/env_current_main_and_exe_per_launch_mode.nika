// ADR-program-path-1, the table of D1 and D2 row by row: `nikaia run FILE`
// stands in as FILE, `nikaia run` in a project as its entry point, both with
// the toolchain as the program that was started; a built program is both
// itself. The child `nikaia` does not inherit this test's own file (D3).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn shown(label: String, out: String, tmp: ref fs::Root, nikaia: String) throws {
    println(f"-- {label}")
    for line in out.lines() {
        println(line.replace(tmp.path().to_text(), "TMP").replace(nikaia, "NIKAIA"))
    }
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    let resolved = process::run("readlink", ["-f", nikaia.clone()]).stdout.trim().clone()
    let probe = "use std::env\n\nfn main() throws {\n    println(f\"main: {env::current_main()?.display() ?? \"null\"}\")\n    println(f\"exe: {env::current_exe()?.display() ?? \"null\"}\")\n}\n"
    fs::write("probe.nika", tmp, probe)
    shown("nikaia run probe.nika", process::run(nikaia.clone(), ["run", "probe.nika"]; dir: tmp.path().to_text()).stdout, tmp, resolved.clone())
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/proj/src"])
    fs::write("proj/nikaia.toml", tmp, "[package]\nname = \"proj\"\nversion = \"0.1.0\"\n")
    fs::write("proj/src/main.nika", tmp, probe)
    let project = tmp.join("proj")
    shown("nikaia run in a project", process::run(nikaia.clone(), ["run"]; dir: project.path().to_text()).stdout, tmp, resolved.clone())
    process::run(nikaia.clone(), ["build"]; dir: project.path().to_text())
    shown("the built program", process::run(f"{project.path().to_text()}/target/nikaia/bin/proj", []; dir: tmp.path().to_text()).stdout, tmp, resolved.clone())
}
