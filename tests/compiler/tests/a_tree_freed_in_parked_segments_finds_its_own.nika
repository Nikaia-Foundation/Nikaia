// **A tree's boxes freed in segments beyond the current one find their own**
// (ADR-327 D15, D16, #1879): `main`'s block holds a long-lived tree over
// several segments while short-lived trees are built and freed beside it, so
// frees land in parked segments, some emptied whole and handed back. Each
// free finds its segment by its address, and every count comes out right.
enum Tree { Leaf, Node(Tree, Tree) }

fn build(depth: i64) -> Tree {
    if depth == 0 {
        return Tree::Leaf
    }
    return Tree::Node(build(depth - 1), build(depth - 1))
}

fn count(t: Tree) -> i64 {
    return match t {
        Tree::Leaf => 1,
        Tree::Node(l, r) => 1 + count(l) + count(r),
    }
}

fn main() throws {
    let long_lived = build(14)
    let mut depth = 4
    while depth <= 14 {
        let mut sum = 0
        for _ in 0..<(1 << (18 - depth)) {
            sum += count(build(depth))
        }
        println(f"depth {depth}: {sum}")
        depth += 2
    }
    println(f"long lived: {count(long_lived)}")
}
