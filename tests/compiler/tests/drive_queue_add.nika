// scripts/drive.nika --queue-add BATCH N...: the lane's ready issues
// appended to its batch as `#N` lines, each once, the ones already queued
// (as a line's first word) left out (owner, 2026-11-06).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain()
    let out = process::run(nikaia, ["run", "scripts/drive.nika", "--", "--queue-add", "1267", "1266", "1266", "1300"]; dir: repo, stdin: process::Input::Text("v43-a.md\n#1267 note\n\n"))
    println(out.stdout.trim())
}
