// One task that only lends a pending value reads it as a diamond's tasks do:
// the value lives in `a`'s block, so the view `keep` hands back of it is
// still there where `b` is read (ADR-async-v6 D8, #2596).

fn load() -> String {
    let mut g = String()
    g.push_str("hi")
    return g
}

fn keep(s: String) -> String {
    return s
}

fn main() throws {
    let a = async load()
    let b = async keep(a)
    println(b)
}
