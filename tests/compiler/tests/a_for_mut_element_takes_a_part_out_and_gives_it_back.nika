// #949, #951, ADR-views-1 per turn (ADR-views-2): `p` is a `let mut` view of
// each element in turn; `p.names` is taken out to a keeper and given back
// before the turn ends.
struct P { pub names: Vec[String], pub count: i64 }
fn keep(names: Vec[String]) -> Vec[String] sync {
    let mut out: Vec[String] = []
    for n in names.drain() { out.push(n) }
    return out
}
fn main() {
    let mut ps: Vec[P] = [P { names: [f"a{1}", f"a{2}"], count: 0 }, P { names: [f"b{1}"], count: 0 }]
    for mut p in ps {
        let old = keep(p.names)
        p.count = old.len()
        p.names = []
    }
    println(f"{ps[0].count} {ps[1].count} {ps[0].names.len()}")
}
