// The way out of NK2203 (#677): both locks taken at once with `update_all`,
// and a callee that only computes called inside a door. A call whose lock
// answer is undecided (code handed on as a parameter) is not refused either
// (Part III C.4).
fn fee(amount: i64) -> i64 sync {
    return amount / 10
}

fn apply(f: fn(i64) -> i64 sync, n: i64) -> i64 sync {
    return f(n)
}

fn main() throws {
    let a = SharedMut(100)
    let b = SharedMut(100)
    update_all(a, b) fn(mut from, mut to) {
        from -= 30 + fee(30)
        to += 30
    }
    a.update fn(mut from) { from += apply(fee, from) }
    println(f"{a.get()} {b.get()}")
}
