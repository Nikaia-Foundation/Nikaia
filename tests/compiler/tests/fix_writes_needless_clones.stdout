struct P { x: i64, y: i64 }

fn take(s: String) -> i64 {
    return s.len() as i64
}

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

fn main() throws {
    let p = P { x: 1, y: 2 }
    let q = p
    println(q.x + p.y)
    let s = make()
    println(take(s))
    let xs = [1, 2, 3]
    for x in xs {
        println(x)
    }
    println(xs.len())
    let t = make()
    println(take(t.clone()))
    println(t)
}
