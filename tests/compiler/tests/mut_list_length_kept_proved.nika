// #1375 (ADR-269 D9): a `mut` list's length is a name the prover reads where
// the body keeps it. `get` and `swapped` write `a` only through its elements,
// `swap` and `sort`, which keep the length, so `a.len()` in their
// preconditions is read, each is proved at its call, and so are the indexes.
// `mut_list_length_push_refused` holds the bodies that may change it.
fn get(mut a: Vec[i64], lo: i64, hi: i64) -> i64 {
    assert(0 <= lo)
    assert(lo <= hi)
    assert(hi < a.len())
    let mut s = a[hi]
    for j in lo..<hi {
        s = s + a[j]
    }
    return s
}

fn swapped(mut a: Vec[i64], i: i64, j: i64) -> i64 {
    assert(0 <= i)
    assert(i < a.len())
    assert(0 <= j)
    assert(j < a.len())
    let t = a[i]
    a[i] = a[j]
    a[j] = t
    a.swap(i, j)
    a.sort()
    return a[i]
}

fn main() throws {
    let mut v: Vec[i64] = [5, 3, 9]
    println(f"{get(v, 0, 2)}")
    let mut w: Vec[i64] = [5, 3, 9]
    println(f"{swapped(w, 0, 2)}")
}
