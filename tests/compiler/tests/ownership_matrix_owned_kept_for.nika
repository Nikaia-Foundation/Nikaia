// Ownership matrix (#1404): a owned value, kept, in the position `for`.
// Generated by scripts/ownership_matrix.nika: change the generator, not this file.

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

fn store(keep a: String, mut into: Vec[String]) {
    into.push(a)
}

fn main() throws {
    let s = make()
    let xs: Vec[String] = [s]
    let mut all: Vec[String] = []
    for x in xs {
        store(x, all)
    }
    println(all.len())
}
