/// A found bound on a list's values must hold at every call (ADR-306 D21,
/// #1397): the second call hands `eval` a position past the end of
/// `values`, so `values[atoms[k]]` keeps its check and only `0 <=
/// atoms[..]` is derived. `values[0]` ends the second call before it
/// reaches the position past the end.
fn eval(atoms: ref Vec[i64], values: ref Vec[bool]) -> bool {
	let mut k = 0
	while k < atoms.len() {
		if values[atoms[k]] {
			return true
		}
		k += 1
	}
	return false
}

fn main() throws {
	let atoms = [0, 2, 1]
	let values = [true, false, true]
	println(f"{eval(atoms, values)}")
	let wide = [0, 3]
	println(f"{eval(wide, values)}")
}
