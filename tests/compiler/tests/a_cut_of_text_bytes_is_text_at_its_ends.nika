// **A cut of a text's own bytes is text where its two ends are** (Part I
// 2.6, #1870): `s.bytes[a..<b].text()` checks the cut's two ends, not every
// byte, and refuses a cut that splits a scalar at either end.

fn make() -> String {
    let mut s = String()
    s.push_str("héllo wörld")
    return s
}

fn piece(s: String, a: i64, b: i64) -> String {
    return s.bytes[a..<b].text() catch { "refused" }
}

struct Holder {
    text: String,
}

fn main() throws {
    let s = make()
    println(s.bytes[0..<1].text() catch { "refused" })
    println(s.bytes[1..<3].text() catch { "refused" })
    println(s.bytes[2..<3].text() catch { "refused" })
    println(s.bytes[1..<2].text() catch { "refused" })
    println(s.bytes[0..<s.bytes.len()].text() catch { "refused" })
    println(s.bytes[4..<4].text() catch { "refused" })
    println(piece(s, 7, 13))
    println(piece(s, 7, 10))
    println(piece(s, 7, 9))
    let h = Holder { text: make() }
    println(h.text.bytes[3..<6].text() catch { "refused" })
    let mut found = 0
    for i in 0..<s.bytes.len() {
        let fragment = s.bytes[i..<i + 1].text() catch { continue }
        if fragment == "l" {
            found += 1
        }
    }
    println(found)
}
