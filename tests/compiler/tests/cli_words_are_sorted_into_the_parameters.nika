// The command line's words are sorted into `main`'s parameters (ADR-cli-v1): a
// subject by its place, an option by its name with `=` or the next word, `--`
// ends the options, a word is a value of its parameter's type in `std`'s
// number shape that fits it, and a wrong word stops the program before its
// body, with exit 2, the error, the usage line and the hint; `-h` prints the
// help, which names the precondition and the defaults. `cli::args().nth`
// takes an `i64`. Moved from the `nikaia-std` unit tests `cli::tests::*`
// (#2082).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    fs::write(
        "p.nika",
        tmp,
        "use std::cli\n\n/// Multiplies.\nfn main(a: i64, rest: Vec[String]; times: i64 = 4, be_loud: bool = false, small: u8 = 0, big: u64 = 0, rate: f64 = 0.0, maybe: i32? = null) throws {\n    assert(a > 0)\n    println(f\"a {a} times {times} loud {be_loud} rest [{rest.iter().join(\", \")}] small {small} big {big} rate {rate} maybe {maybe ?? -1}\")\n    let at: i64 = 0\n    println(f\"{cli::args().nth(at) != null} {cli::args().nth(-1) == null} {cli::args().nth(9223372036854775807) == null}\")\n}\n",
    )
    let cases = [
        "--times=3 5 --be-loud x",
        "--times 7 -- 3 --be-loud",
        "-3",
        "1 --times=-12",
        "1 --times=+12 --big=18446744073709551615 --rate=2.5 --maybe=4",
        "1 --times=-9223372036854775808",
        "",
        "--nope 1",
        "-v 1",
        "1 --times",
        "1 --times=1_2",
        "1 --small=256",
        "1 --small=-1",
        "1 --be-loud=yes",
        "1 -h",
    ]
    for case in cases {
        let out = process::run(
            "sh",
            ["-c", f"\"$0\" run --unproved-claims=warn p.nika -- {case}", toolchain()]; dir: tmp.path().to_text(),
        )
        println(f"== {case}: exit {out.code}")
        print(out.stdout)
        for line in out.stderr.lines() {
            let t = line.trim()
            if t.starts_with("Compiling") || t.starts_with("Finished") || t.starts_with("Running") {
                continue
            }
            println(line.replace(tmp.path().to_text(), "TMP"))
        }
    }
}
