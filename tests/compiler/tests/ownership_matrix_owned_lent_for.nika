// Ownership matrix (#1404): a owned value, lent, in the position `for`.
// Generated by scripts/ownership_matrix.nika: change the generator, not this file.

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

fn measure(a: String) -> i64 {
    return a.len()
}

fn main() throws {
    let s = make()
    let xs: Vec[String] = [s]
    for x in xs {
        println(measure(x))
    }
    println(s)
}
