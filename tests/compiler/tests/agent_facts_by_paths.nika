// A brief that names no `Facts:` sections gets, besides `Core`, each section of
// docs/builder-facts-lookup.md whose `Paths:` line has a fragment in the
// brief's text (or the issues inlined into its prompt), at most three, those
// with most fragments found first (scripts/agent.nika, #2002); a `Facts:` line
// wins. Run in a directory of its own with a small facts file.
use std::env
use std::fs
use std::process

// The checkout: the working directory, or (under `nikaia test`, which runs a
// test in a directory of its own) the one `nikaia` was started in.
fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

// The prompt of a dry run, without its first line (the brief's path) and
// without the options after it.
fn prompt(nikaia: String, repo: String, tmp: ref fs::Root, brief: String) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/agent.nika", "--", brief.clone(), "--dry-run"]; dir: tmp.path().to_text())
    if !out.ok { return f"code={out.code} {out.stdout.trim()}" }
    let lines = out.stdout.split("\n").collect()
    let mut kept: Vec[String] = []
    for i in 1..<lines.len() { kept.push(lines[i].clone()) }
    return kept.join("\n").split(" --agent ").collect()[0].clone()
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    process::run("mkdir", [f"{tmp.path().to_text()}/docs"])
    fs::write("docs/builder-facts.md", tmp, "# Builder facts\n\n## Core\n\n* a core fact\n\n## Traps\n\n### Lowering and lower-std\n\nPaths: `lowered/`, `lower-std`, `sysroot`\n\n* a lowering trap\n\n### Grammar\n\nPaths: `grammar`, `parser`\n\n* a grammar trap\n\n### Prover\n\nPaths: `sv_`, prover, `--bounds`\n\n* a prover trap\n\n### Scripts\n\nPaths: `scripts/`\n\n* a scripts trap\n\n### Probes\n\n* a probe trap, no paths\n")
    // An issue's files name a lowered file: the Lowering section, beside Core.
    fs::write("lowered.md", tmp, "Brief.\n\n## Files and limits\n\n`crates/nikaia-std/src/compiler/lowered/emit_item.rs`\n")
    // A `Facts:` line wins over the paths.
    fs::write("named.md", tmp, "Facts: Grammar\nTouches crates/nikaia-std/src/compiler/lowered/x.rs\n")
    // Four sections match: three, the one with most fragments found first.
    fs::write("many.md", tmp, "Brief: scripts/x.nika, the Parser's grammar block, lowered/a.rs, sv_cut.nika.\n")
    // Nothing matches: Core alone.
    fs::write("none.md", tmp, "Brief about the website.\n")
    for brief in ["lowered.md", "named.md", "many.md", "none.md"] {
        println(f"== {brief}")
        println(prompt(nikaia.clone(), repo.clone(), tmp, brief))
    }
}
