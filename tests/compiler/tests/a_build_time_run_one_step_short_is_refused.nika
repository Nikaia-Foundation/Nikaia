// The same run as `a_build_time_run_takes_exactly_its_counted_steps`, which
// takes six steps (ADR-321 D7), with a budget one less: refused.
fn spin(n: int) -> int {
    let mut total = 0
    for i in 0..n { total += i }
    total
}

comptime(steps: 5) TOTAL = spin(3)

fn main() throws {
    println(TOTAL)
}
