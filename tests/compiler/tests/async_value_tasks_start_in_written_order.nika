// Tasks as arguments, operands and tuple parts start left to right, as written,
// and the callee or the operator gets plain values (ADR-async-5 D6, #988).

fn load(n: i64) -> i64 {
	println(f"task {n}")
	return n * 2
}

fn add(x: i64, y: i64) -> i64 {
	return x + y
}

fn main() {
	let s = add(async load(1), async load(2))
	let t = async load(3) + async load(4)
	let (c, d) = (async load(5), async load(6))
	println(f"{s} {t} {c} {d}")
}
