// **What a callee is found to return bounds a read in its caller** (ADR-306
// D23, #1414): a position below a list parameter's length, found at every
// return of the callee, holds of the call's result where that list's length
// has not changed since; a recursive `find` takes it as assumed, then
// proved. Each element of a list of positions a callee returns too (D24).
// A result read after the list shrank, and one of a callee whose return is
// not below, keep their checks.

pub fn find(parent: ref Vec[i64], x: i64) -> i64 sync {
	let up = parent[x]
	if up == x {
		return x
	}
	return find(parent, up)
}

pub fn same(parent: ref Vec[i64], a: i64, b: i64) -> bool sync {
	let ra = find(parent, a)
	let rb = find(parent, b)
	return parent[ra] == parent[rb]
}

pub fn positions(xs: ref Vec[i64], wanted: i64) -> Vec[i64] sync {
	let mut out: Vec[i64] = []
	for k in 0..<xs.len() {
		if xs[k] == wanted {
			out.push(k)
		}
	}
	return out
}

pub fn sum_at(xs: ref Vec[i64], wanted: i64) -> i64 sync {
	let mut sum = 0
	for k in positions(xs, wanted) {
		sum += xs[k]
	}
	let held = positions(xs, wanted)
	for k in held {
		sum += xs[k]
	}
	return sum
}

pub fn after_clear(mut parent: Vec[i64], a: i64) -> i64 sync {
	let r = find(parent, a)
	parent.truncate(1)
	return parent[r]
}

pub fn length_of(xs: ref Vec[i64]) -> i64 sync {
	return xs.len()
}

pub fn past_the_end(xs: ref Vec[i64]) -> i64 sync {
	let r = length_of(xs)
	return xs[r - 1]
}

fn main() throws {
	let parent = [0, 0, 1, 3, 3]
	println(f"{same(parent, 2, 1)} {same(parent, 2, 4)}")
	let xs = [2, 5, 2, 7, 2]
	println(f"{sum_at(xs, 2)} {after_clear(parent.clone(), 0)} {past_the_end(xs)}")
}
