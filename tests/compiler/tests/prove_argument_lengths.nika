// A length the prover reads where a list or `Bytes` is passed (#1084): a
// bound repeat (`let` as well as `let mut`, #782), a repeat or a literal
// passed as the argument itself, and `Bytes(x)`, which has `x`'s length (as
// `find_all` keeps the length of what it searches, ADR-375 D5). Every call
// proves its precondition; the refused cases are
// `prove_argument_lengths_refused`.

fn g(xs: ref Vec[u8]) -> i64 {
	assert(xs.len() >= 40)
	return xs.len()
}

fn h(b: ref Bytes) -> i64 {
	assert(b.len() >= 4)
	return b.len()
}

fn main() {
	let v: Vec[u8] = [59; 40]
	println(f"{g(v)}")
	let mut m: Vec[u8] = [59; 40]
	println(f"{g(m)}")
	println(f"{g([59; 40])}")
	let w: Vec[u8] = [1, 2, 3, 4]
	println(f"{h(Bytes(w))}")
	println(f"{h(Bytes([5; 4]))}")
	let b = Bytes([1, 2, 3, 4, 5])
	println(f"{h(b)}")
	let u: Vec[u8] = [1, 2, 3, 4, 5, 6]
	let mut c = Bytes(u)
	println(f"{h(c)}")
}
