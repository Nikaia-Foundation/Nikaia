/// One caller hands `pick` an `at` past the list's end (ADR-391 D3): no
/// claim holds at every call, so `arms[before]` keeps its check, and the
/// reason names the callers rather than the loop's counter. The call past
/// the end stands under a guard the walk cannot decide, which `is_empty`
/// of the list it just filled no longer is (#2629).
use std::text

fn pick(arms: ref Vec[i64], at: i64) -> i64 {
	let mut before = 0
	let mut sum = 0
	while before < at {
		sum = arms[before]
		before += 1
	}
	return sum
}

fn main() throws {
	let mut xs: Vec[i64] = []
	for k in 1..<4 {
		xs.push(k)
	}
	println(f"{pick(xs, xs.len())}")
	if (text::parse_i64("none") ?? 0) > 0 {
		println(f"{pick(xs, xs.len() + 1)}")
	}
}
