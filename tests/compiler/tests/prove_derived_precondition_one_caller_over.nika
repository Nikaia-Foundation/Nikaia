/// One caller hands `pick` an `at` past the list's end (ADR-391 D3): no
/// claim holds at every call, so `arms[before]` keeps its check, and the
/// reason names the callers rather than the loop's counter.
fn pick(arms: ref Vec[i64], at: i64) -> i64 {
	let mut before = 0
	let mut sum = 0
	while before < at {
		sum = arms[before]
		before += 1
	}
	return sum
}

fn main() throws {
	let mut xs: Vec[i64] = []
	for k in 1..3 {
		xs.push(k)
	}
	println(f"{pick(xs, xs.len())}")
	if xs.is_empty() {
		println(f"{pick(xs, xs.len() + 1)}")
	}
}
