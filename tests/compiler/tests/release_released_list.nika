// release.nika (#1111): a lane without `released.txt` stops the release with
// `STOP DIR/released.txt missing`, never a guess from file times; the
// architect's and QA's reports are not read as builder reports; `cycle.nika`
// writes an empty `released.txt` on a lane's first run (no report yet) and
// leaves it missing once reports exist.
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

// The STOP lines of a dry run, with the temp dir as `T`. The dry run runs in
// the lane and names it `.`: `release.nika` cuts a line at 160 bytes, and a CI
// scratch path is long enough to cut the line before the replacement.
fn stops(nikaia: String, repo: String, dir: String) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/release.nika", "--", "--dry-run", "."]; dir: dir)
    let mut shown: String = ""
    for line in out.stdout.split("\n") {
        if line.starts_with("STOP") || line.starts_with("SKIPPED") { shown = shown + line.replace("STOP ./", "STOP T/") + "\n" }
    }
    return shown
}

fn write(lane: ref fs::Root, name: String, text: String) throws {
    fs::write(name, lane, text)
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    // The scripts run in their lane's directory, which lies below the
    // working directory; they find the toolchain and scripts under the
    // checkout's names.
    process::run("ln", ["-s", f"{repo}/target", f"{tmp.path().to_text()}/target"])
    process::run("ln", ["-s", f"{repo}/scripts", f"{tmp.path().to_text()}/scripts"])
    let lane = tmp.join("lane")
    process::run("mkdir", ["-p", lane.path().to_text()])
    write(lane, "issue-1.md.report.md", "Result: partial\nPushed: none\nChangelog: none\n")
    write(lane, "architect-task.md.report.md", "Result: done\nPushed: none\nDeviation: none\n")
    write(lane, "qa-task.md.report.md", "Result: done\nPushed: none\nDeviation: none\n")
    println("without released.txt:")
    print(stops(nikaia.clone(), repo.clone(), lane.path().to_text()))
    write(lane, "released.txt", "")
    println("with an empty released.txt:")
    print(stops(nikaia.clone(), repo.clone(), lane.path().to_text()))
    write(lane, "released.txt", "issue-1.md.report.md\n")
    println("with the report released:")
    print(stops(nikaia.clone(), repo.clone(), lane.path().to_text()))
    let first = tmp.join("first")
    process::run("mkdir", ["-p", first.path().to_text()])
    process::run(nikaia.clone(), ["run", f"{repo}/scripts/cycle.nika", "--", "first"]; dir: tmp.path().to_text())
    println(f"cycle, lane without reports: released.txt {fs::exists("released.txt", first)}")
    process::run("rm", ["-f", f"{lane.path().to_text()}/released.txt"])
    process::run(nikaia, ["run", f"{repo}/scripts/cycle.nika", "--", "lane"]; dir: tmp.path().to_text())
    println(f"cycle, lane with reports: released.txt {fs::exists("released.txt", lane)}")
}
