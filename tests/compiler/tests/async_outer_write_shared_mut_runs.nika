// A task that changes a `SharedMut` through `update` runs (ADR-async-5 D7, #1229);
// the read follows the group, since a `get` beside the task's `update` meets it
// on the lock (Part II 12.2, #985).
fn main() throws {
	let total = SharedMut(0)
	async {
		async fn { total.update fn(mut v) { v += 1 } }
		println("working")
	}
	println(f"{total.get()}")
}
