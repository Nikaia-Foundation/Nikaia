// #1576: a guard whose condition has a part the walk cannot read keeps the
// parts it can, and reads `xs.is_empty()` as `xs.len() == 0`. After
// `if !wanted(key) || xs.len() == 0 || xs.len() > 100 { return }` the
// length is between 1 and 100 whatever `wanted` says, so `scalar::from`'s
// precondition holds at the call; the same after `if xs.is_empty() ...`.
// Before, both guards gave no fact and both calls were refused (NK1300).

fn wanted(key: ref str) -> bool {
	return key.starts_with("x")
}

fn g(key: ref str, xs: ref Vec[i64]) -> i64 {
	if !wanted(key) || xs.len() == 0 || xs.len() > 100 {
		return -1
	}
	return scalar::from(xs.len() as i64 + 64) as i64
}

fn h(xs: ref Vec[i64]) -> i64 {
	if xs.is_empty() || xs.len() > 100 {
		return -1
	}
	return scalar::from(xs.len() as i64 + 64) as i64
}

fn main() throws {
	println(f"{g("x", [1, 2])} {g("y", [1, 2])} {h([])} {h([7])}")
}
