/// **A parameter no precondition bounds names the gate** (ADR-391 D1,
/// #1863): of a `pub` function, of one named as a value and of one no
/// body of the file calls, each `--bounds` reason says which.
pub fn first(xs: Vec[i64], at: i64) -> i64 {
	return xs[at]
}

fn second(xs: Vec[i64], at: i64) -> i64 {
	return xs[at]
}

fn unused(xs: Vec[i64], at: i64) -> i64 {
	return xs[at]
}

fn main() throws {
	let xs = [1, 2, 3]
	let f = second
	println(f"{first(xs, 0)} {f(xs, 1)}")
}
