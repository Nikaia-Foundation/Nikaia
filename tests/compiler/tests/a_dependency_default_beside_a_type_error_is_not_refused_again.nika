// #1530: a type error in a dependency package also drew NK1127 "this
// compiler's fault" at each `time::Duration = 10.seconds()` option default
// of that package, built from its consumer; one file alone did not show it.
// One mistake, one error: only the type error is said.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/lib/src", f"{tmp.path().to_text()}/app/src"])
    fs::write("lib/nikaia.toml", tmp, "[package]\nname = \"lib\"\nversion = \"0.1.0\"\n\n[build]\nartifact = \"rust-library\"\n")
    fs::write("lib/src/main.nika", tmp, "use std::time\n\npub fn wait(n: i64; head: time::Duration = 10.seconds(), idle: time::Duration = 75.seconds()) -> i64 {\n\treturn n + 1\n}\n\nfn broken() -> i64 {\n\tlet b = Bytes()\n\treturn 1\n}\n")
    fs::write("app/nikaia.toml", tmp, "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nlib = { path = \"../lib\" }\n")
    fs::write("app/src/main.nika", tmp, "use lib\n\nfn main() throws {\n\tprintln(lib::wait(1))\n}\n")
    let out = process::run(toolchain(), ["build"]; dir: f"{tmp.path().to_text()}/app")
    for line in f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP").lines() {
        if line.contains("NK") || line.contains("type error") {
            println(line)
        }
    }
    println(f"exit {out.code}")
}
