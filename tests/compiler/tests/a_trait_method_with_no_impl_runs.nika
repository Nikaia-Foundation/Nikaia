// #1012, ADR-277 D17: a trait method with no default body and no impl in its
// package runs its callback, so a generic caller lends it a borrowing lambda.
use std::collections
trait H {
    fn ask(ref self, known: fn(ref String) -> i64? sync) -> i64? sync
}
fn look[T: H](host: ref T, names: ref collections::BTreeMap[String, i64]) -> i64 {
    return host.ask(fn(n) { names.get(n) }) ?? 0
}
fn main() {
    let mut names: collections::BTreeMap[String, i64] = collections::BTreeMap()
    names.insert("a", 4)
    println(names.len())
}
