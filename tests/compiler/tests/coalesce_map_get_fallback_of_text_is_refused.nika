// `a ?? m.get(k)` with an owned `a: String?` keeps text of its own beside a
// view of what the map keeps: refused with the copy to write (#995, ADR-293
// D15, ADR-282 D7), never handed to rustc.
use std::collections

fn word(a: String?, m: collections::BTreeMap[String, String], k: String) -> String? {
    return a ?? m.get(k)
}

fn main() {
    let mut w: collections::BTreeMap[String, String] = collections::BTreeMap()
    w.insert("b", "two")
    println(word(null, w, "b") ?? "none")
}
