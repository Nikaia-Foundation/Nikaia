// A file of the tools package is keyed on what its text names of the others
// (#1909, C): their declarations, ledger rows, call graph rows and text tier
// facts, each reached by name. So a function added to `a` that no other file
// names re-lowers `a` alone, a file that starts calling it re-lowers with
// the file it calls, and a signature or ledger change of `a_one` re-lowers
// `a` and `b`, which names it, and not `c`. The cached lowering is the one a
// cold run gives.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

// Lowers the sysroot in `tmp` with `salt` and prints how many files came
// from the cache.
fn lower(nikaia: String, tmp: ref fs::Root, salt: String, what: String) throws {
    let out = process::run(nikaia, ["lower-std", "--sysroot", f"{tmp.path().to_text()}/crates"]; dir: tmp.path().to_text(), env: [("NIKAIA_CACHE_DIR", f"{tmp.path().to_text()}/cache"), ("NIKAIA_LOWER_CACHE_SALT", salt)])
    for line in out.stderr.lines() {
        if line.contains(" files from the cache") || line.contains(": unchanged") {
            let parts: Vec[String] = line.split(": ").collect()
            println(f"{what}: {parts.last() ?? ""}")
            return
        }
    }
    println(f"{what}: exit {out.code}")
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    let dir = tmp.join("crates/nikaia-std/src/compiler")
    process::run("mkdir", ["-p", dir.path().to_text()])
    fs::write("nikaia.toml", dir, "[package]\nname = \"compiler\"\nwithin = \"std\"\n")
    fs::write("a.nika", dir, "pub fn a_one() -> i64 sync {\n    return 1\n}\n")
    fs::write("b.nika", dir, "pub fn b_two() -> i64 sync {\n    return a_one() + 1\n}\n")
    fs::write("c.nika", dir, "pub fn c_ten() -> i64 sync {\n    return 10\n}\n")
    lower(nikaia, tmp, "named", "cold")
    fs::write("a.nika", dir, "pub fn a_one() -> i64 sync {\n    return 1\n}\n\npub fn a_three() -> i64 sync {\n    return 3\n}\n")
    lower(nikaia, tmp, "named", "a_three added")
    fs::write("c.nika", dir, "pub fn c_ten() -> i64 sync {\n    return a_three() + 7\n}\n")
    lower(nikaia, tmp, "named", "c calls a_three")
    fs::write("a.nika", dir, "pub fn a_one() -> i32 sync {\n    return 1\n}\n\npub fn a_three() -> i64 sync {\n    return 3\n}\n")
    lower(nikaia, tmp, "named", "a_one signature")
    fs::write("a.nika", dir, "pub fn a_one() -> i32 sync {\n    let x = 1\n    return x\n}\n\npub fn a_three() -> i64 sync {\n    return 3\n}\n")
    lower(nikaia, tmp, "named", "a_one ledger")
    let cached = process::run("sh", ["-c", f"cat {dir.path().to_text()}/lowered.rs {dir.path().to_text()}/lowered/*.rs"]).stdout.clone()
    lower(nikaia, tmp, "cold-again", "fresh salt")
    let cold = process::run("sh", ["-c", f"cat {dir.path().to_text()}/lowered.rs {dir.path().to_text()}/lowered/*.rs"]).stdout.clone()
    println(f"cached lowering is the cold one: {cached == cold}")
}
