// scripts/pre-push.nika checks what is staged, not the shared working tree
// (#1187): another agent's unstaged `tools/*.nika` move changes the
// self-hosting share, and the `version` step (`bump.py check`, which redraws
// the badges) read the working tree, so it was red for every committer. In a
// temp repository made of HEAD with this checkout's scripts, a tools file
// grows by five thousand code lines, unstaged, and an unrelated file is staged:
// every step stays green. Staged, the same growth turns `badges` and
// `version` red. It runs `pre-push -- push`, where the badges are strict (a
// builder's run only shows them; the driver redraws them).
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/pre-push.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/pre-push.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn sh(dir: String, script: String) -> String throws {
    let out = process::run("sh", ["-c", f"set -e; {script}"]; dir: dir)
    if !out.ok { println(f"setup failed: {script}\n{out.stderr}") }
    return out.stdout.trim().clone()
}

// The step lines of a strict pre-push run (`-- push`), without the output of
// a red one.
fn steps(nikaia: String, work: String) -> String throws {
    let out = process::run(nikaia, ["run", "scripts/pre-push.nika", "--", "push"]; dir: work)
    let mut lines = String()
    for line in out.stdout.lines() {
        if line.ends_with(" green") || line.ends_with(" red") {
            lines.push_str(f"  {line}\n")
        }
    }
    return f"{lines}  exit {out.code}"
}

fn main() throws {
    let tmp = process::run("sh", ["-c", "realpath $(mktemp -d)"]).stdout.trim().clone()
    let repo = root()
    let nikaia = toolchain()
    let work = f"{tmp}/work"
    let id = "git config user.email t@t; git config user.name t; git config commit.gpgsign false"
    let tool = "crates/nikaia-std/src/compiler/fmt.nika"
    // The temp repository borrows this checkout's objects and reads HEAD's
    // tree into its index; only the files the test changes are written out.
    // pre-push copies the index itself, so a checked-out tree would only be
    // written and deleted again (13 000 files, the most of this test's time).
    let objects = sh(repo.clone(), "realpath $(git rev-parse --git-path objects)")
    sh(tmp.clone(), f"git init -q -b develop work; echo {objects} > work/.git/objects/info/alternates")
    sh(work.clone(), f"git read-tree $(git -C {repo} rev-parse HEAD^{{tree}}); git checkout-index README.md {tool}; mkdir -p scripts; s=\"scripts/pre-push.nika scripts/slot.nika scripts/check-adr-refs.nika scripts/bump.py scripts/badges.py scripts/self_hosting.py\"; for f in $s; do cp {repo}/$f $f; done; {id}; git add $s; git commit -q -m base")
    sh(work.clone(), f"for i in $(seq 5000); do echo \"fn grown_$i() -> i64 {{ $i }}\"; done >> {tool}; echo note >> README.md; git add README.md")
    println("unstaged tools move, a docs file staged:")
    println(steps(nikaia.clone(), work.clone()))
    sh(work.clone(), f"git add {tool}")
    println("the tools move staged:")
    println(steps(nikaia, work))
    process::run("rm", ["-rf", tmp])
}
