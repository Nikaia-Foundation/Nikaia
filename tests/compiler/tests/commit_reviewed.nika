// scripts/commit.nika (#1918): --dry-run lists the listed sources' hunks and writes
// Reviewed:; a listed file changed after it (another agent's edit) is refused,
// and a second --dry-run lets the commit through.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn git(dir: String, args: Vec[String]) -> String throws {
    let mut all: Vec[String] = ["-c", "user.name=T", "-c", "user.email=t@example.com"]
    for a in args { all.push(a.clone()) }
    return process::run("git", all; dir: dir).stdout.trim().clone()
}

fn commit(nikaia: String, repo: String, tmp: ref fs::Root, dry: bool) -> String throws {
    let mut args: Vec[String] = ["run", f"{repo}/scripts/commit.nika", "--"]
    if dry { args.push("--dry-run") }
    args.push(f"{tmp.path().to_text()}/X.md.report.md")
    let out = process::run(nikaia, args; dir: tmp.path().to_text(), env: [("GIT_AUTHOR_NAME", "T"), ("GIT_AUTHOR_EMAIL", "t@example.com"), ("GIT_COMMITTER_NAME", "T"), ("GIT_COMMITTER_EMAIL", "t@example.com")])
    return out.stdout.trim().clone()
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    git(tmp.path().to_text(), ["init", "-q", "-b", "develop"])
    fs::write("a.txt", tmp, "one\ntwo\nthree\nfour\nfive\nsix\n")
    git(tmp.path().to_text(), ["add", "a.txt"])
    git(tmp.path().to_text(), ["commit", "-q", "-m", "base"])
    fs::write("a.txt", tmp, "ONE\ntwo\nthree\nfour\nfive\nsix\n")
    fs::write("b.txt", tmp, "new\n")
    fs::write("X.md.report.md", tmp, "Result: done\nFiles: a.txt b.txt\nCommit: a subject\nChangelog: none\nPushed: none\n")
    println("-- dry run")
    println(commit(nikaia.clone(), repo.clone(), tmp, true))
    let report = fs::read_to_string("X.md.report.md", tmp)
    println(f"report has Reviewed: {report.contains("\nReviewed: ")}")
    println("-- another agent edits a.txt")
    fs::write("a.txt", tmp, "ONE\ntwo\nthree\nfour\nfive\nSIX\n")
    println(commit(nikaia.clone(), repo.clone(), tmp, false))
    println(git(tmp.path().to_text(), ["log", "--format=%s"]))
    println("-- dry run again")
    println(commit(nikaia.clone(), repo.clone(), tmp, true))
    let short = commit(nikaia.clone(), repo.clone(), tmp, false)
    println(short.replace(git(tmp.path().to_text(), ["rev-parse", "--short=8", "HEAD"]), "SHA8"))
    println(git(tmp.path().to_text(), ["log", "--format=%s"]))
}
