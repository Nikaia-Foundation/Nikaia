// #2482, ADR-raw-sinks-1 D17 item 6: the outer build hands the wrapper the
// directory Cargo builds in as `NIKAIA_TARGET_DIR`, chosen in one place with
// the `--target-dir` it hands Cargo (ADR-platform-layer-v1 D5, D7 item 2).
// Through a Cargo that records both: the shared tree of the user's cache,
// then a build that asked for its own directory with `CARGO_TARGET_DIR`.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

/// What the shim recorded of the `build` since the last call, `tmp` written
/// as `TMP`, and the log emptied.
fn recorded(log: String, tmp: String) -> String throws {
	let said = process::run(
		"sh",
		["-c", f"grep '^build ' {log} | head -1; rm -f {log}"],
	).stdout.trim().clone()
	return said.replace(tmp, "TMP")
}

fn main() throws {
	let tmp = fs::scratch()
	let at = tmp.path().to_text()
	let nikaia = toolchain()
	let real = process::run(
		"sh",
		["-c", "echo ${CARGO:-$(command -v cargo)}"],
	).stdout.trim().clone()
	process::run("mkdir", ["-p", f"{at}/p/src", f"{at}/bin"])
	let shim = tmp.join("bin/cargo")
	fs::write("bin/cargo", tmp, SHIM)
	process::run("chmod", ["+x", shim.path().to_text()])
	let log = f"{at}/cargo.log"
	let p = tmp.join("p")
	fs::write("nikaia.toml", p, "[package]\nname = \"aimed\"\nversion = \"0.1.0\"\n")
	fs::write("src/main.nika", p, "fn main() throws {\n\tprintln(\"built\")\n}\n")
	let env = [
		("RUST_BACKTRACE", "0"),
		("CARGO_TERM_COLOR", "never"),
		("NIKAIA_CACHE_DIR", f"{at}/cache"),
		("CARGO", shim.path().to_text()),
		("REAL_CARGO", real),
		("SHIM_LOG", log.clone()),
	]

	let shared = process::run(nikaia, ["build"]; dir: p.path().to_text(), env: env.clone())
	if shared.code != 0 {
		eprintln(shared.stderr)
	}
	println(f"shared: built {shared.code}; {recorded(log, at)}")

	let mut own = env.clone()
	own.push(("CARGO_TARGET_DIR", f"{at}/own"))
	let asked = process::run(nikaia, ["build"]; dir: p.path().to_text(), env: own)
	if asked.code != 0 {
		eprintln(asked.stderr)
	}
	println(f"CARGO_TARGET_DIR: built {asked.code}; {recorded(log, at)}")
	let found = process::run("sh", ["-c", f"test -f {at}/own/CACHEDIR.TAG && echo yes || echo no"]).stdout.trim().clone()
	println(f"Cargo built in it: {found}")
	let ran = process::run(f"{at}/p/target/nikaia/bin/aimed", [])
	println(f"the program prints: {ran.stdout.trim()}")
}

// Cargo, recording for `build` the `--target-dir` it got (or `none`), the
// directory it builds in either way, and whether `NIKAIA_TARGET_DIR` is it.
comptime SHIM: ref String = "#!/bin/bash\ngot=none\nprev=\nfor a in \"$@\"; do\n  if [ \"$prev\" = --target-dir ]; then got=\"$a\"; fi\n  prev=\"$a\"\ndone\nif [ \"$got\" = none ]; then dir=\"$CARGO_TARGET_DIR\"; else dir=\"$got\"; fi\ncase \"$dir\" in \"$NIKAIA_CACHE_DIR\"/*) where=cache;; \"\") where=unset;; *) where=\"$dir\";; esac\nif [ \"$NIKAIA_TARGET_DIR\" = \"$dir\" ]; then same=yes; else same=\"no ($NIKAIA_TARGET_DIR)\"; fi\necho \"$1 --target-dir $( [ $got = none ] && echo none || echo given ), builds in $where, NIKAIA_TARGET_DIR is it: $same\" >> \"$SHIM_LOG\"\nexec \"$REAL_CARGO\" \"$@\"\n"
