// #797 (Part I 1.2, ADR-380 D1): `--unproved-claims=warn` on the command
// line wins over the manifest's `unproved-claims = "error"`: the claim it
// cannot prove is a warning, checked when the program runs, and the program
// runs.
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\"",
		],
	).stdout.trim().clone()
	if exe.len() > 0 { return exe }
	return "target/fast/nikaia"
}

fn shown(tmp: String, text: String) -> String {
	let mut lines: Vec[String] = []
	for line in text.replace(tmp, "TMP").lines() {
		let t = line.trim()
		if t.starts_with("Compiling") || t.starts_with("Finished") || t.starts_with("Running") {
			continue
		}
		lines.push(line.clone())
	}
	return lines.join("\n")
}

fn project(tmp: String, name: String, build: String, main: String) throws {
	process::run("mkdir", ["-p", f"{tmp}/{name}/src"])
	fs::write(f"{tmp}/{name}/nikaia.toml", fs::Root::Anywhere, f"[package]\nname = \"p\"\nversion = \"0.1.0\"\n{build}")
	fs::write(f"{tmp}/{name}/src/main.nika", fs::Root::Anywhere, main)
}

fn checked(tmp: String, name: String, flags: Vec[String]) throws {
	let mut args: Vec[String] = ["check", "src/main.nika"]
	args.extend(flags)
	let out = process::run(toolchain(), args; dir: f"{tmp}/{name}")
	println(f"== {name}")
	println(shown(tmp, f"{out.stdout}{out.stderr}"))
	println(f"exit {out.code}")
}

fn main() throws {
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let error = "\n[build]\nunproved-claims = \"error\"\n"
	let claim = "fn main() throws {\n\tlet x = 0.5\n\tassert(x * 2.0 == 1.0)\n\tprintln(\"ok\")\n}\n"
	project(tmp, "manifest", error, claim)
	checked(tmp, "manifest", [])
	let out = process::run(toolchain(), ["run", "--unproved-claims=warn", "src/main.nika"]; dir: f"{tmp}/manifest")
	println("== run --unproved-claims=warn")
	println(shown(tmp, f"{out.stdout}{out.stderr}"))
	println(f"exit {out.code}")
	process::run("rm", ["-rf", tmp])
}
