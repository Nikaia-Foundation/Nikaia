// A `comptime` in an unrolled turn calls a function over the turn's field
// (Part II 10.2, 10.3, #1087): the field is handed whole, and the function
// reads its name and its attributes while the program is built.

@meta::Attribute(field)
pub struct Name { value: String }

struct Contact {
	name: String,
	age: i64 = 7,
}

struct Person {
	@Name("full_name")
	name: String,
}

fn shout(s: String) -> String {
	return f"{s}!"
}

fn wire(f: meta::Field) -> String {
	return f"{f.name}"
}

fn wire_name(f: meta::Field) -> String {
	return f.attribute(Name)?.value ?? f.name
}

fn show[T: Struct]() {
	for f in T::fields {
		comptime a = f.name
		comptime b = shout(f.name)
		comptime c = wire(f)
		comptime d = wire_name(f)
		println(f"{a} {b} {c} {d}")
	}
}

fn main() {
	show[Contact]()
	show[Person]()
}
