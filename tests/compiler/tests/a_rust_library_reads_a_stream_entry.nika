// A Rust user reads a grammar's `@stream` entry from a `std::io::Read`
// (ADR-grammar-2 D7 and ADR-393 D4, amended 2026-11-08, #1442): the package
// `rust_library_stream/lines` names the entry `lines::Words::items` as the
// root of its feature `stream`, which gates `Words::items_reader` alone; the
// in-crate walk of `counted` is core. The crate `user` reads items from a
// `Cursor`, stops early, and gets the parse error last; the crate `private`
// calls the engine's `parse_items_reader`, which stays private to the
// grammar's module (#1464), and its build fails with E0603. Then the grammar
// as a root takes all its entries, and without `[features]` the crate holds
// no reader.
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The tests' cache entry cargo builds in, `<kind>/<toolchain key>` under
// target/nikaia-project-tests: stamped as `use_entry` stamps one
// (`.nikaia-used`), so `nikaia cache prune` counts it and removes it when it
// was used longest ago (#1521); cargo's lock on it keeps it while it builds.
// One per toolchain, so what an older compiler built goes as a whole.
fn cache_entry(repo: String, nikaia: String, kind: String) -> String throws {
    let key = process::run("sha256sum", [nikaia]).stdout.split(" ").collect()[0].clone()
    let entry = f"{repo}/target/nikaia-project-tests/{kind}/{key}"
    process::run("mkdir", ["-p", entry.clone()])
    fs::write(f"{entry}/.nikaia-used", fs::Root::Anywhere, "")
    return entry
}

fn shown(made: String) throws {
    let manifest = fs::read_to_string(f"{made}/Cargo.toml", fs::Root::Anywhere)
    let mut inside = false
    for line in manifest.lines() {
        if line.starts_with("[") { inside = line == "[features]" }
        if inside && line.len() > 0 { println(f"  {line}") }
    }
    let lib = fs::read_to_string(f"{made}/src/lib.rs", fs::Root::Anywhere)
    let mut readers = 0
    for line in lib.lines() {
        let text = line.trim()
        if text.starts_with("#[cfg(") { println(f"  {text.split(" {").next() ?? ""}") }
        if text.contains("__nikaia_reader_") { readers += 1 }
    }
    println(f"  lines naming a reader: {readers}")
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let from = f"{repo}/tests/compiler/rust_library_stream"
    process::run("cp", ["-r", f"{from}/lines", f"{from}/user", f"{from}/private", tmp.clone()])
    process::run("rm", ["-rf", f"{tmp}/lines/target"])
    let mut env: Vec[(String, String)] = []
    env.push(("CARGO_TARGET_DIR", cache_entry(repo.clone(), nikaia.clone(), "rust-library-user")))
    env.push(("CARGO_NET_OFFLINE", "true"))
    env.push(("CARGO_TERM_COLOR", "never"))
    let made = f"{tmp}/lines/target/rust-library/nikaia_lines"
    let toml = fs::read_to_string(f"{tmp}/lines/nikaia.toml", fs::Root::Anywhere)
    let whole = (toml.split("[features]").next() ?? "").clone()
    for features in ["stream = [\"lines::Words::items\"]\n", "all = [\"lines::Words\"]\n", ""] {
        if features.len() > 0 {
            fs::write(f"{tmp}/lines/nikaia.toml", fs::Root::Anywhere, f"{whole}[features]\n{features}")
            println(f"with `{features.trim()}`:")
        } else {
            fs::write(f"{tmp}/lines/nikaia.toml", fs::Root::Anywhere, whole.clone())
            println("without `[features]`:")
        }
        let built = process::run(nikaia, ["build"]; dir: f"{tmp}/lines", env: env.clone())
        if built.code != 0 { println(built.stderr.trim().replace(tmp, "TMP")) }
        shown(made.clone())
        if features.starts_with("stream") {
            let ran = process::run("cargo", ["run", "-q"]; dir: f"{tmp}/user", env: env.clone())
            println(ran.stdout.trim())
            if ran.code != 0 { println(ran.stderr.trim().replace(tmp, "TMP")) }
            let refused = process::run("cargo", ["build", "-q"]; dir: f"{tmp}/private", env: env.clone())
            println(f"private builds: {refused.code == 0}")
            let mut said = 0
            for line in refused.stderr.lines() {
                if line.starts_with("error[E0603]") { println(line); said += 1 }
            }
            if said == 0 { println(refused.stderr.trim().replace(tmp, "TMP")) }
        }
    }
    process::run("rm", ["-rf", tmp])
}
