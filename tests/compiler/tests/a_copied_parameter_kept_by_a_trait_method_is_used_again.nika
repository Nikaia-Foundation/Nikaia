// #1024: a parameter a kept lambda only copies - an `i64` - is not taken, so
// it is still there after the lambda was handed on.
trait H {
    fn take(ref mut self, f: fn(i64) -> i64)
}
struct Keep { held: Vec[fn(i64) -> i64] }
impl H for Keep {
    fn take(ref mut self, f: fn(i64) -> i64) { self.held.push(f) }
}
fn hand[T: H](mut h: T, n: i64) {
    h.take(fn(x) { x + n })
    println(n)
}
fn main() {
    let mut k = Keep { held: [] }
    hand(k, 3)
    println(k.held.len())
}
