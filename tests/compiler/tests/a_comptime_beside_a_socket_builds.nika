// #2152: a `comptime` in a file that uses `std::net` builds, though the
// build-time bundle's `std` has no sockets: what names them - a function and
// a caller of it - is left out of the program that computes the value, and a
// local that shares a left-out function's name keeps what the value reaches.
use std::net

fn send(mut connection: net::Connection, text: String) throws {
	connection.write(text)
}

fn serve(at: String) throws {
	let listener = net::listen(at)
	let mut connection = listener.accept()
	send(connection, "bye")
}

fn shout(words: String) -> String sync {
	let send = words.to_uppercase()
	return f"{send}!"
}

comptime LOUD: String = shout("to be or not to be")

fn main() throws {
	println(LOUD)
	if LOUD.len() == 0 {
		serve("127.0.0.1:0")
	}
}
