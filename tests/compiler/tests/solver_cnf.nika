// Tseitin input (ADR-270 D12, #1283 item 2): the Boolean structure of
// `TermArena` queries put into clauses over atom literals - `=` as two `<=`,
// `!=` as two strict inequalities, a junction under a disjunction as a
// definition, `x <= y` and `y < x` one atom, constants folded, a quotient's
// definition added - each query's atoms and clauses printed, and the clauses
// held against the formula on every value of its variables in -2..2 (the
// definitions and quotient columns chosen freely). A product of two
// variables is refused. The clauses of a contradictory query go to the SAT
// core and its log to `sv_check`. `prover_arena.nika`, `solver_terms.nika`, `prove_text.nika`,
// `logic_lia.nika` and `tools/sv_*.nika` run beside the driver at the end of
// this file (the lines after `// driver:`, their `// ` taken off).
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The driver: the comment lines after `// driver:` in `text`, uncommented.
fn driver(text: String) -> String {
	let mut out = ""
	let mut on = false
	for line in text.lines() {
		if on {
			if line.starts_with("// ") {
				out = out + (line.strip_prefix("// ") ?? "") + "\n"
			} else {
				out = out + "\n"
			}
		} else if line == "// driver:" {
			on = true
		}
	}
	return out
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut paths: Vec[String] = []
	for name in ["prover_arena", "solver_terms", "prove_text", "logic_lia"] {
		paths.push(f"{repo}/crates/nikaia-std/src/tools/{name}.nika")
	}
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf"] {
		let dir = if name == "sv_rod" { "solver" } else { "tools" }
		paths.push(f"{repo}/crates/nikaia-std/src/{dir}/{name}.nika")
	}
	let mut uses: Vec[String] = ["use std::collections"]
	let mut body = ""
	for p in paths {
		// The text bound first: #1287.
		let text = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		for line in text.lines() {
			if line.starts_with("use std::") {
				if !uses.contains(line.to_string()) { uses.push(line.to_string()) }
			} else {
				body = body + line + "\n"
			}
		}
	}
	let own = fs::read_to_string(f"{repo}/tests/compiler/tests/solver_cnf.nika", fs::Root::Anywhere)
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, uses.join("\n") + "\n" + body + driver(own))
	let out = process::run(nikaia, ["run", "main.nika"]; dir: tmp)
	println(out.stdout.trim())
	if out.stdout.trim().len() == 0 {
		println(out.stderr.trim())
	}
	process::run("rm", ["-rf", tmp])
}

