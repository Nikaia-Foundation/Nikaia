// A task whose callee cannot fail, but which names a pending value that can
// (ADR-async-v6 D8, D22, #988): `let c = async f(a) catch { … }`, its binding
// read by nothing, takes `a`'s failure in its own fallback, inside the task.
// It compiled to Rust that did not build (the `catch` lowered as if `f`
// threw). The same with a pausing `a`.
use std::time

struct Bad {}

impl Error for Bad {
	fn message(ref self) -> String {
		return "bad"
	}
}

fn load(n: i64) -> i64 throws {
	if n > 5 {
		throw Bad {}
	}
	return n * 2
}

fn load_slowly(n: i64) -> i64 throws {
	time::sleep(1.millis())
	return load(n)
}

fn f(n: i64) -> i64 {
	return n + 1
}

fn run(n: i64) throws {
	let a = async load(n)
	let _c = async f(a) catch {
		println(f"fallback: {error}")
		0
	}
}

fn run_slowly(n: i64) throws {
	let a = async load_slowly(n)
	let _c = async f(a) catch {
		println(f"slow fallback: {error}")
		0
	}
}

fn main() throws {
	run(1)
	run(9)
	run_slowly(2)
	run_slowly(9)
	println("end")
}
