// A task borrows a name bound outside its group and takes one bound in a
// block that ends before the group does: the task runs on past that block, so
// `s` is handed to it where it starts, and `keep(s)` after is a use after the
// hand-over (async-3 D2, ADR-async-5 D8, #986).

fn make() -> String {
    let mut g = String()
    g.push_str("hi")
    return g
}

fn show(s: String) throws {
    println(s)
}

fn keep(s: String) -> String {
    return s
}

fn main() throws {
    async {
        if true {
            let s = make()
            async show(s)
            let t = keep(s)
            println(t)
        }
        println("after")
    }
}
