// #1144: the text form of a view of an element a loop walks of a list made
// here is that view (ADR-282 D8); put where text of its own is kept, it is
// refused with NK1102, not left to rustc.
fn make(n: i64) -> Vec[String] {
    let mut v: Vec[String] = []
    v.push(f"x {n}")
    return v
}

fn rests(n: i64) -> Vec[String] {
    let mut out: Vec[String] = []
    for full in make(n) {
        match full.strip_prefix("x ") {
            null => {},
            rest => { out.push(rest.to_string()) },
        }
    }
    return out
}

fn main() {
    println(rests(1)[0])
}
