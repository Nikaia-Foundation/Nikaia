// A text's `bytes().collect()` handed to a `Vec[u8]` the callee only reads
// is the text's own bytes (#2385): the lowered call lends `s.as_bytes()`, not
// a list collected, copied into and dropped. A collect into a declared list,
// or into a type variable's parameter, still collects.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let lines: Vec[String] = [
        "use std::hash",
        "use std::collections",
        "",
        "fn own_sum(data: Vec[u8]) -> i64 {",
        "    let mut n = 0",
        "    for b in data {",
        "        n += b as i64",
        "    }",
        "    return n",
        "}",
        "",
        "fn generic_len[T](_x: T) -> i64 {",
        "    return 1",
        "}",
        "",
        "fn of(s: String) -> String {",
        "    return hash::sha256_hex(s.bytes().collect())",
        "}",
        "",
        "fn main() throws {",
        "    let s: String = \"ab\"",
        "    println(hash::sha256_hex(s.bytes().collect()))",
        "    println(of(s))",
        "    println(hash::sha256_hex(\"ab\".bytes().collect()))",
        "    let n = 3",
        f"    println(hash::sha256_hex(f\"a{{n}}\".bytes().collect()))",
        "    println(own_sum(s.bytes().collect()))",
        "    let names: Vec[String] = [\"a\", \"b\"]",
        "    println(own_sum(names.join(\"\\n\").bytes().collect()))",
        "    let mut m: collections::BTreeMap[String, i64] = collections::BTreeMap()",
        "    m.insert(\"ab\", 1)",
        "    for (k, v) in m {",
        f"        println(f\"{{hash::sha256_hex(k.bytes().collect())}} {{v}}\")",
        "    }",
        "    let v: Vec[u8] = s.bytes().collect()",
        "    println(own_sum(v))",
        "    println(generic_len(s.bytes().collect()))",
        "}",
    ]
    fs::write("p.nika", tmp, lines.join("\n") + "\n")
    let lowered = process::run(toolchain(), ["lower", "p.nika", "-o", "p.rs"]; dir: tmp.path().to_text())
    if lowered.stdout.contains("Lowered p.nika") == false { println(lowered.stderr) }
    let rust = fs::read_to_string("p.rs", tmp)
    println(f"lent as the text's bytes: {rust.matches(".as_bytes()").count()}")
    println(f"still collected: {rust.matches(".bytes().collect").count()}")
    let ran = process::run(toolchain(), ["run", "p.nika"]; dir: tmp.path().to_text())
    println(ran.stdout.trim())
    println(ran.stderr.trim())
}
