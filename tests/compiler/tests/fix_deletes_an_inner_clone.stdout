struct P { x: i64, y: i64 }

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

fn main() throws {
    let x = make()
    println(x.len())
    let p = P { x: 1, y: 2 }
    println(p.x + p.y)
}
