// A pause lets another task run (ADR-055 D4; Part II 11.2): two tasks that
// push to one list, sleep and push again come out interleaved, each up to its
// pause before the other resumes.
use std::time

fn work(order: SharedMut[Vec[i64]], name: i64) -> i64 {
	order.update fn(mut list) { list.push(name * 10 + 1) }
	time::sleep(5.millis())
	order.update fn(mut list) { list.push(name * 10 + 2) }
	return name
}

fn main() throws {
	let order: SharedMut[Vec[i64]] = SharedMut([])
	let first = async(handle) fn { work(order, 1) }
	let second = async(handle) fn { work(order, 2) }
	let done = first.join() + second.join()
	let seen = order.get()
	println(f"order: {seen[0]} {seen[1]} {seen[2]} {seen[3]}")
	println(f"joined: {done}")
}
