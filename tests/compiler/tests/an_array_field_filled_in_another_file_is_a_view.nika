use compiler_tests

// #1272 (ADR-views-3 D11): an `Array[T]` field is a view when every literal
// of the package fills it with a piece of a buffer, whichever file of the
// package the literal stands in (`src/slice_beside.nika` declares the
// struct, `src/slice_beside_caller.nika` fills it). It was NK1106.
fn main() throws {
	let a: Vec[i64] = [1, 2, 3]
	println(compiler_tests::slice_tail_second(a))
}
