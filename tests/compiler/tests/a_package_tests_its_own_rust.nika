// A package's `test` block calls the package's own Rust (ADR-rust-boundary-1
// D24, #2233): `nikaia test` splices the Rust root's modules into the test
// build. A `use` whose prefix is a module of the Rust root is `NK2507` (D28),
// and a call to an item narrower than `pub(crate)` is `NK2504`, named as
// such. `nikaia describe crate` drafts beside the reviewed file (D27).
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn ran(nikaia: String, tmp: ref fs::Root, case: String, args: Vec[String]) throws {
    let done = process::run(nikaia, args; dir: f"{tmp.path().to_text()}/demo", env: [("CARGO_TERM_COLOR", "never")])
    println(f"--- {case}: exit {done.code}")
    let text = f"{done.stdout}{done.stderr}".replace(tmp.path().to_text(), "TMP")
    for line in text.lines() {
        // Cargo's progress varies by run and by machine; CI colours it, so it is asked not to.
        let word = line.trim_start().split(" ").next() ?? ""
        if ["Updating", "Locking", "Adding", "Downloading", "Downloaded", "Compiling", "Finished", "Running", "Blocking"].contains(word) { continue }
        println(line)
    }
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    process::run("cp", ["-r", f"{repo}/tests/compiler/own_rust/demo", tmp.path().to_text()])
    let demo = tmp.join("demo")
    let source = fs::read_to_string("src/demo.nika", demo)
    let tested: String = "\ntest \"quad goes through the package's own Rust\" {\n    assert(words::twice(5) == 10)\n    assert(quad(3) == 12)\n}\n"
    fs::write("src/demo.nika", demo, f"{source}{tested}")
    // A package's entry is `src/main.nika` (Part III 13.3), a library's too.
    fs::write("src/main.nika", demo, "// The entry of the package.\n")
    ran(nikaia.clone(), tmp, "test block", ["test"])
    fs::write("src/demo.nika", demo, f"use std::fs as words\n{source}")
    ran(nikaia.clone(), tmp, "same name", ["check", "src/demo.nika"])
    let rust = fs::read_to_string("rust/words.rs", demo)
    let hidden: String = "\n/// Not visible at the crate root.\nfn hidden(x: i64) -> i64 {\n    x\n}\n"
    fs::write("rust/words.rs", demo, f"{rust}{hidden}")
    fs::write("src/demo.nika", demo, f"{source}\npub fn same(x: i64) -> i64 {{\n    return words::hidden(x)\n}}\n")
    ran(nikaia.clone(), tmp, "narrow", ["check", "src/demo.nika"])
    fs::write("rust/words.rs", demo, rust)
    fs::write("src/demo.nika", demo, f"{source}\npub fn six(x: i64) -> i64 {{\n    return words::thrice(words::twice(x))\n}}\n")
    ran(nikaia, tmp, "describe crate", ["describe", "crate"])
    print(fs::read_to_string("contracts/crate.draft.contracts", demo) catch { "no draft\n" })
}
