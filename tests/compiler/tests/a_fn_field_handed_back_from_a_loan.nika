struct H {
	n: i64,
	f: fn(i64) -> i64,
}

fn inc(x: i64) -> i64 {
	return x + 1
}

fn num(h: ref H) -> i64 {
	return h.n
}

fn pick(h: ref H) -> fn(i64) -> i64 {
	return h.f
}

fn main() {
	let h = H { n: 4, f: inc }
	println(f"{num(h)}")
	let p = pick(h)
	println(f"{p(1)}")
	println(f"{h.f(2)}")
}
