// The SAT core (ADR-270 D12, D16, #1283 item 1): pigeonhole 4-into-3 proved
// and its log accepted by `sv_check`; a learned clause whose hint chain is
// four clauses long, replayed; a satisfiable random 3-SAT instance's model
// evaluated on every clause; pigeonhole 6-into-5 with the clause database
// reduced and the arena compacted on the way, still accepted; a log with one
// learned clause's hints taken away rejected; a search stopped by its budget.
// `solver/sv_num.nika`, `sv_row.nika`, `sv_proof.nika`, `sv_check.nika`,
// `sv_sat.nika` and the `LgLin` struct run beside the driver at the end of
// this file (the lines after `// driver:`, their `// ` taken off).
use std::fs
use std::process

// The running `nikaia`: the nearest ancestor whose executable has that name.
// `nikaia run` replaces itself with its program, so the compiler is not
// always the parent (#1305). No path is guessed: without one the test stops
// and says why.
fn toolchain() -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn root() -> String throws {
	let here = process::run("pwd", []).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	let parent = process::run(
		"sh",
		["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"],
	).stdout.trim().clone()
	if fs::exists(f"{parent}/scripts/gate.nika", fs::Root::Anywhere) { return parent }
	return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

// The item of `text` that starts with the line `start`, up to its closing
// brace.
fn item(text: String, start: String) -> String {
	let at = text.find(f"\n{start}") ?? return ""
	let rest = text[at..]
	let end = rest.find("\n}\n") ?? return ""
	return f"{rest[0..<end]}\n}}\n"
}

// The driver: the comment lines after `// driver:` in `text`, uncommented.
fn driver(text: String) -> String {
	let mut out = ""
	let mut on = false
	for line in text.lines() {
		if on {
			if line.starts_with("// ") {
				out = out + (line.strip_prefix("// ") ?? "") + "\n"
			} else {
				out = out + "\n"
			}
		} else if line == "// driver:" {
			on = true
		}
	}
	return out
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain()
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let mut program = "use std::collections\n"
	for name in ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat"] {
		program.push_str(fs::read_to_string(
			f"{repo}/crates/nikaia-std/src/solver/{name}.nika",
			fs::Root::Anywhere,
		))
		program.push_str("\n")
	}
	program.push_str(item(
		fs::read_to_string(
			f"{repo}/crates/nikaia-std/src/tools/logic_lia.nika",
			fs::Root::Anywhere,
		),
		"pub struct LgLin {",
	))
	program.push_str(driver(fs::read_to_string(
		f"{repo}/tests/compiler/tests/solver_sat.nika",
		fs::Root::Anywhere,
	)))
	fs::write(f"{tmp}/main.nika", fs::Root::Anywhere, program)
	let out = process::run(nikaia, ["run", "main.nika"]; dir: tmp)
	println(out.stdout.trim())
	if out.stdout.trim().len() == 0 {
		println(out.stderr.trim())
	}
	process::run("rm", ["-rf", tmp])
}

