struct Holder {
    name: String,
}

fn make() -> String {
    let mut g = String()
    g.push_str("abc")
    return g
}

fn store(keep a: String, mut into: Vec[String]) {
    into.push(a)
}

fn main() throws {
    let h = Holder { name: make() }
    let s = h.name
    let mut all: Vec[String] = []
    store(s, all)
    println(all[0])
    println(s)
}
