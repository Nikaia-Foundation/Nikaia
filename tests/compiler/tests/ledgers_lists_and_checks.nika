// scripts/ledgers.nika (#1591): which directories have a committed ledger,
// how each is built, and a stale one found under `--check`. In a temp
// repository: `examples/app` (a program with a committed contracts file that
// does not match what it derives), `packages/lib` (a library with a committed
// `nikaia.derived`, checked with `check --rustc`), `examples/plain` (no
// ledger) and `examples/ignored` (a ledger on disk that git ignores). Only the
// first two are ledger directories, and `--check` reports the stale one and
// exits 1 before any Rust is built.
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    let here = process::run("pwd", []).stdout.trim().clone()
    if fs::exists(f"{here}/scripts/ledgers.nika", fs::Root::Anywhere) { return here }
    let parent = process::run("sh", ["-c", "readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/cwd"]).stdout.trim().clone()
    if fs::exists(f"{parent}/scripts/ledgers.nika", fs::Root::Anywhere) { return parent }
    return process::run("realpath", [f"{parent}/../.."]).stdout.trim().clone()
}

fn sh(dir: String, script: String) throws {
    let out = process::run("sh", ["-c", f"set -e; {script}"]; dir: dir)
    if !out.ok { println(f"setup failed: {script}\n{out.stderr}") }
}

// The lines of a ledgers.nika run naming a directory, and its exit code.
fn ledgers(nikaia: String, repo: String, work: String, mode: String) throws {
    let out = process::run(nikaia.clone(), ["run", f"{repo}/scripts/ledgers.nika", "--", mode, "--exe", nikaia]; dir: work)
    for line in out.stdout.lines() {
        if line.starts_with("examples/") || line.starts_with("packages/") { println(f"  {line}") }
    }
    println(f"  exit {out.code}")
}

fn main() throws {
    let tmp = process::run("sh", ["-c", "realpath $(mktemp -d)"]).stdout.trim().clone()
    let repo = root()
    let nikaia = toolchain()
    let work = f"{tmp}/work"
    let manifest = "printf '[package]\\nname = \"%s\"\\nversion = \"0.1.0\"\\n'"
    sh(tmp.clone(), "mkdir -p work/examples/app/src work/packages/lib/src work/examples/plain/src work/examples/ignored/src")
    sh(work.clone(), f"{manifest} app > examples/app/nikaia.toml; printf 'fn main() {{\\n}}\\n' > examples/app/src/main.nika; echo '# stale' > examples/app/nikaia.contracts")
    sh(work.clone(), f"{manifest} lib > packages/lib/nikaia.toml; printf 'pub fn one() -> i64 {{\\n    return 1\\n}}\\n' > packages/lib/src/main.nika; echo '# stale' > packages/lib/nikaia.derived")
    sh(work.clone(), f"{manifest} plain > examples/plain/nikaia.toml; printf 'fn main() {{\\n}}\\n' > examples/plain/src/main.nika")
    sh(work.clone(), f"{manifest} ignored > examples/ignored/nikaia.toml; printf 'fn main() {{\\n}}\\n' > examples/ignored/src/main.nika; echo nikaia.contracts > examples/ignored/.gitignore; echo '# local' > examples/ignored/nikaia.contracts")
    sh(work.clone(), "git init -q -b develop; git config user.email t@t; git config user.name t; git config commit.gpgsign false; git add -A; git commit -q -m base")
    println("--list:")
    ledgers(nikaia.clone(), repo.clone(), work.clone(), "--list")
    println("--check:")
    ledgers(nikaia, repo, work, "--check")
    process::run("rm", ["-rf", tmp])
}
