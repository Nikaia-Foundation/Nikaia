// scripts/ledgers.nika (#1591, #2797): every project built in place is a
// ledger directory, how each is built, and a stale one found under
// `--check`. In a temp repository: `examples/app` (a program with a committed
// contracts file that does not match what it derives), `packages/lib` (a
// rust-library with a committed `nikaia.derived`, built like any artifact),
// `examples/plain` (no ledger committed), `examples/ignored` (a ledger on
// disk that git ignores, so it is not copied) and `tests/language` (only a
// committed `nikaia.lock`). All five are projects built in place, so all are
// listed; `--check` finds each stale (a committed ledger that differs, or one
// the project does not commit) and exits 1.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn sh(dir: String, script: String) throws {
    let out = process::run("sh", ["-c", f"set -e; {script}"]; dir: dir)
    if !out.ok { println(f"setup failed: {script}\n{out.stderr}") }
}

// The lines of a ledgers.nika run naming a directory, and its exit code.
fn ledgers(nikaia: String, repo: String, work: ref fs::Root, mode: String) throws {
    let out = process::run(nikaia.clone(), ["run", f"{repo}/scripts/ledgers.nika", "--", mode, "--exe", nikaia]; dir: work.path().to_text())
    for line in out.stdout.lines() {
        if line.starts_with("examples/") || line.starts_with("packages/") || line.starts_with("tests/") { println(f"  {line}") }
    }
    println(f"  exit {out.code}")
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    let work = tmp.join("work")
    let manifest = "printf '[package]\\nname = \"%s\"\\nversion = \"0.1.0\"\\n'"
    sh(tmp.path().to_text(), "mkdir -p work/examples/app/src work/packages/lib/src work/examples/plain/src work/examples/ignored/src work/tests/language/src")
    sh(work.path().to_text(), f"{manifest} app > examples/app/nikaia.toml; printf 'fn main() {{\\n}}\\n' > examples/app/src/main.nika; echo '# stale' > examples/app/nikaia.contracts")
    sh(work.path().to_text(), f"{manifest} lib > packages/lib/nikaia.toml; printf '[build]\\nartifact = \"rust-library\"\\n' >> packages/lib/nikaia.toml; printf 'pub fn one() -> i64 {{\\n    return 1\\n}}\\n' > packages/lib/src/main.nika; echo '# stale' > packages/lib/nikaia.derived")
    sh(work.path().to_text(), f"{manifest} plain > examples/plain/nikaia.toml; printf 'fn main() {{\\n}}\\n' > examples/plain/src/main.nika")
    sh(work.path().to_text(), f"{manifest} ignored > examples/ignored/nikaia.toml; printf 'fn main() {{\\n}}\\n' > examples/ignored/src/main.nika; echo nikaia.contracts > examples/ignored/.gitignore; echo '# local' > examples/ignored/nikaia.contracts")
    sh(work.path().to_text(), f"{manifest} language > tests/language/nikaia.toml; printf 'fn main() {{\\n}}\\n' > tests/language/src/main.nika; printf 'version = 1\\ntoolchain = \"x\"\\n' > tests/language/nikaia.lock")
    sh(work.path().to_text(), "git init -q -b develop; git config user.email t@t; git config user.name t; git config commit.gpgsign false; git add -A; git commit -q -m base")
    println("--list:")
    ledgers(nikaia.clone(), repo.clone(), work, "--list")
    println("--check:")
    ledgers(nikaia, repo, work, "--check")
}
