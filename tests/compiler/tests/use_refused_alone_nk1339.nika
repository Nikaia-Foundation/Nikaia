// #1364: a single file outside a project has no dependencies, so its `use`
// of one is `NK1339`, at the `use` line (ADR-286 D13).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    fs::write("alone.nika", tmp, "fn main() {}\n\nuse helpers\n")
    let out = process::run(toolchain(), ["check", "alone.nika"]; dir: tmp.path().to_text())
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    println(f"exit {out.code}")
}
