// #1364: a single file outside a project has no dependencies, so its `use`
// of one is `NK1339`, at the `use` line (ADR-286 D13).
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    fs::write(f"{tmp}/alone.nika", fs::Root::Anywhere, "fn main() {}\n\nuse helpers\n")
    let out = process::run(toolchain(), ["check", "alone.nika"]; dir: tmp.clone())
    print(f"{out.stdout}{out.stderr}".replace(tmp, "TMP"))
    println(f"exit {out.code}")
    process::run("rm", ["-rf", tmp])
}
