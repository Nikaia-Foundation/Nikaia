// A Rust user's reader of a `@stream` entry whose items view the input in
// Nikaia hands out their owned form (ADR-grammar-typed-read-v1 D7, #2735):
// the package `rust_library_stream_views/lines` builds `Item`, `Inner` and
// `Kind` from the text its rule captures, so the three hold views
// (`Item<'a>`), and the crate writes beside each a twin `<name>Owned` of
// owned text with `of`, which copies an item into it. `Words::items_reader`
// yields `ItemOwned`; the crate `user` keeps the items past the reader, then
// reads the parse error last.
use std::env
use std::fs
use std::process

fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// The tests' cache entry cargo builds in, as `a_rust_library_reads_a_stream_entry` keeps it.
fn cache_entry(repo: String, nikaia: String, kind: String) -> String throws {
    let key = process::run("sha256sum", [nikaia]).stdout.split(" ").collect()[0].clone()
    let entry = f"{repo}/target/nikaia-project-tests/{kind}/{key}"
    process::run("mkdir", ["-p", entry.clone()])
    fs::write(f"target/nikaia-project-tests/{kind}/{key}/.nikaia-used", fs::Root::Dir(repo.clone()), "")
    return entry
}

fn main() throws {
    let repo = root()
    let nikaia = toolchain(repo.clone())
    let tmp = fs::scratch()
    let from = f"{repo}/tests/compiler/rust_library_stream_views"
    process::run("cp", ["-r", f"{from}/lines", f"{from}/user", tmp.path().to_text()])
    process::run("rm", ["-rf", f"{tmp.path().to_text()}/lines/target"])
    let mut env: Vec[(String, String)] = []
    env.push(("CARGO_TARGET_DIR", cache_entry(repo, nikaia.clone(), "rust-library-user")))
    env.push(("CARGO_NET_OFFLINE", "true"))
    env.push(("CARGO_TERM_COLOR", "never"))
    let built = process::run(nikaia, ["build"]; dir: f"{tmp.path().to_text()}/lines", env: env.clone())
    if built.code != 0 { println(built.stderr.trim().replace(tmp.path().to_text(), "TMP")) }
    let lib = fs::read_to_string("lines/target/rust-library/nikaia_lines/src/lib.rs", tmp)
    for line in lib.lines() {
        let text = line.trim()
        let shown = text.starts_with("pub struct ") || text.starts_with("pub enum ") || text.starts_with("pub fn of(") || text.starts_with("impl ::std::convert::From<")
        if shown { println(f"  {text}") }
        if text.contains("pub fn __nikaia_reader_") {
            let yielded = (text.split("Iterator<Item = ").nth(1) ?? "").split(">>").next() ?? ""
            println(f"  the reader yields {yielded}>")
        }
    }
    let ran = process::run("cargo", ["run", "-q"]; dir: f"{tmp.path().to_text()}/user", env: env)
    println(ran.stdout.trim())
    if ran.code != 0 { println(ran.stderr.trim().replace(tmp.path().to_text(), "TMP")) }
}
