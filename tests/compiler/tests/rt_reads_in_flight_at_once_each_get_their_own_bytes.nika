// Reads in one `overlap` are in flight at once on one thread, and each gets
// its own bytes back (ADR-055 D4): two files, then eight files of 1 to 8
// bytes. Moved from the `nikaia-std` unit tests
// `two_reads_are_in_flight_at_once_on_one_thread` and
// `eight_reads_at_once_each_get_their_own_bytes` (#2209).
use std::fs
use std::process

fn main() throws {
	let tmp = fs::scratch()
	fs::write("a", tmp, "eins")
	fs::write("b", tmp, "zweizwei")
	let (a, b) = (async fs::read_to_string("a", tmp), async fs::read_to_string("b", tmp))
	println(f"{a} {b}")
	for n in 1..<9 {
		fs::write(f"{n}", tmp, "x".repeat(n))
	}
	let (r1, r2, r3, r4, r5, r6, r7, r8) = (async fs::read_to_string("1", tmp), async fs::read_to_string("2", tmp), async fs::read_to_string("3", tmp), async fs::read_to_string("4", tmp), async fs::read_to_string("5", tmp), async fs::read_to_string("6", tmp), async fs::read_to_string("7", tmp), async fs::read_to_string("8", tmp))
	println(f"{r1.len()} {r2.len()} {r3.len()} {r4.len()} {r5.len()} {r6.len()} {r7.len()} {r8.len()}")
}
