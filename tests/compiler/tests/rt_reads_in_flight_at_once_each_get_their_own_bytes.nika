// Reads in one `overlap` are in flight at once on one thread, and each gets
// its own bytes back (ADR-055 D4): two files, then eight files of 1 to 8
// bytes. Moved from the `nikaia-std` unit tests
// `two_reads_are_in_flight_at_once_on_one_thread` and
// `eight_reads_at_once_each_get_their_own_bytes` (#2209).
use std::fs
use std::process

fn main() throws {
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	fs::write(f"{tmp}/a", fs::Root::Anywhere, "eins")
	fs::write(f"{tmp}/b", fs::Root::Anywhere, "zweizwei")
	let (a, b) = overlap {
		fs::read_to_string(f"{tmp}/a", fs::Root::Anywhere)
		fs::read_to_string(f"{tmp}/b", fs::Root::Anywhere)
	}
	println(f"{a} {b}")
	for n in 1..8 {
		fs::write(f"{tmp}/{n}", fs::Root::Anywhere, "x".repeat(n))
	}
	let (r1, r2, r3, r4, r5, r6, r7, r8) = overlap {
		fs::read_to_string(f"{tmp}/1", fs::Root::Anywhere)
		fs::read_to_string(f"{tmp}/2", fs::Root::Anywhere)
		fs::read_to_string(f"{tmp}/3", fs::Root::Anywhere)
		fs::read_to_string(f"{tmp}/4", fs::Root::Anywhere)
		fs::read_to_string(f"{tmp}/5", fs::Root::Anywhere)
		fs::read_to_string(f"{tmp}/6", fs::Root::Anywhere)
		fs::read_to_string(f"{tmp}/7", fs::Root::Anywhere)
		fs::read_to_string(f"{tmp}/8", fs::Root::Anywhere)
	}
	println(f"{r1.len()} {r2.len()} {r3.len()} {r4.len()} {r5.len()} {r6.len()} {r7.len()} {r8.len()}")
	process::run("rm", ["-rf", tmp])
}
