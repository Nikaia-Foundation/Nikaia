// A brief's `Facts:` sections of docs/builder-facts.md go into the builder's
// prompt after the brief (scripts/agent.nika), after the section `Core` every
// brief gets; an unknown heading is refused by name. Run in a directory of its
// own with a small facts file.
use std::env
use std::fs
use std::process

// The checkout: the working directory, or (under `nikaia test`, which runs a
// test in a directory of its own) the one `nikaia` was started in.
fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

// The prompt of a dry run, without its first line (the brief's path) and
// without the options after it.
fn prompt(nikaia: String, repo: String, tmp: ref fs::Root, brief: String) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/agent.nika", "--", f"{tmp.path().to_text()}/{brief}", "--dry-run"]; dir: tmp.path().to_text())
    if !out.ok { return f"code={out.code} {out.stdout.trim()}" }
    let lines = out.stdout.split("\n").collect()
    let mut kept: Vec[String] = []
    for i in 1..<lines.len() { kept.push(lines[i].clone()) }
    return kept.join("\n").split(" --agent ").collect()[0].clone()
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    process::run("mkdir", [f"{tmp.path().to_text()}/docs"])
    fs::write("docs/builder-facts.md", tmp, "# Builder facts\n\nintro\n\n## Core\n\n* a core fact\n\n## Traps\n\n* a trap\n\n### Grammar\n\n* a grammar trap\n\n## Moving Rust (self-hosting, #125)\n\n* a move rule\n")
    fs::write("line.md", tmp, "Brief.\nFacts: Grammar, Moving Rust\n")
    fs::write("front.md", tmp, "---\nfacts: Traps\n---\nBrief.\n")
    fs::write("plain.md", tmp, "Brief.\n")
    fs::write("unknown.md", tmp, "Facts: Traps, Lowering\n")
    println(prompt(nikaia.clone(), repo.clone(), tmp, "line.md"))
    println("--")
    println(prompt(nikaia.clone(), repo.clone(), tmp, "front.md"))
    println("--")
    println(f"plain: [{prompt(nikaia.clone(), repo.clone(), tmp, "plain.md")}]")
    println(prompt(nikaia, repo, tmp, "unknown.md"))
}
