// A `for` over a list it lends, whose body pushes onto one local list once a
// turn, asks that list for room first (#2385): the lowered loop starts with
// one `reserve` of the walk's length instead of growing push by push. Not
// where the body pushes twice, onto a name it rebinds, or walks a range.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let lines: Vec[String] = [
        "fn doubled(xs: Vec[i64]) -> Vec[i64] {",
        "    let mut out: Vec[i64] = []",
        "    for x in xs {",
        "        let y = x * 2",
        "        out.push(y)",
        "    }",
        "    return out",
        "}",
        "",
        "fn twice(xs: Vec[i64]) -> Vec[i64] {",
        "    let mut out: Vec[i64] = []",
        "    for x in xs {",
        "        out.push(x)",
        "        out.push(x)",
        "    }",
        "    return out",
        "}",
        "",
        "fn kept(xs: Vec[i64]) -> Vec[i64] {",
        "    let mut out: Vec[i64] = []",
        "    for x in xs {",
        "        if x > 1 {",
        "            out.push(x)",
        "        }",
        "    }",
        "    return out",
        "}",
        "",
        "fn main() throws {",
        "    let xs: Vec[i64] = [1, 2, 3]",
        "    let mut names: Vec[String] = []",
        "    for x in xs {",
        "        names.push(f\"n{x}\")",
        "    }",
        "    let mut squares: Vec[i64] = []",
        "    for i in 0..4 {",
        "        squares.push(i * i)",
        "    }",
        "    println(f\"{doubled(xs).len()} {twice(xs).len()} {kept(xs).len()} {names.join(\",\")} {squares.len()}\")",
        "}",
    ]
    fs::write("p.nika", tmp, lines.join("\n") + "\n")
    let lowered = process::run(toolchain(), ["lower", "p.nika", "-o", "p.rs"]; dir: tmp.path().to_text())
    if lowered.stdout.contains("Lowered p.nika") == false { println(lowered.stderr) }
    let rust = fs::read_to_string("p.rs", tmp)
    println(f"sized before the loop: {rust.matches(".reserve(").count()}")
    let ran = process::run(toolchain(), ["run", "p.nika"]; dir: tmp.path().to_text())
    println(ran.stdout.trim())
    println(ran.stderr.trim())
}
