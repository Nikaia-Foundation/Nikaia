// **`NK1350`: a `.clone()` that copies nothing new** (#1318): the clone of a
// value whose type copies, of a `let` at its last use, and of a list a `for`
// only walks. Three warnings; the program still runs.
struct P { x: i64, y: i64 }

fn take(s: String) -> i64 {
	return s.len() as i64
}

fn make() -> String {
	let mut g = String()
	g.push_str("abc")
	return g
}

fn main() throws {
	let p = P { x: 1, y: 2 }
	let q = p.clone()
	println(q.x + p.y)
	let s = make()
	println(take(s.clone()))
	let xs = [1, 2, 3]
	for x in xs.clone() {
		println(x)
	}
	println(xs.len())
}
