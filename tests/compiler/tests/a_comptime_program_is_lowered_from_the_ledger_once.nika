// #2150: the build-time program of a loose file's `comptime` is lowered from
// the ledger its D2 rule derived, not inferred twice more by the emitter. Its
// value function indexes a vector under the bound it proves, so the bounds
// proofs of that ledger are what the lowering reads. A fresh number in an
// unrelated function makes the value a miss in the user cache (#2149), so the
// program is written each run.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		eprintln("no running nikaia among this program's ancestors: run it with `nikaia test` (#1305)")
		process::exit(2)
	}
	return exe
}

fn main() throws {
	let tmp = fs::scratch()
	let nikaia = toolchain()
	let fresh = process::run("date", ["+%s%N"]).stdout.trim().clone()
	let file = f"{tmp.path().to_text()}/pick.nika"
	let head = "fn pick(xs: Vec[i64], i: i64) -> i64 sync {\n\tif i >= 0 && i < xs.len() {\n\t\treturn xs[i]\n\t}\n\treturn 0\n}\n\nfn fresh() -> i64 {\n\treturn "
	let tail = "\n}\n\ncomptime PICKED: i64 = pick([3, 5, 7, 11], 2)\n\nfn main() throws {\n\tprintln(PICKED)\n}\n"
	fs::write("pick.nika", tmp, f"{head}{fresh}{tail}")
	let out = process::run(nikaia, ["run", file]; dir: tmp.path().to_text(), env: [("RUST_BACKTRACE", "0")])
	println(f"{out.stdout.trim()} (exit {out.code})")
}
