fn work(n: i64) -> i64 sync {
    return n * 2
}

fn rest(n: i64) sync {
    if n > 9 { return }
}

fn main() throws {
    let (a, b) = (async work(2), async work(3))
    println(a + b)
    async {
        async rest(4)
        async rest(5)
    }
}
