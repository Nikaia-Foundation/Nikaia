struct View { head: String }
struct Cursor { input: String, pos: i64 }

fn parse(t: String) -> View {
    return View { head: t }
}

// ADR-353 D3, D4 (#942): `text` moved into `c.input` is followed there, so
// changing that field in place while `v` is still used is refused; `c.pos`
// is no part of the data `v` may point into.
fn main() {
    let n = 1
    let text = f"a: {n}"
    let v = parse(text)
    let mut c = Cursor { input: text, pos: 0 }
    c.pos = 2
    c.input.push_str("b")
    println(f"{c.pos}")
    println(v.head)
    println(c.input)
}
