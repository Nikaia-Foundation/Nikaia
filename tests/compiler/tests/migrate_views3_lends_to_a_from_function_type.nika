// ADR-views-v4 D14: `nikaia migrate views-3` writes no `keep` on an argument
// handed to a function value whose type's `from` reads it: the call lends it.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    fs::write("a.nika", tmp, "fn first(s: String) -> String {\n    return s.trim()\n}\n\nfn apply(f: fn(s: String) -> String from s, s: String) -> i64 {\n    return f(s).len()\n}\n\nfn main() {\n    println(apply(first, \" ab \"))\n}\n")
    let out = process::run(nikaia, ["migrate", "views-3", f"{tmp.path().to_text()}/a.nika"])
    print(f"{out.stdout}{out.stderr}".replace(tmp.path().to_text(), "TMP"))
    print(fs::read_to_string("a.nika", tmp))
}
