// A pending binding named in another task is waited for in that task, so the
// main line waits where it names it itself, here at the group's end
// (ADR-async-5 D6, #986): the next statement starting a task that reads `a`
// is no wait of the main line, and `b`'s task waits for `a` (#988).

fn load(n: i64) -> i64 {
	return n * 2
}

fn enrich(n: i64) -> i64 {
	return n + 1
}

fn main() {
	let a = async load(1)
	let b = async enrich(a)
	println(f"{b}")
}
