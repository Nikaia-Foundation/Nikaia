// #862: batch.nika names what is missing and reads `Result: done. text`,
// `Gate:`, `noop` and `Owner: none ...`.
use std::env
use std::fs
use std::process

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn first(nikaia: String, repo: String, tmp: ref fs::Root) -> String throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/batch.nika", "--", "."]; dir: tmp.path().to_text())
    return out.stdout.trim().split("\n").collect()[0].replace(tmp.path().to_text(), "T")
}

// The toolchain that runs this test (CI builds target/release only); if the
// test was started otherwise, the first built one in the checkout.
fn toolchain(repo: String) -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return f"{repo}/target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain(repo.clone())
    // The scripts run in their lane's directory, which lies below the
    // working directory; they find the toolchain and scripts under the
    // checkout's names.
    process::run("ln", ["-s", f"{repo}/target", f"{tmp.path().to_text()}/target"])
    process::run("ln", ["-s", f"{repo}/scripts", f"{tmp.path().to_text()}/scripts"])
    println(f"no batch.txt: {first(nikaia.clone(), repo.clone(), tmp)}")
    fs::write("batch.txt", tmp, "a.md\n")
    println(f"missing brief: {first(nikaia.clone(), repo.clone(), tmp)}")
    fs::write("a.md", tmp, "body\n")
    let tail = "Pushed: abc\nFound: none\nDeviation: none\nChangelog: none\n"
    fs::write("a.report.md", tmp, "Result: done. text here\n" + tail)
    println(f"done with text: {first(nikaia.clone(), repo.clone(), tmp)}")
    fs::write("a.report.md", tmp, "Result: done\nGate: red x\n" + tail)
    println(f"gate red: {first(nikaia.clone(), repo.clone(), tmp)}")
    fs::write("a.report.md", tmp, "Result: done\nGate: green\nOwner: none, thanks\n" + tail)
    println(f"gate green: {first(nikaia.clone(), repo.clone(), tmp)}")
    fs::write("a.report.md", tmp, "Result: noop\nPushed: none\nFound: none\nDeviation: none\nChangelog: none\n")
    println(f"noop: {first(nikaia.clone(), repo.clone(), tmp)}")
}
