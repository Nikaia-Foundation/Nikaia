// Two failures nobody reads, at the group's normal end (ADR-async-5 D21,
// Part I 8.1.2, #2561): the first in written order is thrown, and the second
// travels as its `secondary`; the task that succeeds between them adds
// nothing, and the group's own statements run on before its end.

enum Bad { Oops(i64) }
impl Error for Bad {
	fn message(ref self) -> String {
		return match self {
			Bad::Oops(n) => f"task {n} failed",
		}
	}
}

fn work(n: i64) -> i64 throws {
	if n > 5 {
		throw Bad::Oops(n)
	}
	return n
}

fn run() -> i64 throws {
	let n = async {
		async work(7)
		async work(1)
		async work(8)
		println("the group's statements run on")
		1
	}
	println("not reached")
	return n
}

fn main() throws {
	let n = run() catch {
		println(error.full())
		0
	}
	println(f"{n}")
}
