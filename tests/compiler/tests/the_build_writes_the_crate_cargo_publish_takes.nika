// #99, ADR-286 D25: `nikaia build` writes the package as `cargo publish` takes
// it to `target/nikaia/publish/`: the crate `nikaia_<name>`, its own packages
// by version as the renaming, and the sources and the ledger, nothing lowered.
// Checked with `cargo package --list`, offline; nothing is published.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    process::run("mkdir", ["-p", f"{tmp.path().to_text()}/base/src", f"{tmp.path().to_text()}/app/src/parts", f"{tmp.path().to_text()}/app/.cargo"])
    fs::write("base/Cargo.toml", tmp, "[package]\nname = \"nikaia_base\"\nversion = \"0.2.4\"\nedition = \"2024\"\n\n[lib]\npath = \"lib.rs\"\n\n[workspace]\n")
    fs::write("base/lib.rs", tmp, "")
    fs::write("base/nikaia.toml", tmp, "[package]\nname = \"base\"\nversion = \"0.2.4\"\n")
    fs::write("base/src/lib.nika", tmp, "pub fn one() -> i64 {\n    return 1\n}\n")
    fs::write("base/nikaia.contracts", tmp, "")
    fs::write("app/.cargo/config.toml", tmp, f"[patch.crates-io]\nnikaia_base = {{ path = \"{tmp.path().to_text()}/base\" }}\n")
    fs::write("app/nikaia.toml", tmp, "[package]\nname = \"tally-up\"\nversion = \"0.3.0\"\nlicense = \"MIT\"\n\n[dependencies]\nbase = \"0.2\"\n")
    fs::write("app/src/main.nika", tmp, "use base\n\npub fn tally(x: i64) -> i64 {\n    return x + base::one()\n}\n\nfn main() throws {\n    println(tally(1))\n}\n")
    fs::write("app/src/parts/more.nika", tmp, "pub fn more() -> i64 {\n    return 2\n}\n")
    let built = process::run(nikaia, ["build"]; dir: f"{tmp.path().to_text()}/app", env: [("CARGO_NET_OFFLINE", "true")])
    println(f"built: {built.ok}")
    if !built.ok {
        println(built.stderr)
    }
    let stub = fs::read_to_string("app/target/nikaia/publish/Cargo.toml", tmp)
    for line in stub.lines() {
        if line.starts_with("name") || line.starts_with("version") || line.starts_with("license") || line.starts_with("base") {
            println(line)
        }
    }
    let listed = process::run("cargo", ["package", "--no-verify", "--list", "--offline", "--allow-dirty", "--manifest-path", f"{tmp.path().to_text()}/app/target/nikaia/publish/Cargo.toml"]; dir: f"{tmp.path().to_text()}/app")
    println(listed.stdout.trim())
    if !listed.ok {
        println(listed.stderr)
    }
}
