// A change to a `///` doc of one file of the tools package re-lowers that
// file alone (#1909, step D): no pass reads another file's docs (the one
// reader, `main_words` in `emit_entry.nika`, reads the file's own `main`),
// so a file's key leaves them out of what it reads of the others. A body
// change that leaves the ledger as it was (a local renamed) re-lowers that
// file too, and so does a function added that `b` does not name (C).
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = process::run("sh", ["-c", "e=$(readlink /proc/$(cut -d' ' -f4 /proc/$PPID/stat)/exe); [ \"$(basename \"$e\")\" = nikaia ] && echo \"$e\""]).stdout.trim().clone()
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

// Lowers the sysroot in `tmp` and prints how many files came from the cache.
fn lower(nikaia: String, tmp: String, what: String) throws {
    let out = process::run(nikaia, ["lower-std", "--sysroot", f"{tmp}/crates"]; dir: tmp.clone(), env: [("NIKAIA_CACHE_DIR", f"{tmp}/cache"), ("NIKAIA_LOWER_CACHE_SALT", "doc-edit")])
    for line in out.stderr.lines() {
        if line.contains(" files from the cache") {
            let parts: Vec[String] = line.split(": ").collect()
            println(f"{what}: {parts.last() ?? ""}")
            return
        }
    }
    println(f"{what}: exit {out.code}")
}

fn main() throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let nikaia = toolchain()
    let dir = f"{tmp}/crates/nikaia-std/src/compiler"
    process::run("mkdir", ["-p", dir.clone()])
    fs::write(f"{dir}/a.nika", fs::Root::Anywhere, "/// A number.\npub fn a_one() -> i64 sync {\n    let x = 1\n    return x\n}\n")
    fs::write(f"{dir}/b.nika", fs::Root::Anywhere, "/// Two.\npub fn b_two() -> i64 sync {\n    return a_one() + 1\n}\n")
    lower(nikaia, tmp, "cold")
    fs::write(f"{dir}/a.nika", fs::Root::Anywhere, "/// A number,\n/// said otherwise.\npub fn a_one() -> i64 sync {\n    let x = 1\n    return x\n}\n")
    lower(nikaia, tmp, "doc edit")
    fs::write(f"{dir}/a.nika", fs::Root::Anywhere, "/// A number,\n/// said otherwise.\npub fn a_one() -> i64 sync {\n    let y = 1\n    return y\n}\n")
    lower(nikaia, tmp, "body edit")
    fs::write(f"{dir}/a.nika", fs::Root::Anywhere, "/// A number,\n/// said otherwise.\npub fn a_one() -> i64 sync {\n    let y = 1\n    return y\n}\n\npub fn a_three() -> i64 sync {\n    return 3\n}\n")
    lower(nikaia, tmp, "signature edit")
    process::run("rm", ["-rf", tmp])
}
