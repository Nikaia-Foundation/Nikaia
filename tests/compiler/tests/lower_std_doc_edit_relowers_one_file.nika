// A change to a `///` doc of one file of the tools package re-lowers that
// file alone (#1909, step D): no pass reads another file's docs (the one
// reader, `main_words` in `emit_entry.nika`, reads the file's own `main`),
// so a file's key leaves them out of what it reads of the others. A body
// change that leaves the ledger as it was (a local renamed) re-lowers that
// file too, and so does a function added that `b` does not name (C).
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

// Lowers the sysroot in `tmp` and prints how many files came from the cache.
fn lower(nikaia: String, tmp: ref fs::Root, what: String) throws {
    let out = process::run(nikaia, ["lower-std", "--sysroot", f"{tmp.path().to_text()}/crates"]; dir: tmp.path().to_text(), env: [("NIKAIA_CACHE_DIR", f"{tmp.path().to_text()}/cache"), ("NIKAIA_LOWER_CACHE_SALT", "doc-edit")])
    for line in out.stderr.lines() {
        if line.contains(" files from the cache") {
            let parts: Vec[String] = line.split(": ").collect()
            println(f"{what}: {parts.last() ?? ""}")
            return
        }
    }
    println(f"{what}: exit {out.code}")
}

fn main() throws {
    let tmp = fs::scratch()
    let nikaia = toolchain()
    let dir = tmp.join("crates/nikaia-std/src/compiler")
    process::run("mkdir", ["-p", dir.path().to_text()])
    fs::write("nikaia.toml", dir, "[package]\nname = \"compiler\"\nwithin = \"std\"\n")
    fs::write("a.nika", dir, "/// A number.\npub fn a_one() -> i64 sync {\n    let x = 1\n    return x\n}\n")
    fs::write("b.nika", dir, "/// Two.\npub fn b_two() -> i64 sync {\n    return a_one() + 1\n}\n")
    lower(nikaia, tmp, "cold")
    fs::write("a.nika", dir, "/// A number,\n/// said otherwise.\npub fn a_one() -> i64 sync {\n    let x = 1\n    return x\n}\n")
    lower(nikaia, tmp, "doc edit")
    fs::write("a.nika", dir, "/// A number,\n/// said otherwise.\npub fn a_one() -> i64 sync {\n    let y = 1\n    return y\n}\n")
    lower(nikaia, tmp, "body edit")
    fs::write("a.nika", dir, "/// A number,\n/// said otherwise.\npub fn a_one() -> i64 sync {\n    let y = 1\n    return y\n}\n\npub fn a_three() -> i64 sync {\n    return 3\n}\n")
    lower(nikaia, tmp, "signature edit")
}
