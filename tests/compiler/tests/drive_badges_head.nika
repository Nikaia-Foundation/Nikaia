// scripts/drive.nika --badges (#1348): the driver's badges step measures the
// committed tree, not the working tree. In a temp repository holding the
// badges' inputs, an unstaged deletion of the largest `.rs` (another lane's
// unfinished work) leaves the badges as committed; the same deletion
// committed regenerates them. Either way HEAD's badges pass
// `badges.py --check` on HEAD's own tree, as CI runs it.
use std::env
use std::fs
use std::process

fn toolchain() -> String throws {
    let exe = env::current_exe()?.display() ?? ""
    if exe.len() > 0 { return exe }
    return "target/fast/nikaia"
}

fn root() -> String throws {
    return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

fn sh(dir: String, script: String) -> String throws {
    let out = process::run("sh", ["-c", f"set -e; {script}"]; dir: dir)
    if !out.ok { println(f"setup failed: {script}\n{out.stderr}") }
    return out.stdout.trim().clone()
}

// Runs the badges step, then says what it committed and whether HEAD's
// badges match HEAD's tree.
fn step(nikaia: String, repo: String, work: ref fs::Root, name: String) throws {
    let out = process::run(nikaia, ["run", f"{repo}/scripts/drive.nika", "--", "--badges"]; dir: work.path().to_text())
    println(f"== {name}")
    println(out.stdout.trim())
    let check = "rm -rf ../head; git checkout-index -a --prefix=../head/; cd ../head; python3 scripts/badges.py --check >/dev/null 2>&1 && echo HEAD badges match HEAD || echo HEAD badges out of date"
    println(sh(work.path().to_text(), f"git log --format=%s -1; git status --porcelain --untracked-files=no; {check}").replace(big(work), "BIG"))
}

fn big(work: ref fs::Root) -> String throws {
    return sh(work.path().to_text(), "cat ../big")
}

fn main() throws {
    let tmp = fs::scratch()
    let repo = root()
    let nikaia = toolchain()
    let work = tmp.join("work")
    let inputs = "scripts/badges.py scripts/self_hosting.py docs/specification/10-nikaia-light.md assets/badges crates/nikaia/src packages/logic/src crates/nikaia-std/src/compiler ':(exclude)crates/nikaia-std/src/compiler/lowered'"
    let id = "git config user.email t@t; git config user.name t; git config commit.gpgsign false"
    sh(tmp.path().to_text(), f"git init -q -b develop work; cd work; {id}; git -C '{repo}' archive HEAD {inputs} | tar -x; python3 scripts/badges.py >/dev/null; git add -A; git commit -q -m base")
    sh(work.path().to_text(), "ls -S crates/nikaia/src/*.rs | head -1 > ../big; rm $(cat ../big)")
    step(nikaia.clone(), repo.clone(), work, "unstaged deletion")
    sh(work.path().to_text(), "git add -A crates/nikaia/src; git commit -q -m 'delete the largest'")
    step(nikaia.clone(), repo.clone(), work, "committed deletion")
}
