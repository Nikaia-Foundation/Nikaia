// `--asserts` lists a type's rules (ADR-369 D5): the written rule of
// `Piece` with each point where it is checked and why, and the found
// rule `0 <= at <= c.len()` of the private `Cursor`, which proves the
// index in `peek`.
struct Piece {
	start: i64,
	end: i64,
	assert(0 <= start && start <= end; message: "a piece ends after it starts"),
}

fn piece(a: i64, b: i64) -> Piece? {
	if 0 <= a && a <= b {
		return Piece { start: a, end: b }
	}
	return null
}

struct Cursor {
	c: Vec[i64],
	at: i64,
}

impl Cursor {
	fn peek(self) -> i64 {
		if self.at == self.c.len() {
			return 0
		}
		return self.c[self.at]
	}

	fn step(mut self) {
		if self.at < self.c.len() {
			self.at += 1
		}
	}
}

fn main() throws {
	let whole = Piece { start: 0, end: 4 }
	let p = piece(1, 3) ?? whole
	let end = p.end
	println(end)
	let mut c = Cursor { c: [4, 5], at: 0 }
	c.step()
	println(c.peek())
}
