// A `pub grammar` whose `@stream` items view the input they are parsed from
// (ADR-grammar-typed-read-v1 D7, ADR-views-v4 D5): `Item { word: w }` holds
// the text `w` captured, and so do the nested `Inner` and `Kind`. `counted`
// walks it inside the crate; a Rust user reads it through the feature
// `stream`, whose reader hands out `ItemOwned`.

pub struct Inner {
	pub text: String,
}

pub enum Kind {
	Plain,
	Quoted(String),
}

pub struct Item {
	pub word: String,
	pub note: String?,
	pub inner: Inner,
	pub kind: Kind,
	pub size: i64,
}

pub grammar Words {
	@stream entry rule items -> Item = item*
	rule item -> Item = w:until(";") ";" -> {
		let note = if w.len() > 1 { w } else { null }
		let kind = if w.starts_with("q") { Kind::Quoted(w) } else { Kind::Plain }
		Item { word: w, note: note, inner: Inner { text: w }, kind: kind, size: w.len() as i64 }
	}
}

pub fn counted(text: String) -> i64 sync throws {
	let mut n = 0
	for it in Words::items(text) {
		n += it.size
	}
	return n
}
