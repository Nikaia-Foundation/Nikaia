// The event stream of each file named on the command line, through
// `yaml::documents` and `yaml::events`, one line per event in the form every
// program of the bench prints (README, *The output*): the yaml-test-suite's
// event lines without the flow markers and `...`, which `saphyr-parser` does
// not report, and with each anchor numbered in the order it is defined. A file
// the parser refuses prints `error`.
use std::cli
use std::collections
use std::fs
use yaml

// `t` escaped onto `out`, as the Rust programs append it.
fn escaped(mut out: String, t: String) {
	for c in t.scalars {
		if c == '\\' {
			out.push_str("\\\\")
		} else if c == '\n' {
			out.push_str("\\n")
		} else if c == '\t' {
			out.push_str("\\t")
		} else if c == '\r' {
			out.push_str("\\r")
		} else {
			out.push(c)
		}
	}
}

// An event's anchor, numbered in the order it is defined, and its tag onto
// `out`.
fn props(mut out: String, e: ref yaml::Event, mut ids: collections::HashMap[String, i64], mut next: i64) -> i64 {
	match e.anchor {
		null => {}
		a => {
			ids.insert(a.clone(), next)
			out.push_str(f" &{next}")
			next += 1
		}
	}
	match e.tag {
		null => {}
		t => {
			out.push_str(" <")
			out.push_str(t)
			out.push_str(">")
		}
	}
	return next
}

fn main() throws {
	let mut out = String()
	let mut args = cli::args()
	args.nth(0)
	for path in args {
		let input = fs::read(path, fs::Root::Anywhere)
		let docs = yaml::documents(input) catch {
			out.push_str("error\n")
			continue
		}
		let mut ids: collections::HashMap[String, i64] = collections::HashMap()
		let mut next = 1
		for e in yaml::events(docs) {
			match e.kind {
				yaml::EventKind::StreamStart => out.push_str("+STR")
				yaml::EventKind::StreamEnd => out.push_str("-STR")
				yaml::EventKind::DocumentStart => out.push_str(if e.explicit { "+DOC ---" } else { "+DOC" })
				yaml::EventKind::DocumentEnd => out.push_str("-DOC")
				yaml::EventKind::SequenceStart => {
					out.push_str("+SEQ")
					next = props(out, e, ids, next)
				}
				yaml::EventKind::SequenceEnd => out.push_str("-SEQ")
				yaml::EventKind::MappingStart => {
					out.push_str("+MAP")
					next = props(out, e, ids, next)
				}
				yaml::EventKind::MappingEnd => out.push_str("-MAP")
				yaml::EventKind::Alias => out.push_str(f"=ALI *{ids.get(e.value) ?? 0}")
				yaml::EventKind::Scalar => {
					out.push_str("=VAL")
					next = props(out, e, ids, next)
					out.push_str(match e.style {
						yaml::Style::Plain => " :"
						yaml::Style::Single => " '"
						yaml::Style::Double => " \""
						yaml::Style::Literal => " |"
						yaml::Style::Folded => " >"
					})
					escaped(out, e.text ?? e.value)
				}
			}
			out.push_str("\n")
		}
	}
	print(out)
}
