// The program ADR-292 D6 is measured on, end to end: two reads that meet on
// nothing, asked to overlap with `overlap { … }` (Part I 8.1.2), in a loop.
// Nothing else in the body could account for a difference: the assignment after
// them performs no operation, so the pair is the pair and the loop is the
// repeat count.
//
// `lowered.sh` builds it beside `sequential.nika`, the same loop with the two
// reads one after the other. The difference between the two binaries is the
// whole of what the block costs or saves.
//
// `user_parallelism = no` in both, which is the point: the waiting overlaps
// there too, because it is not user code.
use std::cli
use std::text
use std::fs

fn main() throws {
    let runden = cli::args().nth(1) ?? "200000"
    let n = text::parse_i32(runden) ?? 200000
    let mut gesamt = 0
    for _runde in 0..<n {
        let (a, b) = overlap {
            fs::read_to_string("eins.txt", fs::Root::Anywhere) catch { "" }
            fs::read_to_string("zwei.txt", fs::Root::Anywhere) catch { "" }
        }
        gesamt = gesamt + a.len() + b.len()
    }
    println(f"{gesamt}")
}
