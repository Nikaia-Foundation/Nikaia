// The scan alone, against `src/bin/scan.rs`: every `;` and `\n` of the file
// by `find_all` over a `bytes::ByteSet`, with no parse and no table. Prints the
// count of separators and the xor of their positions. See `README.md`.

use std::bytes
use std::cli
use std::fs

fn main() throws {
    let path = cli::args().nth(1) ?? "measurements.txt"
    // The file `brc.sh` generated, so who wrote it is known (ADR-365 D2).
    let data = fs::map(path, fs::Root::Anywhere; trusted: true) catch {
        eprintln(f"cannot open {path}: {error}")
        return
    }
    let seps = bytes::ByteSet([';', '\n'])
    // An `i64`, as `src/bin/scan.rs`'s `u64`: a file of a billion rows has
    // two billion separators, at the top of an `i32`. Raised once a position,
    // it stays below the file's length, so it needs no check (#432).
    let mut n: i64 = 0
    let mut x = 0
    for p in data.find_all(seps) {
        n += 1
        x = x ^ p
    }
    println(f"{n} {x}")
}
