// The 1BRC aggregation written for speed against today's `std`, the
// counterpart of `src/bin/ai2.rs`. See `README.md`.
//
// * the file is mapped and read as `Bytes`: nothing checks it as UTF-8 as a
//   whole; a station's name is checked once, where it is printed;
// * `find_all` over a `ByteSet` of `;` alone finds the separators; where a
//   line ends follows from the temperature's shape, so the `\n` is never
//   searched for;
// * a name's first sixteen bytes, read as two words with `u64_le`, are its
//   hash and its key; its bytes are compared only where it is longer;
// * the temperature is read from one word, without a branch;
// * an open-addressing table of our own in a `Vec`;
// * the last rows are read from a copy with zeros behind them, so that no
//   word read goes past the end;
// * on more than one core, `par_pieces` cuts the file at line ends and
//   `Par::fold` scans the pieces into a table each and merges them.
use std::cli
use std::collections
use std::fs
use std::simd
use std::task

struct Slot {
    w0: u64,
    w1: u64,
    len: i64,
    name: Bytes,
    min: i64,
    max: i64,
    sum: i64,
    count: i64,
}

struct Table {
    slots: Vec[Slot],
    used: i64,
    assert(slots.len() == SLOTS; message: "the table holds `SLOTS` slots")
}

comptime BITS: i64 = 14
comptime SLOTS: i64 = 16384
// What of a name's first and second word belongs to it, by its length: a
// name of `len` bytes keeps the low `len` bytes of the first word and the
// low `len - 8` of the second, computed while the program is built.
comptime FIRST: Array[u64, 101] = word_masks(0)
comptime SECOND: Array[u64, 101] = word_masks(8)
// How far behind the last row start a word read may reach: a name of 100
// bytes, its temperature and a word beyond.
comptime MARGIN: i64 = 256

// The masks of `FIRST` (`skip` 0) and `SECOND` (`skip` 8): for each length
// up to 100, a byte of ones for each of the name's bytes from `skip` on, at
// most eight.
fn word_masks(skip: i64) -> Vec[u64] {
    let mut masks: Vec[u64] = []
    for len in 0..<101 {
        let mut mask: u64 = 0
        let mut k = skip
        while k < len && k < skip + 8 {
            mask = (mask << 8) | 0xFF
            k += 1
        }
        masks.push(mask)
    }
    return masks
}

fn table() -> Table {
    let mut slots: Vec[Slot] = []
    slots.resize(SLOTS, Slot { w0: 0, w1: 0, len: 0, name: Bytes([]), min: 0, max: 0, sum: 0, count: 0 })
    return Table { slots: slots, used: 0 }
}

impl Table {
    // The slot of the name `buf[pos..<pos + len]`, whose first sixteen bytes
    // are `w0` and `w1` (zeros past its end), taken where the name is new.
    // The `assert` before each `return` is its postcondition: a caller knows
    // the slot lies inside the table, and indexes it without a check. The
    // first is its precondition: the name lies inside `buf`, which a caller
    // proves, so the cut of a long name is taken without a check.
    fn slot_of(ref mut self, w0: u64, w1: u64, len: i64, buf: ref Bytes, pos: i64) -> i64 {
        assert(pos >= 0 && len >= 0 && pos + len <= buf.len())
        let h = (w0 ^ (w1 << 5)).wrapping_mul(0x9E3779B97F4A7C15)
        let mut at = (h >> (64 - BITS)).bits_as_i64()
        while true {
            if self.slots[at].count == 0 {
                self.claim(at, w0, w1, len, buf, pos)
                assert(at >= 0 && at < SLOTS)
                return at
            }
            if self.slots[at].w0 == w0 && self.slots[at].w1 == w1 && self.slots[at].len == len
                && (len <= 16 || self.slots[at].name[0..<len] == buf[pos..<pos + len]) {
                assert(at >= 0 && at < SLOTS)
                return at
            }
            at = (at + 1) & (SLOTS - 1)
        }
        panic("unreachable")
    }

    // A station seen for the first time: once per name, so kept out of the
    // loop that runs once per row.
    @inline(never)
    fn claim(ref mut self, at: i64, w0: u64, w1: u64, len: i64, buf: ref Bytes, pos: i64) {
        assert(pos >= 0 && len >= 0 && pos + len <= buf.len())
        self.used += 1
        if self.used > 10000 { panic("more than 10 000 stations") }
        self.slots[at] = Slot { w0: w0, w1: w1, len: len, name: buf[pos..<pos + len].clone(), min: 999, max: -999, sum: 0, count: 0 }
    }

    // Every row of `buf` that starts before `stop`.
    fn run(ref mut self, buf: ref Bytes, stop: i64) {
        if stop == 0 { return }
        // A row starts before `stop`, which leaves `MARGIN` bytes behind it.
        assert(stop > 0 && stop <= buf.len() - MARGIN; message: "a row starts `MARGIN` bytes before the end")
        let mut pos = 0
        // The `;` after each row's start, 32 bytes a compare: a row is about
        // 14 bytes, so it is mostly in the first 32, and the test whether it
        // was found is predicted. A name has at most 100 bytes, so at most
        // four loads look for it, each inside the input.
        let semis: simd::Fixed[u8, 32] = simd::splat(';')
        while true {
            let mut sep = pos
            while true {
                // The input's, so checked here, and a fact from here on.
                if !(sep >= pos && sep - pos <= 100) { panic("a station's name has at most 100 bytes") }
                let block: simd::Fixed[u8, 32] = simd::load(buf, sep)
                let hit = block.eq(semis).first() ?? -1
                if hit >= 0 {
                    sep += hit
                    break
                }
                sep += 32
            }
            // The name's first two words, zeros past its end: each cut to
            // the name by a mask looked up by its length, without a branch on
            // the length, which names of varying length would mispredict.
            let len = sep - pos
            if !(len >= 0 && len <= 100) { panic("a station's name has at most 100 bytes") }
            let w0 = buf.u64_le(pos) & FIRST[len]
            let w1 = buf.u64_le(pos + 8) & SECOND[len]

            let at = self.slot_of(w0, w1, len, buf, pos)
            // The temperature, `-?d?d.d`, from one word: where the `.` is
            // says how long it is, and the sign becomes a mask.
            let w = buf.u64_le(sep + 1)
            let dot = (!w & 0x10101000).trailing_zeros()
            if dot > 28 { panic("a row without a temperature") }
            let signed = ((!w) << 59).bits_as_i64() >> 63
            let keep = !(signed.bits_as_u64() & 0xFF)
            let digits = ((w & keep) << (28 - dot)) & 0x0F000F0F00
            let abs = (digits.wrapping_mul(0x640A0001) >> 32) & 0x3FF
            let v = (abs.bits_as_i64() ^ signed) - signed

            if v < self.slots[at].min { self.slots[at].min = v }
            if v > self.slots[at].max { self.slots[at].max = v }
            self.slots[at].sum += v
            self.slots[at].count += 1

            pos = sep + 4 + ((dot >> 3) as i64)
            if pos >= stop { break }
        }
    }

    // Every row of `b`: those up to the last `MARGIN` bytes in place, the
    // rest from a copy with zeros behind it.
    fn scan(ref mut self, b: ref Bytes) {
        let n = b.len()
        let mut cut = 0
        if n > MARGIN {
            cut = n - MARGIN
            while cut > 0 && b[cut - 1] != '\n' { cut -= 1 }
        }
        self.run(b, cut)
        let mut tail: Vec[u8] = []
        for c in b[cut..<n] { tail.push(c) }
        for _ in 0..<MARGIN { tail.push(0) }
        self.run(Bytes(tail), n - cut)
    }

    fn merge(ref mut self, other: Table) {
        for s in other.slots {
            if s.count > 0 {
                let at = self.slot_of(s.w0, s.w1, s.len, s.name, 0)
                if s.min < self.slots[at].min { self.slots[at].min = s.min }
                if s.max > self.slots[at].max { self.slots[at].max = s.max }
                self.slots[at].sum += s.sum
                self.slots[at].count += s.count
            }
        }
    }
}

fn main() throws {
    let path = cli::args().nth(1) ?? "measurements.txt"
    let b = fs::map(ref path, fs::Root::Anywhere) catch {
        eprintln(f"cannot open {path}: {error}")
        return
    }
    let mut all = table()
    if task::cores() == 1 {
        all.scan(b)
    } else {
        all = b.par_pieces('\n').fold(table, fn(t, piece) { t.scan(piece) }, Table::merge; order: par::Order::Any)
    }

    // Each station's name is checked as UTF-8 here, once.
    let mut index: collections::HashMap[ref String, i64] = collections::HashMap()
    let mut at = 0
    while at < SLOTS {
        if all.slots[at].count > 0 { index.insert(all.slots[at].name.text(), at) }
        at += 1
    }
    let mut names = index.keys().collect()
    names.sort()
    let body = names
        .map fn(name) {
            let s = all.slots[index[name] ?? panic("a key")]
            f"{name}={tenths(s.min)}/{tenths(mean(s.sum, s.count))}/{tenths(s.max)}"
        }
        .join(", ")
    println(f"{{{body}}}")
}

// The official rounding: a tie goes toward +infinity (`naive.nika`).
fn mean(sum: i64, count: i64) -> i64 {
    return (2 * sum + count).div_euclid(2 * count)
}

fn tenths(t: i64) -> String {
    if t < 0 {
        let a = -t
        return f"-{a / 10}.{a % 10}"
    }
    return f"{t / 10}.{t % 10}"
}
