+// DERIVED FIX (8-byte read at the end of the file): a row is at most 107
+// bytes (100-byte name, ';', "-99.9", '\n'), so a row that starts at least
+// TAIL_MARGIN bytes before the end of the mapping has 8 readable bytes after
+// its temperature. The rows after that point are parsed from a small
+// zero-padded copy, as beowolx/fast_1brc does; the input file is not padded.
+const TAIL_MARGIN: usize = 109;
+
 fn process_chunk(data: &[u8], start: usize, end: usize) -> FlatTable {
     let mut t = FlatTable::new();
+    let fast_end = end.min(data.len().saturating_sub(TAIL_MARGIN));
+    let i = process_rows(&mut t, data, start, fast_end, end);
+    if i < end {
+        let mut tail = data[i..end].to_vec();
+        tail.resize(end - i + 8, 0);
+        process_rows(&mut t, &tail, 0, end - i, end - i);
+    }
+    t
+}
+
+/// The original loop, unchanged except that it stops at the first row that
+/// starts at or after `stop`; `end` still bounds the `;` search.
+#[inline(always)]
+fn process_rows(t: &mut FlatTable, data: &[u8], start: usize, stop: usize, end: usize) -> usize {
     let mut i = start;
-    while i < end {
+    while i < stop {
         let semi = i + find_semi(&data[i..end]).expect("semi");
         let name = &data[i..semi];
         let h = fxhash(name);
@@ -57,7 +78,7 @@ fn process_chunk(data: &[u8], start: usize, end: usize) -> FlatTable {
         t.stats[idx].update(temp);
         i = semi + 1 + consumed;
     }
-    t
+    i
 }
 
