// The Benchmarks Game's `binary-trees`: complete binary trees built bottom
// up, walked to count their nodes, and dropped. First a stretch tree one
// deeper than the largest; then a long-lived tree of the largest depth, kept
// to the end; between them, for each even depth from 4 up, many short-lived
// trees, 2^(largest - depth + 4) of them, built and counted one at a time.
//
//     nikaia run main.nika -- 10
//     stretch tree of depth 11	 check: 4095
//     1024	 trees of depth 4	 check: 31744
//     256	 trees of depth 6	 check: 32512
//     64	 trees of depth 8	 check: 32704
//     16	 trees of depth 10	 check: 32752
//     long lived tree of depth 10	 check: 2047
//
// The argument is the largest depth (10 if left out, at least 6); the game's
// published output for 10 is the lines above. Written as a Nikaia programmer
// writes it first: a recursive enum, each node its own allocation. Its
// allocator is the program's (ADR-327 D9): the system's malloc, each call
// counted against the running task; the Rust entry puts each tree in a
// bumpalo arena and frees it whole.
use std::cli
use std::text

enum Tree {
	Leaf,
	Node(Tree, Tree),
}

fn bottom_up(depth: i64) -> Tree sync {
	if depth == 0 { return Tree::Leaf }
	return Tree::Node(bottom_up(depth - 1), bottom_up(depth - 1))
}

// The number of nodes of `tree`.
fn check(tree: Tree) -> i64 sync {
	match tree {
		Tree::Leaf => { return 1 }
		Tree::Node(left, right) => { return 1 + check(left) + check(right) }
	}
}

fn main() throws {
	let n = text::parse_i64(cli::args().nth(1) ?? "10") ?? 10
	let min_depth = 4
	let mut max_depth = n
	if max_depth < min_depth + 2 {
		max_depth = min_depth + 2
	}
	let stretch = max_depth + 1
	println(f"stretch tree of depth {stretch}\t check: {check(bottom_up(stretch))}")
	let long_lived = bottom_up(max_depth)
	let mut depth = min_depth
	while depth <= max_depth {
		let iterations = 1 << (max_depth - depth + min_depth)
		let mut sum = 0
		for _ in 0..<iterations {
			sum = sum + check(bottom_up(depth))
		}
		println(f"{iterations}\t trees of depth {depth}\t check: {sum}")
		depth = depth + 2
	}
	println(f"long lived tree of depth {max_depth}\t check: {check(long_lived)}")
}
