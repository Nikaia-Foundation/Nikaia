// The Benchmarks Game programs against the fastest Rust entry of each (#1611):
// it builds every program at both overflow-check settings, checks that all of
// one problem print the same output byte for byte, counts each with callgrind
// and prints the table, with each program's length in tokens.
//
//     nikaia run benches/game/game.nika              every problem
//     nikaia run benches/game/game.nika -- n-body    one
//     nikaia run benches/game/game.nika -- json      json-small, -large, -deep
//
// `$NIKAIA` names the compiler; else the `nikaia` on the path, else a release
// build of the repository's own.
//
// Counts, not a clock (docs/measuring.md): instructions and mispredicted
// branches (`--branch-sim=yes`, conditional and indirect) over the whole
// process, divided by the problem's unit (a step, a row). The Rust entry is
// built as the game builds it (`opt-level = 3`, one codegen unit, its
// `target-cpu`); the Nikaia program as a user builds it, with the same
// `opt-level` and unit count, once for the default CPU level and once for
// `x86-64-v3`, the least level that holds the game's `ivybridge`.
use std::cli
use std::fs
use std::process
use std::text

// One problem of the game.
struct Game {
	// The game's name for it, also the directory under `benches/game/` and
	// the Rust binary's name.
	name: String,
	// The arguments every program of it runs with.
	args: String,
	// What the counts are divided by, and its name in the table; 0 is the
	// size of the standard input in bytes.
	units: i64,
	unit: String,
	// The Nikaia program, from the repository's root, as a Nikaia programmer
	// writes it first, and written for speed (empty where it is the same).
	nikaia: String,
	speed: String,
	// The Rust entry: its source and the `target-cpu` the game builds it for.
	rust: String,
	label: String,
	cpu: String,
	// Where the entry runs on threads: the environment that holds it to one,
	// for a second row (callgrind serialises threads and counts them all).
	one_thread: String,
	// The environment the entry's own row runs in (`VAR=value`, a command
	// before it), else empty: where its threads wait for each other by
	// spinning, callgrind's serialised threads count the spinning, not the
	// work, so it is held to one there.
	rust_env: String,
	// A shell filter the output is passed through for the table's head,
	// where it is too long to show (empty: shown whole).
	shown: String,
	// Where the programs read standard input: another problem and its
	// arguments (`fasta 250000`), whose Rust entry's output is the input,
	// or a Nikaia program and its arguments (`benches/game/json/input.nika
	// large`), whose output is (empty: none).
	input: String,
	// The Rust binary, where it is not `name` (one serves several problems).
	bin: String = "",
	// An official package the Nikaia programs take in, `packages/{package}`
	// (empty: none).
	package: String = "",
}

fn games() -> Vec[Game] {
	return [
		Game {
			name: "n-body",
			args: "1000000",
			units: 1000000,
			unit: "step",
			nikaia: "examples/n-body/src/main.nika",
			speed: "benches/game/n-body/speed.nika",
			rust: "benches/game/n-body/rust-9.rs",
			label: "Rust #9",
			cpu: "ivybridge",
			one_thread: "",
			rust_env: "",
			shown: "",
			input: "",
		},
		Game {
			name: "spectral-norm",
			args: "1000",
			units: 40000000,
			unit: "matrix entry",
			nikaia: "benches/game/spectral-norm/main.nika",
			speed: "benches/game/spectral-norm/speed.nika",
			rust: "benches/game/spectral-norm/rust-6.rs",
			label: "Rust #6",
			cpu: "ivybridge",
			one_thread: "RAYON_NUM_THREADS=1",
			rust_env: "",
			shown: "",
			input: "",
		},
		Game {
			name: "fannkuch-redux",
			args: "10",
			units: 3628800,
			unit: "permutation",
			nikaia: "benches/game/fannkuch-redux/main.nika",
			speed: "benches/game/fannkuch-redux/speed.nika",
			rust: "benches/game/fannkuch-redux/rust-6.rs",
			label: "Rust #6",
			cpu: "ivybridge",
			one_thread: "RAYON_NUM_THREADS=1",
			rust_env: "",
			shown: "",
			input: "",
		},
		Game {
			name: "binary-trees",
			args: "16",
			units: 14985902,
			unit: "tree node",
			nikaia: "benches/game/binary-trees/main.nika",
			speed: "",
			rust: "benches/game/binary-trees/rust-5.rs",
			label: "Rust #5",
			cpu: "ivybridge",
			one_thread: "RAYON_NUM_THREADS=1",
			rust_env: "",
			shown: "",
			input: "",
		},
		// 10n letters, the output also the input of k-nucleotide and
		// reverse-complement. The entry takes min(CPUs, 2) threads that wait
		// for their turn by spinning, which under callgrind never ends in
		// reasonable time (ten minutes, unfinished): it is counted on one CPU,
		// which holds it to one thread.
		Game {
			name: "fasta",
			args: "2500000",
			units: 25000000,
			unit: "letter",
			nikaia: "benches/game/fasta/main.nika",
			speed: "benches/game/fasta/speed.nika",
			rust: "benches/game/fasta/rust-7.rs",
			label: "Rust entry 7",
			cpu: "ivybridge",
			one_thread: "",
			rust_env: "taskset -c 0",
			shown: "md5sum | cut -c1-32",
			input: "",
		},
		// The input is fasta's output at 250000 (2500000 letters); section
		// THREE, which is counted, holds 1250000 of them, the unit. The
		// game's own input is fasta's at 25000000; a tenth of it keeps the
		// plain program's callgrind run under a minute.
		Game {
			name: "k-nucleotide",
			args: "",
			units: 1250000,
			unit: "letter of section THREE",
			nikaia: "benches/game/k-nucleotide/main.nika",
			speed: "benches/game/k-nucleotide/speed.nika",
			rust: "benches/game/k-nucleotide/rust-3.rs",
			label: "Rust entry 3",
			cpu: "ivybridge",
			one_thread: "",
			rust_env: "",
			shown: "",
			input: "fasta 250000",
		},
		// The input is fasta's output at 2500000 (25000000 letters, the
		// unit, in 25.4 MB); the game's is fasta's at 25000000, ten times
		// that, which a callgrind run of the plain program does not finish
		// in a minute. The entry reverses blocks of each sequence on rayon's
		// pool, so it gets a row on one thread too.
		Game {
			name: "reverse-complement",
			args: "",
			units: 25000000,
			unit: "letter",
			nikaia: "benches/game/reverse-complement/main.nika",
			speed: "benches/game/reverse-complement/speed.nika",
			rust: "benches/game/reverse-complement/rust-1.rs",
			label: "Rust entry 1",
			cpu: "ivybridge",
			one_thread: "RAYON_NUM_THREADS=1",
			rust_env: "",
			shown: "md5sum | cut -c1-32",
			input: "fasta 2500000",
		},
		// Not a game problem: the json package against serde_json, the
		// library a Rust program uses (#1620). Standard input read into the
		// tree, `json::Value` and `serde_json::Value`, and written back
		// without blanks; the inputs are generated (`json/input.nika`), each
		// counted per byte of it.
		json_game("small"),
		json_game("large"),
		json_game("deep"),
	]
}

fn json_game(input: String) -> Game {
	return Game {
		name: f"json-{input}",
		args: "",
		units: 0,
		unit: "byte of input",
		nikaia: "benches/game/json/tree.nika",
		speed: "",
		rust: "benches/game/json/rust-tree.rs",
		label: "serde_json 1 (`preserve_order`, `arbitrary_precision`)",
		cpu: "x86-64",
		one_thread: "",
		rust_env: "",
		shown: "md5sum | cut -c1-32",
		input: f"benches/game/json/input.nika {input}",
		bin: "json",
		package: "json",
	}
}

fn root() -> String throws {
	return process::run("git", ["rev-parse", "--show-toplevel"]).stdout.trim().clone()
}

fn toolchain(repo: String) -> String throws {
	let exe = sh("echo ${NIKAIA:-$(command -v nikaia)}").stdout.trim().clone()
	if exe.len() > 0 { return exe }
	must(
		f"cargo build -q --release -p nikaia --manifest-path {repo}/Cargo.toml",
		"the compiler's release build",
	)
	return f"{repo}/target/release/nikaia"
}

fn sh(script: String) -> process::Output throws {
	return process::run("sh", ["-c", script])
}

fn must(script: String, what: String) throws {
	let r = sh(script)
	if r.code != 0 {
		println(f"{what} failed (exit {r.code}):\n{r.stdout}{r.stderr}")
		process::exit(1)
	}
}

// --- the builds ------------------------------------------------------------

// One program at both settings.
struct Program {
	name: String,
	on: String,
	off: String,
	// The environment each run of it gets (`VAR=value `), else empty.
	env: String,
	// The source counted for tokens; empty where the row above counted it.
	source: String,
}

// The Rust entries, each setting in a target directory of its own.
fn build_rust(repo: String, work: String, game: Game) -> Program throws {
	let mut bin = game.bin.clone()
	if bin.len() == 0 {
		bin = game.name.clone()
	}
	for setting in ["on", "off"] {
		must(
			f"RUSTFLAGS='-C target-cpu={game.cpu} -C overflow-checks={setting}' CARGO_TARGET_DIR={work}/rust-{game.cpu}-{setting} cargo build -q --release --bin {bin} --manifest-path {repo}/benches/game/Cargo.toml",
			f"cargo build of {game.name} ({setting})",
		)
	}
	let mut env = String()
	let mut held = ""
	if game.rust_env.len() > 0 {
		env.push_str(f"{game.rust_env} ")
		held = f", `{game.rust_env}`"
	}
	return Program {
		name: f"{game.label}{held}, `target-cpu={game.cpu}`",
		on: f"{work}/rust-{game.cpu}-on/release/{bin}",
		off: f"{work}/rust-{game.cpu}-off/release/{bin}",
		env: env,
		source: game.rust.clone(),
	}
}

// The environment of every run of a Nikaia program of `game`. A program
// that reads standard input parks on the `io_uring` ring while an I/O worker
// reads it, and valgrind 3.22 runs that wait (`io_uring_enter` with
// `min_complete` 1) as a call that does not block, holding the lock it runs
// one thread at a time under: the worker never runs and the program waits for
// ever. Such a program runs pinned to the blocking path (`io-method`, the
// runtime's configuration, ADR-303 D5), which reads standard input as the
// ring does, on the worker.
fn nikaia_env(work: String, game: Game) -> String throws {
	if game.input.len() == 0 { return String() }
	fs::write(f"{work}/io-blocking.toml", fs::Root::Anywhere, "io-method = \"blocking\"\n")
	return f"NIKAIA_RUNTIME_CONFIG={work}/io-blocking.toml "
}

// The arguments every program of `game` runs with, its standard input put
// in place: the Rust entry of the problem `game.input` names, or the Nikaia
// program it names, is built and run, and its output written to
// `{work}/out/{name}.input`.
fn run_args(nikaia: String, repo: String, work: String, game: Game) -> String throws {
	if game.input.len() == 0 { return game.args.clone() }
	let words: Vec[String] = game.input.split_whitespace().collect()
	let file = f"{work}/out/{game.name}.input"
	if words[0].ends_with(".nika") {
		let maker = build_nikaia(nikaia, repo, work, game, words[0], "-input", "x86-64")
		must(f"{maker.off} {words[1]} > {file}", f"the input of {game.name} ({game.input})")
	}
	for source in games() {
		if source.name == words[0] {
			let maker = build_rust(repo, work, source)
			must(
				f"{maker.env}{maker.off} {words[1]} > {file}",
				f"the input of {game.name} ({game.input})",
			)
		}
	}
	return f"{game.args} < {file}"
}

// The Nikaia program `source` (`game.nikaia` or `game.speed`, `kind` the
// row's name for it) as a project of its own at the CPU level `cpu`; the
// binaries are copied out to `{work}/bin/{name}{kind}.{cpu}.on` and `.off`.
fn build_nikaia(
	nikaia: String,
	repo: String,
	work: String,
	game: Game,
	source_file: String,
	kind: String,
	cpu: String,
) -> Program throws {
	let dir = f"{work}/{game.name}{kind}"
	let bin = f"{work}/bin/{game.name}{kind}.{cpu}"
	must(f"mkdir -p {dir}/src {work}/bin && cp {repo}/{source_file} {dir}/src/main.nika", "copy")
	fs::write(
		f"{dir}/nikaia.toml",
		fs::Root::Anywhere,
		f"[package]
name = \"game\"
version = \"0.1.0\"

[build.x86_64-linux]
opt-level = 3
codegen-units = 1
incremental = false
{uses(repo, game)}",
	)
	// valgrind 3.22 runs the executor's io_uring_enter wait as a call that
	// does not block, under its one-thread lock, so a program that reads
	// standard input waits for ever under callgrind (#1874): every Nikaia
	// row runs on the blocking path, as the Rust entries read.
	fs::write(f"{dir}/runtime.toml", fs::Root::Anywhere, "io-method = \"blocking\"\n")
	for setting in ["on", "off"] {
		must(
			f"cd {dir} && RUSTFLAGS='-C overflow-checks={setting}' {nikaia} build --cpu={cpu} >build.log 2>&1 && cp target/nikaia/bin/game {bin}.{setting}",
			f"nikaia build of {game.name}{kind} ({cpu}, {setting}, log in {dir}/build.log)",
		)
	}
	let mut source = String()
	if cpu == "x86-64" {
		source.push_str(source_file)
	}
	let mut name: String = f"Nikaia, `--cpu={cpu}`"
	if kind.len() > 0 {
		name = f"Nikaia for speed, `--cpu={cpu}`"
	}
	return Program {
		name: name,
		on: f"{bin}.on",
		off: f"{bin}.off",
		env: f"NIKAIA_RUNTIME_CONFIG={dir}/runtime.toml ",
		source: source,
	}
}

// The manifest's table of the package `game` takes in, else nothing.
fn uses(repo: String, game: Game) -> String {
	if game.package.len() == 0 { return String() }
	return f"\n[dependencies]\n{game.package} = {{ path = \"{repo}/packages/{game.package}\" }}\n"
}

// --- the same output, then the counts --------------------------------------

// Every program at both settings prints the first one's output.
fn same_output(work: String, programs: Vec[Program], args: String) throws {
	let want = f"{work}/out/want"
	must(f"{programs[0].env}{programs[0].on} {args} > {want}", f"{programs[0].on} {args}")
	for p in programs {
		for bin in [p.on.clone(), p.off.clone()] {
			let r = sh(f"{p.env}{bin} {args} | cmp -s - {want}")
			if r.code != 0 {
				println(f"FAIL: {bin} {args} prints another output than {programs[0].on}")
				process::exit(1)
			}
		}
	}
}

struct Count {
	instructions: i64,
	mispredicted: i64,
}

// Instructions and mispredicted branches of one run, from callgrind's totals
// (`events: Ir Bc Bcm Bi Bim`). The totals and valgrind's log are named after
// the binary's path under `work`, so a failure shows its own log, not the last run's (#2359);
// valgrind's `brk segment overflow` there is a warning, not the failure.
fn count(work: String, env: String, bin: String, args: String) -> Count throws {
	let name = bin.replace(f"{work}/", "").replace("/", "-")
	let file = f"{work}/out/{name}.callgrind.out"
	let log = f"{work}/out/{name}.valgrind.log"
	let r = sh(
		f"{env}valgrind --tool=callgrind --branch-sim=yes --callgrind-out-file={file} {bin} {args} > /dev/null 2>{log}",
	)
	if r.code != 0 {
		let tail = sh(f"tail -20 {log}").stdout
		println(f"callgrind of {bin} failed (exit {r.code}); the end of {log}:\n{r.stderr}{tail}")
		process::exit(1)
	}
	let totals = sh(f"grep -E '^(totals|summary):' {file} | head -1").stdout.trim().clone()
	let fields: Vec[String] = totals.split_whitespace().collect()
	return Count {
		instructions: text::parse_i64(fields[1]) ?? 0,
		mispredicted: (text::parse_i64(fields[3]) ?? 0) + (text::parse_i64(fields[5]) ?? 0),
	}
}

// `n / units` to `places` decimals, rounded.
fn per(n: i64, units: i64, places: i64) -> String {
	let mut scale = 1
	for _ in 0..<places {
		scale = scale * 10
	}
	let scaled = (n * scale + units / 2) / units
	let fraction = f"{scaled % scale}"
	if places == 0 { return f"{scaled}" }
	return f"{scaled / scale}.{"0".repeat(places - fraction.len())}{fraction}"
}

fn tokens(repo: String, nikaia: String, source: String) -> String throws {
	if source.len() == 0 { return "" }
	let r = process::run(
		nikaia,
		["run", "scripts/tokens.nika", "--", source]; dir: repo,
	)
	let fields: Vec[String] = r.stdout.trim().split_whitespace().collect()
	return fields[0].clone()
}

// One problem's rows: each program counted at both settings, the last column
// its instructions with checks off against the Rust entry's.
fn measure(
	nikaia: String,
	repo: String,
	work: String,
	game: Game,
	args: String,
	units: i64,
) -> String throws {
	let rust_entry = build_rust(repo, work, game)
	let mut programs: Vec[Program] = [rust_entry.clone()]
	if game.one_thread.len() > 0 {
		programs.push(Program {
			name: f"{game.label}, one thread, `target-cpu={game.cpu}`",
			on: rust_entry.on.clone(),
			off: rust_entry.off.clone(),
			env: f"{game.one_thread} ",
			source: String(),
		})
	}
	programs.extend([
		build_nikaia(nikaia, repo, work, game, game.nikaia, "", "x86-64"),
		build_nikaia(nikaia, repo, work, game, game.nikaia, "", "x86-64-v3"),
	])
	if game.speed.len() > 0 {
		programs.push(build_nikaia(nikaia, repo, work, game, game.speed, "-speed", "x86-64"))
		programs.push(build_nikaia(nikaia, repo, work, game, game.speed, "-speed", "x86-64-v3"))
	}
	same_output(work, programs, args)
	let mut out = String()
	let mut rust = 0
	for p in programs {
		let on = count(work, p.env, p.on, args)
		let off = count(work, p.env, p.off, args)
		if rust == 0 {
			rust = off.instructions
		}
		let i_on = per(on.instructions, units, 1)
		let m_on = per(on.mispredicted, units, 3)
		let i_off = per(off.instructions, units, 1)
		let m_off = per(off.mispredicted, units, 3)
		let against = per(off.instructions, rust, 2)
		let length = tokens(repo, nikaia, p.source.clone())
		out.push_str(f"| {game.name} | {p.name} | {i_on} | {m_on} | {i_off} | {m_off} | {against} | {length} |\n")
	}
	return out
}

fn main() throws {
	let repo = root()
	let mut args = cli::args()
	args.nth(0)
	let only = args.nth(0) ?? ""
	let nikaia = toolchain(repo.clone())
	let work = f"{repo}/target/game-bench"
	must(f"mkdir -p {work}/bin {work}/out", "mkdir")
	must("command -v valgrind", "game.nika needs valgrind (callgrind):")

	let mut table = String()
	let mut said = String()
	for game in games() {
		if only.len() > 0 && game.name != only && !game.name.starts_with(f"{only}-") {
			continue
		}
		let args = run_args(nikaia, repo, work, game)
		let mut units = game.units
		if units == 0 {
			units = text::parse_i64(sh(f"wc -c < {work}/out/{game.name}.input").stdout.trim()) ?? 1
		}
		table.push_str(measure(nikaia, repo, work, game, args, units))
		let mut run = f"{nikaia_env(work, game)}{work}/bin/{game.name}.x86-64.on {args}"
		let mut what = "output"
		if game.shown.len() > 0 {
			run = f"{run} | {game.shown}"
			what = f"output through `{game.shown}`"
		}
		let call: String = f"{game.name} {game.args}"
		let mut how = f"`{call.trim()}`"
		if game.input.len() > 0 {
			how = f"`{call.trim()}` on standard input from `{game.input}`"
		}
		said.push_str(f"{game.name}: per {game.unit}, {how}, {what} `{sh(run).stdout.trim().replace("\n", " ")}`\n")
	}
	let spec = f"{repo}/docs/specification/10-nikaia-light.md"
	let version = sh(f"sed -n 's/^\\*\\*Version:\\*\\* \\([0-9.]*\\).*/\\1/p' {spec}").stdout
		.trim()
		.clone()
	let rustc = sh("rustc --version | cut -d' ' -f1-2").stdout.trim().clone()
	let cpu = sh("grep -m1 'model name' /proc/cpuinfo | cut -d: -f2").stdout.trim().clone()
	println(f"Nikaia {version}, {rustc}, {cpu}")
	println("callgrind; every program of a problem prints the same, byte for byte, at both settings")
	print(said)
	println("")
	println("| problem | program | instructions, checks on | mispredicted, on | instructions, checks off | mispredicted, off | instructions off / Rust | tokens |")
	println("|---|---|---:|---:|---:|---:|---:|---:|")
	print(table)
}
