use std::text

// The official `json` package (ADR-344): JSON text into a `Value`.
//
//     use json
//     let v = json::parse(text) catch { ... }
//
// A program takes it in by path: `json = { path = "../packages/json" }`.
//
// A number is kept as its text, exactly as written (`12.0`, `1e3`, `-0`, a
// whole number outside `i64`): many writers put `12.0` where an integer is
// meant, so the reader does not choose. `as_i64`, `as_u64` and `as_f64` convert
// it when the caller names the type, and throw a `ConvertError` that says what
// was asked for when the text does not fit. An object keeps its members in the order the text gives them, and a member
// given twice stays twice. A failure is an `Error`: the line and the column
// (from 1, in characters) where reading stopped, and the path of the value
// being read there (`$.contacts[3].email`).

pub enum Value {
    Null,
    Bool(bool),
    Number(String),
    Str(String),
    Array(Vec[Value]),
    Object(Vec[Member]),
}

pub struct Member {
    pub key: String,
    pub value: Value,
}

pub struct Error {
    pub message: String,
    pub line: i64,
    pub column: i64,
    pub path: String,
}

impl Error for Error {
    fn message(ref self) -> String {
        return f"{self.line}:{self.column}: {self.message} at {self.path}"
    }
}

// A number asked for as a type it does not fit, or a value that is none.
pub struct ConvertError {
    pub message: String,
}

impl Error for ConvertError {
    fn message(ref self) -> String {
        return self.message.clone()
    }
}

struct Reader {
    cs: Vec[scalar],
    pos: i64,
}

fn fail(r: ref Reader, message: String, path: String) -> Error {
    let mut line = 1
    let mut column = 1
    let mut i = 0
    while i < r.pos && i < r.cs.len() as i64 {
        if r.cs[i] == '\n' {
            line += 1
            column = 1
        } else {
            column += 1
        }
        i += 1
    }
    return Error { message: message, line: line, column: column, path: path }
}

fn at_end(r: ref Reader) -> bool {
    return r.pos >= r.cs.len() as i64
}

// The character at the position; NUL at the end (check `at_end` first where
// the end is an error of its own).
fn peek(r: ref Reader) -> scalar {
    if r.pos < r.cs.len() as i64 {
        return r.cs[r.pos]
    }
    return 0 as scalar
}

fn blanks(mut r: Reader) {
    while r.pos < r.cs.len() as i64 {
        let c = r.cs[r.pos]
        if c == ' ' || c == '\n' || c == '\t' || c == '\r' {
            r.pos += 1
        } else {
            return
        }
    }
}

fn expect_word(mut r: Reader, word: String, path: String) throws {
    for w in word.chars() {
        if at_end(r) {
            throw fail(r, f"expected `{word}`", path.clone())
        }
        let c = peek(r)
        if c != w {
            throw fail(r, f"expected `{word}`", path.clone())
        }
        r.pos += 1
    }
}

fn hex4(mut r: Reader, path: String) -> i64 throws {
    let mut n = 0
    let mut k = 0
    while k < 4 {
        if at_end(r) {
            throw fail(r, "unterminated string", path.clone())
        }
        let c = peek(r)
        let d = c as i64
        let mut v = -1
        if d >= 48 && d <= 57 {
            v = d - 48
        } else if d >= 65 && d <= 70 {
            v = d - 55
        } else if d >= 97 && d <= 102 {
            v = d - 87
        }
        if v < 0 {
            throw fail(r, "expected four hex digits after `\\u`", path.clone())
        }
        n = n * 16 + v
        r.pos += 1
        k += 1
    }
    return n
}

// The string after its opening quote up to and including the closing one.
fn string(mut r: Reader, path: String) -> String throws {
    let mut out = String()
    while true {
        if at_end(r) {
            throw fail(r, "unterminated string", path.clone())
        }
        let c = peek(r)
        let code = c as i64
        if c == '"' {
            r.pos += 1
            return out
        }
        if code < 32 {
            throw fail(r, "control character in string", path.clone())
        }
        if c != '\\' {
            out.push(c)
            r.pos += 1
            continue
        }
        r.pos += 1
        if at_end(r) {
            throw fail(r, "unterminated string", path.clone())
        }
        let e = peek(r)
        if e == 'u' {
            let start = r.pos - 1
            r.pos += 1
            let mut cp = hex4(r, path)
            if cp >= 55296 && cp <= 56319 {
                // A high surrogate needs `\uXXXX` with a low one right after.
                let a = peek(r)
                if a != '\\' {
                    r.pos = start
                    throw fail(r, "lone surrogate", path.clone())
                }
                r.pos += 1
                let b = peek(r)
                if b != 'u' {
                    r.pos = start
                    throw fail(r, "lone surrogate", path.clone())
                }
                r.pos += 1
                let low = hex4(r, path)
                if low < 56320 || low > 57343 {
                    r.pos = start
                    throw fail(r, "lone surrogate", path.clone())
                }
                cp = 65536 + (cp - 55296) * 1024 + (low - 56320)
            } else if cp >= 56320 && cp <= 57343 {
                r.pos = start
                throw fail(r, "lone surrogate", path.clone())
            }
            out.push(cp as scalar)
            continue
        }
        if e == 'n' {
            out.push('\n')
        } else if e == 't' {
            out.push('\t')
        } else if e == 'r' {
            out.push('\r')
        } else if e == 'b' {
            out.push(8 as scalar)
        } else if e == 'f' {
            out.push(12 as scalar)
        } else if e == '"' || e == '\\' || e == '/' {
            out.push(e)
        } else {
            throw fail(r, "unknown escape", path.clone())
        }
        r.pos += 1
    }
    return out
}

fn is_digit(c: scalar) -> bool {
    let d = c as i64
    return d >= 48 && d <= 57
}

fn number(mut r: Reader, path: String) -> Value throws {
    let start = r.pos
    if peek(r) == '-' {
        r.pos += 1
    }
    if peek(r) == '0' {
        r.pos += 1
    } else if is_digit(peek(r)) {
        while is_digit(peek(r)) {
            r.pos += 1
        }
    } else {
        throw fail(r, "expected a digit", path.clone())
    }
    if peek(r) == '.' {
        r.pos += 1
        if !is_digit(peek(r)) {
            throw fail(r, "expected a digit after `.`", path.clone())
        }
        while is_digit(peek(r)) {
            r.pos += 1
        }
    }
    if peek(r) == 'e' || peek(r) == 'E' {
        r.pos += 1
        if peek(r) == '+' || peek(r) == '-' {
            r.pos += 1
        }
        if !is_digit(peek(r)) {
            throw fail(r, "expected a digit in the exponent", path.clone())
        }
        while is_digit(peek(r)) {
            r.pos += 1
        }
    }
    let mut text = String()
    let mut i = start
    while i < r.pos {
        text.push(r.cs[i])
        i += 1
    }
    return Value::Number(text)
}

fn value(mut r: Reader, path: String, depth: i64) -> Value throws {
    blanks(r)
    if at_end(r) {
        throw fail(r, "unexpected end of text", path.clone())
    }
    let c = peek(r)
    if depth > 512 {
        throw fail(r, "nesting too deep", path.clone())
    }
    if c == 'n' {
        expect_word(r, "null", path)
        return Value::Null
    }
    if c == 't' {
        expect_word(r, "true", path)
        return Value::Bool(true)
    }
    if c == 'f' {
        expect_word(r, "false", path)
        return Value::Bool(false)
    }
    if c == '"' {
        r.pos += 1
        return Value::Str(string(r, path))
    }
    if c == '[' {
        r.pos += 1
        let mut items: Vec[Value] = []
        blanks(r)
        if peek(r) == ']' {
            r.pos += 1
            return Value::Array(items)
        }
        while true {
            let at = items.len()
            items.push(value(r, f"{path}[{at}]", depth + 1))
            blanks(r)
            if at_end(r) {
                throw fail(r, "expected `,` or `]`", path.clone())
            }
            let d = peek(r)
            r.pos += 1
            if d == ']' {
                return Value::Array(items)
            }
            if d != ',' {
                r.pos -= 1
                throw fail(r, "expected `,` or `]`", path.clone())
            }
        }
    }
    if c == '{' {
        r.pos += 1
        let mut members: Vec[Member] = []
        blanks(r)
        if peek(r) == '}' {
            r.pos += 1
            return Value::Object(members)
        }
        while true {
            blanks(r)
            if peek(r) != '"' {
                throw fail(r, "expected a member name", path.clone())
            }
            r.pos += 1
            let key = string(r, path)
            blanks(r)
            if peek(r) != ':' {
                throw fail(r, "expected `:`", f"{path}.{key}")
            }
            r.pos += 1
            let v = value(r, f"{path}.{key}", depth + 1)
            members.push(Member { key: key, value: v })
            blanks(r)
            if at_end(r) {
                throw fail(r, "expected `,` or `}`", path.clone())
            }
            let d = peek(r)
            r.pos += 1
            if d == '}' {
                return Value::Object(members)
            }
            if d != ',' {
                r.pos -= 1
                throw fail(r, "expected `,` or `}`", path.clone())
            }
        }
    }
    if c == '-' || is_digit(c) {
        return number(r, path)
    }
    throw fail(r, "unexpected character", path.clone())
}

// The value `text` holds, or the `Error` where it is not JSON. Anything but
// blanks after the value is an error.
pub fn parse(text: String) -> Value throws {
    let mut r = Reader { cs: text.chars().collect(), pos: 0 }
    let v = value(r, "$", 0)
    blanks(r)
    if r.pos < r.cs.len() as i64 {
        throw fail(r, "unexpected character after the value", "$")
    }
    return v
}

fn kind_of(v: ref Value) -> String {
    return match v {
        Value::Null => "null"
        Value::Bool(_) => "a bool"
        Value::Number(_) => "a number"
        Value::Str(_) => "a string"
        Value::Array(_) => "an array"
        Value::Object(_) => "an object"
    }
}

fn number_text(v: ref Value, asked: String) -> String throws {
    return match v {
        Value::Number(t) => t.clone()
        else => throw ConvertError { message: f"expected a number to read as {asked}, found {kind_of(v)}" }
    }
}

// Whether `text` is a whole number written with a zero fraction (`12.0`, `-3.00`)
// and no exponent; `whole` is then the part before the point.
fn zero_fraction(text: String) -> String? {
    let mut whole = String()
    let mut seen = false
    for c in text.chars() {
        if c == 'e' || c == 'E' {
            return null
        }
        if c == '.' {
            seen = true
            continue
        }
        if seen {
            if c != '0' {
                return null
            }
        } else {
            whole.push(c)
        }
    }
    return whole
}

// The number as an `i64`: `12`, `12.0` and `1e3` are 12 and 1000, `12.5` and a
// number beyond `i64` are not.
pub fn as_i64(v: ref Value) -> i64 throws {
    let t = number_text(v, "an i64")
    let direct = text::parse_i64(t.clone())
    if direct != null {
        return direct ?? 0
    }
    let whole = zero_fraction(t.clone())
    if whole != null {
        let n = text::parse_i64(whole ?? "")
        if n != null {
            return n ?? 0
        }
        throw ConvertError { message: f"`{t}` does not fit in an i64" }
    }
    let x = text::parse_f64(t.clone()) ?? 0.0
    if x == x.trunc() && x.abs() < 9007199254740992.0 {
        return x as i64
    }
    throw ConvertError { message: f"`{t}` is not a whole number that fits in an i64" }
}

// As `as_i64`, for a `u64`.
pub fn as_u64(v: ref Value) -> u64 throws {
    let t = number_text(v, "a u64")
    let direct = text::parse_u64(t.clone())
    if direct != null {
        return direct ?? 0
    }
    let whole = zero_fraction(t.clone())
    if whole != null {
        let n = text::parse_u64(whole ?? "")
        if n != null {
            return n ?? 0
        }
        throw ConvertError { message: f"`{t}` does not fit in a u64" }
    }
    let x = text::parse_f64(t.clone()) ?? 0.0
    if x == x.trunc() && x >= 0.0 && x < 9007199254740992.0 {
        return x as u64
    }
    throw ConvertError { message: f"`{t}` is not a whole number that fits in a u64" }
}

// The number as an `f64`; one beyond the range of an `f64` (`1e999`) is not.
pub fn as_f64(v: ref Value) -> f64 throws {
    let t = number_text(v, "an f64")
    let x = text::parse_f64(t.clone()) ?? 0.0
    if x - x != 0.0 {
        throw ConvertError { message: f"`{t}` does not fit in an f64" }
    }
    return x
}
