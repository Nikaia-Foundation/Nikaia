// packages/logic/src/sv_simplex.nika
//
// **The simplex theory** (ADR-270 D12, D11, #1283 item 3): the general
// simplex of Dutertre and de Moura behind the theory interface of
// `sv_theory.nika` - `assert`, `propagate`, `check`, `explain`, `backtrack`,
// `model`, `shared` - the second theory beside Fourier-Motzkin.
//
// Every bound of an atom is a bound on one variable: a query column where
// the atom's form is one column, else the *slack* of its form, one slack per
// distinct form (`x + 2y` and `-2x - 4y` share it, the form divided by its
// gcd and its first coefficient made positive). The slack's definition is a
// row of the tableau: rows of `sv_row.nika` over the simplex's variables,
// integral, `Σ aⱼ·xⱼ - d·x_b = 0` with the basic variable's coefficient the
// row's one denominator `-d`. Values are rationals with the infinitesimal `δ`
// of `sv_num.nika`, so a strict bound `F < c` is `F <= c - δ`.
//
// `check` repairs the basic variables outside their bounds by pivots. The
// leaving variable is the lowest violated one; the entering variable the one
// with the smallest coefficient in its row (D11: small multipliers keep the
// rows small), of those the one in the fewest rows (its pivot combines
// fewer, #1960), and after `bland_after` pivots in one check the lowest
// eligible one, Bland's rule, which cannot cycle. A pivot whose rows would
// leave `i64` is not taken; when no pivot remains the answer is *unknown*,
// `Overflow`. A row with no eligible variable is a conflict: the bounds of
// its variables, each a literal's row divided by its scale, add up to a
// constant contradiction, and that sum is the Farkas lemma written to the
// log, which `sv_check.nika` replays without trusting the simplex.
//
// Integer columns by branch-and-bound (D5): a column with a fractional value
// `v` is split by `x <= ⌊v⌋ ∨ x >= ⌊v⌋ + 1` (`SvBook::split`). With
// `branching` the check searches both sides itself and learns the clause of
// the two refutations by unit propagation; without it, `check` hands the
// split to the engine as a lemma. Backtracking keeps the basis and restores
// the bounds.
//
// Real columns (ADR-270 D27): a variable whose form holds a real column,
// and a tableau row holding such a variable, gets no GCD test, no cut and no
// branch, and a strict bound on it stays `F <= c - δ`. A final check's model
// replaces `δ` by a positive rational small enough for every bound.

use std::bigint
use std::collections

/// One side of a variable's bounds: the variable lies at most (upper) or at
/// least (lower) at `value`, from `src`, whose row is `scale·(F - value)`
/// for the variable's form `F`. `set` is false where there is no bound
/// (#1296: a `null` cannot be stored into a `Vec[SvSide?]`).
pub struct SvSide {
	pub set: bool,
	pub value: SvDelta,
	pub src: SvSrc,
	pub scale: i64,
}

fn sv_sx_unset() -> SvSide {
	return SvSide { set: false, value: sv_sx_zero(), src: SvSrc::Fact(0), scale: 1 }
}

fn sv_sx_zero() -> SvDelta {
	return sv_delta(sv_int(0), sv_int(0))
}

/// A bound the backtrack restores: the side it replaced.
pub struct SvUndo {
	pub var: i64,
	pub upper: bool,
	pub old: SvSide,
}

/// One summand of a Farkas sum: the row of `src` times `num / scale`,
/// negated where `neg`. An upper side `F <= u` with weight `c` is
/// `c·(F - u)`, a lower side `F >= l` is `c·(l - F)`.
pub struct SvPart {
	pub src: SvSrc,
	pub num: i64,
	pub scale: i64,
	pub neg: bool,
}

fn sv_side_part(side: ref SvSide, upper: bool, weight: i64) -> SvPart {
	return SvPart { src: side.src.clone(), num: weight, scale: side.scale, neg: !upper }
}

/// A literal the simplex propagated: the level it holds from, and the
/// bounds it follows from, weighted, the negated literal's weight `d`.
pub struct SvImplied {
	pub lit: u32,
	pub level: i64,
	pub parts: Vec[SvPart],
	pub d: i64,
}

/// What `propagate` reads of a literal's bound, worked out once (#1960):
/// `usable` where the literal has a bound with columns, not an equality,
/// whose negation has one too and whose reading stays in `i64`; then the
/// variable of its form and the reading's side and value.
pub struct SvLitView {
	pub known: bool,
	pub usable: bool,
	pub var: i64,
	pub upper: bool,
	pub value: SvDelta,
}

fn sv_sx_view_unknown() -> SvLitView {
	return SvLitView { known: false, usable: false, var: -1, upper: false, value: sv_sx_zero() }
}

/// A bound as the simplex reads it: `form REL value` on the form divided by
/// its gcd, first coefficient positive; `scale` the factor that gives the
/// atom's row back, `row = scale·(form - value)`.
pub struct SvReading {
	pub form: SvRow,
	pub upper: bool,
	pub lower: bool,
	pub value: SvDelta,
	pub scale: i64,
}

/// The reading of `row REL 0` for a row with columns; `null` where a step
/// leaves `i64`.
fn sv_reading(row: ref SvRow, rel: SvRel) -> SvReading? {
	let g = sv_row_content(row) ?? return null
	let scale = if row.ks[0] < 0 { g.checked_neg() ?? return null } else { g }
	let mut form = SvRow { cols: row.cols.clone(), ks: Vec(capacity: row.ks.len()), constant: 0 }
	for k in row.ks {
		form.ks.push(k / scale)
	}
	let c = sv_rat(row.constant.checked_neg() ?? return null, scale) ?? return null
	let strict = match rel {
		SvRel::Lt => true,
		else => false,
	}
	let eq = match rel {
		SvRel::Eq => true,
		else => false,
	}
	let up = scale > 0
	let k = if !strict { sv_int(0) } else if up { sv_int(-1) } else { sv_int(1) }
	return SvReading {
		form: form,
		upper: eq || up,
		lower: eq || !up,
		value: sv_delta(c, k),
		scale: scale,
	}
}

/// `¬l`. Written as a branch: #1286, #1290.
fn sv_sx_not(l: u32) -> u32 {
	return if l % 2 == 0 { l + 1 } else { l - 1 }
}

/// **The simplex theory**: the variables (query columns met so far, then
/// slacks), the tableau, the values and bounds, the trail and its levels.
pub struct SvSimplex {
	/// Each query column's name, as a model names it.
	names: Vec[String],
	col_var: collections::BTreeMap[u32, i64],
	/// Each variable's query column, `-1` for a slack.
	var_col: Vec[i64],
	/// Each variable's form over the query columns: its column, or the
	/// form its slack stands for.
	var_form: Vec[SvRow],
	slack_of: collections::BTreeMap[String, i64],
	rows: Vec[SvRow],
	/// Each row's basic variable.
	basic: Vec[i64],
	/// Each variable's row, `-1` where it is not basic.
	row_of: Vec[i64],
	values: Vec[SvDelta],
	lower: Vec[SvSide],
	upper: Vec[SvSide],
	undo: Vec[SvUndo],
	trail: Vec[u32],
	/// Per level above zero: the undo stack's and the trail's length when
	/// it began.
	levels: Vec[i64],
	marks: Vec[i64],
	implied: Vec[SvImplied],
	/// Per literal: how often it stands on the trail or among `implied`,
	/// so `propagate` skips it without scanning either (#1960).
	held: Vec[i64],
	/// Per literal: its bound as `propagate` reads it (`SvLitView`); the
	/// book's atoms only grow, so a view never changes once known.
	views: Vec[SvLitView],
	/// Per variable: whether a bound of it was tightened since the last
	/// `propagate`; per row: whether it was made or changed by a pivot since
	/// then; and the atoms the last `propagate` saw. `propagate` reads only
	/// these rows and atoms again (#1960: every row's bound on every call was
	/// a third of the work on `c_inference`). Bounds only tighten between two
	/// calls but for a backtrack, which only removes what they implied.
	touched: Vec[bool],
	row_dirty: Vec[bool],
	seen_atoms: u32,
	/// The variables whose `touched` and the rows whose `row_dirty` is
	/// set, each once, so `propagate` neither scans nor clears them all
	/// (#2401).
	touched_list: Vec[i64],
	dirty_list: Vec[i64],
	/// What a backtrack makes `propagate` read again (#2401): per level
	/// above zero, `seen_atoms` and the lengths of `row_log` and `var_log`
	/// when it began; `row_log` the rows marked to read again since (a
	/// pivot's or a new row, or one waiting when a level began), `var_log`
	/// the variables waiting as `touched` when a level began. A backtrack
	/// to a level marks these again: what a later level read of them was
	/// read against bounds that are gone. A row or a bound left as it was
	/// implies after the backtrack what it implied when the level was
	/// read, and that was propagated then.
	level_seen: Vec[u32],
	level_rows: Vec[i64],
	level_vars: Vec[i64],
	row_log: Vec[i64],
	var_log: Vec[i64],
	/// The atoms of the literals a backtrack took out of `implied`, each
	/// once, read again as new by the next `propagate`: one the SAT core
	/// had not taken yet (a backjump while it took the call's literals)
	/// may still follow from the bounds and rows that stay.
	redo: Vec[u32],
	redo_in: Vec[bool],
	/// Per variable: the atoms whose view reads it, and the rows that hold
	/// it, unordered and possibly with rows that lost it since (dropped by
	/// `compact` when the column is read: a search for each lost entry
	/// cost more than the pivot, ADR-270 D10's column index). `propagate` reads only
	/// the atoms of a touched variable or of the basic variable of a row
	/// to read again, and a pivot or a refresh only the rows of its column
	/// (#2401: every atom on every call was half the work on
	/// `c_inference`).
	var_atoms: Vec[Vec[u32]],
	col_rows: Vec[Vec[i64]],
	/// `compact`'s calls and the call that last kept each row.
	mark_round: i64,
	row_mark: Vec[i64],
	/// `propagate`'s calls, and the call that last marked each row to
	/// read again, worked out each row side's bound (`rb_has`, `rb_val`)
	/// and took each atom.
	prop_call: i64,
	exam_at: Vec[i64],
	rb_at: Vec[i64],
	rb_has: Vec[bool],
	rb_val: Vec[SvDelta],
	atom_at: Vec[i64],
	/// Stamps for the GCD test (#1960): a counter raised at each change, the
	/// last change of each variable's bounds and of each row, and when each
	/// row last passed the test. A row whose row and bounds did not change
	/// since it passed passes again, and is not tested.
	stamp: i64,
	bound_at: Vec[i64],
	row_at: Vec[i64],
	gcd_at: Vec[i64],
	/// The rows whose row changed since the last GCD test, and the
	/// variables whose bounds did, each once: only their rows can fail
	/// the test again.
	gcd_rows: Vec[i64],
	gcd_row_in: Vec[bool],
	gcd_vars: Vec[i64],
	/// Rows a pivot replaced, whose room the next pivot's rows take
	/// (#2401).
	spare: Vec[SvRow],
	gcd_var_in: Vec[bool],
	/// The number of rows each variable occurs in (ADR-270 D10's column
	/// index, its sizes): the entering rule prefers the shorter column,
	/// whose pivot combines fewer rows (#1960).
	col_count: Vec[i64],
	pub found: collections::BTreeMap[String, i64],
	/// The values of the last consistent final check as rationals, a real
	/// column's with `δ` replaced (ADR-270 D27); empty where a step left
	/// `i64`.
	pub found_real: collections::BTreeMap[String, SvRat],
	/// The query's real columns, ascending: a variable whose form holds one
	/// gets no GCD test, cut or branch (ADR-270 D27).
	pub reals: Vec[u32],
	/// Whether `check` searches a split itself (branch-and-bound) or hands
	/// it to the engine as a lemma.
	pub branching: bool,
	/// Pivots in one check before Bland's rule takes over.
	pub bland_after: i64,
	/// Pivots in one check before the check gives up.
	pub pivot_limit: i64,
	/// Whether a final check runs the GCD test on the tableau's rows.
	pub gcd_test: bool,
	/// The cut a final check tries before a split: `"gmi"` (Gomory
	/// mixed-integer, a split cut), `"cg"` (Gomory's fractional cut, a
	/// Chvátal-Gomory derivation) or `"none"`.
	pub cut_kind: String,
	/// Cuts in a row, each over the last, before the check splits.
	pub cut_rounds: i64,
	pub cut_depth: i64,
	/// What the theory did, for the runner's work column.
	pub pivots: i64,
	pub splits: i64,
	pub overflows: i64,
	pub cuts: i64,
	pub gcd_conflicts: i64,
	/// The stage past `i64` (#2707): whether the query went on there, its
	/// rows (indexed as `rows`, which it leaves behind) and values, the work
	/// spent there (pivots and 64-bit digit products) against
	/// `big_budget`, and how often it was entered.
	big_on: bool,
	big_rows: Vec[SvBigRow],
	big_values: Vec[SvBigDelta],
	big_work: i64,
	pub big_budget: i64,
	pub resumed: i64,
}

fn sv_simplex(names: Vec[String]) -> SvSimplex {
	return SvSimplex {
		names: names,
		col_var: collections::BTreeMap(),
		var_col: [],
		var_form: [],
		slack_of: collections::BTreeMap(),
		rows: [],
		basic: [],
		row_of: [],
		values: [],
		lower: [],
		upper: [],
		undo: [],
		trail: [],
		levels: [],
		marks: [],
		implied: [],
		held: [],
		views: [],
		touched: [],
		row_dirty: [],
		seen_atoms: 0,
		touched_list: [],
		dirty_list: [],
		level_seen: [],
		level_rows: [],
		level_vars: [],
		row_log: [],
		var_log: [],
		redo: [],
		redo_in: [],
		var_atoms: [],
		col_rows: [],
		mark_round: 0,
		row_mark: [],
		prop_call: 0,
		exam_at: [],
		rb_at: [],
		rb_has: [],
		rb_val: [],
		atom_at: [],
		stamp: 0,
		bound_at: [],
		row_at: [],
		gcd_at: [],
		gcd_rows: [],
		gcd_row_in: [],
		gcd_vars: [],
		spare: [],
		gcd_var_in: [],
		col_count: [],
		found: collections::BTreeMap(),
		found_real: collections::BTreeMap(),
		reals: [],
		branching: true,
		bland_after: 64,
		pivot_limit: 100000,
		gcd_test: true,
		cut_kind: "gmi",
		cut_rounds: 8,
		cut_depth: 0,
		pivots: 0,
		splits: 0,
		overflows: 0,
		cuts: 0,
		gcd_conflicts: 0,
		big_on: false,
		big_rows: [],
		big_values: [],
		big_work: 0,
		big_budget: 50000000,
		resumed: 0,
	}
}

/// The parts of a Farkas sum with integer multipliers over their common
/// denominator, divided by their gcd, written to the log as the clause of
/// the negated literals it assumes. `null`, nothing written, where a step
/// leaves `i64` or the sum is no contradiction.
fn sv_sx_lemma(parts: ref Vec[SvPart], mut book: SvBook) -> SvClause? {
	let mult = sv_sx_multipliers(parts) ?? return null
	return sv_sx_lemma_of(mult, book)
}

/// `sv_sx_lemma` of multipliers already worked out.
fn sv_sx_lemma_of(mult: SvMult, mut book: SvBook) -> SvClause? {
	let mut row = sv_row_constant(0)
	let mut equality = true
	let mut strict = false
	let mut i = 0
	while i < mult.sources.len() {
		let b = book.source(mult.sources[i]) ?? return null
		let m = mult.ms[i]
		let is_eq = match b.rel {
			SvRel::Eq => true,
			else => false,
		}
		let is_lt = match b.rel {
			SvRel::Lt => true,
			else => false,
		}
		if !is_eq && m < 0 {
			return null
		}
		equality = equality && is_eq
		strict = strict || (is_lt && m > 0)
		row = sv_row_sum(1, row, m, b.row) ?? return null
		i += 1
	}
	if row.cols.len() > 0 {
		return null
	}
	let c = row.constant
	let closes = if equality { c != 0 } else if strict { c >= 0 } else { c > 0 }
	if !closes {
		return null
	}
	let assumed = book.log.walk.assumed(book.log.steps, mult.sources, mult.ms) ?? return null
	let mut lits: Vec[u32] = []
	for l in assumed {
		lits.push(sv_sx_not(l))
	}
	lits.sort()
	let id = book.log.farkas(lits.clone(), mult.sources, mult.ms, 1)
	return SvClause { id: id, lits: lits }
}

/// The sources of a Farkas sum and their integer multipliers.
pub struct SvMult {
	pub sources: Vec[SvSrc],
	pub ms: Vec[i64],
}

/// The parts' multipliers over their common denominator, divided by their
/// gcd; `null` where a step leaves `i64`.
fn sv_sx_multipliers(parts: ref Vec[SvPart]) -> SvMult? {
	let mut common: i64 = 1
	for p in parts {
		let a = p.scale.checked_abs() ?? return null
		let g = sv_gcd(common, a) ?? return null
		common = (common / g).checked_mul(a) ?? return null
	}
	let mut sources: Vec[SvSrc] = []
	let mut ms: Vec[i64] = []
	for p in parts {
		let mut m = p.num.checked_mul(common / p.scale) ?? return null
		if p.neg {
			m = m.checked_neg() ?? return null
		}
		if m != 0 {
			sources.push(p.src.clone())
			ms.push(m)
		}
	}
	let g = sv_content(ms) ?? return null
	if g > 1 {
		let mut reduced: Vec[i64] = []
		for m in ms {
			reduced.push(m / g)
		}
		ms = reduced
	}
	return SvMult { sources: sources, ms: ms }
}

/// A tableau row past `i64` (#2707): `Σ aⱼ·xⱼ = 0`, its variables
/// ascending, no zero coefficient, the gcd of the coefficients 1; the basic
/// variable's coefficient is negative.
pub struct SvBigRow {
	pub cols: Vec[i64],
	pub ks: Vec[bigint::BigInt],
}

/// A combined row and the 64-bit digit products it took.
pub struct SvBigMade {
	pub row: SvBigRow,
	pub work: i64,
}

/// Where variable `v` stands in row `x`, `-1` where it does not.
fn sv_big_find(x: ref SvBigRow, v: i64) -> i64 {
	let mut lo = 0
	let mut hi = x.cols.len()
	while lo < hi {
		let mid = (lo + hi) / 2
		if x.cols[mid] < v {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo < x.cols.len() && x.cols[lo] == v {
		return lo
	}
	return -1
}

/// Row `x`'s coefficient of variable `v`, zero where it has none.
fn sv_big_coef(x: ref SvBigRow, v: i64) -> bigint::BigInt {
	let at = sv_big_find(x, v)
	if at < 0 {
		return sv_big(0)
	}
	return x.ks[at].clone()
}

/// The row of `ks` divided by their gcd.
fn sv_big_reduced(cols: Vec[i64], ks: Vec[bigint::BigInt]) -> SvBigRow {
	let one = sv_big(1)
	let mut g = sv_big(0)
	for k in ks {
		g = g.gcd(k)
		if g == one {
			break
		}
	}
	if g.sign() == 0 || g == one {
		return SvBigRow { cols: cols, ks: ks }
	}
	let mut out: Vec[bigint::BigInt] = Vec(capacity: ks.len())
	for k in ks {
		out.push(sv_big_quo(k, g))
	}
	return SvBigRow { cols: cols, ks: out }
}

/// `mx·x + my·y`, divided by the gcd of its coefficients.
fn sv_big_combine(x: ref SvBigRow, mx: ref bigint::BigInt, y: ref SvBigRow, my: ref bigint::BigInt) -> SvBigMade {
	let dx = sv_big_digits(mx)
	let dy = sv_big_digits(my)
	let mut work = 0
	let mut cols: Vec[i64] = []
	let mut ks: Vec[bigint::BigInt] = []
	let mut i = 0
	let mut j = 0
	while i < x.cols.len() || j < y.cols.len() {
		let take_x = j >= y.cols.len() || (i < x.cols.len() && x.cols[i] <= y.cols[j])
		let take_y = i >= x.cols.len() || (j < y.cols.len() && y.cols[j] <= x.cols[i])
		let mut k = sv_big(0)
		let mut col = 0
		if take_x {
			col = x.cols[i]
			k = x.ks[i].mul(mx)
			work += dx * sv_big_digits(x.ks[i])
			i += 1
		}
		if take_y {
			col = y.cols[j]
			k = k.add(y.ks[j].mul(my))
			work += dy * sv_big_digits(y.ks[j])
			j += 1
		}
		if k.sign() != 0 {
			cols.push(col)
			ks.push(k)
		}
	}
	return SvBigMade { row: sv_big_reduced(cols, ks), work: work }
}

/// `-x`.
fn sv_big_negated(x: ref SvBigRow) -> SvBigRow {
	let mut ks: Vec[bigint::BigInt] = Vec(capacity: x.ks.len())
	for k in x.ks {
		ks.push(k.neg())
	}
	return SvBigRow { cols: x.cols.clone(), ks: ks }
}

impl SvSimplex {
	/// A new variable for query column `col` (`-1`: a slack), non-basic,
	/// value zero, no bounds.
	fn new_var(ref mut self, col: i64) -> i64 {
		let v = self.var_col.len()
		self.var_col.push(col)
		if col >= 0 {
			self.var_form.push(SvRow { cols: [col.checked_u32() ?? 0], ks: [1], constant: 0 })
		} else {
			self.var_form.push(sv_row_constant(0))
		}
		self.row_of.push(-1)
		self.touched.push(true)
		self.touched_list.push(v)
		self.var_atoms.push([])
		self.col_rows.push([])
		self.gcd_var_in.push(false)
		self.bound_at.push(0)
		self.col_count.push(0)
		self.values.push(sv_sx_zero())
		if self.big_on {
			self.big_values.push(sv_big_delta_zero())
		}
		self.lower.push(sv_sx_unset())
		self.upper.push(sv_sx_unset())
		return v
	}

	/// The variable of query column `col`, made where it is new.
	fn column_var(ref mut self, col: u32) -> i64 {
		let known: i64? = self.col_var.get(col)
		// `known ?? 0` after the test, not `return known`: #1291.
		if known != null {
			return known ?? 0
		}
		let v = self.new_var(col as i64)
		self.col_var.insert(col, v)
		return v
	}

	/// The variable of a reading's form, `-1` where there is none yet.
	pub fn find_var(ref self, form: ref SvRow) -> i64 sync {
		if form.cols.len() == 1 && form.ks[0] == 1 {
			let v: i64? = self.col_var.get(form.cols[0])
			return v ?? -1
		}
		let s: i64? = self.slack_of.get(sv_row_text(form))
		return s ?? -1
	}

	/// The variable of a reading's form: its column, or its slack, made with
	/// its tableau row where it is new (`Σ aⱼ·xⱼ - s = 0`, its basic
	/// variables replaced by their rows); `null` where a step leaves `i64`.
	fn form_var(ref mut self, form: ref SvRow) -> i64? {
		if form.cols.len() == 1 && form.ks[0] == 1 {
			return self.column_var(form.cols[0])
		}
		let key = sv_row_text(form)
		let known: i64? = self.slack_of.get(key)
		if known != null {
			return known ?? 0
		}
		let mut terms: Vec[SvTerm] = []
		let mut i = 0
		while i < form.cols.len() {
			let v = self.column_var(form.cols[i])
			terms.push(SvTerm { col: v.checked_u32() ?? return null, k: form.ks[i] })
			i += 1
		}
		let s = self.new_var(-1)
		self.var_form[s] = form.clone()
		terms.push(SvTerm { col: s.checked_u32() ?? return null, k: -1 })
		let mut row = sv_row_of(terms, 0) ?? return null
		// Past `i64` the row stays as written, a place holder: `big_rows`
		// has the row. Where an elimination leaves `i64`, the stage past it
		// begins once the row is counted (#2707).
		let mut left = false
		if !self.big_on {
			let cols = row.cols.clone()
			for c in cols {
				let at = self.row_of[c as i64]
				if at >= 0 && sv_row_coef(row, c) != 0 {
					let next = sv_row_eliminate_exact(row, self.rows[at], c)
					if next == null {
						left = true
						break
					}
					row = next ?? break
				}
			}
		}
		self.rows.push(row)
		let r = self.rows.len() - 1
		self.row_dirty.push(true)
		self.dirty_list.push(r)
		if self.levels.len() > 0 {
			self.row_log.push(r)
		}
		self.exam_at.push(-1)
		self.row_mark.push(-1)
		for _ in 0..<2 {
			self.rb_at.push(-1)
			self.rb_has.push(false)
			self.rb_val.push(sv_sx_zero())
		}
		self.stamp += 1
		self.row_at.push(self.stamp)
		self.gcd_at.push(-1)
		self.gcd_row_in.push(false)
		self.gcd_row(r)
		for c in self.rows[r].cols {
			self.col_count[c as i64] += 1
			self.col_rows[c as i64].push(r)
		}
		self.basic.push(s)
		self.row_of[s] = r
		self.slack_of.insert(key, s)
		if self.big_on {
			self.big_add_row(s)
			return s
		}
		let value = if left { null } else { self.row_value(r) ?? self.row_value_wide(r) }
		if value == null {
			self.overflows += 1
			return if self.big_enter() { s } else { null }
		}
		self.values[s] = value ?? return null
		return s
	}

	/// The value row `r` gives its basic variable, `Σ aⱼ·βⱼ / d`.
	fn row_value(ref self, r: i64) -> SvDelta? {
		let b = self.basic[r]
		let mut sum = sv_sx_zero()
		let mut d: i64 = 0
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let k = self.rows[r].ks[i]
			if v == b {
				d = k.checked_neg() ?? return null
			} else {
				let term = sv_delta_scale(self.values[v], sv_int(k)) ?? return null
				sum = sv_delta_add(sum, term) ?? return null
			}
			i += 1
		}
		let inverse = sv_rat(1, d) ?? return null
		return sv_delta_scale(sum, inverse)
	}

	/// `row_value` where a product or a partial sum leaves `i64` though the
	/// value fits (#2101: coefficients near `2^62` times values of `±1`): each
	/// part of the values over the lcm of its denominators, `Σ aⱼ·βⱼ` in
	/// double width, divided by `d` and the lcm once at the end, so `null`
	/// only where the value itself does not fit (ADR-270 D11).
	fn row_value_wide(ref self, r: i64) -> SvDelta? {
		let c = self.row_part_wide(r, true) ?? return null
		let k = self.row_part_wide(r, false) ?? return null
		return SvDelta { c: c, k: k }
	}

	/// The real part (`real`) or the `δ` part of `row_value_wide`.
	fn row_part_wide(ref self, r: i64, real: bool) -> SvRat? {
		let b = self.basic[r]
		let mut l: i64 = 1
		let mut d: i64 = 0
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let k = self.rows[r].ks[i]
			i += 1
			if v == b {
				d = k.checked_neg() ?? return null
				continue
			}
			let x = if real { self.values[v].c } else { self.values[v].k }
			if x.num != 0 {
				let g = sv_gcd(l, x.den) ?? return null
				l = (l / g).checked_mul(x.den) ?? return null
			}
		}
		let mut sum = Wide::of(0)
		i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let k = self.rows[r].ks[i]
			i += 1
			let x = if real { self.values[v].c } else { self.values[v].k }
			if v != b && x.num != 0 {
				let term = Wide::product(k, x.num).mul(l / x.den) ?? return null
				sum = sum.add(term) ?? return null
			}
		}
		return sv_wide_ratio(sum, l.checked_mul(d) ?? return null)
	}

	/// The basic values after non-basic variable `v` took a new value: each
	/// row that holds `v` worked out again; false where a step leaves `i64`.
	/// A basic variable stands in its own row only, so a row without `v`
	/// keeps its value, and only these rows change (#1962: a refresh of
	/// every row was a third of the work on `ring_2exp4_5vars_3ite`).
	///
	/// `old` is `v`'s value before: a row's basic value moves by
	/// `a·(new - old) / d` for `v`'s coefficient `a` and the basic one `-d`,
	/// not worked out over the whole row again (#1960); only where that
	/// step leaves `i64` the row is summed again.
	fn refresh(ref mut self, v: i64, old: ref SvDelta) -> bool {
		let col = v.checked_u32() ?? return false
		let moved = sv_delta_sub(self.values[v], old)
		// `v`'s list read once, each row in it once (`row_mark`).
		self.mark_round += 1
		let round = self.mark_round
		let mut i = 0
		while i < self.col_rows[v].len() {
			let r = self.col_rows[v][i]
			i += 1
			let a = if self.row_mark[r] == round { 0 } else { sv_row_coef(self.rows[r], col) }
			if a != 0 {
				self.row_mark[r] = round
				let b = self.basic[r]
				let stepped = self.row_step(r, b, a, moved)
				if stepped != null {
					self.values[b] = stepped ?? return false
				} else {
					self.values[b] = self.row_value(r) ?? self.row_value_wide(r) ?? return false
				}
			}
		}
		return true
	}

	/// Basic variable `b`'s value in row `r` after a variable with
	/// coefficient `a` in it moved by `moved`; `null` where a step leaves
	/// `i64` or there is no move.
	fn row_step(ref self, r: i64, b: i64, a: i64, moved: ref SvDelta?) -> SvDelta? {
		let by = moved ?? return null
		let d = sv_row_coef(self.rows[r], b.checked_u32() ?? return null).checked_neg()
			?? return null
		let factor = sv_rat(a, d) ?? return null
		let change = sv_delta_scale(by, factor) ?? return null
		return sv_delta_add(self.values[b], change)
	}

	fn bound(ref mut self, row: SvRow, rel: SvRel, src: SvSrc, mut book: SvBook) -> SvChecked {
		if row.cols.len() == 0 {
			let c = row.constant
			let fails = match rel {
				SvRel::Le => c > 0,
				SvRel::Lt => c >= 0,
				SvRel::Eq => c != 0,
			}
			if !fails {
				return SvChecked::Consistent
			}
			return self.conflict([SvPart { src: src, num: 1, scale: 1, neg: false }], book)
		}
		let reading = sv_reading(row, rel) ?? return self.overflow()
		let v = self.form_var(reading.form) ?? return self.overflow()
		if reading.upper {
			let side = SvSide {
				set: true,
				value: reading.value.clone(),
				src: src.clone(),
				scale: reading.scale,
			}
			let done = self.tighten(v, true, side, book)
			match done {
				SvChecked::Consistent => {},
				else => {
					return done
				},
			}
		}
		if reading.lower {
			let side = SvSide {
				set: true,
				value: reading.value.clone(),
				src: src.clone(),
				scale: reading.scale,
			}
			return self.tighten(v, false, side, book)
		}
		return SvChecked::Consistent
	}

	/// The side `side` on variable `v`, where it is tighter than the one it
	/// has; a non-basic variable outside it moves onto it.
	fn tighten(ref mut self, v: i64, upper: bool, side: SvSide, mut book: SvBook) -> SvChecked {
		let had = if upper { self.upper[v].clone() } else { self.lower[v].clone() }
		if had.set {
			let order = sv_delta_cmp(had.value, side.value)
			if (upper && order <= 0) || (!upper && order >= 0) {
				return SvChecked::Consistent
			}
		}
		let other = if upper { self.lower[v] } else { self.upper[v] }
		if other.set {
			let order = sv_delta_cmp(side.value, other.value)
			if (upper && order < 0) || (!upper && order > 0) {
				return self.conflict(
					[sv_side_part(side, upper, 1), sv_side_part(other, !upper, 1)],
					book,
				)
			}
		}
		self.undo.push(SvUndo { var: v, upper: upper, old: had })
		if !self.touched[v] {
			self.touched[v] = true
			self.touched_list.push(v)
		}
		self.stamp += 1
		self.bound_at[v] = self.stamp
		self.gcd_var(v)
		let value = side.value.clone()
		if upper {
			self.upper[v] = side
		} else {
			self.lower[v] = side
		}
		if self.row_of[v] < 0 {
			let order = if self.big_on { sv_big_delta_cmp_small(self.big_values[v], value) } else {
				sv_delta_cmp(self.values[v], value)
			}
			if (upper && order > 0) || (!upper && order < 0) {
				if self.big_on {
					self.big_move(v, sv_big_delta_of(value))
					return SvChecked::Consistent
				}
				let old = self.values[v].clone()
				self.values[v] = value
				if !self.refresh(v, old) {
					// On past `i64` (#2707): `v` holds its new value, the
					// basic values are worked out again from the rows.
					self.overflows += 1
					if !self.big_enter() {
						return self.big_unknown()
					}
				}
			}
		}
		return SvChecked::Consistent
	}

	fn overflow(ref mut self) -> SvChecked {
		self.overflows += 1
		return SvChecked::Unknown(LgUnknown::Overflow)
	}

	/// The conflict the parts add up to, written as a Farkas lemma.
	fn conflict(ref mut self, parts: Vec[SvPart], mut book: SvBook) -> SvChecked {
		let clause = sv_sx_lemma(parts, book) ?? return self.overflow()
		return SvChecked::Conflict(clause)
	}

	/// The bound row `r` puts on its basic variable from above (`up`) or
	/// below, through the bounds of its other variables, as the parts of
	/// that sum; `null` where one of them lacks the side it needs.
	fn row_parts(ref self, r: i64, up: bool) -> Vec[SvPart]? {
		let b = self.basic[r]
		let mut parts: Vec[SvPart] = []
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let a = self.rows[r].ks[i]
			i += 1
			if v == b {
				continue
			}
			// From above, `a > 0` needs `v`'s upper side; from below its lower.
			// Two lines, not `(a > 0) == up`: the comparison is taken for a chain.
			let positive = a > 0
			let wants_upper = positive == up
			let side = if wants_upper { self.upper[v] } else { self.lower[v] }
			if !side.set {
				return null
			}
			parts.push(sv_side_part(side, wants_upper, a.checked_abs() ?? return null))
		}
		return parts
	}

	/// The bound on row `r`'s basic variable from above or below that the
	/// bounds of its other variables give, `Σ aⱼ·boundⱼ / d`; `null`
	/// where a side is missing or a step leaves `i64`.
	fn row_bound(ref self, r: i64, up: bool) -> SvDelta? {
		let b = self.basic[r]
		// Whole bounds summed as integers, the same sum the rationals give
		// (#2401: these sums were a tenth of the work on `c_inference`);
		// at the first bound that is no integer, the rational sum below.
		let mut cn: i64 = 0
		let mut kn: i64 = 0
		let mut d: i64 = 1
		let mut whole = true
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let a = self.rows[r].ks[i]
			i += 1
			if v == b {
				d = a.checked_neg() ?? return null
				continue
			}
			let positive = a > 0
			let wants_upper = positive == up
			let side = if wants_upper { self.upper[v] } else { self.lower[v] }
			if !side.set {
				return null
			}
			if side.value.c.den != 1 || side.value.k.den != 1 {
				whole = false
				break
			}
			cn = cn.checked_add(side.value.c.num.checked_mul(a) ?? return null) ?? return null
			kn = kn.checked_add(side.value.k.num.checked_mul(a) ?? return null) ?? return null
		}
		if whole {
			let inverse = sv_rat(1, d) ?? return null
			return sv_delta_scale(SvDelta { c: sv_int(cn), k: sv_int(kn) }, inverse)
		}
		let mut sum = sv_sx_zero()
		d = 1
		i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let a = self.rows[r].ks[i]
			i += 1
			if v == b {
				d = a.checked_neg() ?? return null
				continue
			}
			// Two lines, not `(a > 0) == up`: the comparison is taken for a chain.
			let positive = a > 0
			let wants_upper = positive == up
			let side = if wants_upper { self.upper[v] } else { self.lower[v] }
			if !side.set {
				return null
			}
			let term = sv_delta_scale(side.value, sv_int(a)) ?? return null
			sum = sv_delta_add(sum, term) ?? return null
		}
		let inverse = sv_rat(1, d) ?? return null
		return sv_delta_scale(sum, inverse)
	}

	/// Pivots row `r` on non-basic variable `j`: `j` basic in `r`, every
	/// other row with `j` combined with it by the smallest multipliers.
	/// False, nothing changed, where a row would leave `i64`: `exact`
	/// forms a combination that leaves it in double width (#2307), so then
	/// only where its reduced row does not fit.
	fn pivot(ref mut self, r: i64, j: i64, exact: bool) -> bool {
		let col = j.checked_u32() ?? return false
		// Each other row with `j` combined with row `r` read in place: the
		// elimination gives the same row whichever sign `r` has, so `r`
		// is turned (`j`'s coefficient negative) only once nothing failed.
		let turn = sv_row_coef(self.rows[r], col) > 0
		// `j`'s list read once, each row in it once (`row_mark`), as
		// `compact` would leave it.
		self.mark_round += 1
		let round = self.mark_round
		let mut changed: Vec[i64] = Vec(capacity: self.col_rows[j].len())
		let mut made: Vec[SvRow] = Vec(capacity: self.col_rows[j].len())
		// The columns each made row gained and lost, and where its run ends.
		let mut came: Vec[u32] = []
		let mut left: Vec[u32] = []
		let mut came_end: Vec[i64] = Vec(capacity: self.col_rows[j].len())
		let mut left_end: Vec[i64] = Vec(capacity: self.col_rows[j].len())
		let mut k = 0
		while k < self.col_rows[j].len() {
			let t = self.col_rows[j][k]
			k += 1
			if t != r && self.row_mark[t] != round && sv_row_coef(self.rows[t], col) != 0 {
				self.row_mark[t] = round
				let spare = self.spare.pop() ?? sv_row_constant(0)
				let row = sv_row_eliminate_into(
					spare,
					self.rows[t],
					self.rows[r],
					col,
					exact,
					came,
					left,
				)
				made.push(row ?? return false)
				changed.push(t)
				came_end.push(came.len())
				left_end.push(left.len())
			}
		}
		if turn {
			self.rows[r] = sv_row_scale(self.rows[r], -1) ?? return false
		}
		self.mark_dirty(r)
		self.stamp += 1
		self.row_at[r] = self.stamp
		self.gcd_row(r)
		// Last to first, so each made row is moved out of `made` by `pop`.
		let mut i = changed.len()
		while i > 0 {
			i -= 1
			let row = made.pop() ?? return false
			let t = changed[i]
			// A column that left `t` keeps it in its list until it is
			// compacted; one that came gets it.
			let mut long: Vec[i64] = []
			let mut m = if i > 0 { left_end[i - 1] } else { 0 }
			while m < left_end[i] {
				self.col_count[left[m] as i64] -= 1
				m += 1
			}
			m = if i > 0 { came_end[i - 1] } else { 0 }
			while m < came_end[i] {
				let c = came[m] as i64
				m += 1
				self.col_count[c] += 1
				self.col_rows[c].push(t)
				if self.col_rows[c].len() > 2 * self.rows.len() + 8 {
					long.push(c)
				}
			}
			// The old row moved out to `spare`, not dropped.
			let last = self.rows.len()
			self.rows.push(row)
			self.rows.swap(t, last)
			self.spare.push(self.rows.pop() ?? return false)
			for c in long {
				self.compact(c)
			}
			self.mark_dirty(t)
			self.row_at[t] = self.stamp
			self.gcd_row(t)
		}
		// `j` is eliminated from every row but `r`.
		self.col_rows[j] = [r]
		let old = self.basic[r]
		self.row_of[old] = -1
		self.basic[r] = j
		self.row_of[j] = r
		return true
	}

	/// Row `r` marked to be tested again by the next GCD test.
	fn gcd_row(ref mut self, r: i64) {
		if !self.gcd_row_in[r] {
			self.gcd_row_in[r] = true
			self.gcd_rows.push(r)
		}
	}

	/// Variable `v`'s rows marked to be tested again by the next GCD test.
	fn gcd_var(ref mut self, v: i64) {
		if !self.gcd_var_in[v] {
			self.gcd_var_in[v] = true
			self.gcd_vars.push(v)
		}
	}

	/// Row `r` marked to be read again by the next `propagate`.
	fn mark_dirty(ref mut self, r: i64) {
		if !self.row_dirty[r] {
			self.row_dirty[r] = true
			self.dirty_list.push(r)
			if self.levels.len() > 0 {
				self.row_log.push(r)
			}
		}
	}

	/// Variable `c`'s column left with the rows that hold it, each once.
	fn compact(ref mut self, c: i64) {
		self.mark_round += 1
		let round = self.mark_round
		let col = c.checked_u32() ?? return
		let mut kept: Vec[i64] = []
		let mut i = 0
		while i < self.col_rows[c].len() {
			let t = self.col_rows[c][i]
			i += 1
			if self.row_mark[t] != round && sv_row_coef(self.rows[t], col) != 0 {
				self.row_mark[t] = round
				kept.push(t)
			}
		}
		self.col_rows[c] = kept
	}

	/// The lowest basic variable outside its bounds: its row, and whether it
	/// lies below; `-1` where every one is inside.
	fn violated(ref self) -> SvViolation {
		let mut best = SvViolation { row: -1, var: -1, below: false }
		let mut r = 0
		while r < self.rows.len() {
			let b = self.basic[r]
			r += 1
			// Only a lower variable than the best yet can take its place.
			if best.var >= 0 && b > best.var {
				continue
			}
			let below = self.lower[b].set && sv_delta_cmp(self.values[b], self.lower[b].value) < 0
			let above = self.upper[b].set && sv_delta_cmp(self.values[b], self.upper[b].value) > 0
			if below || above {
				best = SvViolation { row: r - 1, var: b, below: below }
			}
		}
		return best
	}

	/// Every basic variable outside its bounds, lowest variable first: the
	/// rows `feasible` tries where the lowest one's pivots all leave `i64`.
	fn violated_all(ref self) -> Vec[SvViolation] {
		let mut out: Vec[SvViolation] = []
		let mut r = 0
		while r < self.rows.len() {
			let b = self.basic[r]
			r += 1
			let below = self.lower[b].set && sv_delta_cmp(self.values[b], self.lower[b].value) < 0
			let above = self.upper[b].set && sv_delta_cmp(self.values[b], self.upper[b].value) > 0
			if below || above {
				let mut at = out.len()
				while at > 0 && out[at - 1].var > b {
					at -= 1
				}
				out.insert(at, SvViolation { row: r - 1, var: b, below: below })
			}
		}
		return out
	}

	/// Row `at.row` pivoted on one of its entering variables: every one in
	/// `i64` first, since one whose rows leave it hands over to the next and
	/// that keeps the coefficients small, then where all leave it in double
	/// width (#2307). `Ended` where no variable can enter (the row's conflict),
	/// `Left` where every pivot leaves `i64`, nothing changed.
	fn pivot_row(ref mut self, at: SvViolation, bland: bool, mut book: SvBook) -> SvPivoted {
		let r = at.row
		let b = at.var
		let candidates = self.entering(r, at.below, bland)
		if candidates.len() == 0 {
			// `d·x_b` cannot reach the violated side: the row's bound
			// from the other side and that side add up to `c < 0`.
			let mut parts = self.row_parts(r, at.below) ?? return SvPivoted::Ended(self.overflow())
			let d = sv_row_coef(self.rows[r], b.checked_u32() ?? 0).checked_neg()
				?? return SvPivoted::Ended(self.overflow())
			let side = if at.below { self.lower[b] } else { self.upper[b] }
			parts.push(sv_side_part(side, !at.below, d))
			return SvPivoted::Ended(self.conflict(parts, book))
		}
		for j in candidates {
			if self.pivot(r, j, false) {
				return SvPivoted::Done
			}
		}
		for j in candidates {
			if self.pivot(r, j, true) {
				return SvPivoted::Done
			}
		}
		return SvPivoted::Left
	}

	/// The variables of row `r` that can move its basic variable up
	/// (`below`) or down, in the order the rule tries them: smallest
	/// coefficient first, then the one in fewest rows, or, under Bland's
	/// rule, lowest first.
	fn entering(ref self, r: i64, below: bool, bland: bool) -> Vec[i64] {
		let b = self.basic[r]
		let mut out: Vec[i64] = []
		let mut cost: Vec[i64] = []
		let mut length: Vec[i64] = []
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let a = self.rows[r].ks[i]
			i += 1
			if v == b {
				continue
			}
			let can_rise = !self.upper[v].set
				|| sv_delta_cmp(self.values[v], self.upper[v].value) < 0
			let can_fall = !self.lower[v].set
				|| sv_delta_cmp(self.values[v], self.lower[v].value) > 0
			// `d·x_b = Σ a·x`: `x_b` rises with `x` where `a > 0`.
			let rises_with = a > 0
			let ok = if rises_with == below { can_rise } else { can_fall }
			if !ok {
				continue
			}
			let size = if bland { v } else { a.checked_abs() ?? continue }
			let rows = if bland { 0 } else { self.col_count[v] }
			// Insert by `(size, rows, v)`; the columns come ascending, so a
			// tie keeps the lower variable first.
			let mut at = out.len()
			let score = size.saturating_mul(rows)
			while at > 0
				&& (cost[at - 1].saturating_mul(length[at - 1]) > score || (cost[at - 1].saturating_mul(length[at - 1]) == score && cost[at - 1] > size)) {
					at -= 1
				}
			out.insert(at, v)
			cost.insert(at, size)
			length.insert(at, rows)
		}
		return out
	}

	/// Pivots until every variable is inside its bounds (`Consistent`) or a
	/// row shows they cannot be (`Conflict`).
	fn feasible(ref mut self, mut book: SvBook) -> SvChecked {
		if self.big_on {
			return self.big_feasible(book)
		}
		let mut count = 0
		while true {
			let mut at = self.violated()
			if at.row < 0 {
				return SvChecked::Consistent
			}
			if count >= self.pivot_limit {
				return SvChecked::Unknown(LgUnknown::TooManyCases)
			}
			let bland = count >= self.bland_after
			let mut pivoted = self.pivot_row(at, bland, book)
			match pivoted {
				SvPivoted::Done => {},
				SvPivoted::Ended(end) => {
					// A conflict whose lemma left `i64` (counted by
					// `overflow`): on past it (#2707).
					return match end {
						SvChecked::Unknown(LgUnknown::Overflow) => self.resume(true, book),
						else => end,
					}
				},
				SvPivoted::Left => {
					// D11: a step that leaves `i64` is not taken while another
					// pivot is left, so each other violated row is tried, in
					// the order of its variable, before `overflow` (#2101).
					for other in self.violated_all() {
						if other.row != at.row {
							pivoted = self.pivot_row(other, bland, book)
							match pivoted {
								SvPivoted::Left => {},
								else => {
									at = other
									break
								},
							}
						}
					}
				},
			}
			match pivoted {
				SvPivoted::Done => {},
				SvPivoted::Ended(end) => {
					// A conflict whose lemma left `i64` (counted by
					// `overflow`): on past it (#2707).
					return match end {
						SvChecked::Unknown(LgUnknown::Overflow) => self.resume(true, book),
						else => end,
					}
				},
				SvPivoted::Left => {
					return self.resume(false, book)
				},
			}
			let b = at.var
			let target = if at.below { self.lower[b].value.clone() } else {
				self.upper[b].value.clone()
			}
			// `b` left the basis: the rows that hold it now are row `r`
			// and those the pivot combined with it.
			let old = self.values[b].clone()
			self.values[b] = target
			if !self.refresh(b, old) {
				return self.resume(false, book)
			}
			count += 1
			self.pivots += 1
		}
	}

	/// The lowest query column whose value is no integer, `-1` where there
	/// is none.
	fn fractional(ref self) -> i64 {
		let mut v = 0
		while v < self.var_col.len() {
			let value = self.values[v]
			if self.var_col[v] >= 0 && !self.is_real(v) && (value.c.den != 1 || value.k.num != 0) {
				return v
			}
			v += 1
		}
		return -1
	}

	/// Whether variable `v`'s form holds a real column (ADR-270 D27).
	fn is_real(ref self, v: i64) -> bool {
		return sv_row_real(self.var_form[v], self.reals)
	}

	/// Whether tableau row `r` holds a real variable.
	fn row_real(ref self, r: i64) -> bool {
		if self.reals.len() == 0 {
			return false
		}
		for c in self.rows[r].cols {
			if self.is_real(c as i64) {
				return true
			}
		}
		return false
	}

	/// The query columns' values as rationals, by name, `δ` replaced by a
	/// positive rational small enough that every variable keeps its sides:
	/// at most 1, and for a side `lc + lk·δ` below a value `c + k·δ` with
	/// `c > lc`, `k < lk`, at most `(c - lc) / (lk - k)` (above, mirrored).
	/// `null` where a step leaves `i64`.
	fn rational_values(ref self) -> collections::BTreeMap[String, SvRat]? {
		let mut delta = sv_int(1)
		let mut v = 0
		while v < self.var_col.len() {
			let value = self.values[v]
			let lo = self.lower[v]
			let hi = self.upper[v]
			if lo.set
				&& sv_rat_cmp(value.c, lo.value.c) > 0
				&& sv_rat_cmp(value.k, lo.value.k) < 0 {
					let gap = sv_rat_sub(value.c, lo.value.c) ?? return null
					let slope = sv_rat_sub(lo.value.k, value.k) ?? return null
					let most = sv_rat_div(gap, slope) ?? return null
					if sv_rat_cmp(most, delta) < 0 {
						delta = most
					}
				}
			if hi.set
				&& sv_rat_cmp(hi.value.c, value.c) > 0
				&& sv_rat_cmp(hi.value.k, value.k) < 0 {
					let gap = sv_rat_sub(hi.value.c, value.c) ?? return null
					let slope = sv_rat_sub(value.k, hi.value.k) ?? return null
					let most = sv_rat_div(gap, slope) ?? return null
					if sv_rat_cmp(most, delta) < 0 {
						delta = most
					}
				}
			v += 1
		}
		let mut out: collections::BTreeMap[String, SvRat] = collections::BTreeMap()
		v = 0
		while v < self.var_col.len() {
			let col = self.var_col[v]
			if col >= 0 {
				let value = self.values[v]
				let shift = sv_rat_mul(value.k, delta) ?? return null
				let at = sv_rat_add(value.c, shift) ?? return null
				out.insert(sv_column_name(col.checked_u32() ?? return null, self.names), at)
			}
			v += 1
		}
		return out
	}

	/// The query columns' values, by name, where every one is an integer.
	fn integer_values(ref self) -> collections::BTreeMap[String, i64] {
		let mut out: collections::BTreeMap[String, i64] = collections::BTreeMap()
		let mut v = 0
		while v < self.var_col.len() {
			let col = self.var_col[v]
			if col >= 0 {
				let c = col.checked_u32() ?? 0
				out.insert(sv_column_name(c, self.names), self.values[v].c.num)
			}
			v += 1
		}
		return out
	}

	/// The atoms of variable `v` not taken in call `call` yet, added to
	/// `out`.
	fn take_atoms(ref mut self, v: i64, call: i64, mut out: Vec[u32]) {
		let mut k = 0
		while k < self.var_atoms[v].len() {
			let a = self.var_atoms[v][k]
			k += 1
			if self.atom_at[a as i64] != call {
				self.atom_at[a as i64] = call
				out.push(a)
			}
		}
	}

	/// `propagate` on atom `a`: each of its literals, neither asserted
	/// nor propagated yet, that a bound of its variable implies (where
	/// the atom is `fresh` or the variable touched), or, for a basic
	/// variable, the bounds of its row (where the atom is fresh, the row
	/// made in this call or marked to read again), added to `out`.
	fn propagate_atom(
		ref mut self,
		a: u32,
		fresh: bool,
		book: ref SvBook,
		rows_before: i64,
		call: i64,
		mut out: Vec[u32],
	) {
		for l in [sv_lit(a, false), sv_lit(a, true)] {
			if self.is_held(l) {
				continue
			}
			let seen = self.view(l, book)
			if !seen.usable {
				continue
			}
			let v = seen.var
			let up = seen.upper
			let side = if up { self.upper[v] } else { self.lower[v] }
			if side.set && (fresh || self.touched[v]) {
				let order = sv_delta_cmp(side.value, seen.value)
				if (up && order <= 0) || (!up && order >= 0) {
					self.implied.push(SvImplied {
						lit: l,
						level: self.level(),
						parts: [sv_side_part(side, up, 1)],
						d: 1,
					})
					self.hold(l, 1)
					out.push(l)
					continue
				}
			}
			let r = self.row_of[v]
			// Past `i64` the rows behind `rows` are stale: no row bounds.
			if r < 0 || self.big_on {
				continue
			}
			if !fresh && r < rows_before && self.exam_at[r] != call {
				continue
			}
			let at = if up { 2 * r + 1 } else { 2 * r }
			if self.rb_at[at] != call {
				self.rb_at[at] = call
				let found = self.row_bound(r, up)
				self.rb_has[at] = found != null
				if found != null {
					self.rb_val[at] = found ?? sv_sx_zero()
				}
			}
			if !self.rb_has[at] {
				continue
			}
			let order = sv_delta_cmp(self.rb_val[at], seen.value)
			if (up && order <= 0) || (!up && order >= 0) {
				let parts = self.row_parts(r, up) ?? continue
				let d = sv_row_coef(self.rows[r], v.checked_u32() ?? continue).checked_neg()
					?? continue
				self.implied.push(SvImplied { lit: l, level: self.level(), parts: parts, d: d })
				self.hold(l, 1)
				out.push(l)
			}
		}
	}

	/// Whether literal `l` stands on the trail or among `implied`.
	fn is_held(ref self, l: u32) -> bool {
		let at = l as i64
		return at < self.held.len() && self.held[at] > 0
	}

	/// Counts literal `l` once more (`by` 1) or once less (`by` -1) on the
	/// trail or among `implied`.
	fn hold(ref mut self, l: u32, by: i64) {
		let at = l as i64
		while self.held.len() <= at {
			self.held.push(0)
		}
		self.held[at] += by
	}

	/// Literal `l`'s bound as `propagate` reads it, worked out on its first
	/// call; giving the form its variable is the first call's side effect.
	fn view(ref mut self, l: u32, book: ref SvBook) -> SvLitView {
		let at = l as i64
		while self.views.len() <= at {
			self.views.push(sv_sx_view_unknown())
		}
		if self.views[at].known {
			return self.views[at].clone()
		}
		let mut seen = sv_sx_view_unknown()
		seen.known = true
		let got = self.view_of(l, book)
		if got != null {
			seen = got ?? seen
		}
		if seen.usable {
			let a = l / 2
			let n = self.var_atoms[seen.var].len()
			if n == 0 || self.var_atoms[seen.var][n - 1] != a {
				self.var_atoms[seen.var].push(a)
			}
		}
		self.views[at] = seen.clone()
		return seen
	}

	/// The view of literal `l` where it is usable, else `null`.
	fn view_of(ref mut self, l: u32, book: ref SvBook) -> SvLitView? {
		let mine = book.lit_bound(l) ?? return null
		if mine.row.cols.len() == 0 {
			return null
		}
		match mine.rel {
			SvRel::Eq => return null,
			else => {},
		}
		// The explanation needs the negation's bound.
		if book.lit_bound(sv_sx_not(l)) == null {
			return null
		}
		let reading = sv_reading(mine.row, mine.rel) ?? return null
		// Every atom's form gets its variable here, as the theory
		// registers the atoms up front in Dutertre and de Moura: a
		// new slack is basic, so its row bound can imply the atom.
		let v = self.form_var(reading.form) ?? return null
		return SvLitView {
			known: true,
			usable: true,
			var: v,
			upper: reading.upper,
			value: reading.value,
		}
	}

	// --- The stage past `i64` (#2707). A step that leaves `i64` makes the
	// tableau again in `BigInt` from the rows the query wrote, over the
	// basis and bounds kept; the query stays there, within `big_budget`.

	/// Slack `s`'s row as the query wrote it, `Σ aⱼ·xⱼ - s = 0` over its
	/// form's columns, its variables ascending.
	fn original_row(ref self, s: i64) -> SvBigRow {
		let form = self.var_form[s]
		let mut cols: Vec[i64] = []
		let mut ks: Vec[bigint::BigInt] = []
		let mut i = 0
		while i <= form.cols.len() {
			let mut v = s
			let mut k: i64 = -1
			if i < form.cols.len() {
				let found: i64? = self.col_var.get(form.cols[i])
				v = found ?? s
				k = form.ks[i]
			}
			i += 1
			let mut at = cols.len()
			while at > 0 && cols[at - 1] > v {
				at -= 1
			}
			cols.insert(at, v)
			ks.insert(at, sv_big(k))
		}
		return SvBigRow { cols: cols, ks: ks }
	}

	/// The stage past `i64` begun: each row made again from the rows the
	/// query wrote, solved for the basis kept (Gauss-Jordan), and the basic
	/// values worked out from the non-basic ones. Nothing of a tableau a
	/// step left half-pivoted is carried over. False where the rows do not
	/// solve for the basis.
	fn big_enter(ref mut self) -> bool {
		self.big_on = true
		self.resumed += 1
		let mut values: Vec[SvBigDelta] = Vec(capacity: self.values.len())
		for x in self.values {
			values.push(sv_big_delta_of(x))
		}
		self.big_values = values
		let mut slacks: Vec[i64] = []
		for (_, s) in self.slack_of {
			slacks.push(s)
		}
		let mut rows: Vec[SvBigRow] = []
		let mut used: Vec[bool] = []
		for s in slacks {
			rows.push(self.original_row(s))
			used.push(false)
		}
		let n = self.basic.len()
		if rows.len() != n {
			return false
		}
		let mut slot: Vec[i64] = []
		let mut r = 0
		while r < n {
			let b = self.basic[r]
			let mut p = -1
			let mut t = 0
			while t < n {
				if !used[t] && sv_big_find(rows[t], b) >= 0 && (p < 0 || rows[t].cols.len() < rows[p].cols.len()) {
					p = t
				}
				t += 1
			}
			if p < 0 {
				return false
			}
			used[p] = true
			slot.push(p)
			let pb = sv_big_coef(rows[p], b)
			t = 0
			while t < n {
				if t != p {
					let tb = sv_big_coef(rows[t], b)
					if tb.sign() != 0 {
						let made = sv_big_combine(rows[t], pb, rows[p], tb.neg())
						self.big_work += made.work
						rows[t] = made.row
					}
				}
				t += 1
			}
			r += 1
		}
		let mut out: Vec[SvBigRow] = Vec(capacity: n)
		r = 0
		while r < n {
			let row = rows[slot[r]]
			if sv_big_coef(row, self.basic[r]).sign() < 0 {
				out.push(row.clone())
			} else {
				out.push(sv_big_negated(row))
			}
			r += 1
		}
		self.big_rows = out
		r = 0
		while r < n {
			let b = self.basic[r]
			self.big_values[b] = self.big_row_value(r)
			r += 1
		}
		return true
	}

	/// The value row `r` gives its basic variable, `Σ aⱼ·βⱼ / d`.
	fn big_row_value(ref self, r: i64) -> SvBigDelta {
		let b = self.basic[r]
		let row = self.big_rows[r]
		let one = sv_big(1)
		let mut sum = sv_big_delta_zero()
		let mut d = sv_big(1)
		let mut i = 0
		while i < row.cols.len() {
			let v = row.cols[i]
			if v == b {
				d = row.ks[i].neg()
			} else {
				sum = sv_big_delta_add(sum, sv_big_delta_scale(self.big_values[v], row.ks[i], one))
			}
			i += 1
		}
		return sv_big_delta_scale(sum, one, d)
	}

	/// The row of slack `s`, made past `i64` (its row `r` already counted
	/// in `basic`): the row the query wrote with its basic variables
	/// replaced by their rows, and its value.
	fn big_add_row(ref mut self, s: i64) {
		let mut row = self.original_row(s)
		let cols = row.cols.clone()
		for c in cols {
			let at = self.row_of[c]
			if at >= 0 && c != s {
				let tc = sv_big_coef(row, c)
				if tc.sign() != 0 {
					// `pc < 0`, so `s` keeps its negative coefficient.
					let pc = sv_big_coef(self.big_rows[at], c)
					let made = sv_big_combine(row, pc.neg(), self.big_rows[at], tc)
					self.big_work += made.work
					row = made.row
				}
			}
		}
		self.big_rows.push(row)
		self.big_values[s] = self.big_row_value(self.big_rows.len() - 1)
	}

	/// Non-basic variable `v` moved to `to`, the basic value of each row
	/// that holds it moved by `a·(to - old) / d`.
	fn big_move(ref mut self, v: i64, to: SvBigDelta) {
		let moved = sv_big_delta_sub(to, self.big_values[v])
		self.big_values[v] = to
		let mut r = 0
		while r < self.big_rows.len() {
			let at = sv_big_find(self.big_rows[r], v)
			if at >= 0 {
				let b = self.basic[r]
				let a = self.big_rows[r].ks[at].clone()
				let d = sv_big_coef(self.big_rows[r], b).neg()
				let change = sv_big_delta_scale(moved, a, d)
				self.big_values[b] = sv_big_delta_add(self.big_values[b], change)
			}
			r += 1
		}
	}

	/// `violated` past `i64`.
	fn big_violated(ref self) -> SvViolation {
		let mut best = SvViolation { row: -1, var: -1, below: false }
		let mut r = 0
		while r < self.big_rows.len() {
			let b = self.basic[r]
			r += 1
			if best.var >= 0 && b > best.var {
				continue
			}
			let below = self.lower[b].set && sv_big_delta_cmp_small(self.big_values[b], self.lower[b].value) < 0
			let above = self.upper[b].set && sv_big_delta_cmp_small(self.big_values[b], self.upper[b].value) > 0
			if below || above {
				best = SvViolation { row: r - 1, var: b, below: below }
			}
		}
		return best
	}

	/// The variable of row `r` that enters past `i64`: the one with the
	/// shortest coefficient, or under Bland's rule the lowest; `-1` where
	/// none can move the basic variable up (`below`) or down.
	fn big_entering(ref self, r: i64, below: bool, bland: bool) -> i64 {
		let b = self.basic[r]
		let row = self.big_rows[r]
		let mut best = -1
		let mut best_size = 0
		let mut i = 0
		while i < row.cols.len() {
			let v = row.cols[i]
			let positive = row.ks[i].sign() > 0
			i += 1
			if v == b {
				continue
			}
			let can_rise = !self.upper[v].set
				|| sv_big_delta_cmp_small(self.big_values[v], self.upper[v].value) < 0
			let can_fall = !self.lower[v].set
				|| sv_big_delta_cmp_small(self.big_values[v], self.lower[v].value) > 0
			let ok = if positive == below { can_rise } else { can_fall }
			if !ok {
				continue
			}
			let size = if bland { v } else { row.ks[i - 1].bits() }
			if best < 0 || size < best_size {
				best = v
				best_size = size
			}
		}
		return best
	}

	/// `pivot` past `i64`: row `r` turned so that `j`'s coefficient is
	/// negative, `j` basic in it, and every other row with `j` combined with
	/// it.
	fn big_pivot(ref mut self, r: i64, j: i64) {
		if sv_big_coef(self.big_rows[r], j).sign() > 0 {
			self.big_rows[r] = sv_big_negated(self.big_rows[r])
		}
		let pj = sv_big_coef(self.big_rows[r], j)
		let mut t = 0
		while t < self.big_rows.len() {
			if t != r {
				let tj = sv_big_coef(self.big_rows[t], j)
				if tj.sign() != 0 {
					// `-pj > 0` keeps the basic coefficient of `t` negative.
					let made = sv_big_combine(self.big_rows[t], pj.neg(), self.big_rows[r], tj)
					self.big_work += made.work
					self.big_rows[t] = made.row
				}
			}
			t += 1
		}
		let b = self.basic[r]
		self.basic[r] = j
		self.row_of[j] = r
		self.row_of[b] = -1
		self.big_work += 1
	}

	/// *Unknown* past `i64`: the budget is spent, or a lemma's multiplier
	/// does not fit the log's `i64`.
	fn big_unknown(ref self) -> SvChecked {
		return SvChecked::Unknown(LgUnknown::Overflow)
	}

	/// `pivot_row`'s conflict past `i64`: no variable of row `at.row` can
	/// move its basic variable to the violated side, so the row's bound from
	/// the other side and that side add up to a contradiction, its
	/// multipliers divided by their gcd and then in `i64`.
	fn big_conflict(ref mut self, at: SvViolation, mut book: SvBook) -> SvChecked {
		let b = at.var
		let row = self.big_rows[at.row].clone()
		let mut sources: Vec[SvSrc] = []
		let mut weights: Vec[bigint::BigInt] = []
		let mut scales: Vec[i64] = []
		let mut negs: Vec[bool] = []
		let mut i = 0
		while i < row.cols.len() {
			let v = row.cols[i]
			let a = row.ks[i].clone()
			i += 1
			let mut upper = !at.below
			let mut weight = a.neg()
			if v != b {
				upper = (a.sign() > 0) == at.below
				weight = a.abs()
			}
			let side = if upper { self.upper[v].clone() } else { self.lower[v].clone() }
			if !side.set {
				return self.big_unknown()
			}
			sources.push(side.src.clone())
			weights.push(weight)
			scales.push(side.scale)
			negs.push(!upper)
		}
		let mut common: i64 = 1
		for sc in scales {
			let a = sc.checked_abs() ?? return self.big_unknown()
			let g = sv_gcd(common, a) ?? return self.big_unknown()
			common = (common / g).checked_mul(a) ?? return self.big_unknown()
		}
		let mut kept: Vec[SvSrc] = []
		let mut big_ms: Vec[bigint::BigInt] = []
		i = 0
		while i < weights.len() {
			let mut m = weights[i].mul(sv_big(common / scales[i]))
			if negs[i] {
				m = m.neg()
			}
			if m.sign() != 0 {
				kept.push(sources[i].clone())
				big_ms.push(m)
			}
			i += 1
		}
		let mut g = sv_big(0)
		for m in big_ms {
			g = g.gcd(m)
		}
		let mut ms: Vec[i64] = []
		for m in big_ms {
			let q = if g.sign() > 0 { sv_big_quo(m, g) } else { m.clone() }
			ms.push(q.narrow() ?? return self.big_unknown())
		}
		let clause = sv_sx_lemma_of(SvMult { sources: kept, ms: ms }, book) ?? return self.big_unknown()
		return SvChecked::Conflict(clause)
	}

	/// `feasible` past `i64`, within `big_budget`.
	fn big_feasible(ref mut self, mut book: SvBook) -> SvChecked {
		let mut count = 0
		while true {
			let at = self.big_violated()
			if at.row < 0 {
				return SvChecked::Consistent
			}
			if self.big_work > self.big_budget {
				return self.big_unknown()
			}
			if count >= self.pivot_limit {
				return SvChecked::Unknown(LgUnknown::TooManyCases)
			}
			let bland = count >= self.bland_after
			let j = self.big_entering(at.row, at.below, bland)
			if j < 0 {
				return self.big_conflict(at, book)
			}
			self.big_pivot(at.row, j)
			let b = at.var
			let target = if at.below { self.lower[b].value.clone() } else {
				self.upper[b].value.clone()
			}
			self.big_move(b, sv_big_delta_of(target))
			count += 1
			self.pivots += 1
		}
	}

	/// A step of `feasible` left `i64`: on past it (the overflow counted
	/// where `counted` is false).
	fn resume(ref mut self, counted: bool, mut book: SvBook) -> SvChecked {
		if !counted {
			self.overflows += 1
		}
		if !self.big_enter() {
			return self.big_unknown()
		}
		return self.big_feasible(book)
	}

	/// `fractional` past `i64`.
	fn big_fractional(ref self) -> i64 {
		let one = sv_big(1)
		let mut v = 0
		while v < self.var_col.len() {
			let value = self.big_values[v]
			if self.var_col[v] >= 0 && !self.is_real(v) && (value.c.den != one || value.k.num.sign() != 0) {
				return v
			}
			v += 1
		}
		return -1
	}

	/// `integer_values` past `i64`; `null` where an integer column's value
	/// does not fit `i64` (a real column's numerator that does not is 0:
	/// `big_rational_values` gives its value).
	fn big_integer_values(ref self) -> collections::BTreeMap[String, i64]? {
		let mut out: collections::BTreeMap[String, i64] = collections::BTreeMap()
		let mut v = 0
		while v < self.var_col.len() {
			let col = self.var_col[v]
			if col >= 0 {
				let c = col.checked_u32() ?? return null
				let n = self.big_values[v].c.num.narrow()
				if n == null && !self.is_real(v) {
					return null
				}
				out.insert(sv_column_name(c, self.names), n ?? 0)
			}
			v += 1
		}
		return out
	}

	/// `rational_values` past `i64`; `null` where a value does not fit.
	fn big_rational_values(ref self) -> collections::BTreeMap[String, SvRat]? {
		let mut delta = sv_big_rat_int(sv_big(1))
		let mut v = 0
		while v < self.var_col.len() {
			let value = self.big_values[v]
			let lo = self.lower[v]
			let hi = self.upper[v]
			if lo.set {
				let lc = sv_big_rat_of(lo.value.c)
				let lk = sv_big_rat_of(lo.value.k)
				if sv_big_rat_cmp(value.c, lc) > 0 && sv_big_rat_cmp(value.k, lk) < 0 {
					let most = sv_big_rat_div(sv_big_rat_sub(value.c, lc), sv_big_rat_sub(lk, value.k))
					if sv_big_rat_cmp(most, delta) < 0 {
						delta = most
					}
				}
			}
			if hi.set {
				let hc = sv_big_rat_of(hi.value.c)
				let hk = sv_big_rat_of(hi.value.k)
				if sv_big_rat_cmp(hc, value.c) > 0 && sv_big_rat_cmp(hk, value.k) < 0 {
					let most = sv_big_rat_div(sv_big_rat_sub(hc, value.c), sv_big_rat_sub(value.k, hk))
					if sv_big_rat_cmp(most, delta) < 0 {
						delta = most
					}
				}
			}
			v += 1
		}
		let mut out: collections::BTreeMap[String, SvRat] = collections::BTreeMap()
		v = 0
		while v < self.var_col.len() {
			let col = self.var_col[v]
			if col >= 0 {
				let value = self.big_values[v]
				let at = sv_big_rat_add(value.c, sv_big_rat_mul(value.k, delta))
				out.insert(sv_column_name(col.checked_u32() ?? return null, self.names), sv_big_rat_narrow(at) ?? return null)
			}
			v += 1
		}
		return out
	}

	/// `⌊value⌋` of variable `v` in the order with `δ`: `3 - δ` lies below
	/// 3; below `i64::MIN` the split leaves `i64` (#1632).
	fn split_point(ref self, v: i64) -> i64? {
		let value = self.values[v]
		let floor = sv_rat_floor(value.c)
		return if value.c.den == 1 && value.k.num < 0 { floor.checked_sub(1) } else { floor }
	}

	/// The split point of variable `v` past `i64`: `⌊value⌋` in the order
	/// with `δ`, `null` where it does not fit `i64`.
	fn big_split_point(ref self, v: i64) -> i64? {
		let value = self.big_values[v]
		let mut floor = sv_big_rat_floor(value.c)
		if value.c.den == sv_big(1) && value.k.num.sign() < 0 {
			floor = floor.sub(sv_big(1))
		}
		return floor.narrow()
	}
}

impl SvTh for SvSimplex {
	fn push_level(ref mut self) {
		self.levels.push(self.undo.len())
		self.marks.push(self.trail.len())
		self.level_seen.push(self.seen_atoms)
		self.level_rows.push(self.row_log.len())
		self.level_vars.push(self.var_log.len())
		for r in self.dirty_list {
			self.row_log.push(r)
		}
		for v in self.touched_list {
			self.var_log.push(v)
		}
	}

	fn level(ref self) -> i64 {
		return self.levels.len()
	}

	/// `assert(lit)`: the literal's bound holds from now on. A bound that
	/// crosses the other side of its variable is a conflict at once.
	fn assert(ref mut self, lit: u32, mut book: SvBook) -> SvChecked {
		self.trail.push(lit)
		self.hold(lit, 1)
		let a = book.asserted(lit) ?? return SvChecked::Unknown(LgUnknown::OutsideTheTheory)
		return self.bound(a.bound.row, a.bound.rel, a.src, book)
	}

	/// A bound entry of the log that holds at every level, asserted before
	/// the first `push` (a congruence's `x - a - d·q >= 0`).
	fn fact(ref mut self, id: u32, mut book: SvBook) -> SvChecked {
		let b = (book.bounds.get(id) ?? return SvChecked::Unknown(LgUnknown::OutsideTheTheory)).clone()
		return self.bound(b.row, b.rel, SvSrc::Fact(id), book)
	}

	/// `check(final, limit)`: whether what is asserted has rational values
	/// (not final) or integer ones (final, branch-and-bound within
	/// `limit.cases` splits).
	fn check(ref mut self, final: bool, limit: ref LgBudget, mut book: SvBook) -> SvChecked {
		let relaxed = self.feasible(book)
		match relaxed {
			SvChecked::Consistent => {},
			else => {
				return relaxed
			},
		}
		if self.gcd_test && !self.big_on {
			let failed = self.gcd_conflict(book)
			if failed != null {
				self.gcd_conflicts += 1
				return SvChecked::Conflict(failed ?? return self.overflow())
			}
		}
		if !final {
			return SvChecked::Consistent
		}
		let v = if self.big_on { self.big_fractional() } else { self.fractional() }
		if v < 0 {
			if self.big_on {
				self.found = self.big_integer_values() ?? return self.big_unknown()
				self.found_real = self.big_rational_values() ?? collections::BTreeMap()
				return SvChecked::Consistent
			}
			self.found = self.integer_values()
			self.found_real = self.rational_values() ?? collections::BTreeMap()
			return SvChecked::Consistent
		}
		if self.cut_kind != "none" && self.cut_depth < self.cut_rounds && !self.big_on {
			let b = self.fractional_basic()
			if b >= 0 {
				let cut = self.cut_check(b, limit, book)
				if cut != null {
					return cut ?? self.overflow()
				}
			}
		}
		if self.splits >= limit.cases {
			return SvChecked::Unknown(LgUnknown::TooManyCases)
		}
		self.splits += 1
		let col = self.var_col[v]
		let k = if self.big_on { self.big_split_point(v) ?? return self.big_unknown() } else {
			self.split_point(v) ?? return self.overflow()
		}
		let le = SvRow {
			cols: [col.checked_u32() ?? return self.overflow()],
			ks: [1],
			constant: k.checked_neg() ?? return self.overflow(),
		}
		let ge = SvRow {
			cols: [col.checked_u32() ?? return self.overflow()],
			ks: [-1],
			constant: k.checked_add(1) ?? return self.overflow(),
		}
		let split = book.split(le, ge) ?? return self.overflow()
		if !self.branching {
			return SvChecked::Lemmas([split])
		}
		let mut refuted: Vec[SvClause] = []
		for side in split.lits {
			let level = self.level()
			self.push_level()
			let mut got = self.assert(side, book)
			match got {
				SvChecked::Consistent => {
					got = self.check(true, limit, book)
				},
				else => {},
			}
			self.backtrack(level)
			match got {
				SvChecked::Conflict(clause) => {
					if !clause.lits.contains(sv_sx_not(side)) {
						// Refuted without this side: so is the branch.
						return SvChecked::Conflict(clause)
					}
					refuted.push(clause)
				},
				else => {
					return got
				},
			}
		}
		// Each side's clause, unit on the side's negation, then the split's
		// clause false: learned by unit propagation through the three.
		let mut lits: Vec[u32] = []
		for c in refuted {
			for l in c.lits {
				let side = sv_sx_not(l)
				if !split.lits.contains(side) && !lits.contains(l) {
					lits.push(l)
				}
			}
		}
		lits.sort()
		let id = book.learn(lits.clone(), [refuted[0].id, refuted[1].id, split.id])
		return SvChecked::Conflict(SvClause { id: id, lits: lits })
	}

	/// `propagate()`: each literal of the book's atoms, neither asserted nor
	/// propagated yet, that a bound of its variable implies, or, for a basic
	/// variable, the bounds of its row.
	fn propagate(ref mut self, book: ref SvBook) -> Vec[u32] {
		let mut out: Vec[u32] = []
		let count = book.atoms.len().checked_u32() ?? return out
		// Each row's bound from above and below is worked out once per call
		// (#1962, `rb_at`): the bounds do not change while it runs, a row
		// `view` adds leaves the others as they were, and the atoms of one
		// form share a row.
		self.prop_call += 1
		let call = self.prop_call
		let rows_before = self.rows.len()
		while self.atom_at.len() < count as i64 {
			self.atom_at.push(-1)
		}
		let old_atoms = self.seen_atoms
		// The atoms the last call saw are read again only where their
		// variable's bound changed or their variable is basic in a row to
		// read again, changed or holding such a variable (#1960); found
		// through the indexes, not by reading every atom (#2401).
		let mut again: Vec[u32] = []
		if old_atoms > 0 {
			let mut exam: Vec[i64] = []
			let mut i = 0
			while i < self.dirty_list.len() {
				let r = self.dirty_list[i]
				i += 1
				if self.exam_at[r] != call {
					self.exam_at[r] = call
					exam.push(r)
				}
			}
			i = 0
			while i < self.touched_list.len() {
				let v = self.touched_list[i]
				i += 1
				let col = v.checked_u32() ?? 0
				let mut k = 0
				while k < self.col_rows[v].len() {
					let r = self.col_rows[v][k]
					k += 1
					if self.exam_at[r] != call && sv_row_coef(self.rows[r], col) != 0 {
						self.exam_at[r] = call
						exam.push(r)
					}
				}
				self.take_atoms(v, call, again)
			}
			for r in exam {
				self.take_atoms(self.basic[r], call, again)
			}
			for a in self.redo {
				if self.atom_at[a as i64] != call {
					self.atom_at[a as i64] = call
					again.push(a)
				}
			}
			// Many atoms: read in order off their marks, not sorted.
			if again.len() > (old_atoms / 16) as i64 {
				again.clear()
				let mut a: u32 = 0
				while a < old_atoms {
					if self.atom_at[a as i64] == call {
						again.push(a)
					}
					a += 1
				}
			} else {
				again.sort()
			}
		}
		for a in again {
			if a < old_atoms {
				let fresh = (a as i64) < self.redo_in.len() && self.redo_in[a as i64]
				self.propagate_atom(a, fresh, book, rows_before, call, out)
			}
		}
		for a in self.redo {
			self.redo_in[a as i64] = false
		}
		self.redo.clear()
		let mut a = old_atoms
		while a < count {
			self.propagate_atom(a, true, book, rows_before, call, out)
			a += 1
		}
		self.seen_atoms = count
		for v in self.touched_list {
			self.touched[v] = false
		}
		self.touched_list.clear()
		for r in self.dirty_list {
			self.row_dirty[r] = false
		}
		self.dirty_list.clear()
		return out
	}

	/// `explain(lit)`: the clause behind a propagated literal, a Farkas
	/// lemma of the bounds it follows from and its negation.
	fn explain(ref mut self, lit: u32, mut book: SvBook) -> SvClause? {
		for i in self.implied {
			if i.lit != lit {
				continue
			}
			let negation = sv_sx_not(lit)
			let b = book.lit_bound(negation) ?? return null
			let reading = sv_reading(b.row, b.rel) ?? return null
			let mut parts = i.parts.clone()
			parts.push(SvPart {
				src: SvSrc::Lit(negation),
				num: i.d,
				scale: reading.scale,
				neg: !reading.upper,
			})
			return sv_sx_lemma(parts, book)
		}
		return null
	}

	/// `backtrack(level)`: the bounds and the trail as they were when
	/// `level` ended; the basis and the values stay.
	fn backtrack(ref mut self, level: i64) {
		if level >= self.levels.len() {
			return
		}
		let keep = self.levels[level]
		// The basis stays: the rows changed above `level`, the atoms seen
		// and the bounds waiting since were read against bounds that are
		// gone, so the next `propagate` reads them again (`row_log`).
		if self.level_seen[level] < self.seen_atoms {
			self.seen_atoms = self.level_seen[level]
		}
		let rows = self.row_log[self.level_rows[level]..].clone()
		let vars = self.var_log[self.level_vars[level]..].clone()
		self.row_log.truncate(self.level_rows[level])
		self.var_log.truncate(self.level_vars[level])
		self.level_seen.truncate(level)
		self.level_rows.truncate(level)
		self.level_vars.truncate(level)
		while self.undo.len() > keep {
			let u = self.undo.pop() ?? break
			self.stamp += 1
			self.bound_at[u.var] = self.stamp
			self.gcd_var(u.var)
			if u.upper {
				self.upper[u.var] = u.old
			} else {
				self.lower[u.var] = u.old
			}
		}
		while self.trail.len() > self.marks[level] {
			let l = self.trail.pop() ?? break
			self.hold(l, -1)
		}
		self.levels.truncate(level)
		self.marks.truncate(level)
		// Logged again whether or not still marked: a level below reads
		// them again too.
		let logged = self.levels.len() > 0
		for r in rows {
			if !self.row_dirty[r] {
				self.row_dirty[r] = true
				self.dirty_list.push(r)
			}
			if logged {
				self.row_log.push(r)
			}
		}
		for v in vars {
			if !self.touched[v] {
				self.touched[v] = true
				self.touched_list.push(v)
			}
			if logged {
				self.var_log.push(v)
			}
		}
		while self.implied.len() > 0 && self.implied[self.implied.len() - 1].level > level {
			let i = self.implied.pop() ?? break
			self.hold(i.lit, -1)
			let a = (i.lit / 2) as i64
			while self.redo_in.len() <= a {
				self.redo_in.push(false)
			}
			if !self.redo_in[a] {
				self.redo_in[a] = true
				self.redo.push(i.lit / 2)
			}
		}
	}

	/// `model()`: the integer values of the last final `check`, by name.
	fn model(ref self) -> collections::BTreeMap[String, i64] {
		return self.found.clone()
	}

	/// `real_values()`: the rational values of the last final `check`.
	fn real_values(ref self) -> collections::BTreeMap[String, SvRat] {
		return self.found_real.clone()
	}

	/// `shared()`: none while the simplex is the only theory (D13).
	fn shared(ref self) -> Vec[u32] {
		return []
	}

	/// `pivots()`: the pivots of every check so far.
	fn pivots(ref self) -> i64 {
		return self.pivots
	}

	/// `overflows()`: the steps that left `i64` (#2707).
	fn overflows(ref self) -> i64 {
		return self.overflows
	}

	/// `resumed()`: how often the query went on past `i64` (#2707).
	fn resumed(ref self) -> i64 {
		return self.resumed
	}
}

/// The side a non-basic variable sits on.
pub struct SvActive {
	pub side: SvSide,
	pub upper: bool,
}

/// A non-basic variable of a tableau row read at the vertex: its side, and
/// `β` in `x_b = v + Σ β·y'`, `y' >= 0` its distance from that side.
pub struct SvGomory {
	pub var: i64,
	pub side: SvSide,
	pub upper: bool,
	pub beta: SvRat,
}

/// A Gomory mixed-integer cut: the literal of its atom and the learned
/// clause that it holds where what it assumed holds.
pub struct SvGmi {
	pub lit: u32,
	pub clause: SvClause,
}

/// The part of a side with the rational weight `w`.
fn sv_sx_weighted(side: ref SvSide, upper: bool, w: ref SvRat) -> SvPart? {
	return SvPart {
		src: side.src.clone(),
		num: w.num,
		scale: side.scale.checked_mul(w.den) ?? return null,
		neg: !upper,
	}
}

/// Whether `value REL 0` fails.
fn sv_sx_violated(rel: SvRel, value: ref SvDelta) -> bool {
	let order = sv_delta_cmp(value, sv_sx_zero())
	return match rel {
		SvRel::Le => order > 0,
		SvRel::Lt => order >= 0,
		SvRel::Eq => order != 0,
	}
}

/// `lits` without `drop`, with `add` where it is no `null`-literal
/// (`u32::MAX` for none), ascending.
fn sv_sx_relit(lits: ref Vec[u32], drop: ref Vec[u32], add: ref Vec[u32]) -> Vec[u32] {
	let mut out: Vec[u32] = []
	for l in lits {
		if !drop.contains(l) && !out.contains(l) {
			out.push(l)
		}
	}
	for l in add {
		if !out.contains(l) {
			out.push(l)
		}
	}
	out.sort()
	return out
}

/// **Cuts** (ADR-270 D5, #1284 item 1), tried by a final check before it
/// splits. Each is written as D5 allows a cut, and the checker replays it:
///
/// * **The GCD test on a row**: a tableau row `Σ k·v = 0` whose fixed
///   variables add up to a constant `K` the gcd `g` of the other
///   coefficients does not divide. The fixed variables' sides, combined
///   once from above and once from below, give `±(P + K) <= 0` over the
///   query columns for the form `P` of the others, whose coefficients `g`
///   divides; each rounded, the two add up to `1 <= 0`.
/// * **Gomory's fractional cut** (`"cg"`), a Chvátal-Gomory derivation: for
///   a basic query column `x_b = v + Σ β·y'` with `v` no integer, the sides
///   of its row's non-basic variables with the weights `⌈β⌉ - β` combine to
///   `x_b - Σ ⌈β⌉·y' - v <= 0`, whose rounding cuts the vertex off.
/// * **Gomory's mixed-integer cut** (`"gmi"`), a split cut: on the integer
///   form `L = x_b - Σ k·y'` (`k` the floor or the ceiling of `β` as its
///   fraction lies below or above `f0`, the fraction of `v`), the split
///   `L <= ⌊L*⌋ ∨ L >= ⌊L*⌋ + 1`; the cut `Σ α·y' >= 1` is a second split's
///   atom (the cut, or one more than it fails), refuted on its failing side
///   by one Farkas lemma per side of the first split, and the resolution is
///   two learned clauses: the cut holds where the sides it used hold.
impl SvSimplex {
	/// The side non-basic variable `u` sits on; `null` where it sits on
	/// none or the side holds `δ`.
	fn active(ref self, u: i64) -> SvActive? {
		let lo = self.lower[u]
		if lo.set && lo.value.k.num == 0 && sv_delta_cmp(self.values[u], lo.value) == 0 {
			return SvActive { side: lo, upper: false }
		}
		let up = self.upper[u]
		if up.set && up.value.k.num == 0 && sv_delta_cmp(self.values[u], up.value) == 0 {
			return SvActive { side: up, upper: true }
		}
		return null
	}

	/// The value of a form over the query columns at the vertex; `null`
	/// where a column has no variable or a step leaves `i64`.
	fn form_value(ref self, row: ref SvRow) -> SvDelta? {
		let mut sum = sv_delta(sv_int(row.constant), sv_int(0))
		let mut i = 0
		while i < row.cols.len() {
			let known: i64? = self.col_var.get(row.cols[i])
			if known == null {
				return null
			}
			let v = known ?? 0
			let term = sv_delta_scale(self.values[v], sv_int(row.ks[i])) ?? return null
			sum = sv_delta_add(sum, term) ?? return null
			i += 1
		}
		return sum
	}

	/// The first row whose GCD test fails, as a Farkas lemma; `null` where
	/// none does.
	fn gcd_conflict(ref mut self, mut book: SvBook) -> SvClause? {
		// Only a row marked since it passed can fail: one that changed, or
		// one holding a variable whose bounds did.
		let vars = self.gcd_vars.clone()
		self.gcd_vars = []
		for v in vars {
			self.gcd_var_in[v] = false
			let col = v.checked_u32() ?? 0
			let mut i = 0
			while i < self.col_rows[v].len() {
				let t = self.col_rows[v][i]
				i += 1
				if !self.gcd_row_in[t] && sv_row_coef(self.rows[t], col) != 0 {
					self.gcd_row(t)
				}
			}
		}
		let mut marked = self.gcd_rows.clone()
		marked.sort()
		let mut at = 0
		while at < marked.len() {
			let r = marked[at]
			if !self.gcd_unchanged(r) {
				let got = self.row_gcd(r, book)
				if got != null {
					// `r` and the rows after it stay marked.
					self.gcd_rows = marked[at..].clone()
					return got
				}
				self.gcd_at[r] = self.stamp
			}
			self.gcd_row_in[r] = false
			at += 1
		}
		self.gcd_rows = []
		return null
	}

	/// Whether row `r` passed the GCD test and neither it nor a bound of one
	/// of its variables changed since.
	fn gcd_unchanged(ref self, r: i64) -> bool {
		let at = self.gcd_at[r]
		if at < self.row_at[r] {
			return false
		}
		for c in self.rows[r].cols {
			if self.bound_at[c as i64] > at {
				return false
			}
		}
		return true
	}

	/// Whether both sides of `v` are set, equal and free of `δ`.
	fn is_fixed(ref self, v: i64) -> bool {
		let lo = self.lower[v]
		let hi = self.upper[v]
		if !lo.set || !hi.set || lo.value.k.num != 0 || hi.value.k.num != 0 {
			return false
		}
		// Two integers compared as such (#2401: once per column of each
		// row the GCD test reads).
		if lo.value.c.den == 1 && hi.value.c.den == 1 {
			return lo.value.c.num == hi.value.c.num
		}
		return sv_rat_cmp(lo.value.c, hi.value.c) == 0
	}

	/// The GCD test on row `r` (see above).
	fn row_gcd(ref mut self, r: i64, mut book: SvBook) -> SvClause? {
		// A real variable may take any rational: no GCD test (ADR-270 D27).
		if self.row_real(r) {
			return null
		}
		let row = self.rows[r]
		let mut g: i64 = 0
		let mut constant = sv_int(0)
		let mut fixed_count = 0
		let mut i = 0
		while i < row.cols.len() {
			let v = row.cols[i] as i64
			let k = row.ks[i]
			i += 1
			if !self.is_fixed(v) {
				g = sv_gcd(g, k) ?? return null
				continue
			}
			fixed_count += 1
			let term = sv_rat_mul(self.lower[v].value.c, sv_int(k)) ?? return null
			constant = sv_rat_add(constant, term) ?? return null
		}
		if g == 0 || fixed_count == 0 {
			return null
		}
		let q = sv_rat_div(constant, sv_int(g)) ?? return null
		if sv_rat_is_int(q) {
			return null
		}
		// The test failed: only now the parts of the lemma are gathered
		// (#1960: gathering them on every row of every check was an eighth of
		// the work on `c_inference`).
		let mut above: Vec[SvPart] = []
		let mut below: Vec[SvPart] = []
		i = 0
		while i < row.cols.len() {
			let v = row.cols[i] as i64
			let k = row.ks[i]
			i += 1
			if !self.is_fixed(v) {
				continue
			}
			let lo = self.lower[v]
			let hi = self.upper[v]
			let a = k.checked_abs() ?? return null
			// `k·v` from above takes a positive `k`'s upper side, from below
			// its lower side.
			if k > 0 {
				above.push(sv_side_part(hi, true, a))
				below.push(sv_side_part(lo, false, a))
			} else {
				above.push(sv_side_part(lo, false, a))
				below.push(sv_side_part(hi, true, a))
			}
		}
		let up = sv_sx_multipliers(above) ?? return null
		let down = sv_sx_multipliers(below) ?? return null
		let a_id = book.combine(up.sources, up.ms) ?? return null
		let b_id = book.combine(down.sources, down.ms) ?? return null
		let ra = book.round(a_id) ?? return null
		let rb = book.round(b_id) ?? return null
		return book.farkas([SvSrc::Fact(ra), SvSrc::Fact(rb)], [1, 1])
	}

	/// The lowest basic query column whose value is no integer and holds no
	/// `δ`, on a row without a real variable; `-1` where there is none.
	fn fractional_basic(ref self) -> i64 {
		let mut v = 0
		while v < self.var_col.len() {
			let value = self.values[v]
			let basic = self.var_col[v] >= 0 && self.row_of[v] >= 0
			if basic && value.c.den != 1 && value.k.num == 0 && !self.row_real(self.row_of[v]) {
				return v
			}
			v += 1
		}
		return -1
	}

	/// Basic `b`'s row read at the vertex; `null` where a non-basic variable
	/// sits on no side free of `δ`.
	fn gomory_row(ref self, b: i64) -> Vec[SvGomory]? {
		let r = self.row_of[b]
		let d = sv_row_coef(self.rows[r], b.checked_u32() ?? return null).checked_neg()
			?? return null
		let mut out: Vec[SvGomory] = []
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let u = self.rows[r].cols[i] as i64
			let k = self.rows[r].ks[i]
			i += 1
			if u == b {
				continue
			}
			let at = self.active(u) ?? return null
			let beta0 = sv_rat(k, d) ?? return null
			let beta = if at.upper { sv_rat_neg(beta0) ?? return null } else { beta0 }
			out.push(SvGomory { var: u, side: at.side, upper: at.upper, beta: beta })
		}
		return out
	}

	/// Gomory's fractional cut on `terms`, combined and rounded in the log:
	/// its bound entry; `null`, nothing written, where it would not cut the
	/// vertex off.
	fn gomory_cg(ref mut self, terms: ref Vec[SvGomory], mut book: SvBook) -> u32? {
		let mut parts: Vec[SvPart] = []
		for t in terms {
			let w = sv_rat_sub(sv_int(sv_rat_ceil(t.beta)), t.beta) ?? return null
			if w.num != 0 {
				parts.push(sv_sx_weighted(t.side, t.upper, w) ?? return null)
			}
		}
		if parts.len() == 0 {
			return null
		}
		let mult = sv_sx_multipliers(parts) ?? return null
		let sum = book.sum(mult.sources, mult.ms) ?? return null
		let g = sv_row_content(sum.row) ?? return null
		if g <= 1 {
			return null
		}
		let cut = sv_rounded(sum, g) ?? return null
		let at = self.form_value(cut.row) ?? return null
		if !sv_sx_violated(cut.rel, at) {
			return null
		}
		let id = book.combine(mult.sources, mult.ms) ?? return null
		return book.round(id)
	}

	/// Gomory's mixed-integer cut for basic `b` on `terms`, written as the
	/// split cut described above; `null` where a step leaves `i64`.
	fn gomory_gmi(ref mut self, b: i64, terms: ref Vec[SvGomory], mut book: SvBook) -> SvGmi? {
		let v = self.values[b].c
		let f0 = sv_rat_sub(v, sv_int(sv_rat_floor(v))) ?? return null
		let rest = sv_rat_sub(sv_int(1), f0) ?? return null
		// `L = F_b - Σ k·s·F_u`, `y' = s·(F_u - bound)`, `s = -1` on an upper side.
		let mut l_terms: Vec[SvTerm] = []
		let form_b = self.var_form[b]
		let mut i = 0
		while i < form_b.cols.len() {
			l_terms.push(SvTerm { col: form_b.cols[i], k: form_b.ks[i] })
			i += 1
		}
		// The cut's coefficient of each column.
		let mut cut: collections::BTreeMap[u32, SvRat] = collections::BTreeMap()
		let mut cut_c = sv_int(1)
		let mut side1: Vec[SvRat] = []
		let mut side2: Vec[SvRat] = []
		for t in terms {
			let s: i64 = if t.upper { -1 } else { 1 }
			let bound = t.side.value.c
			// A side off the integers keeps `k = 0`, so `L*` keeps `f0`.
			let mut k: i64 = 0
			if bound.den == 1 {
				let fl = sv_rat_floor(t.beta)
				let fj = sv_rat_sub(t.beta, sv_int(fl)) ?? return null
				k = if sv_rat_cmp(fj, f0) <= 0 { fl } else { fl.checked_add(1) ?? return null }
			}
			let g = sv_rat_sub(t.beta, sv_int(k)) ?? return null
			let alpha = if g.num >= 0 { sv_rat_div(g, rest) ?? return null } else {
				sv_rat_div(sv_rat_neg(g) ?? return null, f0) ?? return null
			}
			let fa = sv_rat_mul(f0, alpha) ?? return null
			let ra = sv_rat_mul(rest, alpha) ?? return null
			side1.push(sv_rat_add(g, fa) ?? return null)
			side2.push(sv_rat_sub(ra, g) ?? return null)
			let form = self.var_form[t.var]
			let ks = (k.checked_mul(s) ?? return null).checked_neg() ?? return null
			// The cut `1 - Σ α·s·(F_u - bound) <= 0`.
			let a_s = sv_rat_mul(alpha, sv_int(s)) ?? return null
			let mut j = 0
			while j < form.cols.len() {
				let c = form.cols[j]
				if ks != 0 {
					l_terms.push(SvTerm { col: c, k: ks.checked_mul(form.ks[j]) ?? return null })
				}
				let add = sv_rat_mul(a_s, sv_int(form.ks[j])) ?? return null
				let had = cut.get(c) ?? sv_int(0)
				cut.insert(c, sv_rat_sub(had, add) ?? return null)
				j += 1
			}
			cut_c = sv_rat_add(cut_c, sv_rat_mul(a_s, bound) ?? return null) ?? return null
		}
		let l_form = sv_row_of(l_terms, 0) ?? return null
		let at = self.form_value(l_form) ?? return null
		if at.k.num != 0 || at.c.den == 1 {
			return null
		}
		let fl = sv_rat_floor(at.c)
		if sv_rat_cmp(sv_rat_sub(at.c, sv_int(fl)) ?? return null, f0) != 0 {
			return null
		}
		// The cut over one denominator.
		let mut den: i64 = cut_c.den
		for (_, r) in cut {
			let g = sv_gcd(den, r.den) ?? return null
			den = (den / g).checked_mul(r.den) ?? return null
		}
		let mut c_terms: Vec[SvTerm] = []
		for (col, r) in cut {
			c_terms.push(SvTerm { col: col, k: r.num.checked_mul(den / r.den) ?? return null })
		}
		let hold = sv_row_of(c_terms, cut_c.num.checked_mul(den / cut_c.den) ?? return null)
			?? return null
		if hold.cols.len() == 0 {
			return null
		}
		let le = sv_row_sum(1, l_form, 1, sv_row_constant(fl.checked_neg() ?? return null))
			?? return null
		let ge = sv_row_sum(-1, l_form, 1, sv_row_constant(fl.checked_add(1) ?? return null))
			?? return null
		let fail = sv_row_sum(-1, hold, 1, sv_row_constant(1)) ?? return null
		let split_l = book.split(le, ge) ?? return null
		let split_c = book.split(hold, fail) ?? return null
		let s1 = split_l.lits[0]
		let s2 = split_l.lits[1]
		let a_hold = split_c.lits[0]
		let a_fail = split_c.lits[1]
		let mut clauses: Vec[SvClause] = []
		for (side, f, weights) in [(s1, f0.clone(), side1), (s2, rest.clone(), side2)] {
			let mut parts: Vec[SvPart] = [
				SvPart {
					src: SvSrc::Lit(a_fail),
					num: f.num,
					scale: f.den.checked_mul(den) ?? return null,
					neg: false,
				},
				SvPart { src: SvSrc::Lit(side), num: 1, scale: 1, neg: false },
			]
			let mut n = 0
			while n < terms.len() {
				if weights[n].num != 0 {
					parts.push(sv_sx_weighted(
						terms[n].side,
						terms[n].upper,
						weights[n],
					) ?? return null)
				}
				n += 1
			}
			clauses.push(sv_sx_lemma(parts, book) ?? return null)
		}
		let both = sv_lits_union(clauses[0].lits, clauses[1].lits)
		let failing = sv_sx_relit(both, [sv_sx_not(s1), sv_sx_not(s2)], [])
		let c3 = book.learn(failing.clone(), [clauses[0].id, clauses[1].id, split_l.id])
		let holding = sv_sx_relit(failing, [sv_sx_not(a_fail)], [a_hold])
		let c4 = book.learn(holding.clone(), [split_c.id, c3])
		return SvGmi { lit: a_hold, clause: SvClause { id: c4, lits: holding } }
	}

	/// A cut for basic `b` asserted in a level of its own and the check run
	/// again over it; `null`, nothing asserted, where no cut is made. A
	/// conflict over a mixed-integer cut's atom is resolved with the cut's
	/// clause, so the atom never leaves the check.
	fn cut_check(ref mut self, b: i64, limit: ref LgBudget, mut book: SvBook) -> SvChecked? {
		let terms = self.gomory_row(b) ?? return null
		let level = self.level()
		if self.cut_kind == "cg" {
			let id = self.gomory_cg(terms, book) ?? return null
			self.cuts += 1
			self.push_level()
			let mut got = self.fact(id, book)
			match got {
				SvChecked::Consistent => {
					self.cut_depth += 1
					got = self.check(true, limit, book)
					self.cut_depth -= 1
				},
				else => {},
			}
			self.backtrack(level)
			return got
		}
		let made = self.gomory_gmi(b, terms, book) ?? return null
		self.cuts += 1
		self.push_level()
		let mut got = self.assert(made.lit, book)
		match got {
			SvChecked::Consistent => {
				self.cut_depth += 1
				got = self.check(true, limit, book)
				self.cut_depth -= 1
			},
			else => {},
		}
		self.backtrack(level)
		return match got {
			SvChecked::Conflict(k) => {
				let not_hold = sv_sx_not(made.lit)
				if !k.lits.contains(not_hold) {
					return got
				}
				let open = sv_sx_relit(made.clause.lits, [made.lit], [])
				let lits = sv_sx_relit(k.lits, [not_hold], open)
				let id = book.learn(lits.clone(), [made.clause.id, k.id])
				SvChecked::Conflict(SvClause { id: id, lits: lits })
			},
			else => got,
		}
	}
}

/// What pivoting one violated row gave `feasible`.
pub enum SvPivoted {
	/// The row pivoted.
	Done,
	/// The check ends here: the row's conflict, or `overflow` forming it.
	Ended(SvChecked),
	/// Every pivot of the row leaves `i64`; nothing changed.
	Left,
}

/// The basic variable `check` repairs next.
pub struct SvViolation {
	pub row: i64,
	pub var: i64,
	pub below: bool,
}

// --- Tests: the simplex theory (moved from
// `tests/compiler/tests/solver_simplex.nika`, which compiled the solver anew
// in a program of its own on every run): the theory interface's calls one by
// one on three bounds over one column, then problems asserted whole and
// checked. Each conflict is a Farkas lemma, and its log, closed by one
// learned clause, is replayed by `sv_check`; an integer column goes by
// branch-and-bound, each split a D5 step; a literal implied through a row is
// explained by a Farkas lemma; one problem runs under Bland's rule from the
// start and under the smallest-coefficient rule alone; coefficients near
// 2^40 answer *unknown (overflow)*, never a wrong answer ---

fn sv_simplex_test_row1(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn sv_simplex_test_le(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_simplex_test_row1(ks, c), rel: SvRel::Le }
}

fn sv_simplex_test_lt(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_simplex_test_row1(ks, c), rel: SvRel::Lt }
}

fn sv_simplex_test_eq(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_simplex_test_row1(ks, c), rel: SvRel::Eq }
}

fn sv_simplex_test_lits_text(ls: ref Vec[u32]) -> String {
	let mut parts: Vec[String] = []
	for l in ls {
		parts.push(f"{l}")
	}
	return "[" + parts.join(", ") + "]"
}

fn sv_simplex_test_said_by(checked: ref SvChecked) -> String {
	return match checked {
		SvChecked::Consistent => "consistent",
		SvChecked::Conflict(c) => f"conflict {sv_simplex_test_lits_text(c.lits)}",
		SvChecked::Lemmas(ls) => f"{ls.len()} lemmas",
		SvChecked::Unknown(why) => sv_unknown(why),
	}
}

fn sv_simplex_test_model_text(m: ref collections::BTreeMap[String, i64]) -> String {
	let mut parts: Vec[String] = []
	for (name, v) in m {
		parts.push(f"{name} = {v}")
	}
	return parts.join(", ")
}

// Every atom asserted as it stands, one level, then a final check; a
// conflict closed by one learned clause and the log replayed.
fn sv_simplex_test_scenario(
	title: String,
	names: Vec[String],
	atoms: Vec[SvAtom],
	bland_after: i64,
) -> String {
	let mut out: String = ""
	let n = atoms.len()
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	while (a as i64) < n {
		clauses.push([sv_lit(a, false)])
		a += 1
	}
	let query = SvQuery {
		atoms: atoms,
		clauses: clauses,
		columns: names.len().checked_u32() ?? 0,
		reals: [],
	}
	let mut book = sv_book(query) ?? return out + "no value"
	let mut inputs: Vec[u32] = []
	let mut i: u32 = 0
	while (i as i64) < n {
		inputs.push(book.input(i))
		i += 1
	}
	let budget = lg_budget()
	let mut theory = sv_simplex(names)
	theory.bland_after = bland_after
	theory.push_level()
	let mut got = SvChecked::Consistent
	let mut j: u32 = 0
	while (j as i64) < n {
		got = theory.assert(sv_lit(j, false), book)
		match got {
			SvChecked::Consistent => {},
			else => {
				break
			},
		}
		j += 1
	}
	match got {
		SvChecked::Consistent => {
			got = theory.check(true, budget, book)
		},
		else => {},
	}
	let work = f"{theory.pivots} pivots, {theory.splits} splits"
	match got {
		SvChecked::Conflict(c) => {
			let mut hints: Vec[u32] = []
			for l in c.lits {
				hints.push(inputs[(l / 2) as i64])
			}
			hints.push(c.id)
			book.learn([], hints)
			let v = sv_check(query, book.log.steps)
			let said = if v.ok { "checked" } else { f"rejected at {v.step}: {v.reason}" }
			out = out
				+ f"{title}: conflict {sv_simplex_test_lits_text(c.lits)}, {work}, log of {book.log.steps.len()} steps {said}\n"
		},
		SvChecked::Consistent => {
			out = out
				+ f"{title}: consistent, {sv_simplex_test_model_text(theory.model())}, {work}\n"
		},
		else => {
			out = out + f"{title}: {sv_simplex_test_said_by(got)}, {work}\n"
		},
	}
	return out
}

fn sv_simplex_test_calls() -> String {
	let mut out: String = ""
	let atoms = [
		sv_simplex_test_le([1], -2),
		sv_simplex_test_le([1], -5),
		sv_simplex_test_le([-1], 3),
	]
	let query = SvQuery { atoms: atoms, clauses: [[0], [4]], columns: 1, reals: [] }
	let mut book = sv_book(query) ?? return out + "no value"
	let c0 = book.input(0)
	let c1 = book.input(1)
	let budget = lg_budget()
	let mut theory = sv_simplex(["x"])
	theory.push_level()
	out = out + f"assert x <= 2: {sv_simplex_test_said_by(theory.assert(0, book))}\n"
	let implied = theory.propagate(book)
	out = out + f"propagate: {sv_simplex_test_lits_text(implied)}\n"
	let why = theory.explain(2, book) ?? return out + "no value"
	out = out + f"explain x <= 5: {sv_simplex_test_lits_text(why.lits)}\n"
	let first = theory.check(true, budget, book)
	out = out
		+ f"check: {sv_simplex_test_said_by(first)}, model {sv_simplex_test_model_text(theory.model())}\n"
	theory.push_level()
	let conflict = theory.assert(4, book)
	out = out + f"assert x >= 3 at level {theory.level()}: {sv_simplex_test_said_by(conflict)}\n"
	theory.backtrack(1)
	let again = theory.check(true, budget, book)
	out = out
		+ f"backtrack to 1, check: {sv_simplex_test_said_by(again)}, shared {sv_simplex_test_lits_text(theory.shared())}\n"
	match conflict {
		SvChecked::Conflict(c) => {
			book.learn([], [c0, c1, c.id])
		},
		else => {},
	}
	let v = sv_check(query, book.log.steps)
	let said = if v.ok { "checked" } else { v.reason.clone() }
	out = out + f"log of {book.log.steps.len()} steps: {said}\n"
	return out
}

// Propagation through a row: x <= 1 and y <= 1 bound the slack of x + y, so
// x + y <= 4 is implied; its explanation is a Farkas lemma, and the log closed
// against the negated atom is replayed.
fn sv_simplex_test_through_a_row() -> String {
	let mut out: String = ""
	let atoms = [
		sv_simplex_test_le([1], -1),
		sv_simplex_test_le([0, 1], -1),
		sv_simplex_test_le([1, 1], -4),
	]
	let query = SvQuery { atoms: atoms, clauses: [[0], [2], [5]], columns: 2, reals: [] }
	let mut book = sv_book(query) ?? return out + "no value"
	let c0 = book.input(0)
	let c1 = book.input(1)
	let c2 = book.input(2)
	let mut theory = sv_simplex(["x", "y"])
	theory.push_level()
	theory.assert(0, book)
	theory.assert(2, book)
	let implied = theory.propagate(book)
	out = out + f"x <= 1, y <= 1, propagate: {sv_simplex_test_lits_text(implied)}\n"
	let why = theory.explain(4, book) ?? return out + "no value"
	out = out + f"explain x + y <= 4: {sv_simplex_test_lits_text(why.lits)}\n"
	book.learn([], [c0, c1, c2, why.id])
	let v = sv_check(query, book.log.steps)
	let said = if v.ok { "checked" } else { f"rejected at {v.step}: {v.reason}" }
	out = out + f"log of {book.log.steps.len()} steps: {said}\n"
	return out
}

test "the simplex's interface calls one by one leave a log sv_check replays" {
	let out = sv_simplex_test_calls()
	let expected = [
		"assert x <= 2: consistent",
		"propagate: [2, 5]",
		"explain x <= 5: [1, 2]",
		"check: consistent, model x = 0",
		"assert x >= 3 at level 2: conflict [1, 5]",
		"backtrack to 1, check: consistent, shared []",
		"log of 5 steps: checked",
	]
	assert(out == expected.join("\n") + "\n")
}

test "problems asserted whole are answered with a model or a checked conflict" {
	let mut out: String = ""
	out = out
		+ sv_simplex_test_scenario(
			"x + y >= 5, x <= 2, y <= 2",
			["x", "y"],
			[
				sv_simplex_test_le([-1, -1], 5),
				sv_simplex_test_le([1], -2),
				sv_simplex_test_le([0, 1], -2),
			],
			64,
		)
	out = out
		+ sv_simplex_test_scenario(
			"x + y < 3, x >= 1, y >= 2",
			["x", "y"],
			[
				sv_simplex_test_lt([1, 1], -3),
				sv_simplex_test_le([-1], 1),
				sv_simplex_test_le([0, -1], 2),
			],
			64,
		)
	out = out
		+ sv_simplex_test_scenario(
			"x + y <= 3, x >= 1, y >= 2",
			["x", "y"],
			[
				sv_simplex_test_le([1, 1], -3),
				sv_simplex_test_le([-1], 1),
				sv_simplex_test_le([0, -1], 2),
			],
			64,
		)
	out = out + sv_simplex_test_scenario("2x = 1", ["x"], [sv_simplex_test_eq([2], -1)], 64)
	out = out
		+ sv_simplex_test_scenario(
			"2x + 3y = 7, x >= 0, y >= 0",
			["x", "y"],
			[
				sv_simplex_test_eq([2, 3], -7),
				sv_simplex_test_le([-1], 0),
				sv_simplex_test_le([0, -1], 0),
			],
			64,
		)
	out = out
		+ sv_simplex_test_scenario(
			"1 <= 3x - 3y <= 2, 0 <= x, y <= 3",
			["x", "y"],
			[
				sv_simplex_test_le([-3, 3], 1),
				sv_simplex_test_le([3, -3], -2),
				sv_simplex_test_le([-1], 0),
				sv_simplex_test_le([1], -3),
				sv_simplex_test_le([0, -1], 0),
				sv_simplex_test_le([0, 1], -3),
			],
			64,
		)
	let expected = [
		"x + y >= 5, x <= 2, y <= 2: conflict [1, 3, 5], 2 pivots, 0 splits, log of 5 steps checked",
		"x + y < 3, x >= 1, y >= 2: conflict [1, 3, 5], 0 pivots, 0 splits, log of 5 steps checked",
		"x + y <= 3, x >= 1, y >= 2: consistent, x = 1, y = 2, 0 pivots, 0 splits",
		"2x = 1: conflict [1], 0 pivots, 1 splits, log of 6 steps checked",
		"2x + 3y = 7, x >= 0, y >= 0: consistent, x = 2, y = 1, 2 pivots, 0 splits",
		"1 <= 3x - 3y <= 2, 0 <= x, y <= 3: conflict [1, 3], 1 pivots, 0 splits, log of 15 steps checked",
	]
	assert(out == expected.join("\n") + "\n")
}

test "a literal implied through a row is explained by a Farkas lemma" {
	let out = sv_simplex_test_through_a_row()
	let expected = [
		"x <= 1, y <= 1, propagate: [4]",
		"explain x + y <= 4: [1, 3, 4]",
		"log of 5 steps: checked",
	]
	assert(out == expected.join("\n") + "\n")
}

test "both pivot rules answer alike and coefficients near 2^40 answer unknown" {
	let mut out: String = ""
	out = out
		+ sv_simplex_test_scenario(
			"the same, Bland's rule from the start",
			["x", "y"],
			[
				sv_simplex_test_le([-3, 3], 1),
				sv_simplex_test_le([3, -3], -2),
				sv_simplex_test_le([-1], 0),
				sv_simplex_test_le([1], -3),
				sv_simplex_test_le([0, -1], 0),
				sv_simplex_test_le([0, 1], -3),
			],
			0,
		)
	out = out
		+ sv_simplex_test_scenario(
			"the same, smallest coefficient only",
			["x", "y"],
			[
				sv_simplex_test_le([-3, 3], 1),
				sv_simplex_test_le([3, -3], -2),
				sv_simplex_test_le([-1], 0),
				sv_simplex_test_le([1], -3),
				sv_simplex_test_le([0, -1], 0),
				sv_simplex_test_le([0, 1], -3),
			],
			1000000,
		)
	out = out
		+ sv_simplex_test_scenario(
			"two equalities, coefficients near 2^40",
			["x", "y", "z"],
			[
				sv_simplex_test_eq([1099511627689, 1099511627791, 1099511627773], -1),
				sv_simplex_test_eq([1099511627497, -1099511627543, 1099511627531], -3),
				sv_simplex_test_le([-1], 0),
				sv_simplex_test_le([0, -1], 0),
				sv_simplex_test_le([0, 0, -1], 0),
			],
			64,
		)
	let expected = [
		"the same, Bland's rule from the start: conflict [1, 3], 1 pivots, 0 splits, log of 15 steps checked",
		"the same, smallest coefficient only: conflict [1, 3], 1 pivots, 0 splits, log of 15 steps checked",
		// Past `i64` the stage in `BigInt` pivots once, and the answer
		// stays unknown (overflow) (#2707).
		"two equalities, coefficients near 2^40: unknown (overflow), 1 pivots, 0 splits",
	]
	assert(out == expected.join("\n") + "\n")
}

// D11 (#2101): the lowest violated rows can pivot only out of `i64`, so
// the step is not taken while another violated row is left; `u - v + 1 <= 0`
// pivots and with `u + v <= 0` is proved.
test "a pivot that leaves i64 waits for another violated row" {
	let out = sv_simplex_test_scenario(
		"two equalities near 2^40, then u - v + 1 <= 0 and u + v <= 0",
		["x", "y", "z", "u", "v"],
		[
			sv_simplex_test_eq([1099511627689, 1099511627791, 1099511627773], -1),
			sv_simplex_test_eq([1099511627497, -1099511627543, 1099511627531], -3),
			sv_simplex_test_le([-1], 0),
			sv_simplex_test_le([0, -1], 0),
			sv_simplex_test_le([0, 0, -1], 0),
			sv_simplex_test_le([0, 0, 0, -1], 0),
			sv_simplex_test_le([0, 0, 0, 1, -1], 1),
			sv_simplex_test_le([0, 0, 0, 1, 1], 0),
		],
		64,
	)
	assert(out == "two equalities near 2^40, then u - v + 1 <= 0 and u + v <= 0: conflict [11, 13, 15], 1 pivots, 0 splits, log of 10 steps checked\n")
}

// --- Tests: real variables (moved from `tests/compiler/tests/solver_real.nika`,
// which compiled the solver anew in a program of its own on every run): the
// engine reads the sorts `sv_smtlib` gives. `2x = 1` has the model x = 1/2
// over the reals and is proved over the integers; `x < 1 and x > 0` has a
// model strictly inside, `δ` replaced by a rational; `x < 0 and x > 0` is
// proved by a Farkas sum the checker accepts; Fourier-Motzkin answers a real
// script *unknown (theory)*. Then `sv_check` accepts a split and a rounding
// on an integer row and refuses them on a real one ---

// Each file answered over both theories, the sorts taken; then the lines
// the measuring rod writes for it.
fn sv_real_test_answer(source: String) -> String {
	let mut reals: collections::BTreeSet[String] = collections::BTreeSet()
	let script = match sv_smtlib_script(source) {
		SvSmtRead::Script(s, sorts) => {
			reals = sorts.reals
			s
		},
		else => {
			return "unreadable"
		},
	}
	let mut arena = script.arena
	let goal = arena.boolean(false)
	let run = sv_smt_engine_sorted(arena, script.assertions, goal, lg_budget(), "both", reals)
	return match run.driven {
		SvDriven::Proved(query, steps) => {
			let v = sv_check(query, steps)
			if v.ok { f"proved, log of {steps.len()} steps checked" } else {
				f"log rejected: {v.reason}"
			}
		},
		SvDriven::RealModel(values) => {
			let mut parts: Vec[String] = []
			for (name, v) in values {
				parts.push(f"{name} = {sv_rat_text(v)}")
			}
			let held = sv_real_model_holds(arena, script.assertions, goal, values)
			let checked = if held { "checked" } else { "rejected" }
			f"refuted, model {parts.join(", ")} {checked}"
		},
		SvDriven::Answer(LgAnswer::Refuted { .. }) => "refuted over the integers",
		SvDriven::Answer(LgAnswer::Unknown { why }) => sv_unknown(why),
		SvDriven::Answer(_) => "proved without a log",
	}
}

fn sv_real_test_each(name: String, source: String) -> String {
	let mut out: String = f"{name}: {sv_real_test_answer(source)}\n"
	let simplex = sv_line(source, "new-simplex")
	let fm = sv_line(source, "new-fm")
	let both = sv_line(source, "new")
	let old = sv_line(source, "fm")
	out = out + f"  rod: simplex {simplex}; new-fm {fm}; both {both}; fm {old}\n"
	return out
}

fn sv_real_test_row(ks: Vec[i64], c: i64) -> SvRow {
	let mut cols: Vec[u32] = []
	let mut out: Vec[i64] = []
	let mut i: u32 = 0
	for k in ks {
		if k != 0 {
			cols.push(i)
			out.push(k)
		}
		i += 1
	}
	return SvRow { cols: cols, ks: out, constant: c }
}

fn sv_real_test_units(atoms: Vec[SvAtom], columns: u32, reals: Vec[u32]) -> SvQuery {
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	for _ in atoms {
		clauses.push([sv_lit(a, false)])
		a += 1
	}
	return SvQuery { atoms: atoms, clauses: clauses, columns: columns, reals: reals }
}

// 2x <= 1 and 2x >= 1.
fn sv_real_test_half(reals: Vec[u32]) -> SvQuery {
	return sv_real_test_units(
		[
			SvAtom { row: sv_real_test_row([2], -1), rel: SvRel::Le },
			SvAtom { row: sv_real_test_row([-2], 1), rel: SvRel::Le },
		],
		1,
		reals,
	)
}

// Refuted by the split x <= 0 or x >= 1, each side by a Farkas sum.
fn sv_real_test_split_log(query: ref SvQuery) -> SvLog {
	let mut log = sv_log(query)
		?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0, limit: 0, walk: sv_assumes() }
	let a = log.input(0)
	let b = log.input(1)
	let s = log.split(sv_real_test_row([1], 0), sv_real_test_row([-1], 1))
	let low = log.farkas(
		[sv_lit(1, true), sv_lit(2, true)],
		[SvSrc::Lit(sv_lit(1, false)), SvSrc::Lit(sv_lit(2, false))],
		[1, 2],
		1,
	)
	let high = log.farkas(
		[sv_lit(0, true), sv_lit(3, true)],
		[SvSrc::Lit(sv_lit(0, false)), SvSrc::Lit(sv_lit(3, false))],
		[1, 2],
		1,
	)
	log.learn([], [a, b, low, high, s])
	return log
}

// Refuted by rounding each bound: x <= 0 and x >= 1.
fn sv_real_test_round_log(query: ref SvQuery) -> SvLog {
	let mut log = sv_log(query)
		?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0, limit: 0, walk: sv_assumes() }
	let a = log.input(0)
	let b = log.input(1)
	let up = log.combine([SvSrc::Lit(sv_lit(0, false))], [1])
	let r1 = log.round(up, 2)
	let down = log.combine([SvSrc::Lit(sv_lit(1, false))], [1])
	let r2 = log.round(down, 2)
	let f = log.farkas(
		[sv_lit(0, true), sv_lit(1, true)],
		[SvSrc::Fact(r1), SvSrc::Fact(r2)],
		[1, 1],
		1,
	)
	log.learn([], [a, b, f])
	return log
}

// x < 0 and x > 0 over the reals: their Farkas sum is 0 < 0.
fn sv_real_test_empty() -> SvQuery {
	return sv_real_test_units(
		[
			SvAtom { row: sv_real_test_row([1], 0), rel: SvRel::Lt },
			SvAtom { row: sv_real_test_row([-1], 0), rel: SvRel::Lt },
		],
		1,
		[0],
	)
}

fn sv_real_test_empty_log(query: ref SvQuery) -> SvLog {
	let mut log = sv_log(query)
		?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0, limit: 0, walk: sv_assumes() }
	let a = log.input(0)
	let b = log.input(1)
	let f = log.farkas(
		[sv_lit(0, true), sv_lit(1, true)],
		[SvSrc::Lit(sv_lit(0, false)), SvSrc::Lit(sv_lit(1, false))],
		[1, 1],
		1,
	)
	log.learn([], [a, b, f])
	return log
}

test "real scripts are answered with rational models and checked proofs" {
	let real = "(set-logic QF_LRA)\n(declare-const x Real)\n"
	let files = [
		("half", f"{real}(set-info :status sat)\n(assert (= (* 2 x) 1))\n(check-sat)\n"),
		(
			"half-int",
			"(set-logic QF_LIA)\n(set-info :status unsat)\n(declare-const x Int)\n(assert (= (* 2 x) 1))\n(check-sat)\n",
		),
		(
			"inside",
			f"{real}(set-info :status sat)\n(assert (< x 1))\n(assert (> x 0))\n(check-sat)\n",
		),
		(
			"empty",
			f"{real}(set-info :status unsat)\n(assert (< x 0))\n(assert (> x 0))\n(check-sat)\n",
		),
		(
			"mixed",
			"(set-logic QF_LIRA)\n(set-info :status sat)\n(declare-const x Real)\n(declare-const n Int)\n(assert (= (* 3 x) n))\n(assert (< 0 x 1))\n(check-sat)\n",
		),
	]
	let mut out: String = ""
	for (name, text) in files {
		out = out + sv_real_test_each(f"{name}.smt2", text)
	}
	let expected = [
		"half.smt2: refuted, model x = 1/2 checked",
		"  rod: simplex refuted 2; new-fm unknown (theory) 0; both refuted 2; fm unknown (theory) 0",
		"half-int.smt2: proved, log of 4 steps checked",
		"  rod: simplex proved 1/interval; new-fm proved 1/interval; both proved 1/interval; fm proved 1",
		"inside.smt2: refuted, model x = 1/2 checked",
		"  rod: simplex refuted 2; new-fm unknown (theory) 0; both refuted 2; fm unknown (theory) 0",
		"empty.smt2: proved, log of 4 steps checked",
		"  rod: simplex proved 0; new-fm unknown (theory) 0; both proved 0; fm unknown (theory) 0",
		"mixed.smt2: refuted, model n = 1, x = 1/3 checked",
		"  rod: simplex refuted 6; new-fm unknown (theory) 0; both refuted 6; fm unknown (theory) 0",
	]
	assert(out == expected.join("\n") + "\n")
}

test "a split and a rounding are accepted on an integer row and refused on a real one" {
	// The report is `sv_check_test_report` of `sv_check.nika`'s tests.
	let mut out: String = ""
	out = out
		+ sv_check_test_report(
			"2x = 1, x integer: split",
			sv_real_test_half([]),
			sv_real_test_split_log(sv_real_test_half([])),
		)
	out = out
		+ sv_check_test_report(
			"2x = 1, x real: split",
			sv_real_test_half([0]),
			sv_real_test_split_log(sv_real_test_half([0])),
		)
	out = out
		+ sv_check_test_report(
			"2x = 1, x integer: round",
			sv_real_test_half([]),
			sv_real_test_round_log(sv_real_test_half([])),
		)
	out = out
		+ sv_check_test_report(
			"2x = 1, x real: round",
			sv_real_test_half([0]),
			sv_real_test_round_log(sv_real_test_half([0])),
		)
	out = out
		+ sv_check_test_report(
			"x < 0 and x > 0, x real: farkas",
			sv_real_test_empty(),
			sv_real_test_empty_log(sv_real_test_empty()),
		)
	let expected = [
		"2x = 1, x integer: split: accepted (6 steps)",
		"2x = 1, x real: split: rejected at step 2: split: x0 is real, and an integer step may not touch it",
		"2x = 1, x integer: round: accepted (8 steps)",
		"2x = 1, x real: round: rejected at step 3: round: x0 is real, and an integer step may not touch it",
		"x < 0 and x > 0, x real: farkas: accepted (4 steps)",
	]
	assert(out == expected.join("\n") + "\n")
}

// --- Tests: certified cuts (moved from `tests/compiler/tests/solver_cuts.nika`,
// which compiled the solver anew in a program of its own on every run):
// problems over the simplex whose rational relaxation holds and whose
// integer one does not, refuted by the GCD test of a tableau row (`gcd`), by
// Gomory's fractional cut (`cg`, a Chvátal-Gomory derivation: a combination
// rounded) and by Gomory's mixed-integer cut (`gmi`, a split cut: the split,
// one Farkas lemma per side, and the resolution), and by branch-and-bound
// alone (`branch`) for comparison. Each line counts the log's steps by kind
// and says whether `sv_check` replays it; the simplex is exact, so a cut is
// written as it was found ---

fn sv_cuts_test_row1(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn sv_cuts_test_le(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_cuts_test_row1(ks, c), rel: SvRel::Le }
}

fn sv_cuts_test_eq(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_cuts_test_row1(ks, c), rel: SvRel::Eq }
}

// The log's steps by kind: Farkas, Combine, Round, Split, Learn.
fn sv_cuts_test_kinds(steps: ref Vec[SvStep]) -> String {
	let mut f = 0
	let mut c = 0
	let mut r = 0
	let mut s = 0
	let mut l = 0
	for st in steps {
		match st {
			SvStep::Farkas(..) => { f += 1 },
			SvStep::Combine(..) => { c += 1 },
			SvStep::Round(..) => { r += 1 },
			SvStep::Split(..) => { s += 1 },
			SvStep::Learn(..) => { l += 1 },
			else => {},
		}
	}
	return f"{f} farkas, {c} combine, {r} round, {s} split, {l} learn"
}

// The log with one step broken: `round` the first rounding by 1, `strong`
// the cut's split (the second) one too strong.
fn sv_cuts_test_broken(steps: ref Vec[SvStep], how: String) -> Vec[SvStep] {
	let mut out: Vec[SvStep] = []
	let mut rounds = 0
	let mut splits = 0
	for st in steps {
		let mut next = st.clone()
		match st {
			SvStep::Round(id, d) => {
				rounds += 1
				if how == "round" && rounds == 1 {
					next = SvStep::Round(id, 1)
				}
			},
			SvStep::Split(a, b) => {
				splits += 1
				if how == "strong" && splits == 2 {
					let hold = sv_row_sum(1, a, 1, sv_row_constant(1)) ?? a.clone()
					let fail = sv_row_sum(1, b, 1, sv_row_constant(-1)) ?? b.clone()
					next = SvStep::Split(hold, fail)
				}
			},
			else => {},
		}
		out.push(next)
	}
	return out
}

// Every atom asserted, one level, then a final check under `kind`
// (`gcd`: the GCD test alone; `cg`, `gmi`: the test and that cut;
// `branch`: neither); a conflict closed by one learned clause, the log
// replayed, broken as `how` says where it is not `""`.
fn sv_cuts_test_run(
	title: String,
	names: Vec[String],
	atoms: Vec[SvAtom],
	kind: String,
	how: String,
) -> String {
	let mut out: String = ""
	let n = atoms.len()
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	while (a as i64) < n {
		clauses.push([sv_lit(a, false)])
		a += 1
	}
	let query = SvQuery {
		atoms: atoms,
		clauses: clauses,
		columns: names.len().checked_u32() ?? 0,
		reals: [],
	}
	let mut book = sv_book(query) ?? return "no book"
	let mut inputs: Vec[u32] = []
	let mut i: u32 = 0
	while (i as i64) < n {
		inputs.push(book.input(i))
		i += 1
	}
	let budget = lg_budget()
	let mut theory = sv_simplex(names)
	theory.gcd_test = kind != "branch"
	theory.cut_kind = if kind == "cg" || kind == "gmi" { kind.clone() } else { "none" }
	theory.push_level()
	let mut got = SvChecked::Consistent
	let mut j: u32 = 0
	while (j as i64) < n {
		got = theory.assert(sv_lit(j, false), book)
		match got {
			SvChecked::Consistent => {},
			else => {
				break
			},
		}
		j += 1
	}
	match got {
		SvChecked::Consistent => {
			got = theory.check(true, budget, book)
		},
		else => {},
	}
	let work = f"{theory.splits} splits, {theory.cuts} cuts, {theory.gcd_conflicts} gcd"
	match got {
		SvChecked::Conflict(c) => {
			let mut hints: Vec[u32] = []
			for l in c.lits {
				hints.push(inputs[(l / 2) as i64])
			}
			hints.push(c.id)
			book.learn([], hints)
			let steps = if how
				== "" { book.log.steps.clone() } else { sv_cuts_test_broken(book.log.steps, how) }
			let v = sv_check(query, steps)
			let said = if v.ok { "checked" } else { f"rejected at {v.step}: {v.reason}" }
			let label = if how == "" { kind.clone() } else { f"{kind}, {how}" }
			out = out + f"  {label}: conflict, {work}; {sv_cuts_test_kinds(steps)}; {said}\n"
		},
		SvChecked::Consistent => {
			let mut values: Vec[String] = []
			for (name, v) in theory.model() {
				values.push(f"{name} = {v}")
			}
			out = out + f"  {kind}: consistent, {values.join(", ")}, {work}\n"
		},
		SvChecked::Unknown(why) => {
			out = out + f"  {kind}: {sv_unknown(why)}, {work}\n"
		},
		else => {
			out = out + f"  {kind}: lemmas, {work}\n"
		},
	}
	return out
}

fn sv_cuts_test_every(title: String, names: Vec[String], atoms: Vec[SvAtom]) -> String {
	let mut out: String = ""
	out = out + title + "\n"
	for kind in ["gcd", "cg", "gmi", "branch"] {
		out = out + sv_cuts_test_run(title, names.clone(), atoms.clone(), kind, "")
	}
	return out
}

test "x = y, x + y - 2z = 1 is refuted by the GCD test, branching alone runs out of cases" {
	let out = sv_cuts_test_every(
		"x = y, x + y - 2z = 1",
		["x", "y", "z"],
		[sv_cuts_test_eq([1, -1], 0), sv_cuts_test_eq([1, 1, -2], -1)],
	)
	let expected = [
		"x = y, x + y - 2z = 1",
		"  gcd: conflict, 0 splits, 0 cuts, 1 gcd; 1 farkas, 2 combine, 2 round, 0 split, 1 learn; checked",
		"  cg: conflict, 0 splits, 0 cuts, 1 gcd; 1 farkas, 2 combine, 2 round, 0 split, 1 learn; checked",
		"  gmi: conflict, 0 splits, 0 cuts, 1 gcd; 1 farkas, 2 combine, 2 round, 0 split, 1 learn; checked",
		"  branch: unknown (cases), 1024 splits, 0 cuts, 0 gcd",
	]
	assert(out == expected.join("\n") + "\n")
}

test "the band 1 <= 3x - 3y <= 2 is refuted by one mixed-integer cut where branching takes six splits" {
	let out = sv_cuts_test_every(
		"1 <= 3x - 3y <= 2, 0 <= x, y <= 3",
		["x", "y"],
		[
			sv_cuts_test_le([-3, 3], 1),
			sv_cuts_test_le([3, -3], -2),
			sv_cuts_test_le([-1], 0),
			sv_cuts_test_le([1], -3),
			sv_cuts_test_le([0, -1], 0),
			sv_cuts_test_le([0, 1], -3),
		],
	)
	let expected = [
		"1 <= 3x - 3y <= 2, 0 <= x, y <= 3",
		"  gcd: conflict, 6 splits, 0 cuts, 0 gcd; 7 farkas, 0 combine, 0 round, 6 split, 7 learn; checked",
		"  cg: conflict, 6 splits, 0 cuts, 0 gcd; 7 farkas, 0 combine, 0 round, 6 split, 7 learn; checked",
		"  gmi: conflict, 0 splits, 1 cuts, 0 gcd; 3 farkas, 0 combine, 0 round, 2 split, 4 learn; checked",
		"  branch: conflict, 6 splits, 0 cuts, 0 gcd; 7 farkas, 0 combine, 0 round, 6 split, 7 learn; checked",
	]
	assert(out == expected.join("\n") + "\n")
}

test "the band 1 <= 3x + 5y <= 2 is refuted by one fractional or one mixed-integer cut" {
	let out = sv_cuts_test_every(
		"1 <= 3x + 5y <= 2, 0 <= x, y <= 1",
		["x", "y"],
		[
			sv_cuts_test_le([-3, -5], 1),
			sv_cuts_test_le([3, 5], -2),
			sv_cuts_test_le([-1], 0),
			sv_cuts_test_le([1], -1),
			sv_cuts_test_le([0, -1], 0),
			sv_cuts_test_le([0, 1], -1),
		],
	)
	let expected = [
		"1 <= 3x + 5y <= 2, 0 <= x, y <= 1",
		"  gcd: conflict, 2 splits, 0 cuts, 0 gcd; 3 farkas, 0 combine, 0 round, 2 split, 3 learn; checked",
		"  cg: conflict, 0 splits, 1 cuts, 0 gcd; 1 farkas, 1 combine, 1 round, 0 split, 1 learn; checked",
		"  gmi: conflict, 0 splits, 1 cuts, 0 gcd; 3 farkas, 0 combine, 0 round, 2 split, 4 learn; checked",
		"  branch: conflict, 2 splits, 0 cuts, 0 gcd; 3 farkas, 0 combine, 0 round, 2 split, 3 learn; checked",
	]
	assert(out == expected.join("\n") + "\n")
}

test "the equation 2x + 3y = 7 is consistent under every kind of cut" {
	let out = sv_cuts_test_every(
		"2x + 3y = 7, x >= 0, y >= 0",
		["x", "y"],
		[sv_cuts_test_eq([2, 3], -7), sv_cuts_test_le([-1], 0), sv_cuts_test_le([0, -1], 0)],
	)
	let expected = [
		"2x + 3y = 7, x >= 0, y >= 0",
		"  gcd: consistent, x = 2, y = 1, 2 splits, 0 cuts, 0 gcd",
		"  cg: consistent, x = 2, y = 1, 0 splits, 1 cuts, 0 gcd",
		"  gmi: consistent, x = 2, y = 1, 0 splits, 1 cuts, 0 gcd",
		"  branch: consistent, x = 2, y = 1, 2 splits, 0 cuts, 0 gcd",
	]
	assert(out == expected.join("\n") + "\n")
}

test "a cut's log with a rounding left out or the cut made too strong is rejected" {
	let mut out: String = "broken: the first rounding by 1 (none), the mixed-integer cut one too strong\n"
	out = out
		+ sv_cuts_test_run(
			"",
			["x", "y", "z"],
			[sv_cuts_test_eq([1, -1], 0), sv_cuts_test_eq([1, 1, -2], -1)],
			"gcd",
			"round",
		)
	out = out
		+ sv_cuts_test_run(
			"",
			["x", "y"],
			[
				sv_cuts_test_le([-3, -5], 1),
				sv_cuts_test_le([3, 5], -2),
				sv_cuts_test_le([-1], 0),
				sv_cuts_test_le([1], -1),
				sv_cuts_test_le([0, -1], 0),
				sv_cuts_test_le([0, 1], -1),
			],
			"cg",
			"round",
		)
	out = out
		+ sv_cuts_test_run(
			"",
			["x", "y"],
			[
				sv_cuts_test_le([-3, -5], 1),
				sv_cuts_test_le([3, 5], -2),
				sv_cuts_test_le([-1], 0),
				sv_cuts_test_le([1], -1),
				sv_cuts_test_le([0, -1], 0),
				sv_cuts_test_le([0, 1], -1),
			],
			"gmi",
			"strong",
		)
	let expected = [
		"broken: the first rounding by 1 (none), the mixed-integer cut one too strong",
		"  gcd, round: conflict, 0 splits, 0 cuts, 1 gcd; 1 farkas, 2 combine, 2 round, 0 split, 1 learn; rejected at 6: farkas: x1 is left in the combination",
		"  cg, round: conflict, 0 splits, 1 cuts, 0 gcd; 1 farkas, 1 combine, 1 round, 0 split, 1 learn; rejected at 8: farkas: x0 is left in the combination",
		"  gmi, strong: conflict, 0 splits, 1 cuts, 0 gcd; 3 farkas, 0 combine, 0 round, 2 split, 4 learn; rejected at 8: farkas: the combination ends in 0 <= 0, no contradiction",
	]
	assert(out == expected.join("\n") + "\n")
}

// --- Tests: the split at the bottom of `i64` (#1632). `x + y < -i64::MAX`
// and `y >= 1` put `x` at `i64::MIN - δ`, whose floor in the order with `δ`
// is `i64::MIN - 1`: the split answers *unknown (overflow)*, it does not
// stop the program ---

fn sv_simplex_test_split_at_min(low_first: bool) -> String {
	let big = sv_simplex_test_lt([1, 1], 9223372036854775807)
	let low = sv_simplex_test_le([0, -1], 1)
	let atoms = if low_first { [low, big] } else { [big, low] }
	let query = SvQuery { atoms: atoms, clauses: [[0], [2]], columns: 2, reals: [] }
	let mut book = sv_book(query) ?? return "no value"
	let mut theory = sv_simplex(["x", "y"])
	theory.cut_kind = "none"
	theory.gcd_test = false
	theory.push_level()
	let a = theory.assert(0, book)
	let b = theory.assert(2, book)
	let got = theory.check(true, lg_budget(), book)
	return f"{sv_simplex_test_said_by(a)}, {sv_simplex_test_said_by(b)}, {sv_simplex_test_said_by(got)}, {theory.splits} splits, {theory.overflows} overflows\n"
}

test "a split below i64::MIN answers unknown (overflow)" {
	let out = sv_simplex_test_split_at_min(true) + sv_simplex_test_split_at_min(false)
	let expected = [
		"consistent, consistent, unknown (overflow), 1 splits, 1 overflows",
		"consistent, consistent, unknown (overflow), 1 splits, 1 overflows",
	]
	assert(out == expected.join("\n") + "\n")
}
