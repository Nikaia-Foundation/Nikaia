// packages/logic/src/prover_arena.nika
//
// **The prover's terms, held in Nikaia** (ADR-270 D2, ADR-294, #436 step 4):
// an arena of `SolverTerm` nodes, each child named by its place, with the
// operations the prover's walk uses - the same ones, with the same results,
// as `nikaia-logic`'s `Arena`. A term never changes once built; what
// `substitute` makes is new nodes, as there.
//
// The solver still reads `nikaia-logic`'s arena: a question is handed over
// with the nodes it reads (`prover.nika`'s `ask`), so the two hold the same
// terms in the same order.

use std::collections

/// The terms of one walk. Appended to, never changed.
///
/// **Each variable is numbered once** (#2062): `var` gives back the node it
/// made for a name before, and every node keeps the numbers of the variables
/// it reads, sorted (`variable_ids`), counted from its children's when it is
/// made, since a term's names never change. A node a builder appends to
/// `nodes` itself (`prove_terms.nika`'s `built`) is counted at the next node
/// the arena makes (`read_all`).
pub struct TermArena {
    pub nodes: Vec[SolverTerm],
    /// A variable's name to its number.
    var_ids: collections::BTreeMap[String, i64],
    /// A variable's number to the node `var` gives for it.
    var_nodes: Vec[i64],
    /// A variable's number to its name.
    var_names: Vec[String],
    /// Per node, the sorted numbers of the variables it reads.
    reads: Vec[Vec[i64]],
}

impl TermArena {
    pub fn empty() -> TermArena sync {
        return TermArena { nodes: [], var_ids: collections::BTreeMap(), var_nodes: [], var_names: [], reads: [] }
    }

    fn push(ref mut self, node: SolverTerm) -> i64 {
        self.read_all()
        let read = self.read_by(node, self.nodes.len())
        self.nodes.push(node)
        self.reads.push(read)
        return self.nodes.len() - 1
    }

    /// The variables of each node appended without `push` counted.
    fn read_all(ref mut self) {
        while self.reads.len() < self.nodes.len() {
            let at = self.reads.len()
            let node = self.nodes[at].clone()
            let read = self.read_by(node, at)
            self.reads.push(read)
        }
    }

    /// The sorted numbers of the variables `node`, placed at `at`, reads:
    /// its children's, or its own name's, numbered here if it is new.
    fn read_by(ref mut self, node: ref SolverTerm, at: i64) -> Vec[i64] {
        return match node {
            SolverTerm::Var(name) => [self.numbered(name, at)],
            SolverTerm::Neg(a) => self.reads[a].clone(),
            SolverTerm::Not(a) => self.reads[a].clone(),
            SolverTerm::Quot(a, _) => self.reads[a].clone(),
            SolverTerm::Add(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::Sub(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::Mul(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::Le(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::Lt(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::Ge(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::Gt(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::Eq(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::Ne(a, b) => merged_ids(self.reads[a], self.reads[b]),
            SolverTerm::And(parts) => self.parts_read(parts),
            SolverTerm::Or(parts) => self.parts_read(parts),
            else => [],
        }
    }

    fn parts_read(ref self, parts: ref Vec[i64]) -> Vec[i64] {
        let mut out: Vec[i64] = []
        for part in parts {
            out = merged_ids(out, self.reads[part])
        }
        return out
    }

    /// The number of the variable `name`, given to it, with `at` as its
    /// node, where it has none yet.
    fn numbered(ref mut self, name: ref String, at: i64) -> i64 {
        let known = self.var_ids.get(name)
        if known != null {
            return known ?? 0
        }
        let number = self.var_nodes.len()
        self.var_ids.insert(name.clone(), number)
        self.var_nodes.push(at)
        self.var_names.push(name.clone())
        return number
    }

    /// **The sorted numbers of the variables `id` reads** (#2062), as
    /// `variables` names them; for a node the arena made, or one appended
    /// before the arena made another.
    pub fn variable_ids(ref self, id: i64) -> ref Vec[i64] sync {
        return self.reads[id]
    }

    /// The name of the variable numbered `n`.
    pub fn variable_name(ref self, n: i64) -> ref String sync {
        return self.var_names[n]
    }

    /// The number of the variable `name`, where a node read it.
    pub fn variable_id(ref self, name: ref String) -> i64? sync {
        return self.var_ids.get(name)
    }

    /// How many variables are numbered: every number is below it.
    pub fn variable_count(ref self) -> i64 sync {
        return self.var_nodes.len()
    }

    pub fn at(ref self, id: i64) -> SolverTerm sync {
        return self.nodes[id].clone()
    }

    pub fn boolean(ref mut self, value: bool) -> i64 sync {
        return self.push(SolverTerm::Bool(value))
    }

    pub fn int(ref mut self, value: i64) -> i64 sync {
        return self.push(SolverTerm::Int(value))
    }

    /// The variable `name`: the node made for it before, where there is one.
    pub fn var(ref mut self, name: ref String) -> i64 sync {
        self.read_all()
        let known = self.var_ids.get(name)
        if known != null {
            return self.var_nodes[known ?? 0]
        }
        return self.push(SolverTerm::Var(name.clone()))
    }

    pub fn add(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Add(a, b))
    }

    pub fn sub(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Sub(a, b))
    }

    pub fn neg(ref mut self, a: i64) -> i64 sync {
        return self.push(SolverTerm::Neg(a))
    }

    pub fn mul(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Mul(a, b))
    }

    /// `a / k` for a positive constant `k`, truncated toward zero.
    pub fn quot(ref mut self, a: i64, k: i64) -> i64 sync {
        return self.push(SolverTerm::Quot(a, k))
    }

    pub fn le(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Le(a, b))
    }

    pub fn lt(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Lt(a, b))
    }

    pub fn ge(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Ge(a, b))
    }

    pub fn gt(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Gt(a, b))
    }

    pub fn equal(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Eq(a, b))
    }

    pub fn unequal(ref mut self, a: i64, b: i64) -> i64 sync {
        return self.push(SolverTerm::Ne(a, b))
    }

    pub fn and(ref mut self, parts: Vec[i64]) -> i64 sync {
        return self.push(SolverTerm::And(parts))
    }

    pub fn or(ref mut self, parts: Vec[i64]) -> i64 sync {
        return self.push(SolverTerm::Or(parts))
    }

    pub fn not(ref mut self, a: i64) -> i64 sync {
        return self.push(SolverTerm::Not(a))
    }

    /// Whether `id` reads the variable `name`.
    /// Whether the term `id` reads the variable `name`, numbered `n`
    /// (`variable_id`, -1 for none): a node `reads` holds lists it, and a
    /// name without a number is under none of them (#2062).
    pub fn mentions_numbered(ref self, id: i64, n: i64, name: ref String) -> bool sync {
        if id < self.reads.len() {
            return n >= 0 && self.reads[id].contains(n)
        }
        return self.mentions(id, name)
    }

    pub fn mentions(ref self, id: i64, name: ref String) -> bool sync {
        return match self.nodes[id] {
            SolverTerm::Var(n) => n == name,
            SolverTerm::Neg(a) => self.mentions(a, name),
            SolverTerm::Not(a) => self.mentions(a, name),
            SolverTerm::Add(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Sub(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Mul(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Quot(a, _) => self.mentions(a, name),
            SolverTerm::Le(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Lt(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Ge(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Gt(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Eq(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::Ne(a, b) => self.mentions(a, name) || self.mentions(b, name),
            SolverTerm::And(parts) => self.any_mentions(parts, name),
            SolverTerm::Or(parts) => self.any_mentions(parts, name),
            else => false,
        }
    }

    fn any_mentions(ref self, parts: ref Vec[i64], name: ref String) -> bool {
        for part in parts {
            if self.mentions(part, name) {
                return true
            }
        }
        return false
    }

    /// Every variable `id` reads, added to `names`.
    pub fn variables(ref self, id: i64, mut names: collections::BTreeSet[String]) sync {
        match self.nodes[id] {
            SolverTerm::Var(name) => {
                if !names.contains(name) {
                    names.insert(name.clone())
                }
            },
            SolverTerm::Neg(a) => self.variables(a, names),
            SolverTerm::Not(a) => self.variables(a, names),
            SolverTerm::Add(a, b) => self.both_variables(a, b, names),
            SolverTerm::Sub(a, b) => self.both_variables(a, b, names),
            SolverTerm::Mul(a, b) => self.both_variables(a, b, names),
            SolverTerm::Quot(a, _) => self.variables(a, names),
            SolverTerm::Le(a, b) => self.both_variables(a, b, names),
            SolverTerm::Lt(a, b) => self.both_variables(a, b, names),
            SolverTerm::Ge(a, b) => self.both_variables(a, b, names),
            SolverTerm::Gt(a, b) => self.both_variables(a, b, names),
            SolverTerm::Eq(a, b) => self.both_variables(a, b, names),
            SolverTerm::Ne(a, b) => self.both_variables(a, b, names),
            SolverTerm::And(parts) => {
                for part in parts {
                    self.variables(part, names)
                }
            },
            SolverTerm::Or(parts) => {
                for part in parts {
                    self.variables(part, names)
                }
            },
            else => {},
        }
    }

    fn both_variables(ref self, a: i64, b: i64, mut names: collections::BTreeSet[String]) {
        self.variables(a, names)
        self.variables(b, names)
    }

    /// The value of an integer term that reads no variable, where it fits.
    pub fn constant(ref self, id: i64) -> i64? sync {
        return match self.nodes[id] {
            SolverTerm::Int(n) => n,
            SolverTerm::Neg(a) => {
                let v = self.constant(a) ?? return null
                v.checked_neg()
            },
            SolverTerm::Add(a, b) => {
                let x = self.constant(a) ?? return null
                let y = self.constant(b) ?? return null
                x.checked_add(y)
            },
            SolverTerm::Sub(a, b) => {
                let x = self.constant(a) ?? return null
                let y = self.constant(b) ?? return null
                x.checked_sub(y)
            },
            SolverTerm::Mul(a, b) => {
                let x = self.constant(a) ?? return null
                let y = self.constant(b) ?? return null
                x.checked_mul(y)
            },
            SolverTerm::Quot(a, k) => {
                let x = self.constant(a) ?? return null
                x.checked_div(k)
            },
            else => null,
        }
    }

    /// An integer term's value under `values`, where it has one: every
    /// variable it reads is given, and nothing leaves `i64`.
    pub fn int_value(ref self, id: i64, values: ref collections::BTreeMap[String, i64]) -> i64? sync {
        return match self.nodes[id] {
            SolverTerm::Int(n) => n,
            SolverTerm::Var(name) => {
                let found = values[name] ?? return null
                found
            },
            SolverTerm::Neg(a) => {
                let v = self.int_value(a, values) ?? return null
                v.checked_neg()
            },
            SolverTerm::Add(a, b) => {
                let x = self.int_value(a, values) ?? return null
                let y = self.int_value(b, values) ?? return null
                x.checked_add(y)
            },
            SolverTerm::Sub(a, b) => {
                let x = self.int_value(a, values) ?? return null
                let y = self.int_value(b, values) ?? return null
                x.checked_sub(y)
            },
            SolverTerm::Mul(a, b) => {
                let x = self.int_value(a, values) ?? return null
                let y = self.int_value(b, values) ?? return null
                x.checked_mul(y)
            },
            SolverTerm::Quot(a, k) => {
                let x = self.int_value(a, values) ?? return null
                x.checked_div(k)
            },
            else => null,
        }
    }

    /// **`id` with each variable `given` names replaced by its term**; a
    /// variable it does not name stays. Built anew at every node that is not
    /// a leaf, changed or not, as `nikaia-logic`'s arena builds it.
    pub fn substitute(ref mut self, id: i64, given: ref collections::BTreeMap[String, i64]) -> i64 sync {
        let node = self.nodes[id].clone()
        return match node {
            SolverTerm::Var(name) => given.get(name) ?? id,
            SolverTerm::Bool(_) => id,
            SolverTerm::Int(_) => id,
            SolverTerm::Neg(a) => {
                let x = self.substitute(a, given)
                self.push(SolverTerm::Neg(x))
            },
            SolverTerm::Not(a) => {
                let x = self.substitute(a, given)
                self.push(SolverTerm::Not(x))
            },
            SolverTerm::Add(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Add(x, y))
            },
            SolverTerm::Sub(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Sub(x, y))
            },
            SolverTerm::Mul(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Mul(x, y))
            },
            SolverTerm::Quot(a, k) => {
                let x = self.substitute(a, given)
                self.push(SolverTerm::Quot(x, k))
            },
            SolverTerm::Le(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Le(x, y))
            },
            SolverTerm::Lt(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Lt(x, y))
            },
            SolverTerm::Ge(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Ge(x, y))
            },
            SolverTerm::Gt(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Gt(x, y))
            },
            SolverTerm::Eq(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Eq(x, y))
            },
            SolverTerm::Ne(a, b) => {
                let x = self.substitute(a, given)
                let y = self.substitute(b, given)
                self.push(SolverTerm::Ne(x, y))
            },
            SolverTerm::And(parts) => {
                let mut changed: Vec[i64] = []
                for part in parts {
                    changed.push(self.substitute(part, given))
                }
                self.push(SolverTerm::And(changed))
            },
            SolverTerm::Or(parts) => {
                let mut changed: Vec[i64] = []
                for part in parts {
                    changed.push(self.substitute(part, given))
                }
                self.push(SolverTerm::Or(changed))
            },
            else => id,
        }
    }

    /// How many terms `id` is made of, counting a shared one each time.
    pub fn size(ref self, id: i64) -> i64 sync {
        return 1 + match self.nodes[id] {
            SolverTerm::Neg(a) => self.size(a),
            SolverTerm::Not(a) => self.size(a),
            SolverTerm::Add(a, b) => self.size(a) + self.size(b),
            SolverTerm::Sub(a, b) => self.size(a) + self.size(b),
            SolverTerm::Mul(a, b) => self.size(a) + self.size(b),
            SolverTerm::Quot(a, _) => self.size(a),
            SolverTerm::Le(a, b) => self.size(a) + self.size(b),
            SolverTerm::Lt(a, b) => self.size(a) + self.size(b),
            SolverTerm::Ge(a, b) => self.size(a) + self.size(b),
            SolverTerm::Gt(a, b) => self.size(a) + self.size(b),
            SolverTerm::Eq(a, b) => self.size(a) + self.size(b),
            SolverTerm::Ne(a, b) => self.size(a) + self.size(b),
            SolverTerm::And(parts) => self.parts_size(parts),
            SolverTerm::Or(parts) => self.parts_size(parts),
            else => 0,
        }
    }

    fn parts_size(ref self, parts: ref Vec[i64]) -> i64 {
        let mut total = 0
        for part in parts {
            total += self.size(part)
        }
        return total
    }

    /// Whether `id` is the variable `name` itself.
    /// A term as a reader writes it (`prove_text.nika`'s `term_text`).
    pub fn text(ref self, id: i64) -> String sync {
        return term_text(id) fn(at) { self.at(at) }
    }

    /// **Nodes built elsewhere, appended** in their order, each child moved
    /// by where the list starts here: the place of the last, which is the
    /// root a builder makes last.
    pub fn adopt(ref mut self, nodes: ref Vec[SolverTerm]) -> i64 sync {
        let base = self.nodes.len()
        for node in nodes {
            let moved = match node {
                SolverTerm::Add(a, b) => SolverTerm::Add(a + base, b + base),
                SolverTerm::Sub(a, b) => SolverTerm::Sub(a + base, b + base),
                SolverTerm::Neg(a) => SolverTerm::Neg(a + base),
                SolverTerm::Mul(a, b) => SolverTerm::Mul(a + base, b + base),
                SolverTerm::Quot(a, k) => SolverTerm::Quot(a + base, k),
                SolverTerm::Le(a, b) => SolverTerm::Le(a + base, b + base),
                SolverTerm::Lt(a, b) => SolverTerm::Lt(a + base, b + base),
                SolverTerm::Ge(a, b) => SolverTerm::Ge(a + base, b + base),
                SolverTerm::Gt(a, b) => SolverTerm::Gt(a + base, b + base),
                SolverTerm::Eq(a, b) => SolverTerm::Eq(a + base, b + base),
                SolverTerm::Ne(a, b) => SolverTerm::Ne(a + base, b + base),
                SolverTerm::And(parts) => SolverTerm::And(moved_by(parts, base)),
                SolverTerm::Or(parts) => SolverTerm::Or(moved_by(parts, base)),
                SolverTerm::Not(a) => SolverTerm::Not(a + base),
                else => node.clone(),
            }
            self.nodes.push(moved)
        }
        self.read_all()
        return self.nodes.len() - 1
    }

    /// **The nodes of `id` alone**, each child before the node that names
    /// it and `id` last, as `adopt` takes them: a term handed to another
    /// arena, a result summary's exit to the bounds walk (ADR-359 D14).
    pub fn nodes_of(ref self, id: i64) -> Vec[SolverTerm] sync {
        let mut out: Vec[SolverTerm] = []
        self.copied_into(id, out)
        return out
    }

    /// `id` copied to the end of `out`, its children first: its place there.
    fn copied_into(ref self, id: i64, mut out: Vec[SolverTerm]) -> i64 {
        match self.at(id) {
            SolverTerm::Add(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Add(x, y))
            },
            SolverTerm::Sub(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Sub(x, y))
            },
            SolverTerm::Mul(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Mul(x, y))
            },
            SolverTerm::Le(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Le(x, y))
            },
            SolverTerm::Lt(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Lt(x, y))
            },
            SolverTerm::Ge(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Ge(x, y))
            },
            SolverTerm::Gt(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Gt(x, y))
            },
            SolverTerm::Eq(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Eq(x, y))
            },
            SolverTerm::Ne(a, b) => {
                let x = self.copied_into(a, out)
                let y = self.copied_into(b, out)
                out.push(SolverTerm::Ne(x, y))
            },
            SolverTerm::Neg(a) => {
                let x = self.copied_into(a, out)
                out.push(SolverTerm::Neg(x))
            },
            SolverTerm::Not(a) => {
                let x = self.copied_into(a, out)
                out.push(SolverTerm::Not(x))
            },
            SolverTerm::Quot(a, k) => {
                let x = self.copied_into(a, out)
                out.push(SolverTerm::Quot(x, k))
            },
            SolverTerm::And(parts) => {
                let mut moved: Vec[i64] = []
                for part in parts {
                    moved.push(self.copied_into(part, out))
                }
                out.push(SolverTerm::And(moved))
            },
            SolverTerm::Or(parts) => {
                let mut moved: Vec[i64] = []
                for part in parts {
                    moved.push(self.copied_into(part, out))
                }
                out.push(SolverTerm::Or(moved))
            },
            else => out.push(self.at(id)),
        }
        return out.len() - 1
    }

    pub fn is_the_variable(ref self, id: i64, name: ref String) -> bool sync {
        return match self.nodes[id] {
            SolverTerm::Var(n) => n == name,
            else => false,
        }
    }
}

/// The numbers of `a` and of `b`, both sorted, in one sorted list without
/// repeats.
fn merged_ids(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    if b.is_empty() {
        return a.clone()
    }
    if a.is_empty() {
        return b.clone()
    }
    let mut out: Vec[i64] = []
    let mut i = 0
    let mut j = 0
    while i < a.len() && j < b.len() {
        if a[i] < b[j] {
            out.push(a[i])
            i += 1
        } else if b[j] < a[i] {
            out.push(b[j])
            j += 1
        } else {
            out.push(a[i])
            i += 1
            j += 1
        }
    }
    while i < a.len() {
        out.push(a[i])
        i += 1
    }
    while j < b.len() {
        out.push(b[j])
        j += 1
    }
    return out
}

fn moved_by(parts: ref Vec[i64], base: i64) -> Vec[i64] {
    let mut out: Vec[i64] = []
    for p in parts {
        out.push(p + base)
    }
    return out
}
