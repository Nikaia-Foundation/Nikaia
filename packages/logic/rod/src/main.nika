// packages/logic/rod/src/main.nika
//
// **The measuring rod's driver** (ADR-270 D17, #1281): a program of its own
// that depends on the package `logic` (ADR-270 D26, #2020) and runs it on
// SMT-LIB 2 files; `scripts/solver.nika` builds it. The per-file line lives
// in the package (`sv_rod_line.nika`), so the package's tests and the CLI
// share it; only the CLI entry stays here: it is the harness, not the solver.

use logic
use std::cli
use std::fs

/// The program's entry: `ENGINE FILE...`, one line per file. The engine is
/// `fm`, Fourier-Motzkin as the compiler runs it, or `new`, the CDCL(T)
/// engine of `sv_smt.nika` over both theories (`new-fm`, `new-simplex`: over
/// one). `--stats ENGINE FILE...`: each answer followed by the counters.
fn main() throws {
	let mut args: Vec[String] = []
	for a in cli::args() {
		args.push(a)
	}
	let stats = args.len() > 1 && args[1] == "--stats"
	let from = if stats { 2 } else { 1 }
	let engine = args[from].clone()
	for path in args.iter().skip(from + 1) {
		let source = fs::read_to_string(path.clone(), fs::Root::Anywhere)
		println(logic::sv_line_stats(source, engine, stats))
	}
}
