[type."LgAnswer"]
pub = true
variants = ["Proved { certificate: LgCertificate }", "Refuted { model: LgModel }", "Unknown { why: LgUnknown }"]
compares = true
equates = true
hashes = true

[type."LgBelow"]
fields = ["step: String", "lits: Vec[String]"]
compares = true
equates = true
hashes = true

[type."LgBranch"]
fields = ["held_atoms: Vec[i64]", "held_why: Vec[collections::BTreeSet[i64]]", "open_ors: Vec[i64]", "open_why: Vec[collections::BTreeSet[i64]]"]
compares = true
equates = true
hashes = true

[type."LgBudget"]
pub = true
fields = ["pub cases: i64", "pub bounds: i64"]
compares = true
equates = true
hashes = true
copies = true

[type."LgCertificate"]
pub = true
variants = ["Refuted(LgRefutation)", "Split { disjunction: i64, cases: Vec[LgCertificate] }"]
compares = true
equates = true
hashes = true

[type."LgChecking"]
fields = ["held: collections::BTreeSet[i64]", "open: collections::BTreeSet[i64]"]
compares = true
equates = true
hashes = true

[type."LgClause"]
fields = ["step: String", "parts: Vec[LgPart]"]
compares = true
equates = true
hashes = true

[type."LgClosed"]
variants = ["Refuted(LgRefutation)", "Consistent { found: bool, values: collections::BTreeMap[String, i64] }", "Unknown(LgUnknown)"]
compares = true
equates = true
hashes = true

[type."LgExit"]
pub = true
fields = ["pub kind: String", "pub relation: i64"]
compares = true
equates = true
hashes = true

[type."LgForm"]
fields = ["terms: collections::BTreeMap[String, i64]", "constant: i64"]
compares = true
equates = true
hashes = true

[type."LgFormula"]
variants = ["True", "False", "Le(LgLin)", "And(Vec[LgFormula])", "Or(Vec[LgFormula])"]
compares = true
equates = true
hashes = true

[type."LgHeld"]
fields = ["lin: LgLin", "step: i64", "form: Vec[i64]"]
compares = true
equates = true
hashes = true

[type."LgIndexed"]
pub = true
fields = ["pub atoms: Vec[LgLin]", "pub ors: Vec[Vec[Vec[LgItem]]]", "pub top: Vec[LgItem]"]
compares = true
equates = true
hashes = true

[type."LgItem"]
pub = true
fields = ["pub atom: bool", "pub n: i64"]
compares = true
equates = true
