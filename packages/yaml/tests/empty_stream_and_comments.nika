use yaml

fn show(n: ref yaml::Node) -> String {
	return match n.value {
		yaml::Value::Null => "null"
		yaml::Value::Bool(b) => f"bool({b})"
		yaml::Value::Int(t) => f"int({t})"
		yaml::Value::Float(t) => f"float({t})"
		yaml::Value::Str(s) => f"str({s.raw})"
		yaml::Value::Alias(a) => f"alias({a})"
		yaml::Value::Seq(items) => {
			let parts: Vec[String] = items.iter().map(fn(x) { show(x) }).collect()
			f"[{parts.join(", ")}]"
		}
		yaml::Value::Map(entries) => {
			let parts: Vec[String] = entries.iter().map(fn(e) {
				f"{show(e.key)}: {show(e.value)}"
			}).collect()
			f"{{{parts.join(", ")}}}"
		}
	}
}

fn line(text: String) {
	let input = Bytes(text.bytes().collect())
	let docs = yaml::parse(input) catch {
		println(f"error {error.line}:{error.column}: {error.message}")
		return
	}
	let parts: Vec[String] = docs.iter().map(fn(d) { show(d) }).collect()
	println(f"{docs.len()} [{parts.join(" | ")}]")
}

fn main() {
	// an empty stream holds no document
	line("")
	line("\n\n")
	// comments only: still none
	line("# a comment\n")
	line("  # indented\n\n# two\n")
	line("# no line break at the end")
	// one plain scalar
	line("a")
	line("a\n")
	line("# before\na # after\n")
}
