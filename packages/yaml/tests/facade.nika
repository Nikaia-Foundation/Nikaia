// The serde_yaml facade (#1439; ADR-yaml-1 D10, ADR-rust-boundary-1 D23): `nikaia build`
// writes the package as the Rust crate `nikaia_yaml`, with `rust/` as its
// hand-written root over `native`, and the Rust crate `tests/facade` runs
// serde_yaml 0.9's `test_de.rs`, `test_value.rs`, `test_error.rs` (#1441) and
// `test_serde.rs` (#1515).
// A `FAILED` line is a case the native core does not pass yet, filed
// against the core.
// The copy is built in a slot of `target/yaml-facade`, emptied first
// (`scripts/slot.nika`: a fixed place, so the build hits ADR-021 D14's rustc
// store, #2015). A test program cannot be run again with `nikaia run`, so
// the slot runs `facade_script`, the copy, build and run as a shell line.
use std::env
use std::process

fn toolchain(repo: String) -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() > 0 { return exe }
	return f"{repo}/target/fast/nikaia"
}

// The repository: the test file stands at `packages/yaml/tests/` below it.
fn root() -> String throws {
	return env::current_main()?.parent()?.parent()?.parent()?.parent()?.display() ?? "../.."
}

// The shell line run in the slot ($1), with the package at $2, the compiler
// at $3 and Cargo's target at $4: copies the package, builds it and runs the
// facade crate, printing each's output trimmed, its error output after it
// when it failed, with the slot's path as `TMP`.
fn facade_script() -> String {
	return "d=$1; from=$2; nikaia=$3; export CARGO_TARGET_DIR=$4 CARGO_NET_OFFLINE=true
mkdir -p \"$d/yaml/tests\" && cp -r \"$from/nikaia.toml\" \"$from/src\" \"$from/rust\" \"$d/yaml\" && cp -r \"$from/tests/facade\" \"$d/yaml/tests\" || exit 1
shown() { printf '%s\\n' \"$1\" | sed \"s|$d|TMP|g\"; }
out=$(cd \"$d/yaml\" && \"$nikaia\" build 2>\"$d/build.err\"); c=$?
shown \"$out\"; [ $c = 0 ] || shown \"$(cat \"$d/build.err\")\"
out=$(cd \"$d/yaml/tests/facade\" && cargo run -q 2>\"$d/run.err\"); c=$?
shown \"$out\"; [ $c = 0 ] || shown \"$(cat \"$d/run.err\")\"
exit 0"
}

fn main() throws {
	let repo = root()
	let nikaia = toolchain(repo.clone())
	let cache = f"{repo}/target/nikaia-project-tests/yaml-facade"
	process::run(
		nikaia.clone(),
		[
			"run",
			f"{repo}/scripts/slot.nika",
			"--",
			f"{repo}/target/yaml-facade",
			"sh",
			"-c",
			facade_script(),
			"sh",
			"{slot}",
			f"{repo}/packages/yaml",
			nikaia,
			cache,
		]; stdout: process::Stream::Inherited,
		stderr: process::Stream::Inherited,
	)
}
