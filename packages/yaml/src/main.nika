use std::text

// The official `yaml` package (ADR-yaml-1): YAML text, as `Bytes`, into a tree
// of `Node`s that points into the input.
//
//     use yaml
//     let docs = yaml::parse(input) catch { ... }
//
// A program takes it in by path: `yaml = { path = "../packages/yaml" }`.
//
// The input is `ref Bytes` (a mapped file, a buffer), so every position is a
// byte offset and every `String` in the tree is a view of the input: nothing
// is copied while parsing (D2, D4). Each `Node` carries its span, `start` to
// `end`, from its first byte to just after its last, never a trailing space,
// a comment or the line break. A stream gives one `Node` per document.
//
// A scalar keeps its text as written (`raw`) and its `style`; plain scalars
// resolve by the YAML 1.2 core schema (D5): `yes`, `no`, `on`, `off` are
// strings. `Int` and `Float` keep their text, as `json` keeps a number. A
// failure is an `Error`: the line and the column (from 1, in characters) and
// the byte offset where reading stopped.
//
// Limits are on by default (D8): `parse(input; limits: l)` raises or lowers
// them, none is switched off by leaving it out.

pub struct Node {
	pub start: u32,
	pub end: u32,
	pub anchor: String?,
	pub tag: String?,
	pub value: Value,
}

pub enum Value {
	Null,
	Bool(bool),
	Int(String),
	Float(String),
	Str(Scalar),
	Seq(Vec[Node]),
	Map(Vec[Entry]),
	Alias(String),
}

pub struct Entry {
	pub key: Node,
	pub value: Node,
}

// `raw` is the text as written; `value` is what it says where the grammar
// already knows it: for a double-quoted scalar with an escape or a line break
// its decoded text, of its own (D11); for every other scalar a view of the
// input, `raw` again, folded on request by `text()` (D4). `value` is private
// and read through `text()`, since it holds either kind (ADR-282 D22).
pub struct Scalar {
	pub raw: String,
	value: String,
	pub style: Style,
	// A block scalar's content indentation and chomping (YAML 1.2.2 8.1.1),
	// which `text()` needs; 0 and `Clip` for a flow scalar.
	indent: i64,
	chomp: Chomp,
}

// How a block scalar's final line break and trailing empty lines are kept
// (YAML 1.2.2 8.1.1.2): `-` strips them, `+` keeps them, no indicator clips
// them to the one break.
enum Chomp {
	Clip,
	Strip,
	Keep,
}

// A block scalar's header: the indentation indicator (0 where none is
// written) and the chomping.
struct Head {
	indent: i64,
	chomp: Chomp,
}

pub enum Style {
	Plain,
	Single,
	Double,
	Literal,
	Folded,
}

// The limits of a parse (D8). `depth`: how deeply collections may nest
// (default 128). `bytes`: how long the input may be (default 4 GiB less one,
// the range of a span). `alias_nodes`: the nodes an alias expansion may
// produce beyond ten times the document's own (default 10 000), checked by
// `load`, not by the parse. An exceeded limit is an `Error` naming it, its
// value and the position.
pub struct Limits {
	pub depth: i64,
	pub alias_nodes: i64,
	pub bytes: i64,
}

pub fn default_limits() -> Limits sync {
	return Limits { depth: 128, alias_nodes: 10000, bytes: 4294967295 }
}

// A directive (YAML 1.2.2 6.8) by its name; a `%TAG` one's handle and prefix,
// empty for the others.
struct Dir {
	name: String,
	handle: String,
	prefix: String,
}

pub struct Error {
	pub message: String,
	pub line: i64,
	pub column: i64,
	pub offset: i64,
}

impl Error for Error {
	fn message(ref self) -> String {
		return f"{self.line}:{self.column}: {self.message}"
	}
}

// The block contexts that change what a node may be (YAML 1.2.2 4.1): a
// sequence entry's content may be a compact collection (`- - a`, `- k: v`), a
// mapping's value may be a sequence at the mapping's own indentation.
enum Ctx {
	BlockIn,
	BlockOut,
}

// What a node's tag says of its kind (D5): none, the non-specific `!`, a
// core tag that fixes the kind (`!!str` or `!<tag:yaml.org,2002:str>`), or
// any other, kept on the node and resolved as if it were not there.
enum TagKind {
	Untagged,
	NonSpecific,
	Null,
	Bool,
	Int,
	Float,
	Str,
	Seq,
	Map,
	Other,
}

// A node's properties (YAML 1.2.2 6.9): the anchor's name and the tag as
// written, and where they stand.
struct Props {
	start: u32,
	end: u32,
	anchor: String?,
	tag: String?,
}

// What a plain scalar's text resolves to by the core schema (D5).
enum Kind {
	Null,
	True,
	False,
	Int,
	Float,
	Str,
}

fn is_space(x: scalar) -> bool sync {
	return x == ' ' || x == '\t' || x == '\n' || x == '\r'
}

fn is_flow_indicator(x: scalar) -> bool sync {
	return x == ',' || x == '[' || x == ']' || x == '{' || x == '}'
}

// The characters after `\\` that YAML names (`c-ns-esc-char`) and that stand
// for one character each; `x`, `u`, `U` and the line break are rules.
fn is_escape(x: scalar) -> bool sync {
	return x == '0'
		|| x == 'a'
		|| x == 'b'
		|| x == 't'
		|| x == '\t'
		|| x == 'n'
		|| x == 'v'
		|| x == 'f'
		|| x == 'r'
		|| x == 'e'
		|| x == ' '
		|| x == '"'
		|| x == '/'
		|| x == '\\'
		|| x == 'N'
		|| x == '_'
		|| x == 'L'
		|| x == 'P'
}

// The character an escape of `is_escape` stands for.
fn escaped(e: scalar) -> String sync {
	let c = match e {
		'0' => '\u{0}'
		'a' => '\u{7}'
		'b' => '\u{8}'
		't' => '\t'
		'n' => '\n'
		'v' => '\u{b}'
		'f' => '\u{c}'
		'r' => '\r'
		'e' => '\u{1b}'
		'N' => '\u{85}'
		'_' => '\u{a0}'
		'L' => '\u{2028}'
		'P' => '\u{2029}'
		else => e
	}
	return one(c)
}

fn one(c: scalar) -> String sync {
	let mut out = String()
	out.push(c)
	return out
}

// `n` line breaks.
fn breaks(n: i64) -> String sync {
	let mut out = String()
	for _ in 0..<n {
		out.push('\n')
	}
	return out
}

// `c-indicator`: no plain scalar starts with one (`-`, `?`, `:` may, when a
// safe character follows: `-1`, `:x`).
fn is_indicator(x: scalar) -> bool sync {
	return x == '-'
		|| x == '?'
		|| x == ':'
		|| is_flow_indicator(x)
		|| x == '#'
		|| x == '&'
		|| x == '*'
		|| x == '!'
		|| x == '|'
		|| x == '>'
		|| x == '\''
		|| x == '"'
		|| x == '%'
		|| x == '@'
		|| x == '`'
}

// `ns-plain-safe(c)`: inside flow, the flow indicators end a plain scalar.
fn plain_safe(x: scalar, flow: bool) -> bool sync {
	return !is_space(x) && !(flow && is_flow_indicator(x))
}

fn plain_first(x: scalar) -> bool sync {
	return !is_space(x) && !is_indicator(x)
}

// `ns-plain-char(c)` other than `:`, which needs a safe character after it;
// `#` only where no space stands before it.
fn plain_char(x: scalar, flow: bool, after_space: bool) -> bool sync {
	return plain_safe(x, flow) && x != ':' && !(after_space && x == '#')
}

grammar Yaml {
	// Whitespace is structure: nothing is skipped, every space is written.
	rule WS = "" -> { }

	// `l-yaml-stream`: documents, with comments and blank lines between them.
	// `lim` holds the parse's limits (D8): the nesting depth is handed down the
	// rules as the levels `left`, which each collection takes one of.
	entry rule stream(lim: Limits) -> Vec[Node] =
		Blanks DocEnd* docs:Docs(lim.depth)? DocEnd* eof -> { docs ?? [] }

	// A bare document (no `---`) comes first or after `...` (`l-yaml-stream`).
	rule Docs(left: i64) -> Vec[Node] =
		first:AnyDoc(left) rest:NextDoc(left)* -> {
			let mut all = [first]
			all.extend(rest)
			all
		}
	// The rules below take the document's directives `ds`, where a tag's
	// handle is looked up, and the nesting levels `left` still allowed.
	rule NextDoc(left: i64) -> Node =
		DocEnd+ v:AnyDoc(left) -> { v }
		| v:Explicit([], left) -> { v }
	rule AnyDoc(left: i64) -> Node =
		v:Directed(left) -> { v }
		| v:Explicit([], left) -> { v }
		| not(Marker) v:Block([], left, -1) -> { v }
	rule Explicit(ds: Vec[Dir], left: i64) -> Node = "---" v:DocAfter(ds, left) -> { v }

	// `l-directive-document`: directives, then `---`; they hold for this
	// document only. One `%YAML`, one `%TAG` per handle (YAML 1.2.2 6.8).
	rule Directed(left: i64) -> Node =
		ds:Directive+
		if(yaml_once(ds), "one %YAML directive")
		if(handles_once(ds), "one %TAG directive per handle")
		v:Explicit(ds, left) -> { v }
	// `l-directive`: `%YAML` with a version of major 1 (`1.1`, `1.3` read as
	// 1.2), `%TAG` with a handle and its prefix, or a reserved directive,
	// ignored (6.8.1).
	rule Directive -> Dir =
		"%" n:text("YAML") Sep1 v:dec[i64](digit+) if(v == 1, "a YAML version 1.x")
		"." digit+ Eol Blanks -> {
			Dir { name: n, handle: "", prefix: "" }
		}
		| "%" n:text("TAG") Sep1 h:text(Handle) Sep1 p:text(TagPrefix) Eol Blanks -> {
			Dir { name: n, handle: h, prefix: p }
		}
		| "%" n:text(DirChar+) if(n != "YAML" && n != "TAG", "a directive") (Sep1 not("#") DirChar+)* Eol Blanks -> {
			Dir { name: n, handle: "", prefix: "" }
		}
	rule DirChar = x:any if(!is_space(x)) -> { }
	// `c-tag-handle` and `ns-tag-prefix`.
	rule Handle = "!" WordChar* "!" -> { } | "!" -> { }
	rule TagPrefix = "!" UriChar* -> { } | TagChar UriChar* -> { }

	// `c-document-end`.
	rule DocEnd = "..." Eol Blanks -> { }

	// What follows `---`: a node on that line, on the lines below, or none.
	rule DocAfter(ds: Vec[Dir], left: i64) -> Node =
		s:count(" " | "\t") if(s > 0) v:Propped(ds, left, -1) -> { v }
		| s:count(" " | "\t") if(s > 0) v:BlockScalar(-1) Blanks -> { v }
		| s:count(" " | "\t") if(s > 0) v:Inline(ds, left, -1) Eol Blanks -> { v }
		| Eol Blanks v:Block(ds, left, -1) -> { v }
		| a:here Eol Blanks -> {
			Node { start: a, end: a, anchor: null, tag: null, value: Value::Null }
		}

	// `---` or `...` at the start of a line, where a document begins or ends.
	rule Marker = ("---" | "...") (" " | "\t" | "\n" | eof) -> { }

	// Spaces and tabs inside a line.
	rule Sp = (" " | "\t")* -> { }
	// The rest of a line: spaces, a comment, the line break or the end.
	rule Eol = (" " | "\t")* Comment? ("\n" | eof) -> { }
	rule Comment = "#" until("\n" | eof) -> { }
	// Lines holding nothing but spaces and a comment.
	rule Blanks = Blank* LastBlank? -> { }
	rule Blank = (" " | "\t")* Comment? "\n" -> { }
	rule LastBlank = (" " | "\t")* Comment eof -> { }

	// A block node on the lines below its parent at indentation `n`, at the
	// indentation of its first line, which exceeds `n` (`s-l+block-node`). A
	// sequence that is a mapping's value may sit at the mapping's own
	// indentation (`seq-spaces(n, block-out)`).
	// `k` is the tag a property line above gave it.
	rule Block(ds: Vec[Dir], left: i64, n: i64; c: Ctx = Ctx::BlockIn, k: TagKind = TagKind::Untagged) -> Node =
		not(Marker) m:count(" ") if(m > n) v:Content(ds, left, m, n; k: k) -> { v }
		| not(Marker) m:count(" ") if(c == Ctx::BlockOut && m == n) v:Seq(ds, left, m) -> { v }

	// A node whose first character is at column `m`, under a parent at `n`;
	// it ends after its last line's break and the blank lines behind it.
	rule Content(ds: Vec[Dir], left: i64, m: i64, n: i64; k: TagKind = TagKind::Untagged) -> Node =
		v:Seq(ds, left, m) -> { v }
		| v:Map(ds, left, m) -> { v }
		| v:Propped(ds, left, n) -> { v }
		| v:BlockScalar(n; k: k) Blanks -> { v }
		| v:Inline(ds, left, n; k: k) Eol Blanks -> { v }

	// A collection takes one nesting level (D8); past the last, the parse
	// stops here.
	rule Seq(ds: Vec[Dir], left: i64, m: i64) -> Node =
		SeqLevel(left) a:here first:SeqEntry(ds, left - 1, m) rest:SeqMore(ds, left - 1, m)* -> {
			let mut b = first.end
			for r in rest {
				b = r.end
			}
			let mut all = [first]
			all.extend(rest)
			Node { start: a, end: b, anchor: null, tag: null, value: Value::Seq(all) }
		}
	rule SeqMore(ds: Vec[Dir], left: i64, m: i64) -> Node = " "{m} e:SeqEntry(ds, left, m) -> { e }
	rule SeqEntry(ds: Vec[Dir], left: i64, m: i64) -> Node = "-" v:After(ds, left, m) -> { v }

	rule Map(ds: Vec[Dir], left: i64, m: i64) -> Node =
		MapLevel(ds, left) a:here first:MapEntry(ds, left - 1, m) rest:MapMore(ds, left - 1, m)
		* -> {
			let mut b = first.value.end
			for r in rest {
				b = r.value.end
			}
			let mut all = [first]
			all.extend(rest)
			Node { start: a, end: b, anchor: null, tag: null, value: Value::Map(all) }
		}
	// Where a block collection surely begins (`- `, `? `, `key:`, `: `), a
	// level past the last is an error at once (the cut), not a reason to try
	// reading the line as a scalar.
	rule SeqLevel(left: i64) = peek(Dash) => if(left > 0, "nesting within the depth limit") -> { }
	rule Dash = "-" Gap -> { }
	rule MapLevel(ds: Vec[Dir], left: i64) =
		peek(MapStart(ds, left - 1)) => if(left > 0, "nesting within the depth limit") -> { }
	rule MapStart(ds: Vec[Dir], left: i64) = "?" Gap -> { } | ":" Gap -> { } | Key(ds, left) Sp ":" -> { }
	rule Gap = (" " | "\t" | "\n" | eof) -> { }
	rule MapMore(ds: Vec[Dir], left: i64, m: i64) -> Entry = " "{m} e:MapEntry(ds, left, m) -> { e }
	// An explicit entry (`ns-l-block-map-explicit-entry`): `?` and the key,
	// any node, a collection too; then `:` and the value at the same
	// indentation, or none, a null. Or an implicit entry, `key: value`.
	rule MapEntry(ds: Vec[Dir], left: i64, m: i64) -> Entry =
		"?" k:Indented(ds, left, m) v:ExplicitValue(ds, left, m)? -> {
			let b = k.end
			Entry {
				key: k,
				value: v ?? Node { start: b, end: b, anchor: null, tag: null, value: Value::Null },
			}
		}
		| k:Key(ds, left) Sp ":" v:After(ds, left, m; c: Ctx::BlockOut) -> {
			Entry { key: k, value: v }
		}
		| a:here ":" v:After(ds, left, m; c: Ctx::BlockOut) -> {
			Entry {
				key: Node { start: a, end: a, anchor: null, tag: null, value: Value::Null },
				value: v,
			}
		}
	rule ExplicitValue(ds: Vec[Dir], left: i64, m: i64) -> Node =
		" "{m} ":" v:Indented(ds, left, m) -> { v }
	// `s-l+block-indented(m, block-out)`: a compact collection on the
	// indicator's line, or what may follow a mapping's `:`.
	rule Indented(ds: Vec[Dir], left: i64, m: i64) -> Node =
		s:count(" ") if(s > 0) v:Compact(ds, left, m + 1 + s) -> { v }
		| v:After(ds, left, m; c: Ctx::BlockOut) -> { v }

	// An implicit key: one line, a flow collection, a quoted or a plain scalar.
	rule Key(ds: Vec[Dir], left: i64) -> Node =
		p:Props(ds) Sep1 v:KeyNode(ds, left, tag_kind(ds, p.tag)) if(fits_node(tag_kind(ds, p.tag), v), "a node its tag fits") -> {
			Node { start: p.start, end: v.end, anchor: p.anchor, tag: p.tag, value: v.value }
		}
		| v:KeyNode(ds, left, TagKind::Untagged) -> { v }
	rule KeyNode(ds: Vec[Dir], left: i64, k: TagKind) -> Node =
		v:FlowSeq(ds, left) -> { v }
		| v:FlowMap(ds, left) -> { v }
		| v:Double(k) -> { v }
		| v:Single(k) -> { v }
		| v:Alias -> { v }
		| v:Plain(-1, false, false; k: k) -> { v }

	// A block node that begins with properties (YAML 1.2.2 6.9, 8.2.3): its
	// content on the same line, a block scalar, a node on the lines below (a
	// block collection, as a rule), or none, an empty node. A core tag that
	// fixes a kind is checked here, against a collection, and where a scalar
	// is read, against its text; an alias takes no properties.
	rule Propped(ds: Vec[Dir], left: i64, n: i64; c: Ctx = Ctx::BlockIn) -> Node =
		p:Props(ds) s:count(" " | "\t") if(s > 0) v:BlockScalar(n; k: tag_kind(ds, p.tag)) Blanks -> {
			Node { start: p.start, end: v.end, anchor: p.anchor, tag: p.tag, value: v.value }
		}
		| p:Props(ds) s:count(" " | "\t") if(s > 0) v:Inline(ds, left, n; k: tag_kind(ds, p.tag)) if(fits_node(tag_kind(ds, p.tag), v), "a node its tag fits") Eol Blanks -> {
			Node { start: p.start, end: v.end, anchor: p.anchor, tag: p.tag, value: v.value }
		}
		| p:Props(ds) Eol Blanks v:Block(ds, left, n; c: c, k: tag_kind(ds, p.tag)) if(fits_node(tag_kind(ds, p.tag), v), "a node its tag fits") -> {
			Node { start: p.start, end: v.end, anchor: p.anchor, tag: p.tag, value: v.value }
		}
		| p:Props(ds) if(empty_fits(tag_kind(ds, p.tag)), "a node its tag fits") e:text(Nothing) Eol Blanks -> {
			let v = match tag_kind(ds, p.tag) {
				TagKind::Str => Value::Str(Scalar {
					raw: e,
					value: e,
					style: Style::Plain,
					indent: 0,
					chomp: Chomp::Clip,
				})
				TagKind::NonSpecific => Value::Str(Scalar {
					raw: e,
					value: e,
					style: Style::Plain,
					indent: 0,
					chomp: Chomp::Clip,
				})
				else => Value::Null
			}
			Node { start: p.start, end: p.end, anchor: p.anchor, tag: p.tag, value: v }
		}
	rule Nothing = "" -> { }

	// `c-ns-properties`: a tag and an anchor, in either order, or one alone.
	rule Props(ds: Vec[Dir]) -> Props =
		a:here t:Tag(ds) Sep1 n:Anchor b:here -> { Props { start: a, end: b, anchor: n, tag: t } }
		| a:here n:Anchor Sep1 t:Tag(ds) b:here -> { Props { start: a, end: b, anchor: n, tag: t } }
		| a:here t:Tag(ds) b:here -> { Props { start: a, end: b, anchor: null, tag: t } }
		| a:here n:Anchor b:here -> { Props { start: a, end: b, anchor: n, tag: null } }
	rule Sep1 = (" " | "\t")+ -> { }
	// `c-ns-anchor-property`: the name, after `&`.
	rule Anchor -> String = "&" s:text(AnchorChar+) -> { s }
	rule AnchorChar = x:any if(!is_space(x) && !is_flow_indicator(x)) -> { }
	// `c-ns-alias-node`: `*` and an anchor's name, not resolved (D6).
	rule Alias -> Node = a:here "*" s:text(AnchorChar+) b:here -> {
		Node { start: a, end: b, anchor: null, tag: null, value: Value::Alias(s) }
	}
	// `c-ns-tag-property`, as written: verbatim `!<uri>`, a shorthand with a
	// named or the secondary handle (`!e!x`, `!!str`), with the primary one
	// (`!local`), or the non-specific `!`. Its shape is checked here, by the
	// characters a URI may hold (`ns-uri-char`, `ns-tag-char`); a named
	// handle, by the document's `%TAG` directives (6.8.2.1).
	rule Tag(ds: Vec[Dir]) -> String =
		s:text(TagForm) if(declared(ds, s), "a tag handle a %TAG directive declares") -> { s }
	rule TagForm =
		"!<" UriChar+ ">" -> { }
		| "!" WordChar* "!" TagChar+ -> { }
		| "!" TagChar+ -> { }
		| "!" -> { }
	rule WordChar = x:any if(is_word(x)) -> { }
	rule UriChar = "%" hex_digit hex_digit -> { } | x:any if(is_uri(x)) -> { }
	rule TagChar = "%" hex_digit hex_digit -> { } | x:any if(is_uri(x) && x != '!' && !is_flow_indicator(x)) -> { }

	// What follows `-` or `key:` at indentation `m`: a node on this line, on
	// the lines below, or none (`Null`, where the indicator ends). After `-`
	// that may be a compact collection, whose further entries are at the
	// column it began in.
	rule After(ds: Vec[Dir], left: i64, m: i64; c: Ctx = Ctx::BlockIn) -> Node =
		s:count(" ") if(s > 0 && c == Ctx::BlockIn) v:Compact(ds, left, m + 1 + s) -> { v }
		| s:count(" " | "\t") if(s > 0) v:Propped(ds, left, m; c: c) -> { v }
		| s:count(" " | "\t") if(s > 0) v:BlockScalar(m) Blanks -> { v }
		| s:count(" " | "\t") if(s > 0) v:Inline(ds, left, m) Eol Blanks -> { v }
		| Eol Blanks v:Block(ds, left, m; c: c) -> { v }
		| a:here Eol Blanks -> {
			Node { start: a, end: a, anchor: null, tag: null, value: Value::Null }
		}

	rule Compact(ds: Vec[Dir], left: i64, m: i64) -> Node =
		v:Seq(ds, left, m) -> { v }
		| v:Map(ds, left, m) -> { v }

	// A node in flow style inside a block, under a parent at `n`.
	rule Inline(ds: Vec[Dir], left: i64, n: i64; k: TagKind = TagKind::Untagged) -> Node =
		v:FlowSeq(ds, left) -> { v }
		| v:FlowMap(ds, left) -> { v }
		| v:Double(k) -> { v }
		| v:Single(k) -> { v }
		| v:Alias -> { v }
		| v:Plain(n, false, true; k: k) -> { v }

	// Flow collections: spaces, comments and line breaks between their parts
	// (`s-separate-lines`); a trailing comma.
	rule Fs = Sp (Comment? "\n" Sp)* -> { }

	rule FlowSeq(ds: Vec[Dir], left: i64) -> Node =
		a:here "[" if(left > 0, "nesting within the depth limit")
		Fs first:FlowItem(ds, left - 1) Fs rest:FlowNext(ds, left - 1)* ("," Fs)? "]" b:here -> {
			let mut all = [first]
			all.extend(rest)
			Node { start: a, end: b, anchor: null, tag: null, value: Value::Seq(all) }
		}
		| a:here "[" if(left > 0, "nesting within the depth limit") Fs "]" b:here -> {
			Node { start: a, end: b, anchor: null, tag: null, value: Value::Seq([]) }
		}
	rule FlowNext(ds: Vec[Dir], left: i64) -> Node = "," Fs v:FlowItem(ds, left) Fs -> { v }
	// A flow sequence's entry may be a single pair, `[a: b]` or `[? a : b]`, a
	// mapping that takes a nesting level.
	rule FlowItem(ds: Vec[Dir], left: i64) -> Node =
		if(left > 0, "nesting within the depth limit") a:here "?" not(PlainSafe(true)) Fs p:FlowExplicit(ds, left - 1) -> {
			let b = p.value.end
			Node { start: a, end: b, anchor: null, tag: null, value: Value::Map([p]) }
		}
		| k:FlowAny(ds, left) t:FlowTail(ds, left - 1)?
		if(pair_fits(left, k, t), "nesting within the depth limit") -> {
			let a = k.start
			match t {
				null => k
				v => {
					let b = v.end
					Node {
						start: a,
						end: b,
						anchor: null,
						tag: null,
						value: Value::Map([Entry { key: k, value: v }]),
					}
				}
			}
		}
	// A pair's `:` and its value, or none, `Null` where the `:` ends
	// (`c-ns-flow-map-separate-value`). The key before it is read once, so a
	// nested key is not read again for each way its entry may end.
	rule FlowTail(ds: Vec[Dir], left: i64) -> Node =
		Fs ":" Fs v:FlowAny(ds, left) -> { v }
		| Fs ":" b:here -> {
			Node { start: b, end: b, anchor: null, tag: null, value: Value::Null }
		}

	rule FlowMap(ds: Vec[Dir], left: i64) -> Node =
		a:here "{" if(left > 0, "nesting within the depth limit")
		Fs first:FlowEntry(ds, left - 1) Fs rest:FlowEntryNext(ds, left - 1)
		* ("," Fs)? "}" b:here -> {
			let mut all = [first]
			all.extend(rest)
			Node { start: a, end: b, anchor: null, tag: null, value: Value::Map(all) }
		}
		| a:here "{" if(left > 0, "nesting within the depth limit") Fs "}" b:here -> {
			Node { start: a, end: b, anchor: null, tag: null, value: Value::Map([]) }
		}
	rule FlowEntryNext(ds: Vec[Dir], left: i64) -> Entry = "," Fs e:FlowEntry(ds, left) Fs -> { e }
	// An explicit entry, `? a : b`, or an implicit one.
	rule FlowEntry(ds: Vec[Dir], left: i64) -> Entry =
		"?" not(PlainSafe(true)) Fs e:FlowExplicit(ds, left) -> { e }
		| e:FlowImplicit(ds, left) -> { e }
	// What follows `?` (`ns-flow-map-explicit-entry`): an implicit entry, or
	// nothing, an empty key and value.
	rule FlowExplicit(ds: Vec[Dir], left: i64) -> Entry =
		e:FlowImplicit(ds, left) -> { e }
		| a:here -> {
			Entry {
				key: Node { start: a, end: a, anchor: null, tag: null, value: Value::Null },
				value: Node { start: a, end: a, anchor: null, tag: null, value: Value::Null },
			}
		}
	// `{a: b}`, `{a: }`, `{a}` and `{: b}`: a missing key or value is `Null`.
	rule FlowImplicit(ds: Vec[Dir], left: i64) -> Entry =
		k:FlowAny(ds, left) t:FlowTail(ds, left)? -> {
			let b = k.end
			Entry {
				key: k,
				value: t ?? Node { start: b, end: b, anchor: null, tag: null, value: Value::Null },
			}
		}
		| a:here ":" Fs v:FlowAny(ds, left) -> {
			Entry {
				key: Node { start: a, end: a, anchor: null, tag: null, value: Value::Null },
				value: v,
			}
		}

	// A flow node, with properties or without; properties alone are an empty
	// node.
	rule FlowAny(ds: Vec[Dir], left: i64) -> Node =
		p:Props(ds) Fs v:FlowNode(ds, left, tag_kind(ds, p.tag)) if(fits_node(tag_kind(ds, p.tag), v), "a node its tag fits") -> {
			Node { start: p.start, end: v.end, anchor: p.anchor, tag: p.tag, value: v.value }
		}
		| p:Props(ds) if(empty_fits(tag_kind(ds, p.tag)), "a node its tag fits") e:text(Nothing) -> {
			let v = match tag_kind(ds, p.tag) {
				TagKind::Str => Value::Str(Scalar {
					raw: e,
					value: e,
					style: Style::Plain,
					indent: 0,
					chomp: Chomp::Clip,
				})
				TagKind::NonSpecific => Value::Str(Scalar {
					raw: e,
					value: e,
					style: Style::Plain,
					indent: 0,
					chomp: Chomp::Clip,
				})
				else => Value::Null
			}
			Node { start: p.start, end: p.end, anchor: p.anchor, tag: p.tag, value: v }
		}
		| v:FlowNode(ds, left, TagKind::Untagged) -> { v }
	rule FlowNode(ds: Vec[Dir], left: i64, k: TagKind) -> Node =
		v:FlowSeq(ds, left) -> { v }
		| v:FlowMap(ds, left) -> { v }
		| v:Double(k) -> { v }
		| v:Single(k) -> { v }
		| v:Alias -> { v }
		| v:Plain(-1, true, true; k: k) -> { v }

	// `c-double-quoted`: `raw` is the text between the quotes, as written. A
	// scalar with neither an escape nor a line break is its own value, a view;
	// any other is read in one pass part by part, `raw` the text the parts
	// cover, each escape checked and decoded once, here (D11): its digits by
	// a guard per digit, its range by a guard on its value, so that an invalid
	// escape is a parse error with its line and column, and `scalar::from` is
	// proved by the guard before it.
	// `k` is the node's tag: a core tag that fixes a kind other than a string
	// reads the text between the quotes as that kind, its shape checked here.
	rule Double(k: TagKind) -> Node =
		a:here "\"" s:text(DoublePlain*) "\"" b:here if(fits(k, s), "a scalar its tag fits") -> {
			let v = match resolve(k, s, false) {
				Kind::Null => Value::Null
				Kind::True => Value::Bool(true)
				Kind::False => Value::Bool(false)
				Kind::Int => Value::Int(s)
				Kind::Float => Value::Float(s)
				Kind::Str => Value::Str(Scalar {
					raw: s,
					value: s,
					style: Style::Double,
					indent: 0,
					chomp: Chomp::Clip,
				})
			}
			Node { start: a, end: b, anchor: null, tag: null, value: v }
		}
		| a:here "\"" s:text(parts:DoublePart*) "\"" b:here if(fits(k, s), "a scalar its tag fits") -> {
			let mut d = String()
			for p in parts {
				d.push_str(p)
			}
			let v = match resolve(k, s, false) {
				Kind::Null => Value::Null
				Kind::True => Value::Bool(true)
				Kind::False => Value::Bool(false)
				Kind::Int => Value::Int(s)
				Kind::Float => Value::Float(s)
				Kind::Str => Value::Str(Scalar {
					raw: s,
					value: d,
					style: Style::Double,
					indent: 0,
					chomp: Chomp::Clip,
				})
			}
			Node { start: a, end: b, anchor: null, tag: null, value: v }
		}
	rule DoublePlain = x:any if(x != '"' && x != '\\' && x != '\n') -> { }
	// One part of a double-quoted scalar's value (YAML 1.2.2 7.3.1): a run of
	// characters, spaces inside a line, a folded line break (6.5), an escaped
	// line break, an escape.
	rule DoublePart -> String =
		t:text(DoubleWord+) -> { t.clone() }
		| w:text((" " | "\t")+) not("\n") -> { w.clone() }
		| (" " | "\t")* "\n" n:count(Empty) (" " | "\t")* -> {
			if n == 0 {
				" "
			} else {
				breaks(n)
			}
		}
		| "\\\n" n:count(Empty) (" " | "\t")* -> { breaks(n) }
		| "\\x" v:Hex2 if(v >= 0 && v <= 0xFF) -> { one(scalar::from(v)) }
		| "\\u" v:Hex4 if(v >= 0 && v <= 0xFFFF && (v < 0xD800 || v > 0xDFFF)) -> {
			one(scalar::from(v))
		}
		| "\\U" v:Hex8 if(v >= 0 && v <= 0x10FFFF && (v < 0xD800 || v > 0xDFFF)) -> {
			one(scalar::from(v))
		}
		| "\\" x:any if(is_escape(x), "an escape") -> { escaped(x) }
	rule DoubleWord = x:any if(x != '"' && x != '\\' && x != '\n' && x != ' ' && x != '\t') -> { }
	rule Hex -> i64 = h:hex_digit -> { hex_value(h) }
	rule Hex2 -> i64 = a:Hex b:Hex -> { a * 16 + b }
	rule Hex4 -> i64 = a:Hex2 b:Hex2 -> { a * 256 + b }
	rule Hex8 -> i64 = a:Hex4 b:Hex4 -> { a * 65536 + b }

	// `c-l+literal(n)` and `c-l+folded(n)` (YAML 1.2.2 8.1): the header, then
	// the content lines, indented past `n` as far as the indentation indicator
	// says or, without one, as far as the first non-empty line is. `raw` is the
	// content lines as written, the empty lines behind them included; `text()`
	// takes off the indentation, folds and chomps (no escapes, nothing to check
	// twice). The header is checked here: a wrong indicator is a parse error.
	// A core tag other than `!!str` does not fit one: its value is a copy, and
	// an `Int` or a `Float` keeps a view.
	rule BlockScalar(n: i64; k: TagKind = TagKind::Untagged) -> Node =
		a:here st:BlockStyle if(block_fits(k), "a scalar its tag fits") h:Head e:here HeadEnd r:here s:text(i:BlockBody(n, h.indent)) -> {
			Node {
				start: a,
				end: block_end(e, r, s),
				anchor: null,
				tag: null,
				value: Value::Str(Scalar {
					raw: s,
					value: s,
					style: st,
					indent: i,
					chomp: h.chomp,
				}),
			}
		}
	rule BlockStyle -> Style = "|" -> { Style::Literal } | ">" -> { Style::Folded }
	// `c-b-block-header`: the two indicators in either order, each optional.
	rule Head -> Head =
		d:IndentInd c:ChompInd -> { Head { indent: d, chomp: c } }
		| c:ChompInd d:IndentInd -> { Head { indent: d, chomp: c } }
		| d:IndentInd -> { Head { indent: d, chomp: Chomp::Clip } }
		| c:ChompInd -> { Head { indent: 0, chomp: c } }
		| "" -> { Head { indent: 0, chomp: Chomp::Clip } }
	rule IndentInd -> i64 = x:any if(x >= '1' && x <= '9') -> { x as i64 - 48 }
	rule ChompInd -> Chomp = "-" -> { Chomp::Strip } | "+" -> { Chomp::Keep }
	// The rest of the header's line: a comment, after a space.
	rule HeadEnd = s:count(" " | "\t") (if(s > 0) Comment)? ("\n" | eof) -> { }
	// The content lines; their indentation is the result, 0 where there is no
	// text line. Without an indicator, the leading empty lines may not be
	// indented past the first text line (`l-literal-content`).
	rule BlockBody(n: i64, d: i64) -> i64 =
		if(d > 0) BlockLine(explicit_indent(n, d))* -> { explicit_indent(n, d) }
		| lead:LeadLine* not(Marker) m:count(" ") if(m > n && m >= most(lead)) x:any if(x != '\n') until("\n" | eof) ("\n" | eof) BlockLine(m)* -> {
			m
		}
		| LeadLine* -> { 0 }
	rule LeadLine -> i64 = s:count(" ") "\n" -> { s }
	// A text line indented `k` or more, or an empty line indented less.
	rule BlockLine(k: i64) =
		not(Marker) " "{k} x:any if(x != '\n') until("\n" | eof) ("\n" | eof) -> { }
		| " "* "\n" -> { }

	// `c-single-quoted`: `''` is a quote.
	rule Single(k: TagKind) -> Node =
		a:here "'" s:text(SingleChar*) "'" b:here if(fits(k, s), "a scalar its tag fits") -> {
			let v = match resolve(k, s, false) {
				Kind::Null => Value::Null
				Kind::True => Value::Bool(true)
				Kind::False => Value::Bool(false)
				Kind::Int => Value::Int(s)
				Kind::Float => Value::Float(s)
				Kind::Str => Value::Str(Scalar {
					raw: s,
					value: s,
					style: Style::Single,
					indent: 0,
					chomp: Chomp::Clip,
				})
			}
			Node { start: a, end: b, anchor: null, tag: null, value: v }
		}
	rule SingleChar = "''" -> { } | x:any if(x != '\'') -> { }

	// A plain scalar, resolved by the core schema. In flow the flow
	// indicators end it; `multi` lets it go on over lines indented past `n`.
	// `k` is the node's tag: a core tag fixes the kind, its shape checked
	// here; no tag, or another, resolves by the core schema.
	rule Plain(n: i64, flow: bool, multi: bool; k: TagKind = TagKind::Untagged) -> Node =
		a:here s:text(PlainFirst(flow) PlainMore(n, flow, multi)*) b:here if(fits(k, s), "a scalar its tag fits") -> {
			let v = match resolve(k, s, true) {
				Kind::Null => Value::Null
				Kind::True => Value::Bool(true)
				Kind::False => Value::Bool(false)
				Kind::Int => Value::Int(s)
				Kind::Float => Value::Float(s)
				Kind::Str => Value::Str(Scalar {
					raw: s,
					value: s,
					style: Style::Plain,
					indent: 0,
					chomp: Chomp::Clip,
				})
			}
			Node { start: a, end: b, anchor: null, tag: null, value: v }
		}
	rule PlainFirst(flow: bool) =
		x:any if(plain_first(x)) -> { }
		| ("-" | "?" | ":") peek(PlainSafe(flow)) -> { }
	rule PlainSafe(flow: bool) = x:any if(plain_safe(x, flow)) -> { }
	rule PlainChar(flow: bool; after_space: bool = false) =
		":" peek(PlainSafe(flow)) -> { }
		| x:any if(plain_char(x, flow, after_space)) -> { }
	// What may follow inside the scalar: a character, spaces and a
	// character, or a line break and a further line (`s-ns-plain-next-line`).
	rule PlainMore(n: i64, flow: bool, multi: bool) =
		PlainChar(flow) -> { }
		| (" " | "\t")+ PlainChar(flow; after_space: true) -> { }
		| if(multi) (" " | "\t")* "\n" Empty* not(Marker) m:count(" ") if(flow || m > n) (" " | "\t")* PlainChar(flow; after_space: true) -> { }
	rule Empty = (" " | "\t")* "\n" -> { }
}

fn is_word(x: scalar) -> bool sync {
	return (x >= '0' && x <= '9') || (x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || x == '-'
}

// `ns-uri-char` other than `%`, which comes with two hexadecimal digits.
fn is_uri(x: scalar) -> bool sync {
	return is_word(x) || "#;/?:@&=+$,_.!~*'()[]".contains(x)
}

// Whether a tag's handle is declared: a named handle (`!e!x`) by a `%TAG`
// directive of its document; the primary `!`, the secondary `!!` and a
// verbatim tag need none (6.8.2.1, 6.9.1).
fn declared(ds: ref Vec[Dir], t: String) -> bool sync {
	let rest = t.strip_prefix("!") ?? ""
	if rest.starts_with("!") || rest.starts_with("<") || !rest.contains('!') {
		return true
	}
	return ds.iter().any(fn(d) { d.handle.len() > 2 && t.starts_with(d.handle) })
}

fn yaml_once(ds: ref Vec[Dir]) -> bool sync {
	return ds.iter().filter(fn(d) { d.name == "YAML" }).count() <= 1
}

fn handles_once(ds: ref Vec[Dir]) -> bool sync {
	return ds.iter().all(fn(d) {
		d.name != "TAG"
			|| ds.iter().filter(fn(e) { e.name == "TAG" && e.handle == d.handle }).count() == 1
	})
}

// What a tag, as written, says of a node's kind (D5).
fn tag_kind(ds: ref Vec[Dir], t: String?) -> TagKind sync {
	let s = match t {
		null => return TagKind::Untagged
		x => x
	}
	if s == "!" {
		return TagKind::NonSpecific
	}
	if is_core(ds, s, "null") {
		return TagKind::Null
	}
	if is_core(ds, s, "bool") {
		return TagKind::Bool
	}
	if is_core(ds, s, "int") {
		return TagKind::Int
	}
	if is_core(ds, s, "float") {
		return TagKind::Float
	}
	if is_core(ds, s, "str") {
		return TagKind::Str
	}
	if is_core(ds, s, "seq") {
		return TagKind::Seq
	}
	if is_core(ds, s, "map") {
		return TagKind::Map
	}
	return TagKind::Other
}

// Whether a tag names `tag:yaml.org,2002:name`: verbatim, or by its handle's
// prefix, which a `%TAG` directive of the document gives (`!!` is
// `tag:yaml.org,2002:` where none does).
fn is_core(ds: ref Vec[Dir], s: String, name: String) -> bool sync {
	let core = f"tag:yaml.org,2002:{name}"
	if s == f"!<{core}>" {
		return true
	}
	let primary = !s.starts_with("!<") && !(s.strip_prefix("!") ?? "").contains('!')
	for d in ds {
		let mut named = primary
		if d.handle != "!" {
			named = d.handle.len() > 1 && s.starts_with(d.handle)
		}
		if d.name == "TAG" && named {
			return f"{d.prefix}{s.strip_prefix(d.handle) ?? ""}" == core
		}
	}
	return s == f"!!{name}"
}

// Whether a scalar's text has the shape its tag's kind needs (D5): checked
// once, here, so that `as_i64` checks no digit again.
fn fits(k: TagKind, s: String) -> bool sync {
	return match k {
		TagKind::Null => s == "" || is_null(s)
		TagKind::Bool => is_true(s) || is_false(s)
		TagKind::Int => is_int(s)
		TagKind::Float => is_float(s)
		TagKind::Seq => false
		TagKind::Map => false
		else => true
	}
}

fn block_fits(k: TagKind) -> bool sync {
	return match k {
		TagKind::Null => false
		TagKind::Bool => false
		TagKind::Int => false
		TagKind::Float => false
		TagKind::Seq => false
		TagKind::Map => false
		else => true
	}
}

// How deeply a node's collections nest: 0 for a scalar.
fn depth_of(n: ref Node) -> i64 sync {
	let mut d = 0
	match n.value {
		Value::Seq(items) => {
			for x in items {
				d = d.max(depth_of(x) + 1)
			}
			d = d.max(1)
		}
		Value::Map(entries) => {
			for e in entries {
				d = d.max(depth_of(e.key) + 1).max(depth_of(e.value) + 1)
			}
			d = d.max(1)
		}
		else => {}
	}
	return d
}

// Whether a flow sequence's entry fits the levels `left`: a single pair is a
// mapping, one level more, so its key, read before that was known, must
// nest less deeply than `left` (its value was read within `left - 1`).
fn pair_fits(left: i64, k: ref Node, t: ref Node?) -> bool sync {
	return match t {
		null => true
		v => depth_of(k) < left
	}
}

// An empty node is null, or with `!!str` or `!` an empty string.
fn empty_fits(k: TagKind) -> bool sync {
	return match k {
		TagKind::Bool => false
		TagKind::Int => false
		TagKind::Float => false
		TagKind::Seq => false
		TagKind::Map => false
		else => true
	}
}

// Whether a node fits its tag where the scalars' texts are checked already:
// a collection against `!!seq` and `!!map`; an alias takes no properties.
fn fits_node(k: TagKind, v: ref Node) -> bool sync {
	return match v.value {
		Value::Seq(items) => k == TagKind::Untagged
			|| k == TagKind::Other
			|| k == TagKind::NonSpecific
			|| k == TagKind::Seq
		Value::Map(entries) => k == TagKind::Untagged
			|| k == TagKind::Other
			|| k == TagKind::NonSpecific
			|| k == TagKind::Map
		Value::Alias(name) => false
		else => true
	}
}

// What a scalar's text is, by its tag `k` (D5): a core tag fixes the kind;
// with none, or another, a plain scalar resolves by the core schema and a
// quoted one is a string.
fn resolve(k: TagKind, s: String, plain: bool) -> Kind sync {
	return match k {
		TagKind::Null => Kind::Null
		TagKind::Bool => if is_true(s) { Kind::True } else { Kind::False }
		TagKind::Int => Kind::Int
		TagKind::Float => Kind::Float
		TagKind::Untagged => if plain { plain_kind(s) } else { Kind::Str }
		TagKind::Other => if plain { plain_kind(s) } else { Kind::Str }
		else => Kind::Str
	}
}

fn is_null(s: String) -> bool sync {
	return s == "~" || s == "null" || s == "Null" || s == "NULL"
}

fn is_true(s: String) -> bool sync {
	return s == "true" || s == "True" || s == "TRUE"
}

fn is_false(s: String) -> bool sync {
	return s == "false" || s == "False" || s == "FALSE"
}

// The core schema's resolution of a plain scalar's text (D5).
fn plain_kind(s: String) -> Kind sync {
	if is_null(s) {
		return Kind::Null
	}
	if is_true(s) {
		return Kind::True
	}
	if is_false(s) {
		return Kind::False
	}
	if is_int(s) {
		return Kind::Int
	}
	if is_float(s) {
		return Kind::Float
	}
	return Kind::Str
}

fn digits_in(s: String, from: i64, radix: i64) -> bool sync {
	let cs: Vec[scalar] = s.chars().collect()
	if from >= cs.len() as i64 {
		return false
	}
	let mut i = from
	while i < cs.len() as i64 {
		let c = cs[i]
		let ok = if radix == 8 {
			c >= '0' && c <= '7'
		} else if radix == 16 {
			(c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
		} else {
			c >= '0' && c <= '9'
		}
		if !ok {
			return false
		}
		i += 1
	}
	return true
}

// `[-+]?[0-9]+`, `0o[0-7]+`, `0x[0-9a-fA-F]+`.
fn is_int(s: String) -> bool sync {
	if s.starts_with("0o") {
		return digits_in(s, 2, 8)
	}
	if s.starts_with("0x") {
		return digits_in(s, 2, 16)
	}
	if s.starts_with("-") || s.starts_with("+") {
		return digits_in(s, 1, 10)
	}
	return digits_in(s, 0, 10)
}

// `[-+]?(\.[0-9]+|[0-9]+(\.[0-9]*)?)([eE][-+]?[0-9]+)?`, and `.inf`, `.nan`
// in their three spellings.
fn is_float(s: String) -> bool sync {
	let cs: Vec[scalar] = s.chars().collect()
	let mut i = 0
	if s.starts_with("-") || s.starts_with("+") {
		i = 1
	}
	let body = s.strip_prefix("-") ?? (s.strip_prefix("+") ?? s)
	if body == ".inf" || body == ".Inf" || body == ".INF" {
		return true
	}
	if s == ".nan" || s == ".NaN" || s == ".NAN" {
		return true
	}
	let mut whole = 0
	while i < cs.len() as i64 && cs[i] >= '0' && cs[i] <= '9' {
		whole += 1
		i += 1
	}
	let mut fraction = 0
	if i < cs.len() as i64 && cs[i] == '.' {
		i += 1
		while i < cs.len() as i64 && cs[i] >= '0' && cs[i] <= '9' {
			fraction += 1
			i += 1
		}
	}
	if whole == 0 && fraction == 0 {
		return false
	}
	if i < cs.len() as i64 && (cs[i] == 'e' || cs[i] == 'E') {
		i += 1
		if i < cs.len() as i64 && (cs[i] == '-' || cs[i] == '+') {
			i += 1
		}
		let mut exponent = 0
		while i < cs.len() as i64 && cs[i] >= '0' && cs[i] <= '9' {
			exponent += 1
			i += 1
		}
		if exponent == 0 {
			return false
		}
	}
	return i == cs.len() as i64
}

// The decimal number at the start of `t`, 0 where none is.
fn leading_number(t: String) -> i64 sync {
	let mut n = 0
	for c in t.chars() {
		if c < '0' || c > '9' {
			break
		}
		n = n * 10 + text::digit_value(c) as i64
	}
	return n
}

// The byte offset of a line and a column (from 1, the column in characters).
fn offset_of(input: ref Bytes, line: i64, column: i64) -> i64 sync {
	let n = input.len() as i64
	let mut at_line = 1
	let mut at_column = 1
	let mut i = 0
	while i < n {
		let b = input[i]
		// A byte that is no UTF-8 continuation byte starts a character.
		let starts = b < 128 || b >= 192
		if starts && at_line == line && at_column == column {
			return i
		}
		if b == 10 {
			if at_line == line {
				return i
			}
			at_line += 1
			at_column = 1
		} else if starts {
			at_column += 1
		}
		i += 1
	}
	return n
}

// A `ParseError` carries the parser's rendered message and nothing else
// (Part II 10.8): the message, then `at line L, column C` and the line it
// stopped in.
fn error_of(input: ref Bytes, rendered: String) -> Error sync {
	let parts: Vec[String] = rendered.split(" at line ").collect()
	if parts.len() < 2 {
		return Error { message: rendered.clone(), line: 1, column: 1, offset: 0 }
	}
	let place: Vec[String] = parts[1].split(", column ").collect()
	let line = leading_number(place[0].clone())
	let column = if place.len() > 1 { leading_number(place[1].clone()) } else { 1 }
	return Error {
		message: parts[0].clone(),
		line: line,
		column: column,
		offset: offset_of(input, line, column),
	}
}

// The line and the column (from 1, the column in characters) of a byte
// offset.
fn place_of(input: ref Bytes, offset: i64) -> (i64, i64) sync {
	let mut line = 1
	let mut column = 1
	let mut i = 0
	while i < offset && i < input.len() as i64 {
		let b = input[i]
		if b == 10 {
			line += 1
			column = 1
		} else if b < 128 || b >= 192 {
			column += 1
		}
		i += 1
	}
	return (line, column)
}

// The stream's documents, one `Node` each, within `limits` (D8): an input
// longer than `limits.bytes` is refused before it is read, nesting deeper
// than `limits.depth` where the level past the limit begins.
pub fn parse(input: ref Bytes; limits: Limits = default_limits()) -> Vec[Node] sync throws {
	if input.len() as i64 > limits.bytes {
		let (line, column) = place_of(input, limits.bytes)
		throw Error {
			message: f"input longer than the size limit of {limits.bytes} bytes",
			line: line,
			column: column,
			offset: limits.bytes,
		}
	}
	let depth = limits.depth
	return Yaml::stream(input, limits) catch {
		let rendered = f"{error}"
		if rendered.contains("nesting within the depth limit") {
			let e = error_of(input, rendered)
			throw Error {
				message: f"nesting deeper than the depth limit of {depth}",
				line: e.line,
				column: e.column,
				offset: e.offset,
			}
		}
		throw error_of(input, rendered)
	}
}

// A scalar's value: for a double-quoted one what the grammar decoded (D11);
// line folding (YAML 1.2.2 6.5) and `''` of a plain or a single-quoted one,
// a copy of its own computed on request.
pub fn text(s: ref Scalar) -> String sync {
	return match s.style {
		Style::Plain => fold(s.raw, false)
		Style::Single => fold(s.raw, true)
		Style::Double => s.value.clone()
		Style::Literal => block(s.raw, s.indent, s.chomp, false)
		Style::Folded => block(s.raw, s.indent, s.chomp, true)
	}
}

// The content indentation an indentation indicator `d` gives under a parent
// at `n`; a document's top node has none (`n` is -1) and counts from 0.
fn explicit_indent(n: i64, d: i64) -> i64 sync {
	if n < 0 {
		return d
	}
	return n + d
}

fn most(xs: ref Vec[i64]) -> i64 sync {
	let mut m = 0
	for x in xs {
		if x > m {
			m = x
		}
	}
	return m
}

// A block scalar's end: after its last character that is no space and no
// line break, or after its header where it has no text.
fn block_end(header: u32, from: u32, s: String) -> u32 sync {
	let bs: Vec[u8] = s.bytes().collect()
	let mut n = bs.len() as i64
	while n > 0 && (bs[n - 1] == 32 || bs[n - 1] == 10) {
		n -= 1
	}
	if n == 0 {
		return header
	}
	return from + n as u32
}

// A block scalar's value (YAML 1.2.2 8.1): each content line less its
// indentation `indent`; for a folded one (8.1.3) a single break between two
// lines that start with no space is a space and each empty line between them
// a break, every other break kept; the end chomped (8.1.1.2).
fn block(raw: String, indent: i64, chomp: Chomp, folded: bool) -> String sync {
	let mut lines: Vec[String] = []
	let mut line = String()
	let mut column = 0
	for c in raw.chars() {
		if c == '\n' {
			lines.push(line.clone())
			line = String()
			column = 0
		} else {
			if column >= indent {
				line.push(c)
			}
			column += 1
		}
	}
	// The last line has no break only at the end of the input.
	let broken = line.len() == 0
	if !broken {
		lines.push(line.clone())
	}
	let n = lines.len() as i64
	let mut out = String()
	// The previous text line, -1 before the first.
	let mut prev = -1
	for i in 0..<n {
		if lines[i].len() == 0 {
			continue
		}
		if prev < 0 {
			out.push_str(breaks(i))
		} else if folded && !more_indented(lines[prev]) && !more_indented(lines[i]) {
			if i - prev == 1 {
				out.push(' ')
			} else {
				out.push_str(breaks(i - prev - 1))
			}
		} else {
			out.push_str(breaks(i - prev))
		}
		out.push_str(lines[i])
		prev = i
	}
	if prev < 0 {
		return match chomp {
			Chomp::Keep => breaks(n)
			else => out
		}
	}
	if prev == n - 1 && !broken {
		return out
	}
	match chomp {
		Chomp::Strip => {}
		Chomp::Clip => out.push('\n')
		Chomp::Keep => out.push_str(breaks(n - prev))
	}
	return out
}

fn more_indented(line: String) -> bool sync {
	return line.starts_with(" ") || line.starts_with("\t")
}

// Folds the lines of a flow scalar: the spaces around a line break go, one
// break is a space, each further (empty) line a line break.
fn fold(raw: String, single: bool) -> String sync {
	let cs: Vec[scalar] = raw.chars().collect()
	let n = cs.len() as i64
	let mut out = String()
	// Spaces and tabs not yet known to stand inside a line.
	let mut pending = String()
	let mut i = 0
	while i < n {
		let c = cs[i]
		if c == ' ' || c == '\t' {
			pending.push(c)
			i += 1
			continue
		}
		if c == '\n' || c == '\r' {
			pending = String()
			i = skip_blanks(cs, i + 1)
			let mut breaks = 0
			while i < n && cs[i] == '\n' {
				breaks += 1
				i = skip_blanks(cs, i + 1)
			}
			if breaks == 0 {
				out.push(' ')
			}
			while breaks > 0 {
				out.push('\n')
				breaks -= 1
			}
			continue
		}
		out.push_str(pending)
		pending = String()
		if single && c == '\'' {
			out.push('\'')
			i += 2
			continue
		}
		out.push(c)
		i += 1
	}
	out.push_str(pending)
	return out
}

// The position after the spaces and tabs from `i` (a line's indentation).
fn skip_blanks(cs: ref Vec[scalar], from: i64) -> i64 sync {
	let mut i = from
	while i < cs.len() as i64 && (cs[i] == ' ' || cs[i] == '\t') {
		i += 1
	}
	return i
}

// A value asked for as a number it is not, or does not fit.
pub struct ConvertError {
	pub message: String,
}

impl Error for ConvertError {
	fn message(ref self) -> String {
		return self.message.clone()
	}
}

// An `Int` as an `i64`. **`Value::Int` is built only by the core schema's
// resolution** (`plain_kind`, in the grammar's action on a plain scalar), so
// its text has one of the shapes D5 names, checked there, and is converted
// for that shape without checking a digit again (D5): `[-+]?[0-9]+` by
// `text::parse_i64` (`012` is 12), `0x…` and `0o…` by `radix_value`. A
// `Value::Int` a program builds itself with other text is read as if it had
// that shape.
pub fn as_i64(v: ref Value) -> i64 sync throws {
	let t = match v {
		Value::Int(t) => t.clone()
		else => throw ConvertError { message: "not an integer" }
	}
	let n = if t.starts_with("0x") {
		radix_value(t, 16)
	} else if t.starts_with("0o") {
		radix_value(t, 8)
	} else {
		text::parse_i64(t.clone())
	}
	if n == null {
		throw ConvertError { message: f"`{t}` does not fit in an i64" }
	}
	return n ?? 0
}

// The value of `0x…` (`radix` 16) or `0o…` (8), whose digits the core
// schema's resolution has checked. Whether it fits an `i64` is decided by the
// count of its significant digits, leading zeros not counted, never by
// checked arithmetic: `0x` up to 15 always, 16 where the first is at most
// `7`, 17 or more never (`i64::MAX` is `0x7FFFFFFFFFFFFFFF`); `0o` up to 21
// (63 bits, `0o777777777777777777777`), 22 or more never. A digit's value is
// `hex_value`'s, branch free.
fn radix_value(t: String, radix: i64) -> i64? sync {
	let cs: Vec[scalar] = t.chars().collect()
	let n = cs.len() as i64
	let mut i = 2
	while i < n && cs[i] == '0' {
		i += 1
	}
	let digits = n - i
	if radix == 16 && (digits > 16 || (digits == 16 && cs[i] > '7')) {
		return null
	}
	if radix == 8 && digits > 21 {
		return null
	}
	let mut value = 0
	while i < n {
		value = value * radix + hex_value(cs[i])
		i += 1
	}
	return value
}

// A hexadecimal digit's value, branch free over a digit already checked
// (`benches/brc/fast.nika`): `0`-`9` are their low four bits, `a`-`f` and
// `A`-`F` have one to six there, and bit 6 set, which adds nine.
fn hex_value(x: scalar) -> i64 sync {
	let c = x as i64
	return (c & 15) + 9 * (c >> 6)
}

// An `Int` or a `Float` as an `f64`: YAML's spelling (`.5`, `1.`, `.inf`,
// `-.Inf`, `.NaN`) rewritten into the one `text::parse_f64` reads (ADR-285
// D35: no `.5`, no `1.`); `0x…` and `0o…` as `as_i64` reads them.
pub fn as_f64(v: ref Value) -> f64 sync throws {
	let t = match v {
		Value::Int(t) => t.clone()
		Value::Float(t) => t.clone()
		else => throw ConvertError { message: "not a number" }
	}
	if t.starts_with("0x") || t.starts_with("0o") {
		return as_i64(v) as f64
	}
	let mut spelled = String()
	let cs: Vec[scalar] = t.chars().collect()
	let mut i = 0
	if cs.len() > 0 && (cs[0] == '-' || cs[0] == '+') {
		spelled.push(cs[0])
		i = 1
	}
	if i < cs.len() as i64 && cs[i] == '.' {
		let word: String = (t.strip_prefix(spelled) ?? "").to_lowercase()
		if word == ".inf" || word == ".nan" {
			spelled.push_str(word.strip_prefix(".") ?? "")
			return text::parse_f64(spelled) ?? 0.0
		}
		spelled.push('0')
	}
	while i < cs.len() as i64 {
		spelled.push(cs[i])
		if cs[i] == '.' && (i + 1 >= cs.len() as i64 || cs[i + 1] < '0' || cs[i + 1] > '9') {
			spelled.push('0')
		}
		i += 1
	}
	let x = text::parse_f64(spelled)
	if x == null {
		throw ConvertError { message: f"`{t}` is not a number" }
	}
	return x ?? 0.0
}
