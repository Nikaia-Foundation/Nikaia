[type."Next"]
fields = ["ended: bool", "doc: Document"]
tethered = ["doc"]

[type."Node"]
pub = true
fields = ["pub start: u32", "pub end: u32", "pub anchor: ref String?", "pub tag: ref String?", "pub flow: bool", "pub raw: ref String", "pub style: Style", "pub value: Value"]
tethered = ["anchor", "tag", "raw", "value"]

[type."Props"]
fields = ["start: u32", "end: u32", "anchor: ref String?", "tag: ref String?"]
tethered = ["anchor", "tag"]

[type."Scalar"]
pub = true
fields = ["pub raw: ref String", "value: String", "pub style: Style", "indent: i64", "chomp: Chomp"]
tethered = ["raw", "value"]

[type."Style"]
pub = true
variants = ["Plain", "Single", "Double", "Literal", "Folded"]

[type."TagKind"]
variants = ["Untagged", "NonSpecific", "Null", "Bool", "Int", "Float", "Str", "Seq", "Map", "Other"]

[type."Value"]
pub = true
variants = ["Null", "Bool(bool)", "Int(ref String)", "Float(ref String)", "Str(Scalar)", "Seq(Vec[Node])", "Map(Vec[Entry])", "Alias(ref String)"]
tethered = ["Int", "Float", "Str", "Seq", "Map", "Alias"]
