fields = ["pub key: Node", "pub value: Node"]
tethered = ["key", "value"]

[type."Error"]
pub = true
fields = ["pub message: String", "pub line: i64", "pub column: i64", "pub offset: i64"]

[type."Event"]
pub = true
fields = ["pub kind: EventKind", "pub start: u32", "pub end: u32", "pub explicit: bool", "pub flow: bool", "pub anchor: ref String?", "pub tag: String?", "pub style: Style", "pub value: ref String", "pub text: String?"]
tethered = ["anchor", "value"]

[type."EventKind"]
pub = true
variants = ["StreamStart", "StreamEnd", "DocumentStart", "DocumentEnd", "SequenceStart", "SequenceEnd", "MappingStart", "MappingEnd", "Scalar", "Alias"]

[type."Head"]
