[type."Chomp"]
variants = ["Clip", "Strip", "Keep"]

[type."ConvertError"]
pub = true
fields = ["pub message: String"]

[type."Ctx"]
variants = ["BlockIn", "BlockOut"]

[type."Dir"]
fields = ["name: ref String", "handle: ref String", "prefix: ref String"]
tethered = ["name", "handle", "prefix"]

[type."Document"]
pub = true
fields = ["pub root: Node", "pub start: bool", "pub end: bool"]
tethered = ["root"]

[type."Entry"]
pub = true
fields = ["pub key: Node", "pub value: Node"]
tethered = ["key", "value"]

[type."Error"]
pub = true
fields = ["pub message: String", "pub line: i64", "pub column: i64", "pub offset: i64"]

[type."Head"]
fields = ["indent: i64", "chomp: Chomp"]

[type."Kind"]
variants = ["Null", "True", "False", "Int", "Float", "Str"]

[type."Limits"]
pub = true
fields = ["pub depth: i64", "pub alias_nodes: i64", "pub bytes: i64"]

[type."Next"]
fields = ["ended: bool", "doc: Document"]
tethered = ["doc"]

[type."Node"]
pub = true
fields = ["pub start: u32", "pub end: u32", "pub anchor: ref String?", "pub tag: ref String?", "pub flow: bool", "pub value: Value"]
tethered = ["anchor", "tag", "value"]

[type."Props"]
fields = ["start: u32", "end: u32", "anchor: ref String?", "tag: ref String?"]
tethered = ["anchor", "tag"]

[type."Scalar"]
pub = true
fields = ["pub raw: ref String", "value: String", "pub style: Style", "indent: i64", "chomp: Chomp"]
tethered = ["raw", "value"]

[type."Style"]
pub = true
variants = ["Plain", "Single", "Double", "Literal", "Folded"]

[type."TagKind"]
variants = ["Untagged", "NonSpecific", "Null", "Bool", "Int", "Float", "Str", "Seq", "Map", "Other"]

[type."Value"]
pub = true
variants = ["Null", "Bool(bool)", "Int(ref String)", "Float(ref String)", "Str(Scalar)", "Seq(Vec[Node])", "Map(Vec[Entry])", "Alias(ref String)"]
tethered = ["Int", "Float", "Str", "Seq", "Map", "Alias"]
