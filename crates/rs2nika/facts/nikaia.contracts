# AUTO-GENERATED by `nikaia`. Commit this file like a lockfile.
# Do not edit by hand - it is regenerated on every build.
#
# What a caller has to know about a function it cannot see the body of:
# whether it may pause (`sync`), whether it may fail and with what
# (`throws`), and what its result may point into (`returns`). Part III, 13.5.
#
# A `"?"` among the errors is the absence of a claim: it fails, with
# something this compiler cannot name.
version = 3

[fn."facts_blocks"]
sync = "inferred"
touches = []
views = ["hover: borrowed"]
signature = "(hover: ref String) -> Vec[String]"

[fn."facts_calls"]
sync = "inferred"
touches = []
views = ["source: borrowed", "resolved: borrowed", "doc: borrowed"]
signature = "(source: ref String, resolved: ref collections::BTreeSet[String], doc: ref String) -> Vec[i64]"

[fn."facts_classify"]
sync = "inferred"
touches = []
views = ["hover: borrowed"]
signature = "(hover: ref String, defined: bool) -> String"

[fn."facts_digit"]
sync = "inferred"
touches = []
signature = "(ch: scalar) -> i64"

[fn."facts_fn_name"]
sync = "inferred"
touches = []
views = ["line: borrowed"]
signature = "(line: ref String) -> String"

[fn."facts_hover"]
sync = "inferred"
touches = []
views = ["d: borrowed"]
signature = "(d: ref FactsDump, range: i64) -> String"

[fn."facts_int"]
sync = "inferred"
touches = []
views = ["line: borrowed", "key: borrowed"]
signature = "(line: ref String, key: ref String) -> i64"

[fn."facts_ints"]
sync = "inferred"
touches = []
views = ["line: borrowed", "key: borrowed"]
signature = "(line: ref String, key: ref String) -> Vec[i64]"

[fn."facts_is_op"]
sync = "inferred"
touches = []
views = ["path: borrowed", "name: borrowed"]
signature = "(path: ref String, name: ref String) -> bool"

[fn."facts_read"]
sync = "inferred"
touches = []
views = ["text: borrowed"]
signature = "(text: ref String) -> FactsDump"

[fn."facts_rel"]
sync = "inferred"
touches = []
views = ["d: borrowed", "uri: borrowed"]
signature = "(d: ref FactsDump, uri: ref String) -> String"

[fn."facts_starts"]
sync = "inferred"
touches = []
views = ["text: borrowed", "prefix: borrowed"]
signature = "(text: ref String, prefix: ref String) -> bool"

[fn."facts_str"]
sync = "inferred"
touches = []
views = ["line: borrowed", "key: borrowed"]
signature = "(line: ref String, key: ref String) -> String"

[fn."facts_typed"]
sync = "inferred"
touches = []
views = ["path: borrowed"]
signature = "(path: ref String) -> bool"

[fn."main"]
throws = ["?"]
locks = true
signature = "()"

[type."FactsDump"]
fields = ["root: String", "under: String", "ranges: collections::BTreeMap[i64, String]", "starts: collections::BTreeMap[i64, String]", "next: collections::BTreeMap[i64, i64]", "hover_of: collections::BTreeMap[i64, i64]", "hovers: collections::BTreeMap[i64, String]", "docs: collections::BTreeMap[i64, String]", "doc_of: collections::BTreeMap[i64, i64]", "def_results: collections::BTreeSet[i64]", "defined: collections::BTreeSet[i64]", "def_edges: Vec[i64]"]
