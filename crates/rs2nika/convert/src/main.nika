// crates/rs2nika/convert/src/main.nika
//
// The Rust-to-Nikaia converter (ADR-001 D5, #579): a first draft in Nikaia of
// a Rust function, line by line, by the rules `--rules` lists. What it cannot
// translate it marks with `TODO(rs2nika)`; the draft is read and finished by
// hand. Run: `nikaia run crates/rs2nika/convert -- [--profile check|emit|none]
// [--prefix X_] [--stats] [--file] [--repo DIR] FILE.rs`, `-- --rules`,
// `-- --lint F.nika..`. Names (R45-R47) come from the checkout found at `.`
// or above it, or `--repo DIR`.

use std::fs
use std::cli
use std::process
use std::collections
use std::text

/// What a run made: the draft and the rules it applied, one entry a hit.
pub struct Rs2nikaOut {
    pub text: String,
    pub hits: Vec[String],
    pub missing: Vec[String],
    pub twins: Vec[String],
}

/// The state of one run.
struct Rs2nikaCtx {
    profile: String,
    free: bool,
    world: String,
    prefix: String,
    hits: Vec[String],
    fn_opt: bool,
    methods: Vec[String],
    renamed_from: Vec[String],
    renamed_to: Vec[String],
    stack_ind: Vec[String],
    stack_kind: Vec[String],
    tool_fns: collections::BTreeSet[String],
    tool_names: Vec[String],
    tool_docs: Vec[String],
    tool_files: Vec[String],
    alias_from: Vec[String],
    alias_to: Vec[String],
    equiv_from: Vec[String],
    equiv_to: Vec[String],
    todo_extra: Vec[String],
    arity: Vec[String],
    host_fns: Vec[String],
    opt_names: Vec[String],
    /// R52: the names the file declares `&Parsed` (a parameter), besides `parsed`.
    parsed_names: Vec[String],
    /// R207: inside the `impl` of a type other than the state (`impl Mark`):
    /// its methods keep `ref self`, their names and `self`.
    impl_other: bool,
    /// R205: the field names `tools/*.nika` declares only as `T?`.
    field_opts: collections::BTreeSet[String],
    /// R172: the arm lines a tuple `match` keeps as written, and why.
    tuple_line: Vec[String],
    tuple_why: Vec[String],
    /// R177: the parsed files are `ParsedView`s (`--view`).
    view: bool,
    /// `--view`: rs2nika.names' `[view]`, `from` and `to` side by side
    view_names: Vec[String],
    /// The functions whose Rust result was `impl Iterator`: they return a
    /// list (R197).
    seq_fns: Vec[String],
}

/// The rules, as `--rules` prints them.
pub fn rs2nika_rules() -> Vec[String] {
    return [
        "R1   statement `;` dropped",
        "R2   `&self` -> `ref self`, `&mut self` -> `ref mut self`",
        "R3   param `x: &mut T` -> `mut x: T`; `x: &T` -> `x: ref T`",
        "R4   `&str`/`&String` -> `String` (`ref String` warns, NK1261), `&[T]` -> `ref Vec[T]`, `Cow<str>` -> `String`",
        "R5   lifetimes dropped (`<'a>`, `&'a`, `'_`)",
        "R6   `Vec<T>` -> `Vec[T]` (any generic `<..>` in a type -> `[..]`)",
        "R7   `Option<T>` -> `T?`",
        "R8   `HashMap`/`HashSet`/`BTreeMap`/`BTreeSet` -> `collections::BTreeMap`/`BTreeSet` (TrustedMap otherwise)",
        "R9   `Box<T>` -> `T`, `Box::new(x)` -> `x`",
        "R10  `usize`/`u32`/`u16`/`isize`/`i32` -> `i64` and `char` -> `scalar` in types; `as usize` (`isize`, `u16`, `i32`) casts dropped, `as u32` -> `as i64`",
        "R11  signature: ` sync` added; `-> Result<T>` -> `-> T sync throws`",
        "R12  `None` -> `null`, `Some(x)` as a value -> `x` (also at the end of a block, `{ ..; Some(x) }`)",
        "R13  `_ =>` -> `else =>`",
        "R14  `matches!(e, P)` / `matches!(e, P if g)` -> `match e { P => true, else => false }`",
        "R15  `format!(\"..{}..\", a)` -> `f\"..{a}..\"`; `&format!` -> `f\"..\"`",
        "R16  `.to_owned()`/`.into_owned()`/`String::from(x)` -> `.clone()`; `\"lit\".to_string()`/`\"lit\".to_owned()` -> `\"lit\"` (a literal is the text, NK1301); `.to_string()` after a name lookup -> `.clone()`",
        "R17  `String::new()` -> `\"\"`, `Vec::new()`/`vec![]` -> `[]`, `vec![a, b]` -> `[a, b]`, `BTreeMap::new()` -> `collections::BTreeMap()`",
        "R18  `*x` deref dropped",
        "R19  `&x`/`&mut x` at a use dropped (Nikaia lends implicitly)",
        "R20  `.unwrap_or(d)` / `.unwrap_or_else(|| d)` -> `?? d`; `.cloned()` / `.copied()` of an option -> `?.clone()` (R35 leaves that `?`)",
        "R21  `.is_some()` -> `!= null`, `.is_none()` -> `== null`",
        "R22  `let Some(x) = e else { return y };` -> `let x = e ?? return y` (also continue/break)",
        "R23  `if let Some(x) = x [&& g] {` -> `if x != null [&& g] {` (ADR-382); over a path of fields `if let Some(x) = &self.f [&& g] {` -> `if self.f != null [&& g] {` with `x` read as `self.f`, + `let x = self.f` only where the block writes the path (ADR-382 D7); over another name + `let x = e`; else R170",
        "R24  `if let P = e {` ... `} else {` ... `}` -> `match e { P => {..}, else => {..} }` (single let, optional `&& guard`)",
        "R25  `for x in &xs` / `xs.iter()` -> `for x in xs`",
        "R26  closures `|x| e` -> `fn(x) { e }`; `.any`/`.all`/`.find` pass through (`Seq`), a function name `.any(f)` -> `.any(fn(x) { f(x) })`",
        "R27  `.collect::<T>()` -> `.collect()`",
        "R28  path prefixes `crate::ast::`, `ast::`, `crate::types::`, `ty::`, `contracts::` dropped",
        "R29  `.as_ref()`, `.as_slice()`, `.as_str()`, `.as_deref()`, `.borrow()` dropped",
        "R30  `#[...]` attributes dropped; `pub(crate)`/`pub(super)` -> `pub`/none",
        "R31  profile: `self.parsed.text(x)`/`self.text(x)`/`self.name(x)` -> `world.words.resolve(x)`",
        "R32  profile: `self.s.f` -> `self.f`, `self.parsed.program.items` -> `world.items`, `self.world.` -> `world.`",
        "R33  profile: methods get `world: ref <World>` after `self`; calls `self.m(` to methods in the same input pass `world`",
        "R34  profile: `impl<'a> Checker<'a>` / `impl Emitter` -> `impl CheckState` / `impl EmitState`",
        "R35  postfix `?` in a `T?` function -> `?? return null`; before an operator or a `.` the operand is wrapped: `e? + 1` -> `(e ?? return null) + 1`",
        "R36  `loop {` -> `while true {`",
        "R37  rustfmt-split patterns and struct literals joined onto one line",
        "R38  `X::default()` of a moved struct -> `X::empty()`",
        "R39  `.iter().enumerate()` / slice patterns / `match` on `Some` / `.entry()` / `is_ok_and` / `map_or` R79 cannot take -> TODO marker",
        "R40  `.len() as i64` cast dropped, `.unwrap()` -> `?? panic(\"unwrap\")`",
        "R41  function name prefixed (`--prefix`): tools/*.nika is one global namespace",
        "R42  a function's tail expression -> `return expr` (the style of tools/*.nika)",
        "R43  zero-argument local closures (`let f = || e;`) inlined at `f()`",
        "R44  `--file`: a whole tools file, free items on top and `self` methods in `impl <State>`",
        "R45  a Rust alias of a moved type (`use nikaia_std::tools::m::{CheckX as X}`) -> its Nikaia name",
        "R46  a path call `a::b::f(..)` -> `f(..)` where tools/*.nika has `fn f` (one global namespace)",
        "R47  the equivalence table rs2nika.names (`value_node node_key`): Rust helpers that Nikaia has under another name",
        "R48  `match e { Some(x) => a, None => b }` -> `if e != null { let x = .. a } else { b }`; as a statement whose `None` arm leaves (`return`, `continue`, `break`), either order -> `let x = e ?? <leave>` and `a` after it",
        "R49  `Ty::named(x)` / `Ty::view(x)` -> `Ty::Named { name: x, args: [], view: false/true }`",
        "R50  `&Span` -> `Span` (a span is copied, never lent)",
        "R51  a `fn` nested in a `fn` is hoisted to the top level",
        "R52  profile: a `parsed: &Parsed` parameter -> `parsed: ref CheckWorld`, `parsed.text(x)` -> `parsed.words.resolve(x)`, the same for any other `&Parsed` parameter",
        "R53  ranges: Rust's `a..b` stops before `b`, Nikaia's includes it: `a..b` -> `a..<b`, `a..=b` -> `a..b`",
        "R54  idioms Nikaia spells otherwise: `[\"A\", \"B\"].contains(&x)` -> `(x == \"A\" || x == \"B\")`, `x.rsplit(\"::\").next().unwrap_or(x)` -> `type_last_segment(x)`",
        "R55  `match` on an option with `Some(P)` arms -> `let given = e ?? <None arm>` then `match given { P => .. }`",
        "R56  `while let P = e && let Some(t) = f {` -> `while true {` + `let t = f ?? break` / `match e { P => x, else => break }`",
        "R57  a byte literal `b'x'` -> its number (`b'\\\\'` -> `92`)",
        "R58  a line on Rust-only types (`&[&Parsed]`, `Ledger`, `check(..)`, `once(..)`) -> `// ADAPTER: bleibt in Rust`",
        "R59  `let v: T = xs.iter().filter(|x| p).cloned().collect()` -> `let mut v: T = []` and a `for` with `push(x.clone())`",
        "R60  `let P = v else { jump }` -> `let x = match v { P => x, else => jump }` (a tuple of the names it binds)",
        "R62  a match arm whose value is an assignment -> `P => { n += 1 },`",
        "R61  `let (mut a, mut b): (A, B) = (x, y)` -> one `let` each",
        "R79  Option combinators with a field or method body: `o.map(|x| x.f)` -> `o?.f`, `.is_some_and(|x| x.p())` -> `(o?.p() ?? false)`, `.map_or(d, ..)` -> `(o?.. ?? d)`",
        "R80  `String::with_capacity(n)` -> `\"\"`",
        "R81  a call or a literal in a `format!` argument -> `let hole_N = ..` before the line, `{hole_N}` in the f-string",
        "R67  `.find('c')` / `.rfind('c')` -> `.find(\"c\")`: `str::find` takes text",
        "R66  `build_time::decoded(x)` -> `decoded(x) fn(n) { ascii_scalar(n) }` (escapes.nika), with a TODO: above ASCII it reads no text",
        "R65  `?` in a lambda -> `?? return null`; `x.starts_with([a, b])` -> `(x.starts_with(a) || x.starts_with(b))`",
        "R64  `let x = match e { Some(v) => v, None => return y }` (also `continue`/`break`, in loops too) -> `let x = e ?? return y`",
        "R63  what R79 leaves of `o.is_some_and(..)`, `o` read once: `o.is_some_and(|x| p)` -> `(match o { x => p, null => false })`, `o.is_some_and(f)` -> `(match o { value => f(value), null => false })` (ADR-352)",
        "--only NAME converts the one function NAME of the file (line numbers kept, for `--facts`)",
        "R68  a positional rest `V(a, ..)` and a slice pattern pass through; `rest @ ..` -> `..rest` (ADR-355)",
        "R70  a `format!` hole hoisted out of a match arm (R81) -> the arm becomes a block holding it",
        "R71  a `None =>` / `None if guard =>` arm -> `null =>` / `null if guard =>` (ADR-352)",
        "R72  a `Some(p) =>` arm -> `p =>`, `Some(_)` -> `_value` (the other arms of a `match` with `null` match the `T`, ADR-352)",
        "R95  R72 inside a one-line `match` (`match e { Some(p) => a, None => b }` -> `match e { p => a, null => b }`); its `_ =>` -> `None =>` only where each `Some(` opens its arm; a `Some(` in a struct pattern keeps its TODO (a field does not narrow yet, #886), one in a tuple pattern is R172's",
        "R96  what R79 and R63 leave of an option's combinator with a closure -> a `match`: `e.is_some_and(|x| p)` -> `(match e { x => p, null => false })`, `e.map_or(d, |x| b)` -> `(.. null => d })`, `e.map(|x| b)` / `.and_then(..)` -> `(.. null => null })`, the last three only where `e` ends in a call that hands back an option",
        "R97  a let-chain `if a && let Some(x) = e [&& b] {`: over a name -> `if a && e != null [&& b] {`; else -> `if a {` + `let x = e` + `if x != null [&& b] {`, closed twice",
        "R100 a `use` inside a `fn` or `mod` block -> once at the top of the file, after its own `use` lines (a list over several lines on one line, a duplicate dropped); `use super::x` drops (the module is the same file), `use super::x as y` keeps a TODO",
        "R101 a `static` that holds a constant -> `comptime`: `static X: &str = \"a\";` -> `comptime X: ref String = \"a\"`, `static X: &[T] = &[a, b];` -> `comptime X: Array[T, 2] = [a, b]`, `[T; N]` -> `Array[T, N]`",
        "R102 a `static` that is a global (atomic, lock, cell, once) keeps a TODO that names the field of the state struct it becomes",
        "R103 `const X: T = v;` (also `pub(crate)`, in a function, over several lines) -> `comptime X: T = v`, the type as in R101; one from a macro (`include_str!`, `env!`) or of tuples or nested references keeps a TODO",
        "R104 `const fn` -> `fn`",
        "R105 a `const` of an `impl` -> a top-level `comptime` above it (no associated constants), `Self::X` / `Type::X` -> `X`; a name already taken keeps a TODO",
        "R120 a multi-line `match` on an option whose `None` arm is a value (R55 would need `?? return`): arm by arm in place, `Some(P) =>` -> `P =>`, `None`/`_` -> `null =>`, and `else =>` with the `_` arm's one line after it where a `Some` arm can fail",
        "R121 R96 with a function's path for the closure: `e.map(f)` / `.and_then(f)` / `.map_or(d, f)` -> `(match e { x => f(x), null => .. })`, `x.m()` for `Type::as_m`/`to_m`/`is_m`",
        "R122 R96 also where `e` is an option by its `.as_ref()`/`.as_deref()`, or is a name (or ends in a field) the file declares `: Option<..>` (or a function of it that hands back `Option<..>`, or a `let` of R96's sure kind)",
        "R123 the let-chains R97 leaves (`if let Some(P) = e && ..`, several `let`s, a tuple `P`): a `let` over a name is `e != null`; over anything else the test so far opens an `if`, then `let P = e`, and `P != null` opens the next; closed once for each `if`",
        "R106 an integer literal's suffix: `0usize` -> `0` (R10's types), `1u8` -> `(1 as u8)`",
        "R107 a `char` needle of `find` / `rfind` / `replace` -> a text: `s.find(':')` -> `s.find(\":\")`; a needle that is a function, a closure or a list keeps a TODO, except a closure after an iterator (`xs.iter().find(|x| ..)` is `Seq::find`, R26)",
        "R108 the bytes of a text: `.as_bytes()` -> `.bytes` (the text's own, ADR-320 D11), a byte string `b\"ab\"` -> `\"ab\".bytes`",
        "R109 `e.parse::<T>()` / `e.parse()` (also `.ok()` after it) -> `text::parse_i64(e)` (`parse_u64`, `parse_u8` for those), and `use std::text` at the top",
        "R73  `cond.then(|| e)` -> `(if cond { e } else { null })`",
        "R74  struct update `S { a: x, ..base }` -> `base with { a: x }` (Part I 4.2)",
        "R75  a callback `&|a: T| e` -> the lambda `fn(a) { e }` (R26)",
        "R76  `module::f(` where tools/module.nika exists -> `f(` (one namespace for all tools)",
        "R77  `self.s.m(..)` (a `CheckState` method already in Nikaia) -> `self.m(..)`, name and arguments as written",
        "R78  a `struct`'s field `name: T,` -> `name: T'`, the type by the rules of a parameter's (R2-R5)",
        "R69  a Rust name Nikaia reserves (`grammar`, `throws`, `with`, ..) -> `name_`",
        "R83  profile `check-free` / `emit-free`: a method is a free function, `self` is `state`: `ref self` -> `state: ref CheckState`, `ref mut self` -> `mut state: CheckState`, then `world: ref CheckWorld`, `host: ref H` and the generic `[H: CheckHost]`; `self.m(a)` -> `m(state, world, host, a)`, `self.x` -> `state.x`",
        "R84  `-free` profiles: `let mut x = \"..\"` / `String::new()` -> `let mut x: String = ..`, `let mut n = 0` -> `let mut n: i64 = 0`",
        "R87  `-free` profiles: the `impl Checker { .. }` shell goes (methods dedented), and the methods of that `impl` are not hoisted as nested functions (R51), also in `--file`",
        "R88  `-free` profiles: `host: ref H` and the generic `[H: CheckHost]` only on a method whose text names `host`, calls `self.s.m(..)`, or calls (`self.m(`) one that does; its calls pass `host` only to those",
        "R85  `-free` profiles: a function with no `self` is not marked `sync` (it threads no state, it does not pause)",
        "R86  `let v = xs.iter().find(|x| c)` / `.find_map(|x| e)` (also after `return`, or as the tail) -> a `for` loop with `break` / `return`, a closure block's `return None` -> `continue`",
        "R162 a let-chain with no `else` whose `let` is not `Some(..)`: `if a && let P = e && g && let Q = f {` -> `if a {`, `if let P = e && g {` (R24), `if let Q = f {` nested, closed once each",
        "R82  a local closure with arguments -> `let f: fn(ref T) -> R sync = fn(a) { .. }`, its type from the `--facts` file (rust-analyzer) or from its own annotations",
        "R93  `for (i, x) in xs.iter().enumerate() {` -> `for i in 0..<xs.len() {` and `let x = xs[i]`; `for x in xs.iter().skip(n) {` -> `for at in n..<xs.len() {` the same (`Seq` has no `enumerate`/`skip`)",
        "R92  `m.entry(k).or_insert(d);` / `.or_insert_with(|| d)` -> `if m[k] == null { m[k.clone()] = d }`; `m.entry(k).or_default().push(x)` (any method; `or_default` of `push` is `[]`, of `insert(x)` a set, of `insert(k, v)` a map) -> `let mut slot = m[k]?.clone() ?? d`, `slot.push(x)`, `m[k.clone()] = slot`; `*m.entry(k).or_insert(d) += n` -> `m[k.clone()] = (m[k] ?? d) + n` (`or_default`: `0`); the map keeps its own key",
        "R94  iterator adapters as a `for` loop: `out.extend(xs.iter().cloned())` -> `for x in xs { out.push(x.clone()) }` (`.copied()`: `push(x)`); `let v = xs.iter().fold(init, |acc, x| e)` -> `let mut v = init` and `for x in xs { v = e }`; R59 also after `.cloned()`/`.copied()` before the `filter`",
        "R110 `.copied()` of a `Seq` chain (back over `Seq` steps to `.iter()`, `.keys()`, `.chars()` ..) goes, `.cloned()` -> `.map(|x| x.clone())`; `for p in xs.iter().copied() {` -> `for p in xs {`",
        "R111 `xs.iter().enumerate().map(|(i, x)| b)` -> `(0..<xs.len()).map(fn(i) { let x = xs[i]; b })` (`Seq` has no `enumerate`), also `filter_map`, `flat_map`, `any`, `all`; a `filter`/`skip_while`/`take_while` on the pair keeps the index, the next step takes the element",
        "R112 `.flat_map(..)` / `.skip(n)` on a `Seq` chain is a `Seq` method: no TODO",
        "R113 R94's fold also over any `Seq` chain, with a function for the closure (`v = f(v, x)`), with a closure block of statements, after `return` (`folded`, then `return folded`) and as a block's tail (`folded` last)",
        "R130 `&str` stays `ref String` in a function type's parameter, where NK1261 does not hold (R4 writes `String` elsewhere, `Option<&str>` and `&Option<String>` -> `String?`: `ref String?` is NK1261)",
        "R140 a `Result`'s `.unwrap_or_else(|e| d)` / `.or_else(|e| d)` -> `catch { d }`, `e` read as `let e = error` where `d` names it (Part I 7.1)",
        "R141 an option's `.or_else(|| e)` -> `?? e`; R20 and R140-R143 put the call in parentheses where an operator, `.` or `[` stands beside it: `x.unwrap_or(\"\").len()` -> `(x ?? \"\").len()`",
        "R142 `.ok_or(e)` / `.ok_or_else(|| e)` -> `?? throw e`",
        "R143 `.map_err(|e| x)` -> `catch { let e = error; throw x }` (the `let` only where `x` names `e`), `.map_err(f)` -> `catch { throw f(error) }`",
        "R144 in a function that `throws` (R11): the postfix `?` dropped, outside text and closures (a failure passes on by itself)",
        "R145 in a function that `throws`, not in a closure or a block a `let` binds: `return Ok(x)` / a line `Ok(x)` / an arm `P => Ok(x),` -> `x` (`Ok(())` -> `return`, in an arm `{}`), `Err(e)` -> `throw e`",
        "R146 `let Ok(P) = call else { jump }` -> `let P = call catch { jump }`; `let Err(..)` and a kept `Result` keep a TODO",
        "R147 `.ok().unwrap_or(d)` -> `catch { d }`, `.ok()?` in a `T?` function -> `catch { return null }`; any other `.ok()`, `.is_ok()`, `.is_err()`, `.is_ok_and(..)` keeps a TODO (a `catch` cannot hand back `null`, NK1103)",
        "R148 `Self` in an `impl` -> the type's name (`Self::f()` is NK1245), the state's in the profiles, `Self::f(` -> `f(` in `-free`; the methods of any `impl` or `trait` stay in it (R51 hoists only a `fn` in a `fn`)",
        "R149 an `enum`'s variants: the payload's types by a field's rules (R10, R6, R9): `Dot(usize)` -> `Dot(i64)`, `Named { at: usize }` -> `Named { at: i64 }`",
        "R150 a turbofish whose type nests: `.collect::<BTreeSet<_>>()` -> `.collect()`; one into an `Option`/`Result` keeps a TODO",
        "R151 `x[..]` -> `x`; open cuts stay (`s[a..]`, `s[..<b]` are Nikaia's, R53); `.get(range)` keeps a TODO (no such method, NK1171)",
        "R160 a `match` on a call's `Result`: `let x = match call { Ok(v) => v, Err(e) => d }` -> `let x = call catch { d }` (`e` as `let e = error` where `d` names it; also `return match`); an `Ok` arm that is more than its value follows `let v = call catch { <the Err arm> }` where that arm leaves (or is a `return match`'s value); `Err(Variant)` arms -> `match error { Variant => .., else => .. }`; an `Ok` arm that runs on success only (the `Err` arm does nothing, or is a value that does not leave) -> `match call catch { null } { v => .., null => <the Err arm> }`, `if (call catch { null }) != null {` where it binds nothing (#884); a guard, a kept `Result`, a `mut` binding keep a TODO",
        "R161 a `Result` read as a value where Nikaia has the form: `x.parse().is_ok()` / `.is_err()` -> `text::parse_i64(x) != null` / `== null` (R109); `return x.ok()` in a `T?` function -> `return x catch { return null }`; a statement `x.ok()` over a call that hands back nothing (`flush()`, `writeln!`, `fs::create_dir_all` ..) -> `x catch {}`; `if x.is_err() {` / `if !x.is_ok() {` whose body leaves -> `x catch {`; else, over a call, `x.ok()` -> `x catch { null }`, `x.is_ok()` / `.is_err()` -> `(x catch { null }) != null` / `== null`, `x.is_ok_and(fn(v) { b })` -> `(match x catch { null } { v => b, null => false })` (#884)",
        "R170 `if let Some(x) = e {` over anything but a plain name (a call, a field) -> `match e { x => {..}, null => {..} }`: `e` read once (ADR-352)",
        "R171 `panic!(\"..{}..\", a)` / `unreachable!(..)` -> `panic(f\"..{a}..\")` (R15), `panic!(\"..\")` -> `panic(\"..\")`, `unreachable!()` -> `panic(\"unreachable\")`; R55's `None => panic!(..)` arm -> `?? panic(..)` and a tail panic (R42), no `return`",
        "R172 a multi-line tuple `match` with `Some(..)` / `None` at a position (#879, ADR-352 D1 per position): `Some(p)` -> `p` where `p` is a variant or a literal other than a text, or a name or `_` an unguarded arm before it covers (`None` there; `_`, a name or the same part elsewhere): `(None, None)`, `(None, Some(p))`, `(Some(e), _)` -> `(null, null)`, `(null, p)`, `(e, _)`; else the `None` arms move up past the arms no value matches with them, else before a closing `_ => b` an arm `(None, _) => b` is written above the first arm that needs it; an arm left as written keeps a TODO with its reason",
        "R173 a struct pattern's field `f: Some(x)` -> `f: x` (`f` for `Some(f)` and `Some(_)`) and the guard `x != null` on the arm (ADR-382 D2; in `if let`, `let .. else`, let-chains and `match` arms)",
        "R174 a walk of the emitter `emit::visit_block(b, &mut |e| { .. });` (`visit_stmt`, `visit_expr`) -> `for e in visited_in_block(b) { .. }` (tools/emit_walk.nika), the closure's `return` -> `continue`",
        "R175 a method whose body is one call on a field of `self` (`self.tables.count(&parsed.interner, ty)`) is written out at each `self.count(..)`, its parameters replaced by the arguments",
        "R176 a method that reads one field of `self` only (and calls methods that do) -> a free function of that field: `&self` -> `tables: &EmitSeedsTables` (the type from the `struct`), `self.tables` -> `tables`, `self.m(a)` -> `m(&self.tables, a)`",
        "R177 `--view`: the parsed files are `ParsedView`s named `unit`, by the `[view]` table of rs2nika.names (or one in the working directory): `&Parsed` -> `ref ParsedView`, `&[&Parsed]` -> `ref Vec[ParsedView]`, `parsed.program.items` -> `unit.items`, `parsed.interner` -> `unit.words`, `parsed.text(*x).to_string()` -> `unit.text(x)`",
        "R178 (`-free`) an `impl Type {` whose methods all became free (none takes `self` any longer) loses its head and its closing brace, and its body moves out one level",
        "R179 `let mut out = []` in a function that ends `return out` takes the list type it returns (`let mut out: Vec[Call] = []`); `match &*func` and `match *func` -> `match func`",
        "R197 `-> impl Iterator<Item = T>` -> `-> Vec[T]`, the last `return` collects",
        "R199 a let-chain's `let Some(P) = e` with a refutable `P` is nested by R162 like any refutable `let`",
        "R200 `if let (Some(a), P) = e {` -> `match e { (a, P) if a != null => {..} }`: a tuple position `Some(name)` gets its guard (ADR-382 D2)",
        "R201 a method chain with comments between its links: the comments move above the joined line",
        "R202 a `match` arm `x @ P =>` (no `@` in Nikaia): over the subject `x` itself -> `P =>`; over another name `s` with a block -> `P => {` + `let x = s`",
        "R203 `visit_stmt_blocks(s, &mut |b| { .. })` (contracts::sync) -> `for b in check_visit_stmt_blocks(s) { .. }`, as R174",
        "R204 a radix literal's suffix: `0xcbf2_9ce4u64` -> `(0xcbf2_9ce4 as u64)`, as R106",
        "R205 `A.chain(B).any(F)` -> `A.any(F) || B.any(F)`, `.all(F)` with `&&` (`Seq` has no `chain`)",
        "R206 a statement with `A.chain(B)`: `let mut chained = A.collect()` (`[x]` for `once(x)`), `chained.extend(B.collect())` first, the chain reads `chained` / `chained.iter()`",
        "R207 profile: the methods of an `impl` of a type other than `Checker`/`Emitter` keep `ref self`, their names and `self.x`: no state, world or prefix",
        "R208 a `{x};` inside a string literal keeps its `;` (only a block's `};` loses it)",
        "R198 `?` inside a `filter_map`/`find_map`/`and_then` closure -> `?? return null`",
        "R196 an empty `impl X {}` is dropped",
        "R195 `if let Some(x) = &mut p { *x = e; }` -> `p = match p { x => e, null => null }`",
        "R194 `.map(str::to_string)`, `(String::from)`, `(Clone::clone)` -> `(fn(x) { x.clone() })`",
        "R193 `let x: Vec<_> = e` -> `let x = e`: `_` names no type",
        "R192 `nikaia_std::tools::f`, `check_items::f` (an imported tools module) -> `f`: one namespace",
        "R191 a top-level `impl` or `fn` on a `static`, `Mutex`, `OnceLock` or `Box::leak`, or of a Rust standard trait, stays in Rust: one `// ADAPTER` line",
        "R190 `fn m(&self) -> T;` in a `trait` -> `fn m(ref self) -> T sync`: no body, no prefix, no state",
        "R189 a tools file imports from `std` only, by module: other `use` lines are dropped",
        "R188 `mod x;` lines are dropped: tools files share one namespace",
        "R187 `match (&xs[..], b) {` -> `match (ref xs, b) {`",
        "R186 `let x: T =` with its value on the next line takes the same type rules",
        "R185 `let f = |x| match x {` over several lines -> `let f = fn(x) { match x {`, closed after the `match`",
        "R184 `let Some(x) = e else {` over several lines -> `let x = e ?? {`, the block its fallback",
        "R183 (`-free`) `name.to_string()` of a `String` parameter -> `name`: it is a text already",
        "R182 `let (a, b): (A, B) = e` -> `let (a, b) = e`: a `let` of several names takes no type (NK1136)",
        "R181 `refused!(\"..{x}\")` -> `throw Refused::Because(f\"..{x}\")`, the error the emitters throw",
        "R180 (`-free`) a free function takes `state` and `world` only where its body uses them, itself or through one of the draft's functions it hands them to: `emit_x_pure(state, world, a)` -> `emit_x_pure(a)`",
    ]
}

/// `--stats`: how often each rule was applied, the most frequent first.
pub fn rs2nika_stats(hits: ref Vec[String]) -> String {
    let mut names: Vec[String] = []
    let mut counts: Vec[i64] = []
    for h in hits {
        let mut found = false
        let mut i = 0
        while i < names.len() {
            if names[i] == h {
                counts[i] = counts[i] + 1
                found = true
            }
            i = i + 1
        }
        if !found {
            names.push(h.clone())
            counts.push(1)
        }
    }
    let mut out: String = ""
    let mut done: Vec[bool] = []
    for _n in names.clone() {
        done.push(false)
    }
    let mut left = names.len()
    while left > 0 {
        let mut best = 0 - 1
        let mut i = 0
        while i < names.len() {
            if !done[i] && (best < 0 || counts[i] > counts[best]) {
                best = i
            }
            i = i + 1
        }
        done[best] = true
        left = left - 1
        out.push_str(f"{names[best]} {counts[best]}\n")
    }
    return out
}

fn rs2nika_hit(mut ctx: Rs2nikaCtx, rule: String) {
    ctx.hits.push(rule.clone())
}

fn rs2nika_word(c: scalar) -> bool {
    return c.is_alphanumeric() || c == '_'
}

/// `from` replaced by `to` where it stands as a whole word at its ends.
fn rs2nika_replace_word(text: String, from: String, to: String) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let f: Vec[scalar] = from.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let mut same = at + f.len() <= c.len()
        let mut k = 0
        while same && k < f.len() {
            if c[at + k] != f[k] {
                same = false
            }
            k = k + 1
        }
        if same && rs2nika_word(f[0]) && at > 0 && rs2nika_word(c[at - 1]) {
            same = false
        }
        if same && rs2nika_word(f[f.len() - 1]) && at + f.len() < c.len() && rs2nika_word(c[at + f.len()]) {
            same = false
        }
        if same {
            out.push_str(to)
            at = at + f.len()
        } else {
            out.push(c[at])
            at = at + 1
        }
    }
    return out
}

/// A replacement counted under `rule` when it changed anything.
fn rs2nika_rep(mut ctx: Rs2nikaCtx, text: String, from: String, to: String, rule: String) -> String {
    let out = rs2nika_replace_word(text, from, to)
    if out != text {
        rs2nika_hit(ctx, rule)
    }
    return out
}

/// Splits at the commas outside brackets.
fn rs2nika_split_args(text: String) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut cur: String = ""
    let mut depth = 0
    let mut quoted = false
    let mut prev = ' '
    let mut escaped = false
    for ch in text.chars() {
        // `->`, `=>` and a spaced comparison are no brackets; a string's
        // commas are no separators.
        let arrow = prev == '-' || prev == '=' || prev == ' '
        if quoted {
            if escaped {
                escaped = false
            } else if ch == '\\' {
                escaped = true
            } else if ch == '"' {
                quoted = false
            }
        } else if ch == '"' {
            quoted = true
        } else if (ch == '<' && prev != ' ') || ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1
        } else if (ch == '>' && !arrow) || ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1
        }
        prev = ch
        if ch == ',' && depth == 0 && !quoted {
            out.push(cur.trim().clone())
            cur = ""
        } else {
            cur.push(ch)
        }
    }
    if cur.trim() != "" {
        out.push(cur.trim().clone())
    }
    return out
}

fn rs2nika_join(parts: ref Vec[String], sep: String) -> String {
    let mut out: String = ""
    let mut first = true
    for p in parts {
        if !first {
            out.push_str(sep)
        }
        out.push_str(p)
        first = false
    }
    return out
}

/// R5: `'a`, `'a, ` and `'_` dropped from a type.
fn rs2nika_lifetimes(text: String) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        if c[at] == '\'' {
            at = at + 1
            while at < c.len() && rs2nika_word(c[at]) {
                at = at + 1
            }
            while at < c.len() && c[at] == ' ' {
                at = at + 1
            }
            if at < c.len() && c[at] == ',' {
                at = at + 1
            }
            while at < c.len() && c[at] == ' ' {
                at = at + 1
            }
        } else {
            out.push(c[at])
            at = at + 1
        }
    }
    return out
}

fn rs2nika_is_int(t: String) -> bool {
    return t == "usize" || t == "u32" || t == "u16" || t == "isize" || t == "i32"
}

fn rs2nika_strip_paths(mut ctx: Rs2nikaCtx, text: String) -> String {
    let mut t: String = text.clone()
    for p in ["crate::ast::", "ast::", "crate::types::", "ty::"] {
        if t.starts_with(p) {
            rs2nika_hit(ctx, "R28")
            t = (t.strip_prefix(p) ?? "").clone()
        }
    }
    return t
}

/// A Rust type in Nikaia's spelling.
fn rs2nika_ty(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut t: String = given.trim().clone()
    if t.contains("'") {
        let t2: String = rs2nika_lifetimes(t)
        if t2 != t {
            rs2nika_hit(ctx, "R5")
        }
        t = t2.trim().clone()
    }
    // R197: `impl Iterator<Item = T> + use<'a>` -> `Vec[T]`: a tools file
    // hands back lists
    if t.starts_with("impl Iterator<Item") {
        let c: Vec[scalar] = t.chars().collect()
        let open = rs2nika_find_from(c, "<", 0)
        let close = rs2nika_closing(c, open, '<', '>')
        let eq = rs2nika_find_from(c, "=", open)
        if open > 0 && close > eq && eq > open {
            rs2nika_hit(ctx, "R197")
            let item = rs2nika_ty(ctx, rs2nika_text(c, eq + 1, close))
            return f"Vec[{item}]"
        }
    }
    t = t.replace("std::collections::", "")
    if t.starts_with("collections::") {
        t = (t.strip_prefix("collections::") ?? "").clone()
    }
    if t.starts_with("&mut ") {
        return rs2nika_ty(ctx, (t.strip_prefix("&mut ") ?? "").clone())
    }
    if t.starts_with("&") {
        let inner: String = (t.strip_prefix("&") ?? "").trim().clone()
        if inner == "Parsed" && ctx.world != "" {
            rs2nika_hit(ctx, "R52")
            return f"ref {ctx.world}"
        }
        if inner == "Span" {
            rs2nika_hit(ctx, "R50")
            return "Span"
        }
        if inner == "str" || inner == "String" {
            rs2nika_hit(ctx, "R4")
            return "String"
        }
        if inner.starts_with("[") && inner.ends_with("]") {
            rs2nika_hit(ctx, "R4")
            let elem = rs2nika_ty(ctx, ((inner.strip_prefix("[") ?? "").strip_suffix("]") ?? "").clone())
            return f"ref Vec[{elem}]"
        }
        rs2nika_hit(ctx, "R3")
        let rest = rs2nika_ty(ctx, inner)
        // `&Option<String>`: `ref String?` is NK1261 (R130)
        if rest == "String?" {
            return rest
        }
        return f"ref {rest}"
    }
    if rs2nika_is_int(t) {
        rs2nika_hit(ctx, "R10")
        return "i64"
    }
    // a tuple: each of its parts
    if t.starts_with("(") && t.ends_with(")") && t.len() > 2 {
        let parts = rs2nika_split_args(t["(".len()..<t.len() - ")".len()].clone())
        let mut done: Vec[String] = []
        for part in parts {
            done.push(rs2nika_ty(ctx, part.clone()))
        }
        return f"({done.join(", ")})"
    }
    if t == "str" {
        return "String"
    }
    if t == "char" {
        rs2nika_hit(ctx, "R10")
        return "scalar"
    }
    let open = t.find("<") ?? 0
    if open > 0 && t.ends_with(">") && rs2nika_is_path(t[0..<open].trim().clone()) {
        let name: String = t[0..<open].trim().clone()
        let inner: String = t[open + "<".len()..<t.len() - ">".len()].clone()
        let args = rs2nika_split_args(inner)
        let mut base: String = name.clone()
        let colon = name.rfind("::") ?? 0
        if name.contains("::") {
            base = name[colon + "::".len()..].clone()
        }
        if base == "Option" {
            rs2nika_hit(ctx, "R7")
            // `Option<&str>` -> `String?`: `ref String?` is NK1261 (Part I 2.2)
            let a = rs2nika_ty(ctx, args[0].clone())
            return f"{a}?"
        }
        if base == "Box" || base == "Rc" {
            rs2nika_hit(ctx, "R9")
            return rs2nika_ty(ctx, args[0].clone())
        }
        if base == "Cow" {
            rs2nika_hit(ctx, "R4")
            return "String"
        }
        let mut done: Vec[String] = []
        for a in args {
            let flat = a.replace(" ", "")
            if flat == "&str" || flat == "&'astr" {
                done.push(rs2nika_ty(ctx, "String"))
            } else if a != "" {
                done.push(rs2nika_ty(ctx, a))
            }
        }
        let joined = rs2nika_join(done, ", ")
        if base == "HashMap" || base == "BTreeMap" {
            rs2nika_hit(ctx, "R8")
            return f"collections::BTreeMap[{joined}]"
        }
        if base == "HashSet" || base == "BTreeSet" {
            rs2nika_hit(ctx, "R8")
            return f"collections::BTreeSet[{joined}]"
        }
        rs2nika_hit(ctx, "R6")
        if done.len() == 0 {
            return name
        }
        let short = name.replace("crate::ast::", "").replace("ast::", "")
        return f"{short}[{joined}]"
    }
    if t.starts_with("(") && t.ends_with(")") {
        let mut done: Vec[String] = []
        for a in rs2nika_split_args(((t.strip_prefix("(") ?? "").strip_suffix(")") ?? "").clone()) {
            done.push(rs2nika_ty(ctx, a))
        }
        let joined = rs2nika_join(done, ", ")
        return f"({joined})"
    }
    return rs2nika_strip_paths(ctx, t)
}

fn rs2nika_is_path(text: String) -> bool {
    if text == "" {
        return false
    }
    for c in text.chars() {
        if !(rs2nika_word(c) || c == ':') {
            return false
        }
    }
    return true
}

/// The index of the bracket closing the one at `open`, or -1.
fn rs2nika_closing(c: ref Vec[scalar], open: i64, left: scalar, right: scalar) -> i64 {
    let mut depth = 0
    let mut at = open
    while at < c.len() {
        if c[at] == left {
            depth = depth + 1
        } else if c[at] == right && !(right == '>' && at > 0 && c[at - 1] == '-') {
            depth = depth - 1
            if depth == 0 {
                return at
            }
        }
        at = at + 1
    }
    return 0 - 1
}

fn rs2nika_text(c: ref Vec[scalar], from: i64, to: i64) -> String {
    let mut out: String = ""
    let mut at = from
    while at < to {
        out.push(c[at])
        at = at + 1
    }
    return out
}

/// The name of the function a signature line declares, or "".
fn rs2nika_fn_name(line: String) -> String {
    let mut st: String = line.trim().clone()
    if st.starts_with("pub(") {
        let close = st.find(")") ?? 0
        st = st[close + ")".len()..<st.len()].trim().clone()
    } else if st.starts_with("pub ") {
        st = (st.strip_prefix("pub ") ?? "").trim().clone()
    }
    if !st.starts_with("fn ") {
        return ""
    }
    let c: Vec[scalar] = st.chars().collect()
    let mut at = 3
    while at < c.len() && c[at] == ' ' {
        at = at + 1
    }
    let start = at
    while at < c.len() && rs2nika_word(c[at]) {
        at = at + 1
    }
    if at == start || !st.contains("(") {
        return ""
    }
    return rs2nika_text(c, start, at)
}

/// R2, R3, R11, R33, R41: a one-line signature, or "" when the line is not one.
fn rs2nika_signature(mut ctx: Rs2nikaCtx, line: String) -> String {
    let name0 = rs2nika_fn_name(line)
    if name0 == "" {
        return ""
    }
    let c: Vec[scalar] = line.chars().collect()
    let mut at = 0
    while at < c.len() && c[at] == ' ' {
        at = at + 1
    }
    let ind = rs2nika_text(c, 0, at)
    let st: String = line.trim().clone()
    let mut pub_: String = ""
    if st.starts_with("pub ") || st.starts_with("pub(crate)") {
        pub_ = "pub "
    }
    if st.starts_with("pub(") {
        rs2nika_hit(ctx, "R30")
    }
    // past `fn name`
    let fn_at = rs2nika_find_from(c, "fn ", at)
    at = fn_at + 3
    while c[at] == ' ' {
        at = at + 1
    }
    at = at + name0.len()
    let mut gen: String = ""
    if c[at] == '<' {
        let close = rs2nika_closing(c, at, '<', '>')
        let given = rs2nika_split_args(rs2nika_text(c, at + 1, close))
        let mut kept: Vec[String] = []
        for g in given.clone() {
            if !g.starts_with("'") {
                kept.push(g)
            }
        }
        if kept.len() != given.len() {
            rs2nika_hit(ctx, "R5")
        }
        if kept.len() > 0 {
            let joined = rs2nika_join(kept, ", ")
            gen = f"[{joined}]"
        }
        at = close + 1
    }
    if c[at] != '(' {
        return ""
    }
    let close = rs2nika_closing(c, at, '(', ')')
    if close < 0 {
        return ""
    }
    let params = rs2nika_text(c, at + 1, close)
    let rest: String = rs2nika_text(c, close + 1, c.len()).trim().clone()
    let mut out: Vec[String] = []
    let mut has_self = false
    // R190: `fn m(&self) -> T;` in a `trait` declares a method: it keeps
    // `self`, its name and no body
    let decl = rest.ends_with(";")
    if decl {
        rs2nika_hit(ctx, "R190")
    }
    for p in rs2nika_split_args(params) {
        if p == "&self" || p == "&'a self" {
            if ctx.free && !decl && !ctx.impl_other {
                let state_ty = ctx.world.replace("World", "State")
                out.push(f"state: ref {state_ty}")
            } else {
                out.push("ref self")
            }
            has_self = true
            rs2nika_hit(ctx, "R2")
        } else if p == "&mut self" {
            if ctx.free && !decl && !ctx.impl_other {
                let state_ty = ctx.world.replace("World", "State")
                out.push(f"mut state: {state_ty}")
            } else {
                out.push("ref mut self")
            }
            has_self = true
            rs2nika_hit(ctx, "R2")
        } else if p == "self" || p == "mut self" {
            out.push(p.clone())
            has_self = true
        } else if !p.contains(":") {
            out.push(p.clone())
        } else {
            let colon = p.find(":") ?? 0
            let n: String = p[0..<colon].trim().clone()
            let t: String = p[colon + ":".len()..<p.len()].trim().clone()
            if t.starts_with("&mut ") && !t.contains("impl ") {
                rs2nika_hit(ctx, "R3")
                let tt = rs2nika_ty(ctx, (t.strip_prefix("&mut ") ?? "").clone())
                out.push(f"mut {n}: {tt}")
            } else if t.contains("Fn(") || t.contains("FnMut(") {
                out.push(rs2nika_fn_param(ctx, n, t))
            } else {
                let tt = rs2nika_ty(ctx, t)
                out.push(f"{n}: {tt}")
            }
        }
    }
    if has_self && ctx.profile != "none" && !decl && !ctx.impl_other {
        let w = f"world: ref {ctx.world}"
        let mut withw: Vec[String] = []
        let mut i = 0
        for o in out {
            withw.push(o.clone())
            if i == 0 {
                withw.push(w.clone())
                if ctx.free && rs2nika_has(ctx.host_fns, name0) {
                    withw.push("host: ref H")
                }
            }
            i = i + 1
        }
        out = withw
        rs2nika_hit(ctx, "R33")
        if ctx.free && rs2nika_has(ctx.host_fns, name0) {
            // R83: the host the state threads is a generic of the function
            let host_ty = ctx.world.replace("World", "Host")
            if gen == "" {
                gen = f"[H: {host_ty}]"
            } else {
                let opened: String = (gen.strip_suffix("]") ?? "").clone()
                gen = f"{opened}, H: {host_ty}]"
            }
            rs2nika_hit(ctx, "R83")
        }
    }
    let mut ret: String = ""
    let mut throws_: String = ""
    if rest.starts_with("->") {
        let mut r: String = (rest.strip_prefix("->") ?? "").trim().clone()
        if r.ends_with("{") {
            r = r[0..<r.len() - "{".len()].trim().clone()
        }
        if r.ends_with(";") {
            r = r[0..<r.len() - ";".len()].trim().clone()
        }
        let whole = r.len()
        let w = r.find(" where") ?? whole
        r = r[0..<w].trim().clone()
        if r.starts_with("anyhow::") {
            r = (r.strip_prefix("anyhow::") ?? "").clone()
        }
        if r.starts_with("Result<") && r.ends_with(">") {
            let inner = rs2nika_split_args(((r.strip_prefix("Result<") ?? "").strip_suffix(">") ?? "").clone())
            if inner[0] != "()" {
                let tt = rs2nika_ty(ctx, inner[0].clone())
                ret = f" -> {tt}"
            }
            throws_ = " throws"
            rs2nika_hit(ctx, "R11")
        } else {
            let tt = rs2nika_ty(ctx, r)
            ret = f" -> {tt}"
        }
    }
    let mut name: String = name0.clone()
    let pre: String = ctx.prefix.clone()
    if pre != "" && !decl && !ctx.impl_other && !rs2nika_starts(name, pre) {
        rs2nika_hit(ctx, "R41")
        name = f"{ctx.prefix}{name0}"
    }
    ctx.fn_opt = ret.ends_with("?")
    if rest.contains("impl Iterator<") {
        ctx.seq_fns.push(name.clone())
    }
    rs2nika_hit(ctx, "R11")
    let joined = rs2nika_join(out, ", ")
    // R85: a free function that threads no state does not pause, so it does not promise `sync`
    let mut sync_: String = " sync"
    if ctx.free && (!has_self || ctx.impl_other) && !decl {
        sync_ = ""
        rs2nika_hit(ctx, "R85")
    }
    if decl {
        return f"{ind}{pub_}fn {name}{gen}({joined}){ret}{sync_}{throws_}"
    }
    return f"{ind}{pub_}fn {name}{gen}({joined}){ret}{sync_}{throws_} {{"
}

/// `f: impl Fn(A) -> B` -> `f: fn(A) -> B sync`.
fn rs2nika_fn_param(mut ctx: Rs2nikaCtx, n: String, t: String) -> String {
    let open = t.find("(") ?? 0
    let c: Vec[scalar] = t.chars().collect()
    let close = rs2nika_closing(c, rs2nika_char_index(t, open), '(', ')')
    let mut args: Vec[String] = []
    for a in rs2nika_split_args(rs2nika_text(c, rs2nika_char_index(t, open) + 1, close)) {
        args.push(rs2nika_view_ty(ctx, a))
    }
    let joined = rs2nika_join(args, ", ")
    let after: String = rs2nika_text(c, close + 1, c.len()).trim().clone()
    let mut r: String = ""
    if after.starts_with("->") {
        let tt = rs2nika_ty(ctx, (after.strip_prefix("->") ?? "").clone())
        r = f" -> {tt}"
    }
    return f"{n}: fn({joined}){r} sync"
}

/// R130: where `ref String` still says what NK1261 does not cover, `&str`
/// stays `ref String`: a function type's parameter (`fn(String)` takes the
/// text over). `Option<&str>` is `String?` (NK1261 warns on `ref String?`).
fn rs2nika_view_ty(mut ctx: Rs2nikaCtx, given: String) -> String {
    let r = rs2nika_ty(ctx, given)
    if r == "String" && given.trim().starts_with("&") {
        rs2nika_hit(ctx, "R130")
        return "ref String"
    }
    return r
}

/// The scalar index of a byte index.
fn rs2nika_char_index(t: String, byte: i64) -> i64 {
    let head: String = (t.bytes[0..<byte].text() catch { "" }).clone()
    return head.chars().count()
}

fn rs2nika_find_from(c: ref Vec[scalar], what: String, from: i64) -> i64 {
    let w: Vec[scalar] = what.chars().collect()
    let mut at = from
    while at + w.len() <= c.len() {
        let mut same = true
        let mut k = 0
        while same && k < w.len() {
            if c[at + k] != w[k] {
                same = false
            }
            k = k + 1
        }
        if same {
            return at
        }
        at = at + 1
    }
    return 0 - 1
}


/// `starts_with` of an owned `String` (NK1102 refuses it on the method).
fn rs2nika_starts(text: String, pre: String) -> bool {
    return text.starts_with(pre)
}

/// String literals emptied, so that brackets inside them are not counted.
fn rs2nika_blank(text: String) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        if c[at] == '"' {
            out.push_str("\"\"")
            at = at + 1
            while at < c.len() && c[at] != '"' {
                if c[at] == '\\' {
                    at = at + 1
                }
                at = at + 1
            }
            at = at + 1
        } else {
            out.push(c[at])
            at = at + 1
        }
    }
    return out
}

fn rs2nika_count(text: String, what: scalar) -> i64 {
    let mut n = 0
    for c in text.chars() {
        if c == what {
            n = n + 1
        }
    }
    return n
}

fn rs2nika_opens(code: String) -> i64 {
    return rs2nika_count(code, '(') + rs2nika_count(code, '[') - rs2nika_count(code, ')') - rs2nika_count(code, ']')
}

fn rs2nika_first_word(code: String) -> String {
    let mut out: String = ""
    for c in code.chars() {
        if !rs2nika_word(c) {
            return out
        }
        out.push(c)
    }
    return out
}

fn rs2nika_is_keyword(w: String) -> bool {
    for k in ["impl", "struct", "enum", "pub", "trait", "fn", "if", "match", "while", "for", "else", "loop"] {
        if w == k {
            return true
        }
    }
    return false
}

/// A line that ends in a struct literal's `Name {`.
fn rs2nika_struct_open(code: String) -> bool {
    if !code.ends_with(" {") || code.starts_with("} else") {
        return false
    }
    let c: Vec[scalar] = code.chars().collect()
    let end = c.len() - 2
    let mut start = end
    while start > 0 && (rs2nika_word(c[start - 1]) || c[start - 1] == ':') {
        start = start - 1
    }
    if start == end {
        return false
    }
    if start > 0 {
        let b = c[start - 1]
        if !(b == ' ' || b == '\t' || b == '(' || b == ',' || b == '|') {
            return false
        }
    }
    // some segment starts with a capital
    let mut upper = false
    let mut seg_start = true
    let mut at = start
    while at < end {
        if c[at] == ':' {
            seg_start = true
        } else {
            if seg_start && rs2nika_in(c[at], "ABCDEFGHIJKLMNOPQRSTUVWXYZ") {
                upper = true
            }
            seg_start = false
        }
        at = at + 1
    }
    if !upper {
        return false
    }
    let first = rs2nika_first_word(code)
    if !rs2nika_is_keyword(first) {
        return true
    }
    let rest: String = code.clone()
    if rest.starts_with("}") {
        return false
    }
    return (rest.starts_with("if let ") || rest.starts_with("while let ")) && !rest.contains(" = ")
}

fn rs2nika_indent(line: String) -> String {
    let mut out: String = ""
    for c in line.chars() {
        if c != ' ' && c != '\t' {
            return out
        }
        out.push(c)
    }
    return out
}

/// `, )` -> ` )`, then ` )` -> `)`, and `{` followed by space -> `{ `.
fn rs2nika_tidy(text: String) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        if c[at] == ',' {
            let mut k = at + 1
            while k < c.len() && c[k] == ' ' {
                k = k + 1
            }
            if k < c.len() && (c[k] == ')' || c[k] == ']' || c[k] == '}') {
                out.push(' ')
                out.push(c[k])
                at = k + 1
            } else {
                out.push(c[at])
                at = at + 1
            }
        } else if c[at] == '{' && at + 1 < c.len() && c[at + 1] == ' ' {
            out.push_str("{ ")
            at = at + 1
            while at < c.len() && c[at] == ' ' {
                at = at + 1
            }
        } else {
            out.push(c[at])
            at = at + 1
        }
    }
    return out.replace(" )", ")").replace(" ]", "]")
}

/// R37: rustfmt's multi-line calls, patterns and struct literals on one line.
fn rs2nika_join_split(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut lines: Vec[String] = []
    for l in given {
        let n = lines.len()
        if n > 0 && lines[n - 1].ends_with("\\") && lines[n - 1].contains("\"") {
            let prev: String = lines[n - 1].clone()
            let trimmed: String = l.trim_start().clone()
            let kept: String = (prev.strip_suffix("\\") ?? "").clone()
            lines[n - 1] = f"{kept}{trimmed}"
        } else {
            lines.push(l.clone())
        }
    }
    let mut out: Vec[String] = []
    let mut i = 0
    while i < lines.len() {
        let l: String = lines[i].clone()
        let st: String = l.trim().clone()
        if st.starts_with("//") {
            out.push(l)
            i = i + 1
            continue
        }
        let code = rs2nika_blank(st)
        let opens = rs2nika_opens(code)
        let struct_open = rs2nika_struct_open(code)
        if opens > 0 || struct_open {
            let mut buf: String = l.trim_end().clone()
            let mut d = opens
            let mut sd = 0
            if struct_open && opens <= 0 {
                sd = 1
            }
            let mut j = i + 1
            while j < lines.len() && (d > 0 || sd > 0) {
                let n: String = lines[j].trim().clone()
                if n.starts_with("//") {
                    out.push(lines[j].clone())
                    j = j + 1
                    continue
                }
                let cc = rs2nika_blank(n)
                d = d + rs2nika_opens(cc)
                if sd > 0 {
                    for ch in cc.chars() {
                        if sd > 0 {
                            if ch == '{' {
                                sd = sd + 1
                            } else if ch == '}' {
                                sd = sd - 1
                            }
                        }
                    }
                }
                let mut sep: String = " "
                if buf.ends_with("(") || buf.ends_with("[") || buf.ends_with("{") || n.starts_with(")") || n.starts_with("]") || (n.starts_with(".") && !n.starts_with("..")) || n.starts_with("?") {
                    sep = ""
                }
                if buf.ends_with("{") && !n.starts_with("}") {
                    sep = " "
                }
                if n.starts_with("}") && !buf.ends_with(" ") {
                    sep = " "
                }
                buf = f"{buf}{sep}{n}"
                j = j + 1
                if j - i > 40 {
                    break
                }
            }
            out.push(rs2nika_tidy(buf))
            rs2nika_hit(ctx, "R37")
            i = j
            continue
        }
        out.push(l)
        i = i + 1
    }
    return out
}

fn rs2nika_is_jump(text: String) -> bool {
    let t: String = text.trim().clone()
    let mut u: String = t.clone()
    if u.ends_with(";") {
        u = u[0..<u.len() - ";".len()].clone()
    }
    return u.starts_with("return") || u.starts_with("throw ") || u == "continue" || u == "break"
}

fn rs2nika_starts_control(text: String) -> bool {
    let mut t: String = text.trim().clone()
    if t.starts_with("}") {
        t = (t.strip_prefix("}") ?? "").trim().clone()
        if !t.starts_with("else ") {
            return false
        }
        t = (t.strip_prefix("else ") ?? "").trim().clone()
    }
    let w = rs2nika_first_word(t)
    return w == "if" || w == "while" || w == "for" || w == "match"
}

/// R37: method chains, `?`, `&&`/`||`, the value of an `if let P =` and a
/// lone `{` joined to the line before.
fn rs2nika_join_chains(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut lines: Vec[String] = []
    let mut i = 0
    while i < given.len() {
        let l: String = given[i].clone()
        if l.ends_with("else {") && l.trim().starts_with("let ") && i + 2 < given.len() {
            let third: String = given[i + 2].trim().clone()
            if (third == "};" || third == "}") && rs2nika_is_jump(given[i + 1]) {
                let second: String = given[i + 1].trim().clone()
                lines.push(f"{l} {second} }}")
                rs2nika_hit(ctx, "R37")
                i = i + 3
                continue
            }
        }
        lines.push(l)
        i = i + 1
    }
    let mut out: Vec[String] = []
    for l in lines {
        let st: String = l.trim().clone()
        let n = out.len()
        let mut prev: String = ""
        if n > 0 {
            prev = out[n - 1].trim_end().clone()
        }
        let prev_comment = prev.trim_start().starts_with("//")
        let deeper = rs2nika_indent(l).len() > rs2nika_indent(prev).len()
        if n > 0 && ((st.starts_with(".") && !st.starts_with("..")) || st.starts_with("?")) && !prev_comment {
            out[n - 1] = f"{prev}{st}"
            rs2nika_hit(ctx, "R37")
        } else if n > 1 && prev_comment && st.starts_with(".") && !st.starts_with("..") && rs2nika_chain_under_comments(out) {
            // R201: a chain with comments between its links: the comments
            // move above the line the link joins
            let mut notes: Vec[String] = []
            while out[out.len() - 1].trim_start().starts_with("//") {
                notes.insert(0, out.pop() ?? "")
            }
            let code: String = (out.pop() ?? "").trim_end().clone()
            let at = rs2nika_indent(code)
            for note in notes {
                out.push(f"{at}{note.trim()}")
            }
            out.push(f"{code}{st}")
            rs2nika_hit(ctx, "R201")
        } else if n > 0 && !prev_comment && ((st == "{" && (prev.ends_with("=>") || rs2nika_starts_control(prev))) || st.starts_with("&& ") || st.starts_with("|| ") || st.starts_with("| ") || (prev.ends_with(" =") && rs2nika_starts_control(prev) && deeper) || (st.starts_with("if ") && !prev.contains("=>") && !prev.ends_with("{") && !prev.ends_with(";") && !prev.ends_with(",") && prev.trim() != "" && deeper)) {
            out[n - 1] = f"{prev} {st}"
            rs2nika_hit(ctx, "R37")
        } else {
            out.push(l.clone())
        }
    }
    return rs2nika_join_let_else(ctx, out)
}

/// R202: a `match` arm `x @ P => ..` (Nikaia has no `@`): over the subject
/// itself (`match x { x @ (A | B) => .. }`) -> `A | B => ..`; over another
/// plain name `s`, an arm opening a block -> `P => {` + `let x = s`.
fn rs2nika_at_bindings(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut subjects: Vec[String] = []
    let mut indents: Vec[String] = []
    for line in given {
        let st: String = line.trim().clone()
        let ind = rs2nika_indent(line)
        while indents.len() > 0 && ind.len() <= indents[indents.len() - 1].len() && st != "" && !st.starts_with("//") && !(ind.len() == indents[indents.len() - 1].len() && st.starts_with("}")) {
            indents.pop()
            subjects.pop()
        }
        if st.starts_with("match ") && st.ends_with(" {") {
            subjects.push(st["match ".len()..<st.len() - " {".len()].trim().clone())
            indents.push(ind.clone())
            out.push(line.clone())
            continue
        }
        // `(x @ P) [if g] => ..`, as R24 writes a `Some(x @ P)`: the brackets go
        let mut arm: String = st.clone()
        if st.starts_with("(") {
            let sc: Vec[scalar] = st.chars().collect()
            let end = rs2nika_group_end(sc, 1)
            if end > 1 && end <= sc.len() && !rs2nika_text(sc, 1, end - 1).contains(",") {
                arm = f"{rs2nika_text(sc, 1, end - 1)}{rs2nika_text(sc, end, sc.len())}"
            }
        }
        let (named, written) = arm.split_once(" @ ") ?? ("", "")
        let name: String = named.clone()
        let mut rest: String = written.clone()
        if name == "" || subjects.len() == 0 || !rs2nika_is_path(name) || name.contains(".") || name.contains(":") || !rest.contains(" => ") {
            out.push(line.clone())
            continue
        }
        // `(A | B) => ..` -> `A | B => ..`
        if rest.starts_with("(") {
            let (pat, arm) = rest.split_once(" => ") ?? ("", "")
            let pc: Vec[scalar] = pat.chars().collect()
            if pat.ends_with(")") && rs2nika_group_end(pc, 1) == pc.len() {
                rest = f"{pat["(".len()..<pat.len() - ")".len()]} => {arm}"
            }
        }
        let subject: String = subjects[subjects.len() - 1].clone()
        if subject == name {
            out.push(f"{ind}{rest}")
            rs2nika_hit(ctx, "R202")
            continue
        }
        if rs2nika_is_path(subject) && !subject.contains(".") && !subject.contains("(") && rest.ends_with(" => {") {
            out.push(f"{ind}{rest}")
            out.push(f"{ind}    let {name} = {subject}")
            rs2nika_hit(ctx, "R202")
            continue
        }
        out.push(line.clone())
    }
    return out
}

/// R201: the lines end in comments that follow a line of code a chain's
/// link can join (not a block's opening, not a statement's end).
fn rs2nika_chain_under_comments(out: ref Vec[String]) -> bool {
    let mut k = out.len()
    while k > 0 && out[k - 1].trim_start().starts_with("//") {
        k = k - 1
    }
    if k == 0 {
        return false
    }
    let code: String = out[k - 1].trim_end().clone()
    return code.trim() != "" && !code.ends_with("{") && !code.ends_with(";") && !code.ends_with(",") && !code.ends_with("}")
}

/// rustfmt's `let P = v` / `else {` / jump / `};` as one line, after the
/// chain of `v` is joined.
fn rs2nika_join_let_else(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut lines: Vec[String] = []
    let mut i = 0
    while i < given.len() {
        let l: String = given[i].clone()
        if l.trim().starts_with("let ") && i + 3 < given.len() && given[i + 1].trim() == "else {" {
            let fourth: String = given[i + 3].trim().clone()
            if (fourth == "};" || fourth == "}") && rs2nika_is_jump(given[i + 2]) {
                let jump: String = given[i + 2].trim().clone()
                lines.push(f"{l.trim_end()} else {{ {jump} }}")
                rs2nika_hit(ctx, "R37")
                i = i + 4
                continue
            }
        }
        lines.push(l)
        i = i + 1
    }
    return lines
}

/// R42: a function's last expression becomes `return expr`.
fn rs2nika_tail_returns(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = given.clone()
    let mut i = 0
    while i < out.len() {
        let head: String = out[i].trim().clone()
        let is_fn = (head.starts_with("fn ") || head.starts_with("pub fn ")) && head.contains("->") && head.ends_with("{")
        if !is_fn {
            i = i + 1
            continue
        }
        let ind = rs2nika_indent(out[i])
        let close = f"{ind}}}"
        let mut j = i + 1
        while j < out.len() && out[j].trim_end() != close {
            j = j + 1
        }
        let body = f"{ind}    "
        let deeper = f"{body} "
        let mut k = j - 1
        while k > i && (out[k].trim() == "" || out[k].trim().starts_with("//")) {
            k = k - 1
        }
        let mut start = k
        while start > i && !rs2nika_at_body(out[start], body, deeper) {
            start = start - 1
        }
        if start > i && out[start].contains("\n") {
            // a rule's several lines (R113's tail `folded`): the last one
            let parts: Vec[String] = out[start].split("\n").collect()
            let last: String = parts[parts.len() - 1].clone()
            if rs2nika_at_body(last, body, deeper) && !rs2nika_no_return(last.trim()) {
                let mut lines: Vec[String] = []
                let mut p = 0
                while p + 1 < parts.len() {
                    lines.push(parts[p].clone())
                    p = p + 1
                }
                lines.push(f"{body}return {last.trim()}")
                out[start] = rs2nika_join(lines, "\n")
                rs2nika_hit(ctx, "R42")
            }
        } else if start > i {
            let st: String = out[start].trim().clone()
            if st.starts_with("match ") || !rs2nika_no_return(st) {
                out[start] = f"{body}return {st}"
                rs2nika_hit(ctx, "R42")
            }
        }
        i = j + 1
    }
    return out
}

fn rs2nika_at_body(l: String, body: String, deeper: String) -> bool {
    let st: String = l.trim().clone()
    return l.starts_with(body) && !l.starts_with(deeper) && !st.starts_with("}") && !st.starts_with("//")
}

/// The statements that are not a value: `return`, `let`, loops, an assignment.
fn rs2nika_no_return(st: String) -> bool {
    let w = rs2nika_first_word(st)
    if w == "return" || w == "throw" || w == "let" || w == "for" || w == "while" || w == "if" || w == "else" {
        return true
    }
    if st.starts_with("//") || st.starts_with("}") {
        return true
    }
    // a panic leaves by itself (R171)
    if st.starts_with("panic(") || st.starts_with("panic!(") || st.starts_with("unreachable!(") {
        return true
    }
    // `a.b = ..`, `a += ..`
    let c: Vec[scalar] = st.chars().collect()
    let mut at = 0
    while at < c.len() && (rs2nika_word(c[at]) || c[at] == '.') {
        at = at + 1
    }
    if at == 0 {
        return false
    }
    while at < c.len() && c[at] == ' ' {
        at = at + 1
    }
    if at < c.len() && (c[at] == '+' || c[at] == '-') {
        at = at + 1
    }
    if at + 1 < c.len() && c[at] == '=' && c[at + 1] != '=' && c[at + 1] != '>' {
        return true
    }
    return false
}

/// R160: whether a body's last line leaves: `return`, `throw`, `break`,
/// `continue`, or a macro that does (`bail!`, `panic!`, `unreachable!`).
fn rs2nika_leaves(last: String) -> bool {
    let st: String = last.trim().trim_end_matches(",").clone()
    let w = rs2nika_first_word(st)
    if w == "return" || w == "throw" || w == "break" || w == "continue" {
        return true
    }
    return st.starts_with("bail!(") || st.starts_with("panic!(") || st.starts_with("panic(") || st.starts_with("unreachable!(") || st.starts_with("process::exit(") || st.starts_with("std::process::exit(")
}

/// `l` with `drop` leading spaces taken off (as many as it has) and `add` put
/// before it; a blank line stays blank.
fn rs2nika_moved(l: String, drop: i64, add: String) -> String {
    if l.trim() == "" {
        return ""
    }
    let c: Vec[scalar] = l.chars().collect()
    let mut at = 0
    while at < drop && at < c.len() && c[at] == ' ' {
        at = at + 1
    }
    return f"{add}{rs2nika_text(c, at, c.len())}"
}

/// R160: `return` put before a body's last line where it is a value.
fn rs2nika_returned(mut lines: Vec[String]) {
    let mut k = lines.len() - 1
    while k >= 0 && lines[k].trim() == "" {
        k = k - 1
    }
    if k < 0 {
        return
    }
    let st: String = lines[k].trim().clone()
    if rs2nika_leaves(st) || rs2nika_no_return(st) {
        return
    }
    let ind = rs2nika_indent(lines[k])
    lines[k] = f"{ind}return {st}"
}

/// R160: a `match` on a call's `Result` (Part I 7.1: a failure is caught,
/// never held). `let x = match call { Ok(v) => v, Err(e) => d }` -> `let x =
/// call catch { d }`, `e` read as `let e = error` where `d` names it (also
/// `return match` and a statement); where the `Ok` arm is more than its
/// value, the `Err` arm is the `catch` block when it leaves (a jump, or a
/// `return` of a function's last `match`), and the `Ok` arm's body follows:
/// `let v = call catch { jump }`, then the body. `Err(Variant)` arms ->
/// `match error { Variant => .., else => .. }`. One it cannot take keeps a
/// TODO: a guard, a kept `Result` (no call), an `Err` arm that is a value
/// beside an `Ok` arm that is more than its own, or one whose value is
/// `null` (a `catch` hands back the guarded type, NK1103).
fn rs2nika_result_matches(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    for g in given {
        for l in g.split("\n") {
            out.push(l.clone())
        }
    }
    let mut i = 0
    while i < out.len() {
        let line: String = out[i].clone()
        let st: String = line.trim().clone()
        let c: Vec[scalar] = line.chars().collect()
        let at = rs2nika_find_from(c, "match ", 0)
        if at < 0 || !st.ends_with(" {") || st.starts_with("//") || (at > 0 && rs2nika_word(c[at - 1])) {
            i = i + 1
            continue
        }
        let ind = rs2nika_indent(line)
        let arm = f"{ind}    "
        let mut j = i + 1
        while j < out.len() && !(rs2nika_indent(out[j]) == ind && out[j].trim().starts_with("}")) {
            j = j + 1
        }
        if j >= out.len() {
            i = i + 1
            continue
        }
        let mut starts: Vec[i64] = []
        let mut result = false
        let mut k = i + 1
        while k < j {
            let t: String = out[k].trim().clone()
            if rs2nika_indent(out[k]) == arm && t != "" && !t.starts_with("}") {
                starts.push(k)
                if t.starts_with("Ok(") || t.starts_with("Err(") {
                    result = true
                }
            }
            k = k + 1
        }
        if !result {
            i = i + 1
            continue
        }
        let new = rs2nika_result_match(out, i, j, starts)
        let mut rebuilt: Vec[String] = []
        let mut r = 0
        while r < i {
            rebuilt.push(out[r].clone())
            r = r + 1
        }
        if new.len() == 1 && new[0].starts_with("// TODO") {
            rebuilt.push(f"{ind}{new[0]}")
            r = i
            while r <= j {
                rebuilt.push(out[r].clone())
                r = r + 1
            }
            i = j + 2
        } else {
            for n in new {
                rebuilt.push(n.clone())
            }
            i = i + new.len()
            r = j + 1
            rs2nika_hit(ctx, "R160")
        }
        while r < out.len() {
            rebuilt.push(out[r].clone())
            r = r + 1
        }
        out = rebuilt
    }
    return out
}

/// R160 for the `match` from line `i` to its `}` at `j`, arms at `starts`:
/// the lines that replace it, or none where it does not fit.
fn rs2nika_result_match(out: ref Vec[String], i: i64, j: i64, starts: ref Vec[i64]) -> Vec[String] {
    let line: String = out[i].clone()
    let c: Vec[scalar] = line.chars().collect()
    let ind = rs2nika_indent(line)
    let arm = f"{ind}    "
    let at = rs2nika_find_from(c, "match ", 0)
    let pre: String = rs2nika_text(c, ind.chars().count(), at)
    let subject: String = rs2nika_text(c, at + 6, c.len() - 2).trim().clone()
    let bound = pre.starts_with("let ") && pre.ends_with("= ")
    if subject.contains("binary_search") {
        return rs2nika_r160_todo("place")
    }
    if !subject.ends_with(")") {
        return rs2nika_r160_todo("kept")
    }
    if out[j].trim() != "}" || subject.contains(" catch ") || (pre != "" && pre != "return " && !bound) {
        return rs2nika_r160_todo("")
    }
    let mut ok_seen = false
    let mut ok_name: String = ""
    let mut ok_lines: Vec[String] = []
    let mut ok_block = false
    // the `catch` block: one `Err(e)`'s body, or `match error { .. }`
    let mut handler: Vec[String] = []
    let mut variants: Vec[String] = []
    let mut leaves = true
    let mut n = 0
    while n < starts.len() {
        let s = starts[n]
        let mut end = j
        if n + 1 < starts.len() {
            end = starts[n + 1]
        }
        let t: String = out[s].trim().clone()
        let tc: Vec[scalar] = t.chars().collect()
        let ok = t.starts_with("Ok(")
        let other = t.starts_with("else =>")
        if !ok && !other && !t.starts_with("Err(") {
            return rs2nika_r160_todo("")
        }
        let mut inner: String = "_"
        let mut after: String = t.trim_start_matches("else").trim().clone()
        if !other {
            let mut open = 2
            if !ok {
                open = 3
            }
            let close = rs2nika_closing(tc, open, '(', ')')
            if close < 0 {
                return rs2nika_r160_todo("")
            }
            inner = rs2nika_text(tc, open + 1, close).trim().clone()
            after = rs2nika_text(tc, close + 1, tc.len()).trim().clone()
        }
        if after.starts_with("if ") {
            return rs2nika_r160_todo("guard")
        }
        if !after.starts_with("=> ") {
            return rs2nika_r160_todo("")
        }
        let ac: Vec[scalar] = after.chars().collect()
        let rest: String = rs2nika_text(ac, 3, ac.len()).trim().clone()
        let mut body: Vec[String] = []
        let block = rest == "{"
        if block {
            let mut r = s + 1
            while r < end && !(rs2nika_indent(out[r]) == arm && out[r].trim().starts_with("}")) {
                body.push(out[r].clone())
                r = r + 1
            }
            if r >= end || (out[r].trim() != "}" && out[r].trim() != "},") {
                return rs2nika_r160_todo("")
            }
            r = r + 1
            while r < end {
                if out[r].trim() != "" {
                    return rs2nika_r160_todo("")
                }
                r = r + 1
            }
        } else {
            let mut r = s + 1
            while r < end {
                if out[r].trim() != "" {
                    return rs2nika_r160_todo("")
                }
                r = r + 1
            }
            body.push(rest.trim_end_matches(",").trim().clone())
        }
        if body.len() == 0 {
            body.push("")
        }
        let last: String = body[body.len() - 1].trim().clone()
        if ok {
            if ok_seen {
                return rs2nika_r160_todo("")
            }
            ok_seen = true
            if inner != "_" && inner != "()" {
                let name: String = inner.trim_start_matches("mut ").clone()
                if !rs2nika_is_path(name) || name.contains(":") {
                    return rs2nika_r160_todo("")
                }
                ok_name = inner.clone()
            }
            ok_lines = body
            ok_block = block
        } else {
            if !rs2nika_leaves(last) {
                leaves = false
            }
            let ic: Vec[scalar] = inner.chars().collect()
            if ic.len() == 0 {
                return rs2nika_r160_todo("")
            }
            let catch_all = inner == "_" || (rs2nika_is_path(inner) && !inner.contains(":") && !rs2nika_upper(ic[0]))
            if catch_all && n + 1 < starts.len() && !(n + 2 == starts.len() && out[starts[n + 1]].trim().starts_with("Ok(")) {
                return rs2nika_r160_todo("")
            }
            let mut named: Vec[String] = []
            let mut used = false
            for b in body {
                if rs2nika_replace_word(b, inner, "\u{a7}") != b {
                    used = true
                }
            }
            if catch_all && inner != "_" && inner != "error" && used {
                named.push(f"let {inner} = error")
            }
            if catch_all && variants.len() == 0 {
                // the one `Err(e)`: its body is the block
                for nm in named {
                    handler.push(f"{ind}    {nm}")
                }
                if block {
                    for b in body {
                        handler.push(rs2nika_moved(b, 4, ""))
                    }
                } else {
                    handler.push(f"{ind}    {body[0]}")
                }
            } else {
                let mut pat: String = inner.clone()
                if catch_all {
                    pat = "else"
                }
                if block {
                    variants.push(f"{ind}        {pat} => {{")
                    for nm in named {
                        variants.push(f"{ind}            {nm}")
                    }
                    for b in body {
                        variants.push(rs2nika_moved(b, 0, "    "))
                    }
                    variants.push(f"{ind}        }}")
                } else if named.len() > 0 {
                    variants.push(f"{ind}        {pat} => {{ {named[0]}; {body[0]} }}")
                } else {
                    variants.push(f"{ind}        {pat} => {body[0]}")
                }
                if catch_all {
                    handler.push(f"{ind}    match error {{")
                    for v in variants {
                        handler.push(v.clone())
                    }
                    handler.push(f"{ind}    }}")
                }
            }
        }
        n = n + 1
    }
    if !ok_seen || handler.len() == 0 {
        return rs2nika_r160_todo("")
    }
    let identity = ok_name != "" && !ok_block && ok_lines.len() == 1 && ok_lines[0] == ok_name
    if identity && pre == "" {
        return rs2nika_r160_todo("")
    }
    let mut head: String = f"{ind}{pre}{subject}"
    let mut tail: Vec[String] = []
    if !identity {
        if !leaves && pre != "return " {
            return rs2nika_success_only(ind, pre, subject, ok_name, ok_lines, ok_block, handler, variants.len())
        }
        if bound && ok_block {
            return rs2nika_r160_todo("")
        }
        if pre == "return " && !leaves {
            if variants.len() > 0 {
                // each arm's value: hand it back in place
                return rs2nika_r160_todo("")
            }
            rs2nika_returned(handler)
        }
        head = f"{ind}{subject}"
        if ok_name != "" {
            head = f"{ind}let {ok_name} = {subject}"
        }
        if ok_block {
            for b in ok_lines {
                tail.push(rs2nika_moved(b, 8, ""))
            }
            if pre == "return " {
                rs2nika_returned(tail)
            }
        } else if ok_lines[0] != "{}" && ok_lines[0] != "()" && ok_lines[0] != "" {
            tail.push(f"{ind}{pre}{ok_lines[0]}")
        } else if pre != "" {
            return rs2nika_r160_todo("")
        }
    }
    let mut new: Vec[String] = []
    if handler.len() == 1 || (handler.len() == 2 && variants.len() == 0 && handler[0].trim().starts_with("let ") && handler[0].trim().ends_with(" = error")) {
        let mut parts: Vec[String] = []
        for h in handler {
            parts.push(h.trim().clone())
        }
        new.push(f"{head} catch {{ {rs2nika_join(parts, "; ")} }}")
    } else {
        new.push(f"{head} catch {{")
        for h in handler {
            new.push(h.clone())
        }
        new.push(f"{ind}}}")
    }
    for t in tail {
        new.push(t.clone())
    }
    return new
}

/// R161: the name of the last call `x` ends in (`writeln!` for a macro), or
/// "" where it does not end in `)`.
fn rs2nika_last_call(x: String) -> String {
    let c: Vec[scalar] = x.chars().collect()
    if c.len() == 0 || c[c.len() - 1] != ')' {
        return ""
    }
    let mut depth = 0
    let mut at = c.len() - 1
    while at >= 0 {
        if c[at] == ')' {
            depth = depth + 1
        } else if c[at] == '(' {
            depth = depth - 1
            if depth == 0 {
                break
            }
        }
        at = at - 1
    }
    let mut start = at
    while start > 0 && (rs2nika_word(c[start - 1]) || c[start - 1] == '!') {
        start = start - 1
    }
    let name = rs2nika_text(c, start, at)
    if name == "write" && start >= 4 && rs2nika_text(c, start - 4, start) == "fs::" {
        return "fs::write"
    }
    return name
}

/// R161: whether `x`'s last call hands back nothing where it does not fail
/// (`Result<()>` in Rust): `flush`, `write_all`, `writeln!`, `write!`, the
/// `fs` calls that make, move or remove.
fn rs2nika_unit_call(x: String) -> bool {
    let name = rs2nika_last_call(x)
    for unit in ["flush", "write_all", "writeln!", "write!", "create_dir_all", "create_dir", "remove_file", "remove_dir", "remove_dir_all", "rename", "hard_link", "set_permissions", "fs::write"] {
        if name == unit {
            return true
        }
    }
    return false
}

/// R161: the enclosing function's line above `i` hands back an option.
fn rs2nika_in_opt_fn(out: ref Vec[String], i: i64) -> bool {
    let ind = rs2nika_indent(out[i]).chars().count()
    let mut k = i - 1
    while k >= 0 {
        let t: String = out[k].trim().clone()
        if (t.starts_with("fn ") || t.starts_with("pub fn ")) && rs2nika_indent(out[k]).chars().count() < ind {
            return t.contains("? sync")
        }
        k = k - 1
    }
    return false
}

/// R161: each `Result` read as a value over a call in Nikaia's form (Part I
/// 7.1, #884): `x.ok()` -> `x catch { null }`, `x.is_ok()` / `x.is_err()` ->
/// `(x catch { null }) != null` / `== null` (a `!` before it turns the
/// test), `x.is_ok_and(fn(v) { b })` -> `(match x catch { null } { v => b,
/// null => false })`. The `catch` in parentheses unless it is the whole
/// value of a `let`, a `return`, a statement or a `match` head. A read over
/// a name stays (the `Result` is kept, R160's "kept").
fn rs2nika_result_nulls(line: String) -> String {
    let mut s: String = line.clone()
    for read in [".is_ok_and(", ".is_ok()", ".is_err()", ".ok()"] {
        let n = read.chars().count()
        let mut from = 0
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let at = rs2nika_find_from(c, read, from)
            if at < 0 {
                break
            }
            from = at + 1
            let after = rs2nika_text(c, at + n, c.len())
            if read == ".ok()" && (after.starts_with("?") || after.starts_with(".unwrap_or")) {
                continue
            }
            if read != ".is_ok_and(" && rs2nika_parsed_before(c, at) {
                continue
            }
            if read != ".ok()" && read != ".is_ok_and(" && at >= 5 && rs2nika_text(c, at - 5, at) == ".ok()" && rs2nika_parsed_before(c, at - 5) {
                continue
            }
            let start = rs2nika_recv_start(c, at)
            let recv: String = rs2nika_text(c, start, at)
            let rc: Vec[scalar] = recv.chars().collect()
            if !recv.ends_with(")") || rc.len() == 0 || !rs2nika_word(rc[0]) {
                continue
            }
            let mut prefix: String = rs2nika_text(c, 0, start)
            let mut suffix: String = after.clone()
            let mut put: String = ""
            if read == ".ok()" {
                put = f"{recv} catch {{ null }}"
                let head: String = prefix.trim().clone()
                let whole = suffix.trim() == "" && (head == "" || head == "return" || (prefix.ends_with(" = ") && head.starts_with("let ")))
                if !whole && !(prefix.ends_with("match ") && suffix.starts_with(" {")) && !(prefix.ends_with("{ ") && suffix.starts_with(" }")) {
                    put = f"({put})"
                }
            } else if read == ".is_ok_and(" {
                let close = rs2nika_closing(c, at + n - 1, '(', ')')
                if close < 0 {
                    continue
                }
                let arg: String = rs2nika_text(c, at + n, close).trim().clone()
                let ac: Vec[scalar] = arg.chars().collect()
                if !arg.starts_with("fn(") || !arg.ends_with("}") {
                    continue
                }
                let shut = rs2nika_closing(ac, 2, '(', ')')
                if shut < 0 {
                    continue
                }
                let param: String = rs2nika_text(ac, 3, shut).trim().clone()
                let rest: String = rs2nika_text(ac, shut + 1, ac.len()).trim().clone()
                if !rs2nika_is_path(param) || param.contains(":") || !rest.starts_with("{") {
                    continue
                }
                let inside: String = rest.bytes[1..<rest.len() - 1].text() catch { continue }
                put = f"(match {recv} catch {{ null }} {{ {param} => {inside.trim()}, null => false }})"
                suffix = rs2nika_text(c, close + 1, c.len())
            } else {
                let mut ok = read == ".is_ok()"
                if prefix.ends_with("!") && !prefix.ends_with("!=") {
                    prefix = prefix.bytes[0..<prefix.len() - 1].text() catch { continue }
                    ok = !ok
                }
                let mut op: String = "=="
                if ok {
                    op = "!="
                }
                put = f"({recv} catch {{ null }}) {op} null"
                let next: String = suffix.trim_start().clone()
                if next.starts_with(".") || next.starts_with("==") || next.starts_with("!=") || prefix.trim_end().ends_with("==") || prefix.trim_end().ends_with("!=") {
                    put = f"({put})"
                }
            }
            s = f"{prefix}{put}{suffix}"
            from = prefix.chars().count() + put.chars().count()
        }
    }
    return s
}

/// R161: a `Result` read as a value where Nikaia has its form (Part I 7.1),
/// after R42 wrote the `return`s: `return x.ok()` in a `T?` function ->
/// `return x catch { return null }`; a statement `x.ok()` over a call that
/// hands back nothing (`flush()`, `writeln!`, `fs::create_dir_all` ..) ->
/// `x catch {}`; `if x.is_err() {` / `if !x.is_ok() {` whose body leaves (or,
/// over such a call, ends in a statement) -> `x catch {`. The line's TODO
/// goes where nothing else on it reads a `Result`.
fn rs2nika_result_reads(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = given.clone()
    let mut i = 0
    while i < out.len() {
        let line: String = out[i].clone()
        let st: String = line.trim().clone()
        let ind = rs2nika_indent(line)
        let mut new: String = ""
        if st.starts_with("return ") && st.ends_with(".ok()") {
            let x: String = st.bytes["return ".len()..<st.len() - ".ok()".len()].text() catch { "" }
            if x.ends_with(")") && !rs2nika_result_read(x) && rs2nika_in_opt_fn(out, i) {
                new = f"{ind}return {x} catch {{ return null }}"
            }
        } else if st.ends_with(".ok()") && !st.contains(" = ") && !st.starts_with("let ") {
            let x: String = st.bytes[0..<st.len() - ".ok()".len()].text() catch { "" }
            if !rs2nika_result_read(x) && rs2nika_unit_call(x) {
                new = f"{ind}{x} catch {{}}"
            }
        } else if st.starts_with("if ") && (st.ends_with(".is_err() {") || (st.starts_with("if !") && st.ends_with(".is_ok() {"))) {
            let mut x: String = st.bytes["if ".len()..<st.len() - ".is_err() {".len()].text() catch { "" }
            if st.ends_with(".is_ok() {") {
                x = st.bytes["if !".len()..<st.len() - ".is_ok() {".len()].text() catch { "" }
            }
            let mut j = i + 1
            while j < out.len() && !(rs2nika_indent(out[j]) == ind && out[j].trim().starts_with("}")) {
                j = j + 1
            }
            let mut k = j - 1
            while k > i && (out[k].trim() == "" || out[k].trim().starts_with("//")) {
                k = k - 1
            }
            let plain = x.ends_with(")") && !x.contains("&&") && !x.contains("||") && !rs2nika_result_read(x)
            if plain && j < out.len() && out[j].trim() == "}" && k > i {
                let last: String = out[k].trim().clone()
                if rs2nika_leaves(last) || (rs2nika_unit_call(x) && rs2nika_no_return(last)) {
                    new = f"{ind}{x} catch {{"
                }
            }
        }
        if new == "" && !st.starts_with("//") && rs2nika_result_read(line) {
            let valued = rs2nika_result_nulls(line)
            if valued != line {
                new = valued
            }
        }
        if new == "" {
            i = i + 1
            continue
        }
        out[i] = new
        rs2nika_hit(ctx, "R161")
        // the TODO above it, among the line's TODOs, where no read is left
        let mut k = i - 1
        while k >= 0 && !rs2nika_result_read(out[i]) && out[k].trim().starts_with("// TODO(rs2nika):") {
            if out[k].contains("a `Result` read as a value") {
                let mut rebuilt: Vec[String] = []
                let mut r = 0
                while r < out.len() {
                    if r != k {
                        rebuilt.push(out[r].clone())
                    }
                    r = r + 1
                }
                out = rebuilt
                i = i - 1
                break
            }
            k = k - 1
        }
        i = i + 1
    }
    return out
}

/// R160 where the `Ok` arm runs on success only and the program goes on
/// after a failure (#884): the failure made `null` (Part I 7.1), `match call
/// catch { null } { v => <the Ok arm>, null => <the Err arm> }`, or `if (call
/// catch { null }) != null { .. }` where the `Ok` arm binds nothing and the
/// `Err` arm does nothing. One whose `Ok` arm binds a `mut` name (an arm binds
/// none) or whose `Err` arms are more than one value keeps the TODO.
fn rs2nika_success_only(ind: String, pre: String, subject: String, ok_name: String, ok_lines: ref Vec[String], ok_block: bool, handler: ref Vec[String], variants: i64) -> Vec[String] {
    if variants > 0 || handler.len() != 1 || ok_name.starts_with("mut ") || ok_lines.len() == 0 {
        return rs2nika_r160_todo("on")
    }
    let d: String = handler[0].trim().clone()
    let nothing = d == "{}" || d == "()" || d == ""
    let first: String = ok_lines[0].trim().clone()
    if !ok_block && (first == "{}" || first == "()" || first == "") {
        return rs2nika_r160_todo("")
    }
    let mut new: Vec[String] = []
    if pre == "" && nothing && ok_name == "" {
        new.push(f"{ind}if ({subject} catch {{ null }}) != null {{")
        if ok_block {
            for b in ok_lines {
                new.push(rs2nika_moved(b, 4, ""))
            }
        } else {
            new.push(f"{ind}    {first}")
        }
        new.push(f"{ind}}}")
        return new
    }
    if ok_name == "" || (pre != "" && (nothing || ok_block)) {
        return rs2nika_r160_todo("on")
    }
    let mut none: String = d.clone()
    if nothing {
        none = "{}"
    }
    new.push(f"{ind}{pre}match {subject} catch {{ null }} {{")
    if ok_block {
        new.push(f"{ind}    {ok_name} => {{")
        for b in ok_lines {
            new.push(b.clone())
        }
        new.push(f"{ind}    }},")
    } else {
        new.push(f"{ind}    {ok_name} => {first},")
    }
    new.push(f"{ind}    null => {none},")
    new.push(f"{ind}}}")
    return new
}

/// R160's TODO where it does not take a `match` on `Ok`/`Err`, by the reason.
fn rs2nika_r160_todo(why: String) -> Vec[String] {
    let mut text: String = "not R160's shape (one `Ok(v)` arm, `Err` arms a variant or a name, `_` last, each one line or a block): Nikaia catches a failure, `let v = call catch { <the Err arm> }`, the `Ok` arm after it"
    if why == "kept" {
        text = "over a kept `Result` (not a call): Nikaia holds no `Result`; match where the call is made, `let v = call catch { <the Err arm> }`"
    } else if why == "place" {
        text = "`binary_search`: its `Err` is the place to insert at, not a failure; Nikaia's `xs.binary_search(x)` (Part I) and a test of what it hands back"
    } else if why == "guard" {
        text = "a guard on an `Ok`/`Err` arm: `let v = call catch { <the Err arms> }`, a guard of `Err` as an `if` inside the block, one of `Ok` as an `if` after it"
    } else if why == "on" {
        text = "the `Ok` arm runs on success only, but binds a `mut` name (an arm binds none) or the `Err` arms are more than one value: the failure made `null` (Part I 7.1), `match call catch { null } { v => { let mut x = v; .. }, null => <the Err arm> }`"
    }
    return [f"// TODO(rs2nika): `match` on `Ok`/`Err`: {text}"]
}

/// The end of the bracket group opened just before `from` (the index past it).
fn rs2nika_group_end(c: ref Vec[scalar], from: i64) -> i64 {
    let mut d = 1
    let mut j = from
    while j < c.len() && d > 0 {
        if c[j] == '(' || c[j] == '[' || c[j] == '{' {
            d = d + 1
        } else if c[j] == ')' || c[j] == ']' || c[j] == '}' {
            d = d - 1
        }
        j = j + 1
    }
    return j
}

/// R14: `matches!(e, P)` -> `(match e { P => true, else => false })`.
fn rs2nika_matches(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    while s.contains("matches!(") {
        let c: Vec[scalar] = s.chars().collect()
        let i = rs2nika_find_from(c, "matches!(", 0)
        let j = rs2nika_group_end(c, i + 9)
        let parts = rs2nika_split_args(rs2nika_text(c, i + 9, j - 1))
        if parts.len() < 2 {
            return s
        }
        let e: String = parts[0].clone()
        let mut ps: Vec[String] = []
        let mut k = 1
        while k < parts.len() {
            ps.push(parts[k].clone())
            k = k + 1
        }
        let p = rs2nika_join(ps, ", ")
        let before = rs2nika_text(c, 0, i)
        let after = rs2nika_text(c, j, c.len())
        s = f"{before}(match {e} {{ {p} => true, else => false }}){after}"
        rs2nika_hit(ctx, "R14")
    }
    return s
}

/// R171: `panic!("..", a)` / `unreachable!("..", a)` -> `panic(f"..")` (the
/// text by R15), `panic!("..")` -> `panic("..")`, `unreachable!()` ->
/// `panic("unreachable")`.
fn rs2nika_panic(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    for mac in ["panic!(", "unreachable!("] {
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let mut i = rs2nika_find_from(c, mac, 0)
            while i > 0 && rs2nika_word(c[i - 1]) {
                i = rs2nika_find_from(c, mac, i + 1)
            }
            if i < 0 {
                break
            }
            let open = i + mac.chars().count()
            let j = rs2nika_group_end(c, open)
            let inner: String = rs2nika_text(c, open, j - 1).trim().clone()
            let mut said: String = "\"unreachable\""
            if inner != "" {
                said = inner.clone()
                if inner.contains("{") || !inner.ends_with("\"") {
                    said = f"format!({inner})"
                }
            }
            let before = rs2nika_text(c, 0, i)
            let after = rs2nika_text(c, j, c.len())
            s = f"{before}panic({said}){after}"
            rs2nika_hit(ctx, "R171")
        }
    }
    return s
}

/// R15: `format!("..{}..", a)` -> `f"..{a}.."`.
fn rs2nika_format(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    while true {
        let c: Vec[scalar] = s.chars().collect()
        let i = rs2nika_find_from(c, "format!(", 0)
        if i < 0 {
            return s
        }
        let mut start = i
        if i > 0 && c[i - 1] == '&' {
            start = i - 1
        }
        let mut at = i + 8
        while at < c.len() && (c[at] == ' ' || c[at] == '\n') {
            at = at + 1
        }
        if at >= c.len() || c[at] != '"' {
            return s
        }
        let lit_start = at + 1
        at = lit_start
        while at < c.len() && c[at] != '"' {
            if c[at] == '\\' {
                at = at + 1
            }
            at = at + 1
        }
        let text = rs2nika_text(c, lit_start, at)
        at = at + 1
        while at < c.len() && c[at] == ' ' {
            at = at + 1
        }
        let mut has_args = false
        if at < c.len() && c[at] == ',' {
            has_args = true
            at = at + 1
        }
        let j = rs2nika_group_end(c, at)
        let mut pos: Vec[String] = []
        let mut named_k: Vec[String] = []
        let mut named_v: Vec[String] = []
        if has_args {
            for a in rs2nika_split_args(rs2nika_text(c, at, j - 1)) {
                let eq = rs2nika_named_arg(a)
                if eq > 0 {
                    named_k.push((a.bytes[0..<eq].text() catch { "" }).trim().clone())
                    named_v.push((a.bytes[eq + 1..].text() catch { "" }).trim().clone())
                } else {
                    pos.push(a.clone())
                }
            }
        }
        let mut bound: Vec[String] = []
        for a in pos {
            if a.contains("\"") || a.contains("{") {
                let n = ctx.hits.len()
                ctx.todo_extra.push(f"let hole_{n} = {a}")
                bound.push(f"hole_{n}")
                rs2nika_hit(ctx, "R81")
            } else {
                bound.push(a.clone())
            }
        }
        pos = bound
        let filled = rs2nika_holes(text, pos, named_k, named_v)
        if filled.contains("{?}") {
            ctx.todo_extra.push("`format!` with fewer arguments than holes: `{?}` is a missing one")
        }
        let before = rs2nika_text(c, 0, start)
        let after = rs2nika_text(c, j, c.len())
        s = f"{before}f\"{filled}\"{after}"
        rs2nika_hit(ctx, "R15")
    }
}

/// The byte index of `=` in `name = value`, or 0.
fn rs2nika_named_arg(a: String) -> i64 {
    let c: Vec[scalar] = a.chars().collect()
    let mut at = 0
    while at < c.len() && rs2nika_word(c[at]) {
        at = at + 1
    }
    if at == 0 {
        return 0
    }
    let name_end = at
    while at < c.len() && c[at] == ' ' {
        at = at + 1
    }
    if at + 1 < c.len() && c[at] == '=' && c[at + 1] != '=' {
        return at
    }
    if name_end > 0 && at < c.len() && c[at] == '=' && at + 1 == c.len() {
        return 0
    }
    return 0
}

fn rs2nika_holes(text: String, pos: ref Vec[String], named_k: ref Vec[String], named_v: ref Vec[String]) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let mut out: String = ""
    let mut next = 0
    let mut at = 0
    while at < c.len() {
        // an escaped brace `{{` / `}}` stays as it is, and the hole after it
        // is still a hole (`\\u{{{:x}}}`)
        if (c[at] == '{' || c[at] == '}') && at + 1 < c.len() && c[at + 1] == c[at] {
            out.push(c[at])
            out.push(c[at])
            at = at + 2
            continue
        }
        if c[at] == '{' {
            let mut e = at + 1
            while e < c.len() && c[e] != '}' && c[e] != '{' {
                e = e + 1
            }
            // the first `}` closes the hole, even before an escaped `}}`
            let closes = e < c.len() && c[e] == '}'
            if closes {
                let inner = rs2nika_text(c, at + 1, e)
                let whole = inner.len()
                let colon = inner.find(":") ?? whole
                let nm: String = inner[0..<colon].clone()
                let mut spec: String = ""
                if colon < inner.len() {
                    spec = inner[colon + ":".len()..<inner.len()].clone()
                }
                if spec == "?" {
                    spec = ""
                }
                // A width or a precision keeps its argument (`{:>4}` of
                // `n` -> `{n:>4}`): Nikaia's f-string takes the same spec.
                {
                    let mut v: String = nm.clone()
                    if nm == "" {
                        if next < pos.len() {
                            v = pos[next].clone()
                        } else {
                            v = "?"
                        }
                        next = next + 1
                    } else if rs2nika_digits(nm) {
                        let n = rs2nika_number(nm)
                        if n < pos.len() {
                            v = pos[n].clone()
                        } else {
                            v = "?"
                        }
                    } else {
                        let mut k = 0
                        while k < named_k.len() {
                            if named_k[k] == nm {
                                v = named_v[k].clone()
                            }
                            k = k + 1
                        }
                    }
                    while v.starts_with("&") {
                        v = (v.strip_prefix("&") ?? "").clone()
                    }
                    while v.starts_with("*") {
                        v = (v.strip_prefix("*") ?? "").clone()
                    }
                    if spec != "" {
                        out.push_str(f"{{{v}:{spec}}}")
                    } else {
                        out.push_str(f"{{{v}}}")
                    }
                }
                at = e + 1
                continue
            }
        }
        out.push(c[at])
        at = at + 1
    }
    return out
}

fn rs2nika_digits(t: String) -> bool {
    for c in t.chars() {
        if !rs2nika_in(c, "0123456789") {
            return false
        }
    }
    return true
}

fn rs2nika_number(t: String) -> i64 {
    let mut n = 0
    for c in t.chars() {
        let digits: Vec[scalar] = "0123456789".chars().collect()
        let mut d = 0
        while d < 10 {
            if digits[d] == c {
                n = n * 10 + d
            }
            d = d + 1
        }
    }
    return n
}

/// `.name(arg)` -> `{left}arg{right}` for each call of the method, with the
/// argument balanced (R20).
fn rs2nika_method_arg(mut ctx: Rs2nikaCtx, given: String, call: String, left: String, right: String, rule: String) -> String {
    let mut s: String = given.clone()
    while true {
        let c: Vec[scalar] = s.chars().collect()
        let i = rs2nika_find_from(c, call, 0)
        if i < 0 {
            return s
        }
        let open = i + call.chars().count()
        let j = rs2nika_group_end(c, open)
        let mut arg = rs2nika_text(c, open, j - 1)
        if arg.starts_with("||") {
            arg = (arg.strip_prefix("||") ?? "").trim().clone()
        }
        let before = rs2nika_text(c, 0, i)
        let after = rs2nika_text(c, j, c.len())
        s = f"{before}{left}{arg}{right}{after}"
        rs2nika_hit(ctx, rule)
    }
}

fn rs2nika_in(c: scalar, set: String) -> bool {
    for x in set.chars() {
        if x == c {
            return true
        }
    }
    return false
}

/// R18 and R19: `*x` and `&x` at a use dropped.
fn rs2nika_derefs(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut a: Vec[scalar] = []
    let mut at = 0
    while at < c.len() {
        let next_ok = at + 1 < c.len() && (rs2nika_word(c[at + 1]) || c[at + 1] == '(')
        let prev_bad = at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == ')' || c[at - 1] == ']' || c[at - 1] == ' ' || c[at - 1] == '\t')
        if c[at] == '*' && next_ok && !prev_bad {
            at = at + 1
        } else {
            a.push(c[at])
            at = at + 1
        }
    }
    let mut b: Vec[scalar] = []
    at = 0
    while at < a.len() {
        let next_ok = at + 1 < a.len() && (rs2nika_in(a[at + 1], "abcdefghijklmnopqrstuvwxyz") || a[at + 1] == '_' || a[at + 1] == '(')
        let prev_ok = at > 0 && rs2nika_in(a[at - 1], " \t([,=!")
        if a[at] == '*' && next_ok && prev_ok {
            at = at + 1
        } else {
            b.push(a[at])
            at = at + 1
        }
    }
    let derefs = b.len() != c.len()
    if derefs {
        rs2nika_hit(ctx, "R18")
    }
    let mut out: String = ""
    at = 0
    let mut borrowed = false
    while at < b.len() {
        let prev_ok = at > 0 && rs2nika_in(b[at - 1], "([, \t=")
        if b[at] == '&' && prev_ok {
            let mut k = at + 1
            if k + 3 < b.len() && b[k] == 'm' && b[k + 1] == 'u' && b[k + 2] == 't' && (b[k + 3] == ' ' || b[k + 3] == '\t') {
                k = k + 3
                while k < b.len() && (b[k] == ' ' || b[k] == '\t') {
                    k = k + 1
                }
            }
            let fits = k < b.len() && (rs2nika_word(b[k]) || b[k] == '(' || b[k] == '"' || b[k] == '[')
            if !fits && k > at + 1 && (rs2nika_word(b[at + 1])) {
                k = at + 1
            }
            if k < b.len() && (rs2nika_word(b[k]) || b[k] == '(' || b[k] == '"' || b[k] == '[') {
                at = k
                borrowed = true
                continue
            }
        }
        out.push(b[at])
        at = at + 1
    }
    if borrowed {
        rs2nika_hit(ctx, "R19")
    }
    return out
}

/// R12: `Some(x)` as a value -> `(x)`.
fn rs2nika_some(mut ctx: Rs2nikaCtx, given: String) -> String {
    if given.contains("if let") || given.contains("let Some") {
        return given.clone()
    }
    let mut head: String = ""
    let mut tail: String = given.clone()
    let whole = given.len()
    let arrow = given.find("=>") ?? whole
    if arrow < whole {
        head = given[0..<arrow + "=>".len()].clone()
        tail = given[arrow + "=>".len()..<given.len()].clone()
    }
    let c: Vec[scalar] = tail.chars().collect()
    let mut out: String = ""
    let mut changed = false
    let mut at = 0
    while at < c.len() {
        let is_some = at + 5 <= c.len() && c[at] == 'S' && c[at + 1] == 'o' && c[at + 2] == 'm' && c[at + 3] == 'e' && c[at + 4] == '('
        if is_some {
            let mut ok = false
            if at > 0 && rs2nika_in(c[at - 1], "=(,:>[") {
                ok = true
            }
            if at > 1 && c[at - 1] == ' ' && rs2nika_in(c[at - 2], "=(,:>[") {
                ok = true
            }
            if at >= 7 && rs2nika_text(c, at - 7, at) == "return " {
                ok = true
            }
            let mut lead = true
            let mut k = 0
            while k < at {
                if c[k] != ' ' && c[k] != '\t' {
                    lead = false
                }
                k = k + 1
            }
            if lead {
                ok = true
            }
            let close = rs2nika_closing(c, at + 4, '(', ')')
            // A value at the end of a block: `{ ..; Some(x) }` (not an arm's
            // `{ Some(x) =>`, R95's).
            if !ok && close > at + 5 && at > 1 && c[at - 1] == ' ' && rs2nika_in(c[at - 2], ";{") {
                let after: String = rs2nika_text(c, close + 1, c.len())
                ok = !after.starts_with(" =>") && !after.starts_with(" if ")
            }
            if ok && close > at + 5 {
                let inner: String = rs2nika_text(c, at + 5, close)
                let ic: Vec[scalar] = inner.chars().collect()
                if rs2nika_recv_start(ic, ic.len()) == 0 {
                    out.push_str(inner)
                    at = close + 1
                    changed = true
                    continue
                }
            }
            if ok {
                out.push('(')
                at = at + 5
                changed = true
                continue
            }
        }
        out.push(c[at])
        at = at + 1
    }
    if changed {
        rs2nika_hit(ctx, "R12")
    }
    return f"{head}{out}"
}

/// R35: postfix `?` in a `T?` function -> `?? return null`.
fn rs2nika_question(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: Vec[scalar] = []
    let mut changed = false
    let mut at = 0
    while at < c.len() {
        // A `?` before ` =` ends the type of a `let` (`let p: (A, B)? = ..`).
        let mut next = at + 1
        while next < c.len() && c[next] == ' ' {
            next = next + 1
        }
        let typed = next + 1 < c.len() && c[next] == '=' && c[next + 1] != '=' && c[next + 1] != '>'
        if !typed && c[at] == '?' && at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == ')' || c[at - 1] == ']') && (at + 1 == c.len() || rs2nika_in(c[at + 1], ".;,) \t")) {
            // R35 inside an operation or a chain: `e? + 1` -> `(e ?? return
            // null) + 1`, `e?.f()` -> `(e ?? return null).f()`
            let mut op = next < c.len() && (c[at + 1] == '.' || (rs2nika_in(c[next], "+-*/%<>=!&|") && !(c[next] == '=' && next + 1 < c.len() && c[next + 1] == '>')))
            // also after an operator: `a + e?` -> `a + (e ?? return null)`
            let mut p = rs2nika_operand_start(out)
            while p > 0 && out[p - 1] == ' ' {
                p = p - 1
            }
            if p > 0 && rs2nika_in(out[p - 1], "+-*/%<>!&|") && !(out[p - 1] == '>' && p > 1 && out[p - 2] == '-') {
                op = true
            }
            if p > 1 && out[p - 1] == '=' && rs2nika_in(out[p - 2], "=<>!") {
                op = true
            }
            if op {
                let start = rs2nika_operand_start(out)
                let mut wrapped: Vec[scalar] = []
                let mut k = 0
                while k < out.len() {
                    if k == start {
                        wrapped.push('(')
                    }
                    wrapped.push(out[k])
                    k = k + 1
                }
                out = wrapped
                for ch in " ?? return null)".chars() {
                    out.push(ch)
                }
            } else {
                for ch in " ?? return null".chars() {
                    out.push(ch)
                }
            }
            changed = true
        } else {
            out.push(c[at])
        }
        at = at + 1
    }
    if changed {
        rs2nika_hit(ctx, "R35")
    }
    let mut text: String = ""
    for ch in out {
        text.push(ch)
    }
    return text
}

/// R198: postfix `?` inside a closure whose result is optional
/// (`filter_map`, `find_map`, `and_then`, `map_while`) in a function that is
/// not itself `T?`: `filter_map(fn(r) { f(r.ty?) })` -> `f(r.ty ?? return
/// null)`, the closure's own `return`.
fn rs2nika_question_in_lambda(mut ctx: Rs2nikaCtx, given: String) -> String {
    for marker in ["filter_map(fn(", "find_map(fn(", "and_then(fn(", "map_while(fn("] {
        let (head, tail) = given.split_once(marker) ?? continue
        if !tail.contains("?") {
            continue
        }
        let before = ctx.fn_opt
        ctx.fn_opt = true
        let done = rs2nika_question(ctx, tail.clone())
        ctx.fn_opt = before
        rs2nika_hit(ctx, "R198")
        return f"{head}{marker}{done}"
    }
    return given
}

/// R106 an integer literal's suffix: `0usize` -> `0` (the type is `i64`, R10),
/// `1u8` -> `(1 as u8)`; R107 a `char` needle of `find`, `rfind` and
/// `replace` -> a text (`s.find(':')` -> `s.find(":")`: those take text);
/// R108 a byte string `b"ab"` -> `"ab".bytes`, `.as_bytes()` -> `.bytes`,
/// the text's own bytes (ADR-320 D11); R109 `e.parse()` ->
/// `text::parse_i64(e)`. Text and `char` literals are copied as they stand.
fn rs2nika_literals(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let ch = c[at]
        let before_word = at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == '\'')
        if ch == '"' || (ch == 'b' && !before_word && at + 1 < c.len() && c[at + 1] == '"') {
            let bytes = ch == 'b'
            if bytes {
                at = at + 1
            }
            out.push('"')
            at = at + 1
            while at < c.len() && c[at] != '"' {
                if c[at] == '\\' && at + 1 < c.len() {
                    out.push(c[at])
                    at = at + 1
                }
                out.push(c[at])
                at = at + 1
            }
            out.push('"')
            at = at + 1
            if bytes {
                out.push_str(".bytes")
                rs2nika_hit(ctx, "R108")
            }
            continue
        }
        if ch == '.' && rs2nika_at(c, at, ".parse") {
            let mut ty: String = ""
            let mut k = at + ".parse".len()
            if rs2nika_at(c, k, "::<") {
                k = k + "::<".len()
                while k < c.len() && c[k] != '>' {
                    ty.push(c[k])
                    k = k + 1
                }
                k = k + 1
            }
            if rs2nika_at(c, k, "()") {
                k = k + "()".len()
                if rs2nika_at(c, k, ".ok()") {
                    k = k + ".ok()".len()
                }
                // R161: the option's test for the `Result`'s
                let mut tested: String = ""
                if rs2nika_at(c, k, ".is_ok()") {
                    tested = " != null"
                    k = k + ".is_ok()".len()
                } else if rs2nika_at(c, k, ".is_err()") {
                    tested = " == null"
                    k = k + ".is_err()".len()
                }
                let mut f = "parse_i64"
                if ty == "u64" || ty == "u8" {
                    f = f"parse_{ty}"
                }
                let o: Vec[scalar] = out.chars().collect()
                let start = rs2nika_operand_start(o)
                let mut head: String = ""
                let mut recv: String = ""
                let mut j = 0
                while j < o.len() {
                    if j < start {
                        head.push(o[j])
                    } else {
                        recv.push(o[j])
                    }
                    j = j + 1
                }
                out = f"{head}text::{f}({recv})"
                if tested != "" {
                    if head.ends_with("!") || (k < c.len() && c[k] == '.') {
                        out = f"{head}(text::{f}({recv}){tested})"
                    } else {
                        out = f"{out}{tested}"
                    }
                    rs2nika_hit(ctx, "R161")
                }
                rs2nika_hit(ctx, "R109")
                at = k
                continue
            }
        }
        if ch == '\'' {
            // a `char` literal: `'x'`, `'\n'`, `'\''`; a lifetime is left
            let mut end = 0 - 1
            if at + 2 < c.len() && c[at + 1] != '\\' && c[at + 2] == '\'' {
                end = at + 2
            } else if at + 3 < c.len() && c[at + 1] == '\\' && c[at + 3] == '\'' {
                end = at + 3
            }
            if end < 0 {
                out.push(ch)
                at = at + 1
                continue
            }
            let mut needle = false
            for m in [".find(", ".rfind(", ".replace("] {
                if out.ends_with(m) {
                    needle = true
                }
            }
            if needle && end + 1 < c.len() && (c[end + 1] == ')' || c[end + 1] == ',') {
                out.push('"')
                if c[at + 1] == '"' {
                    out.push_str("\\\"")
                } else if c[at + 1] == '\\' && c[at + 2] == '\'' {
                    out.push('\'')
                } else {
                    let mut k = at + 1
                    while k < end {
                        out.push(c[k])
                        k = k + 1
                    }
                }
                out.push('"')
                rs2nika_hit(ctx, "R107")
            } else {
                let mut k = at
                while k <= end {
                    out.push(c[k])
                    k = k + 1
                }
            }
            at = end + 1
            continue
        }
        if ch.is_ascii_digit() && !before_word {
            let mut end = at
            // `0xcbf2_9ce4u64`, `0b1010u8`: the radix's digits, then the suffix
            let radix = ch == '0' && at + 1 < c.len() && rs2nika_in(c[at + 1], "xbo")
            if radix {
                end = at + 2
            }
            while end < c.len() && (c[end].is_ascii_digit() || c[end] == '_' || (radix && c[at + 1] == 'x' && rs2nika_in(c[end], "abcdefABCDEF"))) {
                end = end + 1
            }
            let mut suffix: String = ""
            let mut k = end
            while k < c.len() && rs2nika_word(c[k]) {
                suffix.push(c[k])
                k = k + 1
            }
            let mut digits: String = ""
            let mut d = at
            while d < end {
                digits.push(c[d])
                d = d + 1
            }
            if rs2nika_is_int(suffix) || suffix == "i64" {
                out.push_str(digits)
                rs2nika_hit(ctx, if radix { "R204" } else { "R106" })
                at = k
                continue
            }
            if suffix == "u8" || suffix == "u64" {
                out.push_str(f"({digits} as {suffix})")
                rs2nika_hit(ctx, if radix { "R204" } else { "R106" })
                at = k
                continue
            }
            out.push_str(digits)
            at = end
            continue
        }
        out.push(ch)
        at = at + 1
    }
    if out.contains(".as_bytes()") {
        rs2nika_hit(ctx, "R108")
        return out.replace(".as_bytes()", ".bytes")
    }
    return out
}

/// Whether `text` has a `.map(|` and each one maps a sequence (R107's test),
/// not an `Option`.
fn rs2nika_seq_maps(text: String) -> bool {
    let c: Vec[scalar] = text.chars().collect()
    let mut from = 0
    let mut any = false
    while true {
        let at = rs2nika_find_from(c, ".map(|", from)
        if at < 0 {
            break
        }
        if !rs2nika_seq_receiver(c, at) {
            return false
        }
        any = true
        from = at + 1
    }
    return any
}

/// R107: whether the receiver ending at `at` is a sequence, not a text: it
/// ends in a call to a method that starts or continues an iterator
/// (`xs.iter()`, `.values()`, `.lines()`, `.rev()`, `.filter(..)`), or it is
/// a range in brackets (`(0..n)`).
fn rs2nika_seq_receiver(c: ref Vec[scalar], at: i64) -> bool {
    if at == 0 || c[at - 1] != ')' {
        return false
    }
    let mut depth = 0
    let mut k = at - 1
    while k >= 0 {
        if c[k] == ')' {
            depth = depth + 1
        } else if c[k] == '(' {
            depth = depth - 1
            if depth == 0 {
                break
            }
        }
        k = k - 1
    }
    if k < 0 {
        return false
    }
    if k == 0 || !rs2nika_word(c[k - 1]) {
        // a range in brackets, `(0..n)`
        return rs2nika_text(c, k + 1, at - 1).contains("..")
    }
    let mut s = k
    while s > 0 && rs2nika_word(c[s - 1]) {
        s = s - 1
    }
    if s == 0 || c[s - 1] != '.' {
        return false
    }
    let mut name: String = ""
    let mut i = s
    while i < k {
        name.push(c[i])
        i = i + 1
    }
    for seq in ["iter", "into_iter", "iter_mut", "values", "values_mut", "keys", "lines", "chars", "bytes", "char_indices", "ancestors", "rev", "split_whitespace", "filter", "map", "skip", "take", "skip_while", "take_while", "enumerate", "zip", "chain", "flatten", "cloned", "copied", "peekable"] {
        if name == seq {
            return true
        }
    }
    return false
}

/// R107: the TODO for a text search whose needle is a function, a closure or
/// a list of `char`s (`s.find(char::is_whitespace)`, `s.split(|c| ..)`,
/// `s.replace(['-', '.'], "_")`): Nikaia's take a text; `""` for any other.
fn rs2nika_needle_todo(line: String) -> String {
    let c: Vec[scalar] = line.chars().collect()
    for m in [".find(", ".rfind(", ".split(", ".rsplit(", ".split_once(", ".rsplit_once(", ".replace(", ".split_terminator(", ".trim_matches(", ".trim_start_matches(", ".trim_end_matches(", ".strip_prefix(", ".strip_suffix(", ".contains(", ".matches("] {
        for tail in [f"{m}char::", f"{m}|", f"{m}['", f"{m}&['"] {
            if tail == ".find(|" {
                // `Iterator::find` with a closure is `Seq::find` (R26)
                let mut from = 0
                while true {
                    let at = rs2nika_find_from(c, tail, from)
                    if at < 0 {
                        break
                    }
                    if !rs2nika_seq_receiver(c, at) {
                        return f"`{m}..)` with a function, a closure or a list of `char`s as the needle: Nikaia's text methods take a text; a loop over `.chars()`, or one call per needle"
                    }
                    from = at + 1
                }
            } else if line.contains(tail) {
                return f"`{m}..)` with a function, a closure or a list of `char`s as the needle: Nikaia's text methods take a text; a loop over `.chars()`, or one call per needle"
            }
        }
    }
    return ""
}

/// R109: the file's lines joined, with `use std::text` after its own `use`
/// lines (or above its first item) where a line calls `text::parse_..`.
fn rs2nika_use_text(lines: ref Vec[String]) -> String {
    let mut needed = false
    let mut has = false
    for l in lines {
        if l.contains("text::parse_") {
            needed = true
        }
        if l.trim() == "use std::text" {
            has = true
        }
    }
    if !needed || has {
        return rs2nika_join(lines, "\n")
    }
    let mut at = 0
    let mut last_use = 0 - 1
    let mut head = true
    while head && at < lines.len() {
        let st: String = lines[at].trim().clone()
        if st.starts_with("use ") {
            last_use = at
        } else if st != "" && !st.starts_with("//") {
            head = false
        }
        if head {
            at = at + 1
        }
    }
    let mut out: Vec[String] = []
    let mut k = 0
    while k < lines.len() {
        if last_use < 0 && k == at {
            out.push("use std::text")
            out.push("")
        }
        out.push(lines[k].clone())
        if k == last_use {
            out.push("use std::text")
        }
        k = k + 1
    }
    return rs2nika_join(out, "\n")
}

/// Whether `what` stands in `c` at `at`.
fn rs2nika_at(c: ref Vec[scalar], at: i64, what: String) -> bool {
    let mut k = at
    for w in what.chars() {
        if k >= c.len() || c[k] != w {
            return false
        }
        k = k + 1
    }
    return true
}

/// Where the operand that ends at the end of `o` starts: back over names,
/// paths, `.` and balanced `(..)` / `[..]`.
fn rs2nika_operand_start(o: ref Vec[scalar]) -> i64 {
    let mut at = o.len()
    while at > 0 {
        let ch = o[at - 1]
        if ch == ')' || ch == ']' {
            let mut depth = 0
            let mut open = true
            while open && at > 0 {
                let d = o[at - 1]
                if d == ')' || d == ']' {
                    depth = depth + 1
                } else if d == '(' || d == '[' {
                    depth = depth - 1
                }
                at = at - 1
                open = depth > 0
            }
        } else if rs2nika_word(ch) || ch == '.' || ch == ':' {
            at = at - 1
        } else {
            return at
        }
    }
    return at
}

/// `ty::` before a name dropped (R28).
fn rs2nika_ty_paths(given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let here = at + 4 < c.len() && c[at] == 't' && c[at + 1] == 'y' && c[at + 2] == ':' && c[at + 3] == ':' && (rs2nika_word(c[at + 4]))
        if here && !(at > 0 && rs2nika_word(c[at - 1])) {
            at = at + 4
        } else {
            out.push(c[at])
            at = at + 1
        }
    }
    return out
}

/// `from` replaced where it is not preceded by a word character or `.`.
fn rs2nika_replace_free(text: String, from: String, to: String) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let f: Vec[scalar] = from.chars().collect()
    let mut out: String = ""
    let mut at = 0
    let mut quoted = false
    while at < c.len() {
        if rs2nika_quote_at(c, at) {
            quoted = !quoted
        }
        if quoted || c[at] == '"' {
            out.push(c[at])
            at = at + 1
            continue
        }
        let mut same = at + f.len() <= c.len()
        let mut k = 0
        while same && k < f.len() {
            if c[at + k] != f[k] {
                same = false
            }
            k = k + 1
        }
        if same && at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == '.' || c[at - 1] == ':') {
            same = false
        }
        if same {
            out.push_str(to)
            at = at + f.len()
        } else {
            out.push(c[at])
            at = at + 1
        }
    }
    return out
}

/// Whether `c[at]` opens or closes a string literal: a `"` not escaped and
/// not the char literal `'"'`. A name inside a literal is text, not a name.
fn rs2nika_quote_at(c: ref Vec[scalar], at: i64) -> bool {
    if c[at] != '"' {
        return false
    }
    if at > 0 && c[at - 1] == '\\' {
        return false
    }
    if at > 0 && at + 1 < c.len() && c[at - 1] == '\'' && c[at + 1] == '\'' {
        return false
    }
    return true
}

fn rs2nika_same(a: String, b: String) -> bool {
    return a == b
}

/// The rewrites of an expression line.
/// The number of a byte literal's body (`a`, `\\`, `\x7f`), or -1.
fn rs2nika_byte_value(body: String) -> i64 {
    let c: Vec[scalar] = body.chars().collect()
    if c.len() == 1 && c[0] != '\\' {
        return c[0] as i64
    }
    if c.len() == 2 && c[0] == '\\' {
        let e = c[1]
        if e == 'n' {
            return 10
        } else if e == 't' {
            return 9
        } else if e == 'r' {
            return 13
        } else if e == '0' {
            return 0
        } else if e == '\\' || e == '\'' || e == '"' {
            return e as i64
        }
        return -1
    }
    if c.len() == 4 && c[0] == '\\' && c[1] == 'x' {
        let mut n = 0
        for d in [c[2], c[3]] {
            let mut v = -1
            if d >= '0' && d <= '9' {
                v = (d as i64) - 48
            } else if d >= 'a' && d <= 'f' {
                v = (d as i64) - 87
            } else if d >= 'A' && d <= 'F' {
                v = (d as i64) - 55
            }
            if v < 0 {
                return -1
            }
            n = n * 16 + v
        }
        return n
    }
    return -1
}

/// R57: a byte literal `b'x'` outside a string -> its number.
fn rs2nika_bytes(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut quoted = false
    let mut at = 0
    while at < c.len() {
        let ch = c[at]
        if quoted {
            out.push(ch)
            if ch == '\\' && at + 1 < c.len() {
                out.push(c[at + 1])
                at = at + 2
                continue
            }
            if ch == '"' {
                quoted = false
            }
            at = at + 1
            continue
        }
        if ch == '"' {
            quoted = true
        } else if ch == 'b' && at + 2 < c.len() && c[at + 1] == '\'' && (at == 0 || !rs2nika_word(c[at - 1])) {
            let mut e = at + 2
            if c[e] == '\\' {
                e = e + 1
            }
            e = e + 1
            while e < c.len() && c[e] != '\'' {
                e = e + 1
            }
            if e < c.len() {
                let n = rs2nika_byte_value(rs2nika_text(c, at + 2, e))
                if n >= 0 {
                    out.push_str(f"{n}")
                    rs2nika_hit(ctx, "R57")
                    at = e + 1
                    continue
                }
                ctx.todo_extra.push("byte literal `b'x'` with an escape rs2nika does not know: its number")
            }
        }
        out.push(ch)
        at = at + 1
    }
    return out
}

/// R66: the build-time decoder is `escapes.nika`'s `decoded`, which takes the
/// reading of a numbered escape as a function; `ascii_scalar` reads a byte.
fn rs2nika_decoded(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    for p in ["crate::build_time::decoded(", "build_time::decoded("] {
        let c: Vec[scalar] = s.chars().collect()
        let at = rs2nika_find_from(c, p, 0)
        if at < 0 {
            continue
        }
        let open = at + p.chars().count() - 1
        let mut depth = 0
        let mut close = -1
        let mut k = open
        while k < c.len() && close < 0 {
            if c[k] == '(' {
                depth = depth + 1
            } else if c[k] == ')' {
                depth = depth - 1
                if depth == 0 {
                    close = k
                }
            }
            k = k + 1
        }
        if close < 0 {
            continue
        }
        let pre = rs2nika_text(c, 0, at)
        let arg = rs2nika_text(c, open + 1, close)
        let post = rs2nika_text(c, close + 1, c.len())
        s = f"{pre}(decoded({arg}) fn(n) {{ ascii_scalar(n) }}){post}"
        ctx.todo_extra.push("`decoded` with `ascii_scalar`: a numbered escape above ASCII reads as no text")
        rs2nika_hit(ctx, "R66")
    }
    return s
}

/// R67: a one-character `char` needle of `find`/`rfind` is the same text.
fn rs2nika_char_needle(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    for m in [".find('", ".rfind('"] {
        let mut from = 0
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let at = rs2nika_find_from(c, m, from)
            if at < 0 {
                break
            }
            let q = at + m.chars().count() - 1
            from = at + 1
            if q + 3 < c.len() && c[q + 2] == '\'' && c[q + 3] == ')' && c[q + 1] != '\\' && c[q + 1] != '"' {
                let pre = rs2nika_text(c, 0, q)
                let post = rs2nika_text(c, q + 3, c.len())
                s = f"{pre}\"{c[q + 1]}\"{post}"
                rs2nika_hit(ctx, "R67")
            }
        }
    }
    return s
}

/// A closure argument `|p| body` (also `move`, `|_|`, `||`, a body in
/// braces) as `[p, body, value]`: the braces of a body that is one block
/// dropped, and `value` the body as an expression (a block of statements
/// keeps its braces);
/// `[]` for anything else (a function's path, a value).
fn rs2nika_closure_parts(arg: String) -> Vec[String] {
    let mut a: String = arg.trim().clone()
    if a.starts_with("move ") {
        a = (a.strip_prefix("move ") ?? "").trim().clone()
    }
    if !a.starts_with("|") {
        return []
    }
    let c: Vec[scalar] = a.chars().collect()
    let mut close = 1
    while close < c.len() && c[close] != '|' {
        close = close + 1
    }
    if close >= c.len() {
        return []
    }
    let mut param: String = rs2nika_text(c, 1, close).trim().clone()
    let colon = param.find(":") ?? param.len()
    param = param[0..<colon].trim().clone()
    if param.contains(",") || param.contains("(") {
        return []
    }
    let mut body: String = rs2nika_text(c, close + 1, c.len()).trim().clone()
    if body.starts_with("{") && body.ends_with("}") {
        let b: Vec[scalar] = body.chars().collect()
        if rs2nika_group_end(b, 1) == b.len() {
            body = rs2nika_text(b, 1, b.len() - 1).trim().clone()
            if body.contains(";") {
                // statements: a block where a value stands, its inner part in a `catch`
                let block: String = f"{{ {body} }}"
                return [param, body, block]
            }
        }
    }
    return [param, body.clone(), body]
}

/// The body of a `catch` that reads the error under the closure's name `p`:
/// `let p = error; body` where the body names it, the body alone where not.
fn rs2nika_catch_body(param: String, body: String) -> String {
    if param == "_" || param == "" || param == "error" || rs2nika_replace_word(body, param, "\u{a7}") == body {
        return body.clone()
    }
    return f"let {param} = error; {body}"
}

/// Whether the value `x.m(..)` written in place needs parentheses once `m`
/// is an operator (`??`, `catch`): an operator or a `.`/`[` beside it.
fn rs2nika_needs_parens(c: ref Vec[scalar], start: i64, end: i64) -> bool {
    let mut k = end
    while k < c.len() && c[k] == ' ' {
        k = k + 1
    }
    if k < c.len() && rs2nika_in(c[k], ".[+-*/%<>!&|?") {
        return true
    }
    if k + 1 < c.len() && c[k] == '=' && c[k + 1] != '>' {
        return true
    }
    if k + 2 < c.len() && c[k] == 'a' && c[k + 1] == 's' && c[k + 2] == ' ' {
        return true
    }
    let mut p = start
    while p > 0 && c[p - 1] == ' ' {
        p = p - 1
    }
    if p > 0 && rs2nika_in(c[p - 1], "+-*/%<>!&|") && !(c[p - 1] == '>' && p > 1 && c[p - 2] == '-') {
        return true
    }
    if p > 1 && c[p - 1] == '=' && rs2nika_in(c[p - 2], "=<>!") {
        return true
    }
    return false
}

/// Whether the receiver ending at `at` is `parse()`'s (R109 reads
/// `.parse().ok()` as `text::parse_i64(..)`, an option).
fn rs2nika_parsed_before(c: ref Vec[scalar], at: i64) -> bool {
    let start = rs2nika_recv_start(c, at)
    let recv = rs2nika_text(c, start, at)
    return recv.ends_with(".parse()") || (recv.contains(".parse::<") && recv.ends_with(">()"))
}

/// R20, R140-R143 and R147: the fallbacks of an option and of a `Result`,
/// each as Nikaia's operator, the call in parentheses where an operator or a
/// `.` stands beside it:
/// `.unwrap_or(d)` / `.unwrap_or_else(|| d)` -> `?? d`, `.or_else(|| e)` ->
/// `?? e` (R141), `.unwrap_or_else(|e| d)` / `.or_else(|e| d)` (a `Result`'s)
/// -> `catch { d }` with `e` read from `error` (R140), `.ok_or(e)` /
/// `.ok_or_else(|| e)` -> `?? throw e` (R142), `.map_err(|e| x)` / `.map_err(f)`
/// -> `catch { throw x }` / `catch { throw f(error) }` (R143), and of a
/// `Result` made an option, `.ok().unwrap_or(d)` -> `catch { d }` and `.ok()?`
/// in a `T?` function -> `catch { return null }` (R147).
fn rs2nika_fallbacks(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    for call in [".unwrap_or_else(", ".unwrap_or(", ".or_else(", ".ok_or_else(", ".ok_or(", ".map_err(", ".ok()?"] {
        let mut from = 0
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let mut i = rs2nika_find_from(c, call, from)
            if i < 0 {
                break
            }
            from = i + 1
            let mut j = i + call.chars().count()
            let mut arg: String = ""
            if call != ".ok()?" {
                j = rs2nika_group_end(c, j)
                arg = rs2nika_text(c, i + call.chars().count(), j - 1).trim().clone()
            }
            let parts = rs2nika_closure_parts(arg)
            let mut op: String = ""
            let mut rule: String = ""
            // `.ok()` before the fallback: the `Result`'s own failure is caught
            let ok = i >= 5 && rs2nika_text(c, i - 5, i) == ".ok()" && !rs2nika_parsed_before(c, i - 5)
            if call == ".ok()?" {
                if !ctx.fn_opt || rs2nika_parsed_before(c, i) {
                    continue
                }
                op = " catch { return null }"
                rule = "R147"
            } else if ok && (call == ".unwrap_or(" || (call == ".unwrap_or_else(" && parts.len() == 3 && parts[0] == "")) {
                let mut d: String = arg.clone()
                if parts.len() == 3 {
                    d = parts[2].clone()
                }
                op = f" catch {{ {d} }}"
                rule = "R147"
                i = i - 5
            } else if call == ".unwrap_or(" {
                op = f" ?? {arg}"
                rule = "R20"
            } else if call == ".unwrap_or_else(" || call == ".or_else(" {
                if parts.len() != 3 {
                    continue
                }
                if parts[0] == "" {
                    op = f" ?? {parts[2]}"
                    rule = "R20"
                    if call == ".or_else(" {
                        rule = "R141"
                    }
                } else {
                    let body = rs2nika_catch_body(parts[0], parts[1])
                    op = f" catch {{ {body} }}"
                    rule = "R140"
                }
            } else if call == ".ok_or(" {
                op = f" ?? throw {arg}"
                rule = "R142"
            } else if call == ".ok_or_else(" {
                if parts.len() != 3 || parts[0] != "" || parts[1] != parts[2] {
                    continue
                }
                op = f" ?? throw {parts[1]}"
                rule = "R142"
            } else {
                let parsed = rs2nika_parsed_before(c, i)
                if parsed && parts.len() == 3 && parts[1] == parts[2] && (parts[0] == "_" || rs2nika_catch_body(parts[0], parts[1]) == parts[1]) {
                    // R109 makes `parse()` an option: its failure is a `null`
                    op = f" ?? throw {parts[1]}"
                } else if parsed {
                    ctx.todo_extra.push("`.map_err(|e| x)` of `parse()`: R109 makes it an option, which carries no error to name; `?? throw x` without `e`")
                    continue
                } else if parts.len() == 3 && parts[1] == parts[2] {
                    let thrown: String = f"throw {parts[1]}"
                    let body = rs2nika_catch_body(parts[0], thrown)
                    op = f" catch {{ {body} }}"
                } else if arg != "" && !arg.contains("|") {
                    op = f" catch {{ throw {arg}(error) }}"
                } else {
                    continue
                }
                rule = "R143"
            }
            let start = rs2nika_recv_start(c, i)
            let recv = rs2nika_text(c, start, i)
            let before = rs2nika_text(c, 0, start)
            let after = rs2nika_text(c, j, c.len())
            if rs2nika_needs_parens(c, start, j) {
                s = f"{before}({recv}{op}){after}"
            } else {
                s = f"{before}{recv}{op}{after}"
            }
            from = start + 1
            rs2nika_hit(ctx, rule)
        }
    }
    return s
}

/// Whether a closure opens at `at` (a `|` after `(`, `,`, `=`, `move` or at
/// the start): an operator `|`/`||` stands after a value.
fn rs2nika_closure_bar(c: ref Vec[scalar], at: i64) -> bool {
    if c[at] != '|' {
        return false
    }
    let mut p = at
    while p > 0 && c[p - 1] == ' ' {
        p = p - 1
    }
    if p == 0 {
        return true
    }
    if rs2nika_in(c[p - 1], "(,=") {
        return true
    }
    return p >= 4 && rs2nika_text(c, p - 4, p) == "move"
}

/// Whether a closure opens in `text` before `upto`.
fn rs2nika_closure_before(text: String, upto: i64) -> bool {
    let c: Vec[scalar] = rs2nika_blank(text).chars().collect()
    let mut at = 0
    while at < upto && at < c.len() {
        if rs2nika_closure_bar(c, at) {
            return true
        }
        at = at + 1
    }
    return false
}

/// R144: Rust's postfix `?` dropped, outside text and closures: in a
/// function that `throws`, a failure passes on by itself (Part I 7.1).
fn rs2nika_drop_try(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut quoted = false
    let mut depth = 0
    let mut closures: Vec[i64] = []
    let mut at = 0
    while at < c.len() {
        let ch = c[at]
        if quoted {
            out.push(ch)
            if ch == '\\' && at + 1 < c.len() {
                out.push(c[at + 1])
                at = at + 1
            } else if ch == '"' {
                quoted = false
            }
            at = at + 1
            continue
        }
        if ch == '"' {
            quoted = true
            out.push(ch)
            at = at + 1
            continue
        }
        if ch == '\'' && at + 2 < c.len() && (c[at + 2] == '\'' || c[at + 1] == '\\') {
            // a `char` literal, copied whole
            out.push(ch)
            at = at + 1
            while at < c.len() && c[at] != '\'' {
                if c[at] == '\\' {
                    out.push(c[at])
                    at = at + 1
                }
                if at < c.len() {
                    out.push(c[at])
                    at = at + 1
                }
            }
            if at < c.len() {
                out.push(c[at])
                at = at + 1
            }
            continue
        }
        if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1
            while closures.len() > 0 && depth < closures[closures.len() - 1] {
                closures.pop()
            }
        } else if ch == ',' && closures.len() > 0 && depth == closures[closures.len() - 1] {
            closures.pop()
        }
        if rs2nika_closure_bar(c, at) {
            closures.push(depth)
            out.push(ch)
            at = at + 1
            if at < c.len() && c[at] == '|' {
                out.push(c[at])
                at = at + 1
                continue
            }
            while at < c.len() && c[at] != '|' {
                out.push(c[at])
                at = at + 1
            }
            if at < c.len() {
                out.push(c[at])
                at = at + 1
            }
            continue
        }
        let after_value = at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == ')' || c[at - 1] == ']')
        if ch == '?' && closures.len() == 0 && after_value && (at + 1 == c.len() || rs2nika_in(c[at + 1], ".;,) \t]}?")) {
            rs2nika_hit(ctx, "R144")
            at = at + 1
            continue
        }
        out.push(ch)
        at = at + 1
    }
    return out
}

/// `head(inner)` as `[inner]` where the whole of `text` is that one call,
/// else `[]`.
fn rs2nika_called(text: String, head: String) -> Vec[String] {
    if !text.starts_with(head) {
        return []
    }
    let c: Vec[scalar] = text.chars().collect()
    let open = head.chars().count()
    if rs2nika_group_end(c, open) != c.len() {
        return []
    }
    return [rs2nika_text(c, open, c.len() - 1).trim().clone()]
}

/// R145: `Ok(x)` / `Err(e)` as what a function that `throws` hands back:
/// `x` (`Ok(())`: `return`) and `throw e`.
fn rs2nika_handed(value: String, arm: bool) -> String {
    let ok = rs2nika_called(value, "Ok(")
    if ok.len() == 1 {
        if ok[0] == "()" {
            if arm {
                return "{}"
            }
            return "return"
        }
        return ok[0].clone()
    }
    let err = rs2nika_called(value, "Err(")
    if err.len() == 1 {
        return f"throw {err[0]}"
    }
    return ""
}

/// R145 on one line: `return Ok(x)` -> `return x`, `return Err(e)` -> `throw
/// e` (anywhere on the line, before any closure), a line that is `Ok(x)` /
/// `Err(e)` (a block's value) and a one-arm line `P => Ok(x),` the same.
fn rs2nika_result_values(mut ctx: Rs2nikaCtx, given: String) -> String {
    let ind = rs2nika_indent(given)
    let mut st: String = given.trim().clone()
    let mut end: String = ""
    if st.ends_with(";") {
        end = ";"
        st = st[0..<st.len() - ";".len()].trim_end().clone()
    } else if st.ends_with(",") {
        end = ","
        st = st[0..<st.len() - ",".len()].trim_end().clone()
    }
    let whole = rs2nika_handed(st, false)
    if whole != "" {
        rs2nika_hit(ctx, "R145")
        if end == ";" {
            end = ""
        }
        return f"{ind}{whole}{end}"
    }
    let arrow = st.find(" => ") ?? st.len()
    if arrow < st.len() && !st.contains("match ") && !st.starts_with("let ") && !rs2nika_closure_before(st, st.len()) {
        let head: String = st[0..<arrow + " => ".len()].clone()
        let value: String = st[arrow + " => ".len()..<st.len()].clone()
        if !value.contains(" => ") {
            let arm = rs2nika_handed(value, true)
            if arm != "" {
                rs2nika_hit(ctx, "R145")
                return f"{ind}{head}{arm}{end}"
            }
        }
    }
    let mut s: String = given.clone()
    for word in ["return Ok(", "return Err("] {
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let at = rs2nika_find_from(c, word, 0)
            if at < 0 || (at > 0 && rs2nika_word(c[at - 1])) || rs2nika_closure_before(s, at) {
                break
            }
            let open = at + word.chars().count()
            let j = rs2nika_group_end(c, open)
            let inner: String = rs2nika_text(c, open, j - 1).trim().clone()
            let mut to: String = f"return {inner}"
            if word == "return Err(" {
                to = f"throw {inner}"
            } else if inner == "()" {
                to = "return"
            }
            s = f"{rs2nika_text(c, 0, at)}{to}{rs2nika_text(c, j, c.len())}"
            rs2nika_hit(ctx, "R145")
        }
    }
    return s
}

/// R144 and R145 over the lines of a function that hands back a `Result`
/// (a `throws` one, R11), not inside a closure, nor in a block a `let` binds
/// (a `Result` kept as a value).
fn rs2nika_results(mut ctx: Rs2nikaCtx, lines: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut depth = 0
    let mut at_depth: Vec[i64] = []
    let mut kinds: Vec[String] = []
    let mut sig: String = ""
    for l in lines {
        let st: String = l.trim().clone()
        if sig == "" && rs2nika_fn_name(l) != "" {
            sig = " "
        }
        let mut line: String = l.clone()
        if sig == "" && kinds.len() > 0 && kinds[kinds.len() - 1] == "res" && !st.starts_with("//") {
            line = rs2nika_result_values(ctx, rs2nika_drop_try(ctx, l))
        }
        out.push(line)
        let before = depth
        depth = depth + rs2nika_depth_of(l)
        let code: String = rs2nika_blank(st).clone()
        if sig != "" {
            sig = f"{sig} {code}"
            if depth > before {
                let mut kind: String = "fn"
                let arrow = sig.find("->") ?? sig.len()
                if arrow < sig.len() && sig[arrow..].contains("Result<") {
                    kind = "res"
                }
                at_depth.push(before)
                kinds.push(kind)
                sig = ""
            } else if code.ends_with(";") {
                sig = ""
            }
        } else if depth > before {
            let brace = code.rfind("{") ?? 0
            let opener: String = code[0..<brace].trim_end().clone()
            // a closure's body, a block handed to a call, a block a `let` binds
            let open_call = rs2nika_count(code, '(') > rs2nika_count(code, ')')
            if opener.ends_with("|") || opener.contains("| ->") || code.starts_with("let ") || open_call {
                at_depth.push(before)
                kinds.push("keep")
            }
        }
        while at_depth.len() > 0 && depth <= at_depth[at_depth.len() - 1] {
            at_depth.pop()
            kinds.pop()
        }
    }
    return out
}

/// R148: `Self` inside an `impl` (or `impl T for X`) -> the type's own name,
/// `Self::f(..)` -> `X::f(..)`, `-> Self` -> `-> X` (tools/*.nika never
/// write `Self`: `Self::f()` is NK1245); the state's `impl` names its state
/// struct (R34), and where its methods are free functions (`-free`, R83)
/// `Self::f(..)` -> `f(..)`.
fn rs2nika_self_type(mut ctx: Rs2nikaCtx, lines: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut depth = 0
    let mut name: String = ""
    for l in lines {
        let st: String = l.trim().clone()
        if depth == 0 {
            name = ""
            if st.starts_with("impl ") || st.starts_with("impl<") {
                name = rs2nika_impl_type(st)
                if ctx.profile != "none" && (name == "Checker" || name == "Emitter") {
                    name = "CheckState"
                    if ctx.profile == "emit" {
                        name = "EmitState"
                    }
                    if ctx.free {
                        name = "\u{a7}"
                    }
                }
            }
        }
        let mut line: String = l.clone()
        if depth > 0 && name != "" && rs2nika_replace_word(l, "Self", "\u{b6}") != l {
            if name == "\u{a7}" {
                // the methods are free functions: `Self::f(` calls one
                line = rs2nika_replace_word(l, "Self::", "")
                let state: String = "CheckState"
                if ctx.profile == "emit" {
                    line = rs2nika_replace_word(line, "Self", "EmitState")
                } else {
                    line = rs2nika_replace_word(line, "Self", state)
                }
            } else {
                line = rs2nika_replace_word(l, "Self", name)
            }
            rs2nika_hit(ctx, "R148")
        }
        out.push(line)
        depth = depth + rs2nika_depth_of(l)
    }
    return out
}

/// R149: a variant of an `enum`: its payload's types by a field's rules
/// (R10, R6, R9): `Dot(usize),` -> `Dot(i64),`, `Named { at: usize },` ->
/// `Named { at: i64 },`; `""` for what is no variant (a comment, an
/// attribute, a discriminant).
fn rs2nika_enum_variant(mut ctx: Rs2nikaCtx, line: String) -> String {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    if st.ends_with(",") {
        st = st[0..<st.len() - ",".len()].trim_end().clone()
    }
    let c: Vec[scalar] = st.chars().collect()
    let mut e = 0
    while e < c.len() && rs2nika_word(c[e]) {
        e = e + 1
    }
    if e == 0 {
        return ""
    }
    let name = rs2nika_text(c, 0, e)
    let rest: String = rs2nika_text(c, e, c.len()).trim().clone()
    if rest == "" {
        return f"{ind}{name},"
    }
    let tuple = rest.starts_with("(") && rest.ends_with(")")
    let fields = rest.starts_with("{") && rest.ends_with("}")
    if !tuple && !fields {
        return ""
    }
    let r: Vec[scalar] = rest.chars().collect()
    let inner = rs2nika_text(r, 1, r.len() - 1)
    let mut parts: Vec[String] = []
    for p in rs2nika_split_args(inner) {
        if tuple {
            parts.push(rs2nika_ty(ctx, p))
        } else {
            let colon = p.find(":") ?? return ""
            let field: String = p[0..<colon].trim().trim_start_matches("pub ").clone()
            let ty = rs2nika_ty(ctx, p[colon + ":".len()..<p.len()].clone())
            parts.push(f"{field}: {ty}")
        }
    }
    rs2nika_hit(ctx, "R149")
    let joined = rs2nika_join(parts, ", ")
    if tuple {
        return f"{ind}{name}({joined}),"
    }
    return f"{ind}{name} {{ {joined} }},"
}

fn rs2nika_enum_head(st: String) -> bool {
    let head: String = st.trim_start_matches("pub(crate) ").trim_start_matches("pub(super) ").trim_start_matches("pub ").clone()
    return head.starts_with("enum ") && head.ends_with("{")
}

/// R147: whether the line reads a `Result` as a value that R147's
/// `catch` forms do not take (`.ok()` before `?` or a fallback, and
/// `parse()`'s, R109, are taken).
fn rs2nika_result_read(line: String) -> bool {
    let c: Vec[scalar] = line.chars().collect()
    for read in [".ok()", ".is_ok()", ".is_err()", ".is_ok_and("] {
        let mut from = 0
        while true {
            let at = rs2nika_find_from(c, read, from)
            if at < 0 {
                break
            }
            from = at + 1
            let after = rs2nika_text(c, at + read.chars().count(), c.len())
            let fallback = read == ".ok()" && (after.starts_with("?") || after.starts_with(".unwrap_or"))
            if !fallback && !(read != ".is_ok_and(" && rs2nika_parsed_before(c, at)) && !(read != ".ok()" && read != ".is_ok_and(" && at >= 5 && rs2nika_text(c, at - 5, at) == ".ok()" && rs2nika_parsed_before(c, at - 5)) {
                return true
            }
        }
    }
    return false
}

/// R146: whether `let Ok(x) = v else ..` binds a call's value (`v` ends in `)`).
fn rs2nika_let_ok_call(st: String) -> bool {
    let eq = st.find(" = ") ?? return false
    let els = st.find(" else ") ?? return false
    if els < eq {
        return false
    }
    return st[eq..<els].trim_end().ends_with(")")
}

/// R151: whether a `.get(..)` of the line takes a range.
fn rs2nika_get_range(line: String) -> bool {
    let c: Vec[scalar] = line.chars().collect()
    let mut from = 0
    while true {
        let at = rs2nika_find_from(c, ".get(", from)
        if at < 0 {
            return false
        }
        from = at + 1
        let open = at + ".get(".len()
        let arg = rs2nika_text(c, open, rs2nika_group_end(c, open) - 1)
        if arg.contains("..") {
            return true
        }
    }
}


fn rs2nika_expr(mut ctx: Rs2nikaCtx, line: String) -> String {
    let mut s: String = rs2nika_struct_update(ctx, line)
    s = rs2nika_bytes(ctx, s)
    s = rs2nika_decoded(ctx, s)
    s = rs2nika_char_needle(ctx, s)
    for p in ["crate::ast::", "ast::", "crate::types::", "crate::", "contracts::"] {
        if s.contains(p) {
            s = s.replace(p, "")
            rs2nika_hit(ctx, "R28")
        }
    }
    s = rs2nika_ty_paths(s)
    s = rs2nika_ranges(ctx, s)
    s = rs2nika_rest(ctx, s)
    if ctx.profile != "none" && !ctx.impl_other {
        let mut s2: String = s.clone()
        for p in ["self.parsed.text(*", "self.parsed.text(", "self.parsed.name(*", "self.parsed.name(", "self.text(*", "self.text(", "self.name(*", "self.name(", "self.parsed.interner.resolve(*", "self.parsed.interner.resolve("] {
            s2 = s2.replace(p, "world.words.resolve(")
        }
        s2 = rs2nika_replace_free(s2, "parsed.text(*", "parsed.words.resolve(")
        s2 = rs2nika_replace_free(s2, "parsed.text(", "parsed.words.resolve(")
        s2 = rs2nika_replace_free(s2, "parsed.name(*", "parsed.words.resolve(")
        s2 = rs2nika_replace_free(s2, "parsed.name(", "parsed.words.resolve(")
        if !ctx.view {
            for n in ctx.parsed_names {
                for m in [".text(*", ".text(", ".name(*", ".name("] {
                    s2 = rs2nika_replace_free(s2, f"{n}{m}", f"{n}.words.resolve(")
                }
            }
        }
        if !rs2nika_same(s2, s) {
            rs2nika_hit(ctx, "R31")
        }
        s = s2.clone()
        s2 = s2.replace("self.parsed.program.items", "world.items").replace("self.s.", "self.§")
        s2 = rs2nika_replace_word(s2, "self.world", "world")
        s2 = rs2nika_replace_word(s2, "self.s", "self")
        s2 = s2.replace("self.parsed.", "world.")
        if !rs2nika_same(s2, s) {
            rs2nika_hit(ctx, "R32")
        }
        s = s2.clone()
        for m in ctx.methods.clone() {
            let n2 = rs2nika_renamed(ctx, m)
            let mut s3: String = rs2nika_self_call(s, m, n2)
            if ctx.free {
                s3 = rs2nika_state_call(s, m, n2, rs2nika_has(ctx.host_fns, m))
            }
            if !rs2nika_same(s3, s) {
                rs2nika_hit(ctx, "R33")
            }
            s = s3.clone()
        }
        // R77: `self.s.m(..)` calls a `CheckState` method that already moved:
        // its name and arguments stay
        if ctx.free {
            s = s.replace("self.§", "state.")
            // the text `"self"` (a name the program looks for) stays as written
            let s4: String = rs2nika_replace_word(s.replace("\"self\"", "\u{3}"), "self", "state").replace("\u{3}", "\"self\"")
            if s4 != s {
                rs2nika_hit(ctx, "R83")
            }
            s = s4.clone()
        } else {
            s = s.replace("self.§", "self.")
        }
    }
    let mut k = 0
    while k < ctx.renamed_from.len() {
        let from: String = ctx.renamed_from[k].clone()
        let to: String = ctx.renamed_to[k].clone()
        s = rs2nika_replace_free(s, f"{from}(", f"{to}(")
        k = k + 1
    }
    s = rs2nika_matches(ctx, s)
    s = rs2nika_panic(ctx, s)
    s = rs2nika_format(ctx, s)
    s = rs2nika_names(ctx, s)
    s = rs2nika_rep(ctx, s, "String::new()", "\"\"", "R17")
    s = rs2nika_rep(ctx, s, "Vec::new()", "[]", "R17")
    s = rs2nika_rep(ctx, s, "vec![", "[", "R17")
    for m in ["BTreeMap::new()", "HashMap::new()", "BTreeMap::default()", "HashMap::default()"] {
        s = s.replace(f"std::collections::{m}", m)
        s = rs2nika_rep(ctx, s, m, "collections::BTreeMap()", "R17")
    }
    for m in ["BTreeSet::new()", "HashSet::new()", "BTreeSet::default()", "HashSet::default()"] {
        s = s.replace(f"std::collections::{m}", m)
        s = rs2nika_rep(ctx, s, m, "collections::BTreeSet()", "R17")
    }
    s = rs2nika_rep(ctx, s, "Box::new(", "(", "R9")
    for t in [".collect::<Vec<_>>()", ".collect::<String>()", ".collect::<Vec<String>>()"] {
        s = rs2nika_rep(ctx, s, t, ".collect()", "R17")
    }
    s = rs2nika_capacity_char(ctx, s)
    if s.contains("\".to_string()") {
        s = s.replace("\".to_string()", "\"")
        rs2nika_hit(ctx, "R16")
    }
    if s.contains("\".to_owned()") {
        s = s.replace("\".to_owned()", "\"")
        rs2nika_hit(ctx, "R16")
    }
    s = rs2nika_rep(ctx, s, ".to_owned()", ".clone()", "R16")
    s = rs2nika_rep(ctx, s, ".into_owned()", ".clone()", "R16")
    s = rs2nika_tuple_slice(ctx, s)
    // R194: a path to a copying function passed by name copies each element
    for f in ["str::to_string", "str::to_owned", "String::from", "ToString::to_string", "ToOwned::to_owned", "Clone::clone", "String::clone"] {
        s = rs2nika_rep(ctx, s, f"({f})", "(fn(x) { x.clone() })", "R194")
    }
    s = rs2nika_rep(ctx, s, "[..]", "", "R151")
    s = rs2nika_fallbacks(ctx, s)
    s = rs2nika_method_arg(ctx, s, ".unwrap_or_else(", " ?? ", "", "R20")
    // an iterator's `.cloned()` is no option's: it stays, under a TODO
    if !s.contains(".iter()") {
        // written `¿` so that R35 leaves this `?` alone
        s = rs2nika_rep(ctx, s, ".cloned()", "¿.clone()", "R20")
        s = rs2nika_rep(ctx, s, ".copied()", "¿.clone()", "R20")
    }
    s = rs2nika_rep(ctx, s, ".is_some()", " != null", "R21")
    s = rs2nika_rep(ctx, s, ".is_none()", " == null", "R21")
    for m in [".as_ref() {", ".as_slice() {", ".as_str() {", ".as_deref() {", ".borrow() {", ".iter() {"] {
        s = rs2nika_rep(ctx, s, m, " {", "R25")
    }
    for m in [".as_ref()", ".as_slice()", ".as_str()", ".as_deref()", ".borrow()"] {
        s = rs2nika_rep(ctx, s, m, "", "R29")
    }
    s = rs2nika_turbofish(ctx, s)
    s = rs2nika_rep(ctx, s, "None", "null", "R12")
    let t: String = s.trim().clone()
    if t.starts_with("_ =>") {
        let k2 = s.find("_ =>") ?? 0
        let head: String = s[0..<k2].clone()
        let tail: String = s[k2 + "_ =>".len()..<s.len()].clone()
        s = f"{head}else =>{tail}"
        rs2nika_hit(ctx, "R13")
    } else {
        s = rs2nika_rep(ctx, s, " _ =>", " else =>", "R13")
        s = rs2nika_rep(ctx, s, "(_ =>", "(else =>", "R13")
        s = rs2nika_rep(ctx, s, ",_ =>", ",else =>", "R13")
    }
    s = rs2nika_rep(ctx, s, "loop {", "while true {", "R36")
    for m in [" as usize", " as isize", " as u16", " as i32"] {
        s = rs2nika_rep(ctx, s, m, "", "R10")
    }
    // `c as u32` is mostly a `char`'s code: a `scalar` keeps the cast
    s = rs2nika_rep(ctx, s, " as u32", " as i64", "R10")
    s = rs2nika_rep(ctx, s, ".len() as i64", ".len()", "R40")
    s = rs2nika_rep(ctx, s, ".unwrap()", " ?? panic(\"unwrap\")", "R40")
    s = rs2nika_rep(ctx, s, "::default()", "::empty()", "R38")
    s = rs2nika_ty_named(ctx, s)
    s = rs2nika_replace_word(s, "self.parsed", "world")
    s = rs2nika_opt_comb_hit(ctx, s)
    s = rs2nika_adapters(ctx, s)
    s = rs2nika_bool_then(ctx, s)
    s = rs2nika_closures(ctx, s)
    s = rs2nika_starts_any(ctx, s)
    s = rs2nika_some(ctx, s)
    s = rs2nika_derefs(ctx, s)
    s = rs2nika_idioms(ctx, s)
    s = rs2nika_literals(ctx, s)
    if ctx.fn_opt {
        s = rs2nika_question(ctx, s)
    } else {
        s = rs2nika_question_in_lambda(ctx, s)
    }
    if s.contains("¿") {
        s = s.replace("¿", "?")
    }
    return s
}

/// Where the receiver of a method call at `at` starts: a postfix chain of
/// names, `.`, `::` and balanced `(..)`/`[..]`.
fn rs2nika_recv_start(c: ref Vec[scalar], at: i64) -> i64 {
    let mut b = at
    let mut depth = 0
    while b > 0 {
        let p = c[b - 1]
        if p == '>' && depth == 0 {
            // a turbofish `::<T>` is part of the chain (R141)
            let mut k = b - 1
            let mut angle = 0
            while k > 0 {
                if c[k] == '>' {
                    angle = angle + 1
                } else if c[k] == '<' {
                    angle = angle - 1
                    if angle == 0 {
                        break
                    }
                }
                k = k - 1
            }
            if angle == 0 && k >= 2 && c[k - 1] == ':' && c[k - 2] == ':' {
                b = k - 2
                continue
            }
            break
        }
        if p == ')' || p == ']' {
            depth = depth + 1
        } else if p == '(' || p == '[' {
            if depth == 0 {
                break
            }
            depth = depth - 1
        } else if depth == 0 && !(rs2nika_path_char(p) || p == '.') {
            break
        }
        b = b - 1
    }
    return b
}

/// R74: Rust's struct update `S { a: x, b, ..base }` -> `base with { a: x, b: b }`
/// (Part I 4.2).
fn rs2nika_struct_update(mut ctx: Rs2nikaCtx, given: String) -> String {
    if !given.contains("..") || !given.contains("{") {
        return given.clone()
    }
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        if c[at] != '{' {
            out.push(c[at])
            at = at + 1
            continue
        }
        // the type's name before the brace: `S {` or `a::S {`
        let mut e = at
        while e > 0 && c[e - 1] == ' ' {
            e = e - 1
        }
        let mut b = e
        while b > 0 && rs2nika_path_char(c[b - 1]) {
            b = b - 1
        }
        let close = rs2nika_closing(c, at, '{', '}')
        let named = b < e && rs2nika_upper(c[b])
        if !named || close < 0 {
            out.push(c[at])
            at = at + 1
            continue
        }
        let parts = rs2nika_split_args(rs2nika_text(c, at + 1, close))
        let last: String = if parts.len() > 0 { parts[parts.len() - 1].trim().clone() } else { "" }
        if !last.starts_with("..") || last.len() <= 2 || last.starts_with("..=") {
            out.push(c[at])
            at = at + 1
            continue
        }
        let base: String = rs2nika_struct_update(ctx, (last.strip_prefix("..") ?? "").trim())
        let mut fields: Vec[String] = []
        let mut i = 0
        while i + 1 < parts.len() {
            let f: String = rs2nika_struct_update(ctx, parts[i].trim())
            if f.contains(":") {
                fields.push(f)
            } else {
                fields.push(f"{f}: {f}")
            }
            i = i + 1
        }
        let name: String = rs2nika_text(c, b, at)
        let kept: String = (out.strip_suffix(name) ?? "").clone()
        let joined = rs2nika_join(fields, ", ")
        out = f"{kept}{base} with {{ {joined} }}"
        rs2nika_hit(ctx, "R74")
        at = close + 1
    }
    return out
}

/// R73: `cond.then(|| e)` -> `if cond { e } else { null }`.
fn rs2nika_bool_then(mut ctx: Rs2nikaCtx, given: String) -> String {
    if !given.contains(".then(||") {
        return given.clone()
    }
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let hit = at + 8 <= c.len() && rs2nika_text(c, at, at + 8) == ".then(||"
        if !hit {
            out.push(c[at])
            at = at + 1
            continue
        }
        let b = rs2nika_recv_start(c, at)
        let close = rs2nika_closing(c, at + 5, '(', ')')
        if close < 0 || b >= at {
            out.push(c[at])
            at = at + 1
            continue
        }
        let recv: String = rs2nika_text(c, b, at)
        let mut cond: String = recv.clone()
        if cond.starts_with("(") && cond.ends_with(")") && rs2nika_closing(c, b, '(', ')') == at - 1 {
            cond = ((cond.strip_prefix("(") ?? "").strip_suffix(")") ?? "").clone()
        }
        let mut body: String = rs2nika_text(c, at + 8, close).trim().clone()
        if body.starts_with("{") && body.ends_with("}") {
            body = ((body.strip_prefix("{") ?? "").strip_suffix("}") ?? "").trim().clone()
        }
        // drop the receiver already copied to `out`
        let kept: String = (out.strip_suffix(recv) ?? "").clone()
        out = f"{kept}(if {cond} {{ {body} }} else {{ null }})"
        rs2nika_hit(ctx, "R73")
        at = close + 1
    }
    return out
}

/// A receiver that is an iterator, not an `Option`.
/// R96: what R79 and R63 leave of an option's combinator with a closure ->
/// a `match` over the option (ADR-352 D1): `e.is_some_and(|x| p)` -> `(match
/// e { x => p, null => false })`, `e.map_or(d, |x| b)` -> `(match e { x => b,
/// null => d })`, `e.map(|x| b)` / `e.and_then(|x| b)` -> `(match e { x => b,
/// null => null })`. `map`, `and_then` and `map_or` only where `e` is surely
/// an option (its last call is one that hands one back), since a `Result` has
/// them too.
fn rs2nika_comb_match(given: String, opts: ref Vec[String]) -> String {
    let mut s: String = given.clone()
    for name in ["is_some_and", "map_or", "and_then", "map"] {
        let mut from = 0
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let at = rs2nika_find_from(c, f".{name}(", from)
            if at < 0 {
                break
            }
            from = at + 1
            let open = at + name.len() + 1
            let end = rs2nika_closing(c, open, '(', ')')
            if end < 0 {
                break
            }
            let start = rs2nika_recv_start(c, at)
            let mut recv: String = rs2nika_text(c, start, at)
            let mut borrowed = false
            for tail in [".as_ref()", ".as_deref()"] {
                if recv.ends_with(tail) {
                    recv = (recv.strip_suffix(tail) ?? "").clone()
                    borrowed = true
                }
            }
            // R122: an option by its `.as_ref()`, or by a name the file
            // declares `Option<..>`
            if recv == "" || (name != "is_some_and" && !rs2nika_surely_option(recv) && !borrowed && !rs2nika_named_option(recv, opts)) {
                continue
            }
            let mut arg: String = rs2nika_text(c, open + 1, end).trim().clone()
            let mut none: String = "null"
            if name == "is_some_and" {
                none = "false"
            } else if name == "map_or" {
                let comma = arg.find(", |") ?? arg.rfind(", ") ?? continue
                none = arg[0..<comma].trim().clone()
                arg = arg[comma + ", ".len()..<arg.len()].trim().clone()
            }
            // R121: a function's path for the closure -> its call on the value
            let lead = arg.chars().next() ?? '0'
            if rs2nika_is_path(arg) && !lead.is_ascii_digit() &&!rs2nika_iter_recv(recv) {
                let pre: String = rs2nika_text(c, 0, start)
                let post: String = rs2nika_text(c, end + 1, c.len())
                let call = rs2nika_path_call(arg, "x")
                s = f"{pre}(match {recv} {{ x => {call}, null => {none} }}){post}"
                from = 0
                continue
            }
            if !arg.starts_with("|") || arg.starts_with("||") {
                continue
            }
            let ac: Vec[scalar] = arg.chars().collect()
            let mut bar = 1
            let mut depth = 0
            while bar < ac.len() && !(ac[bar] == '|' && depth == 0) {
                if ac[bar] == '(' {
                    depth = depth + 1
                } else if ac[bar] == ')' {
                    depth = depth - 1
                }
                bar = bar + 1
            }
            if bar >= ac.len() {
                continue
            }
            let pat: String = rs2nika_text(ac, 1, bar).replace("&", "").trim().clone()
            let body: String = rs2nika_text(ac, bar + 1, ac.len()).trim().clone()
            // a `?` in the closure leaves the closure, not the function; a
            // `match` in it would hand R12 a second `=>`
            if pat == "" || pat.contains(":") || body == "" || body.contains("?") || body.contains("=>") || recv.starts_with(".") || (start > 0 && c[start - 1] == '?') {
                continue
            }
            let pre: String = rs2nika_text(c, 0, start)
            let post: String = rs2nika_text(c, end + 1, c.len())
            s = f"{pre}(match {recv} {{ {pat} => {body}, null => {none} }}){post}"
            from = 0
        }
    }
    return s
}

/// For R121: the call of the function at `path` on `x`: `x.m()` for a
/// method by its name (`Type::as_str`, `str::to_string`), else `path(x)`.
fn rs2nika_path_call(path: String, x: String) -> String {
    let parts: Vec[String] = path.split("::").map(fn(p) { p.to_string() }).collect()
    if parts.len() >= 2 {
        let m: String = parts[parts.len() - 1].clone()
        let ty: String = parts[parts.len() - 2].clone()
        let first = ty.chars().next() ?? 'a'
        let typed = first.is_uppercase() || ty == "str"
        let method = m.starts_with("as_") || m.starts_with("to_") || m.starts_with("is_") || m.starts_with("into_") || m == "len" || m == "clone" || m == "trim"
        if typed && method {
            return f"{x}.{m}()"
        }
    }
    return f"{path}({x})"
}

/// `};` -> `}` outside a string literal: a block's `;` goes, a `{x};` in a
/// `format!` text stays (R208).
fn rs2nika_block_semis(code: String) -> String {
    let c: Vec[scalar] = code.chars().collect()
    let mut out: String = ""
    let mut quoted = false
    let mut at = 0
    while at < c.len() {
        let ch = c[at]
        if quoted && ch == '\\' && at + 1 < c.len() {
            out.push(ch)
            out.push(c[at + 1])
            at = at + 2
            continue
        }
        // a character `'"'` or `'\"'` opens no text
        if !quoted && ch == '\'' && at + 2 < c.len() && c[at + 2] == '\'' {
            out.push_str(rs2nika_text(c, at, at + 3))
            at = at + 3
            continue
        }
        if !quoted && ch == '\'' && at + 3 < c.len() && c[at + 1] == '\\' && c[at + 3] == '\'' {
            out.push_str(rs2nika_text(c, at, at + 4))
            at = at + 4
            continue
        }
        if ch == '"' {
            quoted = !quoted
        }
        out.push(ch)
        if !quoted && ch == '}' && at + 1 < c.len() && c[at + 1] == ';' {
            at = at + 1
        }
        at = at + 1
    }
    return out
}

/// For R52: the names a file declares `&Parsed` (`unit: &Parsed`), other
/// than `parsed`, whose `.text(x)` is the world's `words.resolve(x)`.
fn rs2nika_parsed_names(src: String) -> Vec[String] {
    let mut names: Vec[String] = []
    let c: Vec[scalar] = src.chars().collect()
    let mut from = 0
    while true {
        let at = rs2nika_find_from(c, ": &Parsed", from)
        if at < 0 {
            break
        }
        from = at + 1
        let end = at + ": &Parsed".len()
        if end < c.len() && rs2nika_word(c[end]) {
            continue
        }
        let mut b = at
        while b > 0 && rs2nika_word(c[b - 1]) {
            b = b - 1
        }
        let name: String = rs2nika_text(c, b, at)
        if name != "" && name != "parsed" && !names.contains(name) {
            names.push(name)
        }
    }
    return names
}

/// For R122: the names a file declares `Option<..>` (a parameter, a field, a
/// typed `let`): `name: Option<`, `name: &Option<`, `name: &mut Option<`.
fn rs2nika_opt_names(src: String) -> Vec[String] {
    let mut names: Vec[String] = []
    let c: Vec[scalar] = src.chars().collect()
    for decl in [": Option<", ": &Option<", ": &mut Option<"] {
        let mut from = 0
        while true {
            let at = rs2nika_find_from(c, decl, from)
            if at < 0 {
                break
            }
            from = at + 1
            let mut b = at
            while b > 0 && rs2nika_word(c[b - 1]) {
                b = b - 1
            }
            let name: String = rs2nika_text(c, b, at)
            if name != "" && !names.contains(name) {
                names.push(name)
            }
        }
    }
    // a function of the file that hands back an option: `NAME(` stands for
    // its call
    let mut from = 0
    while true {
        let at = rs2nika_find_from(c, "fn ", from)
        if at < 0 {
            break
        }
        from = at + 1
        if at > 0 && rs2nika_word(c[at - 1]) {
            continue
        }
        let mut e = at + "fn ".len()
        while e < c.len() && rs2nika_word(c[e]) {
            e = e + 1
        }
        let mut body = e
        while body < c.len() && c[body] != '{' && c[body] != ';' {
            body = body + 1
        }
        let sig: String = rs2nika_text(c, e, body)
        let name: String = rs2nika_text(c, at + "fn ".len(), e)
        if name != "" && sig.trim_end().ends_with(">") && (sig.contains("-> Option<") || sig.contains("-> Option <")) {
            names.push(f"{name}(")
        }
    }
    return names
}

/// For R122: the names a `let` binds to a value that surely is an option
/// (R96's test), where no other `let` of the file binds the same name to
/// something else.
fn rs2nika_opt_lets(lines: ref Vec[String], opts: ref Vec[String]) -> Vec[String] {
    let mut sure: Vec[String] = []
    let mut other: Vec[String] = []
    for line in lines {
        let st: String = line.trim().clone()
        let mut rest: String = (st.strip_prefix("let ") ?? continue).clone()
        if rest.starts_with("mut ") {
            rest = (rest.strip_prefix("mut ") ?? "").clone()
        }
        let eq = rest.find(" = ") ?? continue
        let name: String = rest[0..<eq].trim().clone()
        let mut value: String = rest[eq + " = ".len()..<rest.len()].trim().clone()
        if value.ends_with(";") {
            value = value[0..<value.len() - ";".len()].trim().clone()
        }
        let mut word = name != ""
        for ch in name.chars() {
            if !rs2nika_word(ch) {
                word = false
            }
        }
        if !word {
            continue
        }
        let mut borrowed = false
        for tail in [".as_ref()", ".as_deref()"] {
            if value.ends_with(tail) {
                borrowed = true
            }
        }
        if rs2nika_surely_option(value) || borrowed || rs2nika_named_option(value, opts) {
            sure.push(name)
        } else {
            other.push(name)
        }
    }
    let mut out: Vec[String] = []
    for n in sure {
        if !other.contains(n) && !out.contains(n) {
            out.push(n.clone())
        }
    }
    return out
}

/// For R122: whether a receiver is a name of `opts`, or a path of fields
/// ending in one (no call, no index on the way).
fn rs2nika_named_option(recv: String, opts: ref Vec[String]) -> bool {
    let mut r: String = recv.clone()
    while r.starts_with("*") || r.starts_with("&") {
        r = (r.strip_prefix("*") ?? r.strip_prefix("&") ?? "").clone()
    }
    // a call of a function of the file that hands back an option
    if r.ends_with(")") {
        let rc: Vec[scalar] = r.chars().collect()
        let mut depth = 0
        let mut at = rc.len() - 1
        while at >= 0 {
            if rc[at] == ')' {
                depth = depth + 1
            } else if rc[at] == '(' {
                depth = depth - 1
                if depth == 0 {
                    break
                }
            }
            at = at - 1
        }
        let mut b = at
        while b > 0 && rs2nika_word(rc[b - 1]) {
            b = b - 1
        }
        let callee: String = rs2nika_text(rc, b, at)
        // `m::f(` is another module's `f`
        let other = b > 0 && rc[b - 1] == ':'
        return at > 0 && callee != "" && !other && opts.contains(f"{callee}(")
    }
    for ch in r.chars() {
        if !(rs2nika_word(ch) || ch == '.') {
            return false
        }
    }
    let c: Vec[scalar] = r.chars().collect()
    let mut b = c.len()
    while b > 0 && rs2nika_word(c[b - 1]) {
        b = b - 1
    }
    let last: String = rs2nika_text(c, b, c.len())
    return last != "" && opts.contains(last)
}

/// For R96: whether a receiver surely is an `Option`, by the call it ends in.
fn rs2nika_surely_option(recv: String) -> bool {
    if recv.starts_with("(match ") && recv.ends_with("})") {
        return true
    }
    for m in [".ok()", ".err()", ".next()", ".next_back()", ".first()", ".last()", ".file_name()", ".extension()", ".file_stem()", ".parent()", ".pop()"] {
        if recv.ends_with(m) {
            return true
        }
    }
    let c: Vec[scalar] = recv.chars().collect()
    // a `Seq` chain's `filter` hands back a `Seq` (R110)
    if !recv.ends_with(")") || rs2nika_seq_before(c, c.len()) {
        return false
    }
    let mut depth = 0
    let mut at = c.len() - 1
    while at >= 0 {
        if c[at] == ')' {
            depth = depth + 1
        } else if c[at] == '(' {
            depth = depth - 1
            if depth == 0 {
                break
            }
        }
        at = at - 1
    }
    let head: String = rs2nika_text(c, 0, at)
    for m in [".get", ".find", ".nth", ".split_once", ".rsplit_once", ".strip_prefix", ".strip_suffix", ".find_map", ".position", ".checked_sub", ".checked_add", ".get_mut", ".remove", ".and_then", ".filter", ".or_else", ".rfind", ".max_by_key", ".min_by_key", ".rposition"] {
        if head.ends_with(m) {
            return true
        }
    }
    return false
}

fn rs2nika_iter_recv(recv: String) -> bool {
    for m in ["iter()", "chars()", "lines()", "bytes()", "split", "keys()", "values()", "windows(", "drain(", "args()", "zip("] {
        if recv.contains(m) {
            return true
        }
    }
    return false
}

/// R79: `o.map(|x| x.f)` -> `o?.f`, `o.and_then(|x| x.g())` -> `o?.g()`,
/// `o.is_some_and(|x| x.p())` -> `(o?.p() ?? false)`, `o.map_or(d, |x| x.f)`
/// -> `(o?.f ?? d)`; every step of the chain gets its own `?.`. The `?` is
/// written `¿` until R35 has run.
/// R79 with its hit counted.
fn rs2nika_opt_comb_hit(mut ctx: Rs2nikaCtx, given: String) -> String {
    let out: String = rs2nika_opt_comb(given)
    if out != given {
        rs2nika_hit(ctx, "R79")
    }
    let general: String = rs2nika_some_and(out)
    if general != out {
        rs2nika_hit(ctx, "R63")
    }
    let matched: String = rs2nika_comb_match(general, ctx.opt_names)
    if matched != general {
        rs2nika_hit(ctx, "R96")
    }
    return matched
}

/// R63: what R79 leaves of `o.is_some_and(f)` on a plain path `o`, `o`
/// read once: `o.is_some_and(|x| p)` -> `(match o { x => p, null => false })`,
/// `o.is_some_and(f)` -> `(match o { value => f(value), null => false })`.
fn rs2nika_some_and(given: String) -> String {
    let mut s: String = given.clone()
    let mut from = 0
    while true {
        let c: Vec[scalar] = s.chars().collect()
        let at = rs2nika_find_from(c, ".is_some_and(", from)
        if at < 0 {
            break
        }
        from = at + 1
        let open = at + 12
        let end = rs2nika_closing(c, open, '(', ')')
        if end < 0 {
            break
        }
        let start = rs2nika_recv_start(c, at)
        let mut recv: String = rs2nika_text(c, start, at)
        for tail in [".as_ref()", ".as_deref()", ".as_mut()"] {
            if recv.ends_with(tail) {
                recv = (recv.strip_suffix(tail) ?? "").clone()
            }
        }
        if recv == "" || recv.contains("(") || recv.contains("[") {
            continue
        }
        let arg: String = rs2nika_text(c, open + 1, end).trim().clone()
        let closure = arg.starts_with("|")
        if !closure && !rs2nika_is_path(arg) {
            continue
        }
        // the option read once, its value bound by an arm (ADR-352)
        let mut v: String = "value"
        let mut body: String = f"{arg}(value)"
        if closure {
            let after: String = (arg.strip_prefix("|") ?? "").clone()
            let bar = after.find("|") ?? continue
            v = after[0..<bar].replace("&", "").trim().clone()
            body = after[bar + 1..<after.len()].trim().clone()
            if body.starts_with("{") && body.ends_with("}") {
                body = ((body.strip_prefix("{") ?? "").strip_suffix("}") ?? "").trim().clone()
            }
            if !rs2nika_is_path(v) || v.contains(":") || body.contains(";") {
                continue
            }
            body = body.replace(f"*{v}", v)
        }
        let pre: String = rs2nika_text(c, 0, start)
        let post: String = rs2nika_text(c, end + 1, c.len())
        s = f"{pre}(match {recv} {{ {v} => {body}, null => false }}){post}"
        from = 0
    }
    return s
}

fn rs2nika_opt_comb(given: String) -> String {
    let mut s: String = given.clone()
    for name in ["map", "and_then", "is_some_and", "map_or"] {
        let mut from = 0
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let at = rs2nika_find_from(c, f".{name}(", from)
            if at < 0 {
                break
            }
            from = at + 1
            let open = at + name.len() + 1
            let end = rs2nika_closing(c, open, '(', ')')
            if end < 0 {
                break
            }
            let start = rs2nika_recv_start(c, at)
            let recv: String = rs2nika_text(c, start, at)
            if recv == "" || rs2nika_iter_recv(recv) {
                continue
            }
            let mut arg: String = rs2nika_text(c, open + 1, end).trim().clone()
            let mut dflt: String = ""
            if name == "map_or" {
                let comma = arg.find(", |") ?? continue
                dflt = arg[0..<comma].trim().clone()
                arg = arg[comma + ", ".len()..<arg.len()].clone()
            }
            if !arg.starts_with("|") {
                continue
            }
            let after: String = (arg.strip_prefix("|") ?? "").clone()
            let bar = after.find("|") ?? continue
            let v: String = after[0..<bar].trim().clone()
            let mut body: String = after[bar + 1..<after.len()].trim().clone()
            if body.starts_with("&") {
                body = (body.strip_prefix("&") ?? "").clone()
            }
            let vd = body.find(".") ?? 0
            let head_v: String = body[0..<vd].clone()
            if !rs2nika_is_path(v) || v.contains(":") || head_v != v {
                continue
            }
            let rest: String = body[vd + ".".len()..<body.len()].clone()
            if rs2nika_replace_word(rest, v, "#") != rest {
                continue
            }
            let rc: Vec[scalar] = rest.chars().collect()
            if rest == "" || rs2nika_recv_start(rc, rc.len()) != 0 {
                continue
            }
            let mut chain: String = "¿."
            let mut depth = 0
            for ch in rc {
                if ch == '(' || ch == '[' {
                    depth = depth + 1
                } else if ch == ')' || ch == ']' {
                    depth = depth - 1
                }
                if ch == '.' && depth == 0 {
                    chain.push_str("¿.")
                } else {
                    chain.push(ch)
                }
            }
            let pre: String = rs2nika_text(c, 0, start)
            let post: String = rs2nika_text(c, end + 1, c.len())
            if name == "is_some_and" {
                s = f"{pre}({recv}{chain} ?? false){post}"
            } else if name == "map_or" {
                s = f"{pre}({recv}{chain} ?? {dflt}){post}"
            } else {
                s = f"{pre}{recv}{chain}{post}"
            }
            from = 0
        }
    }
    return s
}

/// R80: `String::with_capacity(n)` -> `""`; R57: `x as char` -> `(x as u8) as scalar`.
fn rs2nika_capacity_char(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    let eq = s.find(" = String::with_capacity(") ?? 0
    let lhs: String = s[0..<eq].clone()
    if eq > 0 && lhs.trim_start().starts_with("let ") && !lhs.contains(":") {
        s = s.replace(" = String::with_capacity(", ": String = String::with_capacity(")
    }
    while true {
        let c: Vec[scalar] = s.chars().collect()
        let at = rs2nika_find_from(c, "String::with_capacity(", 0)
        if at < 0 {
            break
        }
        let end = rs2nika_closing(c, at + 21, '(', ')')
        if end < 0 {
            break
        }
        let pre: String = rs2nika_text(c, 0, at)
        let post: String = rs2nika_text(c, end + 1, c.len())
        s = f"{pre}\"\"{post}"
        rs2nika_hit(ctx, "R80")
    }
    while true {
        let c: Vec[scalar] = s.chars().collect()
        let at = rs2nika_find_from(c, " as char", 0)
        if at < 0 {
            break
        }
        let start = rs2nika_recv_start(c, at)
        let x: String = rs2nika_text(c, start, at)
        let pre: String = rs2nika_text(c, 0, start)
        let post: String = rs2nika_text(c, at + 8, c.len())
        s = f"{pre}({x} as u8) as scalar{post}"
        rs2nika_hit(ctx, "R57")
    }
    return s
}

fn rs2nika_renamed(ctx: ref Rs2nikaCtx, name: String) -> String {
    let mut k = 0
    while k < ctx.renamed_from.len() {
        if ctx.renamed_from[k] == name {
            return ctx.renamed_to[k].clone()
        }
        k = k + 1
    }
    return name.clone()
}

/// `self.m(` -> `self.m2(world, `, and `(world, )` -> `(world)` (R33).
fn rs2nika_self_call(s: String, m: String, n2: String) -> String {
    let c: Vec[scalar] = s.chars().collect()
    let pat = f"self.{m}("
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let i = rs2nika_find_from(c, pat, at)
        if i < 0 {
            out.push_str(rs2nika_text(c, at, c.len()))
            return out.replace("(world, )", "(world)")
        }
        out.push_str(rs2nika_text(c, at, i))
        out.push_str(f"self.{n2}(world, ")
        at = i + pat.chars().count()
        while at < c.len() && (c[at] == ' ' || c[at] == '\t') {
            at = at + 1
        }
    }
    return out.replace("(world, )", "(world)")
}

/// R83: `self.m(a)` -> `m2(state, world, host, a)`, `self.m()` -> `m2(state, world, host)`.
fn rs2nika_state_call(s: String, m: String, n2: String, host: bool) -> String {
    let mut passed = "(state, world, host, "
    if !host {
        passed = "(state, world, "
    }
    let c: Vec[scalar] = s.chars().collect()
    let pat = f"self.{m}("
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let i = rs2nika_find_from(c, pat, at)
        if i < 0 {
            out.push_str(rs2nika_text(c, at, c.len()))
            return out.replace("(state, world, host, )", "(state, world, host)").replace("(state, world, )", "(state, world)")
        }
        out.push_str(rs2nika_text(c, at, i))
        out.push_str(f"{n2}{passed}")
        at = i + pat.chars().count()
        while at < c.len() && (c[at] == ' ' || c[at] == '\t') {
            at = at + 1
        }
    }
    return out.replace("(state, world, host, )", "(state, world, host)").replace("(state, world, )", "(state, world)")
}

/// R83: the methods of the input that need the host: their text names `host`,
/// or they call (`self.m(`) one that does. The others take no `host`.
fn rs2nika_host_fns(mut ctx: Rs2nikaCtx, src: String) {
    let mut cur: String = ""
    let mut edges: Vec[String] = []
    for raw in src.split("\n") {
        let name = rs2nika_fn_name(raw)
        if name != "" {
            if rs2nika_takes_self(raw) {
                cur = name.clone()
            } else if rs2nika_indent(raw).len() <= 4 {
                cur = ""
            }
        }
        if cur == "" {
            continue
        }
        // `fn host(` and `self.host(` name the method, not the parameter
        let body: String = raw.replace("self.host(", "self.\u{a7}(").replace("fn host(", "fn \u{a7}(").replace("host::", "\u{a7}::")
        if (rs2nika_replace_word(body, "host", "\u{a7}") != body || raw.contains("self.s.")) && !rs2nika_has(ctx.host_fns, cur) {
            ctx.host_fns.push(cur.clone())
        }
        for m in ctx.methods.clone() {
            if raw.contains(f"self.{m}(") {
                edges.push(f"{cur}>{m}")
            }
        }
    }
    let mut changed = true
    while changed {
        changed = false
        for e in edges.clone() {
            let parts = e.split(">").collect()
            let a: String = parts[0].clone()
            let b: String = parts[1].clone()
            if rs2nika_has(ctx.host_fns, b) && !rs2nika_has(ctx.host_fns, a) {
                ctx.host_fns.push(a.clone())
                changed = true
            }
        }
    }
}

fn rs2nika_has(names: ref Vec[String], name: String) -> bool {
    for n in names {
        if n == name {
            return true
        }
    }
    return false
}

/// The parameters of a signature line contain `self`.
fn rs2nika_takes_self(line: String) -> bool {
    let open = line.find("(") ?? return false
    let rest: String = line[open..<line.len()].clone()
    return rest.contains("self")
}

/// R26: `|x| e` and `|x| { .. }` -> `fn(x) { e }`, after `(`, `,` or `=`.
fn rs2nika_closures(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let mut bar = at
        if c[at] == 'm' && at + 5 < c.len() && rs2nika_text(c, at, at + 5) == "move " {
            bar = at + 5
            while bar < c.len() && c[bar] == ' ' {
                bar = bar + 1
            }
        }
        // `&|a: T| e`: a callback passed by reference is the lambda itself
        if c[at] == '&' && at + 1 < c.len() && c[at + 1] == '|' {
            bar = at + 1
        }
        let after_open = at > 0 && rs2nika_in(c[at - 1], "(,=")
        let after_space = at > 1 && c[at - 1] == ' ' && rs2nika_in(c[at - 2], "(,=")
        if bar < c.len() && c[bar] == '|' && (after_open || after_space) && !(bar + 1 < c.len() && c[bar + 1] == '|') {
            let mut close = bar + 1
            while close < c.len() && c[close] != '|' {
                close = close + 1
            }
            if close >= c.len() {
                out.push(c[at])
                at = at + 1
                continue
            }
            let raw = rs2nika_text(c, bar + 1, close).replace("&", "").replace("(", "").replace(")", "")
            let mut names: Vec[String] = []
            for a in raw.split(",") {
                if a.trim() != "" {
                    let whole = a.len()
                    let colon = a.find(":") ?? whole
                    names.push(a[0..<colon].trim().clone())
                }
            }
            let mut b = close + 1
            while b < c.len() && (c[b] == ' ' || c[b] == '\t') {
                b = b + 1
            }
            let block = b < c.len() && c[b] == '{'
            let mut d = 0
            let mut j = b
            while j < c.len() {
                let ch = c[j]
                if ch == '(' || ch == '[' || ch == '{' {
                    d = d + 1
                } else if ch == ')' || ch == ']' || ch == '}' {
                    if d == 0 {
                        break
                    }
                    d = d - 1
                    if block && d == 0 {
                        j = j + 1
                        break
                    }
                } else if ch == ',' && d == 0 {
                    break
                }
                j = j + 1
            }
            let args0 = rs2nika_join(names, ", ")
            if block && d > 0 {
                // the block closes on a later line: open the closure here
                out.push_str(f"fn({args0}) {{")
                rs2nika_hit(ctx, "R26")
                at = b + 1
                continue
            }
            if !block && d > 0 && j == c.len() {
                // `|x| match x {` whose arms follow: the closure opens here
                // and R185 closes it after the `match`
                out.push_str(f"fn({args0}) {{ {rs2nika_text(c, b, j).trim()}")
                rs2nika_hit(ctx, "R26")
                at = j
                continue
            }
            let mut body: String = rs2nika_text(c, b, j).trim().clone()
            let mut semi: String = ""
            if !block && j == c.len() && body.ends_with(";") {
                body = body[0..<body.len() - ";".len()].trim_end().clone()
                semi = ";"
            }
            if block {
                body = (body.bytes[1..<body.len() - 1].text() catch { "" }).trim().clone()
            }
            // a closure nested in this one's body is rewritten too
            body = rs2nika_closures(ctx, body)
            // R65: `?` in a lambda leaves the lambda with `null` (5.3: a
            // lambda's `return` leaves the lambda)
            if body.contains("?;") || body.ends_with("?") {
                body = body.replace("?;", " ?? return null;")
                if body.ends_with("?") {
                    let cut: String = body[0..<body.len() - "?".len()].clone()
                    body = f"{cut} ?? return null"
                }
                rs2nika_hit(ctx, "R65")
            }
            let args = rs2nika_join(names, ", ")
            out.push_str(f"fn({args}) {{ {body} }}{semi}")
            rs2nika_hit(ctx, "R26")
            at = j
            continue
        }
        out.push(c[at])
        at = at + 1
    }
    return out
}

/// R65: `x.starts_with(['a', 'b'])` -> `(x.starts_with('a') || x.starts_with('b'))`
/// (`str::starts_with` takes one text or one character); a `use` inside a
/// function stays, for R100 to lift to the top of the file.
fn rs2nika_starts_any(mut ctx: Rs2nikaCtx, given: String) -> String {
    let t: String = given.trim().clone()
    if t.starts_with("use ") && given.starts_with(" ") {
        return given.clone()
    }
    let mut s: String = given.clone()
    while true {
        let c: Vec[scalar] = s.chars().collect()
        let at = rs2nika_find_from(c, ".starts_with([", 0)
        if at < 0 {
            break
        }
        let open = at + 13
        let end = rs2nika_closing(c, open, '[', ']')
        if end < 0 || end + 1 >= c.len() || c[end + 1] != ')' {
            break
        }
        let start = rs2nika_recv_start(c, at)
        let recv: String = rs2nika_text(c, start, at)
        let items: String = rs2nika_text(c, open + 1, end)
        let mut parts: Vec[String] = []
        for item in items.split(",") {
            if item.trim() != "" {
                parts.push(f"{recv}.starts_with({item.trim()})")
            }
        }
        let pre: String = rs2nika_text(c, 0, start)
        let post: String = rs2nika_text(c, end + 2, c.len())
        let joined = rs2nika_join(parts, " || ")
        s = f"{pre}({joined}){post}"
        rs2nika_hit(ctx, "R65")
    }
    return s
}

/// R100: a `use` inside a `fn` or `mod` block -> once at the top of the file,
/// after the file's own `use` lines; `use super::x` drops (Nikaia keeps the
/// module and its tests in one file).
fn rs2nika_lift_uses(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut body: Vec[String] = []
    let mut lifted: Vec[String] = []
    let mut i = 0
    while i < given.len() {
        let l: String = given[i].clone()
        let st: String = l.trim().clone()
        i = i + 1
        if !l.starts_with(" ") || !st.starts_with("use ") {
            body.push(l)
            continue
        }
        let mut u: String = st.clone()
        if u.ends_with("{") {
            // a list over several lines -> one line
            let mut items: Vec[String] = []
            while i < given.len() && !given[i].trim().starts_with("}") {
                items.push(given[i].trim().clone())
                i = i + 1
            }
            i = i + 1
            let mut inner: String = rs2nika_join(items, " ")
            if inner.ends_with(",") {
                inner = inner[0..<inner.len() - ",".len()].clone()
            }
            u = f"{u}{inner}}}"
        }
        if u.ends_with(";") {
            u = u[0..<u.len() - ";".len()].clone()
        }
        rs2nika_hit(ctx, "R100")
        if u.starts_with("use super::") {
            if u.contains(" as ") {
                body.push(f"{rs2nika_indent(l)}// TODO(rs2nika): `{u}`: Nikaia has no `super`; write the item's own name where this block names the alias")
            }
            continue
        }
        // R189: a tools file imports from `std` only
        if !u.starts_with("use std::") {
            rs2nika_hit(ctx, "R189")
            continue
        }
        if !lifted.contains(u) {
            lifted.push(u)
        }
    }
    if lifted.len() == 0 {
        return body
    }
    // after the file's own `use` lines, or after its leading comments
    let mut at = 0
    let mut found = false
    let mut k = 0
    let mut own: Vec[String] = []
    while k < body.len() {
        let l: String = body[k].clone()
        if l.starts_with("use ") || l.starts_with("pub use ") {
            let mut whole: String = l.trim().clone()
            if whole.ends_with("{") {
                while k + 1 < body.len() && !body[k].starts_with("}") {
                    k = k + 1
                    whole = f"{whole} {body[k].trim()}"
                }
            }
            own.push(whole)
            at = k + 1
            found = true
        }
        k = k + 1
    }
    if !found {
        while at < body.len() && body[at].starts_with("//") {
            at = at + 1
        }
    }
    let mut out: Vec[String] = []
    k = 0
    while k < at {
        out.push(body[k].clone())
        k = k + 1
    }
    for u in lifted {
        if !own.contains(u) {
            out.push(u.clone())
        }
    }
    if !found && at < body.len() && body[at].trim() != "" {
        out.push("")
    }
    while k < body.len() {
        out.push(body[k].clone())
        k = k + 1
    }
    return out
}

/// The kind of global a Rust `static` line is, as the TODO that says where
/// it goes (R102); `""` for a line that is no `static` or holds a constant.
fn rs2nika_static_todo(st: String) -> String {
    let mut rest: String = st.clone()
    for p in ["pub(crate) ", "pub(super) ", "pub "] {
        if rest.starts_with(p) {
            rest = (rest.strip_prefix(p) ?? "").clone()
        }
    }
    if !rest.starts_with("static ") {
        return ""
    }
    let no_global = "no globals in tools/*.nika;"
    if rest.starts_with("static mut ") {
        return f"`static mut`: {no_global} a field of the state struct, set through `mut self`"
    }
    let eq = rest.find(" =") ?? rest.len()
    let ty: String = rest[0..<eq].clone()
    if ty.contains("Atomic") {
        return f"`static` atomic: {no_global} an `i64` field of the state struct, counted through `mut self`"
    }
    if ty.contains("Mutex<") || ty.contains("RwLock<") {
        return f"`static` behind a lock: {no_global} a field of the state struct (the lock drops), set through `mut self`"
    }
    if ty.contains("Cell<") {
        return f"`static` cell of a `thread_local!`: {no_global} a field of the state struct (the cell drops), set through `mut self`"
    }
    if ty.contains("OnceLock<") || ty.contains("LazyLock<") || ty.contains("OnceCell<") || ty.contains("Lazy<") {
        return f"`static` computed once: a `comptime` where its value is known at build time, else a field of the state struct filled at its first use"
    }
    if !rest.ends_with(";") || !rest.contains(" = ") {
        return f"`static`: {no_global} a `comptime` if it holds a constant, else a field of the state struct"
    }
    return ""
}

/// R101: a `static` that holds a constant -> `comptime`; R102 counts one that
/// is a global (its TODO comes from `rs2nika_static_todo`). `""` for any
/// other line.
fn rs2nika_static(mut ctx: Rs2nikaCtx, raw: String) -> String {
    let st: String = raw.trim().clone()
    let mut vis: String = ""
    let mut rest: String = st.clone()
    for p in ["pub(crate) ", "pub(super) ", "pub "] {
        if rest.starts_with(p) {
            rest = (rest.strip_prefix(p) ?? "").clone()
            vis = "pub "
        }
    }
    if !rest.starts_with("static ") {
        return ""
    }
    if rs2nika_static_todo(st) != "" {
        rs2nika_hit(ctx, "R102")
        return ""
    }
    return rs2nika_comptime(ctx, raw, vis, rest["static ".len()..<rest.len() - ";".len()].clone(), "R101")
}

/// R103: a `const NAME: T = v;` (also `pub(crate)`, inside a function, or
/// lifted out of an `impl` by R105) -> `comptime NAME: T = v`, the type by the
/// rules of R101; `const fn` is R104's. `""` for any other line.
fn rs2nika_const(mut ctx: Rs2nikaCtx, raw: String) -> String {
    let st: String = raw.trim().clone()
    let mut vis: String = ""
    let mut rest: String = st.clone()
    for p in ["pub(crate) ", "pub(super) ", "pub "] {
        if rest.starts_with(p) {
            rest = (rest.strip_prefix(p) ?? "").clone()
            vis = "pub "
        }
    }
    if !rest.starts_with("const ") || rest.starts_with("const fn ") || rest.starts_with("const unsafe ") {
        return ""
    }
    let ind = rs2nika_indent(raw)
    if !rest.ends_with(";") || !rest.contains(" = ") {
        rs2nika_hit(ctx, "R103")
        return f"{ind}// TODO(rs2nika): a `const` without a value on one line: `comptime NAME: T = v`\n{raw}"
    }
    let body: String = rest["const ".len()..<rest.len() - ";".len()].clone()
    let eq = body.find(" = ") ?? 0
    let value: String = body[eq + " = ".len()..].trim().clone()
    if value.contains("!(") {
        rs2nika_hit(ctx, "R103")
        let mac: String = value[0..<(value.find("!(") ?? 0)].clone()
        return f"{ind}// TODO(rs2nika): `const` from the macro `{mac}!`: no build-time macros in Nikaia; a `comptime` of the value, or a field the host fills\n{raw}"
    }
    let colon = body.find(":") ?? 0
    if colon == 0 || eq < colon {
        return ""
    }
    let ty: String = rs2nika_lifetimes(body[colon + ":".len()..<eq].clone()).replace(" ", "").replace("&str", "")
    let mut inner: String = ty.clone()
    if ty.starts_with("&[") {
        inner = ty["&[".len()..].clone()
    }
    if inner.contains("&") {
        rs2nika_hit(ctx, "R103")
        return f"{ind}// TODO(rs2nika): `const` of nested references: a `comptime` list holds values of one length type; a table as `Array`s of pairs, or a `match` in a function\n{raw}"
    }
    if ty == "char" || ty.contains("[char") || ty.contains("(char") || ty.contains(",char") || ty.contains("128") {
        rs2nika_hit(ctx, "R103")
        return f"{ind}// TODO(rs2nika): `const` of a `char` or a 128-bit integer: a `comptime` holds integers up to 64 bits, floats, `bool`, text, lists, pairs and structs (Part II 10.2)\n{raw}"
    }
    return rs2nika_comptime(ctx, raw, vis, body, "R103")
}

/// The text of a `const` item after its visibility and `const `; `""` for a
/// line that is no `const` item (a `const fn` is none).
fn rs2nika_const_rest(line: String) -> String {
    let mut rest: String = line.trim().clone()
    for p in ["pub(crate) ", "pub(super) ", "pub "] {
        if rest.starts_with(p) {
            rest = (rest.strip_prefix(p) ?? "").clone()
        }
    }
    if !rest.starts_with("const ") || rest.starts_with("const fn ") || rest.starts_with("const unsafe ") {
        return ""
    }
    return rest["const ".len()..].clone()
}

/// The name a `const` item declares; `""` for any other line.
fn rs2nika_const_name(line: String) -> String {
    let rest = rs2nika_const_rest(line)
    let colon = rest.find(":") ?? 0
    return rest[0..<colon].trim().clone()
}

/// R104: `const fn` -> `fn` (any function may run at build time, Part II 10.2).
fn rs2nika_const_fn(mut ctx: Rs2nikaCtx, line: String) -> String {
    let ind = rs2nika_indent(line)
    let st: String = line.trim_start().clone()
    for p in ["pub(crate) ", "pub(super) ", "pub ", ""] {
        if st.starts_with(f"{p}const fn ") {
            rs2nika_hit(ctx, "R104")
            let after: String = (st.strip_prefix(f"{p}const fn ") ?? "").clone()
            return f"{ind}{p}fn {after}"
        }
    }
    return line.clone()
}

/// The type an `impl` head is for: `impl<T> Trait for Foo<T> {` -> `Foo`.
/// The last word outside `<..>` before `where` or `{`, as the type is the
/// last segment of the path after `for` (or after `impl`).
fn rs2nika_impl_type(head: String) -> String {
    let mut depth = 0
    let mut word: String = ""
    let mut last: String = ""
    for ch in head.chars() {
        if ch == '<' {
            depth = depth + 1
        } else if ch == '>' {
            depth = depth - 1
        } else if depth == 0 && rs2nika_word(ch) {
            word.push(ch)
            continue
        }
        if word == "where" {
            return last
        }
        if word != "" {
            last = word.clone()
            word = ""
        }
        if ch == '{' {
            return last
        }
    }
    return last
}

/// A Rust function of `lines` at `i` (a line with `fn `): its signature on
/// one line, the index of its body's first line, of its closing `}` and its
/// name; `[]` where `i` opens none.
fn rs2nika_rust_fn(lines: ref Vec[String], i: i64) -> Vec[String] {
    let st: String = lines[i].trim().clone()
    let name = rs2nika_fn_name(lines[i])
    if name == "" || !(st.starts_with("fn ") || st.starts_with("pub fn ") || st.starts_with("pub(crate) fn ")) {
        return []
    }
    let ind = rs2nika_indent(lines[i])
    let mut sig: String = st.clone()
    let mut j = i
    while !sig.ends_with("{") && j + 1 < lines.len() {
        j = j + 1
        let n: String = lines[j].trim().clone()
        if sig.ends_with("(") || n.starts_with(")") {
            sig = f"{sig}{n}"
        } else {
            sig = f"{sig} {n}"
        }
    }
    if !sig.ends_with("{") {
        return []
    }
    sig = sig.replace(",)", ")")
    let mut k = j + 1
    while k < lines.len() && !(rs2nika_indent(lines[k]) == ind && lines[k].trim() == "}") {
        k = k + 1
    }
    if k >= lines.len() {
        return []
    }
    return [sig, f"{j + 1}", f"{k}", name]
}

/// The parameters' names of a signature on one line, `self` left out.
fn rs2nika_param_names(sig: String) -> Vec[String] {
    let c: Vec[scalar] = sig.chars().collect()
    let open = rs2nika_find_from(c, "(", 0)
    let close = rs2nika_closing(c, open, '(', ')')
    let mut out: Vec[String] = []
    for p in rs2nika_split_args(rs2nika_text(c, open + 1, close)) {
        let colon = p.find(":") ?? continue
        out.push(p[0..<colon].trim().trim_start_matches("mut ").clone())
    }
    return out
}

/// The index of `what` in `all`, or -1.
fn rs2nika_index_of(all: ref Vec[String], what: String) -> i64 {
    let mut i = 0
    while i < all.len() {
        if all[i] == what {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// R175: a method whose body is one call on a field of `self`
/// (`fn count(&self, parsed: &Parsed, ty: &Type) -> usize {
/// self.tables.count(&parsed.interner, ty) as usize }`) is written out where
/// it is called: `self.count(parsed, t)` -> `self.tables.count(&parsed.interner, t)`.
fn rs2nika_delegates(mut ctx: Rs2nikaCtx, given: String) -> String {
    let lines: Vec[String] = given.split("\n").map(fn(l) { l.clone() }).collect()
    let mut names: Vec[String] = []
    let mut params: Vec[Vec[String]] = []
    let mut bodies: Vec[String] = []
    let mut spans: Vec[String] = []
    let mut i = 0
    while i < lines.len() {
        let f = rs2nika_rust_fn(lines, i)
        if f.len() == 0 {
            i = i + 1
            continue
        }
        let first = text::parse_i64(f[1].clone()) ?? 0
        let last = text::parse_i64(f[2].clone()) ?? 0
        let mut body: String = ""
        if last == first + 1 {
            body = lines[first].trim().clone()
        }
        let cast = body.find(" as ") ?? body.len()
        let call: String = body[0..<cast].trim().clone()
        if (f[0].contains("(&self") || f[0].contains("(&mut self")) && call.starts_with("self.") && call.ends_with(")") && !call.contains(";") && call.matches("self.").count() == 1 {
            names.push(f[3].clone())
            params.push(rs2nika_param_names(f[0]))
            bodies.push(call)
            // its doc comment, the method and the blank line after it
            let mut from = i
            while from > 0 && lines[from - 1].trim().starts_with("///") {
                from = from - 1
            }
            let mut to = last
            if to + 1 < lines.len() && lines[to + 1].trim() == "" {
                to = to + 1
            } else if from > 0 && lines[from - 1].trim() == "" {
                from = from - 1
            }
            spans.push(f"{from} {to}")
        }
        i = i + 1
    }
    if names.len() == 0 {
        return given.clone()
    }
    let mut out: Vec[String] = []
    let mut n = 0
    for l in lines {
        let mut s: String = l.clone()
        let mut d = 0
        while d < names.len() {
            let what = f"self.{names[d]}("
            while s.contains(what) {
                let c: Vec[scalar] = s.chars().collect()
                let at = rs2nika_find_from(c, what, 0)
                let open = at + what.chars().count()
                let end = rs2nika_group_end(c, open)
                let args = rs2nika_split_args(rs2nika_text(c, open, end - 1))
                if args.len() != params[d].len() {
                    break
                }
                let mut b: String = bodies[d].clone()
                let mut k = 0
                while k < args.len() {
                    b = rs2nika_replace_word(b, params[d][k], f"\u{1}{k}\u{1}")
                    k = k + 1
                }
                k = 0
                while k < args.len() {
                    b = b.replace(f"\u{1}{k}\u{1}", args[k].trim())
                    k = k + 1
                }
                b = b.replace("&&", "&").replace("&&mut ", "&mut ")
                s = f"{rs2nika_text(c, 0, at)}{b}{rs2nika_text(c, end, c.len())}"
                n = n + 1
            }
            d = d + 1
        }
        out.push(s)
    }
    if n == 0 {
        return given.clone()
    }
    rs2nika_hit(ctx, "R175")
    // a delegate no call is left of goes
    let mut d = 0
    while d < names.len() {
        let what = f"self.{names[d]}("
        if !out.iter().any(fn(l) { l.contains(what) }) {
            let ends = spans[d].split(" ").collect()
            let from = text::parse_i64(ends[0].clone()) ?? 0
            let to = text::parse_i64(ends[1].clone()) ?? 0
            let mut k = from
            while k <= to {
                out[k] = "\u{2}"
                k = k + 1
            }
        }
        d = d + 1
    }
    let kept: Vec[String] = out.iter().filter(fn(l) { l != "\u{2}" }).map(fn(l) { l.clone() }).collect()
    return rs2nika_join(kept, "\n")
}

/// The field of `self` a method's body reads (`self.tables`), `"?"` where it
/// reads two, `self` itself or calls a method; `""` where none.
fn rs2nika_self_field(lines: ref Vec[String], first: i64, last: i64, narrowed: ref Vec[String], to: ref Vec[String]) -> String {
    let mut field: String = ""
    let mut k = first
    while k < last {
        // a comment is no use of `self`
        let code: String = lines[k].split("//").collect()[0].clone()
        let c: Vec[scalar] = code.chars().collect()
        let mut from = 0
        while true {
            let at = rs2nika_find_from(c, "self", from)
            if at < 0 {
                break
            }
            from = at + 4
            // nor is the text `"self"`
            if (at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == '.' || c[at - 1] == '"')) || (at + 4 < c.len() && rs2nika_word(c[at + 4])) {
                continue
            }
            if at + 5 >= c.len() || c[at + 4] != '.' {
                return "?"
            }
            let mut e = at + 5
            while e < c.len() && rs2nika_word(c[e]) {
                e = e + 1
            }
            let w: String = rs2nika_text(c, at + 5, e)
            let mut f: String = w.clone()
            if e < c.len() && c[e] == '(' {
                // a call of a method that reads one field only
                let m = rs2nika_index_of(narrowed, w)
                if m < 0 {
                    return "?"
                }
                f = to[m].clone()
            }
            if field != "" && field != f {
                return "?"
            }
            field = f
        }
        k = k + 1
    }
    return field
}

/// R176: a method that reads one field of `self` (`self.tables`) is a free
/// function of that field: `fn read(&mut self, ..)` -> `fn read(tables: &mut
/// EmitSeedsTables, ..)`, `self.tables` -> `tables`, and a call `self.read(a)`
/// -> `read(&mut self.tables, a)`. The field's type is read from the
/// `struct` of the `impl`; without it the method stays.
fn rs2nika_narrow(mut ctx: Rs2nikaCtx, given: String) -> String {
    // a method that stays one keeps its receiver: its callers write `x.m()`
    if !ctx.free {
        return given.clone()
    }
    let mut lines: Vec[String] = given.split("\n").map(fn(l) { l.clone() }).collect()
    // the fields of each struct: `Type.field` -> its type
    let mut keys: Vec[String] = []
    let mut tys: Vec[String] = []
    let mut owner: String = ""
    for l in lines.clone() {
        let st: String = l.trim().clone()
        if rs2nika_struct_head(st) {
            let h: String = st.trim_start_matches("pub(crate) ").trim_start_matches("pub ").clone()
            owner = h["struct ".len()..<h.len() - "{".len()].trim().clone()
            continue
        }
        if owner != "" {
            if st.starts_with("}") {
                owner = ""
            } else if !st.starts_with("//") && !st.starts_with("#") && st.contains(":") && st.ends_with(",") {
                let colon = st.find(":") ?? continue
                let n: String = st[0..<colon].trim_start_matches("pub(crate) ").trim_start_matches("pub ").trim().clone()
                keys.push(f"{owner}.{n}")
                tys.push(st[colon + ":".len()..<st.len() - ",".len()].trim().clone())
            }
        }
    }
    // the methods, with their `impl` and body
    let mut at: Vec[i64] = []
    let mut host: Vec[String] = []
    let mut target: String = ""
    let mut i = 0
    while i < lines.len() {
        let st: String = lines[i].trim().clone()
        if st.starts_with("impl ") && st.ends_with("{") && !st.contains(" for ") {
            target = st["impl ".len()..<st.len() - "{".len()].trim().clone()
        }
        let f = rs2nika_rust_fn(lines, i)
        if f.len() > 0 && (f[0].contains("(&self") || f[0].contains("(&mut self")) {
            at.push(i)
            host.push(target.clone())
        }
        i = i + 1
    }
    // which methods narrow, until none is added
    let mut narrowed: Vec[String] = []
    let mut to: Vec[String] = []
    let mut more = true
    while more {
        more = false
        let mut m = 0
        while m < at.len() {
            let f = rs2nika_rust_fn(lines, at[m])
            if !narrowed.contains(f[3]) {
                let first = text::parse_i64(f[1].clone()) ?? 0
                let last = text::parse_i64(f[2].clone()) ?? 0
                let field = rs2nika_self_field(lines, first, last, narrowed, to)
                if field != "" && field != "?" && keys.contains(f"{host[m]}.{field}") {
                    narrowed.push(f[3].clone())
                    to.push(field)
                    more = true
                }
            }
            m = m + 1
        }
    }
    if narrowed.len() == 0 {
        return given.clone()
    }
    let mut mutable: Vec[bool] = []
    for _n in narrowed.clone() {
        mutable.push(false)
    }
    // the signatures and bodies
    let mut m = 0
    while m < at.len() {
        let f = rs2nika_rust_fn(lines, at[m])
        let which = rs2nika_index_of(narrowed, f[3])
        if which >= 0 {
            let field: String = to[which].clone()
            let ty: String = tys[rs2nika_index_of(keys, f"{host[m]}.{field}")].clone()
            let first = text::parse_i64(f[1].clone()) ?? 0
            let last = text::parse_i64(f[2].clone()) ?? 0
            let mut sig: String = f[0].clone()
            if sig.contains("(&mut self") {
                mutable[which] = true
                sig = sig.replace("(&mut self", f"({field}: &mut {ty}")
            } else {
                sig = sig.replace("(&self", f"({field}: &{ty}")
            }
            let ind = rs2nika_indent(lines[at[m]])
            lines[at[m]] = f"{ind}{sig}"
            let mut k = at[m] + 1
            while k < first {
                lines[k] = "\u{2}"
                k = k + 1
            }
            k = first
            while k < last {
                let mut b: String = rs2nika_replace_word(lines[k], f"self.{field}", field)
                // a call of another narrowed method hands the field on
                let mut d = 0
                while d < narrowed.len() {
                    b = b.replace(f"self.{narrowed[d]}()", f"{narrowed[d]}({to[d]})").replace(f"self.{narrowed[d]}(", f"{narrowed[d]}({to[d]}, ")
                    d = d + 1
                }
                lines[k] = b
                k = k + 1
            }
        }
        m = m + 1
    }
    // the calls
    let mut out: Vec[String] = []
    for l in lines {
        if l == "\u{2}" {
            continue
        }
        let mut s: String = l.clone()
        let mut d = 0
        while d < narrowed.len() {
            let what = f"self.{narrowed[d]}("
            let mut lend = "&"
            if mutable[d] {
                lend = "&mut "
            }
            s = s.replace(f"self.{narrowed[d]}()", f"{narrowed[d]}({lend}self.{to[d]})").replace(what, f"{narrowed[d]}({lend}self.{to[d]}, ")
            d = d + 1
        }
        out.push(s)
    }
    rs2nika_hit(ctx, "R176")
    return rs2nika_join(out, "\n")
}

/// R177 (`--view`): the parsed files are `ParsedView`s named `unit`:
/// `parsed: &Parsed` -> `unit: ref ParsedView`, `&[&Parsed]` -> `ref
/// Vec[ParsedView]`, `parsed.program.items` -> `unit.items`,
/// `parsed.interner` -> `unit.words`, `parsed.text(*x).to_string()` ->
/// `unit.text(x)`.
/// R178: an `impl Type {` without a trait whose methods all became free
/// (none takes `self` any longer) is no wrapper in Nikaia: its head and its
/// closing brace go, and its body moves out one level.
fn rs2nika_unwrap_impls(mut ctx: Rs2nikaCtx, given: String) -> String {
    if !ctx.free {
        return given.clone()
    }
    let lines: Vec[String] = given.split("\n").map(fn(l) { l.clone() }).collect()
    let mut out: Vec[String] = []
    let mut i = 0
    while i < lines.len() {
        let line = lines[i].clone()
        if line.starts_with("impl ") && line.trim_end().ends_with("{") && !line.contains(" for ") {
            let mut close = i + 1
            let mut takes = false
            while close < lines.len() && !lines[close].starts_with("}") {
                let code: String = lines[close].clone()
                if !code.trim_start().starts_with("//") && code.contains("&self") || code.contains("&mut self") || code.contains("(self") || code.contains("Self") {
                    takes = true
                }
                close = close + 1
            }
            if !takes && close < lines.len() {
                rs2nika_hit(ctx, "R178")
                let mut k = i + 1
                while k < close {
                    let l = lines[k].clone()
                    if l.starts_with("    ") {
                        out.push(l["    ".len()..].clone())
                    } else {
                        out.push(l)
                    }
                    k = k + 1
                }
                i = close + 1
                continue
            }
        }
        out.push(line)
        i = i + 1
    }
    return out.join("\n")
}

/// How often `w` stands in `text` as a name of its own: not part of a longer
/// name, not a field (`x.state`).
fn rs2nika_count_word(text: String, w: String) -> i64 {
    let c: Vec[scalar] = text.chars().collect()
    let n = w.chars().count()
    let mut count = 0
    let mut at = 0
    while true {
        let hit = rs2nika_find_from(c, w, at)
        if hit < 0 {
            break
        }
        at = hit + n
        if (hit > 0 && (rs2nika_word(c[hit - 1]) || c[hit - 1] == '.')) || (hit + n < c.len() && rs2nika_word(c[hit + n])) {
            continue
        }
        count = count + 1
    }
    return count
}

/// The calls `name(..)` in `line`, each as the list of its arguments; with
/// `keep` false for an argument position, the line with those dropped.
/// `drop` holds the argument names that go when they lead the call.
fn rs2nika_lead_args(line: String, name: String, drop: ref Vec[String]) -> String {
    let c: Vec[scalar] = line.chars().collect()
    let pat = f"{name}("
    let mut out: String = ""
    let mut at = 0
    while true {
        let hit = rs2nika_find_from(c, pat, at)
        if hit < 0 {
            out.push_str(rs2nika_text(c, at, c.len()))
            break
        }
        let open = hit + pat.chars().count()
        if (hit > 0 && (rs2nika_word(c[hit - 1]) || c[hit - 1] == '.')) {
            out.push_str(rs2nika_text(c, at, open))
            at = open
            continue
        }
        let end = rs2nika_group_end(c, open)
        let args = rs2nika_split_args(rs2nika_text(c, open, end - 1))
        let mut kept: Vec[String] = []
        let mut leading = true
        for a in args {
            if leading && drop.contains(a) {
                continue
            }
            leading = leading && (a == "state" || a == "world" || a == "host")
            kept.push(a.clone())
        }
        out.push_str(rs2nika_text(c, at, open))
        out.push_str(kept.join(", "))
        out.push_str(")")
        at = end
    }
    return out
}

/// The Rust standard trait an `impl Trait for T {` line implements, or "":
/// Nikaia's tools files implement only their own traits (R191).
fn rs2nika_rust_trait(line: String) -> String {
    let at = line.find(" for ") ?? return ""
    let mut name: String = line[0..<at].clone()
    let gen = name.find("<") ?? name.len()
    name = name[0..<gen].trim().clone()
    let last = name.rfind(" ") ?? return ""
    let mut tr: String = name[last + " ".len()..<name.len()].clone()
    let colons = tr.rfind("::") ?? 0
    if tr.contains("::") {
        tr = tr[colons + "::".len()..<tr.len()].clone()
    }
    for one in ["FromIterator", "IntoIterator", "Iterator", "Extend", "Display", "Debug", "From", "Into", "TryFrom", "Deref", "DerefMut", "Default", "PartialEq", "Eq", "PartialOrd", "Ord", "Hash", "Drop", "Clone", "Index", "IndexMut", "AsRef", "Borrow", "FromStr", "Add", "Sub", "Neg", "Not"] {
        if tr == one {
            return tr.clone()
        }
    }
    return ""
}

/// R195: `if let Some(x) = &mut p {` / `*x = e;` / `}` -> `p = match p {
/// Some(x) => Some(e), None => None };`: the option's value is replaced, not
/// changed through a borrow.
fn rs2nika_mut_some(mut ctx: Rs2nikaCtx, src: String) -> String {
    let lines: Vec[String] = src.split("\n").map(fn(l) { l.clone() }).collect()
    let mut out: Vec[String] = []
    let mut i = 0
    while i < lines.len() {
        let l: String = lines[i].clone()
        let st: String = l.trim().clone()
        if st.starts_with("if let Some(") && st.contains(") = &mut ") && st.ends_with(" {") && i + 2 < lines.len() && lines[i + 2].trim() == "}" {
            let (pat, rest) = st.split_once(") = &mut ") ?? ("", "")
            let x: String = (pat.strip_prefix("if let Some(") ?? "").clone()
            let place: String = (rest.strip_suffix(" {") ?? "").clone()
            let body: String = lines[i + 1].trim().clone()
            let set: String = f"*{x} = "
            if rs2nika_is_path(x) && rs2nika_is_path(place.replace(".", "::")) && body.starts_with(set) && body.ends_with(";") {
                let e: String = ((body.strip_prefix(set) ?? "").strip_suffix(";") ?? "").clone()
                out.push(f"{rs2nika_indent(l)}{place} = match {place} {{ Some({x}) => Some({e}), None => None }};")
                rs2nika_hit(ctx, "R195")
                i = i + 3
                continue
            }
        }
        out.push(l)
        i = i + 1
    }
    return rs2nika_join(out, "\n")
}

/// R192: `nikaia_std::tools::f(..)` and `check_items::f(..)` (a module the
/// file imported as `use nikaia_std::tools::check_items;`, or a compiler
/// module as `use crate::dsl;`) -> `f(..)`: the
/// tools files share one namespace.
fn rs2nika_tool_paths(mut ctx: Rs2nikaCtx, src: String) -> String {
    let mut modules: Vec[String] = []
    for l in src.split("\n") {
        let name: String = ((l.trim().strip_prefix("use nikaia_std::tools::") ?? "").strip_suffix(";") ?? "").clone()
        if name != "" && rs2nika_is_path(name) && !name.contains("::") {
            modules.push(name)
        }
        // `use crate::dsl;`, `use crate::contracts::ty;`: a module of the
        // compiler, named by its last segment
        let krate: String = ((l.trim().strip_prefix("use crate::") ?? "").strip_suffix(";") ?? "").clone()
        if krate != "" && rs2nika_is_path(krate) && !krate.contains("{") {
            let last: String = krate.split("::").last()?.clone() ?? ""
            if last != "" && last == last.to_lowercase() && last != "self" {
                modules.push(last)
            }
        }
    }
    let mut out: Vec[String] = []
    for l in src.split("\n") {
        if l.trim_start().starts_with("use ") || l.trim_start().starts_with("pub use ") || l.trim_start().starts_with("//") {
            out.push(l.clone())
            continue
        }
        let mut s: String = l.clone()
        // `nikaia_std::tools::check_copies::f` -> `f`, `nikaia_std::tools::f` -> `f`
        // and `crate::dsl::drivers` -> `drivers`
        for lead in ["nikaia_std::tools::", "crate::"] {
            while s.contains(lead) {
                let (before, after) = s.split_once(lead) ?? break
                let head: String = before.clone()
                let mut rest: String = after.clone()
                let mut module: String = rs2nika_tools_module(rest)
                while module != "" {
                    rest = (rest.strip_prefix(f"{module}::") ?? "").clone()
                    module = rs2nika_tools_module(rest)
                }
                s = f"{head}{rest}"
                rs2nika_hit(ctx, "R192")
            }
        }
        for m in modules {
            s = rs2nika_drop_qualifier(ctx, s, f"{m}::")
        }
        out.push(s)
    }
    return rs2nika_join(out, "\n")
}

/// The tools module a path starts with (`check_copies` of
/// `check_copies::f`), or "": a lower-case first segment.
fn rs2nika_tools_module(path: String) -> String {
    let seg = path.find("::") ?? return ""
    let head: String = path[0..<seg].clone()
    if head != "" && rs2nika_is_path(head) && head == head.to_lowercase() {
        return head
    }
    return ""
}

/// `q` dropped wherever it starts a path (not after a letter, a digit, `_`
/// or `::`).
fn rs2nika_drop_qualifier(mut ctx: Rs2nikaCtx, given: String, q: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let qc: Vec[scalar] = q.chars().collect()
    let mut out: String = ""
    let mut i = 0
    while i < c.len() {
        let mut here = i + qc.len() <= c.len() && (i == 0 || !(rs2nika_path_char(c[i - 1]) || c[i - 1] == ':'))
        let mut k = 0
        while here && k < qc.len() {
            here = c[i + k] == qc[k]
            k = k + 1
        }
        if here {
            rs2nika_hit(ctx, "R192")
            i = i + qc.len()
            continue
        }
        out.push(c[i])
        i = i + 1
    }
    return out
}

/// R191: a top-level `impl` or `fn` whose body holds what only Rust has (a
/// `static`, a `Mutex`, `Box::leak`, a `'static` borrow, the process's environment) stays in Rust: one
/// `// ADAPTER` line stands for it.
fn rs2nika_rust_impls(mut ctx: Rs2nikaCtx, src: String) -> String {
    let lines: Vec[String] = src.split("\n").map(fn(l) { l.clone() }).collect()
    let mut out: Vec[String] = []
    let mut i = 0
    while i < lines.len() {
        let l: String = lines[i].clone()
        // R196: an empty `impl X {}` declares nothing
        if (l.starts_with("impl ") || l.starts_with("impl<")) && l.trim_end().ends_with(" {}") {
            rs2nika_hit(ctx, "R196")
            i = i + 1
            continue
        }
        let is_fn = rs2nika_fn_name(l) != "" && !l.starts_with(" ")
        if (l.starts_with("impl ") || l.starts_with("impl<") || is_fn) && l.trim_end().ends_with("{") {
            let mut j = i + 1
            let mut rust = false
            while j < lines.len() && !lines[j].starts_with("}") {
                let b: String = lines[j].clone()
                rust = rust || b.trim_start().starts_with("static ") || b.contains("Mutex") || b.contains("OnceLock") || b.contains("Box::leak")
                j = j + 1
            }
            let mut std_trait: String = ""
            if !is_fn {
                std_trait = rs2nika_rust_trait(l)
            }
            if (rust || std_trait != "") && j < lines.len() {
                let head: String = l.trim_end().trim_end_matches("{").trim_end().clone()
                let mut why: String = "process-wide state"
                if std_trait != "" {
                    why = f"Rust's `{std_trait}`"
                }
                out.push(f"// ADAPTER: bleibt in Rust (`{head}`: {why})")
                rs2nika_hit(ctx, "R191")
                i = j + 1
                continue
            }
        }
        out.push(l)
        i = i + 1
    }
    return rs2nika_join(out, "\n")
}

/// R197: the last `return` of a function whose Rust result was `impl
/// Iterator` collects the chain into the list it now hands back.
fn rs2nika_collect_seqs(mut ctx: Rs2nikaCtx, given: Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = given.clone()
    let mut i = 0
    while i < out.len() {
        let name = rs2nika_declared(out[i])
        if name != "" && ctx.seq_fns.contains(name) {
            let close: String = f"{rs2nika_indent(out[i])}}}"
            let mut j = i + 1
            while j < out.len() && out[j].trim_end() != close {
                j = j + 1
            }
            let mut k = j - 1
            while k > i && out[k].trim() == "" {
                k = k - 1
            }
            let last: String = out[k].trim_end().clone()
            if k > i && last.trim_start().starts_with("return ") && !last.ends_with(".collect()") && !last.ends_with("{") {
                out[k] = f"{last}.collect()"
                rs2nika_hit(ctx, "R197")
            }
            i = j
        }
        i = i + 1
    }
    return out
}

/// R205: `A.chain(B).any(F)` -> `A.any(F) || B.any(F)` and `.all(F)` with
/// `&&`: `Seq` has no `chain`, and a predicate asked of both halves is the
/// same answer.
fn rs2nika_split_chains(mut ctx: Rs2nikaCtx, given: Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut sig: String = ""
    let mut made = 0
    for line in given {
        let mut l: String = line.clone()
        if rs2nika_declared(l) != "" {
            sig = l.clone()
        }
        let mut tries = 0
        while l.contains(".chain(") && tries < 4 {
            tries = tries + 1
            let c: Vec[scalar] = l.chars().collect()
            let mut i = 0
            let mut found = 0 - 1
            while i + 7 <= c.len() {
                if rs2nika_text(c, i, i + 7) == ".chain(" {
                    found = i
                    break
                }
                i = i + 1
            }
            if found < 0 {
                break
            }
            let close = rs2nika_tuple_close(c, found + 6)
            if close < 0 || close + 6 > c.len() {
                break
            }
            let op = rs2nika_text(c, close + 1, close + 6)
            if op != ".any(" && op != ".all(" {
                break
            }
            let end = rs2nika_tuple_close(c, close + 5)
            if end < 0 {
                break
            }
            let start = rs2nika_recv_start(c, found)
            let a = rs2nika_text(c, start, found)
            let b = rs2nika_text(c, found + 7, close)
            let f = rs2nika_text(c, close + 6, end)
            let joint = if op == ".any(" { "||" } else { "&&" }
            let before = rs2nika_text(c, 0, start)
            let after = rs2nika_text(c, end + 1, c.len())
            let head: String = before.trim_end().clone()
            let tail: String = after.trim_start().clone()
            let bare = (head == "" || head.ends_with("if") || head.ends_with("=") || head.ends_with("return") || head.ends_with("(") || head.ends_with(",")) && (tail == "" || tail.starts_with("{") || tail.starts_with(")") || tail.starts_with(","))
            let other = rs2nika_nullable_half(ctx, sig, b, f, op == ".any(")
            let split = if other != "" { f"{a}{op}{f}) {joint} {other}" } else { f"{a}{op}{f}) {joint} {b}{op}{f})" }
            l = if bare { f"{before}{split}{after}" } else { f"{before}({split}){after}" }
            rs2nika_hit(ctx, "R205")
        }
        if rs2nika_declared(l) != "" {
            made = 0
        }
        let lifted = rs2nika_lift_chain(l, made)
        if lifted.len() > 1 {
            made = made + 1
            rs2nika_hit(ctx, "R206")
            for one in lifted {
                out.push(one.clone())
            }
            continue
        }
        out.push(l)
    }
    return out
}

/// R206: a statement (`let`, `for`, `return`, an assignment) with
/// `A.chain(B)` outside a closure: the list is made first,
/// `let mut chained = A.collect()` (`[x]` for `once(x)`) and
/// `chained.extend(B.collect())`, and the chain reads `chained` (before
/// `.collect()` or a `for` body) or `chained.iter()`. The lines, or the line
/// alone.
fn rs2nika_lift_chain(line: String, made: i64) -> Vec[String] {
    let st: String = line.trim().clone()
    let ind = rs2nika_indent(line)
    let assigns = (st.split_once(" = ") ?? ("(", "")).0.chars().all(fn(ch) { rs2nika_word(ch) || ch == '.' })
    if !(st.starts_with("let ") || st.starts_with("for ") || st.starts_with("return ") || assigns) {
        return [line.clone()]
    }
    let c: Vec[scalar] = line.chars().collect()
    let mut found = 0 - 1
    let mut i = 0
    let mut braces = 0
    while i + 7 <= c.len() {
        if c[i] == '{' {
            braces = braces + 1
        } else if c[i] == '}' {
            braces = braces - 1
        } else if braces == 0 && rs2nika_text(c, i, i + 7) == ".chain(" {
            found = i
            break
        }
        i = i + 1
    }
    if found < 0 {
        return [line.clone()]
    }
    let close = rs2nika_tuple_close(c, found + 6)
    if close < 0 {
        return [line.clone()]
    }
    let start = rs2nika_recv_start(c, found)
    let mut a = rs2nika_text(c, start, found)
    let mut b = rs2nika_text(c, found + 7, close)
    if a == "" || b == "" {
        return [line.clone()]
    }
    for drop in [".copied()", ".cloned()"] {
        if a.ends_with(drop) {
            a = (a.strip_suffix(drop) ?? "").clone()
        }
        if b.ends_with(drop) {
            b = (b.strip_suffix(drop) ?? "").clone()
        }
    }
    let first = if a.starts_with("once(") && a.ends_with(")") { f"[{a["once(".len()..<a.len() - ")".len()]}]" } else if a.starts_with("std::iter::once(") && a.ends_with(")") { f"[{a["std::iter::once(".len()..<a.len() - ")".len()]}]" } else { f"{a}.collect()" }
    let name = if made == 0 { "chained" } else { f"chained_{made + 1}" }
    let before = rs2nika_text(c, 0, start)
    let mut after = rs2nika_text(c, close + 1, c.len())
    let mut read: String = f"{name}.iter()"
    if after.starts_with(".collect()") {
        after = (after.strip_prefix(".collect()") ?? "").clone()
        read = name.clone()
    } else if st.starts_with("for ") && after.trim() == "{" {
        read = name.clone()
    }
    return [f"{ind}let mut {name} = {first}", f"{ind}{name}.extend({b}.collect())", f"{before}{read}{after}"]
}

/// R205: the half `x.iter()` of a nullable `x` (a parameter `x: T?`, a
/// name the file declares `Option<..>`, a field `tools/*.nika` declares only
/// as `T?`) asked `fn(t) { e }`: `(x != null && e)` with `x` for `t`
/// (`(x == null || e)` for `all`), or "".
fn rs2nika_nullable_half(ctx: ref Rs2nikaCtx, sig: String, half: String, pred: String, any: bool) -> String {
    let name = half.strip_suffix(".iter()") ?? return ""
    if name == "" || !name.chars().all(fn(ch) { rs2nika_word(ch) || ch == '.' }) {
        return ""
    }
    let last = (name.rsplit_once(".") ?? ("", name)).1
    let mut nullable = ctx.opt_names.contains(last) || ctx.field_opts.contains(last)
    let typed = f"{name}: "
    let (_, rest_sig) = sig.split_once(typed) ?? ("", "")
    if rest_sig != "" {
        let ty_end = rest_sig.find(",") ?? (rest_sig.find(")") ?? 0)
        nullable = rest_sig[..<ty_end].trim().ends_with("?")
    }
    if !nullable {
        return ""
    }
    let body = pred.trim()
    let after = body.strip_prefix("fn(") ?? return ""
    let (param, rest) = after.split_once(") { ") ?? return ""
    if param == "" || !param.chars().all(fn(ch) { rs2nika_word(ch) }) {
        return ""
    }
    let inner = rest.strip_suffix(" }") ?? return ""
    let said = rs2nika_replace_word(inner, param, name)
    if any {
        return f"({name} != null && {said})"
    }
    return f"({name} == null || {said})"
}

/// R188: `mod core;`, `pub(crate) mod attributes;`: Nikaia's tools files
/// share one namespace and declare no modules.
///
/// R189: a tools file imports from `std` only, by module (`use
/// std::collections`): every other `use`, one line or several, is dropped.
fn rs2nika_drop_mods(mut ctx: Rs2nikaCtx, given: Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut skipping = false
    let mut kept: Vec[String] = []
    for line in given {
        if skipping {
            skipping = !line.starts_with("}")
            continue
        }
        let import: String = (line.strip_prefix("pub use ") ?? line.strip_prefix("use ") ?? "").clone()
        if import != "" {
            rs2nika_hit(ctx, "R189")
            if !import.starts_with("std::") {
                skipping = line.trim_end().ends_with("{")
                continue
            }
            let parts: Vec[String] = import.split("::").map(fn(p) { p.clone() }).collect()
            let mut module: String = f"use std::{parts[1].trim_end_matches(";").trim_end_matches(" {")}"
            if parts.len() == 2 && parts[1].contains("{") {
                module = line.clone()
            }
            if kept.contains(module) {
                skipping = parts.len() > 2 && line.trim_end().ends_with("{")
                continue
            }
            kept.push(module.clone())
            out.push(module)
            skipping = parts.len() > 2 && line.trim_end().ends_with("{")
            continue
        }
        let mut st: String = line.trim().clone()
        for lead in ["pub(crate) ", "pub(super) ", "pub "] {
            if st.starts_with(lead) {
                st = (st.strip_prefix(lead) ?? "").clone()
            }
        }
        if st.starts_with("mod ") && !st.contains("{") && rs2nika_is_path((st.strip_prefix("mod ") ?? "").trim_end_matches(";").clone()) {
            rs2nika_hit(ctx, "R188")
            continue
        }
        out.push(line.clone())
    }
    return out
}

/// R187: `match (&xs[..], b) {` -> `match (ref xs, b) {`: a list matched by
/// slice patterns inside a tuple is borrowed, not moved into it.
fn rs2nika_tuple_slice(mut ctx: Rs2nikaCtx, s: String) -> String {
    let at = s.find("match (&") ?? return s.clone()
    let from = at + "match (&".len()
    let tail: String = s[from..<s.len()].clone()
    let end = tail.find("[..]") ?? return s.clone()
    let place: String = tail[0..<end].clone()
    if !rs2nika_is_path(place.replace(".", "::")) {
        return s.clone()
    }
    rs2nika_hit(ctx, "R187")
    return f"{s[0..<at]}match (ref {place}{tail[end + "[..]".len()..<tail.len()]}"
}

/// Whether a line ends by opening `fn(x) { match x {` (R185).
fn rs2nika_lambda_open(line: String) -> bool {
    let at = line.rfind("fn(") ?? return false
    let tail = line[at..<line.len()]
    return line.ends_with(" {") && tail.contains(") { match ") && !tail.contains("}")
}

/// R185: a closure opened by `fn(x) { match x {` on one line ends where its
/// `match` does: the line at the same indent that starts with `}` gets the
/// closure's own `}`.
fn rs2nika_close_lambdas(mut ctx: Rs2nikaCtx, given: Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = given.clone()
    let mut i = 0
    while i < out.len() {
        let line: String = out[i].trim_end().clone()
        if rs2nika_lambda_open(line) {
            let ind = rs2nika_indent(line)
            let mut j = i + 1
            while j < out.len() {
                let st: String = out[j].trim_start().clone()
                if rs2nika_indent(out[j]) == ind && st.starts_with("}") {
                    out[j] = f"{ind}}} }}{st["}".len()..<st.len()]}"
                    rs2nika_hit(ctx, "R185")
                    break
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

/// R180 (`-free`): a free function takes `state` and `world` only where its
/// body uses them, itself or by handing them to one of the draft's own
/// functions that does; the parameter goes, and so does the argument at
/// each call. `emit_x_pure(state, world, a)` -> `emit_x_pure(a)`.
fn rs2nika_unused_hosts(mut ctx: Rs2nikaCtx, given: Vec[String]) -> Vec[String] {
    if !ctx.free {
        return given.clone()
    }
    let mut names: Vec[String] = []
    let mut starts: Vec[i64] = []
    let mut ends: Vec[i64] = []
    let mut i = 0
    while i < given.len() {
        let name = rs2nika_fn_name(given[i])
        let sig: String = given[i].clone()
        if name != "" && sig.trim_end().ends_with("{") && (sig.contains("(state: ") || sig.contains("(mut state: ") || sig.contains("world: ref ")) {
            let close = f"{rs2nika_indent(sig)}}}"
            let mut e = i + 1
            while e < given.len() && !given[e].starts_with(close) {
                e = e + 1
            }
            names.push(name)
            starts.push(i)
            ends.push(e)
        }
        i = i + 1
    }
    if names.len() == 0 {
        return given.clone()
    }
    // which of `state` and `world` each body uses itself, and whom it hands them
    let mut uses: Vec[String] = []
    let mut hands: Vec[String] = []
    let mut f = 0
    while f < names.len() {
        let mut body: String = ""
        let mut k = starts[f] + 1
        while k < ends[f] {
            body.push_str(given[k])
            body.push_str("\n")
            k = k + 1
        }
        for w in ["state", "world"] {
            let mut own = rs2nika_count_word(body, w)
            let mut g = 0
            while g < names.len() {
                let passed = rs2nika_lead_args(body, names[g], [w.clone()])
                let handed = own - rs2nika_count_word(passed, w)
                if handed > 0 {
                    hands.push(f"{names[f]} {w} {names[g]}")
                }
                own = own - handed
                g = g + 1
            }
            if own > 0 {
                uses.push(f"{names[f]} {w}")
            }
        }
        f = f + 1
    }
    let mut more = true
    while more {
        more = false
        for h in hands.clone() {
            let parts: Vec[String] = h.split(" ").map(fn(x) { x.clone() }).collect()
            let mine = f"{parts[0]} {parts[1]}"
            if !uses.contains(mine) && uses.contains(f"{parts[2]} {parts[1]}") {
                uses.push(mine)
                more = true
            }
        }
    }
    let mut out: Vec[String] = given.clone()
    f = 0
    while f < names.len() {
        let mut drop: Vec[String] = []
        for w in ["state", "world"] {
            if !uses.contains(f"{names[f]} {w}") {
                drop.push(w.clone())
            }
        }
        if drop.len() > 0 {
            rs2nika_hit(ctx, "R180")
            // the signature: its parameters named `state` or `world`
            let sig: String = out[starts[f]].clone()
            let c: Vec[scalar] = sig.chars().collect()
            let open = rs2nika_find_from(c, "(", 0) + 1
            let end = rs2nika_group_end(c, open)
            let mut params: Vec[String] = []
            for p in rs2nika_split_args(rs2nika_text(c, open, end - 1)) {
                let bare: String = p.trim_start_matches("mut ").clone()
                let colon = bare.find(":") ?? bare.len()
                if !drop.contains(bare[0..<colon].trim().clone()) {
                    params.push(p.clone())
                }
            }
            out[starts[f]] = f"{rs2nika_text(c, 0, open)}{params.join(", ")}){rs2nika_text(c, end, c.len())}"
            // and every call
            let mut k = 0
            while k < out.len() {
                if k != starts[f] {
                    out[k] = rs2nika_lead_args(out[k], names[f], drop)
                }
                k = k + 1
            }
        }
        f = f + 1
    }
    return out
}

/// R179: `let mut out = []` in a function that ends `return out` takes the
/// list type the function returns: `let mut out: Vec[EmitSeedsCall] = []`.
/// `match &*func` reads the boxed value as it is: `match func`.
/// R181: `refused!("..")` -> `throw Refused::Because(f"..")`.
fn rs2nika_typed_empty(mut ctx: Rs2nikaCtx, given: Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut texts: Vec[String] = []
    let mut i = 0
    while i < given.len() {
        let mut line: String = given[i].replace("match &*", "match ").replace("match *", "match ")
        if line != given[i] {
            rs2nika_hit(ctx, "R179")
        }
        // R181: the emitters' `refused!("..")` is the `Refused` they throw
        let head: String = line.trim().clone()
        if head.starts_with("refused!(\"") && head.ends_with("\")") {
            let said: String = head["refused!(".len()..<head.len() - ")".len()].clone()
            if rs2nika_split_args(said).len() == 1 {
                let f = if said.contains("{") { "f" } else { "" }
                line = f"{rs2nika_indent(line)}throw Refused::Because({f}{said})"
                rs2nika_hit(ctx, "R181")
            }
        }
        let st: String = line.trim().clone()
        // R183: a text parameter is a text already: `name.to_string()` -> `name`
        if ctx.free && (st.starts_with("fn ") || st.starts_with("pub fn ")) {
            texts = []
            let c: Vec[scalar] = st.chars().collect()
            let open = rs2nika_find_from(c, "(", 0) + 1
            if open > 0 {
                let end = rs2nika_group_end(c, open)
                for p in rs2nika_split_args(rs2nika_text(c, open, end - 1)) {
                    let bare: String = p.trim().trim_start_matches("mut ").clone()
                    let colon = bare.find(": ") ?? continue
                    if bare[colon + ": ".len()..<bare.len()].trim() == "String" {
                        texts.push(bare[0..<colon].clone())
                    }
                }
            }
        }
        for name in texts {
            for tail in [".to_string()", ".to_owned()"] {
                let renamed = rs2nika_rename_word(line, f"{name}{tail}", name)
                if renamed != line {
                    rs2nika_hit(ctx, "R183")
                    line = renamed
                }
            }
        }
        if st.starts_with("let mut ") && st.ends_with(" = []") {
            let name: String = st["let mut ".len()..<st.len() - " = []".len()].clone()
            let mut ret: String = ""
            let mut k = i
            while k > 0 && ret == "" {
                k = k - 1
                let back: String = given[k].trim().clone()
                if back.starts_with("fn ") || back.starts_with("pub fn ") {
                    let arrow = back.find(") -> ") ?? break
                    let tail: String = back[arrow + ") -> ".len()..<back.len()].trim_end_matches("{").trim().clone()
                    ret = tail.clone()
                }
            }
            let mut returned = false
            let mut j = i + 1
            while j < given.len() {
                let fwd: String = given[j].trim().clone()
                if fwd.starts_with("fn ") || fwd.starts_with("pub fn ") {
                    break
                }
                if fwd == f"return {name}" {
                    returned = true
                }
                j = j + 1
            }
            if returned && ret.starts_with("Vec[") && rs2nika_is_path(name) {
                rs2nika_hit(ctx, "R179")
                line = f"{rs2nika_indent(line)}let mut {name}: {ret} = []"
            }
        }
        out.push(line)
        i = i + 1
    }
    return out
}

/// The `[view]` section of rs2nika.names: what `--view` renames, in order,
/// as `from` and `to` side by side.
fn rs2nika_view_names(repo: String) -> Vec[String] {
    // a test brings its own table, beside the file it converts
    let mut table: String = fs::read_to_string("rs2nika.names", fs::Root::Anywhere) catch { "" }
    for d in [repo.clone(), ".", "..", "../..", "../../..", "../../../..", "../../../../..", "../../../../../.."] {
        if d != "" && d != "?" && table == "" {
            table = fs::read_to_string(f"{d}/crates/rs2nika/convert/rs2nika.names", fs::Root::Anywhere) catch { "" }
        }
    }
    if table == "" {
        eprintln("// rs2nika: `--view` found no rs2nika.names, so it renames nothing")
        return []
    }
    let mut pairs: Vec[String] = []
    let mut inside = false
    for l in table.split("\n") {
        if l.starts_with("[") {
            inside = l.trim() == "[view]"
            continue
        }
        let parts: Vec[String] = l.split_whitespace().map(fn(p) { p.clone() }).collect()
        if inside && !l.starts_with("#") && parts.len() >= 2 {
            pairs.push(parts[0].clone())
            pairs.push(parts[1].clone())
        }
    }
    return pairs
}

/// `from` renamed to `to` where it is a word of its own, not a field
/// (`x.parsed`) or part of a longer name (`parsed_at`).
fn rs2nika_rename_word(given: String, from: String, to: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let hit = rs2nika_find_from(c, from, at)
        if hit < 0 {
            out.push_str(rs2nika_text(c, at, c.len()))
            break
        }
        out.push_str(rs2nika_text(c, at, hit))
        let e = hit + from.chars().count()
        if (hit > 0 && (rs2nika_word(c[hit - 1]) || c[hit - 1] == '.')) || (e < c.len() && rs2nika_word(c[e])) {
            out.push_str(from)
        } else {
            out.push_str(to)
        }
        at = e
    }
    return out
}

fn rs2nika_view(mut ctx: Rs2nikaCtx, given: String) -> String {
    if !ctx.view {
        return given.clone()
    }
    // the names are rs2nika.names' `[view]`
    let mut s: String = given.clone()
    let mut k = 0
    while k + 1 < ctx.view_names.len() {
        let from = ctx.view_names[k].clone()
        let to = ctx.view_names[k + 1].clone()
        if rs2nika_is_path(from) {
            s = rs2nika_rename_word(s, from, to)
        } else {
            s = s.replace(from, to)
        }
        k = k + 2
    }
    // `unit.text(x)` is a `String`: its `.to_string()` goes
    let d: Vec[scalar] = s.chars().collect()
    let mut o2: String = ""
    let mut at = 0
    while at < d.len() {
        let hit = rs2nika_find_from(d, "unit.text(", at)
        if hit < 0 {
            o2.push_str(rs2nika_text(d, at, d.len()))
            break
        }
        let end = rs2nika_group_end(d, hit + "unit.text(".len())
        o2.push_str(rs2nika_text(d, at, end))
        at = end
        if rs2nika_find_from(d, ".to_string()", at) == at {
            at = at + ".to_string()".len()
        }
    }
    rs2nika_hit(ctx, "R177")
    return o2
}

/// R174: a walk of the emitter, `emit::visit_block(b, &mut |e| { .. });`
/// (also `visit_stmt`, `visit_expr`) -> `for e in visited_in_block(b) { .. }`
/// (`tools/emit_walk.nika`): the closure's body is the loop's, its `return`
/// is `continue`; a body that is one `match` or one call keeps its line.
fn rs2nika_visits(mut ctx: Rs2nikaCtx, lines: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut i = 0
    while i < lines.len() {
        let l: String = lines[i].clone()
        let ind = rs2nika_indent(l)
        let mut st: String = l.trim().clone()
        // R192 may have taken `crate::emit::` off already
        st = st.trim_start_matches("crate::").trim_start_matches("emit::").clone()
        if !st.starts_with("visit_") {
            out.push(l)
            i = i + 1
            continue
        }
        let open = st.find("(") ?? 0
        let bar = st.find(", &mut |") ?? 0
        if open <= "visit_".len() || bar <= open {
            out.push(l)
            i = i + 1
            continue
        }
        let kind: String = st["visit_".len()..<open].clone()
        if (kind != "block" && kind != "stmt" && kind != "expr" && kind != "stmt_blocks") {
            out.push(l)
            i = i + 1
            continue
        }
        let arg: String = st[open + "(".len()..<bar].trim().clone()
        let after: String = st[bar + ", &mut |".len()..<st.len()].clone()
        let shut = after.find("|") ?? 0
        let mut name: String = after[0..<shut].clone()
        let colon = name.find(":") ?? 0
        if colon > 0 {
            name = name[0..<colon].trim().clone()
        }
        let rest: String = after[shut + "|".len()..<after.len()].trim().clone()
        if shut == 0 || !rs2nika_is_path(name) || !rs2nika_is_path(arg.replace("&", "").replace(".", "").replace("[", "").replace("]", "")) {
            out.push(l)
            i = i + 1
            continue
        }
        // R203: the checker's `contracts::sync::visit_stmt_blocks` is
        // `check_visit_stmt_blocks` (tools/check_visit.nika)
        let mut callee = f"visited_in_{kind}"
        if kind == "stmt_blocks" {
            callee = "check_visit_stmt_blocks"
            rs2nika_hit(ctx, "R203")
        }
        let head = f"{ind}for {name} in {callee}({arg.replace("&", "")}) {{"
        if rest.ends_with(");") && !rest.ends_with("{") {
            // one call or value: the loop's one statement
            out.push(head)
            out.push(f"{ind}    {rest[0..<rest.len() - ");".len()]};")
            out.push(f"{ind}}}")
            rs2nika_hit(ctx, "R174")
            i = i + 1
            continue
        }
        if !rest.ends_with("{") {
            out.push(l)
            i = i + 1
            continue
        }
        let mut j = i + 1
        while j < lines.len() && !(rs2nika_indent(lines[j]) == ind && lines[j].trim().starts_with("})")) {
            j = j + 1
        }
        if j >= lines.len() {
            out.push(l)
            i = i + 1
            continue
        }
        let wrapped = rest != "{"
        out.push(head)
        let mut shift: String = ""
        if wrapped {
            out.push(f"{ind}    {rest}")
            shift = "    "
        }
        let mut k = i + 1
        while k < j {
            let mut b: String = lines[k].clone()
            let bt: String = b.trim().clone()
            if bt == "return;" || bt == "return" {
                b = f"{rs2nika_indent(b)}continue"
            } else if b.ends_with("=> return,") {
                b = f"{b[0..<b.len() - "return,".len()]}continue,"
            }
            if b.trim() == "" {
                out.push("")
            } else {
                out.push(f"{shift}{b}")
            }
            k = k + 1
        }
        if wrapped {
            out.push(f"{ind}    }}")
        }
        out.push(f"{ind}}}")
        rs2nika_hit(ctx, "R174")
        i = j + 1
    }
    return out
}

/// R103 a `const` written over several lines is joined into one (the list
/// `[a,\n b,\n]` -> `[a, b]`); R105 a `const` of an `impl` moves above it as a
/// top-level `comptime` (Nikaia has no associated constants), and
/// `Self::NAME` / `Type::NAME` -> `NAME`. A name the file already declares
/// keeps the `const` in place, with a TODO.
fn rs2nika_lift_consts(mut ctx: Rs2nikaCtx, lines: ref Vec[String]) -> Vec[String] {
    let mut joined: Vec[String] = []
    let mut i = 0
    while i < lines.len() {
        let l: String = lines[i].clone()
        if rs2nika_const_rest(l) != "" && !l.trim_end().ends_with(";") {
            let mut text: String = l.trim_end().clone()
            let mut j = i + 1
            let mut ok = true
            while ok && j < lines.len() && !text.ends_with(";") {
                let part: String = lines[j].trim().clone()
                if part.starts_with("//") || part == "" {
                    ok = false
                } else if text.ends_with("[") || text.ends_with("(") || part.starts_with("]") || part.starts_with(")") {
                    text = f"{text}{part}"
                } else {
                    text = f"{text} {part}"
                }
                j = j + 1
            }
            if ok && text.ends_with(";") {
                joined.push(text.replace(",]", "]").replace(",)", ")"))
                rs2nika_hit(ctx, "R103")
                i = j
                continue
            }
        }
        joined.push(l)
        i = i + 1
    }
    let mut taken: Vec[String] = []
    for l in joined.clone() {
        if rs2nika_indent(l) == "" && rs2nika_const_rest(l) != "" {
            taken.push(rs2nika_const_name(l))
        }
    }
    let mut out: Vec[String] = []
    let mut block: Vec[String] = []
    let mut lifted: Vec[String] = []
    let mut names: Vec[String] = []
    let mut all_names: Vec[String] = []
    let mut all_tys: Vec[String] = []
    let mut in_impl = false
    let mut ty: String = ""
    for l in joined {
        if !in_impl {
            if (l.starts_with("impl ") || l.starts_with("impl<")) && l.trim_end().ends_with("{") {
                in_impl = true
                ty = rs2nika_impl_type(l)
                block = [l.clone()]
                lifted = []
                names = []
            } else {
                out.push(l.clone())
            }
            continue
        }
        if l.trim_end() == "}" {
            block.push(l.clone())
            for c in lifted.clone() {
                out.push(c)
            }
            if lifted.len() > 0 {
                out.push("")
            }
            for b in block.clone() {
                out.push(b)
            }
            in_impl = false
            continue
        }
        let name = rs2nika_const_name(l)
        if name != "" && rs2nika_indent(l).len() == 4 {
            if taken.contains(name) {
                block.push(f"    // TODO(rs2nika): `const` in an `impl`: no associated constants in Nikaia; `{name}` is taken at the top of the file: rename it, move it above the `impl` as a `comptime`")
                block.push(l.clone())
            } else {
                lifted.push(l.trim_start().clone())
                names.push(name.clone())
                taken.push(name.clone())
                all_names.push(name.clone())
                all_tys.push(ty.clone())
                rs2nika_hit(ctx, "R105")
            }
            continue
        }
        let mut t: String = l.clone()
        for n in names.clone() {
            t = rs2nika_replace_word(t, f"Self::{n}", n)
        }
        block.push(t)
    }
    if in_impl {
        for c in lifted {
            out.push(c.clone())
        }
        for b in block {
            out.push(b.clone())
        }
    }
    if all_names.len() == 0 {
        return out
    }
    let mut done: Vec[String] = []
    for l in out {
        let mut t: String = l.clone()
        let mut k = 0
        while k < all_names.len() {
            if all_tys[k] != "" {
                t = rs2nika_replace_word(t, f"{all_tys[k]}::{all_names[k]}", all_names[k])
            }
            k = k + 1
        }
        done.push(t)
    }
    return done
}

/// The `comptime` a `static` (R101) or a `const` (R103) holding a constant
/// becomes; `rest` is the text after the keyword, without the `;`.
fn rs2nika_comptime(mut ctx: Rs2nikaCtx, raw: String, vis: String, given: String, rule: String) -> String {
    let mut rest: String = given.clone()
    let colon = rest.find(":") ?? 0
    let eq = rest.find(" = ") ?? 0
    if colon == 0 || eq < colon {
        return ""
    }
    let name: String = rest[0..<colon].trim().clone()
    let ty: String = rest[colon + ":".len()..<eq].trim().clone()
    let mut value: String = rest[eq + " = ".len()..].trim().clone()
    let flat: String = rs2nika_lifetimes(ty).replace(" ", "")
    let mut nty: String = ""
    if flat == "&str" {
        nty = "ref String"
    } else if flat.starts_with("&[") && flat.ends_with("]") && value.starts_with("&[") && value.ends_with("]") {
        let elem: String = flat["&[".len()..<flat.len() - "]".len()].clone()
        let mut ne: String = "ref String"
        if elem != "&str" {
            ne = rs2nika_ty(ctx, elem)
        }
        let items = rs2nika_split_args(value["&[".len()..<value.len() - "]".len()].clone())
        nty = f"Array[{ne}, {items.len()}]"
        value = value["&".len()..].clone()
    } else if flat.starts_with("[") && flat.ends_with("]") && flat.contains(";") {
        let semi = flat.rfind(";") ?? 0
        let elem: String = flat["[".len()..<semi].clone()
        let n: String = flat[semi + ";".len()..<flat.len() - "]".len()].clone()
        let mut ne: String = "ref String"
        if elem != "&str" {
            ne = rs2nika_ty(ctx, elem)
        }
        nty = f"Array[{ne}, {n}]"
    } else {
        nty = rs2nika_ty(ctx, ty)
    }
    let v: String = rs2nika_expr(ctx, value).trim().clone()
    rs2nika_hit(ctx, rule)
    return f"{rs2nika_indent(raw)}{vis}comptime {name}: {nty} = {v}"
}

/// R27: `::<T>()` -> `()`.
fn rs2nika_turbofish(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        if at + 2 < c.len() && c[at] == ':' && c[at + 1] == ':' && c[at + 2] == '<' {
            // R150: the type may nest (`collect::<Vec<Vec<_>>>()`); a
            // collect into an `Option`/`Result` keeps its TODO
            let mut j = at + 3
            let mut angle = 1
            while j < c.len() && c[j] != '(' && c[j] != ')' {
                if c[j] == '<' {
                    angle = angle + 1
                } else if c[j] == '>' {
                    angle = angle - 1
                    if angle == 0 {
                        break
                    }
                }
                j = j + 1
            }
            let ty = rs2nika_text(c, at + 3, j)
            let kept = ty.starts_with("Option<") || ty.starts_with("Result<")
            if !kept && j + 2 < c.len() && c[j] == '>' && c[j + 1] == '(' && c[j + 2] == ')' {
                out.push_str("()")
                at = j + 3
                rs2nika_hit(ctx, "R27")
                continue
            }
        }
        out.push(c[at])
        at = at + 1
    }
    return out
}

/// The TODO for a `Some(` inside an arm's pattern: in a struct pattern the
/// field does not narrow yet (#886); in a tuple pattern R172 found no arm
/// that takes `None` there before it.
fn rs2nika_some_todo(head: String) -> String {
    if head.contains(": Some(") {
        return rs2nika_some_field()
    }
    let c: Vec[scalar] = head.chars().collect()
    let at = rs2nika_find_from(c, "(Some(", 0)
    if head.trim_start().starts_with("(") || (at >= 0 && (at == 0 || !rs2nika_word(c[at - 1]))) {
        return rs2nika_some_tuple()
    }
    return "`match` on `Some`/`None`: `let x = e ?? <none arm>`"
}

/// The TODO of a `Some(` in a struct pattern.
fn rs2nika_some_field() -> String {
    return "a `Some(` in a struct pattern: a field does not narrow yet (#886); bind the field and test it with `!= null` in the arm"
}

/// R173: a field `f: Some(x)` of a struct pattern -> `f: x` (`f` where `x`
/// is `f` or `_`) and the guard `x != null` (ADR-382 D2: a guard narrows in
/// its arm). `[pattern, guard]`, the guard `""` where the pattern has no
/// such field; the pattern unchanged where a `Some(..)` holds more than a
/// name.
fn rs2nika_some_fields(pat: String) -> Vec[String] {
    let c: Vec[scalar] = pat.chars().collect()
    let mut out: String = ""
    let mut guards: Vec[String] = []
    let mut at = 0
    while at < c.len() {
        let hit = rs2nika_find_from(c, ": Some(", at)
        if hit < 0 {
            out.push_str(rs2nika_text(c, at, c.len()))
            break
        }
        let mut f = hit
        while f > 0 && rs2nika_word(c[f - 1]) {
            f = f - 1
        }
        let open = hit + ": Some(".len()
        let close = rs2nika_group_end(c, open)
        let inner: String = rs2nika_text(c, open, close - 1).trim().clone()
        let field: String = rs2nika_text(c, f, hit)
        if field == "" || !rs2nika_is_path(inner) || inner.contains(":") || inner.contains(".") {
            return [pat.clone(), ""]
        }
        out.push_str(rs2nika_text(c, at, f))
        if inner == "_" || inner == field {
            out.push_str(field)
            guards.push(f"{field} != null")
        } else {
            out.push_str(f"{field}: {inner}")
            guards.push(f"{inner} != null")
        }
        at = close
    }
    // R200: a tuple's position `Some(x)`, `x` a name -> `x` and the guard
    // `x != null` (`(Some(a), Some(B(v)))` -> `(a, B(v)) if a != null`)
    if out.starts_with("(") {
        let tc: Vec[scalar] = out.chars().collect()
        let mut kept: String = ""
        let mut k = 0
        while k < tc.len() {
            let hit = rs2nika_find_from(tc, "Some(", k)
            if hit < 0 {
                kept.push_str(rs2nika_text(tc, k, tc.len()))
                break
            }
            let open = hit + "Some(".len()
            let close = rs2nika_group_end(tc, open)
            let inner: String = rs2nika_text(tc, open, close - 1).trim().clone()
            let lead = hit > 0 && (tc[hit - 1] == '(' || (hit > 1 && tc[hit - 1] == ' ' && tc[hit - 2] == ','))
            kept.push_str(rs2nika_text(tc, k, hit))
            if lead && inner != "_" && rs2nika_is_path(inner) && !inner.contains(":") && !inner.contains(".") && rs2nika_irrefutable(inner) {
                kept.push_str(inner)
                guards.push(f"{inner} != null")
            } else {
                kept.push_str(rs2nika_text(tc, hit, close))
            }
            k = close
        }
        out = kept
    }
    return [out, rs2nika_join(guards, " && ")]
}

/// R173 on a `match` arm written on its own line: `P => ..` with a struct
/// field `f: Some(x)` in `P` -> `P' if x != null => ..`, before an arm's own
/// guard.
fn rs2nika_some_field_arm(mut ctx: Rs2nikaCtx, line: String) -> String {
    let st: String = line.trim().clone()
    if !st.contains(": Some(") || st.starts_with("let ") || st.starts_with("if ") || st.starts_with("while ") || st.starts_with("} else") {
        return line.clone()
    }
    let arrow = line.find(" => ") ?? return line.clone()
    let head: String = line[0..<arrow].clone()
    let mut pat: String = head.clone()
    let mut own: String = ""
    let gat = head.find(" if ") ?? 0
    if gat > 0 {
        pat = head[0..<gat].clone()
        own = head[gat + " if ".len()..<head.len()].trim().clone()
    }
    let sf = rs2nika_some_fields(pat)
    if sf[1] == "" {
        return line.clone()
    }
    let mut guard: String = sf[1].clone()
    if own != "" {
        guard = f"{guard} && {own}"
    }
    rs2nika_hit(ctx, "R173")
    return f"{sf[0]} if {guard}{line[arrow..<line.len()]}"
}

/// The TODO of a `Some(` in a tuple pattern R172 cannot write.
fn rs2nika_some_tuple() -> String {
    return "a `Some(` in a tuple pattern of a `match` R172 does not read (one written on a line, or an arm it cannot split): `Some(p)` -> `p` once an arm before it takes `None` there (ADR-352 D1 per position, #879)"
}

/// The `TODO(rs2nika)` markers a Rust line asks for.
fn rs2nika_todos(line: String, opts: ref Vec[String]) -> Vec[String] {
    let comb: String = rs2nika_comb_match(rs2nika_some_and(rs2nika_opt_comb(line)), opts)
    let mut todo: Vec[String] = []
    let st: String = line.trim().clone()
    if line.contains(" && let ") || ((st.starts_with("if let ") || st.starts_with("} else if let ")) && st.ends_with("&&")) || st.starts_with("&& let ") {
        todo.push("let-chain (`&& let`): nest `match`es")
    }
    let global = rs2nika_static_todo(st)
    if global != "" {
        todo.push(global)
    }
    let needle = rs2nika_needle_todo(line)
    if needle != "" {
        todo.push(needle)
    }
    let map_end = line.trim_end().ends_with(")") && line.contains(".map(|")
    if comb.contains(".and_then(") || (comb.contains(".map(|") && (line.contains("?") || line.contains("unwrap_or") || map_end) && !line.contains("iter()") && !rs2nika_seq_maps(comb)) {
        todo.push("`Option::map`/`and_then`: `let x = e ?? <none>` then the body")
    }
    if line.contains(".enumerate()") {
        todo.push("`.enumerate()`: a `while` with an index")
    }
    let head_end = line.find("=>") ?? 0
    let head: String = line[0..<head_end].clone()
    let some_arm = head_end > 0 && (head.contains(" Some(") || head.contains("(Some(") || head.contains("|Some(")) && !head.trim_start().starts_with("Some(")
    if some_arm {
        todo.push(rs2nika_some_todo(head))
    }
    if line.contains("let [") {
        todo.push("slice pattern in a `let`: a `match` with a list pattern (ADR-355)")
    }
    if line.contains(".entry(") && (line.contains(").or_") || line.contains("Entry::")) {
        todo.push("`.entry(..)`: read with `??`, then write `m[k] = v`")
    }
    if line.contains(".iter()") && (line.contains(".cloned()") || line.contains(".copied()")) {
        todo.push("`.cloned()` of an iterator: a `for` loop with `push` of `x.clone()`")
    }
    if line.contains(".as_mut()") {
        todo.push("`.as_mut()`: clone the value, change it, assign it back")
    }
    if comb.contains("is_some_and") || comb.contains("map_or") {
        todo.push("`is_some_and`/`map_or`: `let x = e ?? <false>` then the test")
    }
    if rs2nika_result_read(line) {
        todo.push("a `Result` read as a value (`.ok()`, `.is_ok()`, `.is_err()`, `.is_ok_and(..)`) not over a call: Nikaia holds no `Result`; read it where the call is made, `call catch { null }` (Part I 7.1)")
    }
    if st.starts_with("let Err(") {
        todo.push("`let Err(e) = x else { .. }`: Nikaia has no `Result` value; the call under `catch { let e = error; .. }`, the jump after it")
    }
    if st.starts_with("let Ok(") && st.contains(" else ") && !rs2nika_let_ok_call(st) {
        todo.push("`let Ok(x) = r else { .. }` over a kept `Result`: Nikaia has none; write the call that made `r` as `let x = call catch { .. }`")
    }
    if line.contains(".get(") && rs2nika_get_range(line) {
        todo.push("`.get(range)`: Nikaia has no `get` of a range (NK1171); test the bounds, then cut `s[a..]` / `s[a..<b]`")
    }
    if line.contains("collect::<Option<") || line.contains("collect::<Result<") {
        todo.push("`collect` into an `Option`/`Result`: a `for` loop that pushes, and returns `null` (or throws) at the first miss")
    }
    // `.any`/`.all`/`.find` with a closure or a function name are rewritten
    // (R26); `.find` with anything else is `str::find`, which Nikaia has.
    let c: Vec[scalar] = line.chars().collect()
    for a in [".any(", ".find("] {
        let mut from = 0
        while true {
            let at = rs2nika_find_from(c, a, from)
            if at < 0 {
                break
            }
            let b = at + a.len()
            let mut e = b
            while e < c.len() && rs2nika_path_char(c[e]) {
                e = e + 1
            }
            let closure = b < c.len() && c[b] == '|'
            let named = e > b && e < c.len() && c[e] == ')'
            if !closure && !(named && a == ".any(") && a == ".any(" {
                todo.push("iterator adapter with no `Seq` method: a `for` loop")
                return todo
            }
            from = at + 1
        }
    }
    // R112: `flat_map` and `skip` are `Seq` methods, a TODO only off a `Seq`.
    for a in [".flat_map(", ".fold(", ".skip("] {
        if line.contains(a) && (a == ".fold(" || rs2nika_off_seq(line, a)) {
            todo.push("iterator adapter with no `Seq` method: a `for` loop")
            return todo
        }
    }
    return todo
}

/// `let x: T = ..` with its type respelled.
fn rs2nika_let_type(mut ctx: Rs2nikaCtx, line: String) -> String {
    let st: String = line.trim_start().clone()
    if !st.starts_with("let ") {
        return line.clone()
    }
    // R186: `let x: T =` whose value follows on the next line
    if line.ends_with(" =") {
        rs2nika_hit(ctx, "R186")
        return rs2nika_let_type(ctx, f"{line} ").trim_end().clone()
    }
    let eq = line.find(" = ") ?? return line.clone()
    let colon = line.find(":") ?? return rs2nika_let_literal(ctx, line)
    if colon > eq {
        return rs2nika_let_literal(ctx, line)
    }
    let head: String = line[0..<colon + 1].clone()
    let name: String = head[0..<head.len() - ":".len()].trim().clone()
    // only `let [mut] name:`
    let mut bare: String = (name.strip_prefix("let ") ?? "").clone()
    if bare.starts_with("mut ") {
        bare = (bare.strip_prefix("mut ") ?? "").clone()
    }
    // `let (a, b): (A, B) =` binds several names, which take no type (NK1136)
    if bare.starts_with("(") && bare.ends_with(")") {
        let mut names = true
        for part in rs2nika_split_args(bare["(".len()..<bare.len() - ")".len()].clone()) {
            names = names && rs2nika_is_path(part.trim().clone())
        }
        if names {
            rs2nika_hit(ctx, "R182")
            return f"{rs2nika_indent(line)}{name}{line[eq..<line.len()]}"
        }
    }
    if !rs2nika_is_path(bare) || bare.contains(":") {
        return line.clone()
    }
    let t: String = line[colon + 1..<eq].clone()
    if !(t.contains("<") || t.contains("&") || rs2nika_is_int(t.trim().clone())) {
        return line.clone()
    }
    let tt = rs2nika_ty(ctx, t)
    let rest: String = line[eq..<line.len()].clone()
    // R193: `Vec<_>` names no type in Nikaia: the value says it
    if tt.contains("[_]") || tt.contains("[_,") || tt.contains(", _]") || tt.contains(", _,") {
        rs2nika_hit(ctx, "R193")
        return f"{head[0..<head.len() - ":".len()]}{rest}"
    }
    return f"{head} {tt}{rest}"
}

/// R84: `let mut x = "";` -> `let mut x: String = "";`, `let mut n = 0;` ->
/// `let mut n: i64 = 0;`: a `mut` local starts from a literal whose type the
/// written program names.
fn rs2nika_let_literal(mut ctx: Rs2nikaCtx, line: String) -> String {
    if !ctx.free {
        return line.clone()
    }
    let eq = line.find(" = ") ?? return line.clone()
    let head: String = line[0..<eq].clone()
    let name: String = (head.trim_start().strip_prefix("let mut ") ?? return line.clone()).clone()
    if !rs2nika_is_path(name) {
        return line.clone()
    }
    let tail: String = line[eq + " = ".len()..].trim().clone()
    let mut v: String = tail.clone()
    if tail.ends_with(";") {
        v = (tail.strip_suffix(";") ?? "").trim().clone()
    }
    let mut ty: String = ""
    if (v.starts_with("\"") && v.ends_with("\"")) || v == "String::new()" {
        ty = "String"
    } else if v != "" && v.chars().all(fn(ch) { ch.is_ascii_digit() }) {
        ty = "i64"
    }
    if ty == "" {
        return line.clone()
    }
    rs2nika_hit(ctx, "R84")
    let rest: String = line[eq..].clone()
    return f"{head}: {ty}{rest}"
}

/// An arm `Some(x) => body`, `None => body` or `_ => body`: its pattern and
/// body, or an empty pattern.
fn rs2nika_option_arm(line: String) -> Vec[String] {
    let st: String = line.trim().clone()
    let arrow = st.find("=>") ?? return ["", ""]
    let pat: String = st[0..<arrow].trim().clone()
    let body: String = st[arrow + 2..<st.len()].trim().clone()
    if pat == "None" || pat == "_" {
        return [pat, body]
    }
    if pat.starts_with("Some(") && pat.ends_with(")") {
        let inner: String = ((pat.strip_prefix("Some(") ?? "").strip_suffix(")") ?? "").clone()
        if rs2nika_is_path(inner) && !inner.contains(":") {
            return [pat, body]
        }
    }
    return ["", ""]
}

/// R48: `match e { Some(x) => a, None => b }` -> `if e != null { a } else { b }`
/// (through R23, as `if let Some(x) = e {`), and `match e { Some(P) => a, None
/// => b }` as a statement -> `match e { Some(P) => .., else => .. }` (R24); a
/// pattern in a value's place keeps its `match`, so no `if let` is left.
fn rs2nika_option_matches(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = given.clone()
    let mut i = 0
    while i < out.len() {
        let line: String = out[i].clone()
        let at = rs2nika_find_from(line.chars().collect(), "match ", 0)
        let ok_head = at >= 0 && line.ends_with(" {") && !line.trim().starts_with("//") && (at == 0 || !rs2nika_word(line.chars().collect()[at - 1]))
        if !ok_head {
            i = i + 1
            continue
        }
        let c: Vec[scalar] = line.chars().collect()
        let ind = rs2nika_indent(line)
        let pre: String = rs2nika_text(c, ind.chars().count(), at)
        let subject: String = rs2nika_text(c, at + 6, c.len() - 2)
        let arm = f"{ind}    "
        let arm_deeper = f"{arm} "
        let closing = f"{ind}}}"
        let mut j = i + 1
        while j < out.len() && !(rs2nika_starts(out[j], closing) && rs2nika_indent(out[j]) == ind) {
            j = j + 1
        }
        if j >= out.len() {
            i = i + 1
            continue
        }
        let mut starts: Vec[i64] = []
        let mut k = i + 1
        while k < j {
            let t: String = out[k].trim().clone()
            if rs2nika_starts(out[k], arm) && !rs2nika_starts(out[k], arm_deeper) && !t.starts_with("//") && !t.starts_with("}") {
                starts.push(k)
            }
            k = k + 1
        }
        if starts.len() != 2 {
            i = i + 1
            continue
        }
        let first = rs2nika_option_arm(out[starts[0]])
        let second = rs2nika_option_arm(out[starts[1]])
        if first[0] == "" || second[0] == "" {
            i = i + 1
            continue
        }
        // R48: a statement `match` whose `None` arm leaves, in either order
        // -> `let x = e ?? <leave>` and the `Some(x)` arm's body after it
        let leaving = rs2nika_option_leave(ctx, out, i, j, starts, pre, subject, ind)
        if leaving.len() > 0 {
            let mut rebuilt: Vec[String] = []
            let mut r = 0
            while r < i {
                rebuilt.push(out[r].clone())
                r = r + 1
            }
            for n in leaving {
                rebuilt.push(n.clone())
            }
            r = j + 1
            while r < out.len() {
                rebuilt.push(out[r].clone())
                r = r + 1
            }
            out = rebuilt
            i = i + 1
            continue
        }
        if !first[0].starts_with("Some") {
            i = i + 1
            continue
        }
        // **R23 and R24 finish what R48 writes**: a name (`Some(x)`) anywhere,
        // another pattern only as a statement (R24's `match`).
        let bound: String = ((first[0].strip_prefix("Some(") ?? "").strip_suffix(")") ?? "").clone()
        let named = rs2nika_is_path(bound) && !bound.contains(":")
        if !named && pre.trim() != "" {
            i = i + 1
            continue
        }
        let mut new: Vec[String] = []
        // R64: `let x = match e { Some(v) => v, None => return y };` (also
        // `continue`/`break`, in a loop as well) -> `let x = e ?? return y`
        let b1: String = first[1].trim().trim_end_matches(",").trim().clone()
        let b2: String = second[1].trim().trim_end_matches(",").trim_end_matches(";").trim().clone()
        let jump = b2.starts_with("return") || b2.starts_with("continue") || b2.starts_with("break")
        if pre.starts_with("let ") && pre.trim_end().ends_with("=") && first[0] == f"Some({b1})" && second[0] == "None" && jump && starts[1] + 1 == j {
            let mut fallback: String = b2.clone()
            if b2 == "return None" {
                fallback = "return null"
            }
            let tail: String = (out[j].trim().strip_prefix("}") ?? "").clone()
            new.push(f"{ind}{pre}{subject} ?? {fallback}{tail}")
            rs2nika_hit(ctx, "R64")
        } else {
            new.push(f"{ind}{pre}if let {first[0]} = {subject} {{")
            rs2nika_arm_body(new, out, starts[0], starts[1], first[1], arm)
            new.push(f"{ind}}} else {{")
            rs2nika_arm_body(new, out, starts[1], j, second[1], arm)
            let tail: String = (out[j].trim().strip_prefix("}") ?? "").clone()
            new.push(f"{ind}}}{tail}")
        }
        let mut rebuilt: Vec[String] = []
        let mut r = 0
        while r < i {
            rebuilt.push(out[r].clone())
            r = r + 1
        }
        for n in new {
            rebuilt.push(n.clone())
        }
        r = j + 1
        while r < out.len() {
            rebuilt.push(out[r].clone())
            r = r + 1
        }
        out = rebuilt
        if !(new.len() == 1) {
            rs2nika_hit(ctx, "R48")
        }
        i = i + 1
    }
    return out
}

/// R48: the lines of `match e { Some(x) => <body>, None => <leave> }` as a
/// statement (either order; `_` for `None` after `Some`), where `<leave>` is one line of
/// `return`, `continue` or `break`: `let x = e ?? <leave>` and the
/// body dedented after it; none for any other shape.
fn rs2nika_option_leave(mut ctx: Rs2nikaCtx, out: ref Vec[String], i: i64, j: i64, starts: ref Vec[i64], pre: String, subject: String, ind: String) -> Vec[String] {
    let tail: String = (out[j].trim().strip_prefix("}") ?? "").trim().clone()
    if pre.trim() != "" || tail != "" {
        return []
    }
    let first = rs2nika_option_arm(out[starts[0]])
    let second = rs2nika_option_arm(out[starts[1]])
    let some_first = first[0].starts_with("Some")
    let mut some_arm: Vec[String] = second.clone()
    let mut none_arm: Vec[String] = first.clone()
    let mut s_k = starts[1]
    let mut s_end = j
    let mut n_end = starts[1]
    let mut n_k = starts[0]
    if some_first {
        some_arm = first.clone()
        none_arm = second.clone()
        s_k = starts[0]
        s_end = starts[1]
        n_k = starts[1]
        n_end = j
    }
    // `_` first would take every value: only `None` stands before `Some`
    if !some_arm[0].starts_with("Some(") || none_arm[0].starts_with("Some") || (!some_first && none_arm[0] != "None") || n_k + 1 != n_end {
        return []
    }
    let bound: String = ((some_arm[0].strip_prefix("Some(") ?? "").strip_suffix(")") ?? "").trim().clone()
    if !rs2nika_is_path(bound) || bound.contains(":") || bound.contains(" ") {
        return []
    }
    let leave: String = none_arm[1].trim().trim_end_matches(",").trim_end_matches(";").trim().clone()
    let w = rs2nika_first_word(leave)
    if !(w == "return" || w == "continue" || w == "break") || leave.ends_with("{") {
        return []
    }
    let mut fallback: String = leave.clone()
    if leave == "return None" {
        fallback = "return null"
    }
    let arm = f"{ind}    "
    let mut body: Vec[String] = []
    rs2nika_arm_body(body, out, s_k, s_end, some_arm[1], arm)
    let mut least = 0 - 1
    for b in body {
        if b.trim() != "" {
            let n = rs2nika_indent(b).chars().count()
            if least < 0 || n < least {
                least = n
            }
        }
    }
    let mut lines: Vec[String] = [f"{ind}let {bound} = {subject} ?? {fallback}"]
    for b in body {
        if b.trim() != "" {
            lines.push(rs2nika_moved(b, least, ind))
        }
    }
    rs2nika_hit(ctx, "R48")
    return lines
}

/// An arm's pattern of a `match` on an option: `Some(P)` -> `P`, `None` ->
/// `null`, `Some(P) | None` -> `P|null`, `_` -> `_`; otherwise "".
fn rs2nika_some_pattern(pat: String) -> String {
    if pat == "None" || pat == "_" {
        if pat == "None" {
            return "null"
        }
        return "_"
    }
    let mut p: String = pat.clone()
    let mut with_none = false
    if p.ends_with("| None") {
        p = p[0..<p.len() - "| None".len()].trim().clone()
        with_none = true
    } else if p.starts_with("None |") {
        p = (p.strip_prefix("None |") ?? "").trim().clone()
        with_none = true
    }
    if !p.starts_with("Some(") {
        return ""
    }
    // the `)` that closes `Some(`: a guard (`Some(x) if f(x)`) follows it
    let c: Vec[scalar] = p.chars().collect()
    let mut depth = 0
    let mut close = -1
    let mut at = 4
    while at < c.len() && close < 0 {
        if c[at] == '(' {
            depth = depth + 1
        } else if c[at] == ')' {
            depth = depth - 1
            if depth == 0 {
                close = at
            }
        }
        at = at + 1
    }
    if close < 0 {
        return ""
    }
    let inner: String = rs2nika_text(c, 5, close).trim().clone()
    let guard: String = rs2nika_text(c, close + 1, c.len()).trim().clone()
    if inner.contains("| ") || (guard != "" && (with_none || !guard.starts_with("if "))) {
        return ""
    }
    if with_none {
        return f"{inner}|null"
    }
    if guard != "" {
        return f"{inner} {guard}"
    }
    return inner
}

/// R55: `match e { Some(A) => .., Some(B(x)) => .., None => n }` ->
/// `let given = e ?? <n>` then `match given { A => .., B(x) => .. }`.
fn rs2nika_some_matches(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = given.clone()
    let mut i = 0
    while i < out.len() {
        let line: String = out[i].clone()
        let at = rs2nika_find_from(line.chars().collect(), "match ", 0)
        let ok_head = at >= 0 && line.ends_with(" {") && !line.trim().starts_with("//") && (at == 0 || !rs2nika_word(line.chars().collect()[at - 1]))
        if !ok_head {
            i = i + 1
            continue
        }
        let c: Vec[scalar] = line.chars().collect()
        let ind = rs2nika_indent(line)
        let pre: String = rs2nika_text(c, ind.chars().count(), at)
        let mut subject: String = rs2nika_text(c, at + 6, c.len() - 2).trim().clone()
        while subject.starts_with("&") {
            subject = (subject.strip_prefix("&") ?? "").clone()
        }
        let arm = f"{ind}    "
        let arm_deeper = f"{arm} "
        let closing = f"{ind}}}"
        let mut j = i + 1
        while j < out.len() && !(rs2nika_starts(out[j], closing) && rs2nika_indent(out[j]) == ind) {
            j = j + 1
        }
        if j >= out.len() {
            i = i + 1
            continue
        }
        let mut starts: Vec[i64] = []
        let mut pats: Vec[String] = []
        let mut ok = true
        let mut somes = 0
        let mut k = i + 1
        while k < j {
            let t: String = out[k].trim().clone()
            if rs2nika_starts(out[k], arm) && !rs2nika_starts(out[k], arm_deeper) && !t.starts_with("//") && !t.starts_with("}") {
                starts.push(k)
                let arrow = t.find("=>") ?? 0
                let p = rs2nika_some_pattern(t[0..<arrow].trim().clone())
                if arrow == 0 || p == "" {
                    ok = false
                }
                if p != "null" && p != "_" {
                    somes = somes + 1
                }
                pats.push(p.clone())
            }
            k = k + 1
        }
        if !ok || somes == 0 || starts.len() < 2 {
            i = i + 1
            continue
        }
        // the `None` arm's value: its one line, or the one line of its block
        let mut none: String = ""
        let mut n = 0
        while n < starts.len() {
            if pats[n] == "null" || pats[n] == "_" || pats[n].ends_with("|null") {
                let t: String = out[starts[n]].trim().clone()
                let arrow = t.find("=>") ?? 0
                let mut body: String = t[arrow + "=>".len()..<t.len()].trim().clone()
                let mut end = j
                if n + 1 < starts.len() {
                    end = starts[n + 1]
                }
                if body == "{" && end - starts[n] == 3 {
                    body = out[starts[n] + 1].trim().clone()
                }
                if body.ends_with(",") {
                    body = body[0..<body.len() - ",".len()].clone()
                }
                none = body.clone()
            }
            n = n + 1
        }
        let mut new: Vec[String] = []
        if none == "" {
            new.push(f"{ind}// TODO(rs2nika): no `None` arm found: the `??` fallback is yours")
            none = "return"
        } else if none.starts_with("panic!(") || none.starts_with("unreachable!(") {
            // R171: a panic leaves by itself, it takes no `return`
        } else if !(none.starts_with("return") || none.starts_with("continue") || none.starts_with("break")) {
            let tail = pre.trim() == "" && j + 1 < out.len() && out[j + 1].trim() == "}" && rs2nika_indent(out[j + 1]).len() < ind.len()
            if pre.trim() != "return" && !tail {
                let arms = rs2nika_some_arms_lines(ctx, out, starts, pats, j)
                if arms.len() > 0 {
                    out = arms
                    i = i + 1
                    continue
                }
                new.push(f"{ind}// TODO(rs2nika): the `None` arm is a value: `?? return` fits once this `match` is a function of its own (pattern check_claim_held)")
            }
            none = f"return {none}"
        }
        new.push(f"{ind}let given = {subject} ?? {none}")
        new.push(f"{ind}{pre}match given {{")
        let mut r = i + 1
        let mut a = 0
        while r < j {
            if a < starts.len() && r == starts[a] {
                let p: String = pats[a].clone()
                let mut end = j
                if a + 1 < starts.len() {
                    end = starts[a + 1]
                }
                a = a + 1
                if p == "null" {
                    r = end
                    continue
                }
                let t: String = out[r].trim().clone()
                let arrow = t.find("=>") ?? 0
                let rest: String = t[arrow..<t.len()].clone()
                let mut np: String = p.clone()
                if np.ends_with("|null") {
                    np = np[0..<np.len() - "|null".len()].clone()
                }
                if np == "_" {
                    np = "else"
                }
                new.push(f"{arm}{np} {rest}")
            } else {
                new.push(out[r].clone())
            }
            r = r + 1
        }
        let mut rebuilt: Vec[String] = []
        r = 0
        while r < i {
            rebuilt.push(out[r].clone())
            r = r + 1
        }
        for l in new {
            rebuilt.push(l.clone())
        }
        r = j
        while r < out.len() {
            rebuilt.push(out[r].clone())
            r = r + 1
        }
        out = rebuilt
        rs2nika_hit(ctx, "R55")
        i = i + 1
    }
    return out
}

/// R120: a `match` on an option whose `None` arm is a value, arm by arm in
/// place (ADR-352 D1: beside a `null` arm the other arms match the `T`):
/// `Some(P) =>` -> `P =>`, `None =>` -> `null =>`, `_ =>` -> `null =>`, and
/// `else =>` with the same one-line body after it where a `Some` arm can fail
/// (a guard, a pattern that tests). The lines with the arms rewritten, or
/// none (a `Some(P) | None` arm, a `_` arm of several lines that would be
/// needed twice).
fn rs2nika_some_arms_lines(mut ctx: Rs2nikaCtx, out: ref Vec[String], starts: ref Vec[i64], pats: ref Vec[String], j: i64) -> Vec[String] {
    let mut has_null = false
    let mut refutable = false
    let mut n = 0
    while n < pats.len() {
        let p: String = pats[n].clone()
        if p.ends_with("|null") {
            return []
        }
        if p == "null" {
            has_null = true
        } else if p != "_" && !rs2nika_irrefutable(p) {
            refutable = true
        }
        n = n + 1
    }
    let mut rebuilt: Vec[String] = []
    let mut r = 0
    let mut a = 0
    while r < out.len() {
        if a < starts.len() && r == starts[a] {
            let line: String = out[r].clone()
            let arm = rs2nika_indent(line)
            let t: String = line.trim().clone()
            let arrow = t.find("=>") ?? return []
            let rest: String = t[arrow..<t.len()].clone()
            let p: String = pats[a].clone()
            let mut end = j
            if a + 1 < starts.len() {
                end = starts[a + 1]
            }
            a = a + 1
            if p == "_" && has_null {
                rebuilt.push(f"{arm}else {rest}")
            } else if p == "_" {
                rebuilt.push(f"{arm}null {rest}")
                if refutable {
                    if end - r != 1 {
                        return []
                    }
                    rebuilt.push(f"{arm}else {rest}")
                }
            } else {
                rebuilt.push(f"{arm}{p} {rest}")
            }
        } else {
            rebuilt.push(out[r].clone())
        }
        r = r + 1
    }
    rs2nika_hit(ctx, "R120")
    return rebuilt
}

/// For R120: whether a pattern always matches (names, `_`, tuples of them).
fn rs2nika_irrefutable(p: String) -> bool {
    if p.contains(" if ") || p.contains("::") || p.contains("..") {
        return false
    }
    let mut word: String = ""
    for ch in f"{p} ".chars() {
        if rs2nika_word(ch) {
            word.push(ch)
            continue
        }
        if word != "" {
            let first = word.chars().next() ?? '_'
            if !(first == '_' || first.is_lowercase()) || word == "true" || word == "false" {
                return false
            }
            word = ""
        }
        if !(ch == '(' || ch == ')' || ch == ',' || ch == ' ') {
            return false
        }
    }
    return true
}

fn rs2nika_arm_body(mut new: Vec[String], out: ref Vec[String], k: i64, end: i64, first: String, arm: String) {
    let mut body: Vec[String] = []
    if first.starts_with("{") {
        body.push((first.strip_prefix("{") ?? "").trim().clone())
        let mut r = k + 1
        while r < end {
            body.push(out[r].clone())
            r = r + 1
        }
        while body.len() > 0 && body[body.len() - 1].trim() == "" {
            body.pop()
        }
        if body.len() > 0 {
            let mut last: String = body[body.len() - 1].trim().clone()
            if last.ends_with(",") {
                last = last[0..<last.len() - ",".len()].clone()
            }
            if last == "}" {
                body.pop()
            }
        }
        let mut kept: Vec[String] = []
        for b in body {
            if b.trim() != "" {
                kept.push(b.clone())
            }
        }
        body = kept
    } else {
        let f: String = first.clone()
        body.push(f)
        let mut r = k + 1
        while r < end {
            body.push(out[r].clone())
            r = r + 1
        }
        let n = body.len()
        let mut last: String = body[n - 1].trim_end().clone()
        if last.ends_with(",") {
            last = last[0..<last.len() - ",".len()].clone()
        }
        body.pop()
        body.push(last)
    }
    for b in body {
        if b.starts_with(arm) {
            new.push(b.clone())
        } else {
            let t: String = b.trim().clone()
            new.push(f"{arm}{t}")
        }
    }
}

/// R22 and R23: `let Some(x) = e else { return y }` and `if let Some(x) = e {`;
/// the lines it becomes, or none.
/// R58: what makes a line Rust-only, so that the cut between the Rust adapter
/// and the Nikaia core shows: the parsed files (`Parsed`, beyond the one
/// `parsed: &Parsed` the profile maps to its world), the ledgers, the whole
/// checker `check(..)` and iterator chains over files; "" where none.
fn rs2nika_adapter_mark(raw: String, signature: bool) -> String {
    let st: String = raw.trim().clone()
    if st.starts_with("//") {
        return ""
    }
    if raw.contains("[&Parsed]") || raw.contains("Vec<&Parsed>") {
        return "a list of `Parsed` files: the Nikaia core takes one `ref ParsedView`"
    }
    if raw.contains("Ledger") {
        return "`Ledger`"
    }
    if signature {
        return ""
    }
    let c: Vec[scalar] = raw.chars().collect()
    for w in ["Parsed", "check(", "once(", "std::iter::once(", "check_package("] {
        let mut from = 0
        while true {
            let at = rs2nika_find_from(c, w, from)
            if at < 0 {
                break
            }
            if at == 0 || !(rs2nika_word(c[at - 1]) || c[at - 1] == '.' || c[at - 1] == ':') {
                return f"`{w}`"
            }
            from = at + 1
        }
    }
    return ""
}

/// The names a pattern binds: lowercase words not after `::`, not `_`.
fn rs2nika_bound(pat: String) -> Vec[String] {
    let c: Vec[scalar] = pat.chars().collect()
    let mut out: Vec[String] = []
    let mut at = 0
    while at < c.len() {
        if rs2nika_word(c[at]) {
            let mut e = at
            while e < c.len() && rs2nika_word(c[e]) {
                e = e + 1
            }
            let w = rs2nika_text(c, at, e)
            let after_path = at > 1 && c[at - 1] == ':'
            let field = e < c.len() && c[e] == ':' && !(e + 1 < c.len() && c[e + 1] == ':')
            let is_path = e + 1 < c.len() && c[e] == ':' && c[e + 1] == ':'
            if rs2nika_lower(c[at]) && w != "_" && !after_path && !field && !is_path && !rs2nika_is_int(w) && w != "ref" && w != "mut" {
                out.push(w.clone())
            }
            at = e
        } else {
            at = at + 1
        }
    }
    return out
}

/// R56: `while let P = e && let Some(t) = f(..) {` -> `while true {` and one
/// `let .. ?? break` or `match .. else => break` per condition.
fn rs2nika_while_let(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let st: String = line.trim().clone()
    let conds: String = ((st.strip_prefix("while ") ?? "").strip_suffix(" {") ?? "").clone()
    let mut out: Vec[String] = [f"{ind}while true {{"]
    for part in conds.split(" && ") {
        let p: String = part.trim().clone()
        if !p.starts_with("let ") {
            let code = rs2nika_expr(ctx, p)
            out.push(f"{ind}    if !({code}) {{ break }}")
            continue
        }
        let eq = p.find(" = ") ?? return []
        let pat: String = (p[..<eq].strip_prefix("let ") ?? "").trim().clone()
        let value: String = rs2nika_expr(ctx, p[eq + 3..<p.len()].trim().clone())
        if pat.starts_with("Some(") && pat.ends_with(")") && rs2nika_is_path(((pat.strip_prefix("Some(") ?? "").strip_suffix(")") ?? "").clone()) {
            let inner: String = ((pat.strip_prefix("Some(") ?? "").strip_suffix(")") ?? "").clone()
            out.push(f"{ind}    let {inner} = {value} ?? break")
            continue
        }
        let pat_n = rs2nika_expr(ctx, pat)
        let names = rs2nika_bound(pat)
        if names.len() == 0 {
            out.push(f"{ind}    if !(match {value} {{ {pat_n} => true, else => false }}) {{ break }}")
        } else if names.len() == 1 {
            out.push(f"{ind}    let {names[0]} = match {value} {{ {pat_n} => {names[0]}, else => break }}")
        } else {
            let tuple = rs2nika_join(names, ", ")
            out.push(f"{ind}    let ({tuple}) = match {value} {{ {pat_n} => ({tuple}), else => break }}")
        }
    }
    rs2nika_hit(ctx, "R56")
    return out
}

/// R59: `let v: T = xs.iter().filter(|x| p).cloned().collect();` -> a `for`
/// loop with `push(x.clone())`: `Seq` has no `cloned`.
fn rs2nika_filter_cloned(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    if st.ends_with(";") {
        st = st[0..<st.len() - ";".len()].clone()
    }
    // R94: `.iter().cloned().filter(..).collect()` is the same pipeline;
    // `.copied()` pushes the element itself.
    let mut push_clone = ".clone()"
    for pre in [".iter().cloned().filter(|", ".iter().copied().filter(|"] {
        if st.contains(pre) && st.ends_with(").collect()") && !st.ends_with(".cloned().collect()") {
            if pre.contains("copied") {
                push_clone = ""
            }
            let body: String = (st.replace(pre, ".iter().filter(|").strip_suffix(".collect()") ?? "").clone()
            st = f"{body}.cloned().collect()"
            rs2nika_hit(ctx, "R94")
        }
    }
    let tail = ".cloned().collect()"
    let mid = ".iter().filter(|"
    if !st.starts_with("let ") || !st.ends_with(tail) {
        return []
    }
    let eq = st.find(" = ") ?? return []
    let colon = st.find(": ") ?? return []
    let at = st.find(mid) ?? return []
    if colon > eq || eq > at {
        return []
    }
    let name: String = (st[..<colon].strip_prefix("let ") ?? "").trim().clone()
    let ty: String = st[colon + 2..<eq].trim().clone()
    let recv: String = st[eq + 3..<at].trim().clone()
    let chain: String = st[at + ".iter()".len()..<st.len() - ".cloned().collect()".len()].clone()
    let chained = rs2nika_filter_chain(ctx, chain, ind)
    if chained.len() > 0 && !name.starts_with("mut ") {
        let typed0 = rs2nika_let_type(ctx, f"let mut {name}: {ty} = []")
        let head0: String = rs2nika_expr(ctx, typed0)
        let r0 = rs2nika_expr(ctx, recv)
        let var0: String = chained[0].clone()
        let mut lines: Vec[String] = [f"{ind}{head0.trim()}", f"{ind}for {var0} in {r0} {{"]
        let mut i = 1
        while i < chained.len() {
            lines.push(chained[i].clone())
            i = i + 1
        }
        lines.push(f"{ind}    {name}.push({var0}{push_clone})")
        lines.push(f"{ind}}}")
        rs2nika_hit(ctx, "R59")
        return lines
    }
    let rest: String = st[at + ".iter().filter(|".len()..<st.len() - ".cloned().collect()".len()].clone()
    let bar = rest.find("|") ?? return []
    let mut var: String = rest[0..<bar].trim().clone()
    while var.starts_with("&") {
        var = (var.strip_prefix("&") ?? "").clone()
    }
    let mut body: String = rest[bar + 1..<rest.len()].trim().clone()
    if !body.ends_with(")") || !rs2nika_is_path(var) || name.starts_with("mut ") {
        return []
    }
    body = body[0..<body.len() - ")".len()].trim().clone()
    while body.contains(f"*{var}") {
        body = body.replace(f"*{var}", var)
    }
    let typed = rs2nika_let_type(ctx, f"let mut {name}: {ty} = []")
    let head: String = rs2nika_expr(ctx, typed)
    let r = rs2nika_expr(ctx, recv)
    let b = rs2nika_expr(ctx, body)
    rs2nika_hit(ctx, "R59")
    return [f"{ind}{head.trim()}", f"{ind}for {var} in {r} {{", f"{ind}    if {b} {{", f"{ind}        {name}.push({var}{push_clone})", f"{ind}    }}", f"{ind}}}"]
}

/// A place: a name or a chain of fields (`self.units`), no call, no index.
fn rs2nika_is_place(text: String) -> bool {
    if text == "" || text.starts_with(".") || text.ends_with(".") || text.contains("..") {
        return false
    }
    for c in text.chars() {
        if !(rs2nika_word(c) || c == ':' || c == '.') {
            return false
        }
    }
    return true
}

/// The first of `names` that `line` does not use as a name.
fn rs2nika_fresh(line: String, names: ref Vec[String]) -> String {
    for n in names {
        if rs2nika_replace_name(line, n, "") == line {
            return n.clone()
        }
    }
    return names[names.len() - 1].clone()
}

/// `xs` of `xs.iter()`, `xs.into_iter()` or `&xs` when `xs` is a place, else
/// `""`.
fn rs2nika_iter_place(given: String) -> String {
    let mut r: String = given.trim().clone()
    let mut found = false
    for m in [".iter()", ".into_iter()"] {
        if !found && r.ends_with(m) {
            r = (r.strip_suffix(m) ?? "").clone()
            found = true
        }
    }
    if !found && r.starts_with("&") && !r.starts_with("&mut ") {
        r = (r.strip_prefix("&") ?? "").clone()
        found = true
    }
    if !found || !rs2nika_is_place(r) {
        return ""
    }
    return r
}

/// R93: `for (i, x) in xs.iter().enumerate() {` -> `for i in 0..<xs.len() {`
/// and `let x = xs[i]`; `for x in xs.iter().skip(n) {` -> `for at in
/// n..<xs.len() {` the same. A range, not a `while`: a `continue` in the body
/// still steps the index. `iter_mut` and a `mut` element stay under the TODO.
fn rs2nika_index_for(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let st: String = line.trim().clone()
    if !st.starts_with("for ") || !st.ends_with(" {") {
        return []
    }
    let inn = st.find(" in ") ?? return []
    let pat: String = st["for ".len()..<inn].trim().clone()
    let seq: String = st[inn + " in ".len()..<st.len() - " {".len()].trim().clone()
    let mut index: String = ""
    let mut elem: String = ""
    let mut from: String = "0"
    let mut recv: String = ""
    if seq.ends_with(".enumerate()") {
        if !pat.starts_with("(") || !pat.ends_with(")") {
            return []
        }
        let parts: Vec[String] = rs2nika_split_args(((pat.strip_prefix("(") ?? "").strip_suffix(")") ?? "").clone())
        if parts.len() != 2 {
            return []
        }
        index = parts[0].trim().clone()
        elem = parts[1].trim().clone()
        if !rs2nika_is_path(index) || index == "_" || index.contains(":") {
            return []
        }
        recv = rs2nika_iter_place(seq[0..<seq.len() - ".enumerate()".len()].clone())
    } else if seq.ends_with(")") {
        let at = seq.find(".skip(") ?? return []
        let n: String = seq[at + ".skip(".len()..<seq.len() - ")".len()].trim().clone()
        if !rs2nika_is_path(n) {
            return []
        }
        from = n
        elem = pat.clone()
        recv = rs2nika_iter_place(seq[0..<at].clone())
        index = rs2nika_fresh(line, ["at", "k", "skipped_at"])
    } else {
        return []
    }
    while elem.starts_with("&") && !elem.starts_with("&mut ") {
        elem = (elem.strip_prefix("&") ?? "").clone()
    }
    if recv == "" || elem == "" || elem.contains("&") || elem.contains("mut ") {
        return []
    }
    let mut out: Vec[String] = ["=", f"{ind}for {index} in {from}..{recv}.len() {{"]
    if elem != "_" {
        out.push(f"{ind}    let {elem} = {recv}[{index}]")
    }
    rs2nika_hit(ctx, "R93")
    return out
}

/// R94: `out.extend(xs.iter().cloned());` -> `for x in xs { out.push(x.clone()) }`,
/// `.copied()` the same with `push(x)`.
fn rs2nika_extend_cloned(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    if st.ends_with(";") {
        st = st[0..<st.len() - ";".len()].clone()
    }
    if !st.ends_with("))") {
        return []
    }
    let at = st.find(".extend(") ?? return []
    let target: String = st[0..<at].clone()
    let mut arg: String = st[at + ".extend(".len()..<st.len() - ")".len()].clone()
    let mut how: String = ".clone()"
    if arg.ends_with(".cloned()") {
        arg = arg[0..<arg.len() - ".cloned()".len()].clone()
    } else if arg.ends_with(".copied()") {
        arg = arg[0..<arg.len() - ".copied()".len()].clone()
        how = ""
    } else {
        return []
    }
    let recv = rs2nika_iter_place(arg)
    if recv == "" || !rs2nika_is_place(target) {
        return []
    }
    let x = rs2nika_fresh(line, ["x", "item", "one"])
    rs2nika_hit(ctx, "R94")
    return ["=", f"{ind}for {x} in {recv} {{", f"{ind}    {target}.push({x}{how})", f"{ind}}}"]
}

/// R94: `let v = xs.iter().fold(init, |acc, x| e);` -> `let mut v = init` and
/// `for x in xs { v = e }`, `acc` read as `v`. R113: also over any `Seq`
/// chain (`for x in s.bytes() {`), a function for the closure (`v = f(v, x)`),
/// a closure block of statements (each one in the loop, the tail assigned),
/// `return xs.iter().fold(..)` (into `folded`, then `return folded`) and a
/// block's tail `xs.iter().fold(..)` (into `folded`, then `folded`).
fn rs2nika_fold_for(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    if st.ends_with(";") {
        st = st[0..<st.len() - ";".len()].clone()
    }
    let returned = st.starts_with("return ")
    let at = st.find(".fold(") ?? return []
    // a block's tail: no `let`, no `return`, a receiver with no space
    let tail = !st.starts_with("let ") && !returned && !st[0..<at].contains(" ") && !st[0..<at].contains("=")
    if !(st.starts_with("let ") || returned || tail) || !st.ends_with(")") {
        return []
    }
    let mut name: String = ""
    let mut given: String = ""
    if st.starts_with("let ") {
        let eq = st.find(" = ") ?? return []
        if at < eq {
            return []
        }
        name = st["let ".len()..<eq].trim().clone()
        given = st[eq + " = ".len()..<at].trim().clone()
    } else if returned {
        name = rs2nika_fresh(line, ["folded", "acc_all", "fold_out"])
        given = st["return ".len()..<at].trim().clone()
    } else {
        name = rs2nika_fresh(line, ["folded", "acc_all", "fold_out"])
        given = st[0..<at].trim().clone()
    }
    let mut new_form = returned || tail
    if name.starts_with("mut ") {
        name = (name.strip_prefix("mut ") ?? "").trim().clone()
    }
    let colon = name.find(":") ?? name.len()
    let mut var: String = name[0..<colon].trim().clone()
    let mut recv = rs2nika_iter_place(given)
    let c: Vec[scalar] = st.chars().collect()
    if recv == "" && rs2nika_seq_before(c, at) {
        recv = given.clone()
        new_form = true
    }
    let close = rs2nika_closing(c, at + ".fold".len(), '(', ')')
    if recv == "" || close != c.len() - 1 || !rs2nika_is_path(var) || var.contains(":") {
        return []
    }
    let inner: String = rs2nika_text(c, at + ".fold(".len(), close)
    let mut init: String = ""
    let mut params: Vec[String] = []
    let mut body: String = ""
    if inner.contains(", |") {
        let split = inner.find(", |") ?? return []
        init = inner[0..<split].trim().clone()
        let lam: String = inner[split + ", |".len()..<inner.len()].clone()
        let bar = lam.find("|") ?? return []
        params = rs2nika_split_args(lam[0..<bar].clone())
        body = lam[bar + 1..<lam.len()].trim().clone()
    } else {
        let args = rs2nika_split_args(inner)
        if args.len() != 2 || !rs2nika_is_path(args[1]) {
            return []
        }
        init = args[0].clone()
        let x0 = rs2nika_fresh(line, ["x", "item", "one"])
        params = ["acc", x0.clone()]
        body = f"{args[1]}(acc, {x0})"
        new_form = true
    }
    // a block of one expression is that expression
    if body.starts_with("{") && body.ends_with("}") && !body.contains(";") {
        body = ((body.strip_prefix("{") ?? "").strip_suffix("}") ?? "").trim().clone()
    }
    let mut stmts: Vec[String] = []
    if body.starts_with("{") && body.ends_with("}") {
        let parts = rs2nika_semis(((body.strip_prefix("{") ?? "").strip_suffix("}") ?? "").trim().clone())
        if parts.len() < 2 {
            return []
        }
        let mut k = 0
        while k + 1 < parts.len() {
            stmts.push(parts[k].clone())
            k = k + 1
        }
        body = parts[parts.len() - 1].clone()
        new_form = true
    }
    if params.len() != 2 || body.starts_with("{") || body == "" {
        return []
    }
    let mut acc: String = params[0].trim().clone()
    if acc.starts_with("mut ") {
        acc = (acc.strip_prefix("mut ") ?? "").trim().clone()
    }
    let mut x: String = params[1].trim().clone()
    while x.starts_with("&") {
        x = (x.strip_prefix("&") ?? "").clone()
    }
    if !rs2nika_is_path(acc) || acc.contains(":") || x.contains(":") || x.contains("&") || x.contains("mut ") {
        return []
    }
    // after `return` or as a tail the closure's own name stays: a rename
    // would also rename a field of that name (`Cast { expr: expr }`)
    let around = f"{init} {recv}"
    let own = rs2nika_replace_name(around, acc, "") == around
    if (returned || tail) && inner.contains(", |") && acc != "_" && own {
        name = acc.clone()
        var = acc.clone()
    }
    let b = rs2nika_replace_name(body, acc, var)
    let mut out: Vec[String] = ["=", f"{ind}let mut {name} = {init}", f"{ind}for {x} in {recv} {{"]
    for s in stmts {
        out.push(f"{ind}    {rs2nika_replace_name(s, acc, var)}")
    }
    if b != var {
        out.push(f"{ind}    {var} = {b}")
    }
    out.push(f"{ind}}}")
    if returned {
        out.push(f"{ind}return {var}")
    } else if tail {
        out.push(f"{ind}{var}")
    }
    if new_form {
        rs2nika_hit(ctx, "R113")
    } else {
        rs2nika_hit(ctx, "R94")
    }
    return out
}

/// The statements of a block's text, split at the `;` outside brackets and
/// strings, each trimmed, none empty; the tail last.
fn rs2nika_semis(text: String) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut cur: String = ""
    let mut depth = 0
    let mut quoted = false
    let mut escaped = false
    for ch in text.chars() {
        if quoted {
            if escaped {
                escaped = false
            } else if ch == '\\' {
                escaped = true
            } else if ch == '"' {
                quoted = false
            }
        } else if ch == '"' {
            quoted = true
        } else if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1
        }
        if ch == ';' && depth == 0 && !quoted {
            if cur.trim() != "" {
                out.push(cur.trim().clone())
            }
            cur = ""
        } else {
            cur.push(ch)
        }
    }
    if cur.trim() != "" {
        out.push(cur.trim().clone())
    }
    return out
}

/// R92: a map's `entry` read with `??` and written back with `m[k] = v`:
/// `m.entry(k).or_insert(d);` -> `if m[k] == null { m[k] = d }`;
/// `m.entry(k).or_default().push(x);` -> `let mut slot = m[k]?.clone() ?? []`,
/// `slot.push(x)`, `m[k] = slot`; `*m.entry(k).or_insert(0) += n;` ->
/// `m[k] = (m[k] ?? 0) + n`. Each write is `m[k.clone()]`: the map keeps its
/// own key (a view is refused, NK1105). The map and the key are places (a
/// key's `.clone()` / `.to_string()` goes, it is read three times); a bound
/// entry (`let e = m.entry(k)..`) stays under the TODO.
fn rs2nika_entry(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    if st.ends_with(";") {
        st = st[0..<st.len() - ";".len()].clone()
    }
    let deref = st.starts_with("*")
    if deref {
        st = (st.strip_prefix("*") ?? "").clone()
    }
    let c: Vec[scalar] = st.chars().collect()
    let at = rs2nika_find_from(c, ".entry(", 0)
    if at < 0 {
        return []
    }
    let map: String = rs2nika_text(c, 0, at)
    let close = rs2nika_closing(c, at + ".entry".len(), '(', ')')
    if close < 0 || !rs2nika_is_place(map) {
        return []
    }
    let mut key: String = rs2nika_text(c, at + ".entry(".len(), close).trim().clone()
    for m in [".clone()", ".to_string()", ".to_owned()"] {
        if key.ends_with(m) {
            key = (key.strip_suffix(m) ?? "").clone()
        }
    }
    while key.starts_with("&") || key.starts_with("*") {
        key = (key.strip_prefix("&") ?? key.strip_prefix("*") ?? "").clone()
    }
    if !rs2nika_is_place(key) {
        return []
    }
    let rest: String = rs2nika_text(c, close + 1, c.len())
    let mut dflt: String = ""
    let mut after: String = ""
    if rest.starts_with(".or_default()") {
        after = (rest.strip_prefix(".or_default()") ?? "").clone()
    } else if rest.starts_with(".or_insert(") || rest.starts_with(".or_insert_with(") {
        let rc: Vec[scalar] = rest.chars().collect()
        let open = rs2nika_find_from(rc, "(", 0)
        let shut = rs2nika_closing(rc, open, '(', ')')
        if open < 0 || shut < 0 {
            return []
        }
        let arg: String = rs2nika_text(rc, open + 1, shut).trim().clone()
        if !rest.starts_with(".or_insert_with(") {
            dflt = arg
        } else if arg.starts_with("||") {
            dflt = (arg.strip_prefix("||") ?? "").trim().clone()
        } else if rs2nika_is_path(arg) {
            dflt = f"{arg}()"
        } else {
            return []
        }
        after = rs2nika_text(rc, shut + 1, rc.len())
    } else {
        return []
    }
    let read: String = f"{map}[{key}]"
    // a map keeps its own key: the write takes a copy (a view is refused)
    let write: String = f"{map}[{key}.clone()]"
    if after == "" && !deref {
        if dflt == "" {
            return []
        }
        rs2nika_hit(ctx, "R92")
        return ["=", f"{ind}if {read} == null {{", f"{ind}    {write} = {dflt}", f"{ind}}}"]
    }
    if deref {
        let mut op: String = ""
        let mut n: String = ""
        if after.starts_with(" += ") {
            op = "+"
            n = (after.strip_prefix(" += ") ?? "").trim().clone()
        } else if after.starts_with(" -= ") {
            op = "-"
            n = (after.strip_prefix(" -= ") ?? "").trim().clone()
        }
        if op == "" || n == "" {
            return []
        }
        if dflt == "" {
            dflt = "0"
        }
        rs2nika_hit(ctx, "R92")
        return ["=", f"{ind}{write} = ({read} ?? {dflt}) {op} {n}"]
    }
    // a method on the entry's value: it is changed in a copy written back
    let ac: Vec[scalar] = after.chars().collect()
    let open = rs2nika_find_from(ac, "(", 0)
    if !after.starts_with(".") || open < 0 || rs2nika_closing(ac, open, '(', ')') != ac.len() - 1 {
        return []
    }
    let method: String = rs2nika_text(ac, 1, open)
    let margs: Vec[String] = rs2nika_split_args(rs2nika_text(ac, open + 1, ac.len() - 1))
    if !rs2nika_is_path(method) || method.contains(":") {
        return []
    }
    if dflt == "" {
        if method == "push" {
            dflt = "Vec::new()"
        } else if method == "insert" && margs.len() == 1 {
            dflt = "BTreeSet::new()"
        } else if method == "insert" && margs.len() == 2 {
            dflt = "BTreeMap::new()"
        } else {
            return []
        }
    }
    let slot = rs2nika_fresh(line, ["slot", "entry_slot"])
    rs2nika_hit(ctx, "R92")
    return ["=", f"{ind}let mut {slot} = {read}¿.clone() ?? {dflt}", f"{ind}{slot}{after}", f"{ind}{write} = {slot}"]
}

/// The rules that turn an iterator pipeline into a loop over the list (R93,
/// R94), and a map's `entry` into a read and a write (R92).
fn rs2nika_iter_loops(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let indexed = rs2nika_index_for(ctx, line)
    if indexed.len() > 0 {
        return indexed
    }
    let extended = rs2nika_extend_cloned(ctx, line)
    if extended.len() > 0 {
        return extended
    }
    let folded = rs2nika_fold_for(ctx, line)
    if folded.len() > 0 {
        return folded
    }
    return rs2nika_entry(ctx, line)
}

/// A step a `Seq` chain passes through on its way back to its root (R110-R113).
fn rs2nika_seq_step(name: String) -> bool {
    for s in ["filter", "map", "rev", "skip", "take", "filter_map", "flat_map", "zip", "copied", "cloned", "skip_while", "take_while", "enumerate", "chain"] {
        if name == s {
            return true
        }
    }
    return false
}

/// Whether the text `c[0..<end]`, ending in a call, is a `Seq`: back over
/// `Seq` steps to `.iter()`, `.into_iter()`, `.keys()`, `.values()`,
/// `.chars()`, `.lines()`, `.bytes()` or a range in brackets.
fn rs2nika_seq_before(c: ref Vec[scalar], end: i64) -> bool {
    let mut at = end
    while at > 0 && c[at - 1] == ')' {
        let mut depth = 0
        let mut k = at - 1
        while k >= 0 {
            if c[k] == ')' {
                depth = depth + 1
            } else if c[k] == '(' {
                depth = depth - 1
                if depth == 0 {
                    break
                }
            }
            k = k - 1
        }
        if k < 0 {
            return false
        }
        let mut s = k
        while s > 0 && rs2nika_word(c[s - 1]) {
            s = s - 1
        }
        if s == k {
            return rs2nika_text(c, k, at).contains("..")
        }
        if s == 0 || c[s - 1] != '.' {
            return false
        }
        let name = rs2nika_text(c, s, k)
        if k + 1 == at - 1 {
            for r in ["iter", "into_iter", "keys", "values", "chars", "lines", "bytes"] {
                if name == r {
                    return true
                }
            }
        }
        if !rs2nika_seq_step(name) {
            return false
        }
        at = s - 1
    }
    return false
}

/// Whether some `what` in `line` (`.flat_map(` ..) is not a step of a `Seq`.
pub fn rs2nika_off_seq(line: String, what: String) -> bool {
    let c: Vec[scalar] = line.chars().collect()
    let mut from = 0
    while true {
        let at = rs2nika_find_from(c, what, from)
        if at < 0 {
            return false
        }
        if !rs2nika_seq_before(c, at) {
            return true
        }
        from = at + 1
    }
    return false
}

/// R110: `.copied()` of a `Seq` goes (a `Seq` over a list hands out its
/// elements), `.cloned()` becomes `.map(|x| x.clone())`; in a `for` header
/// over `xs.iter()` both go and the loop runs over `xs`. R111: `xs.iter()
/// .enumerate().map(|(i, x)| b)` -> `(0..xs.len()).map(|i| { let x = xs[i];
/// b })`, the same for `filter_map`, `flat_map`, `any`, `all`; a `filter` on
/// the pair keeps the index and the next step takes the element.
fn rs2nika_seq_rewrite(mut ctx: Rs2nikaCtx, line: String) -> String {
    let mut out: String = line.clone()
    for m in [".copied()", ".cloned()"] {
        let mut from = 0
        while true {
            let c: Vec[scalar] = out.chars().collect()
            let at = rs2nika_find_from(c, m, from)
            if at < 0 {
                break
            }
            if !rs2nika_seq_before(c, at) {
                from = at + 1
                continue
            }
            let head: String = rs2nika_text(c, 0, at)
            let mut put: String = ""
            let st: String = out.trim().clone()
            let in_for = st.starts_with("for ") && st.ends_with(f"{m} {{")
            if m == ".cloned()" && !in_for {
                let x = rs2nika_fresh(out, ["x", "item", "one"])
                put = f".map(|{x}| {x}.clone())"
            }
            out = f"{head}{put}{rs2nika_text(c, at + m.len(), c.len())}"
            from = at + put.len()
            rs2nika_hit(ctx, "R110")
        }
    }
    let st: String = out.trim().clone()
    if out != line && st.starts_with("for ") && st.ends_with(" {") {
        let inn = st.find(" in ") ?? return out
        let seq: String = st[inn + " in ".len()..<st.len() - " {".len()].clone()
        let place = rs2nika_iter_place(seq)
        if place != "" {
            let lead: String = st[0..<inn + " in ".len()].clone()
            out = f"{rs2nika_indent(line)}{lead}{place} {{"
        }
    }
    return rs2nika_seq_enumerate(ctx, out)
}

/// R111 (see `rs2nika_seq_rewrite`), every `xs.iter().enumerate().` of a
/// place in `line`.
fn rs2nika_seq_enumerate(mut ctx: Rs2nikaCtx, line: String) -> String {
    let mut out: String = line.clone()
    let mut from = 0
    while true {
        let c: Vec[scalar] = out.chars().collect()
        let at = rs2nika_find_from(c, ".enumerate().", from)
        if at < 0 {
            return out
        }
        from = at + 1
        let mut base = at
        for r in [".iter()", ".into_iter()"] {
            let rc: Vec[scalar] = r.chars().collect()
            if base == at && at >= rc.len() && rs2nika_text(c, at - rc.len(), at) == r {
                base = at - rc.len()
            }
        }
        let mut s = base
        while s > 0 && (rs2nika_word(c[s - 1]) || c[s - 1] == '.' || c[s - 1] == ':') {
            s = s - 1
        }
        let xs: String = rs2nika_text(c, s, base)
        if base == at || !rs2nika_is_place(xs) || (s > 0 && (c[s - 1] == '&' || c[s - 1] == '*')) {
            continue
        }
        let mut p = at + ".enumerate()".len()
        let mut steps: String = ""
        let mut done = false
        let mut ok = true
        while !done && ok {
            let dot = p
            let mut e = dot + 1
            while e < c.len() && rs2nika_word(c[e]) {
                e = e + 1
            }
            let name = rs2nika_text(c, dot + 1, e)
            if dot >= c.len() || c[dot] != '.' || e >= c.len() || c[e] != '(' {
                ok = false
                break
            }
            if name == "count" && steps != "" && e + 1 < c.len() && c[e + 1] == ')' {
                done = true
                break
            }
            let close = rs2nika_closing(c, e, '(', ')')
            let arg: String = rs2nika_text(c, e + 1, close).trim().clone()
            let pass = name == "filter" || name == "skip_while" || name == "take_while"
            let takes = pass || name == "map" || name == "filter_map" || name == "flat_map" || name == "any" || name == "all"
            if close < 0 || !takes || !arg.starts_with("|(") {
                ok = false
                break
            }
            let ac: Vec[scalar] = arg.chars().collect()
            let pclose = rs2nika_closing(ac, 1, '(', ')')
            if pclose < 0 || pclose + 1 >= ac.len() || ac[pclose + 1] != '|' {
                ok = false
                break
            }
            let parts = rs2nika_split_args(rs2nika_text(ac, 2, pclose))
            let body: String = rs2nika_text(ac, pclose + 2, ac.len()).trim().clone()
            if parts.len() != 2 {
                ok = false
                break
            }
            let mut i: String = parts[0].trim().clone()
            let mut x: String = parts[1].trim().clone()
            while x.starts_with("&") && !x.starts_with("&mut ") {
                x = (x.strip_prefix("&") ?? "").clone()
            }
            if i == "_" {
                i = rs2nika_fresh(out, ["i", "at", "k", "index"])
            }
            if !rs2nika_is_path(i) || i.contains(":") || x.contains("&") || x.contains("mut ") {
                ok = false
                break
            }
            let mut lam: String = f"|{i}| {body}"
            if x == body {
                lam = f"|{i}| {xs}[{i}]"
            } else if x != "_" {
                let mut inner: String = body.clone()
                if inner.starts_with("{") && inner.ends_with("}") {
                    inner = ((inner.strip_prefix("{") ?? "").strip_suffix("}") ?? "").trim().clone()
                }
                lam = f"|{i}| {{ let {x} = {xs}[{i}]; {inner} }}"
            }
            steps = f"{steps}.{name}({lam})"
            p = close + 1
            if !pass {
                done = true
            }
        }
        if ok && done {
            let range = f"(0..{xs}.len()){steps}"
            out = f"{rs2nika_text(c, 0, s)}{range}{rs2nika_text(c, p, c.len())}"
            from = s
            rs2nika_hit(ctx, "R111")
        }
    }
    return out
}

/// The statements of a closure body `{ a; b; tail }`, converted, one per line
/// at `ind` + 4 (`return false`/`return None` -> `continue`); the last element
/// is the tail expression, not converted.
fn rs2nika_block_stmts(mut ctx: Rs2nikaCtx, body: String, ind: String) -> Vec[String] {
    let mut out: Vec[String] = []
    let stmts: String = ((body.strip_prefix("{") ?? "").strip_suffix("}") ?? "").clone()
    let sc: Vec[scalar] = stmts.chars().collect()
    let mut depth = 0
    let mut from = 0
    let mut k = 0
    while k < sc.len() {
        let ch = sc[k]
        if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1
        } else if ch == ';' && depth == 0 {
            let mut one: String = rs2nika_text(sc, from, k).trim().clone()
            let le = rs2nika_let_else(ctx, one)
            let close_some = one.find(") = ") ?? 0
            let els = one.find(" else {") ?? 0
            if one.starts_with("let Some(") && close_some > 9 && els > close_some && one.ends_with("}") && rs2nika_is_path((one[..<close_some].strip_prefix("let Some(") ?? "").clone()) {
                let x: String = (one[..<close_some].strip_prefix("let Some(") ?? "").clone()
                let e: String = one[close_some + ") = ".len()..<els].clone()
                let jump: String = one[els + " else {".len()..<one.len() - "}".len()].trim().clone()
                one = f"let {x} = {e} ?? {jump}"
            } else if le.len() > 0 {
                one = le[0].trim().clone()
            }
            let typed = rs2nika_let_type(ctx, one)
            let done: String = rs2nika_expr(ctx, typed).replace("return false", "continue").replace("return null", "continue")
            out.push(f"{ind}    {done.trim()}")
            from = k + 1
        }
        k = k + 1
    }
    out.push(rs2nika_text(sc, from, sc.len()).trim().clone())
    return out
}

/// R86: a closure pipeline that looks for one element -> a `for` loop.
/// `let v = xs.iter().find(|x| c);` -> `let mut v = null` and
/// `for x in xs { if c { v = x; break } }`; `find_map(|x| e)` the same with
/// `let found = e` and `if found != null { v = found; break }`; as the tail
/// or after `return` the loop `return`s and `return null` follows. A closure
/// block keeps its statements, its `return None` is `continue`.
fn rs2nika_find_loop(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    if st.ends_with(";") {
        st = st[0..<st.len() - ";".len()].clone()
    }
    if !st.ends_with(")") && !st.ends_with("})") {
        return []
    }
    let mut how = "find"
    let mut mark = ".find(|"
    if st.contains(".find_map(|") {
        how = "find_map"
        mark = ".find_map(|"
    }
    let at = st.find(mark) ?? return []
    let mark_len = mark.len()
    let mut head: String = st[0..<at].clone()
    if head.ends_with(".iter()") {
        head = head[0..<head.len() - ".iter()".len()].clone()
    }
    let mut prefix = ""
    let mut name: String = ""
    let mut ty: String = ""
    let mut recv: String = head.clone()
    if head.starts_with("let ") {
        let eq = head.find(" = ") ?? return []
        let lhs: String = (head[0..<eq].strip_prefix("let ") ?? "").clone()
        if lhs.starts_with("mut ") {
            return []
        }
        let colon = lhs.find(": ")
        if colon != null {
            let c = colon ?? return []
            name = lhs[0..<c].trim().clone()
            ty = lhs[c + ": ".len()..<lhs.len()].trim().clone()
        } else {
            name = lhs.trim().clone()
        }
        recv = head[eq + 3..<head.len()].trim().clone()
        prefix = "let"
    } else if head.starts_with("return ") {
        recv = (head.strip_prefix("return ") ?? "").trim().clone()
        prefix = "return"
    } else {
        prefix = "return"
    }
    if !rs2nika_is_path(name) && prefix == "let" {
        return []
    }
    let c: Vec[scalar] = st.chars().collect()
    let open = at + mark_len - 2
    let close = rs2nika_closing(c, open, '(', ')')
    if close != c.len() - 1 {
        return []
    }
    let inner: String = rs2nika_text(c, open + 2, close)
    let bar = inner.find("|") ?? return []
    let mut var: String = inner[0..<bar].trim().clone()
    while var.starts_with("&") {
        var = (var.strip_prefix("&") ?? "").clone()
    }
    if !rs2nika_is_path(var) {
        return []
    }
    let mut body: String = inner[bar + 1..<inner.len()].trim().clone()
    while body.contains(f"*{var}") {
        body = body.replace(f"*{var}", var)
    }
    let mut lines: Vec[String] = []
    let mut tail: String = body.clone()
    if body.starts_with("{") && body.ends_with("}") {
        let parts = rs2nika_block_stmts(ctx, body, ind)
        for k in 0..<parts.len() - 1 {
            lines.push(f"{parts[k]}")
        }
        tail = parts[parts.len() - 1].clone()
    }
    let r = rs2nika_expr(ctx, recv).trim().clone()
    let t = rs2nika_expr(ctx, tail).trim().clone()
    let mut out: Vec[String] = []
    if prefix == "let" {
        if ty == "" {
            out.push(f"{ind}// TODO(rs2nika): the type of `{name}` (an option of the element)")
            out.push(f"{ind}let mut {name} = null")
        } else {
            let tt = rs2nika_ty(ctx, ty)
            let opt = tt.ends_with("?")
            if opt {
                out.push(f"{ind}let mut {name}: {tt} = null")
            } else {
                out.push(f"{ind}let mut {name}: {tt}? = null")
            }
        }
    }
    out.push(f"{ind}for {var} in {r} {{")
    for l in lines {
        out.push(l.clone())
    }
    let mut found = var.clone()
    let sure = how == "find_map" && tail.starts_with("Some(") && tail.ends_with(")")
    let mut pad = f"{ind}    "
    if sure {
        found = t.clone()
    } else if how == "find_map" {
        out.push(f"{ind}    let found = {t}")
        out.push(f"{ind}    if found != null {{")
        found = "found"
        pad = f"{ind}        "
    } else {
        out.push(f"{ind}    if {t} {{")
        pad = f"{ind}        "
    }
    if prefix == "let" {
        out.push(f"{pad}{name} = {found}")
        out.push(f"{pad}break")
    } else {
        out.push(f"{pad}return {found}")
    }
    if !sure {
        out.push(f"{ind}    }}")
    }
    out.push(f"{ind}}}")
    if prefix == "return" {
        out.push(f"{ind}return null")
    }
    rs2nika_hit(ctx, "R86")
    return out
}

/// R59 for a chain of `.filter(|x| ..)`, two or more or one with a block
/// body: the loop variable first, then per filter its statements and
/// `if !(cond) { continue }`; [] where the chain is anything else.
fn rs2nika_filter_chain(mut ctx: Rs2nikaCtx, chain: String, ind: String) -> Vec[String] {
    let c: Vec[scalar] = chain.chars().collect()
    let mut out: Vec[String] = [""]
    let mut at = 0
    let mut var: String = ""
    let mut block = false
    let mut n = 0
    while at < c.len() {
        if at + 9 > c.len() || rs2nika_text(c, at, at + 9) != ".filter(|" {
            return []
        }
        let close = rs2nika_closing(c, at + 7, '(', ')')
        if close < 0 {
            return []
        }
        let inner: String = rs2nika_text(c, at + 9, close)
        let bar = inner.find("|") ?? return []
        let mut v: String = inner[0..<bar].trim().clone()
        while v.starts_with("&") {
            v = (v.strip_prefix("&") ?? "").clone()
        }
        if !rs2nika_is_path(v) || (var != "" && v != var) {
            return []
        }
        var = v.clone()
        let mut body: String = inner[bar + 1..<inner.len()].trim().clone()
        while body.contains(f"*{var}") {
            body = body.replace(f"*{var}", var)
        }
        let mut cond: String = body.clone()
        if body.starts_with("{") && body.ends_with("}") {
            block = true
            let parts = rs2nika_block_stmts(ctx, body, ind)
            for k in 0..<parts.len() - 1 {
                out.push(parts[k].clone())
            }
            cond = parts[parts.len() - 1].clone()
        }
        let b = rs2nika_expr(ctx, cond)
        out.push(f"{ind}    if !({b.trim()}) {{")
        out.push(f"{ind}        continue")
        out.push(f"{ind}    }}")
        n = n + 1
        at = close + 1
    }
    if n < 2 && !block {
        return []
    }
    out[0] = var.clone()
    return out
}

/// R172: one arm of a tuple `match`, as `rs2nika_tuple_matches` reads it:
/// its lines (comments above it, its pattern line, its body), its parts as
/// written (`None`, `Some(..)`, a name, `_`, a value), its guard (`""` for
/// none) and its line from ` =>` on. `all` is an arm that takes every value
/// (`_ =>`, `name =>`).
struct Rs2nikaTupleArm {
    lines: Vec[String],
    head: i64,
    parts: Vec[String],
    guard: String,
    after: String,
    all: bool,
}

/// R172: the parts of a tuple pattern `(a, b, ..)`, or `null` where `pat` is
/// not one (a single pattern in brackets, `(a) | (b)`).
fn rs2nika_tuple_parts(pat: String) -> Vec[String]? {
    let c: Vec[scalar] = pat.chars().collect()
    if c.len() < 2 || c[0] != '(' || c[c.len() - 1] != ')' {
        return null
    }
    let mut out: Vec[String] = []
    let mut depth = 0
    let mut from = 1
    let mut at = 1
    while at < c.len() - 1 {
        let ch = c[at]
        if ch == '"' || ch == '\'' {
            at = at + 1
            while at < c.len() - 1 && c[at] != ch {
                if c[at] == '\\' {
                    at = at + 1
                }
                at = at + 1
            }
        } else if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1
            if depth < 0 {
                return null
            }
        } else if ch == ',' && depth == 0 {
            out.push(rs2nika_text(c, from, at).trim().clone())
            from = at + 1
        }
        at = at + 1
    }
    if depth != 0 {
        return null
    }
    let last: String = rs2nika_text(c, from, c.len() - 1).trim().clone()
    if last != "" {
        out.push(last)
    }
    if out.len() < 2 {
        return null
    }
    return out
}

/// R172: the end of the bracket that opens at `from` in `c`, or `-1`.
fn rs2nika_tuple_close(c: ref Vec[scalar], from: i64) -> i64 {
    let mut depth = 0
    let mut at = from
    while at < c.len() {
        let ch = c[at]
        if ch == '"' || ch == '\'' {
            at = at + 1
            while at < c.len() && c[at] != ch {
                if c[at] == '\\' {
                    at = at + 1
                }
                at = at + 1
            }
        } else if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1
            if depth == 0 {
                return at
            }
        }
        at = at + 1
    }
    return -1
}

/// R172: a part that takes every value: `_` or a name (`mut x`, `ref x`).
fn rs2nika_tuple_all(part: String) -> bool {
    let mut p: String = part.clone()
    for pre in ["ref mut ", "ref ", "mut "] {
        if p.starts_with(pre) {
            p = (p.strip_prefix(pre) ?? "").clone()
        }
    }
    let c: Vec[scalar] = p.chars().collect()
    if c.len() == 0 || !rs2nika_lower(c[0]) || p == "true" || p == "false" {
        return false
    }
    for ch in c {
        if !rs2nika_word(ch) {
            return false
        }
    }
    return true
}

/// R172: a literal a pattern can match (a number, a character, a text, a
/// truth value).
fn rs2nika_tuple_literal(part: String) -> bool {
    let c: Vec[scalar] = part.chars().collect()
    if c.len() == 0 {
        return false
    }
    let digit = c[0].is_ascii_digit() || (c[0] == '-' && c.len() > 1 && c[1].is_ascii_digit())
    return digit || c[0] == '"' || c[0] == '\'' || part == "true" || part == "false"
}

/// R172: a variant without a payload (`Color::Red`), the one part besides
/// `None` that counts as the same in two arms (a literal does not,
/// `check_core_flow_same_part`).
fn rs2nika_tuple_unit(part: String) -> bool {
    let c: Vec[scalar] = part.chars().collect()
    if c.len() == 0 || part.contains("(") || part.contains("{") || rs2nika_tuple_literal(part) {
        return false
    }
    return part.contains("::") || c[0].is_uppercase()
}

/// R172: what is inside `Some(..)`, or `""` for another part.
fn rs2nika_tuple_some(part: String) -> String {
    if !part.starts_with("Some(") {
        return ""
    }
    let c: Vec[scalar] = part.chars().collect()
    if rs2nika_tuple_close(c, 4) != c.len() - 1 {
        return ""
    }
    return rs2nika_text(c, 5, c.len() - 1).trim().clone()
}

/// R172: whether no value matches both arms: at one position one says
/// `None` and the other `Some(..)`, or both say two other literals.
fn rs2nika_tuple_apart(a: ref Rs2nikaTupleArm, b: ref Rs2nikaTupleArm) -> bool {
    if a.all || b.all {
        return false
    }
    let mut i = 0
    while i < a.parts.len() {
        let x: String = a.parts[i].clone()
        let y: String = b.parts[i].clone()
        let xs = rs2nika_tuple_some(x) != ""
        let ys = rs2nika_tuple_some(y) != ""
        if (x == "None" && ys) || (xs && y == "None") {
            return true
        }
        if rs2nika_tuple_literal(x) && rs2nika_tuple_literal(y) && x != y {
            return true
        }
        i = i + 1
    }
    return false
}

/// R172: the arms in `order` written for Nikaia (ADR-352 D1 per position,
/// #879): a `Some(p)` at a position becomes `p` where `p` is a variant or a
/// literal other than a text, or a name or `_` that an unguarded arm before
/// it covers (`None` there, and at each other position `_`, a name, or what
/// this arm says). Each arm's parts, or `["!", why]` where it stays as
/// written.
fn rs2nika_tuple_plan(arms: ref Vec[Rs2nikaTupleArm], order: ref Vec[i64]) -> Vec[Vec[String]] {
    let mut done: Vec[Vec[String]] = []
    let mut k = 0
    while k < order.len() {
        let arm = arms[order[k]]
        let mut parts: Vec[String] = []
        let mut why: String = ""
        let mut i = 0
        while i < arm.parts.len() && !arm.all && why == "" {
            let p: String = arm.parts[i].clone()
            let inner = rs2nika_tuple_some(p)
            if inner == "" {
                parts.push(p.clone())
                i = i + 1
                continue
            }
            if inner.starts_with("\"") {
                why = f"a text inside `{p}` at a tuple position: the lowering matches a `&str` against the `String` (rustc E0308)"
            } else if rs2nika_tuple_literal(inner) || (inner.contains("::") && !inner.contains("(") && !inner.contains("{")) {
                parts.push(inner.clone())
            } else if inner == "_" || rs2nika_tuple_all(inner) {
                let mut covered = false
                let mut e = 0
                while e < k && !covered {
                    let before = arms[order[e]]
                    let had: Vec[String] = done[e].clone()
                    e = e + 1
                    if before.guard != "" || before.all || had[0] == "!" || had[i] != "None" {
                        continue
                    }
                    covered = true
                    let mut j = 0
                    while j < had.len() {
                        let same = had[j] == arm.parts[j] && (had[j] == "None" || rs2nika_tuple_unit(had[j]))
                        if j != i && had[j] != "_" && !rs2nika_tuple_all(had[j]) && !same {
                            covered = false
                        }
                        j = j + 1
                    }
                }
                if covered {
                    parts.push(inner.clone())
                } else {
                    why = f"no unguarded arm before `{p}` takes `None` there with `_`, a name, `None` or the same variant at each other position (a literal does not count), and no reorder or added `(None, _)` arm gives one (ADR-352 D1 per position)"
                }
            } else {
                why = f"a pattern inside `{p}` at a tuple position: only a name, `_`, a variant or a literal is matched against the `T`"
            }
            i = i + 1
        }
        if arm.all {
            parts = arm.parts.clone()
        }
        if why != "" {
            parts = ["!", why]
        }
        done.push(parts)
        k = k + 1
    }
    return done
}

/// R172: how many arms a plan leaves as written.
fn rs2nika_tuple_left(plan: ref Vec[Vec[String]]) -> i64 {
    let mut n = 0
    for parts in plan {
        if parts[0] == "!" {
            n = n + 1
        }
    }
    return n
}

/// R172: how often an arm says `None`.
fn rs2nika_tuple_nones(arm: ref Rs2nikaTupleArm) -> i64 {
    let mut n = 0
    for p in arm.parts {
        if p == "None" {
            n = n + 1
        }
    }
    return n
}

/// R172: the arms with those that say `None` more often moved up, past arms
/// no value matches together with them, so that each `Some(..)` meets its
/// `None` arms first.
fn rs2nika_tuple_reorder(arms: ref Vec[Rs2nikaTupleArm]) -> Vec[i64] {
    let mut order: Vec[i64] = []
    let mut k = 0
    while k < arms.len() {
        order.push(k)
        let mut at = order.len() - 1
        while at > 0 {
            let here = arms[order[at]]
            let above = arms[order[at - 1]]
            if rs2nika_tuple_nones(here) <= rs2nika_tuple_nones(above) || !rs2nika_tuple_apart(here, above) {
                break
            }
            let moved = order[at]
            order[at] = order[at - 1]
            order[at - 1] = moved
            at = at - 1
        }
        k = k + 1
    }
    return order
}

/// R172: the arm `(None, _, ..) => b` with `None` at `pos` of `width`, `b`
/// the body of the last arm `_ => b`.
fn rs2nika_tuple_none_arm(ind: String, width: i64, pos: i64, last: ref Rs2nikaTupleArm) -> Rs2nikaTupleArm {
    let mut parts: Vec[String] = []
    let mut n = 0
    while n < width {
        if n == pos {
            parts.push("None")
        } else {
            parts.push("_")
        }
        n = n + 1
    }
    let mut body: String = last.after.trim_end().clone()
    if !body.ends_with(",") {
        body = f"{body},"
    }
    return Rs2nikaTupleArm { lines: [f"{ind}({parts.join(", ")}){body}"], head: 0, parts: parts, guard: "", after: body, all: false }
}

/// R172: the position of the first `Some(name)` or `Some(_)` of an arm, or
/// `-1`.
fn rs2nika_tuple_named(arm: ref Rs2nikaTupleArm) -> i64 {
    let mut p = 0
    while p < arm.parts.len() {
        let inner = rs2nika_tuple_some(arm.parts[p])
        if inner == "_" || rs2nika_tuple_all(inner) {
            return p
        }
        p = p + 1
    }
    return -1
}

/// R172: an arm line of a tuple `match` read, or `null` for another line.
fn rs2nika_tuple_arm(t: String, width: i64) -> Rs2nikaTupleArm? {
    let c: Vec[scalar] = t.chars().collect()
    if c.len() == 0 {
        return null
    }
    let mut end = rs2nika_tuple_close(c, 0)
    if c[0] != '(' {
        end = (t.find(" ") ?? 0) - 1
    }
    if end < 0 {
        return null
    }
    let pat: String = rs2nika_text(c, 0, end + 1)
    let rest: String = rs2nika_text(c, end + 1, c.len())
    let mut guard: String = ""
    let mut after: String = rest.clone()
    if rest.starts_with(" if ") {
        let arrow = rest.find(" => ") ?? 0
        guard = rest[0..<arrow].clone()
        after = rest[arrow..<rest.len()].clone()
    }
    if !after.starts_with(" =>") {
        return null
    }
    if rs2nika_tuple_all(pat) || pat == "_" {
        return Rs2nikaTupleArm { lines: [], head: 0, parts: [pat.clone()], guard: guard, after: after, all: true }
    }
    let parts: Vec[String] = rs2nika_tuple_parts(pat) ?? return null
    if width >= 0 && parts.len() as i64 != width {
        return null
    }
    return Rs2nikaTupleArm { lines: [], head: 0, parts: parts, guard: guard, after: after, all: false }
}

/// R172: a `match` whose arms are tuple patterns with `Some(..)` and `None`
/// at a position -> the same `match` with `Some(p)` -> `p` where the arms
/// before take `None` there (ADR-352 D1 per position, #879): `(None, None)`,
/// `(None, Some(p))`, `(Some(e), _)` -> `(None, None)`, `(None, p)`, `(e, _)`.
/// Where the order does not give it, the `None` arms move up past the arms
/// they cannot share a value with; else, in a `match` that ends in `_ => b`,
/// an arm `(None, _) => b` is written above the first arm that needs it,
/// where every arm after it up to `_` has `Some(..)` there. An arm left as
/// written keeps its TODO with the reason (`ctx.tuple_why`).
fn rs2nika_tuple_matches(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = given.clone()
    let mut i = 0
    while i < out.len() {
        let line: String = out[i].clone()
        let at = rs2nika_find_from(line.chars().collect(), "match ", 0)
        let ok_head = at >= 0 && line.ends_with(" {") && !line.trim().starts_with("//") && (at == 0 || !rs2nika_word(line.chars().collect()[at - 1]))
        if !ok_head {
            i = i + 1
            continue
        }
        let ind = rs2nika_indent(line)
        let arm_ind = f"{ind}    "
        let deeper = f"{arm_ind} "
        let closing = f"{ind}}}"
        let mut j = i + 1
        while j < out.len() && !(rs2nika_starts(out[j], closing) && rs2nika_indent(out[j]) == ind) {
            j = j + 1
        }
        if j >= out.len() {
            i = i + 1
            continue
        }
        // each arm from the comments above its line
        let mut starts: Vec[i64] = []
        let mut froms: Vec[i64] = []
        let mut k = i + 1
        while k < j {
            let t: String = out[k].trim().clone()
            if rs2nika_starts(out[k], arm_ind) && !rs2nika_starts(out[k], deeper) && !t.starts_with("//") && !t.starts_with("}") {
                let mut from = k
                let low = if starts.len() == 0 { i + 1 } else { starts[starts.len() - 1] + 1 }
                while from > low && out[from - 1].trim().starts_with("//") && rs2nika_indent(out[from - 1]) == arm_ind {
                    from = from - 1
                }
                starts.push(k)
                froms.push(from)
            }
            k = k + 1
        }
        let mut arms: Vec[Rs2nikaTupleArm] = []
        let mut ok = starts.len() >= 2
        let mut somes = 0
        let mut width = -1
        let mut a = 0
        while a < starts.len() && ok {
            let mut arm: Rs2nikaTupleArm = rs2nika_tuple_arm(out[starts[a]].trim().clone(), width) ?? Rs2nikaTupleArm { lines: [], head: -1, parts: [], guard: "", after: "", all: false }
            if arm.head < 0 {
                ok = false
                break
            }
            if !arm.all {
                width = arm.parts.len() as i64
                for p in arm.parts {
                    if rs2nika_tuple_some(p) != "" {
                        somes = somes + 1
                    }
                }
            }
            let to = if a + 1 < starts.len() { froms[a + 1] } else { j }
            let mut r = froms[a]
            while r < to {
                arm.lines.push(out[r].clone())
                r = r + 1
            }
            arm.head = starts[a] - froms[a]
            arms.push(arm)
            a = a + 1
        }
        if !ok || somes == 0 || width < 0 {
            i = i + 1
            continue
        }
        let mut order: Vec[i64] = []
        for n in 0..<arms.len() {
            order.push(n as i64)
        }
        let mut plan = rs2nika_tuple_plan(arms, order)
        let mut left = rs2nika_tuple_left(plan)
        if left > 0 {
            let moved = rs2nika_tuple_reorder(arms)
            let moved_plan = rs2nika_tuple_plan(arms, moved)
            let moved_left = rs2nika_tuple_left(moved_plan)
            if moved_left < left {
                order = moved
                plan = moved_plan
                left = moved_left
            }
        }
        // a `(None, _) => b` arm above the first arm that needs it
        let last = arms[arms.len() - 1].clone()
        let one_line = last.lines.len() - last.head == 1 && !last.after.trim_end().ends_with("{")
        let wild = last.all && last.parts[0] == "_" && last.guard == "" && one_line
        let mut tries = 0
        while left > 0 && wild && tries < width {
            tries = tries + 1
            let mut k2 = 0
            while k2 < order.len() && plan[k2][0] != "!" {
                k2 = k2 + 1
            }
            let pos = rs2nika_tuple_named(arms[order[k2]])
            if pos < 0 || order[order.len() - 1] != (arms.len() - 1) as i64 {
                break
            }
            let mut safe = true
            let mut m = k2
            while m < order.len() - 1 {
                if arms[order[m]].all || rs2nika_tuple_some(arms[order[m]].parts[pos]) == "" {
                    safe = false
                }
                m = m + 1
            }
            if !safe {
                break
            }
            arms.push(rs2nika_tuple_none_arm(arm_ind, width, pos, last))
            let mut tried: Vec[i64] = []
            for n in 0..<order.len() {
                if n == k2 {
                    tried.push((arms.len() - 1) as i64)
                }
                tried.push(order[n])
            }
            let tried_plan = rs2nika_tuple_plan(arms, tried)
            let tried_left = rs2nika_tuple_left(tried_plan)
            if tried_left >= left {
                break
            }
            order = tried
            plan = tried_plan
            left = tried_left
        }
        let mut new: Vec[String] = []
        let mut r = 0
        while r < froms[0] {
            new.push(out[r].clone())
            r = r + 1
        }
        let mut wrote = false
        for n in 0..<order.len() {
            let arm = arms[order[n]]
            let parts: Vec[String] = plan[n].clone()
            for q in 0..<arm.lines.len() {
                if q as i64 != arm.head || arm.all {
                    new.push(arm.lines[q].clone())
                } else if parts[0] == "!" {
                    ctx.tuple_line.push(arm.lines[q].trim().clone())
                    ctx.tuple_why.push(parts[1].clone())
                    new.push(arm.lines[q].clone())
                } else {
                    let written = f"{arm_ind}({parts.join(", ")}){arm.guard}{arm.after}"
                    if written != arm.lines[q] || n as i64 != order[n] {
                        wrote = true
                    }
                    new.push(written)
                }
            }
        }
        if wrote {
            rs2nika_hit(ctx, "R172")
        }
        let mut r2 = j
        while r2 < out.len() {
            new.push(out[r2].clone())
            r2 = r2 + 1
        }
        out = new
        i = i + 1
    }
    return out
}

/// R72: a `Some(p) =>` arm -> `p =>`: in a `match` with a `null` arm the
/// other arms match the `T` (ADR-352 D1). `Some(_)` binds `_value`, since a
/// bare `_` is not an arm and `else` would also take the `null`.
fn rs2nika_some_arm(mut ctx: Rs2nikaCtx, line: String) -> String {
    let st: String = line.trim_start().clone()
    if !st.starts_with("Some(") {
        return line.clone()
    }
    let c: Vec[scalar] = st.chars().collect()
    let mut depth = 0
    let mut at = 4
    while at < c.len() {
        if c[at] == '(' {
            depth = depth + 1
        } else if c[at] == ')' {
            depth = depth - 1
            if depth == 0 {
                break
            }
        }
        at = at + 1
    }
    if at >= c.len() {
        return line.clone()
    }
    let rest: String = rs2nika_text(c, at + 1, c.len())
    if !rest.starts_with(" =>") && !rest.starts_with(" if ") {
        return line.clone()
    }
    let mut inner: String = rs2nika_text(c, 5, at)
    if inner == "_" {
        inner = "_value"
    }
    rs2nika_hit(ctx, "R72")
    return f"{rs2nika_indent(line)}{inner}{rest}"
}

/// R95: R72 inside a line, for a `match` written on one line (a closure, a
/// field's value): `match e { Some(p) => a, None => b }` -> `match e { p =>
/// a, None => b }`. Only an arm's own `Some(`, after `{`, `,` or `}`, and only
/// where the line has a `None` arm; a `Some(` in a tuple or a struct pattern
/// stays (its name would bind the `T?`).
fn rs2nika_some_arms_inline(mut ctx: Rs2nikaCtx, given: String) -> String {
    let line: String = rs2nika_none_of_rest(given)
    if !line.contains("Some(") || !(line.contains("None =>") || line.contains("None if ")) {
        return given.clone()
    }
    let c: Vec[scalar] = line.chars().collect()
    let mut out: String = ""
    let mut at = 0
    let mut quoted = false
    while at < c.len() {
        if c[at] == '"' && (at == 0 || c[at - 1] != '\\') {
            quoted = !quoted
        }
        if quoted || rs2nika_find_from(c, "Some(", at) != at || (at > 0 && rs2nika_path_char(c[at - 1])) {
            out.push(c[at])
            at = at + 1
            continue
        }
        let mut before = at - 1
        while before >= 0 && c[before] == ' ' {
            before = before - 1
        }
        if before < 0 || (c[before] != '{' && c[before] != ',' && c[before] != '}') {
            out.push(c[at])
            at = at + 1
            continue
        }
        let mut depth = 0
        let mut close = at + 4
        while close < c.len() {
            if c[close] == '(' {
                depth = depth + 1
            } else if c[close] == ')' {
                depth = depth - 1
                if depth == 0 {
                    break
                }
            }
            close = close + 1
        }
        let rest: String = rs2nika_text(c, close + 1, c.len())
        if close >= c.len() || !(rest.starts_with(" =>") || rest.starts_with(" if ")) {
            out.push(c[at])
            at = at + 1
            continue
        }
        let mut inner: String = rs2nika_text(c, at + 5, close)
        if inner == "_" {
            inner = "_value"
        }
        out.push_str(inner)
        at = close + 1
        rs2nika_hit(ctx, "R95")
    }
    return out
}

/// For R95: whether the arms of the one-line `match` in `line` before `end`
/// test the option itself: each `Some(` opens its arm's pattern, none sits
/// inside another pattern.
fn rs2nika_own_somes(line: String, end: i64) -> bool {
    let start = line.find("match ") ?? return false
    let c: Vec[scalar] = line.chars().collect()
    let open = rs2nika_find_from(c, " {", start)
    if open < 0 || open >= end {
        return false
    }
    let mut arms: Vec[String] = []
    let mut depth = 0
    let mut from = open + 2
    let mut at = from
    while at < end {
        let ch = c[at]
        if ch == '"' || ch == '\'' {
            at = at + 1
            while at < end && c[at] != ch {
                if c[at] == '\\' {
                    at = at + 1
                }
                at = at + 1
            }
        } else if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1
        } else if ch == ',' && depth == 0 {
            arms.push(rs2nika_text(c, from, at))
            from = at + 1
        }
        at = at + 1
    }
    arms.push(rs2nika_text(c, from, end))
    let mut own = false
    for a in arms {
        let arrow = a.find("=>") ?? continue
        let pat: String = a[0..<arrow].trim().clone()
        if pat.starts_with("Some(") {
            own = true
        } else if pat.contains("Some(") {
            return false
        }
    }
    return own
}

/// For R95: a one-line `match` whose `None` is Rust's `_ =>` gets its own
/// `None` arm, so the `Some` arms can match the `T`: `{ Some(x) => a, _ => b }`
/// -> `{ Some(x) => a, None => b }`; with a guard on a `Some` arm `_` also
/// takes what the guard leaves, so it stays beside it: `None => b, _ => b`.
/// Only for a line with one `match` and one `_ =>` arm, and only where the
/// subject is the option itself: an arm's own `Some(..)`, never one inside a
/// struct or tuple pattern (`Item::Fn { name: Some(n), .. }`, `(Some(a), 0)`).
fn rs2nika_none_of_rest(line: String) -> String {
    let arm = line.find(", _ => ") ?? return line.clone()
    if line.contains("None") || !line.contains("Some(") || line.matches("match ").count() != 1 || line.matches(" _ => ").count() != 1 {
        return line.clone()
    }
    if !rs2nika_own_somes(line, arm) {
        return line.clone()
    }
    let c: Vec[scalar] = line.chars().collect()
    let from = arm + ", _ => ".len()
    let mut depth = 0
    let mut end = from
    while end < c.len() {
        if c[end] == '(' || c[end] == '[' || c[end] == '{' {
            depth = depth + 1
        } else if c[end] == ')' || c[end] == ']' || c[end] == '}' {
            if depth == 0 {
                break
            }
            depth = depth - 1
        }
        end = end + 1
    }
    if end >= c.len() || c[end] != '}' {
        return line.clone()
    }
    let body: String = rs2nika_text(c, from, end).trim_end().trim_end_matches(",").clone()
    let start = line.find("match ") ?? return line.clone()
    let arms: String = line[start..<arm].clone()
    let guarded = arms.contains(") if ")
    let head: String = line[0..<arm].clone()
    let tail: String = rs2nika_text(c, end, c.len())
    if guarded {
        return f"{head}, None => {body}, _ => {body} {tail}"
    }
    return f"{head}, None => {body} {tail}"
}

/// The names a pattern binds: lower-case words not followed by `(`, `{`,
/// `:` or `::`, and not after `::` or `.`.
fn rs2nika_pattern_names(pat: String) -> Vec[String] {
    let c: Vec[scalar] = pat.chars().collect()
    let mut out: Vec[String] = []
    let mut at = 0
    while at < c.len() {
        if !rs2nika_word(c[at]) {
            at = at + 1
            continue
        }
        let mut e = at
        while e < c.len() && rs2nika_word(c[e]) {
            e = e + 1
        }
        let w: String = rs2nika_text(c, at, e)
        let mut n = e
        while n < c.len() && c[n] == ' ' {
            n = n + 1
        }
        let after = n < c.len() && (c[n] == '(' || c[n] == '{' || c[n] == ':')
        let before = at > 0 && (c[at - 1] == ':' || c[at - 1] == '.')
        let keyword = w == "ref" || w == "mut" || w == "true" || w == "false" || w == "_"
        if rs2nika_lower(c[at]) && !after && !before && !keyword && !out.contains(w) {
            out.push(w.clone())
        }
        at = e
    }
    return out
}

/// R62: a match arm whose value is an assignment (`P => n += 1,`) takes braces.
fn rs2nika_arm_assign(mut ctx: Rs2nikaCtx, line: String) -> String {
    let arrow = line.find(" => ") ?? return line.clone()
    let body: String = line[arrow + 4..<line.len()].trim_end().clone()
    if !body.ends_with(",") || body.starts_with("{") {
        return line.clone()
    }
    let value: String = body[0..<body.len() - ",".len()].trim().clone()
    let mut assign = false
    for op in [" = ", " += ", " -= ", " *= ", " /= ", " |= ", " &= "] {
        if value.contains(op) && !value.contains("(") && !value.contains("{") {
            assign = true
        }
    }
    if !assign {
        return line.clone()
    }
    rs2nika_hit(ctx, "R62")
    return f"{line[0..<arrow + 4]}{{ {value} }},"
}

/// R60: `let P = v else { jump };` with any pattern -> `let x = match v { P => x, else => jump }`
/// (a tuple of the names when it binds several).
fn rs2nika_let_else(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    if st.ends_with(";") {
        st = st[0..<st.len() - ";".len()].clone()
    }
    let els = st.find(" else {") ?? return []
    let eq = st.find(" = ") ?? return []
    if eq > els {
        return []
    }
    let pat: String = (st.bytes[4..<eq].text() catch { "" }).trim().clone()
    let mut value: String = st[eq + 3..<els].trim().clone()
    while value.starts_with("&") {
        value = (value.strip_prefix("&") ?? "").trim_start().clone()
        if value.starts_with("mut ") {
            value = (value.strip_prefix("mut ") ?? "").clone()
        }
    }
    let mut jump: String = (st.bytes[els + 7..<st.len() - 1].text() catch { "" }).trim().clone()
    while jump.ends_with(";") {
        jump = jump[0..<jump.len() - ";".len()].trim().clone()
    }
    if !rs2nika_is_jump(jump) {
        return []
    }
    let names = rs2nika_pattern_names(pat)
    if names.len() == 0 {
        return []
    }
    let mut bound: String = names[0].clone()
    if names.len() > 1 {
        bound = f"({names.join(", ")})"
    }
    let sf = rs2nika_some_fields(pat)
    let p = rs2nika_expr(ctx, sf[0])
    let v = rs2nika_expr(ctx, value)
    // a `Some(x)` field: the arm hands `x ?? jump` on, as a guard would
    // narrow `x` in the arm but not in what the `match` hands back
    if sf[1] != "" {
        rs2nika_hit(ctx, "R173")
        let tested: Vec[String] = sf[1].split(" && ").map(fn(g) { g.replace(" != null", "") }).collect()
        let mut parts: Vec[String] = []
        for n in names {
            if tested.contains(n) {
                parts.push(f"{n} ?? {jump}")
            } else {
                parts.push(n.clone())
            }
        }
        bound = if parts.len() > 1 { f"({parts.join(", ")})" } else { parts[0].clone() }
    }
    let g: String = ""
    // R146: `let Ok(P) = call else { jump }` -> `let P = call catch { jump }`
    let ok = rs2nika_called(pat, "Ok(")
    if ok.len() == 1 && value.ends_with(")") {
        let bound_ok = rs2nika_expr(ctx, ok[0])
        let jumped = rs2nika_expr(ctx, jump)
        rs2nika_hit(ctx, "R146")
        return [f"{ind}let {bound_ok} = {v} catch {{ {jumped} }}"]
    }
    if pat.starts_with("Ok(") || pat.starts_with("Err(") {
        return []
    }
    rs2nika_hit(ctx, "R60")
    let names_bound = if names.len() > 1 { f"({names.join(", ")})" } else { names[0].clone() }
    return [f"{ind}let {names_bound} = match {v} {{ {p}{g} => {bound}, else => {jump} }}"]
}

/// R61: `let (mut a, mut b): (A, B) = (x, y);` -> one `let` each.
fn rs2nika_let_pair(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    if st.ends_with(";") {
        st = st[0..<st.len() - ";".len()].clone()
    }
    if !st.starts_with("let (") || !st.ends_with(")") || st.contains(" else ") {
        return []
    }
    let close = st.find(")") ?? return []
    let eq = st.find(" = ") ?? return []
    if close > eq {
        return []
    }
    let names: Vec[String] = rs2nika_split_args((st[..<close].strip_prefix("let (") ?? "").clone())
    let mut types: Vec[String] = []
    let rest: String = st[close + 1..<eq].trim().clone()
    if rest.starts_with(":") {
        let t: String = (rest.strip_prefix(":") ?? "").trim().clone()
        if !t.starts_with("(") || !t.ends_with(")") {
            return []
        }
        types = rs2nika_split_args(((t.strip_prefix("(") ?? "").strip_suffix(")") ?? "").clone())
    } else if rest != "" {
        return []
    }
    let value: String = st[eq + 3..<st.len()].trim().clone()
    if !value.starts_with("(") {
        return []
    }
    let values: Vec[String] = rs2nika_split_args(((value.strip_prefix("(") ?? "").strip_suffix(")") ?? "").clone())
    if values.len() != names.len() || (types.len() > 0 && types.len() != names.len()) {
        return []
    }
    let mut out: Vec[String] = []
    let mut k = 0
    while k < names.len() {
        let n: String = names[k].trim().clone()
        let mut decl: String = f"let {n}"
        if types.len() > 0 {
            let t = rs2nika_ty(ctx, types[k].trim())
            decl = f"{decl}: {t}"
        }
        let typed = rs2nika_let_type(ctx, f"{decl} = {values[k].trim()}")
        let e: String = rs2nika_expr(ctx, typed)
        out.push(f"{ind}{e.trim()}")
        k = k + 1
    }
    rs2nika_hit(ctx, "R61")
    return out
}

/// Whether `path` is a path of fields from a name (`self.f`, `p.a.b`): words
/// joined by `.`, at least one `.` (ADR-382 D4).
fn rs2nika_field_path(path: String) -> bool {
    if !path.contains(".") || path.starts_with(".") || path.ends_with(".") || path.contains("..") {
        return false
    }
    for c in path.chars() {
        if !(rs2nika_word(c) || c == '.') {
            return false
        }
    }
    return true
}

/// Whether `text` writes `path` or a path it is part of (ADR-382 D5): an
/// assignment, `.take()`, `.insert(..)`, `.replace(..)`, `.get_or_insert..`,
/// `.as_mut()` or a `&mut` of it.
fn rs2nika_writes_path(text: String, path: String) -> bool {
    let t = rs2nika_blank(text)
    let mut held: String = ""
    for part in path.split(".") {
        if held == "" {
            held = part.clone()
        } else {
            held = f"{held}.{part}"
        }
        let c: Vec[scalar] = t.chars().collect()
        let mut from = 0
        while true {
            let at = rs2nika_find_from(c, held, from)
            if at < 0 {
                break
            }
            from = at + 1
            if at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == '.') {
                continue
            }
            let after: String = rs2nika_text(c, at + held.chars().count(), c.len())
            let before: String = rs2nika_text(c, 0, at)
            if before.trim_end().ends_with("&mut") {
                return true
            }
            for w in [" = ", " += ", " -= ", ".take()", ".insert(", ".replace(", ".get_or_insert", ".as_mut()", ".push("] {
                if after.starts_with(w) {
                    return true
                }
            }
        }
    }
    return false
}

/// `name` read as `path` in `text`: a whole word, not a field (`.name`) nor
/// a field's name in a struct literal (`name: ..`); in a string only inside
/// a format hole (`"{name}"`).
fn rs2nika_read_as(text: String, name: String, path: String) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let f: Vec[scalar] = name.chars().collect()
    let mut out: String = ""
    let mut in_string = false
    let mut hole = 0
    let mut at = 0
    while at < c.len() {
        let ch = c[at]
        if in_string && ch == '\\' && at + 1 < c.len() {
            out.push(ch)
            out.push(c[at + 1])
            at = at + 2
            continue
        }
        if ch == '"' {
            in_string = !in_string
            hole = 0
        } else if in_string && ch == '{' {
            hole = hole + 1
        } else if in_string && ch == '}' && hole > 0 {
            hole = hole - 1
        }
        let mut same = (!in_string || hole > 0) && at + f.len() <= c.len()
        let mut k = 0
        while same && k < f.len() {
            if c[at + k] != f[k] {
                same = false
            }
            k = k + 1
        }
        if same && at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == '.') {
            same = false
        }
        let end = at + f.len()
        if same && end < c.len() && rs2nika_word(c[end]) {
            same = false
        }
        if same && end < c.len() && c[end] == ':' && !(end + 1 < c.len() && c[end + 1] == ':') {
            same = false
        }
        if same {
            out.push_str(path)
            at = end
        } else {
            out.push(ch)
            at = at + 1
        }
    }
    return out
}

/// R23 over a path of fields (ADR-382 D4, D7): `if let Some(x) = &self.f [&&
/// g] {` -> `if self.f.is_some() [&& g] {` (R21 writes `!= null`), `x` read as
/// `self.f` in the block; where the block writes the path or a part of it,
/// `let x = self.f;` keeps the old value. `&mut self.f` is left to R23.
fn rs2nika_field_tests(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut lines: Vec[String] = given.clone()
    let mut i = 0
    while i < lines.len() {
        let line: String = lines[i].clone()
        let st: String = line.trim().clone()
        i = i + 1
        let at = st.find("if let Some(") ?? continue
        if !st.ends_with(" {") || st.starts_with("}") || st.starts_with("//") || (at > 0 && !st[..<at].ends_with(" ")) {
            continue
        }
        let pre: String = st[0..<at].clone()
        let rest: String = st[at + "if let Some(".len()..<st.len() - " {".len()].clone()
        let close = rest.find(") = ") ?? continue
        let name: String = rest[0..<close].clone()
        if !rs2nika_is_path(name) || name.contains(":") || name.starts_with("mut ") {
            continue
        }
        let mut value: String = rest[close + ") = ".len()..<rest.len()].trim().clone()
        let mut guard: String = ""
        let and = value.find(" && ") ?? 0
        if and > 0 {
            guard = value[and + " && ".len()..<value.len()].trim().clone()
            value = value[0..<and].trim().clone()
        }
        if value.starts_with("&mut ") {
            continue
        }
        if value.starts_with("&") {
            value = (value.strip_prefix("&") ?? "").clone()
        }
        if !rs2nika_field_path(value) || guard.contains(" let ") {
            continue
        }
        let ind = rs2nika_indent(line)
        let mut j = i
        while j < lines.len() && !(rs2nika_indent(lines[j]) == ind && lines[j].trim().starts_with("}")) {
            j = j + 1
        }
        if j >= lines.len() {
            continue
        }
        let mut written = false
        let mut k = i
        while k < j {
            if rs2nika_writes_path(lines[k], value) {
                written = true
            }
            k = k + 1
        }
        let mut g: String = ""
        if guard != "" {
            g = f" && {rs2nika_read_as(guard, name, value)}"
        }
        rs2nika_hit(ctx, "R23")
        lines[i - 1] = f"{ind}{pre}if {value}.is_some(){g} {{"
        if name == "_" {
            continue
        }
        if written {
            let mut body_ind = f"{ind}    "
            if i < j {
                body_ind = rs2nika_indent(lines[i])
            }
            lines.insert(i, f"{body_ind}let {name} = {value};")
            continue
        }
        k = i
        while k < j {
            lines[k] = rs2nika_read_as(lines[k], name, value)
            k = k + 1
        }
    }
    return lines
}

fn rs2nika_if_let(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let filtered = rs2nika_filter_cloned(ctx, line)
    if filtered.len() > 0 {
        return filtered
    }
    let found = rs2nika_find_loop(ctx, line)
    if found.len() > 0 {
        return found
    }
    let looped = rs2nika_iter_loops(ctx, line)
    if looped.len() > 0 {
        return looped
    }
    // R110/R111 write a chain as `Seq` steps; the rules above and below then
    // see the new line.
    let seq = rs2nika_seq_rewrite(ctx, line)
    if seq != line {
        let again = rs2nika_if_let(ctx, seq)
        if again.len() > 0 {
            return again
        }
        return ["=", seq]
    }
    let st: String = line.trim().clone()
    if st.starts_with("while let ") && st.ends_with(" {") {
        return rs2nika_while_let(ctx, line)
    }
    if st.starts_with("let Some(") && st.contains(" else {") {
        let close = st.find(")") ?? return []
        let mut name: String = (st[..<close].strip_prefix("let Some(") ?? "").clone()
        if name.starts_with("&") {
            name = (name.strip_prefix("&") ?? "").clone()
        }
        let eq = st.find(" = ") ?? return []
        let els = st.find(" else {") ?? return []
        if !rs2nika_is_path(name) || eq < close {
            return []
        }
        let value: String = st[eq + 3..<els].trim().clone()
        // R184: the `else` block on the lines below is the fallback block
        if st.ends_with(" else {") {
            rs2nika_hit(ctx, "R184")
            return ["=", f"{ind}let {name} = {value} ?? {{"]
        }
        let mut jump: String = st[els + 7..<st.len()].trim().clone()
        while jump.ends_with(";") || jump.ends_with("}") {
            jump = (jump.strip_suffix(";") ?? jump.strip_suffix("}") ?? "").trim().clone()
        }
        if !rs2nika_is_jump(jump) {
            return []
        }
        rs2nika_hit(ctx, "R22")
        return ["=", f"{ind}let {name} = {value} ?? {jump}"]
    }
    let pair = rs2nika_let_pair(ctx, line)
    if pair.len() > 0 {
        return pair
    }
    if st.starts_with("let ") && st.contains(" else {") && (st.ends_with("}") || st.ends_with("};")) {
        return rs2nika_let_else(ctx, line)
    }
    let chain = rs2nika_let_chain(ctx, line)
    if chain.len() > 0 {
        return chain
    }
    let chains = rs2nika_let_chains(ctx, line)
    if chains.len() > 0 {
        return chains
    }
    let at = st.find("if let ") ?? return []
    if !st.ends_with(" {") || st.contains(" && let ") || (at > 0 && !st[..<at].ends_with(" ")) {
        return []
    }
    let pre: String = st[0..<at].clone()
    let body: String = st[at + "if let ".len()..<st.len() - " {".len()].clone()
    let eq = body.find(" = ") ?? return []
    let pat: String = body[0..<eq].trim().clone()
    let mut value: String = body[eq + 3..<body.len()].trim().clone()
    let mut guard: String = ""
    let and = value.find(" && ") ?? 0
    if and > 0 {
        guard = value[and + " && ".len()..<value.len()].trim().clone()
        value = value[0..<and].trim().clone()
    }
    let mut name: String = ""
    if pat.starts_with("Some(") && pat.ends_with(")") {
        let inner: String = ((pat.strip_prefix("Some(") ?? "").strip_suffix(")") ?? "").clone()
        if rs2nika_is_path(inner) && !inner.contains(":") {
            name = inner
        }
    }
    if pre.starts_with("}") {
        ctx.todo_extra.push("`else if let`: nest it inside the `else`")
        return []
    }
    if pre != "" && name == "" {
        ctx.todo_extra.push("`if let` with a pattern as a value: write a `match`")
        return []
    }
    let p = rs2nika_expr(ctx, pre)
    if name == "_" && guard == "" {
        let v = rs2nika_expr(ctx, value)
        rs2nika_hit(ctx, "R23")
        ctx.stack_ind.push(ind.clone())
        ctx.stack_kind.push("if")
        return [f"{ind}{p}if {v} != null {{"]
    }
    // **A test that proves the option not `null` makes it a `T`** (ADR-382):
    // over a plain name the binding is the name itself.
    let plain = rs2nika_is_path(value) && !value.contains(".") && !value.contains(":") && !value.contains("(")
    if name != "" && plain && (name == value || guard == "") {
        let v = rs2nika_expr(ctx, value)
        rs2nika_hit(ctx, "R23")
        ctx.stack_ind.push(ind.clone())
        ctx.stack_kind.push("if")
        if name == value {
            if guard == "" {
                return [f"{ind}{p}if {v} != null {{"]
            }
            let ge = rs2nika_expr(ctx, guard)
            return [f"{ind}{p}if {v} != null && {ge} {{"]
        }
        return [f"{ind}{p}if {v} != null {{", f"{ind}    let {name} = {v}"]
    }
    // R170: any other subject is read once: `match e { x => {..}, null =>
    // {..} }`, the arm binds the `T` beside the `null` arm (ADR-352)
    if name != "" && guard == "" {
        let v = rs2nika_expr(ctx, value)
        rs2nika_hit(ctx, "R170")
        ctx.stack_ind.push(ind.clone())
        ctx.stack_kind.push("ifletopt")
        return [f"{ind}{p}match {v} {{", f"{ind}    {name} => {{"]
    }
    if name != "" {
        ctx.todo_extra.push("`if let Some(..) = e && guard`: write `let x = e ?? ..` then `if`")
        return []
    }
    // `match &x` is Rust's; Nikaia lends implicitly (R19).
    while value.starts_with("&") {
        value = (value.strip_prefix("&") ?? "").trim_start().clone()
        if value.starts_with("mut ") {
            value = (value.strip_prefix("mut ") ?? "").clone()
        }
    }
    let v = rs2nika_expr(ctx, value)
    let sf = rs2nika_some_fields(pat)
    let pt = rs2nika_expr(ctx, sf[0])
    let mut g: String = ""
    if guard != "" {
        let ge = rs2nika_expr(ctx, guard)
        g = f" if {ge}"
    }
    if sf[1] != "" {
        rs2nika_hit(ctx, "R173")
        if g == "" {
            g = f" if {sf[1]}"
        } else {
            g = f" if {sf[1]} &&{g[" if".len()..<g.len()]}"
        }
    }
    rs2nika_hit(ctx, "R24")
    ctx.stack_ind.push(ind.clone())
    ctx.stack_kind.push("iflet")
    return [f"{ind}match {v} {{", f"{ind}    {pt}{g} => {{"]
}

/// A Rust function, or several, as a Nikaia draft.
/// Whether a line opens a `struct` with named fields.
fn rs2nika_struct_head(st: String) -> bool {
    let head: String = st.trim_start_matches("pub(crate) ").trim_start_matches("pub(super) ").trim_start_matches("pub ").clone()
    return head.starts_with("struct ") && head.ends_with("{")
}

/// R78: a `struct`'s header: its lifetimes dropped (R5), `<T>` -> `[T]`,
/// `pub(crate)` -> `pub` (R30).
fn rs2nika_struct_header(mut ctx: Rs2nikaCtx, line: String) -> String {
    let mut out: String = line.clone()
    if out.contains("'") {
        out = rs2nika_lifetimes(out).replace("<>", "")
        rs2nika_hit(ctx, "R5")
    }
    if out.contains("<") {
        out = out.replace("<", "[").replace(">", "]")
    }
    if out.trim_start().starts_with("pub(") {
        let ind = rs2nika_indent(out)
        let close = out.find(")") ?? return out
        out = f"{ind}pub{out[close + 1..<out.len()]}"
        rs2nika_hit(ctx, "R30")
    }
    return out
}

/// R78: a `struct`'s field `name: T,` -> its type by a parameter's rules.
/// Anything else inside the `struct` (a comment, an attribute) is not a
/// field: `""`.
fn rs2nika_struct_field(mut ctx: Rs2nikaCtx, line: String) -> String {
    let ind = rs2nika_indent(line)
    let mut st: String = line.trim().clone()
    let mut vis: String = ""
    if st.starts_with("pub(") {
        let close = st.find(")") ?? return ""
        st = st[close + 1..<st.len()].trim().clone()
        vis = "pub "
        rs2nika_hit(ctx, "R30")
    } else if st.starts_with("pub ") {
        st = (st.strip_prefix("pub ") ?? "").trim().clone()
        vis = "pub "
    }
    let colon = st.find(":") ?? return ""
    let name: String = st[0..<colon].trim().clone()
    if name == "" || name.starts_with("/") || name.starts_with("#") {
        return ""
    }
    for ch in name.chars() {
        if !rs2nika_word(ch) {
            return ""
        }
    }
    let mut rest: String = st[colon + 1..<st.len()].trim().clone()
    if rest.ends_with(",") {
        rest = rest[0..<rest.len() - ",".len()].trim().clone()
    }
    let ty = rs2nika_ty(ctx, rest)
    rs2nika_hit(ctx, "R78")
    return f"{ind}{vis}{name}: {ty},"
}

pub fn rs2nika_convert(src: String, profile_given: String, prefix: String, repo: String, facts: ref Vec[String]) -> Rs2nikaOut {
    // R83: `check-free` / `emit-free` turn the methods into free functions
    let free = profile_given.ends_with("-free")
    let mut base: String = profile_given.clone()
    if free {
        base = profile_given[0..<profile_given.len() - "-free".len()].clone()
    }
    let mut view = false
    if base.ends_with("+view") {
        view = true
        base = base[0..<base.len() - "+view".len()].clone()
    }
    let profile = base.clone()
    let mut world: String = ""
    if profile == "check" {
        world = "CheckWorld"
    } else if profile == "emit" {
        world = "EmitWorld"
    }
    let mut ctx = Rs2nikaCtx { profile: base.clone(), free: free, world: world, prefix: prefix.clone(), hits: [], fn_opt: false, methods: [], renamed_from: [], renamed_to: [], stack_ind: [], stack_kind: [], tool_fns: collections::BTreeSet(), tool_names: [], tool_docs: [], tool_files: [], alias_from: [], alias_to: [], equiv_from: [], equiv_to: [], todo_extra: [], arity: [], host_fns: [], opt_names: rs2nika_opt_names(src), parsed_names: rs2nika_parsed_names(src), impl_other: false, field_opts: collections::BTreeSet(), tuple_line: [], tuple_why: [], view: view, view_names: [], seq_fns: [] }
    if repo != "" {
        rs2nika_load(ctx, repo)
    }
    if view {
        ctx.view_names = rs2nika_view_names(repo)
    }
    rs2nika_enum_arity(ctx, src)
    let pruned0 = rs2nika_rust_impls(ctx, src)
    let pruned1 = rs2nika_tool_paths(ctx, pruned0)
    let pruned = rs2nika_mut_some(ctx, pruned1)
    let delegated = rs2nika_delegates(ctx, pruned)
    let narrowed = rs2nika_narrow(ctx, delegated)
    let viewed0 = rs2nika_view(ctx, narrowed)
    let viewed = rs2nika_unwrap_impls(ctx, viewed0)
    let mut lines: Vec[String] = []
    for given in viewed.split("\n") {
        let raw = rs2nika_const_fn(ctx, given)
        lines.push(rs2nika_reserved(ctx, raw))
        rs2nika_impl_track(ctx, raw)
        let name = rs2nika_fn_name(raw)
        if name != "" && !ctx.impl_other {
            if rs2nika_takes_self(raw) {
                ctx.methods.push(name.clone())
            }
            if prefix != "" && !rs2nika_starts(name, prefix) {
                ctx.renamed_from.push(name.clone())
                ctx.renamed_to.push(f"{prefix}{name}")
            }
        }
    }
    ctx.impl_other = false
    if free {
        rs2nika_host_fns(ctx, viewed)
    }
    let walked = rs2nika_visits(ctx, lines)
    let consts0 = rs2nika_lift_consts(ctx, walked)
    let consts = rs2nika_self_type(ctx, consts0)
    let typed = rs2nika_typed_closures(ctx, consts, facts)
    let inlined = rs2nika_inline_closures(ctx, typed)
    let hoisted = rs2nika_hoist(ctx, inlined)
    let first = rs2nika_join_chains(ctx, hoisted)
    let split = rs2nika_join_split(ctx, first)
    let chained0 = rs2nika_join_chains(ctx, split)
    let chained = rs2nika_results(ctx, chained0)
    for name in rs2nika_opt_lets(chained, ctx.opt_names) {
        ctx.opt_names.push(name.clone())
    }
    let nested = rs2nika_nest_chains(ctx, chained)
    let joined0 = rs2nika_option_matches(ctx, nested)
    let joined2 = rs2nika_some_matches(ctx, joined0)
    let joined1 = rs2nika_tuple_matches(ctx, joined2)
    let joined = rs2nika_field_tests(ctx, joined1)
    let mut out: Vec[String] = []
    let mut in_struct = false
    let mut in_enum = false
    for given in joined {
        let raw = rs2nika_some_field_arm(ctx, given)
        let st: String = raw.trim().clone()
        if in_enum {
            if st.starts_with("}") {
                in_enum = false
            } else {
                let variant = rs2nika_enum_variant(ctx, raw)
                if variant != "" {
                    out.push(variant)
                    continue
                }
            }
        }
        if rs2nika_enum_head(st) {
            in_enum = true
            out.push(rs2nika_struct_header(ctx, raw))
            continue
        }
        if in_struct {
            if st.starts_with("}") {
                in_struct = false
            } else {
                let field = rs2nika_struct_field(ctx, raw)
                if field != "" {
                    out.push(field)
                    continue
                }
            }
        }
        if rs2nika_struct_head(st) {
            in_struct = true
            out.push(rs2nika_struct_header(ctx, raw))
            continue
        }
        if st.starts_with("#[") {
            rs2nika_hit(ctx, "R30")
        } else if st == "" {
            out.push("")
        } else if st.starts_with("//") {
            out.push(raw.clone())
        } else {
            let konst = rs2nika_static(ctx, raw)
            if konst != "" {
                out.push(konst)
                continue
            }
            let konst2 = rs2nika_const(ctx, raw)
            if konst2 != "" {
                out.push(konst2)
                continue
            }
            rs2nika_impl_track(ctx, raw)
            let head = rs2nika_impl_head(ctx, raw)
            if head != "" {
                out.push(head)
                continue
            }
            let sig = rs2nika_signature(ctx, raw)
            let shift = rs2nika_shift(ctx, 0)
            ctx.todo_extra = []
            let mut iflet: Vec[String] = []
            if sig == "" {
                iflet = rs2nika_if_let(ctx, raw)
            }
            let mut line: String = raw.clone()
            if iflet.len() >= 2 && iflet[0] == "=" {
                line = iflet[1].clone()
                let mut k = 2
                while k < iflet.len() {
                    line = f"{line}\n{shift}{iflet[k]}"
                    k = k + 1
                }
            }
            let mut closing: Vec[String] = []
            let below = rs2nika_shift(ctx, 1)
            if sig == "" && iflet.len() == 0 {
                closing = rs2nika_close_iflet(ctx, raw)
            }
            let adapter = rs2nika_adapter_mark(raw, sig != "")
            if adapter != "" {
                out.push(f"{rs2nika_indent(raw)}// ADAPTER: bleibt in Rust ({adapter})")
                rs2nika_hit(ctx, "R58")
            }
            if sig != "" {
                out.push(sig)
            } else if iflet.len() > 0 && iflet[0] != "=" {
                for l in iflet {
                    out.push(f"{shift}{l}")
                }
            } else if closing.len() > 0 {
                for l in closing {
                    out.push(f"{below}{l}")
                }
            } else {
                line = rs2nika_some_arms_inline(ctx, f"{shift}{line}")
                let ind = rs2nika_indent(line)
                for t in ctx.todo_extra.clone() {
                    out.push(f"{ind}// TODO(rs2nika): {t}")
                }
                for t in rs2nika_todos(line, ctx.opt_names) {
                    let mut said: String = t.clone()
                    if t == rs2nika_some_tuple() {
                        let mut w = 0
                        while w < ctx.tuple_line.len() {
                            if ctx.tuple_line[w] == line.trim() {
                                said = f"a `Some(` in a tuple pattern: {ctx.tuple_why[w]}"
                                break
                            }
                            w = w + 1
                        }
                    }
                    out.push(f"{ind}// TODO(rs2nika): {said}")
                }
                if line.trim_start().starts_with("None if ") || line.trim_start().starts_with("None =>") {
                    rs2nika_hit(ctx, "R71")
                }
                line = rs2nika_some_arm(ctx, line)
                let typed = rs2nika_let_type(ctx, line)
                let before_expr = ctx.todo_extra.len()
                let mut code: String = rs2nika_expr(ctx, typed).trim_end().clone()
                let mut k = before_expr
                let mut holes: Vec[String] = []
                while k < ctx.todo_extra.len() {
                    let t = ctx.todo_extra[k].clone()
                    if t.starts_with("let hole_") {
                        let bound: String = rs2nika_expr(ctx, t)
                        holes.push(bound)
                    } else {
                        out.push(f"{ind}// TODO(rs2nika): {t}")
                    }
                    k = k + 1
                }
                if code.ends_with(";") && !code.trim_start().starts_with("//") {
                    code = code[0..<code.len() - ";".len()].clone()
                    rs2nika_hit(ctx, "R1")
                }
                code = rs2nika_block_semis(code)
                code = rs2nika_arm_assign(ctx, code)
                // R70: a hole hoisted out of a match arm goes into the arm's block
                let arrow = code.find(" => ") ?? 0
                let lead: String = code.trim_start().clone()
                let arm = holes.len() > 0 && arrow > 0 && code.ends_with(",") && !code.ends_with("},") && !lead.starts_with("let ") && !lead.starts_with("return ") && !lead.starts_with("if ") && !lead.starts_with("//")
                if arm {
                    let head: String = code[0..<arrow + " => ".len()].clone()
                    let body: String = code[arrow + " => ".len()..<code.len() - ",".len()].clone()
                    out.push(f"{head}{{")
                    for h in holes {
                        out.push(f"{ind}    {h}")
                    }
                    out.push(f"{ind}    {body}")
                    out.push(f"{ind}}},")
                    rs2nika_hit(ctx, "R70")
                } else {
                    for h in holes {
                        out.push(f"{ind}{h}")
                    }
                    out.push(code)
                }
            }
        }
    }
    let mut armed = out.clone()
    if ctx.free {
        armed = rs2nika_unimpl(ctx, out)
    }
    let returned = rs2nika_tail_returns(ctx, armed)
    let matched = rs2nika_result_matches(ctx, returned)
    let done0 = rs2nika_result_reads(ctx, matched)
    let done1 = rs2nika_typed_empty(ctx, done0)
    let done2 = rs2nika_unused_hosts(ctx, done1)
    let done3 = rs2nika_close_lambdas(ctx, done2)
    let done4 = rs2nika_drop_mods(ctx, done3)
    let done5 = rs2nika_at_bindings(ctx, done4)
    let done6 = rs2nika_collect_seqs(ctx, done5)
    let done = rs2nika_split_chains(ctx, done6)
    // R100 after R45, which drops the `use` of an alias
    let named = rs2nika_aliases(ctx, rs2nika_join(done, "\n"))
    let mut named_lines: Vec[String] = []
    for l in named.split("\n") {
        named_lines.push(l.clone())
    }
    let text = rs2nika_use_text(rs2nika_lift_uses(ctx, named_lines))
    let mut missing: Vec[String] = []
    let mut twins: Vec[String] = []
    if ctx.tool_names.len() > 0 {
        missing = rs2nika_missing(ctx, text)
        twins = rs2nika_twins(ctx, src)
    }
    return Rs2nikaOut { text: text, hits: ctx.hits, missing: missing, twins: twins }
}

fn rs2nika_lower(c: scalar) -> bool {
    return (c >= 'a' && c <= 'z') || c == '_'
}

fn rs2nika_upper(c: scalar) -> bool {
    return c >= 'A' && c <= 'Z'
}

/// Whether `c` may stand in a path: a word character or `:`.
fn rs2nika_path_char(c: scalar) -> bool {
    return rs2nika_word(c) || c == ':'
}

/// `from` replaced where it is a whole name: not after a word character, `.`
/// or `:`, and not followed by a word character when it ends in one.
fn rs2nika_replace_name(text: String, from: String, to: String) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let f: Vec[scalar] = from.chars().collect()
    if f.len() == 0 {
        return text.clone()
    }
    let mut out: String = ""
    let mut at = 0
    let mut quoted = false
    while at < c.len() {
        if rs2nika_quote_at(c, at) {
            quoted = !quoted
        }
        if quoted || c[at] == '"' {
            out.push(c[at])
            at = at + 1
            continue
        }
        let mut same = at + f.len() <= c.len()
        let mut k = 0
        while same && k < f.len() {
            if c[at + k] != f[k] {
                same = false
            }
            k = k + 1
        }
        if same && at > 0 && (rs2nika_path_char(c[at - 1]) || c[at - 1] == '.') {
            same = false
        }
        if same && rs2nika_word(f[f.len() - 1]) && at + f.len() < c.len() && rs2nika_word(c[at + f.len()]) {
            same = false
        }
        if same {
            out.push_str(to)
            at = at + f.len()
        } else {
            out.push(c[at])
            at = at + 1
        }
    }
    return out
}

/// R54: `["A", "B"].contains(x)` -> `(x == "A" || x == "B")`, and
/// `x.rsplit("::").next() ?? x` -> `type_last_segment(x)` (check_types.nika).
fn rs2nika_idioms(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    let mut from = 0
    while true {
        let c: Vec[scalar] = s.chars().collect()
        let at = rs2nika_find_from(c, "].contains(", from)
        if at < 0 {
            break
        }
        from = at + 1
        let mut open = at - 1
        let mut d = 0
        while open >= 0 && !(c[open] == '[' && d == 0) {
            if c[open] == ']' {
                d = d + 1
            } else if c[open] == '[' {
                d = d - 1
            }
            open = open - 1
        }
        if open < 0 || (open > 0 && (rs2nika_word(c[open - 1]) || c[open - 1] == ')' || c[open - 1] == ']')) {
            continue
        }
        let items: String = rs2nika_text(c, open + 1, at)
        let mut lits: Vec[String] = []
        let mut plain = true
        for it in items.split(",") {
            let t: String = it.trim().clone()
            if t != "" {
                if t.len() >= 2 && t.starts_with("\"") && t.ends_with("\"") && rs2nika_count(t, '"') == 2 {
                    lits.push(t)
                } else {
                    plain = false
                }
            }
        }
        let arg_open = at + 10
        let close = rs2nika_closing(c, arg_open, '(', ')')
        if !plain || lits.len() == 0 || close < 0 {
            continue
        }
        let mut arg: String = rs2nika_text(c, arg_open + 1, close).trim().clone()
        while arg.starts_with("&") {
            arg = (arg.strip_prefix("&") ?? "").clone()
        }
        let mut tests: Vec[String] = []
        for l in lits {
            tests.push(f"{arg} == {l}")
        }
        let joined = rs2nika_join(tests, " || ")
        let pre: String = rs2nika_text(c, 0, open)
        let post: String = rs2nika_text(c, close + 1, c.len())
        s = f"{pre}({joined}){post}"
        rs2nika_hit(ctx, "R54")
    }
    while true {
        let c: Vec[scalar] = s.chars().collect()
        let at = rs2nika_find_from(c, ".rsplit(\"::\").next() ?? ", 0)
        if at < 0 {
            break
        }
        let mut b = at
        while b > 0 && (rs2nika_word(c[b - 1]) || c[b - 1] == '.') {
            b = b - 1
        }
        let recv: String = rs2nika_text(c, b, at)
        let after = at + 24
        let e = after + recv.len()
        if recv == "" || e > c.len() || rs2nika_text(c, after, e) != recv || (e < c.len() && rs2nika_word(c[e])) {
            break
        }
        let pre: String = rs2nika_text(c, 0, b)
        let post: String = rs2nika_text(c, e, c.len())
        s = f"{pre}type_last_segment({recv}){post}"
        rs2nika_hit(ctx, "R54")
    }
    return s
}

/// R53: Rust's `a..b` stops before `b`, Nikaia's includes it: `a..b` ->
/// `a..<b`, `a..=b` -> `a..b`. A `..` with no end (`x..`, `{ .. }`, `..base`)
/// is left as it is; strings are skipped.
fn rs2nika_ranges(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    let mut quoted = false
    while at < c.len() {
        let ch = c[at]
        if ch == '"' && (at == 0 || c[at - 1] != '\\') {
            quoted = !quoted
        }
        let dots = !quoted && ch == '.' && at + 1 < c.len() && c[at + 1] == '.' && (at + 2 >= c.len() || c[at + 2] != '.') && (at == 0 || c[at - 1] != '.')
        if dots {
            let before = at > 0 && (rs2nika_word(c[at - 1]) || c[at - 1] == ')' || c[at - 1] == ']' || c[at - 1] == '[')
            let mut next = at + 2
            let inclusive = next < c.len() && c[next] == '='
            if inclusive {
                next = next + 1
            }
            let after = next < c.len() && (rs2nika_word(c[next]) || c[next] == '(' || c[next] == '-')
            if before && after && c[at + 2] != '<' {
                if inclusive {
                    out.push_str("..")
                } else {
                    out.push_str("..<")
                }
                rs2nika_hit(ctx, "R53")
                at = next
                continue
            }
        }
        out.push(ch)
        at = at + 1
    }
    return out
}

/// R82: a local closure with arguments (`let f = |a: &T| -> R { .. };`) gets
/// its type on the `let`: `let f: fn(ref T) -> R sync = |a| { .. };` (R26
/// then writes the lambda). The type is the `local` fact of rust-analyzer
/// for that line (`--facts`), or the closure's own annotations when every
/// argument and the result are written down; otherwise the line is kept.
fn rs2nika_typed_closures(mut ctx: Rs2nikaCtx, given: ref Vec[String], facts: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut at = 0
    for l in given {
        at = at + 1
        let st: String = l.trim().clone()
        let eq = st.find(" = ") ?? 0
        if !st.starts_with("let ") || eq < 5 {
            out.push(l.clone())
            continue
        }
        let name: String = (st[..<eq].strip_prefix("let ") ?? "").trim().clone()
        let mut rest: String = st[eq + " = ".len()..<st.len()].trim().clone()
        if rest.starts_with("move ") {
            rest = (rest.strip_prefix("move ") ?? "").trim().clone()
        }
        if !rs2nika_is_path(name) || name.contains(":") || !rest.starts_with("|") || rest.starts_with("||") {
            out.push(l.clone())
            continue
        }
        let inner: String = (rest.strip_prefix("|") ?? "").clone()
        let bar = inner.find("|") ?? inner.len()
        if bar >= inner.len() {
            out.push(l.clone())
            continue
        }
        let params: String = inner[0..<bar].clone()
        let mut body: String = inner[bar + "|".len()..<inner.len()].trim().clone()
        let mut ret: String = ""
        if body.starts_with("->") {
            let brace = body.find("{") ?? body.len()
            if brace >= body.len() {
                out.push(l.clone())
                continue
            }
            ret = (body[..<brace].strip_prefix("->") ?? "").trim().clone()
            body = body[brace..<body.len()].clone()
        }
        // the type: the fact first, then the closure's own annotations
        let key: String = f"{at}\t"
        let mut ty: String = ""
        for fact in facts {
            if fact.starts_with(ref key) && fact.contains("Fn") {
                ty = (fact.strip_prefix(key) ?? "").trim().clone()
            }
        }
        let mut names: Vec[String] = []
        let mut types: Vec[String] = []
        for p in rs2nika_split_args(params) {
            let colon = p.find(":") ?? p.len()
            if colon >= p.len() {
                names.push(p.trim().clone())
            } else {
                names.push(p[0..<colon].trim().clone())
                types.push(p[colon + ":".len()..<p.len()].trim().clone())
            }
        }
        if ty == "" && ret != "" && types.len() == names.len() {
            let joined = rs2nika_join(types, ", ")
            ty = f"impl Fn({joined}) -> {ret}"
        }
        let fopen = ty.find("Fn") ?? ty.len()
        if fopen >= ty.len() {
            out.push(l.clone())
            continue
        }
        let decl = rs2nika_fn_param(ctx, name, ty[fopen..<ty.len()].clone())
        let ind = rs2nika_indent(l)
        let args = rs2nika_join(names, ", ")
        out.push(f"{ind}let {decl} = |{args}| {body}")
        rs2nika_hit(ctx, "R82")
    }
    return out
}

/// R43: zero-argument local closures (`let f = || e;`) inlined where they
/// are called, and their `let` dropped.
fn rs2nika_inline_closures(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut names: Vec[String] = []
    let mut bodies: Vec[String] = []
    let mut keep: Vec[String] = []
    for l in given {
        let st: String = l.trim().clone()
        let eq = st.find(" = ") ?? 0
        let mut taken = false
        if st.starts_with("let ") && eq > 4 && st.ends_with(";") {
            let name: String = (st[..<eq].strip_prefix("let ") ?? "").trim().clone()
            let mut rest: String = st[eq + " = ".len()..<st.len() - ";".len()].trim().clone()
            if rest.starts_with("move ") {
                rest = (rest.strip_prefix("move ") ?? "").trim().clone()
            }
            if rs2nika_is_path(name) && !name.contains(":") && rest.starts_with("||") {
                let body: String = (rest.strip_prefix("||") ?? "").trim().clone()
                if body != "" {
                    names.push(name)
                    bodies.push(body)
                    rs2nika_hit(ctx, "R43")
                    taken = true
                }
            }
        }
        if !taken {
            keep.push(l.clone())
        }
    }
    let mut out: Vec[String] = []
    for l in keep {
        let mut s: String = l.clone()
        let mut k = 0
        while k < names.len() {
            let n: String = names[k].clone()
            s = rs2nika_replace_free(s, f"{n}()", bodies[k])
            k = k + 1
        }
        out.push(s)
    }
    return out
}

/// The braces a line opens, net, with strings and comments left out.
fn rs2nika_depth_of(line: String) -> i64 {
    let b = rs2nika_blank(line)
    let mut code: String = b.clone()
    let cut = b.find("//") ?? b.len()
    if cut < b.len() {
        code = b[0..<cut].clone()
    }
    return rs2nika_count(code, '{') - rs2nika_count(code, '}')
}

/// R51: a `fn` declared inside a `fn` becomes a top-level `fn` after it.
fn rs2nika_hoist(mut ctx: Rs2nikaCtx, lines: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut moved: Vec[String] = []
    let mut depth = 0
    let mut in_impl = false
    let mut i = 0
    while i < lines.len() {
        let l: String = lines[i].clone()
        let ind = rs2nika_indent(l)
        let st: String = l.trim().clone()
        if depth == 0 {
            // the methods of an `impl` (or a `trait`) are not nested functions (R148)
            in_impl = st.starts_with("impl ") || st.starts_with("impl<") || rs2nika_starts(st.trim_start_matches("pub "), "trait ")
        }
        if depth > 0 && !(in_impl && depth == 1) && ind != "" && st.starts_with("fn ") {
            let close: String = f"{ind}}}"
            let mut j = i + 1
            while j < lines.len() && lines[j].trim_end() != close {
                j = j + 1
            }
            moved.push("")
            let mut k = i
            while k <= j && k < lines.len() {
                let x: String = lines[k].clone()
                if rs2nika_starts(x, ind) {
                    let y: String = (x.strip_prefix(ind) ?? "").clone()
                    moved.push(y)
                } else {
                    moved.push(x.clone())
                }
                k = k + 1
            }
            rs2nika_hit(ctx, "R51")
            i = j + 1
            continue
        }
        let before = depth
        depth = depth + rs2nika_depth_of(l)
        out.push(l)
        if before > 0 && depth == 0 && moved.len() > 0 {
            for m in moved {
                out.push(m.clone())
            }
            moved = []
        }
        i = i + 1
    }
    return out
}

/// R26: `.any(|x| p)` -> `.filter(|x| p).count() > 0`, `.all(|x| p)` ->
/// `.filter(|x| !(p)).count() == 0`, `.find(|x| p)` -> `.filter(|x| p).next()`;
/// `.any(f)`/`.all(f)` with a function name call it with the element.
fn rs2nika_adapters(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    for name in ["any", "all", "find"] {
        let mut from = 0
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let at = rs2nika_find_from(c, f".{name}(", from)
            if at < 0 {
                break
            }
            let open = at + name.len() + 1
            let b = open + 1
            if b < c.len() && c[b] == '|' {
                // a closure: `Seq::any`/`all`/`find` take it as it is
                from = at + 1
                continue
            }
            let mut e = b
            while e < c.len() && rs2nika_path_char(c[e]) {
                e = e + 1
            }
            let f: String = rs2nika_text(c, b, e)
            if name == "find" || e == b || e >= c.len() || c[e] != ')' || !rs2nika_word(c[b]) {
                from = at + 1
                continue
            }
            let callee = rs2nika_renamed(ctx, f)
            let pre: String = rs2nika_text(c, 0, at)
            let post: String = rs2nika_text(c, e + 1, c.len())
            s = f"{pre}.{name}(|x| {callee}(x)){post}"
            rs2nika_hit(ctx, "R26")
            from = at + 1
        }
    }
    return s
}

/// R49: `Ty::named(x)` / `Ty::view(x)` -> `Ty::Named { name: x, args: [], view: false/true }`.
fn rs2nika_ty_named(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    for which in ["named", "view"] {
        while true {
            let c: Vec[scalar] = s.chars().collect()
            let mut at = rs2nika_find_from(c, f"Ty::{which}(", 0)
            while at > 0 && rs2nika_word(c[at - 1]) {
                at = rs2nika_find_from(c, f"Ty::{which}(", at + 1)
            }
            if at < 0 {
                break
            }
            let open = at + which.len() + 4
            let end = rs2nika_closing(c, open, '(', ')')
            if end < 0 {
                break
            }
            let arg: String = rs2nika_text(c, open + 1, end)
            let pre: String = rs2nika_text(c, 0, at)
            let post: String = rs2nika_text(c, end + 1, c.len())
            let view = which == "view"
            s = f"{pre}Ty::Named {{ name: {arg}, args: [], view: {view} }}{post}"
            rs2nika_hit(ctx, "R49")
        }
    }
    return s
}

/// R46: a path call `a::b::f(..)` -> `f(..)` where tools/*.nika has `fn f`;
/// R47: the names rs2nika.names gives Nikaia's spelling of.
fn rs2nika_names(mut ctx: Rs2nikaCtx, given: String) -> String {
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        let free = at == 0 || !(rs2nika_word(c[at - 1]) || c[at - 1] == '.')
        if free && rs2nika_lower(c[at]) {
            let mut e = at
            let mut last = at
            let mut segs = 0
            while true {
                let mut w = e
                while w < c.len() && rs2nika_lower(c[w]) {
                    w = w + 1
                }
                if w > e && w + 1 < c.len() && c[w] == ':' && c[w + 1] == ':' {
                    e = w + 2
                    last = e
                    segs = segs + 1
                } else {
                    break
                }
            }
            let mut n = last
            if segs > 0 && n < c.len() && rs2nika_lower(c[n]) {
                while n < c.len() && rs2nika_word(c[n]) {
                    n = n + 1
                }
                let name: String = rs2nika_text(c, last, n)
                if n < c.len() && c[n] == '(' && (ctx.tool_fns.contains(name) || ctx.equiv_from.contains(name)) {
                    out.push_str(name)
                    rs2nika_hit(ctx, "R46")
                    at = n
                    continue
                }
                // R76: a module that is a tools file (`throws::f(`): all
                // tools/*.nika share one namespace
                let module: String = rs2nika_text(c, at, last - 2)
                if segs == 1 && n < c.len() && c[n] == '(' && ctx.tool_files.contains(f"{module}.nika") {
                    out.push_str(name)
                    rs2nika_hit(ctx, "R76")
                    if !name.starts_with(ctx.prefix) {
                        ctx.todo_extra.push(f"`{module}::{name}`: tools/{module}.nika has no `{name}`; see rs2nika.names")
                    }
                    at = n
                    continue
                }
            }
        }
        out.push(c[at])
        at = at + 1
    }
    let mut s: String = out.clone()
    let mut k = 0
    while k < ctx.equiv_from.len() {
        let s2 = rs2nika_replace_name(s, ctx.equiv_from[k], ctx.equiv_to[k])
        if !rs2nika_same(s2, s) {
            rs2nika_hit(ctx, "R47")
        }
        s = s2.clone()
        k = k + 1
    }
    return s
}

/// R45: a Rust alias of a moved type -> its Nikaia name, over the whole draft.
fn rs2nika_aliases(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut k = 0
    // a `use m::Alias` in the body names a type Nikaia spells otherwise
    let mut kept: Vec[String] = []
    for l in given.split("\n") {
        let st: String = l.trim().clone()
        let cut = st.rfind("::") ?? 0
        if st.starts_with("use ") && cut > 0 && !st.contains("{") && ctx.alias_from.contains(st[cut + "::".len()..].clone()) {
            rs2nika_hit(ctx, "R45")
            continue
        }
        kept.push(l.clone())
    }
    let mut s: String = rs2nika_join(kept, "\n")
    while k < ctx.alias_from.len() {
        let y: String = ctx.alias_from[k].clone()
        let x: String = ctx.alias_to[k].clone()
        let yc: Vec[scalar] = y.chars().collect()
        let xc: Vec[scalar] = x.chars().collect()
        if yc.len() > 0 && xc.len() > 0 && rs2nika_upper(yc[0]) && rs2nika_upper(xc[0]) {
            let s2 = rs2nika_replace_name(s, y, x)
            if !rs2nika_same(s2, s) {
                rs2nika_hit(ctx, "R45")
            }
            s = s2.clone()
        }
        k = k + 1
    }
    return s
}

/// R97: a let-chain `if a && let Some(x) = e [&& b] {`. Over a plain name `e`
/// -> `if a && e != null [&& b] {` (ADR-382 D2: `&&` carries the proof; `x`
/// is `e`, or `let x = e` in the block); over anything else -> `if a {` + `let
/// x = e` + `if x != null [&& b] {`, so `e` is still evaluated only where `a`
/// holds, and the block closes twice. One `let`, a `Some(name)` pattern.
fn rs2nika_let_chain(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let st: String = line.trim().clone()
    let at = st.find(" && let Some(") ?? return []
    if !st.starts_with("if ") || !st.ends_with(" {") || st.matches(" let ").count() != 1 {
        return []
    }
    let a: String = st["if ".len()..<at].clone()
    let rest: String = st[at + " && let Some(".len()..<st.len() - " {".len()].clone()
    let close = rest.find(") = ") ?? return []
    let name: String = rest[0..<close].replace("&", "").trim().clone()
    if !rs2nika_is_path(name) || name.contains(".") || name.contains(":") {
        return []
    }
    let mut value: String = rest[close + ") = ".len()..<rest.len()].trim().clone()
    let mut guard: String = ""
    let rc: Vec[scalar] = value.chars().collect()
    let mut depth = 0
    let mut k = 0
    while k + 4 <= rc.len() {
        if rc[k] == '(' || rc[k] == '[' || rc[k] == '{' {
            depth = depth + 1
        } else if rc[k] == ')' || rc[k] == ']' || rc[k] == '}' {
            depth = depth - 1
        }
        if depth == 0 && rs2nika_text(rc, k, k + 4) == " && " {
            guard = rs2nika_text(rc, k + 4, rc.len()).trim().clone()
            value = rs2nika_text(rc, 0, k).trim().clone()
            break
        }
        k = k + 1
    }
    while value.starts_with("&") {
        value = (value.strip_prefix("&") ?? "").trim_start().clone()
    }
    let pa = rs2nika_expr(ctx, a)
    let plain = rs2nika_is_path(value) && !value.contains(".") && !value.contains(":") && !value.contains("(")
    rs2nika_hit(ctx, "R97")
    ctx.stack_ind.push(ind.clone())
    if plain {
        ctx.stack_kind.push("if")
        let v = rs2nika_expr(ctx, value)
        let mut g: String = ""
        if guard != "" {
            let ge = rs2nika_expr(ctx, rs2nika_replace_word(guard, name, value))
            g = f" && {ge}"
        }
        if name == value {
            return [f"{ind}if {pa} && {v} != null{g} {{"]
        }
        return [f"{ind}if {pa} && {v} != null{g} {{", f"{ind}    let {name} = {v}"]
    }
    ctx.stack_kind.push("chain")
    let v = rs2nika_expr(ctx, value)
    let mut g: String = ""
    if guard != "" {
        let ge = rs2nika_expr(ctx, guard)
        g = f" && {ge}"
    }
    return [f"{ind}if {pa} {{", f"{ind}    let {name} = {v}", f"{ind}    if {name} != null{g} {{"]
}

/// R162: the parts of a let-chain's condition, between the `&&`s outside
/// brackets and strings; none where a `|` stands outside them (`||`, a
/// closure whose `&&` would be read as the chain's).
fn rs2nika_chain_parts(cond: String) -> Vec[String] {
    let cc: Vec[scalar] = cond.chars().collect()
    let mut parts: Vec[String] = []
    let mut depth = 0
    let mut from = 0
    let mut quoted = false
    let mut k = 0
    while k < cc.len() {
        let ch = cc[k]
        if quoted {
            if ch == '\\' {
                k = k + 1
            } else if ch == '"' {
                quoted = false
            }
        } else if ch == '"' {
            quoted = true
        } else if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1
        } else if ch == '|' && depth == 0 {
            return []
        } else if depth == 0 && k + 4 <= cc.len() && rs2nika_text(cc, k, k + 4) == " && " {
            parts.push(rs2nika_text(cc, from, k).trim().clone())
            from = k + 4
            k = k + 4
            continue
        }
        k = k + 1
    }
    parts.push(rs2nika_text(cc, from, cc.len()).trim().clone())
    return parts
}

/// R199: a chain's `let Some(P) = e` whose `P` can fail (`Some(Stmt::Expr(v))`):
/// R97 and R123 take only names under `Some(`, so R162 nests it as any other
/// refutable `let`.
fn rs2nika_refutable_some(part: String) -> bool {
    let rest: String = (part.strip_prefix("let Some(") ?? return false).clone()
    let (pat, _) = rest.split_once(") = ") ?? return false
    return !rs2nika_irrefutable(pat.replace("&", "").replace("ref ", "").trim().clone())
}

/// R162: `if [a &&] let P = e [&& g] && rest {` with no `else`, `P` not
/// `Some(..)` (R97 and R123 take those), `rest` starting with a `let` ->
/// `if a {`, `if let P = e [&& g] {` (R24) and `if rest {` nested, the block
/// shifted in and closed once for each; a `rest` that is a chain again is
/// taken on the next line. `if let P = e && g {` alone is R24's.
fn rs2nika_nest_chains(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = given.clone()
    let mut i = 0
    while i < out.len() {
        let st: String = out[i].trim().clone()
        if !st.starts_with("if ") || !st.ends_with(" {") || !(st.contains(" let ") || st.starts_with("if let ")) {
            i = i + 1
            continue
        }
        // a `let`'s value lent (`= &mut x`, `= &x`): Nikaia lends implicitly
        let mut parts: Vec[String] = []
        for part in rs2nika_chain_parts(st["if ".len()..<st.len() - " {".len()].clone()) {
            if part.starts_with("let ") {
                parts.push(part.replace(" = &mut ", " = ").replace(" = &", " = "))
            } else {
                parts.push(part.clone())
            }
        }
        let mut first_let = 0 - 1
        let mut p = 0
        while p < parts.len() && first_let < 0 {
            if parts[p].starts_with("let ") && (!parts[p].starts_with("let Some(") || rs2nika_refutable_some(parts[p])) && parts[p].contains(" = ") {
                first_let = p
            }
            p = p + 1
        }
        // the next `let` after it: the parts between are its guard
        let mut next_let = parts.len()
        if first_let >= 0 {
            p = first_let + 1
            while p < parts.len() && next_let == parts.len() {
                if parts[p].starts_with("let ") {
                    next_let = p
                }
                p = p + 1
            }
        }
        // one `let`, first, and guards: R24's `match` with a guard
        if parts.len() < 2 || first_let < 0 || (first_let == 0 && next_let == parts.len()) {
            i = i + 1
            continue
        }
        let ind = rs2nika_indent(out[i])
        let closing = f"{ind}}}"
        let mut j = i + 1
        while j < out.len() && !(rs2nika_starts(out[j], closing) && rs2nika_indent(out[j]) == ind) {
            j = j + 1
        }
        if j >= out.len() || out[j].trim() != "}" {
            i = i + 1
            continue
        }
        let step = "    "
        let mut heads: Vec[String] = []
        if first_let > 0 {
            let mut before: Vec[String] = []
            let mut b = 0
            while b < first_let {
                before.push(parts[b].clone())
                b = b + 1
            }
            heads.push(rs2nika_join(before, " && "))
        }
        let mut guarded: Vec[String] = []
        let mut g = first_let
        while g < next_let {
            guarded.push(parts[g].clone())
            g = g + 1
        }
        heads.push(rs2nika_join(guarded, " && "))
        if next_let < parts.len() {
            let mut after: Vec[String] = []
            let mut a = next_let
            while a < parts.len() {
                after.push(parts[a].clone())
                a = a + 1
            }
            heads.push(rs2nika_join(after, " && "))
        }
        let mut rebuilt: Vec[String] = []
        let mut r = 0
        while r < i {
            rebuilt.push(out[r].clone())
            r = r + 1
        }
        let mut level = 0
        for h in heads {
            rebuilt.push(f"{ind}{step.repeat(level)}if {h} {{")
            level = level + 1
        }
        let shift = step.repeat(level - 1)
        r = i + 1
        while r < j {
            if out[r].trim() == "" {
                rebuilt.push("")
            } else {
                rebuilt.push(f"{shift}{out[r]}")
            }
            r = r + 1
        }
        while level > 0 {
            level = level - 1
            rebuilt.push(f"{ind}{step.repeat(level)}}}")
        }
        r = j + 1
        while r < out.len() {
            rebuilt.push(out[r].clone())
            r = r + 1
        }
        out = rebuilt
        rs2nika_hit(ctx, "R162")
        i = i + 1
    }
    return out
}

/// R123: the let-chains R97 leaves, `if [a &&] let Some(P) = e && .. {`
/// with several `let`s, or one first, or a tuple `P`: each `let` over a plain
/// name is `e != null` in the test (and `let P = e` in the block); over
/// anything else the test so far opens an `if`, then `let P = e`, and `P !=
/// null` starts the next test; a tuple `P` is taken out under its own `if`.
/// The block closes once for each `if`. Only `Some(P)` patterns, `P` a name
/// or a tuple of names.
fn rs2nika_let_chains(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let ind = rs2nika_indent(line)
    let st: String = line.trim().clone()
    if !st.starts_with("if ") || !st.ends_with(" {") || !st.contains("let Some(") {
        return []
    }
    let cond: String = st["if ".len()..<st.len() - " {".len()].clone()
    // the parts between `&&`s at depth 0
    let cc: Vec[scalar] = cond.chars().collect()
    let mut parts: Vec[String] = []
    let mut depth = 0
    let mut from = 0
    let mut k = 0
    while k < cc.len() {
        if cc[k] == '(' || cc[k] == '[' || cc[k] == '{' {
            depth = depth + 1
        } else if cc[k] == ')' || cc[k] == ']' || cc[k] == '}' {
            depth = depth - 1
        } else if cc[k] == '|' && depth == 0 {
            // a closure's own `&&` is not the chain's, nor is `||`'s; one
            // in brackets (`.any(|b| ..)`) keeps its `&&`s inside them
            return []
        }
        if depth == 0 && k + 4 <= cc.len() && rs2nika_text(cc, k, k + 4) == " && " {
            parts.push(rs2nika_text(cc, from, k).trim().clone())
            from = k + 4
            k = k + 4
            continue
        }
        k = k + 1
    }
    parts.push(rs2nika_text(cc, from, cc.len()).trim().clone())
    if parts.len() < 2 {
        return []
    }
    // every `let` is `let Some(P) = e`, `P` names; one tuple at most
    let mut tuples = 0
    for part in parts {
        if !part.starts_with("let ") {
            continue
        }
        let rest: String = (part.strip_prefix("let Some(") ?? return []).clone()
        let close = rest.find(") = ") ?? return []
        let pat: String = rest[0..<close].replace("&", "").replace("ref ", "").trim().clone()
        if rest.contains(" let ") || !rs2nika_irrefutable(pat) || pat == "" {
            return []
        }
        if !(rs2nika_is_path(pat) && !pat.contains(":")) {
            tuples = tuples + 1
        }
    }
    // one `let` with a tuple, first: R48's `match` with a guard takes it
    let mut lets = 0
    for part in parts {
        if part.starts_with("let ") {
            lets = lets + 1
        }
    }
    if tuples > 1 || (tuples == 1 && lets == 1 && parts[0].starts_with("let ")) {
        return []
    }
    let mut out: Vec[String] = []
    let mut conds: Vec[String] = []
    let mut post: Vec[String] = []
    let mut from_names: Vec[String] = []
    let mut to_names: Vec[String] = []
    let mut level = 0
    let step = "    "
    for given in parts {
        let mut part: String = given.clone()
        let mut n = 0
        while n < from_names.len() {
            part = rs2nika_replace_word(part, from_names[n], to_names[n])
            n = n + 1
        }
        let here = f"{ind}{step.repeat(level)}"
        if !part.starts_with("let ") {
            conds.push(rs2nika_expr(ctx, part))
            continue
        }
        let rest: String = (part.strip_prefix("let Some(") ?? "").clone()
        let close = rest.find(") = ") ?? 0
        let pat: String = rest[0..<close].replace("&", "").replace("ref ", "").trim().clone()
        let mut value: String = rest[close + ") = ".len()..<rest.len()].trim().clone()
        while value.starts_with("&") {
            value = (value.strip_prefix("&") ?? "").trim_start().clone()
        }
        let v = rs2nika_expr(ctx, value)
        let plain = rs2nika_is_path(value) && !value.contains(":")
        let named = rs2nika_is_path(pat) && !pat.contains(":")
        if named && plain && !value.contains("(") {
            conds.push(f"{v} != null")
            if pat != value {
                from_names.push(pat.clone())
                to_names.push(value.clone())
                post.push(f"let {pat} = {v}")
            }
            continue
        }
        if conds.len() > 0 {
            let joined = rs2nika_join(conds, " && ")
            out.push(f"{here}if {joined} {{")
            level = level + 1
            conds = []
        }
        let inner = f"{ind}{step.repeat(level)}"
        if named {
            out.push(f"{inner}let {pat} = {v}")
            conds.push(f"{pat} != null")
            continue
        }
        out.push(f"{inner}let pair = {v}")
        out.push(f"{inner}if pair != null {{")
        level = level + 1
        out.push(f"{inner}    let {pat} = pair")
    }
    if conds.len() > 0 {
        let joined = rs2nika_join(conds, " && ")
        out.push(f"{ind}{step.repeat(level)}if {joined} {{")
        level = level + 1
    }
    for p in post {
        out.push(f"{ind}{step.repeat(level)}{p}")
    }
    rs2nika_hit(ctx, "R123")
    ctx.stack_ind.push(ind.clone())
    // `chain` closes twice (R97's), each `+` once more
    if level == 1 {
        ctx.stack_kind.push("if")
    } else {
        let more = "+"
        ctx.stack_kind.push(f"chain{more.repeat(level - 2)}")
    }
    return out
}

/// R24: `if let P = e {` (not `Some(x)`) -> `match e {` + `P => {`; the
/// closing lines it becomes when `line` closes one, or none.
fn rs2nika_close_iflet(mut ctx: Rs2nikaCtx, line: String) -> Vec[String] {
    let st: String = line.trim().clone()
    let ind = rs2nika_indent(line)
    let n = ctx.stack_ind.len()
    if n == 0 || !st.starts_with("}") || ind != ctx.stack_ind[n - 1] {
        return []
    }
    let kind: String = ctx.stack_kind[n - 1].clone()
    let rest: String = (st.strip_prefix("}") ?? "").clone()
    let mut tail: String = rest.clone()
    if tail.ends_with(";") {
        tail = tail[0..<tail.len() - ";".len()].clone()
    }
    let is_else = rest.trim_start().starts_with("else")
    if kind == "iflet" || kind == "ifletopt" {
        // R170: the other arm of an `if let Some(x) = e` is `null`
        let mut other = "else"
        if kind == "ifletopt" {
            other = "null"
        }
        let e: String = rest.trim().clone()
        if e == "else {" {
            ctx.stack_kind[n - 1] = "iflet-else"
            return [f"{ind}    }},", f"{ind}    {other} => {{"]
        }
        if e.starts_with("else if") {
            let mut cond: String = (e.strip_prefix("else if") ?? "").clone()
            if cond.ends_with("{") {
                cond = cond[0..<cond.len() - "{".len()].clone()
            }
            let c2 = rs2nika_expr(ctx, cond.trim())
            ctx.stack_kind[n - 1] = "iflet-elseif"
            return [f"{ind}    }},", f"{ind}    // TODO(rs2nika): `else if` after `if let`", f"{ind}    {other} => {{ if {c2} {{"]
        }
        ctx.stack_ind.pop()
        ctx.stack_kind.pop()
        return [f"{ind}    }},", f"{ind}    {other} => {{}},", f"{ind}}}{tail}"]
    }
    if kind == "iflet-else" && !is_else {
        ctx.stack_ind.pop()
        ctx.stack_kind.pop()
        return [f"{ind}    }},", f"{ind}}}{tail}"]
    }
    if kind == "iflet-elseif" && !is_else {
        ctx.stack_ind.pop()
        ctx.stack_kind.pop()
        return [f"{ind}    }} }},", f"{ind}}}{tail}"]
    }
    if kind == "if" && !is_else {
        ctx.stack_ind.pop()
        ctx.stack_kind.pop()
    }
    // R97's nested `if`: the inner closes too; an `else` would also have to
    // run where the binding is `null`
    if kind == "chain" {
        ctx.stack_ind.pop()
        ctx.stack_kind.pop()
        if is_else {
            return [f"{ind}    }}", f"{ind}    // TODO(rs2nika): this `else` also runs in Rust where the `let` did not match: repeat it after the inner `if`", f"{ind}}}{rest}"]
        }
        return [f"{ind}    }}", f"{ind}}}{tail}"]
    }
    // R123's nested `if`s: each inner one closes too
    if kind.starts_with("chain+") {
        let levels = kind.chars().count() - "chain".len() + 2
        ctx.stack_ind.pop()
        ctx.stack_kind.pop()
        let mut out: Vec[String] = []
        let mut k = levels - 1
        while k > 0 {
            let step = "    "
            out.push(f"{ind}{step.repeat(k)}}}")
            k = k - 1
        }
        if is_else {
            out.push(f"{ind}// TODO(rs2nika): this `else` also runs in Rust where a `let` did not match: repeat it after the inner `if`s")
            out.push(f"{ind}}}{rest}")
            return out
        }
        out.push(f"{ind}}}{tail}")
        return out
    }
    return []
}

/// R83: under a `-free` profile the `impl CheckState { .. }` shell goes: its
/// methods are free functions, dedented one level.
fn rs2nika_unimpl(mut ctx: Rs2nikaCtx, given: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut i = 0
    while i < given.len() {
        let l: String = given[i].clone()
        let st: String = l.trim().clone()
        if st == "impl CheckState {" || st == "impl EmitState {" {
            let ind = rs2nika_indent(l)
            let close: String = f"{ind}}}"
            let inner: String = f"{ind}    "
            let mut j = i + 1
            while j < given.len() && given[j].trim_end() != close {
                let x: String = given[j].clone()
                if rs2nika_starts(x, inner) {
                    out.push((x.bytes[inner.len()..].text() catch { "" }).clone())
                } else {
                    out.push(x.clone())
                }
                j = j + 1
            }
            rs2nika_hit(ctx, "R83")
            i = j + 1
            continue
        }
        out.push(l.clone())
        i = i + 1
    }
    return out
}

/// R44: a whole tools file: `use std::collections`, free items at the top
/// level, methods of `self` inside `impl <State> { }`.
fn rs2nika_as_file(text: String, state: String) -> String {
    let mut free: Vec[String] = []
    let mut meth: Vec[String] = []
    let mut pending: Vec[String] = []
    let mut cur: Vec[String] = []
    let mut cur_method = false
    let mut cur_ind = 0
    let mut open = false
    let mut depth = 0
    for l in text.split("\n") {
        let st: String = l.trim().clone()
        if depth == 0 {
            let mut head: String = st.clone()
            if head.starts_with("pub ") {
                head = (head.strip_prefix("pub ") ?? "").clone()
            }
            // every line at the top is an item (`fn`, `struct`, `comptime`,
            // `trait`, ..) but a comment, a `use` and a closing brace: none
            // is dropped unsaid
            let item = st != "" && !st.starts_with("//") && !st.starts_with("}") && !head.starts_with("use ")
            if item {
                if open {
                    rs2nika_flush(cur, cur_method, cur_ind, free, meth)
                }
                cur = []
                for p in pending {
                    cur.push(p.clone())
                }
                pending = []
                cur.push(l.clone())
                cur_method = l.contains("(self") || l.contains("(ref self") || l.contains("(ref mut self")
                cur_ind = rs2nika_indent(l).len()
                open = true
            } else if st.starts_with("//") {
                pending.push(l.clone())
                continue
            } else {
                continue
            }
        } else {
            cur.push(l.clone())
        }
        depth = depth + rs2nika_depth_of(l)
        if depth < 0 {
            depth = 0
        }
    }
    if open {
        rs2nika_flush(cur, cur_method, cur_ind, free, meth)
    }
    let mut out: Vec[String] = ["use std::collections", ""]
    for x in free {
        out.push(x.clone())
    }
    if meth.len() > 0 {
        out.push(f"impl {state} {{")
        for x in meth {
            if x.trim() == "" {
                out.push("")
            } else {
                out.push(f"    {x}")
            }
        }
        let last = out.len() - 1
        out[last] = "}"
    }
    let joined = rs2nika_join(out, "\n")
    return f"{joined}\n"
}

/// One item of `rs2nika_as_file`, dedented, with a blank line after it.
fn rs2nika_flush(cur: ref Vec[String], method: bool, ind: i64, mut free: Vec[String], mut meth: Vec[String]) {
    let mut pad: String = ""
    while pad.len() < ind {
        pad.push_str(" ")
    }
    for x in cur {
        let mut y: String = x.trim_start().clone()
        if rs2nika_starts(x, pad) {
            y = (x.strip_prefix(pad) ?? "").clone()
        }
        if method {
            meth.push(y)
        } else {
            free.push(y)
        }
    }
    if method {
        meth.push("")
    } else {
        free.push("")
    }
}

/// Four spaces for each `if let` turned `match` that holds the current line;
/// `skip` leaves out that many of the innermost blocks.
fn rs2nika_shift(ctx: ref Rs2nikaCtx, skip: i64) -> String {
    let mut out: String = ""
    let mut k = 0
    while k + skip < ctx.stack_kind.len() {
        if ctx.stack_kind[k].starts_with("iflet") || ctx.stack_kind[k] == "chain" {
            out.push_str("    ")
        }
        k = k + 1
    }
    return out
}

/// R207: an `impl` header at the left margin of a type other than the
/// state's (`impl Mark {`, `impl Code for Finding {`) opens `impl_other`;
/// the `}` at the margin closes it.
fn rs2nika_impl_track(mut ctx: Rs2nikaCtx, line: String) {
    if line.trim_end() == "}" {
        ctx.impl_other = false
        return
    }
    if !(line.starts_with("impl ") || line.starts_with("impl<")) || !line.trim_end().ends_with("{") {
        return
    }
    let name = rs2nika_impl_type(line)
    ctx.impl_other = ctx.profile != "none" && name != "Checker" && name != "Emitter"
    if ctx.impl_other {
        rs2nika_hit(ctx, "R207")
    }
}

/// R34: an `impl` header; `Checker`/`Emitter` become the state struct.
fn rs2nika_impl_head(mut ctx: Rs2nikaCtx, line: String) -> String {
    let st: String = line.trim().clone()
    if !(st.starts_with("impl ") || st.starts_with("impl<")) || !st.ends_with("{") || st.contains(" for ") {
        return ""
    }
    let mut rest: String = ((st.strip_prefix("impl") ?? "").strip_suffix("{") ?? "").trim().clone()
    if rest.starts_with("<") {
        let c: Vec[scalar] = rest.chars().collect()
        let close = rs2nika_closing(c, 0, '<', '>')
        if close < 0 {
            return ""
        }
        rest = (rest.bytes[close + 1..].text() catch { "" }).trim().clone()
    }
    let c: Vec[scalar] = rest.chars().collect()
    let mut e = 0
    while e < c.len() && rs2nika_word(c[e]) {
        e = e + 1
    }
    let mut name: String = rs2nika_text(c, 0, e)
    if name == "" {
        return ""
    }
    if ctx.profile != "none" && (name == "Checker" || name == "Emitter") {
        rs2nika_hit(ctx, "R34")
        if ctx.profile == "check" {
            name = "CheckState"
        } else {
            name = "EmitState"
        }
    }
    let ind = rs2nika_indent(line)
    return f"{ind}impl {name} {{"
}

/// The name a `fn` line declares, or "".
fn rs2nika_declared(line: String) -> String {
    let mut st: String = line.trim().clone()
    if st.starts_with("pub ") {
        st = (st.strip_prefix("pub ") ?? "").clone()
    }
    if !st.starts_with("fn ") {
        return ""
    }
    let c: Vec[scalar] = st.chars().collect()
    let mut e = 3
    while e < c.len() && rs2nika_word(c[e]) {
        e = e + 1
    }
    return rs2nika_text(c, 3, e)
}

/// R45-R47: what the repository already has in Nikaia, read from the tree:
/// the functions of tools/*.nika (with their doc comments, for `rs2nika_twins`),
/// the Rust aliases of moved types and the table rs2nika.names.
/// A Rust function whose whole body calls `nikaia_std::tools::m::g(..)` is
/// a thin adapter: its name is an equivalent of `g`, as in rs2nika.names.
fn rs2nika_thin_adapters(mut ctx: Rs2nikaCtx, text: String) {
    let lines: Vec[String] = text.lines().map(fn(l) { l.trim().clone() }).collect()
    let mut i = 0
    while i + 2 < lines.len() {
        let l: String = lines[i].clone()
        let pre = "nikaia_std::tools::"
        if (l.starts_with("fn ") || l.starts_with("pub fn ") || l.starts_with("pub(crate) fn ")) && l.ends_with("{") && lines[i + 1].starts_with(pre) && lines[i + 2] == "}" {
            let name = rs2nika_fn_name(l)
            let call: String = (lines[i + 1].strip_prefix(pre) ?? "").clone()
            let open = call.find("(") ?? 0
            let path: String = call[0..<open].clone()
            let cut = path.rfind("::") ?? path.len()
            if open > 0 && cut < path.len() {
                let g: String = path[cut + "::".len()..].clone()
                if name != "" && g != name {
                    // a call only: a local of the same name stays
                    ctx.equiv_from.push(f"{name}(")
                    ctx.equiv_to.push(f"{g}(")
                }
            }
        }
        i = i + 1
    }
}

/// R68: the number of parts of each tuple variant an `enum` of `text`
/// declares, kept as `Enum::V\tn` in `ctx.arity`.
fn rs2nika_enum_arity(mut ctx: Rs2nikaCtx, text: String) {
    let mut name: String = ""
    let mut depth = 0
    let mut variant: String = ""
    for l in text.split("\n") {
        let st: String = l.trim().clone()
        if st.starts_with("//") {
            continue
        }
        if name == "" {
            if (st.starts_with("pub enum ") || st.starts_with("enum ")) && st.ends_with("{") {
                let at = (st.find("enum ") ?? 0) + "enum ".len()
                let n: String = st[at..<st.len() - "{".len()].trim().clone()
                let gen = n.find("[") ?? n.len()
                let gen2 = n.find("<") ?? gen
                let cut = if gen2 < gen { gen2 } else { gen }
                name = n[0..<cut].clone()
                depth = 1
            }
            continue
        }
        if variant != "" {
            variant = f"{variant} {st}"
        } else if depth == 1 && st.len() > 0 && rs2nika_upper(st.chars().next() ?? ' ') && (st.find("(") ?? 999999) < (st.find("{") ?? 999999) {
            variant = st.clone()
        }
        if variant != "" && rs2nika_count(variant, '(') == rs2nika_count(variant, ')') {
            let open = variant.find("(") ?? 0
            let close = variant.rfind(")") ?? open
            let v: String = variant[0..<open].trim().clone()
            let inner: String = variant[open + "(".len()..<close].clone()
            let mut n = 0
            for part in rs2nika_split_args(inner) {
                if part.trim() != "" {
                    n = n + 1
                }
            }
            ctx.arity.push(f"{name}::{v}\t{n}")
            variant = ""
        }
        depth = depth + rs2nika_count(st, '{') - rs2nika_count(st, '}')
        if depth <= 0 {
            name = ""
            variant = ""
        }
    }
}

/// R68: a positional rest `V(a, ..)` and a slice pattern pass through
/// (ADR-355 D3); Rust's named rest `rest @ ..` is written `..rest` (D2).
fn rs2nika_rest(mut ctx: Rs2nikaCtx, given: String) -> String {
    if !given.contains(" @ ..") {
        return given.clone()
    }
    let c: Vec[scalar] = given.chars().collect()
    let mut out: String = ""
    let mut at = 0
    while at < c.len() {
        if at + 5 <= c.len() && rs2nika_text(c, at, at + 5) == " @ .." && at > 0 && rs2nika_word(c[at - 1]) {
            let o: Vec[scalar] = out.chars().collect()
            let mut k = o.len()
            while k > 0 && rs2nika_word(o[k - 1]) {
                k = k - 1
            }
            let name: String = rs2nika_text(o, k, o.len())
            let head: String = rs2nika_text(o, 0, k)
            out = f"{head}..{name}"
            rs2nika_hit(ctx, "R68")
            at = at + 5
            continue
        }
        out.push(c[at])
        at = at + 1
    }
    return out
}

/// R69: a Rust name that Nikaia reserves (`grammar`, `throws`, ..) -> `name_`.
fn rs2nika_reserved(mut ctx: Rs2nikaCtx, given: String) -> String {
    let mut s: String = given.clone()
    if given.trim_start().starts_with("//") {
        return s
    }
    for w in ["catch", "comptime", "dsl", "grammar", "null", "overlap", "select", "spawn", "sync", "throw", "throws", "with"] {
        if !s.contains(ref w) {
            continue
        }
        // a field of a struct pattern or literal keeps its name; its binding
        // is renamed (`{ grammar }` -> `{ grammar: grammar_ }`)
        let mut held: String = s.clone()
        if rs2nika_fn_name(s) == "" {
            held = held.replace(f"{{ {w}: ", f"{{ zzfieldzz{w}: ").replace(f", {w}: ", f", zzfieldzz{w}: ")
            held = held.replace(f"{{ {w} }}", f"{{ zzfieldzz{w}: {w} }}").replace(f"{{ {w}, ", f"{{ zzfieldzz{w}: {w}, ").replace(f", {w} }}", f", zzfieldzz{w}: {w} }}")
        }
        let renamed: String = rs2nika_replace_name(held, w, f"{w}_").replace("zzfieldzz", "")
        let mut t: String = renamed.replace(f"{w}_(", f"{w}(").replace(f"{w}_!", f"{w}!").replace(f"{w}_::", f"{w}::")
        t = t.replace(f"{{{w}}}", f"{{{w}_}}").replace(f"{{{w}:", f"{{{w}_:")
        if !rs2nika_same(t, s) {
            rs2nika_hit(ctx, "R69")
        }
        s = t.clone()
    }
    return s
}

fn rs2nika_load(mut ctx: Rs2nikaCtx, repo: String) {
    let tools: String = f"{repo}/crates/nikaia-std/src/tools"
    let files = fs::walk(tools, fs::Root::Anywhere) catch {
        return
    }
    let mut maybe: collections::BTreeSet[String] = collections::BTreeSet()
    let mut sure: collections::BTreeSet[String] = collections::BTreeSet()
    for name in files {
        if !name.ends_with(".nika") {
            continue
        }
        let text = fs::read_to_string(f"{tools}/{name}", fs::Root::Anywhere) catch {
            continue
        }
        rs2nika_enum_arity(ctx, text)
        let file = name.to_text() catch {
            continue
        }
        let mut doc: String = ""
        for l in text.split("\n") {
            let st: String = l.trim().clone()
            if l.starts_with("///") {
                if doc == "" {
                    doc = (st.strip_prefix("///") ?? "").trim().clone()
                }
            } else if l.starts_with("fn ") || l.starts_with("pub fn ") {
                let n = rs2nika_declared(l)
                ctx.tool_fns.insert(n.clone())
                ctx.tool_names.push(n)
                ctx.tool_docs.push(doc.clone())
                ctx.tool_files.push(file.clone())
                doc = ""
            } else if !st.starts_with("#[") {
                doc = ""
            }
            // R205: a field line `[pub ]name: T[?],`
            let field: String = if st.starts_with("pub ") { (st.strip_prefix("pub ") ?? "").clone() } else { st.clone() }
            let (fname, fty) = field.split_once(": ") ?? continue
            if fname != "" && fname.chars().all(fn(ch) { rs2nika_word(ch) }) && fty.ends_with(",") && !fty.contains("(") {
                if fty.trim_end_matches(",").ends_with("?") {
                    maybe.insert(fname.clone())
                } else {
                    sure.insert(fname.clone())
                }
            }
        }
    }
    for fname in maybe {
        if !sure.contains(fname) {
            ctx.field_opts.insert(fname.clone())
        }
    }
    let src: String = f"{repo}/crates/nikaia/src"
    let rust = fs::walk(src, fs::Root::Anywhere) catch {
        return
    }
    for name in rust {
        if !name.ends_with(".rs") {
            continue
        }
        let text = fs::read_to_string(f"{src}/{name}", fs::Root::Anywhere) catch {
            continue
        }
        rs2nika_thin_adapters(ctx, text)
        let mut rest: String = text.clone()
        while true {
            let at = rest.find("use nikaia_std::tools::") ?? break
            let tail: String = rest[at..<rest.len()].clone()
            let whole = tail.len()
            let end = tail.find(";") ?? whole
            let u: String = tail[0..<end].replace("{", " ").replace("}", " ").replace(",", " ").replace("\n", " ")
            let mut toks: Vec[String] = []
            for t in u.split(" ") {
                if t != "" {
                    toks.push(t.clone())
                }
            }
            let mut i = 1
            while i + 1 < toks.len() {
                if toks[i] == "as" {
                    let a: String = toks[i - 1].clone()
                    let cut = a.rfind("::") ?? a.len()
                    let mut short: String = a.clone()
                    if cut < a.len() {
                        short = a[cut + "::".len()..].clone()
                    }
                    ctx.alias_from.push(toks[i + 1].clone())
                    ctx.alias_to.push(short)
                }
                i = i + 1
            }
            rest = tail[end..<tail.len()].clone()
        }
    }
    let table = fs::read_to_string(f"{repo}/crates/rs2nika/convert/rs2nika.names", fs::Root::Anywhere) catch {
        return
    }
    for l in table.split("\n") {
        // a `[section]` is another rule's table
        if l.starts_with("[") {
            break
        }
        if l.trim() == "" || l.starts_with("#") {
            continue
        }
        let mut parts: Vec[String] = []
        for p in l.split_whitespace() {
            parts.push(p.clone())
        }
        if parts.len() >= 2 {
            ctx.equiv_from.push(parts[0].clone())
            ctx.equiv_to.push(parts[1].clone())
        }
    }
}

/// The functions the draft calls that neither it nor tools/*.nika declares.
fn rs2nika_missing(ctx: ref Rs2nikaCtx, draft: String) -> Vec[String] {
    let mut own: collections::BTreeSet[String] = collections::BTreeSet()
    for l in draft.split("\n") {
        let n = rs2nika_declared(l)
        if n != "" {
            own.insert(n)
        }
        // a lambda's parameters (`fn(want) {..}`) are called, not missing
        for part in l.split("fn(") {
            let close = part.find(")") ?? continue
            for p in part[0..<close].split(",") {
                let mut name: String = p.trim().clone()
                let colon = name.find(":") ?? name.len()
                name = name[0..<colon].trim().clone()
                if rs2nika_is_path(name) {
                    own.insert(name)
                }
            }
        }
    }
    for k in ["fn", "if", "match", "while", "for", "return", "panic", "println", "sync", "f", "in", "and", "or", "not"] {
        own.insert(k.clone())
    }
    let mut found: collections::BTreeSet[String] = collections::BTreeSet()
    for l in draft.split("\n") {
        let c: Vec[scalar] = rs2nika_blank(l).chars().collect()
        let mut at = 0
        while at < c.len() {
            if rs2nika_lower(c[at]) && (at == 0 || !(rs2nika_path_char(c[at - 1]) || c[at - 1] == '.')) {
                let mut e = at
                while e < c.len() && rs2nika_word(c[e]) {
                    e = e + 1
                }
                let n: String = rs2nika_text(c, at, e)
                if e < c.len() && c[e] == '(' && !own.contains(n) && !ctx.tool_fns.contains(n) {
                    found.insert(n)
                }
                at = e
            } else {
                at = at + 1
            }
        }
    }
    let mut out: Vec[String] = []
    for n in found {
        out.push(n.clone())
    }
    return out
}

/// Functions of the input that tools/*.nika may have already: the same name,
/// the same name with the prefix, or the same first doc line.
fn rs2nika_twins(ctx: ref Rs2nikaCtx, src: String) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut doc: String = ""
    for l in src.split("\n") {
        let st: String = l.trim().clone()
        if st.starts_with("///") {
            if doc == "" {
                doc = (st.strip_prefix("///") ?? "").trim().clone()
            }
            continue
        }
        if st.starts_with("#[") {
            continue
        }
        let name = rs2nika_fn_name(l)
        if name != "" {
            let pre: String = ctx.prefix.clone()
            // A method's bare name is no clash: tools/*.nika's free functions
            // share one namespace, the methods of a state struct do not.
            let method = rs2nika_takes_self(l)
            let mut k = 0
            while k < ctx.tool_names.len() {
                let t: String = ctx.tool_names[k].clone()
                let mut why: String = ""
                if (t == name && !method) || (pre != "" && t == f"{pre}{name}") {
                    why = "the same name"
                } else if doc != "" && ctx.tool_docs[k] == doc {
                    why = "the same doc comment"
                }
                if why != "" {
                    let file: String = ctx.tool_files[k].clone()
                    out.push(f"`{name}` may be in Nikaia already: tools/{file} `fn {t}` ({why})")
                }
                k = k + 1
            }
        }
        doc = ""
    }
    return out
}

/// The lint messages one line of hand-written Nikaia earns (strings emptied).
pub fn rs2nika_lint_line(code: String, params: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = []
    let c: Vec[scalar] = code.chars().collect()
    let get = code.find(".get(") ?? code.len()
    if get < code.len() && code[get..<code.len()].contains(")?.clone()") {
        out.push("D2: `m.get(k)?.clone()` lowers to a clone of a reference; write `m[k]?.clone()`")
    }
    if code.contains(".len() as i64") {
        out.push("D7: `.len()` is already `i64`; the cast is doubled (clippy unnecessary_cast)")
    }
    let g = code.find("get(") ?? code.len()
    if (g < code.len() && code[g..<code.len()].contains(" as i64)")) || code.contains(" as i64]") {
        out.push("D8: a cast inside a map read lowers as `&x as i64`; bind `let k = x as i64` first")
    }
    let arrow = code.find("=>") ?? code.len()
    if arrow < code.len() {
        let after: Vec[scalar] = code[arrow + "=>".len()..<code.len()].trim_start().chars().collect()
        let mut e = 0
        while e < after.len() && (rs2nika_word(after[e]) || after[e] == '.') {
            e = e + 1
        }
        let run = rs2nika_text(after, 0, e)
        if e < after.len() && after[e] == '(' && run.ends_with(".insert") && run.len() > 7 {
            out.push("D3: `insert` as an arm value yields `bool` against `()`; write `=> { let _added = s.insert(..) }`")
        }
    }
    let w = code.find(" with {") ?? -1
    if w > 0 {
        let mut b = w
        while b > 0 && rs2nika_word(c[b - 1]) {
            b = b - 1
        }
        let x = rs2nika_text(c, b, w)
        if x != "self" && params.contains(x) {
            out.push("D1: `p with {..}` on a by-value parameter writes `..p` of a `&T`; on a parameter write the struct literal in full")
        }
    }
    let arm: String = code.trim_start().clone()
    if arm.starts_with("Some(") && (arm.contains(") =>") || arm.contains(") if ")) {
        out.push("NK2704: `Some(x) =>` is not a pattern of a `T?`; write `x =>`, with `null =>` beside it (ADR-352 D5)")
    }
    if arm.starts_with("None =>") || arm.starts_with("None if ") {
        out.push("NK2705: `None =>` is not a pattern of a `T?`; write `null =>` (ADR-352 D5)")
    }
    if code.contains("\".to_string()") || code.contains("\".clone()") {
        out.push("NK1301: a text literal takes no `.to_string()` and no `.clone()`; write the literal")
    }
    if code.contains(".to_owned()") {
        out.push("NK1189: `.to_owned()` is `.clone()`")
    }
    if rs2nika_replace_word(code, "if let", "@") != code {
        out.push("no `if let`: `x ?? return`, or `if x != null` then `x ?? panic(..)`")
    }
    let mut star = false
    let mut k = 0
    while k + 1 < c.len() {
        if c[k] == '*' && rs2nika_lower(c[k + 1]) && (k == 0 || !(rs2nika_word(c[k - 1]) || c[k - 1] == ')' || c[k - 1] == ']' || c[k - 1] == ' ' || c[k - 1] == '\t')) {
            star = true
        }
        k = k + 1
    }
    if star {
        out.push("no `*x`")
    }
    if rs2nika_replace_word(code, "if match", "@") != code {
        out.push("a `match` in a guard or condition needs parentheses: `if (match ..)`")
    }
    return out
}

/// `--lint FILE.nika`: the known lowering defects and syntax gaps in
/// hand-written Nikaia, before a lower-std; how many it found.
pub fn rs2nika_lint(path: String, text: String) -> i64 {
    let mut n = 0
    let mut params: Vec[String] = []
    let mut in_str = false
    let mut no = 0
    for l in text.split("\n") {
        no = no + 1
        let was = in_str
        let c: Vec[scalar] = l.chars().collect()
        let mut quotes = 0
        let mut k = 0
        while k < c.len() {
            if c[k] == '"' && (k == 0 || c[k - 1] != '\\') {
                quotes = quotes + 1
            }
            k = k + 1
        }
        if quotes % 2 == 1 {
            in_str = !in_str
        }
        if was || l.trim().starts_with("//") {
            continue
        }
        if rs2nika_declared(l) != "" {
            params = []
            let open = l.find("(") ?? l.len()
            let close = l.rfind(")") ?? 0
            if open < l.len() && close > open {
                for p in l[open + "(".len()..<close].split(",") {
                    let mut q: String = p.trim().clone()
                    if q.starts_with("mut ") {
                        q = (q.strip_prefix("mut ") ?? "").clone()
                    }
                    let colon = q.find(": ") ?? 0
                    if colon > 0 && !q[colon + ": ".len()..<q.len()].starts_with("ref") {
                        let pn: String = q[0..<colon].clone()
                        params.push(pn)
                    }
                }
            }
        }
        let code = rs2nika_blank(l)
        for m in rs2nika_lint_line(code, params) {
            println(f"{path}:{no}: {m}")
            n = n + 1
        }
    }
    return n
}

/// The checkout the names come from: the first of `.` and its parents that
/// holds `crates/nikaia-std/src/tools`, or "".
fn rs2nika_find_repo() -> String {
    let parents = [".", "..", "../..", "../../..", "../../../..", "../../../../..", "../../../../../.."]
    for d in parents {
        let there = fs::exists(f"{d}/crates/nikaia-std/src/tools", fs::Root::Anywhere) catch {
            false
        }
        if there {
            return d.clone()
        }
    }
    return ""
}

/// `--only NAME`: the function `NAME` of `text` with its doc comments and
/// attributes, the other lines blanked so that line numbers (and `--facts`)
/// still fit; "" when there is none.
fn rs2nika_only(text: String, name: String) -> String {
    let lines: Vec[String] = text.lines().map(fn(l) { l.clone() }).collect()
    let mut start = -1
    let mut i = 0
    while i < lines.len() {
        let t: String = lines[i].trim_start().trim_start_matches("pub(crate) ").trim_start_matches("pub ").clone()
        let call: String = f"fn {name}("
        let generic: String = f"fn {name}<"
        if t.starts_with(ref call) || t.starts_with(ref generic) {
            start = i
            break
        }
        i = i + 1
    }
    if start < 0 {
        return ""
    }
    let mut first = start
    while first > 0 && (lines[first - 1].trim().starts_with("///") || lines[first - 1].trim().starts_with("#[")) {
        first = first - 1
    }
    let mut last = start
    let mut depth = 0
    let mut opened = false
    while last < lines.len() {
        depth = depth + rs2nika_depth_of(lines[last])
        if lines[last].contains("{") {
            opened = true
        }
        if opened && depth <= 0 {
            break
        }
        last = last + 1
    }
    let mut out: String = ""
    let mut k = 0
    while k < lines.len() {
        if k >= first && k <= last {
            out.push_str(lines[k])
        }
        out.push_str("\n")
        k = k + 1
    }
    return out
}

/// The `local` facts of `facts` (the output of `../facts`) on the file
/// `path`, each as `<line>\t<type>`; none without a facts file.
fn rs2nika_read_facts(facts: String, path: String) -> Vec[String] {
    let mut out: Vec[String] = []
    if facts == "" {
        return out
    }
    let text = fs::read_to_string(ref facts, fs::Root::Anywhere) catch {
        eprintln(f"cannot read {facts}: {error}")
        return out
    }
    for line in text.lines() {
        let cols: Vec[String] = line.split("\t").map(fn(c) { c.clone() }).collect()
        if cols.len() < 4 || cols[2] != "local" {
            continue
        }
        let file: String = cols[0].clone()
        if !(path.ends_with(ref file) || file.ends_with(path)) {
            continue
        }
        let colon = cols[1].find(":") ?? 0
        let at: String = cols[1][0..<colon].clone()
        let ty: String = cols[3].clone()
        out.push(f"{at}\t{ty}")
    }
    return out
}

// The score of a draft against the file a person made of it (#802): the lines
// of FINAL that the draft already had, and the kinds of line that were written
// by hand. A blank line, a comment and a line of only closing brackets do not
// count: they are in every file.
fn rs2nika_scored(line: String) -> String {
    let t: String = line.trim().clone()
    if t == "" || t.starts_with("//") || t == "}" || t == "{" || t == ")" || t == "]" || t == "})" || t == "}," || t == ")," {
        return ""
    }
    return t
}

fn rs2nika_edit_kind(t: String) -> String {
    if t.contains("catch") {
        return "catch"
    }
    if t.contains("??") {
        return "?? default"
    }
    if t.contains("ref ") {
        return "ref"
    }
    if t.contains(".clone()") {
        return ".clone()"
    }
    if t.starts_with("fn ") || t.starts_with("pub fn ") {
        return "signature"
    }
    if t.starts_with("let ") {
        return "let"
    }
    if t.starts_with("return") {
        return "return"
    }
    if t.starts_with("match ") || t.starts_with("if ") || t.starts_with("} else") || t.starts_with("for ") || t.starts_with("while ") {
        return "control flow"
    }
    if t.contains("f\"") {
        return "format string"
    }
    return "other"
}

// kept lines, all lines, and the kind of every line written by hand.
pub struct Rs2nikaScore {
    kept: i64,
    total: i64,
    kinds: Vec[String]
}

pub fn rs2nika_score(draft: String, fin: String) -> Rs2nikaScore {
    let mut have: Vec[String] = []
    for l in draft.lines() {
        let t = rs2nika_scored(l)
        if t != "" {
            have.push(t)
        }
    }
    let mut used: Vec[bool] = []
    for _h in have.clone() {
        used.push(false)
    }
    let mut kept = 0
    let mut total = 0
    let mut kinds: Vec[String] = []
    for l in fin.lines() {
        let t = rs2nika_scored(l)
        if t == "" {
            continue
        }
        total = total + 1
        let mut found = false
        let mut i = 0
        while i < have.len() && !found {
            if !used[i] && have[i] == t {
                used[i] = true
                found = true
            }
            i = i + 1
        }
        if found {
            kept = kept + 1
        } else {
            kinds.push(rs2nika_edit_kind(t))
        }
    }
    return Rs2nikaScore { kept: kept, total: total, kinds: kinds }
}

// `name floor profile prefix` per line of DIR/manifest; each NAME/ holds
// before.rs (the Rust before the move, from git history) and after.nika (the
// committed result). Fails when a score falls under its floor: a rule that
// lowered it.
fn rs2nika_corpus(dir: String) -> i64 {
    let manifest = fs::read_to_string(f"{dir}/manifest", fs::Root::Anywhere) catch {
        eprintln(f"cannot read {dir}/manifest: {error}")
        return 1
    }
    let mut bad = 0
    for line in manifest.lines() {
        let cols: Vec[String] = line.split(" ").map(fn(c) { c.clone() }).collect()
        if cols.len() < 3 {
            continue
        }
        let name: String = cols[0].clone()
        let floor: i64 = text::parse_i64(cols[1].clone()) ?? 0
        let mut prefix: String = ""
        if cols.len() > 3 {
            prefix = cols[3].clone()
        }
        let before = fs::read_to_string(f"{dir}/{name}/before.rs", fs::Root::Anywhere) catch {
            eprintln(f"cannot read {dir}/{name}/before.rs: {error}")
            return 1
        }
        let after = fs::read_to_string(f"{dir}/{name}/after.nika", fs::Root::Anywhere) catch {
            eprintln(f"cannot read {dir}/{name}/after.nika: {error}")
            return 1
        }
        let out = rs2nika_convert(before, cols[2], prefix, "", [])
        let s = rs2nika_score(out.text, after)
        println(f"{name}: kept {s.kept} of {s.total} lines")
        if s.kept < floor {
            println(f"{name}: below its floor {floor}")
            bad = bad + 1
        }
    }
    return bad
}

fn main() throws {
    let mut profile: String = "check"
    let mut view = false
    let mut prefix: String = ""
    let mut stats = false
    let mut whole = false
    let mut lint = false
    let mut score = false
    let mut corpus: String = ""
    let mut repo: String = "?"
    let mut facts_path: String = ""
    let mut only: String = ""
    let mut path: String = ""
    let mut lints: Vec[String] = []
    let mut args: Vec[String] = []
    for a in cli::args() {
        args.push(a)
    }
    let mut at = 1
    while true {
        if at >= args.len() {
            break
        }
        let arg: String = args[at].clone()
        if arg == "--rules" {
            for line in rs2nika_rules() {
                println(line)
            }
            return
        } else if arg == "--stats" {
            stats = true
        } else if arg == "--file" {
            whole = true
        } else if arg == "--lint" {
            lint = true
        } else if arg == "--score" {
            score = true
        } else if arg == "--view" {
            view = true
        } else if arg == "--corpus" {
            at = at + 1
            corpus = args[at].clone()
        } else if arg == "--profile" {
            at = at + 1
            profile = args[at].clone()
        } else if arg == "--prefix" {
            at = at + 1
            prefix = args[at].clone()
        } else if arg == "--only" {
            at = at + 1
            only = args[at].clone()
        } else if arg == "--facts" {
            at = at + 1
            facts_path = args[at].clone()
        } else if arg == "--repo" {
            at = at + 1
            repo = args[at].clone()
        } else if lint || score {
            lints.push(arg)
        } else {
            path = arg
        }
        at = at + 1
    }
    if corpus != "" {
        let bad = rs2nika_corpus(corpus)
        if bad > 0 {
            process::exit(1)
        }
        return
    }
    if score {
        if lints.len() != 2 {
            eprintln("usage: rs2nika --score DRAFT FINAL")
            process::exit(2)
        }
        let draft = fs::read_to_string(ref lints[0], fs::Root::Anywhere) catch {
            eprintln(f"cannot read {lints[0]}: {error}")
            return
        }
        let fin = fs::read_to_string(ref lints[1], fs::Root::Anywhere) catch {
            eprintln(f"cannot read {lints[1]}: {error}")
            return
        }
        let s = rs2nika_score(draft, fin)
        println(f"kept {s.kept} of {s.total} lines")
        let kinds: Vec[String] = s.kinds.clone()
        print(rs2nika_stats(kinds))
        return
    }
    if lint {
        let mut n = 0
        for f in lints {
            let text = fs::read_to_string(ref f, fs::Root::Anywhere) catch {
                eprintln(f"cannot read {f}: {error}")
                return
            }
            n = n + rs2nika_lint(f, text)
        }
        if n > 0 {
            eprintln(f"{n} findings")
            process::exit(1)
        }
        return
    }
    if profile != "check" && profile != "emit" && profile != "none" && profile != "check-free" && profile != "emit-free" {
        eprintln(f"`--profile` is `check`, `emit`, `none`, `check-free` or `emit-free`, not `{profile}`")
        return
    }
    // R177: `--view` rides on the profile as `+view` (`emit+view-free`)
    if view && profile.ends_with("-free") {
        profile = f"{profile[0..<profile.len() - "-free".len()]}+view-free"
    } else if view {
        profile = f"{profile}+view"
    }
    if repo == "?" {
        repo = rs2nika_find_repo()
    }
    let mut text = fs::read_to_string(ref path, fs::Root::Anywhere) catch {
        eprintln(f"cannot read {path}: {error}")
        return
    }
    if only != "" {
        text = rs2nika_only(text, only)
        if text == "" {
            eprintln(f"no function `{only}` in {path}")
            process::exit(1)
        }
    }
    let out = rs2nika_convert(text, profile, prefix, repo, rs2nika_read_facts(facts_path, path))
    if whole {
        let mut state: String = "State"
        if profile == "check" {
            state = "CheckState"
        } else if profile == "emit" {
            state = "EmitState"
        }
        print(rs2nika_as_file(out.text, state))
    } else {
        println(out.text)
    }
    for t in out.twins {
        eprintln(f"// rs2nika: {t}")
    }
    if out.missing.len() > 0 {
        let names = rs2nika_join(out.missing, ", ")
        eprintln(f"// rs2nika: called but not in Nikaia yet (move them first, or name the equivalent in rs2nika.names): {names}")
    }
    if stats {
        eprintln(rs2nika_stats(out.hits))
    }
}
