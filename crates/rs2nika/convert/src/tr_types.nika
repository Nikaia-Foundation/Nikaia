// crates/rs2nika/convert/src/tr_types.nika
//
// **Types, patterns and literals** of the syntax-tree converter: Rust's
// `Vec<T>` is `Vec[T]`, `Option<T>` is `T?`, `usize` is `i64`, `char` is
// `scalar`; a pattern's `Some(p)` is `p` and its `None` is `null` (ADR-352);
// ranges move to Nikaia's spelling (`a..b` includes `b`, `a..<b` does not).

use std::collections

/// Rust's integer types Nikaia writes as `i64` (R10).
fn tr_wide_int(name: String) -> bool {
    return name == "usize" || name == "isize" || name == "u16" || name == "i16" || name == "i8"
}

/// A Rust literal's text with its escapes, as a Nikaia text literal.
fn tr_raw_string(text: String) -> String {
    // r"..", r#".."#: no escapes inside; Nikaia's literal escapes `\` and `"`
    let open = text.find("\"") ?? 0
    let mut hashes = open - 1
    if hashes < 0 {
        hashes = 0
    }
    let body: String = text.bytes[open + 1..<text.len() - 1 - hashes].text() catch { "" }
    let esc = body.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
    return f"\"{esc}\""
}

/// A Rust text literal without its line continuations: a `\\` at a line's
/// end drops the line break and the next line's leading blanks.
fn tr_continued(text: String) -> String {
    if !text.contains("\\\n") {
        return text
    }
    let parts: Vec[String] = text.split("\n").map(fn(p) { p.to_string() }).collect()
    let mut out: String = ""
    let mut glued = false
    for p in parts {
        let piece: String = if glued { p.trim_start().to_string() } else { p.clone() }
        if out != "" && !glued {
            out.push_str("\n")
        }
        glued = piece.ends_with("\\") && !piece.ends_with("\\\\")
        if glued {
            out.push_str(piece.bytes[0..<piece.len() - 1].text() catch { "" })
        } else {
            out.push_str(piece)
        }
    }
    return out
}

impl TrEm {
    pub fn ty(ref mut self, n: i64) -> String {
        let kind = self.t.kind(n)
        if kind == "PATH_TYPE" {
            return self.path_ty(n)
        } else if kind == "REF_TYPE" || kind == "PAREN_TYPE" || kind == "PTR_TYPE" {
            let inner = self.referent(n)
            if self.t.is(inner, "SLICE_TYPE") {
                return f"Vec[{self.ty(self.t.nth(inner, 0))}]"
            }
            if kind == "PTR_TYPE" {
                return self.todo("a raw pointer", n)
            }
            return self.ty(inner)
        } else if kind == "SLICE_TYPE" {
            return f"Vec[{self.ty(self.t.nth(n, 0))}]"
        } else if kind == "ARRAY_TYPE" {
            let parts = self.nodes(n)
            return f"Array[{self.ty(parts[0])}, {self.expr(parts[1])}]"
        } else if kind == "TUPLE_TYPE" {
            let mut parts: Vec[String] = []
            for k in self.nodes(n) {
                parts.push(self.ty(k))
            }
            if parts.len() == 0 {
                return "()"
            }
            return f"({parts.join(", ")})"
        } else if kind == "FN_PTR_TYPE" {
            return self.fn_ty(self.t.kid(n, "PARAM_LIST"), self.t.kid(n, "RET_TYPE"))
        } else if kind == "IMPL_TRAIT_TYPE" || kind == "DYN_TRAIT_TYPE" {
            return self.bound_ty(n)
        } else if kind == "INFER_TYPE" {
            return "_"
        } else if kind == "NEVER_TYPE" {
            return self.todo("the never type", n)
        }
        return self.todo("a type", n)
    }

    /// `fn(A, B) -> R` from a parameter list and a result.
    fn fn_ty(ref mut self, params: i64, ret: i64) -> String {
        let mut ps: Vec[String] = []
        for p in self.t.kids_of(params, "PARAM") {
            let pt = self.param_type_node(p)
            ps.push(self.ty(pt))
        }
        let mut out = f"fn({ps.join(", ")})"
        if ret >= 0 {
            let r = self.ty(self.t.nth(ret, 0))
            if r != "()" {
                out = f"{out} -> {r}"
            }
        }
        return out
    }

    /// The type node of a `PARAM`: its last child node that is not its pattern.
    fn param_type_node(ref self, p: i64) -> i64 {
        let ns = self.nodes(p)
        if ns.len() == 0 {
            return -1
        }
        return ns[ns.len() - 1]
    }

    /// `impl Fn(A) -> B` / `dyn Fn(..)` -> `fn(A) -> B`; `impl Iterator<Item =
    /// T>` -> `Vec[T]` (R197).
    fn bound_ty(ref mut self, n: i64) -> String {
        let bl = self.t.kid(n, "TYPE_BOUND_LIST")
        for b in self.t.kids_of(bl, "TYPE_BOUND") {
            let pt = self.t.kid(b, "PATH_TYPE")
            let name = self.last_seg(pt)
            if name == "Fn" || name == "FnMut" || name == "FnOnce" {
                let p = self.t.find(pt, "PATH")
                let seg = self.t.kid(p, "PATH_SEGMENT")
                let pl = self.t.kid(seg, "PARENTHESIZED_ARG_LIST")
                let mut ps: Vec[String] = []
                for a in self.nodes(pl) {
                    // a borrowed parameter stays borrowed: `&str` -> `ref String`
                    let at = self.t.nth(a, 0)
                    let pt_text = self.ty(at)
                    let plain = pt_text == "i64" || pt_text == "f64" || pt_text == "bool" || pt_text == "scalar" || pt_text.starts_with("ref ")
                    if self.t.is(at, "REF_TYPE") && !self.t.has_tok(at, "MUT_KW") && !plain {
                        ps.push(f"ref {pt_text}")
                    } else {
                        ps.push(pt_text)
                    }
                }
                let mut out = f"fn({ps.join(", ")})"
                let ret = self.t.kid(seg, "RET_TYPE")
                if ret >= 0 {
                    let r = self.ty(self.t.nth(ret, 0))
                    if r != "()" {
                        out = f"{out} -> {r}"
                    }
                }
                // a tools file's function parameters say their lambda does not pause
                if self.profile != "none" && self.profile != "" {
                    out = f"{out} sync"
                }
                return out
            }
            if name == "Iterator" || name == "IntoIterator" || name == "DoubleEndedIterator" {
                for a in self.gen_args(pt) {
                    if self.t.is(a, "ASSOC_TYPE_ARG") {
                        let at = self.nodes(a)
                        return f"Vec[{self.ty(at[at.len() - 1])}]"
                    }
                }
            }
        }
        return self.todo("a trait object or `impl Trait`", n)
    }

    fn path_ty(ref mut self, n: i64) -> String {
        let name = self.last_seg(n)
        let mut args: Vec[String] = []
        for a in self.gen_args(n) {
            if self.t.is(a, "TYPE_ARG") {
                args.push(self.ty(self.t.nth(a, 0)))
            } else if self.t.is(a, "CONST_ARG") {
                args.push(self.expr(self.t.nth(a, 0)))
            }
        }
        if tr_wide_int(name) {
            return "i64"
        }
        if name == "char" {
            return "scalar"
        }
        if name == "str" || name == "String" || name == "Cow" || name == "OsString" || name == "OsStr" {
            return "String"
        }
        // `std::path`'s paths are `fs::Path`, a list of bytes `Bytes`
        if name == "Path" || name == "PathBuf" {
            self.uses.insert("fs")
            return "fs::Path"
        }
        if name == "Vec" && args.len() == 1 && args[0] == "u8" {
            return "Bytes"
        }
        if name == "Self" && self.self_ty != "" {
            return self.self_ty.clone()
        }
        if (name == "Box" || name == "Rc" || name == "Arc" || name == "RefCell" || name == "Cell") && args.len() == 1 {
            return args[0].clone()
        }
        if name == "Option" && args.len() == 1 {
            return f"{args[0]}?"
        }
        if name == "HashMap" || name == "BTreeMap" || name == "HashSet" || name == "BTreeSet" || name == "VecDeque" || name == "BinaryHeap" {
            self.uses.insert("collections")
            if args.len() == 0 {
                return f"collections::{name}"
            }
            return f"collections::{name}[{args.join(", ")}]"
        }
        let segs = self.segs(n)
        let mut path = name.clone()
        if segs.len() > 1 && segs[0] != "std" && segs[0] != "crate" && segs[0] != "self" && segs[0] != "super" && segs[0] != "core" && segs[0] != "alloc" {
            path = segs.join("::")
        }
        if args.len() == 0 {
            return path
        }
        return f"{path}[{args.join(", ")}]"
    }

    /// The type a reference refers to, past its lifetime: `&'a T` -> `T`.
    fn referent(ref self, n: i64) -> i64 {
        for k in self.nodes(n) {
            if !self.t.is(k, "LIFETIME") {
                return k
            }
        }
        return -1
    }

    /// The type of a parameter: `&mut T` lends it changeable (`mut x: T`, R3),
    /// `&T` as `ref T` unless it is copied anyway (a number, a text, R4).
    fn param_ty(ref mut self, n: i64) -> (String, bool) {
        if self.t.is(n, "REF_TYPE") {
            let inner = self.referent(n)
            let t = self.ty(n)
            if self.t.has_tok(n, "MUT_KW") {
                return (t, true)
            }
            if t == "String" || t == "i64" || t == "i32" || t == "u8" || t == "u32" || t == "u64" || t == "f64" || t == "f32" || t == "bool" || t == "scalar" || t.ends_with("?") || self.t.is(inner, "FN_PTR_TYPE") || self.t.is(inner, "DYN_TRAIT_TYPE") || self.t.is(inner, "IMPL_TRAIT_TYPE") {
                return (t, false)
            }
            return (f"ref {t}", false)
        }
        return (self.ty(n), false)
    }

    // ---- patterns ----

    pub fn pat(ref mut self, n: i64) -> String {
        let kind = self.t.kind(n)
        if kind == "IDENT_PAT" {
            let name = self.t.name_of(n)
            if name == "None" {
                return "null"
            }
            let sub = self.t.nth(n, 1)
            if sub >= 0 {
                // `x @ P`: no `@` in Nikaia (R202)
                return self.todo("a binding `x @ P`", n)
            }
            return tr_ident(name)
        } else if kind == "WILDCARD_PAT" {
            return "_"
        } else if kind == "REST_PAT" {
            return ".."
        } else if kind == "LITERAL_PAT" {
            let inner = self.t.nth(n, 0)
            let neg = self.t.has_tok(n, "MINUS")
            let l = self.lit(inner)
            if neg {
                return f"-{l}"
            }
            return l
        } else if kind == "TUPLE_STRUCT_PAT" {
            let path = self.path_text(self.t.kid(n, "PATH"))
            let mut parts: Vec[String] = []
            for k in self.nodes(n) {
                if !self.t.is(k, "PATH") {
                    parts.push(self.pat(k))
                }
            }
            if path == "Some" && parts.len() == 1 {
                return parts[0].clone()
            }
            return f"{path}({parts.join(", ")})"
        } else if kind == "RECORD_PAT" {
            let path = self.path_text(self.t.kid(n, "PATH"))
            let list = self.t.kid(n, "RECORD_PAT_FIELD_LIST")
            let mut parts: Vec[String] = []
            for f in self.nodes(list) {
                if self.t.is(f, "REST_PAT") {
                    parts.push("..")
                    continue
                }
                let nr = self.t.kid(f, "NAME_REF")
                let p = self.nodes(f)
                if nr >= 0 && p.len() > 1 {
                    let fp = self.pat(p[p.len() - 1])
                    let field = self.src(nr)
                    if fp == field {
                        parts.push(field.clone())
                    } else {
                        parts.push(f"{field}: {fp}")
                    }
                } else if p.len() > 0 {
                    parts.push(self.pat(p[p.len() - 1]))
                }
            }
            return f"{path} {{ {parts.join(", ")} }}"
        } else if kind == "TUPLE_PAT" {
            let mut parts: Vec[String] = []
            for k in self.nodes(n) {
                parts.push(self.pat(k))
            }
            return f"({parts.join(", ")})"
        } else if kind == "SLICE_PAT" {
            let mut parts: Vec[String] = []
            for k in self.nodes(n) {
                if self.t.is(k, "IDENT_PAT") && self.t.nth(k, 1) >= 0 && self.t.is(self.t.nth(k, 1), "REST_PAT") {
                    parts.push(f"..{self.t.name_of(k)}")
                } else {
                    parts.push(self.pat(k))
                }
            }
            return f"[{parts.join(", ")}]"
        } else if kind == "PATH_PAT" {
            let p = self.path_text(self.t.kid(n, "PATH"))
            if p == "None" {
                return "null"
            }
            return p
        } else if kind == "OR_PAT" {
            let mut parts: Vec[String] = []
            for k in self.nodes(n) {
                parts.push(self.pat(k))
            }
            return parts.join(" | ")
        } else if kind == "REF_PAT" || kind == "BOX_PAT" {
            return self.pat(self.t.nth(n, 0))
        } else if kind == "PAREN_PAT" {
            return f"({self.pat(self.t.nth(n, 0))})"
        } else if kind == "RANGE_PAT" {
            let ps = self.nodes(n)
            let incl = self.t.has_tok(n, "DOT2EQ") || self.t.has_tok(n, "DOT3")
            let mut lo: String = ""
            let mut hi: String = ""
            let mut seen_op = false
            for k in self.t.nodes[n].kids.clone() {
                let kk = self.t.kind(k)
                if kk == "DOT2" || kk == "DOT2EQ" || kk == "DOT3" {
                    seen_op = true
                } else if !self.t.nodes[k].tok {
                    if seen_op {
                        hi = self.pat(k)
                    } else {
                        lo = self.pat(k)
                    }
                }
            }
            if ps.len() == 0 {
                return ".."
            }
            if incl {
                return f"{lo}..{hi}"
            }
            return f"{lo}..<{hi}"
        } else if kind == "CONST_BLOCK_PAT" || kind == "MACRO_PAT" {
            return self.todo("a pattern", n)
        }
        return self.todo("a pattern", n)
    }

    /// Whether a pattern can fail: a name or `_` cannot.
    fn refutable(ref self, n: i64) -> bool {
        let kind = self.t.kind(n)
        if kind == "IDENT_PAT" {
            return self.t.name_of(n) == "None" || self.t.nth(n, 1) >= 0
        }
        if kind == "WILDCARD_PAT" || kind == "REST_PAT" {
            return false
        }
        if kind == "TUPLE_PAT" || kind == "PAREN_PAT" || kind == "REF_PAT" || kind == "BOX_PAT" {
            for k in self.nodes(n) {
                if self.refutable(k) {
                    return true
                }
            }
            return false
        }
        return true
    }

    /// Whether a pattern is `Some(..)`.
    fn is_some_pat(ref self, n: i64) -> bool {
        return self.t.is(n, "TUPLE_STRUCT_PAT") && self.last_seg(self.t.kid(n, "PATH")) == "Some"
    }

    /// Whether a pattern is `None`.
    fn is_none_pat(ref self, n: i64) -> bool {
        return (self.t.is(n, "IDENT_PAT") || self.t.is(n, "PATH_PAT")) && self.src(n) == "None"
    }

    /// The names a pattern binds, in order.
    fn bound_names(ref self, n: i64) -> Vec[String] {
        let mut out: Vec[String] = []
        self.collect_names(n, out)
        return out
    }

    fn collect_names(ref self, n: i64, mut out: Vec[String]) {
        let kind = self.t.kind(n)
        if kind == "IDENT_PAT" {
            let name = self.t.name_of(n)
            if name != "None" && name != "" {
                out.push(tr_ident(name))
            }
        } else if kind == "RECORD_PAT_FIELD" && self.nodes(n).len() == 1 && self.t.is(self.nodes(n)[0], "IDENT_PAT") {
            out.push(tr_ident(self.t.name_of(self.nodes(n)[0])))
            return
        }
        for k in self.nodes(n) {
            if !self.t.is(k, "PATH") {
                self.collect_names(k, out)
            }
        }
    }

    /// A path as Nikaia writes it: `Self` is the type, `crate::`/`self::`/
    /// `super::` and `std::` prefixes go (one namespace), `Some`/`None` stay
    /// for the caller to read.
    fn path_text(ref self, n: i64) -> String {
        let segs = self.segs(n)
        let mut out: Vec[String] = []
        for i in 0..<segs.len() {
            let s = segs[i].clone()
            if i < segs.len() - 1 && (s == "crate" || s == "self" || s == "super" || s == "std" || s == "core") {
                continue
            }
            if s == "Self" && self.self_ty != "" {
                out.push(self.self_ty.clone())
            } else {
                out.push(s)
            }
        }
        if out.len() >= 2 && out[0] != "" {
            // `collections::HashMap` / `cmp::Ordering`: a std module keeps one segment
            let first = out[0].clone()
            if first == "collections" || first == "cmp" || first == "fmt" || first == "io" || first == "mem" || first == "iter" || first == "str" || first == "string" || first == "vec" || first == "char" || first == "num" || first == "ops" || first == "convert" {
                if first == "collections" {
                    return out.join("::")
                }
                out.remove(0)
            }
        }
        return out.join("::")
    }

    // ---- literals ----

    pub fn lit(ref mut self, n: i64) -> String {
        let mut tok = n
        if self.t.is(n, "LITERAL") {
            let ks = self.t.nodes[n].kids.clone()
            tok = ks[0]
        }
        let kind = self.t.kind(tok)
        let text = self.t.text(tok)
        if kind == "INT_NUMBER" || kind == "FLOAT_NUMBER" {
            for suf in ["usize", "isize", "i64", "i32", "u16", "i16", "i8", "u8", "u32", "u64", "f64", "f32", "u128", "i128"] {
                if text.ends_with(suf) && !(text.starts_with("0x") && (suf == "f64" || suf == "f32")) {
                    let num: String = text.bytes[0..<text.len() - suf.len()].text() catch { "" }
                    let num2: String = tr_drop_suffix(num.clone(), "_")
                    if tr_wide_int(suf) || suf == "i32" {
                        return num2
                    }
                    if suf == "f64" && num2.contains(".") {
                        return num2
                    }
                    return f"({num2} as {suf})"
                }
            }
            return text
        } else if kind == "STRING" {
            if text.starts_with("r") {
                return tr_raw_string(text)
            }
            return tr_continued(text)
        } else if kind == "BYTE" {
            let inner: String = text.bytes[2..<text.len() - 1].text() catch { "" }
            return tr_byte_value(inner)
        } else if kind == "BYTE_STRING" {
            if text.starts_with("br") {
                let raw: String = text.bytes[1..<text.len()].text() catch { "" }
                return f"{tr_raw_string(raw)}.bytes"
            }
            let body: String = text.bytes[1..<text.len()].text() catch { "" }
            return f"{body}.bytes"
        } else if kind == "C_STRING" {
            return self.todo("a C string", n)
        }
        // CHAR, TRUE_KW, FALSE_KW
        return text
    }
}

/// The number of a byte literal's body: `a` -> 97, `\n` -> 10 (R57).
fn tr_byte_value(inner: String) -> String {
    if inner == "\\n" {
        return "10"
    } else if inner == "\\t" {
        return "9"
    } else if inner == "\\r" {
        return "13"
    } else if inner == "\\0" {
        return "0"
    } else if inner == "\\\\" {
        return "92"
    } else if inner == "\\'" {
        return "39"
    } else if inner == "\\\"" {
        return "34"
    } else if inner.starts_with("\\x") {
        let hex: String = inner.bytes[2..<inner.len()].text() catch { "" }
        return f"0x{hex}"
    }
    for c in inner.scalars {
        return f"{c as i64}"
    }
    return "0"
}

/// A Rust name Nikaia reserves gets a `_` (R69).
fn tr_ident(name: String) -> String {
    let n = tr_drop_prefix(name.clone(), "r#")
    if n == "grammar" || n == "throws" || n == "with" || n == "comptime" || n == "null" || n == "scalar" || n == "sync" || n == "overlap" || n == "spawn" || n == "rule" || n == "view" || n == "catch" || n == "throw" || n == "jump" || n == "par" {
        return f"{n}_"
    }
    return n
}
