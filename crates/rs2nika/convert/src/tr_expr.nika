// crates/rs2nika/convert/src/tr_expr.nika
//
// **Expressions** of the syntax-tree converter. An expression is written on
// one line where it can; a closure with a block, an `if` or a `match` used as
// a value spans lines, its inner lines indented from `self.ind`, the
// statement's own. What a value needs written before it (a `format!` hole
// holding a literal) goes to `self.pre` as a `let hole_N`.

use std::collections
use std::text

/// The methods that make or extend an iterator: a chain through one of them
/// is a `Seq`, not an option.
fn tr_iter_method(m: String) -> bool {
    return m == "iter" || m == "into_iter" || m == "chars" || m == "bytes" || m == "keys" || m == "values" || m == "lines" || m == "split" || m == "split_whitespace" || m == "map" || m == "filter" || m == "rev" || m == "zip" || m == "skip" || m == "take" || m == "chain" || m == "enumerate" || m == "windows" || m == "chunks" || m == "filter_map" || m == "flat_map" || m == "step_by" || m == "take_while" || m == "skip_while" || m == "char_indices" || m == "drain" || m == "peekable" || m == "cloned" || m == "copied" || m == "scalars" || m == "splitn" || m == "rsplit" || m == "split_terminator" || m == "inspect"
}

/// The methods whose answer is an option.
fn tr_option_method(m: String) -> bool {
    return m == "get" || m == "pop" || m == "first" || m == "last" || m == "next" || m == "find" || m == "position" || m == "max" || m == "min" || m == "max_by_key" || m == "min_by_key" || m == "max_by" || m == "min_by" || m == "strip_prefix" || m == "strip_suffix" || m == "checked_add" || m == "checked_sub" || m == "checked_mul" || m == "checked_div" || m == "rfind" || m == "find_map" || m == "nth" || m == "get_mut" || m == "remove_entry" || m == "split_once" || m == "rsplit_once" || m == "to_digit" || m == "last_mut" || m == "first_mut" || m == "pop_front" || m == "pop_back" || m == "front" || m == "back" || m == "peek" || m == "rposition" || m == "char_indices_next"
}

impl TrEm {
    pub fn expr(ref mut self, n: i64) -> String {
        let kind = self.t.kind(n)
        if n < 0 {
            return ""
        }
        if kind == "LITERAL" {
            return self.lit(n)
        } else if kind == "PATH_EXPR" {
            return self.path_expr(n)
        } else if kind == "PAREN_EXPR" {
            return f"({self.expr(self.t.nth(n, 0))})"
        } else if kind == "BIN_EXPR" {
            return self.bin(n)
        } else if kind == "PREFIX_EXPR" {
            let inner = self.expr(self.t.nth(n, 0))
            if self.t.has_tok(n, "STAR") {
                return inner
            } else if self.t.has_tok(n, "BANG") {
                if inner.ends_with(" != null") || inner.ends_with(" == null") {
                    return f"!({inner})"
                }
                return f"!{inner}"
            }
            return f"-{inner}"
        } else if kind == "REF_EXPR" {
            return self.expr(self.t.nth(n, 0))
        } else if kind == "CAST_EXPR" {
            return self.cast(n)
        } else if kind == "CALL_EXPR" {
            return self.call(n)
        } else if kind == "METHOD_CALL_EXPR" {
            return self.method(n)
        } else if kind == "FIELD_EXPR" {
            let recv = self.expr(self.t.nth(n, 0))
            let nr = self.t.kid(n, "NAME_REF")
            return f"{recv}.{self.src(nr)}"
        } else if kind == "INDEX_EXPR" {
            let parts = self.nodes(n)
            let base = self.expr(parts[0])
            if self.t.is(parts[1], "RANGE_EXPR") && self.nodes(parts[1]).len() == 0 {
                return base
            }
            return f"{base}[{self.expr(parts[1])}]"
        } else if kind == "RANGE_EXPR" {
            return self.range(n)
        } else if kind == "TUPLE_EXPR" {
            let mut parts: Vec[String] = []
            for k in self.nodes(n) {
                parts.push(self.expr(k))
            }
            if parts.len() == 1 {
                return f"({parts[0]},)"
            }
            return f"({parts.join(", ")})"
        } else if kind == "ARRAY_EXPR" {
            let ind = self.ind.clone()
            let wide = tr_opens_line(self.src(n)) && !self.t.has_tok(n, "SEMICOLON")
            if wide { self.ind = f"{ind}    " }
            let mut parts: Vec[String] = []
            for k in self.nodes(n) {
                parts.push(self.expr(k))
            }
            self.ind = ind.clone()
            if self.t.has_tok(n, "SEMICOLON") && parts.len() == 2 {
                return f"[{parts[0]}; {parts[1]}]"
            }
            let one = f"[{parts.join(", ")}]"
            if wide && parts.len() > 0 && ind.len() + one.len() > 100 {
                return f"[\n{ind}    {parts.join(f",\n{ind}    ")},\n{ind}]"
            }
            return one
        } else if kind == "RECORD_EXPR" {
            return self.record(n)
        } else if kind == "CLOSURE_EXPR" {
            return self.closure(n)
        } else if kind == "MACRO_EXPR" {
            return self.mac(self.t.kid(n, "MACRO_CALL"))
        } else if kind == "MACRO_CALL" {
            return self.mac(n)
        } else if kind == "RETURN_EXPR" {
            return self.ret(n)
        } else if kind == "BREAK_EXPR" {
            if self.nodes(n).len() > 0 || self.t.has_tok(n, "LIFETIME") || self.t.kid(n, "LIFETIME") >= 0 {
                return self.todo("`break` with a value or a label", n)
            }
            return "break"
        } else if kind == "CONTINUE_EXPR" {
            if self.t.kid(n, "LIFETIME") >= 0 {
                return self.todo("`continue` with a label", n)
            }
            return "continue"
        } else if kind == "TRY_EXPR" {
            let inner = self.expr(self.t.nth(n, 0))
            if self.fails {
                return inner
            } else if self.opt {
                return f"({inner} ?? return null)"
            }
            return self.todo("`?` in a function that hands back neither `Result` nor `Option`", n)
        } else if kind == "IF_EXPR" || kind == "MATCH_EXPR" || kind == "BLOCK_EXPR" || kind == "LOOP_EXPR" || kind == "WHILE_EXPR" || kind == "FOR_EXPR" {
            return self.flow_value(n)
        } else if kind == "UNDERSCORE_EXPR" {
            return "_"
        } else if kind == "AWAIT_EXPR" {
            return self.expr(self.t.nth(n, 0))
        }
        return self.todo("an expression", n)
    }

    /// A control-flow expression read as a value: its lines from the
    /// statement's indentation, the first one without it.
    /// A refusal's text as what is thrown: only an error can be (NK1161),
    /// and a tools file has std's `Refused::Because`; elsewhere the text.
    fn refusal(ref self, said: String) -> String {
        if self.profile == "none" || self.profile == "" {
            return said
        }
        return f"Refused::Because({said})"
    }

    fn flow_value(ref mut self, n: i64) -> String {
        let ind = self.ind.clone()
        let lines = self.flow(n, ind.clone(), "value")
        let text = lines.join("\n")
        return tr_drop_prefix(text, ind)
    }

    /// `X::default()` of a struct of this file, written out field by field:
    /// `X { a: [], b: collections::HashMap(), .. }`; "" where a field's type
    /// has no default the converter knows.
    fn default_of_struct(ref mut self, name: ref String) -> String {
        // an `impl Default` of its own is written as `impl X { fn default }`
        for im in self.t.kids_of(0, "IMPL") {
            let tys = self.t.kids_of(im, "PATH_TYPE")
            if self.t.has_tok(im, "FOR_KW") && tys.len() == 2 && self.last_seg(tys[0]) == "Default" && self.last_seg(tys[1]) == name {
                return f"{name}::default()"
            }
        }
        // `#[derive(Default)]` on an enum: the variant marked `#[default]`
        for en in self.t.kids_of(0, "ENUM") {
            if self.t.name_of(en) != name {
                continue
            }
            for v in self.t.kids_of(self.t.kid(en, "VARIANT_LIST"), "VARIANT") {
                for a in self.t.kids_of(v, "ATTR") {
                    if self.src(a) == "#[default]" {
                        return f"{name}::{self.t.name_of(v)}"
                    }
                }
            }
            return ""
        }
        for st in self.t.kids_of(0, "STRUCT") {
            if self.t.name_of(st) != name {
                continue
            }
            let list = self.t.kid(st, "RECORD_FIELD_LIST")
            let mut parts: Vec[String] = []
            for f in self.t.kids_of(list, "RECORD_FIELD") {
                let ty = self.ty(self.t.nth(f, self.nodes(f).len() - 1))
                let value = self.default_of(ty)
                if value == "" {
                    return ""
                }
                parts.push(f"{self.t.name_of(f)}: {value}")
            }
            return f"{name} {{ {parts.join(", ")} }}"
        }
        return ""
    }

    /// The type a value at `n` is written into, as Nikaia writes it: the
    /// field of a struct literal, or a `let` with its type; "" when unknown.
    fn expected_ty(ref mut self, n: i64) -> String {
        let up = self.t.nodes[n].parent
        if up >= 0 && self.t.is(up, "RECORD_EXPR_FIELD") {
            let rec = self.t.up(up, "RECORD_EXPR")
            let field = self.src(self.t.kid(up, "NAME_REF"))
            if rec >= 0 {
                return self.field_ty(self.last_seg(self.t.kid(rec, "PATH")), field)
            }
        }
        if up >= 0 && self.t.is(up, "LET_STMT") {
            for k in self.nodes(up) {
                if self.t.nodes[k].kind.ends_with("_TYPE") {
                    return self.ty(k)
                }
            }
        }
        return ""
    }

    /// The type of field `field` of struct `name` (any struct when `name`
    /// is ""), as Nikaia writes it, or "".
    fn field_ty(ref mut self, name: ref String, field: ref String) -> String {
        for i in 0..<self.t.nodes.len() {
            if self.t.nodes[i].kind != "STRUCT" || (name != "" && self.t.name_of(i) != name) {
                continue
            }
            for f in self.t.kids_of(self.t.kid(i, "RECORD_FIELD_LIST"), "RECORD_FIELD") {
                if self.t.name_of(f) == field {
                    return self.ty(self.t.nth(f, self.nodes(f).len() - 1))
                }
            }
        }
        return ""
    }

    /// The default of what the optional `n` holds, from the field or the
    /// function of this file it reads; "" when unknown.
    fn default_of_optional(ref mut self, n: i64) -> String {
        let mut at = n
        while self.t.is(at, "METHOD_CALL_EXPR") {
            let m = self.src(self.t.kid(at, "NAME_REF"))
            if m != "as_deref" && m != "as_ref" && m != "cloned" && m != "copied" && m != "clone" {
                break
            }
            at = self.nodes(at)[0]
        }
        let mut held: String = ""
        if self.t.is(at, "FIELD_EXPR") {
            held = self.field_ty("", self.src(self.t.kid(at, "NAME_REF")))
        }
        if self.t.is(at, "METHOD_CALL_EXPR") || self.t.is(at, "CALL_EXPR") {
            let name = if self.t.is(at, "CALL_EXPR") { self.last_seg(self.nodes(at)[0]) } else { self.src(self.t.kid(at, "NAME_REF")) }
            if name == "var" && self.src(self.nodes(at)[0]).ends_with("env::var") {
                return "\"\""
            }
            for i in 0..<self.t.nodes.len() {
                if self.t.nodes[i].kind == "FN" && self.t.name_of(i) == name {
                    let ret = self.t.kid(i, "RET_TYPE")
                    if ret >= 0 && self.nodes(ret).len() > 0 {
                        held = self.ty(self.nodes(ret)[0])
                    }
                    break
                }
            }
        }
        if !held.ends_with("?") {
            return ""
        }
        return self.default_of(held.trim_end_matches("?"))
    }

    /// The default value of a type as Nikaia writes it, or "".
    fn default_of(ref mut self, ty: ref String) -> String {
        if ty.ends_with("?") {
            return "null"
        }
        if ty == "String" {
            return "\"\""
        }
        if ty == "bool" {
            return "false"
        }
        if ty == "f64" || ty == "f32" {
            return "0.0"
        }
        if ty == "i64" || ty == "i32" || ty == "u8" || ty == "u32" || ty == "u64" {
            return "0"
        }
        if ty.starts_with("Vec[") {
            return "[]"
        }
        for c in ["HashMap", "HashSet", "BTreeMap", "BTreeSet"] {
            if ty.starts_with(f"collections::{c}[") {
                return f"collections::{c}()"
            }
        }
        return self.default_of_struct(ty)
    }

    fn path_expr(ref mut self, n: i64) -> String {
        let segs = self.segs(n)
        if segs.len() == 1 {
            let name = segs[0].clone()
            if name == "None" {
                return "null"
            }
            if name == "self" {
                return "self"
            }
            match self.aliases[name] {
                null => {},
                place => {
                    return place.clone()
                },
            }
            // a local or a parameter of that name is not the function
            if self.prefix != "" && self.fns.contains(name) && !self.binds(self.t.up(n, "FN"), name) {
                return tr_prefixed(self.prefix, name)
            }
            return tr_ident(name)
        }
        if segs.len() == 2 && tr_wide_int(segs[0]) {
            return f"i64::{segs[1]}"
        }
        return self.path_text(self.t.kid(n, "PATH"))
    }

    fn bin(ref mut self, n: i64) -> String {
        let parts = self.nodes(n)
        let mut op: String = ""
        let mut broken = false
        let mut gap = false
        for k in self.t.nodes[n].kids.clone() {
            let kind = self.t.kind(k)
            if kind == "WHITESPACE" {
                if self.t.text(k).contains("\n") {
                    gap = true
                }
            } else if self.t.nodes[k].tok && kind != "COMMENT" {
                op = self.t.text(k)
                broken = gap
            } else if kind != "COMMENT" {
                gap = false
            }
        }
        if parts.len() < 2 {
            return self.todo("an operator", n)
        }
        // `*m.entry(k).or_insert(d) += v` -> `m.insert(k, (m[k] ?? d) + v)`
        if op.ends_with("=") && op != "==" && op != "!=" && op != "<=" && op != ">=" {
            let lhs = parts[0]
            let entry = self.entry_or_insert(lhs)
            if entry.len() == 3 {
                let rhs = self.expr(parts[1])
                if op == "=" {
                    return f"{entry[0]}.insert({entry[1]}, {rhs})"
                }
                let bare: String = op.bytes[0..<op.len() - 1].text() catch { "" }
                return f"{entry[0]}.insert({entry[1]}, ({entry[0]}[{entry[1]}] ?? {entry[2]}) {bare} {rhs})"
            }
        }
        let a = self.expr(parts[0])
        let b = self.expr(parts[1])
        // The source broke the chain before the operator: keep the break.
        if broken {
            return f"{a}\n{self.ind}    {op} {b}"
        }
        return f"{a} {op} {b}"
    }

    /// `*m.entry(k).or_insert(d)` (also `or_default()`, `or_insert_with(..)`)
    /// -> [m, k, d]; [] otherwise.
    fn entry_or_insert(ref mut self, n: i64) -> Vec[String] {
        let mut at = n
        if self.t.is(at, "PREFIX_EXPR") && self.t.has_tok(at, "STAR") {
            at = self.t.nth(at, 0)
        }
        if !self.t.is(at, "METHOD_CALL_EXPR") {
            return []
        }
        let m = self.src(self.t.kid(at, "NAME_REF"))
        let inner = self.t.nth(at, 0)
        if !self.t.is(inner, "METHOD_CALL_EXPR") || self.src(self.t.kid(inner, "NAME_REF")) != "entry" {
            return []
        }
        let map = self.expr(self.t.nth(inner, 0))
        let key_args = self.nodes(self.t.kid(inner, "ARG_LIST"))
        if key_args.len() != 1 {
            return []
        }
        let key = self.expr(key_args[0])
        let args = self.nodes(self.t.kid(at, "ARG_LIST"))
        let mut d: String = "0"
        if m == "or_insert" && args.len() == 1 {
            d = self.expr(args[0])
        } else if m == "or_insert_with" && args.len() == 1 {
            d = self.default_of_ctor(args[0])
        } else if m != "or_default" {
            return []
        }
        return [map, key, d]
    }

    /// The value `or_insert_with(f)` makes: a closure's body, `Vec::new` -> `[]`.
    fn default_of_ctor(ref mut self, n: i64) -> String {
        if self.t.is(n, "CLOSURE_EXPR") {
            let ns = self.nodes(n)
            return self.expr(ns[ns.len() - 1])
        }
        let s = self.src(n)
        if s.ends_with("Vec::new") || s.ends_with("Default::default") {
            return "[]"
        }
        if s.ends_with("String::new") {
            return "\"\""
        }
        if s.contains("Map::new") || s.contains("Set::new") {
            let last = self.last_seg(n)
            self.uses.insert("collections")
            return f"collections::{self.segs(n)[0]}()"
        }
        return f"{self.expr(n)}()"
    }

    fn cast(ref mut self, n: i64) -> String {
        let parts = self.nodes(n)
        let e = self.expr(parts[0])
        let mut ty = self.ty(parts[1])
        if ty == "scalar" {
            return f"{e} as scalar"
        }
        // `xs.len() as usize`: a length is an `i64` already (R40)
        if ty == "i64" && self.t.is(parts[0], "METHOD_CALL_EXPR") {
            let m = self.src(self.t.kid(parts[0], "NAME_REF"))
            if m == "len" || m == "count" {
                return e
            }
        }
        return f"{e} as {ty}"
    }

    /// What the tree cannot write yet, marked. A call keeps its converted
    /// receiver and arguments and a macro is a call to `rs2nika_NAME`, so
    /// the draft still parses and the compiler points at each one; the Rust
    /// is in the comment.
    fn todo(ref mut self, what: String, n: i64) -> String {
        self.todos += 1
        let src = self.t.text(n).trim().replace("\n", " ").replace("*/", "* /")
        let kind = self.t.kind(n)
        if kind == "METHOD_CALL_EXPR" {
            let r = self.expr(self.t.nth(n, 0))
            let m = self.src(self.t.kid(n, "NAME_REF"))
            return f"{r}.{m}({self.args(n).join(", ")}) /* TODO(rs2nika): {what} */"
        }
        if kind == "CALL_EXPR" && self.t.is(self.t.nth(n, 0), "PATH_EXPR") {
            let callee = self.src(self.t.nth(n, 0)).replace(" ", "")
            if !callee.contains("<") {
                return f"{callee}({self.args(n).join(", ")}) /* TODO(rs2nika): {what} */"
            }
        }
        if kind == "MACRO_CALL" || kind == "MACRO_EXPR" {
            let mut mc = n
            if kind == "MACRO_EXPR" {
                mc = self.t.kid(n, "MACRO_CALL")
            }
            let name = self.last_seg(mc)
            let a = self.margs[mc] ?? -1
            let mut inner: String = ""
            if a >= 0 && self.t.is(a, "LITERAL") {
                inner = self.src(a)
            } else if src.ends_with("\")") && src.contains("!(\"") && src.split("\"").count() == 3 {
                // `env!("NAME")`: the one text it names
                inner = f"\"{src.split("\"").nth(1) ?? ""}\""
            }
            return f"rs2nika_{name}({inner}) /* TODO(rs2nika): {what}: `{src}` */"
        }
        return f"{src} /* TODO(rs2nika): {what} */"
    }

    fn args(ref mut self, n: i64) -> Vec[String] {
        let mut out: Vec[String] = []
        for a in self.nodes(self.t.kid(n, "ARG_LIST")) {
            out.push(self.expr(a))
        }
        return out
    }

    fn call(ref mut self, n: i64) -> String {
        let callee = self.t.nth(n, 0)
        let arg_nodes = self.nodes(self.t.kid(n, "ARG_LIST"))
        if !self.t.is(callee, "PATH_EXPR") {
            let f = self.expr(callee)
            return f"{f}({self.args(n).join(", ")})"
        }
        let segs = self.segs(callee)
        let last = segs[segs.len() - 1].clone()
        let first = segs[0].clone()
        let joined = segs.join("::")
        if segs.len() == 1 {
            if last == "Some" && arg_nodes.len() == 1 {
                return self.expr(arg_nodes[0])
            }
            if last == "Ok" && arg_nodes.len() == 1 {
                if self.src(arg_nodes[0]) == "()" {
                    return "()"
                }
                return self.expr(arg_nodes[0])
            }
            if last == "Err" && arg_nodes.len() == 1 {
                return f"throw {self.expr(arg_nodes[0])}"
            }
        }
        if segs.len() >= 2 {
            let owner = segs[segs.len() - 2].clone()
            if (owner == "Box" || owner == "Rc" || owner == "Arc" || owner == "RefCell" || owner == "Cell") && last == "new" && arg_nodes.len() == 1 {
                return self.expr(arg_nodes[0])
            }
            if owner == "String" && (last == "new" || last == "with_capacity") {
                return "\"\""
            }
            if owner == "String" && last == "from" && arg_nodes.len() == 1 {
                let a = self.expr(arg_nodes[0])
                if a.starts_with("\"") {
                    return a
                }
                return f"{a}.to_string()"
            }
            if owner == "Vec" && (last == "new" || last == "with_capacity") {
                return "[]"
            }
            if owner == "Vec" && last == "from" && arg_nodes.len() == 1 {
                return self.expr(arg_nodes[0])
            }
            if owner == "HashMap" || owner == "BTreeMap" || owner == "HashSet" || owner == "BTreeSet" || owner == "VecDeque" || owner == "BinaryHeap" {
                if last == "new" || last == "with_capacity" || last == "default" {
                    self.uses.insert("collections")
                    return f"collections::{owner}()"
                }
            }
            if (owner == "process" && last == "exit") || joined.ends_with("process::exit") {
                self.uses.insert("process")
                return f"process::exit({self.args(n).join(", ")})"
            }
            if owner == "String" && last == "from_utf8_lossy" && arg_nodes.len() == 1 {
                return f"({self.expr(arg_nodes[0])}.text() catch {{ \"\" }})"
            }
            if owner == "env" && last == "args" {
                self.uses.insert("cli")
                return "cli::args()"
            }
            if (owner == "cmp" || owner == "std") && (last == "max" || last == "min") && arg_nodes.len() == 2 {
                let a = self.expr(arg_nodes[0])
                let b = self.expr(arg_nodes[1])
                return f"{a}.{last}({b})"
            }
            if owner == "mem" && (last == "swap" || last == "replace" || last == "take") {
                return self.todo("`std::mem` moves values in place", n)
            }
            if (owner == "i64" || owner == "u64" || owner == "i32" || owner == "u32" || owner == "u8" || owner == "f64" || owner == "f32" || tr_wide_int(owner)) && last == "from" && arg_nodes.len() == 1 {
                let mut t = owner.clone()
                if tr_wide_int(owner) {
                    t = "i64"
                }
                return f"({self.expr(arg_nodes[0])} as {t})"
            }
            let mut ty = owner.clone()
            if ty == "Self" {
                ty = self.self_ty.clone()
            }
            if last == "new" && self.ctors.contains(ty) {
                return f"{ty}({self.args(n).join(", ")})"
            }
            if last == "default" && segs.len() == 2 {
                if ty == "Default" {
                    ty = self.expected_ty(n)
                }
                let written = self.default_of(ty)
                if written != "" {
                    return written
                }
                return self.todo("`Default` (write the value out)", n)
            }
        }
        let mut path = self.path_text(self.t.kid(callee, "PATH"))
        if segs.len() == 1 && self.prefix != "" && self.fns.contains(last) {
            path = tr_prefixed(self.prefix, last)
        } else if segs.len() == 1 {
            path = tr_ident(last)
        }
        return f"{path}({self.args(n).join(", ")})"
    }

    /// Whether the method chain ending in `n` runs through an iterator.
    fn iter_chain(ref self, n: i64) -> bool {
        let mut at = n
        while self.t.is(at, "METHOD_CALL_EXPR") {
            let m = self.src(self.t.kid(at, "NAME_REF"))
            if tr_iter_method(m) {
                return true
            }
            at = self.t.nth(at, 0)
        }
        return false
    }

    /// Whether `n` reads as an option: a name declared `Option`, a method that
    /// hands one back, `Some(..)` / `None`.
    fn optional_expr(ref self, n: i64) -> bool {
        if self.t.is(n, "METHOD_CALL_EXPR") {
            let m = self.src(self.t.kid(n, "NAME_REF"))
            if m == "cloned" || m == "copied" || m == "as_ref" || m == "as_deref" || m == "as_mut" || m == "take" {
                return self.optional_expr(self.t.nth(n, 0))
            }
            return tr_option_method(m) || m == "map" && !self.iter_chain(self.t.nth(n, 0)) && self.optional_expr(self.t.nth(n, 0))
        }
        if self.t.is(n, "PATH_EXPR") || self.t.is(n, "FIELD_EXPR") {
            let s = self.src(n)
            if s == "None" {
                return true
            }
            let mut name = s.clone()
            if self.t.is(n, "FIELD_EXPR") {
                name = self.src(self.t.kid(n, "NAME_REF")).clone()
            }
            return self.optional.contains(name)
        }
        if self.t.is(n, "REF_EXPR") || self.t.is(n, "PAREN_EXPR") || self.t.is(n, "PREFIX_EXPR") {
            return self.optional_expr(self.t.nth(n, 0))
        }
        return false
    }

    /// A closure argument's one parameter and body, for an option's
    /// combinators: `|x| e` (or `|x| { e }`) -> ("x", "e"); ("", "") when it is
    /// not one.
    fn closure_parts(ref mut self, c: i64) -> (String, String) {
        if !self.t.is(c, "CLOSURE_EXPR") {
            return ("", "")
        }
        let params = self.t.kids_of(self.t.kid(c, "PARAM_LIST"), "PARAM")
        let ns = self.nodes(c)
        let mut body = ns[ns.len() - 1]
        if self.t.is(body, "BLOCK_EXPR") {
            // `|| { e }`, a block that is only its value, is `|| e`
            let inner = self.nodes(self.t.kid(body, "STMT_LIST"))
            if inner.len() != 1 || self.t.is(inner[0], "LET_STMT") || self.t.is(inner[0], "EXPR_STMT") {
                return ("", "")
            }
            body = inner[0]
        }
        if params.len() > 1 {
            return ("", "")
        }
        let mut p: String = "_"
        if params.len() == 1 {
            p = self.pat(self.t.nth(params[0], 0))
        }
        return (p, self.expr(body))
    }

    fn method(ref mut self, n: i64) -> String {
        let recv_n = self.t.nth(n, 0)
        let m = self.src(self.t.kid(n, "NAME_REF"))
        let arg_nodes = self.nodes(self.t.kid(n, "ARG_LIST"))
        let turbofish = self.t.kid(n, "GENERIC_ARG_LIST")
        let mut r = self.expr(recv_n)
        if r.ends_with(" != null") || r.ends_with(" == null") {
            r = f"({r})"
        }
        let a = self.args(n)
        let al = a.join(", ")
        if m == "chars" && a.len() == 0 {
            return f"{r}.scalars"
        }
        if (m == "bytes" || m == "as_bytes") && a.len() == 0 {
            return f"{r}.bytes"
        }
        if (m == "as_str" || m == "as_ref" || m == "as_mut" || m == "borrow" || m == "borrow_mut" || m == "as_slice" || m == "as_deref" || m == "as_mut_slice" || m == "by_ref" || m == "into" || m == "as_path" || m == "into_owned") && a.len() == 0 {
            return r
        }
        // anyhow's `.context(m)` / `.with_context(|| m)` after a call that
        // answers an option: `(o ?? throw m)` (`bail!`'s refusal)
        if (m == "context" || m == "with_context") && a.len() == 1 && self.t.is(recv_n, "METHOD_CALL_EXPR") {
            let inner = self.src(self.t.kid(recv_n, "NAME_REF"))
            if ["file_name", "file_stem", "extension", "parent", "first", "last", "get", "next", "pop", "find", "position", "split_once", "rsplit_once", "strip_prefix", "strip_suffix"].contains(inner) {
                let mut said: String = a[0].clone()
                if m == "with_context" {
                    let (p, body) = self.closure_parts(arg_nodes[0])
                    if p != "_" {
                        return f"{r}.{m}({al})"
                    }
                    said = body
                }
                return f"({r} ?? throw {self.refusal(said)})"
            }
        }
        // a path's text: `p.to_string_lossy()` -> `p.display()`
        if m == "to_string_lossy" && a.len() == 0 {
            return f"{r}.display()"
        }
        if (m == "to_owned" || m == "to_vec") && a.len() == 0 {
            if r.starts_with("\"") {
                return r
            }
            return f"{r}.clone()"
        }
        if m == "to_string" && r.starts_with("\"") && a.len() == 0 {
            return r
        }
        // R183: a text parameter is a text already
        if (m == "to_string" || m == "to_owned") && a.len() == 0 && self.texts.contains(r) {
            return r
        }
        // `text::parse_i64` hands back an option already
        if m == "ok" && a.len() == 0 && r.starts_with("text::parse_") {
            return r
        }
        if m == "into_iter" && a.len() == 0 {
            return f"{r}.iter()"
        }
        // `fs::Path` has neither `to_path_buf` nor `file_stem` nor `as_os_str`
        if m == "to_path_buf" && a.len() == 0 {
            return f"{r}.clone()"
        }
        if m == "file_stem" && a.len() == 0 {
            return f"{r}.with_extension(\"\").file_name()"
        }
        if m == "as_os_str" && a.len() == 0 {
            return f"{r}.display()"
        }
        // `o.is_some_and(|w| e)` read as a value: `(match o { null => false, w => e })`
        if (m == "is_some_and" || m == "is_none_or") && a.len() == 1 {
            let (p, body) = self.closure_parts(arg_nodes[0])
            if body != "" && !body.contains("\n") {
                let absent = if m == "is_some_and" { "false" } else { "true" }
                let mut base = recv_n
                while self.t.is(base, "METHOD_CALL_EXPR") && self.nodes(self.t.kid(base, "ARG_LIST")).len() == 0 {
                    let inner = self.src(self.t.kid(base, "NAME_REF"))
                    if inner != "as_ref" && inner != "as_deref" && inner != "as_mut" {
                        break
                    }
                    base = self.t.nth(base, 0)
                }
                return f"(match {self.expr(base)} {{ null => {absent}, {p} => {body} }})"
            }
        }
        if m == "iter_mut" {
            return self.todo("`iter_mut` (index the list: `for i in 0..<xs.len()`)", n)
        }
        if m == "unwrap" && a.len() == 0 {
            if self.t.is(recv_n, "METHOD_CALL_EXPR") && self.src(self.t.kid(recv_n, "NAME_REF")) == "parse" {
                return f"({r} ?? panic(\"unwrap\"))"
            }
            return f"({r} ?? panic(\"unwrap\"))"
        }
        if m == "expect" && a.len() == 1 {
            return f"({r} ?? panic({a[0]}))"
        }
        // `o.or_else(|| p)` / `o.or(p)`: the other option where it is absent
        if m == "or_else" && a.len() == 1 {
            let (p, body) = self.closure_parts(arg_nodes[0])
            if p == "_" && self.nodes(self.t.kid(arg_nodes[0], "PARAM_LIST")).len() == 0 {
                return f"({r} ?? {body})"
            }
        }
        if m == "or" && a.len() == 1 && self.optional_expr(recv_n) {
            return f"({r} ?? {a[0]})"
        }
        if m == "unwrap_or" && a.len() == 1 {
            return f"({r} ?? {a[0]})"
        }
        if m == "unwrap_or_else" && a.len() == 1 {
            let (p, body) = self.closure_parts(arg_nodes[0])
            if p == "_" {
                return f"({r} ?? {body})"
            }
            if p != "" {
                return f"({r} catch {{ let {p} = error\n{self.ind}    {body} }})"
            }
            return f"({r} ?? {a[0]}())"
        }
        if m == "unwrap_or_default" && a.len() == 0 && (r.starts_with("fs::read_to_string(") || r.starts_with("fs::read(")) {
            let empty = if r.starts_with("fs::read(") { "[]" } else { "\"\"" }
            return f"({r} catch {{ {empty} }})"
        }
        if m == "unwrap_or_default" && a.len() == 0 {
            let empty = self.default_of_optional(recv_n)
            if empty != "" {
                return f"({r} ?? {empty})"
            }
            return self.todo("`unwrap_or_default` (write the default: `?? 0`, `?? \"\"`, `?? []`)", n)
        }
        // `c.then(|| v)` / `c.then_some(v)` -> `if c { v } else { null }`
        if (m == "then" || m == "then_some") && a.len() == 1 {
            let mut v: String = a[0].clone()
            if m == "then" {
                let (p, body) = self.closure_parts(arg_nodes[0])
                if p != "_" {
                    return f"{r}.{m}({al})"
                }
                v = body
            }
            let mut c: String = r.clone()
            if self.t.is(recv_n, "PAREN_EXPR") {
                c = self.expr(self.t.nth(recv_n, 0))
            }
            return f"(if {c} {{ {v} }} else {{ null }})"
        }
        if m == "is_some" && a.len() == 0 {
            return f"{r} != null"
        }
        // a parse hands back an option in Nikaia: `.is_ok()` asks for a value
        if (m == "is_ok" || m == "is_err") && a.len() == 0 && r.starts_with("text::parse_") {
            return if m == "is_ok" { f"{r} != null" } else { f"{r} == null" }
        }
        if m == "is_none" && a.len() == 0 {
            return f"{r} == null"
        }
        if (m == "ok_or" || m == "ok_or_else") && a.len() == 1 {
            let mut e = a[0].clone()
            if m == "ok_or_else" {
                let (p, body) = self.closure_parts(arg_nodes[0])
                if p == "_" {
                    e = body
                }
            }
            return f"({r} ?? throw {e})"
        }
        if m == "parse" && a.len() == 0 {
            self.uses.insert("text")
            let mut which: String = "i64"
            if turbofish >= 0 {
                let t = self.ty(self.t.nth(self.t.nth(turbofish, 0), 0))
                if t == "u64" || t == "u8" || t == "f64" {
                    which = t
                }
            }
            return f"text::parse_{which}({r})"
        }
        if (m == "collect" || m == "sum" || m == "product") && a.len() == 0 {
            return f"{r}.{m}()"
        }
        if m == "cloned" || m == "copied" {
            if self.iter_chain(recv_n) {
                if m == "copied" {
                    return r
                }
                return f"{r}.map(fn(x) {{ x.clone() }})"
            }
            return f"{r}?.clone()"
        }
        if self.optional_expr(recv_n) && !self.iter_chain(recv_n) {
            // an option's combinators (R79, R96): a `match` on it (ADR-352)
            if (m == "map" || m == "and_then" || m == "is_some_and" || m == "map_or" || m == "is_none_or" || m == "filter") && arg_nodes.len() >= 1 {
                let (p, body) = self.closure_parts(arg_nodes[arg_nodes.len() - 1])
                if p != "" && p != "_" {
                    let mut none: String = "null"
                    if m == "is_some_and" {
                        none = "false"
                    } else if m == "is_none_or" {
                        none = "true"
                    } else if m == "map_or" && a.len() == 2 {
                        none = a[0].clone()
                    }
                    if m == "filter" {
                        return f"(match {r} {{ {p} if {body} => {p}, else => null }})"
                    }
                    return f"(match {r} {{ {p} => {body}, null => {none} }})"
                }
            }
        }
        if (m == "find" || m == "rfind" || m == "replace" || m == "split" || m == "contains" || m == "starts_with" || m == "ends_with" || m == "trim_matches" || m == "trim_start_matches" || m == "trim_end_matches" || m == "strip_prefix" || m == "strip_suffix" || m == "split_once" || m == "rsplit" || m == "splitn" || m == "matches") && arg_nodes.len() >= 1 && !self.iter_chain(recv_n) {
            // a `char` needle is a text (R107)
            let mut fixed: Vec[String] = []
            for i in 0..<a.len() {
                let s = a[i].clone()
                if s.starts_with("'") && s.ends_with("'") {
                    let inner: String = s.bytes[1..<s.len() - 1].text() catch { "" }
                    let q = inner.replace("\"", "\\\"").replace("\\'", "'")
                    fixed.push(f"\"{q}\"")
                } else {
                    fixed.push(s)
                }
            }
            return f"{r}.{m}({fixed.join(", ")})"
        }
        if m == "sort_unstable" {
            return f"{r}.sort({al})"
        }
        if m == "sort_unstable_by" {
            return f"{r}.sort_by({al})"
        }
        if m == "sort_unstable_by_key" {
            return f"{r}.sort_by_key({al})"
        }
        return f"{r}.{m}({al})"
    }

    fn range(ref mut self, n: i64) -> String {
        let mut lo: String = ""
        let mut hi: String = ""
        let mut op: String = ""
        for k in self.t.nodes[n].kids.clone() {
            let kind = self.t.kind(k)
            if kind == "DOT2" || kind == "DOT2EQ" {
                op = kind
            } else if !self.t.nodes[k].tok {
                if op == "" {
                    lo = self.expr(k)
                } else {
                    hi = self.expr(k)
                }
            }
        }
        if hi == "" {
            return f"{lo}.."
        }
        if op == "DOT2EQ" {
            return f"{lo}..{hi}"
        }
        return f"{lo}..<{hi}"
    }

    fn record(ref mut self, n: i64) -> String {
        let path = self.path_text(self.t.kid(n, "PATH"))
        let list = self.t.kid(n, "RECORD_EXPR_FIELD_LIST")
        let ind = self.ind.clone()
        let wide = list >= 0 && tr_opens_line(self.src(list))
        if wide { self.ind = f"{ind}    " }
        let mut fields: Vec[String] = []
        let mut base: String = ""
        let mut after_dots = false
        for k in self.t.nodes[list].kids.clone() {
            let kind = self.t.kind(k)
            if kind == "DOT2" {
                after_dots = true
            } else if kind == "RECORD_EXPR_FIELD" {
                let nr = self.t.kid(k, "NAME_REF")
                let vals = self.nodes(k)
                let v = vals[vals.len() - 1]
                if nr >= 0 && vals.len() > 1 {
                    fields.push(f"{self.src(nr)}: {self.expr(v)}")
                } else if nr >= 0 && self.t.has_tok(k, "COLON") {
                    fields.push(f"{self.src(nr)}: {self.expr(v)}")
                } else {
                    // a shorthand whose name is written otherwise (a prefix,
                    // an alias) names its field
                    let e = self.expr(v)
                    let field = self.src(v)
                    if e == field {
                        fields.push(e)
                    } else {
                        fields.push(f"{field}: {e}")
                    }
                }
            } else if !self.t.nodes[k].tok && after_dots {
                base = self.expr(k)
            }
        }
        self.ind = ind.clone()
        if base != "" {
            if fields.len() == 0 {
                return f"{base}.clone()"
            }
            if wide && ind.len() + base.len() + fields.join(", ").len() > 92 {
                return f"{base} with {{\n{ind}    {fields.join(f",\n{ind}    ")},\n{ind}}}"
            }
            return f"{base} with {{ {fields.join(", ")} }}"
        }
        let one = f"{path} {{ {fields.join(", ")} }}"
        if wide && fields.len() > 0 && ind.len() + one.len() > 100 {
            return f"{path} {{\n{ind}    {fields.join(f",\n{ind}    ")},\n{ind}}}"
        }
        return one
    }

    fn closure(ref mut self, n: i64) -> String {
        let mut ps: Vec[String] = []
        for p in self.t.kids_of(self.t.kid(n, "PARAM_LIST"), "PARAM") {
            let written = self.pat(self.t.nth(p, 0))
            ps.push(if written == "()" { "_" } else { written })
        }
        let ns = self.nodes(n)
        let body = ns[ns.len() - 1]
        let head = f"fn({ps.join(", ")})"
        // `filter_map(|x| e?)`: the closure hands back an option
        let up = self.t.nodes[n].parent
        let called = if up >= 0 { self.t.nodes[up].parent } else { -1 }
        let by = if called >= 0 && self.t.is(called, "METHOD_CALL_EXPR") { self.src(self.t.kid(called, "NAME_REF")) } else { "" }
        if !self.t.is(body, "BLOCK_EXPR") && ["filter_map", "find_map", "and_then"].contains(by) && self.t.find(body, "TRY_EXPR") >= 0 {
            let saved_throws = self.fails
            let saved_opt = self.opt
            self.opt = true
            self.fails = false
            let e = self.expr(body)
            self.fails = saved_throws
            self.opt = saved_opt
            return f"{head} {{ {e} }}"
        }
        if self.t.is(body, "BLOCK_EXPR") {
            let ind = self.ind.clone()
            let saved_throws = self.fails
            let saved_opt = self.opt
            let saved_unit = self.unit
            let mut mode: String = "return"
            // a block that hands back `None` or `Some(..)` is an option's:
            // `?` in it is `?? return null`
            let text = self.src(body)
            if text.contains("return None") || (text.contains("Some(") && text.contains("?") && !text.contains("Ok(") && !text.contains("Err(")) {
                self.opt = true
                self.fails = false
            }
            if self.closure_unit(n, body) {
                mode = "stmt"
                self.unit = true
            } else {
                self.unit = false
            }
            let lines = self.block(body, f"{ind}    ", mode)
            self.fails = saved_throws
            self.opt = saved_opt
            self.unit = saved_unit
            if lines.len() == 0 {
                return f"{head} {{}}"
            }
            return f"{head} {{\n{lines.join("\n")}\n{ind}}}"
        }
        let e = self.expr(body)
        return f"{head} {{ {e} }}"
    }

    /// Whether a closure's block hands back nothing: no tail expression, or
    /// one that only does (`println!`, an assignment, a `push`), or it is
    /// handed to `for_each`.
    fn closure_unit(ref self, c: i64, body: i64) -> bool {
        let p = self.t.nodes[c].parent
        if self.t.is(p, "ARG_LIST") {
            let call = self.t.nodes[p].parent
            if self.t.is(call, "METHOD_CALL_EXPR") {
                let m = self.src(self.t.kid(call, "NAME_REF"))
                if m == "for_each" || m == "retain" && false {
                    return true
                }
            }
        }
        let list = self.t.kid(body, "STMT_LIST")
        let ns = self.nodes(list)
        if ns.len() == 0 {
            return true
        }
        let tail = ns[ns.len() - 1]
        let kind = self.t.kind(tail)
        if kind == "LET_STMT" || kind == "EXPR_STMT" || kind == "FOR_EXPR" || kind == "WHILE_EXPR" || kind == "LOOP_EXPR" {
            return true
        }
        if kind == "BIN_EXPR" {
            let op = self.t.toks(tail)
            if op.len() > 0 && op[0].ends_with("EQ") && op[0] != "EQ2" && op[0] != "NEQ" && op[0] != "LTEQ" && op[0] != "GTEQ" {
                return true
            }
        }
        if kind == "MACRO_EXPR" {
            let name = self.last_seg(self.t.kid(tail, "MACRO_CALL"))
            return name == "println" || name == "print" || name == "eprintln" || name == "eprint" || name == "write" || name == "writeln"
        }
        if kind == "METHOD_CALL_EXPR" {
            let m = self.src(self.t.kid(tail, "NAME_REF"))
            return m == "push" || m == "push_str" || m == "insert" || m == "extend" || m == "sort" || m == "clear"
        }
        return false
    }

    fn ret(ref mut self, n: i64) -> String {
        let inner = self.t.nth(n, 0)
        if inner < 0 {
            return "return"
        }
        if self.t.is(inner, "CALL_EXPR") {
            let segs = self.segs(self.t.nth(inner, 0))
            let args = self.nodes(self.t.kid(inner, "ARG_LIST"))
            if segs.len() == 1 && args.len() == 1 {
                if segs[0] == "Ok" && self.src(args[0]) == "()" {
                    return "return"
                }
                if segs[0] == "Err" {
                    return f"throw {self.expr(args[0])}"
                }
            }
        }
        return f"return {self.expr(inner)}"
    }

    // ---- macros ----

    fn mac(ref mut self, n: i64) -> String {
        let name = self.last_seg(n)
        let args_node = self.margs[n] ?? -1
        if args_node < 0 {
            return self.todo(f"the macro `{name}!`", n)
        }
        if name == "vec" {
            return self.expr(args_node)
        }
        if name == "matches" || name == "assert_matches" {
            let mut sn = self.t.nth(args_node, 0)
            if self.t.is(sn, "PAREN_EXPR") {
                sn = self.t.nth(sn, 0)
            }
            let subject = self.expr(sn)
            let arm = self.t.kid(self.t.kid(args_node, "MATCH_ARM_LIST"), "MATCH_ARM")
            let p = self.pat(self.t.nth(arm, 0))
            let guard = self.t.kid(arm, "MATCH_GUARD")
            let mut g: String = ""
            if guard >= 0 {
                g = f" if {self.expr(self.t.nth(guard, 0))}"
            }
            return f"(match {subject} {{ {p}{g} => true, else => false }})"
        }
        let args = self.nodes(args_node)
        if name == "assert" || name == "debug_assert" {
            if args.len() == 0 {
                return self.todo("an empty `assert!`", n)
            }
            let c = self.expr(args[0])
            if args.len() > 1 {
                let mut rest: Vec[i64] = []
                for i in 1..<args.len() {
                    rest.push(args[i])
                }
                return f"assert({c}; message: {self.fstring(rest)})"
            }
            return f"assert({c})"
        }
        if name == "assert_eq" || name == "assert_ne" || name == "debug_assert_eq" || name == "debug_assert_ne" {
            if args.len() < 2 {
                return self.todo("an `assert_eq!` without two values", n)
            }
            let mut op: String = "=="
            if name.ends_with("_ne") {
                op = "!="
            }
            let a = self.expr(args[0])
            let b = self.expr(args[1])
            if args.len() > 2 {
                let mut rest: Vec[i64] = []
                for i in 2..<args.len() {
                    rest.push(args[i])
                }
                return f"assert({a} {op} {b}; message: {self.fstring(rest)})"
            }
            return f"assert({a} {op} {b})"
        }
        if name == "todo" || name == "unimplemented" {
            return "panic(\"not yet implemented\")"
        }
        if name == "unreachable" {
            if args.len() == 0 {
                return "panic(\"internal error: entered unreachable code\")"
            }
            return f"panic({self.fstring(args)})"
        }
        if name == "panic" {
            if args.len() == 0 {
                return "panic(\"explicit panic\")"
            }
            return f"panic({self.fstring(args)})"
        }
        if name == "format" || name == "format_args" {
            return self.fstring(args)
        }
        // R181, R292: the emitters' refusals; R263: `bail!` / `anyhow!`
        if (name == "refused" || name == "refuse" || name == "bail" || name == "anyhow" || name == "format_err") && args.len() > 0 {
            let mut said = self.fstring(args)
            if name == "refused" || name == "refuse" {
                said = f"Refused::Because({said})"
            } else {
                said = self.refusal(said)
            }
            if name == "refuse" || name == "bail" {
                return f"throw {said}"
            }
            return said
        }
        if (name == "ensure") && args.len() > 1 {
            let mut rest: Vec[i64] = []
            for i in 1..<args.len() {
                rest.push(args[i])
            }
            return f"if !({self.expr(args[0])}) {{ throw {self.fstring(rest)} }}"
        }
        if name == "print" || name == "println" || name == "eprint" || name == "eprintln" {
            if args.len() == 0 {
                return f"{name}(\"\")"
            }
            return f"{name}({self.fstring(args)})"
        }
        if name == "write" || name == "writeln" {
            if args.len() == 0 {
                return self.todo("a `write!` without a target", n)
            }
            let target = self.expr(args[0])
            let mut rest: Vec[i64] = []
            for i in 1..<args.len() {
                rest.push(args[i])
            }
            let mut text: String = "\"\""
            if rest.len() > 0 {
                text = self.fstring(rest)
            }
            if name == "writeln" {
                if text.ends_with("\"") {
                    let body: String = text.bytes[0..<text.len() - 1].text() catch { "" }
                    text = f"{body}\\n\""
                }
            }
            return f"{target}.push_str({text})"
        }
        return self.todo(f"the macro `{name}!`", n)
    }

    /// A Rust format string and its arguments as a Nikaia text: `f"..{a}.."`
    /// (R15), a hole holding a text or a char literal hoisted as `hole_N`
    /// (R81); a format without holes is a plain literal.
    fn fstring(ref mut self, args: Vec[i64]) -> String {
        let fmt_n = args[0]
        if !self.t.is(fmt_n, "LITERAL") {
            return self.todo("a format string that is not a literal", fmt_n)
        }
        let mut lit_text = self.t.text(self.t.nodes[fmt_n].kids[0])
        if lit_text.starts_with("r") {
            lit_text = tr_raw_string(lit_text)
        }
        lit_text = tr_continued(lit_text)
        let body: String = lit_text.bytes[1..<lit_text.len() - 1].text() catch { "" }
        let mut positional: Vec[i64] = []
        let mut named = collections::BTreeMap()
        for i in 1..<args.len() {
            let a = args[i]
            if self.t.is(a, "BIN_EXPR") && self.t.has_tok(a, "EQ") {
                let lhs = self.t.nth(a, 0)
                named.insert(self.src(lhs), self.t.nth(a, 1))
            } else {
                positional.push(a)
            }
        }
        let mut out: String = ""
        let mut holes = 0
        let mut next = 0
        let bs = body.bytes
        let mut i = 0
        while i < bs.len() {
            let b = bs[i]
            if b == 123 && i + 1 < bs.len() && bs[i + 1] == 123 {
                out.push_str("{{")
                i += 2
                continue
            }
            if b == 125 && i + 1 < bs.len() && bs[i + 1] == 125 {
                out.push_str("}}")
                i += 2
                continue
            }
            if b == 123 {
                let mut j = i + 1
                while j < bs.len() && bs[j] != 125 {
                    j += 1
                }
                let inner: String = bs[i + 1..<j].text() catch { "" }
                let mut name: String = inner.clone()
                let mut spec: String = ""
                let colon = inner.find(":")
                if colon != null {
                    name = inner.bytes[0..<colon].text() catch { "" }
                    spec = inner.bytes[colon + 1..<inner.len()].text() catch { "" }
                }
                name = name.trim().clone()
                let mut hole: String = ""
                if name == "" {
                    if next < positional.len() {
                        hole = self.hole(positional[next])
                    }
                    next += 1
                } else if text::parse_i64(name) != null {
                    let at = text::parse_i64(name) ?? 0
                    if at < positional.len() {
                        hole = self.hole(positional[at])
                    }
                } else {
                    let given = named[name] ?? -1
                    if given >= 0 {
                        hole = self.hole(given)
                    } else {
                        hole = tr_ident(name)
                    }
                }
                if spec == "?" || spec == "#?" {
                    spec = ":?"
                } else if spec != "" {
                    if spec.contains("$") {
                        self.todos += 1
                        spec = f":{spec} /* TODO(rs2nika): a width from an argument */"
                    } else {
                        spec = f":{spec}"
                    }
                }
                out.push_str(f"{{{hole}{spec}}}")
                holes += 1
                i = j + 1
                continue
            }
            out.push_str(bs[i..<i + 1].text() catch { "" })
            i += 1
        }
        if holes == 0 {
            return f"\"{out.replace("{{", "{").replace("}}", "}")}\""
        }
        return f"f\"{out}\""
    }

    /// One hole of an f-string: the expression, or a `hole_N` written before
    /// the statement where it holds a literal text, a char or a line break.
    fn hole(ref mut self, n: i64) -> String {
        let e = self.expr(n)
        if e.contains("\"") || e.contains("'") || e.contains("\n") || e.contains("{") {
            let name = self.fresh("hole")
            self.pre.push(f"{self.ind}let {name} = {e}")
            return name
        }
        return e
    }
}
