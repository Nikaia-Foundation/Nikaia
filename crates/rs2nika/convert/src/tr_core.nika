// crates/rs2nika/convert/src/tr_core.nika
//
// **The syntax-tree converter's state** (`--engine tree`). `TrEm` walks the
// tree `tree.nika` reads and writes Nikaia node by node: items (tr_items.nika),
// statements and control flow (tr_stmt.nika), expressions (tr_expr.nika),
// patterns and types (tr_types.nika). What it has no form for it writes as the
// Rust text with a `TODO(rs2nika)` beside it, never silently.
//
// A macro's arguments are a token tree, not syntax: `tr_graft_macros` parses
// the known macros' arguments once more, in one run of rust-analyzer, as the
// expression list of a call (`format!`), an array (`vec!`) or a `match`
// (`matches!`), and hangs that tree beside the call (`margs`).

use std::collections
use std::text

pub struct TrEm {
    pub t: RtTree,
    pub profile: String,
    pub prefix: String,
    /// lines a statement needs before it (`let hole_N = ..`), indented
    pub pre: Vec[String],
    /// the indentation of the statement being written
    pub ind: String,
    /// `use std::x` lines the output needs
    pub uses: collections::BTreeSet[String],
    pub uniq: i64,
    /// the function being written returns a `Result` / an `Option`
    pub fails: bool,
    pub opt: bool,
    /// the function returns nothing
    pub unit: bool,
    /// the type of the `impl` being written
    pub self_ty: String,
    /// types whose `fn new` became the anonymous constructor
    pub ctors: collections::BTreeSet[String],
    /// a macro call -> the tree of its arguments
    pub margs: collections::BTreeMap[i64, i64],
    /// names the Rust declares `Option<..>` (locals, parameters, fields)
    pub optional: collections::BTreeSet[String],
    /// the parameters that are texts (`&str`, `String`): R183
    pub texts: collections::BTreeSet[String],
    /// text parameters read more than once: each `to_string()` is a clone
    pub shared_texts: collections::BTreeSet[String],
    pub todos: i64,
    /// the file's own top-level functions (a `prefix` renames them)
    pub fns: collections::BTreeSet[String],
    /// nested items, written after the top-level item that holds them
    pub hoisted: Vec[String],
    /// a name that stands for a place while a body is written: the variable
    /// of `for x in xs.iter_mut()` is `xs[i]`
    pub aliases: collections::BTreeMap[String, String],
    /// a `-free` profile's world (`CheckWorld`): the state's methods become
    /// free functions of `state`, `world` (and `host`)
    pub world: String,
    pub host_fns: collections::BTreeSet[String],
    /// the methods being written are the state's (`impl Checker`)
    pub state_impl: bool,
    /// the type the function being written returns, as Nikaia writes it
    pub ret_ty: String,
    /// a closure's body written as a loop's (`xs.iter().map(|x| { .. })
    /// .collect()`): the list its values are pushed to, and whether they
    /// are options (`filter_map`), whose absence is `continue`
    pub push_to: String,
    pub push_opt: bool,
    /// `module::f` of the crate -> its name in tools/module.nika
    pub tool_paths: collections::BTreeMap[String, String],
    /// the functions that read the environment (`env::var`), themselves or
    /// through another: they take `host: ref H`, as the moved tools do
    pub env_fns: collections::BTreeSet[String],
}

pub fn tr_convert(t: RtTree, profile: String, prefix: String, world: String, host_fns: ref Vec[String], tool_paths: collections::BTreeMap[String, String]) -> String {
    let mut em = TrEm {
        t: t,
        profile: profile,
        prefix: prefix,
        pre: [],
        ind: "",
        uses: collections::BTreeSet(),
        uniq: 0,
        fails: false,
        opt: false,
        unit: true,
        self_ty: "",
        ctors: collections::BTreeSet(),
        margs: collections::BTreeMap(),
        optional: collections::BTreeSet(),
        texts: collections::BTreeSet(),
        shared_texts: collections::BTreeSet(),
        env_fns: collections::BTreeSet(),
        todos: 0,
        fns: collections::BTreeSet(),
        hoisted: [],
        aliases: collections::BTreeMap(),
        world: world,
        host_fns: host_fns.iter().map(fn(h) { h.clone() }).collect(),
        state_impl: false,
        ret_ty: "",
        push_to: "",
        push_opt: false,
        tool_paths: tool_paths,
    }
    if em.t.nodes.len() == 0 {
        return ""
    }
    em.graft_macros()
    em.find_ctors()
    em.find_env_fns()
    let body = em.file(0)
    let mut out: Vec[String] = []
    for u in em.uses {
        out.push(f"use std::{u}")
    }
    if out.len() > 0 {
        out.push("")
    }
    out.push(body)
    return out.join("\n")
}

/// The parts of a token tree's text between its delimiters, split at its
/// top-level commas.
fn tr_split_commas(t: ref RtTree, tt: i64) -> Vec[String] {
    let mut parts: Vec[String] = []
    let mut cur: String = ""
    let ks = t.nodes[tt].kids.clone()
    for i in 1..<ks.len() - 1 {
        let k = ks[i]
        if t.nodes[k].kind == "COMMA" {
            parts.push(cur.clone())
            cur = ""
        } else {
            cur.push_str(t.text(k))
        }
    }
    if cur.trim() != "" {
        parts.push(cur)
    }
    return parts
}

impl TrEm {
    fn fresh(ref mut self, base: String) -> String {
        self.uniq += 1
        return f"{base}_{self.uniq}"
    }

    /// The source text of `n`, trimmed.
    fn src(ref self, n: i64) -> String {
        return self.t.text(n).trim().clone()
    }

    /// The child nodes of `n` (no tokens).
    fn nodes(ref self, n: i64) -> Vec[i64] {
        return self.t.nodes_of(n)
    }

    /// Whether a pattern inside `n` binds `name` again.
    fn binds(ref self, n: i64, name: ref String) -> bool {
        if n < 0 {
            return false
        }
        if self.t.is(n, "IDENT_PAT") && self.t.name_of(n) == name {
            return true
        }
        for k in self.nodes(n) {
            if self.binds(k, name) {
                return true
            }
        }
        return false
    }

    /// How often `n` copies the variable `name`: `name.to_string()` or
    /// `name.to_owned()`, inside a macro's arguments (tokens) too.
    fn copies_of(ref self, n: i64, name: ref String) -> i64 {
        if n < 0 || self.t.nodes[n].tok {
            return 0
        }
        let mut count = 0
        if self.t.is(n, "METHOD_CALL_EXPR") {
            let m = self.src(self.t.kid(n, "NAME_REF"))
            if (m == "to_string" || m == "to_owned") && self.t.is(self.t.nth(n, 0), "PATH_EXPR") && self.src(self.t.nth(n, 0)) == name {
                count += 1
            }
        }
        if self.t.is(n, "TOKEN_TREE") {
            let mut toks: Vec[String] = []
            for k in self.t.nodes[n].kids {
                if self.t.nodes[k].tok && self.t.nodes[k].kind != "WHITESPACE" && self.t.nodes[k].kind != "COMMENT" {
                    toks.push(self.t.nodes[k].text.clone())
                }
            }
            for i in 0..<toks.len() {
                if i + 2 < toks.len() && toks[i] == name && toks[i + 1] == "." && (toks[i + 2] == "to_string" || toks[i + 2] == "to_owned") && (i == 0 || toks[i - 1] != ".") {
                    count += 1
                }
            }
        }
        for k in self.t.nodes[n].kids {
            count += self.copies_of(k, name)
        }
        return count
    }

    /// The name a `PATH` / `PATH_EXPR` / `PATH_TYPE` ends in.
    fn last_seg(ref self, n: i64) -> String {
        let p = self.t.find(n, "PATH")
        if p < 0 {
            return ""
        }
        let segs = self.t.kids_of(p, "PATH_SEGMENT")
        if segs.len() == 0 {
            return ""
        }
        let nr = self.t.kid(segs[0], "NAME_REF")
        if nr >= 0 {
            return self.src(nr)
        }
        return self.src(segs[0])
    }

    /// The segments of a path, outermost first: `a::b::c` -> [a, b, c].
    fn segs(ref self, n: i64) -> Vec[String] {
        let mut out: Vec[String] = []
        let mut p = n
        if !self.t.is(p, "PATH") {
            p = self.t.find(n, "PATH")
        }
        while p >= 0 {
            let seg = self.t.kid(p, "PATH_SEGMENT")
            let nr = self.t.kid(seg, "NAME_REF")
            if nr >= 0 {
                out.insert(0, self.src(nr))
            } else {
                // `Self`, `crate`, `super`, `<T as X>`
                let mut s: String = ""
                for k in self.t.nodes[seg].kids.clone() {
                    if self.t.nodes[k].kind != "GENERIC_ARG_LIST" {
                        s.push_str(self.t.text(k))
                    }
                }
                out.insert(0, s.trim().clone())
            }
            p = self.t.kid(p, "PATH")
        }
        return out
    }

    /// The generic arguments of a path's last segment, as nodes.
    fn gen_args(ref self, n: i64) -> Vec[i64] {
        let mut p = n
        if !self.t.is(p, "PATH") {
            p = self.t.find(n, "PATH")
        }
        let seg = self.t.kid(p, "PATH_SEGMENT")
        let gl = self.t.kid(seg, "GENERIC_ARG_LIST")
        let mut out: Vec[i64] = []
        for a in self.nodes(gl) {
            out.push(a)
        }
        return out
    }

    /// `impl X { fn new(..) -> Self }` without `self`: `X(..)` calls the
    /// anonymous constructor it becomes.
    fn find_ctors(ref mut self) {
        for f in self.t.kids_of(0, "FN") {
            self.fns.insert(self.t.name_of(f).clone())
        }
        // a function nested in a function is hoisted to the top level, where
        // it takes the prefix as well (R258)
        for i in 0..<self.t.nodes.len() {
            if self.t.nodes[i].kind == "FN" && self.t.up(i, "FN") >= 0 {
                self.fns.insert(self.t.name_of(i).clone())
            }
        }
        for i in 0..<self.t.nodes.len() {
            if self.t.nodes[i].kind != "IMPL" || self.t.has_tok(i, "FOR_KW") {
                continue
            }
            let ty = self.last_seg(self.t.kid(i, "PATH_TYPE"))
            let list = self.t.kid(i, "ASSOC_ITEM_LIST")
            for f in self.t.kids_of(list, "FN") {
                let params = self.t.kid(f, "PARAM_LIST")
                if self.t.name_of(f) == "new" && self.t.kid(params, "SELF_PARAM") < 0 {
                    self.ctors.insert(ty.clone())
                }
            }
        }
    }

    /// The functions that read the environment: `env::var` in their body, or
    /// a call to one that does (`f(..)`, `Self::f(..)`, `self.f(..)`).
    fn find_env_fns(ref mut self) {
        let mut grew = true
        while grew {
            grew = false
            for i in 0..<self.t.nodes.len() {
                if self.t.nodes[i].kind != "FN" || self.env_fns.contains(self.t.name_of(i)) {
                    continue
                }
                if self.reads_env(self.t.kid(i, "BLOCK_EXPR")) {
                    self.env_fns.insert(self.t.name_of(i).clone())
                    grew = true
                }
            }
        }
    }

    fn reads_env(ref self, n: i64) -> bool {
        if n < 0 {
            return false
        }
        if self.env_call(n) {
            return true
        }
        for k in self.nodes(n) {
            if self.reads_env(k) {
                return true
            }
        }
        return false
    }

    /// Whether `n` is `env::var(..)` / `env::var_os(..)`, or a call to a
    /// function of `env_fns`.
    fn env_call(ref self, n: i64) -> bool {
        if self.t.is(n, "CALL_EXPR") && self.t.is(self.t.nth(n, 0), "PATH_EXPR") {
            let segs = self.segs(self.t.nth(n, 0))
            let last = segs[segs.len() - 1].clone()
            if segs.len() >= 2 && segs[segs.len() - 2] == "env" && (last == "var" || last == "var_os") {
                return true
            }
            return (segs.len() == 1 || segs.len() == 2 && segs[0] == "Self") && self.env_fns.contains(last)
        }
        if self.t.is(n, "METHOD_CALL_EXPR") && self.src(self.t.nth(n, 0)) == "self" {
            return self.env_fns.contains(self.src(self.t.kid(n, "NAME_REF")))
        }
        return false
    }

    /// The host trait of this file's functions that read the environment:
    /// `project_settings_` -> `ProjectSettingsHost`; without a prefix, the
    /// world's (`CheckWorld` -> `CheckHost`).
    fn host_trait(ref self) -> String {
        if self.prefix == "" && self.world != "" {
            return self.world.replace("World", "Host")
        }
        let mut out: String = ""
        for w in self.prefix.split("_") {
            if w == "" {
                continue
            }
            let mut first = true
            for c in w.scalars {
                if first {
                    out.push_str(c.to_string().to_uppercase())
                    first = false
                } else {
                    out.push(c)
                }
            }
        }
        return f"{out}Host"
    }

    /// Parse the arguments of the macros the converter knows, in rounds: an
    /// argument may hold a macro of its own.
    fn graft_macros(ref mut self) {
        let mut from = 0
        for _ in 0..<6 {
            let mut src: Vec[String] = []
            let mut calls: Vec[i64] = []
            let mut shapes: Vec[String] = []
            let upto = self.t.nodes.len()
            for i in from..<upto {
                if self.t.nodes[i].kind != "MACRO_CALL" {
                    continue
                }
                let tt = self.t.kid(i, "TOKEN_TREE")
                if tt < 0 {
                    continue
                }
                let name = self.last_seg(i)
                let ks = self.t.nodes[tt].kids.clone()
                if ks.len() < 2 {
                    continue
                }
                let mut inner: String = ""
                for j in 1..<ks.len() - 1 {
                    inner.push_str(self.t.text(ks[j]))
                }
                let at = calls.len()
                if name == "vec" {
                    src.push(f"fn __rt{at}() {{ [{inner}]; }}")
                    shapes.push("ARRAY_EXPR")
                } else if name == "matches" || name == "assert_matches" {
                    let parts = tr_split_commas(self.t, tt)
                    if parts.len() < 2 {
                        continue
                    }
                    let mut pat_text: String = ""
                    for j in 1..<parts.len() {
                        if j > 1 {
                            pat_text.push_str(",")
                        }
                        pat_text.push_str(parts[j])
                    }
                    let e = parts[0].clone()
                    src.push(f"fn __rt{at}() {{ match ({e}) {{ {pat_text} => {{}} }} }}")
                    shapes.push("MATCH_EXPR")
                } else if tr_format_like(name) || name == "assert" || name == "assert_eq" || name == "assert_ne" || name == "debug_assert" || name == "debug_assert_eq" || name == "debug_assert_ne" || name == "todo" || name == "unimplemented" || name == "dbg" {
                    src.push(f"fn __rt{at}() {{ f({inner}); }}")
                    shapes.push("ARG_LIST")
                } else {
                    continue
                }
                calls.push(i)
            }
            if calls.len() == 0 {
                return
            }
            let more = rt_parse(src.join("\n")) catch { RtTree { nodes: [] } }
            if more.nodes.len() == 0 {
                return
            }
            let base = self.t.nodes.len()
            for j in 0..<more.nodes.len() {
                let node = more.nodes[j].clone()
                let mut kids: Vec[i64] = []
                for k in node.kids {
                    kids.push(k + base)
                }
                let mut parent = -1
                if node.parent >= 0 {
                    parent = node.parent + base
                }
                self.t.nodes.push(RtNode { kind: node.kind, text: node.text, tok: node.tok, kids: kids, parent: parent, start: node.start, end: node.end })
            }
            // by name, not by order: a call whose text does not parse leaves
            // an `ERROR` in place of its `fn`, and the rest would slide
            for f in self.t.kids_of(base, "FN") {
                let fname = self.t.name_of(f).clone()
                if !fname.starts_with("__rt") {
                    continue
                }
                let c = text::parse_i64(tr_drop_prefix(fname, "__rt")) ?? -1
                if c < 0 || c >= calls.len() {
                    continue
                }
                let body = self.t.kid(f, "BLOCK_EXPR")
                let found = self.t.find(body, shapes[c])
                if found >= 0 {
                    self.margs.insert(calls[c], found)
                }
            }
            from = base
        }
    }
}

/// The macros whose first argument is a format string.
fn tr_format_like(name: String) -> bool {
    return name == "format" || name == "print" || name == "println" || name == "eprint" || name == "eprintln" || name == "panic" || name == "write" || name == "writeln" || name == "unreachable" || name == "format_args" || name == "refused" || name == "refuse" || name == "bail" || name == "anyhow" || name == "format_err" || name == "ensure"
}

/// `s` without `p` at its front, if it starts with it.
fn tr_drop_prefix(s: String, p: ref String) -> String {
    if s.starts_with(p) {
        let rest: String = s.bytes[p.len()..<s.len()].text() catch { "" }
        return rest.clone()
    }
    return s
}

/// Whether a bracketed Rust text (`[..]`, `{..}`) breaks the line right
/// after its opening bracket: the Nikaia keeps one item a line where one
/// line would run past 100 columns (rustfmt breaks far sooner).
fn tr_opens_line(s: String) -> bool {
    let rest = s.bytes[1..<s.len()].text() catch { "" }
    let first = rest.split("\n").next() ?? ""
    return rest.contains("\n") && first.trim() == ""
}

/// `s` without `p` at its end, if it ends with it.
fn tr_drop_suffix(s: String, p: ref String) -> String {
    if s.ends_with(p) {
        let rest: String = s.bytes[0..<s.len() - p.len()].text() catch { "" }
        return rest.clone()
    }
    return s
}

/// A function of the draft under `prefix`; the line passes wrote some
/// helpers (`modules_is_file`) with it already.
fn tr_prefixed(prefix: ref String, name: ref String) -> String {
    if name.starts_with(prefix) {
        return name.clone()
    }
    return f"{prefix}{name}"
}
