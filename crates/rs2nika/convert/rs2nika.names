# Rust name in the compiler    Nikaia name in tools/*.nika    (R47; extend when a builder finds one)
value_node node_key
contracts::base type_last_segment
contracts::TEXT "String"
tail_of tail_value_of
ty::base( type_last_segment(
base( type_last_segment(
check::Finding CheckFinding # check/mod.rs re-exports check_state::CheckFinding as Finding (project_check.nika, P2)
check::Severity CheckSeverity # the same re-export; also `check::Severity::Warning` in expressions
cache::sha256_hex host.sha256_hex # `std` has no SHA-256: a `SysrootHost` method (sysroot_cache.nika, S2)
cache::use_entry host.use_entry # the user cache's mark, a `SysrootHost` method (S2)
crate::comptime_run::unique_beside host.unique_beside # a `SysrootHost` method (S2)

# [view]: what `--view` (R177) renames, in this order. The parsed files are
# `ParsedView`s named `unit`. A bare word is renamed as a word (not after a
# `.`); anything else is replaced as text.
[view]
&[&Parsed] &Vec<ParsedView>
&[Parsed] &Vec<ParsedView>
&Parsed &ParsedView
parsed.program.items parsed.items
&parsed.interner parsed.words
parsed.interner parsed.words
parsed unit
unit.text(* unit.text(
unit.name(* unit.text(
unit.name( unit.text(

# [types]: `Rust type = Nikaia type`, what a move decided (spaces in the Rust
# type do not count), its reason after ` #` (R224). Extend in the commit of the move.
[types]
check::Finding = CheckFinding # check/mod.rs re-exports check_state::CheckFinding as Finding (project_check.nika, P2)
check::Severity = CheckSeverity # the same re-export
PathBuf = fs::Path # std's file name, `std::path::PathBuf` lowered; its methods are `nikaia_std::fs::path` (sysroot_cache.nika, S2)
&Path = ref fs::Path # the same, lent (S2)
