# Rust name in the compiler    Nikaia name in tools/*.nika    (R47; extend when a builder finds one)
value_node node_key
contracts::base type_last_segment
contracts::TEXT "String"
tail_of tail_value_of
ty::base( type_last_segment(
base( type_last_segment(
check::Finding CheckFinding # check/mod.rs re-exports check_state::CheckFinding as Finding (project_check.nika, P2)
check::Severity CheckSeverity # the same re-export; also `check::Severity::Warning` in expressions
cache::sha256_hex host.sha256_hex # `std` has no SHA-256: a `SysrootHost` method (sysroot_cache.nika, S2)
cache::use_entry host.use_entry # the user cache's mark, a `SysrootHost` method (S2)
crate::comptime_run::unique_beside host.unique_beside # a `SysrootHost` method (S2)
crate::contracts::sync::Pause ModulesPause # modules.rs's pause, `ModulesPause` in modules.nika (M1)
sync::Pause ModulesPause # the same, by its short path (M1)
verdict project_tests_verdict # `verdict` is a test runner's word other tools may want: prefixed (project_tests.nika, P3a)
difference project_tests_difference # the same: diffs.nika has `differing_lines` beside it (P3a)
bless project_tests_bless # every name P3b moved into project_tests.nika is prefixed: the file prefixes most of its names since (R245)
bless_program project_tests_bless_program # the same (P3b)
explain_output project_tests_explain_output # the same (P3b)
foreign_empty project_members_no_foreign # P4b's `Default` of `Foreign` (R312, R313): the build with no project around it, named for what it is
is_a_test_function prover_a_test_function # modules.rs had it without a caller; prover_walk.nika answers the same question (M2 deleted the Rust one)

# [view]: what `--view` (R177) renames, in this order. The parsed files are
# `ParsedView`s named `unit`. A bare word is renamed as a word (not after a
# `.`); anything else is replaced as text.
[view]
&[&Parsed] &Vec<ParsedView>
&[Parsed] &Vec<ParsedView>
&Parsed &ParsedView
parsed.program.items parsed.items
&parsed.interner parsed.words
parsed.interner parsed.words
parsed unit
unit.text(* unit.text(
unit.name(* unit.text(
unit.name( unit.text(

# [types]: `Rust type = Nikaia type`, what a move decided (spaces in the Rust
# type do not count), its reason after ` #` (R224). Extend in the commit of the move.
[types]
check::Finding = CheckFinding # check/mod.rs re-exports check_state::CheckFinding as Finding (project_check.nika, P2)
check::Severity = CheckSeverity # the same re-export
PathBuf = fs::Path # std's file name, `std::path::PathBuf` lowered; its methods are `nikaia_std::fs::path` (sysroot_cache.nika, S2)
&Path = ref fs::Path # the same, lent (S2)
(Span,String) = Site # a pause's site, `Site { span, what }` (sync.nika, M1)
Outcome = ProjectTestsOutcome # project.rs's `Outcome` is project_tests.nika's, re-exported under its old name (P3a)
Option<Vec<u8>> = Bytes? # a file read where there is one: what a test expects is `Bytes`, compared as bytes (P3a)
Blessed = ProjectTestsBlessed # project.rs's `Blessed` is project_tests.nika's, prefixed as every P3b name (P3b)
# P3a: `OutputTest` and `ProgramTest` are Nikaia structs holding `Bytes` and
# `fs::Path` (R255 writes a `Vec<u8>` field as `Bytes`); a plain `Vec<u8>` or
# `&[u8]` stays `Vec[u8]`, a buffer being built (S2's packed `body`, `sha256_hex`)

# [fields]: `Type.field chain = list: Nikaia type`, a struct the Rust side
# keeps, lent as `&[Type]` and read by fields: one list per field read,
# named in the plural (R242). Extend in the commit of the move.
[fields]
Unit.package = packages: Vec[String?] # modules.rs's `Unit` stays Rust; its packages, in unit order (modules.nika, M1)
Unit.path.display().to_string() = paths: Vec[String] # the units' paths as shown (M1)
Unit.renames = renames: Vec[collections::BTreeMap[String, String]] # the units' package renames (M1)
Unit.source = sources: Vec[String] # the units' texts (M1)
Package.files = files: Vec[(String, String)] # sysroot.rs's packed package, one field (S2)

# [forms]: `Rust form = Nikaia form`, an expression a move spells
# otherwise; `{x}` is the receiver chain before the rest (R244).
[forms]
{x}.sync_claim == Sync::Inferred = inferred_sync({x}.sync_claim) # `Sync` stays Rust: modules.nika asks `inferred_sync` (M1)
{x}.absorb_renaming( = absorb_into({x}, # `Ledger::absorb_renaming` is ledger_ops.nika's free `absorb_into` (M1)
{x}.span.at() = ({x}.span.start as i64) # `Span::at` is a Rust helper of the lowered `Span`; Nikaia reads the field (modules.nika, M2)
{x}.span.stop() = ({x}.span.end as i64) # the same, its end (M2)
{x}.windows(2).all(fn(pair) { pair[0].1 == pair[1].1 }) = project_tests_agree({x}) # whether all settings agree is P3a's `project_tests_agree` (project_tests.nika, P3b)

# [prefixed]: a prefix the move gave every name of its file (R294), so a
# draft under it prefixes every name even before the file exists.
[prefixed]
project_members_ # P4a prefixed every name it moved into project_members.nika (3620d27)

# [types X_] / [forms X_]: a move's decisions for the file `--prefix X_`
# names only (R309), so they reach no other file's draft.
[types project_members_]
Manifest = ProjectMembersManifest # Manifest stays Rust: the walk reads its view, filled by project.rs (P4a)
modules::Dependency = ProjectMembersDependency # modules.rs's Dependency is project_members.nika's now (P4a)
Member = ProjectMembersMember # Member stays Rust (it holds the Manifest); the walk builds this one (P4a)
BTreeMap<PathBuf,String> = collections::HashMap[fs::Path, String] # a map of paths only looked up, never walked in order (P4a)
BTreeMap<PathBuf,usize> = collections::HashMap[fs::Path, i64] # the same (P4a's `seen`)
BTreeMap<&Path,usize> = collections::HashMap[fs::Path, i64] # the same, its keys owned (P4a's `at_of`)
BTreeSet<PathBuf> = collections::HashSet[fs::Path] # a set of paths only asked, never walked in order (P4b's `seen`)

[forms project_members_]
{x}.package_name() = {x}.name # the manifest view's fields (ProjectMembersManifest, P4a)
{x}.has_build_section() = {x}.has_build # the same
{x}.foreign_crates() = {x}.foreign # the same
{x}.dependencies().keys() = {x}.keys.iter() # the same: every dependency's key
{x}.dependencies()|Dependency::Path = {x}.paths.iter() # the same: the path dependencies, a loop keeping `Dependency::Path` (R308)
ProjectMembersManifest::read({a}) = manifests.manifest_at({a}) ?? throw ProjectMembersRefusal::Manifest # a manifest is read by project.rs, through ProjectMembersHost (R295, R314's `manifests`); one that did not read is its error, kept there
Ledger::empty() = host.empty_ledger() # `Ledger` stays Rust: the foreign host makes one (ProjectMembersForeignHost, P4b)
Ledger::read_beside({a}) = host.read_beside({a}) # the same: a description is read by the host (P4b)
{x}.absorb(null, = {x} = host.absorb({x}, # the same: the host merges one ledger into another and hands it back (P4b)
crate_root({a}, {b}) = host.crate_root({a}, {b}.clone()) # describe.rs's `crate_root` stays Rust, behind the foreign host (P4b)
Refused::Because( = ProjectMembersRefusal::Refused( # the file's refusal, turned back into the same anyhow error in project.rs (P4a)

# [hosts X_]: `parameter = Bound: Trait`, the host parameters a function of
# the file takes for the calls on them (R314), in the order its signature
# lists them; none: one `host`, bound by the prefix's `<Prefix>Host` (R295).
[hosts project_members_]
manifests = M: ProjectMembersHost # P4b: the manifests come from project.rs's host, P4a's trait (P4a's own functions call it `host`; the move kept them)
host = H: ProjectMembersForeignHost # P4b: the ledger and the crate sources are the foreign host's (8394790)

[forms project_check_]
check::check_against( = host.check_against( # the checker's walk stays Rust behind ProjectCheckHost; the host holds the program, the build's facts and keeps `checked.facts` (P5d)
project_check_check(parsed, foreign.declared, = host.foreign_check( # `crate::foreign::check` stays Rust, the host's (P5d)
sync_::check( = host.sync_violations( # `contracts::sync::check` stays Rust: the host keeps the violations, Nikaia counts them (P5d)
diagnostics::render_finding_in( = host.render_finding_in( # the renderer stays Rust (P5d)
diagnostics::render_sync_violation( = host.render_sync_violation( # the same, a violation named by its index (P5d)
host.env_var(WRAPPER_MARKER) != null || WARNED.with(fn(warned) { warned.get() }) = host.in_the_wrapper() # the wrapper's marker and the thread-local stay Rust (P5d)
eprint( = host.eprint( # std has no `eprint` without a newline (P5d)
check::Kept { = ProjectCheckKept { # `check::Kept` stays Rust (lane 2); project.rs maps this one to it (P5d)
{x}.arguments() = {x}.params # `SignatureOps::arguments` is the params after a `self` (contracts/mod.rs) (P5d)

[hosts project_check_]
host = H: ProjectCheckHost # P5d: the walks and the renderer stay Rust behind project.rs's host

[forms project_lower_]
program.could_promise() = host.could_promise() # the program stays Rust, held by project.rs's LowerHost (P5b)
program.lost_sync( = host.lost_sync( # the same: what a `pub` function lost, asked of the held program (P5b)
host.env_var(WRAPPER_MARKER) != null || WARNED.with(fn(warned) { warned.get() }) = host.in_the_wrapper() # the wrapper's marker and the thread-local stay Rust (P5b, as P5d)
eprint( = host.eprint( # std has no `eprint` without a newline (P5b, as P5d)
reads.unused() = host.unused_reads() # `assets::Reads` stays Rust, the host's (P5b)
changed_contracts( = host.changed_contracts( # the prover's `implies` and the dependencies filter stay Rust, behind the host (P5b)
Ledger::parse( = host.parse_ledger( # `Ledger::parse` is the compiler's, behind the host (P5b)

[hosts project_lower_]
host = H: ProjectLowerHost # P5b: the program, the cache, the check and the emitter stay Rust behind project.rs's LowerHost
