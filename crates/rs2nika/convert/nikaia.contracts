[type."Rs2nikaCtx"]
fields = ["profile: String", "free: bool", "world: ref String", "prefix: String", "hits: Vec[String]", "fn_opt: bool", "methods: Vec[String]", "renamed_from: Vec[String]", "renamed_to: Vec[String]", "stack_ind: Vec[String]", "stack_kind: Vec[String]", "tool_fns: collections::BTreeSet[String]", "tool_names: Vec[String]", "tool_docs: Vec[String]", "tool_files: Vec[String]", "alias_from: Vec[String]", "alias_to: Vec[String]", "equiv_from: Vec[String]", "equiv_to: Vec[String]", "todo_extra: Vec[String]", "arity: Vec[String]", "host_fns: Vec[String]", "opt_names: Vec[String]"]

[type."Rs2nikaOut"]
pub = true
fields = ["pub text: String", "pub hits: Vec[String]", "pub missing: Vec[String]", "pub twins: Vec[String]"]

[type."Rs2nikaScore"]
pub = true
fields = ["kept: i64", "total: i64", "kinds: Vec[String]"]
