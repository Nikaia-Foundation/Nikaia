[type."Rs2nikaCase"]
fields = ["name: String", "floor: i64", "profile: String", "prefix: String", "before: String", "after: String"]

[type."Rs2nikaCtx"]
fields = ["profile: String", "free: bool", "world: ref String", "prefix: String", "hits: Vec[String]", "fn_opt: bool", "methods: Vec[String]", "renamed_from: Vec[String]", "renamed_to: Vec[String]", "stack_ind: Vec[String]", "stack_kind: Vec[String]", "tool_fns: collections::BTreeSet[String]", "tool_names: Vec[String]", "tool_docs: Vec[String]", "tool_files: Vec[String]", "alias_from: Vec[String]", "alias_to: Vec[String]", "equiv_from: Vec[String]", "equiv_to: Vec[String]", "type_from: Vec[String]", "type_to: Vec[String]", "todo_extra: Vec[String]", "arity: Vec[String]", "host_fns: Vec[String]", "opt_names: Vec[String]", "parsed_names: Vec[String]", "impl_other: bool", "field_opts: collections::BTreeSet[String]", "tuple_line: Vec[String]", "tuple_why: Vec[String]", "view: bool", "view_names: Vec[String]", "seq_fns: Vec[String]", "tool_types: collections::BTreeSet[String]", "only_fns: Vec[String]", "only_consts: Vec[String]", "only_methods: Vec[String]", "field_from: Vec[String]", "field_to: Vec[String]", "form_from: Vec[String]", "form_to: Vec[String]", "prefix_all: bool", "prefix_file: String", "prefixed: Vec[String]", "scoped: Vec[(String, String, String, String)]", "rust_fields: Vec[(String, String, String)]", "hosts: Vec[(String, String)]", "tool_fields: Vec[(String, String, String)]", "tool_methods: Vec[(String, String)]"]

[type."Rs2nikaOut"]
pub = true
fields = ["pub text: String", "pub hits: Vec[String]", "pub missing: Vec[String]", "pub twins: Vec[String]"]

[type."Rs2nikaScore"]
pub = true
fields = ["kept: i64", "total: i64", "kinds: Vec[String]"]

[type."Rs2nikaTupleArm"]
fields = ["variant: String", "lines: Vec[String]", "head: i64", "parts: Vec[String]", "guard: String", "after: String", "all: bool"]
