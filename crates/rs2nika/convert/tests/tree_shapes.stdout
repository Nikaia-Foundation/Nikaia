use std::collections
struct Around {
    foreign: Vec[String],
    newly: bool,
}
struct P {
    site: (u32, String)?,
}

pub fn split(around: Around) -> i64 {
    let foreign = around.foreign
    let mut fresh = around.newly
    fresh = !fresh
    if fresh {
        return foreign.len()
    } else {
        return 0
    }
}

pub fn split_made() -> bool {
    let whole = make()
    let newly = whole.newly
    return newly
}

pub fn what(pause: P?) -> String? {
    let what = (match (match pause { pause => pause.site, null => null }) { (_, what) => what.clone(), null => null })
    return what
}

pub fn kept(xs: ref Vec[i64]) -> i64 {
    let found = xs.iter().filter(fn(x) { x > 1 }).collect()
    return sync_::count(found)
}

pub fn panics(t: Target) -> String {
    return panic_strategy(t)
}

fn key(t: String) -> String throws {
    return t
}

pub fn keyed(t: String) -> (String, String) {
    return ((key(t) catch { "" }), t)
}

pub fn long_list(a: String) -> Vec[(String, String)] {
    return [
        (TARGET_VARIABLE_NAME.to_string(), a.clone()),
        (TARGET_VARIABLE_NAME.to_string(), a.clone()),
        (TARGET_VARIABLE_NAME.to_string(), a.clone()),
        (TARGET_VARIABLE_NAME.to_string(), a.clone()),
    ].iter().collect()
}

pub fn both(a: String) -> (String, String) {
    return (a.clone(), a.clone())
}

pub fn level(word: String) -> String {
    return match word {
        "error" | "warn" => word,
        else => "",
    }
}

pub struct W {
    pub target: String,
    pub tests: bool,
    pub cpu: String?,
}
impl W {
    fn as_env(ref self) -> Vec[(String, String)] {
        let mut out: Vec[(String, String)] = [(A.to_string(), self.target.clone())]
        if self.tests {
            out.push((A.to_string(), "1"))
        }
        match self.cpu {
            level => out.push((A.to_string(), level.clone())),
            null => {},
        }
        return out
    }
}

fn flags[H: CheckHost](host: ref H) -> String? {
    return host.env_var("RUSTFLAGS")
}

pub fn has_flags[H: CheckHost](host: ref H) -> bool {
    return flags(host) != null
}

pub struct Bag {
    items: Vec[String],
}

impl Bag {
    pub fn take_items(ref mut self) -> Vec[String] {
        return self.items.drain().collect()
    }
}

pub fn shout(mut v: Vec[String]) {
    for at_1 in 0..<v.len() {
        v[at_1] = v[at_1].to_uppercase()
    }
}
