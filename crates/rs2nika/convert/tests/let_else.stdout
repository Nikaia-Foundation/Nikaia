fn bound(types: ref Vec[Ty]) -> i64 sync {
    let mut known: Vec[Ty] = []
    let mut numbers: i64 = 0
    for ty in types {
        let (name, args) = match ty { Ty::Named { name, args, .. } => (name, args), else => continue }
        let inner = match ty { Ty::Nullable(inner) => inner, else => return 0 }
        let parts = match inner.clone() { Ty::Tuple(parts) => parts, else => continue }
        let first = parts.first() ?? continue
        numbers += first + args.len() + name.len() + parts.len() + parts.iter().map(fn(p) { p.len() }).collect().len()
    }
    return numbers
}

