//! R188-R204: module lines, foreign `use`s, adapters, and patterns.
use std::collections

// TODO(rs2nika): `static` behind a lock: no globals in tools/*.nika; a field of the state struct (the lock drops), set through `mut self`
static CACHE: std::sync::Mutex<Vec<u8>> = std::sync::Mutex::new([])

// ADAPTER: bleibt in Rust (`impl std::fmt::Display for Shape`: Rust's `Display`)


trait Named {
    fn name(ref self) -> String sync
}

fn more_chosen(names: ref Vec[String], body: ref Block, expected: Ty?, tail: Span?, how: Wrap?) -> Vec[String] {
    let all = names.iter().map(fn(x) { x.clone() }).collect()
    let n = count(body)
    let _ = first(body)
    if expected != null {
        match body.stmts.last()?.node {
            Stmt::Expr(value) => {
                if tail != null {
                    let at = tail
                    use_both(value, at)
                }
            },
            else => {},
        }
    }
    match (expected, body.stmts.last()?.node) {
        (expected, Stmt::Expr(value)) if expected != null => {
            use_both(value, expected)
        },
        else => {},
    }
    match how {
        Wrap::Widen(_) | Wrap::Constructor => {
            keep(how)
        }
        else => {}
    }
    // a comment between two links
    // TODO(rs2nika): `.get(range)`: Nikaia has no `get` of a range (NK1171); test the bounds, then cut `s[a..]` / `s[a..<b]`
    let typed: Vec[Ty] = names.iter().filter_map(fn(n) { Ty::from(n.get(0..<1) ?? return null) }).collect()
    for inner in check_visit_stmt_blocks(body.stmts[0].node) {
        walk(inner)
    }
    return all
}

fn more_evens(xs: ref Vec[i64]) -> Vec[i64] {
    return xs.iter().filter(fn(x) { x % 2 == 0 }).collect()
}

fn more_hashed() -> u64 {
    let basis = (0xcbf2_9ce4_8422_2325 as u64)
    return basis ^ (0b1010 as u8) as u64 ^ 0xFF as u64
}

fn more_either(args: ref Vec[Arg], ret: ref Ty?) -> bool {
    if args.iter().map(fn(a) { a.ty }).any(fn(t) { t.is_view }) || (match ret { t => t.is_view, null => false }) {
        return true
    }
    let all = (args.iter().map(fn(a) { a.ty }).all(fn(t) { t.lasting }) && (match ret { t => t.lasting, null => true })) && args.len() > 1
    return all
}

fn more_gathered(first: ref Unit, beside: ref Vec[Unit], keys: ref collections::BTreeMap[String, Ty], more: ref collections::BTreeMap[String, Ty]) -> Vec[String] {
    let mut seen: i64 = 0
    // ADAPTER: bleibt in Rust (`std::iter::once(`)
    let mut chained = [first]
    chained.extend(beside.iter().collect())
    for unit in chained {
        seen += unit.len()
    }
    let mut chained_2 = keys.keys().collect()
    chained_2.extend(more.keys().collect())
    let names: Vec[String] = chained_2.iter().map(fn(x) { x.clone() }).collect()
    let mut chained_3 = beside.iter().collect()
    chained_3.extend(beside.iter().collect())
    let all: Vec[ref Unit] = chained_3
    return names
}

fn more_named(unit: ref CheckWorld, word: Word) -> bool {
    return unit.words.resolve(word) == "x"
}

impl Mark {
    fn text(ref self) -> String {
        return self.places.join(", ")
    }

    fn read(text: String) -> Mark {
        return Mark { places: [text] }
    }
}

fn more_after_mark() -> i64 {
    return 0
}

fn more_listed(places: String, c: scalar) -> String {
    let q = if c == '"' { 1 } else { 2 }
    return f"{places}; repeatable {q}"
}

pub struct Moved {
    /// The names.
    pub names: Vec[String],
    pub by: collections::BTreeMap[String, i64],
    pub last: String?,
    pub done: bool,
}

impl Moved {
    /// Every field empty (Rust's derived `Default`).
    pub fn empty() -> Moved {
        return Moved { names: [], by: collections::BTreeMap(), last: null, done: false }
    }
}

impl Moved {
    pub fn new() -> Moved {
        return Moved::empty()
    }
}

fn more_fresh() -> Moved {
    return Moved()
}

fn more_spelled(mut state: CheckState, world: ref CheckWorld, value: ref Expr) -> String sync {
    return state.written(world.here, value)
}

fn more_walked(mut state: CheckState, world: ref CheckWorld) sync {
    for item in world.here.items {
        more_spelled(state, world, item.value)
    }
}

fn more_told(with_: String, throw_: i64) {
    println(f"told {with_} with {throw_} items")
    eprintln("")
    eprint("no holes, with care")
    print(f"{with_}: '{'x'}'")
}

