pub fn shown(xs: ref Vec[Unit], written: String?) -> Vec[String] sync {
    return xs.iter().map(fn(u) { match written { w if u.first => w.clone(), null => u.path.clone(), else => u.path.clone() } }).collect()
}
pub fn dir(v: String?) -> String? sync {
    let t = match v { _value => null, null => { default_dir() } }
    return t
}
pub fn pair(a: i64?, b: i64?) -> i64 sync {
    // TODO(rs2nika): a `Some(` in a tuple pattern of a `match` R172 does not read (one written on a line, or an arm it cannot split): `Some(p)` -> `p` once an arm before it takes `None` there (ADR-352 D1 per position, #879)
    let n = match (a, b) { (Some(x), _) => x, (null, _) => 0 }
    return n
}

