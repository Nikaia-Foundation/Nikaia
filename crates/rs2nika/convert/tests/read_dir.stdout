pub fn sources(dir: ref Path) -> Vec[PathBuf] sync throws {
    let mut paths: Vec[PathBuf] = fs::read_dir(dir, fs::Root::Anywhere).iter().map(fn(entry) { dir.join(entry) }).collect()
    return paths
}

pub fn stale(dir: ref Path) -> Vec[String] sync {
    let mut names: Vec[String] = (fs::read_dir(dir, fs::Root::Anywhere) catch { [] }).iter().filter_map(fn(name) { name.to_text() catch { null } }).collect()
    return names
}

pub fn walk(dir: ref Path) sync {
    let entries = fs::read_dir(dir, fs::Root::Anywhere) catch { return }
    for path in entries.iter().map(fn(name) { dir.join(name) }) {
        if is_dir(path) {
            walk(path)
        }
    }
}

pub fn count(dir: ref Path) -> i64 sync {
    return (fs::read_dir(dir, fs::Root::Anywhere) catch { [] }).len()
}

pub fn direct(dir: ref Path) sync {
    for path in (fs::read_dir(dir, fs::Root::Anywhere) catch { [] }).iter().map(fn(name) { dir.join(name) }) {
        println(f"{path.display()}")
    }
}

/// Whether `path` names a directory; a name that is not there names none.
fn is_dir(path: ref Path) -> bool sync {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_dir()
}
