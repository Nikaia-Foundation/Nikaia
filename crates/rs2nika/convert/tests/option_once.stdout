fn take(mut at: collections::BTreeMap[i64, i64], k: i64) -> i64 sync {
    match at.remove(k) {
        v => {
            return v + 1
        },
        null => {},
    }
    return 0
}

fn take_or(mut at: collections::BTreeMap[i64, i64], k: i64) -> i64 sync {
    let mut n = 0
    match at.remove(k) {
        v => {
            n = v
        },
        null => {
            n = 7
        },
    }
    return n
}

fn first(mut xs: Vec[i64]) -> i64 sync {
    match xs.pop() {
        top => {
            match xs.pop() {
                next => {
                    return top + next
                },
                null => {},
            }
            return top
        },
        null => {},
    }
    return -1
}

fn long(o: String?) -> bool sync {
    return (match o { s => s.len() > 2, null => false })
}

fn big(o: i64?) -> bool sync {
    return (match o { value => positive(value), null => false })
}

fn positive(n: i64) -> bool sync {
    return n > 0
}

