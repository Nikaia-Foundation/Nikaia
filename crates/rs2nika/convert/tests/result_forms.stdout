use std::text

fn width(name: ref String?) -> i64 sync {
    return (name ?? "").len()
}

fn first(a: i64?, b: i64?) -> i64 sync {
    let x = (a ?? b) ?? 0
    return x
}

fn read(path: String) -> String sync throws {
    let text = std::fs::read_to_string(path) catch { let e = error; throw f"{path}: {e}" }
    let n = text::parse_i64(text.trim()) ?? throw "not a number"
    if n == 0 {
        throw "zero"
    }
    return text
}

fn count(path: String) -> i64 sync {
    return (read(path) catch { "" }).len()
}

fn need(v: i64?) -> i64 sync throws {
    let x = v ?? throw "missing"
    return x + 1
}

fn head(path: String) -> Vec[String] sync {
    let text = read(path) catch { return [] }
    return [text]
}

fn digits(s: String) -> i64? sync {
    let n = text::parse_i64(s) ?? return null
    return n
}

