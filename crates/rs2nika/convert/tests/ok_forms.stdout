use std::text

pub fn home() -> String? sync {
    let h = std::env::var("HOME") catch { return null }
    return h
}

pub fn port() -> i64? sync {
    return (match std::env::var("PORT") catch { null } { p => text::parse_i64(p), null => null })
}

pub fn first(dir: ref Path) -> String? sync {
    let text = (fs::read_to_string(dir.join("a"), fs::Root::Anywhere) catch { return null }).trim().clone()
    return text
}

pub fn manifest(dir: ref Path) -> Manifest? sync {
    let m = Manifest::read(dir) catch { return null }
    return m
}

// ADAPTER: bleibt in Rust (`Ledger`)
pub fn ledger(text: String) -> Ledger? sync {
    // ADAPTER: bleibt in Rust (`Ledger`)
    return Ledger::parse(text) catch { return null }
}

pub fn ctx(path: ref Path) -> String sync throws {
    let t = fs::read_to_string(path, fs::Root::Anywhere)
    return t
}

pub fn flag() -> bool sync {
    return (match std::env::var("X") catch { null } { v => v == "1", null => null }) ?? false
}

pub fn ctx2(path: ref Path) -> i64 sync throws {
    let n = fs::read_to_string(path, fs::Root::Anywhere).len()
    let m = fs::read(path, fs::Root::Anywhere)
    return n + m.len()
}

