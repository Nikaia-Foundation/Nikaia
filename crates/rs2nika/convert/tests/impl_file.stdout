use std::collections

pub fn top(x: String) -> bool {
    return x.is_empty()
}

fn walk(mut state: CheckState, world: ref CheckWorld, a: String) -> bool sync {
    note(state, world, a)
    state.errors += 1; state.host().x()
    return a.is_empty()
}

fn note(state: ref CheckState, world: ref CheckWorld, a: String) sync {
    let _ = a
}

