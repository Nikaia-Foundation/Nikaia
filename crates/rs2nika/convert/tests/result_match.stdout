pub fn twice(text: String) -> Tree sync throws {
    let again = read_tree(text) catch { throw f"does not parse: {error}" }
    return again
}

pub fn format_all(files: Vec[String]) -> i64 sync {
    let mut code = 0
    for file in files {
        let formatted = format(file) catch {
            let refusal = error
            eprintln(f"{file}: {refusal}")
            code = 1
            continue
        }
        println(f"{formatted}")
    }
    return code
}

pub fn stage(text: String) -> Stage sync {
    lower(text) catch { return Stage::Refused }
    return Stage::Lowered
}

pub fn hole(text: String) -> Hole sync {
    let expr = read_tree(text) catch { let e = error; return Hole::Refused(e.to_string()) }
    return Hole::Parsed(expr)
}

pub fn dump(ty: String) -> Computed sync {
    let dump = dumper(ty) catch {
        match error {
            Wall::NoForm { because } => {
                return Computed::NotHere(because)
            },
            else => {
                return Computed::NotHere("no")
            },
        }
    }
    return Computed::Value(dump)
}

pub fn run_it() sync {
    let mut held = run() catch {
        eprintln(f"{error}")
        return
    }
    held.push(1)
    show(held)
    done()
}

pub fn open_cache() -> Cache? sync {
    let cache = Cache::open() catch {
        eprintln(f"warning: {error:#}")
        null
    }
    return cache
}

pub fn position(starts: ref Vec[i64], at: i64) -> i64 sync {
    // TODO(rs2nika): `match` on `Ok`/`Err`: `binary_search`: its `Err` is the place to insert at, not a failure; Nikaia's `xs.binary_search(x)` (Part I) and a test of what it hands back
    let line = match starts.binary_search(at) {
        Ok(i) => i,
        Err(i) => i - 1,
    }
    return line
}

pub fn report(said: Result[Out]) -> i64 sync {
    // TODO(rs2nika): `match` on `Ok`/`Err`: over a kept `Result` (not a call): Nikaia holds no `Result`; match where the call is made, `let v = call catch { <the Err arm> }`
    match said {
        Ok(out) => {
            show(out)
        },
        Err(error) => {
            eprintln(f"{error}")
        },
    }
    return 0
}

pub fn first_line(path: String) -> String sync {
    let text = read_file(path) catch { return "" }
    show(text)
    return path.to_string()
}

pub fn note(path: String) sync {
    match read_file(path) catch { null } {
        text => {
            show(text)
        },
        null => {},
    }
    done()
}

