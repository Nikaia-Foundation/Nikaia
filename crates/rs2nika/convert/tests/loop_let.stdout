// ADAPTER: bleibt in Rust (`Ledger`)
pub fn reach(plain: ref collections::BTreeMap[String, Ledger], words: ref Vec[String], package: String, mut seen: Ledger) {
    for word in words {
        let ours = word.clone()
        if ours == package {
            continue
        }
        let theirs = plain.get(ours) ?? continue
        seen.absorb(theirs.clone())
    }
    for word in words {
        match plain.get(word) {
            theirs => {
                seen.absorb(theirs.clone())
            },
            null => {},
        }
        seen.count += 1
    }
}

