pub fn facade(items: ref Vec[Item]) {
    for it in items {
        match it {
            Item::Fn { name: null, .. } => continue,
            Item::Const { name: null, .. } => continue,
            Item::Fn { name, .. } | Item::Const { name, .. } => {
                println(f"{name}")
            },
            else => continue,
        }
    }
}
pub fn nowild(it: ref Item) -> i64 {
    return match it {
        Item::Fn { name: null, .. } => {
            // TODO(rs2nika): the null arm of a Some(..) field
        },
        Item::Fn { name, args } => name.len() + args,
        Item::Other => 0,
    }
}