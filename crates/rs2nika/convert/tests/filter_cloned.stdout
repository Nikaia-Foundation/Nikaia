fn kept(thrown: ref Vec[Thrown], items: ref Vec[Item]) -> Vec[Thrown] sync {
    let mut fatal: Vec[Thrown] = []
    for t in thrown {
        if t.fatal {
            fatal.push(t.clone())
        }
    }
    // TODO(rs2nika): the type of `first` (an option of the element)
    let mut first = null
    for item in items {
        let found = item.name.clone()
        if found != null {
            first = found
            break
        }
    }
    return fatal
}

