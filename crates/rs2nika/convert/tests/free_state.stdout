fn check_x_bump(mut state: CheckState, world: ref CheckWorld, by: i64) sync {
    state.count += by
}
fn check_x_both[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H) sync {
    check_x_bump(state, world, 1)
    check_x_bump(state, world, 2)
    state.other()
}
fn check_x_peek(state: ref CheckState, world: ref CheckWorld) -> i64 sync {
    return state.count
}

