fn report(path: ref String, rows: ref Vec[Held]) -> String sync {
    let hole_6 = count(fn(h) { (match h { Held::Proved => true, else => false }) })
    let hole_7 = count(fn(h) { (match h { Held::Refused => true, else => false }) })
    let hole_8 = if rows.len() > 2 { "many" } else { "few, some" }
    return f"asserts in {path}: {rows.len()} - proved {hole_6}, refused {hole_7}, {hole_8}\n"
}

fn short(a: i64) -> String sync {
    // TODO(rs2nika): `format!` with fewer arguments than holes: `{?}` is a missing one
    return f"{a} and {?}"
}

