fn report(path: ref String, rows: ref Vec[Held]) -> String sync {
    // TODO(rs2nika): an f-string hole holds `count(|h| (match h { Held::Proved => true, else => false }))`: bind it to a `let` first
    // TODO(rs2nika): an f-string hole holds `count(|h| (match h { Held::Refused => true, else => false }))`: bind it to a `let` first
    // TODO(rs2nika): an f-string hole holds `if rows.len() > 2 { "many" } else { "few, some" }`: bind it to a `let` first
    return f"asserts in {path}: {rows.len()} - proved {count(fn(h) { (match h { Held::Proved => true, else => false }) })}, refused {count(fn(h) { (match h { Held::Refused => true, else => false }) })}, {if rows.len() > 2 { "many" } else { "few, some" }}\n"
}

fn short(a: i64) -> String sync {
    // TODO(rs2nika): `format!` with fewer arguments than holes: `{?}` is a missing one
    return f"{a} and {?}"
}

