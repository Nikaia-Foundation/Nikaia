pub fn mine(key: String, own: ref collections::BTreeMap[String, i64]) -> bool sync {
    return !(match key.split_once("::") { (package, _) => own.contains_key(package), null => false })
}
pub fn first_ok(name: String) -> bool sync {
    return (match name.strip_prefix("__t_") { k => !k.is_empty() && k.bytes().all(fn(b) { b.is_ascii_digit() }), null => false })
}
pub fn at(source: String, at: i64) -> i64 sync {
    return (match source.char_indices().nth(at) { (byte, _) => byte, null => source.len() })
}
// ADAPTER: bleibt in Rust (`Ledger`)
pub fn committed(root: ref Path) -> Ledger? sync {
    // ADAPTER: bleibt in Rust (`Ledger`)
    return (match fs::read_to_string(root.join("c"), fs::Root::Anywhere) catch { null } { text => (Ledger::parse(text) catch { null }), null => null })
}
pub fn stays(r: Result[i64, String]) -> i64 sync throws {
    // TODO(rs2nika): `Option::map`/`and_then`: `let x = e ?? <none>` then the body
    return r.map(fn(n) { n + 1 })
}

