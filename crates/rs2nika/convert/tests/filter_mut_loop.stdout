pub fn soften(mut findings: Vec[Finding], on: String) {
    if on != "warn" {
        return
    }
    for mut finding in findings {
        if finding.code != "NK1207" {
            continue
        }
        finding.severity = Severity::Warning
        finding.notes.push("softened")
    }
    for mut item in state.items {
        if !(item.on && item.code != "x") {
            continue
        }
        item.count += 1
    }
    for (a, b) in pairs.iter_mut().filter(fn(p) { p.0 == 1 }) {
        a.push(b)
    }
}

