pub fn soften(mut findings: Vec[Finding], on: String) {
    if on != "warn" {
        return
    }
    for i in 0..<findings.len() {
        if findings[i].code != "NK1207" {
            continue
        }
        findings[i].severity = Severity::Warning
        findings[i].notes.push("softened")
    }
    for i in 0..<state.items.len() {
        if !(state.items[i].on && state.items[i].code != "x") {
            continue
        }
        state.items[i].count += 1
    }
    for (a, b) in pairs.iter_mut().filter(fn(p) { p.0 == 1 }) {
        a.push(b)
    }
}

