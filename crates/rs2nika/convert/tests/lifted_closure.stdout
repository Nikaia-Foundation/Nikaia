fn sum_summary(all: ref Vec[Finding], extra: i64) -> String {
    let findings: Vec[ref Finding] = all.iter().filter(fn(f) { f.error }).collect()
    let mut refused: Vec[String] = []
    let more = fn(n) { n + extra }
    let kept = fn(f) { f.code != "NK1" }
    let types = sum_count(findings, "NK1")
    if types > 0 {
        refused.push(f"{types} type error{sum_plural(types)}")
    }
    let locks = ["NK2203", "NK2204"].iter().map(fn(code) { sum_count(findings, code) }).sum()
    refused.push(f"{more(locks)} more")
    let left: Vec[ref ref Finding] = findings.iter().filter(kept).collect()
    return refused.join(", ")
}

fn sum_count(findings: ref Vec[ref Finding], family: String) -> i64 {
    return findings.iter().filter(fn(f) { f.code.starts_with(family) }).count()
}

fn sum_plural(n: i64) -> String {
    if n == 1 { "" } else { "s" }
}
