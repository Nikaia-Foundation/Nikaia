fn is_call(e: ref Expr) -> bool sync {
    return match e {
        Expr::Call(..) => true,
        Expr::Index(base, ..) => is_call(base),
        Expr::Pair(_, rhs, ..) if rhs.is_empty() => false,
        else => false,
    }
}

enum Shape {
    Pair(Expr, Expr, Span),
    Index(Expr, Expr),
}

fn first_of(s: ref Shape) -> bool sync {
    return match s {
        Shape::Pair(a, ..) => is_call(a),
        Shape::Index(_, i, ..) => is_call(i),
    }
}

fn count(xs: ref Vec[Expr]) -> i64 sync {
    return match xs {
        [first, ..rest] => 1 + count(rest),
        [] => 0,
    }
}

