pub fn gather(units: ref Vec[Unit], mut library: Library, contract: ref Contract, name: String) sync {
    // ADAPTER: bleibt in Rust (`Parsed`)
    let mut packages: collections::BTreeMap[String, Vec[Parsed]] = collections::BTreeMap()
    let mut counts: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for unit in units {
        let mut slot = packages[unit.name]?.clone() ?? []
        slot.push(unit.parsed)
        packages.insert(unit.name.clone(), slot)
        counts.insert(unit.name.clone(), (counts[unit.name] ?? 0) + 1)
    }
    if !library.functions.contains_key(name) {
        library.functions.insert(name.clone(), contract.clone())
    }
    let mut slot = library.seen[name]?.clone() ?? collections::BTreeSet()
    slot.insert(contract.id)
    library.seen.insert(name.clone(), slot)
    // TODO(rs2nika): `.entry(..)`: read with `??`, then write `m.insert(k, v)`
    let held = counts.entry(name.clone()).or_default()
    if project.entry() == name {
        return
    }
}

