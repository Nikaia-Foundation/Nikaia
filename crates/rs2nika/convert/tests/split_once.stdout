pub fn cut(line: String) -> (String, String)? sync {
    let (key, value) = line.split_once('=') ?? return null
    return (key.trim().clone(), value.to_string())
}
pub fn owner(path: String) -> (String, String) sync {
    return path.rsplit_once("::") ?? ("", path)
}
pub fn none_yet() -> (String, i64)? sync {
    let found: (String, i64)? = null
    return found
}

