use std::collections
fn s_get(codegen: ref Codegen) -> u32 {
    return codegen.n
}
fn s_twice(codegen: ref Codegen) -> u32 {
    return s_get(codegen) * 2
}
fn s_bump(mut codegen: Codegen) {
    codegen.n += 1
}
fn s_make() -> u32 {
    return s_helper() + 1
}
fn s_helper() -> u32 {
    return 3
}
