pub fn port(n: i64) -> String sync {
    let p = half(n) catch { null }
    return show(p)
}

pub fn report(n: i64) sync {
    match half(n) catch { null } {
        v => {
            println(f"got {v}")
        },
        null => {},
    }
}

pub fn quiet(n: i64) sync {
    match half(n) catch { null } {
        v => println(f"half {v}"),
        null => {},
    }
}

pub fn touched(n: i64) sync {
    if (half(n) catch { null }) != null {
        println("even")
    }
}

pub fn even(n: i64) -> bool sync {
    return (half(n) catch { null }) != null
}

pub fn odd(n: i64) -> bool sync {
    return (half(n) catch { null }) == null
}

pub fn not_odd(n: i64) -> bool sync {
    return (half(n) catch { null }) != null
}

pub fn four(n: i64) -> bool sync {
    return (match half(n) catch { null } { v => v == 4, null => false })
}

pub fn kept(n: i64) -> i64? sync {
    return half(n) catch { null }
}

pub fn quartered(n: i64) -> String sync {
    let q = match half(n) catch { null } {
        v => v / 2,
        null => 0,
    }
    return f"{q}"
}

