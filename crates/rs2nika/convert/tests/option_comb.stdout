pub fn tail_of(block: ref Block) -> ref Expr? sync {
    return block.stmts.last()?.node
}

pub fn named(t: ref Ty?) -> bool sync {
    return (t?.is_named() ?? false)
}

pub fn width(t: ref Ty?) -> i64 sync {
    return (t?.name?.len() ?? 0)
}

pub fn sizes(xs: ref Vec[Ty]) -> Vec[i64] sync {
    return xs.iter().map(fn(x) { x.size }).collect()
}

