use std::collections
use std::fs

/// A refusal, in the words the compiler reports.
pub enum FsFormsRefusal {
    Refused(String),
}

impl Error for FsFormsRefusal {
    fn message(ref self) -> String {
        return match self {
            FsFormsRefusal::Refused(why) => why.clone(),
        }
    }
}

pub struct Own {
    pub root: fs::Path,
    pub variant: String?,
}

fn fs_forms_tag(own: ref Own) -> String {
    let mut named = own.root.display()
    if own.variant != null {
        let variant = own.variant.clone()
        named.push_str(variant)
    }
    return named
}

fn fs_forms_copy(root: ref fs::Path, built: ref fs::Path) -> fs::Path throws {
    let dir = root.join("bin")
    fs::create_dir(dir, fs::Root::Anywhere; recursive: true)
    let name = (built.file_name() ?? throw FsFormsRefusal::Refused("a program has a file name"))
    let own = dir.join(name)
    fs::remove(own, fs::Root::Anywhere) catch {}
    if fs::exists(own, fs::Root::Anywhere) {
        throw FsFormsRefusal::Refused(f"still there: {own.display()}")
    }
    return own
}
