pub fn emit_x_parse(name: String) -> Target throws {
    return match known(name) {
        k => k,
        null => {
            throw Refused::Because(f"There's no target called `{name}`. Use x86_64-linux, or a triple from `rustc --print target-list`.")
        },
    }
}

pub fn emit_x_check(n: i64) throws {
    let e = Refused::Because(f"too many: {n}")
    throw e
}

