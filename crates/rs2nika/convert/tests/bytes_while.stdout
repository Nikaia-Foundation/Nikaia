fn shown(byte: u8) -> String sync {
    return match byte {
        92 | 39 => f"b'\\{(byte as u8) as scalar}'",
        0x20..0x7e => f"b'{(byte as u8) as scalar}'",
        127 | 10 => "odd".clone(),
        else => f"b'\\x{byte:02x}'",
    }
}

fn peeled(mut value: ref Expr) -> ref Expr sync {
    while true {
        let block = match value { Expr::Block(block, _) => block, else => break }
        let tail = tail_of(block) ?? break
        value = tail
    }
    return value
}

