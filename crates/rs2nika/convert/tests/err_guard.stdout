fn run_all() -> ExitCode sync {
    run() catch {
        if is_a_refusal(error) {
            eprintln(f"{error:#}")
            return ExitCode::FAILURE
        }
        eprintln(f"Error: {error}")
        return ExitCode::FAILURE
    }
    return ExitCode::SUCCESS
}

fn size(path: ref Path) -> u64 sync {
    let m = fs::metadata(path) catch {
        let e = error
        if e.kind() == io::ErrorKind::NotFound {
            return 0
        }
        return 1
    }
    return m.len()
}

fn last(path: ref Path) -> u64 sync {
    // TODO(rs2nika): `match` on `Ok`/`Err`: a guard on an `Ok`/`Err` arm: `let v = call catch { <the Err arms> }`, a guard of `Err` as an `if` inside the block, one of `Ok` as an `if` after it
    return match fs::metadata(path) {
        Ok(m) => m.len(),
        Err(e) if e.kind() == io::ErrorKind::NotFound => 0,
    }
}

