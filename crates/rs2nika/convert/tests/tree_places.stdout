use std::collections

pub struct Tally {
    pub seen: collections::HashMap[String, i64],
    pub names: Vec[String],
    pub total: i64,
}

pub struct Walk {
    pub names: ref Vec[String],
    pub tally: Tally,
}

pub fn t_count(names: ref Vec[String]) -> Tally {
    let walk = Walk { names: names, tally: Tally { seen: collections::HashMap(), names: [], total: 0 } }
    return walk.tally
}

pub fn t_grow(mut views: Vec[Tally], from: i64) {
    for view_ in views.iter_mut() /* TODO(rs2nika): `iter_mut` outside a `for` over the list itself (an adapter, a map): not decided yet (ADR-views-2 section 6); `for mut x in xs` walks a list in place */.skip(from) {
        view_.total += 1
    }
}

pub fn t_says(count: i64) -> String {
    let msg = f"a message long enough that the syntax tree's dump shortens it: {count}"
    return msg
}