/// Whether the goal is proved under no facts.
pub fn ac_answer(arena: ref TermArena, goal: i64, ask: fn(ref TermArena, ref Vec[i64], i64) -> ProofsAsked sync) -> bool {
    return ask(arena, [], goal) == Asked::Proved
}

/// Whether both goals are proved: `answer` asks, so this one passes it on.
pub fn ac_both(arena: ref TermArena, a: i64, b: i64, ask: fn(ref TermArena, ref Vec[i64], i64) -> ProofsAsked sync) -> bool {
    return ac_answer(arena, a, ask) && ac_answer(arena, b, ask)
}

/// Asks nothing: no parameter.
pub fn ac_width(a: i64) -> i64 {
    return a + 1
}