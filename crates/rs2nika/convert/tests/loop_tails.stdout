/// The keys that were inferred.
fn lost(keys: ref Vec[String], committed: ref collections::BTreeMap[String, Contract], pauses: ref collections::BTreeMap[String, i64]) -> String {
    let mut out: String = ""
    for key in keys {
        if key.is_empty() {
            continue
        }
        let before = committed.get(key) ?? continue
        if !inferred_sync(before.sync_claim) {
            continue
        }
        // nothing to point at
        let unit = pauses.get(key) ?? {
            out.push_str(key)
            continue
        }
        out.push_str(f"{key} {unit}")
    }
    return out
}

/// Both ledgers, merged.
// ADAPTER: bleibt in Rust (`Ledger`)
fn merged(mut library: Ledger, own: ref Ledger, renames: ref collections::BTreeMap[String, String]) -> Ledger {
    absorb_into(library, null, renames, own.clone())
    return library
}

