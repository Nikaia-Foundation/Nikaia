pub fn emit_x_pick(e: ref Expr) -> i64 {
    let (callee, given) = match e {
        Expr::Call { name, args } => (name.clone(), args),
        else => return 0,
    }
    return given.len()
}

pub fn emit_x_first(items: ref Vec[Item]) -> i64 {
    for m in items {
        let (name, args, ret) = match m.node { Item::Fn { name, args, ret_type: ret, .. } => (name ?? continue, args, ret ?? continue), else => continue }
        return args.len()
    }
    return 0
}

pub fn emit_x_named(mut bodies: Vec[Body], name: String) {
    bodies.push(Body { name: name })
}

