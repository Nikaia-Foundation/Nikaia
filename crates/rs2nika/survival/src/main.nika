// crates/rs2nika/survival/src/main.nika
//
// **How many rs2nika drafts survive `nikaia check`** (#579). The material is
// the Rust of `check/mod.rs` before the three commits of
// docs/selfhosting-gaps.md; each function is converted alone
// (`rs2nika --profile check --file --prefix survival_ --only NAME`) and the
// draft is checked **in context**: as one more file of a scratch project that
// holds a copy of `crates/nikaia-std/src/tools/*.nika` (the compiler's types
// already in Nikaia) and the tools' described Rust crates as the project's own
// `contracts/<crate>.contracts`. A type still unknown in the draft gets an
// empty stub `struct` in `zz_survival_stubs.nika` and the draft is checked
// again. Only findings located in the draft count: the copy's own are the
// baseline.
//
//     cd crates/rs2nika/convert && nikaia build
//     cd ../survival && nikaia run [-- NIKAIA]     # NIKAIA defaults to `nikaia`

use std::cli
use std::fs
use std::process

struct Survival_Case {
    commit: String,
    name: String,
    /// `old`: the thirteen of docs/selfhosting-gaps.md; `new`: later moves.
    set: String,
}

fn survival_add(cases: Vec[Survival_Case], commit: ref String, set: ref String, names: Vec[ref String]) -> Vec[Survival_Case] {
    let mut out = cases
    for name in names {
        out.push(Survival_Case { commit: commit.clone(), name: name.clone(), set: set.clone() })
    }
    return out
}

fn survival_cases() -> Vec[Survival_Case] {
    let mut cases: Vec[Survival_Case] = []
    // `payload_of` stays in Rust (an adapter over `Held`), so it is no case.
    cases = survival_add(cases, "5755b65", "old", ["several_errors", "wholly_known", "a_map", "is_a_literal_other_than", "a_copied_part"])
    cases = survival_add(cases, "3e26691", "old", ["tail_of", "articles", "unpromised"])
    cases = survival_add(cases, "07c5b14", "old", ["claims_report", "byte_literal", "peeled", "an_or_a"])
    cases = survival_add(cases, "61822b0", "new", ["an_exit_code_out_of_range", "an_operator_needs_a_bound", "a_fatal_error_passes"])
    cases = survival_add(cases, "f6208c6", "new", ["arms_that_disagree", "a_write_that_skips_the_door"])
    cases = survival_add(cases, "3e9216a", "new", ["an_operation_that_overflows", "collect_copies", "collect_types"])
    cases = survival_add(cases, "0c4c693", "new", ["value_leaves", "arms_to_ask", "note_mixed", "views_meet_owned_text", "hands_over", "a_map_key"])
    cases = survival_add(cases, "a77a8e6", "new", ["a_view_kept_where_the_receiver_says_text"])
    return cases
}

fn survival_dir(root: ref fs::Root) -> String throws {
    return match root {
        fs::Root::Dir(path) => path.to_text(),
        else => panic("fs::scratch() hands back a Dir"),
    }
}

/// The described ledger's header and the sections of one crate (`"node_id::..`).
fn survival_contracts_of(ledger: ref String, crate_: ref String) -> String {
    let mut out: String = ""
    let mut keep = true
    let mark = f"\"{crate_}::"
    for line in ledger.lines() {
        if line.starts_with("[") {
            keep = line.contains(ref mark)
        }
        if keep {
            out = f"{out}{line}\n"
        }
    }
    return out
}

/// The scratch project around the drafts: the tools' sources and descriptions.
fn survival_project(root: ref fs::Root, dir: ref String, tools: ref String) -> bool throws {
    fs::create_dir("ctx", root; recursive: true)
    let made = process::run("cp", ["-rT", tools.clone(), f"{dir}/ctx/src"])
    if !made.ok {
        println(f"COPY  {made.stderr}")
        return false
    }
    let gone = process::run("rm", [f"{dir}/ctx/src/described.contracts"])
    if !gone.ok {
        return false
    }
    fs::create_dir("ctx/contracts", root; recursive: true)
    let ledger = process::run("cat", [f"{tools}/described.contracts"]).stdout
    let mut toml: String = "[package]\nname = \"survival_ctx\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
    for c in ["node_id", "winnow_grammar"] {
        fs::write(f"ctx/contracts/{c}.contracts", root, survival_contracts_of(ledger, c))
        toml = f"{toml}{c} = {{ type = \"rust\", version = \"0.1\" }}\n"
    }
    fs::write("ctx/nikaia.toml", root, toml)
    return true
}

/// The findings of a check that point into `file`, as their header lines.
fn survival_in(said: ref String, file: ref String) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut head: String = ""
    for line in said.lines() {
        if line.starts_with("error") {
            head = line.clone()
        } else if head != "" && line.trim().starts_with("-->") {
            if line.contains(ref file) {
                out.push(head.clone())
            }
            head = ""
        }
    }
    return out
}

/// The type a finding names as unknown, or "".
fn survival_unknown_type(head: ref String) -> String {
    let words = ["unknown type", "no type called", "isn't a type", "is not a type", "no type named"]
    let mut said = false
    for w in words {
        if head.contains(w) {
            said = true
        }
    }
    if !said {
        return ""
    }
    let mut name: String = ""
    let mut at = 0
    for part in head.split("`") {
        if at == 1 {
            name = part.clone()
        }
        at += 1
    }
    if name == "" || name.contains(" ") || name.contains("::") || name.contains("[") {
        return ""
    }
    return name
}

fn survival_stub_list(stubs: ref Vec[String]) -> String {
    if stubs.len() == 0 {
        return ""
    }
    let mut out: String = " (stubs:"
    for t in stubs {
        out = f"{out} {t}"
    }
    return f"{out})"
}

fn main() throws {
    let mut nikaia: String = "nikaia"
    for a in cli::args() {
        nikaia = a.clone()
    }
    let rs2nika = "../convert/target/nikaia/bin/rs2nika"
    let root = fs::scratch()
    let dir = survival_dir(root)
    if !survival_project(root, dir, "../../nikaia-std/src/tools") {
        return
    }
    // every draft goes into the project at once: one check a round, not one a case
    let cases = survival_cases()
    let mut drafted: Vec[bool] = []
    for case in cases {
        let rust = f"{dir}/{case.commit}.rs"
        let shown = process::run("git", ["show", f"{case.commit}^:crates/nikaia/src/check/mod.rs"]; dir: ".")
        if !shown.ok {
            println(f"GIT   {case.commit}: {shown.stderr}")
            drafted.push(false)
            continue
        }
        fs::write(f"{case.commit}.rs", root, shown.stdout)
        let draft = process::run(rs2nika, ["--profile", "check", "--file", "--prefix", "survival_", "--only", case.name.clone(), rust.clone()])
        if !draft.ok {
            println(f"NONE  {case.name}: {draft.stderr.trim()}")
            drafted.push(false)
            continue
        }
        fs::write(f"ctx/src/zz_{case.name}.nika", root, draft.stdout)
        drafted.push(true)
    }
    // a draft that does not parse stops every type check: it fails on its
    // own and leaves the project before the next round
    let mut unparsed: Vec[String] = []
    for case in cases {
        unparsed.push("")
    }
    let mut stubs: Vec[String] = []
    let mut said: String = ""
    let mut rounds = 0
    while rounds < 8 + cases.len() {
        rounds += 1
        let mut text: String = ""
        for t in stubs {
            text = f"{text}struct {t} {{}}\n"
        }
        fs::write("ctx/src/zz_survival_stubs.nika", root, text)
        let checked = process::run(nikaia, ["check", f"{dir}/ctx/src/zz_survival_stubs.nika"])
        said = f"{checked.stdout}\n{checked.stderr}"
        let mut grew = false
        let mut k = 0
        while k < cases.len() {
            let file = f"zz_{cases[k].name}.nika"
            for head in survival_in(said, file) {
                if !head.contains("[NK") && drafted[k] && unparsed[k] == "" {
                    unparsed[k] = head.clone()
                    let gone = process::run("rm", [f"{dir}/ctx/src/{file}"])
                    grew = gone.ok
                }
            }
            k += 1
        }
        for head in survival_in(said, "/ctx/src/zz_") {
            let t = survival_unknown_type(head)
            if t != "" && !stubs.contains(t) {
                stubs.push(t.clone())
                grew = true
            }
        }
        if !grew {
            break
        }
    }
    println(f"stubs:{survival_stub_list(stubs)}")
    let mut passed = 0
    let mut total = 0
    let mut passed_old = 0
    let mut total_old = 0
    let mut at = 0
    while at < cases.len() {
        let set: String = cases[at].set.clone()
        let name: String = cases[at].name.clone()
        let ok = drafted[at]
        at += 1
        total += 1
        if set == "old" {
            total_old += 1
        }
        if !ok {
            continue
        }
        let mut found = survival_in(said, f"zz_{name}.nika")
        if unparsed[at - 1] != "" {
            found = [unparsed[at - 1].clone()]
        }
        if found.len() == 0 {
            passed += 1
            if set == "old" {
                passed_old += 1
            }
            println(f"PASS  {set} {name}")
        } else {
            println(f"FAIL  {set} {name}: {found.len()} error(s), first: {found[0]}")
        }
    }
    println(f"old set: {passed_old} of {total_old}; new set: {passed - passed_old} of {total - total_old}")
    println(f"{passed} of {total} drafts pass `nikaia check` in context")
}
