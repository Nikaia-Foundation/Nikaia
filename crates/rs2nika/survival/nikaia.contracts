# AUTO-GENERATED by `nikaia`. Commit this file like a lockfile.
# Do not edit by hand - it is regenerated on every build.
#
# What a caller has to know about a function it cannot see the body of:
# whether it may pause (`sync`), whether it may fail and with what
# (`throws`), and what its result may point into (`returns`). Part III, 13.5.
#
# A `"?"` among the errors is the absence of a claim: it fails, with
# something this compiler cannot name.
version = 3

[fn."main"]
throws = ["?", "io::IoError"]
locks = true
signature = "()"

[fn."survival_add"]
sync = "inferred"
keeps = ["cases"]
touches = []
views = ["commit: borrowed", "set: borrowed", "names: borrowed"]
signature = "(cases: Vec[Survival_Case], commit: ref String, set: ref String, names: Vec[ref String]) -> Vec[Survival_Case]"

[fn."survival_cases"]
sync = "inferred"
touches = []
signature = "() -> Vec[Survival_Case]"

[fn."survival_contracts_of"]
sync = "inferred"
touches = []
views = ["ledger: borrowed", "crate_: borrowed"]
signature = "(ledger: ref String, crate_: ref String) -> String"

[fn."survival_dir"]
sync = "inferred"
throws = ["?", "io::IoError"]
locks = "?"
views = ["root: borrowed"]
signature = "(root: ref fs::Root) -> String"

[fn."survival_in"]
sync = "inferred"
touches = []
views = ["said: borrowed", "file: borrowed"]
signature = "(said: ref String, file: ref String) -> Vec[String]"

[fn."survival_project"]
throws = ["io::IoError"]
locks = true
views = ["root: borrowed", "dir: borrowed", "tools: borrowed"]
signature = "(root: ref fs::Root, dir: ref String, tools: ref String) -> bool"

[fn."survival_stub_list"]
sync = "inferred"
touches = []
views = ["stubs: borrowed"]
signature = "(stubs: ref Vec[String]) -> String"

[fn."survival_unknown_type"]
sync = "inferred"
touches = []
views = ["head: borrowed"]
signature = "(head: ref String) -> String"

[type."Survival_Case"]
fields = ["commit: String", "name: String", "set: String"]
