// crates/nikaia-std/src/runtime/target.nika
//
// **What a named CPU level has** (ADR-371 D6), written in Nikaia: the table
// `target::has` reads in a build-time run, where the level is the name the
// compiler hands over (`--cpu`) rather than what the code was compiled with.
//
// `src/target.rs` re-exports `Instruction` as `nikaia_std::target::Instruction`
// and keeps what Nikaia has no word for: `cfg!(target_feature)` for the level
// a program was compiled at, and the detection of this machine's instructions
// for `native`. `std.contracts` writes the type's entry by hand.

/// An instruction a CPU level may have.
pub enum Instruction {
    /// CRC-32C of a word: SSE 4.2 on x86-64, `crc` on AArch64.
    Crc32c,
    /// x86-64's BMI2 (`pext`, `pdep`, shifts without flags).
    Bmi2,
    /// x86-64's 256-bit integer vectors.
    Avx2,
}

/// Whether the CPU level named `level` has `i`: `x86-64-v2` has CRC-32C,
/// `x86-64-v3` and `x86-64-v4` have all three, and every other name - the
/// baseline `x86-64`, the empty text of no level - has none. `native` is not
/// a name this table knows: what this machine has is asked of the machine.
pub fn level_has(level: ref String, i: Instruction) -> bool sync {
    return match level {
        "x86-64-v2" => i == Instruction::Crc32c,
        "x86-64-v3" | "x86-64-v4" => true,
        else => false,
    }
}
