// crates/nikaia-std/src/runtime/abort_lines.nika
//
// **Where a stop is reported** (#2120): the `.nika` line for a line of the
// generated file, found in the program's table of sites. `src/abort.rs`'s
// panic hook asks it with the table the emitter wrote and reads the found
// entry's file and line itself, so nothing is copied while the program stops.

/// Where in `table` the entry of generated line `generated` is, where `line`
/// reads an entry's generated line; nothing where the table lacks the line,
/// and the hook then lets Rust's own message speak.
pub fn lookup[T](table: ref Vec[T], generated: int, line: fn(ref T) -> int sync) -> int? sync {
	// The emitter writes a table sorted by its generated lines; `std`
	// assumes nothing (ADR-376, NK1295), so the order is looked at, and a
	// table out of order answers nothing rather than a wrong line.
	if !table.is_sorted_by_key(line) {
		return null
	}
	return table.binary_search_by_key(generated, line)
}

/// A table of three sites, sorted by their generated lines.
fn sites() -> Vec[(int, String, int)] sync {
	return [(10, "src/main.nika", 3), (24, "src/parse.nika", 41), (99, "src/main.nika", 7)]
}

/// The half that keeps a program from being worse off: a line the table does
/// not know is not answered wrongly.
test "an unknown line is not guessed at" {
	let table = sites()
	let eleven = lookup(table, 11, fn(site) { site.0 })
	assert(eleven == null)
	let one = lookup(table, 1, fn(site) { site.0 })
	assert(one == null)
	let thousand = lookup(table, 1000, fn(site) { site.0 })
	assert(thousand == null)
	let none: Vec[(int, String, int)] = []
	let empty = lookup(none, 10, fn(site) { site.0 })
	assert(empty == null)
}

/// A line the table knows is answered with its place, which holds its file
/// and line.
test "a known line is answered" {
	let table = sites()
	let found = lookup(table, 24, fn(site) { site.0 })
	assert((found ?? -1) == 1)
	assert(table[1].1 == "src/parse.nika")
	assert(table[1].2 == 41)
}
