// crates/nikaia-std/src/runtime/paths.nika
//
// **A path from outside proved by a property of its own, and a root for a
// directory a program walks** (ADR-raw-sinks-1 D12, D13, D14), written in
// Nikaia.
//
// `is_component` and `is_below` are `std::path`'s predicates: `lib.rs`
// re-exports them as `nikaia_std::path::*`, and `std.contracts` writes their
// entries by hand, as for `html::is_plain`. Each is a pure `bool` call, so a
// guard on it is a fact the prover reads (ADR-381 D1, ADR-396 D2).
//
// `root_join` and `root_path` are `fs::Root::join` and `fs::Root::path`: the
// emitter writes such a method call as a call of the function here
// (`emit_core_calls.nika`, `emit_call_span_function`), since `fs::Root` is the
// Rust enum of `fs.rs` and a method on it is not declared from a `.nika` file.

use std::fs

/// Whether `p` is one component of a path: not empty, not `.` or `..`, and
/// no separator, `/` or `\` (ADR-raw-sinks-1 D14). A name `fs::read_dir`
/// hands back is one.
pub fn is_component(p: String) -> bool sync {
    if p == "" || p == "." || p == ".." {
        return false
    }
    for c in p.scalars {
        if c == '/' || c == '\\' {
            return false
        }
    }
    return true
}

/// Whether `p` stays below the directory it is joined to: relative, with no
/// root (`/` or `\` first), no drive letter (`C:`) and no `..` component
/// (ADR-raw-sinks-1 D14). `.` and `a/./b` are below.
pub fn is_below(p: String) -> bool sync {
    let mut at = 0
    let mut letter = false
    let mut len = 0
    let mut dots = 0
    for c in p.scalars {
        let separator = c == '/' || c == '\\'
        if at == 0 {
            if separator {
                return false
            }
            letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        }
        if at == 1 && letter && c == ':' {
            return false
        }
        at += 1
        if separator {
            if len == 2 && dots == 2 {
                return false
            }
            len = 0
            dots = 0
        } else {
            len += 1
            if c == '.' {
                dots += 1
            }
        }
    }
    return !(len == 2 && dots == 2)
}

/// `root.join(part)`: a root for the directory `part` under `root`, under
/// the same check (ADR-raw-sinks-1 D13); `Anywhere` stays `Anywhere`.
pub fn root_join(root: ref fs::Root, part: ref fs::Path) -> fs::Root sync {
    return match root {
        fs::Root::Dir(dir) => fs::Root::Dir(dir.join(part)),
        fs::Root::Anywhere => fs::Root::Anywhere,
    }
}

/// `root.path()`: the directory of a `Dir`, for a program's argument
/// (ADR-raw-sinks-1 D12); `.` for `Anywhere`, which hands a name to the
/// operating system as written, so `f"{root.path()}/x"` names the file
/// `root` opens for `"x"` under either root.
pub fn root_path(root: ref fs::Root) -> fs::Path sync {
    let here: fs::Path = "."
    return match root {
        fs::Root::Dir(dir) => dir.clone(),
        fs::Root::Anywhere => here,
    }
}
