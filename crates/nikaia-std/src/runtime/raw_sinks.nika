// crates/nikaia-std/src/runtime/raw_sinks.nika
//
// **The preconditions of `std`'s raw sinks, written in Nikaia**
// (ADR-raw-sinks-1 D2, #1253): what an outside part of a text must be before
// it may reach a sink that reads text as code. Each is a pure `bool` call, so
// the prover reads it as a property (ADR-381 D1): a guard
// `throw BadInput(name) if !html::is_plain(name)` makes it a fact, and a
// sink's precondition is proved from it. `std` runs no shell, so it has no
// shell precondition (ADR-raw-sinks-1 D9).
//
// `src/html.rs` re-exports `is_plain` as `nikaia_std::html::is_plain`, and
// `src/process.rs` `is_operand` as `nikaia_std::process::is_operand`;
// `std.contracts` writes its entry by hand, as for `env::vars`.
// `db::is_identifier` is the `db` package's (`packages/db/src/main.nika`).

use std::html

/// Whether `part` holds none of the characters markup reads as more than
/// text: `&`, `<`, `>`, `"` and `'` (ADR-raw-sinks-1 D2, the precondition of
/// `html::Raw`). The empty text is plain.
pub fn is_plain(part: ref String) -> bool sync {
    for c in part.scalars {
        let steers = match c {
            '&' => true,
            '<' => true,
            '>' => true,
            '"' => true,
            '\'' => true,
            else => false,
        }
        if steers {
            return false
        }
    }
    return true
}

/// Whether `text` is read as an operand, not as an option: it starts with
/// neither `-` nor `/` (ADR-raw-sinks-1 D18, the precondition of the start of
/// each argument of `process::run`). A program reads a word that starts with
/// `-` as an option, and a Windows program one that starts with `/`
/// (`findstr /G:file`); a program is built once for every target, so both
/// are refused on every target (D18 item 6). A path that is meant passes as
/// `"./" + name` or under a root. The empty text is one. A guard
/// `if !process::is_operand(name) { process::exit(2) }` makes it a fact.
pub fn is_operand(text: ref String) -> bool sync {
    return !text.starts_with("-") && !text.starts_with("/")
}

/// The safe way in: escape first, and the result is markup by construction,
/// not escaped twice when it is written out again (`src/html.rs`, #2304).
test "escaped text becomes markup" {
    let markup = html::Raw::escaped("a < b & c")
    assert(markup.as_str() == "a &lt; b &amp; c")
    assert(html::Raw(markup.as_str()).as_str() == "a &lt; b &amp; c")
}

/// A word that starts with `-` or `/` is an option, anything else an
/// operand (ADR-raw-sinks-1 D18, item 6).
test "an operand starts with neither a dash nor a slash" {
    assert(is_operand("file.txt"))
    assert(is_operand(""))
    assert(is_operand("a-b"))
    assert(is_operand("a/b"))
    assert(is_operand("./x"))
    assert(!is_operand("-rf"))
    assert(!is_operand("--checkpoint-action=exec=sh"))
    assert(!is_operand("/G:secrets.txt"))
    assert(!is_operand("/etc/passwd"))
}
