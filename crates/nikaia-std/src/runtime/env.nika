// crates/nikaia-std/src/runtime/env.nika
//
// **`env::vars(prefix)`, written in Nikaia** (#1601, Part III 14.2
// `std::env`): the environment's variables whose name starts with `prefix`,
// as (name, value) pairs sorted by name.
//
// The operating system's list is the one Rust primitive, `env::pairs()` in
// `src/env.rs`: the raw pairs and nothing more. What a program sees is decided
// here, the launcher's variables it does not see included (ADR-program-path-1
// D3, #2034). `src/env.rs` re-exports this function as
// `nikaia_std::env::vars`, and the two names and `launcher_var` under their
// old paths, which `env::var`, `process.rs` and the toolchain use; and
// `std.contracts` writes its entry by hand, because it carries what no source
// infers: the provenance, the operator's unless a name a CGI host fills can
// start with the prefix (ADR-397 D1, D2), which the compiler decides by the
// prefix written and this function never sees.

use std::env
use std::process

/// **The variable a launcher hands the program it started in**
/// (ADR-program-path-1 D3): the path `env::current_exe` answers, set by
/// `nikaia run` and `nikaia test` to the `nikaia` that was started.
pub comptime EXE_VAR: ref String = "NIKAIA_EXE"

/// **The variable a launcher hands the file the program stands in as**
/// (ADR-program-path-1 D3): the path `env::current_main` answers, set by
/// `nikaia run` to the `.nika` file it was given and by `nikaia test` to the
/// test's file.
pub comptime MAIN_VAR: ref String = "NIKAIA_MAIN"

/// **Whether `name` is one of the launcher's variables**, which a program
/// does not see (ADR-program-path-1 D3): `env::var` answers nothing for it,
/// `env::vars` leaves it out, and a process the program starts does not
/// inherit it (`process.rs`), so a child never takes its parent's answer.
pub fn launcher_var(name: String) -> bool sync {
    return name == EXE_VAR || name == MAIN_VAR
}

/// **The line a privileged start ends with** (ADR-397 D3): `program`, the
/// name it was started under, was started with more rights than its caller,
/// its manifest does not declare the environment untrusted, and the line to
/// add. `env.rs`'s `stop_a_privileged_start` writes it and ends with status 1.
pub fn privileged_start_line(program: String) -> String sync {
    return f"error: `{program}` was started with more rights than its caller (setuid, setgid or file capabilities), and its manifest does not declare the environment untrusted, so the caller chose every variable it would read. A program meant to start so declares `[build] environment = \"untrusted\"` in its `nikaia.toml` (ADR-397 D3, D4)."
}

/// The variables whose name starts with `prefix`, sorted by name.
///
/// It sees what `env::var` sees: a variable whose name or value is not
/// Unicode, or whose value is empty, is left out, and so is a launcher's
/// variable, so the list holds no name `env::var` calls null.
pub fn vars(prefix: String) -> Vec[(String, String)] sync {
    let mut listed: Vec[(String, String)] = []
    for pair in env::pairs() {
        let name = pair.0.text() catch { continue }
        let value = pair.1.text() catch { continue }
        if value.is_empty() || !name.starts_with(prefix) || launcher_var(name) {
            continue
        }
        listed.push((name.clone(), value.clone()))
    }
    listed.sort()
    return listed
}

/// **Whether two environment names are the same variable** (ADR-243 D5):
/// byte for byte, or without regard to ASCII case where `windows`.
pub fn same_name(a: Bytes, b: Bytes, windows: bool) -> bool sync {
    if windows {
        return a.eq_ignore_ascii_case(b)
    }
    return a == b
}

/// **Which entries a child's environment holds** (ADR-243 D5): the caller's
/// `inherited` names, or none where `clear`, without each name in `remove`
/// or in `set`; then each name of `set`, in order, but one a later name of
/// `set` replaces. Names compare as the platform compares them, `windows`
/// saying which (ADR-243 D6's input, as `found_on_path` takes it). The answer
/// is positions: `i` below `inherited.len()` is the inherited entry `i`, and
/// `inherited.len() + j` the pair `j` of `set`. `process.rs` builds the
/// environment from them out of its own `OsString`s, which Nikaia has no type
/// for (#2131).
pub fn merged(inherited: ref Vec[Bytes], clear: bool, remove: ref Vec[Bytes], set: ref Vec[Bytes], windows: bool) -> Vec[i64] sync {
    let mut kept: Vec[i64] = []
    if !clear {
        for (i, name) in inherited.iter().enumerate() {
            if !remove.iter().any(fn(r) { same_name(name, r, windows) })
                && !set.iter().any(fn(s) { same_name(name, s, windows) }) {
                kept.push(i)
            }
        }
    }
    for (j, name) in set.iter().enumerate() {
        if !set.iter().skip(j + 1).any(fn(s) { same_name(name, s, windows) }) {
            kept.push(inherited.len() + j)
        }
    }
    return kept
}

test "a child's environment names compare without case on Windows" {
    let inherited: Vec[Bytes] = ["Path".bytes, "path".bytes]
    assert(merged(inherited, false, [], ["PATH".bytes], true) == [2])
    assert(merged(inherited, false, ["PATH".bytes], [], true).is_empty())
    assert(merged(inherited, false, [], ["PATH".bytes], false) == [0, 1, 2])
    assert(merged(inherited, false, ["PATH".bytes], [], false) == [0, 1])
}

test "a later pair of a name replaces an earlier one, and clear drops all inherited" {
    let inherited: Vec[Bytes] = ["A".bytes, "B".bytes]
    assert(merged(inherited, false, [], ["B".bytes, "C".bytes, "b".bytes], false) == [0, 2, 3, 4])
    assert(merged(inherited, false, [], ["B".bytes, "C".bytes, "b".bytes], true) == [0, 3, 4])
    assert(merged(inherited, true, [], ["A".bytes], false) == [2])
}
