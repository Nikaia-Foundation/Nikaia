// crates/nikaia-std/src/runtime/env.nika
//
// **`env::vars(prefix)`, written in Nikaia** (#1601, Part III 14.2
// `std::env`): the environment's variables whose name starts with `prefix`,
// as (name, value) pairs sorted by name.
//
// The operating system's list is the one Rust primitive, `env::pairs()` in
// `src/env.rs`: the raw pairs and nothing more. What a program sees is decided
// here. `src/env.rs` re-exports this function as `nikaia_std::env::vars`, and
// `std.contracts` writes its entry by hand, because it carries what no source
// infers: the provenance, untrusted unless the call says `trusted: true`
// (ADR-397 D1, D2). The marker is said to the compiler and never reaches this
// function, as at every source (ADR-365 D2).

use std::env

/// The variables whose name starts with `prefix`, sorted by name.
///
/// It sees what `env::var` sees: a variable whose name or value is not
/// Unicode, or whose value is empty, is left out, so the list holds no name
/// `env::var` calls null.
pub fn vars(prefix: String) -> Vec[(String, String)] sync {
    let mut listed: Vec[(String, String)] = []
    for pair in env::pairs() {
        let name = pair.0.text() catch { continue }
        let value = pair.1.text() catch { continue }
        if value.is_empty() || !name.starts_with(prefix) {
            continue
        }
        listed.push((name.clone(), value.clone()))
    }
    listed.sort()
    return listed
}
