// crates/nikaia-std/src/tools/prover_calls.nika
//
// **What the prover reads of a call's callee** (ADR-269), moved from the
// compiler's `prove` (ADR-294, #436 step 4): a free function of this
// program by name, whether a call may throw out of the function it
// stands in, and whether a value came from outside the program.

use std::collections

/// What the prover reads of a free function of this program.
pub struct FreeFunction {
    /// Its parameters' names, in order: the subject parameters, then the
    /// options (Part I 5.1) in the order they are declared.
    pub params: Vec[String],
    /// Its options' names and defaults, in the order they are declared.
    pub options: Vec[(String, Expr)],
    /// It `throws`.
    pub can_throw: bool,
    /// It hands back a whole number.
    pub whole_result: bool,
}

/// The free function of `program` named `wanted`: not a method, which a call
/// by name never reaches.
pub fn free_function(program: ref Program, words: ref winnow_grammar::InternerContext, wanted: ref String) -> FreeFunction? {
    for item in program.items {
        match item.node {
            Item::Fn { name, receiver, args, config, ret_type, can_throw, .. } => {
                if receiver == null && named_as(name, words, wanted) {
                    let mut params: Vec[String] = []
                    for arg in args {
                        params.push(words.resolve(arg.name).clone())
                    }
                    let mut options: Vec[(String, Expr)] = []
                    for option in config {
                        params.push(words.resolve(option.name).clone())
                        options.push((words.resolve(option.name).clone(), option.default.clone()))
                    }
                    return FreeFunction { params: params, options: options, can_throw: can_throw, whole_result: whole_type(ret_type, words) }
                }
            },
            else => {},
        }
    }
    return null
}

/// The method `wanted` of `owner`'s own `impl` (not a trait's), as a call
/// `self.wanted(…)` in a method of `owner` reaches it: its parameters without
/// the receiver (#776).
pub fn own_method(program: ref Program, words: ref winnow_grammar::InternerContext, owner: ref String, wanted: ref String) -> FreeFunction? {
    for item in program.items {
        match item.node {
            Item::Impl { methods, target, trait_name } => {
                if trait_name == null && words.resolve(target.name) == owner {
                    for method in methods {
                        match method.node {
                            Item::Fn { name, receiver, args, config, ret_type, can_throw, .. } => {
                                if receiver != null && named_as(name, words, wanted) {
                                    let mut params: Vec[String] = []
                                    for arg in args {
                                        params.push(words.resolve(arg.name).clone())
                                    }
                                    let mut options: Vec[(String, Expr)] = []
                                    for option in config {
                                        params.push(words.resolve(option.name).clone())
                                        options.push((words.resolve(option.name).clone(), option.default.clone()))
                                    }
                                    return FreeFunction { params: params, options: options, can_throw: can_throw, whole_result: whole_type(ret_type, words) }
                                }
                            },
                            else => {},
                        }
                    }
                }
            },
            else => {},
        }
    }
    return null
}

/// **A call's arguments in the order of `function`'s parameters**: the
/// positional ones as written, then each option as the call names it, or its
/// default where the call leaves it out (ADR-318), so a claim about an option
/// is proved at the call as one about a subject parameter is (ADR-269 D5).
pub fn arguments_in_order(function: ref FreeFunction, args: ref Vec[Expr], config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext) -> Vec[Expr] {
    let mut all: Vec[Expr] = args.clone()
    for (option, default) in function.options {
        let mut value = default.clone()
        for given in config {
            if words.resolve(given.name) == option {
                value = given.value.clone()
            }
        }
        all.push(value)
    }
    return all
}

fn named_as(named: ref winnow_grammar::Symbol?, words: ref winnow_grammar::InternerContext, name: ref String) -> bool {
    let symbol = named ?? return false
    return words.resolve(symbol) == name
}

fn whole_type(ty: ref Type?, words: ref winnow_grammar::InternerContext) -> bool {
    let t = ty ?? return false
    return t.generics.is_empty() && is_whole_number(words.resolve(t.name))
}

/// **Whether a call may throw out of the function it stands in**, where
/// that one `throws` (`in_throwing`): what the callee declares, by its
/// `throws` or its ledger's; a call nothing describes may. `unaliased`
/// resolves a package's alias.
///
/// **A failure only the world decides does not count** (ADR-392): a call
/// whose every failure is `io::IoError` - a `println`, a file read - fails or
/// not by what is outside the program, never by its values, so it narrows no
/// state past it; for each state there is a world in which it goes on.
pub fn may_throw(call: ref Expr, in_throwing: bool, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, unaliased: fn(ref String) -> String sync) -> bool {
    if !in_throwing {
        return false
    }
    let name = thrower_named(call, words, unaliased) ?? return true
    let function = free_function(program, words, name)
    if function != null {
        let found = function ?? return true
        if !found.can_throw {
            return false
        }
        let inferred = own.functions[name] ?? return true
        return inferred.fails_with.is_empty() || fails_by_the_program(inferred.fails_with)
    }
    if own.functions.contains_key(name) {
        let contract = own.functions[name] ?? return true
        return fails_by_the_program(contract.fails_with)
    }
    let contract = library.functions[name] ?? return true
    return fails_by_the_program(contract.fails_with)
}

/// Whether one of the failures a contract names is not the world's
/// (`io::IoError`), so the program's values may decide it.
fn fails_by_the_program(fails_with: ref Vec[String]) -> bool {
    for one in fails_with {
        if one != "io::IoError" {
            return true
        }
    }
    return false
}

/// The callee a call names: a bare name, or a path as the ledger keys it.
fn thrower_named(call: ref Expr, words: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync) -> String? {
    return match call {
        Expr::Call { func, .. } => match func {
            Expr::Variable(name, _) => words.resolve(name).clone(),
            Expr::Path(segments, _) => {
                let mut joined: String = ""
                for segment in segments {
                    if !joined.is_empty() {
                        joined.push_str("::")
                    }
                    joined.push_str(words.resolve(segment))
                }
                unaliased(joined)
            },
            else => null,
        },
        else => null,
    }
}

/// **Whether a value came from outside the program** (ADR-010 D2): it names
/// a binding in `tainted`, or calls a source `std`'s ledger calls untrusted
/// without writing `trusted: true` (ADR-365 D2) - anywhere inside it, as `contracts::sync`'s walk reads it: every
/// expression, not into its blocks, the holes of its literals included.
pub fn from_outside(expr: ref Expr, tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    match expr {
        Expr::Variable(name, _) => {
            if tainted.contains(words.resolve(name)) {
                return true
            }
        },
        Expr::Call { func, config, .. } => {
            let source = outside_source_named(func, words)
            if source != null && untrusted(library, source ?? "") && !says_trusted(words, config) {
                return true
            }
        },
        // **A source method marked `trusted: true`** (ADR-365 D2): what it
        // hands back is the operator's, whatever its receiver came from.
        // Unmarked, the method the checker resolved it to (`callees`, by
        // the receiver's node) says whether it reads from outside (#1446).
        Expr::MethodCall { receiver, method, config, .. } => {
            if says_trusted(words, config) && a_source_method(library, words.resolve(method)) {
                return false
            }
            if untrusted(library, callees.get(id_of(receiver) as i64) ?? "") && !says_trusted(words, config) {
                return true
            }
        },
        Expr::SafeMethod { receiver, method, config, .. } => {
            if says_trusted(words, config) && a_source_method(library, words.resolve(method)) {
                return false
            }
            if untrusted(library, callees.get(id_of(receiver) as i64) ?? "") && !says_trusted(words, config) {
                return true
            }
        },
        else => {},
    }
    for hole in holes_of(expr) {
        if from_outside(hole, tainted, words, library, callees, holes_of) {
            return true
        }
    }
    return match expr {
        Expr::Call { func, args, config, .. } => from_outside(func, tainted, words, library, callees, holes_of) || any_from_outside(args, tainted, words, library, callees, holes_of) || config_from_outside(config, tainted, words, library, callees, holes_of),
        Expr::MethodCall { receiver, args, config, .. } => from_outside(receiver, tainted, words, library, callees, holes_of) || any_from_outside(args, tainted, words, library, callees, holes_of) || config_from_outside(config, tainted, words, library, callees, holes_of),
        Expr::SafeMethod { receiver, args, config, .. } => from_outside(receiver, tainted, words, library, callees, holes_of) || any_from_outside(args, tainted, words, library, callees, holes_of) || config_from_outside(config, tainted, words, library, callees, holes_of),
        Expr::Binary { lhs, rhs, .. } => from_outside(lhs, tainted, words, library, callees, holes_of) || from_outside(rhs, tainted, words, library, callees, holes_of),
        Expr::Unary { expr, .. } => from_outside(expr, tainted, words, library, callees, holes_of),
        Expr::Try(inner, _) => from_outside(inner, tainted, words, library, callees, holes_of),
        Expr::Async(inner, _, _, _) => from_outside(inner, tainted, words, library, callees, holes_of),
        Expr::Throw(inner, _) => from_outside(inner, tainted, words, library, callees, holes_of),
        Expr::Cast { expr, .. } => from_outside(expr, tainted, words, library, callees, holes_of),
        Expr::Field { base, .. } => from_outside(base, tainted, words, library, callees, holes_of),
        Expr::SafeField { base, .. } => from_outside(base, tainted, words, library, callees, holes_of),
        Expr::Index { base, index, .. } => from_outside(base, tainted, words, library, callees, holes_of) || from_outside(index, tainted, words, library, callees, holes_of),
        Expr::Range { start, end, .. } => from_outside(start, tainted, words, library, callees, holes_of) || from_outside(end, tainted, words, library, callees, holes_of),
        Expr::Tuple(parts, _) => any_from_outside(parts, tainted, words, library, callees, holes_of),
        Expr::Coalesce { value, fallback, .. } => from_outside(value, tainted, words, library, callees, holes_of) || from_outside(fallback, tainted, words, library, callees, holes_of),
        Expr::TryCatch { expr, .. } => from_outside(expr, tainted, words, library, callees, holes_of),
        Expr::If { cond, .. } => from_outside(cond, tainted, words, library, callees, holes_of),
        Expr::Match { value, arms, .. } => {
            if from_outside(value, tainted, words, library, callees, holes_of) {
                return true
            }
            for arm in arms {
                if maybe_from_outside(arm.guard, tainted, words, library, callees, holes_of) || from_outside(arm.body, tainted, words, library, callees, holes_of) {
                    return true
                }
            }
            false
        },
        Expr::StructLit { fields, .. } => {
            for field in fields {
                if maybe_from_outside(field.value, tainted, words, library, callees, holes_of) {
                    return true
                }
            }
            false
        },
        Expr::ListRepeat { value, count, .. } => from_outside(value, tainted, words, library, callees, holes_of) || from_outside(count, tainted, words, library, callees, holes_of),
        Expr::ListLit { items, .. } => any_from_outside(items, tainted, words, library, callees, holes_of),
        Expr::With { base, fields, .. } => {
            if from_outside(base, tainted, words, library, callees, holes_of) {
                return true
            }
            for field in fields {
                if maybe_from_outside(field.value, tainted, words, library, callees, holes_of) {
                    return true
                }
            }
            false
        },
        Expr::Return(value, _) => maybe_from_outside(value, tainted, words, library, callees, holes_of),
        Expr::Select(arms, _) => {
            for arm in arms {
                if from_outside(arm.value, tainted, words, library, callees, holes_of) {
                    return true
                }
            }
            false
        },
        else => false,
    }
}

fn maybe_from_outside(expr: ref Expr?, tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    let present = expr ?? return false
    return from_outside(present, tainted, words, library, callees, holes_of)
}

fn any_from_outside(exprs: ref Vec[Expr], tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    for e in exprs {
        if from_outside(e, tainted, words, library, callees, holes_of) {
            return true
        }
    }
    return false
}

fn config_from_outside(config: ref Vec[ConfigArg], tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    for c in config {
        if from_outside(c.value, tainted, words, library, callees, holes_of) {
            return true
        }
    }
    return false
}

/// A call's callee as `std`'s ledger keys a source: a bare name, or a path.
/// **The source a value from outside reads** (ADR-396 D1), as the message
/// of an index it reaches names it: the first call to an untrusted source
/// inside it (`io::read_to_string`), or the source of a name in `tainted`
/// it reads. Null where `from_outside` would find none, or only one this
/// shorter walk does not reach; the message then names the binding alone.
pub fn outside_source(expr: ref Expr, tainted: ref collections::BTreeSet[String], sources: ref collections::BTreeMap[String, String], words: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync) -> String? {
    match expr {
        Expr::Variable(name, _) => {
            let n = words.resolve(name)
            if tainted.contains(n) {
                return sources[n]?.clone() ?? n.clone()
            }
            return null
        },
        Expr::Call { func, args, config, .. } => {
            let source = outside_source_named(func, words)
            if source != null && untrusted(library, source ?? "") && !says_trusted(words, config) {
                return source
            }
            return outside_source_in(args, tainted, sources, words, library, callees, holes_of)
        },
        Expr::MethodCall { receiver, args, config, .. } => {
            let callee = callees.get(id_of(receiver) as i64) ?? ""
            if untrusted(library, callee) && !says_trusted(words, config) {
                return callee.clone()
            }
            return outside_source(receiver, tainted, sources, words, library, callees, holes_of) ?? outside_source_in(args, tainted, sources, words, library, callees, holes_of)
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            let callee = callees.get(id_of(receiver) as i64) ?? ""
            if untrusted(library, callee) && !says_trusted(words, config) {
                return callee.clone()
            }
            return outside_source(receiver, tainted, sources, words, library, callees, holes_of) ?? outside_source_in(args, tainted, sources, words, library, callees, holes_of)
        },
        Expr::Binary { lhs, rhs, .. } => return outside_source(lhs, tainted, sources, words, library, callees, holes_of) ?? outside_source(rhs, tainted, sources, words, library, callees, holes_of),
        Expr::Unary { expr, .. } => return outside_source(expr, tainted, sources, words, library, callees, holes_of),
        Expr::Try(inner, _) => return outside_source(inner, tainted, sources, words, library, callees, holes_of),
        Expr::Cast { expr, .. } => return outside_source(expr, tainted, sources, words, library, callees, holes_of),
        Expr::Field { base, .. } => return outside_source(base, tainted, sources, words, library, callees, holes_of),
        Expr::SafeField { base, .. } => return outside_source(base, tainted, sources, words, library, callees, holes_of),
        Expr::Index { base, index, .. } => return outside_source(index, tainted, sources, words, library, callees, holes_of) ?? outside_source(base, tainted, sources, words, library, callees, holes_of),
        Expr::Coalesce { value, fallback, .. } => return outside_source(value, tainted, sources, words, library, callees, holes_of) ?? outside_source(fallback, tainted, sources, words, library, callees, holes_of),
        Expr::TryCatch { expr, .. } => return outside_source(expr, tainted, sources, words, library, callees, holes_of),
        else => {},
    }
    return outside_source_in(holes_of(expr), tainted, sources, words, library, callees, holes_of)
}

fn outside_source_in(exprs: ref Vec[Expr], tainted: ref collections::BTreeSet[String], sources: ref collections::BTreeMap[String, String], words: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync) -> String? {
    for e in exprs {
        let found = outside_source(e, tainted, sources, words, library, callees, holes_of)
        if found != null {
            return found
        }
    }
    return null
}

fn outside_source_named(func: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match func {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        Expr::Path(segments, _) => {
            let mut joined: String = ""
            for segment in segments {
                if !joined.is_empty() {
                    joined.push_str("::")
                }
                joined.push_str(words.resolve(segment))
            }
            joined
        },
        else => null,
    }
}

/// Whether `name` is the last name of a method `library` calls an untrusted
/// source (ADR-010 D2): the prover reads the tree, not the receiver's type.
fn a_source_method(library: ref Ledger, name: ref String) -> bool {
    let tail = f"::{name}"
    for (key, contract) in library.functions {
        let provenance = contract.provenance ?? continue
        let a_method = contract.signature?.takes_a_receiver() ?? false
        if provenance == Provenance::Untrusted && a_method && key.ends_with(tail) {
            return true
        }
    }
    return false
}

fn untrusted(library: ref Ledger, name: ref String) -> bool {
    let contract = library.functions[name] ?? return false
    let provenance = contract.provenance ?? return false
    return provenance == Provenance::Untrusted
}
