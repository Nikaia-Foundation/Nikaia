// crates/nikaia-std/src/tools/check_fields.nika
//
// **What a field read or a `?.` / `??` over a plain value leaves for the
// emitter, and says** (ADR-293, ADR-279 D13, #558, #125), moved from the
// compiler's checker: it writes `CheckState.facts` directly. A `?.` over a
// field reaches through a value that may be absent (`a_safe_field`), a `?.` or
// `??` over a value that never is gets `NK1121`/`NK1217` and `NK1211`/`NK1216`,
// and a `??` whose left side is a view and whose fallback owns gets `NK1185`.

use std::collections

fn fact_key(expr: ref Expr) -> i64 sync {
    return id_of(expr) as i64
}

/// What a reach is a view of: text, or anything else.
fn viewed_of(ty: ref Ty) -> FactViewed sync {
    return match ty {
        Ty::Named { name, args, .. } => if args.len() == 0 && type_last_segment(name) == "String" { FactViewed::Text } else { FactViewed::Plain },
        else => FactViewed::Plain,
    }
}

/// The name of a named type, and an empty one for any other.
fn named_or_empty(ty: ref Ty) -> String sync {
    return match ty {
        Ty::Named { name, .. } => name.clone(),
        else => "",
    }
}

/// What `?.` over a field gives: `T?` of a view where the base is a place,
/// and the facts the emitter writes it by.
fn viewed_nullable(plain: ref Ty) -> Ty sync {
    return Ty::Nullable(plain.as_a_view())
}

impl CheckState {
    /// **A field read through `?.`** (ADR-293 D5): the type it comes to, and
    /// the facts for the emitter - whether the base is flattened, copied or
    /// lent as a view.
    pub fn a_safe_field(ref mut self, world: ref CheckWorld, inner: ref Ty, base: ref Expr, field: ref String, expr: ref Expr, span: ref Span) -> Ty sync {
        let ty = named_or_empty(inner)
        if ty.is_empty() {
            return Ty::Unknown
        }
        if self.facts.boxed_members.contains_key(ty) {
            let members = self.facts.boxed_members[ty]?.clone() ?? collections::BTreeSet()
            if members.contains(field) {
                self.facts.boxed_reads.insert(fact_key(expr))
            }
        }
        let fields = self.fields_of(world, ty) ?? return Ty::Unknown
        let mut found: FieldContract? = null
        for each in fields {
            if found == null && each.name == field {
                found = each.clone()
            }
        }
        if found == null {
            self.no_such_field(ty, field, fields, span)
            return Ty::Unknown
        }
        let declared = found ?? return Ty::Unknown
        self.field_is_reachable(ty, declared, span)
        return self.a_safe_reach(base, declared.ty)
    }

    /// What `?.` reaches, of type `held`, on `base`: flattened where the
    /// member is itself a `T?`, lent where it copies or comes out as a view.
    pub fn a_safe_reach(ref mut self, base: ref Expr, held_ty: ref Ty) -> Ty sync {
        let place = roots_in_a_binding(base)
        let key = fact_key(base)
        match held_ty {
            Ty::Nullable(held) => {
                if place && moves(held) {
                    self.facts.viewed_reaches.insert(key, viewed_of(held))
                    self.facts.flattened_reaches.insert(key)
                    return viewed_nullable(held)
                }
                self.facts.flattened_reaches.insert(key)
                return held_ty.clone()
            },
            else => {
                if !moves(held_ty) {
                    self.facts.copied_reaches.insert(key)
                    return Ty::Nullable(held_ty.clone())
                }
                if place {
                    self.facts.viewed_reaches.insert(key, viewed_of(held_ty))
                    self.facts.copied_reaches.insert(key)
                    return viewed_nullable(held_ty)
                }
                return Ty::Nullable(held_ty.clone())
            },
        }
    }

    /// **`?.` over a value that is never absent** (`NK1121` over an index,
    /// `NK1217` otherwise). `what` is `field` or `method`, `plain` the plain
    /// spelling, `shown` the receiver, and `index` and `list` the pieces of an
    /// index read where the receiver is one.
    pub fn reaches_through_a_plain_value(ref mut self, world: ref CheckWorld, on: ref Ty, receiver: ref Expr, member: ref String, method: bool, reach: ref Expr, span: ref Span) sync {
        if on.is_unknown() {
            return
        }
        let mut what: String = "field"
        let mut plain: String = f".{member}"
        if method {
            what = "method"
            plain = f".{member}(…)"
        }
        let pieces = match receiver {
            Expr::Index { base, index, .. } => [written_expression(world.words, base), written_expression(world.words, index)],
            else => [],
        }
        if pieces.len() == 2 {
            let message = f"`{written_expression(world.words, receiver)}` always has a value, so `?.` guards nothing."
            let note = "A list read never comes back empty: an index that does not fit stops the program, and `?.` only passes over a `null`."
            self.findings.push(check_refusal("NK1121", span, message, [note.clone()], f"Check the length first: `if {pieces[1]} < {pieces[0]}.len()`, then write `{plain}`."))
            return
        }
        self.facts.plain_reaches.insert(fact_key(reach))
        let note = f"`?.` is for a value that may be missing: it reaches the {what} when there's something there and gives `null` otherwise. A type without `?` always has a value, so this is the plain `{plain}`."
        self.findings.push(CheckFinding { severity: CheckSeverity::Warning, span: span.clone(), code: "NK1217", message: f"You don't need `?.` here: a `{on.text()}` is never absent.", notes: [note], help: f"Write `{plain}`.", labels: [] })
    }

    /// **`??` over a value that is never absent** (`NK1211` over an index,
    /// `NK1216` otherwise). True where it is the warning, which the emitter
    /// is told by `plain_reaches`.
    pub fn nothing_to_fall_back_from(ref mut self, world: ref CheckWorld, value: ref Expr, left: ref Ty, coalesce: ref Expr, span: ref Span) -> bool sync {
        let seen = left.unseen()
        let never_absent = match seen {
            Ty::Named { name, .. } => type_last_segment(name) != "Option",
            Ty::Tuple(_) => true,
            else => false,
        }
        if !never_absent {
            return false
        }
        let shown = written_expression(world.words, value)
        let pieces = match value {
            Expr::Index { base, index, .. } => [written_expression(world.words, base), written_expression(world.words, index)],
            else => [],
        }
        let index = pieces.len() == 2
        if !index {
            self.facts.plain_reaches.insert(fact_key(coalesce))
        }
        let message = f"`{shown}` always has a value, so `??` has nothing to replace."
        if index {
            let note = "A list read never comes back empty: an index that does not fit stops the program, and `??` only replaces a `null`."
            self.findings.push(check_refusal("NK1211", span, message, [note.clone()], f"Check the length first: `if {pieces[1]} < {pieces[0]}.len()`."))
            return false
        }
        let note = f"`??` replaces a `null`, and a value of type `{seen.text()}` is never `null`: only a type written with `?` can be."
        self.findings.push(CheckFinding { severity: CheckSeverity::Warning, span: span.clone(), code: "NK1216", message: message, notes: [note], help: "Remove `??` and what follows it.", labels: [] })
        return true
    }

    /// `NK1185`: a `??` whose left side is a view and whose fallback owns what
    /// the left side views. A fallback that names a copy (`.clone()`,
    /// `.to_owned()`, a `to_string()` of something not text already) is text.
    pub fn a_fallback_that_owns_what_the_left_side_views(ref mut self, world: ref CheckWorld, viewed: ref Ty, fallback: ref Ty, written: ref Expr, span: ref Span) sync {
        if !viewed.is_a_view() || fallback.is_a_view() {
            return
        }
        let mut names_a_copy = false
        match written {
            Expr::MethodCall { receiver, method, .. } => {
                let word = world.words.resolve(method).clone()
                if word == "clone" || word == "to_owned" {
                    names_a_copy = true
                } else if word == "to_string" {
                    names_a_copy = !self.facts.text_as_is.contains(fact_key(receiver))
                }
            },
            else => {},
        }
        let mut owned = fallback.clone()
        if names_a_copy {
            owned = Ty::Named { name: "String", args: [], view: false }
        }
        let a_name = match owned {
            Ty::Named { .. } => true,
            else => false,
        }
        if !a_name || !moves(owned) || !self.takes_away(world, owned) {
            return
        }
        let message = f"The two sides of `??` don't match: the left is a `{viewed.text()}`, the fallback a `{owned.text()}`."
        let notes: Vec[String] = ["A view and the value it points into are different types, and `??` has to give back one type.", "Nikaia never makes a copy behind your back, so it can't make the two agree on its own."]
        let help = f"Make the fallback a view too - a text literal already is one, so `?? \"…\"` works and costs nothing - or, if you need a `{owned.text()}`, put the value in a name of its own first."
        self.findings.push(check_refusal("NK1185", span, message, notes, help))
    }
}

/// Whether a binary operator computes in one type: not a comparison, not
/// `&&` or `||`.
fn an_operation_in_one_type(op: ref BinaryOp) -> bool sync {
    return !(op == BinaryOp::Eq || op == BinaryOp::Ne || op == BinaryOp::Lt || op == BinaryOp::Le || op == BinaryOp::Gt || op == BinaryOp::Ge || op == BinaryOp::And || op == BinaryOp::Or)
}

/// A map type's name, by its last segment.
fn a_map_name(name: ref String) -> bool sync {
    let base = type_last_segment(name)
    return base == "HashMap" || base == "BTreeMap" || base == "Map"
}

impl CheckState {
    /// **A name that is a parameter the function only lends on** (ADR-288):
    /// whether the contract of the function being walked lends at its position.
    pub fn a_lent_parameter(ref self, world: ref CheckWorld, given: ref Expr) -> bool sync {
        let name = match given {
            Expr::Variable(name, _) => world.words.resolve(name).clone(),
            else => return false,
        }
        let key = self.current ?? return false
        let contract = world.own.functions[key]?.clone() ?? return false
        let signature = contract.signature?.clone() ?? return false
        let mut at: i64 = -1
        let mut scan = 0
        while scan < signature.params.len() {
            if at < 0 && signature.params[scan].0 == name {
                at = scan
            }
            scan = scan + 1
        }
        if at < 0 {
            return false
        }
        return lends_in_own(contract, at, [world.library])
    }

    /// **A name that is a parameter this function owns** (#665): one the
    /// contract does not lend (its body keeps it), that is not `mut`, `self`
    /// or a view - a part of it may be moved out.
    pub fn an_owned_parameter(ref self, world: ref CheckWorld, given: ref Expr) -> bool sync {
        let name = match given {
            Expr::Variable(name, _) => world.words.resolve(name).clone(),
            else => return false,
        }
        let key = self.current ?? return false
        let contract = world.own.functions[key]?.clone() ?? return false
        let signature = contract.signature?.clone() ?? return false
        if name == "self" || signature.mutable.contains(name) {
            return false
        }
        let mut at: i64 = -1
        let mut scan = 0
        while scan < signature.params.len() {
            if at < 0 && signature.params[scan].0 == name {
                at = scan
            }
            scan = scan + 1
        }
        if at < 0 || signature.params[at].1.is_a_view() {
            return false
        }
        return !lends_in_own(contract, at, [world.library])
    }

    /// **A `comptime` binding used where a type is asked**: the use is written
    /// with the type's suffix (`3u8`), by the node (ADR-287). `ty` is the suffix.
    pub fn comptimes_asked(ref mut self, world: ref CheckWorld, expr: ref Expr, ty: ref String) sync {
        match expr {
            Expr::Variable(name, _) => {
                let local = self.binding(world.words.resolve(name)) ?? return
                let value = local.constant ?? return
                if !self.open_comptimes.contains_key(local.id) {
                    return
                }
                let digits = integer_text(value)
                let mut written = f"{digits}{ty}"
                if value.negative {
                    written = f"({digits}{ty})"
                }
                self.facts.comptime_uses.insert(fact_key(expr), written)
                self.facts.folded_comptimes.insert(world.words.resolve(name).clone())
            },
            Expr::Binary { op, lhs, rhs, .. } => {
                if an_operation_in_one_type(op) {
                    self.comptimes_asked(world, lhs, ty)
                    if op != BinaryOp::Shl && op != BinaryOp::Shr {
                        self.comptimes_asked(world, rhs, ty)
                    }
                }
            },
            Expr::Unary { op, expr, .. } => {
                if op == UnaryOp::Neg || op == UnaryOp::Not {
                    self.comptimes_asked(world, expr, ty)
                }
            },
            else => {},
        }
    }

    /// Whether a declared type has a field of the name that holds code
    /// (ADR-230 D1): what a field whose code is not seen is asked about.
    pub fn a_field_holds_code(ref self, world: ref CheckWorld, owner: ref String, field: ref String) -> bool sync {
        let fields = self.fields_seen(world, owner)
        for each in fields {
            if each.name == field {
                return check_core_stmt_holds_code(each.ty)
            }
        }
        return false
    }

    /// The declared fields of a type by the name a value's type carries: the
    /// program's own, another file's by the exact qualified name, or `std`'s by
    /// the last segment (ADR-296 D17). Empty where there are none.
    pub fn fields_seen(ref self, world: ref CheckWorld, name: ref String) -> Vec[FieldContract] sync {
        if self.structs.contains_key(name) {
            return self.structs[name]?.clone() ?? []
        }
        if world.own.types.contains_key(name) {
            let contract = world.own.types[name]?.clone() ?? return []
            return contract.fields.clone()
        }
        let suffix = f"::{name}"
        for (key, contract) in world.library.types {
            if key == name || key.ends_with(ref suffix) {
                return contract.fields.clone()
            }
        }
        return []
    }
}

/// **A map's first writes through the brackets give it its types**
/// (#543, ADR-285 D43): `m[k] = v` as `insert` does. The value is handed
/// to an open number by the assignment itself.
pub fn check_fields_map_first_written(mut state: CheckState, world: ref CheckWorld, target: ref Expr, value: ref Expr, found: ref Ty, span: ref Span) sync {
    match target {
        Expr::Index { base, index, .. } => {
            match base {
                Expr::Variable(name, _) => {
                    let base_name: String = world.words.resolve(name).clone()
                    let local = state.binding(base_name) ?? return
                    let open = match local.ty {
                        Ty::Named { name, args, .. } => a_map_name(name) && (args.len() == 0 || (args.len() == 2 && (args[0].is_unknown() || args[1].is_unknown()))),
                        else => false,
                    }
                    if !open {
                        return
                    }
                    let before = check_fields_map_parts(local.ty)
                    let index_key = index_key_type(state, world, index)
                    check_core_call_on_map_written(state, world, base_name, index, index_key, false, value, found, false, span)
                    // **The first write's text is handed over as every later
                    // one's is** (ADR-285 D43): built as the map's own.
                    let now = check_fields_map_parts(state.lookup(base_name) ?? Ty::Unknown)
                    if before[0].is_unknown() && !now[0].is_unknown() {
                        state.a_map_key(world, now[0], index_key, index, true, span)
                    }
                    if before[1].is_unknown() && !now[1].is_unknown() {
                        state.text_literal(world, now[1], value, true)
                    }
                },
                else => {}
            }
        },
        else => {}
    }
}

/// A map's key and value types, `?` where one is not said.
fn check_fields_map_parts(ty: ref Ty) -> Vec[Ty] sync {
    return match ty {
        Ty::Named { args, .. } => if args.len() == 2 { args.clone() } else { [Ty::Unknown, Ty::Unknown] },
        else => [Ty::Unknown, Ty::Unknown],
    }
}

/// The type a map's index key gives: text for a literal, the type of a
/// variable that is known; `?` otherwise.
fn index_key_type(state: ref CheckState, world: ref CheckWorld, index: ref Expr) -> Ty sync {
    return match index {
        Expr::LitStr { .. } => Ty::Named { name: "String", args: [], view: false },
        Expr::Variable(key, _) => value_of_a_copy(state.lookup(world.words.resolve(key)) ?? Ty::Unknown),
        else => Ty::Unknown,
    }
}
