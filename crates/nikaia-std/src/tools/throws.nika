// crates/nikaia-std/src/tools/throws.nika
//
// Kap 7.1: **which errors can leave a function** - the lattice of the
// compiler's `contracts::throws`, moved from Rust (ADR-294, #125).
//
// **The walk, the graph and the fixpoint.** Per `throws` function, what it
// throws itself and whom in this package it calls: the body's walk is here,
// what one expression reaches is `sync`'s single resolution (ADR-288), handed
// in as `contribution_of`, and the method calls are the type checker's,
// handed in as `MethodsCalled`. The compiler hands in each unit and writes
// back what this answers.
//
// An error set is a **least** fixpoint, `sync`'s walk with the lattice turned
// around: everyone starts with what they throw themselves and grows by what
// their callees throw, until nothing changes. Mutual recursion ends because
// the sets only grow, and there are finitely many names to grow by.

use std::collections

/// The name for an error nobody can name (ADR-280): what a call that cannot
/// be seen contributes, because "I cannot see it" may never be read as "it
/// does not fail" (ADR-010 D1).
comptime UNNAMED: ref String = "?"

/// The checker's entry for the functions of this package named as a value
/// (ADR-351 D4): not a place, the list of whose callers are not all seen.
pub comptime AS_VALUE: ref String = "<as a value>"

/// The method calls of one body as the type checker resolved them
/// (ADR-288): the entries reached, and whether something could not be seen
/// - a call that did not resolve, or code handed in that may fail.
pub struct MethodsCalled {
    pub resolved: collections::BTreeSet[String],
    pub unseen: bool,
    /// The function fields it calls through, as `Type.field` (ADR-351 D2).
    pub fields: collections::BTreeSet[String],
}

/// The graph the walk builds - what each `throws` function throws itself and
/// whom in this package it calls - with the type checker's method calls by
/// the key it files each body's answers under: one record, because every
/// function of a unit reads the one and writes the others.
pub struct ThrowsGraph {
    pub methods: collections::BTreeMap[String, MethodsCalled],
    pub direct: collections::BTreeMap[String, collections::BTreeSet[String]],
    pub calls: collections::BTreeMap[String, collections::BTreeSet[String]],
    /// **What a `catch` lets through** (ADR-345 D2): per function, the callees
    /// of this package called inside a `catch`, with the fatal types its
    /// handler names; the others of their fatal errors still reach the caller.
    pub fatal_calls: collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]],
}

/// Every `throws` function and method of one unit, by the key the ledger
/// records it under, into `graph`, which `error_sets` takes.
pub fn unit_throws(program: ref Program, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, own: ref Ledger, library: ref Ledger, mut graph: ThrowsGraph) {
    for item in program.items {
        match item.node {
            Item::Fn { name, body, can_throw, .. } => {
                if can_throw {
                    let thrown = thrown_by(body, names, holes_of, contribution_of)
                    with_methods(key_of_function(name, "", names), thrown, own, library, graph)
                }
            }
            Item::Impl { target, methods, .. } => {
                let owner = names.resolve(target.name).clone()
                for method in methods {
                    match method.node {
                        Item::Fn { name, body, can_throw, .. } => {
                            if can_throw {
                                let thrown = thrown_by(body, names, holes_of, contribution_of)
                                with_methods(key_of_function(name, owner, names), thrown, own, library, graph)
                            }
                        }
                        else => {}
                    }
                }
            }
            else => {}
        }
    }
}

// What the walk left to somebody else: the body's method calls, merged rather
// than reconciled - the walk skips method calls entirely and this covers those
// and nothing else. A resolved callee of this package is a call; one of a
// library brings what its ledger says it fails with; one no ledger carries
// after all is `?`, as an unresolved one is.
fn with_methods(key: ref String, thrown: ref Thrown, own: ref Ledger, library: ref Ledger, mut graph: ThrowsGraph) {
    let mut named = thrown.direct.clone()
    let mut called = thrown.calls.clone()
    methods_into(graph.methods[key], own, library, named, called)
    graph.direct.insert(key.clone(), named)
    graph.calls.insert(key.clone(), called)
    graph.fatal_calls.insert(key.clone(), thrown.fatal_calls.clone())
}

fn methods_into(resolved: ref MethodsCalled?, own: ref Ledger, library: ref Ledger, mut named: collections::BTreeSet[String], mut called: collections::BTreeSet[String]) {
    let known = resolved ?? return
    for field in known.fields {
        called.insert(field.clone())
    }
    if known.unseen {
        named.insert(UNNAMED.clone())
    }
    for callee in known.resolved {
        if own.functions.contains_key(callee) {
            called.insert(callee.clone())
        } else {
            for error in fails_with_of(library, callee) {
                named.insert(error)
            }
        }
    }
}

/// **A function field is a place in the graph** (ADR-351 D1, D3): it calls
/// whatever was stored in it, and its set is the union of theirs. `free` are
/// the functions named or called by the stored code, `resolved` its method
/// calls; code this walk did not see makes it `?`.
pub fn stored_throws(field: ref String, resolved: ref collections::BTreeSet[String], unresolved: bool, free: ref collections::BTreeSet[String], own: ref Ledger, library: ref Ledger, mut graph: ThrowsGraph) {
    let mut named: collections::BTreeSet[String] = collections::BTreeSet()
    let mut called: collections::BTreeSet[String] = collections::BTreeSet()
    if unresolved {
        named.insert(UNNAMED.clone())
    }
    for callee in free {
        if own.functions.contains_key(callee) {
            called.insert(callee.clone())
        } else if library.functions.contains_key(callee) {
            for error in fails_with_of(library, callee) {
                named.insert(error)
            }
        }
    }
    let known: MethodsCalled? = MethodsCalled { resolved: resolved.clone(), unseen: false, fields: collections::BTreeSet() }
    methods_into(known, own, library, named, called)
    graph.direct.insert(field.clone(), named)
    graph.calls.insert(field.clone(), called)
}

/// **A parameter of code is a place** (ADR-351 D1, D4), given what every
/// caller of this package hands it. One whose callers this package cannot
/// all see - a `pub` function, or one used as a value - cannot be named
/// here: those places are returned, for the caller to fill with `"?"` for
/// this package and with `"from(p)"` for the ledger.
pub fn params_as_places(own: ref Ledger, mut stored: collections::BTreeMap[String, CheckStoredCode]) -> collections::BTreeSet[String] {
    let mut open: collections::BTreeSet[String] = collections::BTreeSet()
    let mut kept: collections::BTreeSet[String] = collections::BTreeSet()
    // The functions named as a value anywhere - returned, handed on, kept.
    let named: CheckStoredCode = stored.remove(AS_VALUE) ?? CheckStoredCode::empty()
    for free in named.free {
        kept.insert(free.clone())
    }
    for (_, code) in stored {
        for free in code.free {
            kept.insert(free.clone())
        }
    }
    // **A published field of a published type is stored into by packages this
    // one does not see** (ADR-351 D4): its set cannot be named here.
    for (owner, contract) in own.types {
        if !contract.public {
            continue
        }
        for field in contract.fields {
            if !field.public || !check_core_stmt_holds_code(field.ty) {
                continue
            }
            let key = f"{owner}.{field.name}"
            let mut entry: CheckStoredCode = stored.remove(key) ?? CheckStoredCode::empty()
            entry.unresolved = true
            stored.insert(key, entry)
        }
    }
    for (name, contract) in own.functions {
        if name.contains("::") {
            continue
        }
        let signature: ref Signature = contract.signature ?? continue
        for (param, ty) in signature.params {
            if !check_core_stmt_holds_code(ty) {
                continue
            }
            let key = f"{name}::{param}"
            let mut entry: CheckStoredCode = stored.remove(key) ?? CheckStoredCode::empty()
            if contract.public || kept.contains(name) {
                open.insert(key.clone())
            }
            stored.insert(key, entry)
        }
    }
    return open
}

/// **The sets a ledger publishes** (ADR-351 D4): `sets` filled the open
/// parameter places with `"?"`, `given` the same graph with `"from(F::p)"`.
/// Where a function's only unnamed member is its own parameters' code, it
/// says which, and a caller replaces them with what it passed.
pub fn throws_from(given: ref collections::BTreeMap[String, Vec[String]], name: ref String) -> Vec[String] {
    let set = given[name] ?? return []
    let prefix = f"from({name}::"
    let mut params: Vec[String] = []
    for error in set {
        if error == UNNAMED {
            return []
        }
        if error.starts_with("from(") {
            if !error.starts_with(prefix) {
                return []
            }
            let rest: String = (error.strip_prefix("from(") ?? "").clone()
            let after: String = (rest.strip_prefix(name) ?? "").clone()
            let param: String = (after.strip_prefix("::") ?? "").clone()
            params.push((param.strip_suffix(")") ?? "").clone())
        }
    }
    return params
}

// What a library's ledger says a callee fails with, and `?` for one it does
// not carry.
fn fails_with_of(library: ref Ledger, callee: ref String) -> Vec[String] {
    let contract = library.functions[callee] ?? return ["?"]
    return contract.fails_with.clone()
}

/// What every `throws` function of the ledger fails with, by name: `direct`
/// is what each throws itself (`"?"` where it cannot be named) and `calls`
/// whom in this package it calls. A function the ledger does not carry, or
/// carries as one that cannot fail, has no entry - a function that cannot
/// fail cannot propagate. A declared `throws` whose body names nothing keeps
/// `["?"]`: the declaration is a promise a caller already relies on, and this
/// is here to say more than it, never less.
pub fn error_sets(direct: ref collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], fatal_calls: ref collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]], fatal: ref collections::BTreeSet[String], own: ref Ledger, places: ref collections::BTreeSet[String]) -> collections::BTreeMap[String, Vec[String]] {
    let mut sets = direct.clone()
    let mut changed = true
    while changed {
        changed = false
        for (name, callees) in calls {
            let before = sets[name]?.clone() ?? collections::BTreeSet()
            let mut grown = before.clone()
            for callee in callees {
                for error in theirs(sets, own, callee) {
                    grown.insert(error)
                }
            }
            let caught = fatal_calls[name]?.clone() ?? collections::BTreeMap()
            for (callee, named) in caught {
                for error in theirs(sets, own, callee) {
                    if fatal.contains(error) && !named.contains(error) {
                        grown.insert(error)
                    }
                }
            }
            if grown.len() != before.len() {
                sets.insert(name.clone(), grown)
                changed = true
            }
        }
    }
    let mut settled: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    for (name, set) in sets {
        // **A function field settles to its union as it is** (ADR-351 D3):
        // empty where no failing value reaches it.
        if places.contains(name) {
            let mut union: Vec[String] = []
            for error in set {
                union.push(error.clone())
            }
            settled.insert(name.clone(), union)
            continue
        }
        let contract = own.functions[name] ?? continue
        if contract.fails_with.len() == 0 {
            continue
        }
        let mut errors: Vec[String] = []
        for error in set {
            errors.push(error.clone())
        }
        if errors.len() == 0 {
            errors.push("?")
        }
        settled.insert(name.clone(), errors)
    }
    return settled
}

/// What a callee fails with. **One the walk did not see still has a set**
/// (ADR-296 D40): a grammar's entry rule is not an `Item::Fn`, and its contract
/// is written straight into the ledger (ADR-296 D24). Read as nothing, what a
/// parse throws reached no caller, and the caller's channel was inferred
/// without it - a file `rustc` refused.
fn theirs(sets: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger, callee: ref String) -> Vec[String] {
    let mut errors: Vec[String] = []
    if sets.contains_key(callee) {
        let set = sets[callee] ?? return errors
        for error in set {
            errors.push(error.clone())
        }
        return errors
    }
    let contract = own.functions[callee] ?? return errors
    for error in contract.fails_with {
        errors.push(error.clone())
    }
    return errors
}

/// The type a `throw` raises. `ConfigError::NotFound(p)` and
/// `ConfigError::NotFound` are both `ConfigError`: a variant is written under
/// the type that declares it (Part I, 3.4), so **everything but the last
/// segment** is the type - `io::IoError::NotFound` is `io::IoError`, a type
/// keyed with its module (ADR-313 D3). A variant with named fields is a
/// struct literal, `ConfigError::BadSyntax { line }`, and records the type and
/// not the variant too (ADR-023 D1, ADR-280 D9).
pub fn error_type(names: ref winnow_grammar::InternerContext, thrown: ref Expr) -> String? {
    return match thrown {
        Expr::Path(segments, _) => if segments.len() > 1 { all_but_the_last(names, segments) } else { null },
        Expr::Call { func, .. } => error_type(names, func),
        Expr::StructLit { name, .. } => struct_type(names.resolve(name)),
        else => null,
    }
}

/// `io::IoError::NotFound` read as the path of its type.
fn all_but_the_last(names: ref winnow_grammar::InternerContext, segments: ref Vec[winnow_grammar::Symbol]) -> String {
    let mut written: String = ""
    for k in 0..<segments.len() - 1 {
        if k > 0 {
            written = f"{written}::"
        }
        let segment = names.resolve(segments[k])
        written = f"{written}{segment}"
    }
    return written
}

/// `ConfigError::BadSyntax` is `ConfigError`; a struct with no `::` is itself.
fn struct_type(written: ref String) -> String {
    let mut parts: Vec[String] = []
    for part in written.split("::") {
        parts.push(part.clone())
    }
    if parts.len() < 2 {
        return written.clone()
    }
    let mut ty: String = ""
    for k in 0..<parts.len() - 1 {
        if k > 0 {
            ty = f"{ty}::"
        }
        ty = f"{ty}{parts[k]}"
    }
    return ty
}

// ---------------------------------------------------------------------------
// **What a function throws itself, and whom it calls** - the walk, moved from
// the compiler's `contracts::throws` (#125). What a call resolves to is the
// compiler's to say (`contribution_of`): `sync`'s single resolution (ADR-288),
// handed in as an answer per expression, as the holes of a literal are.

/// What one function contributes to its own error set before its callees are
/// taken into account: what it names in a `throw` (`?` where it cannot be
/// named), and the functions of this package it calls.
pub struct Thrown {
    pub direct: collections::BTreeSet[String],
    pub calls: collections::BTreeSet[String],
    /// Whether a `throw error` stood anywhere in what was walked: a handler
    /// that has one passes what it caught on (ADR-280 D10).
    passes_on: bool,
    /// The fatal types the handler of the `catch` being walked names
    /// (ADR-345 D2).
    named: collections::BTreeSet[String],
    pub fatal_calls: collections::BTreeMap[String, collections::BTreeSet[String]],
}

/// What an expression contributes, as the compiler resolved it: a function of
/// this package it calls, or the errors a ledger names for a callee outside
/// it (`?` for a call nobody can name), or neither.
pub struct Contribution {
    pub call: String?,
    pub errors: Vec[String],
    /// Those of `errors` that are fatal (ADR-345 D1).
    pub fatal: Vec[String],
}

/// What a function's body throws itself, and whom in this package it calls.
pub fn thrown_by(body: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync) -> Thrown {
    let mut out = Thrown { direct: collections::BTreeSet(), calls: collections::BTreeSet(), passes_on: false, named: collections::BTreeSet(), fatal_calls: collections::BTreeMap() }
    thrown_in_block(body, names, holes_of, contribution_of, false, out)
    return out
}

// Each statement's expressions, then the blocks it holds - each with whether
// it is the handler of a `catch`, which is where `throw error` passes on what
// the guarded half threw rather than naming something new.
fn thrown_in_block(block: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, mut out: Thrown) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { value, .. } => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Comptime { value, .. } => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Expr(value) => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Return(value) => thrown_in(value ?? continue, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Assign { target, value, .. } => {
                thrown_in(target, names, holes_of, contribution_of, in_a_handler, false, out)
                thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out)
            }
            Stmt::For { iter, .. } => thrown_in(iter, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::While { cond, .. } => thrown_in(cond, names, holes_of, contribution_of, in_a_handler, false, out),
            else => {}
        }
        match stmt.node {
            Stmt::For { body, .. } => thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::While { body, .. } => thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Let { value, .. } => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Comptime { value, .. } => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Expr(value) => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Return(value) => thrown_in_blocks(value ?? continue, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Assign { target, value, .. } => {
                thrown_in_blocks(target, names, holes_of, contribution_of, in_a_handler, out)
                thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out)
            }
            else => {}
        }
    }
}

// Every expression inside one, the holes of a literal included, and not the
// bodies of nested blocks. **What a handler catches and does not pass on is
// not the function's** (Part I 7.1): everything in the guarded half of a
// `catch` whose handler never writes `throw error` is `caught`, and fails into
// the handler and nowhere else.
fn thrown_in(expr: ref Expr, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    a_contribution(expr, names, contribution_of, in_a_handler, caught, out)
    for hole in holes_of(expr) {
        thrown_in(hole, names, holes_of, contribution_of, in_a_handler, caught, out)
    }
    match expr {
        Expr::Call { func, args, config, .. } => {
            thrown_in(func, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::MethodCall { receiver, args, config, .. } => {
            thrown_in(receiver, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            thrown_in(receiver, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Binary { lhs, rhs, .. } => {
            thrown_in(lhs, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(rhs, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Unary { expr, .. } => thrown_in(expr, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Try(inner, _) => thrown_in(inner, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Throw(inner, _) => thrown_in(inner, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Cast { expr, .. } => thrown_in(expr, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Field { base, .. } => thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::SafeField { base, .. } => thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Index { base, index, .. } => {
            thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(index, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Range { start, end, .. } => {
            thrown_in(start, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(end, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Tuple(parts, _) => {
            for part in parts {
                thrown_in(part, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Coalesce { value, fallback, .. } => {
            thrown_in(value, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(fallback, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::TryCatch { expr, handler, .. } => {
            let into_the_handler = caught || !passes_on(handler, names, holes_of, contribution_of)
            let outer = out.named.clone()
            if !caught {
                out.named = fatal_named(handler, names)
            }
            thrown_in(expr, names, holes_of, contribution_of, in_a_handler, into_the_handler, out)
            out.named = outer
        }
        Expr::If { cond, .. } => thrown_in(cond, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Match { value, arms, .. } => {
            thrown_in(value, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arm in arms {
                maybe_thrown_in(arm.guard, names, holes_of, contribution_of, in_a_handler, caught, out)
                thrown_in(arm.body, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::StructLit { fields, .. } => {
            for field in fields {
                maybe_thrown_in(field.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::ListLit { items, .. } => {
            for item in items {
                thrown_in(item, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::With { base, fields, .. } => {
            thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out)
            for field in fields {
                maybe_thrown_in(field.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Return(value, _) => thrown_in(value ?? return, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Select(arms, _) => {
            for arm in arms {
                thrown_in(arm.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        else => {}
    }
}

fn maybe_thrown_in(expr: ref Expr?, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    thrown_in(expr ?? return, names, holes_of, contribution_of, in_a_handler, caught, out)
}

// Every block an expression holds, the body of a lambda passed as an argument
// included - and a `catch`'s handler, walked as one.
fn thrown_in_blocks(expr: ref Expr, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, mut out: Thrown) {
    match expr {
        Expr::Block(block, _) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Unsafe(block, _) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Overlap(block, _) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Closure { body, .. } => thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out),
        // ADR-346 D5: a task's errors reach whoever joins it; the starter is
        // where its handle is joined or handed on.
        Expr::Spawn { body, .. } => thrown_in_blocks(body, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Call { func, args, config, .. } => {
            thrown_in_blocks(func, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::MethodCall { receiver, args, config, .. } => {
            thrown_in_blocks(receiver, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            thrown_in_blocks(receiver, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::If { then_branch, else_branch, .. } => {
            thrown_in_block(then_branch, names, holes_of, contribution_of, in_a_handler, out)
            thrown_in_block(else_branch ?? return, names, holes_of, contribution_of, in_a_handler, out)
        }
        Expr::TryCatch { expr, handler, .. } => {
            thrown_in_blocks(expr, names, holes_of, contribution_of, in_a_handler, out)
            thrown_in_block(handler, names, holes_of, contribution_of, true, out)
        }
        Expr::Match { arms, .. } => {
            for arm in arms {
                thrown_in_blocks(arm.body, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::Select(arms, _) => {
            for arm in arms {
                thrown_in_block(arm.body, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        else => {}
    }
}

// What one expression contributes. **`throw error` in a handler passes the
// caught error on** (ADR-280 D10): its types are the guarded expression's,
// which the call there already contributed - read as a value nobody can name
// it added `?`, and the function's sum fell back to the unnamed error. Noted
// wherever it stands, caught or not, for `passes_on`.
fn a_contribution(expr: ref Expr, names: ref winnow_grammar::InternerContext, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    let passing = the_caught_error(expr, names)
    if passing {
        out.passes_on = true
    }
    if in_a_handler && passing {
        return
    }
    if caught {
        // **A fatal error passes a `catch` that does not name it** (ADR-345 D2).
        match expr {
            Expr::Throw(_, _) => {}
            else => {
                let given = contribution_of(expr)
                for error in given.fatal {
                    if !out.named.contains(error) {
                        out.direct.insert(error.clone())
                    }
                }
                let call = given.call ?? ""
                if call.len() > 0 && !out.fatal_calls.contains_key(call) {
                    out.fatal_calls.insert(call, out.named.clone())
                }
            }
        }
        return
    }
    match expr {
        // A `throw` that reached something this compiler cannot name - a
        // value from a call, say - fails; with what is the absence of a claim
        // rather than an answer.
        Expr::Throw(thrown, _) => {
            out.direct.insert(error_type(names, thrown) ?? "?")
        }
        else => {
            let given = contribution_of(expr)
            let call = given.call ?? ""
            if call.len() > 0 {
                out.calls.insert(call)
            }
            for error in given.errors {
                out.direct.insert(error.clone())
            }
        }
    }
}

// `throw error`, the caught error handed on.
fn the_caught_error(expr: ref Expr, names: ref winnow_grammar::InternerContext) -> bool {
    return match expr {
        Expr::Throw(thrown, _) => match thrown {
            Expr::Variable(name, _) => names.resolve(name) == "error",
            else => false,
        },
        else => false,
    }
}

// Whether a handler passes what it caught on: `throw error` anywhere in it
// (ADR-280 D10).
fn passes_on(handler: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync) -> bool {
    let mut seen = Thrown { direct: collections::BTreeSet(), calls: collections::BTreeSet(), passes_on: false, named: collections::BTreeSet(), fatal_calls: collections::BTreeMap() }
    thrown_in_block(handler, names, holes_of, contribution_of, false, seen)
    return seen.passes_on
}

/// **The fatal types a handler takes** (ADR-345 D2): those whose variant a
/// `match` arm over `error` names, at the handler's top level.
pub fn fatal_named(handler: ref Block, names: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    for stmt in handler.stmts {
        match stmt.node {
            Stmt::Expr(value) => named_in_match(value, names, out),
            Stmt::Let { value, .. } => named_in_match(value, names, out),
            Stmt::Return(value) => named_in_match(value ?? continue, names, out),
            else => {}
        }
    }
    return out
}

fn named_in_match(expr: ref Expr, names: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[String]) {
    match expr {
        Expr::Match { value, arms, .. } => {
            if !the_error(value, names) {
                return
            }
            for arm in arms {
                let path = pattern_path(arm.pattern) ?? continue
                if path.len() < 2 {
                    continue
                }
                let mut parts: Vec[String] = []
                for at in 0..<path.len() - 1 {
                    parts.push(names.resolve(path[at]).clone())
                }
                out.insert(parts.join("::"))
            }
        }
        else => {}
    }
}

fn the_error(expr: ref Expr, names: ref winnow_grammar::InternerContext) -> bool {
    return match expr {
        Expr::Variable(name, _) => names.resolve(name) == "error",
        else => false,
    }
}

fn pattern_path(pattern: ref MatchPattern) -> Vec[winnow_grammar::Symbol]? {
    match pattern {
        MatchPattern::Path(path) => {
            return path.clone()
        },
        MatchPattern::Tuple { path, .. } => {
            return path.clone()
        },
        MatchPattern::Named { path, .. } => {
            return path.clone()
        },
        else => {},
    }
    return null
}
