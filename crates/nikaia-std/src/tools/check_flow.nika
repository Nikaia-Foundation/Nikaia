// crates/nikaia-std/src/tools/check_flow.nika
//
// **What the checker keeps while it walks one body** (ADR-294, #125, #558, C-3):
// the flags and tables that say where the walk stands - inside a `catch`, in a
// loop, at a write door - and what it has seen so far in the statement, the
// function, the numbers whose type is still open. `CheckState` holds it as
// `flow`; the Rust `Checker` holds what it looks at and does not own (the
// parsed files, the newly gained contracts, what the build may read).
//
// **Positions are `i64`** (ADR-294 D7), and the tables that were hash maps are
// ordered maps: nothing reads one in an order.

use std::collections

/// A constant integer the walk worked out: the number, whether the fold left
/// the 65 bits every literal fits in, and the type an operand's declaration
/// pinned (`fold.rs`'s `Constant`).
pub struct CheckConstant {
    pub value: Integer,
    pub beyond: bool,
    pub pinned: String?,
}

/// **A number no annotation typed** (ADR-285): one `let`, or several its uses
/// joined, and what those uses asked of it.
pub struct CheckOpenNumber {
    /// The name, for the message.
    pub name: String,
    /// Whether it is the elements of the list `name` binds (D34) rather than
    /// the name's own number.
    pub element: bool,
    /// How many lists stand around its numbers in the `let`'s value: 0 for
    /// the name's own number, 1 for `[1, 2]`, 2 for `[[1, 2], [3]]` (#938):
    /// the type is written inside as many `Vec`s.
    pub levels: i64,
    /// The `let`, where the type is written and where a refusal points.
    pub at: Span,
    /// The entry this one was joined into, by the `let` it names; itself where
    /// none.
    pub joined: i64,
    /// What the uses asked: the type, the statement, and whether the use is a
    /// type standing beside it (`true`) or an index.
    pub asks: Vec[(String, Span, bool)],
    /// The numbers it is given as written, with the statement and whether it
    /// is a bare literal.
    pub given: Vec[(CheckConstant, Span, bool)],
    /// What a shift of literals alone it is given comes to (ADR-285 D40):
    /// where no use asks, the first type that holds it is the number's; a
    /// type a use asks for is the shift's, and does not have to hold it.
    pub shifted: Vec[CheckConstant],
    /// What an operation over it comes to, where that folds.
    pub derived: Vec[(CheckConstant, Span)],
    /// The statements that give it a number, by the byte they start at, and
    /// every literal in them.
    pub written: Vec[(i64, Vec[(i64, Integer)], bool)],
    /// The casts out of it, by the operand's id and the type cast into: what
    /// a cast keeps or checks is known once the number's type is (#629 D-1).
    pub casts: Vec[(i64, String)],
    /// The shifts of it by a constant count, with the count and where: whether
    /// the count fits is known once the number's type is (Part I 2.2).
    pub shifts: Vec[(CheckConstant, Span)],
    /// A use that needs its type written even where no use asks for one: a
    /// cast or a method call (#629 D-1, D-2), which the language below cannot
    /// read off an unsuffixed literal.
    pub typed: bool,
    /// The operations over it that stay inside their type or stop the
    /// program, by the byte they stand at: sites of the overflow proof
    /// (ADR-306 D6) once the number's type is written.
    pub sites: Vec[i64],
}

/// **A `'…'` bound by a `let` that its uses type** (ADR-320 D8, as a number
/// literal's binding is, ADR-285 D23): one ASCII character or a `'\xNN'`.
pub struct CheckOpenChar {
    /// The name, for the message.
    pub name: String,
    /// The literal as written, without its quotes.
    pub written: String,
    /// The literal's node, which is written as a byte where the uses ask one.
    pub literal: i64,
    /// The `let`, where a refusal of the literal points.
    pub at: Span,
    /// Every read of the name, by the read's node, with its statement.
    pub reads: collections::BTreeMap[i64, Span],
    /// The reads a use took as a `u8`; every other read is a `scalar`.
    pub bytes: collections::BTreeSet[i64],
}

/// A signed value put where an unsigned type is stated, until the walk proves
/// it `>= 0` or refuses it.
pub struct CheckUnsignedSlot {
    pub node: i64,
    pub found: Ty,
    pub want: Ty,
    pub into: String,
    pub written: String,
    pub span: Span,
    /// The slot's own refusal, where `expect` would have written one.
    pub refusal: CheckFinding?,
}

/// The concrete type an unrolling is over and the field this turn stands at.
pub struct CheckUnrolling {
    pub on: String,
    pub field: FieldContract,
}

/// **A `return` inside a lambda** (#758): what it hands back and where.
pub struct CheckLambdaReturn {
    pub ty: Ty,
    pub at: Span,
    /// What it hands back as written: none for a bare `return`.
    pub value: Vec[Expr],
}

/// **What the walk of a body keeps beside the scope**: see the Rust `Checker`'s
/// history for each field's reason; the comments here say what it is.
pub struct CheckFlow {
    /// The bounds the `comptime` being computed raised: steps and bytes.
    pub raised: (u64?, u64?),
    /// Whether this walk computes build-time values at all.
    pub computes: bool,
    /// The addresses of the values a call names after its `;` (#455).
    pub option_values: Vec[i64],
    /// Which of them is a text literal, in the same order.
    pub option_literals: Vec[bool],
    /// **The options a method call names after its `;`** (#1446), by its
    /// receiver's node, until the call resolves: each one's name, type,
    /// address and whether it is a text literal. A witness (`within:`,
    /// `after:`), `on_timeout:` and a DSL driver's options are not among them.
    pub method_passed: collections::BTreeMap[i64, Vec[(String, Ty, i64, bool)]],
    /// The concrete type's name and the field the current unrolling stands at
    /// (ADR-304 D7); `null` in the generic body.
    pub unrolling: CheckUnrolling?,
    /// This walk is one unit harvesting another's call sites (ADR-304 D2).
    pub harvesting: bool,
    /// Whether the walk is inside a `comptime` initialiser (ADR-310 D3).
    pub inside_a_comptime: bool,
    /// Numbers written as a method's receiver in this statement (#417).
    pub literal_receivers: Vec[(i64, Integer)],
    /// The function hands back text both kinds of which flow into its result.
    pub expected_either: bool,
    /// The same for the field whose value is being checked.
    pub field_either: bool,
    /// Whether it declared `throws`.
    pub throwing: bool,
    /// Whether the expression being walked is the guarded half of a `catch`.
    pub caught: bool,
    /// **Inside the guarded half of a `catch` that keeps what it caught**
    /// (Part I 7.1, ADR-280 D10: its handler writes no `throw error`): the
    /// fatal types the outermost such handler names (ADR-345 D2); `null`
    /// outside one. A method resolved here adds nothing to the function's
    /// error set but those fatal errors (#725).
    pub swallowed: collections::BTreeSet[String]?,
    /// The handler being walked was handed an error that can be more than one
    /// type (ADR-280 D18).
    pub caught_several: bool,
    /// The one error type arriving at the nearest `catch`, where exactly one does.
    pub caught_one: Ty?,
    /// What the guarded expression of the nearest `catch` turned out to hold.
    pub guarded: CheckGuarded?,
    /// How many loops are open around the statement, from the nearest boundary.
    pub loops: i64,
    /// **How many right sides of `&&` / `||` stand around the expression**
    /// (#1567): one runs only where its left side lets it, so a divisor the
    /// checker folds to zero there is left to the walk (`NK1207`), which reads
    /// the guard, and is no certain `NK1118`. A branch of an `if` whose
    /// condition folds the other way counts too (#1588).
    pub short_circuited: i64,
    /// The nearest boundary a jump may not cross (a lambda, a task, an
    /// `overlap` branch).
    pub barrier: String?,
    /// **The innermost `async { }` around the expression in this function**
    /// (ADR-async-5 D9), by its node; a lambda starts again with none.
    pub async_group: i64?,
    /// The `async { }` whose own block the next `check_core_block` walks.
    pub async_group_block: i64?,
    /// How many tasks the innermost `async { }` started so far (`NK2111`).
    pub async_started: i64,
    /// The groups written `limit: 1` with the literal (ADR-async-5 D15): their
    /// tasks run one at a time and are not checked against each other (D7).
    pub async_one_at_a_time: collections::BTreeSet[i64],
    /// How many `async` forms stand around the expression in this function:
    /// a `return` inside one would leave it (`NK1132`, D10).
    pub async_depth: i64,
    /// Method calls whose callee's contract says it can fail, and the ones
    /// where that could not be established.
    pub fallible_methods: collections::BTreeSet[i64],
    pub opaque_methods: collections::BTreeSet[i64],
    /// The same pair for the calls whose callee pauses.
    pub pausing_methods: collections::BTreeSet[i64],
    pub settled_methods: collections::BTreeSet[i64],
    /// The lambdas of the call being walked that paused and were handed to a
    /// `std` entry (ADR-233 D1).
    pub paused_args: Vec[i64],
    /// What the body of each lambda handed to a parameter of a function type
    /// ends with, by the lambda, beside the type the parameter says it hands
    /// back: a fold's step that ends with nothing changes its accumulator in
    /// place (ADR-372 D9).
    pub lambda_tails: collections::BTreeMap[i64, Ty],
    /// The `return`s of each lambda being walked, innermost last (#758).
    pub lambda_returns: Vec[Vec[CheckLambdaReturn]],
    /// The `return`s of the lambda walked last.
    pub last_lambda_returns: Vec[CheckLambdaReturn],
    /// The next number to give a choice: one per `if` and per `match`.
    pub next_choice: i64,
    /// **The choices one of whose branches every run takes**, by number:
    /// how many branches (#1140). A `match`, and an `if` with an `else`; an
    /// `if` without one is not here, its other way is to go past it.
    pub choice_arms: collections::BTreeMap[i64, i64],
    /// Which read an expression is, by the expression's id (ADR-293 D1).
    pub read_index: collections::BTreeMap[(i64, i64), i64],
    /// `??`s that may lend their left side (ADR-279 D5).
    pub pending_coalesces: Vec[CheckPendingCoalesce],
    /// Names of owned text beside a `+` that are lent if read again (#1324).
    pub pending_concatenations: Vec[CheckPendingConcat],
    /// **Bindings a `let` declared as an owned `T?`** (#1291): what they hold
    /// was copied out at the `let`, so a read of them is not copied again.
    pub declared_options: collections::BTreeSet[i64],
    /// Set by an assignment whose target is an index (ADR-293 D27).
    pub writing_index: bool,
    /// Set where an `Index` read a map (ADR-293 D28).
    pub read_a_map: bool,
    /// Set while an immutable `let` checks its value (#819), typed or not
    /// (#827), and while a call argument does: a list element past a jump is
    /// bound as a view of it.
    pub lending_let: bool,
    /// Every read of a map, by the expression's id (ADR-293 D15).
    pub map_read_sites: collections::BTreeSet[i64],
    /// The bindings a `let` made of a map read (#297), by binding.
    pub map_views: collections::BTreeSet[i64],
    /// A list's `get`, `first` or `last` of a tuple, by the call's id: a view
    /// of the element below (`Option<&T>`).
    pub lent_list_reads: collections::BTreeSet[i64],
    /// A call a field is read off whose result is handed over owned, by the
    /// call's id (#1191): `f().inner` is a part of a value nothing else owns,
    /// so a `let` of it moves it out and is no view.
    pub owned_call_bases: collections::BTreeSet[i64],
    /// A `get` of a `std` list or map, by the call's id: the read a `let mut`
    /// past a jump turns into a mutable view of the entry (#952).
    pub std_gets: collections::BTreeSet[i64],
    /// A map's read whose element is itself a view, by the read's id: Rust's
    /// read is a view of that view (`Option<&&str>`), so where a `T?` of the
    /// view is kept the read is copied out (ADR-293 D15, #996).
    pub view_reads: collections::BTreeSet[i64],
    /// An `Entry`'s `or_insert` or `or_insert_with`, by the call's id: the
    /// value in the map, which a `let mut` binds as the `&mut` itself (#974).
    pub std_entry_views: collections::BTreeSet[i64],
    /// The bindings a `let mut` made a mutable view of a place, by their id:
    /// the `&mut` already, lent on to a `mut` parameter as `&mut *x` (#975).
    pub mut_view_bindings: collections::BTreeSet[i64],
    /// **The bindings a `let` gave views and text of its own**, by their id
    /// (ADR-282 D14, #1310): typed as the view they may be, they hold
    /// `EitherText`, which a read-only `String` parameter is lent (`&x`).
    pub either_bindings: collections::BTreeSet[i64],
    /// Whether the last `std` method call handed back a view of a `String`
    /// slot (`ref $V` bound to owned text, #1388), read by the call's caller.
    pub text_slot: bool,
    /// Whether it handed back a view of a slot that holds text, owned or a
    /// view (#1388): a walk of it reads `&String` or `&&str`.
    pub text_walk: bool,
    /// **The method calls that hand back a view of a `String` slot**, by
    /// their id (#1388): typed as the one text view (ADR-184 D2), below they
    /// are `&String`, or `&mut String` where a `let mut` writes through them.
    pub text_slot_views: collections::BTreeSet[i64],
    /// The method calls that hand back views of slots that hold text, owned
    /// or views, by their id (#1388).
    pub text_walks: collections::BTreeSet[i64],
    /// The bindings a `let mut` made a view of a `String` slot, by their id
    /// (#1388): what is assigned through them is owned text.
    pub text_slot_bindings: collections::BTreeSet[i64],
    /// The ledger key the last method call resolved to (ADR-293 D24).
    pub last_resolved: String?,
    /// The name of the receiver of the method call being walked, where it is a
    /// plain name (ADR-105 D2).
    pub receiver_name: String?,
    /// The receiver of the call being checked is a file's name the compiler
    /// followed back to text (ADR-319 D5).
    pub receiver_from_text: bool,
    /// The bindings of a file's name made from text, by binding (D5).
    pub text_paths: collections::BTreeSet[i64],
    /// The `let`s that bind one name to a `TaskHandle`, by the `let`'s byte:
    /// the handle has to be taken before its scope ends (`NK2109`), whatever
    /// made it - a `spawn` or a call that hands one back.
    pub handle_lets: collections::BTreeSet[i64],
    /// The `let`s whose value was an empty list and whose element type nothing
    /// has said yet (ADR-135 D2), by the `let`'s byte.
    pub empty_lists: collections::BTreeMap[i64, (String, Span)],
    /// Those of `empty_lists` that are an unannotated map (ADR-285 D43): a
    /// map nothing writes into and nothing types is asked as a list is.
    pub empty_maps: collections::BTreeSet[i64],
    /// The numbers whose uses decide their type, by the `let` (ADR-285).
    pub open_numbers: collections::BTreeMap[i64, CheckOpenNumber],
    /// The `'…'`s a `let` binds whose uses decide `u8` or `scalar`, by the
    /// binding (ADR-320 D8).
    pub open_chars: collections::BTreeMap[i64, CheckOpenChar],
    /// The `'\xNN'` above `\x7F` not bound by a `let`, by node: a use that
    /// wants a `u8` makes each a byte, and one left a `scalar` is `NK1212`.
    pub high_bytes: collections::BTreeMap[i64, (String, Span)],
    /// The `'…'` of one scalar that is not ASCII, by node, and its length in
    /// bytes and its statement: where a `u8` is wanted it is `NK1212`.
    pub wide_chars: collections::BTreeMap[i64, (i64, Span)],
    /// The `'…'`s already refused where a `u8` is wanted, said once.
    pub chars_refused: collections::BTreeSet[i64],
    /// A list written in number literals: the binding and the entry of
    /// `open_numbers` it names (ADR-285 D34).
    pub open_elements: collections::BTreeMap[i64, i64],
    /// **A list of lists written in numbers** (#938): the binding and how
    /// many lists stand around the number in it, where more than one; its
    /// number is in `open_elements`. An index or a walk of it hands on one
    /// list fewer.
    pub open_levels: collections::BTreeMap[i64, i64],
    /// **A map's keys written in number literals** (ADR-285 D43): the binding
    /// and the entry of `open_numbers` they are; its values are in
    /// `open_elements`, as a list's elements are.
    pub open_keys: collections::BTreeMap[i64, i64],
    /// **A tuple written in numbers** (#837): the binding and, per part, the
    /// entry of `open_numbers` it is, or -1.
    pub open_parts: collections::BTreeMap[i64, Vec[i64]],
    /// The entries of `open_numbers` that are a map's keys or values, by the
    /// entry: `true` for the keys, and the other part's type as written, for
    /// the message.
    pub open_map_parts: collections::BTreeMap[i64, (bool, String)],
    /// The entries of `open_numbers` that are a list literal walked in place
    /// (#1485): no `let` stands where the type is written, so every literal
    /// in it carries the type.
    pub open_literal_lists: collections::BTreeSet[i64],
    /// **A `sum` of an open number's items** (#1485): the receiver and the
    /// entry of `open_numbers`; the call names the type the number gets.
    pub open_sums: collections::BTreeMap[i64, i64],
    /// **A walk whose items are an open number** (ADR-285 D34, #594), by the
    /// call that makes it, and the entry of `open_numbers` it names.
    pub open_walks: collections::BTreeMap[i64, i64],
    /// **An item a walk of an open number hands back** (#931): `sum` of
    /// `xs.iter()` with `xs = [1, 2, 3]`, by the call, and the entry of
    /// `open_numbers` it is one of.
    pub open_items: collections::BTreeMap[i64, i64],
    /// The parameters of a lambda the call being walked hands such items to,
    /// by name, and the entry of `open_numbers` each is bound to.
    pub open_params: collections::BTreeMap[String, i64],
    /// What the method call just checked hands back: a walk of this open
    /// number, and whether as views of it.
    pub walk_open: i64?,
    pub walk_view: bool,
    /// What it hands back is one of the walk's items itself, of this open
    /// number (#931).
    pub walk_item: i64?,
    /// **A walk whose items are lent** (#626), by the call that makes it: a
    /// walk of views of a list's elements, and one that hands those on.
    pub lent_walks: collections::BTreeSet[i64],
    /// The parameters of a lambda the call being walked hands a lent item
    /// to, by name, for `lambda_parameter` to bind as lent.
    pub lent_params: collections::BTreeSet[String],
    /// **The text parameters of such a lambda** (#688), by binding: a view
    /// of the item one level or two below, so compared as `str`.
    pub lent_text_params: collections::BTreeSet[i64],
    /// Whether the method call just checked hands back a walk that lends.
    pub walk_lent: bool,
    /// The `fn` type the place a lambda stands in declares (#497).
    pub lambda_expected: Ty?,
    /// The last value of the lambda walked last (`async fn { … }`'s value,
    /// ADR-async-5 D10: the lambda is run).
    pub lambda_tail: Ty?,
    /// The `fn` type a lambda bound by the `let` about to be checked is first
    /// handed to (#997), found by the block it stands in.
    pub let_lambda_use: Ty?,
    /// The leaves of a function's last value that are a place of a borrowed
    /// parameter, found while its scope stands (#738), by their nodes.
    pub lent_tail_leaves: collections::BTreeSet[i64],
    /// The bindings a `let` bound to an element of a list this body made,
    /// read whole (`let e = xs[0]`), by their ids (#1368).
    pub made_elements: collections::BTreeSet[i64],
    /// The reads of such an element, `xs[0]` or `e`, by their nodes, found
    /// while the scope stands: a function's last value is asked after it.
    pub made_element_reads: collections::BTreeSet[i64],
    /// A generic call that hands back the number it was given (#497), by the
    /// call's first argument.
    pub open_calls: collections::BTreeMap[i64, Vec[i64]],
    /// The `let`s whose value had no known type (#497), by binding.
    pub unknown_bound: collections::BTreeSet[i64],
    /// **The lambda parameters handed a value of no known type** (#703), by
    /// binding: a member of one is asked where the lambda stands (`NK1245`).
    pub unknown_lambda_params: collections::BTreeSet[i64],
    /// **The binding of each lambda's first parameter**, by the lambda's
    /// node (#762): an in-place fold step lends it on as `&mut *acc`.
    pub lambda_firsts: collections::BTreeMap[i64, i64],
    /// The first parameter's binding of the lambda checked last.
    pub last_lambda_first: i64,
    /// How many `NK1245`s this walk has said (or stood back for).
    pub unknown_said: i64,
    /// What such a list holds, where nothing can change it (D26).
    pub list_constants: collections::BTreeMap[i64, Vec[CheckConstant]],
    /// The statements an operation in has already overflowed, by the byte.
    pub overflowed: collections::BTreeSet[i64],
    /// The integer type a `let` states, on its way to the operands (D32).
    pub reaching: String?,
    /// What the expression being walked was handed of `reaching`.
    pub reached: String?,
    /// The names this function's body gives text of its own later on.
    pub grown_text: collections::BTreeSet[String],
    /// **The names of those that are also assigned a field read** (ADR-282
    /// D13, #840): views and text of their own flow into them, so a name that
    /// started as a literal holds `EitherText`.
    pub mixed_text: collections::BTreeSet[String],
    /// The conversions that do not narrow.
    pub widening_casts: collections::BTreeSet[i64],
    /// Signed values put where an unsigned type is stated, by the statement.
    pub unsigned_slots: collections::BTreeMap[i64, Vec[CheckUnsignedSlot]],
    /// Whether the lambda being walked is a write door's block (ADR-281 D12).
    pub at_a_write_door: bool,
    /// The name of an empty list a `push` is being walked on (#523).
    pub pushed_into: String?,
    /// The receiver of the call `pushed_into` was held for, by its node: a
    /// call inside it, its receiver's or an argument's, is not that write.
    pub pushed_receiver: i64,
    /// **What a `let mut` holds where straight-line code has followed it**
    /// (Part III C.4), by binding: its value, and each value assigned to it
    /// in the frame it was bound in. An assignment in a nested block forgets
    /// it, and a loop or a lambda around a read does not see it.
    pub followed: collections::BTreeMap[i64, Integer],
    /// **The `.clone()`s of a `let` that may be its last use** (`NK1350`,
    /// #1318), asked where the body ends.
    pub clones: Vec[CheckClone],
    /// **The names a `let` bound to a view of another**, by that other's
    /// binding: a read of the view after a clone keeps the clone needed.
    pub clone_loans: Vec[(String, i64?)],
    /// **The `let`s bound to a value made there**, by binding: a call's, a
    /// literal's; only their clone can be the last use (`NK1350`).
    pub clone_owners: collections::BTreeSet[i64],
}

/// **A `.clone()` of a `let`, held to the body's end** (`NK1350`, #1318): the
/// copy is needless where no read of the binding follows it on a path.
pub struct CheckClone {
    pub name: String,
    pub binding: i64?,
    /// The read of the receiver, in the walk's order.
    pub seq: i64,
    pub choices: Vec[(i64, i64)],
    /// The call's node, said once.
    pub node: i64,
    pub span: Span,
}

impl CheckFlow {
    /// The flow at the start of a body's walk.
    pub fn start(computes: bool, harvesting: bool) -> CheckFlow {
        return CheckFlow {
            raised: (null, null),
            computes: computes,
            option_values: Vec(),
            option_literals: Vec(),
            method_passed: collections::BTreeMap(),
            unrolling: null,
            harvesting: harvesting,
            inside_a_comptime: false,
            literal_receivers: Vec(),
            expected_either: false,
            field_either: false,
            throwing: false,
            caught: false,
            swallowed: null,
            caught_several: false,
            caught_one: null,
            guarded: null,
            loops: 0,
            short_circuited: 0,
            barrier: null,
            async_group: null,
            async_group_block: null,
            async_started: 0,
            async_one_at_a_time: collections::BTreeSet(),
            async_depth: 0,
            fallible_methods: collections::BTreeSet(),
            opaque_methods: collections::BTreeSet(),
            pausing_methods: collections::BTreeSet(),
            settled_methods: collections::BTreeSet(),
            paused_args: Vec(),
            lambda_tails: collections::BTreeMap(),
            lambda_returns: Vec(),
            last_lambda_returns: Vec(),
            next_choice: 0,
            choice_arms: collections::BTreeMap(),
            read_index: collections::BTreeMap(),
            pending_coalesces: Vec(),
            pending_concatenations: Vec(),
            declared_options: collections::BTreeSet(),
            writing_index: false,
            read_a_map: false,
            lending_let: false,
            map_read_sites: collections::BTreeSet(),
            map_views: collections::BTreeSet(),
            lent_list_reads: collections::BTreeSet(),
            owned_call_bases: collections::BTreeSet(),
            std_gets: collections::BTreeSet(),
            view_reads: collections::BTreeSet(),
            std_entry_views: collections::BTreeSet(),
            mut_view_bindings: collections::BTreeSet(),
            either_bindings: collections::BTreeSet(),
