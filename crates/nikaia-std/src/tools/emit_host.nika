// crates/nikaia-std/src/tools/emit_host.nika
//
// **The host of the emitter's core** (ADR-294, #125, #558, E9, units U0b..U10):
// what the part of the lowering that has moved to Nikaia asks of the part that
// has not. `EmitHost` is implemented by the Rust `Emitter` (`emit/host.rs`);
// the moved methods are `emit_core_*[H: EmitHost]` of `EmitState`, and the
// Rust method of the same name is a one-line stub. A callee that has moved is
// `self.emit_core_*`, one that has not is `host.<name>`; the trait shrinks
// until U10 deletes it.
//
// The walk is passed as `mut walk`, the output as `mut out`; the flow is the
// pair `EmitFlow` (by value) and `EmitScope` (by reference).

/// What the core asks of the Rust side. Every method may refuse.
pub trait EmitHost {
    /// `Emitter::expr`: an expression, written to `out`.
    fn expr(ref self, mut walk: EmitWalk, mut out: EmitOut, node: ref Expr, depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws

    /// `Emitter::block_opening_with`: a block, with `opening` (one line) written
    /// before its statements where there is one.
    fn block_opening_with(ref self, mut walk: EmitWalk, mut out: EmitOut, block: ref Block, depth: i64, flow: EmitFlow, scope: ref EmitScope, tail: EmitTail, opening: String?) sync throws

    /// A hole of an `f"..."` with what the tier pass hands over inside it
    /// (`text_tiers::wrap_hole`).
    fn wrap_hole(ref self, hole: ref Expr, wraps: ref Vec[(i64, winnow_grammar::Symbol)]) -> Expr sync

    /// The names of the variables read anywhere in `expr`, string holes
    /// included, in the order the walk meets them (`sync::visit_expr`).
    fn names_read(ref self, expr: ref Expr) -> Vec[String] sync

    /// The names bound out of a lent value that an arm copies out
    /// (`check::Checked::copied_bindings`), for the arm whose body is at `at`.
    fn copied_bindings(ref self, at: i64) -> Vec[String] sync

    /// The names a guard reads inside a box that an arm copies out
    /// (`check::Checked::guards_inside_boxes`), for the arm whose body is at `at`.
    fn guard_copies(ref self, at: i64) -> Vec[String] sync

    /// `Build::overlaps_user_code`: user code may run on more than one thread.
    fn overlaps_user_code(ref self) -> bool sync

    /// `Build::crossings_are_possible`: values may cross threads, or the program
    /// is called from C.
    fn crossings_are_possible(ref self) -> bool sync

    /// `Build::user_parallelism` is `yes`.
    fn user_parallelism(ref self) -> bool sync

    /// What the runtime is asked to do, as `winnow_grammar::rt` names it:
    /// `Parallelism::Off` or `Parallelism::Auto` (`Build::parallelism`).
    fn parallelism(ref self) -> String sync

    /// An expression as the program wrote it (`check::written`), which is what
    /// the prover's reaches are keyed by (`prove::call_key`).
    fn written(ref self, expr: ref Expr) -> String sync

    /// The buffers whose keeps hold the values a method call puts into the
    /// keeper rooted at `root`, by argument, each padded to the keeper's widest
    /// value (ADR-283 D12, D15); `null` where the plan holds none. A set cannot
    /// be walked in Nikaia.
    fn held_buffers(ref self, walk: ref EmitWalk, function: ref String, statement: i64, root: ref String) -> Vec[(i64, Vec[i64])]? sync
}

impl EmitState {
    /// A cast's operand, through the view a `for` binding is (ADR-182 D1):
    /// inside the checked conversion and not around it.
    pub fn emit_core_operand[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, node: ref Expr, viewed: bool, depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        if !viewed {
            host.expr(walk, out, node, depth, flow, scope)
            return
        }
        out.push("nikaia_std::num::value(")
        host.expr(walk, out, node, depth, flow, scope)
        out.push(")")
    }

    /// A range as the language below writes one, `a..b`, for the two places
    /// that walk or slice it where it stands (ADR-293 D18).
    pub fn emit_core_bare_range[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, node: ref Expr, depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        match node {
            Expr::Range { start, end, inclusive, .. } => {
                host.expr(walk, out, start, depth, flow, scope)
                if inclusive {
                    out.push("..=")
                } else {
                    out.push("..")
                }
                host.expr(walk, out, end, depth, flow, scope)
            },
            else => host.expr(walk, out, node, depth, flow, scope),
        }
    }

    /// What stands inside brackets: a range there is a slice, and stays the
    /// language below's own (ADR-293 D18).
    pub fn emit_core_index_expr[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, node: ref Expr, depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        self.emit_core_bare_range(world, walk, out, host, node, depth, flow, scope)
    }
}
