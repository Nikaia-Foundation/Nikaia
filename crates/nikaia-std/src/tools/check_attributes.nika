// crates/nikaia-std/src/tools/check_attributes.nika
//
// **Attributes** (ADR-294, #125, C-7, U-d2; ADR-331 D1-D4, Part II 10.3):
// `@json::Name("createdAt")` before a declaration is a value of the struct the
// path names. A struct is an attribute where `@meta::Attribute(…)` marks it,
// naming the places it may stand; anywhere else it is `NK1235`, and a second
// one where the mark does not say `repeatable: true` is `NK1236`. The
// arguments are checked as a call's are, against the struct's fields: those
// without a default by position, those with one by name after the `;`.
//
// `Mark` itself, `mark_of` and `@inline`'s `inline_written` stay Rust's: the
// ledger and the emitter read them. The mark here is the checker's copy.

use std::collections

/// What a struct's `@meta::Attribute(…)` says: the places, and whether it may
/// stand twice.
pub struct CheckAttributesMark {
    pub places: collections::BTreeSet[String],
    pub repeatable: bool,
}

/// The mark itself, which `std` declares and nothing else may be.
fn check_attributes_mark_name() -> String {
    return "meta::Attribute"
}

/// **`@inline`, the language's own** (ADR-370 D1).
fn check_attributes_inline_name() -> String {
    return "inline"
}

/// A trait's method, which `@inline` may not stand before: it has no body.
fn check_attributes_trait_fn() -> String {
    return "trait fn"
}

/// Where an attribute may stand, as the mark's arguments spell them (D2).
fn check_attributes_places() -> Vec[String] {
    return ["field".clone(), "struct".clone(), "enum".clone(), "variant".clone(), "fn".clone(), "parameter".clone(), "trait".clone(), "impl".clone()]
}

fn check_attributes_places_text() -> String {
    let mut text: String = ""
    for place in check_attributes_places() {
        if text != "" {
            text = f"{text}, "
        }
        text = f"{text}`{place}`"
    }
    return text
}

fn check_attributes_place_or_field(place: ref String) -> String {
    if place == "" {
        return "field"
    }
    return place.clone()
}

/// ASCII case-insensitive equality of two words.
fn check_attributes_same_word(left: ref String, right: ref String) -> bool {
    let mut a: String = ""
    for c in left.chars() {
        a.push(c.to_ascii_lowercase())
    }
    let mut b: String = ""
    for c in right.chars() {
        b.push(c.to_ascii_lowercase())
    }
    return a == b
}

/// A place named in a mark's arguments: a word, or the last segment of a
/// path in lower case; `""` for anything else.
fn check_attributes_place_word(unit: ref ParsedView, arg: ref Expr) -> String {
    match arg {
        Expr::Variable(word, _) => return unit.text(word),
        Expr::Path(segments, _) => {
            if segments.len() == 0 {
                return ""
            }
            let last = segments.len() as i64 - 1
            return unit.text(segments[last]).to_lowercase()
        },
        else => return "",
    }
}

/// Read back from the ledger's `attribute` column (`field, struct; repeatable`).
fn check_attributes_mark_read(text: ref String) -> CheckAttributesMark {
    let mut places: collections::BTreeSet[String] = collections::BTreeSet()
    let mut word: String = ""
    let mut rest: String = ""
    let mut after = false
    for c in text.chars() {
        if after {
            rest.push(c)
            continue
        }
        if c == ',' || c == ';' {
            let trimmed = word.trim()
            if trimmed != "" {
                places.insert(trimmed.clone())
            }
            word = ""
            if c == ';' {
                after = true
            }
            continue
        }
        word.push(c)
    }
    if !after {
        let trimmed = word.trim()
        if trimmed != "" {
            places.insert(trimmed.clone())
        }
    }
    return CheckAttributesMark { places: places, repeatable: rest.trim() == "repeatable" }
}

/// The places a mark names, read off its arguments; a word that is not one is
/// refused where the mark is checked.
fn check_attributes_mark_of(unit: ref ParsedView, mark: ref Attribute) -> CheckAttributesMark {
    let mut places: collections::BTreeSet[String] = collections::BTreeSet()
    let known = check_attributes_places()
    for arg in mark.args {
        let word = check_attributes_place_word(unit, arg)
        if known.contains(word) {
            places.insert(word)
        }
    }
    let mut repeatable = false
    for option in mark.config {
        if unit.text(option.name) == "repeatable" {
            match option.value {
                Expr::LitBool(true, _) => { repeatable = true },
                else => {},
            }
        }
    }
    return CheckAttributesMark { places: places, repeatable: repeatable }
}

/// **The marks of the structs of one file.**
fn check_attributes_marks_in(unit: ref ParsedView, mut marks: collections::BTreeMap[String, CheckAttributesMark]) sync {
    let mark_name = check_attributes_mark_name()
    for item in unit.items {
        match item.node {
            Item::Struct { name, .. } => {
                for attribute in item.attributes {
                    let written = unit.text(attribute.name)
                    if unit.unaliased(written) == mark_name {
                        marks.insert(unit.text(name), check_attributes_mark_of(unit, attribute))
                        break
                    }
                }
            },
            else => {},
        }
    }
}

/// **The marks of this package's structs**, read off every file of it: an
/// attribute declared in one file is used in another.
fn check_attributes_marks(world: ref CheckWorld) -> collections::BTreeMap[String, CheckAttributesMark] sync {
    let mut marks: collections::BTreeMap[String, CheckAttributesMark] = collections::BTreeMap()
    // **A dependency's, from its ledger** (D8), under the name the type has
    // there and the name a program writes after its package.
    for (key, contract) in world.library.types {
        if contract.mark != "" {
            marks.insert(key.clone(), check_attributes_mark_read(contract.mark))
        }
    }
    for (key, contract) in world.own.types {
        if contract.mark != "" {
            marks.insert(key.clone(), check_attributes_mark_read(contract.mark))
        }
    }
    check_attributes_marks_in(world.here, marks)
    for unit in world.beside {
        check_attributes_marks_in(unit, marks)
    }
    return marks
}

fn check_attributes_mark_for(marks: ref collections::BTreeMap[String, CheckAttributesMark], name: ref String) -> CheckAttributesMark? {
    let mark = marks.get(name) ?? return null
    return mark.clone()
}

fn check_attributes_allows(marks: ref collections::BTreeMap[String, CheckAttributesMark], name: ref String, place: ref String) -> bool {
    let mark = marks.get(name) ?? return false
    return mark.places.contains(place)
}

fn check_attributes_repeats(marks: ref collections::BTreeMap[String, CheckAttributesMark], name: ref String) -> bool {
    let mark = marks.get(name) ?? return false
    return mark.repeatable
}

/// **Every attribute of this file, where it stands** (ADR-331 D1-D4).
pub fn check_attributes_all[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H) sync {
    let marks = check_attributes_marks(world)
    for item in world.here.items {
        let place: String = match item.node {
            Item::Struct { .. } => "struct",
            Item::Enum { .. } => "enum",
            Item::Fn { .. } => "fn",
            Item::Trait { .. } => "trait",
            Item::Impl { .. } => "impl",
            else => "",
        }
        check_attributes_at(state, world, host, item.attributes, place, marks)
        match item.node {
            Item::Struct { fields, .. } => {
                for field in fields {
                    check_attributes_at(state, world, host, field.attributes, "field", marks)
                }
            },
            Item::Enum { variants, .. } => {
                for variant in variants {
                    check_attributes_at(state, world, host, variant.attributes, "variant", marks)
                    match variant.fields {
                        VariantFields::Named(fields) => {
                            for field in fields {
                                check_attributes_at(state, world, host, field.attributes, "field", marks)
                            }
                        },
                        else => {},
                    }
                }
            },
            Item::Fn { args, .. } => check_attributes_parameters(state, world, host, args, marks),
            Item::Impl { methods, .. } => {
                for method in methods {
                    check_attributes_at(state, world, host, method.attributes, "fn", marks)
                    match method.node {
                        Item::Fn { args, .. } => check_attributes_parameters(state, world, host, args, marks),
                        else => {},
                    }
                }
            },
            Item::Trait { methods, .. } => {
                for method in methods {
                    check_attributes_at(state, world, host, method.attributes, check_attributes_trait_fn(), marks)
                    check_attributes_parameters(state, world, host, method.node.args, marks)
                }
            },
            else => {},
        }
    }
}

fn check_attributes_parameters[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, args: ref Vec[FnArg], marks: ref collections::BTreeMap[String, CheckAttributesMark]) sync {
    for arg in args {
        check_attributes_at(state, world, host, arg.attributes, "parameter", marks)
    }
}

/// The attributes before one declaration, `place` being what it is; an empty
/// `place` is a declaration no attribute may stand before.
fn check_attributes_at[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, attributes: ref Vec[Attribute], place: ref String, marks: ref collections::BTreeMap[String, CheckAttributesMark]) sync {
    let mut seen: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let mut inlines: i64 = 0
    let inline_name = check_attributes_inline_name()
    let mark_name = check_attributes_mark_name()
    let trait_fn = check_attributes_trait_fn()
    for attribute in attributes {
        let written = world.here.text(attribute.name)
        let name = world.here.unaliased(written)
        if name == inline_name {
            inlines += 1
            check_attributes_the_inline(state, world, attribute, place, inlines)
            continue
        }
        // A trait's method is a `fn` to every attribute but `@inline`.
        let mut here: String = place.clone()
        if place == trait_fn {
            here = "fn"
        }
        if name == mark_name {
            check_attributes_the_mark(state, world, attribute, here)
            continue
        }
        let declared = state.fields_of(world, name)
        if declared == null {
            check_attributes_nothing_declares(state, name, attribute.span)
            continue
        }
        let fields: Vec[FieldContract] = declared ?? []
        let mark = check_attributes_mark_for(marks, name)
        if !check_attributes_allows(marks, name, here) {
            check_attributes_out_of_place(state, name, here, mark, attribute.span)
            continue
        }
        let mut count: i64 = 1
        if seen.contains_key(name) {
            count = (seen.get(name) ?? 0) + 1
        }
        seen.insert(name.clone(), count)
        if count == 2 && !check_attributes_repeats(marks, name) {
            check_attributes_written_twice(state, name, attribute.span)
        }
        check_attributes_arguments(state, world, host, name, fields, attribute)
    }
}

/// What `@inline` is refused for, in the words the checker says it in.
fn check_attributes_inline_refusal(world: ref CheckWorld, attribute: ref Attribute) -> String? {
    let bare = attribute.config.len() == 0
    if attribute.args.len() == 0 && bare {
        return null
    }
    if attribute.args.len() == 1 && bare {
        match attribute.args[0] {
            Expr::Variable(word, _) => {
                let spelled = world.here.text(word)
                if spelled == "always" || spelled == "never" {
                    return null
                }
                return f"`@inline` takes `always` or `never`, and `{spelled}` is neither."
            },
            else => return "`@inline` takes `always` or `never`, and this is neither.".clone(),
        }
    }
    return "`@inline` takes one word at most: `always` or `never`.".clone()
}

/// **`@inline`, `@inline(always)`, `@inline(never)`** (ADR-370 D1): before a
/// function or a method with a body, once, with no word but `always` or
/// `never`.
fn check_attributes_the_inline(mut state: CheckState, world: ref CheckWorld, attribute: ref Attribute, place: ref String, count: i64) sync {
    if place != "fn" {
        let mut message: String = f"`@inline` stands before a function or a method, and this is a `{place}`."
        let mut note: String = "It asks that a function's body be copied to where it is called."
        let mut help: String = "Move it before a `fn`, or remove it."
        if place == check_attributes_trait_fn() {
            message = "`@inline` stands before a function with a body, and a trait's method declares none."
            note = "What is inlined is a body: the one each `impl` writes."
            help = "Write `@inline` before the method in the `impl`."
        }
        if place == "" {
            message = "`@inline` stands before a function or a method, and this is neither."
        }
        state.findings.push(check_refusal("NK1235", attribute.span, message, [note], help))
        return
    }
    if count == 2 {
        state.findings.push(check_refusal("NK1236", attribute.span, "`@inline` stands twice before one function.".clone(), ["A function is inlined, always inlined or never: one of them.".clone()], "Remove one.".clone()))
    }
    let refused = check_attributes_inline_refusal(world, attribute)
    if refused != null {
        let message = refused ?? return
        state.findings.push(check_refusal("NK1293", attribute.span, message, ["`@inline` asks, `@inline(always)` insists, `@inline(never)` forbids.".clone()], "Write `@inline`, `@inline(always)` or `@inline(never)`.".clone()))
    }
}

/// `@meta::Attribute(field, variant; repeatable: true)` itself: only on a
/// struct, with places it knows and the one option.
fn check_attributes_the_mark(mut state: CheckState, world: ref CheckWorld, attribute: ref Attribute, place: ref String) sync {
    if place != "struct" {
        let mark_name = check_attributes_mark_name()
        check_attributes_out_of_place(state, mark_name, place, null, attribute.span)
        return
    }
    if attribute.args.len() == 0 {
        state.findings.push(check_refusal("NK1101", attribute.span, "`@meta::Attribute` names where the attribute may stand, and this names no place.".clone(), [f"The places are {check_attributes_places_text()}."], "Write `@meta::Attribute(field)`.".clone()))
    }
    let known = check_attributes_places()
    for arg in attribute.args {
        let word = check_attributes_place_word(world.here, arg)
        if !known.contains(word) {
            let mut message: String = f"`@meta::Attribute` takes places, and `{word}` is not one."
            if word == "" {
                message = "`@meta::Attribute` takes places, and this is not one."
            }
            state.findings.push(check_refusal("NK1102", attribute.span, message, [f"The places are {check_attributes_places_text()}."], "Name a place by its word alone: `field`.".clone()))
        }
    }
    for option in attribute.config {
        let option_name = world.here.text(option.name)
        if option_name != "repeatable" {
            state.findings.push(check_refusal("NK1109", attribute.span, f"`@meta::Attribute` has no option called `{option_name}`.", ["Its one option is `repeatable: bool`.".clone()], "Write `repeatable: true`, or leave it out.".clone()))
            continue
        }
        let is_bool = match option.value {
            Expr::LitBool(_, _) => true,
            else => false,
        }
        if !is_bool {
            state.findings.push(check_refusal("NK1102", attribute.span, "`repeatable` is `true` or `false`.".clone(), [], "Write `repeatable: true`.".clone()))
        }
    }
}

/// **The arguments, against the fields** (D4): those without a default by
/// position, in declaration order, those with one by name after the `;`; each
/// a build-time value, and a variant of the field's `enum` by its name alone
/// (D3).
fn check_attributes_arguments[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, name: ref String, fields: ref Vec[FieldContract], attribute: ref Attribute) sync {
    let mut required: Vec[FieldContract] = []
    let mut options: Vec[FieldContract] = []
    for field in fields {
        if field.default == "" {
            required.push(field.clone())
        } else {
            options.push(field.clone())
        }
    }
    if attribute.args.len() != required.len() {
        let mut wanted: String = ""
        for field in required {
            if wanted != "" {
                wanted = f"{wanted}, "
            }
            wanted = f"{wanted}`{field.name}`"
        }
        let mut plural: String = "s"
        if required.len() == 1 {
            plural = ""
        }
        let mut note: String = f"They are the fields without a default, in the order `{name}` declares them: {wanted}."
        if required.len() == 0 {
            note = f"Every field of `{name}` has a default, so each is named after the `;`."
        }
        state.findings.push(check_refusal("NK1101", attribute.span, f"`@{name}` takes {required.len()} argument{plural} before the `;`, and this gives {attribute.args.len()}.", [note], "Give one value for each, by position.".clone()))
    }
    let mut at: i64 = 0
    while at < required.len() as i64 && at < attribute.args.len() as i64 {
        check_attributes_argument(state, world, host, name, required[at], attribute.args[at], attribute.span)
        at += 1
    }
    for option in attribute.config {
        let option_name = world.here.text(option.name)
        let mut found: i64 = -1
        let mut index: i64 = 0
        while index < options.len() as i64 {
            if options[index].name == option_name {
                found = index
                break
            }
            index += 1
        }
        if found >= 0 {
            check_attributes_argument(state, world, host, name, options[found], option.value, attribute.span)
            continue
        }
        let mut known: String = ""
        for field in options {
            if known != "" {
                known = f"{known}, "
            }
            known = f"{known}`{field.name}`"
        }
        let mut positional = false
        for field in required {
            if field.name == option_name {
                positional = true
            }
        }
        let mut note: String = f"Its options are {known}."
        let mut help: String = "Name one of its options, or leave it out."
        if positional {
            note = f"`{option_name}` has no default, so it is given by position, before the `;`."
            help = f"Move `{option_name}`'s value before the `;`."
        } else {
            if options.len() == 0 {
                note = f"No field of `{name}` has a default, so it takes no options."
            }
        }
        state.findings.push(check_refusal("NK1109", attribute.span, f"`@{name}` has no option called `{option_name}`.", [note], help))
    }
}

fn check_attributes_is_null(arg: ref Expr) -> bool {
    return match arg {
        Expr::LitNull(_) => true,
        else => false,
    }
}

fn check_attributes_is_text(arg: ref Expr) -> bool {
    return match arg {
        Expr::LitStr { .. } => true,
        else => false,
    }
}

fn check_attributes_names_string(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, .. } => name == "String",
        else => false,
    }
}

fn check_attributes_argument[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, owner: ref String, field: ref FieldContract, arg: ref Expr, span: ref Span) sync {
    // **A variant by its name alone** (D3): `snake` for a `Case`, read off the
    // field's type - only here.
    match arg {
        Expr::Variable(word, _) => {
            let variants: Vec[String] = check_attributes_variants_of_type(state, world, field.ty) ?? []
            let spelled = world.here.text(word)
            for variant in variants {
                if check_attributes_same_word(variant, spelled) {
                    return
                }
            }
        },
        else => {},
    }
    let nullable = match field.ty {
        Ty::Nullable(_) => true,
        else => false,
    }
    let mut want: Ty = field.ty.clone()
    match field.ty {
        Ty::Nullable(inner) => {
            if !check_attributes_is_null(arg) {
                want = inner.clone()
            }
        },
        else => {},
    }
    if check_attributes_is_null(arg) && nullable {
        return
    }
    if check_attributes_is_text(arg) && check_attributes_names_string(want) {
        return
    }
    // **Anything else is computed at build time** (D1), as an option's
    // default is, under the same codes.
    if !a_literal(arg) {
        let label = f"{owner}.{field.name}"
        check_defaults_computed_value(state, world, host, label, want, arg, span, CheckComputing::Attribute)
        return
    }
    let found = check_core_expr(state, world, host, arg, span)
    let field_name = field.name.clone()
    let kind = check_attributes_literal_misfit(arg, want)
    if kind != null {
        let said = kind ?? return
        let wanted = want.text()
        state.findings.push(check_refusal("NK1102", span, f"`@{owner}`'s `{field_name}` is `{wanted}`, and this gives {said}.", [], f"Give `{field_name}` a `{wanted}`."))
        return
    }
    state.expect_type(world, found, want, span, "argument", fn(found_text, wanted_text) { f"`@{owner}`'s `{field_name}` is `{wanted_text}`, and this gives `{found_text}`." })
}

/// **`field.attribute(X)`'s `X`** (ADR-331 D6): one type, an attribute. `null`
/// where it is refused.
pub fn check_attributes_an_attribute_read(mut state: CheckState, world: ref CheckWorld, args: ref Vec[Expr], span: ref Span) -> String? sync {
    let mut written: String = ""
    let mut one = false
    if args.len() == 1 {
        match args[0] {
            Expr::Variable(name, _) => {
                written = world.here.text(name)
                one = true
            },
            Expr::Path(segments, _) => {
                for segment in segments {
                    if written != "" {
                        written = f"{written}::"
                    }
                    written = f"{written}{world.here.text(segment)}"
                }
                one = true
            },
            else => {},
        }
    }
    if !one {
        state.findings.push(check_refusal("NK1101", span, "`.attribute(X)` takes one type, the attribute to read.".clone(), [], "Write `field.attribute(json::Name)`.".clone()))
        return null
    }
    let name = world.here.unaliased(written)
    if state.fields_of(world, name) == null {
        check_attributes_nothing_declares(state, name, span)
        return null
    }
    let marks = check_attributes_marks(world)
    if !marks.contains_key(name) {
        check_attributes_out_of_place(state, name, "field", null, span)
        return null
    }
    return name
}

/// The variants of a contract, where it has any.
fn check_attributes_names_of(contract: ref TypeContract) -> Vec[String]? {
    if contract.variants.len() == 0 {
        return null
    }
    let mut names: Vec[String] = []
    for variant in contract.variants {
        names.push(variant.name.clone())
    }
    return names
}

/// The variants of an `enum` a field holds, written as the program writes
/// them (`Camel`).
fn check_attributes_variants_of_type(state: ref CheckState, world: ref CheckWorld, ty: ref Ty) -> Vec[String]? {
    let name: ref String = match ty {
        Ty::Named { name, .. } => name,
        else => return null,
    }
    if state.enums.contains_key(name) {
        let set = state.enums.get(name) ?? return null
        let mut names: Vec[String] = []
        for variant in set {
            names.push(variant.clone())
        }
        return names
    }
    let own = world.own.types.get(name)
    if own != null {
        return check_attributes_names_of(own ?? return null)
    }
    let suffix = f"::{name}"
    for (key, contract) in world.library.types {
        if key == name || key.ends_with(suffix) {
            return check_attributes_names_of(contract)
        }
    }
    return null
}

fn check_attributes_nothing_declares(mut state: CheckState, name: ref String, span: ref Span) sync {
    state.findings.push(check_refusal("NK1135", span, f"There's no struct called `{name}`.", ["An attribute is a value of a struct that `@meta::Attribute` marks, declared here or in a package you use.".clone()], "Declare the struct, or fix the name.".clone()))
}

/// `NK1235`: a struct the mark does not make an attribute, or a place its mark
/// does not name.
fn check_attributes_out_of_place(mut state: CheckState, name: ref String, place: ref String, mark: CheckAttributesMark?, span: ref Span) sync {
    let mut here: String = f"a `{place}`"
    if place == "" {
        here = "this declaration"
    }
    let mark_name = check_attributes_mark_name()
    if name == mark_name {
        state.findings.push(check_refusal("NK1235", span, f"`@{mark_name}` marks a struct, and this is {here}.", ["It makes the struct after it an attribute.".clone()], "Move it before a `struct`.".clone()))
        return
    }
    if mark == null {
        state.findings.push(check_refusal("NK1235", span, f"`{name}` is not an attribute: `@{mark_name}` does not mark it.", ["An attribute is a struct marked with `@meta::Attribute(…)`, naming where it may stand.".clone()], f"Write `@meta::Attribute({check_attributes_place_or_field(place)})` before `struct {name}`."))
        return
    }
    let known = mark ?? return
    let mut named: String = ""
    for p in known.places {
        if named != "" {
            named = f"{named}, "
        }
        named = f"{named}`{p}`"
    }
    let mut help: String = f"Add `{place}` to its `@meta::Attribute(…)`, or remove it here."
    if place == "" {
        help = "Remove it."
    }
    state.findings.push(check_refusal("NK1235", span, f"`@{name}` may not stand before {here}.", [f"Its mark names {named}."], help))
}

/// `NK1236`: the same attribute twice before one declaration.
fn check_attributes_written_twice(mut state: CheckState, name: ref String, span: ref Span) sync {
    state.findings.push(check_refusal("NK1236", span, f"`@{name}` stands twice before one declaration.", [f"An attribute stands once unless its mark says `repeatable: true`, and `{name}`'s does not."], f"Remove one, or write `@meta::Attribute(…; repeatable: true)` before `struct {name}`."))
}

fn check_attributes_whole(name: ref String) -> bool {
    return name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "i128" || name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "u128"
}

fn check_attributes_misfit_named(literal: ref Expr, name: ref String, plain: bool) -> String? {
    let float = name == "f32" || name == "f64"
    let whole = check_attributes_whole(name)
    let known = whole || float || name == "bool" || name == "String" || name == "str"
    if !known || !plain {
        return null
    }
    let number = whole || float
    let inner: ref Expr = match literal {
        Expr::Unary { expr, .. } => expr,
        other => other,
    }
    return match inner {
        Expr::LitInt { .. } if !number => "a whole number".clone(),
        Expr::LitFloat(_, _) if !float => "a number with a fraction".clone(),
        Expr::LitBool(_, _) if name != "bool" => "a `bool`".clone(),
        Expr::LitStr { .. } if name != "String" && name != "str" => "text".clone(),
        else => null,
    }
}

/// **A literal that cannot be the type wanted**, said by its kind: a number
/// has no type of its own until a use gives it one, so the general check
/// passes it, and before a declaration there is no later use to ask.
pub fn check_attributes_literal_misfit(literal: ref Expr, want: ref Ty) -> String? {
    return match want {
        Ty::Named { name, args, .. } => check_attributes_misfit_named(literal, name, args.len() == 0),
        else => null,
    }
}
