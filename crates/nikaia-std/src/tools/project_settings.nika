// The build settings' words (P1, #125): what `--refuted-claims`,
// `--unproved-claims`, `--optimization`, `[build] artifact` and `--cpu` may
// say, the cache's key of a build and what a panic does on its target. The
// Rust adapter is `Settings` in `crates/nikaia/src/project.rs`: it keeps
// `build: Build` and holds these words. P5a moved what `Settings` and
// `Project` do with the words and the project's paths: the structs stay
// Rust, and these take and return words and paths.

use std::fs

/// A word a build setting does not take, in the words the compiler reports.
pub enum ProjectSettingsRefusal {
    Refused(String),
}

impl Error for ProjectSettingsRefusal {
    fn message(ref self) -> String {
        return match self {
            ProjectSettingsRefusal::Refused(why) => why.clone(),
        }
    }
}

/// **The build switches as words**: flag over manifest over built-in
/// default. The cache key and the diagnostics want the word (ADR-021 D5
/// hashes what was asked for); the emitter wants the parsed value, which
/// `Settings::build` holds beside them.
pub struct ProjectWords {
    pub target: String,
    pub user_parallelism: String,
    pub reentrancy_check: String,
    /// `--optimization`, or `[build] optimization`: `name:level` words,
    /// comma-separated, the last one for a name deciding
    /// ([ADR-306](../../../docs/specification/adr/adr-306.md) D1). Empty where
    /// neither says anything.
    pub optimization: String,
    /// **What a claim shown false with values is**
    /// ([ADR-269](../../../docs/specification/adr/adr-269.md) D8): `error`, the
    /// default, refuses the program; `warn` builds it, the claim checked where
    /// it is reached. The bypass for a program a better prover now refutes.
    pub refuted_claims: String,
    /// **What a claim the compiler did not prove is**
    /// ([ADR-380](../../../docs/specification/adr/adr-380.md) D2): `error`, the
    /// default, refuses the program (`NK1300`); `warn` builds it, each such
    /// claim a warning and a check where it is reached.
    pub unproved_claims: String,
    /// **What is made** (ADR-284 D4): `"program"`, or `"c-library"`, which
    /// exports every `pub extern fn` with a body and writes the header.
    pub artifact: String,
    /// The prefix of every exported symbol (ADR-284 D13): `symbol-prefix`, or
    /// the package's name with `-` written `_`.
    pub symbol_prefix: String,
    /// **Whether this is `nikaia test`'s build**
    /// ([ADR-269](../../../docs/specification/adr/adr-269.md) D1): the program's
    /// `test` blocks are compiled, and its `main` runs them by number. A
    /// choice like the others, so the cache and the wrapper both see it.
    pub tests: bool,
    /// **A binding to write beside the library** (`nikaia bind <language>`,
    /// [ADR-284](../../../docs/specification/adr/adr-284.md) D26): `python` or `node`,
    /// or none for a plain build.
    pub bind: String?,
    /// **The CPU level `--cpu` named** ([ADR-002](../../../docs/specification/adr/adr-002.md)
    /// D6), where it is not the target's baseline: the build may use every
    /// instruction it has, in the program and in `std`. None is the baseline,
    /// and no `-C target-cpu` at all.
    pub cpu: String?,
}

/// `error` or `warn`, what `--refuted-claims` and `[build] refuted-claims`
/// may say ([ADR-269](../../../docs/specification/adr/adr-269.md) D8).
pub fn refuted_claims(word: String) -> String throws {
    return match word {
        "error" | "warn" => word,
        else => throw ProjectSettingsRefusal::Refused(f"`refuted-claims` is `error` or `warn`, not `{word}`. `error` refuses a program with a claim the compiler shows false with values; `warn` builds it and checks the claim when it runs."),
    }
}

/// `error` or `warn`, what `--unproved-claims` and `[build] unproved-claims`
/// may say ([ADR-380](../../../docs/specification/adr/adr-380.md) D2).
pub fn unproved_claims(word: String) -> String throws {
    return match word {
        "error" | "warn" => word,
        else => throw ProjectSettingsRefusal::Refused(f"`unproved-claims` is `error` or `warn`, not `{word}`. `error` refuses a program with a claim the compiler did not prove; `warn` builds it and checks the claim when it runs."),
    }
}

/// **`name:on` or `name:off` words, comma-separated**, to what they decide
/// ([ADR-306](../../../docs/specification/adr/adr-306.md) D14). The names are
/// `remove-bounds-checks` and `remove-overflow-checks`
/// ([ADR-306](../../../docs/specification/adr/adr-306.md) D6); a later word for
/// a name wins over an earlier one.
pub fn optimizations(words: String) -> (BoundsChecks, OverflowChecks) throws {
    let mut bounds = BoundsChecks::Kept
    let mut overflow = OverflowChecks::Kept
    for word in words.split(",").map(fn(w) { w.trim() }).filter(fn(w) { !w.is_empty() }) {
        let (name, level) = word.split_once(":") ?? throw ProjectSettingsRefusal::Refused(f"`--optimization={word}` needs `on` or `off`: write `--optimization=remove-bounds-checks:on` or `--optimization=remove-overflow-checks:on`")
        match name {
            "remove-bounds-checks" => {
                bounds = BoundsChecks::parse(level) ?? throw ProjectSettingsRefusal::Refused(f"`remove-bounds-checks` is `on` or `off`, not `{level}`{project_settings_renamed(level)}")
            },
            // Read by `skip_free_at_exit` and `prove_through_loops`; checked
            // here with the rest.
            "skip-free-at-exit" | "prove-through-loops" => {
                if !(match level { "on" | "off" => true, else => false }) {
                    throw ProjectSettingsRefusal::Refused(f"`{name}` is `on` or `off`, not `{level}`")
                }
            },
            "remove-overflow-checks" => {
                overflow = OverflowChecks::parse(level) ?? throw ProjectSettingsRefusal::Refused(f"`remove-overflow-checks` is `on` or `off`, not `{level}`{project_settings_renamed(level)}")
            },
            else => throw ProjectSettingsRefusal::Refused(f"there is no optimization called `{name}`: the ones there are, are `remove-bounds-checks`, `remove-overflow-checks`, `prove-through-loops` and `skip-free-at-exit`"),
        }
    }
    return (bounds, overflow)
}

/// **`prove-through-loops:on`**
/// ([ADR-361](../../../docs/specification/adr/adr-361.md) D10): an index's, an
/// overflow's or a shift's check a loop leaves open is asked once more through
/// the loop's invariant. The last word for the name wins; [`optimizations`]
/// has already refused a word that is not `on` or `off`.
pub fn prove_through_loops(words: String) -> bool {
    return (words.split(",").map(fn(w) { w.trim() }).filter_map(fn(w) { w.strip_prefix("prove-through-loops:") }).last() ?? "") == "on"
}

/// **`skip-free-at-exit:on`**
/// ([ADR-348](../../../docs/specification/adr/adr-348.md) D1): what `main` still
/// holds at its end dies, and every cleanup runs, but its memory is left to the
/// operating system. The last word for the name wins; [`optimizations`] has
/// already refused a word that is not `on` or `off`.
pub fn skip_free_at_exit(words: String) -> bool {
    return (words.split(",").map(fn(w) { w.trim() }).filter_map(fn(w) { w.strip_prefix("skip-free-at-exit:") }).last() ?? "") == "on"
}

/// **The words before ADR-306 D14**: `basic` and `aggressive` were levels of
/// how hard the compiler proved and whether it dropped what it proved, in one
/// word. What is proved no longer depends on the option, so the old words name
/// the one thing they still mean.
fn project_settings_renamed(level: String) -> String {
    return match level {
        "aggressive" | "basic" => ". The compiler now proves the same at every build, and the option only says whether a proved check is written without it: `aggressive` and `basic` are `on`",
        else => "",
    }
}

/// `[build] artifact` (ADR-284 D4): a program, or a library C calls.
pub fn artifact(word: String) -> String throws {
    return match word {
        "program" | "c-library" => word,
        else => throw ProjectSettingsRefusal::Refused(f"`artifact` is `program` or `c-library`, not `{word}`. `c-library` makes a shared and a static library of the package, and its header, from every `pub extern fn` with a body."),
    }
}

/// What Cargo is told for the CPU level: `-C target-cpu` for every crate
/// built for the target, the program's and `std`'s, through Cargo's own
/// configuration rather than the user's `RUSTFLAGS` (ADR-002 D6, ADR-325).
pub fn cpu_config(words: ref ProjectWords, target: Target) -> Vec[String] {
    return match words.cpu?.clone() {
        level => [f"target.\"{target.triple()}\".rustflags=[\"-C\", \"target-cpu={level}\"]"],
        null => [],
    }
}

/// The cache's view of this build (ADR-021 D5): the key of
/// `Settings::choices`, whose backend is `"rust"`. `cpu_key` is
/// `Settings::cpu_key`'s answer, read only where a level is named.
pub fn choices_key(words: ref ProjectWords, bounds: BoundsChecks, overflow: OverflowChecks, skip_free_on: bool, through_loops_on: bool, cpu_key: String) -> String {
    let tests = if words.tests { "/tests" } else { "" }
    // A build that lets a refuted claim through must not hand its
    // lowering to one that refuses it.
    let refuted = if words.refuted_claims == "warn" { "/refuted-claims:warn" } else { "" }
    // The same for a claim not proved (ADR-380 D2).
    let unproved = if words.unproved_claims == "warn" { "/unproved-claims:warn" } else { "" }
    let removed_bounds = match bounds { BoundsChecks::Kept => "", else => f"/remove-bounds-checks:{bounds.name()}" }
    let removed_overflow = match overflow { OverflowChecks::Kept => "", else => f"/remove-overflow-checks:{overflow.name()}" }
    let skip_free = if skip_free_on { "/skip-free-at-exit:on" } else { "" }
    let through_loops = if through_loops_on { "/prove-through-loops:on" } else { "" }
    // A library's lowering carries its entry points' wrappers,
    // named by the prefix.
    let library = if words.artifact == "c-library" { f"/c-library:{words.symbol_prefix}" } else { "" }
    // A `comptime` that reads `target::has` answers for the level
    // (ADR-371 D6), so the lowering is kept per level.
    let cpu = if words.cpu != null { f"/cpu:{cpu_key}" } else { "" }
    return f"{words.target}/{words.user_parallelism}/{words.reentrancy_check}{tests}{refuted}{unproved}{removed_bounds}{removed_overflow}{skip_free}{through_loops}{library}{cpu}"
}

/// What a panic does on this machine (ADR-037 D1), in Cargo's vocabulary.
///
/// Not a choice, which is why it is not in the codegen table: WebAssembly
/// traps and has no stack to unwind, and a build that asked for `unwind`
/// there would be asking for something the machine does not have.
pub fn panic_strategy(target: Target) -> String {
    return match target {
        Target::X86_64Linux | Target::Aarch64Linux => "unwind",
        Target::Wasm32Unknown => "abort",
        else => {
            if target.is_bare_metal() || target.triple().starts_with("wasm") {
                "abort"
            } else {
                "unwind"
            }
        },
    }
}

/// The user's flags (`CARGO_ENCODED_RUSTFLAGS` first, as Cargo reads them,
/// else `RUSTFLAGS` split on whitespace) followed by `-C target-cpu=CPU`,
/// joined with `\x1f`; `null` when neither variable is set (#753).
pub fn encoded_with_cpu(encoded: String?, plain: String?, cpu: String) -> String? {
    let mut flags: Vec[String] = match encoded?.clone() {
        e => e.split("\x1f").filter(fn(f) { !f.is_empty() }).map(fn(f) { f.clone() }).collect(),
        null => match plain?.clone() {
            p => p.split_whitespace().map(fn(f) { f.clone() }).collect(),
            null => return null,
        },
    }
    flags.push("-C")
    flags.push(f"target-cpu={cpu}")
    return flags.join("\x1f")
}

/// The variables that carry the resolved words to the `rustc` wrapper: Cargo
/// owns the wrapper's arguments, so the environment is the one channel.
comptime PROJECT_SETTINGS_TARGET_VAR: ref String = "NIKAIA_BUILD_TARGET"
comptime PROJECT_SETTINGS_PARALLELISM_VAR: ref String = "NIKAIA_USER_PARALLELISM"
/// The third switch's word, down the same channel
/// ([ADR-281](../../../docs/specification/adr/adr-281.md) D36).
comptime PROJECT_SETTINGS_REENTRANCY_VAR: ref String = "NIKAIA_REENTRANCY_CHECK"
/// `--optimization`'s words, resolved
/// ([ADR-306](../../../docs/specification/adr/adr-306.md) D1).
comptime PROJECT_SETTINGS_OPTIMIZATION_VAR: ref String = "NIKAIA_OPTIMIZATION"
/// `--refuted-claims`, resolved ([ADR-269](../../../docs/specification/adr/adr-269.md) D8).
comptime PROJECT_SETTINGS_REFUTED_VAR: ref String = "NIKAIA_REFUTED_CLAIMS"
/// `--unproved-claims`, resolved ([ADR-380](../../../docs/specification/adr/adr-380.md) D2).
comptime PROJECT_SETTINGS_UNPROVED_VAR: ref String = "NIKAIA_UNPROVED_CLAIMS"
/// `[build] artifact` and `symbol-prefix` (ADR-284 D4, D13).
comptime PROJECT_SETTINGS_ARTIFACT_VAR: ref String = "NIKAIA_BUILD_ARTIFACT"
comptime PROJECT_SETTINGS_PREFIX_VAR: ref String = "NIKAIA_SYMBOL_PREFIX"
/// Set where the build is `nikaia test`'s
/// ([ADR-269](../../../docs/specification/adr/adr-269.md) D1).
comptime PROJECT_SETTINGS_TESTS_VAR: ref String = "NIKAIA_TESTS"
/// The CPU level `--cpu` named, so that the wrapper's lowering answers
/// `target::has` in a `comptime` for it (ADR-371 D6).
comptime PROJECT_SETTINGS_CPU_VAR: ref String = "NIKAIA_CPU"

/// What the settings ask of the compiler (P5a): `std` reads no environment
/// variable yet (#922), and `native` is what `rustc` says
/// (`crate::sysroot::native_cpu`).
pub trait ProjectSettingsHost {
    /// The variable `name`, where it is set and is text.
    fn env_var(ref self, name: ref String) -> String? sync
    /// The CPU `rustc` finds on this machine for `triple`.
    fn native_cpu(ref self, triple: ref String) -> String sync throws
}

/// **Every switch's word, checked**, before anything is read, so a mistyped
/// one fails on its own account rather than after a compile (ADR-037 D5): the
/// refuted and unproved claims' words and the artifact. The symbol prefix, the
/// target's words and the optimizations are parsed by the Rust adapter, after
/// these, in this order.
fn project_settings_checked(target: String, user_parallelism: String, reentrancy_check: String, optimization: String, refuted: String, unproved: String, made: String, symbol_prefix: String, tests: bool, cpu: String?) -> ProjectWords throws {
    let refuted_claims = refuted_claims(refuted)
    let unproved_claims = unproved_claims(unproved)
    let artifact = artifact(made)
    return ProjectWords { target: target, user_parallelism: user_parallelism, reentrancy_check: reentrancy_check, optimization: optimization, refuted_claims: refuted_claims, unproved_claims: unproved_claims, artifact: artifact, symbol_prefix: symbol_prefix, tests: tests, bind: null, cpu: cpu }
}

/// **The words, flag over manifest over built-in default.** `manifest` is
/// the manifest's `[build]` word for a key, or the default it is given;
/// `package` the package's name, which names the symbol prefix where
/// `[build]` does not.
pub fn project_settings_resolve(manifest: fn(ref String, ref String) -> String sync, package: String?, target: String?, user_parallelism: String?, default_target: String) -> ProjectWords throws {
    let target = target?.clone() ?? manifest("target", default_target)
    let user_parallelism = user_parallelism?.clone() ?? manifest("user-parallelism", "no")
    // **No flag of its own** ([ADR-281](../../../docs/specification/adr/adr-281.md)
    // D8): it *lives in the manifest*, because otherwise a shipped build is
    // not reproducible, and Part I 1.2 names the two that a single build may
    // override. The environment is not a second front door - it is how the
    // resolved word reaches the wrapper, which Cargo owns the arguments of.
    let reentrancy_check = manifest("reentrancy-check", "yes")
    let optimization = manifest("optimization", "")
    let refuted = manifest("refuted-claims", "error")
    let unproved = manifest("unproved-claims", "error")
    let made = manifest("artifact", "program")
    let named = (package ?? "program").replace("-", "_")
    let symbol_prefix = manifest("symbol-prefix", named)
    return project_settings_checked(target, user_parallelism, reentrancy_check, optimization, refuted, unproved, made, symbol_prefix, false, null)
}

/// **What the driver put in the environment.** Absent means the wrapper was
/// run by hand, and the built-in defaults are the honest answer.
pub fn project_settings_from_env[H: ProjectSettingsHost](default_target: String, host: ref H) -> ProjectWords throws {
    let target = host.env_var(PROJECT_SETTINGS_TARGET_VAR) ?? default_target
    let user_parallelism = host.env_var(PROJECT_SETTINGS_PARALLELISM_VAR) ?? "no"
    let reentrancy_check = host.env_var(PROJECT_SETTINGS_REENTRANCY_VAR) ?? "yes"
    let optimization = host.env_var(PROJECT_SETTINGS_OPTIMIZATION_VAR) ?? ""
    let refuted = host.env_var(PROJECT_SETTINGS_REFUTED_VAR) ?? "error"
    let unproved = host.env_var(PROJECT_SETTINGS_UNPROVED_VAR) ?? "error"
    let made = host.env_var(PROJECT_SETTINGS_ARTIFACT_VAR) ?? "program"
    let symbol_prefix = host.env_var(PROJECT_SETTINGS_PREFIX_VAR) ?? "program"
    let tests = host.env_var(PROJECT_SETTINGS_TESTS_VAR) != null
    let level = host.env_var(PROJECT_SETTINGS_CPU_VAR) ?? ""
    let cpu: String? = if level.is_empty() { null } else { level }
    return project_settings_checked(target, user_parallelism, reentrancy_check, optimization, refuted, unproved, made, symbol_prefix, tests, cpu)
}

/// **The command line's `--refuted-claims` and `--unproved-claims` over the
/// manifest's** ([ADR-269](../../../docs/specification/adr/adr-269.md) D8,
/// [ADR-380](../../../docs/specification/adr/adr-380.md) D2): a single build
/// may let through a claim a newer prover refutes, as it may name another
/// target. The two words the build then has, refuted first.
pub fn project_settings_refutations(words: ref ProjectWords, refuted: String?, unproved: String?) -> (String, String) throws {
    let refuted_word = match refuted?.clone() {
        word => refuted_claims(word),
        null => words.refuted_claims.clone(),
    }
    let unproved_word = match unproved?.clone() {
        word => unproved_claims(word),
        null => words.unproved_claims.clone(),
    }
    return (refuted_word, unproved_word)
}

/// **`--cpu=LEVEL`** ([ADR-002](../../../docs/specification/adr/adr-002.md)
/// D6): one of the target's `levels`, the baseline first, or the build fails
/// naming them. The baseline is the same build as no level at all: `null`.
pub fn project_settings_chosen_cpu(level: String, levels: ref Vec[String], target_name: String) -> String? throws {
    if !levels.iter().any(fn(known) { known == level }) {
        let named = levels.iter().map(fn(known) { f"`{known}`" }).collect().join(", ")
        throw ProjectSettingsRefusal::Refused(f"`--cpu={level}` is not a CPU level of `{target_name}`. Its levels are: {named}.")
    }
    return if level != levels[0] { level } else { null }
}

/// The CPU level as a dimension of the compiled `std` (ADR-002 D6): empty
/// for the baseline, the level's name, and for `native` the CPU `rustc`
/// finds on this machine for `triple`, never the word.
pub fn project_settings_cpu_key[H: ProjectSettingsHost](words: ref ProjectWords, triple: String, host: ref H) -> String throws {
    let level = words.cpu?.clone() ?? return ""
    return match level {
        "native" => host.native_cpu(triple),
        else => level,
    }
}

/// **`--cpu` against the user's `RUSTFLAGS`** (#753, ADR-002 D6, Part III
/// 13.3). Cargo ignores the `rustflags` of [`cpu_config`] when `RUSTFLAGS` or
/// `CARGO_ENCODED_RUSTFLAGS` is set, so then the child gets
/// `CARGO_ENCODED_RUSTFLAGS`: the user's flags, then `-C target-cpu=L` last
/// (the level wins, the flags still apply). `null` where nothing is needed.
pub fn project_settings_cpu_rustflags[H: ProjectSettingsHost](words: ref ProjectWords, triple: String, host: ref H) -> String? throws {
    if words.cpu == null {
        return null
    }
    let encoded = host.env_var("CARGO_ENCODED_RUSTFLAGS")
    let plain = host.env_var("RUSTFLAGS")
    return encoded_with_cpu(encoded, plain, project_settings_cpu_key(words, triple, host))
}

/// **The words, for the wrapper.** Cargo owns the wrapper's arguments, so the
/// environment is the only channel the switches can travel down - and they
/// travel already resolved, because a second resolution is a second chance
/// to disagree.
pub fn project_settings_as_env(words: ref ProjectWords) -> Vec[(String, String)] {
    let mut env: Vec[(String, String)] = [
        (PROJECT_SETTINGS_TARGET_VAR.clone(), words.target.clone()),
        (PROJECT_SETTINGS_PARALLELISM_VAR.clone(), words.user_parallelism.clone()),
        (PROJECT_SETTINGS_REENTRANCY_VAR.clone(), words.reentrancy_check.clone()),
        (PROJECT_SETTINGS_OPTIMIZATION_VAR.clone(), words.optimization.clone()),
        (PROJECT_SETTINGS_REFUTED_VAR.clone(), words.refuted_claims.clone()),
        (PROJECT_SETTINGS_UNPROVED_VAR.clone(), words.unproved_claims.clone()),
        (PROJECT_SETTINGS_ARTIFACT_VAR.clone(), words.artifact.clone()),
        (PROJECT_SETTINGS_PREFIX_VAR.clone(), words.symbol_prefix.clone()),
    ]
    if words.tests {
        env.push((PROJECT_SETTINGS_TESTS_VAR.clone(), "1"))
    }
    match words.cpu?.clone() {
        level => env.push((PROJECT_SETTINGS_CPU_VAR.clone(), level)),
        null => {},
    }
    return env
}

/// No project around `start`: what the build says.
pub fn project_settings_no_project(start: ref fs::Path) -> String {
    let main = start.join("main.nika")
    return f"There's no `nikaia.toml` in {start.display()} or any folder above it.\n`nikaia build` needs a project. To lower a single file to Rust, run `nikaia lower {main.display()}`."
}

/// A target this toolchain cannot build for yet, and why (`missing`).
pub fn project_settings_unbuildable(triple: String, missing: String) -> String {
    return f"Building for `{triple}` isn't possible yet: {missing}"
}

/// `target/nikaia/`, or a directory under it of the `variant`'s: which of
/// `nikaia test`'s builds this is (ADR-269 D12), `null` for a plain build.
pub fn project_settings_own_dir(root: ref fs::Path, variant: String?) -> fs::Path {
    let dir = root.join("target").join("nikaia")
    return match variant?.clone() {
        named => dir.join("variants").join(named),
        null => dir,
    }
}

/// Where the generated `Cargo.toml` goes. Under `target/`, because it is
/// build output: it is regenerated from `nikaia.toml` on every build and
/// editing it would be editing something the next build overwrites.
pub fn project_settings_build_dir(root: ref fs::Path, variant: String?) -> fs::Path {
    return project_settings_own_dir(root, variant).join("build")
}

/// Where the emitted Rust goes - **outside** [`project_settings_build_dir`],
/// and that is not tidiness. Cargo lists the files of a path package to
/// decide whether it is fresh, so a generated source inside the package would
/// make the package dirty the moment it was written, and every build would
/// recompile.
pub fn project_settings_gen_dir(root: ref fs::Path, variant: String?) -> fs::Path {
    return project_settings_own_dir(root, variant).join("gen")
}

/// **The switches, as a file Cargo can see** (ADR-021 D5): the driver writes
/// the resolved switches here before `cargo` runs, and the wrapper puts it
/// into the dependency file beside the `.nika` sources, so a switch that
/// changed is an input that changed. In [`project_settings_gen_dir`], for its
/// reason. Why a file at all: `Project::switches_path`.
pub fn project_settings_switches_path(root: ref fs::Path, variant: String?) -> fs::Path {
    return project_settings_gen_dir(root, variant).join("switches")
}

/// The ledger, in the project root (Part III 13.5).
pub fn project_settings_ledger_path(root: ref fs::Path) -> fs::Path {
    return root.join("nikaia.contracts")
}

/// **The switches file the driver wrote**, where there is one in `gen_dir`.
/// Absent means the wrapper was run by hand rather than by a project build,
/// and then there is no switch anybody could flip between two runs.
pub fn project_settings_switches_beside(gen_dir: ref fs::Path) -> fs::Path? {
    let path = gen_dir.join("switches")
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return null }
    return if found.is_file() { path } else { null }
}
