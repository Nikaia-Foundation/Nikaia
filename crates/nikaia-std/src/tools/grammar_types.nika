// **A rule that takes types is copied once per list of type arguments**
// ([ADR-grammar-2](../../../docs/specification/adr/adr-grammar-2.md) D1,
// Part II 10.8, *A rule may take types*). Right after parsing, the parser's
// host (`crates/nikaia/src/parser/mod.rs`, `expand_grammar_types`) rewrites
// each call `G::read[i64](input)` to the copy's name, `G::read__i64(input)`,
// and hands the calls here: every rule the copies reach with types,
// `Value[A]`, is copied too, under the same spelling of its types
// (`check_specialised`, ADR-330 D2), and shared between the calls that reach
// it with the same list. The generic rule itself is not kept (ADR-304 D6), so
// the checker, the analyses and the emitter only ever see single-type rules.
//
// **A copy keeps the arm its type takes** (ADR-grammar-2 D2, D6): a rule body
// `match T::kind { … }` becomes the alternatives of the one arm `T`'s kind
// takes, with the names the arm binds (`Maybe(A)`) standing for the parts of
// the type; a type no arm takes, or one an arm `refuse`s, is refused at the
// call that led there (`NK1250`), a `match` on anything but a kind is
// `NK1310`, and a bound on a rule's type parameter is checked at that call
// (`NK1164`). Inside each copy the type parameters are put in in the actions,
// guards and bounds too (`grammar_types_put_block`).

use std::collections

/// **One copy a call of an entry asks for**: the grammar, the rule as written
/// and the types the brackets wrote, under the symbols the program's
/// interner gives the names.
pub struct GrammarTypesCall {
    pub owner: winnow_grammar::Symbol,
    pub rule: winnow_grammar::Symbol,
    pub types: Vec[Type],
}

/// **The name of a rule's copy** for the list of types `types`: `read__i64`,
/// spelled as a function's copy is (`check_specialised`).
pub fn grammar_types_copy_name(words: ref winnow_grammar::InternerContext, rule: ref String, types: ref Vec[Type]) -> String {
    let mut spelled: Vec[String] = []
    for ty in types {
        spelled.push(grammar_types_spelled(words, ty))
    }
    return check_specialised(rule, spelled.join(", "))
}

/// A type as the program writes it: `Vec[i64]`, `(A, B)`, `T?`.
fn grammar_types_spelled(words: ref winnow_grammar::InternerContext, ty: ref Type) -> String {
    let mut parts: Vec[String] = []
    for arg in ty.generics {
        parts.push(grammar_types_spelled(words, arg))
    }
    let mut text: String = ""
    if ty.is_tuple {
        text = f"({parts.join(", ")})"
    } else if parts.len() == 0 {
        text = f"{words.resolve(ty.name)}"
    } else {
        text = f"{words.resolve(ty.name)}[{parts.join(", ")}]"
    }
    if ty.is_nullable {
        text = f"{text}?"
    }
    return text
}

/// **What a copy cannot be made for**, said at the call that asked for it
/// (`call`, the place in the calls handed in; -1 where no call did, and
/// `span` says where).
pub struct GrammarTypesRefusal {
    pub code: String,
    pub call: i64,
    pub span: Span,
    pub message: String,
    pub note: String,
    pub help: String,
}

/// The items with the copies put in, and what could not be copied.
pub struct GrammarTypesExpanded {
    pub items: Vec[Spanned[Item]],
    pub refused: Vec[GrammarTypesRefusal],
}

/// A copy asked for, with the call it comes from and the rules with types
/// that led to it (`Lit::read[f64?]`, `Value[f64?]`, `Value[f64]`).
struct GrammarTypesWanted {
    call: GrammarTypesCall,
    from: i64,
    path: Vec[String],
}

/// What the copying of one program carries: the copies still to make, what
/// is refused, the program's declared shapes, traits and `impl`s, and the
/// call and path of the copy being made.
struct GrammarTypesWork {
    queue: Vec[GrammarTypesWanted],
    refused: Vec[GrammarTypesRefusal],
    shapes: collections::BTreeMap[String, String],
    traits: collections::BTreeSet[String],
    impls: collections::BTreeSet[String],
    /// Each declared struct's type parameters and fields, which a
    /// `members[S]` builds (ADR-grammar-2 D3).
    structs: collections::BTreeMap[String, (Vec[GenericParam], Vec[FieldDef])],
    from: i64,
    path: Vec[String],
}

/// **The items with each grammar's rules that take types replaced by the
/// copies `calls` reach**, and each `match` on a kind by the arm its copy's
/// type takes. A grammar with neither is returned as it was.
fn grammar_types_expand(mut items: Vec[Spanned[Item]], calls: ref Vec[GrammarTypesCall], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> GrammarTypesExpanded {
    let none: Vec[String] = []
    let mut work = GrammarTypesWork { queue: [], refused: [], shapes: collections::BTreeMap(), traits: collections::BTreeSet(), impls: collections::BTreeSet(), structs: collections::BTreeMap(), from: -1, path: none }
    for item in items {
        match item.node {
            Item::Struct { name, generics, fields, .. } => {
                work.shapes.insert(f"{words.resolve(name)}", "Struct")
                work.structs.insert(f"{words.resolve(name)}", (generics.clone(), fields.clone()))
            },
            Item::Enum { name, .. } => {
                work.shapes.insert(f"{words.resolve(name)}", "Enum")
            },
            Item::Trait { name, .. } => {
                work.traits.insert(f"{words.resolve(name)}")
            },
            Item::Impl { trait_name, target, .. } => {
                if trait_name != null {
                    let named: winnow_grammar::Symbol = trait_name ?? target.name
                    work.impls.insert(f"{words.resolve(named)} for {words.resolve(target.name)}")
                }
            },
            else => {},
        }
    }
    let mut out: Vec[Spanned[Item]] = []
    for item in items.drain() {
        let mut kept = item.clone()
        match item.node {
            Item::Grammar(def) => {
                kept.node = Item::Grammar(grammar_types_def(def, calls, words, intern, work))
            },
            else => {},
        }
        out.push(kept)
    }
    return GrammarTypesExpanded { items: out, refused: work.refused }
}

/// Whether a rule's alternatives hold a `match` on a kind.
fn grammar_types_chooses(alts: ref Vec[GrammarAlt]) -> bool {
    for alt in alts {
        match alt.pattern.node {
            Pattern::Choose { .. } => {
                return true
            },
            else => {},
        }
    }
    return false
}

/// **Whether a grammar needs the copying** (ADR-grammar-2 D1-D3): a rule
/// that takes types, a `match` on a kind, or a `members[S]`, whose value
/// rule is copied once per field type.
pub fn grammar_types_wanted(def: ref GrammarDef) -> bool {
    for rule in def.rules {
        if rule.generics.len() > 0 || grammar_types_chooses(rule.alts) {
            return true
        }
        for alt in rule.alts {
            if grammar_types_has_members(alt.pattern) {
                return true
            }
        }
    }
    return false
}

/// Whether a pattern holds a `members[S]`.
fn grammar_types_has_members(pattern: ref Spanned[Pattern]) -> bool {
    match pattern.node {
        Pattern::Members { .. } => {
            return true
        },
        Pattern::Seq(parts) => {
            for part in parts {
                if grammar_types_has_members(part) {
                    return true
                }
            }
        },
        Pattern::Choice(parts) => {
            for part in parts {
                if grammar_types_has_members(part) {
                    return true
                }
            }
        },
        Pattern::Bind { pat, .. } => {
            return grammar_types_has_members(pat)
        },
        Pattern::Repeat { pat, .. } => {
            return grammar_types_has_members(pat)
        },
        Pattern::Group(inner) => {
            return grammar_types_has_members(inner)
        },
        Pattern::Counted { pat, .. } => {
            return grammar_types_has_members(pat)
        },
        else => {},
    }
    return false
}

/// A call of a rule with types, as the program writes it: `Value[f64?]`.
fn grammar_types_called(words: ref winnow_grammar::InternerContext, rule: ref String, types: ref Vec[Type]) -> String {
    let mut spelled: Vec[String] = []
    for ty in types {
        spelled.push(grammar_types_spelled(words, ty))
    }
    return f"{rule}[{spelled.join(", ")}]"
}

fn grammar_types_def(def: ref GrammarDef, calls: ref Vec[GrammarTypesCall], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut work: GrammarTypesWork) -> GrammarDef {
    let mut generic: collections::BTreeMap[String, GrammarRule] = collections::BTreeMap()
    for rule in def.rules {
        if rule.generics.len() > 0 {
            generic.insert(f"{words.resolve(rule.name)}", rule.clone())
        }
    }
    if generic.len() == 0 && !grammar_types_wanted(def) {
        return def.clone()
    }
    let owner = def.name
    work.queue = []
    let mut index: i64 = 0
    for call in calls {
        if call.owner == owner {
            let first = f"{words.resolve(owner)}::{grammar_types_called(words, words.resolve(call.rule), call.types)}"
            work.queue.push(GrammarTypesWanted { call: call.clone(), from: index, path: [first] })
        }
        index += 1
    }
    // The rules without types stay, and a rule of theirs that hands types
    // to a generic one asks for its copy too.
    let mut rules: Vec[GrammarRule] = []
    let none: collections::BTreeMap[String, Type] = collections::BTreeMap()
    for rule in def.rules {
        if rule.generics.len() == 0 {
            work.from = -1
            work.path = [f"{words.resolve(rule.name)}"]
            rules.push(grammar_types_rule(rule, none, rule.name, generic, owner, words, intern, work))
        }
    }
    let mut done: collections::BTreeSet[String] = collections::BTreeSet()
    let mut at: i64 = 0
    while at < work.queue.len() as i64 {
        let wanted = work.queue[at].clone()
        at += 1
        let call = wanted.call
        let copy = grammar_types_copy_name(words, words.resolve(call.rule), call.types)
        if done.contains(copy) {
            continue
        }
        done.insert(copy.clone())
        let rule: GrammarRule = generic.get(words.resolve(call.rule))?.clone() ?? continue
        work.from = wanted.from
        work.path = wanted.path.clone()
        let mut bound: collections::BTreeMap[String, Type] = collections::BTreeMap()
        let mut index: i64 = 0
        for parameter in rule.generics {
            if index < call.types.len() as i64 {
                let given = call.types[index].clone()
                grammar_types_bounds(parameter, given, words, work)
                bound.insert(f"{words.resolve(parameter.name)}", given)
            }
            index += 1
        }
        rules.push(grammar_types_rule(rule, bound, intern(copy), generic, owner, words, intern, work))
    }
    let mut expanded = def.clone()
    expanded.rules = rules
    return expanded
}

/// **A bound on a rule's type parameter, checked at the call** (`NK1164`,
/// as at a function's call): a shape bound by the declaration, a trait the
/// program declares by its `impl`s. It fails open where the program
/// declares neither the type nor the trait.
fn grammar_types_bounds(parameter: ref GenericParam, given: ref Type, words: ref winnow_grammar::InternerContext, mut work: GrammarTypesWork) {
    let actual = grammar_types_spelled(words, given)
    let kind = grammar_types_kind(given, work.shapes, words)
    let entry = work.path[0].clone()
    for wanted in parameter.bounds {
        let trait_name = f"{words.resolve(wanted)}"
        if (trait_name == "Struct" || trait_name == "Enum") && !work.traits.contains(trait_name) {
            if kind == trait_name || kind == "Opaque" {
                continue
            }
            let mut article: String = "a"
            if trait_name == "Enum" {
                article = "an"
            }
            let mut what: String = "a built-in type, which is neither"
            if kind == "Struct" {
                what = f"a `struct`, so the bound it matches is `[{actual}: Struct]`"
            } else if kind == "Enum" {
                what = f"an `enum`, so the bound it matches is `[{actual}: Enum]`"
            }
            grammar_types_refuse(work, "NK1164", null, f"`{entry}` needs {article} `{trait_name}` here, but `{actual}` isn't one.", f"`[{words.resolve(parameter.name)}: {trait_name}]` asks what a type is, not what it does, so it's answered by the declaration, not an `impl`. `{actual}` is {what}.", f"Pass a type declared with `{trait_name.to_lowercase()}`, or remove the bound.")
        } else if work.traits.contains(trait_name) && !work.impls.contains(f"{trait_name} for {words.resolve(given.name)}") {
            grammar_types_refuse(work, "NK1164", null, f"`{entry}` needs a `{trait_name}` here, but `{actual}` isn't one.", f"`[{words.resolve(parameter.name)}: {trait_name}]` says the type passed has to have `{trait_name}`'s methods, and `{actual}` doesn't implement it.", f"Write `impl {trait_name} for {actual} {{ … }}`, or pass a type that already has one.")
        }
    }
}

/// One refusal, at the call the copy being made comes from, or at `span`
/// where no call led there.
fn grammar_types_refuse(mut work: GrammarTypesWork, code: ref String, span: Span?, message: String, note: String, help: String) {
    let at: Span = span ?? Span { start: 0, end: 0 }
    work.refused.push(GrammarTypesRefusal { code: code.clone(), call: work.from, span: at, message: message, note: note, help: help })
}

/// **What `T::kind` is for a type as the program writes it** (Part II 10.3):
/// a declared `struct` or `enum` by its declaration, the language's own by
/// `check_reflect_builtin_kind`.
fn grammar_types_kind(ty: ref Type, shapes: ref collections::BTreeMap[String, String], words: ref winnow_grammar::InternerContext) -> String {
    if ty.is_nullable {
        return "Maybe"
    }
    if ty.is_tuple {
        return "Tuple"
    }
    let name = f"{words.resolve(ty.name)}"
    let shape: String? = shapes.get(name)?.clone()
    if shape != null {
        return shape ?? "Opaque"
    }
    return check_reflect_builtin_kind(name)
}

/// The types an arm's names stand for: `A` of `Maybe(A)` and `List(A)`,
/// `K` and `V` of `Map(K, V)`, the type itself for `Struct(S)`, `Enum(E)`
/// and `Opaque(T)`.
fn grammar_types_parts(ty: ref Type, kind: ref String) -> Vec[Type] {
    let mut parts: Vec[Type] = []
    if kind == "Maybe" {
        let mut inner = ty.clone()
        inner.is_nullable = false
        parts.push(inner)
    } else if kind == "List" || kind == "Map" || kind == "Array" {
        for arg in ty.generics {
            parts.push(arg.clone())
        }
    } else if kind == "Struct" || kind == "Enum" || kind == "Opaque" {
        parts.push(ty.clone())
    }
    return parts
}

/// One rule with the types `bound` says put in, under the name `name`.
fn grammar_types_rule(rule: ref GrammarRule, bound: ref collections::BTreeMap[String, Type], name: winnow_grammar::Symbol, generic: ref collections::BTreeMap[String, GrammarRule], owner: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut work: GrammarTypesWork) -> GrammarRule {
    let mut copy = rule.clone()
    copy.name = name
    copy.generics = []
    if rule.ret_type != null {
        let written: Type = rule.ret_type?.clone() ?? return copy
        copy.ret_type = grammar_types_put(written, bound, words)
    }
    let mut args: Vec[FnArg] = []
    for arg in rule.args {
        let mut a = arg.clone()
        a.ty = grammar_types_put(arg.ty, bound, words)
        args.push(a)
    }
    copy.args = args
    let mut config: Vec[ConfigParam] = []
    for param in rule.config {
        let mut c = param.clone()
        c.ty = grammar_types_put(param.ty, bound, words)
        config.push(c)
    }
    copy.config = config
    copy.alts = grammar_types_alts(rule.alts, bound, f"{words.resolve(rule.name)}", generic, owner, words, intern, work)
    return copy
}

/// A rule's alternatives in a copy: a `match` on a kind gives the arm the
/// type takes, every other alternative its pattern and action with the
/// types put in.
fn grammar_types_alts(alts: ref Vec[GrammarAlt], bound: ref collections::BTreeMap[String, Type], rule: ref String, generic: ref collections::BTreeMap[String, GrammarRule], owner: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut work: GrammarTypesWork) -> Vec[GrammarAlt] {
    let mut out: Vec[GrammarAlt] = []
    for alt in alts {
        match alt.pattern.node {
            Pattern::Choose { value, arms } => {
                for one in grammar_types_choose(value, arms, alt.pattern.span, bound, rule, generic, owner, words, intern, work) {
                    out.push(one)
                }
            },
            else => {
                let mut a = alt.clone()
                a.pattern = grammar_types_pattern(alt.pattern, bound, generic, owner, words, intern, work)
                if bound.len() > 0 && alt.action != null {
                    let block: Block = alt.action?.clone() ?? Block { stmts: [] }
                    a.action = grammar_types_put_block(block, bound, words, intern)
                }
                out.push(a)
            },
        }
    }
    return out
}

/// **The arm of a `match` on a kind a copy keeps** (ADR-grammar-2 D2, D6):
/// the first whose kind is the type's, or `else`; its names stand for the
/// type's parts. No arm, or an arm that is `refuse("why")`, is `NK1250` at
/// the call; a value other than a type's `::kind` is `NK1310`.
fn grammar_types_choose(value: ref Expr, arms: ref Vec[GrammarArm], span: ref Span, bound: ref collections::BTreeMap[String, Type], rule: ref String, generic: ref collections::BTreeMap[String, GrammarRule], owner: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut work: GrammarTypesWork) -> Vec[GrammarAlt] {
    let none: Vec[GrammarAlt] = []
    let mut written: String = "this value"
    let mut subject: String = ""
    match value {
        Expr::Path(segments, _) => {
            let mut parts: Vec[String] = []
            for segment in segments {
                parts.push(f"{words.resolve(segment)}")
            }
            written = parts.join("::")
            if segments.len() == 2 && parts[1] == "kind" {
                subject = parts[0].clone()
            }
        },
        Expr::Variable(name, _) => {
            written = f"{words.resolve(name)}"
        },
        else => {},
    }
    let given: Type? = bound.get(subject)?.clone()
    if given == null {
        grammar_types_refuse(work, "NK1310", span.clone(), f"A `match` in a rule's pattern chooses while the program is built, and `{written}` isn't known then.", "A rule body chooses its pattern by the kind of a type the rule takes (ADR-grammar-2 D2), which is decided while building; a value is only known while the input is read.", "Match on the kind of a type the rule takes, `match T::kind { … }`, or choose while reading with alternatives and a guard, `if(cond)`.")
        return none
    }
    let ty: Type = given ?? return none
    let kind = grammar_types_kind(ty, work.shapes, words)
    let spelled = grammar_types_spelled(words, ty)
    let entry = work.path[0].clone()
    let mut reached: String = ""
    if work.path.len() > 1 {
        reached = f", reached by `{work.path.join("` then `")}`"
    }
    for arm in arms {
        let read: (String, Vec[String])? = check_reflect_arm(words, arm.pattern)
        let (case, names) = read ?? continue
        if case != "" && case != kind {
            continue
        }
        let mut inner = bound.clone()
        let parts = grammar_types_parts(ty, kind)
        let mut index: i64 = 0
        for name in names {
            if index < parts.len() as i64 && name != "_" {
                inner.insert(name.clone(), parts[index].clone())
            }
            index += 1
        }
        let reason: String? = grammar_types_refused_why(arm.alts, words)
        if reason != null {
            let why: String = reason ?? ""
            let mut named: String = case.clone()
            if case == "" {
                named = "else"
            }
            grammar_types_refuse(work, "NK1250", span.clone(), f"`{entry}` can't read a `{spelled}`: {why}", f"The arm `{named}` of the `match` in `{rule}` refuses it with `refuse(…)` (ADR-grammar-2 D6){reached}.", "Call it with a type the grammar reads.")
            return none
        }
        return grammar_types_alts(arm.alts, inner, rule, generic, owner, words, intern, work)
    }
    grammar_types_refuse(work, "NK1250", span.clone(), f"`{entry}` can't read a `{spelled}`: no arm of the `match` in `{rule}` takes `{kind}`.", f"`{rule}` chooses its pattern by `{written}` (ADR-grammar-2 D6){reached}.", f"Add an arm for `{kind}` to the `match` in `{rule}`, or call it with a type an arm takes.")
    return none
}

/// The reason of an arm that is `refuse("why")` alone; `null` for any other.
fn grammar_types_refused_why(alts: ref Vec[GrammarAlt], words: ref winnow_grammar::InternerContext) -> String? {
    if alts.len() != 1 || alts[0].action != null {
        return null
    }
    match alts[0].pattern.node {
        Pattern::Call { name, args, .. } => {
            if words.resolve(name) != "refuse" || args.len() != 1 {
                return null
            }
            match args[0] {
                Expr::LitStr { text, .. } => {
                    return text.clone()
                },
                else => {},
            }
        },
        else => {},
    }
    return null
}

/// An expression of a pattern with the types put in (`grammar_types_put_block`).
fn grammar_types_put_expr(expr: ref Expr, bound: ref collections::BTreeMap[String, Type], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> Expr {
    if bound.len() == 0 {
        return expr.clone()
    }
    let mut copy = expr.clone()
    let mut walk = grammar_types_putting(bound)
    grammar_types_walk_expr(copy, words, intern, walk)
    return copy
}

fn grammar_types_put_exprs(exprs: ref Vec[Expr], bound: ref collections::BTreeMap[String, Type], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> Vec[Expr] {
    let mut out: Vec[Expr] = []
    for expr in exprs {
        out.push(grammar_types_put_expr(expr, bound, words, intern))
    }
    return out
}

/// **The fields a `members[S]` builds** (ADR-grammar-2 D3): each field of
/// the struct `S` with the copy of the value rule for its type, which is
/// queued. An `S` that isn't a declared struct is `NK1164`, as a type a
/// rule's `S: Struct` bound refuses; one still a type parameter (in a rule
/// that takes types is only met in its copies.
fn grammar_types_members(built: ref Type, value: winnow_grammar::Symbol, span: ref Span, generic: ref collections::BTreeMap[String, GrammarRule], owner: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut work: GrammarTypesWork) -> Vec[GrammarMember] {
    let mut out: Vec[GrammarMember] = []
    let declared: (Vec[GenericParam], Vec[FieldDef])? = work.structs.get(words.resolve(built.name))?.clone()
    if declared == null {
        let spelled = grammar_types_spelled(words, built)
        grammar_types_refuse(work, "NK1164", span.clone(), f"`members[{spelled}]` builds a struct, and `{spelled}` isn't one this file declares.", "`members[S]` reads the members of an object into the fields of the struct `S` (ADR-grammar-2 D3); its fields are known only for a struct declared beside the grammar.", "Name a struct declared in the grammar's file.")
        return out
    }
    let (params, fields) = declared ?? return out
    let mut inner: collections::BTreeMap[String, Type] = collections::BTreeMap()
    let mut index: i64 = 0
    for parameter in params {
        if index < built.generics.len() as i64 {
            inner.insert(f"{words.resolve(parameter.name)}", built.generics[index].clone())
        }
        index += 1
    }
    let called = words.resolve(value)
    for field in fields {
        let fty = grammar_types_put(field.ty, inner, words)
        let types: Vec[Type] = [fty.clone()]
        let mut rule = value
        if generic.contains_key(called) {
            let mut path = work.path.clone()
            path.push(grammar_types_called(words, called, types))
            rule = intern(grammar_types_copy_name(words, called, types))
            work.queue.push(GrammarTypesWanted { call: GrammarTypesCall { owner: owner, rule: value, types: types }, from: work.from, path: path })
        }
        out.push(GrammarMember { name: field.name, ty: fty, value: rule })
    }
    return out
}

/// A type with each type parameter `bound` names put in.
pub fn grammar_types_put(ty: ref Type, bound: ref collections::BTreeMap[String, Type], words: ref winnow_grammar::InternerContext) -> Type {
    if ty.generics.len() == 0 && !ty.is_tuple {
        let given: Type? = bound.get(words.resolve(ty.name))?.clone()
        if given != null {
            let mut put: Type = given ?? ty.clone()
            put.is_nullable = put.is_nullable || ty.is_nullable
            return put
        }
    }
    let mut copy = ty.clone()
    let mut generics: Vec[Type] = []
    for arg in ty.generics {
        generics.push(grammar_types_put(arg, bound, words))
    }
    copy.generics = generics
    return copy
}

fn grammar_types_patterns(parts: ref Vec[Spanned[Pattern]], bound: ref collections::BTreeMap[String, Type], generic: ref collections::BTreeMap[String, GrammarRule], owner: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut work: GrammarTypesWork) -> Vec[Spanned[Pattern]] {
    let mut out: Vec[Spanned[Pattern]] = []
    for part in parts {
        out.push(grammar_types_pattern(part, bound, generic, owner, words, intern, work))
    }
    return out
}

/// A pattern with the types put in, and each rule it hands types to,
/// `Value[A]`, called by its copy's name, which is queued.
fn grammar_types_pattern(pattern: ref Spanned[Pattern], bound: ref collections::BTreeMap[String, Type], generic: ref collections::BTreeMap[String, GrammarRule], owner: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut work: GrammarTypesWork) -> Spanned[Pattern] {
    let mut copy = pattern.clone()
    match pattern.node {
        Pattern::Seq(parts) => {
            copy.node = Pattern::Seq(grammar_types_patterns(parts, bound, generic, owner, words, intern, work))
        },
        Pattern::Choice(parts) => {
            copy.node = Pattern::Choice(grammar_types_patterns(parts, bound, generic, owner, words, intern, work))
        },
        Pattern::Bind { name, pat } => {
            copy.node = Pattern::Bind { name: name, pat: grammar_types_pattern(pat, bound, generic, owner, words, intern, work) }
        },
        Pattern::Repeat { pat, rep } => {
            copy.node = Pattern::Repeat { pat: grammar_types_pattern(pat, bound, generic, owner, words, intern, work), rep: rep.clone() }
        },
        Pattern::Group(inner) => {
            copy.node = Pattern::Group(grammar_types_pattern(inner, bound, generic, owner, words, intern, work))
        },
        Pattern::Counted { pat, low, high, comma } => {
            let mut top: Expr? = null
            if high != null {
                let given: Expr = high?.clone() ?? low.clone()
                top = grammar_types_put_expr(given, bound, words, intern)
            }
            copy.node = Pattern::Counted { pat: grammar_types_pattern(pat, bound, generic, owner, words, intern, work), low: grammar_types_put_expr(low, bound, words, intern), high: top, comma: comma }
        },
        Pattern::Guard { cond, expected } => {
            copy.node = Pattern::Guard { cond: grammar_types_put_expr(cond, bound, words, intern), expected: expected?.clone() }
        },
        Pattern::Call { name, args, config } => {
            let mut config2: Vec[ConfigArg] = []
            for one in config {
                config2.push(ConfigArg { name: one.name, value: grammar_types_put_expr(one.value, bound, words, intern) })
            }
            copy.node = Pattern::Call { name: name, args: grammar_types_put_exprs(args, bound, words, intern), config: config2 }
        },
        Pattern::Choose { .. } => {
            grammar_types_refuse(work, "NK1310", pattern.span.clone(), "A `match` on a kind stands as a rule's whole body or a whole alternative, not inside a pattern.", "A rule body chooses its pattern by the kind of a type the rule takes (ADR-grammar-2 D2).", "Give the `match` a rule of its own, and call that rule here.")
        },
        Pattern::Members { ty, key, value, sep, on_null, on_unknown, fields } => {
            let built = grammar_types_put(ty, bound, words)
            let key2 = grammar_types_pattern(key, bound, generic, owner, words, intern, work)
            let sep2 = grammar_types_pattern(sep, bound, generic, owner, words, intern, work)
            let members = grammar_types_members(built, value, pattern.span, generic, owner, words, intern, work)
            copy.node = Pattern::Members { ty: built, key: key2, value: value, sep: sep2, on_null: on_null, on_unknown: on_unknown, fields: members }
        },
        Pattern::Ref { name, generics, args } => {
            let mut types: Vec[Type] = []
            for ty in generics {
                types.push(grammar_types_put(ty, bound, words))
            }
            let parts = grammar_types_patterns(args, bound, generic, owner, words, intern, work)
            let called = words.resolve(name)
            if generic.contains_key(called) && types.len() > 0 {
                let copied = grammar_types_copy_name(words, called, types)
                let mut path = work.path.clone()
                path.push(grammar_types_called(words, called, types))
                work.queue.push(GrammarTypesWanted { call: GrammarTypesCall { owner: owner, rule: name, types: types }, from: work.from, path: path })
                copy.node = Pattern::Ref { name: intern(copied), generics: [], args: parts }
            } else {
                copy.node = Pattern::Ref { name: name, generics: types, args: parts }
            }
        },
        else => {},
    }
    return copy
}

/// **The rules that take types, and whether a rule chooses**: what the
/// parser's host asks before it walks the program for the calls of a rule
/// that takes types (ADR-grammar-2 D1-D3). Neither, and nothing is copied.
pub struct GrammarTypesGeneric {
    pub rules: collections::BTreeSet[(winnow_grammar::Symbol, winnow_grammar::Symbol)],
    pub chooses: bool,
}

/// Each grammar's rules that take types, by grammar and rule, and whether a
/// `match` on a kind or a `members[S]` asks for the copying too, also in a
/// rule that takes no types (ADR-grammar-2 D2, D3).
pub fn grammar_types_generic(items: ref Vec[Spanned[Item]]) -> GrammarTypesGeneric {
    let mut found = GrammarTypesGeneric { rules: collections::BTreeSet(), chooses: false }
    for item in items {
        match item.node {
            Item::Grammar(def) => {
                for rule in def.rules.iter().filter(fn(r) { r.generics.len() > 0 }) {
                    found.rules.insert((def.name, rule.name))
                }
                found.chooses = grammar_types_wanted(def) || found.chooses
            },
            else => {},
        }
    }
    return found
}

/// **What one call of a rule that takes types asks for**: the copy and the
/// callee the call takes instead (`G::read__i64`), or, where its brackets
/// hold a value, that part and the callee as written (`NK1230`).
pub struct GrammarTypesAsked {
    pub call: GrammarTypesCall?,
    pub func: Expr?,
    pub refused: u32,
    pub callee: String,
}

/// **A call `G::read[i64](input)` of a rule in `generic`**, read off the
/// expression: what it asks for, or nothing for any other expression.
pub fn grammar_types_asked(expr: ref Expr, generic: ref collections::BTreeSet[(winnow_grammar::Symbol, winnow_grammar::Symbol)], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> GrammarTypesAsked? {
    match expr {
        Expr::Call { func, .. } => match func {
            Expr::Index { base, index, .. } => match base {
                Expr::Path(segments, _) => return grammar_types_asked_of(segments, index, generic, words, intern),
                else => return null,
            },
            else => return null,
        },
        else => return null,
    }
}

/// The call of `segments` with the brackets `index`, where `segments` names
/// a rule of `generic`.
fn grammar_types_asked_of(segments: ref Vec[winnow_grammar::Symbol], index: ref Expr, generic: ref collections::BTreeSet[(winnow_grammar::Symbol, winnow_grammar::Symbol)], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> GrammarTypesAsked? {
    if segments.len() != 2 || !generic.contains((segments[0], segments[1])) {
        return null
    }
    let owner = segments[0]
    let rule = segments[1]
    let bracket = grammar_types_bracket(index, words, intern)
    match bracket.value {
        null => {},
        value => {
            let callee = f"{words.resolve(owner)}::{words.resolve(rule)}"
            return GrammarTypesAsked { call: null, func: null, refused: value ?? 0, callee: callee }
        },
    }
    let copy = grammar_types_copy_name(words, words.resolve(rule), bracket.types)
    let func = Expr::Path([owner, intern(copy)], fresh_id())
    let call = GrammarTypesCall { owner: owner, rule: rule, types: bracket.types }
    return GrammarTypesAsked { call: call, func: func, refused: 0, callee: "" }
}

/// The types a call's brackets write, one per part, or the first part that
/// is a value and not a type (by its id).
struct GrammarTypesBracket {
    types: Vec[Type],
    value: u32?,
}

/// The parts of the brackets `index` (`[i64]`, `[K, V]`) read as types.
fn grammar_types_bracket(index: ref Expr, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> GrammarTypesBracket {
    let mut out = GrammarTypesBracket { types: [], value: null }
    match index {
        Expr::Tuple(parts, _) => {
            for part in parts {
                if !grammar_types_bracket_part(part, words, intern, out) {
                    return out
                }
            }
        },
        else => {
            grammar_types_bracket_part(index, words, intern, out)
        },
    }
    return out
}

/// One part of the brackets: its type kept, or the part named as a value.
fn grammar_types_bracket_part(part: ref Expr, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut out: GrammarTypesBracket) -> bool {
    match grammar_types_written(part, words, intern) {
        null => {
            out.value = id_of(part)
            return false
        },
        ty => {
            out.types.push(ty)
            return true
        },
    }
}

/// **The type a call's brackets write where an expression stands for it**:
/// `i64`, `json::Value`, `Vec[i64]`; nothing for a value.
pub fn grammar_types_written(expr: ref Expr, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> Type? {
    match expr {
        Expr::Variable(name, _) => return grammar_types_named(name, []),
        Expr::Path(segments, _) => {
            let spelled: Vec[String] = segments.iter().map(fn(s) { words.resolve(s).clone() }).collect()
            return grammar_types_named(intern(spelled.join("::")), [])
        },
        Expr::Index { base, index, .. } => {
            let outer = grammar_types_written(base, words, intern) ?? return null
            let bracket = grammar_types_bracket(index, words, intern)
            match bracket.value {
                null => return grammar_types_named(outer.name, bracket.types),
                else => return null,
            }
        },
        else => return null,
    }
}

/// A plain type of the name `name` and the type arguments `generics`.
fn grammar_types_named(name: winnow_grammar::Symbol, generics: Vec[Type]) -> Type {
    return Type { name: name, generics: generics, is_view: false, is_tuple: false, is_nullable: false, code: null, count: null, is_mut: false, is_slice: false, either: false, lasting: false }
}

/// **A value in a rule's brackets** (`NK1230`, ADR-grammar-2 D1), said at
/// `span`, the part that is a value: a rule that takes types takes them as a
/// function's type parameters are written.
pub fn grammar_types_value_refused(callee: ref String, span: ref Span) -> GrammarTypesRefusal {
    return GrammarTypesRefusal {
        code: "NK1230",
        call: -1,
        span: span.clone(),
        message: f"`{callee}` takes a type here, not a value.",
        note: f"`{callee}` is a rule that takes types, so the call writes types in its brackets (ADR-grammar-2 D1).",
        help: f"Write the type: `{callee}[i64](…)`, not a value of it.",
    }
}

/// **The type a rule's type parameter `name` stands for in a copy**, where
/// it is put as a value's head (`T::kind`, `T::from(…)`): a plain type only.
pub fn grammar_types_plain(name: winnow_grammar::Symbol, bound: ref collections::BTreeMap[String, Type], words: ref winnow_grammar::InternerContext) -> winnow_grammar::Symbol? {
    let ty = bound.get(words.resolve(name)) ?? return null
    if ty.generics.len() == 0 && !ty.is_nullable && !ty.is_tuple {
        return ty.name
    }
    return null
}

/// **Every call of a rule that takes types made the call of its copy, and the
/// copies made** (ADR-grammar-2 D1): what the parser does right after the
/// grammar. Each call `G::read[i64](input)` becomes `G::read__i64(input)`, and
/// the rules are copied once per list of type arguments, so no later reader
/// sees a rule that takes types. A value in the brackets is `NK1230`, as a
/// value where a type belongs is; it and every other refusal stand at the
/// call that asked for the copy (by `spans`, the file's spans by id), and one
/// no call asked for at the pattern it is about. Only the first refusal is
/// said; a program with no rule that takes types and no `match` on a kind
/// comes back as it was.
pub fn grammar_types_whole(items: Vec[Spanned[Item]], spans: ref collections::BTreeMap[u32, Span], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> GrammarTypesExpanded {
    let generic = grammar_types_generic(items)
    let mut all = items
    if generic.rules.len() == 0 && !generic.chooses {
        return GrammarTypesExpanded { items: all, refused: [] }
    }
    let mut walk = GrammarTypesWalk { putting: false, bound: collections::BTreeMap(), rules: generic.rules, calls: [], call_ids: [], refused_at: null, refused_callee: "" }
    for mut item in all {
        grammar_types_walk_item(item.node, words, intern, walk)
    }
    if walk.refused_at != null {
        let at = parsed_span_of(spans, walk.refused_at ?? 0) ?? Span { start: 0, end: 0 }
        return GrammarTypesExpanded { items: all, refused: [grammar_types_value_refused(walk.refused_callee, at)] }
    }
    let mut expanded = grammar_types_expand(all, walk.calls, words, intern)
    if expanded.refused.len() > 0 {
        grammar_types_placed(expanded.refused[0], walk.call_ids, spans)
    }
    return expanded
}

/// A refusal of the copying put at the call that asked for the copy, where a
/// call did and the parser kept where it stands.
fn grammar_types_placed(mut refusal: GrammarTypesRefusal, call_ids: ref Vec[u32], spans: ref collections::BTreeMap[u32, Span]) {
    if refusal.call < 0 {
        return
    }
    let id = call_ids.get(refusal.call) ?? return
    refusal.span = parsed_span_of(spans, id) ?? return
}

/// **A copy's actions, guards and bounds with the rule's type parameters
/// put in** (ADR-grammar-2 D1): a type written in them (`d as T`,
/// `let x: T`), and a parameter standing as a value's head (`T::kind`,
/// `T::from(…)`), names the type the copy is for.
fn grammar_types_put_block(block: ref Block, bound: ref collections::BTreeMap[String, Type], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> Block {
    let mut copy = block.clone()
    let mut walk = grammar_types_putting(bound)
    grammar_types_walk_block(copy, words, intern, walk)
    return copy
}

/// **What the walk over a program's code does at each expression, children
/// before parents, and each statement after its parts**: put a copy's types
/// in (`putting`, with the types each parameter is `bound` to), or read the
/// calls of the rules that take types (`rules`), making each the call of its
/// copy, with the copies asked for, the ids of their calls, and the first
/// call whose brackets hold a value (its id and the callee as written).
struct GrammarTypesWalk {
    putting: bool,
    bound: collections::BTreeMap[String, Type],
    rules: collections::BTreeSet[(winnow_grammar::Symbol, winnow_grammar::Symbol)],
    calls: Vec[GrammarTypesCall],
    call_ids: Vec[u32],
    refused_at: u32?,
    refused_callee: String,
}

/// The walk that puts the types `bound` in.
fn grammar_types_putting(bound: ref collections::BTreeMap[String, Type]) -> GrammarTypesWalk {
    return GrammarTypesWalk { putting: true, bound: bound.clone(), rules: collections::BTreeSet(), calls: [], call_ids: [], refused_at: null, refused_callee: "" }
}

/// The blocks of an item: a function's, a test's, a bench's, each method's.
fn grammar_types_walk_item(mut item: Item, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    match item {
        Item::Fn { body, .. } => grammar_types_walk_block(body, words, intern, walk),
        Item::Test { body, .. } => grammar_types_walk_block(body, words, intern, walk),
        Item::Bench { body, .. } => grammar_types_walk_block(body, words, intern, walk),
        Item::Impl { methods, .. } => {
            for mut method in methods {
                grammar_types_walk_item(method.node, words, intern, walk)
            }
        },
        else => {},
    }
}

fn grammar_types_walk_block(mut block: Block, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    for mut stmt in block.stmts {
        grammar_types_walk_stmt(stmt.node, words, intern, walk)
        grammar_types_visit_stmt(stmt.node, words, walk)
    }
}

fn grammar_types_walk_stmt(mut stmt: Stmt, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    match stmt {
        Stmt::Let { value, .. } => grammar_types_walk_expr(value, words, intern, walk),
        Stmt::Assign { target, value, .. } => {
            grammar_types_walk_expr(target, words, intern, walk)
            grammar_types_walk_expr(value, words, intern, walk)
        },
        Stmt::For { iter, body, .. } => {
            grammar_types_walk_expr(iter, words, intern, walk)
            grammar_types_walk_block(body, words, intern, walk)
        },
        Stmt::While { cond, body } => {
            grammar_types_walk_expr(cond, words, intern, walk)
            grammar_types_walk_block(body, words, intern, walk)
        },
        Stmt::Return(value) => grammar_types_walk_maybe(value, words, intern, walk),
        Stmt::Expr(value) => grammar_types_walk_expr(value, words, intern, walk),
        else => {},
    }
}

fn grammar_types_walk_maybe(mut expr: Expr?, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    if expr != null {
        grammar_types_walk_expr(expr, words, intern, walk)
    }
}

fn grammar_types_walk_else(mut block: Block?, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    if block != null {
        grammar_types_walk_block(block, words, intern, walk)
    }
}

fn grammar_types_walk_all(mut all: Vec[Expr], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    for mut each in all {
        grammar_types_walk_expr(each, words, intern, walk)
    }
}

fn grammar_types_walk_config(mut config: Vec[ConfigArg], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    for mut option in config {
        grammar_types_walk_expr(option.value, words, intern, walk)
    }
}

fn grammar_types_walk_fields(mut fields: Vec[FieldInit], words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    for mut field in fields {
        grammar_types_walk_maybe(field.value, words, intern, walk)
    }
}

fn grammar_types_walk_expr(mut expr: Expr, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    match expr {
        Expr::Call { func, args, config, .. } => {
            grammar_types_walk_expr(func, words, intern, walk)
            grammar_types_walk_all(args, words, intern, walk)
            grammar_types_walk_config(config, words, intern, walk)
        },
        Expr::MethodCall { receiver, args, config, .. } => {
            grammar_types_walk_expr(receiver, words, intern, walk)
            grammar_types_walk_all(args, words, intern, walk)
            grammar_types_walk_config(config, words, intern, walk)
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            grammar_types_walk_expr(receiver, words, intern, walk)
            grammar_types_walk_all(args, words, intern, walk)
            grammar_types_walk_config(config, words, intern, walk)
        },
        Expr::Binary { lhs, rhs, .. } => {
            grammar_types_walk_expr(lhs, words, intern, walk)
            grammar_types_walk_expr(rhs, words, intern, walk)
        },
        Expr::Unary { expr: inner, .. } => grammar_types_walk_expr(inner, words, intern, walk),
        Expr::Try(inner, _) => grammar_types_walk_expr(inner, words, intern, walk),
        Expr::Throw(inner, _) => grammar_types_walk_expr(inner, words, intern, walk),
        Expr::Cast { expr: inner, .. } => grammar_types_walk_expr(inner, words, intern, walk),
        Expr::Return(value, _) => grammar_types_walk_maybe(value, words, intern, walk),
        Expr::Field { base, .. } => grammar_types_walk_expr(base, words, intern, walk),
        Expr::SafeField { base, .. } => grammar_types_walk_expr(base, words, intern, walk),
        Expr::Index { base, index, .. } => {
            grammar_types_walk_expr(base, words, intern, walk)
            grammar_types_walk_expr(index, words, intern, walk)
        },
        Expr::Range { start, end, .. } => {
            grammar_types_walk_expr(start, words, intern, walk)
            grammar_types_walk_expr(end, words, intern, walk)
        },
        Expr::Tuple(items, _) => grammar_types_walk_all(items, words, intern, walk),
        Expr::ListLit { items, .. } => grammar_types_walk_all(items, words, intern, walk),
        Expr::ListRepeat { value, count, .. } => {
            grammar_types_walk_expr(value, words, intern, walk)
            grammar_types_walk_expr(count, words, intern, walk)
        },
        Expr::Coalesce { value, fallback, .. } => {
            grammar_types_walk_expr(value, words, intern, walk)
            grammar_types_walk_expr(fallback, words, intern, walk)
        },
        Expr::TryCatch { expr: inner, handler, .. } => {
            grammar_types_walk_expr(inner, words, intern, walk)
            grammar_types_walk_block(handler, words, intern, walk)
        },
        Expr::If { cond, then_branch, else_branch, .. } => {
            grammar_types_walk_expr(cond, words, intern, walk)
            grammar_types_walk_block(then_branch, words, intern, walk)
            grammar_types_walk_else(else_branch, words, intern, walk)
        },
        Expr::Match { value, arms, .. } => {
            grammar_types_walk_expr(value, words, intern, walk)
            for mut arm in arms {
                grammar_types_walk_maybe(arm.guard, words, intern, walk)
                grammar_types_walk_expr(arm.body, words, intern, walk)
            }
        },
        Expr::StructLit { fields, .. } => grammar_types_walk_fields(fields, words, intern, walk),
        Expr::With { base, fields, .. } => {
            grammar_types_walk_expr(base, words, intern, walk)
            grammar_types_walk_fields(fields, words, intern, walk)
        },
        Expr::Block(block, _) => grammar_types_walk_block(block, words, intern, walk),
        Expr::Unsafe(block, _) => grammar_types_walk_block(block, words, intern, walk),
        Expr::Overlap(block, _) => grammar_types_walk_block(block, words, intern, walk),
        Expr::Closure { body, .. } => grammar_types_walk_block(body, words, intern, walk),
        Expr::Spawn { body, .. } => grammar_types_walk_expr(body, words, intern, walk),
        else => {},
    }
    if walk.putting {
        grammar_types_put_in(expr, words, walk)
    } else {
        grammar_types_ask(expr, words, intern, walk)
    }
}

/// A statement's written type with the copy's types put in.
fn grammar_types_visit_stmt(mut stmt: Stmt, words: ref winnow_grammar::InternerContext, walk: ref GrammarTypesWalk) {
    if !walk.putting {
        return
    }
    match stmt {
        Stmt::Let { ty, .. } => grammar_types_put_written(ty, walk.bound, words),
        Stmt::Comptime { ty, .. } => grammar_types_put_written(ty, walk.bound, words),
        else => {},
    }
}

fn grammar_types_put_written(mut ty: Type?, bound: ref collections::BTreeMap[String, Type], words: ref winnow_grammar::InternerContext) {
    if ty != null {
        ty = grammar_types_put(ty, bound, words)
    }
}

/// An expression with the copy's types put in: the type of a cast, and a
/// parameter standing as a name or as a path's head.
fn grammar_types_put_in(mut expr: Expr, words: ref winnow_grammar::InternerContext, walk: ref GrammarTypesWalk) {
    match expr {
        Expr::Cast { expr: inner, ty, id } => {
            expr = Expr::Cast { expr: inner, ty: grammar_types_put(ty, walk.bound, words), id: id }
            return
        },
        else => {},
    }
    let to = grammar_types_head(expr, walk.bound, words) ?? return
    match expr {
        Expr::Variable(_, id) => {
            expr = Expr::Variable(to, id)
        },
        Expr::Path(segments, id) => {
            let mut put = segments.clone()
            put[0] = to
            expr = Expr::Path(put, id)
        },
        else => {},
    }
}

/// The type a name, or a path's head, stands for in the copy, where it is
/// one of the rule's type parameters.
fn grammar_types_head(expr: ref Expr, bound: ref collections::BTreeMap[String, Type], words: ref winnow_grammar::InternerContext) -> winnow_grammar::Symbol? {
    return match expr {
        Expr::Variable(name, _) => grammar_types_plain(name, bound, words),
        Expr::Path(segments, _) => if segments.len() > 0 { grammar_types_plain(segments[0], bound, words) } else { null },
        else => null,
    }
}

/// A call of a rule that takes types made the call of its copy, the copy
/// asked for kept; a call whose brackets hold a value kept as the first
/// refusal, unless there is one.
fn grammar_types_ask(mut expr: Expr, words: ref winnow_grammar::InternerContext, intern: fn(ref String) -> winnow_grammar::Symbol sync, mut walk: GrammarTypesWalk) {
    let call_id = id_of(expr)
    let asked = grammar_types_asked(expr, walk.rules, words, intern) ?? return
    if asked.call == null || asked.func == null {
        if walk.refused_at == null {
            walk.refused_at = asked.refused
            walk.refused_callee = asked.callee
        }
        return
    }
    let to = asked.func ?? return
    match expr {
        Expr::Call { args, config, id, .. } => {
            expr = Expr::Call { func: to, args: args, config: config, id: id }
        },
        else => {},
    }
    walk.call_ids.push(call_id)
    walk.calls.push(asked.call ?? return)
}
