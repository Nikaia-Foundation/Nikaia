// crates/nikaia-std/src/tools/lsp.nika
//
// **`nikaia lsp`: the language server** (#1347, the first slice of #103). An
// editor starts it and talks LSP's JSON-RPC on its standard input and output:
// each message is a header, `Content-Length: N`, a blank line, and a body of
// exactly `N` bytes of JSON, which `packages/json` reads and writes (#1163).
// It answers the lifecycle (`initialize`, `shutdown`, `exit`); a request it
// does not know is answered with `-32601`, a notification it does not know is
// dropped. It keeps the text of each document the editor has open, and after
// each `didOpen`, `didChange` and `didSave` it publishes what `nikaia check`
// says of that file's package - checked in this process, over the editor's
// text (`LspHost`) - as `textDocument/publishDiagnostics`, each finding on the
// file it is about.

use json
use std::collections
use std::fs
use std::io
use std::text

/// **What the server asks of the compiler** (#1347): the findings of the
/// program `entry` belongs to, read as `nikaia check` reads it with the files
/// in `open` (a path to the text the editor holds) instead of the disk, and
/// checked; nothing emitted, cached or written. Each finding comes with the
/// path of the file it is about, warnings too. `alone` checks `entry` as a
/// single file, in no package: a document with no `file://` path (#1365).
pub trait LspHost {
    fn diagnose(ref self, entry: ref String, open: ref collections::BTreeMap[String, String], alone: bool) -> Vec[(String, Shown)] sync
}

/// A message the editor sent that cannot be read as one.
pub enum LspRefusal {
    Framing(String),
}

impl Error for LspRefusal {
    fn message(ref self) -> String {
        return match self {
            LspRefusal::Framing(why) => why.clone(),
        }
    }
}

/// **One message's body**: the header lines up to the blank one, then exactly
/// the bytes its `Content-Length` names (Part III 17.1's `read_line` and
/// `read_exact`); nothing where the input ends before a header.
pub fn lsp_read_message() -> String? throws {
    let mut length = -1
    while true {
        let line = io::read_line() ?? return null
        if line.is_empty() {
            break
        }
        let value = line.strip_prefix("Content-Length:")
        if value != null {
            length = text::parse_i64((value ?? "").trim()) ?? -1
        }
    }
    if length < 0 {
        throw LspRefusal::Framing("a message without a `Content-Length` header")
    }
    let body = io::read_exact(length)
    let read = body.text() catch { throw LspRefusal::Framing("a message body that is not UTF-8") }
    return read.clone()
}

/// **One message to the editor**: its header and its body. Standard output is
/// flushed before the next read waits (`io::read_line`), so the editor has the
/// answer before this waits for the next question.
pub fn lsp_write_message(body: ref json::Value) {
    let text = json::to_string(body)
    print(f"Content-Length: {text.len()}\r\n\r\n{text}")
}

/// An object, its members in the order given.
pub fn lsp_object(members: Vec[(ref String, json::Value)]) -> json::Value {
    return json::Value::Object(members.iter().map(fn(member) { json::Member { key: member.0.clone(), value: member.1.clone() } }).collect())
}

/// A string value.
pub fn lsp_string(text: ref String) -> json::Value {
    return json::Value::Str(text.clone())
}

/// A whole number value.
pub fn lsp_number(n: i64) -> json::Value {
    return json::Value::Number(f"{n}")
}

/// The answer to the request `id`.
pub fn lsp_respond(id: ref json::Value, result: json::Value) {
    lsp_write_message(lsp_object([("jsonrpc", lsp_string("2.0")), ("id", id.clone()), ("result", result)]))
}

/// The request `id` refused with `code` and `message` (JSON-RPC 2.0, 5.1).
pub fn lsp_refuse(id: ref json::Value, code: i64, message: ref String) {
    let error = lsp_object([("code", lsp_number(code)), ("message", lsp_string(message))])
    lsp_write_message(lsp_object([("jsonrpc", lsp_string("2.0")), ("id", id.clone()), ("error", error)]))
}

/// What `initialize` answers: the whole text of a document is sent on each
/// change (`textDocumentSync` 1), and nothing else is offered.
pub fn lsp_capabilities() -> json::Value {
    return lsp_object([("capabilities", lsp_object([("textDocumentSync", lsp_number(1))]))])
}

/// **The server**: messages are read and answered until `exit`. What it ends
/// with is LSP's: `0` after a `shutdown`, `1` for an `exit` without one or an
/// input that ended without `exit`.
pub fn lsp_serve[H: LspHost](host: ref H) -> i64 throws {
    let mut shut_down = false
    // The documents the editor has open, by path, and the URI it named each by.
    let mut open: collections::BTreeMap[String, String] = collections::BTreeMap()
    let mut uris: collections::BTreeMap[String, String] = collections::BTreeMap()
    // The URIs whose markers a check published, each with the package that
    // check was of, to be cleared when a check of that package finds nothing
    // there any more.
    let mut marked: collections::BTreeMap[String, String] = collections::BTreeMap()
    while true {
        let body = lsp_read_message() ?? return 1
        let message = json::parse(body) catch {
            lsp_refuse(json::Value::Null, -32700, f"the message is not JSON: {error.message}")
            continue
        }
        let method = cargo_json_text(cargo_json_member(message, "method")) ?? ""
        let id = cargo_json_member(message, "id")
        if method == "exit" {
            return if shut_down { 0 } else { 1 }
        }
        match id {
            // A notification: one it does not know is dropped.
            null => {
                let params = cargo_json_member(message, "params")
                let document = cargo_json_member(params, "textDocument")
                let uri = cargo_json_text(cargo_json_member(document, "uri")) ?? continue
                // **A document with no `file://` path** (`untitled:`) is
                // named by its URI and belongs to no package (#1365): it is
                // checked alone, as a single file.
                let alone = !uri.starts_with("file://")
                let path = if alone { uri.clone() } else { lsp_uri_path(uri) ?? continue }
                if method == "textDocument/didOpen" {
                    open.insert(path.clone(), cargo_json_text(cargo_json_member(document, "text")) ?? "")
                    uris.insert(path.clone(), uri.clone())
                    marked = lsp_publish(host, path, open, uris, marked, alone)
                } else if method == "textDocument/didChange" {
                    // The whole text, as `textDocumentSync` 1 asks: the last
                    // change is the document.
                    let changes = cargo_json_items(cargo_json_member(params, "contentChanges"))
                    if changes.len() > 0 {
                        let last = changes.len() - 1
                        let changed: json::Value? = changes[last].clone()
                        open.insert(path.clone(), cargo_json_text(cargo_json_member(changed, "text")) ?? "")
                    }
                    marked = lsp_publish(host, path, open, uris, marked, alone)
                } else if method == "textDocument/didSave" {
                    marked = lsp_publish(host, path, open, uris, marked, alone)
                } else if method == "textDocument/didClose" {
                    open.remove(path)
                    uris.remove(path)
                    if marked.contains_key(uri) {
                        marked.remove(uri)
                        lsp_notify_diagnostics(uri, [])
                    }
                    // The package lost the editor's text of this file - all
                    // of it where the file was never saved (#1365) - so an
                    // open document beside it is checked again.
                    if !alone {
                        let beside = lsp_open_beside(path, open) ?? continue
                        marked = lsp_publish(host, beside, open, uris, marked, false)
                    }
                }
            },
            asked => {
                if method == "initialize" {
                    lsp_respond(asked, lsp_capabilities())
                } else if method == "shutdown" {
                    shut_down = true
                    lsp_respond(asked, json::Value::Null)
                } else {
                    lsp_refuse(asked, -32601, f"no method `{method}`")
                }
            },
        }
    }
    return 1
}

/// **The path a `file://` URI names**, each `%XX` decoded as the byte it
/// writes; nothing for a URI of another scheme or one whose bytes are not
/// UTF-8.
pub fn lsp_uri_path(uri: ref String) -> String? {
    let rest = uri.strip_prefix("file://") ?? return null
    let given: Vec[u8] = rest.bytes().collect()
    let mut decoded: Vec[u8] = []
    let mut i = 0
    while i < given.len() as i64 {
        let b = given[i]
        if b == 37 && i + 2 < given.len() as i64 {
            let high = lsp_hex(given[i + 1])
            let low = lsp_hex(given[i + 2])
            if high >= 0 && low >= 0 {
                decoded.push((high * 16 + low) as u8)
                i += 3
                continue
            }
        }
        decoded.push(b)
        i += 1
    }
    let bytes = Bytes(decoded)
    let path = bytes.text() catch { return null }
    return path.clone()
}

/// The value of one hex digit, `-1` for a byte that is none.
fn lsp_hex(b: u8) -> i64 {
    let d = b as i64
    if d >= 48 && d <= 57 {
        return d - 48
    }
    if d >= 65 && d <= 70 {
        return d - 55
    }
    if d >= 97 && d <= 102 {
        return d - 87
    }
    return -1
}

/// **LSP's place of the byte `at` in `source`**: the line from 0, and the
/// column in UTF-16 code units from 0, as LSP counts by default. A span is in
/// bytes; a character outside ASCII is more than one byte and one code unit,
/// and one above U+FFFF is two code units.
pub fn lsp_position(source: ref String, at: i64) -> (i64, i64) {
    let mut line = 0
    let mut column = 0
    let mut byte = 0
    for c in source.chars() {
        if byte >= at {
            break
        }
        let code = c as i64
        byte += if code < 128 { 1 } else if code < 2048 { 2 } else if code < 65536 { 3 } else { 4 }
        if c == '\n' {
            line += 1
            column = 0
        } else {
            column += if code < 65536 { 1 } else { 2 }
        }
    }
    return (line, column)
}

/// **What the check of `path`'s program says, published** (#1347): one
/// `publishDiagnostics` for each file it found something in, one for `path`
/// itself even when that is nothing, and an empty one for each file the last
/// check of the same package marked and this one did not, so old markers
/// disappear; a check of another package leaves them (#1365: a document
/// checked alone cleared the markers of a package's file). What it gives
/// back is the URIs marked, each with its package: `path`'s directory, or
/// `path` itself for a document checked alone.
fn lsp_publish[H: LspHost](host: ref H, path: ref String, open: ref collections::BTreeMap[String, String], uris: ref collections::BTreeMap[String, String], marked: ref collections::BTreeMap[String, String], alone: bool) -> collections::BTreeMap[String, String] {
    let checked: fs::Path = path
    let package = match checked.parent() {
        null => path.clone(),
        dir => if alone { path.clone() } else { dir.text_of().clone() },
    }
    let found = host.diagnose(path, open, alone)
    let mut by_file: collections::BTreeMap[String, Vec[json::Value]] = collections::BTreeMap()
    by_file.insert(path.clone(), [])
    let mut sources: collections::BTreeMap[String, String] = collections::BTreeMap()
    for (file, shown) in found {
        if !sources.contains_key(file) {
            let text = match open.get(file) {
                null => fs::read_to_string(file, fs::Root::Anywhere) catch { "" },
                held => held.clone(),
            }
            sources.insert(file.clone(), text)
        }
        let source = sources.get(file) ?? continue
        let uri = lsp_uri_of(file, uris)
        let diagnostic = lsp_diagnostic(shown, source, uri)
        by_file.entry(file.clone()).or_insert([]).push(diagnostic)
    }
    let mut now: collections::BTreeMap[String, String] = collections::BTreeMap()
    for (file, list) in by_file {
        let uri = lsp_uri_of(file, uris)
        if !list.is_empty() {
            now.insert(uri.clone(), package.clone())
        }
        lsp_notify_diagnostics(uri, list.clone())
    }
    for (uri, of) in marked {
        if now.contains_key(uri) || by_file.keys().any(fn(file) { lsp_uri_of(file, uris) == uri }) {
            continue
        }
        if of == package {
            lsp_notify_diagnostics(uri, [])
        } else {
            now.insert(uri.clone(), of.clone())
        }
    }
    return now
}

/// The first open document in the directory of `path`, a file of the same
/// package; nothing where there is none.
fn lsp_open_beside(path: ref String, open: ref collections::BTreeMap[String, String]) -> String? {
    let closed: fs::Path = path
    let dir = closed.parent() ?? return null
    for key in open.keys() {
        let held: fs::Path = key
        let parent = held.parent() ?? continue
        if parent.text_of() == dir.text_of() {
            return key.clone()
        }
    }
    return null
}

/// One `textDocument/publishDiagnostics` notification.
fn lsp_notify_diagnostics(uri: ref String, diagnostics: Vec[json::Value]) {
    let params = lsp_object([("uri", lsp_string(uri)), ("diagnostics", json::Value::Array(diagnostics))])
    lsp_write_message(lsp_object([("jsonrpc", lsp_string("2.0")), ("method", lsp_string("textDocument/publishDiagnostics")), ("params", params)]))
}

/// The URI the editor named the file at `path` by, or the `file://` URI of
/// the path for a file it does not have open.
fn lsp_uri_of(path: ref String, uris: ref collections::BTreeMap[String, String]) -> String {
    return match uris.get(path) {
        null => lsp_path_uri(path),
        uri => uri.clone(),
    }
}

/// **The `file://` URI of a path**: every byte but a letter, a digit, `-`,
/// `.`, `_`, `~` and `/` written as `%XX` (RFC 3986 2.3).
pub fn lsp_path_uri(path: ref String) -> String {
    let mut out: String = "file://"
    let digits: Vec[scalar] = "0123456789ABCDEF".chars().collect()
    for b in path.bytes() {
        let d = b as i64
        let kept = (d >= 48 && d <= 57) || (d >= 65 && d <= 90) || (d >= 97 && d <= 122) || d == 45 || d == 46 || d == 95 || d == 126 || d == 47
        if kept {
            out.push(b as scalar)
        } else {
            out.push('%')
            out.push(digits[d / 16].clone())
            out.push(digits[d % 16].clone())
        }
    }
    return out
}

/// **One finding as an LSP `Diagnostic`**: severity 1 for an error and 2 for
/// a warning, its code, `source` `nikaia`, its message with each note and the
/// help as lines of their own, the range of the place it marks (the one
/// `nikaia check`'s `-->` names), and each place that explains it as
/// `relatedInformation`.
pub fn lsp_diagnostic(shown: ref Shown, source: ref String, uri: ref String) -> json::Value {
    let mut message = said(shown.message)
    for note in shown.notes {
        message.push_str(ref f"\nnote: {said(note)}")
    }
    match shown.help {
        null => {},
        help => message.push_str(ref f"\nhelp: {said(help)}"),
    }
    let mut range = lsp_range(source, shown.span, "")
    let mut related: Vec[json::Value] = []
    let mut placed = false
    for label in shown.labels {
        let marks = lsp_range(source, label.span, label.word)
        if label.main && !placed {
            range = marks
            placed = true
        } else if !label.main {
            let location = lsp_object([("uri", lsp_string(uri)), ("range", marks)])
            let text = if label.text.is_empty() { "here" } else { label.text.clone() }
            related.push(lsp_object([("location", location), ("message", lsp_string(text))]))
        }
    }
    let mut members: Vec[(ref String, json::Value)] = [("range", range), ("severity", lsp_number(if shown.warning { 2 } else { 1 }))]
    if !shown.code.is_empty() {
        members.push(("code", lsp_string(shown.code)))
    }
    members.push(("source", lsp_string("nikaia")))
    members.push(("message", lsp_string(message)))
    if !related.is_empty() {
        members.push(("relatedInformation", json::Value::Array(related)))
    }
    return lsp_object(members)
}

/// **LSP's range of what a place marks**, placed as `tools/render.nika` places
/// it: the line `span` starts on, `word` found from there (`word_in`), or
/// for no word the span's first line without its trailing space; at least one
/// character. Lines from 0, columns in UTF-16 code units from 0.
pub fn lsp_range(source: ref String, span: ref Span, word: ref String) -> json::Value {
    let lines: Vec[ref String] = source.split("\n").collect()
    let at = span.start as i64
    let end = span.end as i64
    let mut line = 0
    let mut start = 0
    while line + 1 < lines.len() as i64 && start + lines[line].len() as i64 < at {
        start += lines[line].len() as i64 + 1
        line += 1
    }
    let text = lines[line]
    let mut column = 1
    let mut covered = 0
    let mut pending = 0
    let mut bytes = start
    for c in text.chars() {
        if bytes < at {
            column += 1
        } else if bytes < end {
            if c == ' ' || c == '\t' || c == '\r' {
                pending += 1
            } else {
                covered += pending + 1
                pending = 0
            }
        }
        let code = c as i64
        bytes += if code < 128 { 1 } else if code < 2048 { 2 } else if code < 65536 { 3 } else { 4 }
    }
    let placed = if word.is_empty() { (column, if covered < 1 { 1 } else { covered }) } else { word_in(text, column, word) }
    let from = lsp_units(text, placed.0 - 1)
    let to = lsp_units(text, placed.0 - 1 + placed.1)
    return lsp_object([("start", lsp_point(line, from)), ("end", lsp_point(line, to))])
}

/// How many UTF-16 code units the first `count` characters of `line` take.
fn lsp_units(line: ref String, count: i64) -> i64 {
    let mut units = 0
    let mut seen = 0
    for c in line.chars() {
        if seen >= count {
            break
        }
        units += if (c as i64) < 65536 { 1 } else { 2 }
        seen += 1
    }
    return units
}

/// A `Position`.
fn lsp_point(line: i64, character: i64) -> json::Value {
    return lsp_object([("line", lsp_number(line)), ("character", lsp_number(character))])
}
