// crates/nikaia-std/src/tools/check_core_pilot.nika
//
// **The first four functions of the checker's core that moved** (ADR-294, #125,
// #558, C-6, U-c0): `grammar_call`, `a_compound_write_to_a_map_slot`,
// `an_instantiation` and `a_mut_parameter_given_away`. They are the pilot of
// the form every later unit takes: a free function over the state
// (`mut state: CheckState`, which lowers to `&mut CheckState`), the world, and
// a host `H: CheckHost`; what has not moved yet is asked of the host
// (`check_core_expr` is the hub the walk comes back through), what has is called as
// `check_core_*`, and what is below the core is a method of the state.

use std::collections

/// The name of the copy of `function` that is specialised on the type `on`:
/// the emitter writes the same name at the call and at the definition.
pub fn check_specialised(function: ref String, on: ref String) -> String {
    // A type with parts is spelled into a name the language below accepts
    // (ADR-330 D2): `Vec[i64]` is `Vec_i64_`, `i64?` is `i64_maybe`.
    let mut tail: String = on.clone()
    for (from, to) in [("::", "__"), (" -> ", "_to_"), (", ", "_"), ("[", "_"), ("]", "_"), ("(", "_of_"), (")", "_"), ("?", "_maybe"), (" ", "_")] {
        tail = tail.replace(from, to)
    }
    return f"{function}__{tail}"
}

/// **A call of a grammar's entry rule** (ADR-308 D2): its arguments are walked,
/// whether it can fail comes from the contract (a rule past a commit point is
/// an entry in the ledger with `throws = ["?"]`, ADR-023 D9), and what it comes
/// to is the contract's result. **An entry takes a `String` or a `Bytes`**
/// (ADR-366 D1): the argument decides, and a `Bytes` one is kept in
/// `bytes_entries` and its grammar in `bytes_grammars`, for the lowering to
/// compile the grammar over bytes too. The result and `throws` are as for text.
pub fn check_core_grammar_call[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, key: ref String, args: ref Vec[Expr], config: ref Vec[ConfigArg], span: ref Span) -> Ty sync {
    // **The input first, then the values the entry takes** (ADR-grammar-1
    // D2), checked against its contract as a function's arguments are.
    let declared: FnContract? = world.own.functions[key]?.clone()
    match declared {
        contract => {
            let signature = contract.signature ?? Signature::empty()
            let wanted = signature.params.len() as i64 - 1
            if wanted >= 0 && args.len() as i64 - 1 != wanted {
                state.findings.push(check_refusal("NK1101", span, f"`{key}` takes the input and {counted(wanted, "value")}, but you passed {args.len()} arguments.", ["An entry takes the text or bytes to parse first, then the values its rule declares (ADR-grammar-1 D2)."], "Give the input, then one value for each, by position."))
            }
            for i in 1..<args.len() {
                if i < signature.params.len() {
                    let named = signature.params[i].0.clone()
                    let given = check_core_expr(state, world, host, args[i], span)
                    state.expect_type(world, given, signature.params[i].1, span, "argument", fn(was, wanted) { f"The value for `{named}` is `{was}`, but `{key}` takes `{wanted}`." })
                }
            }
            for c in config {
                let option = world.words.resolve(c.name).clone()
                let mut found = false
                for o in signature.config {
                    if o.name == option {
                        found = true
                        let given = check_core_expr(state, world, host, c.value, span)
                        state.expect_type(world, given, o.ty, span, "argument", fn(was, wanted) { f"The option `{option}` is `{was}`, but `{key}` takes `{wanted}`." })
                    }
                }
                if !found {
                    state.findings.push(check_refusal("NK1109", span, f"`{key}` has no option called `{option}`.", ["An entry's options are what its rule declares after its `;`."], "Name an option the rule declares."))
                }
            }
        },
        null => {},
    }
    let mut at = 0
    for arg in args {
        at += 1
        if at > 1 {
            continue
        }
        let given = check_core_expr(state, world, host, arg, span)
        let over_bytes = match given {
            Ty::Named { name, args: inner, .. } => name == "Bytes" && inner.len() == 0,
            else => false,
        }
        let over_text = match given {
            Ty::Named { name, args: inner, .. } => (name == "String" || name == "str" || name == "Mapped") && inner.len() == 0,
            else => false,
        }
        if !over_bytes && !over_text && !given.is_unknown() {
            state.findings.push(check_core_grammar_input_refused(key, given, span))
        }
        let cut = key.find("::") ?? 0
        if over_bytes && cut > 0 {
            state.facts.bytes_entries.insert(id_of(arg) as i64)
            state.facts.bytes_grammars.insert(key[0..<cut].clone())
        }
        if over_text && cut > 0 {
            match grammar_positions_over_text(world, key, key[0..<cut].clone(), span) {
                refused => state.findings.push(refused),
                null => {},
            }
        }
    }
    let contract = world.own.functions[key]?.clone() ?? return Ty::Unknown
    if contract.fails_with.len() > 0 && state.flow.guarded != null {
        let held: CheckGuarded? = state.flow.guarded?.clone()
        let mut guarded = held ?? CheckGuarded::nothing()
        guarded.fallible = true
        guarded.thrown.extend(contract.fails_with.clone())
        state.flow.guarded = guarded
    }
    let signature = contract.signature ?? return Ty::Unknown
    return signature.result ?? Ty::Unknown
}

/// **`NK1162`: a compound assignment to a map's slot** (ADR-080 D2). It reads
/// the slot and writes it, and the read is a `T?`, so the form has to say what
/// an absent key counts as. A sequence is untouched: `xs[i] += 1` reads a `T`
/// (D3).
pub fn check_core_a_compound_write_to_a_map_slot[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, target: ref Expr, span: ref Span) sync {
    match target {
        Expr::Index { base, index, .. } => {
            // Only where the read is nullable, which is only a map. Where the
            // container's type is not known, nothing is claimed.
            let read = check_core_expr(state, world, host, target, span)
            let nullable = match read {
                Ty::Nullable(_) => true,
                else => false,
            }
            if !nullable {
                return
            }
            let slot = f"{check_walked_written(base, world.words)}[{check_walked_written(index, world.words)}]"
            let notes: Vec[String] = ["A missing key is normal, not a bug, so this line has to say what a missing key counts as."]
            let help: String = f"Write it out with a fallback for a missing key: `{slot} = ({slot} ?? 0) + 1`."
            state.findings.push(check_refusal("NK1162", span, f"`{slot}` reads the map before writing it, and the key might not be there yet.", notes, help))
        }
        else => return,
    }
}

/// **A call that is an instantiation of a function the program walks the
/// fields of** (ADR-304): the type of its first argument decides the copy, and
/// the fields it is unrolled over are kept for the emitter.
pub fn check_core_an_instantiation[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, name: ref String, call: i64, args: ref Vec[Expr], span: ref Span) sync {
    if !state.walks_fields.contains_key(name) {
        return
    }
    if args.len() == 0 {
        return
    }
    // Walked with the walk switched off, because the argument is walked again
    // by the ordinary path and a message said twice is two problems to a reader.
    let before = state.findings.len()
    let given = check_core_expr(state, world, host, args[0], span)
    state.findings.truncate(before)
    // **A type of no shape is a copy too** (ADR-330 D2): a function that asks
    // `T::kind` or `T::name` is written once per type, with no field to walk.
    let named: String = match given {
        Ty::Named { name, .. } => name.clone(),
        else => "",
    }
    let mut on: String = named.clone()
    let mut fields: Vec[FieldContract] = []
    let shape: Vec[FieldContract]? = state.shape_of(world.here, world, named)
    let shaped = shape != null
    if shaped {
        fields = shape ?? []
    } else {
        // An unknown type is an integer literal's, else no copy is made.
        let literal = match args[0] {
            Expr::LitInt { .. } => true,
            else => false,
        }
        let unknown = match given {
            Ty::Unknown => true,
            else => false,
        }
        if unknown && !literal {
            return
        }
        on = check_reflect_written(given)
        if on == "" {
            return
        }
    }
    let mut kind = check_reflect_kind(state, check_reflect_plain(given))
    if shaped && kind == "Opaque" {
        kind = "Struct"
    }
    state.facts.type_kinds.insert(on.clone(), kind)
    state.facts.unrolled_calls.insert(call, check_specialised(name, on))
    state.facts.unrolled.insert((name.clone(), on.clone()), fields)
}

/// **`NK1131`: a `mut` parameter given away whole** (issue #161, Part I 6.6).
/// It is passed as `ref mut`, so the function borrows it as a method borrows
/// `ref self`, and giving it away is a field of a borrowed subject's shape one
/// position over.
pub fn check_core_a_mut_parameter_given_away[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, value: ref Expr, span: ref Span, what: ref String) sync {
    let name: String = match value {
        Expr::Variable(symbol, _) => world.words.resolve(symbol).clone(),
        else => return,
    }
    // `Local::changing`: a `let` of the same name is a binding of its own.
    let local = state.binding(name) ?? return
    if !local.changing {
        return
    }
    let ty = check_core_expr(state, world, host, value, span)
    // **A `mut` view handed back** (D26): the caller's view is changed in
    // place, and what is handed back would be a view of that view, which no
    // signature can name. The view is copied into a local first.
    if ty.is_a_view() && what == "handed back" {
        let notes: Vec[String] = [f"`mut {name}: {ty.text()}` changes the caller's view in place, so handing it back hands back a view of the caller's view.".clone()]
        let help: String = f"Take `{name}: {ty.text()}` without `mut`, and walk a local of its own: `let mut at = {name}`, then `return at`."
        state.findings.push(check_refusal("NK1131", span, f"You can't hand back `{name}` here: a `mut` parameter that is a view is only borrowed.", notes, help))
        return
    }
    if ty.is_unknown() || state.copied(world, ty) {
        return
    }
    let mut way: String = ""
    if what == "handed back" {
        way = " to return"
    }
    let notes: Vec[String] = [f"`mut {name}` is passed as `ref mut`, so the caller's `{ty.text()}` is changed in place and stays the caller's. Giving it away would take it from them."]
    let help: String = f"Write `{name}.clone()` for a copy{way}, or drop the `mut` if the function is meant to use up its value."
    state.findings.push(check_refusal("NK1131", span, f"You can't give away `{name}` here: a `mut` parameter is only borrowed.", notes, help))
}

/// `NK1282`: an entry handed neither text (a `String`, or a mapping, which is
/// checked text, ADR-016 D1) nor a `Bytes` (ADR-366 D1).
fn check_core_grammar_input_refused(key: ref String, given: ref Ty, span: ref Span) -> CheckFinding {
    let message = f"`{key}` parses a `String` or a `Bytes`, and is handed a `{given.text()}`."
    let notes: Vec[String] = ["A grammar reads text or bytes; the argument decides which."]
    let help: String = "Hand it the text or the bytes to parse."
    return check_refusal("NK1282", span, message, notes, help)
}

/// **The cases of `meta::Type` that carry no type** (ADR-330 D3): the ones a
/// path can name before a type can be passed as an argument (#859 step 2).
fn check_reflect_bare_kind(case: ref String) -> bool {
    return ["I64", "I32", "U8", "U64", "U32", "F64", "Bool", "Text", "Bytes", "Scalar"].contains(case)
}

/// **What `T::kind` is for a type** (ADR-330 D3, ADR-332 D1): the case of
/// `meta::Type` it takes. `ref A`, `Shared[A]` and `SharedMut[A]` have the kind
/// of `A`; what the program cannot see inside is `Opaque`.
pub fn check_reflect_kind(state: ref CheckState, ty: ref Ty) -> String {
    return match ty {
        Ty::Nullable(_) => "Maybe",
        Ty::Tuple(_) => "Tuple",
        Ty::Fn { .. } => "Fn",
        Ty::Named { name, args, .. } => check_reflect_named_kind(state, name, args),
        else => "Opaque",
    }
}

fn check_reflect_named_kind(state: ref CheckState, name: ref String, args: ref Vec[Ty]) -> String {
    if (name == "Shared" || name == "SharedMut") && args.len() == 1 {
        return check_reflect_kind(state, args[0])
    }
    if state.structs.contains_key(name) {
        return "Struct"
    }
    if state.enums.contains_key(name) {
        return "Enum"
    }
    return match name {
        "i64" => "I64",
        "i32" => "I32",
        "u8" => "U8",
        "u64" => "U64",
        "u32" => "U32",
        "f64" => "F64",
        "bool" => "Bool",
        "String" => "Text",
        "str" => "Text",
        "Bytes" => "Bytes",
        "scalar" => "Scalar",
        "Vec" => "List",
        "List" => "List",
        "HashMap" => "Map",
        "Array" => "Array",
        else => "Opaque",
    }
}

/// **The type a copy is made for, as the program writes it** (ADR-330 D2,
/// `T::name`): each name as its declaration writes it, without the module in
/// front; without the `ref` of a view, which is how it is reached and not what
/// it is (D8); an integer nothing else types is an `i64` (Part I 2.4).
fn check_reflect_plain(ty: ref Ty) -> Ty {
    return match ty {
        Ty::Named { name, args, .. } => {
            let mut plain: String = name.split("::").last()?.clone() ?? name.clone()
            if plain == "str" {
                plain = "String"
            }
            Ty::Named { name: plain, args: args.iter().map(fn(a) { check_reflect_plain(a) }).collect(), view: false }
        },
        Ty::Nullable(inner) => Ty::Nullable(check_reflect_plain(inner)),
        Ty::Tuple(parts) => Ty::Tuple(parts.iter().map(fn(a) { check_reflect_plain(a) }).collect()),
        Ty::Unknown => Ty::Named { name: "i64", args: [], view: false },
        else => ty.clone(),
    }
}

/// The text of [`check_reflect_plain`], `""` where the type is not known.
fn check_reflect_written(ty: ref Ty) -> String {
    return match ty {
        Ty::Var { .. } => "",
        else => check_reflect_plain(ty).text(),
    }
}

/// Whether `ty` names a type `::kind` and `::name` can be asked of: a type
/// parameter, a type the program declares, or one of the language's own.
fn check_reflect_a_type(state: ref CheckState, ty: ref String) -> bool {
    if state.type_parameters.contains_key(ty) || state.structs.contains_key(ty) || state.enums.contains_key(ty) {
        return true
    }
    return check_reflect_named_kind(state, ty, []) != "Opaque"
}

/// **The kind a side of a comparison names**, where it is one: the case of
/// `meta::Type::X`, `?` for a type parameter's (decided per copy), the case
/// of a named type's `X::kind` (kept for the emitter).
fn check_reflect_kind_of(mut state: CheckState, world: ref CheckWorld, side: ref Expr) -> String? sync {
    let segments = match side {
        Expr::Path(segments, _) => segments,
        else => return null,
    }
    if segments.len() == 3 {
        let case = world.words.resolve(segments[2])
        if world.words.resolve(segments[0]) == "meta" && world.words.resolve(segments[1]) == "Type" && check_reflect_bare_kind(case) {
            return case.clone()
        }
        return null
    }
    if segments.len() != 2 || world.words.resolve(segments[1]) != "kind" {
        return null
    }
    let ty = world.words.resolve(segments[0]).clone()
    if state.is_variant(ty, "kind") || !check_reflect_a_type(state, ty) {
        return null
    }
    if state.type_parameters.contains_key(ty) {
        return "?"
    }
    let kind = check_reflect_named_kind(state, ty, [])
    state.facts.type_kinds.insert(ty.clone(), kind.clone())
    return kind
}

/// **`T::kind == meta::Type::X`, decided while the program is built**
/// (ADR-330 D3, D6): both sides are kinds, and the comparison is a `bool` the
/// emitter writes per copy. `null` where it is not such a comparison.
pub fn check_reflect_compared(mut state: CheckState, world: ref CheckWorld, expr: ref Expr, op: BinaryOp, lhs: ref Expr, rhs: ref Expr) -> Ty? sync {
    let equality = match op {
        BinaryOp::Eq | BinaryOp::Ne => true,
        else => false,
    }
    if !equality {
        return null
    }
    let left = check_reflect_kind_of(state, world, lhs) ?? return null
    let right = check_reflect_kind_of(state, world, rhs) ?? return null
    if left == "" || right == "" {
        return null
    }
    state.facts.kind_compares.insert(id_of(expr) as i64)
    return Ty::Named { name: "bool", args: [], view: false }
}

/// **`T::name` and `T::kind` as a value** (ADR-330 D2, D6): the name is text
/// known while building; a kind anywhere but beside `==` would reach the
/// running program, `NK1231`. `null` where the path is not one of them.
pub fn check_reflect_path(mut state: CheckState, world: ref CheckWorld, expr: ref Expr, segments: ref Vec[winnow_grammar::Symbol], span: ref Span) -> Ty? sync {
    let meta = Ty::Named { name: "meta::Type", args: [], view: false }
    if segments.len() == 3 {
        if world.words.resolve(segments[0]) == "meta" && world.words.resolve(segments[1]) == "Type" && check_reflect_bare_kind(world.words.resolve(segments[2])) {
            state.a_kind_kept_at_run_time(f"meta::Type::{world.words.resolve(segments[2])}", span)
            return meta
        }
        return null
    }
    if segments.len() != 2 {
        return null
    }
    let ty = world.words.resolve(segments[0]).clone()
    let member = world.words.resolve(segments[1]).clone()
    if member != "kind" && member != "name" {
        return null
    }
    if state.is_variant(ty, member) || resolve_call(world, f"{ty}::{member}") != null || !check_reflect_a_type(state, ty) {
        return null
    }
    if member == "name" {
        state.facts.reflected_names.insert(id_of(expr) as i64)
        return Ty::Named { name: "str", args: [], view: true }
    }
    state.a_kind_kept_at_run_time(f"{ty}::kind", span)
    return meta
}
