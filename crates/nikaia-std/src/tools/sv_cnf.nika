// crates/nikaia-std/src/tools/sv_cnf.nika
//
// **Tseitin input** (ADR-270 D12, #1283 item 2): the Boolean structure of a
// `TermArena` query - its facts hold, its goal does not - put into clauses
// over atom literals, the query of `sv_proof.nika` the SAT core and the
// theory start from.
//
// * **Atoms** are `row <= 0` and `row < 0` over integer columns: `a <= b` is
//   `a - b <= 0`, `a < b` is `a - b < 0`, `a = b` the two `<=` both ways, and
//   `a != b` the two strict inequalities `a - b < 0 ∨ b - a < 0`. An atom is
//   kept once: a row whose first coefficient is negative is the negation of
//   the other relation on the negated row (`r <= 0` is `¬(-r < 0)`), so
//   `x <= y` and `y < x` are one atom and its negation. A row without
//   columns is decided on the spot. A row over a real variable
//   (`sv_cnf_sorted`, ADR-270 D27) keeps `row < 0` strict: no `+1`, no
//   rounding, only the exact division by the gcd of all its numbers.
// * **Clauses**: what holds at the top - a conjunction, a negated
//   disjunction - is split into its parts, a disjunction there is one
//   clause, and only a junction nested below a disjunction gets a
//   *definition*: a fresh atom `d <= 0` over a fresh column `def#k`, the
//   theory leaving it free, with clauses making it equivalent to the
//   junction (Tseitin: every model of the formula extends to one of the
//   clauses, and every model of the clauses is one of the formula).
// * **Constants** fold: a true part drops out of a conjunction and makes a
//   disjunction true, a false one the reverse; a literal and its negation in
//   one clause drop the clause; a false fact is the empty clause.
// * **Quotients** by a positive constant are read by `lg_linear` as the
//   fresh column `quot#place`, and their definitions (`lg_quotient`) join the
//   query as further facts.
//
// A literal while it is built is an `i64`: `-1` true, `-2` false, else the
// literal of `sv_proof.nika`.

use std::collections

/// A query in clauses: the log's query, the columns' names, and per atom
/// whether it is a definition (no theory atom).
pub struct SvCnf {
	pub query: SvQuery,
	pub names: Vec[String],
	pub definition: Vec[bool],
}

/// A junction while it is built: its literals, a conjunction or a
/// disjunction.
struct SvParts {
	conjunction: bool,
	lits: Vec[i64],
}

/// The encoding under way.
struct SvTseitin {
	atoms: Vec[SvAtom],
	definition: Vec[bool],
	clauses: Vec[Vec[u32]],
	vars: SvVars,
	/// Each atom by its text, for keeping it once.
	known: collections::BTreeMap[String, u32],
	/// The literal each junction node of the arena was given.
	defined: collections::BTreeMap[i64, i64],
	definitions: i64,
	/// The names of the real variables (ADR-270 D27).
	real_names: collections::BTreeSet[String],
}

/// The negation of a literal under way.
fn sv_cnf_not(l: i64) -> i64 {
	if l == -1 {
		return -2
	}
	if l == -2 {
		return -1
	}
	return if l % 2 == 0 { l + 1 } else { l - 1 }
}

/// The clauses of `facts` and of the negation of `goal`; `null` where a term
/// is outside linear integer arithmetic or a number leaves `i64` (`why`
/// says which).
fn sv_cnf(arena: ref TermArena, facts: ref Vec[i64], goal: i64, mut why: LgWhy) -> SvCnf? {
	let none: collections::BTreeSet[String] = collections::BTreeSet()
	return sv_cnf_sorted(arena, facts, goal, none, why)
}

/// `sv_cnf` where the variables named in `reals` are real (ADR-270 D27):
/// an atom over one of them keeps its strict relation, and the query
/// records their columns.
fn sv_cnf_sorted(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	reals: ref collections::BTreeSet[String],
	mut why: LgWhy,
) -> SvCnf? {
	let mut t = SvTseitin {
		atoms: [],
		definition: [],
		clauses: [],
		vars: sv_vars(),
		known: collections::BTreeMap(),
		defined: collections::BTreeMap(),
		definitions: 0,
		real_names: reals.clone(),
	}
	for fact in facts {
		t.assert(arena, fact, true, why) ?? return null
	}
	t.assert(arena, goal, false, why) ?? return null
	// Each quotient read, defined - a definition may read a further one.
	let mut at = 0
	while at < why.quotients.len() {
		let formula = lg_quotient(arena, why.quotients[at], why) ?? return null
		t.assert_formula(formula) ?? return null
		at += 1
	}
	let columns = t.vars.names.len().checked_u32() ?? return null
	let mut real_cols: Vec[u32] = []
	let mut c: u32 = 0
	while c < columns {
		if t.real_names.contains(t.vars.names[c as i64]) {
			real_cols.push(c)
		}
		c += 1
	}
	return SvCnf {
		query: SvQuery { atoms: t.atoms, clauses: t.clauses, columns: columns, reals: real_cols },
		names: t.vars.names,
		definition: t.definition,
	}
}

impl SvTseitin {
	/// The literal of `row < 0` (`strict`) or `row <= 0`, the atom made where
	/// it is new. Over the integers every atom is `row <= 0` in normal form:
	/// `row < 0` is `row + 1 <= 0`, the row divided by the gcd of its
	/// coefficients (`sv_row_tightened`), and a row whose first coefficient is
	/// negative the negation of `-row < 0` - so `x <= y` and `y < x` are one
	/// atom (the normal form of ADR-270 D19).
	fn atom(ref mut self, row: SvRow, strict: bool) -> i64? {
		if row.cols.len() == 0 {
			let holds = if strict { row.constant < 0 } else { row.constant <= 0 }
			return if holds { -1 } else { -2 }
		}
		if row.ks[0] < 0 {
			let negated = sv_row_scale(row, -1) ?? return null
			let other = self.atom(negated, !strict) ?? return null
			return sv_cnf_not(other)
		}
		if self.real(row) {
			return self.real_atom(row, strict)
		}
		let mut le = row
		if strict {
			le.constant = le.constant.checked_add(1) ?? return null
		}
		let normal = sv_row_tightened(le)
		let key = sv_row_text(normal)
		// The default bound first: #1297.
		let missing: u32 = 4294967295
		let known: u32 = self.known.get(key) ?? missing
		if known != missing {
			return sv_lit(known, false) as i64
		}
		let a = self.atoms.len().checked_u32() ?? return null
		self.atoms.push(SvAtom { row: normal, rel: SvRel::Le })
		self.definition.push(false)
		self.known.insert(key, a)
		return sv_lit(a, false) as i64
	}

	/// Whether `row` mentions a real variable.
	fn real(ref self, row: ref SvRow) -> bool {
		if self.real_names.len() == 0 {
			return false
		}
		for c in row.cols {
			if self.real_names.contains(self.vars.names[c as i64]) {
				return true
			}
		}
		return false
	}

	/// The literal of `row < 0` (`strict`) or `row <= 0` over a real
	/// variable, its first coefficient positive: no `+1` and no rounding
	/// (ADR-270 D19, D27), the row only divided exactly by the gcd of its
	/// coefficients and its constant.
	fn real_atom(ref mut self, row: SvRow, strict: bool) -> i64? {
		let normal = sv_row_reduced(row)
		let rel = if strict { SvRel::Lt } else { SvRel::Le }
		let key = f"{sv_row_text(normal)} {sv_rel_text(rel)}"
		let missing: u32 = 4294967295
		let known: u32 = self.known.get(key) ?? missing
		if known != missing {
			return sv_lit(known, false) as i64
		}
		let a = self.atoms.len().checked_u32() ?? return null
		self.atoms.push(SvAtom { row: normal, rel: rel })
		self.definition.push(false)
		self.known.insert(key, a)
		return sv_lit(a, false) as i64
	}

	/// `x - y`, as a row, where `x` and `y` are the terms `a` and `b`.
	fn difference(ref mut self, arena: ref TermArena, a: i64, b: i64, mut why: LgWhy) -> SvRow? {
		let x = lg_linear(arena, a, why) ?? return null
		let y = lg_linear(arena, b, why) ?? return null
		let d = lg_overflowed(lg_sub(x, y), why) ?? return null
		return sv_cnf_overflowed_row(sv_row_of_lin(d, self.vars), why)
	}

	/// The parts of the Boolean term `id` where it holds; `null` where it is
	/// no junction or comparison (a constant or a negation).
	fn parts(ref mut self, arena: ref TermArena, id: i64, mut why: LgWhy) -> SvParts? {
		return match arena.at(id) {
			SolverTerm::And(items) => SvParts {
				conjunction: true,
				lits: self.lits(arena, items, why) ?? return null,
			},
			SolverTerm::Or(items) => SvParts {
				conjunction: false,
				lits: self.lits(arena, items, why) ?? return null,
			},
			SolverTerm::Le(a, b) => {
				let d = self.difference(arena, a, b, why) ?? return null
				self.single(d, false) ?? return sv_cnf_overflow_parts(why)
			},
			SolverTerm::Lt(a, b) => {
				let d = self.difference(arena, a, b, why) ?? return null
				self.single(d, true) ?? return sv_cnf_overflow_parts(why)
			},
			SolverTerm::Ge(a, b) => {
				let d = self.difference(arena, b, a, why) ?? return null
				self.single(d, false) ?? return sv_cnf_overflow_parts(why)
			},
			SolverTerm::Gt(a, b) => {
				let d = self.difference(arena, b, a, why) ?? return null
				self.single(d, true) ?? return sv_cnf_overflow_parts(why)
			},
			SolverTerm::Eq(a, b) => {
				let d = self.difference(arena, a, b, why) ?? return null
				let e = sv_row_scale(d, -1) ?? return sv_cnf_overflow_parts(why)
				let x = self.atom(d, false) ?? return sv_cnf_overflow_parts(why)
				let y = self.atom(e, false) ?? return sv_cnf_overflow_parts(why)
				SvParts { conjunction: true, lits: [x, y] }
			},
			SolverTerm::Ne(a, b) => {
				let d = self.difference(arena, a, b, why) ?? return null
				let e = sv_row_scale(d, -1) ?? return sv_cnf_overflow_parts(why)
				let x = self.atom(d, true) ?? return sv_cnf_overflow_parts(why)
				let y = self.atom(e, true) ?? return sv_cnf_overflow_parts(why)
				SvParts { conjunction: false, lits: [x, y] }
			},
			else => {
				why.unknown = LgUnknown::OutsideTheTheory
				null
			},
		}
	}

	/// The one atom `row REL 0` as a conjunction of it.
	fn single(ref mut self, row: SvRow, strict: bool) -> SvParts? {
		let l = self.atom(row, strict) ?? return null
		return SvParts { conjunction: true, lits: [l] }
	}

	/// The literal of each of `items`, where it holds.
	fn lits(ref mut self, arena: ref TermArena, items: ref Vec[i64], mut why: LgWhy) -> Vec[i64]? {
		let mut out: Vec[i64] = []
		for item in items {
			out.push(self.lit(arena, item, why) ?? return null)
		}
		return out
	}

	/// The literal of the Boolean term `id` where it holds.
	fn lit(ref mut self, arena: ref TermArena, id: i64, mut why: LgWhy) -> i64? {
		let node = arena.at(id)
		match node {
			SolverTerm::Bool(b) => return if b { -1 } else { -2 },
			SolverTerm::Not(a) => {
				let inner = self.lit(arena, a, why) ?? return null
				return sv_cnf_not(inner)
			},
			else => {},
		}
		let made: i64 = self.defined.get(id) ?? -3
		if made != -3 {
			return made
		}
		let parts = self.parts(arena, id, why) ?? return null
		let l = self.junction(parts) ?? return sv_cnf_overflow_lit(why)
		self.defined.insert(id, l)
		return l
	}

	/// The literal of a junction: a constant or a single literal as it is,
	/// else a definition.
	fn junction(ref mut self, parts: SvParts) -> i64? {
		// A conjunction is the negation of the disjunction of the negations.
		let mut lits: Vec[i64] = []
		for l in parts.lits {
			lits.push(if parts.conjunction { sv_cnf_not(l) } else { l })
		}
		let clause = sv_cnf_clause(lits)
		let either: Vec[u32] = clause ?? return if parts.conjunction { -2 } else { -1 }
		if either.len() == 0 {
			return if parts.conjunction { -1 } else { -2 }
		}
		if either.len() == 1 {
			let l = either[0] as i64
			return if parts.conjunction { sv_cnf_not(l) } else { l }
		}
		// `d ↔ ∨ either`: `¬d ∨ either`, and `d ∨ ¬e` for each `e`.
		let col = self.vars.column(f"def#{self.definitions}") ?? return null
		self.definitions += 1
		let a = self.atoms.len().checked_u32() ?? return null
		self.atoms.push(SvAtom { row: SvRow { cols: [col], ks: [1], constant: 0 }, rel: SvRel::Le })
		self.definition.push(true)
		let d = sv_lit(a, false)
		let mut long = either.clone()
		long.push(d ^ 1)
		long.sort()
		self.clauses.push(long)
		for e in either {
			let mut short = [d, e ^ 1]
			short.sort()
			self.clauses.push(short)
		}
		let dl = d as i64
		return if parts.conjunction { sv_cnf_not(dl) } else { dl }
	}

	/// Adds the clauses saying the Boolean term `id` holds (or, where
	/// `holds` is false, does not).
	fn assert(ref mut self, arena: ref TermArena, id: i64, holds: bool, mut why: LgWhy) -> bool? {
		match arena.at(id) {
			SolverTerm::Bool(b) => {
				if b != holds {
					self.clauses.push([])
				}
				return true
			},
			SolverTerm::Not(a) => return self.assert(arena, a, !holds, why),
			SolverTerm::And(items) => {
				if holds {
					for item in items {
						self.assert(arena, item, true, why) ?? return null
					}
					return true
				}
			},
			SolverTerm::Or(items) => {
				if !holds {
					for item in items {
						self.assert(arena, item, false, why) ?? return null
					}
					return true
				}
			},
			else => {},
		}
		let parts = self.parts(arena, id, why) ?? return null
		self.add(parts, holds)
		return true
	}

	/// Adds the clauses of a junction that holds (or, where `holds` is
	/// false, does not).
	fn add(ref mut self, parts: SvParts, holds: bool) {
		let mut lits: Vec[i64] = []
		for l in parts.lits {
			lits.push(if holds { l } else { sv_cnf_not(l) })
		}
		if parts.conjunction == holds {
			for l in lits {
				self.unit(l)
			}
			return
		}
		let clause: Vec[u32] = sv_cnf_clause(lits) ?? return
		self.clauses.push(clause)
	}

	/// Adds the clause of the one literal `l`.
	fn unit(ref mut self, l: i64) {
		if l == -1 {
			return
		}
		if l == -2 {
			self.clauses.push([])
			return
		}
		self.clauses.push([l as u32])
	}

	/// Adds the clauses of a formula of `logic_lia.nika` that holds.
	fn assert_formula(ref mut self, formula: LgFormula) -> bool? {
		match formula {
			LgFormula::And(items) => {
				for item in items {
					self.assert_formula(item) ?? return null
				}
			},
			else => {
				let l = self.formula_lit(formula) ?? return null
				let parts = SvParts { conjunction: true, lits: [l] }
				self.add(parts, true)
			},
		}
		return true
	}

	/// The literal of a formula of `logic_lia.nika`.
	fn formula_lit(ref mut self, formula: LgFormula) -> i64? {
		return match formula {
			LgFormula::True => -1,
			LgFormula::False => -2,
			LgFormula::Le(lin) => {
				let row = sv_row_of_lin(lin, self.vars) ?? return null
				self.atom(row, false) ?? return null
			},
			LgFormula::And(items) => {
				let mut lits: Vec[i64] = []
				for item in items {
					lits.push(self.formula_lit(item) ?? return null)
				}
				self.junction(SvParts { conjunction: true, lits: lits }) ?? return null
			},
			LgFormula::Or(items) => {
				let mut lits: Vec[i64] = []
				for item in items {
					lits.push(self.formula_lit(item) ?? return null)
				}
				self.junction(SvParts { conjunction: false, lits: lits }) ?? return null
			},
		}
	}
}

/// The clause of the literals `lits`, ascending and each once; `null` where
/// it is true (a true literal, or a literal and its negation).
fn sv_cnf_clause(lits: Vec[i64]) -> Vec[u32]? {
	let mut out: Vec[u32] = []
	for l in lits {
		if l == -1 {
			return null
		}
		if l >= 0 {
			out.push(l as u32)
		}
	}
	out.sort()
	let mut kept: Vec[u32] = []
	for l in out {
		let n = kept.len()
		if n > 0 && kept[n - 1] == l {
			continue
		}
		if n > 0 && kept[n - 1] == (l ^ 1) {
			return null
		}
		kept.push(l)
	}
	return kept
}

/// `made`, or the overflow it is.
fn sv_cnf_overflowed_row(made: SvRow?, mut why: LgWhy) -> SvRow? {
	if made == null {
		why.unknown = LgUnknown::Overflow
	}
	return made
}

fn sv_cnf_overflow_parts(mut why: LgWhy) -> SvParts? {
	why.unknown = LgUnknown::Overflow
	return null
}

fn sv_cnf_overflow_lit(mut why: LgWhy) -> i64? {
	why.unknown = LgUnknown::Overflow
	return null
}

// --- Tests: the Tseitin input against the formula (moved from
// `tests/compiler/tests/solver_cnf.nika`, which compiled these files anew in a
// program of its own on every run) ---

fn sv_cnf_test_int(arena: ref TermArena, id: i64, env: ref collections::BTreeMap[String, i64]) -> i64 {
	return match arena.at(id) {
		SolverTerm::Int(n) => n,
		SolverTerm::Var(name) => env.get(name) ?? 0,
		SolverTerm::Add(a, b) => sv_cnf_test_int(arena, a, env) + sv_cnf_test_int(arena, b, env),
		SolverTerm::Sub(a, b) => sv_cnf_test_int(arena, a, env) - sv_cnf_test_int(arena, b, env),
		SolverTerm::Neg(a) => -sv_cnf_test_int(arena, a, env),
		SolverTerm::Mul(a, b) => sv_cnf_test_int(arena, a, env) * sv_cnf_test_int(arena, b, env),
		SolverTerm::Quot(a, k) => sv_cnf_test_int(arena, a, env) / k,
		else => 0,
	}
}

fn sv_cnf_test_bool(arena: ref TermArena, id: i64, env: ref collections::BTreeMap[String, i64]) -> bool {
	return match arena.at(id) {
		SolverTerm::Bool(b) => b,
		SolverTerm::Not(a) => !sv_cnf_test_bool(arena, a, env),
		SolverTerm::And(items) => {
			let mut all = true
			for item in items {
				all = all && sv_cnf_test_bool(arena, item, env)
			}
			all
		},
		SolverTerm::Or(items) => {
			let mut any = false
			for item in items {
				any = any || sv_cnf_test_bool(arena, item, env)
			}
			any
		},
		SolverTerm::Le(a, b) => sv_cnf_test_int(arena, a, env) <= sv_cnf_test_int(arena, b, env),
		SolverTerm::Lt(a, b) => sv_cnf_test_int(arena, a, env) < sv_cnf_test_int(arena, b, env),
		SolverTerm::Ge(a, b) => sv_cnf_test_int(arena, a, env) >= sv_cnf_test_int(arena, b, env),
		SolverTerm::Gt(a, b) => sv_cnf_test_int(arena, a, env) > sv_cnf_test_int(arena, b, env),
		SolverTerm::Eq(a, b) => sv_cnf_test_int(arena, a, env) == sv_cnf_test_int(arena, b, env),
		SolverTerm::Ne(a, b) => sv_cnf_test_int(arena, a, env) != sv_cnf_test_int(arena, b, env),
		else => false,
	}
}

// `2·x - y + 4` with the columns' names.
fn sv_cnf_test_row(r: ref SvRow, names: ref Vec[String]) -> String {
	let mut out = ""
	let mut i = 0
	while i < r.cols.len() {
		let k = r.ks[i]
		let name = names[r.cols[i] as i64].clone()
		let size = if k < 0 { -k } else { k }
		let sign = if k < 0 { if i == 0 { "-" } else { " - " } } else { if i == 0 { "" } else { " + " } }
		let factor = if size == 1 { "" } else { f"{size}·" }
		out = out + sign + factor + name
		i += 1
	}
	if r.constant > 0 {
		out = out + f" + {r.constant}"
	} else if r.constant < 0 {
		out = out + f" - {-r.constant}"
	}
	return out
}

fn sv_cnf_test_lit(l: u32) -> String {
	return if l % 2 == 0 { f"a{l / 2}" } else { f"-a{l / 2}" }
}

// Whether every clause holds where the columns have `values` and the
// definitions the bits of `bits`.
fn sv_cnf_test_holds(cnf: ref SvCnf, values: ref Vec[i64], bits: i64) -> bool {
	let mut truth: Vec[bool] = []
	let mut d = 0
	let mut a = 0
	while a < cnf.query.atoms.len() {
		if cnf.definition[a] {
			truth.push((bits / (1 << d)) % 2 == 1)
			d += 1
		} else {
			let atom = cnf.query.atoms[a].clone()
			let mut sum = atom.row.constant
			let mut i = 0
			while i < atom.row.cols.len() {
				sum += atom.row.ks[i] * values[atom.row.cols[i] as i64]
				i += 1
			}
			truth.push(match atom.rel {
				SvRel::Lt => sum < 0,
				else => sum <= 0,
			})
		}
		a += 1
	}
	for clause in cnf.query.clauses {
		let mut ok = false
		for l in clause {
			let t = truth[(l / 2) as i64]
			let positive = l % 2 == 0
			if positive == t {
				ok = true
			}
		}
		if !ok {
			return false
		}
	}
	return true
}

// Whether some value of the free columns (`free`, from `at` on, in -3..3)
// and of the definitions makes every clause hold.
fn sv_cnf_test_extends(cnf: ref SvCnf, mut values: Vec[i64], free: ref Vec[i64], at: i64) -> bool {
	if at == free.len() {
		let mut defs = 0
		for d in cnf.definition {
			if d {
				defs += 1
			}
		}
		let mut bits = 0
		while bits < (1 << defs) {
			if sv_cnf_test_holds(cnf, values, bits) {
				return true
			}
			bits += 1
		}
		return false
	}
	let mut v = -3
	while v <= 3 {
		values[free[at]] = v
		if sv_cnf_test_extends(cnf, values, free, at + 1) {
			return true
		}
		v += 1
	}
	return false
}

// The clauses of `facts` and not `goal`, as lines, and held against the
// formula on every value of its variables in -2..2.
fn sv_cnf_test_show(name: String, arena: ref TermArena, facts: Vec[i64], goal: i64) -> String {
	let mut out = f"{name}\n"
	let mut why = lg_why()
	let made = sv_cnf(arena, facts, goal, why)
	let cnf = made ?? {
		let reason = match why.unknown {
			LgUnknown::OutsideTheTheory => "outside the theory",
			LgUnknown::Overflow => "overflow",
			else => "unknown",
		}
		return out + f"  refused: {reason}\n"
	}
	let mut a = 0
	while a < cnf.query.atoms.len() {
		let atom = cnf.query.atoms[a].clone()
		if cnf.definition[a] {
			out = out + f"  a{a}: definition {sv_cnf_test_row(atom.row, cnf.names)} <= 0\n"
		} else {
			let rel = match atom.rel {
				SvRel::Lt => "<",
				SvRel::Le => "<=",
				SvRel::Eq => "=",
			}
			out = out + f"  a{a}: {sv_cnf_test_row(atom.row, cnf.names)} {rel} 0\n"
		}
		a += 1
	}
	let mut texts: Vec[String] = []
	for clause in cnf.query.clauses {
		let mut parts: Vec[String] = []
		for l in clause {
			parts.push(sv_cnf_test_lit(l))
		}
		texts.push(f"[{parts.join(" ")}]")
	}
	out = out + f"  clauses: {texts.join(" ")}\n"
	// The variables of the formula, the free columns and their places.
	let mut vars: Vec[i64] = []
	let mut free: Vec[i64] = []
	let mut c = 0
	while c < cnf.names.len() {
		let n = cnf.names[c].clone()
		if n.starts_with("quot#") {
			free.push(c)
		} else if !n.starts_with("def#") {
			vars.push(c)
		}
		c += 1
	}
	let mut total = 1
	for _ in vars {
		total = total * 5
	}
	let mut agree = 0
	let mut models = 0
	let mut code = 0
	while code < total {
		let mut values: Vec[i64] = []
		for _ in cnf.names {
			values.push(0)
		}
		let mut env: collections::BTreeMap[String, i64] = collections::BTreeMap()
		let mut rest = code
		for v in vars {
			values[v] = rest % 5 - 2
			env.insert(cnf.names[v].clone(), rest % 5 - 2)
			rest = rest / 5
		}
		let mut formula = !sv_cnf_test_bool(arena, goal, env)
		for f in facts {
			formula = formula && sv_cnf_test_bool(arena, f, env)
		}
		if formula {
			models += 1
		}
		if formula == sv_cnf_test_extends(cnf, values, free, 0) {
			agree += 1
		}
		code += 1
	}
	return out + f"  agree on {agree} of {total} values; the formula holds on {models}\n"
}

test "the clauses of a query agree with its formula on every small value" {
	let mut t = TermArena::empty()
	let x = t.var("x")
	let y = t.var("y")
	let z = t.var("z")
	let zero = t.int(0)
	let one = t.int(1)
	let two = t.int(2)
	let no = t.boolean(false)
	let yes = t.boolean(true)
	let mut out: String = ""

	let y1 = t.add(y, one)
	let lt = t.lt(x, y)
	let eq = t.equal(x, y1)
	let not_eq = t.not(eq)
	let first = t.or([lt, not_eq])
	out = out + sv_cnf_test_show("x < y or not x = y + 1", t, [first], no)

	let ne = t.unequal(x, y)
	out = out + sv_cnf_test_show("x != y", t, [ne], no)
	let not_ne = t.not(ne)
	out = out + sv_cnf_test_show("not x != y", t, [not_ne], no)

	let x0 = t.le(x, zero)
	let y0 = t.le(y, zero)
	let both = t.and([x0, y0])
	let x2 = t.ge(x, two)
	let y_lt = t.lt(y, one)
	let not_y = t.not(y_lt)
	let other = t.and([x2, not_y])
	let z1 = t.equal(z, one)
	let nested = t.or([both, other, z1])
	out = out + sv_cnf_test_show("x <= 0 and y <= 0, or x >= 2 and not y < 1, or z = 1", t, [nested], no)

	let le = t.le(x, y)
	let gt = t.lt(y, x)
	out = out + sv_cnf_test_show("x <= y, y < x: one atom", t, [le, gt], no)

	let gz = t.gt(x, zero)
	let inner = t.or([no, gz])
	let folded = t.and([yes, inner])
	out = out + sv_cnf_test_show("true and (false or x > 0)", t, [folded], no)
	let xx = t.sub(x, x)
	let minus = t.int(-1)
	let never = t.le(xx, minus)
	out = out + sv_cnf_test_show("x - x <= -1", t, [never], no)

	let q = t.quot(x, 2)
	let q1 = t.ge(q, one)
	out = out + sv_cnf_test_show("x / 2 >= 1", t, [q1], no)

	let nonneg = t.ge(x, zero)
	let pos = t.gt(x, zero)
	let is0 = t.equal(x, zero)
	let goal = t.or([pos, is0])
	out = out + sv_cnf_test_show("x >= 0, goal x > 0 or x = 0", t, [nonneg], goal)

	let xy = t.mul(x, y)
	let product = t.le(xy, one)
	out = out + sv_cnf_test_show("x * y <= 1", t, [product], no)

	let expected = [
		"x < y or not x = y + 1",
		"  a0: x - y + 1 <= 0",
		"  a1: x - y - 1 <= 0",
		"  a2: x - y <= 0",
		"  a3: definition def#0 <= 0",
		"  clauses: [-a1 a2 -a3] [a1 a3] [-a2 a3] [a0 a3]",
		"  agree on 25 of 25 values; the formula holds on 21",
		"x != y",
		"  a0: x - y + 1 <= 0",
		"  a1: x - y <= 0",
		"  clauses: [a0 -a1]",
		"  agree on 25 of 25 values; the formula holds on 20",
		"not x != y",
		"  a0: x - y + 1 <= 0",
		"  a1: x - y <= 0",
		"  clauses: [-a0] [a1]",
		"  agree on 25 of 25 values; the formula holds on 5",
		"x <= 0 and y <= 0, or x >= 2 and not y < 1, or z = 1",
		"  a0: x <= 0",
		"  a1: y <= 0",
		"  a2: definition def#0 <= 0",
		"  a3: x - 1 <= 0",
		"  a4: definition def#1 <= 0",
		"  a5: z - 1 <= 0",
		"  a6: z <= 0",
		"  a7: definition def#2 <= 0",
		"  clauses: [-a0 -a1 -a2] [a0 a2] [a1 a2] [a1 a3 -a4] [-a1 a4] [-a3 a4] [-a5 a6 -a7] [a5 a7] [-a6 a7] [-a2 -a4 -a7]",
		"  agree on 125 of 125 values; the formula holds on 69",
		"x <= y, y < x: one atom",
		"  a0: x - y <= 0",
		"  clauses: [a0] [-a0]",
		"  agree on 25 of 25 values; the formula holds on 0",
		"true and (false or x > 0)",
		"  a0: x <= 0",
		"  clauses: [-a0]",
		"  agree on 5 of 5 values; the formula holds on 2",
		"x - x <= -1",
		"  clauses: []",
		"  agree on 1 of 1 values; the formula holds on 0",
		"x / 2 >= 1",
		"  a0: quot#32 <= 0",
		"  a1: x + 1 <= 0",
		"  a2: 2·quot#32 - x <= 0",
		"  a3: 2·quot#32 - x + 2 <= 0",
		"  a4: definition def#0 <= 0",
		"  a5: definition def#1 <= 0",
		"  a6: 2·quot#32 - x + 1 <= 0",
		"  a7: 2·quot#32 - x - 1 <= 0",
		"  a8: definition def#2 <= 0",
		"  a9: definition def#3 <= 0",
		"  clauses: [-a0] [-a2 a3 -a4] [a2 a4] [-a3 a4] [a1 -a4 -a5] [-a1 a5] [a4 a5] [a5] [a6 -a7 -a8] [-a6 a8] [a7 a8] [-a1 -a8 -a9] [a1 a9] [a8 a9] [a9]",
		"  agree on 5 of 5 values; the formula holds on 1",
		"x >= 0, goal x > 0 or x = 0",
		"  a0: x + 1 <= 0",
		"  a1: x <= 0",
		"  clauses: [-a0] [a1] [a0 -a1]",
		"  agree on 5 of 5 values; the formula holds on 0",
		"x * y <= 1",
		"  refused: outside the theory",
	]
	assert(out == expected.join("\n") + "\n")
}

/// The clauses of `x <= y, y < x` to the SAT core: refuted by their Boolean
/// structure alone, and the refutation's log is one `sv_check` accepts.
test "a query refuted by its clauses alone is unsat and its log checks" {
	let mut t = TermArena::empty()
	let x = t.var("x")
	let y = t.var("y")
	let no = t.boolean(false)
	let le = t.le(x, y)
	let gt = t.lt(y, x)
	let mut why = lg_why()
	let made = sv_cnf(t, [le, gt], no, why)
	assert(made != null)
	let cnf = made ?? return
	let mut s = sv_sat_of(cnf.query) ?? {
		assert(false)
		return
	}
	let answer = s.solve(100)
	assert(answer == SvSatAnswer::Unsat)
	let v = sv_check(cnf.query, s.book.log.steps)
	assert(v.ok)
}
