// crates/nikaia-std/src/tools/maps.nika
//
// **The ledger key `maps`** (ADR-010 D9, Part III 13.5, #581 step 6), moved from
// the compiler's `contracts::maps` (ADR-294, #125): for a `pub` function with a
// map in its signature, which of those map positions are one map, and what its
// body puts into each - `from(p, ...)` (keys as trusted as the arguments
// named, `from()` for none) or `keyed`. The Rust module stays as the adapter:
// it hands over the parsed units and the two questions only the emitter's
// `Seeds` can answer (the key of a written type, the arity of a type name).
//
// **A permission key, so every doubt is `keyed`.** A caller reads the line and
// never the body. A wrong `from(..)` lets a caller give the fixed seed to a map
// the body fills with keys an adversary chose, so the body is read in a few
// shapes only and everything else is `keyed`:
//
//   * a map is read (`len`, `get`, `keys`, ...), filled by `m[k] = v` or
//     `m.insert(k, ..)`, returned, or put in the struct the function returns;
//   * a key is a literal, a parameter, or built from those with a method that
//     only reshapes it (`clone`, `trim`, ...); a `let` or a `for` binding
//     carries what it is made of.
//
// Anything else - a map handed to a call, kept in a `let`, compared with
// something unseen, a key from a call or from a name nothing explains, a
// `match`, a closure - makes **every** map of the function `keyed`, and its
// positions are then grouped by the type written.
//
// **Positions, groups, hidden parameters.** A position is one place a map type
// is written in the signature: a parameter, a map field of a `pub` struct a
// parameter has (`t.counts`), or the result likewise. A `pub` type declares one
// hidden parameter per position. A `pub` function declares one per **group of
// positions its body joins** (a map assigned to another, compared, returned
// from a parameter): the `|` in a line. Where the body is not read exactly, the
// positions of one written type are one group.

use std::collections

fn mp_result() -> String {
    return "<result>".clone()
}

fn mp_self() -> String {
    return "self".clone()
}

/// The text of a name.
fn mp_text(words: ref winnow_grammar::InternerContext, s: winnow_grammar::Symbol) -> String {
    return words.resolve(s).clone()
}

/// The last segment of a `::` path.
fn mp_short(name: String) -> String {
    return (name.rsplit("::").next() ?? "").clone()
}

/// Methods that read a map and hand back something that is not a map.
fn mp_reads(name: String) -> bool {
    return match name {
        "len" | "is_empty" | "contains_key" | "contains" | "capacity" | "get" | "get_or" | "remove" | "clear" | "iter" | "keys" | "values" => true,
        else => false,
    }
}

/// Methods that put a key into a map.
fn mp_adds(name: String) -> bool {
    return match name {
        "insert" | "entry" | "extend" | "push" | "add" | "append" | "get_or_insert" => true,
        else => false,
    }
}

/// Methods that make a key from the keys of their receiver and arguments and
/// nothing else.
fn mp_shapes(name: String) -> bool {
    return match name {
        "clone" | "len" | "to_string" | "trim" | "trim_start" | "trim_end" | "to_lowercase" | "to_uppercase" | "as_str" | "abs" | "min" | "max" | "pow" => true,
        else => false,
    }
}

fn mp_is_map(name: String) -> bool {
    return match mp_short(name) {
        "HashMap" | "HashSet" | "TrustedMap" | "TrustedSet" => true,
        else => false,
    }
}

/// One map position of a signature.
struct MpPosition {
    /// The name it has in a line: `m`, `t.counts`, `<result>.counts`.
    label: String,
    /// The parameter it belongs to (`self`, a name, or `<result>`).
    owner: String,
    /// The way down from the parameter: `""`, `".counts"`.
    path: String,
    /// The written type it is in, for the grouping that needs no body.
    group: String,
    /// A position of the type of the `impl` a method is in: the ordinal among
    /// that type's own parameters.
    within: i64?,
}

/// A field of a struct.
/// The parsed units: the programs, and the words each one's names are
/// interned in.
pub struct MpHeld {
    pub units: ref Vec[ref Program],
    pub words: ref Vec[ref winnow_grammar::InternerContext],
}

struct MpField {
    name: String,
    ty: Type,
}

/// A struct: the file it is in and its fields.
struct MpStruct {
    unit: i64,
    fields: Vec[MpField],
}

/// The structs of the units, by name.
fn mp_structs(held: ref MpHeld) -> collections::BTreeMap[String, MpStruct] {
    let mut by_name: collections::BTreeMap[String, MpStruct] = collections::BTreeMap()
    for u in 0..<held.units.len() {
        for item in held.units[u].items {
            match item.node {
                Item::Struct { name, fields, .. } => {
                    let mut own: Vec[MpField] = []
                    for f in fields {
                        own.push(MpField { name: held.words[u].resolve(f.name).clone(), ty: f.ty.clone() })
                    }
                    by_name.insert(held.words[u].resolve(name).clone(), MpStruct { unit: u, fields: own })
                },
                else => {},
            }
        }
    }
    return by_name
}

/// The state of the walk down the types of a signature.
struct MpGather {
    /// The type of the `impl` the method is in (empty for none).
    target: String,
    /// A map holds another one: the positions are not independent lines.
    nested: bool,
    /// The counters of the mentions of the `impl`'s own type: the ordinal of
    /// the next position among that type's parameters, one per mention.
    counters: Vec[i64],
}

/// Where a walk down a type is: the name it prints, the parameter, the struct
/// mention a field position belongs to, the way down.
struct MpAt {
    owner: String,
    label: String,
    scope: String,
    path: String,
    /// Inside a mention of the `impl`'s own type: the counter, else -1.
    within: i64,
}

fn mp_ordinal(mut g: MpGather, at: ref MpAt) -> i64? {
    if at.within < 0 {
        return null
    }
    let n = g.counters[at.within]
    g.counters[at.within] = n + 1
    return n
}

fn mp_of(mut g: MpGather, held: ref MpHeld, structs: ref collections::BTreeMap[String, MpStruct], key: fn(i64, ref Type) -> String sync, arity: fn(ref String) -> i64 sync, unit: i64, ty: ref Type, at: ref MpAt, mut out: Vec[MpPosition], depth: i64) {
    if ty.code != null || depth > 6 {
        return
    }
    let name = held.words[unit].resolve(ty.name).clone()
    if !ty.is_tuple && mp_is_map(name) {
        let seed = key(unit, ty)
        let within = mp_ordinal(g, at)
        out.push(MpPosition { label: at.label.clone(), owner: at.owner.clone(), path: at.path.clone(), group: f"{at.scope}|{seed}|{at.path}", within: within })
        let before = out.len()
        for generic in ty.generics {
            mp_of(g, held, structs, key, arity, unit, generic, at, out, depth + 1)
        }
        if out.len() > before {
            g.nested = true
        }
        return
    }
    let short = mp_short(name)
    if !ty.is_tuple && arity(name) > 0 {
        let found = structs[short]
        if found != null {
            let st = found ?? return
            let scope_here = if at.scope.is_empty() { key(unit, ty) } else { at.scope.clone() }
            // A mention of the `impl`'s own type starts counting from the
            // type's first parameter.
            let enters = g.target == short && at.within < 0
            let mut within = at.within
            if enters {
                g.counters.push(0)
                within = g.counters.len() - 1
            }
            for field in st.fields {
                let inner = MpAt { owner: at.owner.clone(), label: f"{at.label}.{field.name}", scope: scope_here.clone(), path: f"{at.path}.{field.name}", within: within }
                mp_of(g, held, structs, key, arity, st.unit, field.ty, inner, out, depth + 1)
            }
        }
    }
    for generic in ty.generics {
        mp_of(g, held, structs, key, arity, unit, generic, at, out, depth + 1)
    }
}

/// What a key is made of: names, or nothing a caller can vouch for.
struct MpDep {
    unknown: bool,
    names: collections::BTreeSet[String],
}

fn mp_nothing() -> MpDep {
    return MpDep { unknown: false, names: collections::BTreeSet() }
}

fn mp_unknown() -> MpDep {
    return MpDep { unknown: true, names: collections::BTreeSet() }
}

fn mp_named(name: String) -> MpDep {
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    names.insert(name)
    return MpDep { unknown: false, names: names }
}

fn mp_join(one: ref MpDep, other: ref MpDep) -> MpDep {
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    for n in one.names {
        names.insert(n.clone())
    }
    for n in other.names {
        names.insert(n.clone())
    }
    return MpDep { unknown: one.unknown || other.unknown, names: names }
}

/// What a place written in the body is.
enum MpRes {
    /// Exactly one map position.
    Map(i64),
    /// A struct or a collection that holds some: not a map itself.
    Part,
    /// Neither: any other value.
    Not,
}

struct MpBody {
    /// The words the unit's names are made of.
    words: ref winnow_grammar::InternerContext,
    /// The parameters, by name.
    params: collections::BTreeSet[String],
    /// The maps a name holds: the way down to each, and its root. A parameter
    /// has one per position, a local made with `HashMap()` one.
    roots: collections::BTreeMap[String, Vec[(String, i64)]],
    /// The name each root has in a key's dependencies (a parameter's), empty for none.
    root_name: Vec[String],
    parent: Vec[i64],
    adds: Vec[MpDep],
    /// Everything keyed: a shape this does not read.
    all_keyed: bool,
    /// What each local name is made of, joined over every place it is set.
    locals: collections::BTreeMap[String, MpDep],
    /// The roots of the result, with their way down.
    result: Vec[(String, i64)],
}

impl MpBody {
    fn find(ref mut self, start: i64) -> i64 {
        let mut at = start
        while self.parent[at] != at {
            let up = self.parent[at]
            self.parent[at] = self.parent[up]
            at = self.parent[at]
        }
        return at
    }

    fn union(ref mut self, a: i64, b: i64) {
        let one = self.find(a)
        let other = self.find(b)
        if one != other {
            self.parent[one] = other
        }
    }

    fn new_root(ref mut self, name: String) -> i64 {
        let id = self.parent.len()
        self.parent.push(id)
        self.adds.push(mp_nothing())
        self.root_name.push(name)
        return id
    }

    fn doubt(ref mut self) {
        self.all_keyed = true
    }

    fn add(ref mut self, root: i64, dep: ref MpDep) {
        let joined = mp_join(self.adds[root], dep)
        self.adds[root] = joined
    }

    /// The variable and the way down of a chain of fields (an index on the way
    /// is the same position: a position is per type, not per element).
    fn locate(ref mut self, e: ref Expr) -> (String, String)? {
        match e {
            Expr::Variable(n, _) => {
                return (mp_text(self.words, n), "".clone())
            },
            Expr::Field { base, name, .. } => {
                let (var, path) = self.locate(base) ?? return null
                return (var, f"{path}.{mp_text(self.words, name)}")
            },
            Expr::Index { base, index, .. } => {
                let found = self.locate(base)
                if found == null {
                    return null
                }
                self.expr(index)
                return found
            },
            else => return null,
        }
    }

    /// What a place is, without the keys an index adds.
    fn classify(ref mut self, e: ref Expr) -> MpRes {
        let (var, path) = self.locate(e) ?? return MpRes::Not
        let held = self.roots[var]?.clone() ?? return MpRes::Not
        for (p, id) in held {
            if p == path {
                return MpRes::Map(id)
            }
        }
        let below = f"{path}."
        let mut under = path.is_empty()
        for (p, _) in held {
            if p.starts_with(below) {
                under = true
            }
        }
        if under {
            return MpRes::Part
        }
        return MpRes::Not
    }

    /// The map a place names, with the keys it reads on the way down.
    fn place(ref mut self, e: ref Expr) -> i64? {
        match e {
            Expr::Index { base, index, .. } => {
                let root = self.place(base) ?? return null
                let dep = self.deps(index)
                self.add(root, dep)
                self.expr(index)
                return root
            },
            Expr::Variable(..) => return self.place_named(e),
            Expr::Field { .. } => return self.place_named(e),
            else => return null,
        }
    }

    fn place_named(ref mut self, e: ref Expr) -> i64? {
        return match self.classify(e) {
            MpRes::Map(id) => id,
            else => null,
        }
    }

    /// The roots a value-place stands for, in position order.
    fn roots_of(ref mut self, e: ref Expr) -> Vec[i64]? {
        let (var, path) = self.locate(e) ?? return null
        let held = self.roots[var]?.clone() ?? return null
        let below = f"{path}."
        let mut found: Vec[i64] = []
        for (p, id) in held {
            if p == path || p.starts_with(below) {
                found.push(id)
            }
        }
        if found.is_empty() {
            return null
        }
        return found
    }

    fn map_made(ref self, e: ref Expr) -> bool {
        match e {
            Expr::Call { func, args, .. } => {
                if !args.is_empty() {
                    return false
                }
                return match func {
                    Expr::Path(segments, _) => self.ends_in_a_map(segments),
                    Expr::Variable(one, _) => mp_made_name(self.words.resolve(one)),
                    else => false,
                }
            },
            else => return false,
        }
    }

    fn ends_in_a_map(ref self, segments: ref Vec[winnow_grammar::Symbol]) -> bool {
        if segments.is_empty() {
            return false
        }
        return mp_made_name(self.words.resolve(segments[segments.len() - 1]))
    }

    fn deps(ref self, e: ref Expr) -> MpDep {
        match e {
            Expr::LitInt { .. } => return mp_nothing(),
            Expr::LitStr { .. } => return mp_nothing(),
            Expr::LitChar(..) => return mp_nothing(),
            Expr::LitBool(..) => return mp_nothing(),
            Expr::LitFloat(..) => return mp_nothing(),
            Expr::LitNull(_) => return mp_nothing(),
            Expr::Variable(n, _) => {
                let name = mp_text(self.words, n)
                if self.params.contains(name) || self.locals.contains_key(name) {
                    return mp_named(name)
                }
                return mp_unknown()
            },
            Expr::Field { base, .. } => return self.deps(base),
            Expr::SafeField { base, .. } => return self.deps(base),
            Expr::Index { base, index, .. } => return mp_join(self.deps(base), self.deps(index)),
            Expr::MethodCall { receiver, method, args, .. } => {
                if !mp_shapes(self.words.resolve(method)) {
                    return mp_unknown()
                }
                let mut all = self.deps(receiver)
                for a in args {
                    all = mp_join(all, self.deps(a))
                }
                return all
            },
            Expr::Binary { lhs, rhs, .. } => return mp_join(self.deps(lhs), self.deps(rhs)),
            Expr::Coalesce { value, fallback, .. } => return mp_join(self.deps(value), self.deps(fallback)),
            Expr::Unary { expr, .. } => return self.deps(expr),
            Expr::Cast { expr, .. } => return self.deps(expr),
            Expr::Tuple(items, _) => return self.deps_all(items),
            Expr::ListLit { items, .. } => return self.deps_all(items),
            Expr::ListRepeat { value, count, .. } => return mp_join(self.deps(value), self.deps(count)),
            Expr::LitInterpolated { parts, .. } => {
                let mut all = mp_nothing()
                for p in parts {
                    match p {
                        FPart::Hole { expr, .. } => {
                            all = mp_join(all, self.deps(expr))
                        },
                        else => {},
                    }
                }
                return all
            },
            else => return mp_unknown(),
        }
    }

    fn deps_all(ref self, items: ref Vec[Expr]) -> MpDep {
        let mut all = mp_nothing()
        for a in items {
            all = mp_join(all, self.deps(a))
        }
        return all
    }

    fn set_local(ref mut self, name: String, dep: ref MpDep) {
        if self.params.contains(name) || self.roots.contains_key(name) {
            // A name that hides a parameter: not followed.
            self.doubt()
            return
        }
        let before = self.locals[name]?.clone() ?? mp_nothing()
        self.locals.insert(name, mp_join(before, dep))
    }

    fn block(ref mut self, block: ref Block, tail_is_the_result: bool) {
        let last = block.stmts.len() - 1
        let mut at = 0
        for stmt in block.stmts {
            self.stmt(stmt.node, tail_is_the_result && at == last)
            at = at + 1
        }
    }

    fn stmt(ref mut self, stmt: ref Stmt, is_the_result: bool) {
        match stmt {
            Stmt::Let { names, value, .. } => {
                if names.len() == 1 && self.map_made(value) {
                    let name = mp_text(self.words, names[0])
                    if self.params.contains(name) || self.roots.contains_key(name) {
                        self.doubt()
                    } else {
                        let root = self.new_root("".clone())
                        self.roots.insert(name, [("".clone(), root)])
                    }
                    return
                }
                let dep = self.deps(value)
                self.expr(value)
                for n in names {
                    self.set_local(mp_text(self.words, n), dep)
                }
            },
            Stmt::Assign { target, value, .. } => {
                match target {
                    Expr::Variable(n, _) => {
                        if !self.roots.contains_key(mp_text(self.words, n)) {
                            let dep = self.deps(value)
                            self.expr(value)
                            self.set_local(mp_text(self.words, n), dep)
                        } else {
                            self.assign_whole(target, value)
                        }
                    },
                    Expr::Index { .. } => {
                        if self.place(target) == null {
                            self.expr(target)
                        }
                        self.expr(value)
                    },
                    // A whole map assigned, or a field that holds one.
                    else => self.assign_whole(target, value),
                }
            },
            Stmt::For { bindings, iter, body, .. } => {
                let dep = self.iterated(iter)
                for b in bindings {
                    self.set_local(mp_text(self.words, b), dep)
                }
                self.block(body, false)
            },
            Stmt::While { cond, body } => {
                self.expr(cond)
                self.block(body, false)
            },
            Stmt::Return(value) => {
                self.returned_maybe(value)
            },
            Stmt::Expr(e) => {
                if is_the_result {
                    self.returned(e)
                } else {
                    self.expr(e)
                }
            },
            Stmt::Break => {},
            Stmt::Continue => {},
            Stmt::Comptime { .. } => self.doubt(),
        }
    }

    fn assign_whole(ref mut self, target: ref Expr, value: ref Expr) {
        let kind = self.classify(target)
        let is_not = match kind {
            MpRes::Not => true,
            else => false,
        }
        if !is_not && !self.map_made(value) {
            self.doubt()
        }
        self.expr(value)
    }

    fn returned_maybe(ref mut self, value: ref Expr?) {
        self.returned(value ?? return)
    }

    /// What a `for` binds: the keys of a map it walks, or what the iterable
    /// is made of.
    fn iterated(ref mut self, iter: ref Expr) -> MpDep {
        let mut walked: i64? = null
        match iter {
            Expr::MethodCall { receiver, method, .. } => {
                let m = mp_text(self.words, method)
                if m == "keys" || m == "values" || m == "iter" {
                    walked = self.place(receiver)
                } else {
                    walked = self.place(iter)
                }
            },
            else => {
                walked = self.place(iter)
            },
        }
        if walked != null {
            let root = walked ?? 0
            let name = self.root_name[root].clone()
            if !name.is_empty() {
                return mp_named(name)
            }
            return mp_unknown()
        }
        let dep = self.deps(iter)
        self.expr(iter)
        return dep
    }

    /// A value that becomes the function's result, or a part of it.
    fn returned(ref mut self, e: ref Expr) {
        if self.result.is_empty() {
            self.expr(e)
            return
        }
        self.flows(e, "".clone())
    }

    /// The result's roots at or below `under`.
    fn targets_of(ref self, under: String) -> Vec[i64] {
        let below = f"{under}."
        let mut targets: Vec[i64] = []
        for (p, id) in self.result {
            if p == under || p.starts_with(below) {
                targets.push(id)
            }
        }
        return targets
    }

    fn join_all(ref mut self, from: ref Vec[i64], targets: ref Vec[i64]) {
        if from.len() == targets.len() {
            for i in 0..<from.len() {
                self.union(from[i], targets[i])
            }
        } else {
            self.doubt()
        }
    }

    fn flows(ref mut self, e: ref Expr, under: String) {
        let targets = self.targets_of(under.clone())
        if targets.is_empty() {
            // A part of the result that holds no map.
            self.expr(e)
            return
        }
        if self.map_made(e) {
            return
        }
        match e {
            Expr::Variable(..) => self.flow_from(e, targets),
            Expr::Field { .. } => self.flow_from(e, targets),
            Expr::Index { .. } => self.flow_from(e, targets),
            Expr::MethodCall { receiver, method, args, .. } => {
                if args.is_empty() && mp_text(self.words, method) == "clone" {
                    self.flow_from(receiver, targets)
                } else {
                    self.expr(e)
                    self.doubt()
                }
            },
            Expr::StructLit { fields, .. } => {
                for f in fields {
                    let field = mp_text(self.words, f.name)
                    let part = f"{under}.{field}"
                    if f.value != null {
                        self.flows_in(f.value, part)
                    } else {
                        let held = self.roots[field]?.clone()
                        let ours = self.targets_of(part.clone())
                        if ours.is_empty() {
                            continue
                        }
                        if held == null {
                            self.doubt()
                        } else {
                            let h = held ?? []
                            if h.len() == ours.len() {
                                for i in 0..<h.len() {
                                    let (_, a) = h[i]
                                    self.union(a, ours[i])
                                }
                            } else {
                                self.doubt()
                            }
                        }
                    }
                }
            },
            Expr::LitNull(_) => {},
            Expr::Block(..) => self.doubt(),
            Expr::If { .. } => self.doubt(),
            Expr::Tuple(..) => self.doubt(),
            else => {
                self.expr(e)
                self.doubt()
            },
        }
    }

    fn flows_in(ref mut self, v: ref Expr?, under: String) {
        self.flows(v ?? return, under)
    }

    /// A value-place whose maps flow into the result's.
    fn flow_from(ref mut self, e: ref Expr, targets: ref Vec[i64]) {
        let from = self.roots_of(e)
        if from == null {
            self.doubt()
        } else {
            self.join_all(from ?? [], targets)
        }
    }

    fn expr(ref mut self, e: ref Expr) {
        match e {
            Expr::LitInt { .. } => {},
            Expr::LitStr { .. } => {},
            Expr::LitChar(..) => {},
            Expr::LitBool(..) => {},
            Expr::LitFloat(..) => {},
            Expr::LitNull(_) => {},
            Expr::Path(..) => {},
            Expr::Break(_) => {},
            Expr::Continue(_) => {},
            Expr::Variable(n, _) => {
                // A map used as a value: it goes somewhere unseen.
                if self.roots.contains_key(mp_text(self.words, n)) {
                    self.doubt()
                }
            },
            Expr::LitInterpolated { parts, .. } => {
                for p in parts {
                    match p {
                        FPart::Hole { expr, .. } => self.expr(expr),
                        else => {},
                    }
                }
            },
            Expr::Tuple(items, _) => {
                for i in items {
                    self.expr(i)
                }
            },
            Expr::ListLit { items, .. } => {
                for i in items {
                    self.expr(i)
                }
            },
            Expr::ListRepeat { value, count, .. } => {
                self.expr(value)
                self.expr(count)
            },
            Expr::Block(b, _) => self.block(b, false),
            Expr::Unsafe(b, _) => self.block(b, false),
            Expr::If { cond, then_branch, else_branch, .. } => {
                self.expr(cond)
                self.block(then_branch, false)
                self.block_maybe(else_branch)
            },
            Expr::Call { func, args, config, .. } => {
                self.expr(func)
                for a in args {
                    self.expr(a)
                }
                for c in config {
                    self.expr(c.value)
                }
            },
            Expr::MethodCall { receiver, method, args, config, .. } => {
                let name = mp_text(self.words, method)
                let root = self.place(receiver)
                if root != null {
                    if mp_adds(name) {
                        let mut dep = mp_nothing()
                        for a in args {
                            dep = mp_join(dep, self.deps(a))
                        }
                        self.add(root ?? 0, dep)
                    } else if !mp_reads(name) {
                        self.doubt()
                    }
                } else {
                    self.field_or(receiver)
                }
                for a in args {
                    self.expr(a)
                }
                for c in config {
                    self.expr(c.value)
                }
            },
            // A lookup, `m[k]`: reads the map and hands back a value.
            Expr::Index { base, index, .. } => {
                if self.place(base) != null {
                    self.expr(index)
                } else {
                    self.field_or(e)
                }
            },
            Expr::Field { .. } => self.field_or(e),
            Expr::SafeField { base, .. } => self.expr(base),
            Expr::Binary { op, lhs, rhs, .. } => {
                let equal = match op {
                    BinaryOp::Eq => true,
                    BinaryOp::Ne => true,
                    else => false,
                }
                if !equal {
                    self.expr(lhs)
                    self.expr(rhs)
                    return
                }
                let left = self.roots_of(lhs)
                let right = self.roots_of(rhs)
                if left != null && right != null {
                    let a = left ?? []
                    let b = right ?? []
                    if a.len() == b.len() {
                        for i in 0..<a.len() {
                            self.union(a[i], b[i])
                        }
                    } else {
                        self.doubt()
                    }
                } else if left != null {
                    if !self.map_made(rhs) {
                        self.doubt()
                    }
                    self.expr(rhs)
                } else if right != null {
                    if !self.map_made(lhs) {
                        self.doubt()
                    }
                    self.expr(lhs)
                } else {
                    self.expr(lhs)
                    self.expr(rhs)
                }
            },
            Expr::Unary { expr, .. } => self.expr(expr),
            Expr::Cast { expr, .. } => self.expr(expr),
            Expr::Try(inner, _) => self.expr(inner),
            Expr::Throw(inner, _) => self.expr(inner),
            Expr::Coalesce { value, fallback, .. } => {
                self.expr(value)
                self.expr(fallback)
            },
            Expr::Range { start, end, .. } => {
                self.expr(start)
                self.expr(end)
            },
            Expr::Return(value, _) => self.returned_maybe(value),
            Expr::StructLit { fields, .. } => {
                for f in fields {
                    if f.value != null {
                        self.expr_maybe(f.value)
                    } else if self.roots.contains_key(mp_text(self.words, f.name)) {
                        self.doubt()
                    }
                }
            },
            // A `match`, a closure, a task, an `overlap`, a `catch`, a DSL,
            // `with`, assembly: names bound some way this does not follow.
            else => self.doubt(),
        }
    }

    fn expr_maybe(ref mut self, value: ref Expr?) {
        self.expr(value ?? return)
    }

    fn block_maybe(ref mut self, block: ref Block?) {
        self.block(block ?? return, false)
    }

    /// A field or an index read as a value: a map or a part of a parameter
    /// that holds some goes somewhere unseen; any other field is a value.
    fn field_or(ref mut self, e: ref Expr) {
        match e {
            Expr::Field { .. } => self.field_or_place(e),
            Expr::Index { .. } => self.field_or_place(e),
            Expr::Variable(..) => self.field_or_place(e),
            else => self.expr(e),
        }
    }

    fn field_or_place(ref mut self, e: ref Expr) {
        match self.classify(e) {
            MpRes::Not => {
                // A field of a parameter that holds no map, or a chain that
                // does not start at a name: the parts that are expressions
                // have been visited by `locate`.
                if mp_root_is_expr(e) {
                    self.expr_base(e)
                }
            },
            else => self.doubt(),
        }
    }

    fn expr_base(ref mut self, e: ref Expr) {
        match e {
            Expr::Field { base, .. } => self.expr_base(base),
            Expr::Index { base, index, .. } => {
                self.expr_base(base)
                self.expr(index)
            },
            else => self.expr(e),
        }
    }

    /// What a set of names comes to once the locals are followed: the
    /// parameters, or null where something is never trusted.
    fn resolve(ref self, dep: ref MpDep) -> collections::BTreeSet[String]? {
        if dep.unknown {
            return null
        }
        let mut out: collections::BTreeSet[String] = collections::BTreeSet()
        let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
        let mut todo: Vec[String] = []
        for n in dep.names {
            todo.push(n.clone())
        }
        while !todo.is_empty() {
            let name = todo[todo.len() - 1].clone()
            todo.pop()
            if seen.contains(name) {
                continue
            }
            seen.insert(name.clone())
            let local = self.locals[name]?.clone()
            if local != null {
                let l = local ?? mp_unknown()
                if l.unknown {
                    return null
                }
                for n in l.names {
                    todo.push(n.clone())
                }
            } else if self.params.contains(name) {
                out.insert(name)
            } else {
                return null
            }
        }
        return out
    }
}

fn mp_made_name(name: String) -> bool {
    return name == "HashMap" || name == "HashSet"
}

/// Whether a chain of fields starts at something that is not a name.
fn mp_root_is_expr(e: ref Expr) -> bool {
    return match e {
        Expr::Field { base, .. } => mp_root_is_expr(base),
        Expr::Index { base, .. } => mp_root_is_expr(base),
        Expr::Variable(..) => false,
        else => true,
    }
}

/// How the lowering declares the hidden parameters of a `pub` function: one
/// per group of positions (ADR-010 D9, Part III 17.1).
pub struct MpShape {
    /// For each position, the first position of its group. Positions are
    /// numbered `self`'s first (a method), then the parameters in order, then
    /// the result.
    pub groups: Vec[i64],
    /// For each position, the ordinal among its `impl` type's own parameters
    /// where it is a position of that type.
    pub within: Vec[i64?],
    /// How many positions are `self`'s: the written types start after them.
    pub start: i64,
    /// How many positions the parameters have (the result's follow).
    pub of_params: i64,
    /// The body was read to its end, so the groups are the joins it makes.
    /// Otherwise they are the positions of one written type.
    pub exact: bool,
    /// Two positions of the `impl`'s own type are joined: the type declares
    /// one parameter for each, so no signature can say it.
    pub conflict: bool,
}

/// What a `pub` function says of its map positions.
pub struct MpFnMaps {
    /// The ledger's key: `name`, or `Type::name` for a method.
    pub key: String,
    /// The lines of the `maps` key, sorted.
    pub lines: Vec[String],
    pub shape: MpShape,
}

/// What each class of roots adds: the parameters, or null where unknown.
struct MpHow {
    known: bool,
    names: collections::BTreeSet[String],
}

/// One parameter of a function: its name and written type.
struct MpParam {
    name: String,
    ty: Type,
}

/// The lines and the shape of one function, null where it has no map position.
/// `read_body` is false for a signature alone (a trait's method).
fn mp_lines(held: ref MpHeld, structs: ref collections::BTreeMap[String, MpStruct], key: fn(i64, ref Type) -> String sync, arity: fn(ref String) -> i64 sync, unit: i64, fname: String, target: ref Type?, params: ref Vec[MpParam], ret: ref Type?, body: ref Block, read_body: bool) -> MpFnMaps? {
    let mut target_name: String = ""
    if target != null {
        let t = target ?? return null
        target_name = mp_short(held.words[unit].resolve(t.name))
    }
    let mut g = MpGather { target: target_name.clone(), nested: false, counters: [] }
    let mut positions: Vec[MpPosition] = []
    let mut start = 0
    let mut of_params = 0
    for p in params {
        let before = positions.len()
        let at = MpAt { owner: p.name.clone(), label: p.name.clone(), scope: "".clone(), path: "".clone(), within: -1 }
        mp_of(g, held, structs, key, arity, unit, p.ty, at, positions, 0)
        if p.name == mp_self() {
            start = positions.len() - before
        } else {
            of_params = of_params + positions.len() - before
        }
    }
    if ret != null {
        let at = MpAt { owner: mp_result(), label: mp_result(), scope: "".clone(), path: "".clone(), within: -1 }
        mp_of(g, held, structs, key, arity, unit, ret ?? return null, at, positions, 0)
    }
    if positions.is_empty() {
        return null
    }
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    for p in params {
        names.insert(p.name.clone())
    }
    let mut b = MpBody { words: held.words[unit], params: names, roots: collections::BTreeMap(), root_name: [], parent: [], adds: [], all_keyed: g.nested, locals: collections::BTreeMap(), result: [] }
    // One root per position: the ids are the positions' numbers.
    for p in positions {
        if p.owner == mp_result() {
            let id = b.new_root("".clone())
            b.result.push((p.path.clone(), id))
        } else {
            let id = b.new_root(p.owner.clone())
            let mut held = b.roots[p.owner]?.clone() ?? []
            held.push((p.path.clone(), id))
            b.roots.insert(p.owner.clone(), held)
        }
    }
    if read_body {
        b.block(body, ret != null)
    } else {
        // A signature alone (a trait's): nothing is known of what goes in.
        b.doubt()
    }
    let exact = !b.all_keyed
    // The class of each root and what its members add.
    let mut how: collections::BTreeMap[i64, MpHow] = collections::BTreeMap()
    for id in 0..<b.parent.len() {
        let class = b.find(id)
        let seen = b.resolve(b.adds[id])
        let before = how[class]?.clone() ?? MpHow { known: true, names: collections::BTreeSet() }
        let mut merged: collections::BTreeSet[String] = collections::BTreeSet()
        for n in before.names {
            merged.insert(n.clone())
        }
        let mut known = before.known
        if seen == null {
            known = false
        } else {
            for n in seen ?? collections::BTreeSet() {
                merged.insert(n.clone())
            }
        }
        how.insert(class, MpHow { known: known, names: merged })
    }
    let mut classes: collections::BTreeMap[i64, Vec[String]] = collections::BTreeMap()
    for at in 0..<positions.len() {
        let class = b.find(at)
        let mut labels = classes[class]?.clone() ?? []
        labels.push(positions[at].label.clone())
        classes.insert(class, labels)
    }
    let mut out: Vec[String] = []
    for (class, found) in classes {
        let mut labels = found.clone()
        labels.sort()
        let mut distinct: Vec[String] = []
        for l in labels {
            if distinct.is_empty() || distinct[distinct.len() - 1] != l {
                distinct.push(l.clone())
            }
        }
        let mut said = "keyed".clone()
        let entry = how[class]?.clone()
        if !b.all_keyed && entry != null {
            let h = entry ?? MpHow { known: false, names: collections::BTreeSet() }
            if h.known {
                let mut from: Vec[String] = []
                for n in h.names {
                    from.push(n.clone())
                }
                said = f"from({from.join(", ")})"
            }
        }
        out.push(f"{distinct.join(" | ")}: {said}")
    }
    out.sort()
    // The groups the lowering declares: the joins the body makes, or, where it
    // was not read to its end, the positions of one written type.
    let mut keys: Vec[String] = []
    for at in 0..<positions.len() {
        if exact {
            keys.push(f"{b.find(at)}")
        } else {
            keys.push(positions[at].group.clone())
        }
    }
    // The first position of a group, but a position of the `impl`'s own type
    // first where there is one: its parameter is the type's, and the others
    // of the group take it.
    let mut first: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let mut conflict = false
    for at in 0..<keys.len() {
        let k = keys[at].clone()
        let canon = first[k]
        if canon == null {
            first.insert(k, at)
        } else {
            let c = canon ?? 0
            let old = positions[c].within
            let new = positions[at].within
            if old == null && new != null {
                first.insert(k, at)
            } else if old != null && new != null && old != new {
                conflict = true
            }
        }
    }
    let mut groups: Vec[i64] = []
    let mut within: Vec[i64?] = []
    for at in 0..<keys.len() {
        groups.push(first[keys[at]] ?? 0)
        within.push(positions[at].within)
    }
    return MpFnMaps { key: fname, lines: out, shape: MpShape { groups: groups, within: within, start: start, of_params: of_params, exact: exact, conflict: conflict } }
}

/// Every `pub` function of the units that has a map position, with the key the
/// ledger files it under, its lines and its shape. `key` is the seeds' key of a
/// written type in a unit, `arity` the seeds' count of a type name.
pub fn mp_analyse(held: ref MpHeld, key: fn(i64, ref Type) -> String sync, arity: fn(ref String) -> i64 sync) -> Vec[MpFnMaps] {
    let structs = mp_structs(held)
    let mut out: Vec[MpFnMaps] = []
    for u in 0..<held.units.len() {
        for item in held.units[u].items {
            match item.node {
                Item::Fn { name, args, ret_type, body, is_public, receiver, .. } => {
                    if !is_public || receiver != null || name == null {
                        continue
                    }
                    let fname = held.words[u].resolve(name ?? continue).clone()
                    let mut params: Vec[MpParam] = []
                    for a in args {
                        params.push(MpParam { name: held.words[u].resolve(a.name).clone(), ty: a.ty.clone() })
                    }
                    let found = mp_lines(held, structs, key, arity, u, fname, null, params, ret_type, body, true)
                    if found != null {
                        out.push(found ?? continue)
                    }
                },
                Item::Impl { target, methods, trait_name } => {
                    let target_name = held.words[u].resolve(target.name).clone()
                    for method in methods {
                        match method.node {
                            Item::Fn { name, args, ret_type, body, is_public, receiver, .. } => {
                                if !is_public || name == null {
                                    continue
                                }
                                let fname = f"{target_name}::{held.words[u].resolve(name ?? continue)}"
                                let mut params: Vec[MpParam] = []
                                if receiver != null {
                                    params.push(MpParam { name: mp_self(), ty: target.clone() })
                                }
                                for a in args {
                                    params.push(MpParam { name: held.words[u].resolve(a.name).clone(), ty: a.ty.clone() })
                                }
                                // A trait's method is a barrier (step 7): fixed
                                // keyed, whatever its body does.
                                let found = mp_lines(held, structs, key, arity, u, fname, target, params, ret_type, body, trait_name == null)
                                if found != null {
                                    out.push(found ?? continue)
                                }
                            },
                            else => {},
                        }
                    }
                },
                else => {},
            }
        }
    }
    return out
}
