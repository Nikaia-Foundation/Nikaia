// crates/nikaia-std/src/tools/prove_terms.nika
//
// **An expression as a term of the proof** (ADR-269 D7, ADR-270), moved from
// the compiler's `prove` (ADR-294, #436 step 4): a whole number as a linear
// term, and a claim as a formula over them, where they are ones the prover
// reads.
//
// **The terms are built into the prover's arena.** Each node is appended to
// `out` - `prover_arena.nika`'s nodes - in the order it is made, its children
// named by their place in `out`: the same terms in the same order the Rust
// made them.

/// `expr` as a linear term over the names `var` admits: the node's place in
/// `out`, or nothing where it is not one. A product is linear where one side
/// is a constant. A name or a call `pinned` gives a value the build knows is
/// that value: a `comptime` binding (ADR-359 D7), a call run while the
/// program was built (D11).
pub fn lin_term(expr: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[SolverTerm]) -> i64? {
    return match expr {
        // A literal no `i64` holds is outside what the solver reads.
        Expr::LitInt { value, negative, .. } => {
            let n = literal_value(value, negative) ?? return null
            built(SolverTerm::Int(n), out)
        },
        Expr::Variable(name, _) => {
            let text = words.resolve(name)
            if !var(text) {
                let known = pinned(text) ?? return null
                return built(SolverTerm::Int(known), out)
            }
            built(SolverTerm::Var(text.clone()), out)
        },
        // `xs.len()` of a list that does not change is a variable of its own.
        Expr::MethodCall { receiver, method, args, .. } => {
            if !args.is_empty() || words.resolve(method) != "len" {
                return null
            }
            let length = match receiver {
                Expr::Variable(name, _) => f"{words.resolve(name)}.len()",
                else => return null,
            }
            if !var(length) {
                return null
            }
            built(SolverTerm::Var(length), out)
        },
        // **A call's result**, where the walk made it a name of its own
        // (`call_result_name`, ADR-314 D3).
        Expr::Call { .. } => {
            let name = call_result_name(expr)
            let ran = pinned(name)
            if ran != null {
                return built(SolverTerm::Int(ran ?? 0), out)
            }
            if !var(name) {
                return null
            }
            built(SolverTerm::Var(name), out)
        },
        Expr::Unary { op, expr, .. } => {
            if op != UnaryOp::Neg {
                return null
            }
            let a = lin_term(expr, words, var, pinned, out) ?? return null
            built(SolverTerm::Neg(a), out)
        },
        // **A conversion into a whole number keeps the value or stops the
        // program** (Part III A.2), so where it goes on the number is the one
        // converted: `c as i32` over a name `var` admits is that name
        // (ADR-314 D3's `result == c as i32 - 48`).
        Expr::Cast { expr, ty, .. } => {
            if !ty.generics.is_empty() || !is_whole_number(words.resolve(ty.name)) {
                return null
            }
            lin_term(expr, words, var, pinned, out)
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            let l = lin_term(lhs, words, var, pinned, out) ?? return null
            let r = lin_term(rhs, words, var, pinned, out) ?? return null
            match op {
                BinaryOp::Add => built(SolverTerm::Add(l, r), out),
                BinaryOp::Sub => built(SolverTerm::Sub(l, r), out),
                BinaryOp::Mul => {
                    if constant_at(l, out) == null && constant_at(r, out) == null {
                        return null
                    }
                    built(SolverTerm::Mul(l, r), out)
                },
                // **A quotient or a remainder of two known numbers is its
                // value** (ADR-359 D5), as Part I 2.2 folds it: truncated
                // toward zero. A division by zero or past the type's range
                // stops the program, and is no number here.
                BinaryOp::Div => {
                    let x = constant_at(l, out) ?? return null
                    let y = constant_at(r, out) ?? return null
                    let q = x.checked_div(y) ?? return null
                    built(SolverTerm::Int(q), out)
                },
                BinaryOp::Rem => {
                    let x = constant_at(l, out) ?? return null
                    let y = constant_at(r, out) ?? return null
                    let m = x.checked_rem(y) ?? return null
                    built(SolverTerm::Int(m), out)
                },
                else => null,
            }
        },
        else => null,
    }
}

/// **The name a call's result has in the proof**: the call's id (ADR-340),
/// in a form no binding of a program can spell.
pub fn call_result_name(call: ref Expr) -> String {
    return f"result@{node_key(call)}"
}

/// The claim `expr` as a formula over [`lin_term`]s, where it is one this
/// prover reads.
pub fn claim_term(expr: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[SolverTerm]) -> i64? {
    return match expr {
        Expr::LitBool(b, _) => built(SolverTerm::Bool(b), out),
        Expr::Unary { op, expr, .. } => {
            if op != UnaryOp::Not {
                return null
            }
            let a = claim_term(expr, words, var, pinned, out) ?? return null
            built(SolverTerm::Not(a), out)
        },
        Expr::Binary { op, lhs, rhs, .. } => match op {
            BinaryOp::And => {
                let l = claim_term(lhs, words, var, pinned, out) ?? return null
                let r = claim_term(rhs, words, var, pinned, out) ?? return null
                built(SolverTerm::And([l, r]), out)
            },
            BinaryOp::Or => {
                let l = claim_term(lhs, words, var, pinned, out) ?? return null
                let r = claim_term(rhs, words, var, pinned, out) ?? return null
                built(SolverTerm::Or([l, r]), out)
            },
            BinaryOp::Lt => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Le => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Gt => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Ge => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Eq => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Ne => compared(op, lhs, rhs, words, var, pinned, out),
            else => null,
        },
        else => null,
    }
}

/// A comparison of two linear terms.
fn compared(op: BinaryOp, lhs: ref Expr, rhs: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[SolverTerm]) -> i64? {
    let a = lin_term(lhs, words, var, pinned, out) ?? return null
    let b = lin_term(rhs, words, var, pinned, out) ?? return null
    return match op {
        BinaryOp::Lt => built(SolverTerm::Lt(a, b), out),
        BinaryOp::Le => built(SolverTerm::Le(a, b), out),
        BinaryOp::Gt => built(SolverTerm::Gt(a, b), out),
        BinaryOp::Ge => built(SolverTerm::Ge(a, b), out),
        BinaryOp::Eq => built(SolverTerm::Eq(a, b), out),
        else => built(SolverTerm::Ne(a, b), out),
    }
}

/// `node` appended, and its place.
fn built(node: SolverTerm, mut out: Vec[SolverTerm]) -> i64 {
    out.push(node)
    return out.len() - 1
}

/// The value of the term at `at` where it reads no variable and fits, as
/// `nikaia-logic`'s `Arena::constant` reads it.
fn constant_at(at: i64, out: ref Vec[SolverTerm]) -> i64? {
    return match out[at] {
        SolverTerm::Int(n) => n,
        SolverTerm::Neg(a) => {
            let v = constant_at(a, out) ?? return null
            v.checked_neg()
        },
        SolverTerm::Add(a, b) => {
            let x = constant_at(a, out) ?? return null
            let y = constant_at(b, out) ?? return null
            x.checked_add(y)
        },
        SolverTerm::Sub(a, b) => {
            let x = constant_at(a, out) ?? return null
            let y = constant_at(b, out) ?? return null
            x.checked_sub(y)
        },
        SolverTerm::Mul(a, b) => {
            let x = constant_at(a, out) ?? return null
            let y = constant_at(b, out) ?? return null
            x.checked_mul(y)
        },
        else => null,
    }
}

/// An integer literal's value where an `i64` holds it.
fn literal_value(value: u64, negative: bool) -> i64? {
    if value <= 9223372036854775807 {
        let n = value as i64
        if negative {
            return -n
        }
        return n
    }
    if negative && value == 9223372036854775808 {
        return -9223372036854775808
    }
    return null
}

/// No name pinned: for a term read where no `comptime` and no call run
/// while building can stand.
pub fn nothing_pinned(name: ref String) -> i64? {
    return null
}
