// crates/nikaia-std/src/tools/migrate_views3.nika
//
// **`nikaia migrate views-3`** (ADR-views-3 D4, D2; #1213 step 6): the one-off
// rewrite that takes `ref` out of a program and writes `keep` where the keep
// inference says a parameter is kept.
//
// **Over the tokens, not the tree**, as `nikaia fmt` is (`fmt.nika`): every
// token, blank and comment stays as written except the ones a rewrite names.
// A comment, a string, an `f"…"` and a `dsl` body are single tokens or part of
// the blanks before one, so a `ref` in them is never touched.
//
// The rewrites (D4):
// * `ref self` -> `self`, `ref mut self` -> `mut self`;
// * a parameter `x: ref T` -> `x: T`, `x: ref mut T` -> `mut x: T`;
// * `return ref s` -> `return s`, `f(ref x)` -> `f(x)`;
// * `ref` before a type (a field, an element, a binding, a tuple, a result)
//   is dropped.
// Left alone: an `extern` block (also written `extern "C"` or
// `extern(library: …)`) and an `extern fn`'s signature, where `ref` keeps
// its meaning at the C boundary (D4, Part III); `ref(a | b) T`, whose
// sources D8 spells `T from a | b` after the type; and a `ref mut T`
// that is neither a receiver nor a parameter's type (no form replaces it).
//
// `keep` (D2) comes from the inference the checker holds the marks against
// (`keeps.nika` through `keeps_uses_of`, as `check_keep_marks.nika` asks it):
// `migrate_views3_keeps` names the parameters it would refuse unmarked, and
// the rewrite writes `keep` before each.

use std::collections

enum MigrateKind {
    Word,
    // A string, an `f"…"` with its holes, a character, a `dsl` body.
    Text,
    Open,
    Close,
    Punct,
}

struct MigrateToken {
    // The blanks and comments before it, as written.
    gap: String,
    text: String,
    kind: MigrateKind,
    // The character index its text starts at.
    at: i64,
}

struct MigrateLexer {
    c: Vec[scalar],
    at: i64,
    tokens: Vec[MigrateToken],
}

impl MigrateLexer {
    fn run(mut self) sync {
        while self.at < self.c.len() {
            let gap_start = self.at
            self.skip_gap()
            let mut gap: String = ""
            for k in gap_start..<self.at {
                gap.push(self.c[k])
            }
            if self.at >= self.c.len() {
                self.tokens.push(MigrateToken { gap, text: "", kind: MigrateKind::Punct, at: self.at })
                return
            }
            let start = self.at
            let kind = self.scan()
            let end = if self.at > self.c.len() { self.c.len() } else { self.at }
            self.at = end
            let mut text: String = ""
            for k in start..<end {
                text.push(self.c[k])
            }
            self.tokens.push(MigrateToken { gap, text, kind, at: start })
        }
    }

    // Blanks, line ends and comments: `//` to the line's end, `/* … */`
    // nested.
    fn skip_gap(mut self) sync {
        while self.at < self.c.len() {
            let c = self.c[self.at]
            let d = migrate_ahead(self.c, self.at + 1)
            if c.is_whitespace() {
                self.at += 1
            } else if c == '/' && d == '/' {
                while self.at < self.c.len() && self.c[self.at] != '\n' {
                    self.at += 1
                }
            } else if c == '/' && d == '*' {
                let mut depth = 0
                while self.at < self.c.len() {
                    let e = self.c[self.at]
                    let f = migrate_ahead(self.c, self.at + 1)
                    if e == '/' && f == '*' {
                        depth += 1
                        self.at += 2
                    } else if e == '*' && f == '/' {
                        depth -= 1
                        self.at += 2
                        if depth == 0 {
                            break
                        }
                    } else {
                        self.at += 1
                    }
                }
            } else {
                return
            }
        }
    }

    fn scan(mut self) -> MigrateKind sync {
        let c = self.c[self.at]
        let d = migrate_ahead(self.c, self.at + 1)
        if c == '"' {
            self.at += 1
            self.quoted()
            return MigrateKind::Text
        }
        if c == 'f' && d == '"' {
            self.at += 2
            self.interpolated()
            return MigrateKind::Text
        }
        if c == '\'' {
            let after = migrate_character_end(self.c, self.at)
            if after > 0 {
                self.at = after
                return MigrateKind::Text
            }
        }
        if c.is_alphanumeric() || c == '_' {
            while self.at < self.c.len() && (self.c[self.at].is_alphanumeric() || self.c[self.at] == '_') {
                self.at += 1
            }
            return MigrateKind::Word
        }
        if c == '{' && migrate_after_dsl(self.tokens) {
            self.verbatim()
            return MigrateKind::Text
        }
        self.at += 1
        if c == '(' || c == '[' || c == '{' {
            return MigrateKind::Open
        }
        if c == ')' || c == ']' || c == '}' {
            return MigrateKind::Close
        }
        if c == ':' && d == ':' {
            self.at += 1
        }
        if c == '-' && d == '>' {
            self.at += 1
        }
        return MigrateKind::Punct
    }

    // A plain string, from after its opening quote through its closing one.
    fn quoted(mut self) sync {
        while self.at < self.c.len() {
            let c = self.c[self.at]
            if c == '\\' {
                self.at += 2
            } else {
                self.at += 1
                if c == '"' {
                    return
                }
            }
        }
    }

    // An `f"…"`, from after `f"`; a hole's braces nest, and a string in a
    // hole is one.
    fn interpolated(mut self) sync {
        let mut depth = 0
        while self.at < self.c.len() {
            let c = self.c[self.at]
            let d = migrate_ahead(self.c, self.at + 1)
            if c == '\\' || (depth == 0 && ((c == '{' && d == '{') || (c == '}' && d == '}'))) {
                self.at += 2
            } else {
                self.at += 1
                if c == '"' && depth == 0 {
                    return
                }
                if c == '"' {
                    self.quoted()
                } else if c == '{' {
                    depth += 1
                } else if c == '}' {
                    depth -= 1
                }
            }
        }
    }

    // A `dsl` body from its `{` through `} eod`.
    fn verbatim(mut self) sync {
        let mut k = self.at + 1
        while k + 4 < self.c.len() {
            if self.c[k] == '}' && self.c[k + 1] == ' ' && self.c[k + 2] == 'e' && self.c[k + 3] == 'o' && self.c[k + 4] == 'd' {
                self.at = k + 5
                return
            }
            k += 1
        }
        self.at = self.c.len()
    }
}

fn migrate_ahead(c: ref Vec[scalar], k: i64) -> scalar sync {
    if k < c.len() {
        return c[k]
    }
    return ' '
}

// Where a character literal starting at `at` ends, or 0 where none does.
fn migrate_character_end(c: ref Vec[scalar], at: i64) -> i64 sync {
    let mut k = at + 1
    if k < c.len() && c[k] == '\\' {
        k += 2
    } else {
        k += 1
    }
    while k < c.len() && c[k] != '\'' && c[k] != '\n' {
        k += 1
    }
    if k < c.len() && c[k] == '\'' {
        return k + 1
    }
    return 0
}

// Whether the tokens before a `{` are `dsl NAME` or `dsl NAME::NAME`.
fn migrate_after_dsl(tokens: ref Vec[MigrateToken]) -> bool sync {
    let n = tokens.len()
    if n < 2 || tokens[n - 1].kind != MigrateKind::Word {
        return false
    }
    if tokens[n - 2].text == "dsl" {
        return true
    }
    return n >= 4 && tokens[n - 2].text == "::" && tokens[n - 4].text == "dsl"
}

// Whether a gap holds only blanks on one line: dropping it joins two tokens
// of a line, never two lines or a comment.
fn migrate_blank(gap: String) -> bool sync {
    return gap.chars().all(fn(c) { c == ' ' || c == '\t' })
}

// The text of token `k`, or nothing past the end.
fn migrate_text_at(tokens: Vec[MigrateToken], k: i64) -> String sync {
    if k >= 0 && k < tokens.len() {
        return tokens[k].text.clone()
    }
    return ""
}

// The index of the token that closes the bracket opened at `open`, or the
// last token.
fn migrate_closing(tokens: Vec[MigrateToken], open: i64) -> i64 sync {
    let mut depth = 0
    let mut k = open
    while k < tokens.len() {
        match tokens[k].kind {
            MigrateKind::Open => { depth += 1 },
            MigrateKind::Close => {
                depth -= 1
                if depth == 0 {
                    return k
                }
            },
            else => {},
        }
        k += 1
    }
    return tokens.len() - 1
}

// **The C boundary**: from an `extern` at `at`, the last token that stays as
// written. An `extern { … }` block whole, also one written `extern "C"` or
// `extern(library: "name")`; an `extern fn`, its signature up to the body's
// `{`.
fn migrate_extern_end(tokens: Vec[MigrateToken], at: i64) -> i64 sync {
    let mut k = at + 1
    if k < tokens.len() && tokens[k].kind == MigrateKind::Text {
        k += 1
    }
    if migrate_text_at(tokens, k) == "(" {
        k = migrate_closing(tokens, k) + 1
    }
    if migrate_text_at(tokens, k) == "{" {
        return migrate_closing(tokens, k)
    }
    let mut depth = 0
    while k < tokens.len() {
        let t = tokens[k].text.clone()
        match tokens[k].kind {
            MigrateKind::Open => {
                if t == "{" && depth == 0 {
                    return k - 1
                }
                depth += 1
            },
            MigrateKind::Close => {
                if depth == 0 {
                    return k - 1
                }
                depth -= 1
            },
            else => {},
        }
        k += 1
    }
    return tokens.len() - 1
}

/// **Each method's receiver `self`, in order**: the index of its token, and
/// whether it is written bare, with no `ref`, `mut` or `keep` before it (the
/// old by-value `self`). The first `(` after a `fn` opens the parameters.
fn migrate_receivers(tokens: ref Vec[MigrateToken]) -> Vec[(i64, bool)] sync {
    let mut out: Vec[(i64, bool)] = []
    let mut pending = false
    let mut k = 0
    while k < tokens.len() {
        let t = tokens[k].text.clone()
        if tokens[k].kind == MigrateKind::Word && t == "fn" {
            pending = true
        } else if pending && (t == "{" || t == ";" || t == "=") {
            pending = false
        } else if pending && t == "(" {
            pending = false
            let mut j = k + 1
            while j < tokens.len() && (tokens[j].text == "ref" || tokens[j].text == "mut" || tokens[j].text == "keep") {
                j += 1
            }
            if j < tokens.len() && tokens[j].text == "self" {
                out.push((j, j == k + 1))
            }
        }
        k += 1
    }
    return out
}

/// **Whether each token stands directly inside a declaration's parameter
/// list**: the first `(` after a `fn`, as the brackets open and close.
fn migrate_in_params(tokens: ref Vec[MigrateToken]) -> Vec[bool] sync {
    let mut out: Vec[bool] = []
    let mut params: Vec[bool] = []
    let mut fn_depth = -1
    for token in tokens {
        let t = token.text.clone()
        match token.kind {
            MigrateKind::Open => {
                params.push(t == "(" && fn_depth == params.len())
                if t == "(" && fn_depth == params.len() - 1 {
                    fn_depth = -1
                }
                if t == "{" {
                    fn_depth = -1
                }
            },
            MigrateKind::Close => {
                if params.len() > 0 {
                    params.pop()
                }
            },
            MigrateKind::Word => {
                if t == "fn" {
                    fn_depth = params.len()
                }
            },
            MigrateKind::Punct => {
                if t == "=" || t == ";" {
                    fn_depth = -1
                }
            },
            else => {},
        }
        out.push(params.len() > 0 && params[params.len() - 1])
    }
    return out
}

/// **Each declared parameter, in order**: the index of its name's token, a
/// word before `:` right after `(`, `,`, `keep` or `mut` in a parameter list.
/// The names a function type or a lambda writes, `fn(a: String)`, are none:
/// the migration names a function type's parameters (D14), and the list must
/// read alike before and after it.
fn migrate_parameters(tokens: ref Vec[MigrateToken]) -> Vec[i64] sync {
    let in_params = migrate_in_params(tokens)
    let mut unnamed: Vec[bool] = []
    let mut out: Vec[i64] = []
    for k in 0..<tokens.len() {
        match tokens[k].kind {
            MigrateKind::Open => {
                unnamed.push(k > 0 && tokens[k].text == "(" && tokens[k - 1].text == "fn")
            },
            MigrateKind::Close => {
                if unnamed.len() > 0 {
                    unnamed.pop()
                }
            },
            else => {},
        }
        if k > 0 && !(unnamed.len() > 0 && unnamed[unnamed.len() - 1]) {
            let before = tokens[k - 1].text.clone()
            if in_params[k] && tokens[k].kind == MigrateKind::Word && migrate_text_at(tokens, k + 1) == ":" && (before == "(" || before == "," || before == "keep" || before == "mut") {
                out.push(k)
            }
        }
    }
    return out
}

/// The last token of the type that starts at `at`: a bracketed one whole, or
/// a name with its path, its `[…]` and its `?`.
fn migrate_type_end(tokens: ref Vec[MigrateToken], at: i64) -> i64 sync {
    let mut k = at
    if k >= tokens.len() {
        return tokens.len() - 1
    }
    if tokens[k].kind == MigrateKind::Open {
        k = migrate_closing(tokens, k)
    } else {
        while migrate_text_at(tokens, k + 1) == "::" {
            k += 2
        }
        if migrate_text_at(tokens, k + 1) == "[" {
            k = migrate_closing(tokens, k + 1)
        }
    }
    if migrate_text_at(tokens, k + 1) == "?" {
        k += 1
    }
    return k
}

/// Whether the tokens at `k` are a function type with a `ref` result, `fn(…)
/// -> ref T`, read where a type stands: after `:`, `->` or `[`, or after a
/// `,` among a type's `[…]`.
fn migrate_a_ref_code(tokens: ref Vec[MigrateToken], k: i64, in_brackets: bool) -> bool sync {
    if tokens[k].text != "fn" || migrate_text_at(tokens, k + 1) != "(" || tokens[k + 1].gap != "" || k == 0 {
        return false
    }
    let before = tokens[k - 1].text.clone()
    if before != ":" && before != "->" && before != "[" && !(before == "," && in_brackets) {
        return false
    }
    let close = migrate_closing(tokens, k + 1)
    return migrate_text_at(tokens, close + 1) == "->" && migrate_text_at(tokens, close + 2) == "ref" && migrate_text_at(tokens, close + 3) != "mut" && migrate_text_at(tokens, close + 3) != "("
}

/// **A function type with a `ref` result, written as D14 says** (ADR-views-3
/// D14, #1254): each parameter named by its position, `a`, `b`, `c`, … (a
/// name written already stays), and the result reads `from` the ones written
/// `ref`. `fn(ref String) -> ref String` becomes `fn(a: String) -> String from
/// a`. Its `ref`s go as everywhere else; the names and the `from` are added
/// to `prefix` and `suffix`.
fn migrate_name_a_code(tokens: ref Vec[MigrateToken], k: i64, mut prefix: Vec[String], mut suffix: Vec[String]) sync {
    let open = k + 1
    let close = migrate_closing(tokens, open)
    let mut sources: Vec[String] = []
    let mut start = open + 1
    let mut depth = 0
    let mut position = 0
    let mut j = open + 1
    while j <= close {
        let ends = j == close || (depth == 0 && tokens[j].text == ",")
        if ends && j > start {
            let mut name: String = ""
            let mut type_at = start
            if tokens[start].kind == MigrateKind::Word && migrate_text_at(tokens, start + 1) == ":" {
                name = tokens[start].text.clone()
                type_at = start + 2
            } else {
                name = migrate_letter(position)
                prefix[start] = f"{name}: "
            }
            if migrate_text_at(tokens, type_at) == "ref" && migrate_text_at(tokens, type_at + 1) != "mut" {
                sources.push(name)
            }
            position += 1
        }
        if ends {
            start = j + 1
        }
        match tokens[j].kind {
            MigrateKind::Open => { depth += 1 },
            MigrateKind::Close => { depth -= 1 },
            else => {},
        }
        j += 1
    }
    if sources.len() == 0 {
        return
    }
    let last = migrate_type_end(tokens, close + 3)
    suffix[last] = f"{suffix[last]} from {sources.join(" | ")}"
}

/// The name of a function type's parameter at `position`: `a`, `b`, … `z`,
/// then `a26`, … .
fn migrate_letter(position: i64) -> String sync {
    let letters = "abcdefghijklmnopqrstuvwxyz"
    let chars: Vec[scalar] = letters.chars().collect()
    if position < 26 {
        let mut one: String = ""
        one.push(chars[position])
        return one
    }
    return f"a{position}"
}

/// **A declaration whose `ref` result may come out of a function value it
/// takes** (ADR-views-3 D8, D14, #1254): `fn apply(f: fn(ref String) -> ref
/// String, s: ref String) -> ref String` hands back what `f` makes of `s`,
/// which no body tells the inference, so the result is written `from` the
/// parameters the old one could point into, those written `ref` (and a `ref
/// self`): `-> String from s`. `k` is the `fn` of the declaration.
fn migrate_from_of_a_declaration(tokens: ref Vec[MigrateToken], k: i64, mut suffix: Vec[String]) sync {
    if migrate_text_at(tokens, k + 1) == "(" || k + 1 >= tokens.len() || tokens[k + 1].kind != MigrateKind::Word {
        return
    }
    let mut open = k + 2
    if migrate_text_at(tokens, open) == "[" {
        open = migrate_closing(tokens, open) + 1
    }
    if migrate_text_at(tokens, open) != "(" {
        return
    }
    let close = migrate_closing(tokens, open)
    if migrate_text_at(tokens, close + 1) != "->" || migrate_text_at(tokens, close + 2) != "ref" || migrate_text_at(tokens, close + 3) == "mut" || migrate_text_at(tokens, close + 3) == "(" {
        return
    }
    let mut takes_one = false
    let mut sources: Vec[String] = []
    let mut depth = 0
    for j in open + 1..<close {
        if migrate_a_ref_code(tokens, j, false) {
            takes_one = true
        }
        match tokens[j].kind {
            MigrateKind::Open => { depth += 1 },
            MigrateKind::Close => { depth -= 1 },
            else => {},
        }
        let before = tokens[j - 1].text.clone()
        let first = j == open + 1 || (depth == 0 && before == ",")
        if first && tokens[j].text == "ref" && migrate_text_at(tokens, j + 1) == "self" {
            sources.push("self")
        }
        if first && tokens[j].kind == MigrateKind::Word && migrate_text_at(tokens, j + 1) == ":" && migrate_text_at(tokens, j + 2) == "ref" && migrate_text_at(tokens, j + 3) != "mut" {
            sources.push(tokens[j].text.clone())
        }
    }
    if !takes_one || sources.len() == 0 {
        return
    }
    let last = migrate_type_end(tokens, close + 3)
    suffix[last] = f"{suffix[last]} from {sources.join(" | ")}"
}

/// **A trait method's `ref` result, written as D14 says** (ADR-views-3 D14,
/// #1224): without a body, `from` alone makes a result a view, so dropping
/// the `ref` of `fn name(self) -> ref String` would make it own its value.
/// The migration writes the `from` the old declaration meant, which is what
/// every implementation's body is held to today (`views.nika`,
/// `rsrc_report`): a lent receiver, `-> String from self`; else the one
/// parameter written `ref`. `k` is the `fn` of a method inside a `trait`.
/// The answer is the last token of the result type, its `ref`, the sources
/// to write after it, and, where the old declaration names several parameters or
/// none, no sources but the choices, for the refusal; `-1` where `k` is no
/// body-less method with a `ref` result and no `from`.
fn migrate_trait_result(tokens: ref Vec[MigrateToken], k: i64) -> (i64, i64, String, Vec[String]) sync {
    let none: (i64, i64, String, Vec[String]) = (-1, -1, "", [])
    if k + 1 >= tokens.len() || tokens[k + 1].kind != MigrateKind::Word {
        return none
    }
    let mut open = k + 2
    if migrate_text_at(tokens, open) == "[" {
        open = migrate_closing(tokens, open) + 1
    }
    if migrate_text_at(tokens, open) != "(" {
        return none
    }
    let close = migrate_closing(tokens, open)
    if migrate_text_at(tokens, close + 1) != "->" || migrate_text_at(tokens, close + 2) != "ref" || migrate_text_at(tokens, close + 3) == "mut" || (migrate_text_at(tokens, close + 3) == "(" && tokens[close + 3].gap == "") {
        return none
    }
    let last = migrate_type_end(tokens, close + 3)
    let mut after = last + 1
    while migrate_text_at(tokens, after) == "sync" || migrate_text_at(tokens, after) == "throws" {
        after += 1
    }
    if migrate_text_at(tokens, after) == "from" || migrate_text_at(tokens, after) == "{" {
        return none
    }
    let mut lent_self = false
    let mut sources: Vec[String] = []
    let mut depth = 0
    for j in open + 1..<close {
        match tokens[j].kind {
            MigrateKind::Open => { depth += 1 },
            MigrateKind::Close => { depth -= 1 },
            else => {},
        }
        let first = j == open + 1 || (depth == 0 && tokens[j - 1].text == ",")
        if first && j == open + 1 {
            let receiver = migrate_text_at(tokens, j)
            if receiver == "self" || ((receiver == "ref" || receiver == "mut") && migrate_text_at(tokens, j + 1) == "self") || (receiver == "ref" && migrate_text_at(tokens, j + 1) == "mut" && migrate_text_at(tokens, j + 2) == "self") {
                lent_self = true
            }
        }
        if first && tokens[j].kind == MigrateKind::Word && migrate_text_at(tokens, j + 1) == ":" && migrate_text_at(tokens, j + 2) == "ref" && migrate_text_at(tokens, j + 3) != "mut" {
            sources.push(tokens[j].text.clone())
        }
    }
    if lent_self {
        return (last, close + 2, "self", [])
    }
    if sources.len() == 1 {
        return (last, close + 2, sources[0].clone(), [])
    }
    let mut choices: Vec[String] = []
    for source in sources {
        choices.push(f"`from {source}`")
    }
    if sources.len() > 1 {
        choices.push(f"`from {sources.join(" | ")}`")
    }
    return (last, close + 2, "", choices)
}

/// **The end of each `trait` block**, per token: the index of its closing
/// `}` where `k` is the word `trait`, else -1.
fn migrate_trait_end(tokens: ref Vec[MigrateToken], k: i64) -> i64 sync {
    if tokens[k].kind != MigrateKind::Word || tokens[k].text != "trait" || k + 1 >= tokens.len() || tokens[k + 1].kind != MigrateKind::Word {
        return -1
    }
    let mut j = k + 2
    while j < tokens.len() && tokens[j].text != "{" && tokens[j].text != ";" {
        if tokens[j].kind == MigrateKind::Open {
            j = migrate_closing(tokens, j)
        }
        j += 1
    }
    if j >= tokens.len() || tokens[j].text != "{" {
        return -1
    }
    return migrate_closing(tokens, j)
}

/// **What the migration of `code` could not write** (ADR-views-3 D14,
/// #1224): each trait method whose `ref` result names no source the old
/// declaration fixes, with its line and the `from`s to choose from. Its `ref`
/// stays, and the checker refuses it (`NK1336`) until one is written.
pub fn migrate_views3_unwritten(code: String) -> Vec[String] sync {
    let mut lexer = MigrateLexer { c: code.chars().collect(), at: 0, tokens: [] }
    lexer.run()
    let tokens = lexer.tokens
    let mut out: Vec[String] = []
    let mut in_trait = -1
    let mut guarded = -1
    for k in 0..<tokens.len() {
        if tokens[k].kind == MigrateKind::Word && tokens[k].text == "extern" && k > guarded {
            guarded = migrate_extern_end(tokens, k)
        }
        if k > in_trait && k > guarded {
            in_trait = migrate_trait_end(tokens, k)
        }
        if k < in_trait && k > guarded && tokens[k].kind == MigrateKind::Word && tokens[k].text == "fn" {
            let (last, _, from, choices) = migrate_trait_result(tokens, k)
            if last >= 0 && from.is_empty() {
                let mut line = 1
                let mut at = 0
                for c in code.chars() {
                    if at >= tokens[k].at {
                        break
                    }
                    if c == '\n' {
                        line += 1
                    }
                    at += 1
                }
                let name = tokens[k + 1].text.clone()
                let help = if choices.is_empty() { "or drop `ref` to hand back text of its own" } else { f"write one of {choices.join(", ")} after its result type, or drop `ref` to hand back text of its own" }
                out.push(f"{line}: `{name}` hands back a view but says of no parameter whose data it points into: {help} (ADR-views-3 D14)")
            }
        }
    }
    return out
}

fn migrate_ordinal_of(items: ref Vec[i64], wanted: i64) -> i64 sync {
    for at in 0..<items.len() {
        if items[at] == wanted {
            return at
        }
    }
    return -1
}

/// **Which declared parameters were written `ref`**, in
/// `migrate_parameters`'s order: read on the code as written, before `ref`
/// goes, since `p: ref T` and `p: T` read alike after it (ADR-views-3 D4:
/// such a one was a borrow, and is never marked `keep`).
pub fn migrate_views3_lent(code: String) -> Vec[bool] sync {
    let mut lexer = MigrateLexer { c: code.chars().collect(), at: 0, tokens: [] }
    lexer.run()
    let mut out: Vec[bool] = []
    for k in migrate_parameters(lexer.tokens) {
        out.push(migrate_text_at(lexer.tokens, k + 2) == "ref" && migrate_text_at(lexer.tokens, k + 3) != "mut")
    }
    return out
}

/// **Which receivers were the old by-value `self`**, in order: read on the
/// code as written, before `ref` goes, since `ref self` and `self` read
/// alike after it (ADR-views-3 D2: a consumed one becomes `keep self`).
pub fn migrate_views3_selves(code: String) -> Vec[bool] sync {
    let mut lexer = MigrateLexer { c: code.chars().collect(), at: 0, tokens: [] }
    lexer.run()
    let mut out: Vec[bool] = []
    for (_, bare) in migrate_receivers(lexer.tokens) {
        out.push(bare)
    }
    return out
}

/// **The rewrite of one piece of Nikaia code**: `keep_at` are the character
/// indices of the parameters to mark `keep` (a parameter takes the mark at
/// its first token at or after the index; a method's `self`, named by where
/// the method starts, takes it where `by_value` says its receiver was the old
/// by-value `self`, in `migrate_views3_selves`'s order).
pub fn migrate_views3_code(code: String, keep_at: Vec[i64], by_value: Vec[bool], lent: Vec[bool]) -> String sync {
    let mut lexer = MigrateLexer { c: code.chars().collect(), at: 0, tokens: [] }
    lexer.run()
    let tokens = lexer.tokens
    let n = tokens.len()
    let receivers = migrate_receivers(tokens)
    let parameters = migrate_parameters(tokens)
    let mut dropped: Vec[bool] = []
    let mut gapless: Vec[bool] = []
    let mut prefix: Vec[String] = []
    let mut guarded: Vec[bool] = []
    let mut suffix: Vec[String] = []
    for _t in tokens {
        dropped.push(false)
        gapless.push(false)
        prefix.push("")
        guarded.push(false)
        suffix.push("")
    }
    let in_params = migrate_in_params(tokens)
    let mut in_trait = -1
    let mut kept_ref: Vec[bool] = []
    for _t in tokens {
        kept_ref.push(false)
    }
    let mut brackets: Vec[bool] = []
    let mut until = -1
    let mut k = 0
    while k < n {
        let t = tokens[k].text.clone()
        let kind = tokens[k].kind
        if k <= until {
            guarded[k] = true
        }
        if kind == MigrateKind::Word && t == "extern" && k > until {
            until = migrate_extern_end(tokens, k)
            guarded[k] = true
        }
        if !guarded[k] && migrate_a_ref_code(tokens, k, brackets.len() > 0 && brackets[brackets.len() - 1]) {
            migrate_name_a_code(tokens, k, prefix, suffix)
        }
        if !guarded[k] && kind == MigrateKind::Word && t == "fn" {
            migrate_from_of_a_declaration(tokens, k, suffix)
        }
        if k > in_trait && !guarded[k] {
            in_trait = migrate_trait_end(tokens, k)
        }
        if k < in_trait && !guarded[k] && kind == MigrateKind::Word && t == "fn" {
            let (last, ref_at, from, _) = migrate_trait_result(tokens, k)
            if last >= 0 && !from.is_empty() {
                suffix[last] = f"{suffix[last]} from {from}"
            } else if last >= 0 {
                // No source the old declaration fixes: its `ref` stays
                // (`migrate_views3_unwritten` names the choices).
                kept_ref[ref_at] = true
            }
        }
        if kind == MigrateKind::Open {
            brackets.push(t == "[")
        } else if kind == MigrateKind::Close && brackets.len() > 0 {
            brackets.pop()
        }
        if kind == MigrateKind::Word && t == "ref" && !guarded[k] && !kept_ref[k] {
            let next = migrate_text_at(tokens, k + 1)
            let after = migrate_text_at(tokens, k + 2)
            let named = k >= 3 && migrate_text_at(tokens, k - 1) == ":" && tokens[k - 2].kind == MigrateKind::Word && (migrate_text_at(tokens, k - 3) == "(" || migrate_text_at(tokens, k - 3) == ",")
            if next == "(" && tokens[k + 1].gap == "" {
                // `ref(a | b) T`: left for D8's `from`; `ref (A, B)` is a
                // tuple (#1115) and loses its `ref` below.
            } else if next == "mut" && after == "self" {
                dropped[k] = true
                gapless[k + 1] = migrate_blank(tokens[k + 1].gap)
            } else if next == "mut" && in_params[k] && named {
                dropped[k] = true
                dropped[k + 1] = true
                gapless[k + 1] = true
                gapless[k + 2] = migrate_blank(tokens[k + 2].gap)
                prefix[k - 2] = "mut "
            } else if next == "mut" {
                // `ref mut T` elsewhere: no form replaces it.
            } else if k + 1 < n && tokens[k + 1].kind != MigrateKind::Punct {
                dropped[k] = true
                gapless[k + 1] = migrate_blank(tokens[k + 1].gap)
            }
        }
        k += 1
    }
    for at in keep_at {
        let mut j = 0
        while j < n && tokens[j].at < at {
            j += 1
        }
        if j < n && (tokens[j].text == "pub" || tokens[j].text == "fn") {
            // A method whose `self` the body keeps.
            let mut r = 0
            while r < receivers.len() && receivers[r].0 < j {
                r += 1
            }
            if r < receivers.len() && r < by_value.len() && by_value[r] && receivers[r].1 && prefix[receivers[r].0] == "" {
                prefix[receivers[r].0] = "keep "
            }
        } else if j < n && prefix[j] == "" && !guarded[j] && tokens[j].text != "keep" && tokens[j].text != "mut" {
            // **An old `ref` parameter is never kept** (ADR-views-3 D2, D4,
            // #1254): it was a borrow, so the body reads it, hands back a view
            // of it (D7/D8) or stores one (D5), and the lent `T` says that.
            let at_parameter = migrate_ordinal_of(parameters, j)
            if at_parameter < 0 || at_parameter >= lent.len() || !lent[at_parameter] {
                prefix[j] = "keep "
            }
        }
    }
    let mut out: String = ""
    let mut j = 0
    while j < n {
        if !gapless[j] {
            out.push_str(tokens[j].gap)
        }
        out.push_str(prefix[j])
        if !dropped[j] {
            out.push_str(tokens[j].text)
        }
        out.push_str(suffix[j])
        j += 1
    }
    return out
}

/// **A `.nika` file**: the code is the file. `ref` goes first; `keeps_of`
/// then names, in the migrated text, the parameters to mark `keep`: the keep
/// inference is asked about the program the checker will check, since a
/// `ref` still written (a `ref` field, `ref mut self`) changes what it finds.
pub fn migrate_views3_nika(source: String, keeps_of: fn(ref String) -> Vec[i64] sync) -> String sync {
    let by_value = migrate_views3_selves(source.clone())
    let lent = migrate_views3_lent(source.clone())
    let dropped = migrate_views3_code(source, [], [], [])
    let keep_at = keeps_of(dropped)
    return migrate_views3_code(dropped, keep_at, by_value, lent)
}

/// **A Markdown file**: only a fenced block marked `nika` or `nikaia` is
/// code; the prose, and every other block, stays as written.
pub fn migrate_views3_markdown(source: String, keeps_of: fn(ref String) -> Vec[i64] sync) -> String sync {
    let mut out: String = ""
    let mut block: String = ""
    let mut inside = false
    let mut first = true
    for line in source.split("\n") {
        let fence = line.trim()
        if inside && fence == "```" {
            out.push_str(migrate_views3_nika(block, keeps_of))
            block = ""
            inside = false
        }
        if inside {
            block.push_str(line)
            block.push('\n')
        } else {
            if !first {
                out.push('\n')
            }
            first = false
            out.push_str(line)
            if fence == "```nika" || fence == "```nikaia" {
                inside = true
                out.push('\n')
                first = true
            }
        }
    }
    // A block the file never closes: its lines as they stood.
    out.push_str(block.strip_suffix("\n") ?? "")
    return out
}

/// **The parameters the checker would refuse unmarked** (ADR-views-3 D2,
/// `check_keep_marks.nika`'s `NK2302` without its transition rule): each a
/// parameter of a free function or an inherent method that the inference
/// keeps and that says neither `keep` nor `mut`, as the byte offset its
/// declaration starts at. The inference does not decide `self`; the checker
/// and the tier pass do: a bare `self` whose body gives a piece of it away
/// (its `NK1131`, among `findings`) or hands a field or a piece of it back
/// as a result the tier pass makes a view of it (`hands_back_a_piece_of_self`,
/// D7) is named by the offset its method starts at, and
/// `migrate_views3_code` writes `keep self` there where it was the old
/// by-value `self`. An `impl` of a trait takes the trait's marks.
pub fn migrate_views3_keeps(view: ref ParsedView, own: ref Ledger, library: ref Ledger, indexes: KeepsIndexes, resolved: ref collections::BTreeMap[String, CheckMethodCalls], holes_of: fn(ref Expr) -> Vec[Expr] sync, findings: ref Vec[CheckFinding]) -> Vec[i64] {
    let mut out: Vec[i64] = []
    let plain = hb_plain_enums(view.items, view.words)
    for item in view.items {
        match item.node {
            Item::Fn { .. } => {
                migrate_keeps_of_body(view, item, null, own, library, indexes, resolved, holes_of, findings, plain, out)
            },
            Item::Impl { trait_name, target, methods } => {
                if trait_name == null {
                    let target_name = view.text(target.name)
                    for method in methods {
                        migrate_keeps_of_body(view, method, target_name.clone(), own, library, indexes, resolved, holes_of, findings, plain, out)
                    }
                }
            },
            else => {},
        }
    }
    return out
}

fn migrate_keeps_of_body(view: ref ParsedView, item: ref Spanned[Item], target: String?, own: ref Ledger, library: ref Ledger, indexes: KeepsIndexes, resolved: ref collections::BTreeMap[String, CheckMethodCalls], holes_of: fn(ref Expr) -> Vec[Expr] sync, findings: ref Vec[CheckFinding], plain: ref collections::BTreeSet[String], mut out: Vec[i64]) {
    match item.node {
        Item::Fn { args, is_extern, receiver, .. } => {
            if is_extern {
                return
            }
            // A bare `self` reads as lent, as `ref self` did (D1).
            let bare = receiver != null && !(receiver?.is_mut ?? true) && !(receiver?.is_keep ?? true)
            if bare && target != null && hands_back_a_piece_of_self(item.node, view.words, plain) {
                out.push(item.span.start as i64)
            } else if bare && target != null {
                for finding in findings {
                    if finding.code == "NK1131" && finding.message.starts_with("You can't give away `self.") && finding.span.start >= item.span.start && finding.span.end <= item.span.end {
                        out.push(item.span.start as i64)
                        break
                    }
                }
            }
            if args.is_empty() {
                return
            }
            let found = keeps_uses_of(view, item.node, target?.clone(), own, library, indexes, resolved, holes_of) ?? return
            let contract = own.functions[found.key] ?? return
            let copies = keeps_copy_types(view)
            for arg in args {
                let parameter = view.text(arg.name)
                if parameter == "" || parameter == "_" || arg.keep || arg.mutable || !arg.attributes.is_empty() {
                    continue
                }
                // **A copy is never marked `keep`** (ADR-views-3 D2, #1254):
                // a data-less enum or a struct of copied fields is handed over
                // by value, so storing it keeps no caller's value.
                if !arg.ty.is_view && keeps_a_copy_type(written_ty(view.words, view.aliases, arg.ty), copies) {
                    continue
                }
                if contract.keeps.contains(parameter) {
                    out.push(arg.span.start as i64)
                }
            }
        },
        else => {},
    }
}
