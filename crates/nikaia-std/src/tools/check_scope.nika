// crates/nikaia-std/src/tools/check_scope.nika
//
// **The names in scope and the functions a call may mean**, moved from the
// compiler's checker (ADR-294, #125, #558): the innermost binding of a name,
// and the contract a written name resolves to. Each answer is an owned copy -
// a method that returns a view into the state and a name it was given cannot
// say which of the two the view points into (`NK2302`).

/// A function a written name resolves to: the key the ledger records it under,
/// and its contract.
pub struct CheckResolved {
    pub key: String,
    pub contract: ref FnContract,
}

impl CheckState {
    /// The innermost binding of a name, whole.
    pub fn binding(ref self, name: ref String) -> CheckLocal? sync {
        let mut frame_at = self.scope.len()
        while frame_at > 0 {
            frame_at = frame_at - 1
            let frame = self.scope[frame_at]
            let mut at = frame.len()
            while at > 0 {
                at = at - 1
                if frame[at].name == name {
                    return frame[at].clone()
                }
            }
        }
        return null
    }

    /// The innermost frame a name is bound in, or -1.
    pub fn frame_holding(ref self, name: ref String) -> i64 sync {
        let mut frame_at = self.scope.len()
        while frame_at > 0 {
            frame_at = frame_at - 1
            for local in self.scope[frame_at] {
                if local.name == name {
                    return frame_at
                }
            }
        }
        return -1
    }

    /// **What a `let mut` holds here, where it is followed** (Part III C.4):
    /// not inside a loop or a lambda that began after it was bound, which may
    /// run after a later assignment.
    pub fn followed_here(ref self, id: i64, name: ref String) -> Integer? sync {
        let value = self.flow.followed[id]?.clone() ?? return null
        let count = self.repeats.len()
        if count > 0 && self.repeats[count - 1].frame > self.frame_holding(name) {
            return null
        }
        return value
    }

    /// **An assignment to a followed `let mut`**: in the frame it was bound
    /// in, what it now holds where that folds; in a nested block (a branch,
    /// a loop, a lambda), forgotten, since the code after it may or may not
    /// have run it.
    pub fn assigned_followed(ref mut self, world: ref CheckWorld, target: ref Expr, op: ref BinaryOp?, value: ref Expr) sync {
        let name: String = match target {
            Expr::Variable(written, _) => world.words.resolve(written).clone(),
            else => return,
        }
        let local = self.binding(name) ?? return
        let mut next: Integer? = null
        if self.frame_holding(name) == self.scope.len() - 1 {
            next = self.followed_value(world, local.id, op, value)
        }
        if next == null {
            self.flow.followed.remove(local.id)
        } else {
            self.flow.followed.insert(local.id, next ?? return)
        }
    }

    fn followed_value(ref self, world: ref CheckWorld, id: i64, op: ref BinaryOp?, value: ref Expr) -> Integer? sync {
        let given = self.constant_of(world, value) ?? return null
        if given.beyond {
            return null
        }
        if op == null {
            return given.value
        }
        let before = self.flow.followed[id]?.clone() ?? return null
        let o: ref BinaryOp = op ?? return null
        return match o {
            BinaryOp::Add => integer_sum(before, given.value),
            BinaryOp::Sub => integer_difference(before, given.value),
            BinaryOp::Mul => integer_product(before, given.value),
            else => null,
        }
    }

    /// The type of the innermost binding of a name.
    pub fn lookup(ref self, name: ref String) -> Ty? sync {
        let found = self.binding(name) ?? return null
        return found.ty.clone()
    }
}

/// A function by the name a call wrote: this unit's, then a constructor, then a
/// library's - the same order the `sync` check resolves in.
pub fn resolve_call(world: ref CheckWorld, name: ref String) -> CheckResolved? sync {
    if world.own.functions.contains_key(name) {
        let contract = check_scope_found(world.own.functions, name) ?? return null
        return CheckResolved { key: name.clone(), contract: contract }
    }
    let constructed = f"{name}::new"
    if world.own.functions.contains_key(constructed) {
        let contract = check_scope_found(world.own.functions, constructed) ?? return null
        return CheckResolved { key: constructed.clone(), contract: contract }
    }
    if world.library.functions.contains_key(name) {
        let contract = check_scope_found(world.library.functions, name) ?? return null
        return CheckResolved { key: name.clone(), contract: contract }
    }
    // **`std`'s own types are constructed the same way** (ADR-140 D2): `Vec()`
    // is the anonymous constructor, exactly as `Stats(first)` is for a type a
    // `.nika` file declares. The ledger's key stays `Vec::new`, because that is
    // the name the **lowering** writes and the lowering is name for name
    // (ADR-296 D17).
    if world.library.functions.contains_key(constructed) {
        let contract = check_scope_found(world.library.functions, constructed) ?? return null
        return CheckResolved { key: constructed.clone(), contract: contract }
    }
    return null
}

/// A method on a type, by the name `Type::method` the ledger records it under.
/// A library writes the module in front of it (`fs::Mapped::deref`) and the
/// receiver's type may or may not carry one, so both directions are tried.
///
/// **The receiver's own module is dropped on the second try**, since ADR-313 D3
/// put a type in one: a value of `collections::HashMap` has its methods keyed
/// `HashMap::len`, because the module is where the **type** lives and the method
/// belongs to the type.
pub fn resolve_method(world: ref CheckWorld, key: ref String) -> CheckResolved? sync {
    if world.own.functions.contains_key(key) {
        let contract = check_scope_found(world.own.functions, key) ?? return null
        return CheckResolved { key: key.clone(), contract: contract }
    }
    // The first key, in key order, that is `key` or ends in `::{key}`: the
    // index's bucket holds every key that ends so, in key order.
    let mut best: String = ""
    let mut have = false
    if world.library.functions.contains_key(key) {
        best = key.clone()
        have = true
    }
    let ends = method_keys(world.library_methods, key)
    if ends.len() > 0 && (!have || ends[0] < best) {
        best = ends[0].clone()
        have = true
    }
    if have {
        let contract = check_scope_found(world.library.functions, best) ?? return null
        return CheckResolved { key: best.clone(), contract: contract }
    }
    // `collections::HashMap::len` was asked for; `HashMap::len` is the key.
    let at = key.find("::") ?? return null
    let without_the_module = key[at + 2..<key.len()].clone()
    if !without_the_module.contains("::") {
        return null
    }
    if world.own.functions.contains_key(without_the_module) {
        let contract = check_scope_found(world.own.functions, without_the_module) ?? return null
        return CheckResolved { key: without_the_module.clone(), contract: contract }
    }
    if world.library.functions.contains_key(without_the_module) {
        let contract = check_scope_found(world.library.functions, without_the_module) ?? return null
        return CheckResolved { key: without_the_module.clone(), contract: contract }
    }
    return null
}

/// A function's contract by its key, as a view of the ledger's.
fn check_scope_found(functions: ref collections::BTreeMap[String, FnContract], key: String) -> ref FnContract? sync {
    return functions[key]
}
