// crates/nikaia-std/src/tools/check_core_flow.nika
//
// **The arms that choose and the blocks with a rule of their own** (ADR-294,
// #125, #558, C-6, U-c8): `Match`, `If`, `Select`, `Overlap`, `TryCatch` and
// `Unsafe` of the checker's walk (`Block` is the hub `check_core_block`). The
// form is the pilot's (`check_core_pilot.nika`): a free function over the
// state, the world and a host; the walk comes back through the hub
// `check_core_expr`. What a test proves not `null` (ADR-350) is
// `check_narrow.nika`'s. One function per arm, and a `match` arm in a
// function of its own, so a deep expression's frames stay small.

use std::collections

/// A type by its bare name.
fn check_core_flow_named(name: ref String) -> Ty {
    return Ty::Named { name: name.clone(), args: [], view: false }
}

/// The last segment of a path, `ty::base`.
fn check_core_flow_base(name: ref String) -> String {
    let parts: Vec[ref String] = name.split("::").collect()
    if parts.len() == 0 {
        return name.clone()
    }
    let last = parts.len() as i64 - 1
    return f"{parts[last]}"
}

/// Whether a type is `Unknown` itself.
fn check_core_flow_unknown(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Unknown => true,
        else => false,
    }
}

/// The name a variable reads, or the empty text.
fn check_core_flow_variable(world: ref CheckWorld, value: ref Expr) -> String sync {
    return match value {
        Expr::Variable(name, _) => f"{world.words.resolve(name)}",
        else => "".clone(),
    }
}

/// Whether a pattern is the literal `null` (ADR-352 D1).
fn check_core_flow_a_null_pattern(pattern: ref MatchPattern) -> bool sync {
    return match pattern {
        MatchPattern::Literal(literal) => match literal {
            Expr::LitNull(_) => true,
            else => false,
        },
        else => false,
    }
}

/// Whether a pattern is a list pattern (ADR-355).
fn check_core_flow_a_list(pattern: ref MatchPattern) -> bool sync {
    return match pattern {
        MatchPattern::List(_) => true,
        else => false,
    }
}

/// What is inside a `T?`, or the type itself.
fn check_core_flow_inside(ty: ref Ty) -> Ty sync {
    return match ty {
        Ty::Nullable(inner) => inner.clone(),
        else => ty.clone(),
    }
}

/// A view of a slice, `..rest` (ADR-355 D2).
fn check_core_flow_a_slice(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, view, .. } => view && name == "Array",
        else => false,
    }
}

/// Owned text.
fn check_core_flow_owned_text(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, view, .. } => !view && check_core_flow_base(name) == "String",
        else => false,
    }
}

/// The place a chain of fields and brackets starts from.
fn check_core_flow_root(value: ref Expr) -> ref Expr sync {
    return match value {
        Expr::Field { base, .. } => check_core_flow_root(base),
        Expr::Index { base, .. } => check_core_flow_root(base),
        else => value,
    }
}

/// The type a name is bound to in `parts`, where it is bound.
fn check_core_flow_part(parts: ref collections::BTreeMap[String, Ty], wanted: ref String) -> Ty? {
    return parts.get(wanted)?.clone()
}

/// Whether a block hands nothing on: it exits or jumps.
fn check_core_flow_leaves(state: ref CheckState, world: ref CheckWorld, block: ref Block) -> bool sync {
    return state.block_exits(world, block) || state.block_leaves(world, block)
}

/// **A block walked with what `cond` proves when it `holds`** (ADR-350), in a
/// frame of its own where anything is proved.
fn check_core_flow_proved_block[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, cond: ref Expr, holds: bool, block: ref Block) -> Ty sync {
    let markers = check_narrow_proved_here(state, world, cond, holds)
    if markers.len() == 0 {
        return check_core_block(state, world, host, block)
    }
    state.scope.push(markers)
    let value = check_core_block(state, world, host, block)
    state.scope.pop()
    return value
}

/// The type a branch's tail is kept under, for the position the value goes
/// into (#596).
fn check_core_flow_arm_type(mut state: CheckState, block: ref Block, ty: ref Ty) sync {
    let tail: ref Expr = tail_value_of(block) ?? return
    state.arm_types.insert(id_of(check_peeled(tail)) as i64, ty.clone())
}

/// An open number beside a typed one takes its type.
fn check_core_flow_number_open(mut state: CheckState, world: ref CheckWorld, typed: ref Ty, open: ref Expr?, span: ref Span) -> Ty? sync {
    let opened: ref Expr = open ?? return null
    let number = value_of_a_copy(typed.unseen())
    if integer_named(number) == null || !state.number_shaped(world, opened) {
        return null
    }
    state.number_asked(world, opened, number, span, true)
    return number
}

/// **One branch typed, the other an open number** (#497).
fn check_core_flow_number_beside(mut state: CheckState, world: ref CheckWorld, a_tail: ref Expr?, a: ref Ty, b_tail: ref Expr?, b: ref Ty, span: ref Span) -> Ty? sync {
    if !a.is_unknown() && b.is_unknown() {
        return check_core_flow_number_open(state, world, a, b_tail, span)
    }
    if a.is_unknown() && !b.is_unknown() {
        return check_core_flow_number_open(state, world, b, a_tail, span)
    }
    return null
}

/// Whether an arm's tail ends in text.
fn check_core_flow_ends_in_text(tail: ref Expr?) -> bool sync {
    let t: ref Expr = tail ?? return false
    return ends_in_text(t)
}

/// **Arms that meet at text** (ADR-282 D4).
fn check_core_flow_meet_at_text(mut state: CheckState, world: ref CheckWorld, arms: ref Vec[CheckArm], span: ref Span) -> Ty? sync {
    let text = check_core_flow_named("String")
    let mut any = false
    for arm in arms {
        if arm.ty == text {
            any = true
        }
    }
    if !any {
        return null
    }
    for arm in arms {
        state.a_name_in_text(world, text, arm.tail, span)
    }
    for arm in arms {
        if arm.ty != text && !check_core_flow_ends_in_text(arm.tail) {
            return null
        }
    }
    for arm in arms {
        if arm.ty != text {
            let tail: ref Expr = arm.tail ?? continue
            state.text_literal(world, text, tail, true)
        }
    }
    return text
}

/// **A `match` arm whose value is not used** (#596): the arm, and the tail of
/// the block it is, are statements.
fn check_core_flow_arm_discarded(mut state: CheckState, body: ref Expr) sync {
    state.discarded.insert(id_of(body) as i64)
    state.discarded.insert(id_of(check_peeled(body)) as i64)
    match body {
        Expr::Block(block, _) => check_core_stmt_body_discarded(state, block),
        else => {},
    }
}

/// **Arms whose types differ**: said once, at the first arm that is not the
/// first one's type.
fn check_core_flow_disagree(mut state: CheckState, world: ref CheckWorld, expr: ref Expr, arms: ref Vec[CheckArm], span: ref Span) sync {
    if state.discarded.contains(id_of(expr) as i64) {
        return
    }
    let is_if = match expr {
        Expr::If { .. } => true,
        else => false,
    }
    let mut finding: CheckFinding = arms_that_disagree(arms, is_if, span) ?? return
    let mut at = check_span_at(world, expr, span)
    if arms.len() > 0 {
        let first = arms[0].ty.unseen()
        let mut i = 1
        while i < arms.len() as i64 {
            if arms[i].ty.unseen() != first && arms[i].tail != null {
                at = check_span_at(world, arms[i].tail ?? expr, span)
                break
            }
            i += 1
        }
    }
    finding.span = at
    state.arm_disagreements.insert(id_of(expr) as i64, finding)
}

/// **What arms that disagree come to**: text, `null` beside a value, or
/// nothing known, said.
fn check_core_flow_meet(mut state: CheckState, world: ref CheckWorld, expr: ref Expr, arms: ref Vec[CheckArm], span: ref Span) -> Ty sync {
    let text = check_core_flow_meet_at_text(state, world, arms, span)
    if text != null {
        return text ?? Ty::Unknown
    }
    let at_null = state.arms_meet_at_null(world, arms)
    if at_null != null {
        return at_null ?? Ty::Unknown
    }
    check_core_flow_disagree(state, world, expr, arms, span)
    return Ty::Unknown
}

/// **`unsafe { … }`** (ADR-302 D3): a block whose calls may name an `extern`.
pub fn check_core_flow_unsafe[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, block: ref Block) -> Ty sync {
    let outer = state.inside_unsafe
    state.inside_unsafe = true
    let value = check_core_block(state, world, host, block)
    state.inside_unsafe = outer
    return value
}

/// One branch of an `overlap`.
fn check_core_flow_branch[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, stmt: ref Stmt, span: ref Span) -> Ty sync {
    match stmt {
        Stmt::Expr(value) => {
            return check_core_expr(state, world, host, value, span)
        },
        else => {
            check_core_stmt(state, world, host, stmt, span)
        },
    }
    return Ty::Unknown
}

/// **`overlap { … }`** (Part I 8.1.2, ADR-292 D2): each statement is a
/// branch, an `async` block of its own, and the value is their tuple.
pub fn check_core_flow_overlap[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, block: ref Block, span: ref Span) -> Ty sync {
    state.scope.push([])
    let mut parts: Vec[Ty] = []
    for stmt in block.stmts {
        let saved = state.enter_boundary("`overlap` branch")
        let ty = check_core_flow_branch(state, world, host, stmt.node, stmt.span)
        state.leave_boundary(saved)
        parts.push(ty)
    }
    state.scope.pop()
    state.branches_meet_on_nothing(world, block)
    return Ty::Tuple(parts)
}

/// The frame a `select` arm binds: its one name, or nothing for `_`.
fn check_core_flow_select_frame(mut state: CheckState, world: ref CheckWorld, binding: winnow_grammar::Symbol?, raced: Ty) -> Vec[CheckLocal] sync {
    let name = binding ?? return []
    let id = state.a_new_binding()
    return [CheckLocal::free(f"{world.words.resolve(name)}", raced, id)]
}

/// One arm of a `select`: its type, or `null` where it jumps or is of no
/// known type.
fn check_core_flow_select_arm[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, arm: ref SelectArm, span: ref Span) -> Ty? sync {
    let saved = state.enter_boundary("`select` arm")
    let raced = check_core_expr(state, world, host, arm.value, span)
    state.leave_boundary(saved)
    let frame = check_core_flow_select_frame(state, world, arm.binding, raced)
    state.scope.push(frame)
    let inner = state.enter_boundary("`select` arm")
    let ty = check_core_block(state, world, host, arm.body)
    state.leave_boundary(inner)
    state.scope.pop()
    if state.block_leaves(world, arm.body) {
        return null
    }
    if ty.is_unknown() {
        return null
    }
    return ty
}

/// **`select`** (Part II 12.4, ADR-292 D12): the `match` rule one construct
/// over.
pub fn check_core_flow_select[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, arms: ref Vec[SelectArm], span: ref Span) -> Ty sync {
    let mut seen = Ty::Unknown
    let mut any = false
    let mut agree = true
    for arm in arms {
        let got = check_core_flow_select_arm(state, world, host, arm, span)
        if got != null {
            let ty = got ?? Ty::Unknown
            if !any {
                seen = ty
                any = true
            } else if seen != ty {
                agree = false
            }
        }
    }
    if any && agree {
        return seen
    }
    return Ty::Unknown
}

/// The `else` of an `if`, and what the two branches come to.
fn check_core_flow_else[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, expr: ref Expr, cond: ref Expr, then_branch: ref Block, then: ref Ty, otherwise: ref Block, choice: i64, span: ref Span) -> Ty sync {
    state.branch.push((choice, 1))
    let from = state.taken_so_far()
    let other = check_core_flow_proved_block(state, world, host, cond, false, otherwise)
    let leaves = check_core_flow_leaves(state, world, otherwise)
    state.a_branch_that_leaves(from, leaves, span)
    state.branch.pop()
    // **An arm that leaves gives no value** (#375).
    let then_leaves = check_core_flow_leaves(state, world, then_branch)
    let other_leaves = check_core_flow_leaves(state, world, otherwise)
    // **Each arm's type is kept for the position the value goes into** (#596).
    if !then_leaves {
        check_core_flow_arm_type(state, then_branch, then)
    }
    if !other_leaves {
        check_core_flow_arm_type(state, otherwise, other)
    }
    if then == other || (other_leaves && !then_leaves) {
        return then.clone()
    }
    if then_leaves && !other_leaves {
        return other
    }
    let typed = check_core_flow_number_beside(state, world, tail_value_of(then_branch), then, tail_value_of(otherwise), other, span)
    if typed != null {
        return typed ?? Ty::Unknown
    }
    let arms: Vec[CheckArm] = [CheckArm { tail: tail_value_of(then_branch), ty: then.clone() }, CheckArm { tail: tail_value_of(otherwise), ty: other }]
    return check_core_flow_meet(state, world, expr, arms, span)
}

/// **`if`** (Part I 3.2): a `bool` decides, a stamped condition reaches inward
/// (ADR-281 D25), and what the test proves holds in each branch and, after an
/// early exit, in the rest of the block (ADR-350).
pub fn check_core_flow_if[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, expr: ref Expr, cond: ref Expr, then_branch: ref Block, else_branch: ref Block?, span: ref Span) -> Ty sync {
    let cond_ty = check_core_expr(state, world, host, cond, span)
    let at = check_span_at(world, cond, span)
    state.expect_bool(cond_ty, at, "An `if` decides on a `bool`.")
    let outer_condition = state.stamped_condition
    if cond_ty.is_seen() {
        state.stamped_condition = span.start as i64
    }
    // **An `if` whose value is not used hands that on to its arms** (#596):
    // an `else if` and an arm's own tail `if` or `match` are statements too.
    if state.discarded.contains(id_of(expr) as i64) {
        check_core_stmt_body_discarded(state, then_branch)
        if else_branch != null {
            let otherwise: ref Block = else_branch ?? then_branch
            check_core_stmt_body_discarded(state, otherwise)
        }
    }
    let choice = state.flow.next_choice
    state.flow.next_choice += 1
    state.branch.push((choice, 0))
    let from = state.taken_so_far()
    let then = check_core_flow_proved_block(state, world, host, cond, true, then_branch)
    // **A `continue` or a `break` leaves the turn as a `return` leaves the
    // function**.
    let leaves = check_core_flow_leaves(state, world, then_branch)
    state.a_branch_that_leaves(from, leaves, span)
    state.branch.pop()
    let mut branches = Ty::Unknown
    let mut else_leaves = false
    if else_branch != null {
        let otherwise: ref Block = else_branch ?? then_branch
        branches = check_core_flow_else(state, world, host, expr, cond, then_branch, then, otherwise, choice, span)
        else_leaves = check_core_flow_leaves(state, world, otherwise)
    }
    state.stamped_condition = outer_condition
    // **An early exit proves the rest of the block** (ADR-350 D3).
    let then_leaves = check_core_flow_leaves(state, world, then_branch)
    if then_leaves && !else_leaves {
        check_narrow_proved_from_here(state, world, cond, false)
    } else if else_leaves && !then_leaves {
        check_narrow_proved_from_here(state, world, cond, true)
    }
    return branches
}

/// The member of several errors an arm's pattern names (ADR-280 D30, D17).
fn check_core_flow_member(world: ref CheckWorld, members: ref Vec[Ty], pattern: ref MatchPattern) -> Ty sync {
    let path: Vec[winnow_grammar::Symbol] = match pattern {
        MatchPattern::Path(p) => p.clone(),
        MatchPattern::Tuple { path, .. } => path.clone(),
        MatchPattern::Named { path, .. } => path.clone(),
        else => [],
    }
    let mut owner: String = ""
    if path.len() >= 2 {
        let mut at = 0
        while at < path.len() as i64 - 1 {
            if at > 0 {
                owner = f"{owner}::"
            }
            owner = f"{owner}{world.words.resolve(path[at])}"
            at += 1
        }
    }
    for member in members {
        if member.text() == owner {
            return member.clone()
        }
    }
    return Ty::Unknown
}

/// **A field reached through a view is matched as the view it is**, and so is
/// one reached through the brackets of a view.
fn check_core_flow_through_a_view(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    let a_place = match value {
        Expr::Field { .. } => true,
        Expr::Index { .. } => true,
        else => false,
    }
    if !a_place {
        return false
    }
    let root = check_core_flow_root(value)
    let name = check_core_flow_variable(world, root)
    if name == "" {
        return false
    }
    let local: CheckLocal = state.binding(name) ?? return false
    return local.lent || local.ty.is_a_view()
}

/// **A name lent to this function's walk** (`Local::lent`).
fn check_core_flow_a_lent_name(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    let name = check_core_flow_variable(world, value)
    if name == "" {
        return false
    }
    let local: CheckLocal = state.binding(name) ?? return false
    return local.lent
}

/// **The guard is walked inside the arm's scope** (ADR-291 D2).
fn check_core_flow_guard[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, pattern: ref MatchPattern, guard: ref Expr, span: ref Span) sync {
    let boxed = state.boxed_names(world, pattern)
    let last = state.scope.len() as i64 - 1
    let mut saved: Vec[CheckLocal] = []
    // The frame a guard reads: a part bound whole out of a box is a view of
    // it there (ADR-246 D5 item 2, #97); after the guard it is put back.
    if last >= 0 {
        saved = state.scope[last].clone()
        for at in 0..<saved.len() {
            if boxed.contains(saved[at].name) {
                state.scope[last][at].ty = view_of_type(saved[at].ty)
                state.scope[last][at].lent = true
            }
        }
    }
    let found = check_core_expr(state, world, host, guard, span)
    if last >= 0 {
        for at in 0..<saved.len() {
            if at < state.scope[last].len() && boxed.contains(saved[at].name) {
                state.scope[last][at].ty = saved[at].ty.clone()
                state.scope[last][at].lent = saved[at].lent
            }
        }
    }
    let at = check_span_at(world, guard, span)
    state.expect_bool(found, at, "A `match` guard is a condition.")
}

/// The box rule's question about a guard, where there is one.
fn check_core_flow_guard_box[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, pattern: ref MatchPattern, body: ref Expr, guard: ref Expr?) sync {
    let g: ref Expr = guard ?? return
    state.a_guard_reading_inside_a_box(world, host, pattern, body, g)
}

/// The guard walked, where there is one.
fn check_core_flow_a_guard[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, pattern: ref MatchPattern, guard: ref Expr?, span: ref Span) sync {
    let g: ref Expr = guard ?? return
    check_core_flow_guard(state, world, host, pattern, g, span)
}

/// The parts a `match` arm binds, as its scope sees them (ADR-291, 0.0.252,
/// #171).
fn check_core_flow_parts(mut state: CheckState, world: ref CheckWorld, pattern: ref MatchPattern, typed: ref Ty, lendable: bool) -> collections::BTreeMap[String, Ty] sync {
    let parts = state.pattern_parts(world, pattern, typed)
    if lendable || !typed.is_a_view() {
        return parts
    }
    let mut out: collections::BTreeMap[String, Ty] = collections::BTreeMap()
    for (name, ty) in parts {
        if state.copied(world, ty) {
            out.insert(name.clone(), ty.clone())
        } else {
            out.insert(name.clone(), view_of_type(ty))
        }
    }
    return out
}

/// **A part copied out at the head of the arm** (0.0.236, ADR-246 D5,
/// ADR-355 D5).
fn check_core_flow_copied_parts(mut state: CheckState, world: ref CheckWorld, arm: ref MatchArm, typed: ref Ty) sync {
    let at = id_of(arm.body) as i64
    let mut parts = state.pattern_parts(world, arm.pattern, typed)
    state.typed_inside_boxes(world, arm.pattern, parts)
    for (name, ty) in parts {
        // A view of a slice, `..rest`, is already the reference.
        let a_slice = check_core_flow_a_slice(ty)
        if (state.copied(world, ty) || ty.is_a_view()) && !a_slice {
            state.facts.copied_bindings.insert((at, name.clone()))
        }
    }
}

/// **Owned text bound through a lent value is a `&String` below** (#125).
fn check_core_flow_owned_texts(mut state: CheckState, world: ref CheckWorld, pattern: ref MatchPattern, typed: ref Ty) -> collections::BTreeSet[String] sync {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    let parts = state.pattern_parts(world, pattern, typed)
    for (name, ty) in parts {
        if check_core_flow_owned_text(ty) {
            out.insert(name.clone())
        }
    }
    return out
}

/// The frame a `match` arm binds.
fn check_core_flow_frame(mut state: CheckState, world: ref CheckWorld, pattern: ref MatchPattern, at: i64, parts: ref collections::BTreeMap[String, Ty], lent_parts: bool, owned_text: ref collections::BTreeSet[String]) -> Vec[CheckLocal] sync {
    let names = pattern_names(world, pattern)
    let mut bound: Vec[CheckLocal] = []
    for name in names {
        let id = state.a_new_binding()
        bound.push(CheckLocal::free(name.clone(), Ty::Unknown, id))
    }
    let mut frame: Vec[CheckLocal] = []
    for local in bound {
        let found = check_core_flow_part(parts, local.name)
        if found == null {
            frame.push(local.clone())
            continue
        }
        let ty = found ?? Ty::Unknown
        let text = owned_text.contains(local.name)
        let id = state.a_new_binding()
        state.arm_bound.insert(id, at)
        let mut kept = CheckLocal::free(local.name.clone(), ty.clone(), id)
        kept.lent = lent_parts && (!state.copied(world, ty) || text)
        frame.push(kept)
    }
    return frame
}

/// **A part lent where it is not kept** (ADR-291).
fn check_core_flow_lent_parts[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, body: ref Expr, parts: ref collections::BTreeMap[String, Ty], from: i64, changed_from: i64, bound_by_reference: bool, a_list: bool) sync {
    let lent = state.parts_lent(world, body, parts, from, changed_from)
    // **An element a list pattern keeps is taken** (ADR-355 D5, Part I 3.4,
    // #622): the slice below lends it, so the arm opens with its clone, and
    // the list, which the arm took, is gone afterwards as anywhere else.
    if a_list {
        for (name, part) in parts {
            if !lent.contains(name) && !part.is_a_view() && !state.copied(world, part) {
                state.facts.cloned_bindings.insert((id_of(body) as i64, name.clone()))
            }
        }
    }
    if lent.len() > 0 {
        state.a_lent_part_is_handed_on_as_it_is(world, host, body, lent)
        if !bound_by_reference {
            state.facts.lent_bindings.insert(id_of(body) as i64, lent)
        }
    }
}

/// **One arm of a `match`**: its type, or `null` where it jumps (ADR-276 D1).
fn check_core_flow_arm[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, value: ref Expr, on: ref Ty, arm: ref MatchArm, typed: ref Ty, lendable: bool, through_the_reference: bool, mut_subject: ref String?, choice: i64, taken: i64, span: ref Span) -> Ty? sync {
    // **Every alternative of an or-pattern binds the same names** (ADR-291 D1).
    state.an_or_pattern_that_binds_unevenly(world, arm.pattern, span)
    state.a_pattern_naming_a_member_a_type_does_not_have(world, arm.pattern, span)
    state.a_pattern_inside_a_box(world, arm.pattern, span)
    check_core_flow_guard_box(state, world, host, arm.pattern, arm.body, arm.guard)
    let parts = check_core_flow_parts(state, world, arm.pattern, typed, lendable)
    let a_list = check_core_flow_a_list(arm.pattern)
    if typed.is_a_view() || through_the_reference || a_list {
        check_core_flow_copied_parts(state, world, arm, typed)
    }
    let lent_parts = !lendable && typed.is_a_view()
    let mut owned_text: collections::BTreeSet[String] = collections::BTreeSet()
    if lent_parts {
        owned_text = check_core_flow_owned_texts(state, world, arm.pattern, typed)
    }
    let frame = check_core_flow_frame(state, world, arm.pattern, id_of(arm.body) as i64, parts, lent_parts, owned_text)
    state.scope.push(frame)
    state.branch.push((choice, taken))
    let from = state.taken_so_far()
    let (_, handed_from) = state.taken_so_far()
    let changed_from = state.changed.len() as i64
    check_core_flow_a_guard(state, world, host, arm.pattern, arm.guard, span)
    let ty = check_core_expr(state, world, host, arm.body, span)
    // **A name that is a view binds by reference by itself** (D30).
    let name = check_core_flow_variable(world, value)
    let by_reference = through_the_reference || a_list || (name != "" && (on.is_a_view() || state.got_past_a_jump.contains(name)))
    check_core_flow_lent_parts(state, world, host, arm.body, parts, handed_from, changed_from, by_reference, a_list)
    let leaves = state.exits(world, arm.body)
    state.a_branch_that_leaves(from, leaves, span)
    if mut_subject != null {
        state.parts_taken_out_of_a_mut_parameter(world, mut_subject ?? "", arm.body, typed, parts, handed_from)
    }
    state.branch.pop()
    state.scope.pop()
    if state.leaves(world, arm.body) {
        return null
    }
    return ty
}

/// `error` in a handler, untyped at its binding, read as the one type that
/// arrived.
fn check_core_flow_caught(state: ref CheckState, world: ref CheckWorld, on: ref Ty, value: ref Expr) -> Ty sync {
    if check_core_flow_unknown(on) && check_core_flow_variable(world, value) == "error" && !state.flow.caught_several {
        return state.flow.caught_one?.clone() ?? Ty::Unknown
    }
    return on.clone()
}

/// **`match`** (Part I 3.4): the subject, read as what it is below; each arm
/// in a scope of its own; and the arms' types, met.
pub fn check_core_flow_match[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, expr: ref Expr, value: ref Expr, arms: ref Vec[MatchArm], span: ref Span) -> Ty sync {
    let on = check_core_expr(state, world, host, value, span)
    // **A name an enclosing arm bound** (`match_on_a_lent_name.rs`): where that arm
    // lends it, the lowering matches what it points to.
    let subject = check_core_flow_variable(world, value)
    if subject != "" {
        let bound = state.binding(subject)
        if bound != null {
            let id = bound?.id ?? -1
            if state.arm_bound.contains_key(id) {
                let arm = state.arm_bound.get(id) ?? -1
                state.facts.arm_subjects.insert(id_of(value) as i64, arm)
            }
        }
    }
    let several: Vec[Ty] = several_errors_of(on)
    let mut typed = check_core_flow_caught(state, world, on, value)
    // Several: each arm's pattern names its member (D17, D18).
    if !check_core_flow_unknown(on) && several.len() > 0 {
        typed = Ty::Unknown
    }
    // **With a `null` arm, the other arms match the `T`** (ADR-352 D1).
    let mut null_arm = false
    for arm in arms {
        if check_core_flow_a_null_pattern(arm.pattern) {
            null_arm = true
        }
    }
    if null_arm {
        typed = check_core_flow_inside(typed)
    }
    let lendable = state.an_owned_place(world, value, typed)
    // **A `match` over a `mut` parameter, or a place in one** (#576).
    let mut_subject: String? = state.a_mut_parameter_place(world, value)
    let a_variable = match value {
        Expr::Variable(_, _) => true,
        else => false,
    }
    let through_the_reference = mut_subject != null && a_variable
    let through_a_view = check_core_flow_through_a_view(state, world, value)
    if through_a_view && !typed.is_a_view() && state.takes_away(world, typed) {
        state.facts.lent_scrutinees.insert(id_of(value) as i64)
        typed = view_of_type(typed)
    }
    // **And so is a name lent to this function's walk**, and a `let` over a
    // place (#567).
    let lent_name = check_core_flow_a_lent_name(state, world, value) || state.a_lent_let(world, value)
    if lent_name && !typed.is_a_view() && state.takes_away(world, typed) {
        typed = view_of_type(typed)
    }
    // **A `match` is a condition too** (ADR-281 D25).
    let outer_condition = state.stamped_condition
    if on.is_seen() {
        state.stamped_condition = span.start as i64
    }
    let mut seen = Ty::Unknown
    let mut any = false
    let mut agree = true
    let mut answered: Vec[CheckArm] = []
    let choice = state.flow.next_choice
    state.flow.next_choice += 1
    let mut taken = 0
    if state.discarded.contains(id_of(expr) as i64) {
        for arm in arms {
            check_core_flow_arm_discarded(state, arm.body)
        }
    }
    for arm in arms {
        // **An error, one of several, is taken apart by member** (ADR-280 D30).
        let mut arm_typed = typed.clone()
        if several.len() > 0 {
            arm_typed = check_core_flow_member(world, several, arm.pattern)
        }
        let got = check_core_flow_arm(state, world, host, value, on, arm, arm_typed, lendable, through_the_reference, mut_subject, choice, taken, span)
        taken += 1
        if got != null {
            let ty = got ?? Ty::Unknown
            answered.push(CheckArm { tail: arm.body, ty: ty.clone() })
            state.arm_types.insert(id_of(check_peeled(arm.body)) as i64, ty.clone())
            if !any {
                seen = ty
                any = true
            } else if seen != ty {
                agree = false
            }
        }
    }
    state.stamped_condition = outer_condition
    state.a_match_over_several_error_types(world, value, arms, span)
    let over = check_core_flow_caught(state, world, on, value)
    state.a_match_that_misses_a_case(world, over, arms, span)
    state.a_variant_matched_on_a_nullable(world, over, value, arms, span)
    state.a_null_arm_on_a_plain_value(world, over, value, arms, span)
    if any && agree {
        return seen
    }
    return check_core_flow_meet(state, world, expr, answered, span)
}

/// Mark the nearest guard as one with no answer (ADR-308).
fn check_core_flow_no_answer(mut state: CheckState) sync {
    let mut guarded: CheckGuarded = state.flow.guarded?.clone() ?? return
    guarded.unanswered = true
    state.flow.guarded = guarded
}

/// The lambda's own record of a `catch` (ADR-277 D7): set, and what it was.
fn check_core_flow_lambda_caught(mut state: CheckState, caught: bool) -> bool? sync {
    let mut handed: CheckHanded = state.handed_over?.clone() ?? return null
    let was = handed.caught
    handed.caught = caught
    state.handed_over = handed
    return was
}

/// **`error` is what the guarded calls throw** (Part I 7.1, #501, ADR-280
/// D30).
fn check_core_flow_caught_type(guarded: ref CheckGuarded) -> Ty sync {
    if guarded.unanswered {
        return Ty::Unknown
    }
    let mut thrown: Vec[String] = []
    let mut unknown = false
    for name in guarded.thrown {
        if name == "?" || throws_given(name) {
            unknown = true
        }
        thrown.push(name.clone())
    }
    if unknown {
        return Ty::Unknown
    }
    if thrown.len() == 1 {
        return check_core_flow_named(thrown[0])
    }
    if thrown.len() >= 2 {
        let mut args: Vec[Ty] = []
        for name in thrown {
            args.push(check_core_flow_named(name))
        }
        return Ty::Named { name: "Error".clone(), args: args, view: false }
    }
    return Ty::Unknown
}

/// The text literal a handler ends in, built where the guarded value is
/// (ADR-282 D3).
fn check_core_flow_handler_text(mut state: CheckState, world: ref CheckWorld, answers: ref Ty, handler: ref Block) -> Ty? sync {
    let tail: ref Expr = tail_value_of(handler) ?? return null
    return state.text_literal(world, answers, tail, true)
}

/// **`expr catch { … }`** (Part I 7.1): the guarded expression needs no
/// `throws` (`NK2605`), the handler binds `error`, and the value is the
/// guarded one's type where the handler agrees (0.0.230).
pub fn check_core_flow_try_catch[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, guarded_expr: ref Expr, handler: ref Block, span: ref Span) -> Ty sync {
    let outer = state.flow.caught
    state.flow.caught = true
    let lambda_outer = check_core_flow_lambda_caught(state, true)
    // **A guard of its own, and the enclosing one set aside** (ADR-308).
    let enclosing: CheckGuarded? = state.flow.guarded?.clone()
    state.flow.guarded = CheckGuarded::nothing()
    let answers = check_core_expr(state, world, host, guarded_expr, span)
    let held: CheckGuarded? = state.flow.guarded?.clone()
    state.flow.guarded = enclosing
    if state.flow.guarded != null {
        check_core_flow_no_answer(state)
    }
    state.flow.caught = outer
    if lambda_outer != null {
        check_core_flow_lambda_caught(state, lambda_outer ?? false)
    }
    let guarded: CheckGuarded = held ?? CheckGuarded::nothing()
    state.a_fatal_error_passes(world, guarded, handler, span)
    let caught = check_core_flow_caught_type(guarded)
    state.nothing_here_can_fail(guarded, span)
    let id = state.a_new_binding()
    state.scope.push([CheckLocal::free("error".clone(), caught, id)])
    // **A set that cannot be named is open** (ADR-351 D4): a `match` over it
    // covers nothing without `else`, as one over several types does.
    let mut open = false
    for thrown in guarded.thrown {
        if thrown == "?" || throws_given(thrown) {
            open = true
        }
    }
    let arriving = state.several_arrive(world, guarded_expr) || open
    let one: Ty? = state.the_one_error(world, guarded_expr)
    let several = state.flow.caught_several
    state.flow.caught_several = arriving
    let single: Ty? = state.flow.caught_one?.clone()
    state.flow.caught_one = one
    let from = state.taken_so_far()
    let handled = check_core_block(state, world, host, handler)
    let literal = check_core_flow_handler_text(state, world, answers, handler)
    let leaves = state.block_exits(world, handler)
    state.a_branch_that_leaves(from, leaves, span)
    state.flow.caught_several = several
    state.flow.caught_one = single
    state.scope.pop()
    let value = literal ?? handled
    if state.block_leaves(world, handler) || value.is_unknown() || value.fits(answers) {
        return answers
    }
    return Ty::Unknown
}
