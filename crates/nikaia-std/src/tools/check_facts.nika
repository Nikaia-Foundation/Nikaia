            boxed_reads: collections::BTreeSet(),
            copied_bindings: collections::BTreeSet(),
            changed_copies: collections::BTreeSet(),
            changed_bindings: collections::BTreeSet(),
            cloned_bindings: collections::BTreeSet(),
            some_tails: collections::BTreeSet(),
            mixed_leaves: collections::BTreeMap(),
            mixed_choices: collections::BTreeSet(),
            lent_options: collections::BTreeSet(),
            wrapped: collections::BTreeMap(),
            compared_views: collections::BTreeSet(),
            compared_numbers: collections::BTreeSet(),
            ordered_texts: collections::BTreeSet(),
            claims: collections::BTreeMap(),
            entries: collections::BTreeMap(),
            reaches: collections::BTreeMap(),
            published: collections::BTreeMap(),
            mut_args: collections::BTreeSet(),
            mut_arg_bindings: collections::BTreeMap(),
            reborrowed_args: collections::BTreeSet(),
            copied_args: collections::BTreeSet(),
            settle_fns: collections::BTreeMap(),
            settle_lets: collections::BTreeMap(),
            lent_lets: collections::BTreeSet(),
            lent_returns: collections::BTreeSet(),
            compares: collections::BTreeSet(),
            compares_totally: collections::BTreeSet(),
            copies: collections::BTreeSet(),
            viewed_numbers: collections::BTreeSet(),
            array_literals: collections::BTreeSet(),
            byte_literals: collections::BTreeSet(),
            owned_texts: collections::BTreeSet(),
            text_bytes: collections::BTreeSet(),
            text_scalars: collections::BTreeSet(),
            text_graphemes: collections::BTreeSet(),
            kept_text_bytes: collections::BTreeSet(),
            byte_copies: collections::BTreeSet(),
            map_drains: collections::BTreeSet(),
            par_folds: collections::BTreeSet(),
            in_place_folds: collections::BTreeMap(),
            kept_drains: collections::BTreeSet(),
            kept_byte_fields: collections::BTreeSet(),
            lent_list_reads: collections::BTreeSet(),
            lent_reads: collections::BTreeSet(),
            view_fallbacks: collections::BTreeSet(),
            map_read_views: collections::BTreeSet(),
            keep_plans: null,
        }
    }
}

/// How the compiler holds one `assert`, as `--asserts` says it (ADR-269 D7).
fn check_claim_held(held: ref ClaimHeld?) -> String {
    let given = held ?? return "refused: a claim about data from outside the program".clone()
    return match given {
        ClaimHeld::Proved => "proved".clone(),
        ClaimHeld::ProvedThrough(how) => how.clone(),
        ClaimHeld::Precondition(f, n) => {
            // **`main`'s caller is the command line** (ADR-360 D4).
            if f == "main" {
                "precondition of `main`, checked where the words arrive".clone()
            } else if n == 0 {
                f"precondition of `{f}`: proved at every call the compiler sees; any other reaches the entry that checks it"
            } else if n == 1 {
                f"precondition of `{f}`: one call checks it when it runs; any other call proves it or reaches the entry that checks it"
            } else {
                f"precondition of `{f}`: {n} calls check it when they run; any other call proves it or reaches the entry that checks it"
            }
        }
        ClaimHeld::AtRunTime(why) => f"checked at run time: {why}",
        ClaimHeld::ByTheTest => "checked when the test runs".clone(),
        ClaimHeld::Refused => "refused: a claim about data from outside the program".clone(),
    }
}

/// How a claim the build refuses as not proved (`NK1300`, ADR-380 D1) is
/// listed; nothing where it is not refused so.
fn check_claim_refused(held: ref ClaimHeld?) -> String? {
    let given = held ?? return null
    match given {
        ClaimHeld::AtRunTime(why) => return f"refused, not proved: {why}",
        ClaimHeld::Precondition(f, n) => {
            if f == "main" || n == 0 {
                return null
            }
            if n == 1 {
                return f"refused, precondition of `{f}`: one call does not prove it"
            }
            return f"refused, precondition of `{f}`: {n} calls do not prove it"
        },
        else => return null,
    }
}

/// **`--asserts`** (ADR-269 D7): every `assert` of one file, by line, how
/// the compiler holds it, and how many of each. What is not proved comes
/// first, in red - refused, checked at run time, checked by a test -, then
/// what is checked where outside data arrives (`main`'s preconditions), in
/// light blue, and what the build proved last, in green: proved claims, and
/// preconditions proved at every call. Within a group the claims are in the
/// order of their lines; `colour` asks for the colours. `published` gives
/// `main`'s preconditions carried back from a callee (ADR-269 D15, ADR-360
/// D3), which no `assert` of `main` states: each is a row of its own.
pub fn check_claims_report(claims: ref collections::BTreeMap[(i64, i64), FactClaim], source: ref String, path: ref String, published: ref collections::BTreeMap[String, Published], colour: bool, refuses: bool) -> String {
    let mut refused: Vec[String] = []
    let mut at_run_time: Vec[String] = []
    let mut arrives: Vec[String] = []
    let mut by_the_test: Vec[String] = []
    let mut proved: Vec[String] = []
    let mut through_loops = 0
    let mut preconditions: Vec[String] = []
    let mut assumed: Vec[String] = []
    let mut mains: collections::BTreeSet[String] = collections::BTreeSet()
    let mut line = 1
    let mut at = 0
    for (key, claim) in claims {
        let mut start = key.0
        if start > source.len() {
            start = source.len()
        }
        if start > at {
            for c in source.bytes[at..<start] {
                if c == '\n' {
                    line = line + 1
                }
            }
            at = start
        }
        // **Every `assume` is listed** (ADR-376 D3): vouched for, not proved.
        if claim.assumed {
            assumed.push(f"  {path}:{line}  {claim.written}  assumed: a fact the program vouches for in `unsafe`, checked only where the build removes no checks")
            continue
        }
        // **Where the build refuses what it did not prove** (ADR-380 D1),
        // such a claim is refused, not checked at run time.
        let how = match refuses {
            true => check_claim_refused(claim.held) ?? check_claim_held(claim.held),
            false => check_claim_held(claim.held),
        }
        let row = f"  {path}:{line}  {claim.written}  {how}"
        if how == "proved" {
            proved.push(row)
        } else if how.starts_with("proved through") {
            through_loops += 1
            proved.push(row)
        } else if how.starts_with("precondition of `main`") {
            mains.insert(claim.written.clone())
            arrives.push(row)
        } else if how.starts_with("precondition") && how.contains("proved at every call") {
            preconditions.push(row)
        } else if how.starts_with("precondition") || how.starts_with("checked at run time") {
            at_run_time.push(row)
        } else if how.starts_with("checked when") {
            by_the_test.push(row)
        } else if claim.held != null {
            refused.push(row)
        }
    }
    let main = published["main"]
    if main != null {
        let entry = main?.clone() ?? Published::nothing()
        for k in 0..<entry.requires.len() {
            if k >= entry.from.len() {
                continue
            }
            let from = entry.from[k]
            if mains.contains(from) {
                continue
            }
            arrives.push(f"  {path}  {entry.requires[k]}  precondition of `main` carried back from `{from}`, checked where the words arrive")
        }
    }
    let unproved = refused.len() + at_run_time.len() + by_the_test.len()
    let done = proved.len() + preconditions.len()
    // **What a loop carried** (ADR-361 D7), counted where there is any.
    let mut looped: String = ""
    if through_loops > 0 {
        looped = f", through a loop {through_loops}"
    }
    let mut vouched: String = ""
    if assumed.len() > 0 {
        vouched = f"; assumed {assumed.len()}"
    }
    let mut out: String = f"asserts in {path}: {unproved + arrives.len() + done} - not proved {unproved} (refused {refused.len()}, checked at run time {at_run_time.len()}, checked by a test {by_the_test.len()}); checked where the words arrive {arrives.len()}; proved {done} (proved {proved.len()}{looped}, preconditions proved at every call {preconditions.len()}){vouched}\n"
    let mut red: Vec[String] = []
    red.extend(refused)
    red.extend(at_run_time)
    red.extend(by_the_test)
    let mut green: Vec[String] = []
    green.extend(proved)
    green.extend(preconditions)
    out.push_str(check_report_rows(red, "\x1b[31m", colour))
    out.push_str(check_report_rows(arrives, "\x1b[94m", colour))
    out.push_str(check_report_rows(assumed, "\x1b[33m", colour))
    out.push_str(check_report_rows(green, "\x1b[32m", colour))
    return out
}

/// Each row on a line of its own, in `paint` where `colour` asks for it.
fn check_report_rows(rows: ref Vec[String], paint: ref String, colour: bool) -> String {
    let mut out: String = ""
    for row in rows {
        if colour {
            out.push_str(paint)
            out.push_str(row)
            out.push_str("\x1b[0m\n")
        } else {
            out.push_str(row)
            out.push_str("\n")
        }
    }
    return out
}
