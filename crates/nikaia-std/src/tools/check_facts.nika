            unsigned_literals: collections::BTreeMap(),
            number_lets: collections::BTreeMap(),
            changed_elements: collections::BTreeSet(),
            text_finds: collections::BTreeSet(),
            standard_compares: collections::BTreeMap(),
            count_args: collections::BTreeSet(),
            path_methods: collections::BTreeMap(),
            map_keys: collections::BTreeMap(),
            slice_indices: collections::BTreeSet(),
            list_indices: collections::BTreeSet(),
            copied_tuple_parts: collections::BTreeSet(),
            std_lengths: collections::BTreeSet(),
            sized_lengths: collections::BTreeSet(),
            char_codes: collections::BTreeSet(),
            arithmetic: collections::BTreeMap(),
            negations: collections::BTreeMap(),
