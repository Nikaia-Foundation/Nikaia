            witnessed_sets: collections::BTreeSet(),
            pausing_methods: collections::BTreeSet(),
            nullable_sites: collections::BTreeMap(),
            concatenations: collections::BTreeSet(),
            path_comparisons: collections::BTreeSet(),
            mixed_comparisons: collections::BTreeMap(),
            path_holes: collections::BTreeMap(),
            flattened_reaches: collections::BTreeSet(),
