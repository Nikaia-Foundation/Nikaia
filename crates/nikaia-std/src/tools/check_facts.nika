// crates/nikaia-std/src/tools/check_facts.nika
//
// **What the checker found out about the program and the emitter reads**
// (ADR-294, #125, #558; the coordinator's design): one struct, `CheckFacts`,
// that the checker fills and the emitter holds as its single `facts` field.
// Each table is keyed by the id of the node it is about (ADR-340 D4), or by a
// statement's start byte where the fact is about the statement (D5), so a key
// is an `i64`. A name is a `String`.

use std::collections

/// How a plain value is put into a nullable slot, a name or a number's slot
/// (Part I 2.3, ADR-278, ADR-285 D32, ADR-319 D2).
pub enum FactWrap {
    /// `Some(value)`: the type is known and is not a `T?`.
    Constructor,
    /// `value.into()`: the type is not known.
    Conversion,
    /// Text where a file's name is asked: an `fs::Path` made from it.
    Path,
    /// ...and a view of one.
    PathView,
    /// An integer widened where no value can be lost: the type the slot states.
    Widen(String),
    /// A signed value proved not negative, in the unsigned type the slot states.
    Unsigned(String),
    /// A mapping where a `Bytes` is kept (ADR-373 D3): the mapping at a count.
    MappedBytes,
}

/// How a map's key is handed over.
pub enum FactKeyForm {
    Handed,
    Lent,
    AsIs,
    Either,
    /// Text of its own looked up in a map keyed by views of text: read as the
    /// `str` it holds, which every key of text borrows as (#659).
    Viewed,
}

/// What a reach is a view of.
pub enum FactViewed {
    Text,
    Plain,
}

/// A cast that narrows.
pub enum FactNarrowing {
    Integer,
    FromFloat,
}

/// What a lambda that pauses is rewritten to: the word, as a function, a lent
/// one or a method.
pub enum FactPausing {
    Function(String),
    Lent(String),
    Method(String),
}

/// One `assert` (ADR-269 D2): what its failure says, which only the compiler
/// knows.
pub struct FactClaim {
    pub held: ClaimHeld?,
    pub written: String,
    pub left: String?,
    pub right: String?,
    /// **An `assume`** (ADR-376): a fact from where it stands, never a goal.
    pub assumed: bool,
}

pub struct CheckFacts {
    /// What a task binds and still holds at a pause (ADR-055 D6): seen by the tests.
    pub held_across_a_pause: collections::BTreeSet[(i64, String)],
    pub comptime_values: collections::BTreeMap[i64, (String, String)],
    pub dsl_values: collections::BTreeMap[i64, (String, String)],
    pub with_types: collections::BTreeMap[i64, String],
    pub unrolled: collections::BTreeMap[(String, String), Vec[FieldContract]],
    pub walks_fields: collections::BTreeMap[String, String],
    pub unrolled_calls: collections::BTreeMap[i64, String],
    pub fallible_loops: collections::BTreeSet[i64],
    pub pausing_walks: collections::BTreeSet[i64],
    pub pausing_loops: collections::BTreeSet[i64],
    pub owned_loops: collections::BTreeSet[i64],
    pub copied_loop_bindings: collections::BTreeSet[(i64, String)],
    pub copied_view_bindings: collections::BTreeSet[(i64, String)],
    pub unsigned_literals: collections::BTreeMap[i64, String],
    pub number_lets: collections::BTreeMap[i64, String],
    pub changed_elements: collections::BTreeSet[i64],
    pub text_finds: collections::BTreeSet[i64],
    /// **A `Bytes` cut by a set** (ADR-375 D3), by the receiver: written
    /// `nikaia_std::bytes::split(&b, set)`, since a slice's own `split` takes
    /// a closure and is the one the language below would pick.
    pub bytes_splits: collections::BTreeSet[i64],
    /// **A text pattern of one scalar is that character** (#617), by the
    /// argument: `split(";")` on text is written `split(';')`, the character
    /// literal kept here as Rust spells it. A `&str` pattern is Rust's two-way
    /// searcher, built for every call; a `char` is a `memchr`.
    pub char_patterns: collections::BTreeMap[i64, String],
    /// **`a.compare(b)` and `a.eq(b)` on a type the language orders or equates**
    /// (ADR-341 D2), by the receiver: which side is a view (bit 0 the receiver,
    /// bit 1 the argument), so the emitter writes `std::cmp::Ord::cmp(&*a, &b)`.
    pub standard_compares: collections::BTreeMap[i64, i64],
    pub count_args: collections::BTreeSet[i64],
    pub path_methods: collections::BTreeMap[i64, bool],
    pub map_keys: collections::BTreeMap[(i64, bool), FactKeyForm],
    pub slice_indices: collections::BTreeSet[i64],
    pub list_indices: collections::BTreeSet[i64],
    pub copied_tuple_parts: collections::BTreeSet[(i64, String)],
    pub std_lengths: collections::BTreeSet[i64],
    pub sized_lengths: collections::BTreeSet[i64],
    /// **The field reads of a whole-number type**, by node (ADR-306 D17):
    /// the bounds walk reads a path of fields to one as a number. And the
    /// calls of that type a `let` binds (#781).
    pub whole_fields: collections::BTreeSet[i64],
    /// **The `N` of each `Array[T, N]` read or counted**, by node (#711).
    pub array_lengths: collections::BTreeMap[i64, i64],
    pub char_codes: collections::BTreeSet[i64],
    pub arithmetic: collections::BTreeMap[i64, String],
    pub negations: collections::BTreeMap[i64, String],
    /// **Every `x << k` and `x >> k` whose count is not a literal**, by the
    /// byte its operator starts at, with `x`'s whole-number type: its count is
    /// a goal of the bounds walk (ADR-306 D18).
    pub shifts: collections::BTreeMap[i64, String],
    /// **A method call on a type `std`'s ledger describes**, by the call's
    /// node, with that type's name as the ledger keys it (`Bytes`, `u64`):
    /// the bounds walk reads the entry's `ensures` and `ensures_each`
    /// (ADR-314 D3, ADR-375 D5).
    pub std_receivers: collections::BTreeMap[i64, String],
    /// **A vector's load, read as the cut it reads** (ADR-377 D3), by the
    /// node of the called path: the bytes it reads, or minus the most a
    /// `Lanes` reads on any CPU level where its count is the build's.
    pub simd_loads: collections::BTreeMap[i64, i64],
    pub copied_slots: collections::BTreeSet[i64],
    pub owned_copies: collections::BTreeSet[i64],
    /// The copies among them that copy text, by the receiver's id: reached
    /// through `?.`, the receiver is a reference to the text, which may itself
    /// be a view (ADR-282 D29), and only `to_string` copies both.
    pub text_copies: collections::BTreeSet[i64],
    /// Reads of a field declared `String` that holds static text (ADR-282
    /// D29), by the read's id: typed as the view it is below, said as the
    /// `String` the program wrote.
    pub static_field_reads: collections::BTreeSet[i64],
    pub text_as_is: collections::BTreeSet[i64],
    pub lent_coalesces: collections::BTreeMap[i64, String],
    pub plain_reaches: collections::BTreeSet[i64],
    pub copied_jump_reads: collections::BTreeSet[i64],
    /// `let mut x = m[k] ?? <jump>` over a `mut` place, by the `??`'s id: `x`
    /// is a mutable view of the entry (#816), lowered to `index::get_mut`;
    /// the text is what lends the place: `&mut ` for a local or a field, and
    /// nothing for a `mut` parameter, which already is the `&mut`.
    pub mut_view_reads: collections::BTreeMap[i64, String],
    pub view_coalesces: collections::BTreeSet[i64],
    /// The `??`s whose left side holds a view of text and whose fallback is
    /// a name that is a view of text (#719): the fallback is read as `str`.
    pub text_view_fallbacks: collections::BTreeSet[i64],
    /// The `??`s whose left side holds text, `String` or `&String` below,
    /// and whose fallback is a name that is a view of text (#752): both sides
    /// are made the `String` the answer is.
    pub text_owned_fallbacks: collections::BTreeSet[i64],
    pub lent_map_fallbacks: collections::BTreeSet[i64],
    pub optional_fallbacks: collections::BTreeSet[i64],
    pub flat_reads: collections::BTreeSet[i64],
    pub copied_reads: collections::BTreeSet[i64],
    pub text_in_lists: collections::BTreeSet[i64],
    pub owned_patterns: collections::BTreeSet[i64],
    pub counted: collections::BTreeSet[i64],
    pub lent_bindings: collections::BTreeMap[i64, collections::BTreeSet[String]],
    pub taking_arms: collections::BTreeMap[i64, String],
    pub views_handed_on: collections::BTreeSet[i64],
    pub comptime_uses: collections::BTreeMap[i64, String],
    /// **The names of the package's `comptime`s** (#703): a binding by one
    /// of them shadows the constant, which the language below refuses, so
    /// the emitter writes the binding under a name of its own.
    pub comptime_names: collections::BTreeSet[String],
    /// **The `comptime`s an open number's use was written out for** (ADR-287
    /// D21, #700): a use takes the literal with the type it asked for, so
    /// the constant itself may be read nowhere below.
    pub folded_comptimes: collections::BTreeSet[String],
    /// The reads of a name that a binding shadowing a `comptime` holds, by
    /// node: each is written under the binding's own name.
    pub shadowing_reads: collections::BTreeSet[i64],
    pub lent_scrutinees: collections::BTreeSet[i64],
    /// **A `match` over an owned `String` with a text literal among its
    /// patterns**, by the subject (#704): the language below matches a
    /// literal against a `&str`, so the subject is written as one.
    pub text_scrutinees: collections::BTreeSet[i64],
    /// **A `match` on a name an enclosing arm bound**, by the subject: that
    /// arm's body. Where the arm lent the name, it is a reference below, and
    /// the `match` is over what it points to.
    pub arm_subjects: collections::BTreeMap[i64, i64],
    pub guards_inside_boxes: collections::BTreeMap[i64, collections::BTreeSet[String]],
    pub collected_into: collections::BTreeSet[i64],
    pub copied_walks: collections::BTreeSet[i64],
    pub filter_patterns: collections::BTreeSet[i64],
    /// **An `and_modify` lambda handed a number, `bool` or `char` in the
    /// map** (#684), by the lambda: its parameter is the value, read out of
    /// the slot and written back when the lambda ends.
    pub copied_entry_lambdas: collections::BTreeSet[i64],
    /// **The key of `entry` on a map keyed by owned text, given a literal or
    /// a view** (#676), by the key: built into text of its own, as `insert`'s
    /// is.
    pub owned_entry_keys: collections::BTreeSet[i64],
    pub kept_lambdas: collections::BTreeMap[i64, (bool, bool)],
    pub kept_hulls: collections::BTreeMap[i64, Vec[String]],
    pub kept_owned: collections::BTreeMap[i64, Vec[String]],
    pub field_calls: collections::BTreeMap[i64, bool],
    pub kept_calls: collections::BTreeMap[i64, (bool, bool)],
    pub kept_args: collections::BTreeSet[i64],
    pub kept_functions: collections::BTreeMap[i64, (bool, bool, i64)],
    pub fallible_methods: collections::BTreeSet[i64],
    pub future_lambdas: collections::BTreeSet[i64],
    pub run_lambdas: collections::BTreeSet[i64],
    pub run_code_fails: collections::BTreeSet[i64],
    pub sync_functions_run_async: collections::BTreeMap[i64, i64],
    /// A declared function that throws, named where a parameter of a
    /// `fn(..) throws` type runs it (ADR-280 D9, #703): the argument and the
    /// count of its parameters. That type's channel is the box, so the
    /// lowering hands over a closure that puts the function's own error in it.
    pub boxed_fn_values: collections::BTreeMap[i64, i64],
    /// A declared function that cannot fail, named where a parameter of a
    /// `fn(..) throws` type runs it (ADR-351 D4, #732): the argument and the
    /// count of its parameters. The lowering hands over a closure that wraps
    /// its result in `Ok`.
    pub infallible_fn_values: collections::BTreeMap[i64, i64],
    pub pausing_lambdas: collections::BTreeMap[i64, FactPausing],
    pub paused_scopes: collections::BTreeSet[i64],
    /// The lambdas handed to `task::Scope::spawn` (ADR-346 D7): each fails in
    /// its scope's channel.
    pub scope_tasks: collections::BTreeSet[i64],
    pub witnessed_sets: collections::BTreeSet[i64],
    pub pausing_methods: collections::BTreeSet[i64],
    pub nullable_sites: collections::BTreeMap[i64, FactWrap],
    pub concatenations: collections::BTreeSet[i64],
    pub path_comparisons: collections::BTreeSet[i64],
    pub mixed_comparisons: collections::BTreeMap[i64, bool],
    pub path_holes: collections::BTreeMap[i64, Vec[bool]],
    pub flattened_reaches: collections::BTreeSet[i64],
    pub copied_reaches: collections::BTreeSet[i64],
    pub viewed_reaches: collections::BTreeMap[i64, FactViewed],
    pub lent_reaches: collections::BTreeSet[i64],
    pub held_reaches: collections::BTreeSet[i64],
    pub nullable_fields: collections::BTreeMap[(i64, String), FactWrap],
    pub nullable_args: collections::BTreeMap[i64, FactWrap],
    pub narrowing_casts: collections::BTreeMap[i64, FactNarrowing],
    /// **A read of a `T?` a test proved not `null`** (ADR-350), by the read:
    /// bit 0 whether the value is copied out (`x.unwrap()`) or lent
    /// (`x.as_ref().unwrap()`), bit 1 whether it is an operand, which no wrap
    /// into an option stands directly around.
    pub narrowed_reads: collections::BTreeMap[i64, i64],
    pub task_handles: collections::BTreeSet[(i64, String)],
    /// **An argument of a grammar's entry that is a `Bytes`** (ADR-366 D1), by
    /// the argument: the call enters the grammar's copy over bytes.
    pub bytes_entries: collections::BTreeSet[i64],
    /// **A grammar of this file entered with a `Bytes`**, by its name: it is
    /// lowered a second time, with `input bytes;`.
    pub bytes_grammars: collections::BTreeSet[String],
    pub method_options: collections::BTreeMap[(i64, String), Vec[(String, String)]],
    pub lent_args: collections::BTreeSet[i64],
    /// **A value lent into a `ref` field of a struct literal** (D37), by the
    /// value: the counterpart of `lent_args` for a call.
    pub lent_fields: collections::BTreeSet[i64],
    pub lookup_keys: collections::BTreeSet[i64],
    pub boxed_members: collections::BTreeMap[String, collections::BTreeSet[String]],
    pub boxed_reads: collections::BTreeSet[i64],
    pub copied_bindings: collections::BTreeSet[(i64, String)],
    /// **A number copied out that the arm changes** (#730): changed in
    /// place, or handed to a `mut` parameter. The copy is the arm's own (Part
    /// I 3.4), so it is opened as `let mut`.
    pub changed_copies: collections::BTreeSet[(i64, String)],
    /// **A part bound by value that the arm changes** (#734, Part I 3.4): the
    /// arm took it, so it is opened as `let mut` again.
    pub changed_bindings: collections::BTreeSet[(i64, String)],
    /// **An element a list pattern keeps out of an owned list** (ADR-355
    /// D5, #622): the slice lends it, so the arm opens with its clone, and the
    /// list is gone afterwards as Part I 3.4 says.
    pub cloned_bindings: collections::BTreeSet[(i64, String)],
    pub some_tails: collections::BTreeSet[i64],
    pub mixed_leaves: collections::BTreeMap[i64, bool],
    pub mixed_choices: collections::BTreeSet[i64],
    pub lent_options: collections::BTreeSet[i64],
    pub wrapped: collections::BTreeMap[i64, FactWrap],
    pub compared_views: collections::BTreeSet[(i64, String)],
    pub compared_numbers: collections::BTreeSet[(i64, String)],
    /// **Text ordered against text** (#733), and a lambda's lent item
    /// compared with text (#688), by the operator's span: both sides are
    /// read as `str`, owned or viewed.
    pub ordered_texts: collections::BTreeSet[i64],
    pub claims: collections::BTreeMap[(i64, i64), FactClaim],
    pub entries: collections::BTreeMap[String, Vec[PreconditionCheck]],
    pub reaches: collections::BTreeMap[(String, String), CallReach],
    pub published: collections::BTreeMap[String, Published],
    pub mut_args: collections::BTreeSet[i64],
    /// The binding each argument of `mut_args` names, by the argument's node.
    pub mut_arg_bindings: collections::BTreeMap[i64, i64],
    /// **A `mut` argument that is a reference already** (#703): a part an
    /// arm over a `mut` parameter bound in place, handed on to a `mut`
    /// parameter, is lent on as `&mut *part` (ADR-094 D3, D7).
    pub reborrowed_args: collections::BTreeSet[i64],
    pub copied_args: collections::BTreeSet[i64],
    pub settle_fns: collections::BTreeMap[String, bool],
    pub settle_lets: collections::BTreeMap[i64, bool],
    pub lent_lets: collections::BTreeSet[i64],
    pub lent_returns: collections::BTreeSet[i64],
    pub compares: collections::BTreeSet[String],
    pub compares_totally: collections::BTreeSet[String],
    pub copies: collections::BTreeSet[String],
    pub viewed_numbers: collections::BTreeSet[(i64, String)],
    pub array_literals: collections::BTreeSet[i64],
    pub byte_literals: collections::BTreeSet[i64],
    pub owned_texts: collections::BTreeSet[i64],
    /// `s.bytes` on text: the text's own bytes, borrowed (ADR-320 D11).
    pub text_bytes: collections::BTreeSet[i64],
    /// `s.scalars` on text: its scalars, walked (ADR-320 D3).
    pub text_scalars: collections::BTreeSet[i64],
    /// `s.graphemes` on text: its graphemes by UAX #29, walked (ADR-320 D9).
    pub text_graphemes: collections::BTreeSet[i64],
    /// `s.bytes`, or a name a `let` bound to it, where the program keeps it
    /// beyond the text: copied into a `Bytes` of its own (ADR-320 D11).
    pub kept_text_bytes: collections::BTreeSet[i64],
    /// The receivers of a `Bytes`'s `clone()`: a `Bytes` or a `&[u8]` below,
    /// copied into a `Bytes` of its own (ADR-320 D11).
    pub byte_copies: collections::BTreeSet[i64],
    /// The receivers of a map's `drain()`: where the map stays the caller's,
    /// it is emptied by Rust's `drain()`, which takes no range (#707).
    pub map_drains: collections::BTreeSet[i64],
    /// The receivers of a `Par`'s `fold(init, step, merge)` (ADR-372 D2):
    /// `fold_merged` below, which a list's `iter()` at `no` has as well as a
    /// walk on every core, beside the language below's own two-argument `fold`.
    pub par_folds: collections::BTreeSet[i64],
    /// **A fold's step or merge that changes its accumulator in place**
    /// (ADR-372 D9), by the argument: `1` takes the second argument by value,
    /// `2` lent. The lowering wraps it in `|mut a, x| { f(&mut a, x); a }`.
    pub in_place_folds: collections::BTreeMap[i64, i64],
    /// The receivers of a `drain()` that stay the caller's - rooted in a `mut`
    /// parameter or in `self` under `ref mut self` - which it empties (#707).
    pub kept_drains: collections::BTreeSet[i64],
    /// `P { b }` over a name bound to `s.bytes`, by the struct literal and the
    /// field: the name copied into a `Bytes` of its own (ADR-320 D11).
    pub kept_byte_fields: collections::BTreeSet[(i64, String)],
    pub lent_list_reads: collections::BTreeSet[i64],
    /// **An arm that reads an element or a field off a place, lent** (#613).
    pub lent_reads: collections::BTreeSet[i64],
    pub view_fallbacks: collections::BTreeSet[i64],
    /// **A map read that jumps where it finds nothing** (`m[k] ?? return`),
    /// by the `??`: of a value that moves, the answer is a view of the map
    /// (ADR-293 D28), which `view_changes` watches (#739).
    pub map_read_views: collections::BTreeSet[i64],
    /// **The keep plans the check made against `std` alone** (#727): the
    /// emitter's own, where it reads this check's facts.
    pub keep_plans: Vec[BufferPlan]?,
}

impl CheckFacts {
    pub fn empty() -> CheckFacts {
        return CheckFacts {
            held_across_a_pause: collections::BTreeSet(),
            comptime_values: collections::BTreeMap(),
            dsl_values: collections::BTreeMap(),
            with_types: collections::BTreeMap(),
            unrolled: collections::BTreeMap(),
            walks_fields: collections::BTreeMap(),
            unrolled_calls: collections::BTreeMap(),
            fallible_loops: collections::BTreeSet(),
            pausing_walks: collections::BTreeSet(),
            pausing_loops: collections::BTreeSet(),
            owned_loops: collections::BTreeSet(),
            copied_loop_bindings: collections::BTreeSet(),
            copied_view_bindings: collections::BTreeSet(),
            unsigned_literals: collections::BTreeMap(),
            number_lets: collections::BTreeMap(),
            changed_elements: collections::BTreeSet(),
            text_finds: collections::BTreeSet(),
            bytes_splits: collections::BTreeSet(),
            char_patterns: collections::BTreeMap(),
            standard_compares: collections::BTreeMap(),
            count_args: collections::BTreeSet(),
            path_methods: collections::BTreeMap(),
            map_keys: collections::BTreeMap(),
            slice_indices: collections::BTreeSet(),
            list_indices: collections::BTreeSet(),
            copied_tuple_parts: collections::BTreeSet(),
            std_lengths: collections::BTreeSet(),
            sized_lengths: collections::BTreeSet(),
            whole_fields: collections::BTreeSet(),
            array_lengths: collections::BTreeMap(),
            char_codes: collections::BTreeSet(),
            arithmetic: collections::BTreeMap(),
            shifts: collections::BTreeMap(),
            std_receivers: collections::BTreeMap(),
            simd_loads: collections::BTreeMap(),
            negations: collections::BTreeMap(),
            copied_slots: collections::BTreeSet(),
            owned_copies: collections::BTreeSet(),
            text_copies: collections::BTreeSet(),
            static_field_reads: collections::BTreeSet(),
            text_as_is: collections::BTreeSet(),
            lent_coalesces: collections::BTreeMap(),
            plain_reaches: collections::BTreeSet(),
            copied_jump_reads: collections::BTreeSet(),
            mut_view_reads: collections::BTreeMap(),
            view_coalesces: collections::BTreeSet(),
            text_view_fallbacks: collections::BTreeSet(),
            text_owned_fallbacks: collections::BTreeSet(),
            lent_map_fallbacks: collections::BTreeSet(),
            optional_fallbacks: collections::BTreeSet(),
            flat_reads: collections::BTreeSet(),
            copied_reads: collections::BTreeSet(),
            text_in_lists: collections::BTreeSet(),
            owned_patterns: collections::BTreeSet(),
            counted: collections::BTreeSet(),
            lent_bindings: collections::BTreeMap(),
            taking_arms: collections::BTreeMap(),
            views_handed_on: collections::BTreeSet(),
            comptime_uses: collections::BTreeMap(),
            comptime_names: collections::BTreeSet(),
            folded_comptimes: collections::BTreeSet(),
            shadowing_reads: collections::BTreeSet(),
            lent_scrutinees: collections::BTreeSet(),
            text_scrutinees: collections::BTreeSet(),
            arm_subjects: collections::BTreeMap(),
            guards_inside_boxes: collections::BTreeMap(),
            collected_into: collections::BTreeSet(),
            copied_walks: collections::BTreeSet(),
            filter_patterns: collections::BTreeSet(),
            copied_entry_lambdas: collections::BTreeSet(),
            owned_entry_keys: collections::BTreeSet(),
            kept_lambdas: collections::BTreeMap(),
            kept_hulls: collections::BTreeMap(),
            kept_owned: collections::BTreeMap(),
            field_calls: collections::BTreeMap(),
            kept_calls: collections::BTreeMap(),
            kept_args: collections::BTreeSet(),
            kept_functions: collections::BTreeMap(),
            fallible_methods: collections::BTreeSet(),
            future_lambdas: collections::BTreeSet(),
            run_lambdas: collections::BTreeSet(),
            run_code_fails: collections::BTreeSet(),
            sync_functions_run_async: collections::BTreeMap(),
            boxed_fn_values: collections::BTreeMap(),
            infallible_fn_values: collections::BTreeMap(),
            pausing_lambdas: collections::BTreeMap(),
            paused_scopes: collections::BTreeSet(),
            scope_tasks: collections::BTreeSet(),
            witnessed_sets: collections::BTreeSet(),
            pausing_methods: collections::BTreeSet(),
            nullable_sites: collections::BTreeMap(),
            concatenations: collections::BTreeSet(),
            path_comparisons: collections::BTreeSet(),
            mixed_comparisons: collections::BTreeMap(),
            path_holes: collections::BTreeMap(),
            flattened_reaches: collections::BTreeSet(),
            copied_reaches: collections::BTreeSet(),
            viewed_reaches: collections::BTreeMap(),
            lent_reaches: collections::BTreeSet(),
            held_reaches: collections::BTreeSet(),
            nullable_fields: collections::BTreeMap(),
