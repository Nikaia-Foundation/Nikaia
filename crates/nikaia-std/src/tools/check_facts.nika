            plain_reaches: collections::BTreeSet(),
            copied_jump_reads: collections::BTreeSet(),
            view_coalesces: collections::BTreeSet(),
            lent_map_fallbacks: collections::BTreeSet(),
            optional_fallbacks: collections::BTreeSet(),
            flat_reads: collections::BTreeSet(),
            copied_reads: collections::BTreeSet(),
            text_in_lists: collections::BTreeSet(),
            counted: collections::BTreeSet(),
            lent_bindings: collections::BTreeMap(),
            taking_arms: collections::BTreeMap(),
            views_handed_on: collections::BTreeSet(),
            comptime_uses: collections::BTreeMap(),
            lent_scrutinees: collections::BTreeSet(),
            guards_inside_boxes: collections::BTreeMap(),
            collected_into: collections::BTreeSet(),
            copied_walks: collections::BTreeSet(),
            filter_patterns: collections::BTreeSet(),
            kept_lambdas: collections::BTreeMap(),
            kept_hulls: collections::BTreeMap(),
