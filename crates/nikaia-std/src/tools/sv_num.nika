// crates/nikaia-std/src/tools/sv_num.nika
//
// **The solver's numbers** (ADR-270 D11, #1282 items 1-2): `i64` only, kept
// small by construction, never wrapped. Every sum and product goes through
// the language's overflow check (`checked_add`, `checked_mul`, ...); a step
// that would leave the range answers `null`, and the engine that asked picks
// another pivot or variable, or answers *unknown* with `SvUnknown::Overflow`.
// A vector of coefficients is divided by its gcd at once, and an elimination
// multiplies by the smallest multipliers that cancel the column, the
// coefficients' quotients by their gcd, so a chain of combinations stays
// near the size of its inputs instead of doubling per step.
//
// A value of the simplex is a rational of two `i64`, normalised by gcd with a
// positive denominator (`SvRat`), extended by the infinitesimal `δ` for strict
// bounds (`SvDelta`, Dutertre and de Moura). Comparing two rationals never
// overflows: it compares the integer parts and then the reciprocals of the
// fractional parts.

/// Why the solver could not tell.
pub enum SvUnknown {
	/// Every step left was one that would leave `i64` (D11).
	Overflow,
	/// The query holds what the solver's theory does not read.
	OutsideTheTheory,
	/// The search reached its limit.
	Budget,
	/// Searched within the limit, found no contradiction.
	NoContradiction,
}

/// The greatest common divisor, never negative; `0` for two zeros. `null`
/// only where it is `2^63`, which no `i64` holds (`a` and `b` each `0` or
/// the least `i64`).
fn sv_gcd(a: i64, b: i64) -> i64? {
	let mut x = a
	let mut y = b
	while y != 0 {
		if y == 1 || y == -1 {
			return 1
		}
		let t = x % y
		x = y
		y = t
	}
	return x.checked_abs()
}

/// `⌊a / m⌋` for `m > 0`; `null` for any other `m`.
fn sv_floor_div(a: i64, m: i64) -> i64? {
	if m <= 0 {
		return null
	}
	return a.div_euclid(m)
}

/// `⌈a / m⌉` for `m > 0`; `null` for any other `m`.
fn sv_ceil_div(a: i64, m: i64) -> i64? {
	if m <= 0 {
		return null
	}
	let q = a.div_euclid(m)
	if a.rem_euclid(m) == 0 {
		return q
	}
	return q + 1
}

/// `a·x + b·y`, or `null` where a product or the sum leaves `i64`.
fn sv_mul_add(a: i64, x: i64, b: i64, y: i64) -> i64? {
	let left = a.checked_mul(x) ?? return null
	let right = b.checked_mul(y) ?? return null
	return left.checked_add(right)
}

/// Whether `k` lies in the 32-bit range, where one product fits 63 bits and
/// one combination `a·x + b·y` cannot overflow (D11's fast path).
pub fn sv_fits32(k: i64) -> bool {
	return k >= -2147483648 && k <= 2147483647
}

/// The gcd of all entries of `ks`; `null` where it is `2^63`.
fn sv_content(ks: ref Vec[i64]) -> i64? {
	let mut g: i64 = 0
	for k in ks {
		g = sv_gcd(g, k) ?? return null
		if g == 1 {
			return 1
		}
	}
	return g
}

/// `ks` divided by their gcd. The division is exact, so it holds for an
/// equality and for a bound `Σ <= 0` alike; a vector whose gcd no `i64`
/// holds stays as it is.
pub fn sv_reduced(ks: Vec[i64]) -> Vec[i64] {
	let g = sv_content(ks) ?? return ks
	if g <= 1 {
		return ks
	}
	let mut out: Vec[i64] = []
	for k in ks {
		out.push(k / g)
	}
	return out
}

/// The largest absolute value of `ks`; `null` where it is `2^63`.
pub fn sv_max_abs(ks: ref Vec[i64]) -> i64? {
	let mut most: i64 = 0
	for k in ks {
		let a = k.checked_abs() ?? return null
		if a > most {
			most = a
		}
	}
	return most
}

/// `a·x + b·y` entry by entry, divided by its gcd; `null` where an entry
/// leaves `i64`. The two vectors have one length (a dense row, D10).
pub fn sv_dense_combine(a: i64, x: ref Vec[i64], b: i64, y: ref Vec[i64]) -> Vec[i64]? {
	if x.len() != y.len() {
		return null
	}
	let mut out: Vec[i64] = []
	let mut i = 0
	while i < x.len() {
		out.push(sv_mul_add(a, x[i], b, y[i]) ?? return null)
		i += 1
	}
	return sv_reduced(out)
}

/// The smallest multipliers `(a, b)` with `a·xj + b·yj = 0` and `a > 0`:
/// `yj` and `xj` divided by their gcd. `null` where a column is zero or a
/// negation leaves `i64`.
fn sv_cancelling(xj: i64, yj: i64) -> Vec[i64]? {
	if xj == 0 || yj == 0 {
		return null
	}
	let g = sv_gcd(xj, yj) ?? return null
	let mut a = yj / g
	let mut b = (xj / g).checked_neg() ?? return null
	if a < 0 {
		a = a.checked_neg() ?? return null
		b = b.checked_neg() ?? return null
	}
	return [a, b]
}

/// Column `j` eliminated between `x` and `y` with the smallest multipliers,
/// the result divided by its gcd. Between two bounds `Σ <= 0` the
/// multipliers must both be positive, so `x[j]` and `y[j]` have opposite
/// signs; the caller asks so, an equality may take either sign.
pub fn sv_dense_eliminate(x: ref Vec[i64], y: ref Vec[i64], j: i64) -> Vec[i64]? {
	let ab = sv_cancelling(x[j], y[j]) ?? return null
	return sv_dense_combine(ab[0], x, ab[1], y)
}

/// Which column to eliminate between `x` and `y` among the first `width`
/// (D11: a unit coefficient first, then the smallest product of the two
/// multipliers); `-1` where no column is non-zero in both. `opposite` asks
/// for columns of opposite signs only, as two bounds need.
pub fn sv_pick_column(x: ref Vec[i64], y: ref Vec[i64], width: i64, opposite: bool) -> i64 {
	let mut best: i64 = -1
	let mut best_cost: i64 = 0
	let mut j = 0
	while j < width {
		let xj = x[j]
		let yj = y[j]
		let x_up = xj > 0
		let y_up = yj > 0
		let usable = xj != 0 && yj != 0 && (!opposite || x_up != y_up)
		if usable {
			let cost = sv_column_cost(xj, yj)
			if cost != null && (best < 0 || (cost ?? 0) < best_cost) {
				best = j
				best_cost = cost ?? 0
			}
		}
		j += 1
	}
	return best
}

/// What eliminating with the coefficients `xj` and `yj` costs: `0` where one
/// is a unit, else the product of the multipliers; `null` where a multiplier
/// leaves `i64`.
fn sv_column_cost(xj: i64, yj: i64) -> i64? {
	if xj == 1 || xj == -1 || yj == 1 || yj == -1 {
		return 0
	}
	let ab = sv_cancelling(xj, yj) ?? return null
	let b = ab[1].checked_abs() ?? return null
	return ab[0].checked_mul(b)
}

/// A rational `num / den`: `den > 0`, `gcd(num, den) = 1`.
pub struct SvRat {
	pub num: i64,
	pub den: i64,
}

/// `n / d` normalised; `null` for `d = 0` or where the sign moves out of
/// `i64`.
fn sv_rat(n: i64, d: i64) -> SvRat? {
	if d == 0 {
		return null
	}
	let g = sv_gcd(n, d) ?? return null
	let mut num = n / g
	let mut den = d / g
	if den < 0 {
		num = num.checked_neg() ?? return null
		den = den.checked_neg() ?? return null
	}
	return SvRat { num: num, den: den }
}

/// The integer `n` as a rational.
fn sv_int(n: i64) -> SvRat {
	return SvRat { num: n, den: 1 }
}

fn sv_rat_add(a: ref SvRat, b: ref SvRat) -> SvRat? {
	let g = sv_gcd(a.den, b.den) ?? return null
	let da = a.den / g
	let db = b.den / g
	let num = sv_mul_add(a.num, db, b.num, da) ?? return null
	let den = a.den.checked_mul(db) ?? return null
	return sv_rat(num, den)
}

fn sv_rat_neg(a: ref SvRat) -> SvRat? {
	return SvRat { num: a.num.checked_neg() ?? return null, den: a.den }
}

fn sv_rat_sub(a: ref SvRat, b: ref SvRat) -> SvRat? {
	let negated = sv_rat_neg(b) ?? return null
	return sv_rat_add(a, negated)
}

/// The product, each numerator reduced against the other's denominator
/// first so that nothing larger than the result is formed.
fn sv_rat_mul(a: ref SvRat, b: ref SvRat) -> SvRat? {
	let g1 = sv_gcd(a.num, b.den) ?? return null
	let g2 = sv_gcd(b.num, a.den) ?? return null
	let num = (a.num / g1).checked_mul(b.num / g2) ?? return null
	let den = (a.den / g2).checked_mul(b.den / g1) ?? return null
	return sv_rat(num, den)
}

/// The quotient; `null` for a division by zero.
fn sv_rat_div(a: ref SvRat, b: ref SvRat) -> SvRat? {
	let inverse = sv_rat(b.den, b.num) ?? return null
	return sv_rat_mul(a, inverse)
}

/// `-1`, `0` or `1` as `a` is less than, equal to or greater than `b`.
/// Never overflows: integer parts first, then the fractional parts through
/// their reciprocals, a continued fraction.
fn sv_rat_cmp(a: ref SvRat, b: ref SvRat) -> i64 {
	let mut an = a.num
	let mut ad = a.den
	let mut bn = b.num
	let mut bd = b.den
	let mut sign: i64 = 1
	while true {
		let aq = an.div_euclid(ad)
		let bq = bn.div_euclid(bd)
		if aq != bq {
			return if aq < bq { -sign } else { sign }
		}
		let ar = an.rem_euclid(ad)
		let br = bn.rem_euclid(bd)
		if ar == 0 || br == 0 {
			if ar == br {
				return 0
			}
			return if ar == 0 { -sign } else { sign }
		}
		// ar/ad < br/bd exactly when ad/ar > bd/br.
		an = ad
		ad = ar
		bn = bd
		bd = br
		sign = -sign
	}
}

fn sv_rat_is_int(a: ref SvRat) -> bool {
	return a.den == 1
}

fn sv_rat_floor(a: ref SvRat) -> i64 {
	return a.num.div_euclid(a.den)
}

fn sv_rat_ceil(a: ref SvRat) -> i64 {
	return sv_ceil_div(a.num, a.den) ?? 0
}

pub fn sv_rat_text(a: ref SvRat) -> String {
	if a.den == 1 {
		return f"{a.num}"
	}
	return f"{a.num}/{a.den}"
}

/// `c + k·δ` for an infinitesimal `δ > 0`: `x < 5` is `x <= 5 - δ`.
pub struct SvDelta {
	pub c: SvRat,
	pub k: SvRat,
}

fn sv_delta(c: SvRat, k: SvRat) -> SvDelta {
	return SvDelta { c: c, k: k }
}

fn sv_delta_add(a: ref SvDelta, b: ref SvDelta) -> SvDelta? {
	let c = sv_rat_add(a.c, b.c) ?? return null
	let k = sv_rat_add(a.k, b.k) ?? return null
	return SvDelta { c: c, k: k }
}

pub fn sv_delta_sub(a: ref SvDelta, b: ref SvDelta) -> SvDelta? {
	let c = sv_rat_sub(a.c, b.c) ?? return null
	let k = sv_rat_sub(a.k, b.k) ?? return null
	return SvDelta { c: c, k: k }
}

fn sv_delta_scale(a: ref SvDelta, r: ref SvRat) -> SvDelta? {
	let c = sv_rat_mul(a.c, r) ?? return null
	let k = sv_rat_mul(a.k, r) ?? return null
	return SvDelta { c: c, k: k }
}

/// Ordered by the rational part, then by the coefficient of `δ`.
fn sv_delta_cmp(a: ref SvDelta, b: ref SvDelta) -> i64 {
	let first = sv_rat_cmp(a.c, b.c)
	if first != 0 {
		return first
	}
	return sv_rat_cmp(a.k, b.k)
}

pub fn sv_delta_text(a: ref SvDelta) -> String {
	if a.k.num == 0 {
		return sv_rat_text(a.c)
	}
	let real = if a.c.num == 0 { "" } else { sv_rat_text(a.c) }
	let sign = if a.k.num > 0 && a.c.num != 0 { "+" } else { "" }
	if a.k.num == 1 && a.k.den == 1 {
		return f"{real}{sign}δ"
	}
	if a.k.num == -1 && a.k.den == 1 {
		return f"{real}-δ"
	}
	return f"{real}{sign}{sv_rat_text(a.k)}δ"
}

// --- Tests: the solver's numbers (moved from
// `tests/compiler/tests/solver_num.nika`, which compiled this file anew in a
// program of its own on every run): a 40-step elimination chain stays within
// 32 bits where the same chain without the gcd leaves them at step 28 and is
// refused, not wrapped, at step 60; rationals normalised and compared without
// overflow; `δ` orders strict bounds ---

// The other bound of step `n`, reduced (gcd 1): its first column, `-2`,
// cancels the current row's `2`; the others have the row's sign, so the
// first is the only column two bounds may be combined on.
fn sv_num_test_partner(n: i64) -> Vec[i64] {
	return [-2, 1, 5, 1 + n % 7]
}

// Without the gcd: the multipliers are the two coefficients themselves.
fn sv_num_test_naive(x: ref Vec[i64], y: ref Vec[i64], j: i64) -> Vec[i64]? {
	let mut a = y[j]
	let mut b = x[j]
	if a < 0 { a = -a } else { b = -b }
	let mut out: Vec[i64] = []
	let mut i = 0
	while i < x.len() {
		out.push(sv_mul_add(a, x[i], b, y[i]) ?? return null)
		i += 1
	}
	return out
}

fn sv_num_test_chain(reduce: bool, steps: i64) -> String {
	let mut c: Vec[i64] = [2, 1, 3, 4]
	let mut n = 0
	let mut largest: i64 = 0
	let mut left32: i64 = -1
	while n < steps {
		let f = sv_num_test_partner(n)
		let j = sv_pick_column(c, f, 3, true)
		if j < 0 {
			return f"step {n}: no column"
		}
		let next = if reduce { sv_dense_eliminate(c, f, j) } else { sv_num_test_naive(c, f, j) }
		let made = next ?? return f"step {n + 1}: refused, would leave i64 (left 32 bits at step {left32}, largest so far {largest})"
		c = made
		largest = sv_max_abs(c) ?? -1
		if left32 < 0 && !sv_fits32(largest) {
			left32 = n + 1
		}
		if c[j] != 0 {
			return f"step {n}: column {j} left"
		}
		// The eliminated column comes back with the next bound.
		c[j] = 2
		n += 1
	}
	return f"{steps} steps, largest coefficient {largest}, within 32 bits: {sv_fits32(largest)}"
}

fn sv_num_test_show(r: SvRat?) -> String {
	let v = r ?? return "refused"
	return sv_rat_text(v)
}

fn sv_num_test_order(a: ref SvRat, b: ref SvRat) -> String {
	let c = sv_rat_cmp(a, b)
	let op = if c < 0 { "<" } else if c > 0 { ">" } else { "=" }
	return f"{sv_rat_text(a)} {op} {sv_rat_text(b)}"
}

fn sv_num_test_dorder(a: ref SvDelta, b: ref SvDelta) -> String {
	let c = sv_delta_cmp(a, b)
	let op = if c < 0 { "<" } else if c > 0 { ">" } else { "=" }
	return f"{sv_delta_text(a)} {op} {sv_delta_text(b)}"
}

test "i64 coefficients are kept small and never wrapped" {
	let mut out: String = ""
	out = out + "== item 1: i64 kept small\n"
	out = out + f"reduced chain: {sv_num_test_chain(true, 40)}\n"
	out = out + f"unreduced chain: {sv_num_test_chain(false, 40)}\n"
	out = out + f"unreduced chain, longer: {sv_num_test_chain(false, 80)}\n"
	let big: i64 = 4611686018427387904
	let sum = sv_mul_add(1, big, 1, big)
	out = out + f"2^62 + 2^62: {if sum == null { "refused" } else { "wrapped" }}\n"
	let wide: Vec[i64] = [3037000500, 1]
	let square = sv_dense_combine(3037000500, wide, 0, wide)
	out = out + f"3037000500 * 3037000500: {if square == null { "refused" } else { "wrapped" }}\n"
	let least: i64 = -9223372036854775807 - 1
	out = out + f"gcd(-12, 18) = {sv_gcd(-12, 18) ?? -1}, gcd(i64 least, 0): {if sv_gcd(least, 0) == null { "refused" } else { "wrapped" }}\n"
	let row: Vec[i64] = [6, -9, 12, 3]
	let shown = sv_reduced(row).iter().join(", ")
	out = out + f"reduced [6, -9, 12, 3]: [{shown}]\n"
	out = out + f"column cost unit {sv_column_cost(1, -7) ?? -1}, 4 vs -6: {sv_column_cost(4, -6) ?? -1}\n"
	let x: Vec[i64] = [4, 1, -6]
	let y: Vec[i64] = [-6, -1, 9]
	out = out + f"picked column of [4, 1, -6] and [-6, -1, 9]: {sv_pick_column(x, y, 3, true)}\n"
	out = out + f"floor(-7/2) = {sv_floor_div(-7, 2) ?? 0}, ceil(-7/2) = {sv_ceil_div(-7, 2) ?? 0}, floor by 0: {if sv_floor_div(1, 0) == null { "refused" } else { "?" }}\n"

	let expected = [
		"== item 1: i64 kept small",
		"reduced chain: 40 steps, largest coefficient 194, within 32 bits: true",
		"unreduced chain: 40 steps, largest coefficient 14293651161078, within 32 bits: false",
		"unreduced chain, longer: step 60: refused, would leave i64 (left 32 bits at step 28, largest so far 7493989779944505334)",
		"2^62 + 2^62: refused",
		"3037000500 * 3037000500: refused",
		"gcd(-12, 18) = 6, gcd(i64 least, 0): refused",
		"reduced [6, -9, 12, 3]: [2, -3, 4, 1]",
		"column cost unit 0, 4 vs -6: 6",
		"picked column of [4, 1, -6] and [-6, -1, 9]: 1",
		"floor(-7/2) = -4, ceil(-7/2) = -3, floor by 0: refused",
	]
	assert(out == expected.join("\n") + "\n")
}

test "rationals and delta are normalised, ordered and refuse overflow" {
	let mut out: String = ""
	out = out + "== item 2: rationals and delta\n"
	out = out + f"6/-4 = {sv_num_test_show(sv_rat(6, -4))}, 0/-5 = {sv_num_test_show(sv_rat(0, -5))}, 1/0: {sv_num_test_show(sv_rat(1, 0))}\n"
	let sixth = sv_rat(1, 6) ?? sv_int(0)
	let tenth = sv_rat(1, 10) ?? sv_int(0)
	out = out + f"1/6 + 1/10 = {sv_num_test_show(sv_rat_add(sixth, tenth))}, 1/6 - 1/10 = {sv_num_test_show(sv_rat_sub(sixth, tenth))}\n"
	let p = sv_rat(3037000499, 2) ?? sv_int(0)
	let q = sv_rat(2, 3037000499) ?? sv_int(0)
	out = out + f"3037000499/2 * 2/3037000499 = {sv_num_test_show(sv_rat_mul(p, q))}, divided = {sv_num_test_show(sv_rat_div(p, q))}\n"
	let huge = sv_int(9223372036854775807)
	out = out + f"i64 max + 1/2: {sv_num_test_show(sv_rat_add(huge, sv_rat(1, 2) ?? sv_int(0)))}\n"
	out = out + f"divided by 0: {sv_num_test_show(sv_rat_div(sixth, sv_int(0)))}\n"
	let third = sv_rat(1, 3) ?? sv_int(0)
	let half = sv_rat(1, 2) ?? sv_int(0)
	out = out + sv_num_test_order(third, half) + "\n"
	out = out + sv_num_test_order(sv_rat_neg(third) ?? third, sv_rat_neg(half) ?? half) + "\n"
	let m: i64 = 9223372036854775807
	let a = sv_rat(m - 1, m) ?? sv_int(0)
	let b = sv_rat(m - 2, m - 1) ?? sv_int(0)
	out = out + sv_num_test_order(a, b) + "\n"
	out = out + sv_num_test_order(sv_rat(-7, 2) ?? half, sv_rat(-14, 4) ?? half) + "\n"
	let r = sv_rat(-7, 2) ?? half
	out = out + f"floor(-7/2) = {sv_rat_floor(r)}, ceil = {sv_rat_ceil(r)}, integer: {sv_rat_is_int(r)}\n"
	let five = sv_delta(sv_int(5), sv_int(0))
	let below = sv_delta(sv_int(5), sv_int(-1))
	let above = sv_delta(sv_int(5), sv_int(1))
	let four = sv_delta(sv_int(4), sv_int(1000))
	out = out + sv_num_test_dorder(below, five) + "\n"
	out = out + sv_num_test_dorder(five, above) + "\n"
	out = out + sv_num_test_dorder(below, four) + "\n"
	out = out + sv_num_test_dorder(sv_delta_sub(above, five) ?? five, sv_delta(sv_int(0), sv_int(1))) + "\n"
	out = out + f"(5 - δ) * -2 = {sv_delta_text(sv_delta_scale(below, sv_int(-2)) ?? five)}\n"
	out = out + f"(5 - δ) + (4 + 1000δ) = {sv_delta_text(sv_delta_add(below, four) ?? five)}\n"

	let expected = [
		"== item 2: rationals and delta",
		"6/-4 = -3/2, 0/-5 = 0, 1/0: refused",
		"1/6 + 1/10 = 4/15, 1/6 - 1/10 = 1/15",
		"3037000499/2 * 2/3037000499 = 1, divided = 9223372030926249001/4",
		"i64 max + 1/2: refused",
		"divided by 0: refused",
		"1/3 < 1/2",
		"-1/3 > -1/2",
		"9223372036854775806/9223372036854775807 > 9223372036854775805/9223372036854775806",
		"-7/2 = -7/2",
		"floor(-7/2) = -4, ceil = -3, integer: false",
		"5-δ < 5",
		"5 < 5+δ",
		"5-δ > 4+1000δ",
		"δ = δ",
		"(5 - δ) * -2 = -10+2δ",
		"(5 - δ) + (4 + 1000δ) = 9+999δ",
	]
	assert(out == expected.join("\n") + "\n")
}
