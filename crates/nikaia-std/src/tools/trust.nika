// crates/nikaia-std/src/tools/trust.nika
//
// **What `--trust` says about a program** (ADR-010 D7, ADR-108 D4): which
// sources it reads and who chose their bytes, and every file access whose
// root is a word rather than a directory.
//
// The second module of the ring after the tree (ADR-294) moved from Rust
// to Nikaia, by ADR-290's route: lowered by `nikaia lower-std` to `trust.rs`
// beside it, `include!`d as `nikaia_std::tools::trust`, and called from the
// compiler's `contracts::trust`.
//
// **What moved is the module's decisions**: which written root is a way
// around the root check, and what the report says. What stays Rust is what
// it reads, the ledger and the call walk (ADR-294 D2): the compiler's
// `contracts::trust` finds the calls, asks the ledger who chose a source's
// bytes and which parameter is a root, and hands this module plain data - a
// name, a `bool`, a line and a column.

/// Which of the two spellings ADR-108 D4 lists a root is.
pub enum Wrote {
    /// `fs::Root::Anywhere`: no check, and the program answers for the name.
    Anywhere,
    /// `fs::Root::Dir("/")`: a check whose root is everything, which is
    /// `Anywhere` with more characters.
    TheFilesystemRoot,
}

/// How the report names it.
pub fn spelled(wrote: Wrote) -> String {
    return match wrote {
        Wrote::Anywhere => "Anywhere",
        Wrote::TheFilesystemRoot => "Dir(\"/\") - which is every directory",
    }
}

/// The root an argument writes, where it is one the review wants to see:
/// `Root::Anywhere`, or `Root::Dir("/")`, under whatever module path.
pub fn written_root(names: ref winnow_grammar::InternerContext, arg: ref Expr) -> Wrote? {
    return match arg {
        Expr::Path(segments, _) => if ends_with_variant(names, segments, "Anywhere") { Wrote::Anywhere } else { null },
        Expr::Call { func, args, .. } => the_whole_filesystem(names, func, args),
        else => null,
    }
}

/// `Root::Dir("/")`, and no other directory.
fn the_whole_filesystem(names: ref winnow_grammar::InternerContext, func: ref Expr, args: ref Vec[Expr]) -> Wrote? {
    let is_dir = match func {
        Expr::Path(segments, _) => ends_with_variant(names, segments, "Dir"),
        else => false,
    }
    return null if !is_dir || args.len() == 0
    return match args[0] {
        Expr::LitStr { text, .. } => if text == "/" { Wrote::TheFilesystemRoot } else { null },
        else => null,
    }
}

/// Whether a path ends `Root::<variant>`.
fn ends_with_variant(names: ref winnow_grammar::InternerContext, segments: ref Vec[winnow_grammar::Symbol], variant: ref String) -> bool {
    let n = segments.len()
    return n >= 2 && names.resolve(segments[n - 2]) == "Root" && names.resolve(segments[n - 1]) == variant
}

/// A source the program calls, and whether someone else chose its bytes.
pub struct Reason {
    pub source: String,
    pub untrusted: bool,
}

/// A call that wrote a root the review wants to see, where it stands.
pub struct Place {
    pub line: i64,
    pub column: i64,
    pub entry: String,
    pub wrote: Wrote,
}

/// The report `--trust` prints for one file.
pub fn render(untrusted: bool, reasons: ref Array[Reason], places: ref Array[Place], path: ref String) -> String {
    let mut out = f"input provenance: {provenance(untrusted)}\n"
    if reasons.len() == 0 {
        out.push_str("    no source is read, so nothing entered from outside\n")
    }
    for reason in reasons {
        out.push_str(ref f"    {reason.source} is {provenance(reason.untrusted)}\n")
    }
    let hash = if untrusted {
        "keyed, per-process random seed - key choice cannot be aimed at the table"
    } else {
        "fast, fixed seed - no adversary chooses these keys"
    }
    out.push_str(ref f"hash for a map keyed by the input: {hash}\n")
    out.push_str("file access with no root to check against:\n")
    if places.len() == 0 {
        out.push_str("    none - every path here names a directory it may not leave\n")
    }
    for place in places {
        out.push_str(ref f"    {path}:{place.line}:{place.column}  {place.entry} writes {spelled(place.wrote)}\n")
    }
    return out
}

fn provenance(untrusted: bool) -> String {
    return if untrusted { "untrusted" } else { "trusted" }
}

// **Which maps are keyed by what the program wrote itself** (ADR-010 D2), the
// walk the compiler's `contracts::trust` ran in Rust, moved (ADR-294, #125).
//
// A map made by `HashMap()` or `HashSet()` gets the fast fixed-seed hash when
// everything that ever becomes one of its keys is made only of what the
// program wrote and of what a trusted source handed back, each name followed
// to the binding it reads.
//
// **Everything not seen is untrusted** (D1, a barrier widens): a parameter, a
// pattern's binding, a function of the program's own, a method that is a
// source somewhere in `std` by its name, and any shape this does not read. A
// map that gets the keyed hash needlessly is slower; the opposite is an
// attack.

use std::collections

/// What a value is made of: the bindings it reads, or `known: false` where
/// something in it is never trusted.
struct KeyDeps {
    known: bool,
    ids: Vec[i64],
}

/// The names a body's functions share, which the walk of one does not change.
struct MapEnv {
    /// A method is a source where `std` names one by that name, whatever it
    /// is called on.
    sources: collections::BTreeSet[String],
    /// The functions of the program's own.
    own: collections::BTreeSet[String],
    /// The private functions that stand alone (not `pub`, no type parameters,
    /// not `extern`), with their number of parameters: the only ones whose
    /// every caller is seen, so the only ones a map may pass through.
    privates: collections::BTreeMap[winnow_grammar::Symbol, i64],
}

/// **The classes of the map positions of one file** (ADR-010 D9, #581): a
/// position is a `let` (`l:<start>`), a private function's parameter
/// (`p:<fn>:<n>`) or result (`r:<fn>`). Positions a map passes between are
/// one class (union-find), and the class has one Rust type. A class is keyed
/// where any position in it is `poisoned`: a key that is not trusted reaches
/// it, or a value of it goes somewhere this does not follow. Everything not
/// seen is keyed (D1, a barrier widens).
struct MapClasses {
    parent: collections::BTreeMap[String, String],
    poisoned: collections::BTreeSet[String],
    /// Every `let` that names one binding, by the start of the statement.
    lets: Vec[i64],
    /// Every parameter and result of a function that stands alone.
    slots: Vec[String],
    /// Some function was not read to the end, so what it calls is unknown.
    unread: bool,
    /// The `let`s whose map leaves the function (returned, stored, handed on).
    escaped: Vec[i64],
}

/// The answer: the `let`s and the parameters and results that keep the fast
/// hash in a program that reads untrusted input.
pub struct MapPlan {
    pub lets: collections::BTreeSet[i64],
    pub slots: collections::BTreeSet[String],
    /// The `let`s whose map leaves its function: where the function's
    /// positions are type parameters, such a map may stand at one (D9).
    pub escaped: collections::BTreeSet[i64],
}

/// A `let` that makes a map: the statement, the name, the binding.
struct MapMade {
    at: i64,
    name: winnow_grammar::Symbol,
    id: i64,
}

/// One use of a map, with what the use hands it (the iterable of a `for`
/// hands it nothing).
struct MapKept {
    id: i64,
    deps: KeyDeps,
}

/// One function's bindings, followed lexically.
struct MapWalk {
    /// The class position of each binding, parallel to `given`.
    nodes: Vec[String],
    /// The result position of the function walked.
    ret: String,
    /// Each block's names, innermost last, to the binding they read; `-1` is
    /// one never trusted (a parameter, a pattern's binding).
    scopes: Vec[collections::BTreeMap[winnow_grammar::Symbol, i64]],
    /// What each binding is given.
    given: Vec[Vec[KeyDeps]],
    made: Vec[MapMade],
    kept: Vec[MapKept],
    /// The bindings whose name stands somewhere else: an argument, a value
    /// bound or returned, an assignment.
    escapes: collections::BTreeSet[i64],
    /// How often each name is bound in the body.
    bound: collections::BTreeMap[winnow_grammar::Symbol, i64],
    unread: bool,
}

fn tm_never() -> KeyDeps {
    return KeyDeps { known: false, ids: [] }
}

fn tm_nothing() -> KeyDeps {
    return KeyDeps { known: true, ids: [] }
}

fn tm_reading(id: i64) -> KeyDeps {
    return KeyDeps { known: true, ids: [id] }
}

fn tm_join(a: ref KeyDeps, b: ref KeyDeps) -> KeyDeps {
    if !a.known || !b.known {
        return tm_never()
    }
    let mut ids: Vec[i64] = []
    for id in a.ids {
        ids.push(id)
    }
    for id in b.ids {
        ids.push(id)
    }
    return KeyDeps { known: true, ids: ids }
}

fn mc_find(classes: ref MapClasses, node: ref String) -> String {
    let mut at: String = node.clone()
    let mut moving = true
    while moving {
        let up = classes.parent.get(at)
        if up == null {
            moving = false
        } else {
            let next = (up ?? "").clone()
            if next == at {
                moving = false
            } else {
                at = next
            }
        }
    }
    return at
}

fn mc_union(mut classes: MapClasses, a: ref String, b: ref String) {
    let ra = mc_find(classes, a)
    let rb = mc_find(classes, b)
    if ra != rb {
        classes.parent.insert(ra, rb)
    }
}

fn mc_poison(mut classes: MapClasses, node: ref String) {
    classes.poisoned.insert(node.clone())
}

/// The positions of a private function, all keyed: it is used as a value, or
/// called with other than its number of arguments.
fn mc_poison_function(mut classes: MapClasses, name: ref String, arity: i64) {
    let ret = f"r:{name}"
    mc_poison(classes, ret)
    let mut at = 0
    while at < arity {
        let param = f"p:{name}:{at}"
        mc_poison(classes, param)
        at = at + 1
    }
}

/// The classes of the maps of one file, and which of them keep the fast hash:
/// the `let`s, parameters and results of every class no untrusted key reaches
/// and nothing unseen touches.
pub fn trusted_maps(program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger) -> MapPlan {
    let mut env = MapEnv { sources: collections::BTreeSet(), own: collections::BTreeSet(), privates: collections::BTreeMap() }
    for (key, contract) in library.functions {
        let provenance = contract.provenance ?? continue
        if provenance == Provenance::Untrusted {
            let parts: Vec[ref String] = key.split("::").collect()
            env.sources.insert(parts[parts.len() - 1].clone())
        }
    }
    for item in program.items {
        match item.node {
            Item::Fn { name, generics, args, is_public, is_extern, .. } => {
                tm_remember(name, words, env.own)
                if !is_public && !is_extern && generics.len() == 0 {
                    let symbol = name ?? continue
                    env.privates.insert(symbol, args.len())
                }
            },
            Item::Impl { methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { name, .. } => tm_remember(name, words, env.own),
                        else => {}
                    }
                }
            },
            else => {}
        }
    }
    let mut classes = MapClasses { parent: collections::BTreeMap(), poisoned: collections::BTreeSet(), lets: [], slots: [], unread: false, escaped: [] }
    let mut counter = 0
    for item in program.items {
        match item.node {
            Item::Fn { name, generics, args, body, is_public, is_extern, .. } => {
                let mut fname: String = "fn"
                let mut alone = false
                if !is_public && !is_extern && generics.len() == 0 {
                    let symbol = name
                    if symbol != null {
                        fname = words.resolve(symbol ?? continue).clone()
                        alone = true
                    }
                }
                if !alone {
                    counter = counter + 1
                    fname = f"#{counter}"
                }
                tm_walk_function(fname, alone, args, body, words, library, env, classes)
            },
            Item::Impl { methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { args, body, .. } => {
                            counter = counter + 1
                            let fname = f"#{counter}"
                            tm_walk_function(fname, false, args, body, words, library, env, classes)
                        },
                        else => {}
                    }
                }
            },
            Item::Struct { .. } => {},
            Item::Enum { .. } => {},
            Item::Extern { .. } => {},
            Item::Import { .. } => {},
            // A test, a bench, a trait's default, a comptime block or a grammar:
            // code this does not read, which could call any function.
            else => {
                classes.unread = true
            }
        }
    }
    if classes.unread {
        let every = classes.slots.clone()
        for slot in every {
            mc_poison(classes, slot)
        }
    }
    let mut bad: collections::BTreeSet[String] = collections::BTreeSet()
    for node in classes.poisoned {
        bad.insert(mc_find(classes, node))
    }
    let mut plan = MapPlan { lets: collections::BTreeSet(), slots: collections::BTreeSet(), escaped: collections::BTreeSet() }
    for at in classes.escaped {
        plan.escaped.insert(at)
    }
    for at in classes.lets {
        let node = f"l:{at}"
        if !bad.contains(mc_find(classes, node)) {
            plan.lets.insert(at)
        }
    }
    for slot in classes.slots {
        if !bad.contains(mc_find(classes, slot)) {
            plan.slots.insert(slot.clone())
        }
    }
    return plan
}

fn tm_remember(name: winnow_grammar::Symbol?, words: ref winnow_grammar::InternerContext, mut own: collections::BTreeSet[String]) {
    let symbol = name ?? return
    own.insert(words.resolve(symbol).clone())
}

fn tm_walk_function(fname: ref String, alone: bool, args: ref Vec[FnArg], body: ref Block, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses) {
    let ret = f"r:{fname}"
    let mut first: collections::BTreeMap[winnow_grammar::Symbol, i64] = collections::BTreeMap()
    let mut walk = MapWalk { nodes: [], ret: ret.clone(), scopes: [], given: [], made: [], kept: [], escapes: collections::BTreeSet(), bound: collections::BTreeMap(), unread: false }
    if alone {
        classes.slots.push(ret.clone())
    } else {
        mc_poison(classes, ret)
    }
    let mut at = 0
    for arg in args {
        let node = f"p:{fname}:{at}"
        if alone {
            classes.slots.push(node.clone())
        } else {
            mc_poison(classes, node)
        }
        let id = walk.given.len()
        walk.given.push([tm_never()])
        walk.nodes.push(node.clone())
        let name = arg.name.clone()
        walk.made.push(MapMade { at: -1, name: name.clone(), id: id })
        tm_count_binding(name, walk)
        first.insert(name.clone(), id)
        at = at + 1
    }
    walk.scopes.push(first)
    tm_walk_block(body, words, library, env, classes, walk)
    if walk.unread {
        classes.unread = true
        for made in walk.made {
            if made.at >= 0 && walk.escapes.contains(made.id) {
                classes.escaped.push(made.at)
            }
        }
        for node in walk.nodes {
            mc_poison(classes, node)
        }
        mc_poison(classes, ret)
        return
    }
    let trusted = tm_trusted_bindings(walk.given)
    for kept in walk.kept {
        let mut keys_trusted = kept.deps.known
        for dep in kept.deps.ids {
            if !trusted.contains(dep) {
                keys_trusted = false
            }
        }
        if !keys_trusted {
            mc_poison(classes, walk.nodes[kept.id])
        }
    }
    // **Any other use is the map leaving**: bound again, returned from a
    // block, assigned, handed to anything but a private function's parameter.
    for id in walk.escapes {
        mc_poison(classes, walk.nodes[id])
    }
    for made in walk.made {
        // Bound once, so every use of the name in the body is this binding.
        if (walk.bound.get(made.name) ?? 0) != 1 {
            mc_poison(classes, walk.nodes[made.id])
        }
        if made.at >= 0 {
            classes.lets.push(made.at)
            if walk.escapes.contains(made.id) {
                classes.escaped.push(made.at)
            }
        }
    }
}

/// Which bindings are trusted: the greatest answer that holds, so a name that
/// feeds itself (`x = x + 1`) is as trusted as what else it is given.
fn tm_trusted_bindings(given: ref Vec[Vec[KeyDeps]]) -> collections::BTreeSet[i64] {
    let mut trusted: collections::BTreeSet[i64] = collections::BTreeSet()
    let mut id = 0
    while id < given.len() {
        let mut every = true
        for one in given[id] {
            if !one.known {
                every = false
            }
        }
        if every {
            trusted.insert(id)
        }
        id = id + 1
    }
    let mut settled = false
    while !settled {
        let mut now: collections::BTreeSet[i64] = collections::BTreeSet()
        for id in trusted {
            now.insert(id)
        }
        let mut next: collections::BTreeSet[i64] = collections::BTreeSet()
        for id in now {
            let mut holds = true
            for one in given[id] {
                if !one.known {
                    holds = false
                }
                for dep in one.ids {
                    if !now.contains(dep) {
                        holds = false
                    }
                }
            }
            if holds {
                next.insert(id)
            }
        }
        if next.len() == now.len() {
            settled = true
        }
        trusted = next
    }
    return trusted
}

fn tm_bind(name: winnow_grammar::Symbol, given: ref KeyDeps, node: ref String, mut walk: MapWalk) -> i64 {
    let id = walk.given.len()
    walk.nodes.push(node.clone())
    walk.given.push([KeyDeps { known: given.known, ids: given.ids.clone() }])
    tm_count_binding(name, walk)
    let last = walk.scopes.len() - 1
    walk.scopes[last].insert(name.clone(), id)
    return id
}

fn tm_opaque(name: winnow_grammar::Symbol, mut walk: MapWalk) {
    tm_count_binding(name, walk)
    let last = walk.scopes.len() - 1
    walk.scopes[last].insert(name.clone(), -1)
}

fn tm_count_binding(name: winnow_grammar::Symbol, mut walk: MapWalk) {
    let before = walk.bound.get(name) ?? 0
    walk.bound.insert(name.clone(), before + 1)
}

/// The binding a name reads here: `-2` where nothing binds it, `-1` where
/// what binds it is never trusted.
fn tm_resolve(name: winnow_grammar::Symbol, walk: ref MapWalk) -> i64 {
    let mut at = walk.scopes.len()
    while at > 0 {
        at = at - 1
        let found = walk.scopes[at].get(name)
        if found != null {
            return found ?? -2
        }
    }
    return -2
}

fn tm_walk_block(block: ref Block, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    walk.scopes.push(collections::BTreeMap())
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, value, .. } => {
                let given = tm_deps_of(value, words, library, env, walk)
                if names.len() == 1 {
                    let name = names[0].clone()
                    let node = f"l:{stmt.span.start}"
                    // **Where the value comes from decides the class**: a
                    // map made here has none to join; a name or a private
                    // function's result is the same class as the let.
                    if is_a_map_made(value, words) {
                        tm_walk_expr(value, words, library, env, classes, walk)
                    } else {
                        tm_flow(node, value, words, library, env, classes, walk)
                    }
                    let id = tm_bind(name, given, node, walk)
                    walk.made.push(MapMade { at: stmt.span.start as i64, name: name.clone(), id: id })
                } else {
                    tm_walk_expr(value, words, library, env, classes, walk)
                    for one in names {
                        tm_opaque(one.clone(), walk)
                    }
                }
            },
            Stmt::Assign { target, value, .. } => {
                tm_walk_expr(target, words, library, env, classes, walk)
                tm_walk_expr(value, words, library, env, classes, walk)
                match target {
                    Expr::Variable(name, _) => {
                        let given = tm_deps_of(value, words, library, env, walk)
                        let id = tm_resolve(name.clone(), walk)
                        if id >= 0 {
                            walk.given[id].push(given)
                        }
                    },
                    else => {}
                }
            },
            Stmt::For { bindings, iter, body, .. } => {
                match iter {
                    Expr::Variable(name, _) => {
                        let id = tm_resolve(name.clone(), walk)
                        if id >= 0 {
                            walk.kept.push(MapKept { id: id, deps: tm_nothing() })
                        }
                    },
                    else => tm_walk_expr(iter, words, library, env, classes, walk),
                }
                let given = tm_deps_of(iter, words, library, env, walk)
                walk.scopes.push(collections::BTreeMap())
                for one in bindings {
                    let node = f"b:{walk.given.len()}"
                    tm_bind(one.clone(), given, node, walk)
                }
                tm_walk_block(body, words, library, env, classes, walk)
                walk.scopes.pop()
            },
            Stmt::While { cond, body } => {
                tm_walk_expr(cond, words, library, env, classes, walk)
                tm_walk_block(body, words, library, env, classes, walk)
            },
            Stmt::Expr(value) => tm_walk_expr(value, words, library, env, classes, walk),
            Stmt::Return(value) => {
                if value != null {
                    let ret = walk.ret.clone()
                    tm_flow(ret, value ?? return, words, library, env, classes, walk)
                }
            },
            else => {
                walk.unread = true
            }
        }
    }
    walk.scopes.pop()
}

/// The private function `func` names, where it is called by its name and no
/// binding in the body hides it; nothing otherwise.
fn tm_private_callee(func: ref Expr, env: ref MapEnv, walk: ref MapWalk) -> winnow_grammar::Symbol? {
    return match func {
        Expr::Variable(name, _) => {
            if tm_resolve(name.clone(), walk) == -2 && env.privates.contains_key(name) {
                name.clone()
            } else {
                null
            }
        },
        else => null,
    }
}

/// What a call hands a private function: each argument is a value flowing
/// into the parameter of its place.
fn tm_call_args(callee: winnow_grammar::Symbol, args: ref Vec[Expr], config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    let arity = env.privates.get(callee) ?? -1
    let written = words.resolve(callee)
    if arity != args.len() {
        mc_poison_function(classes, written, arity)
        for a in args {
            tm_walk_expr(a, words, library, env, classes, walk)
        }
    } else {
        let mut at = 0
        for a in args {
            let param = f"p:{written}:{at}"
            tm_flow(param, a, words, library, env, classes, walk)
            at = at + 1
        }
    }
    for c in config {
        tm_walk_expr(c.value, words, library, env, classes, walk)
    }
}

/// A value flowing into the position `sink`: from a name, or from a private
/// function's result, it is one class with that; from anything else the
/// class is keyed, because where it comes from is not followed.
fn tm_flow(sink: ref String, value: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    match value {
        Expr::Variable(name, _) => {
            let id = tm_resolve(name.clone(), walk)
            if id >= 0 {
                let node = walk.nodes[id].clone()
                mc_union(classes, sink, node)
            } else {
                mc_poison(classes, sink)
                tm_walk_expr(value, words, library, env, classes, walk)
            }
        },
        Expr::Call { func, args, config, .. } => {
            let found = tm_private_callee(func, env, walk)
            if found != null {
                let callee = found ?? return
                let ret = f"r:{words.resolve(callee)}"
                mc_union(classes, sink, ret)
                tm_call_args(callee, args, config, words, library, env, classes, walk)
            } else {
                mc_poison(classes, sink)
                tm_walk_expr(value, words, library, env, classes, walk)
            }
        },
        else => {
            mc_poison(classes, sink)
            tm_walk_expr(value, words, library, env, classes, walk)
        }
    }
}

/// The map `receiver` names, if it names one: its binding, else `-1`.
fn map_named(receiver: ref Expr, words: ref winnow_grammar::InternerContext, walk: ref MapWalk) -> i64 {
    return match receiver {
        Expr::Variable(name, _) => {
            let id = tm_resolve(name.clone(), walk)
            if id >= 0 { id } else { -1 }
        },
        else => -1,
    }
}

/// An expression where it stands: the uses of a map in it, read with the
/// names bound here, and the blocks inside it walked with their own.
fn tm_walk_expr(expr: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    match expr {
        Expr::Block(b, _) => tm_walk_block(b, words, library, env, classes, walk),
        Expr::Unsafe(b, _) => tm_walk_block(b, words, library, env, classes, walk),
        Expr::If { cond, then_branch, else_branch, .. } => {
            tm_walk_expr(cond, words, library, env, classes, walk)
            tm_walk_block(then_branch, words, library, env, classes, walk)
            if else_branch != null {
                tm_walk_block(else_branch ?? return, words, library, env, classes, walk)
            }
        },
        Expr::MethodCall { receiver, method, args, config, .. } => {
            let id = map_named(receiver, words, walk)
            if id >= 0 && words.resolve(method) != "clone" {
                let mut all = tm_nothing()
                for a in args {
                    all = tm_join(all, tm_deps_of(a, words, library, env, walk))
                }
                walk.kept.push(MapKept { id: id, deps: all })
            } else {
                tm_walk_expr(receiver, words, library, env, classes, walk)
            }
            for a in args {
                tm_walk_expr(a, words, library, env, classes, walk)
            }
            for c in config {
                tm_walk_expr(c.value, words, library, env, classes, walk)
            }
        },
        Expr::Index { base, index, .. } => {
            let id = map_named(base, words, walk)
            if id >= 0 {
                let deps = tm_deps_of(index, words, library, env, walk)
                walk.kept.push(MapKept { id: id, deps: deps })
            } else {
                tm_walk_expr(base, words, library, env, classes, walk)
            }
            tm_walk_expr(index, words, library, env, classes, walk)
        },
        Expr::Call { func, args, config, .. } => {
            let found = tm_private_callee(func, env, walk)
            if found != null {
                let callee = found ?? return
                // Its result is used where no class follows it.
                let ret = f"r:{words.resolve(callee)}"
                mc_poison(classes, ret)
                tm_call_args(callee, args, config, words, library, env, classes, walk)
            } else {
                tm_walk_expr(func, words, library, env, classes, walk)
                for a in args {
                    tm_walk_expr(a, words, library, env, classes, walk)
                }
                for c in config {
                    tm_walk_expr(c.value, words, library, env, classes, walk)
                }
            }
        },
        Expr::Binary { lhs, rhs, .. } => {
            tm_walk_expr(lhs, words, library, env, classes, walk)
            tm_walk_expr(rhs, words, library, env, classes, walk)
        },
        Expr::Unary { expr, .. } => tm_walk_expr(expr, words, library, env, classes, walk),
        Expr::Cast { expr, .. } => tm_walk_expr(expr, words, library, env, classes, walk),
        Expr::Try(inner, _) => tm_walk_expr(inner, words, library, env, classes, walk),
        Expr::Throw(inner, _) => tm_walk_expr(inner, words, library, env, classes, walk),
        Expr::Field { base, .. } => tm_walk_expr(base, words, library, env, classes, walk),
        Expr::SafeField { base, .. } => tm_walk_expr(base, words, library, env, classes, walk),
        Expr::Coalesce { value, fallback, .. } => {
            tm_walk_expr(value, words, library, env, classes, walk)
            tm_walk_expr(fallback, words, library, env, classes, walk)
        },
        Expr::Tuple(items, _) => {
            for i in items {
                tm_walk_expr(i, words, library, env, classes, walk)
            }
        },
        Expr::ListLit { items, .. } => {
            for i in items {
                tm_walk_expr(i, words, library, env, classes, walk)
            }
        },
        Expr::ListRepeat { value, count, .. } => {
            tm_walk_expr(value, words, library, env, classes, walk)
            tm_walk_expr(count, words, library, env, classes, walk)
        },
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => tm_walk_expr(expr, words, library, env, classes, walk),
                    else => {}
                }
            }
        },
        Expr::Return(value, _) => {
            if value != null {
                let ret = walk.ret.clone()
                tm_flow(ret, value ?? return, words, library, env, classes, walk)
            }
        },
        Expr::Variable(name, _) => {
            let id = tm_resolve(name.clone(), walk)
            if id >= 0 {
                walk.escapes.insert(id)
            }
            // A private function's name where it is not called: a value, so
            // its callers are not all seen.
            if id == -2 {
                let arity = env.privates.get(name) ?? -1
                if arity >= 0 {
                    mc_poison_function(classes, words.resolve(name), arity)
                }
            }
        },
        // A struct literal is code this does not follow (the function stays
        // unread), but what it is built from leaves: a map named in a field is a
        // map that may stand at a hidden parameter (D9).
        Expr::StructLit { fields, .. } => {
            for field in fields {
                if field.value != null {
                    tm_walk_expr(field.value ?? return, words, library, env, classes, walk)
                } else {
                    let id = tm_resolve(field.name.clone(), walk)
                    if id >= 0 {
                        walk.escapes.insert(id)
                    }
                }
            }
            walk.unread = true
        },
        Expr::Path(_, _) => {},
        Expr::LitInt { .. } => {},
        Expr::LitFloat(_, _) => {},
        Expr::LitStr { .. } => {},
        Expr::LitChar(_, _) => {},
        Expr::LitBool(_, _) => {},
        Expr::LitNull(_) => {},
        Expr::Break(_) => {},
        Expr::Continue(_) => {},
        // A lambda, a `match`, a `catch`, a task: names bound some way this
        // does not follow.
        else => {
            walk.unread = true
        }
    }
}

fn tm_all_deps(items: ref Vec[Expr], words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, walk: ref MapWalk) -> KeyDeps {
    let mut all = tm_nothing()
    for item in items {
        all = tm_join(all, tm_deps_of(item, words, library, env, walk))
        if !all.known {
            return all
        }
    }
    return all
}

/// The bindings a value is made of, or nothing where something in it is never
/// trusted.
fn tm_deps_of(value: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, walk: ref MapWalk) -> KeyDeps {
    return match value {
        Expr::LitInt { .. } => tm_nothing(),
        Expr::LitFloat(_, _) => tm_nothing(),
        Expr::LitStr { .. } => tm_nothing(),
        Expr::LitChar(_, _) => tm_nothing(),
        Expr::LitBool(_, _) => tm_nothing(),
        Expr::LitNull(_) => tm_nothing(),
        Expr::Variable(name, _) => {
            let id = tm_resolve(name.clone(), walk)
            if id >= 0 { tm_reading(id) } else { tm_never() }
        },
        Expr::LitInterpolated { parts, .. } => {
            let mut all = tm_nothing()
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => {
                        all = tm_join(all, tm_deps_of(expr, words, library, env, walk))
                    },
                    else => {}
                }
            }
            all
        },
        Expr::Tuple(items, _) => tm_all_deps(items, words, library, env, walk),
        Expr::ListLit { items, .. } => tm_all_deps(items, words, library, env, walk),
        Expr::ListRepeat { value, count, .. } => tm_join(tm_deps_of(value, words, library, env, walk), tm_deps_of(count, words, library, env, walk)),
        Expr::Unary { expr, .. } => tm_deps_of(expr, words, library, env, walk),
        Expr::Cast { expr, .. } => tm_deps_of(expr, words, library, env, walk),
        Expr::Binary { lhs, rhs, .. } => tm_join(tm_deps_of(lhs, words, library, env, walk), tm_deps_of(rhs, words, library, env, walk)),
        Expr::Field { base, .. } => tm_deps_of(base, words, library, env, walk),
        Expr::Index { base, index, .. } => tm_join(tm_deps_of(base, words, library, env, walk), tm_deps_of(index, words, library, env, walk)),
        Expr::Coalesce { value, fallback, .. } => tm_join(tm_deps_of(value, words, library, env, walk), tm_deps_of(fallback, words, library, env, walk)),
        Expr::Call { func, args, config, .. } => tm_call_deps(func, args, config, words, library, env, walk),
        Expr::MethodCall { receiver, method, args, .. } => {
            let name = words.resolve(method)
            if env.sources.contains(name) || env.own.contains(name) {
                tm_never()
            } else {
                tm_join(tm_deps_of(receiver, words, library, env, walk), tm_all_deps(args, words, library, env, walk))
            }
        },
        else => tm_never(),
    }
}

fn tm_call_deps(func: ref Expr, args: ref Vec[Expr], config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, walk: ref MapWalk) -> KeyDeps {
    let name = match func {
        Expr::Path(segments, _) => {
            let mut joined: String = ""
            for segment in segments {
                if !joined.is_empty() {
                    joined.push_str("::")
                }
                joined.push_str(words.resolve(segment))
            }
            joined
        },
        Expr::Variable(one, _) => words.resolve(one).clone(),
        else => return tm_never(),
    }
    if env.own.contains(name) {
        return tm_never()
    }
    let contract = library.functions[name] ?? return tm_never()
    if contract.provenance != null {
        let provenance = contract.provenance ?? return tm_never()
        if provenance == Provenance::Trusted {
            return tm_nothing()
        }
        return tm_never()
    }
    let mut all = tm_all_deps(args, words, library, env, walk)
    for c in config {
        all = tm_join(all, tm_deps_of(c.value, words, library, env, walk))
    }
    return all
}

/// `HashMap()` and `HashSet()`, with nothing in the parentheses.
fn is_a_map_made(value: ref Expr, words: ref winnow_grammar::InternerContext) -> bool {
    return match value {
        Expr::Call { func, args, .. } => {
            if args.len() != 0 {
                false
            } else {
                match func {
                    Expr::Path(segments, _) => {
                        let last = words.resolve(segments[segments.len() - 1])
                        last == "HashMap" || last == "HashSet"
                    },
                    Expr::Variable(one, _) => {
                        let last = words.resolve(one)
                        last == "HashMap" || last == "HashSet"
                    },
                    else => false,
                }
            }
        },
        else => false,
    }
}
