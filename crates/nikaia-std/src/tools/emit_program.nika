// crates/nikaia-std/src/tools/emit_program.nika
//
// **A unit's text**, moved from `emit/mod.rs` (ADR-294, #125, #583, E11-3):
// the preamble of a whole program, the shadow types of its `dsl` statements,
// its error sums, every item (a generic body that walks a shape once per type
// it was used with), the handle types and the `fn main` Rust runs. What the
// Rust side keeps is the source map, the empty abort table of a program
// emitted without its file name and the refusal of an item this lowering does
// not write, which names the item's tree.

impl EmitState {
    /// The unit: with `whole`, a program with its preamble; without, a
    /// module's items and nothing else - no preamble, no `mod` header.
    pub fn emit_program[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, whole: bool) sync throws {
        if whole {
            self.emit_program_preamble(world, out)
        }
        self.emit_program_shadow_types(world, out)
        self.write_error_sums(world, out)
        for item in world.items {
            // **One copy per type it was used with, and no generic original**
            // ([ADR-304](../../docs/specification/adr/adr-304.md) D6): the
            // generic body holds a loop over a shape, which has no form in the
            // language below. It is **unrolled**, which is
            // [ADR-304](../../docs/specification/adr/adr-304.md) D5's *one loop*
            // arrived at rather than added - `T::fields` is known while the
            // program is built, so there is no run-time reading to rule out.
            let shape = self.walks_a_shape(world, item.node) ?? ""
            if shape != "" {
                let mut copies: Vec[String] = []
                for ((written, on), _) in self.facts.unrolled {
                    if written == shape {
                        copies.push(on.clone())
                    }
                }
                for on in copies {
                    let walked = self.walked_parameter(world, item.node).clone()
                    walk.specialising = EmitPair { first: walked, second: on.clone() }
                    let st = out.mark()
                    host.refuse_unwritten_item(item)
                    self.emit_item(world, walk, out, host, item)
                    walk.specialising = null
                    out.record(item.span, st)
                    out.push("\n")
                }
                continue
            }
            let st = out.mark()
            host.refuse_unwritten_item(item)
            self.emit_item(world, walk, out, host, item)
            out.record(item.span, st)
            out.push("\n")
        }
        self.emit_program_tether_wrappers(world, walk, out)
        self.emit_program_entry_point(world, out, host)
    }

    /// What a whole program opens with.
    fn emit_program_preamble(ref self, world: ref EmitWorld, mut out: EmitOut) {
        out.push("// Generated by the Nikaia bootstrap compiler (Stage 0).\n")
        out.push("// Edit the .nika source, not this file.\n\n")
        let mut grammars = false
        for item in world.items {
            match item.node {
                Item::Grammar(_) => { grammars = true },
                else => {},
            }
        }
        if grammars {
            out.push("use winnow_grammar::grammar;\n")
        }
        if self.uses_driver(world) {
            out.push("use winnow_grammar::rt::Parallelism;\n")
            out.push("use winnow_grammar::ParseContext;\n")
        }
        // Always, except in `std` itself, which is the prelude - see
        // `Needs::preamble`, the copy of this that a program of several files
        // uses.
        if !self.is_std {
            out.push("#[allow(unused_imports)]\npub use nikaia_std::prelude::*;\n")
        }
        if self.fails {
            // Kap 7.1: `error.full()` is a method on whatever a `catch` bound, so
            // the trait has to be in scope even in a program that imports no `std`
            // module of its own - `throw` needs `std` whether or not the source
            // mentions it.
            out.push("#[allow(unused_imports)]\npub use nikaia_std::error::Full;\n")
        }
        out.push("\n")
    }

    /// The shadow type of every deferred-parameter DSL in this unit
    /// (ADR-296 D5).
    ///
    /// One struct per parameter list, a field per `:name`, and **generic in
    /// every field**: nothing in `… WHERE id = :id …` says what `:id` is, so
    /// the type comes from the argument at the call site and is monomorphised
    /// there. Inventing `i32` here is exactly the guess ADR-296 D17 forbids an
    /// emitter to make. A plain struct, passed by value: D5 asks for the
    /// parameters on the stack.
    fn emit_program_shadow_types(ref self, world: ref EmitWorld, mut out: EmitOut) {
        for (name, parameters) in shadow_types(world.words, world.items) {
            let mut generics: Vec[String] = []
            let mut fields: Vec[String] = []
            for i in 0..<parameters.len() {
                generics.push(f"P{i}")
                fields.push(f"    pub {parameters[i]}: P{i},")
            }
            let listed = generics.join(", ")
            let body = fields.join("\n")
            out.push(f"// ADR-296 D5: the parameters of a `dsl … {{ … }} eod` statement, as a type.\n#[derive(Debug, Clone, Copy, PartialEq)]\n#[allow(non_camel_case_types, dead_code)]\npub struct {name}<{listed}> {{\n{body}\n}}\n\n")
        }
    }

    /// The handle types, at the end of the unit.
    fn emit_program_tether_wrappers(ref self, world: ref EmitWorld, walk: ref EmitWalk, mut out: EmitOut) {
        for wrapper in walk.wrappers {
            out.push("\n")
            out.push(wrapper)
        }
        out.push(self.held_structs(world))
    }

    /// The `fn main` Rust runs: ADR-303 D4, as five lines of generated code.
    ///
    /// The runtime is started *before* the program's first statement and
    /// drained after its last, so an operation inside the program costs no
    /// thread start and no thread wake-up (ADR-292). What starts is what
    /// ADR-037 D2 allows, and the *compiler* is what knows which:
    /// `user_parallelism` is a build switch, so it is written into this call
    /// rather than read from the operator's runtime configuration file.
    fn emit_program_entry_point[H: EmitHost](ref self, world: ref EmitWorld, mut out: EmitOut, host: ref H) {
        let channel = self.error_channel(world, "main", true, EmitLifetimes::Elided.params(), EmitLifetimes::Static.params(), false)
        // **`main`'s parameters as its definition spells them**
        // ([ADR-360](../../docs/specification/adr/adr-360.md) D1): the words
        // are read into locals that own them, and a parameter the body only
        // reads (`&[T]`, `&str`) is lent from its local: `passing` writes the
        // argument, `{}` standing for the local.
        let mut types: Vec[String] = []
        let mut passing: Vec[String] = []
        for param in host.main_params() {
            let ty = emit_program_param_type(param)
            if ty == "&str" {
                types.push("String")
                passing.push("&{}")
            } else if ty == "Option<&str>" {
                types.push("Option<String>")
                passing.push("{}.as_deref()")
            } else if ty.starts_with("&[") && ty.ends_with("]") {
                let element = (ty.strip_prefix("&[") ?? "").strip_suffix("]") ?? ""
                types.push(f"Vec<{element}>")
                passing.push("&{}")
            } else if ty.starts_with("&") && !ty.starts_with("&mut ") {
                // Any other view the body only reads, `&Option<String>` for an
                // unused `String?` among them (#703), is lent from the local
                // that owns the word.
                types.push((ty.strip_prefix("&") ?? "").to_string())
                passing.push("&{}")
            } else {
                let mut owned = ty.clone()
                while owned.starts_with("&mut ") {
                    owned = (owned.strip_prefix("&mut ") ?? "").to_string()
                }
                types.push(owned)
                passing.push("{}")
            }
        }
        let entry = self.entry_point(world, host.user_parallelism(), channel, types, passing)
        if entry.is_empty() {
            return
        }
        out.push(entry)
        // **The program's allocator is the system's**, with a free that
        // `skip-free-at-exit:on` skips once `main` has ended
        // ([ADR-348](../../docs/specification/adr/adr-348.md) D1). Written
        // here and not in `std`, which has no `unsafe` (ADR-218).
        if host.skip_free_at_exit() {
            out.push(emit_program_allocator())
        }
    }
}

/// The type a parameter of `main` was written with, `_` where it names none.
fn emit_program_param_type(param: String) -> String {
    let parts: Vec[String] = param.split(": ").collect()
    if parts.len() < 2 {
        return "_"
    }
    let mut ty = parts[1].clone()
    for i in 2..<parts.len() {
        ty = f"{ty}: {parts[i]}"
    }
    return ty
}

/// **The allocator of a program built with `skip-free-at-exit:on`**: the
/// system's, with a free that it skips once `main` has ended.
fn emit_program_allocator() -> String {
    let lines: Vec[String] = [
        "",
        "struct NikaiaHeap;",
        "// SAFETY: every call is the system allocator's; a free that is skipped leaves",
        "// the block allocated until the process ends, which is always sound.",
        "unsafe impl std::alloc::GlobalAlloc for NikaiaHeap {",
        "    #[inline]",
        "    unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {",
        "        unsafe { std::alloc::GlobalAlloc::alloc(&std::alloc::System, layout) }",
        "    }",
        "    #[inline]",
        "    unsafe fn alloc_zeroed(&self, layout: std::alloc::Layout) -> *mut u8 {",
        "        unsafe { std::alloc::GlobalAlloc::alloc_zeroed(&std::alloc::System, layout) }",
        "    }",
        "    #[inline]",
        "    unsafe fn dealloc(&self, ptr: *mut u8, layout: std::alloc::Layout) {",
        "        if nikaia_std::rt::exit::frees() {",
        "            unsafe { std::alloc::GlobalAlloc::dealloc(&std::alloc::System, ptr, layout) }",
        "        }",
        "    }",
        "    #[inline]",
        "    unsafe fn realloc(&self, ptr: *mut u8, layout: std::alloc::Layout, size: usize) -> *mut u8 {",
        "        unsafe { std::alloc::GlobalAlloc::realloc(&std::alloc::System, ptr, layout, size) }",
        "    }",
        "}",
        "#[global_allocator]",
        "static NIKAIA_HEAP: NikaiaHeap = NikaiaHeap;",
        "",
    ]
    return lines.join("\n")
}
