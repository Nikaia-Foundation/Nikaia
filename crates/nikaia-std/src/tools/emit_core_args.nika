// crates/nikaia-std/src/tools/emit_core_args.nika
//
// **The arguments and the call of the emitter's core** (ADR-294, #125, #558, E9
// unit U5): `args`, which writes each argument of a call with what the checker
// found out about its position (a lent view, a `mut` place, a wrapped plain
// value, a count, a pointer for C, a function run at a pausing place), and
// `called`, the call itself without ADR-023 D8's propagation: the walking
// functions, the hulls, the doors over several locks, `println`, a struct's
// constructor, `std`'s and a package's, a scope that polls its tasks, and the
// ordinary call with its options and its keep. Methods of `EmitState`,
// `emit_core_*[H: EmitHost]`; the Rust method of the same name is a one-line
// stub. `expr` stays a host method until U10.

use std::collections

/// How a call makes the address of an `extern` position, as one number: 0 for
/// none, 1 and 2 a run (`.as_ptr()`, `.as_mut_ptr()`), 3 and 4 one value (`&`,
/// `&mut`), 5 a handle given to its release, 6 a handle lent.
fn emit_arg_pointer_code(found: ref EmitPointer?) -> i64 {
    let each = found ?? return 0
    return match each {
        EmitPointer::Run { mutable } => if mutable { 2 } else { 1 },
        EmitPointer::Reference { mutable } => if mutable { 4 } else { 3 },
        EmitPointer::Handle { give } => if give { 5 } else { 6 },
    }
}

/// What a parameter of type `ty` is opened with when a view is lent inside its
/// option (`ref String?` is an `Option<&str>`): empty where it is not a
/// nullable view.
fn emit_arg_opening_of(ty: ref Ty) -> String {
    return match ty {
        Ty::Nullable(inner) => emit_arg_opening_inside(inner),
        else => "",
    }
}

fn emit_arg_opening_inside(inner: ref Ty) -> String {
    if !inner.is_a_view() {
        return ""
    }
    return match inner {
        Ty::Named { name, .. } => if emit_base(name) == "String" || emit_base(name) == "str" { ".as_deref()" } else { ".as_ref()" },
        else => ".as_ref()",
    }
}

fn emit_arg_lends_own(contract: ref FnContract, at: i64, library: ref Ledger, described: ref Ledger) -> bool {
    return lends_in_own(contract, at, [library, described])
}

/// The opening of argument `i` in one contract.
fn emit_arg_opening_in(contract: ref FnContract, i: i64) -> String {
    let signature = contract.signature?.clone() ?? return ""
    let params = call_arguments(signature)
    if i >= params.len() {
        return ""
    }
    return emit_arg_opening_of(params[i].1)
}

/// Whether the argument is a name, or a field of one.
fn emit_arg_names_a_place(arg: ref Expr) -> bool {
    return match arg {
        Expr::Variable(_, _) => true,
        Expr::Field { .. } => true,
        else => false,
    }
}

/// Whether the argument is a place that goes through an index: `xs[i]`,
/// `b.xs[i]`, `xs[i].inner`.
fn emit_arg_through_index(arg: ref Expr) -> bool {
    return match arg {
        Expr::Index { .. } => true,
        Expr::Field { base, .. } => emit_arg_through_index(base),
        else => false,
    }
}

fn emit_arg_is_closure(arg: ref Expr) -> bool {
    return match arg {
        Expr::Closure { .. } => true,
        else => false,
    }
}

fn emit_arg_is_null(arg: ref Expr) -> bool {
    return match arg {
        Expr::LitNull(_) => true,
        else => false,
    }
}

/// A text literal that is a view as it stands (ADR-282 D5).
fn emit_arg_is_text_literal(arg: ref Expr) -> bool {
    return match arg {
        Expr::LitStr { .. } => true,
        else => false,
    }
}

/// The key of an argument that names a function: a name, or a path as written.
fn emit_arg_function_key(world: ref EmitWorld, arg: ref Expr) -> String? {
    return match arg {
        Expr::Variable(name, _) => emit_text(world, name),
        Expr::Path(parts, _) => emit_arg_joined(world, parts),
        else => null,
    }
}

fn emit_arg_joined(world: ref EmitWorld, parts: ref Vec[winnow_grammar::Symbol]) -> String {
    let mut names: Vec[String] = []
    for part in parts {
        names.push(emit_text(world, part))
    }
    return names.join("::")
}

impl EmitWalk {
    /// The buffers whose keeps hold the argument `i` of the call being written.
    fn buffers_held_at(ref self, i: i64) -> Vec[i64]? {
        let all = self.hold_args ?? return null
        for (key, buffers) in all {
            if key == i {
                return buffers.clone()
            }
        }
        return null
    }
}

impl EmitState {
    /// Whether the callee's name is the function the call stands in: each `&` is
    /// a new type there, and the function would instantiate itself without end.
    fn emit_arg_calls_itself(ref self, function: ref String, callee: ref String) -> bool {
        return function == callee || function.ends_with(ref f"::{callee}")
    }

    /// Whether a `mut` parameter handed to a `mut` parameter goes on as the
    /// `&mut` it is (ADR-094 D3), and not read as its number.
    fn emit_arg_handed_on_changed(ref self, world: ref EmitWorld, function: ref String, callee: ref String, i: i64, arg: ref Expr) -> bool {
        return match arg {
            Expr::Variable(name, _) => self.copied_in_place(function, emit_text(world, name)) && self.changes_at(callee, i),
            else => false,
        }
    }

    /// A code parameter a method took whole, handed on to code that only runs
    /// it (#463).
    fn emit_arg_code_handed_on(ref self, world: ref EmitWorld, function: ref String, callee: ref String, i: i64, arg: ref Expr) -> bool {
        return match arg {
            Expr::Variable(name, _) => self.a_code_parameter_taken_whole(world, function, emit_text(world, name)) && self.runs_code_at(callee, i),
            else => false,
        }
    }

    /// Whether this unit's function `callee` only reads its parameter `i`,
    /// which is then lowered a `&str` (`Option<&str>`) below whatever text
    /// flows in (ADR-282 D5, D11): a view is lent as it is, not wrapped (#598).
    fn emit_arg_only_read(ref self, world: ref EmitWorld, callee: ref String, i: i64) -> bool {
        let contract = self.own_contracts.functions.get(callee) ?? return false
        let signature = contract.signature?.clone() ?? return false
        if signature.takes_a_receiver() {
            return false
        }
        return emit_arg_lends_own(contract, i, world.library, self.described)
    }

    /// Whether `callee` takes its parameter `i` as a `Bytes` with its owner
    /// (ADR-373 D1, D4): a `ref Bytes` it keeps, lowered to `&Bytes`.
    fn emit_arg_keeps_bytes(ref self, world: ref EmitWorld, callee: ref String, method_callee: ref String?, i: i64) -> bool {
        // **A method is the one its receiver's type resolves to** (#842):
        // `self` is position 0. A call the checker resolved to no method (a
        // closure in a field) is never wrapped.
        if method_callee != null {
            let key = method_callee ?? return false
            if self.own_contracts.functions.contains_key(key) {
                let c = self.own_contracts.functions.get(key) ?? return false
                return emit_takes_self(c) && keeps_its_bytes(c, i + 1)
            }
            let c = world.library.functions.get(key) ?? return false
            return emit_takes_self(c) && keeps_its_bytes(c, i + 1)
        }
        if self.own_contracts.functions.contains_key(callee) {
            return keeps_its_bytes(self.own_contracts.functions.get(callee) ?? return false, i)
        }
        return keeps_its_bytes(world.library.functions.get(callee) ?? return false, i)
    }

    /// The opening a lent view gets inside the option a nullable parameter is:
    /// the declaration's own where this unit has the callee, else the one every
    /// method of that name agrees on (#462). Empty where there is none.
    fn emit_arg_opening(ref self, callee: ref String, i: i64) -> String {
        if self.own_contracts.functions.contains_key(callee) {
            let contract = self.own_contracts.functions.get(callee) ?? return ""
            return emit_arg_opening_in(contract, i)
        }
        let candidates = emit_candidates(self.own_contracts, callee)
        let mut first: String = ""
        let mut seen = false
        let mut agree = true
        for candidate in candidates {
            let each = emit_arg_opening_in(candidate, i)
            if !seen {
                first = each
                seen = true
            } else if each != first {
                agree = false
            }
        }
        if seen && agree {
            return first
        }
        return ""
    }

    /// The arity of the function a position that runs code is handed, where it
    /// never pauses and is run where a pause may happen (#516): `-1` otherwise.
    fn emit_arg_run_async(ref self, world: ref EmitWorld, statement: i64, i: i64, arg: ref Expr) -> i64 {
        let place = node_key(arg)
        if !self.facts.sync_functions_run_async.contains_key(place) {
            return -1
        }
        let key = emit_arg_function_key(world, arg) ?? return -1
        if call_pauses(self.own_contracts, key) || call_library_pauses(world.library, key) != null {
            return -1
        }
        return self.facts.sync_functions_run_async.get(place) ?? -1
    }

    /// The count of parameters of a declared function named where a
    /// `fn(..) throws` parameter runs it, where its channel is not the box
    /// that type fails in (ADR-280 D9, #703); `-1` otherwise. One that pauses
    /// is handed over as it is.
    fn emit_arg_into_the_box(ref self, world: ref EmitWorld, arg: ref Expr) -> i64 {
        let arity = self.facts.boxed_fn_values.get(node_key(arg)) ?? return -1
        let key = emit_arg_function_key(world, arg) ?? return -1
        if call_pauses(self.own_contracts, key) {
            return -1
        }
        if self.error_channel(world, key, true, "", "", false) == "Box<dyn std::error::Error>" {
            return -1
        }
        return arity
    }

    /// Each argument of a call, with what the checker found out about its
    /// position. `callee` is the callee as the source wrote it: Part I 2.3's
    /// wrap is keyed by it, because a statement may hold several calls and one
    /// call several arguments. `takes_a_handle` says which positional
    /// parameters take a handle on a shared value by value (empty where nothing
    /// does or nothing is known).
    pub fn emit_core_args[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, callee: ref String, args: ref Vec[Expr], takes_a_handle: ref Vec[bool], depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        // **This call's mask and no other's**: taken here, so a call written
        // inside one of these arguments does not see it.
        let boxed_mask: Vec[bool] = (walk.boxed_args?.clone() ?? [])
        walk.boxed_args = null
        let method_callee: String? = walk.method_callee?.clone()
        walk.method_callee = null
        let part_counts: Vec[Count] = (walk.variant_counts?.clone() ?? [])
        walk.variant_counts = null
        // **An argument bound ahead of the call**: written as it would
        // be in place, into the `let` the call is preceded by.
        let hoisted: Vec[i64] = (walk.hoisted_args?.clone() ?? [])
        walk.hoisted_args = null
        let mut lets = EmitOut::empty()
        let mut i = 0
        for arg in args {
            if i > 0 {
                out.push(", ")
            }
            if hoisted.contains(i) {
                let mut one = EmitOut::empty()
                self.emit_core_argument(world, walk, one, host, callee, method_callee, arg, i, boxed_mask, part_counts, takes_a_handle, depth, flow, scope)
                lets.push(f"let __nikaia_arg{i} = ")
                lets.append(one)
                lets.push("; ")
                out.push(f"__nikaia_arg{i}")
            } else {
                self.emit_core_argument(world, walk, out, host, callee, method_callee, arg, i, boxed_mask, part_counts, takes_a_handle, depth, flow, scope)
            }
            i += 1
        }
        if hoisted.len() > 0 {
            walk.hoisted_lets = lets
        }
    }

    /// One argument.
    fn emit_core_argument[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, callee: ref String, method_callee: ref String?, arg: ref Expr, i: i64, boxed_mask: ref Vec[bool], part_counts: ref Vec[Count], takes_a_handle: ref Vec[bool], depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        if i < part_counts.len() {
            walk.hull_count = part_counts[i]
        } else {
            walk.hull_count = null
        }
        // **A text pattern of one scalar is that character** (#617).
        let scalar = self.facts.char_patterns.get(node_key(arg)) ?? ""
        if scalar != "" {
            out.push(scalar.clone())
            return
        }
        // **`entry`'s key built into the map's text** (#676).
        if self.facts.owned_entry_keys.contains(node_key(arg)) {
            out.push("String::from(")
            host.expr(walk, out, arg, depth, flow, scope)
            out.push(")")
            return
        }
        // **A part of a variant that is boxed is built in its box** (ADR-246 D3),
        // around everything else this argument is written with.
        let boxed_here = i < boxed_mask.len() && boxed_mask[i]
        if boxed_here {
            out.push("Box::new(")
        }
        let node = node_key(arg)
        // **A lookup's key of no known type** (0.0.235): the reference the map
        // wants, whichever of a number or a view the key turns out to be.
        if i == 0 && self.facts.lookup_keys.contains(node) {
            out.push("nikaia_std::index::AsKey::as_key(&")
            host.expr(walk, out, arg, depth, flow, scope)
            out.push(")")
            return
        }
        // **Text of its own looked up among views of text** (#659): as its
        // `str`.
        if i == 0 {
            let keyed = self.map_key(arg, false)
            if keyed != null {
                let form = keyed ?? return
                self.emit_core_key(world, walk, out, host, form, arg, depth, flow, scope)
                return
            }
        }
        // ADR-312 D1: a handle on a shared value is **duplicated, never moved**,
        // where it is handed on by value, and only where the argument names one.
        let duplicate = i < takes_a_handle.len() && takes_a_handle[i] && emit_arg_names_a_place(arg)
        // Part I 2.3: a plain value in a parameter the callee declares nullable.
        let (before, after) = emit_leaf_wrapped(self.facts.nullable_args, node, arg)
        // **A count the language below wants in `usize`** (ADR-285 D15), not
        // where the argument is written only in literals, and a `usize` a C
        // declaration names is one too (ADR-302 D6).
        let wants_a_size = is_count(callee, i) || self.takes_a_size(world, callee, i) || self.facts.count_args.contains(node)
        let count = wants_a_size && !only_literals(arg)
        // **The caller writes no `&`** (ADR-094 D1): where the callee reads this
        // argument rather than keeping it, the reference is the compiler's. A
        // literal is a view already (ADR-282 D5).
        let mut lend = self.facts.lent_args.contains(node) && !(emit_arg_is_text_literal(arg) && !self.facts.owned_texts.contains(node))
        // **And `&mut` for a parameter the callee declared `mut`** (D3).
        let change = self.facts.mut_args.contains(node)
        // **A lambda handed to a parameter whose type may pause** (ADR-277 D11).
        let future = emit_arg_is_closure(arg) && self.facts.future_lambdas.contains(node) && !self.facts.kept_lambdas.contains_key(node)
        // **The pointer a C declaration takes** (ADR-302 D5).
        let mut pointer = 0
        if self.foreign_params.contains_key(callee) {
            let params = self.foreign_params.get(callee) ?? return
            if i < params.len() {
                let ty = params[i].clone()
                pointer = emit_arg_pointer_code(self.pointer_for(world, callee, ty))
            }
        }
        // **Into a parameter both kinds of text flow into, each argument goes as
        // it is** (ADR-282 D2): a view borrowed, text of its own moved in.
        let either = !lend && !change && !emit_arg_is_null(arg) && self.either_param(world, callee, i) && !self.emit_arg_only_read(world, callee, i) && !self.facts.mixed_choices.contains(node_key(arg))
        out.push(before)
        if either {
            out.push("nikaia_std::either_text::either(")
        }
        // **A `Bytes` kept by the callee is handed over with its owner**
        // (ADR-373 D1, D4): a `Bytes` as it is, a mapping's at a count, and a
        // run of bytes - a text's, a cut - copied into one.
        let keeps_bytes = self.emit_arg_keeps_bytes(world, callee, method_callee, i)
        if keeps_bytes {
            out.push("&*nikaia_std::bytes::kept(")
        }
        // **A nullable view is lent inside its option** (issue #171).
        let mut how: String = ""
        let mut has_how = false
        if lend {
            how = self.emit_arg_opening(callee, i)
            has_how = how != ""
        }
        // **A map's read is that option already**: `index::get` answers an
        // `Option<&T>`, so nothing is opened, and text is read as `str`.
        if has_how {
            let a_map_read = self.emit_arg_a_map_read(arg) || self.facts.flat_reads.contains(node)
            if a_map_read {
                if how == ".as_deref()" {
                    how = ".map(String::as_str)"
                } else {
                    how = ""
                }
            }
        }
        // **A plain value put into the option is lent inside it**: `Some(&value)`.
        if before == "Some(" {
            has_how = false
            how = ""
        }
        if has_how {
            lend = false
        }
        // **A function value a method took whole is lent on to code that only
        // runs it** (#463), not to a call of the function it stands in (#464).
        if !lend && !change && !self.emit_arg_calls_itself(scope.function, callee) && self.emit_arg_code_handed_on(world, scope.function, callee, i, arg) {
            lend = true
        }
        if emit_arg_is_null(arg) && has_how {
            out.push("None")
            out.push(after)
            return
        }
        let mut kept_here = false
        if pointer == 0 {
            if change && self.facts.reborrowed_args.contains(node) {
                out.push("&mut *")
            } else if change {
                out.push("&mut ")
            } else {
                // **Only an argument made in the call is put into a keep**
                // (ADR-283 D24): the plan keys it by statement, callee and
                // place, which a second call of the callee there shares (#678).
                let keep = if lend && made_in_the_call(arg) { self.argument_keep(walk, scope.function, flow.statement, callee, i) ?? "" } else { "" }
                if lend && keep != "" {
                    out.push(f"({keep}).put(")
                    kept_here = true
                } else if lend && !self.facts.views_handed_on.contains(node) {
                    // **A part an expression arm binds as a view** is one
                    // already (#456); the others are lent here.
                    out.push("&")
                }
            }
        }
        // **A boxed field is its own parentheses** (`(*code.result)`,
        // ADR-246 D2): a second pair around it is `unused_parens`.
        let boxed_alone = pointer == 0 && !count && self.facts.boxed_reads.contains(node)
        let held = has_how && how != "" && !boxed_alone
        if held {
            out.push("(")
        }
        if pointer == 3 {
            out.push("&")
        } else if pointer == 4 {
            out.push("&mut ")
        }
        if count {
            out.push("nikaia_std::count::of(")
        }
        // A count written only in literals is left for Rust to infer as a
        // `usize`, so a suffix may not be written into it either.
        let mut inside = flow
        if wants_a_size && !count {
            inside = flow.inferred()
        }
        // **A `mut` parameter handed to a `mut` parameter is handed on as the
        // `&mut` it is** (ADR-094 D3), and not read as its number.
        if self.emit_arg_handed_on_changed(world, scope.function, callee, i, arg) {
            inside = inside.place()
        }
        // **An element handed to a `mut` parameter is a place** (#814): it is
        // lent as `&mut xs[at]`, never read through `index::get`, which is
        // behind a shared reference.
        if change && pointer == 0 && emit_arg_through_index(arg) {
            inside = inside.place()
        }
        // **A fold's step or merge that changes its accumulator in place**
        // (ADR-372 D9) runs as one that hands it back: a closure that lends
        // the accumulator to it, typed by the fold before the lambda is.
        let in_place = self.facts.in_place_folds.get(node) ?? 0
        if in_place > 0 {
            let second = if in_place == 2 { "&__nk_x" } else { "__nk_x" }
            out.push(f"|mut __nk_acc, __nk_x| {{ nikaia_std::par::in_place(&mut __nk_acc, {second}, ")
        }
        if future {
            self.emit_arg_future(world, walk, out, host, arg, i, depth, inside, scope)
        } else {
            self.emit_arg_value(world, walk, out, host, arg, i, depth, inside, scope)
        }
        if in_place > 0 {
            out.push("); __nk_acc }")
        }
        // `.as_ptr()` and `.as_mut_ptr()`, which a `Vec`, an `Array` and text all
        // answer - so one call writes the address of whatever a caller lends a
        // `&[T]` parameter (D1).
        if pointer == 1 {
            out.push(".as_ptr()")
        } else if pointer == 2 {
            out.push(".as_mut_ptr()")
        }
        // **A handle is lent unless this call is its cleanup** (D3).
        if pointer == 6 {
            out.push(".lent()")
        }
        if held {
            out.push(")")
        }
        if has_how && how != "" {
            out.push(how)
        }
        if count {
            out.push(")")
        }
        if kept_here {
            out.push(")")
        }
        if keeps_bytes {
            out.push(")")
        }
        if either {
            out.push(")")
        }
        out.push(after)
        if duplicate {
            // `.clone()` and not `Rc::clone(&x)`: it is right under either count,
            // so it cannot disagree with the type the position was lowered to.
            out.push(".clone()")
        }
        if boxed_here {
            out.push(")")
        }
    }

    /// Whether the argument is a read of a map whose keys the checker typed.
    fn emit_arg_a_map_read(ref self, arg: ref Expr) -> bool {
        return match arg {
            Expr::Index { index, .. } => self.map_key(index, false) != null,
            else => false,
        }
    }

    /// `|a| Box::pin(async move { .. })`, which is what a parameter declared
    /// `impl Fn(A) -> Pin<Box<dyn Future<..>>>` takes (ADR-277 D11), or an
    /// `async` closure where the callee runs the parameter (D1).
    ///
    /// **`in_lambda` is deliberately not set**, and that is D2: the `async`
    /// block is where a body's `.await`s belong.
    fn emit_arg_future[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, arg: ref Expr, i: i64, depth: i64, inside: EmitFlow, scope: ref EmitScope) sync throws {
        match arg {
            Expr::Closure { params, mutable, body, .. } => {
                let mut names: Vec[String] = []
                for p in params {
                    names.push(emit_local_name(self.facts.comptime_names, emit_text(world, p)))
                }
                let joined = names.join(", ")
                // **No `move` on the run shape** (Part I 5.4 A): the call is over
                // before the caller's frame is. The boxed shape keeps its `move`:
                // the future outlives the closure body it is made in.
                let runs = self.facts.run_lambdas.contains(node_key(arg))
                if runs {
                    out.push(f"async |{joined}| ")
                } else {
                    out.push(f"|{joined}| Box::pin(async move ")
                }
                let mut changed: Vec[winnow_grammar::Symbol] = scope.changed.clone()
                changed.extend(mutable.clone())
                let inner = EmitScope::plain() with { changed: changed }
                self.emit_core_block(world, walk, out, host, body, depth, EmitFlow::plain().at(inside.statement), inner, EmitTail::Return)
                if !runs {
                    out.push(")")
                }
            },
            else => {},
        }
    }

    /// An argument that is a value: held by the keeps of the buffers it points
    /// into, copied out of a view, run as an `async` closure, or as it stands.
    fn emit_arg_value[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, arg: ref Expr, i: i64, depth: i64, inside: EmitFlow, scope: ref EmitScope) sync throws {
        let node = node_key(arg)
        // **Held by the keeps of the buffers it points into** (ADR-283 D12, D14):
        // a view of text becomes a `Held`, a struct of views a `Holding`, and
        // which one is the language below's to pick by the value's type.
        let buffers = walk.buffers_held_at(i)
        if buffers != null {
            let mut keeps: Vec[String] = []
            for b in (buffers ?? []) {
                keeps.push(f"std::sync::Arc::clone(&__keep_{b})")
            }
            let joined = keeps.join(", ")
            out.push("{ use nikaia_std::tether::Hold as _; (")
            host.expr(walk, out, arg, depth, inside, scope)
            out.push(f").hold([{joined}]) }}")
            return
        }
        // A kept value handed to a parameter that only runs it: the closure it
        // holds.
        // One that pauses, run by a parameter that may pause (#832): an
        // `async` closure that awaits the future the value returns.
        let kept_arity = self.facts.kept_args_run_async.get(node) ?? -1
        if kept_arity >= 0 {
            let mut names: Vec[String] = []
            for n in 0..<kept_arity {
                names.push(f"__nikaia_a{n}")
            }
            let joined = names.join(", ")
            out.push(f"&async |{joined}| (*")
            host.expr(walk, out, arg, depth, inside, scope)
            out.push(f")({joined}).await")
            return
        }
        if self.facts.kept_args.contains(node) {
            out.push("&*")
        }
        // **A view of a value that copies, where the value is wanted** (ADR-233
        // D4): copied out of it.
        if self.facts.copied_args.contains(node) {
            out.push("*")
            self.emit_core_postfix_base(world, walk, out, host, arg, depth, inside, scope)
            return
        }
        let arity = self.emit_arg_run_async(world, inside.statement, i, arg)
        // **A named function whose read-only parameters are lent, handed over
        // as a value** (#757): the parameter of function type takes them by
        // value, so whatever closure is written below lends them to the call.
        let lent = self.emit_arg_lent_params(world, arg)
        // **A function whose channel is narrower than the box, run by a
        // `fn(..) throws` parameter** (ADR-280 D9, #703): a closure that calls
        // it and puts its error in the box, `async` where the parameter may
        // pause.
        // **A function that cannot fail, run by a `fn(..) throws` parameter**
        // (ADR-351 D4, #732): a closure that calls it and hands its result
        // over in an `Ok`, `async` where the parameter may pause.
        let never_fails = self.facts.infallible_fn_values.get(node_key(arg)) ?? -1
        if never_fails >= 0 {
            let mut names: Vec[String] = []
            for n in 0..<never_fails {
                names.push(f"__nikaia_a{n}")
            }
            let joined = names.join(", ")
            let key: String = (emit_arg_function_key(world, arg) ?? "").clone()
            let pauses = key != "" && call_pauses(self.own_contracts, key)
            if arity >= 0 || pauses {
                out.push("async ")
            }
            out.push(f"|{joined}| Ok(")
            host.expr(walk, out, arg, depth, inside, scope)
            out.push(f"({emit_arg_passing(names, lent)})")
            if pauses {
                out.push(".await")
            }
            out.push(")")
            return
        }
        let boxed = self.emit_arg_into_the_box(world, arg)
        if boxed >= 0 {
            let mut names: Vec[String] = []
            for n in 0..<boxed {
                names.push(f"__nikaia_a{n}")
            }
            let joined = names.join(", ")
            if arity >= 0 {
                out.push("async ")
            }
            out.push(f"|{joined}| ")
            host.expr(walk, out, arg, depth, inside, scope)
            out.push(f"({emit_arg_passing(names, lent)}).map_err(Into::into)")
            return
        }
        if arity < 0 && lent.len() > 0 {
            let mut names: Vec[String] = []
            for n in 0..<lent.len() {
                names.push(f"__nikaia_a{n}")
            }
            let joined = names.join(", ")
            out.push(f"|{joined}| ")
            host.expr(walk, out, arg, depth, inside, scope)
            out.push(f"({emit_arg_passing(names, lent)})")
            return
        }
        if arity < 0 {
            host.expr(walk, out, arg, depth, inside, scope)
            return
        }
        // **A function that never pauses, run where a pause may happen** (#516):
        // an `async` closure around the call, which is the `AsyncFn` the
        // parameter is.
        let mut names: Vec[String] = []
        for n in 0..<arity {
            names.push(f"__nikaia_a{n}")
        }
        let joined = names.join(", ")
        out.push(f"async |{joined}| ")
        host.expr(walk, out, arg, depth, inside, scope)
        out.push(f"({emit_arg_passing(names, lent)})")
    }

    /// For an argument that names a function of this unit without a receiver,
    /// whether each of its parameters is lent (lowered behind a `&`) where the
    /// parameter of function type it is handed to takes it by value; empty
    /// where none is, or the argument is no such name, or a kept function
    /// value already calls it (#757).
    fn emit_arg_lent_params(ref self, world: ref EmitWorld, arg: ref Expr) -> Vec[bool] {
        let key = match arg {
            Expr::Variable(name, _) => emit_text(world, name),
            else => return [],
        }
        if self.facts.kept_functions.contains_key(node_key(arg)) {
            return []
        }
        let viewed = self.facts.named_fn_values.get(node_key(arg)) ?? return []
        let contract = self.own_contracts.functions.get(key) ?? return []
        let signature = contract.signature?.clone() ?? return []
        if signature.takes_a_receiver() {
            return []
        }
        let mut lent: Vec[bool] = []
        let mut any = false
        for at in 0..<signature.params.len() {
            let one = emit_arg_lends_own(contract, at, world.library, self.described) && !(at < viewed.len() && viewed[at])
            any = any || one
            lent.push(one)
        }
        if !any {
            return []
        }
        return lent
    }

    /// **A named function bound by a `let` without a type** (#582): the local
    /// is called with its parameters by value, as a function type takes them,
    /// so where the function lends one, the value is a closure that lends it.
    /// Its parameters carry the written types: the language below cannot infer
    /// an owned argument from the view the call lends. Whether it wrote one.
    pub fn emit_arg_named_fn_bound[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, value: ref Expr, depth: i64, flow: EmitFlow, scope: ref EmitScope) -> bool sync throws {
        if !self.facts.named_fn_values.contains_key(node_key(value)) {
            return false
        }
        let wanted = match value {
            Expr::Variable(name, _) => emit_text(world, name),
            else => return false,
        }
        let lent = self.emit_arg_lent_params(world, value)
        if lent.is_empty() {
            return false
        }
        let mut written: Vec[String] = []
        for item in world.items {
            match item.node {
                Item::Fn { name, receiver, generics, args, .. } => {
                    let declared = name ?? continue
                    if receiver != null || !generics.is_empty() || emit_text(world, declared) != wanted || args.len() != lent.len() {
                        continue
                    }
                    for arg in args {
                        written.push(self.emit_core_ty(world, walk, host.crossings_are_possible(), host.overlaps_user_code(), arg.ty, EmitLifetimes::Elided))
                    }
                },
                else => {}
            }
        }
        if written.len() != lent.len() {
            return false
        }
        let mut names: Vec[String] = []
        let mut typed: Vec[String] = []
        for n in 0..<lent.len() {
            names.push(f"__nikaia_a{n}")
            typed.push(f"__nikaia_a{n}: {written[n]}")
        }
        out.push(f"|{typed.join(", ")}| ")
        host.expr(walk, out, value, depth, flow, scope)
        out.push(f"({emit_arg_passing(names, lent)})")
        return true
    }
}

/// The arguments a closure around a named function hands it: each name, behind
/// a `&` where the function lends that parameter (#757).
fn emit_arg_passing(names: ref Vec[String], lent: ref Vec[bool]) -> String {
    let mut passed: Vec[String] = []
    let mut at = 0
    for name in names {
        if at < lent.len() && lent[at] {
            passed.push(f"&{name}")
        } else {
            passed.push(name.clone())
        }
        at += 1
    }
    return passed.join(", ")
}

/// `std`'s entries that run a kept function in a task of their own and have a
/// twin for `user_parallelism = yes`, named `<name>_on_pool`.
fn emit_call_on_the_pool(key: ref String) -> bool {
    return key == "net::serve" || key == "supervisor::child" || key == "supervisor::run" || key == "task::scope"
}

/// **The channel a scope's tasks fail in** (ADR-346 D7): the box where a
/// `catch` on the call opens it, the function's where the error leaves it, and
/// `Crashed` alone where nothing else can.
fn emit_call_tasks_channel(flow: EmitFlow, scope: ref EmitScope) -> String {
    if flow.handled_here {
        return "Box<dyn std::error::Error>"
    }
    if flow.can_throw {
        return scope.channel.clone()
    }
    return "nikaia_std::task::Crashed"
}

/// **The scope's own channel**: the box's twin with no lifetime of its own
/// where a `catch` opens it, so its tasks may borrow (`task::Boxed`); its
/// tasks still fail in the box.
fn emit_call_scope_channel(channel: ref String) -> String {
    if channel == "Box<dyn std::error::Error>" {
        return "nikaia_std::task::Boxed"
    }
    return channel.clone()
}

/// A default that stands in a run that computes another one (#468); the text
/// is `comptime_run::NOT_COMPUTED_YET`.
fn emit_call_not_computed_yet() -> String {
    return "a default not computed yet"
}

/// Whether the type is the owned `String`.
fn emit_call_owned_text(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, view, .. } => !view && name == "String",
        else => false,
    }
}

impl EmitState {
    /// The call itself, without ADR-023 D8's propagation.
    pub fn emit_core_called[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, func: ref Expr, args: ref Vec[Expr], config: ref Vec[ConfigArg], unchecked: bool, depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        if self.emit_call_special(world, walk, out, host, func, args, config, depth, flow, scope) {
            return
        }
        // **A scope that polls the tasks that pause** (ADR-328 D10): the scope is
        // made here and named as the lambda names it, and its function is an
        // `async` block that names it in turn - not a closure handed it, which
        // would be higher-ranked, and a future `rustc` cannot show `Send`.
        // Awaited inside the block that owns the scope.
        if self.opens_a_paused_scope(world, func, args) && self.emit_call_paused_scope(world, walk, out, host, args, depth, flow, scope) {
            return
        }
        host.expr(walk, out, func, depth, flow, scope)
        // **What runs a kept function in a task of its own** - `net::serve`'s
        // handler (ADR-326 D1), a supervisor's children (ADR-328) - has a twin
        // where tasks run on threads, whose functions cross one: the pool's, as
        // `spawn` has, from one written call.
        if host.overlaps_user_code() {
            match func {
                Expr::Path(segments, _) => {
                    if emit_call_on_the_pool(unaliased_in(world.aliases, emit_arg_joined(world, segments))) {
                        out.push("_on_pool")
                    }
                },
                else => {},
            }
        }
        // **A scope's tasks fail in one channel** (ADR-346 D7), which the call
        // names: nothing else in it may.
        let mut tasks: String? = null
        let mut valued = false
        match func {
            Expr::Path(segments, _) => {
                if unaliased_in(world.aliases, emit_arg_joined(world, segments)) == "task::scope" {
                    let mut channel = emit_call_tasks_channel(flow, scope)
                    // **Only a scope with a task that can fail fails in a wider
                    // channel** (ADR-346 D7): read off its tasks written that way.
                    if channel != "nikaia_std::task::Crashed" {
                        let mut owner: String = ""
                        if channel == scope.channel {
                            owner = scope.function.clone()
                        }
                        let tried = scope.clone() with { tasks_channel: channel.clone(), tasks_function: owner }
                        let mut probe = EmitOut::empty()
                        self.emit_core_args(world, walk, probe, host, self.emit_call_callee(world, func), args, self.takes_a_handle_at(world, func), depth, flow, tried)
                        if !probe.buf.contains("?") {
                            channel = "nikaia_std::task::Crashed".clone()
                        }
                    }
                    out.push(f"::<_, {emit_call_scope_channel(channel)}>")
                    tasks = channel
                }
            },
            else => {},
        }
        if unchecked {
            out.push("__unchecked")
        }
        // **A hidden map parameter no argument fixes is filled here** (ADR-010
        // D9): the call names the hasher of the package it stands in.
        let callee_name = emit_callee_text(world, func) ?? ""
        let callee_parts: Vec[String] = callee_name.split("::").collect()
        let mut callee_last: String = ""
        if callee_parts.len() > 0 {
            callee_last = callee_parts[callee_parts.len() - 1].clone()
        }
        if self.seeded_calls.contains_key(callee_last) {
            let hidden = self.seeded_calls.get(callee_last) ?? return
            let mut fill: String = "nikaia_std::hash::Keyed"
            if self.trusted_input {
                fill = "nikaia_std::hash::Fast"
            }
            let mut fills: Vec[String] = []
            for at in 0..<hidden.0 {
                if at < hidden.1 {
                    fills.push("_")
                } else {
                    fills.push(fill.clone())
                }
            }
            out.push(f"::<{fills.join(", ")}>")
        }
        out.push("(")
        let takes = self.takes_a_handle_at(world, func)
        // The written callee, which is what the checker keyed its answers by:
        // `h::id_of()` is `http::id_of()` where the file wrote `use http as h`
        // (ADR-286 D3), and a qualified name is one of them.
        let callee = self.emit_call_callee(world, func)
        if tasks != null {
            let channel = (tasks ?? "").clone()
            let mut owner: String = ""
            if channel == scope.channel {
                owner = scope.function.clone()
            }
            let boxed = flow.handled_here && channel == "Box<dyn std::error::Error>"
            // **The scope's function may throw itself** (ADR-346 D7): its error
            // is the scope's, after its tasks' (`settled`).
            let mut written = false
            if channel != "nikaia_std::task::Crashed" && args.len() == 1 {
                match args[0] {
                    Expr::Closure { params, body, .. } => {
                        if params.len() == 1 {
                            let named = emit_local_name(self.facts.comptime_names, emit_text(world, params[0]))
                            out.push(f"|{named}| {{ let __scope_body: Result<_, {channel}> = (|| {{ let {named} = {named}; Ok(")
                            self.emit_call_scope_body(world, walk, out, host, body, depth, flow, scope, channel, owner, false)
                            out.push(f") }})(); {named}.settled(__scope_body) }}")
                            written = true
                        }
                    },
                    else => {},
                }
            }
            if !written {
                let inner = scope.clone() with { tasks_channel: channel, tasks_function: owner }
                self.emit_core_args(world, walk, out, host, callee, args, takes, depth, flow, inner)
            }
            valued = written
            walk.boxed_scope = boxed
        } else {
            self.emit_core_args(world, walk, out, host, callee, args, takes, depth, flow, scope)
        }
        match func {
            Expr::Variable(name, _) => self.emit_core_dsl_parameters(world, walk, out, host, emit_text(world, name), args.len(), config, depth, flow, scope),
            else => {},
        }
        // **The keep, last** (ADR-283 D10): where the callee's views leave it, the
        // caller says where they live.
        let mut keep: String = ""
        let keeping = self.keeping_callee(world, func)
        if keeping != null {
            let key = keeping ?? ""
            let found = self.keep_handed(walk, scope.function, flow.statement, key)
            keep = found ?? ""
        }
        // Kap 5.1: the language below has no named arguments and no defaults, so
        // the options become positional here, in the order the *declaration*
        // gives - which is the only order there is, and the reason this needs the
        // callee's contract rather than the call alone.
        let options = self.options_of(world, func)
        let mut n = 0
        for option in options {
            // **The comma belongs *between* arguments**, and a call whose
            // arguments are all options has nothing before the first one
            // (ADR-133 D1).
            if n > 0 || args.len() > 0 {
                out.push(", ")
            }
            n += 1
            self.emit_call_option(world, walk, out, host, option, config, depth, flow, scope)
        }
        if keep != "" {
            if args.len() > 0 || config.len() > 0 {
                out.push(", ")
            }
            out.push(keep)
        }
        out.push(")")
        if valued {
            out.push(".map(nikaia_std::task::valued)")
        }
    }

    /// The callee as the source wrote it, which is what the checker keyed its
    /// answers by.
    fn emit_call_callee(ref self, world: ref EmitWorld, func: ref Expr) -> String {
        return match func {
            Expr::Variable(name, _) => emit_text(world, name),
            Expr::Path(segments, _) => unaliased_in(world.aliases, emit_arg_joined(world, segments)),
            else => "",
        }
    }

    /// One option of the callee, positional: what the call passed, or the
    /// declaration's default.
    fn emit_call_option[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, option: ref ConfigContract, config: ref Vec[ConfigArg], depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        for passed in config {
            if emit_text(world, passed.name) == option.name {
                if self.facts.lent_options.contains(node_key(passed.value)) {
                    out.push("&")
                }
                host.expr(walk, out, passed.value, depth, flow, scope)
                return
            }
        }
        // Not passed, so the declaration's default is the value. It is a
        // literal, and Nikaia spells a literal the way the language below does
        // (ADR-296 D17). A list crosses as the view the parameter is (ADR-318
        // D4): `[4, 5]` for a `ref Vec[i64]` is a list lent for the call.
        if option.default.starts_with("[") && option.ty.is_a_view() {
            out.push("&vec!")
            out.push(option.default)
            return
        }
        // **A list handed over is built** (ADR-243 D5): `env: Vec[(String,
        // String)] = []` is a `Vec` of its own where nothing was passed.
        if option.default.starts_with("[") {
            out.push("vec!")
            out.push(option.default)
            return
        }
        // **A default not computed yet** stands only in a run that computes
        // another one (#468): a call the run reaches with it would be a ring,
        // which `NK1168` refuses first.
        if option.default == "" {
            out.push(f"unreachable!(\"{emit_call_not_computed_yet()}\")")
            return
        }
        // **Text for an owned `String`** is one (#498): the literal below is a
        // `&str`.
        if option.default.starts_with("\"") && emit_call_owned_text(option.ty) {
            out.push("String::from(")
            out.push(option.default)
            out.push(")")
            return
        }
        out.push(option.default)
    }

    /// **A scope's own function, where it may throw** (ADR-346 D7): written as
    /// a task's body is, failing in the scope's channel; its value is `Ok`'s.
    fn emit_call_scope_body[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, body: ref Block, depth: i64, flow: EmitFlow, scope: ref EmitScope, channel: ref String, owner: ref String, paused: bool) sync throws {
        let failing = EmitFlow::plain().at(flow.statement) with { in_lambda: !paused, can_throw: true }
        let inner = EmitScope::plain() with { origin: scope.origin.clone(), function: owner.clone(), channel: channel.clone(), changed: scope.changed.clone(), tasks_channel: channel.clone(), tasks_function: owner.clone() }
        self.emit_core_block(world, walk, out, host, body, depth, failing, inner, EmitTail::Value)
    }

    /// The scope that polls the tasks that pause (ADR-328 D10), where the lambda
    /// is written the way the form wants: one parameter.
    fn emit_call_paused_scope[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, args: ref Vec[Expr], depth: i64, flow: EmitFlow, scope: ref EmitScope) -> bool sync throws {
        if args.len() == 0 {
            return false
        }
        match args[0] {
            Expr::Closure { params, body, .. } => {
                if params.len() != 1 {
                    return false
                }
                let mut made = "PausedScope"
                let mut run = "scope_paused"
                if host.overlaps_user_code() {
                    made = "PausedPoolScope"
                    run = "scope_paused_on_pool"
                }
                let named = emit_local_name(self.facts.comptime_names, emit_text(world, params[0]))
                let mut channel = emit_call_tasks_channel(flow, scope)
                let mut owner: String = ""
                if channel == scope.channel {
                    owner = scope.function.clone()
                }
                // **Only a scope with a task that can fail fails in a wider
                // channel** (ADR-346 D7): read off its body written that way.
                if channel != "nikaia_std::task::Crashed" {
                    let mut probe = EmitOut::empty()
                    let tried = EmitScope::plain() with { changed: scope.changed.clone(), tasks_channel: channel.clone(), tasks_function: owner.clone() }
                    self.emit_core_block(world, walk, probe, host, body, depth, EmitFlow::plain().at(flow.statement), tried, EmitTail::Return)
                    if !probe.buf.contains("?") {
                        channel = "nikaia_std::task::Crashed".clone()
                    }
                }
                let boxed = flow.handled_here && channel == "Box<dyn std::error::Error>"
                out.push(f"{{ let {named} = &nikaia_std::task::{made}::<{emit_call_scope_channel(channel)}>::new(); nikaia_std::task::{run}({named}, async ")
                // **Its function may throw itself** (ADR-346 D7), as `task::scope`'s.
                if channel != "nikaia_std::task::Crashed" {
                    out.push(f"{{ let __scope_body: Result<_, {channel}> = async {{ let {named} = {named}; Ok(")
                    self.emit_call_scope_body(world, walk, out, host, body, depth, flow, scope, channel, owner, true)
                    out.push(f") }}.await; {named}.settled(__scope_body) }}")
                    walk.boxed_scope = boxed
                    out.push(").await.map(nikaia_std::task::valued) }")
                    return true
                }
                let inner = EmitScope::plain() with { changed: scope.changed.clone(), tasks_channel: channel, tasks_function: owner }
                self.emit_core_block(world, walk, out, host, body, depth, EmitFlow::plain().at(flow.statement), inner, EmitTail::Return)
                walk.boxed_scope = boxed
                out.push(").await }")
                return true
            },
            else => return false,
        }
    }

    /// What a call is when it is one of the special forms: a walking function's
    /// copy, a hull, a door over several locks, `println`, a constructor. `true`
    /// where it has been written.
    fn emit_call_special[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, func: ref Expr, args: ref Vec[Expr], config: ref Vec[ConfigArg], depth: i64, flow: EmitFlow, scope: ref EmitScope) -> bool sync throws {
        // **A call to a function that walks a type's fields goes to the copy**
        // (ADR-304 D6), and which copy is the checker's answer: this emitter has
        // no types (ADR-288), so the name is handed over keyed by the callee's
        // node (ADR-340 D5).
        if self.facts.unrolled_calls.contains_key(node_key(func)) {
            let copy = self.facts.unrolled_calls.get(node_key(func)) ?? return false
            if self.emit_call_walks(world, func, copy) {
                out.push(f"{copy}(")
                let mut at = 0
                for arg in args {
                    if at > 0 {
                        out.push(", ")
                    }
                    at += 1
                    host.expr(walk, out, arg, depth, flow, scope)
                }
                out.push(")")
                return true
            }
        }
        // **A shared value that is built again when a panic poisons it** (ADR-327
        // D3, ADR-328 D9): the hulls `SharedMut(x)` gets, around the builder
        // instead of a value.
        if self.emit_call_supervised(world, walk, out, host, func, args, config, depth, flow, scope) {
            return true
        }
        match func {
            Expr::Variable(name, _) => {
                if self.emit_call_by_name(world, walk, out, host, emit_text(world, name), args, depth, flow, scope) {
                    return true
                }
            },
            else => {},
        }
        match func {
            Expr::Path(segments, _) => {
                return self.emit_call_by_path(world, walk, out, host, segments, args, depth, flow, scope)
            },
            else => return false,
        }
    }

    /// Whether the callee is a name that the copy `copy` is a copy of.
    fn emit_call_walks(ref self, world: ref EmitWorld, func: ref Expr, copy: ref String) -> bool {
        return match func {
            Expr::Variable(name, _) => copy.starts_with(ref f"{emit_text(world, name)}__"),
            else => false,
        }
    }

    /// The count a hull's allocation is counted with: the one an enclosing
    /// argument handed down, taken, or else the function's own answer.
    fn emit_call_hull_count[H: EmitHost](ref self, host: ref H, mut walk: EmitWalk, scope: ref EmitScope) -> Count {
        let given = walk.hull_count
        walk.hull_count = null
        return given ?? self.count_at(host.crossings_are_possible(), scope.function, scope.bound)
    }

    /// `SharedMut.supervised(build; policy: ..)`.
    fn emit_call_supervised[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, func: ref Expr, args: ref Vec[Expr], config: ref Vec[ConfigArg], depth: i64, flow: EmitFlow, scope: ref EmitScope) -> bool sync throws {
        match func {
            Expr::Path(segments, _) => {
                if segments.len() != 2 || args.len() != 1 {
                    return false
                }
                if emit_text(world, segments[0]) != "SharedMut" || emit_text(world, segments[1]) != "supervised" {
                    return false
                }
                let count = self.emit_call_hull_count(host, walk, scope)
                let hulls = self.hull_new(world, host.crossings_are_possible(), walk.trusting, "SharedMut", count) ?? return false
                if hulls.len() != 2 {
                    return false
                }
                out.push(f"{hulls[0]}::new({hulls[1]}::supervised_kept(")
                host.expr(walk, out, args[0], depth, flow, scope)
                // **Its policy** (ADR-328 D9): the one `policy:` names, or `std`'s.
                out.push(", ")
                let mut named = false
                for a in config {
                    if !named && emit_text(world, a.name) == "policy" {
                        host.expr(walk, out, a.value, depth, flow, scope)
                        named = true
                    }
                }
                if !named {
                    out.push("nikaia_std::supervisor::Backoff()")
                }
                out.push("))")
                return true
            },
            else => return false,
        }
    }

    /// A call by a bare name: a door over several locks, a hull, `println`, a
    /// struct's constructor, `std`'s own types.
    fn emit_call_by_name[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, text: ref String, args: ref Vec[Expr], depth: i64, flow: EmitFlow, scope: ref EmitScope) -> bool sync throws {
        // **A door over several locks** (ADR-281): the locks go in by reference
        // and the block becomes the last argument, which is what the
        // trailing-lambda rule already made of it. The ordered acquisition is
        // `std`'s, because it is about addresses at run time and not about
        // anything this compiler can see.
        if (text == "access_all" || text == "update_all") && args.len() > 0 {
            out.push(f"nikaia_std::lock::{text}(")
            let last = args.len() - 1
            let mut at = 0
            for lock in args {
                if at < last {
                    out.push("&")
                    host.expr(walk, out, lock, depth, flow, scope)
                    out.push(", ")
                } else {
                    host.expr(walk, out, lock, depth, flow, scope)
                }
                at += 1
            }
            out.push(")")
            return true
        }
        // **A hull you can observe, you write** (ADR-281 D2). `Shared(x)`,
        // `SharedMut(x)` and `Locked(x)` are the three, and each expands to the
        // shape `written_name` would give the *type* - so the constructor and the
        // annotation cannot disagree about a value.
        if args.len() == 1 {
            let count = self.emit_call_hull_count(host, walk, scope)
            let hulls = self.hull_new(world, host.crossings_are_possible(), walk.trusting, text, count)
            if hulls != null {
                let paths = hulls ?? return false
                for path in paths {
                    out.push(f"{path}::new(")
                }
                host.expr(walk, out, args[0], depth, flow, scope)
                for _ in paths {
                    out.push(")")
                }
                return true
            }
        }
        // `println`, `print` and their `stderr` halves are macros in Rust, and
        // their argument is an interpolated string, which is a format string
        // already. `print` is here because output composed piece by piece cannot
        // be written with the newline attached.
        if text == "println" || text == "eprintln" || text == "print" || text == "eprint" {
            self.emit_call_print(world, walk, out, host, text, args, depth, flow, scope)
            return true
        }
        if self.declares_a_struct(text) {
            out.push(f"{text}::new(")
            let takes = self.takes_a_handle(world, f"{text}::new")
            self.emit_core_args(world, walk, out, host, text, args, takes, depth, flow, scope)
            out.push(")")
            return true
        }
        // **`std`'s own types are constructed the same way** (ADR-140 D2).
        // `Vec()` is the anonymous constructor and `Vec::new()` is what the
        // language below calls it. **Read off the library rather than from a
        // list of three names**: the entry `Name::new` *is* the fact.
        if world.library.functions.contains_key(f"{text}::new") {
            // **Through `path`**, because one name below depends on more than the
            // name: a **trusted** map is `TrustedMap::default()` and not
            // `TrustedMap::new()` (ADR-010 D5).
            out.push(self.path(world, walk.trusting, walk.unpinned, [text.clone(), "new".clone()]))
            out.push("(")
            let takes = self.takes_a_handle(world, f"{text}::new")
            self.emit_core_args(world, walk, out, host, text, args, takes, depth, flow, scope)
            out.push(")")
            return true
        }
        return false
    }

    /// `println(..)` and its three: a file's name is written as its bytes
    /// (ADR-319 D4), an `f".."` is a format string, a plain string has its braces
    /// escaped (ADR-309 D4), anything else goes through `{}`.
    fn emit_call_print[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, text: ref String, args: ref Vec[Expr], depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        if args.len() == 1 {
            let given = args[0]
            let key = node_key(given)
            if self.facts.path_holes.contains_key(key) {
                let names = self.facts.path_holes.get(key) ?? return
                let to_err = text.starts_with("e")
                let newline = text.ends_with("ln")
                out.push("nikaia_std::fs::path::print(&(")
                match given {
                    Expr::LitInterpolated { parts, .. } => self.emit_core_joined_name(world, walk, out, host, parts, names, depth, flow, scope),
                    else => host.expr(walk, out, given, depth, flow, scope),
                }
                out.push(f"), {to_err}, {newline})")
                return
            }
            match given {
                Expr::LitInterpolated { parts, .. } => {
                    out.push(f"{text}!(")
                    self.emit_core_format_string(world, walk, out, host, parts, depth, flow, scope)
                    out.push(")")
                    return
                },
                Expr::LitStr { text: literal, .. } => {
                    out.push(f"{text}!(\"{rust_format_escape(literal)}\")")
                    return
                },
                else => {},
            }
        }
        out.push(f"{text}!(\"{{}}\", ")
        self.emit_core_args(world, walk, out, host, text, args, [], depth, flow, scope)
        out.push(")")
    }

    /// A call by a path: the same constructor written with its module in front
    /// (ADR-313 D3), and a type another *package* publishes (ADR-100 D1).
    fn emit_call_by_path[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, segments: ref Vec[winnow_grammar::Symbol], args: ref Vec[Expr], depth: i64, flow: EmitFlow, scope: ref EmitScope) -> bool sync throws {
        if segments.len() == 2 {
            let module = emit_text(world, segments[0])
            let name = emit_text(world, segments[1])
            // **The key carries the module**, because that is where the ledger
            // keeps a type that lives in one: `collections::HashMap` and its
            // `::new` beside it.
            let key = f"{module}::{name}::new"
            if world.library.functions.contains_key(key) {
                out.push(f"{module}::{self.path(world, walk.trusting, walk.unpinned, [name.clone(), "new".clone()])}")
                out.push("(")
                let takes = self.takes_a_handle(world, key)
                self.emit_core_args(world, walk, out, host, key, args, takes, depth, flow, scope)
                out.push(")")
                return true
            }
        }
        // **And a type another *package* publishes**: `tiny::Server()` is Part I
        // 4.2's constructor reached through the package that declares it, and the
        // entry `tiny::Server::new` is in the ledger the build merged. **Unaliased
        // and whole**: `use tiny as t` writes `t::Server` and the ledger keys
        // `tiny::Server::new`, and a path of any depth is one key.
        let qualified = unaliased_in(world.aliases, emit_arg_joined(world, segments))
        let key = f"{qualified}::new"
        if self.own_contracts.functions.contains_key(key) {
            out.push(f"{qualified}::new(")
            let takes = self.takes_a_handle(world, key)
            self.emit_core_args(world, walk, out, host, key, args, takes, depth, flow, scope)
            out.push(")")
            return true
        }
        return false
    }
}
