// crates/nikaia-std/src/tools/sv_smt.nika
//
// **The CDCL(T) engine** (ADR-270 D12, #1283 item A): the clauses of
// `sv_cnf.nika` searched by the SAT core of `sv_sat.nika`, a theory behind
// the interface `SvTh` of `sv_theory.nika` deciding the atoms. Every atom
// literal the SAT trail assigns is asserted to the theory, one theory level
// per decision level; after each unit propagation the theory checks what is
// asserted (not final), may propagate literals (each explained by a Farkas
// clause), and checks finally once every variable is assigned. A theory
// conflict is a clause of the log, added to the SAT core as a learned clause:
// it backjumps, analyses and learns as on a clause of its own. The SAT core
// and the theory write one book (`sv_proof.nika`), so a refutation is one
// log `sv_check.nika` replays.
//
// The theories: the simplex of `sv_simplex.nika`, Fourier-Motzkin
// (`SvTheory`), and the two together (`SvBoth`), the simplex first and
// Fourier-Motzkin with the equality elimination of `sv_elim.nika` where the
// simplex cannot tell and once at level zero, where it finds a parity or a
// gcd the simplex's branch-and-bound does not end on (#1282 item 6).
//
// Before the search, a disjunction at the top whose alternatives each fix
// one column, `x = v_j`, gives the congruence `x ≡ v_0 (mod d)` for `d` the
// gcd of the `v_j - v_0` (as the enumeration driver of #1282 derived it): an
// extension, a split, a Farkas lemma per alternative, and a unit clause the
// SAT core starts from.
//
// Real columns (ADR-270 D27): `sv_smt_engine_sorted` takes the names the
// script declares `Real`. A query with a real column runs the simplex alone
// (its integer steps skip real rows), no fast path, no preprocessing and no
// congruence on a real column; Fourier-Motzkin answers it *unknown*
// (theory). Its model is rationals, checked by `sv_real_model_holds`, as
// `lg_verify_model` reads only integers.

use std::collections

/// How the new engine answered a query.
pub enum SvDriven {
	/// The query and the log that refutes it.
	Proved(SvQuery, Vec[SvStep]),
	/// A model or an unknown, as `lg_check` gives them.
	Answer(LgAnswer),
	/// A model of a query with a real column, by name, rationals,
	/// `sv_real_model_holds` checked (ADR-270 D27).
	RealModel(collections::BTreeMap[String, SvRat]),
}

/// The new engine's answer, its work (the theory checks it ran, or a fast
/// path's rounds) and the fast path that answered (`""`: the loop); after a
/// search that ended *unknown*, the clauses it learned over the query's atoms
/// and its level-zero literals, which cross to the walk (ADR-270 D14).
pub struct SvEngineRun {
	pub driven: SvDriven,
	pub work: i64,
	pub path: String,
	pub carried: Vec[Vec[u32]],
	/// What the search did, for `--stats`.
	pub stats: SvSmtStats,
}

/// The search's counters (#1312 item 2): the SAT core's conflicts, the
/// theory's conflicts, theory lemmas (conflicts and explained
/// propagations) and those whose literals an earlier lemma already had,
/// decisions and restarts.
pub struct SvSmtStats {
	pub conflicts: i64,
	pub theory_conflicts: i64,
	pub lemmas: i64,
	pub repeated: i64,
	pub decisions: i64,
	pub restarts: i64,
}

fn sv_smt_stats_none() -> SvSmtStats {
	return SvSmtStats {
		conflicts: 0,
		theory_conflicts: 0,
		lemmas: 0,
		repeated: 0,
		decisions: 0,
		restarts: 0,
	}
}

/// The counters as `--stats` prints them.
pub fn sv_smt_stats_text(st: ref SvSmtStats) -> String {
	return f"conflicts {st.conflicts}, theory conflicts {st.theory_conflicts}, lemmas {st.lemmas} (repeated {st.repeated}), decisions {st.decisions}, restarts {st.restarts}"
}

fn sv_engine_unknown(why: LgUnknown, work: i64) -> SvEngineRun {
	return SvEngineRun {
		driven: SvDriven::Answer(LgAnswer::Unknown { why: why }),
		work: work,
		path: "",
		carried: [],
		stats: sv_smt_stats_none(),
	}
}

/// `¬l`. Written as a branch: #1286.
fn sv_not(l: u32) -> u32 {
	return if l % 2 == 0 { l + 1 } else { l - 1 }
}

/// The literals `ls`, ascending.
fn sv_sorted(ls: Vec[u32]) -> Vec[u32] {
	let mut out = ls
	out.sort()
	return out
}

/// **Both theories**: every literal asserted to each; the simplex checks,
/// Fourier-Motzkin with the equality elimination checks where the simplex
/// answers unknown, and once more at level zero after each change there.
pub struct SvBoth {
	pub simplex: SvSimplex,
	pub exact: SvTheory,
	/// Whether Fourier-Motzkin answered the last final check.
	pub by_exact: bool,
	/// Fourier-Motzkin's trail at level zero when it last checked there,
	/// `-1` before.
	pub ran_at: i64,
	/// The checks Fourier-Motzkin ran.
	pub exact_checks: i64,
}

fn sv_both(names: Vec[String]) -> SvBoth {
	return SvBoth {
		simplex: sv_simplex(names.clone()),
		exact: sv_theory(names),
		by_exact: false,
		ran_at: -1,
		exact_checks: 0,
	}
}

impl SvTh for SvBoth {
	fn push_level(ref mut self) {
		self.simplex.push_level()
		self.exact.push_level()
	}

	fn level(ref self) -> i64 {
		return self.simplex.level()
	}

	fn assert(ref mut self, lit: u32, mut book: SvBook) -> SvChecked {
		let first = self.exact.assert(lit, book)
		let got = self.simplex.assert(lit, book)
		return match got {
			SvChecked::Consistent => first,
			else => got,
		}
	}

	fn fact(ref mut self, id: u32, mut book: SvBook) -> SvChecked {
		self.exact.fact(id, book)
		return self.simplex.fact(id, book)
	}

	fn propagate(ref mut self, book: ref SvBook) -> Vec[u32] {
		return self.simplex.propagate(book)
	}

	fn explain(ref mut self, lit: u32, mut book: SvBook) -> SvClause? {
		return self.simplex.explain(lit, book)
	}

	fn backtrack(ref mut self, level: i64) {
		self.simplex.backtrack(level)
		self.exact.backtrack(level)
	}

	fn check(ref mut self, final: bool, limit: ref LgBudget, mut book: SvBook) -> SvChecked {
		let got = self.simplex.check(final, limit, book)
		match got {
			SvChecked::Consistent => {
				if final {
					self.by_exact = false
					return got
				}
				let here = self.exact.trail.len()
				if self.level() > 0 || here == self.ran_at {
					return got
				}
				self.ran_at = here
				self.exact_checks += 1
				return match self.exact.check(false, limit, book) {
					SvChecked::Conflict(c) => SvChecked::Conflict(c.clone()),
					else => got,
				}
			},
			SvChecked::Unknown(_) => {},
			else => {
				return got
			},
		}
		if !final {
			return SvChecked::Consistent
		}
		self.exact_checks += 1
		let second = self.exact.check(true, limit, book)
		return match second {
			SvChecked::Consistent => {
				self.by_exact = true
				second
			},
			SvChecked::Conflict(_) => second,
			else => got,
		}
	}

	fn model(ref self) -> collections::BTreeMap[String, i64] {
		if self.by_exact {
			return self.exact.model()
		}
		return self.simplex.model()
	}

	fn real_values(ref self) -> collections::BTreeMap[String, SvRat] {
		if self.by_exact {
			return self.exact.real_values()
		}
		return self.simplex.real_values()
	}

	fn shared(ref self) -> Vec[u32] {
		return []
	}
}

/// The search: the SAT core (which holds the book), the theory, which
/// variables are theory atoms, and how far the theory has seen the trail.
pub struct SvSmt[T: SvTh] {
	pub sat: SvSat,
	pub th: T,
	pub theory_atom: Vec[bool],
	/// The SAT trail's entries handed to the theory.
	pub head: i64,
	pub budget: LgBudget,
	/// Theory checks, partial and final: the work, capped by
	/// `budget.cases`.
	pub checks: i64,
	/// Theory conflicts and the literals the theory propagated.
	pub conflicts: i64,
	pub propagated: i64,
	/// Whether the theory's `propagate` is asked after each check.
	pub propagating: bool,
	/// Theory lemmas added, those repeating an earlier one, and the
	/// literals of each, sorted.
	pub lemmas: i64,
	pub repeated: i64,
	pub seen: collections::BTreeSet[Vec[u32]],
	/// Whether a literal went to the theory since its last check.
	pub fresh: bool,
}

/// How the search ended.
pub enum SvSmtEnd {
	Unsat,
	Sat,
	Unknown(LgUnknown),
}

/// The theory brought back to the SAT core's level, and the trail from
/// where a backjump cut it handed to it again.
fn sv_smt_sync[T: SvTh](mut s: SvSmt[T]) {
	let level = s.sat.decision_level()
	if s.th.level() > level {
		s.th.backtrack(level)
	}
	if s.sat.undone < s.head {
		s.head = s.sat.undone
	}
	s.sat.undone = s.sat.trail_len()
}

/// The trail's new entries asserted to the theory, a theory level per
/// decision level; the first answer that is no `Consistent`.
fn sv_smt_assert[T: SvTh](mut s: SvSmt[T]) -> SvChecked {
	while s.head < s.sat.trail_len() {
		let l = s.sat.trail_at(s.head)
		s.head += 1
		while s.th.level() < s.sat.level_of(l) {
			s.th.push_level()
		}
		if !s.theory_atom[(l / 2) as i64] {
			continue
		}
		s.fresh = true
		let got = s.th.assert(l, s.sat.book)
		match got {
			SvChecked::Consistent => {},
			else => {
				return got
			},
		}
	}
	return SvChecked::Consistent
}

/// A clause of the theory added to the SAT core: on a conflict the core
/// backjumps and learns. `false` where a literal is none of the core's.
fn sv_smt_lemma[T: SvTh](mut s: SvSmt[T], clause: ref SvClause) -> bool {
	for l in clause.lits {
		if !s.sat.knows(l) {
			return false
		}
	}
	s.lemmas += 1
	let key = sv_sorted(clause.lits.clone())
	if s.seen.contains(key) {
		s.repeated += 1
	} else {
		s.seen.insert(key)
	}
	let conflict = s.sat.add_lemma(clause.lits, clause.id)
	if conflict >= 0 {
		s.sat.stats.conflicts += 1
		s.sat.learn_conflict(conflict)
	}
	sv_smt_sync(s)
	return true
}

/// What a theory's answer leaves the search with: `null` to go on (a
/// conflict learned), else how it ends.
fn sv_smt_answer[T: SvTh](mut s: SvSmt[T], got: ref SvChecked) -> SvSmtEnd? {
	return match got {
		SvChecked::Conflict(c) => {
			s.conflicts += 1
			if !sv_smt_lemma(s, c) {
				return SvSmtEnd::Unknown(LgUnknown::OutsideTheTheory)
			}
			null
		},
		SvChecked::Lemmas(_) => SvSmtEnd::Unknown(LgUnknown::OutsideTheTheory),
		SvChecked::Unknown(why) => SvSmtEnd::Unknown(why.clone()),
		SvChecked::Consistent => null,
	}
}

/// The literals the theory implies, each explained by a clause the SAT core
/// propagates; whether one was new.
fn sv_smt_propagate[T: SvTh](mut s: SvSmt[T]) -> bool {
	let implied = s.th.propagate(s.sat.book)
	let mut any = false
	for l in implied {
		if !s.sat.knows(l) || !s.theory_atom[(l / 2) as i64] || s.sat.lit_value(l) != 0 {
			continue
		}
		let why = s.th.explain(l, s.sat.book) ?? continue
		s.propagated += 1
		if !sv_smt_lemma(s, why) {
			continue
		}
		any = true
	}
	return any
}

/// **The CDCL(T) loop.**
fn sv_smt_search[T: SvTh](mut s: SvSmt[T]) -> SvSmtEnd {
	while true {
		if s.sat.refuted {
			return SvSmtEnd::Unsat
		}
		if s.checks >= s.budget.cases {
			return SvSmtEnd::Unknown(LgUnknown::TooManyCases)
		}
		let conflict = s.sat.propagate()
		if conflict >= 0 {
			s.sat.stats.conflicts += 1
			if s.sat.decision_level() == 0 {
				s.sat.refute(conflict)
				return SvSmtEnd::Unsat
			}
			s.sat.learn_conflict(conflict)
			sv_smt_sync(s)
			continue
		}
		let asserted = sv_smt_assert(s)
		match asserted {
			SvChecked::Consistent => {},
			else => {
				let end = sv_smt_answer(s, asserted)
				if end != null {
					return end ?? SvSmtEnd::Sat
				}
				continue
			},
		}
		// A check only where the theory was handed a literal since the
		// last one: a decision on a definition gives it nothing new.
		if !s.fresh {
			let next = s.sat.pick()
			if next != null {
				s.sat.decide(next ?? 0)
				continue
			}
		}
		s.fresh = false
		s.checks += 1
		let partial = s.th.check(false, s.budget, s.sat.book)
		match partial {
			SvChecked::Conflict(_) => {
				let end = sv_smt_answer(s, partial)
				if end != null {
					return end ?? SvSmtEnd::Sat
				}
				continue
			},
			// Unknown before the last check: the final one decides.
			else => {},
		}
		if s.propagating && sv_smt_propagate(s) {
			continue
		}
		let next = s.sat.pick()
		if next == null {
			s.checks += 1
			let last = s.th.check(true, s.budget, s.sat.book)
			match last {
				SvChecked::Consistent => {
					return SvSmtEnd::Sat
				},
				else => {},
			}
			let end = sv_smt_answer(s, last)
			if end != null {
				return end ?? SvSmtEnd::Sat
			}
			continue
		}
		s.sat.decide(next ?? 0)
	}
}

/// The congruences of the top clauses (see the header): per clause whose
/// alternatives are definitions each implying `x - v_j <= 0` and
/// `v_j - x <= 0` on one column, the unit clause `x - v_0 - d·q <= 0` (its
/// literal into `units`, its entry into `unit_ids`) and the extension's
/// `d·q - (x - v_0) <= 0` (into `facts`). `false` where a step does not
/// close.
fn sv_smt_congruences(
	cnf: ref SvCnf,
	ids: ref Vec[u32],
	mut book: SvBook,
	mut units: Vec[u32],
	mut unit_ids: Vec[u32],
	mut facts: Vec[u32],
) -> bool {
	// What `¬d` implies, per definition atom: the other literal of each
	// two-literal clause through `d`, and the clause.
	let mut short_lit: Vec[Vec[u32]] = []
	let mut short_id: Vec[Vec[u32]] = []
	for _ in cnf.definition {
		short_lit.push([])
		short_id.push([])
	}
	let mut c = 0
	while c < cnf.query.clauses.len() {
		let clause = cnf.query.clauses[c].clone()
		if clause.len() == 2 {
			for k in [0, 1] {
				let d = clause[k]
				let a = (d / 2) as i64
				if d % 2 == 0 && cnf.definition[a] {
					short_lit[a].push(clause[1 - k])
					short_id[a].push(ids[c])
				}
			}
		}
		c += 1
	}
	c = 0
	while c < cnf.query.clauses.len() {
		let clause = cnf.query.clauses[c].clone()
		let mut defined = clause.len() >= 2
		for l in clause {
			if l % 2 == 0 || !cnf.definition[(l / 2) as i64] {
				defined = false
			}
		}
		if defined
			&& !sv_smt_congruence(
				clause,
				ids[c],
				short_lit,
				short_id,
				book,
				units,
				unit_ids,
				facts,
			) {
				return false
			}
		c += 1
	}
	return true
}

/// The congruence of top clause `clause` (entry `id`), where it has one;
/// `true` where it has none.
fn sv_smt_congruence(
	clause: ref Vec[u32],
	id: u32,
	short_lit: ref Vec[Vec[u32]],
	short_id: ref Vec[Vec[u32]],
	mut book: SvBook,
	mut units: Vec[u32],
	mut unit_ids: Vec[u32],
	mut facts: Vec[u32],
) -> bool {
	let mut column: i64 = -1
	let mut values: Vec[i64] = []
	let mut ps: Vec[u32] = []
	let mut ns: Vec[u32] = []
	let mut p_ids: Vec[u32] = []
	let mut n_ids: Vec[u32] = []
	for h in clause {
		let a = (sv_not(h) / 2) as i64
		// The first pair `x - v <= 0`, `v - x <= 0` (in the order of the
		// list, the first one's place first), found through the second
		// ones by column and constant: one pass, not one per pair (#1312).
		let n = short_lit[a].len()
		let mut rows: Vec[SvBound] = []
		let mut second: collections::BTreeMap[String, i64] = collections::BTreeMap()
		for k in 0..<n {
			let r = book.lit_bound(short_lit[a][k]) ?? return true
			if r.row.ks == [-1] {
				let key = f"{r.row.cols[0]} {r.row.constant}"
				if !second.contains_key(key) {
					second.insert(key, k)
				}
			}
			rows.push(r)
		}
		let mut found = false
		let mut i = 0
		while i < n && !found {
			let pr = rows[i].clone()
			i += 1
			if pr.row.ks != [1] {
				continue
			}
			let x = pr.row.cols[0] as i64
			let v = pr.row.constant.checked_neg() ?? continue
			let j: i64 = second.get(f"{x} {v}") ?? -1
			if j >= 0 && (column < 0 || x == column) {
				column = x
				values.push(v)
				ps.push(short_lit[a][i - 1])
				ns.push(short_lit[a][j])
				p_ids.push(short_id[a][i - 1])
				n_ids.push(short_id[a][j])
				found = true
			}
		}
		if !found {
			return true
		}
	}
	let v0 = values[0]
	let mut d = 0
	for v in values {
		d = sv_gcd(d, v.checked_sub(v0) ?? return true) ?? return true
	}
	if d < 2 {
		return true
	}
	let x = column as u32
	if book.reals.contains(x) {
		return true
	}
	let l = SvRow { cols: [x], ks: [1], constant: v0.checked_neg() ?? return true }
	let q = book.log.columns
	let t = sv_row_sum(1, l, -d, SvRow { cols: [q], ks: [1], constant: 0 }) ?? return true
	let not_t = sv_row_sum(-1, t, 1, sv_row_constant(1)) ?? return true
	let ext = book.extend(l, d) ?? return false
	let split = book.split(t, not_t) ?? return false
	let first = split.lits[0] / 2
	let below = sv_lit(first + 1, false)
	let mut cases: Vec[u32] = []
	let mut j = 0
	while j < ps.len() {
		let r1 = book.combine([SvSrc::Lit(below), SvSrc::Lit(ps[j])], [1, 1]) ?? return false
		let r2 = book.combine([SvSrc::Fact(ext.first + 1), SvSrc::Lit(ns[j])], [1, 1])
			?? return false
		let f1 = book.round(r1) ?? return false
		let f2 = book.round(r2) ?? return false
		let lemma = book.farkas([SvSrc::Fact(f1), SvSrc::Fact(f2)], [1, 1]) ?? return false
		cases.push(book.learn(
			sv_sorted([sv_not(below), sv_not(clause[j])]),
			[p_ids[j], n_ids[j], lemma.id],
		))
		j += 1
	}
	cases.push(id)
	let no_gap = book.learn([sv_not(below)], cases)
	units.push(sv_lit(first, false))
	unit_ids.push(book.learn([sv_lit(first, false)], [no_gap, split.id]))
	facts.push(ext.first)
	return true
}

/// **The new engine** on whether `facts` imply `goal`, over `theory`:
/// `simplex`, `fm` (Fourier-Motzkin with the equality elimination) or
/// `both`.
fn sv_smt_engine(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	budget: ref LgBudget,
	theory: String,
) -> SvEngineRun {
	let none: collections::BTreeSet[String] = collections::BTreeSet()
	return sv_smt_engine_sorted(arena, facts, goal, budget, theory, none)
}

/// `sv_smt_engine` where the names in `reals` are real (ADR-270 D27).
fn sv_smt_engine_sorted(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	budget: ref LgBudget,
	theory: String,
	reals: ref collections::BTreeSet[String],
) -> SvEngineRun {
	return sv_smt_engine_set(arena, facts, goal, budget, theory, reals, "")
		?? sv_engine_unknown(LgUnknown::NoContradiction, 0)
}

/// `sv_smt_engine_sorted` with the parameters `settings` (`name=value`,
/// comma-separated, `sv_params_set_all`) changed before and after the
/// strategy's pick: a threshold moves the pick, a `pipeline` or `theory`
/// overrides it. `null` where a setting does not take.
fn sv_smt_engine_set(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	budget: ref LgBudget,
	theory: String,
	reals: ref collections::BTreeSet[String],
	settings: String,
) -> SvEngineRun? {
	let mut base = sv_params()
	if !sv_params_set_all(base, settings.clone()) {
		return null
	}
	let mut why = lg_why()
	let read = sv_cnf_sorted(arena, facts, goal, reals, why)
	if read == null {
		return sv_engine_unknown(why.unknown.clone(), 0)
	}
	let cnf = read ?? return null
	let mut p = sv_strategy_pick(sv_features(cnf), base)
	sv_params_set_all(p, settings)
	if theory != "both" {
		p.theory = theory
	}
	return sv_strategy_run(arena, facts, goal, budget, cnf, p)
}

/// The search of the strategy's pipeline (`sv_strategy.nika`) on `cnf`
/// under `p`: the fast paths, the preprocessing, the CDCL(T) search over
/// `p.theory`, its SAT core starting from `phases` where they are given.
fn sv_smt_search_cnf(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	budget: ref LgBudget,
	cnf: ref SvCnf,
	p: ref SvParams,
	phases: ref Vec[bool],
) -> SvEngineRun {
	let theory = p.theory.clone()
	let real = cnf.query.reals.len() > 0
	if real && theory == "fm" {
		return sv_engine_unknown(LgUnknown::OutsideTheTheory, 0)
	}
	let mut book = sv_book(cnf.query) ?? return sv_engine_unknown(LgUnknown::Overflow, 0)
	let mut ids: Vec[u32] = []
	let mut c: u32 = 0
	for _ in cnf.query.clauses {
		ids.push(book.input(c))
		c += 1
	}
	let fast = if p.fast { sv_fast(book, cnf, ids) } else { sv_fast_skip() }
	match fast.end {
		SvFastEnd::Unsat => return SvEngineRun {
			driven: SvDriven::Proved(cnf.query.clone(), book.log.steps.clone()),
			work: fast.work,
			path: fast.path.clone(),
			carried: [],
			stats: sv_smt_stats_none(),
		},
		SvFastEnd::Sat(values) => return SvEngineRun {
			driven: SvDriven::Answer(lg_consistent_answer(arena, facts, goal, true, values)),
			work: fast.work,
			path: fast.path.clone(),
			carried: [],
			stats: sv_smt_stats_none(),
		},
		SvFastEnd::Skip => {},
	}
	let pre = if p.pre { sv_pre(book, cnf, ids) } else { sv_pre_none() }
	if pre.unsat {
		return SvEngineRun {
			driven: SvDriven::Proved(cnf.query.clone(), book.log.steps.clone()),
			work: 0,
			path: "pre",
			carried: [],
			stats: sv_smt_stats_none(),
		}
	}
	let shown = sv_smt_pre_shown(pre)
	let mut units: Vec[u32] = []
	let mut unit_ids: Vec[u32] = []
	let mut known: Vec[u32] = []
	if !sv_smt_congruences(cnf, ids, book, units, unit_ids, known) {
		return sv_engine_unknown(LgUnknown::Overflow, 0)
	}
	let vars = book.atoms.len().checked_u32() ?? return sv_engine_unknown(LgUnknown::Overflow, 0)
	let mut theory_atom: Vec[bool] = []
	let mut a = 0
	while a < book.atoms.len() {
		theory_atom.push(a >= cnf.definition.len() || !cnf.definition[a])
		a += 1
	}
	let mut sat = sv_sat_book(vars, book)
	let mut i = 0
	while i < cnf.query.clauses.len() {
		sat.add_input(cnf.query.clauses[i], ids[i])
		i += 1
	}
	i = 0
	while i < units.len() {
		sat.assign_unit(units[i], unit_ids[i])
		i += 1
	}
	for lemma in pre.lemmas {
		sat.add_input(lemma.lits, lemma.id)
	}
	// What crosses from a walk run first (ADR-270 D14): each atom's truth
	// where it came closest.
	let mut v = 0
	while v < phases.len() && v < vars as i64 {
		sat.set_phase(v, phases[v])
		v += 1
	}
	let mut run = if real {
		let mut sx = sv_strategy_simplex(cnf.names.clone(), p)
		sx.reals = cnf.query.reals.clone()
		sv_smt_run(sx, sat,
			theory_atom,
			known,
			cnf,
			arena,
			facts,
			goal,
			budget,
		)
	} else if theory == "fm" {
		sv_smt_run(sv_theory(cnf.names.clone()), sat,
			theory_atom,
			known,
			cnf,
			arena,
			facts,
			goal,
			budget,
		)
	} else if theory == "simplex" {
		sv_smt_run(sv_strategy_simplex(cnf.names.clone(), p), sat,
			theory_atom,
			known,
			cnf,
			arena,
			facts,
			goal,
			budget,
		)
	} else {
		let mut both = sv_both(cnf.names.clone())
		both.simplex = sv_strategy_simplex(cnf.names.clone(), p)
		sv_smt_run(both, sat,
			theory_atom,
			known,
			cnf,
			arena,
			facts,
			goal,
			budget,
		)
	}
	run.path = shown
	return run
}

/// What the preprocessing rewrote, for the runner's work column: `pre:`
/// and its lemmas (`l`) and literals without a fixed column (`f`); `""`
/// where it rewrote nothing.
fn sv_smt_pre_shown(pre: ref SvPre) -> String {
	if pre.lemmas.len() == 0 && pre.fixed == 0 {
		return ""
	}
	return f"pre:l{pre.lemmas.len()}f{pre.fixed}"
}

/// The search over theory `th`, its answer as the runner reads it: a log
/// for a refutation, a model checked against the query for a model.
fn sv_smt_run[T: SvTh](
	th: T,
	sat: SvSat,
	theory_atom: Vec[bool],
	known: Vec[u32],
	cnf: ref SvCnf,
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	budget: ref LgBudget,
) -> SvEngineRun {
	let mut s = SvSmt {
		sat: sat,
		th: th,
		theory_atom: theory_atom,
		head: 0,
		budget: budget.clone(),
		checks: 0,
		conflicts: 0,
		propagated: 0,
		propagating: true,
		lemmas: 0,
		repeated: 0,
		seen: collections::BTreeSet(),
		fresh: true,
	}
	for f in known {
		match s.th.fact(f, s.sat.book) {
			SvChecked::Consistent => {},
			else => {
				return sv_engine_unknown(LgUnknown::OutsideTheTheory, 0)
			},
		}
	}
	let end = sv_smt_search(s)
	let stats = SvSmtStats {
		conflicts: s.sat.stats.conflicts,
		theory_conflicts: s.conflicts,
		lemmas: s.lemmas,
		repeated: s.repeated,
		decisions: s.sat.stats.decisions,
		restarts: s.sat.stats.restarts,
	}
	return match end {
		SvSmtEnd::Unsat => SvEngineRun {
			driven: SvDriven::Proved(cnf.query.clone(), s.sat.book.log.steps.clone()),
			work: s.checks,
			path: "",
			carried: [],
			stats: stats.clone(),
		},
		SvSmtEnd::Sat => {
			if cnf.query.reals.len() == 0 {
				return SvEngineRun {
					driven: SvDriven::Answer(lg_consistent_answer(
						arena,
						facts,
						goal,
						true,
						s.th.model(),
					)),
					work: s.checks,
					path: "",
					carried: [],
					stats: stats.clone(),
				}
			}
			let values = s.th.real_values()
			if !sv_real_model_holds(arena, facts, goal, values) {
				let mut none = sv_engine_unknown(LgUnknown::NoContradiction, s.checks)
				none.stats = stats.clone()
				return none
			}
			SvEngineRun {
				driven: SvDriven::RealModel(values),
				work: s.checks,
				path: "",
				carried: [],
				stats: stats.clone(),
			}
		},
		SvSmtEnd::Unknown(why) => {
			// What crosses a switch (ADR-270 D14): the learned clauses and the
			// level-zero units over the query's own atoms.
			let mut run = sv_engine_unknown(why.clone(), s.checks)
			run.stats = stats.clone()
			let atoms = cnf.query.atoms.len()
			for c in s.sat.carried() {
				let mut inside = true
				for l in c {
					if (l / 2) as i64 >= atoms {
						inside = false
					}
				}
				if inside {
					run.carried.push(c.clone())
				}
			}
			run
		},
	}
}

/// A term's value under rational `values`, a name missing from them zero;
/// `null` where it has none (a Boolean, a quotient of a non-integer) or a
/// step leaves `i64`.
fn sv_real_value(
	arena: ref TermArena,
	id: i64,
	values: ref collections::BTreeMap[String, SvRat],
) -> SvRat? {
	let node = arena.at(id)
	return match node {
		SolverTerm::Int(n) => sv_int(n),
		// Through `sv_real_named`, not `values[name]`: #1304.
		SolverTerm::Var(name) => sv_real_named(values, name),
		SolverTerm::Add(a, b) => {
			let x = sv_real_value(arena, a, values) ?? return null
			let y = sv_real_value(arena, b, values) ?? return null
			sv_rat_add(x, y) ?? return null
		},
		SolverTerm::Sub(a, b) => {
			let x = sv_real_value(arena, a, values) ?? return null
			let y = sv_real_value(arena, b, values) ?? return null
			sv_rat_sub(x, y) ?? return null
		},
		SolverTerm::Neg(a) => {
			let x = sv_real_value(arena, a, values) ?? return null
			sv_rat_neg(x) ?? return null
		},
		SolverTerm::Mul(a, b) => {
			let x = sv_real_value(arena, a, values) ?? return null
			let y = sv_real_value(arena, b, values) ?? return null
			sv_rat_mul(x, y) ?? return null
		},
		SolverTerm::Quot(a, d) => {
			// Truncated toward zero, as Part I 2.2 divides (ADR-359 D5).
			let x = sv_real_value(arena, a, values) ?? return null
			if !sv_rat_is_int(x) {
				return null
			}
			sv_int(x.num.checked_div(d) ?? return null)
		},
		else => null,
	}
}

/// The value `values` give `name`, zero where they give none.
fn sv_real_named(values: ref collections::BTreeMap[String, SvRat], name: String) -> SvRat {
	return values[name] ?? sv_int(0)
}

/// A Boolean term's value under rational `values`; `null` where it has none.
fn sv_real_truth(
	arena: ref TermArena,
	id: i64,
	values: ref collections::BTreeMap[String, SvRat],
) -> bool? {
	let node = arena.at(id)
	return match node {
		SolverTerm::Bool(x) => x,
		SolverTerm::Not(a) => {
			let x = sv_real_truth(arena, a, values) ?? return null
			!x
		},
		SolverTerm::And(parts) => {
			let mut all = true
			for part in parts {
				let x = sv_real_truth(arena, part, values) ?? return null
				all = all && x
			}
			all
		},
		SolverTerm::Or(parts) => {
			let mut any = false
			for part in parts {
				let x = sv_real_truth(arena, part, values) ?? return null
				any = any || x
			}
			any
		},
		SolverTerm::Le(a, b) => (sv_real_order(arena, a, b, values) ?? return null) <= 0,
		SolverTerm::Lt(a, b) => (sv_real_order(arena, a, b, values) ?? return null) < 0,
		SolverTerm::Ge(a, b) => (sv_real_order(arena, a, b, values) ?? return null) >= 0,
		SolverTerm::Gt(a, b) => (sv_real_order(arena, a, b, values) ?? return null) > 0,
		SolverTerm::Eq(a, b) => (sv_real_order(arena, a, b, values) ?? return null) == 0,
		SolverTerm::Ne(a, b) => (sv_real_order(arena, a, b, values) ?? return null) != 0,
		else => null,
	}
}

/// The order of terms `a` and `b` under `values`, as `sv_rat_cmp` gives it.
fn sv_real_order(
	arena: ref TermArena,
	a: i64,
	b: i64,
	values: ref collections::BTreeMap[String, SvRat],
) -> i64? {
	let x = sv_real_value(arena, a, values) ?? return null
	let y = sv_real_value(arena, b, values) ?? return null
	return sv_rat_cmp(x, y)
}

/// Whether rational `values` make every fact true and the goal false: the
/// check of a real query's model (ADR-270 D27), as `lg_verify_model` is of
/// an integer one.
fn sv_real_model_holds(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	values: ref collections::BTreeMap[String, SvRat],
) -> bool {
	for fact in facts {
		let held = sv_real_truth(arena, fact, values) ?? return false
		if !held {
			return false
		}
	}
	let at_goal = sv_real_truth(arena, goal, values) ?? return false
	return !at_goal
}

// --- Tests: the CDCL(T) engine over each theory as the measuring rod answers
// it (moved from `tests/compiler/tests/solver_smt.nika`, which compiled the
// solver anew in a program of its own on every run): one search over the
// simplex, over Fourier-Motzkin and over both, then the search's counters
// over both as `scripts/solver.nika run --stats` prints them (#1312 item 2).
// `bits-20` holds twenty two-way disjunctions, 2^20 cases for an
// enumeration, proved with learned clauses; `threes-10` is proved by the
// congruence its disjunctions give before the search, over the simplex by the
// GCD test of a tableau row (#1284); `branch-depth` is an equality without a
// unit coefficient the elimination once extended for ever ---

// `n` values `xᵢ ∈ {0, k}` whose sum is `total`, of status `status`, and
// `extra` assertions.
fn sv_smt_test_family(n: i64, k: i64, total: i64, status: String, extra: String) -> String {
	let mut text = f"(set-logic QF_LIA)\n(set-info :status {status})\n"
	let mut terms: String = ""
	for i in 1..<n + 1 {
		text = text + f"(declare-const x{i} Int)\n"
		terms = terms + f" x{i}"
	}
	for i in 1..<n + 1 {
		text = text + f"(assert (or (= x{i} 0) (= x{i} {k})))\n"
	}
	return text + extra + f"(assert (= (+{terms}) {total}))\n(check-sat)\n"
}

// Each file answered over each theory, then the search's counters.
fn sv_smt_test_lines(files: Vec[(String, String)]) -> String {
	let mut out: String = ""
	for (name, source) in files {
		let simplex = sv_line(source.clone(), "new-simplex")
		let fm = sv_line(source.clone(), "new-fm")
		let both = sv_line(source.clone(), "new")
		out = out + f"{name}.smt2: simplex {simplex}; fm {fm}; both {both}\n"
		for line in sv_line_stats(source, "new", true).lines() {
			if line.starts_with("stats:") {
				out = out + f"  {line}\n"
			}
		}
	}
	return out
}

test "two-way disjunctions are searched with learned clauses over each theory" {
	let files = [
		("bits-20", sv_smt_test_family(20, 1, 21, "unsat", "")),
		(
			"bits-sat",
			sv_smt_test_family(12, 1, 5, "sat", "(assert (<= (+ x1 x2 x3) 1))\n(assert (>= (+ x4 x5) 2))\n"),
		),
	]
	let out = sv_smt_test_lines(files)
	let expected = [
		"bits-20.smt2: simplex proved 344; fm proved 402; both proved 344",
		"  stats: conflicts 19, theory conflicts 19, lemmas 41 (repeated 0), decisions 325, restarts 0",
		"bits-sat.smt2: simplex refuted 49; fm refuted 72; both refuted 49",
		"  stats: conflicts 9, theory conflicts 0, lemmas 34 (repeated 0), decisions 29, restarts 0",
	]
	assert(out == expected.join("\n") + "\n")
}

test "a congruence, a deep equality and contradicting bounds are answered before or without search" {
	let files = [
		("threes-10", sv_smt_test_family(10, 3, 16, "unsat", "")),
		(
			"branch-depth",
			"(set-logic QF_LIA)\n(set-info :status sat)\n(declare-fun x () Int)\n(declare-fun x6 () Int)\n(declare-fun x4 () Int)\n(assert (and (= 0 (+ x6 1 (* 2 x4))) (= 0 (+ (* x 51725) (* x6 241)))))\n(check-sat)\n",
		),
		(
			"bounds",
			"(set-logic QF_LIA)\n(set-info :status unsat)\n(declare-const x Int)\n(declare-const y Int)\n(assert (or (< x 0) (> x 10)))\n(assert (<= 0 x 10))\n(assert (= y (+ x 1)))\n(check-sat)\n",
		),
	]
	let out = sv_smt_test_lines(files)
	let expected = [
		"threes-10.smt2: simplex proved 1; fm proved 1; both proved 1",
		"  stats: conflicts 0, theory conflicts 1, lemmas 1 (repeated 0), decisions 0, restarts 0",
		"branch-depth.smt2: simplex refuted 2; fm refuted 2; both refuted 2",
		"  stats: conflicts 0, theory conflicts 0, lemmas 0 (repeated 0), decisions 0, restarts 0",
		"bounds.smt2: simplex proved 0/pre:l2f0; fm proved 0/pre:l2f0; both proved 0/pre:l2f0",
		"  stats: conflicts 1, theory conflicts 0, lemmas 0 (repeated 0), decisions 0, restarts 0",
	]
	assert(out == expected.join("\n") + "\n")
}
