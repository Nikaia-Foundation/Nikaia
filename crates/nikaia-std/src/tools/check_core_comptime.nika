// crates/nikaia-std/src/tools/check_core_comptime.nika
//
// **A `comptime`, wherever it stands, and a `dsl` block over a grammar of this
// program** (ADR-294, #125, #558, C-6, U-c2): `comptime_binding` and
// `a_block_over_a_grammar`. The form is the pilot's (`check_core_pilot.nika`):
// a free function over the state, the world and a host; the walk comes back
// through the hub `check_core_expr`.

use std::collections

/// Which shape a computed value has: 0 none, 1 an integer, 2 a float, 3 a
/// `bool`, 4 a list, 5 text, 6 a tuple, 7 a struct, 8 a variant, 9 a `std`
/// constant.
fn check_core_comptime_shape(evaluated: ref BuildValue?) -> i64 {
    let value = evaluated ?? return 0
    return match value {
        BuildValue::Int(_) => 1,
        BuildValue::Float(_) => 2,
        BuildValue::Bool(_) => 3,
        BuildValue::List(_) => 4,
        BuildValue::Text(_) => 5,
        BuildValue::Tuple(_) => 6,
        BuildValue::Struct { .. } => 7,
        BuildValue::Variant { .. } => 8,
        BuildValue::Constant { .. } => 9,
    }
}

/// A tuple's parts nothing typed, typed by the numbers they hold.
fn check_core_comptime_tuple_parts(found: ref Ty, evaluated: ref BuildValue?) -> Ty {
    let value = evaluated ?? return found.clone()
    let parts: Vec[BuildValue] = match value {
        BuildValue::Tuple(each) => each.clone(),
        else => return found.clone(),
    }
    let tys: Vec[Ty] = match found {
        Ty::Tuple(each) => each.clone(),
        else => return found.clone(),
    }
    if tys.len() != parts.len() {
        return found.clone()
    }
    let mut out: Vec[Ty] = []
    let mut at = 0
    for t in tys {
        let mut one = t.clone()
        if t.is_unknown() {
            match parts[at] {
                BuildValue::Int(n) => {
                    one = Ty::Named { name: check_core_comptime_first_type(n, false), args: [], view: false }
                },
                else => {},
            }
        }
        out.push(one)
        at = at + 1
    }
    return Ty::Tuple(out)
}

/// The type a number with nothing declaring one takes: the first of `i32` and
/// `i64` that holds it (Part I 2.4).
fn check_core_comptime_first_type(n: ref Integer, beyond: bool) -> String {
    if !beyond && integer_fits(n, "i32") {
        return "i32"
    }
    return "i64"
}

/// The type below for a `comptime` that declares one: Part I 2.2's, a type of
/// this program, or the struct the value names.
fn check_core_comptime_declared_below(state: ref CheckState, world: ref CheckWorld, want: ref Ty, evaluated: ref BuildValue?) -> String? {
    let arrives = check_core_comptime_arrives(want)
    match arrives {
        Ty::Nullable(inner) => {
            let none: BuildValue? = null
            let held = check_core_comptime_declared_below(state, world, inner, none) ?? return null
            return f"Option<{held}>"
        },
        else => {}
    }
    return rust_constant_type(world.library, want) ?? state.declared_below(world, want) ?? check_core_comptime_struct_named(want, evaluated)
}

/// **The type a `comptime` arrives as** (Part II 10.2, #1087): a `String?`
/// as a `ref String?`, every other type as itself.
fn check_core_comptime_arrives(want: ref Ty) -> Ty {
    return match want {
        Ty::Nullable(inner) => match inner {
            Ty::Named { name, args, view } if name == "String" && args.len() == 0 && !view => Ty::Nullable(Ty::Named { name: "str", args: [], view: true }),
            else => want.clone(),
        },
        else => want.clone(),
    }
}

/// The struct the value names, where it is the type `want` names.
fn check_core_comptime_struct_named(want: ref Ty, evaluated: ref BuildValue?) -> String? {
    let value = evaluated ?? return null
    let mut named: String = ""
    match value {
        BuildValue::Struct { name, .. } => { named = name.clone() },
        else => {}
    }
    if named == "" {
        return null
    }
    let mut same = false
    match want {
        Ty::Named { name, args, view } => {
            same = !view && name == named && args.len() == 0
        },
        else => {}
    }
    if same {
        return named
    }
    return null
}

/// The type below for a `comptime` nothing declares and nothing folded: the
/// expression's where the value is a number (ADR-287 D21), the value's shape
/// otherwise.
fn check_core_comptime_value_below(world: ref CheckWorld, found: ref Ty, evaluated: ref BuildValue?) -> String? {
    let value = evaluated ?? return null
    match value {
        BuildValue::Float(_) => { return "f64" },
        BuildValue::Bool(_) => { return "bool" },
        BuildValue::Int(n) => {
            let named = integer_named(found)
            if named != null {
                return named
            }
            return check_core_comptime_first_type(n, false)
        },
        BuildValue::List(items) => {
            let mut element: String? = element_below(world.library, found)
            if element == null {
                element = rust_array_type(items)
            }
            let ty = element ?? return null
            return f"[{ty}; {items.len()}]"
        },
        BuildValue::Text(_) => { return "&str" },
        BuildValue::Tuple(parts) => {
            let declared: Vec[Ty] = match found {
                Ty::Tuple(each) => each.clone(),
                else => [],
            }
            let mut each: Vec[String] = []
            let mut at = 0
            for part in parts {
                let part_found: Ty = (nth_type(declared, at) ?? Ty::Unknown).clone()
                let one: BuildValue? = part.clone()
                let held = check_core_comptime_value_below(world, part_found, one) ?? return null
                each.push(held)
                at = at + 1
            }
            return tuple_spelled(each)
        },
        BuildValue::Struct { name, .. } => { return name.clone() },
        BuildValue::Variant { ty, .. } => { return ty.clone() },
        BuildValue::Constant { constructor, .. } => { return constructed(constructor) },
    }
    return null
}

/// The elements of a computed list, or none.
fn check_core_comptime_items(evaluated: ref BuildValue?) -> Vec[BuildValue] {
    let value = evaluated ?? return []
    return match value {
        BuildValue::List(items) => items.clone(),
        else => [],
    }
}

/// The element of an `Array` written with no length, where `want` is one.
fn check_core_comptime_unsized_array(want: ref Ty) -> String? {
    match want {
        Ty::Named { name, args, .. } => {
            if name == "Array" && args.len() == 1 {
                return args[0].text()
            }
        },
        else => {}
    }
    return null
}

/// **What a declared `comptime` that does not cross as it is gets told**
/// (ADR-311 D1, D2): a field that owns memory, a growable value, an `Array`
/// with no length, or the ordinary mismatch.
fn check_core_comptime_other(mut state: CheckState, world: ref CheckWorld, bound: ref String, narrowed: ref Ty, want: ref Ty, evaluated: ref BuildValue?, span: ref Span) sync {
    let shape = check_core_comptime_shape(evaluated)
    if shape == 7 {
        let field = state.unwritable_field(world, want)
        if field.len() == 2 {
            state.a_field_that_owns_memory(bound, field[0], field[1], "a `comptime`", span)
            return
        }
    }
    if (shape == 4 || shape == 5) && is_growable(want) {
        let computed = evaluated ?? return
        state.a_constant_that_owns_memory(bound, want, computed, "a `comptime`", span)
        return
    }
    if shape == 4 && !is_growable(want) {
        let unsized = check_core_comptime_unsized_array(want)
        if unsized != null {
            let element = unsized ?? return
            let items = check_core_comptime_items(evaluated)
            let notes: Vec[String] = ["An `Array` built into the program carries its length in its type."]
            state.findings.push(check_refusal("NK1166", span, f"`{bound}` is an `Array[{element}]` with no length, which a `comptime` needs.", notes, f"Declare it as `Array[{element}, {items.len()}]`: the build computed {counted(items.len() as i64, "element")}."))
            return
        }
    }
    // **A value where its `T?` is declared** is the value present: it arrives
    // as what the `T?` arrives as (Part II 10.2, #1087).
    if check_core_comptime_nullable(want) && narrowed.fits(check_core_comptime_arrives(want)) {
        return
    }
    state.expect_type(world, narrowed, want, span, "const", fn(found_text, wanted_text) { f"This value is `{found_text}`, but the `comptime` declares `{wanted_text}`." })
}

// Whether `expr` is a local that holds the reflected field (Part II 10.3).
fn check_core_comptime_a_field_local(state: ref CheckState, world: ref CheckWorld, expr: ref Expr) -> bool {
    return match expr {
        Expr::Variable(name, _) => check_reflect_a_field(state.lookup(world.words.resolve(name)) ?? Ty::Unknown),
        else => false,
    }
}

// Whether `value` reads a local that holds the reflected field.
fn check_core_comptime_reads_a_field(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool {
    return check_core_comptime_field_local(state, world, value) != null
}

// The first local `value` reads that holds the reflected field, the holes of
// its `f"…"` literals included.
fn check_core_comptime_field_local(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> String? {
    for read in check_visit_preorder(value) {
        match read {
            Expr::Variable(name, _) => {
                if check_core_comptime_a_field_local(state, world, read) {
                    return world.words.resolve(name).clone()
                }
            },
            Expr::LitInterpolated { parts, .. } => {
                for part in parts {
                    match part {
                        FPart::Hole { expr, .. } => {
                            let found = check_core_comptime_field_local(state, world, expr)
                            if found != null {
                                return found
                            }
                        },
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    return null
}

/// **A turn's field, read for its name** (Part II 10.3, #1087): in an
/// unrolled turn `f.name` is the name of the field the turn stands at, a
/// literal the build can compute with; the rest of `value` is kept as it is.
fn check_core_comptime_turned(state: ref CheckState, world: ref CheckWorld, value: ref Expr, field: ref String) -> Expr {
    return match value {
        Expr::Field { base, name, id } => {
            if world.words.resolve(name) == "name" && check_core_comptime_a_field_local(state, world, base) {
                Expr::LitStr { text: field.clone(), id: fresh_id() }
            } else {
                Expr::Field { base: check_core_comptime_turned(state, world, base, field), name: name, id: id }
            }
        },
        Expr::Call { func, args, config, id } => Expr::Call { func: func.clone(), args: check_core_comptime_all_turned(state, world, args, field), config: config.clone(), id: id },
        Expr::MethodCall { receiver, method, args, config, id } => Expr::MethodCall { receiver: check_core_comptime_turned(state, world, receiver, field), method: method, args: check_core_comptime_all_turned(state, world, args, field), config: config.clone(), id: id },
        Expr::Binary { op, lhs, rhs, span, grouped, id } => Expr::Binary { op: op.clone(), lhs: check_core_comptime_turned(state, world, lhs, field), rhs: check_core_comptime_turned(state, world, rhs, field), span: span.clone(), grouped: grouped, id: id },
        Expr::Unary { op, expr, id } => Expr::Unary { op: op.clone(), expr: check_core_comptime_turned(state, world, expr, field), id: id },
        Expr::Coalesce { value: inner, fallback, id } => Expr::Coalesce { value: check_core_comptime_turned(state, world, inner, field), fallback: check_core_comptime_turned(state, world, fallback, field), id: id },
        Expr::LitInterpolated { parts, id } => {
            let mut kept: Vec[FPart] = []
            for part in parts {
                match part {
                    FPart::Hole { expr, spec, at } => {
                        let written: String? = spec?.clone()
                        kept.push(FPart::Hole { expr: check_core_comptime_turned(state, world, expr, field), spec: written, at: at })
                    },
                    FPart::Text(text) => kept.push(FPart::Text(text.clone())),
                }
            }
            Expr::LitInterpolated { parts: kept, id: id }
        },
        else => value.clone(),
    }
}

fn check_core_comptime_all_turned(state: ref CheckState, world: ref CheckWorld, values: ref Vec[Expr], field: ref String) -> Vec[Expr] {
    let mut out: Vec[Expr] = []
    for value in values {
        out.push(check_core_comptime_turned(state, world, value, field))
    }
    return out
}

/// **One `comptime`, wherever it stands** (ADR-287 D3): the two places differ
/// only in which frame the name lands in, so there is one function - a second
/// copy of the fold, the refusal and the emitter's spelling would be three
/// chances for the two places to disagree about what a constant is.
pub fn check_core_comptime_binding[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, name: winnow_grammar::Symbol, ty: ref Type?, value: ref Expr, bounds: ref Vec[ConfigArg], span: ref Span) -> Ty sync {
    // **The bounds this one raises** (ADR-321 D11), read before anything
    // runs: a bound that is refused runs nothing.
    let raised: CheckRaised? = state.raised_bounds(world, bounds, span)
    // **`asset("…")` is a name only here** (ADR-310 D3): the evaluator answers
    // it, so the ordinary walk's refusal is off while the initialiser is read.
    let outside = state.flow.inside_a_comptime
    state.flow.inside_a_comptime = true
    let walked_from = state.findings.len()
    let found = check_core_expr(state, world, host, value, span)
    state.flow.inside_a_comptime = outside
    // **A `comptime` another one reads is used** (#836): the reader is written
    // below as its folded value, so the language below sees no read and is
    // told so.
    for read in check_visit_preorder(value) {
        match read {
            Expr::Variable(read_name, _) => {
                state.facts.folded_comptimes.insert(world.words.resolve(read_name).clone())
            },
            else => {},
        }
    }
    // **A name nothing declares is the one error** (ADR-287 D19, #380).
    let mut said_a_name = false
    let mut at = walked_from
    while at < state.findings.len() {
        if state.findings[at].code == "NK1117" && state.findings[at].message.ends_with("` isn't declared anywhere.") {
            said_a_name = true
        }
        at = at + 1
    }
    let bound = world.words.resolve(name).clone()
    state.nameable(bound, span, "a `comptime`")
    let mut want: Ty? = null
    if ty != null {
        let written = ty ?? return Ty::Unknown
        want = check_walked_declared(state, world, written, span)
    }

    // What the emitter writes, spelled in the language below: before the type
    // check, because whether a growable value crosses as a fixed one is a
    // question about the value (ADR-311 D1).
    // **A `comptime` that reads the turn's field** (Part II 10.3, #1087) is
    // worked out once per turn, with the field the turn stands at; the walk
    // that knows no field yet leaves it to the turns.
    let turn: CheckUnrolling? = state.flow.unrolling?.clone()
    let reads_a_field = check_core_comptime_reads_a_field(state, world, value)
    let waits_for_a_turn = reads_a_field && turn == null
    let mut read: Expr = value.clone()
    let mut at_turn: String? = null
    let mut marked = false
    if reads_a_field && turn != null {
        let here = turn ?? return Ty::Unknown
        read = check_core_comptime_turned(state, world, value, here.field.name)
        at_turn = f"{span.start}:{here.on}:{here.field.name}"
        // **The field itself is read** - handed to a function, asked for an
        // attribute: the run goes through the same turn (`TURN_MARK`).
        let local: String? = check_core_comptime_field_local(state, world, read)
        if local != null {
            read = comptime_turn_marked(here.on, here.field.name, local ?? "", read)
            marked = true
        }
    }
    let mut folded: CheckConstant? = null
    if !waits_for_a_turn && !marked {
        folded = state.constant_of(world, read)
    }
    let mut fold_type: String? = null
    let mut evaluated: BuildValue? = null
    let mut said = waits_for_a_turn
    let is_null = match read {
        Expr::LitNull(_) => true,
        else => false,
    }
    if waits_for_a_turn {
    } else if is_null && check_core_comptime_nullable(want ?? Ty::Unknown) {
        // **`null` is a `const`** (Part II 10.2, #1087): nothing to run.
        evaluated = BuildValue::Variant { ty: "Option", variant: "None", payload: [] }
    } else if folded != null {
        let one = folded ?? return Ty::Unknown
        let pinned: String? = one.pinned?.clone()
        if pinned != null {
            fold_type = pinned
        } else {
            fold_type = check_core_comptime_first_type(one.value, one.beyond)
        }
        // A fold past the 65 bits has been refused already.
        if !one.beyond {
            evaluated = BuildValue::Int(one.value.clone())
        }
    } else {
        if raised == null {
            said = true
        } else {
            let more = raised ?? return Ty::Unknown
            let kept = state.flow.raised.clone()
            state.flow.raised = (more.steps, more.ram)
            let compiled = state.compiled_build_time_value(world, host, read, found, bound, span)
            if compiled.answered {
                evaluated = compiled.value
                said = compiled.said
            } else {
                let (built, refused) = state.build_time_value(host, read, bound, span)
                evaluated = built
                said = refused
            }
            state.flow.raised = kept
        }
    }
    // Counted rather than returned, so that every refusal below suppresses
    // `NK1127` the same way: one mistake, one error.
    let before = state.findings.len()
    if want != null {
        let wanted: Ty = want?.clone() ?? Ty::Unknown
        state.constant_fits(world, value, want, span)
        // **The annotation is a use, and a use answers the literal** (ADR-152 D4).
        let mut narrowed: Ty = found.clone()
        let literal = state.array_literal(world, found, wanted, value, span)
        if literal != null {
            narrowed = literal ?? Ty::Unknown
        }
        // **Growable going in, fixed coming out** (ADR-311 D1).
        match state.crosses_as_fixed(narrowed, wanted, evaluated, span) {
            CheckCrossing::Other => check_core_comptime_other(state, world, bound, narrowed, wanted, evaluated, span),
            else => {}
        }
    } else {
        let none: Ty? = null
        state.constant_fits(world, value, none, span)
    }
    let said_a_type = state.findings.len() > before

    let mut below: String? = null
    if want != null {
        let wanted: Ty = want?.clone() ?? Ty::Unknown
        below = check_core_comptime_declared_below(state, world, wanted, evaluated)
    } else {
        if fold_type != null {
            below = fold_type
        } else if check_core_comptime_nullable(found) {
            below = check_core_comptime_declared_below(state, world, found, evaluated)
        } else {
            below = check_core_comptime_value_below(world, found, evaluated)
        }
    }

    // **A map the build can see** (ADR-311 D1): a list of pairs, and the
    // declared type is what says it is a table.
    let mut said_a_table = false
    let mut crossed = false
    let mut table_below: String = ""
    let mut table_written: String = ""
    if want != null && check_core_comptime_shape(evaluated) == 4 {
        let wanted: Ty = want?.clone() ?? Ty::Unknown
        if is_fixed(wanted) {
            let pairs = check_core_comptime_items(evaluated)
            let table = state.a_table_that_crosses(world, bound, wanted, pairs, span, fn(of, variant) { check_walked_payload_of(world, of, variant) }, fn(number) { host.float_text(number) })
            if table.found {
                crossed = true
                table_below = table.below.clone()
                table_written = table.written.clone()
            } else {
                said_a_table = table.said
            }
        }
    }

    // **The value, spelled below, read against the declaration** (ADR-179 D2).
    let mut written: String? = null
    if evaluated != null {
        let computed: BuildValue = evaluated?.clone() ?? return Ty::Unknown
        written = written_below(state, world, computed, want, fn(of, variant) { check_walked_payload_of(world, of, variant) }, fn(number) { host.float_text(number) })
        // **A `T?` given its `T`** - the literal the sub-program carries - is
        // the value present.
        let optional = match computed {
            BuildValue::Variant { ty, .. } => ty == "Option",
            else => false,
        }
        if written != null && !optional && check_core_comptime_nullable(want ?? Ty::Unknown) {
            let text = written ?? ""
            written = f"Option::Some({text})"
        }
    }
    if crossed {
        below = table_below
        written = table_written
    }
    // **A part of the value the language below cannot write**, asked of the
    // value: `Shape::Empty` is a `const` and `Shape::Many([1, 2])` is not.
    let mut said_a_part = false
    if evaluated != null {
        let computed: BuildValue = evaluated?.clone() ?? return Ty::Unknown
        let part = unwritable_in(state, world, computed, fn(of, variant) { check_walked_payload_of(world, of, variant) })
        if part.len() == 2 {
            state.a_field_that_owns_memory(bound, part[0], part[1], "a `comptime`", span)
            said_a_part = true
        }
    }
    if below != null && written != null && !said_a_part {
        let spelled = below ?? return Ty::Unknown
        let text = written ?? return Ty::Unknown
        if at_turn != null {
            state.facts.turn_comptime_values.insert(at_turn ?? "", (spelled, text))
        } else {
            state.facts.comptime_values.insert(span.start as i64, (spelled, text))
        }
    } else {
        if !(said || said_a_type || said_a_table || said_a_part || said_a_name) {
            let notes: Vec[String] = ["A `comptime` has to be computed while the program is built.", "At build time the compiler can compute numbers, `bool`s, text, lists, structs and enum variants: literals, `f\"…\"`, arithmetic and comparisons, `if`, `for` over a range, `while`, and calls to your own functions and methods made of those."]
            state.findings.push(check_refusal("NK1127", span, f"`{bound}` can't be computed while the program is built.", notes, f"Write `let {bound} = …` to compute it while the program runs instead."))
        }
    }

    // **An integer with no written type is an open number** (ADR-287 D21).
    let shape = check_core_comptime_shape(evaluated)
    let declared = want != null
    let open = !declared && shape == 1
    let mut held: Ty = Ty::Unknown
    if !open {
        held = check_core_comptime_arrives(want ?? found)
    }
    // **A tuple of numbers nothing typed** (#837): each part is the type a
    // lone number of its value takes, the one its `const` is written with.
    if !open && !declared && shape == 6 {
        held = check_core_comptime_tuple_parts(held, evaluated)
    }
    let id = state.a_new_binding()
    if open {
        state.open_comptimes.insert(id, Span { start: span.start, end: span.end })
    }
    let mut constant: Integer? = null
    if shape == 1 {
        let computed = evaluated?.clone() ?? return Ty::Unknown
        match computed {
            BuildValue::Int(n) => { constant = n.clone() },
            else => {}
        }
    }
    // **What the name is worth is what was evaluated, not what folded**, and
    // the whole value, which is what a call one `comptime` later needs.
    state.bind_local(CheckLocal {
        written_mut: false,
        id: id,
        literal: null,
        name: bound,
        ty: held,
        lent: false,
        view_of: "",
        changing: false,
        constant: constant,
        built: evaluated,
        immutable: null,
        empty_list: null,
        open_number: null,
    })
    return Ty::Tuple([])
}

/// **`dsl G { … } eod` over a grammar of this program** (#518): the grammar's
/// entry run on the block's text while the program is built, as
/// `comptime … = G::entry("…")` would be. The value is recorded for the
/// emitter under the block's own node: two blocks in one statement are two
/// values. Only a grammar with one entry (ADR-296 D25).
pub fn check_core_a_block_over_a_grammar[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, block: ref Expr, target: winnow_grammar::Symbol, content: ref String, span: ref Span) -> Ty sync {
    let owner = world.words.resolve(target).clone()
    let mut entry: String = ""
    let mut any = false
    let entries = state.grammars.get(owner) ?? return Ty::Unknown
    for one in entries {
        if !any {
            entry = one.clone()
            any = true
        }
    }
    if !any {
        return Ty::Unknown
    }
    let name = host.intern("__nikaia_dsl")
    let call = Expr::Call {
        func: Expr::Path([target, host.intern(entry)], fresh_id()),
        args: [Expr::LitStr { text: as_a_literal(content.trim()), id: fresh_id() }],
        config: [],
        id: fresh_id(),
    }
    let key = span.start as i64
    let outer = state.facts.comptime_values.remove(key)
    let none: Type? = null
    let bounds: Vec[ConfigArg] = []
    check_core_comptime_binding(state, world, host, name, none, call, bounds, span)
    let value = state.facts.comptime_values.remove(key)
    if value != null {
        let recorded = value ?? return Ty::Unknown
        state.facts.dsl_values.insert(node_key(block), recorded)
    }
    if outer != null {
        let kept = outer ?? return Ty::Unknown
        state.facts.comptime_values.insert(key, kept)
    }
    // The block's type is the entry's result, as the call's would be.
    let contract = world.own.functions.get(f"{owner}::{entry}") ?? return Ty::Unknown
    let signature = contract.signature ?? return Ty::Unknown
    return signature.result?.clone() ?? Ty::Unknown
}

/// Whether a type is a `T?`.
fn check_core_comptime_nullable(ty: ref Ty) -> bool {
    return match ty {
        Ty::Nullable(_) => true,
        else => false,
    }
}
