// crates/nikaia-std/src/tools/check_core_stmt.nika
//
// **A statement, and a block of them** (ADR-294, #125, #558, C-6, U-c7):
// `stmt`, one function per `Stmt` variant, and `block`, which stops being a
// hub of the host. The form is the pilot's (`check_core_pilot.nika`): a free
// function over the state, the world and a host; an expression is walked
// through the hub `check_core_expr`. What stays Rust is asked through the host: a
// value with a cleanup bound by a `let` (`a_value_with_a_cleanup_bound`) and
// the spawn work's `NK2109` (`a_bound_handle_is_taken`, #605).

use std::collections

/// The empty tuple, what a statement that hands nothing back is.
fn check_core_stmt_unit() -> Ty {
    return Ty::Tuple([])
}

/// **The integer a `let`'s annotation names**, for the walk of its value
/// (`flow.reaching`): one of the five integer types, written bare.
fn check_core_stmt_reaching(world: ref CheckWorld, ty: ref Type?) -> String? sync {
    let written: ref Type = ty ?? return null
    return match written_ty(world.words, world.here.aliases, written) {
        Ty::Named { name, args, view } => {
            if !view && args.len() == 0 && (name == "u8" || name == "u32" || name == "u64" || name == "i32" || name == "i64") {
                name.clone()
            } else {
                null
            }
        },
        else => null,
    }
}

/// A closure or a list literal, the values a `let`'s annotation is expected by.
fn check_core_stmt_expects_a_lambda(value: ref Expr) -> bool sync {
    return match value {
        Expr::Closure { .. } => true,
        Expr::ListLit { .. } => true,
        Expr::ListRepeat { .. } => true,
        else => false,
    }
}

/// An index or a method call: the reads of a map a name is bound to.
fn check_core_stmt_a_map_read(value: ref Expr) -> bool sync {
    return match value {
        Expr::Index { .. } => true,
        Expr::MethodCall { .. } => true,
        else => false,
    }
}

/// A call of `get`, by its method's name.
fn check_core_stmt_a_get(world: ref CheckWorld, read: ref Expr) -> bool sync {
    return match read {
        Expr::MethodCall { method, .. } => world.words.resolve(method) == "get",
        else => false,
    }
}

/// An index read, `xs[i]`.
fn check_core_stmt_an_index(read: ref Expr) -> bool sync {
    return match read {
        Expr::Index { .. } => true,
        else => false,
    }
}

/// **A value `get` hands back past a jump** (D30).
fn check_core_stmt_got(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => check_core_stmt_a_get(world, read) && state.jumps(world, fallback),
        else => false,
    }
}

/// A read through the brackets whose fallback jumps.
// A chain `a[k] ?? b[k] ?? return` is one too (#735).
fn check_core_stmt_read_through_a_jump(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => check_core_stmt_an_index(read) && (state.jumps(world, fallback) || check_core_stmt_read_through_a_jump(state, world, fallback)),
        else => false,
    }
}

/// An option field read whose fallback jumps: `c.field ?? return`.
fn check_core_stmt_a_field_jump(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => check_core_stmt_a_field(read) && state.jumps(world, fallback),
        else => false,
    }
}

fn check_core_stmt_a_field(value: ref Expr) -> bool sync {
    return match value {
        Expr::Field { .. } => true,
        else => false,
    }
}

/// A named type, not a tuple or an option.
fn check_core_stmt_a_named(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { .. } => true,
        else => false,
    }
}

/// A read through the brackets or a `get` whose fallback leaves.
fn check_core_stmt_a_read_that_leaves(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => (check_core_stmt_an_index(read) || check_core_stmt_a_get(world, read)) && (state.leaves(world, fallback) || check_core_stmt_a_read_that_leaves(state, world, fallback)),
        else => false,
    }
}

/// **Each read of a chain `a[k] ?? b[k] ?? return x` is copied out** (#694):
/// the read and every read its fallback chains to, so that each arm of the
/// `match`es it lowers to hands back the number and not a view of it.
fn check_core_stmt_copied_jump_reads(mut state: CheckState, value: ref Expr) sync {
    match value {
        Expr::Coalesce { fallback, .. } => {
            state.facts.copied_jump_reads.insert(id_of(value) as i64)
            check_core_stmt_copied_jump_reads(state, fallback)
        },
        else => {},
    }
}

/// **`let mut x = m[k] ?? <jump>` is a mutable view of the entry** (#816,
/// ADR-282 D7: a copy is never inserted). The place has to be a `mut` one,
/// the same rule as a change through it (`NK1138`, `NK1139`).
fn check_core_stmt_mut_view(mut state: CheckState, world: ref CheckWorld, value: ref Expr, span: ref Span, copies: bool) sync {
    match value {
        Expr::Coalesce { value: read, .. } => {
            match read {
                Expr::Field { .. } => {
                    // A field that is an option, read through a `mut` place: `as_mut`.
                    // A word that is copied stays a copy.
                    if !copies {
                        let path = dotted_path(world, read) ?? return
                        let parts: Vec[ref String] = path.split(".").collect()
                        let root = parts[0].clone()
                        let found = state.binding(root) ?? return
                        if found.immutable == null {
                            state.facts.mut_view_reads.insert(id_of(value) as i64, "")
                        } else {
                            state.a_changed_binding_says_mut(root, "a mutable view of the field is taken here", span.clone())
                        }
                    }
                },
                Expr::Index { base, .. } => {
                    let path = dotted_path(world, base) ?? return
                    let parts: Vec[ref String] = path.split(".").collect()
                    let root = parts[0].clone()
                    let found = state.binding(root) ?? return
                    if found.immutable == null {
                        let mut lend: String = "&mut "
                        if parts.len() == 1 && state.a_mut_parameter_place(world, base) != null {
                            lend = ""
                        }
                        state.facts.mut_view_reads.insert(id_of(value) as i64, lend)
                    } else {
                        state.a_changed_binding_says_mut(root, "a mutable view of the entry is taken here", span.clone())
                    }
                },
                else => {},
            }
        },
        else => {},
    }
}

/// A name or a field, the values a `let` may see through.
fn check_core_stmt_a_name_or_field(value: ref Expr) -> bool sync {
    return match value {
        Expr::Variable(_, _) => true,
        Expr::Field { .. } => true,
        else => false,
    }
}

/// A call of a function or a method.
fn check_core_stmt_a_call(value: ref Expr) -> bool sync {
    return match value {
        Expr::Call { .. } => true,
        Expr::MethodCall { .. } => true,
        else => false,
    }
}

/// A field or an index, the places a `let` is a view of.
fn check_core_stmt_a_place(value: ref Expr) -> bool sync {
    return match value {
        Expr::Field { .. } => true,
        Expr::Index { .. } => true,
        else => false,
    }
}

/// A bare name.
fn check_core_stmt_a_name(value: ref Expr) -> bool sync {
    return match value {
        Expr::Variable(_, _) => true,
        else => false,
    }
}

/// Whether a `NK1116` was said since finding `from`.
fn check_core_stmt_overflowed_since(state: ref CheckState, from: i64) -> bool sync {
    let mut at = from
    while at < state.findings.len() as i64 {
        if state.findings[at].code == "NK1116" {
            return true
        }
        at += 1
    }
    return false
}

/// The text of a string literal, where the value is one.
fn check_core_stmt_literal(value: ref Expr) -> String? sync {
    return match value {
        Expr::LitStr { text, .. } => text.clone(),
        else => null,
    }
}

/// A `Vec` whose element type nobody knows.
fn check_core_stmt_an_unknown_list(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, args, .. } => name == "Vec" && args.len() == 1 && args[0].is_unknown(),
        else => false,
    }
}

/// A list's own type, `fs::Path`.
fn check_core_stmt_a_path(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, .. } => name == "fs::Path",
        else => false,
    }
}

/// A fresh open number at a `let` or a `for`.
fn check_core_stmt_open_number(name: ref String, element: bool, span: ref Span) -> CheckOpenNumber {
    return CheckOpenNumber { name: name.clone(), element: element, at: Span { start: span.start, end: span.end }, joined: span.start as i64, asks: [], given: [], shifted: [], derived: [], written: [], casts: [], shifts: [], typed: false, sites: [] }
}

/// **A `let` whose declared type is a number and whose value is a `for`
/// binding** (ADR-182 D5), and everything else a refusal (ADR-185 D1).
fn check_core_stmt_a_number_read_through_a_lent_binding(mut state: CheckState, world: ref CheckWorld, want: ref Ty, value: ref Expr, span: ref Span) sync {
    let wanted: String = match want {
        Ty::Named { name, args, view } => {
            if view {
                return
            }
            if args.len() == 0 && (name == "i32" || name == "i64" || name == "u8" || name == "u32" || name == "u64" || name == "f32" || name == "f64" || name == "bool" || name == "char" || name == "scalar") {
                state.a_cast_over_a_lent_binding(world, value, span)
                return
            }
            name.clone()
        },
        else => {
            return
        },
    }
    let name: String = match value {
        Expr::Variable(bound, _) => f"{world.words.resolve(bound)}",
        else => {
            return
        },
    }
    let local: CheckLocal = state.binding(name) ?? return
    if !local.lent || state.number_shaped(world, value) {
        return
    }
    state.a_copy_the_source_did_not_write(name, wanted, span)
}

/// **A value that may be wrapped into a nullable slot** (ADR-293 D3).
fn check_core_stmt_wraps_into_nullable[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, found: ref Ty, want: ref Ty, value: ref Expr, span: ref Span) sync {
    state.a_map_read_kept(world, found, want, value, span)
    let how = check_widened_slot(state, world, host, found, want, value, span)
    if how != null {
        let wrap = how ?? return
        state.facts.nullable_sites.insert(span.start as i64, wrap)
    }
}

/// A list, a map, a set, or a `struct` or an `enum` this unit declares.
fn check_core_stmt_has_no_arithmetic(world: ref CheckWorld, ty: ref Ty) -> bool sync {
    return is_a_collection_type(ty) || declared_with_no_arithmetic(world.here, ty) != null
}

/// A name nothing typed bound to `bound`.
fn check_core_stmt_lent_let(mut state: CheckState, world: ref CheckWorld, names: ref Vec[winnow_grammar::Symbol], span: ref Span) sync {
    state.facts.lent_lets.insert(span.start as i64)
    for n in names {
        let name: String = f"{world.words.resolve(n)}"
        let mut depth = state.scope.len() as i64 - 1
        if depth < 0 {
            depth = 0
        }
        state.lent_lets.insert((name, depth))
    }
}

/// **An element or a field read off a place, under a `let` that declares a
/// view of it** ([ADR-354](../../docs/specification/adr/adr-354.md) D1, #613):
/// 1 where the read is lent, 2 where it is a word by its kind and is copied
/// (`NK1257`), 0 where the rule has nothing to say.
pub fn check_core_stmt_element_view(state: ref CheckState, world: ref CheckWorld, value: ref Expr, found: ref Ty, want: ref Ty) -> i64 sync {
    if !check_core_stmt_a_place(value) || found.is_a_view() {
        return 0
    }
    let inner = match want {
        Ty::Nullable(held) => held.clone(),
        else => want.clone(),
    }
    let is_view = match inner {
        Ty::Named { view, .. } => view,
        else => false,
    }
    let read = found.unseen()
    if !is_view || !read.fits(inner.owned()) {
        return 0
    }
    if state.a_word_by_its_kind(world, read) {
        return 2
    }
    return 1
}

/// A field path or an index read as written, for a help: `given[0]`,
/// `p.a`, `xs[i]`; `…` where it is anything else.
fn check_core_stmt_read_shown(world: ref CheckWorld, value: ref Expr) -> String sync {
    return match value {
        Expr::Index { base, index, .. } => {
            let held = dotted_path(world, base) ?? return "…".clone()
            let at: String = match index {
                Expr::Variable(name, _) => world.words.resolve(name).clone(),
                Expr::LitInt { value, negative, .. } => if negative { f"-{value}" } else { f"{value}" },
                else => "…".clone(),
            }
            f"{held}[{at}]"
        }
        else => dotted_path(world, value) ?? "…".clone(),
    }
}

/// **`let`** (Part I 2.1).
// A value that is code where it is written: a lambda, or a name.
fn check_core_stmt_code_given(value: ref Expr) -> bool {
    match value {
        Expr::Closure { .. } => return true,
        Expr::Variable(_, _) => return true,
        Expr::ListLit { .. } => return true,
        Expr::ListRepeat { .. } => return true,
        Expr::If { .. } => return true,
        Expr::Match { .. } => return true,
        else => return false,
    }
}

/// Whether a value is code, or a list or map of it (ADR-351 D1).
pub fn check_core_stmt_holds_code(ty: ref Ty) -> bool {
    match ty {
        Ty::Fn { .. } => return true,
        Ty::Named { args, .. } => {
            for arg in args {
                if check_core_stmt_holds_code(arg) {
                    return true
                }
            }
            return false
        },
        else => return false,
    }
}

pub fn check_core_stmt_let[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, names: ref Vec[winnow_grammar::Symbol], shape: ref Vec[i64], mutable: bool, ty: ref Type?, value: ref Expr, span: ref Span) -> Ty sync {
    check_core_a_field_of_a_borrowed_subject(state, world, host, value, span, "bound")
    check_core_a_mut_parameter_given_away(state, world, host, value, span, "bound")
    let outer_read = state.flow.read_a_map
    state.flow.read_a_map = false
    state.flow.reaching = check_core_stmt_reaching(world, ty)
    if ty != null && (check_core_stmt_expects_a_lambda(value) || check_simd_a_call(world, value)) {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        state.flow.lambda_expected = written_ty(world.words, world.here.aliases, t)
    }
    // **A name bound to a function value is a place of the error-set
    // calculation** (ADR-351 D1): what it is given is what a call through it
    // reaches.
    let code_place = names.len() == 1 && state.current != null && check_core_stmt_code_given(value)
    if code_place {
        state.stored_frames.push(CheckStoredCode::empty())
    }
    let findings_before = state.findings.len() as i64
    state.flow.lending_let = !mutable && ty == null
    let found = check_core_expr(state, world, host, value, span)
    state.flow.lending_let = false
    state.flow.lambda_expected = null
    // **A call's whole-number result is a number of the bounds walk**
    // (#781): `let at = self.slot_of(…)` is bounded by what is assumed of
    // `at`, as a name bound to a sum is.
    if names.len() == 1 && check_core_stmt_a_call(value) {
        match found {
            Ty::Named { name, args, .. } => {
                if args.is_empty() && is_whole_number(name) {
                    state.facts.whole_fields.insert(id_of(value) as i64)
                }
            },
            else => {}
        }
    }
    // **A map's read past a jump, bound to a declared type that owns its
    // value** (ADR-293 D15): refused or copied out as an assignment's is.
    if ty != null && names.len() == 1 && shape.len() == 0 {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        let declared = written_ty(world.words, world.here.aliases, t)
        state.a_map_read_assigned(world, declared, value, span)
    }
    if code_place && !check_core_stmt_holds_code(found) {
        state.stored_frames.pop()
    } else if code_place {
        let current: String = state.current?.clone() ?? ""
        let key = f"{current}::{world.words.resolve(names[0])}"
        check_core_places_stored(state, world, host, value, key)
    }
    state.a_narrowed_read_given_up(value)
    // **A name bound to a map read is a view of the map** (#297).
    let was_read = state.flow.read_a_map
    state.flow.read_a_map = outer_read
    let of_a_map = was_read && check_core_stmt_a_map_read(value)
    // **A value `get` hands back past a jump is a reference** (D30).
    let got = check_core_stmt_got(state, world, value)
    for n in names {
        let name: String = f"{world.words.resolve(n)}"
        if got {
            state.got_past_a_jump.insert(name)
        } else {
            state.got_past_a_jump.remove(name)
        }
    }
    // **A value with a cleanup, bound here, dies where this block ends**
    // (ADR-297 D2).
    if names.len() == 1 {
        let single: String = f"{world.words.resolve(names[0])}"
        check_crossings_a_value_with_a_cleanup_bound(state, world, single, found, span)
    }
    // **`let t = s` is a rename, and a rename moves** (ADR-094 D4, ADR-293
    // D29), except `let _ = s`.
    let mut bound_names: Vec[String] = []
    for n in names {
        bound_names.push(f"{world.words.resolve(n)}")
    }
    let mut any_named = false
    for n in bound_names {
        if n != "_" {
            any_named = true
        }
    }
    // **A container a `let` declares a view of what it holds is lent** (#452).
    let mut seen_through = false
    if check_core_stmt_a_name_or_field(value) && ty != null {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        let want = written_ty(world.words, world.here.aliases, t)
        seen_through = !found.fits(want) && state.fits_through_deref(world, found, want)
    }
    // **An element or a field read off a place under a `ref T` is a view of
    // it** (ADR-354 D1, #613).
    let mut element_view = 0
    if names.len() == 1 && ty != null {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        let want = written_ty(world.words, world.here.aliases, t)
        element_view = check_core_stmt_element_view(state, world, value, found, want)
    }
    // **A name bound to `s.bytes` is the view** (ADR-320 D11): nothing is
    // handed over, and the name is copied where it is kept. A `let mut` keeps
    // it, so it is copied there.
    let bytes_view = !mutable && names.len() == 1 && shape.len() == 0 && state.a_text_bytes_view(world, value)
    if seen_through || element_view == 1 {
        check_core_stmt_lent_let(state, world, names, span)
    } else if any_named && !bytes_view {
        let to = f"bound to `{bound_names.join("`, `")}` by a `let`"
        state.hands_over(world, value, found, to, span)
    }
    // **And a `let` gives the name a value again**, as an assignment does.
    for n in bound_names {
        if n != "_" {
            state.written_at.push((n.clone(), span.start as i64))
        }
    }
    // **A `let` over a place is a view of it** (ADR-094 D4).
    if check_core_stmt_a_place(value) && state.takes_away(world, found) && !state.facts.text_bytes.contains(node_key(value)) {
        check_core_stmt_lent_let(state, world, names, span)
    }
    // **A tuple of names takes the value apart** (ADR-291).
    if names.len() >= 2 || shape.len() > 0 {
        return state.tuple_let(world, names, shape, ty != null, found, value, span)
    }
    let name: String = f"{world.words.resolve(names[0])}"
    // **`let _ = expr` is a statement wearing a `let`** (ADR-291 D7).
    if name == "_" {
        state.a_let_that_binds_nothing(span)
    }
    state.nameable(name, span, "a `let`")
    let mut bound = Ty::Unknown
    if ty != null {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        let want = host.declared(state, t, span)
        // **The annotation is no longer the constructor** (ADR-281 D2).
        state.constant_fits(world, value, want, span)
        check_core_stmt_wraps_into_nullable(state, world, host, found, want, value, span)
        // **The annotation is a use, and a use answers the literal** (ADR-152 D4).
        let by_use = check_core_literal_by_use(state, world, host, found, want, value, span)
        let found_used: Ty = by_use ?? found.clone()
        let widened = state.widened_elements(world, found_used, want, value, span)
        let mut found_kept: Ty = widened ?? found_used.clone()
        if element_view == 1 {
            found_kept = want.clone()
        } else if element_view == 2 {
            // **A word is copied at a read, so there is no view of it to
            // declare** (ADR-354 D2).
            let shown = found.unseen().text()
            let written = check_core_stmt_read_shown(world, value)
            state.findings.push(check_refusal("NK1257", span, f"A `{shown}` read out of a place is a copy, so it can't be bound as a `ref {shown}`.", ["A number, a `bool`, a `scalar` and an enum whose variants hold nothing are copied at a read (ADR-279 D8); there is no view of them to keep.".clone()], f"an `{shown}` is copied at a read; write `let {name} = {written}`."))
            found_kept = want.clone()
        }
        state.expect_kept_asked(world, found_kept, want, value, "the `let` declares a `String`, which is text of its own", span, "let", fn(was, wanted) { f"This value is `{was}`, but the `let` declares `{wanted}`." })
        check_core_stmt_a_number_read_through_a_lent_binding(state, world, want, value, span)
        bound = want
    } else if mutable && state.flow.grown_text.contains(name) && found.is_a_view() && state.text_literal(world, check_core_method_named("String"), value, true) != null {
        // **A `let mut` of a literal that the body later grows holds text of
        // its own** (0.0.232).
        bound = check_core_method_named("String")
    } else {
        // **A number nothing typed is open** (ADR-285 D1).
        if !(found.is_unknown() && state.number_shaped(world, value)) {
            state.constant_fits(world, value, null, span)
        }
        if found.is_unknown() {
            let met = state.views_meet_owned_text(world, value)
            bound = met ?? found.clone()
        } else {
            bound = found.clone()
        }
    }
    let mut open: i64? = null
    if ty == null && bound.is_unknown() && state.number_shaped(world, value) {
        state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(name, false, span))
        state.open_number_given(world, span.start as i64, value, span)
        open = span.start as i64
    }
    // **A list written in numbers has one open number for its elements**
    // (ADR-285 D34).
    let mut element_at: i64? = null
    let mut element_constants: Vec[CheckConstant]? = null
    if ty == null && check_core_stmt_an_unknown_list(bound) {
        match value {
            Expr::ListLit { items, .. } => {
                let mut all_numbers = items.len() > 0
                for item in items {
                    if all_numbers && !state.number_shaped(world, item) {
                        all_numbers = false
                    }
                }
                if all_numbers {
                    state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(name, true, span))
                    for item in items {
                        state.open_number_given(world, span.start as i64, item, span)
                    }
                    if !mutable {
                        let mut constants: Vec[CheckConstant] = []
                        let mut every = true
                        for item in items {
                            if every {
                                let c = state.constant_of(world, item)
                                if c == null {
                                    every = false
                                } else {
                                    constants.push(c ?? continue)
                                }
                            }
                        }
                        if every {
                            element_constants = constants
                        }
                    }
                    element_at = span.start as i64
                }
            },
            // **So has `[v; n]` whose `v` is a number** (ADR-362 D1).
            Expr::ListRepeat { value: item, .. } => {
                if state.number_shaped(world, item) {
                    state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(name, true, span))
                    state.open_number_given(world, span.start as i64, item, span)
                    element_at = span.start as i64
                }
            },
            else => {},
        }
    }
    // **An empty list has no element type, and D2 says where one comes
    // from** (ADR-135).
    let mut pending: i64? = null
    if ty == null {
        match value {
            Expr::ListLit { items, .. } => {
                if items.len() == 0 {
                    state.flow.empty_lists.insert(span.start as i64, (name.clone(), Span { start: span.start, end: span.end }))
                    pending = span.start as i64
                }
            },
            // **A map made without its types** is asked as an empty list is
            // (ADR-285 D43).
            Expr::Call { args, .. } => {
                if args.len() == 0 && names.len() == 1 && shape.len() == 0 && check_core_stmt_an_untyped_map(bound) {
                    state.flow.empty_lists.insert(span.start as i64, (name.clone(), Span { start: span.start, end: span.end }))
                    state.flow.empty_maps.insert(span.start as i64)
                    pending = span.start as i64
                }
            },
            else => {},
        }
    }
    // **Only an immutable `let` carries its value forward** (Part III, C.4);
    // a `let mut`'s is followed through straight-line code.
    let mut constant: Integer? = null
    let mut followed: Integer? = null
    let c = state.constant_of(world, value)
    // **A constant that overflowed is said once, where it was written**
    // (#662): the binding carries no value forward to be refused again. Nor
    // does a shift of literals beside a type: it is that type's, and its
    // exact value is not the one the binding holds (ADR-285 D40).
    let typed_shift = ty != null && (shifts_literals(value) || state.an_open_shift_in(world, value))
    if c != null && !typed_shift && !check_core_stmt_overflowed_since(state, findings_before) {
        let held: CheckConstant = c ?? return check_core_stmt_unit()
        if !mutable {
            constant = held.value
        } else if !held.beyond {
            followed = held.value
        }
    }
    // **What a task binds for itself** (ADR-055 D6).
    let tasks = state.task_bindings.len()
    if tasks > 0 {
        state.task_bindings[tasks - 1].push((name.clone(), bound.clone(), span.start as i64))
    }
    let id = state.a_new_binding()
    if bytes_view {
        state.text_bytes_lets.insert(id)
    }
    // **A position a text handed out keeps where it came from** (ADR-320 D5).
    if !mutable && names.len() == 1 && shape.len() == 0 {
        let position = check_core_places_text_position(state, world, value)
        if position != null {
            state.text_positions.insert(id, position ?? CheckTextPosition { text: "", step: -1 })
        }
    }
    // **A `'…'` nothing typed is typed by its uses** (ADR-320 D8, as a
    // number is, ADR-285 D23): a `u8` where they ask one.
    if ty == null && !mutable {
        match value {
            Expr::LitChar(written, _) => {
                if literal_is_a_byte(written) {
                    let literal = id_of(value) as i64
                    state.flow.high_bytes.remove(literal)
                    state.flow.open_chars.insert(id, CheckOpenChar { name: name.clone(), written: written.clone(), literal: literal, at: span.clone(), reads: collections::BTreeMap(), bytes: collections::BTreeSet() })
                }
            },
            else => {},
        }
    }
    if followed != null {
        state.flow.followed.insert(id, followed ?? return check_core_stmt_unit())
    }
    if element_at != null {
        state.flow.open_elements.insert(id, element_at ?? 0)
        if element_constants != null {
            state.flow.list_constants.insert(id, element_constants ?? [])
        }
    }
    // **And typed as one**: a `V?` read out of a map is an option of a view.
    if of_a_map {
        let kept: Ty = match bound {
            Ty::Nullable(inner) => {
                if inner.is_a_view() {
                    bound.clone()
                } else {
                    Ty::Nullable(view_of_type(inner))
                }
            },
            else => bound.clone(),
        }
        bound = kept
        state.flow.map_views.insert(id)
    }
    // **A read through the brackets that jumps where nothing is there binds
    // what the container holds**, unless it reads a number, a `bool` or a
    // `char` (#456).
    let jumped = check_core_stmt_read_through_a_jump(state, world, value)
    let copied_read = a_copy_by_value(bound) && check_core_stmt_a_read_that_leaves(state, world, value)
    if copied_read {
        check_core_stmt_copied_jump_reads(state, value)
    }
    // **A map's read of a type of the package that copies, past a jump, is
    // copied out** (ADR-279 D8), as the typed `let x: T = m[k] ?? return`
    // copies it (ADR-293 D15): a word is a value, not a view of the map.
    let copied_word = ty == null && jumped && !copied_read && state.a_package_copy(world, bound) && check_core_stmt_a_named(bound)
    if copied_word {
        state.a_map_read_assigned(world, bound, value, span)
    }
    let read_through_a_jump = jumped && !copied_read && !copied_word
    if mutable && (read_through_a_jump || check_core_stmt_a_field_jump(state, world, value)) {
        check_core_stmt_mut_view(state, world, value, span, a_copy_by_value(bound))
    }
    if check_core_stmt_a_path(bound) && state.made_from_text(world, value) {
        state.flow.text_paths.insert(id)
    }
    if bound.is_unknown() || state.a_drivers_row(world, value) {
        state.flow.unknown_bound.insert(id)
    }
    let mut literal: String? = null
    if ty == null {
        literal = check_core_stmt_literal(value)
    }
    let mut immutable: CheckImmutable? = null
    if !mutable {
        immutable = CheckImmutable { at: Span { start: span.start, end: span.end }, kind: CheckKind::Let }
    }
    match bound {
        Ty::Named { name, .. } => {
            if name == "TaskHandle" {
                state.flow.handle_lets.insert(span.start as i64)
            }
        },
        else => {},
    }
    let mut local = CheckLocal::free(name, bound, id)
    local.constant = constant
    local.lent = read_through_a_jump
    local.empty_list = pending
    local.open_number = open
    local.literal = literal
    local.immutable = immutable
    local.written_mut = mutable
    state.bind_local(local)
    return check_core_stmt_unit()
}

/// A shift, `<<` or `>>`.
fn check_core_stmt_a_shift(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Shl || o == BinaryOp::Shr
}

/// `+`, `-` or `*`, written compound.
fn check_core_stmt_add_sub_mul(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Add || o == BinaryOp::Sub || o == BinaryOp::Mul
}

/// An arithmetic or bit operator a slot of numbers is read once for.
fn check_core_stmt_a_slot_operator(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Add || o == BinaryOp::Sub || o == BinaryOp::Mul || o == BinaryOp::Div || o == BinaryOp::Rem || o == BinaryOp::BitAnd || o == BinaryOp::BitOr || o == BinaryOp::BitXor || o == BinaryOp::Shl || o == BinaryOp::Shr
}

/// An arithmetic operator, `+ - * / %`.
fn check_core_stmt_arithmetic(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Add || o == BinaryOp::Sub || o == BinaryOp::Mul || o == BinaryOp::Div || o == BinaryOp::Rem
}

/// A plain, not a view, type with no arguments: its name.
fn check_core_stmt_plain_name(ty: ref Ty) -> String? sync {
    return match ty {
        Ty::Named { name, args, view } => {
            if !view && args.len() == 0 {
                name.clone()
            } else {
                null
            }
        },
        else => null,
    }
}

/// A map type that says neither its key nor its value.
fn check_core_stmt_an_untyped_map(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, args, .. } => a_map_type(name) && (args.len() == 0 || (args.len() == 2 && args[0].is_unknown() && args[1].is_unknown())),
        else => false,
    }
}

/// **The open number an assignment's target is**, its root.
fn check_core_stmt_open_target(state: ref CheckState, world: ref CheckWorld, target: ref Expr) -> i64? sync {
    match target {
        Expr::Variable(name, _) => {
            let named: String = f"{world.words.resolve(name)}"
            let local: CheckLocal = state.binding(named) ?? return null
            let at: i64 = local.open_number ?? return null
            return state.open_root(at)
        },
        Expr::Index { .. } => {
            let at: i64 = state.open_element_of(world, target) ?? return null
            return state.open_root(at)
        },
        else => {},
    }
    return null
}

/// Whether the target is a name that holds shared mutable state.
fn check_core_stmt_shared(state: ref CheckState, world: ref CheckWorld, target: ref Expr) -> bool sync {
    if !check_core_stmt_a_name(target) {
        return false
    }
    let root: String = state.rooted_at(world, target) ?? return false
    let local: CheckLocal = state.binding(root) ?? return false
    return match local.ty {
        Ty::Named { name, .. } => name == "SharedMut",
        else => false,
    }
}

/// **`x = v` and `x op= v`** (Part I 2.1).
pub fn check_core_stmt_assign[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, target: ref Expr, op: ref BinaryOp?, value: ref Expr, span: ref Span) -> Ty sync {
    // **Code assigned meets what the place holds** (ADR-351 D3).
    let code_keys: Vec[String] = if op == null { check_core_places_code_keys(state, world, target) } else { [] }
    // `NK2101`: an assignment **revives** a name a task took with it, and a
    // part of one (ADR-293 D32).
    let path = state.place_path(world, target)
    if path != null {
        let written: String = (path ?? "").clone()
        let choices = state.branch.clone()
        state.gives.push(CheckGive { path: written.clone(), at: span.start as i64, choices: choices })
        state.written_at.push((written, span.start as i64))
    }
    // **D3**: an assignment into a parameter says `mut`.
    let shared = check_core_stmt_shared(state, world, target)
    if !shared {
        let rooted = state.rooted_at(world, target)
        if rooted != null {
            let root: String = (rooted ?? "").clone()
            let how: String = if check_core_stmt_a_name(target) { "changed here".clone() } else { "one of its parts is changed here".clone() }
            state.a_changed_binding_says_mut(root, how, Span { start: span.start, end: span.end })
            state.a_shared_name_changed_in_parallel(root, span)
        }
    }
    // **A write through the brackets is unchanged** (ADR-293 D2, D19).
    let outer = state.reading_only
    state.reading_only = check_core_stmt_a_name(target)
    // **A key written is handed to the map** (ADR-293 D27).
    state.flow.writing_index = op == null && check_core_stmt_an_index(target)
    let mut into = check_core_expr(state, world, host, target, span)
    if check_core_stmt_an_index(target) {
        let slot: Ty = match into {
            Ty::Nullable(inner) => inner.clone(),
            else => into.clone(),
        }
        into = slot
    }
    state.reading_only = outer
    state.flow.writing_index = false
    if code_keys.len() > 0 {
        state.stored_frames.push(CheckStoredCode::empty())
    }
    let mut found = check_core_expr(state, world, host, value, span)
    if code_keys.len() > 0 {
        check_core_places_stored_keys(state, world, host, value, code_keys)
    }
    if op == null {
        state.a_map_read_assigned(world, into, value, span)
        check_fields_map_first_written(state, world, target, value, found, span)
    }
    // **An assignment keeps what it is given** (ADR-282 D3, ADR-293 D28).
    if op == null {
        check_core_a_kept_lambda(state, world, host, into, value, span)
    }
    if op == null {
        let built = state.text_literal(world, into, value, true)
        if built != null {
            found = built ?? found.clone()
        }
    }
    // **An assignment is a use of both sides** (ADR-285 D24, D25).
    if !check_core_stmt_a_shift(op) {
        let open = check_core_stmt_open_target(state, world, target)
        if open != null {
            if integer_named(value_of_a_copy(found.unseen())) != null {
                state.number_asked(world, target, found, span, true)
            } else if state.number_shaped(world, value) {
                state.open_number_given(world, open ?? 0, value, span)
            }
        }
        state.number_asked(world, value, into, span, true)
    }
    // **`x <<= k` shifts `x` as `x << k` does** (Part I 2.2).
    if check_core_stmt_a_shift(op) {
        let o: ref BinaryOp = op ?? return check_core_stmt_unit()
        state.shift_count_fits(world, o.clone(), target, value_of_a_copy(into.unseen()), value, span)
    }
    // **A `let mut` is followed through what straight-line code assigns it**.
    state.assigned_followed(world, target, op, value)
    // **What is assigned is given to the place** (ADR-293 D29).
    if op == null {
        let to: String = if check_core_stmt_an_index(target) { "written into a container".clone() } else { "assigned to another name".clone() }
        state.hands_over(world, value, found, to, span)
    }
    // **A write to shared mutable state goes through a door** (ADR-281).
    let written = host.written(value)
    state.a_write_that_skips_the_door(world, target, into, written, span)
    // **A compound assignment on a map slot is written out** (ADR-293 D2).
    if op != null {
        check_core_a_compound_write_to_a_map_slot(state, world, host, target, span)
    }
    // **`x += a` over two integer types is `x = x + a`** (ADR-285 D32).
    if op != null && !check_core_stmt_a_shift(op) {
        let o: ref BinaryOp = op ?? return check_core_stmt_unit()
        // **`x += 1` over an `f64` `x`** is an integer beside a float (#703).
        if !state.an_integer_beside_a_float(world, target, into, value, found, span) {
            state.a_compound_over_two_integer_types(world, o.clone(), target, into, value, found, span)
        }
    }
    // **`x += d` is `x = x + d`, and may be proved as one** (#387), and so
    // is `x.f += d`, a fold's counter (ADR-367 D3).
    if check_core_stmt_add_sub_mul(op) && check_core_stmt_a_name_or_field(target) {
        let plain = check_core_stmt_plain_name(into.unseen())
        if plain != null {
            let name: String = (plain ?? "").clone()
            // A number this use types (ADR-285 D23) takes the name's type.
            let same = match value {
                Expr::LitInt { .. } => true,
                else => value_of_a_copy(found.unseen()) == into.unseen() || state.open_numbers_in(world, value).len() > 0,
            }
            if is_whole_number(name) && same {
                state.facts.arithmetic.insert(span.start as i64, name)
            }
        } else {
            // **`i += d` on an untyped `let mut i = 0`** takes `d`'s type
            // where `d` has one, and otherwise waits for the number's type,
            // as `i + 1` does (ADR-285 D23).
            let given = check_core_stmt_plain_name(found.unseen())
            let counted = match value {
                Expr::LitInt { .. } => true,
                else => state.open_numbers_in(world, value).len() > 0,
            }
            if given != null && is_whole_number(given ?? "") && !counted {
                state.facts.arithmetic.insert(span.start as i64, (given ?? "").clone())
            } else if counted {
                state.open_number_site(world, [target], span.start as i64)
            }
        }
    }
    // **`xs[i] += d` on a list of numbers** (#387).
    if check_core_stmt_a_slot_operator(op) && check_core_stmt_an_index(target) {
        let plain = check_core_stmt_plain_name(into.unseen())
        if plain != null {
            let name: String = (plain ?? "").clone()
            if a_number_name(name) || name == "bool" {
                state.facts.copied_slots.insert(span.start as i64)
            }
        }
    }
    // **`NK1191` for `-=` as for `-`**.
    if check_core_stmt_arithmetic(op) {
        let arithmetic: ref BinaryOp = op ?? return check_core_stmt_unit()
        if !(arithmetic == BinaryOp::Add && is_text_type(into)) && (check_core_stmt_has_no_arithmetic(world, into) || check_core_stmt_has_no_arithmetic(world, found)) {
            state.arithmetic_on_something_that_has_none(world, arithmetic.clone(), target, into, value, found, true, span)
        }
    }
    // Only a plain assignment.
    if op == null {
        check_core_stmt_wraps_into_nullable(state, world, host, found, into, value, span)
        if state.owned_text_into_a_literal_binding(world, target, found, into, span) {
            return check_core_stmt_unit()
        }
        if state.a_name_in_text(world, into, value, span) {
            return check_core_stmt_unit()
        }
        let at = check_span_at(world, value, span)
        let pushed = state.findings.len() as i64
        let waiting = state.slots_waiting(span)
        // **A number assigned where no integer goes** (#703) is the `i64` it
        // would be, and the mismatch says so.
        if check_float_literal_fits(value, into) {
            state.floats_beyond_f32(value, into, span)
            return check_core_stmt_unit()
        }
        let mut assigned: Ty = found.clone()
        if found.is_unknown() && state.number_shaped(world, value) && state.no_integer_is(into) {
            assigned = Ty::Named { name: "i64".clone(), args: [], view: false }
        }
        state.expect_type(world, assigned, into, span, "assign", fn(was, wanted) { f"You're assigning `{was}` to something that holds `{wanted}`." })
        state.findings_moved(span, at, pushed, waiting)
    }
    return check_core_stmt_unit()
}

/// **`while`** (Part I 3.3).
pub fn check_core_stmt_while[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, cond: ref Expr, body: ref Block, span: ref Span) -> Ty sync {
    let cond_ty = check_core_expr(state, world, host, cond, span)
    let at = check_span_at(world, cond, span)
    state.expect_bool(cond_ty, at, "A `while` loop repeats while a `bool` is `true`.")
    let depth = state.scope.len() as i64
    state.repeats.push(CheckRepeats::a_loop(world.words, depth, body))
    // **The body sees what the condition proves not `null`** (ADR-350 D2).
    let proved = check_narrow_proved_here(state, world, cond, true)
    state.scope.push(proved)
    // **The body and not the condition.**
    state.flow.loops += 1
    check_core_stmt_body_discarded(state, body)
    check_core_block(state, world, host, body)
    state.flow.loops -= 1
    state.scope.pop()
    state.repeats.pop()
    return check_core_stmt_unit()
}

/// **A range's binding is a use of the numbers it counts between**
/// (ADR-285 D1, ADR-270 D8 step 1), and between two literals a number of its
/// own (D1, D3).
fn check_core_stmt_for_a_range(mut state: CheckState, world: ref CheckWorld, iter: ref Expr, mut frame: Vec[CheckLocal], span: ref Span) sync {
    match iter {
        Expr::Range { start, end, .. } => {
            let mut open: Vec[i64] = []
            for n in state.open_numbers_in(world, start) {
                open.push(n)
            }
            for n in state.open_numbers_in(world, end) {
                open.push(n)
            }
            state.open_numbers_joined(open)
            if open.len() > 0 && frame.len() > 0 {
                frame[0].open_number = state.open_root(open[0])
            }
            // **Between two literals the binding is a number of its own** (D1, D3).
            if open.len() == 0 && state.number_shaped(world, start) && state.number_shaped(world, end) && frame.len() > 0 && frame[0].ty.is_unknown() {
                let first: String = frame[0].name.clone()
                state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(first, false, span))
                frame[0].open_number = span.start as i64
                state.open_number_given(world, span.start as i64, start, span)
                state.open_number_given(world, span.start as i64, end, span)
            }
        },
        else => {},
    }
}

/// **`for`** (Part I 3.3).
pub fn check_core_stmt_for[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, bindings: ref Vec[winnow_grammar::Symbol], shape: ref Vec[i64], iter: ref Expr, body: ref Block, span: ref Span) -> Ty sync {
    state.the_caller_writes_no_reference(iter, span, "a `for` lends what it iterates")
    let over = check_core_expr(state, world, host, iter, span)
    state.a_loop_over_a_nullable(world, over, iter, span)
    // **A nested head walks its top-level width** (ADR-356).
    let mut width = bindings.len() as i64
    if shape.len() > 0 && shape[0] > 0 {
        width = shape[0]
    }
    let before = state.findings.len()
    state.fallible_step(world, over, width, span)
    // A fallible walk bound to several names is `NK2701` already.
    let stepped_fallibly = state.findings.len() > before
    state.pausing_step(over, span)
    // **A `for` walks a produced sequence, and that consumes it** (ADR-105 D2).
    state.a_sequence_is_walked(iter, over, span, world)
    let mut elements = elements_walked(over, width)
    if width > 1 && !stepped_fallibly {
        let refused = state.a_tuple_pattern_that_does_not_fit(element_walked(over, 1), width, "A `for`", span)
    }
    if shape.len() > 0 {
        elements = state.nested_pattern_parts(world, elements, shape, bindings.len() as i64, "A `for`", span)
    }
    // **An element of a list of code is given what the list was** (ADR-351
    // D1, D4).
    if bindings.len() == 1 && state.current != null && check_core_stmt_holds_code(over) {
        // A name of this function, or a field path: each place it names.
        let current: String = state.current?.clone() ?? ""
        let to = f"{current}::{world.words.resolve(bindings[0])}"
        let keys = check_core_places_code_keys(state, world, iter)
        let mut entry: CheckStoredCode = state.stored_code.remove(to) ?? CheckStoredCode::empty()
        if keys.len() == 0 {
            entry.unresolved = true
        }
        for from in keys {
            let given: CheckStoredCode = state.stored_code[from]?.clone() ?? CheckStoredCode { resolved: collections::BTreeSet(), unresolved: true, free: collections::BTreeSet() }
            for resolved in given.resolved {
                entry.resolved.insert(resolved.clone())
            }
            entry.unresolved = entry.unresolved || given.unresolved
            for free in given.free {
                entry.free.insert(free.clone())
            }
        }
        state.stored_code.insert(to, entry)
    }
    // **A name that holds a sequence is handed over, not lent** (ADR-293 D19).
    let a_seq = match over {
        Ty::Seq { .. } => true,
        else => false,
    }
    let owned = is_a_place(iter) && a_seq
    if owned {
        state.facts.owned_loops.insert(span.start as i64)
    }
    // **A `for` over a place lends** (ADR-094 D4).
    let lent = is_a_place(iter) && !owned
    let mut frame: Vec[CheckLocal] = []
    let mut at = 0
    for b in bindings {
        if at >= elements.len() {
            break
        }
        let name: String = f"{world.words.resolve(b)}"
        let element = elements[at].clone()
        at += 1
        let copied = lent && name != "_" && a_copy_by_value(element)
        if copied {
            state.facts.copied_loop_bindings.insert((span.start as i64, name.clone()))
        }
        // **An element of a type that copies by declaration is the value**
        // (`selfhosting_defects::a_loop_over_copies_binds_the_value`): a type
        // of the package that derives `Copy`, or a described one whose ledger
        // says `copies`, as a number is above.
        let declared_copy = lent && name != "_" && !copied && !element.is_a_view() && state.a_view_that_copies(world, view_of_type(element))
        let a_view = declared_copy || (lent && name != "_" && !copied && element.is_a_view())
        if a_view {
            state.facts.copied_view_bindings.insert((span.start as i64, name.clone()))
        }
        // **A binding lent something that does not copy is a view of it.**
        let named = match element {
            Ty::Named { .. } => true,
            else => false,
        }
        let mut bound = element.clone()
        if lent && !copied && !declared_copy && named {
            bound = view_of_type(element)
        }
        let id = state.a_new_binding()
        let mut local = CheckLocal::free(name, bound, id)
        local.written_mut = false
        local.lent = lent && !copied && !a_view
        // **A `for` binding takes no `mut`** (Part I 3.3, #734): its head is
        // a `let`'s pattern, so a change to it is `NK1139`.
        local.immutable = CheckImmutable { at: Span { start: span.start, end: span.end }, kind: CheckKind::Loop }
        frame.push(local)
    }
    // **A range's binding is a use of the numbers it counts between**
    // (ADR-285 D1, ADR-270 D8).
    if bindings.len() == 1 {
        check_core_stmt_for_a_range(state, world, iter, frame, span)
    }
    // **A walk over a list written in numbers binds its open element**
    // (ADR-285 D34).
    if bindings.len() == 1 && frame.len() > 0 && frame[0].ty.is_unknown() {
        match iter {
            Expr::Variable(name, _) => {
                let named: String = f"{world.words.resolve(name)}"
                let list = state.binding(named)
                if list != null {
                    let held: CheckLocal = list ?? return check_core_stmt_unit()
                    let element_at = state.flow.open_elements.get(held.id)
                    if element_at != null {
                        let element: i64 = element_at ?? 0
                        frame[0].open_number = state.open_root(element)
                    }
                }
            },
            Expr::ListLit { items, .. } => {
                let mut all_numbers = items.len() > 0
                for item in items {
                    if all_numbers && !state.number_shaped(world, item) {
                        all_numbers = false
                    }
                }
                if all_numbers {
                    let first: String = frame[0].name.clone()
                    state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(first, false, span))
                    frame[0].open_number = span.start as i64
                    for item in items {
                        state.open_number_given(world, span.start as i64, item, span)
                    }
                }
            },
            else => {},
        }
    }
    // **A walk over a map written in numbers binds its open key and value**
    // (ADR-285 D43).
    if bindings.len() == 2 && frame.len() == 2 {
        match iter {
            Expr::Variable(name, _) => {
                let named: String = f"{world.words.resolve(name)}"
                let map = state.binding(named)
                if map != null {
                    let held: CheckLocal = map ?? return check_core_stmt_unit()
                    let a_map = match held.ty {
                        Ty::Named { name, .. } => a_map_type(name),
                        else => false,
                    }
                    let keys = state.flow.open_keys.get(held.id)
                    if a_map && keys != null && frame[0].ty.is_unknown() {
                        frame[0].open_number = state.open_root(keys ?? 0)
                    }
                    let values = state.flow.open_elements.get(held.id)
                    if a_map && values != null && frame[1].ty.is_unknown() {
                        frame[1].open_number = state.open_root(values ?? 0)
                    }
                }
            },
            else => {},
        }
    }
    for local in frame {
        state.nameable(local.name, span, "a `for` binding")
    }
    let depth = state.scope.len() as i64
    state.repeats.push(CheckRepeats::a_loop(world.words, depth, body))
    state.scope.push(frame)
    state.flow.loops += 1
    check_core_stmt_body_discarded(state, body)
    check_core_block(state, world, host, body)
    state.flow.loops -= 1
    state.scope.pop()
    state.repeats.pop()
    return check_core_stmt_unit()
}

/// **`return`**: `Ty::Unknown`, a statement that jumps is not a value.
pub fn check_core_stmt_return[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, value: ref Expr?, span: ref Span) -> Ty sync {
    check_core_returns(state, world, host, value, span, false)
    if value != null {
        let returned = value ?? return Ty::Unknown
        state.a_narrowed_read_given_up(returned)
    }
    state.a_way_out("return", "", span)
    return Ty::Unknown
}

/// **`break` and `continue`** (Part I 3.3): `Ty::Unknown`, as a `return`.
pub fn check_core_stmt_jump(mut state: CheckState, word: ref String, span: ref Span) -> Ty sync {
    if state.flow.loops == 0 {
        state.a_jump_with_nowhere_to_go(word, span)
    }
    return Ty::Unknown
}

/// **A statement, walked**: one function per variant.
pub fn check_core_stmt[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, stmt: ref Stmt, span: ref Span) -> Ty sync {
    state.flow.literal_receivers.clear()
    return match stmt {
        Stmt::Let { names, shape, mutable, ty, value } => check_core_stmt_let(state, world, host, names, shape, mutable, ty, value, span),
        // **`comptime` is a `let` that has to fold** (ADR-287 D4, D5).
        Stmt::Comptime { name, ty, value, bounds } => check_core_comptime_binding(state, world, host, name, ty, value, bounds, span),
        Stmt::Assign { target, op, value, .. } => check_core_stmt_assign(state, world, host, target, op, value, span),
        Stmt::While { cond, body } => check_core_stmt_while(state, world, host, cond, body, span),
        Stmt::For { bindings, shape, iter, body } => check_core_stmt_for(state, world, host, bindings, shape, iter, body, span),
        Stmt::Return(value) => check_core_stmt_return(state, world, host, value, span),
        Stmt::Break => check_core_stmt_jump(state, "break", span),
        Stmt::Continue => check_core_stmt_jump(state, "continue", span),
        // **One site, not two.**
        Stmt::Expr(expr) => check_core_expr(state, world, host, expr, span),
    }
}

/// A `break` or a `continue`.
fn check_core_stmt_is_a_jump(stmt: ref Stmt) -> bool sync {
    return match stmt {
        Stmt::Break => true,
        Stmt::Continue => true,
        else => false,
    }
}

/// **A loop body's value is never used** (#596): its tail `if` or `match` is a
/// statement, and its arms are not asked for a common type.
pub fn check_core_stmt_body_discarded(mut state: CheckState, body: ref Block) sync {
    let count = body.stmts.len() as i64
    if count == 0 {
        return
    }
    match body.stmts[count - 1].node {
        Stmt::Expr(value) => {
            state.discarded.insert(id_of(value) as i64)
        },
        else => {},
    }
}

/// **Walk a block and hand back the type of its tail.**
pub fn check_core_block[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, block: ref Block) -> Ty sync {
    state.scope.push([])
    let mut tail = check_core_stmt_unit()
    let count = block.stmts.len() as i64
    let mut last = count - 1
    if last < 0 {
        last = 0
    }
    let mut at = 0
    for stmt in block.stmts {
        if at < last {
            match stmt.node {
                Stmt::Expr(value) => {
                    state.discarded.insert(id_of(value) as i64)
                },
                else => {},
            }
        }
        let ty = check_core_stmt(state, world, host, stmt.node, stmt.span)
        state.coalesces_not_lent_are_taken(world)
        // **`break i` is two statements, and that is the point**: asked of the
        // next statement's span, because that is what the author would delete.
        if at < last && check_core_stmt_is_a_jump(stmt.node) {
            state.nothing_follows_a_jump(stmt.node, block.stmts[at + 1].span)
        }
        if at == last {
            tail = ty
        }
        at += 1
    }
    check_crossings_a_bound_handle_is_taken(state, world, block)
    state.scope.pop()
    return tail
}
