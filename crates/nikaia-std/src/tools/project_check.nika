// crates/nikaia-std/src/tools/project_check.nika
//
// **What `check` says at its end**, for the compiler's `project`: the switches
// that turn a finding into a warning, the tally of a refused program, and the
// `--locked` refusals of the proofs and the ledger. Moved from Rust (ADR-294,
// #125, P2).

/// **The tally of a refused program**: one line per family of the errors in
/// `findings` (its warnings are not counted), and `violations`, the calls
/// `contracts::sync` found a `sync` function may not make, joined with `, `.
pub fn project_check_summary(findings: ref Vec[CheckFinding], violations: i64) -> String {
    let mut refused: Vec[String] = []
    // One line per family, because a family is what a reader can act on in one
    // go. The `NK1xxx` codes are types; `NK23xx` is a view kept past its call;
    // `NK25xx` is a value on the wrong thread; `NK2605` and `NK2701` are one
    // rule counted together, because they *are* one rule (ADR-025 D1) - a call
    // that can fail, written or not, in a function that does not declare
    // `throws`.

    // **`NK1207` is counted apart from the types** (ADR-269 D8): it is a
    // claim the compiler showed false with values, and the way out is the
    // program or the claim, never a type.
    let refuted = project_check_count(findings, "NK1207")
    if refuted > 0 {
        refused.push(f"{refuted} claim{project_check_plural(refuted)} shown false")
    }
    let types = project_check_count(findings, "NK1") - refuted
    if types > 0 {
        refused.push(f"{types} type error{project_check_plural(types)}")
    }
    // **`NK2503` is counted apart from the other `NK25xx` codes**
    // ([ADR-281](../../docs/specification/adr/adr-281.md) D32), for the reason
    // every split in this tally has: it must say what it counted. The others
    // are a *value* on the wrong thread; this one is a *call* that can reach a
    // lock, and the way out is keeping the lock out of its reach rather than
    // anything about the value.
    let reaching = project_check_count(findings, "NK2503")
    if reaching > 0 {
        refused.push(f"{reaching} call{project_check_plural(reaching)} that can reach a lock")
    }
    // **And `NK2504` is not a crossing at all**, which the tally said it was:
    // it is a crate nobody described, and *a value that may not cross a thread*
    // is a sentence about no part of it. Same rule as the split above — the
    // tally has to say what it counted — measured on a project whose only
    // refusal was an undescribed crate.
    let undescribed = project_check_count(findings, "NK2504")
    if undescribed > 0 {
        refused.push(f"{undescribed} Rust crate{project_check_plural(undescribed)} nothing describes")
    }
    // **And `NK2505` is a third thing again**: a crate that *is* described, by
    // a file about a version of it that is no longer there
    // ([ADR-290](../../docs/specification/adr/adr-290.md) D5). What a reader
    // does about it is neither of the two above.
    let stale = project_check_count(findings, "NK2505")
    if stale > 0 {
        refused.push(f"{stale} description{project_check_plural(stale)} of a crate that has moved")
    }
    let crossings = project_check_count(findings, "NK25") - reaching - undescribed - stale
    if crossings > 0 {
        refused.push(f"{crossings} value{project_check_plural(crossings)} that may not cross a thread")
    }
    // `NK23xx` is aliasing: who else points at the thing this one is about.
    // Counted on its own because the way out is a different one - a shape to
    // change rather than a declaration to add.
    let aliases = project_check_count(findings, "NK2302")
    if aliases > 0 {
        refused.push(f"{aliases} view{project_check_plural(aliases)} kept past the call that was given it")
    }
    // **The tether's own line** ([ADR-283](../../docs/specification/adr/adr-283.md)
    // D4). Counted apart from `NK2302` although both are `NK23xx`, because the
    // tally has to say what it counted and these are two different shapes: one
    // is a view given to a call and kept, the other a view of a buffer the body
    // made and handed back.
    // **Data changed under a view** (ADR-353 D4): the way out is an order of
    // statements, or a copy.
    let changed_under = project_check_count(findings, "NK2305")
    if changed_under > 0 {
        refused.push(f"{changed_under} change{project_check_plural(changed_under)} to data a view still to be used may point into")
    }
    let tethered = project_check_count(findings, "NK2303")
    if tethered > 0 {
        refused.push(f"{tethered} view{project_check_plural(tethered)} that would keep a buffer alive without a declaration saying so")
    }
    // **What a tether cannot be lowered to** (ADR-283), a line of its own for
    // the same reason: the way out is a shape to change, not a word to add.
    let untethered = project_check_count(findings, "NK2304")
    if untethered > 0 {
        refused.push(f"{untethered} buffer{project_check_plural(untethered)} whose views have no one place to live")
    }
    // `NK21xx` is running things at once, and its two rules want two lines: what
    // a `spawn` took with it is a value to clone, and an `overlap` whose
    // branches meet is a block to take apart. Counted apart from the line below
    // for the reason they are counted at all - the tally has to say what it
    // counted, and "a place that can fail without saying so" is neither of them.
    let moved = project_check_count(findings, "NK2101")
    if moved > 0 {
        refused.push(f"{moved} value{project_check_plural(moved)} a task took with it")
    }
    let together = project_check_count(findings, "NK2104")
    if together > 0 {
        let hole_84 = if together == 1 { "" } else { "es" }
        refused.push(f"{together} branch{hole_84} that cannot run beside the others")
    }
    // **A name a parallel lambda changes** (ADR-235 D2): the way out is a
    // `map` and a `collect`, or a lock, which is neither line above.
    let raced = project_check_count(findings, "NK2107")
    if raced > 0 {
        refused.push(f"{raced} name{project_check_plural(raced)} changed from a lambda that runs on several cores")
    }
    let tasks = project_check_count(findings, "NK21")
    // **A sequence walked twice is not a place that can fail**
    // ([ADR-105](../../docs/specification/adr/adr-105.md) D2), so it does not
    // land in the line below: the way out is a `collect()` and not a `throws`,
    // which is the same reason the two `NK21xx` rules have lines of their own.
    let walked = project_check_count(findings, "NK2702")
    if walked > 0 {
        refused.push(f"{walked} sequence{project_check_plural(walked)} walked a second time")
    }
    // **`NK2202` is counted with the other `sync` violations and not below**,
    // wherever it came from. The free call is `contracts::sync`'s and the
    // method call is the type checker's
    // ([ADR-149](../../docs/specification/adr/adr-149.md) D2), because only one
    // of the two knows what `tx.send(1)` goes to — but they are one rule, and a
    // tally that has to say what it counted must not call one of them *a place
    // that can fail without saying so*.
    let pausing = project_check_count(findings, "NK2202")
    // **A pause inside a door is the same code and another sentence**
    // ([ADR-233](../../docs/specification/adr/adr-233.md) D3): it is no `sync`
    // function's, and the way out is moving the call out of the block.
    let paused_in_a_door = findings.iter().filter(fn(f) { f.severity == CheckSeverity::Error && f.code == "NK2202" && f.message.contains("holding a lock") }).count()
    if paused_in_a_door > 0 {
        refused.push(f"{paused_in_a_door} pause{project_check_plural(paused_in_a_door)} with a lock held")
    }
    let pausing = pausing - paused_in_a_door
    // **A pause where nothing may pause** - a grammar's action, a fold, a
    // parallel lambda (ADR-296 D35, ADR-235 D2) - is not a place that can fail.
    let pauses_forbidden = project_check_count(findings, "NK2209")
    if pauses_forbidden > 0 {
        refused.push(f"{pauses_forbidden} call{project_check_plural(pauses_forbidden)} that can pause where nothing may")
    }
    // **A file read with a lock held is not a place that can fail either**
    // ([ADR-281](../../docs/specification/adr/adr-281.md) D35), and lands on the
    // same reasoning as the two above: the tally has to say what it counted,
    // and the way out here is moving the read rather than declaring anything.
    let under_a_lock = project_check_count(findings, "NK2201")
    if under_a_lock > 0 {
        refused.push(f"{under_a_lock} read{project_check_plural(under_a_lock)} of a file with a lock held")
    }
    // **A place that can fail without saying so is `NK2605` and `NK2701`**, and
    // nothing else: this line used to be the remainder, which named every rule
    // the tally had no line for - a lock taken twice, a direct write to shared
    // state - as a failure nobody declared.
    let rules = project_check_count(findings, "NK2605") + project_check_count(findings, "NK2701")
    if rules > 0 {
        refused.push(f"{rules} place{project_check_plural(rules)} that can fail without saying so")
    }
    // **The rules about locks** that are not a pause: a lock inside a lock,
    // shared state written past its door, a value read from a lock and stored
    // back, a door written by hand.
    let locks = ["NK2203", "NK2204", "NK2205", "NK2207", "NK2208"].iter().map(fn(code) { project_check_count(findings, code) }).sum()
    if locks > 0 {
        refused.push(f"{locks} mistake{project_check_plural(locks)} with a lock")
    }
    let others = findings.iter().filter(fn(f) { f.severity == CheckSeverity::Error }).count()
        - locks
        - rules
        - refuted
        - types
        - crossings
        - reaching
        - undescribed
        - stale
        - aliases
        - changed_under
        - tethered
        - untethered
        - tasks
        - walked
        - pausing
        - paused_in_a_door
        - pauses_forbidden
        - under_a_lock
    if others > 0 {
        refused.push(f"{others} other error{project_check_plural(others)}")
    }
    let may_not = violations + pausing
    if may_not > 0 {
        let hole_118 = if may_not == 1 { "" } else { "s" }
        refused.push(f"{may_not} call{hole_118} a `sync` function may not make")
    }
    return refused.join(", ")
}

/// How many errors in `findings` have a code that starts with `family`.
fn project_check_count(findings: ref Vec[CheckFinding], family: String) -> i64 {
    return findings.iter().filter(fn(f) { f.severity == CheckSeverity::Error && f.code.starts_with(family) }).count()
}

/// The `s` of a count other than one.
fn project_check_plural(n: i64) -> String {
    if n == 1 { "" } else { "s" }
}

/// **`refuted-claims = "warn"`: a claim shown false with values builds**
/// ([ADR-269](../../docs/specification/adr/adr-269.md) D8), as a warning, and
/// is checked where it is reached. The bypass for the day a better prover
/// refutes what an older one let through; without it the build stops.
pub fn project_check_let_refuted_claims_through(mut findings: Vec[CheckFinding], refuted_claims: String) {
    if refuted_claims != "warn" {
        return
    }
    for i in 0..<findings.len() {
        if findings[i].code != "NK1207" {
            continue
        }
        findings[i].severity = CheckSeverity::Warning
        findings[i].notes.push("`refuted-claims = \"warn\"` lets this build through: the claim is checked when the program runs, and stops it there")
    }
}

/// **`unproved-claims = "warn"`: a claim the compiler did not prove builds**
/// ([ADR-380](../../docs/specification/adr/adr-380.md) D2), as a warning, and
/// is checked where it is reached, as every claim was before the switch.
pub fn project_check_let_unproved_claims_through(mut findings: Vec[CheckFinding], unproved_claims: String) {
    if unproved_claims != "warn" {
        return
    }
    for i in 0..<findings.len() {
        if findings[i].code != "NK1300" {
            continue
        }
        findings[i].severity = CheckSeverity::Warning
        findings[i].notes.push("`unproved-claims = \"warn\"` lets this build through: the claim is checked when the program runs, and a false one stops it there")
    }
}

/// The `NK25xx` codes whose crossing this build does not perform, reported as a
/// lint rather than as an error.
///
/// Part III C.3 says the `Send` rules are "reported at `user_parallelism = no`
/// as a lint, so a library built there stays usable at `yes`", and the reason is
/// exact: at `no` nothing the program wrote runs concurrently (ADR-037 D2), so
/// the emitter writes no `task::both` and no task - the crossing `NK2501` is
/// about does not happen in *this* build. Refusing it would be refusing a
/// program that compiles, which is the one thing the compiler may never do; and
/// saying nothing would be ADR-005 §1 Group B's failure exactly, a library built
/// at `no` that turns out un-compilable at `yes`. A lint is the third answer, and
/// it is the one that record asked for.
///
/// **`NK2502` is not downgraded, and that is the decision.** A Rust dependency
/// may bring its own runtime (ADR-303 D7), and its threads are not the
/// program's: `user_parallelism` bounds what *you* wrote, which is ADR-037 D2's
/// load-bearing "user". So that crossing is real at both settings and so is the
/// refusal.
///
/// This is the only place a build switch meets a `NK25xx`, and it meets the
/// **severity** rather than the verdict. The verdict is a property of the
/// program and the analyses never see a switch.
pub fn project_check_lint_where_nothing_crosses(mut findings: Vec[CheckFinding], user_parallelism: String) {
    if user_parallelism != "no" {
        return
    }
    for i in 0..<findings.len() {
        if findings[i].code != "NK2501" {
            continue
        }
        findings[i].severity = CheckSeverity::Warning
        findings[i].notes.push("`user_parallelism = no` runs nothing you wrote concurrently, so this build does not perform the crossing - it is reported so that the same source still builds at `yes`")
    }
}

/// **`--locked` and a `nikaia.proofs` that would change**
/// ([ADR-270](../../docs/specification/adr/adr-270.md) D21, D22): `file` the
/// path shown, `why` what changed, `places` where the questions were asked,
/// `name` the file's name to commit.
pub fn project_check_locked_proofs(file: String, why: String, places: String, name: String) -> String {
    return f"--locked: {file} does not hold the prover's answers for these sources ({why}).{places}\nRun `nikaia build` and commit `{name}`."
}

/// **`--locked` and no ledger to compare with.**
pub fn project_check_locked_ledger_missing(path: String) -> String {
    return f"--locked, but {path} is not there; run without --locked to write it"
}

/// **`--locked` and a ledger that would change**: the determinism guarantee
/// (13.5) lets the build compare bytes, so a difference is a change in a
/// contract; `changed` is the lines it does not have (`changed_lines`).
pub fn project_check_locked_ledger_changed(path: String, changed: String) -> String {
    return f"--locked: the contracts changed and {path} does not say so.\nWhat the build inferred and the ledger does not have:\n{changed}\nRun without --locked to record it, and read the diff."
}

