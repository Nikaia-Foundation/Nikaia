// crates/nikaia-std/src/tools/check_patterns.nika
//
// **What a `match` arm's pattern binds, and to what type** - moved from the
// compiler's checker (ADR-294, #125, #558). The state holds the program's
// structs and enums; a pattern is read against them.

use std::collections

impl CheckState {
    /// **The types of the names an arm binds**, where the variant says them: a
    /// positional variant's parts in order, a variant with named fields by name.
    /// Nested patterns are typed from their part; or-patterns are left untyped,
    /// which leaves their names bound as they always were.
    pub fn pattern_parts(ref self, world: ref CheckWorld, pattern: ref MatchPattern, on: ref Ty) -> collections::BTreeMap[String, Ty] sync {
        let mut out: collections::BTreeMap[String, Ty] = collections::BTreeMap()
        // **A bare name binds the whole value** (ADR-291 D1), as it does in the
        // language below: `other => other` is of the type matched, unless the
        // name is one of the type's own variants.
        match pattern {
            MatchPattern::Path(one) => {
                if one.len() == 1 && !on.is_unknown() {
                    let word = world.words.resolve(one[0]).clone()
                    let mut a_variant = false
                    match on {
                        Ty::Named { name, .. } => {
                            a_variant = self.is_variant(name, word) || self.variant_parts.contains_key(f"{name}::{word}")
                        }
                        else => {}
                    }
                    if !a_variant && word != "_" {
                        out.insert(word, on.clone())
                        return out
                    }
                }
            }
            else => {}
        }
        // **A tuple's parts are the types at their positions** (#522):
        // `(Op::Times, n)` over an `(Op, i64)` binds `n` as the `i64`.
        match on {
            Ty::Tuple(types) => {
                match pattern {
                    MatchPattern::Tuple { path, parts } => {
                        if path.len() == 0 {
                            self.bind_positional(world, parts, types, out)
                            return out
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }
        // **A list's elements are its element type**, and a named rest is a
        // view of the remaining ones, `ref Array[T]` (ADR-355 D1, D2).
        match pattern {
            MatchPattern::List(parts) => {
                let element = pattern_list_element(on) ?? return out
                for part in parts {
                    match part {
                        MatchPattern::RestNamed(name) => {
                            out.insert(world.words.resolve(name).clone(), Ty::Named { name: "Array".clone(), args: [element.clone()], view: true })
                        }
                        MatchPattern::Rest => {}
                        else => self.bind_a_part(world, part, element, out),
                    }
                }
                return out
            }
            else => {}
        }
        let owner = match on {
            Ty::Named { name, .. } => name.clone(),
            else => return out,
        }
        match pattern {
            MatchPattern::Tuple { path, parts } => {
                if path.len() > 0 {
                    let key = self.pattern_variant(world, path, owner)
                    let mut types: Vec[Ty] = []
                    if self.variant_parts.contains_key(key) {
                        types = self.variant_parts[key]?.clone() ?? []
                    } else {
                        let fields = self.structs[key]?.clone() ?? []
                        for field in fields {
                            types.push(field.ty.clone())
                        }
                    }
                    self.bind_positional(world, parts, types, out)
                }
            }
            MatchPattern::Named { path, fields, .. } => {
                let key = self.pattern_variant(world, path, owner)
                let declared = self.structs[key]?.clone() ?? []
                for each in fields {
                    let name = world.words.resolve(each.name).clone()
                    for field in declared {
                        if field.name == name {
                            self.bind_a_part(world, each.pat, field.ty, out)
                            break
                        }
                    }
                }
            }
            else => {}
        }
        return out
    }

    /// **Positional parts against the types at their places**: those before a
    /// `..` from the front, those after it from the back (ADR-355 D3).
    fn bind_positional(ref self, world: ref CheckWorld, parts: ref Vec[MatchPattern], types: ref Vec[Ty], mut out: collections::BTreeMap[String, Ty]) sync {
        let mut rest_at = -1
        let mut at = 0
        while at < parts.len() {
            if pattern_is_rest(parts[at]) {
                rest_at = at
            }
            at = at + 1
        }
        at = 0
        while at < parts.len() {
            let mut place = at
            if rest_at >= 0 && at > rest_at {
                place = types.len() - (parts.len() - at)
            }
            if (rest_at < 0 || at != rest_at) && place >= 0 && place < types.len() {
                self.bind_a_part(world, parts[at], types[place], out)
            }
            at = at + 1
        }
    }

    /// The ledger's key of the variant a pattern names: `Owner::One` for one
    /// segment, the path as written otherwise.
    fn pattern_variant(ref self, world: ref CheckWorld, path: ref Vec[winnow_grammar::Symbol], owner: ref String) -> String sync {
        let mut written: Vec[String] = []
        for part in path {
            written.push(world.words.resolve(part).clone())
        }
        if written.len() == 1 {
            return f"{owner}::{written[0]}"
        }
        return written.join("::")
    }

    /// One part of a tuple pattern: a name binds the type at its place, and a
    /// pattern inside a pattern binds from its part's type (ADR-291 D10):
    /// `Add(Num(x), Num(y))`.
    fn bind_a_part(ref self, world: ref CheckWorld, part: ref MatchPattern, ty: ref Ty, mut out: collections::BTreeMap[String, Ty]) sync {
        match part {
            MatchPattern::Path(one) => {
                if one.len() == 1 {
                    out.insert(world.words.resolve(one[0]).clone(), ty.clone())
                }
            }
            MatchPattern::Tuple { .. } => {
                for (entry_name, entry_value) in self.pattern_parts(world, part, ty) {
                    out.insert(entry_name.clone(), entry_value.clone())
                }
            }
            MatchPattern::Named { .. } => {
                for (entry_name, entry_value) in self.pattern_parts(world, part, ty) {
                    out.insert(entry_name.clone(), entry_value.clone())
                }
            }
            MatchPattern::List(_) => {
                for (entry_name, entry_value) in self.pattern_parts(world, part, ty) {
                    out.insert(entry_name.clone(), entry_value.clone())
                }
            }
            else => {}
        }
    }
}

/// The names one pattern binds, in the order it writes them.
///
/// **Recursive, because a pattern nests**
/// ([ADR-291](../../docs/specification/adr/adr-291.md) D10): a tuple's parts
/// are patterns, so `Event::Click(Point { x, .. })` binds what the part
/// inside it binds.
///
/// **An or-pattern hands back its first alternative's names**, which is the
/// answer that is right *once `NK1155` has run*: every alternative binds the
/// same set, so any of them will do — and where they do not, the refusal is
/// the finding rather than a scope this guessed at.
pub fn pattern_names(world: ref CheckWorld, pattern: ref MatchPattern) -> Vec[String] sync {
    return match pattern {
        MatchPattern::Path(segments) => if segments.len() == 1 { [world.words.resolve(segments[0]).clone()] } else { [] },
        MatchPattern::Tuple { parts, .. } => names_of_parts(world, parts),
        MatchPattern::List(parts) => names_of_parts(world, parts),
        MatchPattern::RestNamed(name) => [world.words.resolve(name).clone()],
        MatchPattern::Named { fields, .. } => names_of_fields(world, fields),
        MatchPattern::Or(alternatives) => if alternatives.len() > 0 { pattern_names(world, alternatives[0]) } else { [] },
        else => [],
    }
}

fn names_of_parts(world: ref CheckWorld, parts: ref Vec[MatchPattern]) -> Vec[String] sync {
    let mut out: Vec[String] = []
    for part in parts {
        for name in pattern_names(world, part) {
            out.push(name)
        }
    }
    return out
}

fn names_of_fields(world: ref CheckWorld, fields: ref Vec[PatternField]) -> Vec[String] sync {
    let mut out: Vec[String] = []
    for field in fields {
        for name in pattern_names(world, field.pat) {
            out.push(name)
        }
    }
    return out
}

/// Whether a part is a rest, `..` or `..name` (ADR-355).
pub fn pattern_is_rest(part: ref MatchPattern) -> bool {
    return match part {
        MatchPattern::Rest => true,
        MatchPattern::RestNamed(_) => true,
        else => false,
    }
}

/// The element type a list pattern matches: of a `Vec[T]`, an `Array[T]` or a
/// view of either (ADR-355 D1).
pub fn pattern_list_element(on: ref Ty) -> Ty? {
    match on {
        Ty::Named { name, args, .. } => {
            if (name == "Vec" || name == "Array" || name == "List") && args.len() > 0 {
                return args[0].clone()
            }
        }
        else => {}
    }
    return null
}

impl CheckState {
    /// **A struct pattern names every field, or ends with `..`** (Part I 3.4,
    /// #732): `Point { x: px }` over a `Point` with a `y` is `NK1234`, as a
    /// literal that leaves a field out is. Nested patterns are asked too.
    pub fn a_struct_pattern_that_leaves_fields_out(ref mut self, world: ref CheckWorld, pattern: ref MatchPattern, on: ref Ty, span: ref Span) sync {
        match pattern {
            MatchPattern::Or(alternatives) => {
                for alternative in alternatives {
                    self.a_struct_pattern_that_leaves_fields_out(world, alternative, on, span)
                }
                return
            }
            else => {}
        }
        // **Inside a tuple, the part at each place**, from the front up to a
        // `..`.
        let mut types: Vec[Ty] = []
        let mut inside: bool = false
        match on {
            Ty::Tuple(parts_of) => {
                types = parts_of.clone()
                inside = true
            }
            else => {}
        }
        let owner = match on {
            Ty::Named { name, .. } => name.clone(),
            else => "".clone(),
        }
        match pattern {
            MatchPattern::Tuple { path, parts } => {
                if path.len() > 0 && owner != "" {
                    let key = self.pattern_variant(world, path, owner)
                    types = self.variant_parts[key]?.clone() ?? []
                    inside = true
                }
                if !inside {
                    return
                }
                let mut at = 0
                for part in parts {
                    if pattern_is_rest(part) || at >= types.len() {
                        return
                    }
                    self.a_struct_pattern_that_leaves_fields_out(world, part, types[at], span)
                    at = at + 1
                }
                return
            }
            else => {}
        }
        if owner == "" {
            return
        }
        match pattern {
            MatchPattern::Named { path, fields, rest } => {
                let mut written: Vec[String] = []
                for part in path {
                    written.push(world.words.resolve(part).clone())
                }
                let mut key: String = self.pattern_variant(world, path, owner)
                if written.len() == 1 && written[0] == owner {
                    key = owner.clone()
                }
                let declared = self.structs[key]?.clone() ?? []
                let mut named: Vec[String] = []
                for each in fields {
                    let name = world.words.resolve(each.name).clone()
                    named.push(name.clone())
                    for field in declared {
                        if field.name == name {
                            self.a_struct_pattern_that_leaves_fields_out(world, each.pat, field.ty, span)
                            break
                        }
                    }
                }
                if rest || declared.len() == 0 {
                    return
                }
                let mut missing: Vec[String] = []
                for field in declared {
                    if !named.contains(field.name) {
                        missing.push(f"`{field.name}`")
                    }
                }
                if missing.len() == 0 {
                    return
                }
                let shown = written.join("::")
                let mut one: String = "field".clone()
                if missing.len() > 1 {
                    one = "fields".clone()
                }
                self.findings.push(check_refusal("NK1234", span, f"This `{shown}` pattern leaves out the {one} {missing.join(", ")}.", ["A struct pattern names every field, or ends with `..` for the ones it does not name (Part I 3.4).".clone()], f"Name them, or end the pattern with `..`: `{shown} {{ …, .. }}`."))
            }
            else => {}
        }
    }
}
