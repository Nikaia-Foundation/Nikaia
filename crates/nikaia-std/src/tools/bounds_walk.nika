// crates/nikaia-std/src/tools/bounds_walk.nika
//
// **The aggressive bounds and overflow walk** (ADR-306 D4, D6, D7), moved
// from the compiler's `bounds` (ADR-294, #435 step 3): each body walked
// forward, keeping the linear facts that hold at each point - ranges, branch
// and loop conditions, the operands of `&&` and `||`, `let`s and
// assignments, the lengths a list is built or resized to - and the solver
// asked whether an index is inside its list and an operation inside its
// type. What it proves is a set of index nodes and a set of operators.
//
// **What only the compiler can do is handed in** as a callback: the solver
// (`ask`, whether facts imply a goal on a certificate the checker accepts).
// A node is named by its id (`id_of`, ADR-340), which the emitter reads again.
// A term is a place in the walk's arena (`prover_arena.nika`).

use std::text
use std::collections

/// **What the program around every body says**, read once per program.
pub struct BoundsContext {
    /// The receivers of the `len()` calls that count a `std` list, text or
    /// map, by node: only those are numbers of a proof.
    pub lengths: collections::BTreeSet[i64],
    /// Of `lengths`, those below 2^60 (#383).
    pub sized: collections::BTreeSet[i64],
    /// Every `+`, `-` and `*` whose two sides are one whole-number type, by
    /// the byte its operator starts at, with that type.
    pub arithmetic: collections::BTreeMap[i64, String],
    /// Signed values put where an unsigned type is stated, by node: each is
    /// taken without a conversion where it is proved `>= 0` (ADR-285 D32).
    pub nonnegative: collections::BTreeSet[i64],
    /// The `char`s converted to a whole number, by node: each such
    /// conversion is a code in `0..=0x10FFFF` (ADR-314 D2).
    pub char_codes: collections::BTreeSet[i64],
    /// What a callee's ledger entry ensures, by the name a call writes
    /// (ADR-314 D3).
    pub ensured: collections::BTreeMap[String, Ensured],
    /// What each element of a sequence a ledger entry hands back holds, by
    /// the entry's key (ADR-375 D5).
    pub each: collections::BTreeMap[String, Ensured],
    /// The method calls on a type `std`'s ledger describes, by node, with the
    /// type's name as the ledger keys it (ADR-314 D3, ADR-375 D5).
    pub std_receivers: collections::BTreeMap[i64, String],
    /// [`CheckFacts::simd_loads`]: a vector's load, by the called path's
    /// node, with the bytes it reads (minus the most, for a `Lanes`).
    pub simd_loads: collections::BTreeMap[i64, i64],
    /// Every shift whose count is not a literal, by the byte its operator
    /// starts at, with the shifted value's type (ADR-306 D18).
    pub shifts: collections::BTreeMap[i64, String],
    /// **What a grammar binding matched** (ADR-314 D1), for the action it
    /// stands in: a whole number's range by name (`dec[i32](digit{1,2})` is
    /// `0..=99`), and a `char`'s code by name (`digit` is `48..=57`). Empty
    /// for a function.
    pub given: collections::BTreeMap[String, Range],
    /// Every `-x` of a signed whole number, by node, with that type
    /// (ADR-314 D5).
    pub negations: collections::BTreeMap[i64, String],
    pub classes: collections::BTreeMap[String, Range],
    /// A text binding's length by name (`x:digit{1,2}` is `1..=2`), and the
    /// code of each of its characters (`48..=57`).
    pub text_lengths: collections::BTreeMap[String, Range],
    pub text_classes: collections::BTreeMap[String, Range],
    pub around: Around,
    /// **The field reads of a whole-number type**, by node (ADR-306 D17):
    /// a path of fields from a name, `p.end`, is a number of the walk.
    pub whole_fields: collections::BTreeSet[i64],
    /// **The length an `Array[T, N]`'s type says**, by the node of the
    /// array read or counted: `len()` is `N` (#711).
    pub array_lengths: collections::BTreeMap[i64, i64],
    /// **`prove-through-loops:on`** (ADR-361 D10): a check a loop leaves
    /// open is asked once more through the loop's invariant.
    pub through_loops: bool,
}

/// **What a callee's ledger entry ensures** (ADR-314 D3): each condition read
/// back over its parameters and `result`, for the walk to assume of a call.
pub struct Ensured {
    pub params: Vec[String],
    /// Of `params`, those that are `char`s: each is handed the argument's
    /// code (D2).
    pub chars: Vec[bool],
    /// The options it takes by name, each with its default as the ledger
    /// writes it (`ensures_each`, ADR-375 D5).
    pub options: Vec[(String, String)],
    pub conditions: Vec[Vec[SolverTerm]],
}

/// What the walk proved: index nodes (the `id_of` of the indexed `base`) and
/// arithmetic operators (by the byte their operator starts at).
pub struct BoundsProven {
    pub indices: collections::BTreeSet[i64],
    pub arithmetic: collections::BTreeSet[i64],
    /// Of the context's `nonnegative`, those proved `>= 0` where they stand.
    pub nonnegative: collections::BTreeSet[i64],
    /// Of the context's `negations`, those proved not to negate the type's
    /// least value.
    pub negations: collections::BTreeSet[i64],
    /// **The invariants that carried a check through a loop** (ADR-361 D4,
    /// D10), by the byte the loop starts at: its parts as `nikaia.proofs`
    /// keeps them, each with the strategy that found it.
    pub loops: collections::BTreeMap[i64, String],
}

/// What holds at one point of a body.
struct BoundsFacts {
    /// Names that are whole numbers here.
    ints: collections::BTreeSet[String],
    facts: Vec[i64],
}

/// The names whose value, and the lists whose length, a block may change.
struct BoundsChanged {
    values: collections::BTreeSet[String],
    lengths: collections::BTreeSet[String],
    /// Values whose paths of fields may change (ADR-306 D17), their own
    /// length aside: the receivers of methods that may change them.
    parts: collections::BTreeSet[String],
    /// Of `values`, those changed otherwise than by adding to them: by a
    /// call, or by an assignment of another shape (#711).
    jumps: collections::BTreeSet[String],
}

struct BoundsWalk {
    arena: TermArena,
    proven: BoundsProven,
    /// **What every length the walk read of a container whose elements take
    /// space is**, by the length's name: `0 <= len(x) <= 2^60` (#383). A fact
    /// of every list, so it holds whatever the program did to it, and every
    /// proof is handed it.
    axioms: collections::BTreeMap[String, Vec[i64]],
    /// Names a length was read of where the elements may take no space: a
    /// name read both ways - one `xs` shadowing another - gets no axiom.
    unsized_names: collections::BTreeSet[String],
    /// **`0 <= len(x)` for those** (#439): a length is never negative, however
    /// little its elements take - only the upper bound depends on memory.
    floors: collections::BTreeMap[String, i64],
    /// Names a lambda, a task or an `overlap` branch changes: they may change
    /// whenever one runs, so no fact is kept about them anywhere.
    pinned: collections::BTreeSet[String],
    /// Whole numbers that are never negative anywhere in the body.
    nonnegative: collections::BTreeSet[String],
    /// How many `char` codes the walk has read: each reading is a number of
    /// its own (ADR-314 D2).
    codes: i64,
    /// The binding of a `for d in x.chars()` over a text binding, with the
    /// code of `x`'s characters (ADR-314 D1).
    loop_classes: collections::BTreeMap[String, Range],
    /// What the body is, read once before any pass.
    shape: BodyShape,
    /// The bounds on lists' values this pass may read (ADR-306 D7), by key:
    /// a list's name for its values, `name[]` for the values of the lists it
    /// holds.
    assumed: collections::BTreeMap[String, Range],
    /// The join of what this pass saw written, by key.
    written: collections::BTreeMap[String, Range],
    /// Keys a write this pass put something unbounded in.
    poisoned: collections::BTreeSet[String],
    /// A pass that only finds bounds and proves nothing.
    collecting: bool,
    /// The first byte of the statement being walked: the key a compound
    /// assignment's operation is recorded by (#387).
    at: i64,
    /// **The counters the loops being walked take to only grow** (#711):
    /// each is at least what it was when its loop began, while every
    /// assignment to it adds what is proved not negative.
    growing: collections::BTreeSet[String],
    /// Of `growing`, those an assignment was not proved to grow: a loop that
    /// took one is walked again without it.
    grow_failed: collections::BTreeSet[String],
    /// How many values at a loop's start the walk has named.
    entries: i64,
    /// **How many goals the walk has left open** (ADR-361 D2): a loop that
    /// left none is not asked through its invariant.
    open: i64,
    /// **The names a goal left open read**, each with the open count when it
    /// last did: a loop is asked through its invariant only where one of
    /// them is a name it changes.
    missed: collections::BTreeMap[String, i64],
    /// The newest goals left open, for that test.
    missed_goals: Vec[BoundsMissed],
    /// `prove-through-loops:on`: the walk keeps `open` and `missed`.
    through_loops: bool,
    /// **The loops whose invariant is being checked**, innermost last
    /// (ADR-361 D4): what a turn's end, a `continue` or a `break` must keep.
    turns: Vec[BoundsTurn],
    /// **The candidates a `break` need not keep** (ADR-361 D4): `!c` of a
    /// guard `if c { break }`, which holds at each turn's head and not where
    /// the loop is left, so nothing past the loop reads it.
    leaving: collections::BTreeSet[i64],
}

/// **A loop's candidate invariant, while its body is walked** (ADR-361 D4):
/// the guesses assumed at the head of a turn, those an end of a turn or a
/// `break` did not keep, and where those ends were checked.
struct BoundsTurn {
    guesses: Vec[i64],
    failed: collections::BTreeSet[i64],
    jumps: collections::BTreeSet[i64],
}

/// No length of a container whose elements take space reaches this (#383):
/// each element takes a byte, and no target this compiler builds for
/// addresses more than 2^57 bytes. One number for every target, with a margin
/// of 8 (ADR-037 D1).
fn length_below() -> i64 {
    return 1152921504606846976
}

/// The widest bound a proof of a whole number states (#444): `2^62`, far
/// enough from `i64`'s ends that the solver, which counts in `i64`, can
/// combine it with a length's bound without overflowing.
fn solvable() -> i64 {
    return 4611686018427387904
}

/// How many facts a point keeps: the newest, so that a long body costs the
/// solver what a short one does.
fn most_facts() -> i64 {
    return 48
}

/// How deep a call to an expression function is followed into another: far
/// enough for a helper over a helper, and a recursion stops.
fn call_depth() -> i64 {
    return 4
}

fn no_proofs() -> BoundsProven {
    return BoundsProven { indices: collections::BTreeSet(), arithmetic: collections::BTreeSet(), nonnegative: collections::BTreeSet(), negations: collections::BTreeSet(), loops: collections::BTreeMap() }
}

fn nothing_changed() -> BoundsChanged {
    return BoundsChanged { values: collections::BTreeSet(), lengths: collections::BTreeSet(), parts: collections::BTreeSet(), jumps: collections::BTreeSet() }
}

/// **Every index and every operation the walk proves in one body**, a
/// function whose parameters are `args`; `nonnegative` are its whole numbers
/// that are never negative anywhere.
///
/// **A bound on a list's values is an invariant, found and then checked**
/// (ADR-306 D7): each pass reads the bounds the last one found, and the last
/// pass keeps only those every write is proved to stay within, assuming all
/// of them. Reads before the writes they depend on, and writes that depend on
/// each other, are why one pass is not enough; a bound that only holds by
/// assuming itself larger is dropped. The passes that only collect prove
/// nothing. The pass that checks proves too, and when it keeps every bound it
/// assumed, what it proved stands.
pub fn bounds_aggressive(args: ref Vec[FnArg], body: ref Block, nonnegative: collections::BTreeSet[String], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> BoundsProven {
    let pinned = pinned_in(body, words)
    let mut shape = shape_of(args, body, pinned, context.around, words)
    // **A `comptime` of the module, written as a number**, is that number
    // wherever the body does not bind its name again.
    for item in program.items {
        match item.node {
            Item::Comptime { name, ty, value, .. } => {
                let text = words.resolve(name)
                let whole = bounding_declared_whole(ty, words) ?? true
                let n = match value {
                    Expr::LitInt { value: digits, negative, .. } => integer_as_count(integer(digits, negative)),
                    else => null,
                }
                if whole && n != null && !shape.bound.contains(text) && !shape.constants.contains_key(text) {
                    shape.constants.insert(text.clone(), n ?? 0)
                }
            },
            else => {},
        }
    }
    let mut walk = BoundsWalk {
        arena: TermArena::empty(),
        proven: no_proofs(),
        axioms: collections::BTreeMap(),
        unsized_names: collections::BTreeSet(),
        floors: collections::BTreeMap(),
        pinned: pinned,
        nonnegative: nonnegative,
        codes: 0,
        loop_classes: collections::BTreeMap(),
        shape: shape,
        assumed: collections::BTreeMap(),
        written: collections::BTreeMap(),
        poisoned: collections::BTreeSet(),
        collecting: false,
        at: 0,
        growing: collections::BTreeSet(),
        grow_failed: collections::BTreeSet(),
        entries: 0,
        open: 0,
        missed: collections::BTreeMap(),
        missed_goals: [],
        through_loops: context.through_loops,
        turns: [],
        leaving: collections::BTreeSet(),
    }
    let mut settled = false
    if !walk.shape.roots.is_empty() {
        walk.collecting = true
        for _round in 0..<2 {
            bounding_pass(walk, args, body, context, program, words, ask)
            walk.assumed = bounding_found(walk)
        }
        walk.collecting = false
        for _round in 0..<4 {
            walk.proven = no_proofs()
            bounding_pass(walk, args, body, context, program, words, ask)
            let found = bounding_found(walk)
            let before = walk.assumed.len()
            let mut kept: collections::BTreeMap[String, Range] = collections::BTreeMap()
            for (key, bound) in walk.assumed {
                let seen = found.get(key) ?? continue
                if bound.holds(seen) {
                    kept.insert(key.clone(), bound.clone())
                }
            }
            walk.assumed = kept
            if walk.assumed.len() == before {
                settled = true
                break
            }
        }
    }
    if !settled {
        if !walk.shape.roots.is_empty() {
            walk.assumed = collections::BTreeMap()
        }
        walk.proven = no_proofs()
        bounding_pass(walk, args, body, context, program, words, ask)
    }
    return walk.proven
}

/// One pass over the body: proofs into `proven`, what is written into
/// `written`.
fn bounding_pass(mut walk: BoundsWalk, args: ref Vec[FnArg], body: ref Block, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    walk.written = collections::BTreeMap()
    walk.poisoned = collections::BTreeSet()
    let mut facts = BoundsFacts { ints: collections::BTreeSet(), facts: [] }
    for arg in args {
        let name = words.resolve(arg.name).clone()
        let ty = words.resolve(arg.ty.name).clone()
        if arg.ty.generics.is_empty() && is_whole_number(ty) {
            facts.ints.insert(name.clone())
            if ty.starts_with("u") {
                bounding_at_least_zero(walk, facts, name)
            }
        }
        if ty == "Vec" || ty == "List" || ty == "Array" {
            bounding_at_least_zero(walk, facts, length_of(name))
        }
    }
    // **A grammar binding** (ADR-314 D1): a number within what it matched,
    // unless the action binds the name again.
    for (name, range) in context.given {
        if !walk.shape.bound.contains(name) {
            facts.ints.insert(name.clone())
            bounding_bounded(walk, facts, name, range)
        }
    }
    // A text binding's length, which nothing changes.
    for (name, range) in context.text_lengths {
        if !walk.shape.bound.contains(name) {
            bounding_bounded(walk, facts, length_of(name), range)
        }
    }
    bounding_block(walk, body, facts, context, program, words, ask)
}

/// The bounds this pass found: every key written, none written something
/// unbounded.
fn bounding_found(walk: ref BoundsWalk) -> collections::BTreeMap[String, Range] {
    let mut out: collections::BTreeMap[String, Range] = collections::BTreeMap()
    for (key, bound) in walk.written {
        if bound.is_bounded() && !bounding_poisoned(walk, key) {
            out.insert(key.clone(), bound.clone())
        }
    }
    return out
}

/// A key is out where it, or a list it is part of, was written something
/// unbounded: `xs.push(ys)` with `ys` unknown says nothing of `xs[]`.
fn bounding_poisoned(walk: ref BoundsWalk, key: ref String) -> bool {
    let mut at = key_root(key)
    let parts: Vec[ref String] = key.split("[").collect()
    for _part in 0..<parts.len() {
        if walk.poisoned.contains(at) {
            return true
        }
        at.push_str("[]")
    }
    return false
}

/// The bound assumed of `key`'s values, where there is one.
fn bounding_assumed(walk: ref BoundsWalk, key: ref String) -> Range? {
    let bound = walk.assumed.get(key) ?? return null
    return bound.clone()
}

/// **`value` is written into the list whose elements are `key`** (ADR-306
/// D7): a number joins the key's bound, a list's items join `key[]`'s, a
/// list the walk knows joins its bound into `key[]`.
fn bounding_write(mut walk: BoundsWalk, key: ref String, value: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if !tracks(walk.shape, key) {
        return
    }
    let inner = f"{key}[]"
    match value {
        Expr::ListLit { items, .. } => {
            for item in items {
                bounding_write(walk, inner, item, facts, context, program, words, ask)
            }
            return
        },
        Expr::ListRepeat { value: item, .. } => {
            bounding_write(walk, inner, item, facts, context, program, words, ask)
            return
        },
        else => {},
    }
    let range = bounding_range(walk, value, facts, context, program, words, ask)
    if range != null {
        bounding_join(walk, key, range ?? Range::open())
        return
    }
    let elements = elements_key(walk.shape, value, words)
    if elements != null {
        let bound = bounding_assumed(walk, elements ?? "")
        if bound != null {
            bounding_join(walk, inner, bound ?? Range::open())
        } else {
            walk.poisoned.insert(inner)
        }
        return
    }
    walk.poisoned.insert(key.clone())
}

fn bounding_join(mut walk: BoundsWalk, key: ref String, range: Range) {
    if !range.is_bounded() {
        walk.poisoned.insert(key.clone())
        return
    }
    let mut joined = range
    let was = walk.written.get(key)
    if was != null {
        joined = (was ?? Range::open()).join(range)
    }
    walk.written.insert(key.clone(), joined)
}

/// **A goal's question** (an index, an operation, a conversion): as
/// [`bounding_proves`], and where it is left open, the names it reads are
/// what the walk missed (ADR-361 D2), stamped with the open count.
fn bounding_proves_goal(mut walk: BoundsWalk, facts: ref BoundsFacts, goal: i64, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    if bounding_proves(walk, facts, goal, ask) {
        return true
    }
    if walk.through_loops {
        walk.open += 1
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(goal, read)
        for name in read {
            walk.missed.insert(name.clone(), walk.open)
        }
        walk.missed_goals.push(BoundsMissed { stamp: walk.open, goal: goal, facts: facts.facts.clone() })
        if walk.missed_goals.len() > 64 {
            walk.missed_goals.remove(0)
        }
    }
    return false
}

/// **A goal left open**, with what held where it was asked: the cheap test
/// of whether a loop's candidates could prove anything (ADR-361 D2).
struct BoundsMissed {
    stamp: i64,
    goal: i64,
    facts: Vec[i64],
}

/// Whether `goal` follows from what holds, on a certificate the checker
/// accepts.
fn bounding_proves(walk: ref BoundsWalk, facts: ref BoundsFacts, goal: i64, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let mut all = facts.facts.clone()
    for (name, axiom) in walk.axioms {
        if !walk.unsized_names.contains(name) {
            for fact in axiom {
                all.push(fact)
            }
        }
    }
    for (name, floor) in walk.floors {
        if walk.unsized_names.contains(name) {
            all.push(floor)
        }
    }
    return ask(walk.arena, all, goal)
}

/// **What is known of a linear term, as constants**: a candidate from
/// interval propagation over the facts, as Wuffs bounds a value, each end
/// then confirmed by the solver on a certificate the checker accepts. An end
/// the solver does not confirm is open.
fn bounding_term(mut walk: BoundsWalk, term: i64, facts: ref BoundsFacts, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> Range {
    let known = walk.arena.constant(term)
    if known != null {
        return Range::exactly(known ?? 0)
    }
    let guess = candidate(term, facts.facts, fn(at) { walk.arena.at(at) })
    let mut confirmed = Range::open()
    if guess.hi != null {
        let hi = guess.hi ?? 0
        let k = walk.arena.int(hi)
        let goal = walk.arena.le(term, k)
        if bounding_proves(walk, facts, goal, ask) {
            confirmed.hi = hi
        }
    }
    if guess.lo != null {
        let lo = guess.lo ?? 0
        let k = walk.arena.int(lo)
        let goal = walk.arena.ge(term, k)
        if bounding_proves(walk, facts, goal, ask) {
            confirmed.lo = lo
        }
    }
    return confirmed
}

/// **The constants a whole number lies between**, where the walk can tell:
/// a linear term by the solver, and around it `%` (ADR-306 D8), `>>`, `&`, a
/// conversion, a truncation, and a value read out of a list whose values are
/// bounded (D2). Nothing is "not a number the walk knows", which is also
/// what anything else is.
fn bounding_range(mut walk: BoundsWalk, expr: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> Range? {
    let term = bounding_lin(walk, expr, facts, context, program, words)
    if term != null {
        return bounding_term(walk, term ?? 0, facts, ask)
    }
    match expr {
        Expr::Binary { op, lhs, rhs, span, .. } => return bounding_range_of(walk, op, lhs, rhs, span.start as i64, facts, context, program, words, ask),
        Expr::Unary { op, expr, .. } => {
            match op {
                UnaryOp::Neg => {
                    let inner = bounding_range(walk, expr, facts, context, program, words, ask) ?? return null
                    return inner.neg()
                },
                else => {},
            }
        },
        // A conversion keeps its value or stops the program.
        Expr::Cast { expr, ty, .. } => {
            if ty.generics.is_empty() {
                let into = Range::held_by_type(words.resolve(ty.name)) ?? return null
                let got = bounding_range(walk, expr, facts, context, program, words, ask) ?? return into
                return got.meet(into)
            }
        },
        Expr::MethodCall { receiver, method, args, .. } => {
            if args.is_empty() {
                let name = words.resolve(method)
                if name == "len" {
                    return Range { lo: 0, hi: null }
                }
                // `bits_as_` too (ADR-285 D42): a value the destination holds
                // keeps it, any other is somewhere in the destination's range.
                let mut dropped = 11
                if name.starts_with("bits_as_") {
                    dropped = 8
                } else if !name.starts_with("truncating_") {
                    return null
                }
                let into = Range::held_by_type(bounding_dropped(name, dropped)) ?? return null
                let got = bounding_range(walk, receiver, facts, context, program, words, ask) ?? return into
                if into.holds(got) {
                    return got
                }
                return into
            }
        },
        Expr::Index { base, .. } => {
            let key = elements_key(walk.shape, base, words) ?? return null
            return bounding_assumed(walk, key)
        },
        else => {},
    }
    return null
}

/// `text` without its first `count` characters.
fn bounding_dropped(text: ref String, count: i64) -> String {
    let c: Vec[scalar] = text.chars().collect()
    let mut out: String = ""
    for k in count..<c.len() {
        out.push(c[k])
    }
    return out
}

/// `lhs op rhs`, where it is not a linear term.
fn bounding_range_of(mut walk: BoundsWalk, op: ref BinaryOp, lhs: ref Expr, rhs: ref Expr, at: i64, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> Range? {
    match op {
        BinaryOp::Add => {
            let a = bounding_range(walk, lhs, facts, context, program, words, ask) ?? return null
            let b = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
            return a.add(b)
        },
        BinaryOp::Sub => {
            let a = bounding_range(walk, lhs, facts, context, program, words, ask) ?? return null
            let b = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
            return a.add(b.neg())
        },
        BinaryOp::Mul => {
            let a = bounding_range(walk, lhs, facts, context, program, words, ask) ?? return null
            let b = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
            return a.mul(b)
        },
        // **`0 <= x % n < n`** where `x` is not negative and `n` is
        // positive; `|x % n| < n` where only `n` is known.
        BinaryOp::Rem => {
            let n = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
            let low = n.lo ?? return null
            let high = n.hi ?? return null
            if low < 1 {
                return null
            }
            let x = bounding_range(walk, lhs, facts, context, program, words, ask)
            return bounding_remainder(x, high)
        },
        BinaryOp::Shr => {
            let by = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
            let k = by.lo ?? return null
            let same = by.hi ?? return null
            if k != same || k < 0 || k >= 64 {
                return null
            }
            // **An unsigned value shifted right by `k` is below `2^(w - k)`**
            // for its type's width `w`, whatever the walk knows of it.
            let mut widest: Range? = null
            let ty = context.shifts[at] ?? ""
            let width = bounding_bits(ty) ?? 0
            if ty.starts_with("u") && width > 0 && k >= 1 && k < width {
                let most = (1 << (width - k).min(62)) - 1
                widest = Range { lo: 0, hi: most }
            }
            let known = bounding_range(walk, lhs, facts, context, program, words, ask)
            let x = known ?? return widest
            let lo = x.lo ?? return widest
            if lo < 0 {
                return widest
            }
            let mut shifted = Range { lo: lo >> k, hi: (widest ?? Range { lo: 0, hi: null }).hi }
            if x.hi != null {
                shifted.hi = (x.hi ?? 0) >> k
            }
            return shifted
        },
        BinaryOp::BitAnd => {
            let mut mask: i64? = null
            let first = bounding_mask(walk, lhs, facts, context, program, words)
            if first != null {
                mask = first
            }
            let second = bounding_mask(walk, rhs, facts, context, program, words)
            if second != null {
                mask = second
            }
            let most = mask ?? return null
            return Range { lo: 0, hi: most }
        },
        else => {},
    }
    return null
}

/// `x % n` for an `n` of at most `high`.
fn bounding_remainder(x: ref Range?, high: i64) -> Range {
    let either = Range { lo: 1 - high, hi: high - 1 }
    let known = x ?? return either
    let lo = known.lo ?? return either
    if lo < 0 {
        return either
    }
    let hi = known.hi ?? return Range { lo: 0, hi: high - 1 }
    return Range { lo: 0, hi: hi.min(high - 1) }
}

/// A side of `&` that is a constant not below zero: the mask.
fn bounding_mask(mut walk: BoundsWalk, side: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    let term = bounding_lin(walk, side, facts, context, program, words) ?? return null
    let c = walk.arena.constant(term) ?? return null
    if c >= 0 {
        return c
    }
    return null
}

/// Whether `lhs op rhs`, an operation of type `ty`, stays inside it.
///
/// **A goal the solver can state** (#444): the solver counts in `i64` and
/// refuses on overflow, so `term <= i64::MAX` - negated, `term >= 2^63` - was
/// never decided. Inside `±2^62` is inside the type, and leaves the solver
/// room to add facts as large as a length without overflowing; a value it
/// does not cover keeps its check.
fn bounding_fits(mut walk: BoundsWalk, op: ref BinaryOp, lhs: ref Expr, rhs: ref Expr, ty: ref String, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let bounds = Range::of_type(ty) ?? return false
    let widest_lo = bounds.lo ?? return false
    let widest_hi = bounds.hi ?? return false
    let lo = widest_lo.max(0 - solvable())
    let hi = widest_hi.min(solvable())
    let term = bounding_lin_of(walk, op, lhs, rhs, facts, context, program, words)
    if term != null {
        let t = term ?? 0
        let low = walk.arena.int(lo)
        let high = walk.arena.int(hi)
        let above = walk.arena.ge(t, low)
        let below = walk.arena.le(t, high)
        // **A constant that is not negative moves a value of the type one way
        // only** (ADR-306 D6): `i + k` cannot leave below, nor `i - k` above,
        // so the bound on that side is not asked.
        let side = bounding_one_way(op, lhs, rhs)
        let mut goal = walk.arena.and([above, below])
        if side > 0 {
            goal = below
        } else if side < 0 {
            goal = above
        }
        return bounding_proves_goal(walk, facts, goal, ask)
    }
    // **A side the walk only bounds** (#714): `l + x` with `a <= x <= b`
    // lies between `l + a` and `l + b`, linear goals the solver can state.
    let adds = match op {
        BinaryOp::Add => true,
        else => false,
    }
    let subtracts = match op {
        BinaryOp::Sub => true,
        else => false,
    }
    if (adds || subtracts) && bounding_mixed_fits(walk, lhs, rhs, subtracts, lo, hi, facts, context, program, words, ask) {
        return true
    }
    if adds && bounding_mixed_fits(walk, rhs, lhs, false, lo, hi, facts, context, program, words, ask) {
        return true
    }
    let range = bounding_range_of(walk, op, lhs, rhs, -1, facts, context, program, words, ask) ?? return false
    return bounds.holds(range)
}

/// `linear + ranged` (or `linear - ranged` where `subtracts`) inside `lo..=hi`:
/// `linear` a term of the solver, `ranged` a value between two constants.
fn bounding_mixed_fits(mut walk: BoundsWalk, linear: ref Expr, ranged: ref Expr, subtracts: bool, lo: i64, hi: i64, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let l = bounding_lin(walk, linear, facts, context, program, words) ?? return false
    let r = bounding_range(walk, ranged, facts, context, program, words, ask) ?? return false
    let a = r.lo ?? return false
    let b = r.hi ?? return false
    let mut least = a
    let mut most = b
    if subtracts {
        least = 0 - b
        most = 0 - a
    }
    let least_term = walk.arena.int(least)
    let most_term = walk.arena.int(most)
    let low = walk.arena.add(l, least_term)
    let high = walk.arena.add(l, most_term)
    let floor = walk.arena.int(lo)
    let ceiling = walk.arena.int(hi)
    let above = walk.arena.ge(low, floor)
    let below = walk.arena.le(high, ceiling)
    let goal = walk.arena.and([above, below])
    return bounding_proves_goal(walk, facts, goal, ask)
}

/// **A shift's count lies in `0..<w`** (ADR-306 D18), `w` the width of the
/// shifted value's type `ty`.
fn bounding_count_fits(mut walk: BoundsWalk, count: ref Expr, ty: ref String, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let width = bounding_bits(ty) ?? return false
    let term = bounding_lin(walk, count, facts, context, program, words)
    if term != null {
        let k = term ?? 0
        let zero = walk.arena.int(0)
        let most = walk.arena.int(width - 1)
        let above = walk.arena.ge(k, zero)
        let below = walk.arena.le(k, most)
        let goal = walk.arena.and([above, below])
        return bounding_proves_goal(walk, facts, goal, ask)
    }
    let range = bounding_range(walk, count, facts, context, program, words, ask) ?? return false
    let lo = range.lo ?? return false
    let hi = range.hi ?? return false
    return lo >= 0 && hi < width
}

/// A whole-number literal.
fn bounding_literal(expr: ref Expr) -> bool {
    return match expr {
        Expr::LitInt { .. } => true,
        else => false,
    }
}

/// How many bits a whole-number type has.
fn bounding_bits(ty: ref String) -> i64? {
    return match ty {
        "i8" => 8, "u8" => 8, "i16" => 16, "u16" => 16, "i32" => 32, "u32" => 32,
        "i64" => 64, "u64" => 64, "int" => 64, "isize" => 64, "usize" => 64,
        "i128" => 128, "u128" => 128,
        else => null,
    }
}

/// Which way an operation with a constant that is not negative moves the
/// other side: `1` up (`x + k`, `k + x`), `-1` down (`x - k`), `0` either.
fn bounding_one_way(op: ref BinaryOp, lhs: ref Expr, rhs: ref Expr) -> i64 {
    match op {
        BinaryOp::Add => {
            if bounding_a_count(rhs) || bounding_a_count(lhs) {
                return 1
            }
        },
        BinaryOp::Sub => {
            if bounding_a_count(rhs) {
                return -1
            }
        },
        else => {},
    }
    return 0
}

/// A literal whole number that is not negative.
fn bounding_a_count(expr: ref Expr) -> bool {
    return match expr {
        Expr::LitInt { negative, .. } => !negative,
        else => false,
    }
}

/// `name` lies within `range`, where it is a whole number.
///
/// **A bound past `±2^62` is not stated** (#444): the solver counts in `i64`
/// and refuses a query whose sums overflow, so `c >= -2^63` beside the facts
/// that matter would leave every later index unproved, and a bound that wide
/// says nothing an `i64` does not. Leaving it out only weakens what is known.
fn bounding_bounded(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, range: ref Range) {
    let n = walk.arena.var(name)
    if range.lo != null && (range.lo ?? 0) >= 0 - solvable() {
        let lo = walk.arena.int(range.lo ?? 0)
        let fact = walk.arena.ge(n, lo)
        bounding_push(walk, facts, fact)
    }
    if range.hi != null && (range.hi ?? 0) <= solvable() {
        let hi = walk.arena.int(range.hi ?? 0)
        let fact = walk.arena.le(n, hi)
        bounding_push(walk, facts, fact)
    }
}

fn bounding_push(walk: ref BoundsWalk, mut facts: BoundsFacts, fact: i64) {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    walk.arena.variables(fact, read)
    for name in read {
        if walk.pinned.contains(path_root(name)) {
            return
        }
    }
    facts.facts.push(fact)
    if facts.facts.len() > most_facts() {
        facts.facts.remove(0)
    }
}

fn bounding_at_least_zero(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String) {
    let n = walk.arena.var(name)
    let zero = walk.arena.int(0)
    let fact = walk.arena.ge(n, zero)
    bounding_push(walk, facts, fact)
}

/// Nothing known about `name`, its length or a path of fields from it
/// (ADR-306 D17) holds any more.
fn bounding_forget(walk: ref BoundsWalk, mut facts: BoundsFacts, name: ref String) {
    let mut kept: Vec[i64] = []
    for fact in facts.facts {
        if !bounding_touches(walk, fact, name) {
            kept.push(fact)
        }
    }
    facts.facts = kept
}

/// Whether `term` reads `name`, its length or a path of fields from it.
fn bounding_touches(walk: ref BoundsWalk, term: i64, name: ref String) -> bool {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    walk.arena.variables(term, read)
    for v in read {
        if path_within(v, name) {
            return true
        }
    }
    return false
}

/// What is known of the paths of fields from `name` (ADR-306 D17) holds no
/// more, its own length aside: a method changed the value they are part of.
fn bounding_forget_parts(walk: ref BoundsWalk, mut facts: BoundsFacts, name: ref String) {
    let length = length_of(name)
    let under = f"{name}."
    let mut kept: Vec[i64] = []
    for fact in facts.facts {
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(fact, read)
        let mut touched = false
        for v in read {
            if v.starts_with(under) && v != length {
                touched = true
            }
        }
        if !touched {
            kept.push(fact)
        }
    }
    facts.facts = kept
}

fn bounding_forget_length(walk: ref BoundsWalk, mut facts: BoundsFacts, name: ref String) {
    let length = length_of(name)
    let mut kept: Vec[i64] = []
    for fact in facts.facts {
        if !walk.arena.mentions(fact, length) {
            kept.push(fact)
        }
    }
    facts.facts = kept
}

/// Every fact `name` reads, rewritten for `name` now being `old + by`: what
/// held of the old value holds of `name - by`.
fn bounding_shift(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, by: i64) {
    let now = walk.arena.var(name)
    let old = walk.arena.sub(now, by)
    let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
    given.insert(name.clone(), old)
    for k in 0..<facts.facts.len() {
        let fact = facts.facts[k]
        if walk.arena.mentions(fact, name) {
            facts.facts[k] = walk.arena.substitute(fact, given)
        }
    }
}

/// What holds again after a loop's body or a branch changed `changed`: a
/// name that is never negative still is not.
fn bounding_after_change(mut walk: BoundsWalk, mut facts: BoundsFacts, changed: ref BoundsChanged) {
    for name in changed.values {
        bounding_forget(walk, facts, name)
        if (walk.nonnegative.contains(name) || walk.shape.unsigned.contains(name)) && facts.ints.contains(name) {
            bounding_at_least_zero(walk, facts, name)
        }
    }
    for name in changed.lengths {
        bounding_forget_length(walk, facts, name)
    }
    for name in changed.parts {
        bounding_forget_parts(walk, facts, name)
    }
}

/// **`expr` as a linear term**, where it is one.
fn bounding_lin(mut walk: BoundsWalk, expr: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    match expr {
        Expr::LitInt { value, negative, .. } => {
            let n = integer_as_count(integer(value, negative)) ?? return null
            return walk.arena.int(n)
        },
        Expr::Variable(name, _) => {
            let text = words.resolve(name)
            if walk.shape.constants.contains_key(text) {
                let n = walk.shape.constants[text] ?? 0
                return walk.arena.int(n)
            }
            if facts.ints.contains(text) {
                return walk.arena.var(text)
            }
        },
        Expr::MethodCall { receiver, method, args, .. } => {
            if args.is_empty() && words.resolve(method) == "len" {
                let path = path_of(receiver, words) ?? return null
                return bounding_length(walk, receiver, path, context)
            }
            // **What `std`'s ledger ensures of a method's result** (ADR-314
            // D3): `x.trailing_zeros()` of a `u64` is in `0..=64`.
            let ty = context.std_receivers[node_key(expr)] ?? return null
            let ensured = context.ensured[f"{ty}::{words.resolve(method)}"] ?? return null
            return bounding_ensured(walk, ensured, args, facts, context, program, words)
        },
        // **A path of fields from a name** (ADR-306 D17), of a whole-number
        // type: a number of its own, `p.end`.
        Expr::Field { .. } => {
            if context.whole_fields.contains(node_key(expr)) {
                let path = path_of(expr, words) ?? return null
                return walk.arena.var(path)
            }
        },
        Expr::Unary { op, expr, .. } => {
            match op {
                UnaryOp::Neg => {
                    let a = bounding_lin(walk, expr, facts, context, program, words) ?? return null
                    return walk.arena.neg(a)
                },
                else => {},
            }
        },
        // **A conversion keeps the value or stops the program** (Part III
        // A.2: one that does not fit is checked at every build), so where the
        // program goes on, the number is the one converted.
        Expr::Cast { expr, ty, .. } => {
            if ty.generics.is_empty() && is_whole_number(words.resolve(ty.name)) {
                if context.char_codes.contains(node_key(expr)) {
                    return bounding_code_of(walk, expr, context, words)
                }
                return bounding_lin(walk, expr, facts, context, program, words)
            }
        },
        Expr::Call { func, args, config, .. } => {
            if config.is_empty() {
                let callee = bounding_callee(func, words) ?? return null
                let mut given: Vec[i64] = []
                let mut every = true
                for arg in args {
                    let term = bounding_lin(walk, arg, facts, context, program, words)
                    if term == null {
                        every = false
                    } else {
                        given.push(term ?? 0)
                    }
                }
                if every {
                    let inlined = bounding_called(walk, callee, given, 0, program, words)
                    if inlined != null {
                        return inlined
                    }
                }
                let ensured = context.ensured[callee] ?? return null
                return bounding_ensured(walk, ensured, args, facts, context, program, words)
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => return bounding_lin_of(walk, op, lhs, rhs, facts, context, program, words),
        // **A call checked against a type's rule first** (ADR-369 D3): the
        // block the rule's `assert`s are put in has the call's value (#776).
        Expr::Block(block, _) => {
            let last = block.stmts.len() - 1
            if last < 0 {
                return null
            }
            for k in 0..<last {
                if !bounding_an_assert(block.stmts[k].node, words) {
                    return null
                }
            }
            return match block.stmts[last].node {
                Stmt::Expr(inner) => bounding_lin(walk, inner, facts, context, program, words),
                else => null,
            }
        },
        else => {},
    }
    return null
}

/// Whether a statement is an `assert(…)` and nothing else.
fn bounding_an_assert(stmt: ref Stmt, words: ref winnow_grammar::InternerContext) -> bool {
    return match stmt {
        Stmt::Expr(inner) => match inner {
            Expr::Call { func, args, .. } => args.len() == 1 && (bounding_variable(func, words) ?? "") == "assert",
            else => false,
        },
        else => false,
    }
}

/// **A `char`'s code** (ADR-314 D2): a number in `0..=0x10FFFF`, and a new
/// one at every reading, because the walk keeps no fact about which character
/// it is. Every proof is handed its bounds, as a list's length's.
fn bounding_code(mut walk: BoundsWalk) -> i64 {
    let name = f"code#{walk.codes}"
    walk.codes += 1
    let v = walk.arena.var(name)
    let zero = walk.arena.int(0)
    let most = walk.arena.int(1114111)
    let low = walk.arena.ge(v, zero)
    let high = walk.arena.le(v, most)
    walk.axioms.insert(name, [low, high])
    return v
}

/// **The code of the `char` `expr`**: within its class where it is a grammar
/// binding the action does not bind again (ADR-314 D1), any code otherwise
/// (D2).
fn bounding_code_of(mut walk: BoundsWalk, expr: ref Expr, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) -> i64 {
    let v = bounding_code(walk)
    let name = bounding_variable(expr, words) ?? return v
    let class = bounding_class_of(walk, name, context) ?? return v
    let key = f"code#{walk.codes - 1}"
    let mut held: Vec[i64] = []
    if class.lo != null {
        let lo = walk.arena.int(class.lo ?? 0)
        held.push(walk.arena.ge(v, lo))
    }
    if class.hi != null {
        let hi = walk.arena.int(class.hi ?? 0)
        held.push(walk.arena.le(v, hi))
    }
    walk.axioms.insert(key, held)
    return v
}

/// **`-x` that stays inside its type** (ADR-314 D5): `x` is proved above the
/// type's least value, whose negation is the one that does not fit.
fn bounding_negation(mut walk: BoundsWalk, expr: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if walk.collecting || context.negations.is_empty() {
        return
    }
    let node = node_key(expr)
    let ty = context.negations[node] ?? return
    let operand = match expr {
        Expr::Unary { op, expr, .. } => match op {
            UnaryOp::Neg => expr,
            else => return,
        },
        else => return,
    }
    let least = Range::of_type(ty) ?? return
    let lo = least.lo ?? return
    let above = (lo + 1).max(0 - solvable())
    let term = bounding_lin(walk, operand, facts, context, program, words) ?? return
    let k = walk.arena.int(above)
    let goal = walk.arena.ge(term, k)
    if bounding_proves_goal(walk, facts, goal, ask) {
        walk.proven.negations.insert(node)
    } else {
        walk.open += 1
    }
}

/// The class of the `char` named `name`: a grammar binding's, or a loop's
/// over a text binding's characters, where nothing binds the name again.
fn bounding_class_of(walk: ref BoundsWalk, name: ref String, context: ref BoundsContext) -> Range? {
    if walk.loop_classes.contains_key(name) && !walk.shape.twice.contains(name) {
        return walk.loop_classes[name]
    }
    if walk.shape.bound.contains(name) {
        return null
    }
    return context.classes[name]
}

/// `x` where `iter` is `x.chars()`.
fn bounding_chars_of(iter: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match iter {
        Expr::MethodCall { receiver, method, args, .. } => {
            if !args.is_empty() || words.resolve(method) != "chars" {
                return null
            }
            bounding_variable(receiver, words)
        },
        else => null,
    }
}

/// The name a call writes for its callee: a bare one, or a path such as
/// `text::digit_value`.
fn bounding_callee(func: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match func {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        Expr::Path(parts, _) => {
            let mut out: String = ""
            for part in parts {
                if !out.is_empty() {
                    out.push_str("::")
                }
                out.push_str(words.resolve(part))
            }
            out
        },
        else => null,
    }
}

/// **A callee's `ensures` is a fact about the call's value** (ADR-314 D3):
/// the value is a number of its own, and each condition the ledger states
/// holds of it, with the arguments for the parameters - a `char` argument as
/// its code. Every proof is handed them, as a length's bounds.
fn bounding_ensured(mut walk: BoundsWalk, ensured: ref Ensured, args: ref Vec[Expr], facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    if args.len() != ensured.params.len() || ensured.conditions.is_empty() {
        return null
    }
    let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for k in 0..<args.len() {
        if ensured.chars[k] {
            given.insert(ensured.params[k].clone(), bounding_code_of(walk, args[k], context, words))
        } else {
            // An argument the walk does not read is a number of its own: what
            // the callee ensures holds whatever it is (#776).
            let term = bounding_lin(walk, args[k], facts, context, program, words) ?? bounding_fresh(walk)
            given.insert(ensured.params[k].clone(), term)
        }
    }
    let name = f"result#{walk.codes}"
    walk.codes += 1
    let result = walk.arena.var(name)
    given.insert("result", result)
    let mut holds: Vec[i64] = []
    for nodes in ensured.conditions {
        let read = walk.arena.adopt(nodes)
        holds.push(walk.arena.substitute(read, given))
    }
    walk.axioms.insert(name, holds)
    return result
}

/// **What `std`'s ledger states of each element a sequence yields**
/// (ADR-375 D5): `b.find_all(set; from: f)` yields positions with
/// `f <= s < b.len()`. The facts of `item` for the call `iter`; none where
/// `iter` is no call whose entry states any, or its receiver is no path.
fn bounding_each(mut walk: BoundsWalk, iter: ref Expr, item: i64, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> Vec[i64] {
    let mut out: Vec[i64] = []
    match iter {
        Expr::MethodCall { receiver, method, args, config, .. } => {
            let ty = context.std_receivers[node_key(iter)] ?? return out
            let each = context.each[f"{ty}::{words.resolve(method)}"] ?? return out
            let path = path_of(receiver, words) ?? return out
            if args.len() != each.params.len() {
                return out
            }
            let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
            for k in 0..<args.len() {
                given.insert(each.params[k].clone(), bounding_given(walk, args[k], facts, context, program, words))
            }
            for (name, default) in each.options {
                let mut term: i64? = null
                for option in config {
                    if words.resolve(option.name) == name {
                        term = bounding_given(walk, option.value, facts, context, program, words)
                    }
                }
                if term == null {
                    let written = text::parse_i64(default)
                    if written != null {
                        term = walk.arena.int(written ?? 0)
                    } else {
                        term = bounding_fresh(walk)
                    }
                }
                given.insert(name.clone(), term ?? 0)
            }
            given.insert("item", item)
            given.insert(length_of("self"), bounding_length_named(walk, path, true))
            for nodes in each.conditions {
                let read = walk.arena.adopt(nodes)
                out.push(walk.arena.substitute(read, given))
            }
        },
        else => {},
    }
    return out
}

/// An argument as a term of the walk, or a number of its own where the walk
/// has none for it: a fact over that one says nothing of any other.
fn bounding_given(mut walk: BoundsWalk, arg: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64 {
    let term = bounding_lin(walk, arg, facts, context, program, words)
    if term != null {
        return term ?? 0
    }
    return bounding_fresh(walk)
}

/// A number of its own, that no other term reads.
fn bounding_fresh(mut walk: BoundsWalk) -> i64 {
    let name = f"given#{walk.codes}"
    walk.codes += 1
    return walk.arena.var(name)
}

/// The name a sequence's element is known by while the sequence is held
/// under `name` (ADR-375 D5): a path within it, so that what is known goes
/// when `name` changes.
fn bounding_element_of(name: ref String) -> String {
    return f"{name}.each()"
}

/// The name `expr` is, where it is a bare one.
fn bounding_variable(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match expr {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        else => null,
    }
}

/// `name.len()`, where `receiver` counts a `std` container.
fn bounding_length(mut walk: BoundsWalk, receiver: ref Expr, name: ref String, context: ref BoundsContext) -> i64? {
    let fixed = context.array_lengths.get(node_key(receiver))
    if fixed != null {
        return walk.arena.int(fixed ?? 0)
    }
    if !context.lengths.contains(node_key(receiver)) {
        return null
    }
    return bounding_length_named(walk, name, context.sized.contains(node_key(receiver)))
}

/// `name.len()` as a number of the walk: not negative, and below 2^60 where
/// the elements take space (`sized`).
fn bounding_length_named(mut walk: BoundsWalk, name: ref String, sized: bool) -> i64 {
    let length = length_of(name)
    let n = walk.arena.var(length)
    if sized {
        if !walk.axioms.contains_key(length) {
            let zero = walk.arena.int(0)
            let most = walk.arena.int(length_below())
            let low = walk.arena.ge(n, zero)
            let high = walk.arena.le(n, most)
            walk.axioms.insert(length, [low, high])
        }
    } else {
        walk.unsized_names.insert(length.clone())
        if !walk.floors.contains_key(length) {
            let zero = walk.arena.int(0)
            let low = walk.arena.ge(n, zero)
            walk.floors.insert(length, low)
        }
    }
    return n
}

/// `lhs op rhs` as a linear term: a sum, a difference, or a product with a
/// constant side.
fn bounding_lin_of(mut walk: BoundsWalk, op: ref BinaryOp, lhs: ref Expr, rhs: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    let l = bounding_lin(walk, lhs, facts, context, program, words) ?? return null
    let r = bounding_lin(walk, rhs, facts, context, program, words) ?? return null
    return bounding_combined(walk, op, l, r)
}

fn bounding_combined(mut walk: BoundsWalk, op: ref BinaryOp, l: i64, r: i64) -> i64? {
    match op {
        BinaryOp::Add => return walk.arena.add(l, r),
        BinaryOp::Sub => return walk.arena.sub(l, r),
        BinaryOp::Mul => return bounding_product(walk, l, r),
        else => {},
    }
    return null
}

/// `l * r`, linear where one side is a constant.
fn bounding_product(mut walk: BoundsWalk, l: i64, r: i64) -> i64? {
    if walk.arena.constant(l) == null && walk.arena.constant(r) == null {
        return null
    }
    return walk.arena.mul(l, r)
}

/// **A call to an expression function is its expression** (ADR-314 D3,
/// #421): a free function whose body is one `return e` gives `e` with the
/// arguments for its parameters, which is the `ensures result == e` it
/// publishes. Where `e` overflows, the function's own check stops the
/// program, so where the caller goes on the value is the one written.
///
/// **Only what `e` says of its parameters**: a name the body does not take
/// as a parameter belongs to the callee's scope, not the caller's, and is not
/// read. A call inside `e` is followed as far as `call_depth`.
fn bounding_called(mut walk: BoundsWalk, wanted: ref String, given: ref Vec[i64], depth: i64, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    if depth >= call_depth() {
        return null
    }
    for item in program.items {
        match item.node {
            Item::Fn { name, receiver, args, config, ret_type, body, .. } => {
                if receiver != null || !config.is_empty() {
                    continue
                }
                let declared = name ?? continue
                if words.resolve(declared) != wanted {
                    continue
                }
                let ret = ret_type ?? continue
                if !ret.generics.is_empty() || !is_whole_number(words.resolve(ret.name)) || body.stmts.len() != 1 {
                    continue
                }
                for only in body.stmts {
                    match only.node {
                        Stmt::Return(returned) => {
                            let value = returned ?? continue
                            if args.len() != given.len() {
                                return null
                            }
                            let mut env: collections::BTreeMap[String, i64] = collections::BTreeMap()
                            for k in 0..<args.len() {
                                env.insert(words.resolve(args[k].name).clone(), given[k])
                            }
                            return bounding_inline(walk, value, env, depth, program, words)
                        },
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    return null
}

/// `expr`, a callee's expression, over `env`'s terms for its parameters.
fn bounding_inline(mut walk: BoundsWalk, expr: ref Expr, env: ref collections::BTreeMap[String, i64], depth: i64, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    match expr {
        Expr::LitInt { value, negative, .. } => {
            let n = integer_as_count(integer(value, negative)) ?? return null
            return walk.arena.int(n)
        },
        Expr::Variable(name, _) => {
            let term = env[words.resolve(name)] ?? return null
            return term
        },
        Expr::Unary { op, expr, .. } => {
            match op {
                UnaryOp::Neg => {
                    let a = bounding_inline(walk, expr, env, depth, program, words) ?? return null
                    return walk.arena.neg(a)
                },
                else => {},
            }
        },
        Expr::Cast { expr, ty, .. } => {
            if ty.generics.is_empty() && is_whole_number(words.resolve(ty.name)) {
                return bounding_inline(walk, expr, env, depth, program, words)
            }
        },
        Expr::Call { func, args, config, .. } => {
            if config.is_empty() {
                let callee = bounding_variable(func, words) ?? return null
                let mut given: Vec[i64] = []
                for arg in args {
                    let term = bounding_inline(walk, arg, env, depth, program, words) ?? return null
                    given.push(term)
                }
                return bounding_called(walk, callee, given, depth + 1, program, words)
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            let l = bounding_inline(walk, lhs, env, depth, program, words) ?? return null
            let r = bounding_inline(walk, rhs, env, depth, program, words) ?? return null
            return bounding_combined(walk, op, l, r)
        },
        else => {},
    }
    return null
}

/// **What holds where `expr` is true**: a formula `expr` implies, which may
/// say less than `expr` does - of `a && b`, what is read of either half - and
/// never more.
fn bounding_claim(mut walk: BoundsWalk, expr: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    match expr {
        Expr::LitBool(b, _) => return walk.arena.boolean(b),
        Expr::Unary { op, expr, .. } => {
            match op {
                UnaryOp::Not => return bounding_denial(walk, expr, facts, context, program, words),
                else => {},
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            match op {
                BinaryOp::And => {
                    let l = bounding_claim(walk, lhs, facts, context, program, words)
                    let r = bounding_claim(walk, rhs, facts, context, program, words)
                    if l != null && r != null {
                        return walk.arena.and([l ?? 0, r ?? 0])
                    }
                    if l != null {
                        return l
                    }
                    return r
                },
                // A disjunction says something only where both halves do.
                BinaryOp::Or => {
                    let l = bounding_claim(walk, lhs, facts, context, program, words) ?? return null
                    let r = bounding_claim(walk, rhs, facts, context, program, words) ?? return null
                    return walk.arena.or([l, r])
                },
                else => {},
            }
        },
        else => {},
    }
    return bounding_comparison(walk, expr, facts, context, program, words)
}

/// **What holds where `expr` is false**: a formula `!expr` implies, by the
/// same rule as `bounding_claim` - so `a || b` false says what is read of
/// either half false, and `a && b` false says something only where both
/// halves can be denied.
fn bounding_denial(mut walk: BoundsWalk, expr: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    match expr {
        Expr::LitBool(b, _) => return walk.arena.boolean(!b),
        Expr::Unary { op, expr, .. } => {
            match op {
                UnaryOp::Not => return bounding_claim(walk, expr, facts, context, program, words),
                else => {},
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            match op {
                BinaryOp::Or => {
                    let l = bounding_denial(walk, lhs, facts, context, program, words)
                    let r = bounding_denial(walk, rhs, facts, context, program, words)
                    if l != null && r != null {
                        return walk.arena.and([l ?? 0, r ?? 0])
                    }
                    if l != null {
                        return l
                    }
                    return r
                },
                BinaryOp::And => {
                    let l = bounding_denial(walk, lhs, facts, context, program, words) ?? return null
                    let r = bounding_denial(walk, rhs, facts, context, program, words) ?? return null
                    return walk.arena.or([l, r])
                },
                else => {},
            }
        },
        else => {},
    }
    let atom = bounding_comparison(walk, expr, facts, context, program, words) ?? return null
    return walk.arena.not(atom)
}

/// A comparison of two linear terms, exactly.
fn bounding_comparison(mut walk: BoundsWalk, expr: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    match expr {
        Expr::Binary { op, lhs, rhs, .. } => {
            let compares = match op {
                BinaryOp::Lt => true,
                BinaryOp::Le => true,
                BinaryOp::Gt => true,
                BinaryOp::Ge => true,
                BinaryOp::Eq => true,
                BinaryOp::Ne => true,
                else => false,
            }
            if !compares {
                return null
            }
            let a = bounding_lin(walk, lhs, facts, context, program, words) ?? return null
            let b = bounding_lin(walk, rhs, facts, context, program, words) ?? return null
            match op {
                BinaryOp::Lt => return walk.arena.lt(a, b),
                BinaryOp::Le => return walk.arena.le(a, b),
                BinaryOp::Gt => return walk.arena.gt(a, b),
                BinaryOp::Ge => return walk.arena.ge(a, b),
                BinaryOp::Eq => return walk.arena.equal(a, b),
                else => return walk.arena.unequal(a, b),
            }
        },
        else => {},
    }
    return null
}

fn bounding_assume(mut walk: BoundsWalk, mut facts: BoundsFacts, cond: ref Expr, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) {
    let holds = bounding_claim(walk, cond, facts, context, program, words) ?? return
    bounding_push(walk, facts, holds)
}

fn bounding_assume_not(mut walk: BoundsWalk, mut facts: BoundsFacts, cond: ref Expr, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) {
    let holds = bounding_denial(walk, cond, facts, context, program, words) ?? return
    bounding_push(walk, facts, holds)
}

/// Whether `0 <= index < list.len()` follows from what holds.
fn bounding_inside(mut walk: BoundsWalk, list: ref String, node: i64, index: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    if walk.collecting || walk.pinned.contains(path_root(list)) {
        return false
    }
    let len = bounding_list_length(walk, list, node, context)
    // **A cut lies inside where its ends do** (ADR-306 D4): `0 <= a <= b <=
    // len` for `a..<b`, and `b < len` for `a..=b`.
    match index {
        Expr::Range { start, end, inclusive, .. } => {
            let from = bounding_lin(walk, start, facts, context, program, words) ?? return false
            let to = bounding_lin(walk, end, facts, context, program, words) ?? return false
            let zero = walk.arena.int(0)
            let low = walk.arena.ge(from, zero)
            let ordered = walk.arena.le(from, to)
            let mut high = walk.arena.le(to, len)
            if inclusive {
                high = walk.arena.lt(to, len)
            }
            let goal = walk.arena.and([low, ordered, high])
            return bounding_proves_goal(walk, facts, goal, ask)
        },
        else => {},
    }
    let at = bounding_lin(walk, index, facts, context, program, words)
    if at == null {
        // A position read out of a list whose values are bounded (ADR-306
        // D7), or one `%` keeps small (D3).
        let range = bounding_range(walk, index, facts, context, program, words, ask) ?? return false
        let lo = range.lo ?? return false
        let hi = range.hi ?? return false
        if lo < 0 {
            return false
        }
        let most = walk.arena.int(hi)
        let goal = walk.arena.lt(most, len)
        return bounding_proves_goal(walk, facts, goal, ask)
    }
    let position = at ?? 0
    let zero = walk.arena.int(0)
    let low = walk.arena.ge(position, zero)
    let high = walk.arena.lt(position, len)
    let goal = walk.arena.and([low, high])
    return bounding_proves_goal(walk, facts, goal, ask)
}

/// Whether the `width` elements from `at` lie inside `list`, as the cut
/// `list[at..<at + width]` does: `0 <= at` and `at + width <= list.len()`.
fn bounding_word_inside(mut walk: BoundsWalk, list: ref String, node: i64, at: ref Expr, width: i64, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    if walk.collecting || walk.pinned.contains(path_root(list)) {
        return false
    }
    let len = bounding_list_length(walk, list, node, context)
    let from = bounding_lin(walk, at, facts, context, program, words) ?? return false
    let zero = walk.arena.int(0)
    let n = walk.arena.int(width)
    let to = walk.arena.add(from, n)
    let low = walk.arena.ge(from, zero)
    let high = walk.arena.le(to, len)
    let goal = walk.arena.and([low, high])
    return bounding_proves_goal(walk, facts, goal, ask)
}

/// `base[index]`, read or written: proved where `base` is a list by name.
fn bounding_index(mut walk: BoundsWalk, base: ref Expr, index: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    let list = path_of(base, words) ?? return
    if bounding_inside(walk, list, node_key(base), index, facts, context, program, words, ask) {
        walk.proven.indices.insert(node_key(base))
    } else {
        walk.open += 1
    }
}

/// **The length of the list `list`, read at `node`**: the `N` of an
/// `Array[T, N]`, or the list's length as a name.
fn bounding_list_length(mut walk: BoundsWalk, list: ref String, node: i64, context: ref BoundsContext) -> i64 {
    let fixed = context.array_lengths.get(node)
    if fixed != null {
        return walk.arena.int(fixed ?? 0)
    }
    return walk.arena.var(length_of(list))
}

/// A block; whether control never goes past its end.
fn bounding_block(mut walk: BoundsWalk, block: ref Block, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let before = facts.ints.clone()
    let mut bound: Vec[String] = []
    let mut leaves = false
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, .. } => {
                for name in names {
                    bound.push(words.resolve(name).clone())
                }
            },
            Stmt::Comptime { name, .. } => bound.push(words.resolve(name).clone()),
            else => {},
        }
        walk.at = stmt.span.start as i64
        if bounding_stmt(walk, stmt.node, facts, context, program, words, ask) {
            leaves = true
            break
        }
    }
    // The block's own names leave with it; a name it hid is the outer one
    // again, and what was known of that was forgotten where it was hidden.
    for name in bound {
        bounding_forget(walk, facts, name)
        facts.ints.remove(name)
        if before.contains(name) {
            facts.ints.insert(name.clone())
        }
    }
    return leaves
}

fn bounding_maybe_block(mut walk: BoundsWalk, block: ref Block?, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let present = block ?? return false
    return bounding_block(walk, present, facts, context, program, words, ask)
}

fn bounding_stmt(mut walk: BoundsWalk, stmt: ref Stmt, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    match stmt {
        Stmt::Let { names, ty, value, .. } => {
            bounding_let(walk, names, ty, value, facts, context, program, words, ask)
            return false
        },
        Stmt::Comptime { name, value, .. } => {
            bounding_expr(walk, value, facts, context, program, words, ask)
            let text = words.resolve(name)
            bounding_forget(walk, facts, text)
            facts.ints.remove(text)
            return false
        },
        // **The value first, and then the write**, in the order the lowering
        // runs them (ADR-293 D2): a value that shrinks the list is reached
        // before the index it is written at.
        Stmt::Assign { target, op, value } => {
            let at = walk.at
            bounding_expr(walk, value, facts, context, program, words, ask)
            bounding_place(walk, target, facts, context, program, words, ask)
            bounding_compound(walk, op, target, value, at, facts, context, program, words, ask)
            if op == null {
                match target {
                    Expr::Index { base, .. } => {
                        let key = elements_key(walk.shape, base, words)
                        if key != null {
                            bounding_write(walk, key ?? "", value, facts, context, program, words, ask)
                        }
                    },
                    else => {},
                }
            }
            match target {
                Expr::Variable(name, _) => bounding_assign(walk, facts, words.resolve(name), op, value, context, program, words, ask),
                // **A write to a path of fields** (ADR-306 D17): the path
                // moves as a name does, and what was known of its parts goes.
                Expr::Field { .. } => {
                    let path = path_of(target, words)
                    if path != null {
                        let p = path ?? ""
                        if context.whole_fields.contains(node_key(target)) {
                            facts.ints.insert(p.clone())
                        } else {
                            facts.ints.remove(p)
                        }
                        bounding_assign(walk, facts, p, op, value, context, program, words, ask)
                    }
                },
                else => {},
            }
            return false
        },
        Stmt::For { .. } => {
            bounding_loop_stmt(walk, stmt, facts, context, program, words, ask)
            return false
        },
        Stmt::While { .. } => {
            bounding_loop_stmt(walk, stmt, facts, context, program, words, ask)
            return false
        },
        Stmt::Return(value) => {
            let returned = value ?? return true
            bounding_expr(walk, returned, facts, context, program, words, ask)
            return true
        },
        Stmt::Break => {
            bounding_turn_end(walk, facts, true, true, ask)
            return true
        },
        Stmt::Continue => {
            bounding_turn_end(walk, facts, true, false, ask)
            return true
        },
        Stmt::Expr(expr) => return bounding_expr_leaves(walk, expr, facts, context, program, words, ask),
    }
}

/// `for bindings in iter { body }`, with `invariant` assumed at the head of
/// each turn (ADR-361 D10).
fn bounding_for_stmt(mut walk: BoundsWalk, bindings: ref Vec[winnow_grammar::Symbol], iter: ref Expr, body: ref Block, mut facts: BoundsFacts, invariant: ref Vec[i64], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
        let changed = bounding_changed(body, context, words)
        let mut cands = bounding_candidates(walk, changed, facts)
        if cands.is_empty() {
            bounding_for(walk, bindings, iter, body, facts, cands, invariant, context, program, words, ask)
            return
        }
        let start = facts.clone()
        let proven = walk.proven.clone()
        let written = walk.written.clone()
        let poisoned = walk.poisoned.clone()
        // **Walked again without the counters that did not grow**, until
        // every one left did: each pass takes fewer.
        while true {
            let added = bounding_grow(walk, cands)
            bounding_for(walk, bindings, iter, body, facts, cands, invariant, context, program, words, ask)
            let failed = bounding_grew(walk, cands, added)
            if failed.is_empty() {
                return
            }
            walk.proven = proven.clone()
            walk.written = written.clone()
            walk.poisoned = poisoned.clone()
            facts.facts = start.facts.clone()
            facts.ints = start.ints.clone()
            cands = bounding_without(cands, failed)
        }
        return
}

/// `while cond { body }`, with `invariant` assumed at the head of each turn.
fn bounding_while_stmt(mut walk: BoundsWalk, cond: ref Expr, body: ref Block, mut facts: BoundsFacts, invariant: ref Vec[i64], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
        let mut changed = bounding_changed(body, context, words)
        bounding_extend(changed, bounding_changed_in_expr(cond, context, words))
        let mut cands = bounding_candidates(walk, changed, facts)
        if cands.is_empty() {
            bounding_while(walk, cond, body, changed, cands, facts, invariant, context, program, words, ask)
            return
        }
        let start = facts.clone()
        let proven = walk.proven.clone()
        let written = walk.written.clone()
        let poisoned = walk.poisoned.clone()
        // **Walked again without the counters that did not grow**, until
        // every one left did: each pass takes fewer.
        while true {
            let added = bounding_grow(walk, cands)
            bounding_while(walk, cond, body, changed, cands, facts, invariant, context, program, words, ask)
            let failed = bounding_grew(walk, cands, added)
            if failed.is_empty() {
                return
            }
            walk.proven = proven.clone()
            walk.written = written.clone()
            walk.poisoned = poisoned.clone()
            facts.facts = start.facts.clone()
            facts.ints = start.ints.clone()
            cands = bounding_without(cands, failed)
        }
        return
}

/// **A loop, and under `prove-through-loops:on` its invariant** (ADR-361 D2,
/// D4, D10). The loop is walked as ADR-306 walks it; where that leaves a goal
/// open, it is walked again with a candidate invariant assumed at the head of
/// each turn: the facts before it that the loop's changes take away, an
/// equality as its two halves (D5's guess and check, its candidates the
/// facts the loop is reached with). Each candidate is asked where the loop is
/// reached, and at each end of a turn, `continue` and `break` while all of
/// them are assumed; one that fails is dropped and the loop walked again,
/// until none fails. What that walk proves stands only where it proves more
/// than the walk without it; its invariant is kept for `nikaia.proofs` (D7).
fn bounding_loop_stmt(mut walk: BoundsWalk, stmt: ref Stmt, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    let start = walk.at
    let open = walk.open
    if !context.through_loops || walk.collecting {
        bounding_loop_framed(walk, stmt, facts, context, program, words, ask)
        return
    }
    let entry = facts.clone()
    let proven = walk.proven.clone()
    let written = walk.written.clone()
    let poisoned = walk.poisoned.clone()
    bounding_loop_framed(walk, stmt, facts, context, program, words, ask)
    if walk.open == open {
        return
    }
    // **Only a goal that reads a name the loop changes** is asked through
    // it (D10): the names such goals left open, and of the candidates only
    // those that read one of them.
    let changed = bounding_loop_changed(stmt, context, words)
    let mut wanted: collections::BTreeSet[String] = collections::BTreeSet()
    for (name, stamp) in walk.missed {
        if stamp > open && bounding_changes_name(changed, name) {
            wanted.insert(name.clone())
        }
    }
    if wanted.is_empty() {
        return
    }
    let ways = match stmt {
        Stmt::For { body, .. } => turn_jumps(body, words),
        Stmt::While { body, .. } => turn_jumps(body, words),
        else => return,
    }
    let mut guesses: Vec[i64] = []
    for guess in bounding_loop_guesses(walk, stmt, entry, changed, context, program, words) {
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(guess, read)
        let mut useful = false
        for name in read {
            if wanted.contains(name) {
                useful = true
            }
        }
        // D4's first query: it holds where the loop is reached.
        if useful && bounding_proves(walk, entry, guess, ask) {
            guesses.push(guess)
        }
    }
    if guesses.is_empty() {
        return
    }
    // **Worth a walk only where it could pay**: a goal this loop left open
    // that its candidates, added to what held there, prove. A guess only -
    // what the walk then proves is what counts.
    if !bounding_could_pay(walk, guesses, open, ask) {
        return
    }
    let after = facts.clone()
    let after_proven = walk.proven.clone()
    let after_written = walk.written.clone()
    let after_poisoned = walk.poisoned.clone()
    let after_open = walk.open
    // **The candidates settle first in walks that ask no goal** (they only
    // carry the facts to each end of a turn), then one walk asks the goals
    // with what is left assumed and checks it once more.
    let mut settled = false
    for _round in 0..<4 {
        walk.written = written.clone()
        walk.poisoned = poisoned.clone()
        let mut here = entry.clone()
        walk.collecting = true
        walk.turns.push(BoundsTurn { guesses: guesses.clone(), failed: collections::BTreeSet(), jumps: collections::BTreeSet() })
        bounding_loop_walk(walk, stmt, here, guesses, context, program, words, ask)
        walk.collecting = false
        let frame = walk.turns.pop() ?? break
        // A way out the walk did not reach is one nothing checked.
        if frame.jumps.len() != ways {
            break
        }
        if frame.failed.is_empty() {
            settled = true
            break
        }
        let mut kept: Vec[i64] = []
        for k in 0..<guesses.len() {
            if !frame.failed.contains(k) {
                kept.push(guesses[k])
            }
        }
        guesses = kept
        if guesses.is_empty() {
            break
        }
    }
    // The candidates left are asked the same once more.
    if settled && bounding_could_pay(walk, guesses, open, ask) {
        walk.proven = proven.clone()
        walk.written = written.clone()
        walk.poisoned = poisoned.clone()
        walk.open = open
        let mut here = entry.clone()
        walk.turns.push(BoundsTurn { guesses: guesses.clone(), failed: collections::BTreeSet(), jumps: collections::BTreeSet() })
        bounding_loop_walk(walk, stmt, here, guesses, context, program, words, ask)
        let frame = walk.turns.pop() ?? BoundsTurn { guesses: [], failed: collections::BTreeSet(), jumps: collections::BTreeSet() }
        if frame.failed.is_empty() && frame.jumps.len() == ways && bounding_proven_count(walk.proven) > bounding_proven_count(after_proven) {
            let mut parts: Vec[(i64, String)] = []
            for guess in guesses {
                parts.push((guess, "guess and check".clone()))
            }
            walk.proven.loops.insert(start, loop_parts_text(walk.arena, LoopFound { parts: parts }))
            facts.facts = here.facts.clone()
            facts.ints = here.ints.clone()
            // What a guess a `break` need not keep says of the names the
            // loop changes does not hold past it.
            for guess in guesses {
                if walk.leaving.contains(guess) {
                    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
                    walk.arena.variables(guess, read)
                    for name in read {
                        if bounding_changes_name(changed, name) {
                            bounding_forget(walk, facts, name)
                        }
                    }
                }
            }
            return
        }
    }
    walk.proven = after_proven
    walk.written = after_written
    walk.poisoned = after_poisoned
    walk.open = after_open
    facts.facts = after.facts.clone()
    facts.ints = after.ints.clone()
}

/// **Whether `guesses` could pay for a walk**: a goal left open since the
/// open count was `open` that they, added to what held there, prove.
fn bounding_could_pay(mut walk: BoundsWalk, guesses: ref Vec[i64], open: i64, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    for missed in walk.missed_goals {
        if missed.stamp <= open {
            continue
        }
        let mut there = BoundsFacts { ints: collections::BTreeSet(), facts: missed.facts.clone() }
        for guess in guesses {
            there.facts.push(guess)
        }
        if bounding_proves(walk, there, missed.goal, ask) {
            return true
        }
    }
    return false
}

/// A loop walked once, in a frame of its own where an outer loop's
/// invariant is being checked: its `break`s and `continue`s are its own.
fn bounding_loop_framed(mut walk: BoundsWalk, stmt: ref Stmt, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    let none: Vec[i64] = []
    if walk.turns.is_empty() {
        bounding_loop_walk(walk, stmt, facts, none, context, program, words, ask)
        return
    }
    walk.turns.push(BoundsTurn { guesses: [], failed: collections::BTreeSet(), jumps: collections::BTreeSet() })
    bounding_loop_walk(walk, stmt, facts, none, context, program, words, ask)
    walk.turns.pop()
}

fn bounding_loop_walk(mut walk: BoundsWalk, stmt: ref Stmt, mut facts: BoundsFacts, invariant: ref Vec[i64], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    match stmt {
        Stmt::For { bindings, iter, body, .. } => bounding_for_stmt(walk, bindings, iter, body, facts, invariant, context, program, words, ask),
        Stmt::While { cond, body } => bounding_while_stmt(walk, cond, body, facts, invariant, context, program, words, ask),
        else => {},
    }
}

/// **The candidates of a loop's invariant**: the facts it is reached with
/// that its changes take away, an equality as its two halves, none that
/// reads a `for`'s binding.
fn bounding_loop_guesses(mut walk: BoundsWalk, stmt: ref Stmt, entry: ref BoundsFacts, changed: ref BoundsChanged, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> Vec[i64] {
    let mut bound: Vec[String] = []
    match stmt {
        Stmt::For { bindings, .. } => {
            for binding in bindings {
                bound.push(words.resolve(binding).clone())
            }
        },
        else => {},
    }
    let mut head = entry.clone()
    bounding_after_change(walk, head, changed)
    let mut kept: collections::BTreeSet[i64] = collections::BTreeSet()
    for fact in head.facts {
        kept.insert(fact)
    }
    let mut out: Vec[i64] = []
    for fact in entry.facts {
        if kept.contains(fact) {
            continue
        }
        let mut reads_bound = false
        for name in bound {
            if bounding_touches(walk, fact, name) {
                reads_bound = true
            }
        }
        if reads_bound {
            continue
        }
        match walk.arena.at(fact) {
            SolverTerm::Eq(a, b) => {
                out.push(walk.arena.le(a, b))
                out.push(walk.arena.ge(a, b))
            },
            else => out.push(fact),
        }
    }
    // **A guard that leaves the loop holds the other way where the next turn
    // starts** (D4): `if c { break }` in the body makes `!c` a candidate,
    // asked where the loop is reached as any other.
    let body = match stmt {
        Stmt::For { body, .. } => body,
        Stmt::While { body, .. } => body,
        else => return out,
    }
    for each in body.stmts {
        let guard = bounding_break_guard(each.node) ?? continue
        let denied = bounding_denial(walk, guard, entry, context, program, words) ?? continue
        let mut reads_bound = false
        for name in bound {
            if bounding_touches(walk, denied, name) {
                reads_bound = true
            }
        }
        if !reads_bound {
            walk.leaving.insert(denied)
            out.push(denied)
        }
    }
    return out
}

/// The condition `c` of a statement `if c { break }`.
fn bounding_break_guard(stmt: ref Stmt) -> Expr? {
    return match stmt {
        Stmt::Expr(expr) => match expr {
            Expr::If { cond, then_branch, else_branch, .. } => {
                if else_branch != null || then_branch.stmts.len() != 1 {
                    return null
                }
                match then_branch.stmts[0].node {
                    Stmt::Break => cond.clone(),
                    else => null,
                }
            },
            else => null,
        },
        else => null,
    }
}

/// What a loop's turn may change: its body's changes, and a `while`'s
/// condition's.
fn bounding_loop_changed(stmt: ref Stmt, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) -> BoundsChanged {
    let mut changed = nothing_changed()
    match stmt {
        Stmt::For { body, .. } => {
            changed = bounding_changed(body, context, words)
        },
        Stmt::While { cond, body } => {
            changed = bounding_changed(body, context, words)
            bounding_extend(changed, bounding_changed_in_expr(cond, context, words))
        },
        else => {},
    }
    return changed
}

/// Whether `name`, a name of the walk, is one `changed` changes: a value, a
/// path of fields from one, or a length.
fn bounding_changes_name(changed: ref BoundsChanged, name: ref String) -> bool {
    for value in changed.values {
        if path_within(name, value) {
            return true
        }
    }
    for list in changed.lengths {
        if name == length_of(list) {
            return true
        }
    }
    for part in changed.parts {
        if path_within(name, part) {
            return true
        }
    }
    return false
}

/// **An end of a turn, a `continue` or a `break`** (ADR-361 D4): each
/// candidate of the innermost loop whose invariant is being checked is asked
/// of what holds here; one that does not follow is dropped. `jump` where it
/// is a `break` or a `continue`, counted by where it stands.
fn bounding_turn_end(mut walk: BoundsWalk, facts: ref BoundsFacts, jump: bool, leaves: bool, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if walk.turns.is_empty() {
        return
    }
    let mut frame = walk.turns.pop() ?? return
    if jump {
        frame.jumps.insert(walk.at)
    }
    for k in 0..<frame.guesses.len() {
        if leaves && walk.leaving.contains(frame.guesses[k]) {
            continue
        }
        if !frame.failed.contains(k) && !bounding_proves(walk, facts, frame.guesses[k], ask) {
            frame.failed.insert(k)
        }
    }
    walk.turns.push(frame)
}

fn bounding_proven_count(proven: ref BoundsProven) -> i64 {
    return proven.indices.len() + proven.arithmetic.len() + proven.nonnegative.len() + proven.negations.len()
}

/// `while cond { body }`, with the counters `cands` taken to only grow.
fn bounding_while(mut walk: BoundsWalk, cond: ref Expr, body: ref Block, changed: ref BoundsChanged, cands: ref Vec[String], mut facts: BoundsFacts, invariant: ref Vec[i64], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    bounding_loop_change(walk, facts, changed, cands)
    for fact in invariant {
        bounding_push(walk, facts, fact)
    }
    bounding_expr(walk, cond, facts, context, program, words, ask)
    let mut inner = facts.clone()
    bounding_assume(walk, inner, cond, context, program, words)
    if !bounding_block(walk, body, inner, context, program, words, ask) {
        bounding_turn_end(walk, inner, false, false, ask)
    }
    if !breaks(body, words) {
        bounding_assume_not(walk, facts, cond, context, program, words)
    }
}

/// **The counters a loop may take to only grow** (#711): changed in it only
/// by assignments that add to them - `i += k`, `i = i + k` - with nothing
/// they are part of changed, and not pinned. Whether each addition is not
/// negative is proved where it stands.
fn bounding_candidates(walk: ref BoundsWalk, changed: ref BoundsChanged, facts: ref BoundsFacts) -> Vec[String] {
    let mut out: Vec[String] = []
    for x in changed.values {
        if changed.jumps.contains(x) || walk.pinned.contains(path_root(x)) {
            continue
        }
        if !facts.ints.contains(x) && !x.contains(".") {
            continue
        }
        let mut inside = false
        for v in changed.values {
            if v != x && path_within(x, v) {
                inside = true
            }
        }
        for v in changed.parts {
            if path_within(x, v) {
                inside = true
            }
        }
        if !inside {
            out.push(x.clone())
        }
    }
    return out
}

/// `cands` taken to grow while their loop is walked: those no loop around
/// it takes already, which this loop answers for.
fn bounding_grow(mut walk: BoundsWalk, cands: ref Vec[String]) -> Vec[String] {
    let mut added: Vec[String] = []
    for c in cands {
        if !walk.growing.contains(c) {
            walk.growing.insert(c.clone())
            walk.grow_failed.remove(c)
            added.push(c.clone())
        }
    }
    return added
}

/// The loop is walked: the counters it took to grow that did not.
fn bounding_grew(mut walk: BoundsWalk, cands: ref Vec[String], added: ref Vec[String]) -> Vec[String] {
    for c in added {
        walk.growing.remove(c)
    }
    let mut failed: Vec[String] = []
    for c in cands {
        if walk.grow_failed.contains(c) {
            failed.push(c.clone())
        }
    }
    return failed
}

/// `cands` without `failed`.
fn bounding_without(cands: ref Vec[String], failed: ref Vec[String]) -> Vec[String] {
    let mut kept: Vec[String] = []
    for c in cands {
        if !failed.contains(c) {
            kept.push(c.clone())
        }
    }
    return kept
}

/// **What holds again at a loop's start** (`bounding_after_change`), and of
/// each counter in `cands` that it is at least what it was when the loop
/// began: what was known of it then is kept about that value.
fn bounding_loop_change(mut walk: BoundsWalk, mut facts: BoundsFacts, changed: ref BoundsChanged, cands: ref Vec[String]) {
    let mut entries: Vec[(String, String)] = []
    for x in cands {
        let entry = f"{x}#{walk.entries}"
        walk.entries += 1
        let e = walk.arena.var(entry)
        let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
        given.insert(x.clone(), e)
        for k in 0..<facts.facts.len() {
            let fact = facts.facts[k]
            if walk.arena.mentions(fact, x) {
                facts.facts[k] = walk.arena.substitute(fact, given)
            }
        }
        entries.push((x.clone(), entry))
    }
    bounding_after_change(walk, facts, changed)
    for (x, entry) in entries {
        let now = walk.arena.var(x)
        let then = walk.arena.var(entry)
        let fact = walk.arena.ge(now, then)
        bounding_push(walk, facts, fact)
    }
}

/// Whether `name = value` or `name op= value` adds to `name`.
fn bounding_steps_up(name: ref String, op: ref BinaryOp?, value: ref Expr, words: ref winnow_grammar::InternerContext) -> bool {
    if op != null {
        return bounding_is_op(op, BinaryOp::Add)
    }
    return match value {
        Expr::Binary { op: added, lhs, rhs, .. } => added == BinaryOp::Add && ((path_of(lhs, words) ?? "") == name || (path_of(rhs, words) ?? "") == name),
        else => false,
    }
}

/// `let names: ty = value`.
fn bounding_let(mut walk: BoundsWalk, names: ref Vec[winnow_grammar::Symbol], ty: ref Type?, value: ref Expr, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    bounding_expr(walk, value, facts, context, program, words, ask)
    let value_lin = bounding_lin(walk, value, facts, context, program, words)
    // **A number the walk bounds without a linear term**: a value read out
    // of a list, a `%` (ADR-306 D7, D8).
    let mut value_range: Range? = null
    if value_lin == null {
        let range = bounding_range(walk, value, facts, context, program, words, ask) ?? Range::open()
        if range.is_bounded() {
            value_range = range
        }
    }
    // A field of a whole-number type read through an index (`xs[i].count`)
    // is a number too, of which nothing is known yet (#714).
    let whole_field = match value {
        Expr::Field { .. } => context.whole_fields.contains(node_key(value)),
        else => false,
    }
    let whole = bounding_declared_whole(ty, words) ?? (value_lin != null || value_range != null || whole_field)
    for symbol in names {
        let name = words.resolve(symbol)
        bounding_forget(walk, facts, name)
        facts.ints.remove(name)
    }
    if names.len() != 1 {
        return
    }
    let name = words.resolve(names[0]).clone()
    // **A sequence held under a name keeps what `std`'s ledger states of
    // each element** (ADR-375 D5), as facts of a name within it.
    let held = walk.arena.var(bounding_element_of(name))
    for fact in bounding_each(walk, value, held, facts, context, program, words) {
        bounding_push(walk, facts, fact)
    }
    if whole {
        facts.ints.insert(name.clone())
        if value_lin != null {
            let v = value_lin ?? 0
            if !walk.arena.mentions(v, name) {
                let n = walk.arena.var(name)
                let fact = walk.arena.equal(n, v)
                bounding_push(walk, facts, fact)
            }
        }
        if bounding_declared_unsigned(ty, words) {
            bounding_at_least_zero(walk, facts, name)
        }
        if value_range != null {
            bounding_bounded(walk, facts, name, value_range ?? Range::open())
        }
    }
    bounding_built(walk, facts, name, value)
    if walk.shape.roots.contains(name) {
        match value {
            Expr::ListLit { items, .. } => {
                for item in items {
                    bounding_write(walk, name, item, facts, context, program, words, ask)
                }
            },
            Expr::ListRepeat { value: item, .. } => bounding_write(walk, name, item, facts, context, program, words, ask),
            else => {},
        }
    }
}

/// Whether a declared type is a whole number; nothing where none is
/// declared.
fn bounding_declared_whole(ty: ref Type?, words: ref winnow_grammar::InternerContext) -> bool? {
    let t = ty ?? return null
    return t.generics.is_empty() && is_whole_number(words.resolve(t.name))
}

fn bounding_declared_unsigned(ty: ref Type?, words: ref winnow_grammar::InternerContext) -> bool {
    let t = ty ?? return false
    return words.resolve(t.name).starts_with("u")
}

/// **`x += d` proved as `x + d`** (#387), before the name moves: what is
/// known of `x` is what the operation reads.
fn bounding_compound(mut walk: BoundsWalk, op: ref BinaryOp?, target: ref Expr, value: ref Expr, at: i64, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    let operation = op ?? return
    let arithmetic = match operation {
        BinaryOp::Add => true,
        BinaryOp::Sub => true,
        BinaryOp::Mul => true,
        else => false,
    }
    if !arithmetic || walk.collecting {
        return
    }
    if path_of(target, words) == null {
        return
    }
    let ty = context.arithmetic[at] ?? return
    if bounding_fits(walk, operation, target, value, ty, facts, context, program, words, ask) {
        walk.proven.arithmetic.insert(at)
    } else {
        walk.open += 1
    }
}

fn bounding_for(mut walk: BoundsWalk, bindings: ref Vec[winnow_grammar::Symbol], iter: ref Expr, body: ref Block, mut facts: BoundsFacts, cands: ref Vec[String], invariant: ref Vec[i64], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    bounding_expr(walk, iter, facts, context, program, words, ask)
    let changed = bounding_changed(body, context, words)
    // `for k in low..<high`: the binding, its ends as terms, and whether the
    // range takes its end.
    let mut counted = false
    let mut name: String = ""
    let mut low: i64? = null
    let mut high: i64? = null
    let mut closed = false
    if bindings.len() == 1 {
        match iter {
            Expr::Range { start, end, inclusive, .. } => {
                low = bounding_lin(walk, start, facts, context, program, words)
                high = bounding_lin(walk, end, facts, context, program, words)
                counted = true
                name = words.resolve(bindings[0]).clone()
                closed = inclusive
            },
            else => {},
        }
    }
    let mut inner = facts.clone()
    bounding_loop_change(walk, inner, changed, cands)
    for binding in bindings {
        let bound = words.resolve(binding)
        bounding_forget(walk, inner, bound)
        inner.ints.remove(bound)
    }
    for fact in invariant {
        bounding_push(walk, inner, fact)
    }
    // `for d in x.chars()` over a text binding: `d` is in its class
    // (ADR-314 D1).
    let mut classed: String? = null
    if bindings.len() == 1 && !counted {
        let over = bounding_chars_of(iter, words)
        if over != null {
            let text = over ?? ""
            let class = context.text_classes[text]
            if class != null && !walk.shape.bound.contains(text) {
                let only = words.resolve(bindings[0]).clone()
                walk.loop_classes.insert(only.clone(), class ?? Range::open())
                classed = only
            }
        }
    }
    // `for x in xs`, where what `xs` holds is bounded (ADR-306 D7).
    if bindings.len() == 1 && !counted {
        let key = elements_key(walk.shape, iter, words)
        if key != null {
            let bound = bounding_assumed(walk, key ?? "")
            if bound != null {
                let only = words.resolve(bindings[0]).clone()
                inner.ints.insert(only.clone())
                bounding_bounded(walk, inner, only, bound ?? Range::open())
            }
        }
    }
    // **A position a search hands back lies in the buffer** (ADR-375 D5):
    // what `std`'s ledger states of each element holds of the name bound,
    // from the call itself or from the name the sequence was held under, while
    // nothing it reads changes in the body.
    if bindings.len() == 1 && !counted {
        let only = words.resolve(bindings[0]).clone()
        let item = walk.arena.var(only)
        let mut stated = bounding_each(walk, iter, item, facts, context, program, words)
        let held = bounding_variable(iter, words)
        if held != null {
            let element = bounding_element_of(held ?? "")
            let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
            given.insert(element.clone(), item)
            for fact in facts.facts {
                if walk.arena.mentions(fact, element) {
                    stated.push(walk.arena.substitute(fact, given))
                }
            }
        }
        for fact in stated {
            if bounding_unchanged(walk, fact, changed) {
                inner.ints.insert(only.clone())
                bounding_push(walk, inner, fact)
            }
        }
    }
    if counted {
        inner.ints.insert(name.clone())
        let n = walk.arena.var(name)
        // A bound is read once, before the first turn: it holds of the
        // binding while nothing it reads has changed.
        if low != null {
            let l = low ?? 0
            if bounding_stable(walk, l, changed, name) {
                let fact = walk.arena.le(l, n)
                bounding_push(walk, inner, fact)
            }
        }
        if high != null {
            let h = high ?? 0
            if bounding_stable(walk, h, changed, name) {
                let fact = bounding_below(walk, n, h, closed)
                bounding_push(walk, inner, fact)
            }
        }
    }
    if !bounding_block(walk, body, inner, context, program, words, ask) {
        bounding_turn_end(walk, inner, false, false, ask)
    }
    if classed != null {
        walk.loop_classes.remove(classed ?? "")
    }
    // **A loop that pushes once per turn adds its count to the length**
    // (ADR-306 D9).
    let mut filled: Vec[String] = []
    let mut count = 0
    if counted && low != null && high != null {
        let l = low ?? 0
        let h = high ?? 0
        let mut stable = true
        for c in changed.values {
            if bounding_reads(walk, l, h, c) {
                stable = false
            }
        }
        for c in changed.lengths {
            if bounding_reads(walk, l, h, c) {
                stable = false
            }
        }
        let mut lists: Vec[String] = []
        if stable {
            lists = filled_once(body, walk.pinned, words)
        }
        let not_empty = walk.arena.le(l, h)
        if !lists.is_empty() && bounding_proves(walk, facts, not_empty, ask) {
            let mut taken = 0
            if closed {
                taken = 1
            }
            let one = walk.arena.int(taken)
            let span = walk.arena.sub(h, l)
            count = walk.arena.add(span, one)
            filled = lists
        }
    }
    let mut outer = BoundsChanged { values: changed.values.clone(), lengths: changed.lengths.clone(), parts: changed.parts.clone(), jumps: changed.jumps.clone() }
    for list in filled {
        outer.lengths.remove(list)
    }
    bounding_loop_change(walk, facts, outer, cands)
    for fact in invariant {
        bounding_push(walk, facts, fact)
    }
    for list in filled {
        bounding_shift(walk, facts, length_of(list), count)
    }
}

/// `n <= h` where the range takes its end, `n < h` where it does not.
fn bounding_below(mut walk: BoundsWalk, n: i64, h: i64, closed: bool) -> i64 {
    if closed {
        return walk.arena.le(n, h)
    }
    return walk.arena.lt(n, h)
}

/// Whether `t` holds while the loop's body runs: it reads nothing the body
/// changes, nor the binding.
fn bounding_stable(walk: ref BoundsWalk, t: i64, changed: ref BoundsChanged, name: ref String) -> bool {
    return bounding_unchanged(walk, t, changed) && !walk.arena.mentions(t, name)
}

/// Whether `t` reads nothing a loop's body changes.
fn bounding_unchanged(walk: ref BoundsWalk, t: i64, changed: ref BoundsChanged) -> bool {
    for c in changed.values {
        if bounding_touches(walk, t, c) {
            return false
        }
    }
    for c in changed.lengths {
        if walk.arena.mentions(t, length_of(c)) {
            return false
        }
    }
    for c in changed.parts {
        if bounding_touches(walk, t, c) {
            return false
        }
    }
    return true
}

/// Whether either end reads `c` or its length.
fn bounding_reads(walk: ref BoundsWalk, l: i64, h: i64, c: ref String) -> bool {
    let length = length_of(c)
    return walk.arena.mentions(l, c) || walk.arena.mentions(h, c) || walk.arena.mentions(l, length) || walk.arena.mentions(h, length)
}

/// `name = value`, or `name op= value`.
fn bounding_assign(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, op: ref BinaryOp?, value: ref Expr, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if !facts.ints.contains(name) {
        if walk.growing.contains(name) {
            walk.grow_failed.insert(name.clone())
        }
        bounding_forget(walk, facts, name)
        bounding_built(walk, facts, name, value)
        return
    }
    let value_lin = bounding_lin(walk, value, facts, context, program, words)
    let now = walk.arena.var(name)
    let mut by: i64? = null
    if value_lin != null {
        let v = value_lin ?? 0
        if bounding_is_op(op, BinaryOp::Add) && !walk.arena.mentions(v, name) {
            by = v
        } else if bounding_is_op(op, BinaryOp::Sub) && !walk.arena.mentions(v, name) {
            by = walk.arena.neg(v)
        } else if op == null && walk.arena.mentions(v, name) {
            // `n = n + d`, with `d` not reading `n`: linear in `n` with
            // coefficient one exactly where setting `n` to zero and to one
            // gives the same difference.
            let d = walk.arena.sub(v, now)
            let mut at_zero: collections::BTreeMap[String, i64] = collections::BTreeMap()
            at_zero.insert(name.clone(), walk.arena.int(0))
            let d0 = walk.arena.substitute(d, at_zero)
            let mut at_one: collections::BTreeMap[String, i64] = collections::BTreeMap()
            at_one.insert(name.clone(), walk.arena.int(1))
            let d1 = walk.arena.substitute(d, at_one)
            let same = walk.arena.equal(d0, d1)
            let none: Vec[i64] = []
            if ask(walk.arena, none, same) {
                by = d0
            }
        }
    }
    if walk.growing.contains(name) {
        let mut grows = false
        if by != null {
            let zero = walk.arena.int(0)
            let goal = walk.arena.ge(by ?? 0, zero)
            grows = bounding_proves(walk, facts, goal, ask)
        }
        if !grows {
            walk.grow_failed.insert(name.clone())
        }
    }
    if by != null {
        bounding_shift(walk, facts, name, by ?? 0)
        return
    }
    if op == null && value_lin != null {
        bounding_forget(walk, facts, name)
        let n = walk.arena.var(name)
        let fact = walk.arena.equal(n, value_lin ?? 0)
        bounding_push(walk, facts, fact)
        return
    }
    let mut range: Range? = null
    if op == null && value_lin == null {
        range = bounding_range(walk, value, facts, context, program, words, ask)
    }
    bounding_forget(walk, facts, name)
    if walk.nonnegative.contains(name) || walk.shape.unsigned.contains(name) {
        bounding_at_least_zero(walk, facts, name)
    }
    if range != null {
        bounding_bounded(walk, facts, name, range ?? Range::open())
    }
}

fn bounding_is_op(op: ref BinaryOp?, wanted: BinaryOp) -> bool {
    let given = op ?? return false
    return given == wanted
}

/// What is known of `name`'s length from the value it was given.
fn bounding_built(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, value: ref Expr) {
    match value {
        Expr::ListLit { items, .. } => {
            let length = length_of(name)
            let len = walk.arena.var(length)
            let n = walk.arena.int(items.len())
            let fact = walk.arena.equal(len, n)
            bounding_push(walk, facts, fact)
        },
        else => {},
    }
}

/// The target of an assignment: an index there is a write, proved as a read
/// is.
fn bounding_place(mut walk: BoundsWalk, target: ref Expr, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    match target {
        Expr::Index { base, index, .. } => {
            bounding_place(walk, base, facts, context, program, words, ask)
            bounding_expr(walk, index, facts, context, program, words, ask)
            bounding_index(walk, base, index, facts, context, program, words, ask)
        },
        Expr::Field { base, .. } => bounding_place(walk, base, facts, context, program, words, ask),
        else => {},
    }
}

/// An expression as a statement; whether control never goes past it.
fn bounding_expr_leaves(mut walk: BoundsWalk, expr: ref Expr, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    match expr {
        Expr::If { cond, then_branch, else_branch, .. } => return bounding_if_leaves(walk, cond, then_branch, else_branch, facts, context, program, words, ask),
        Expr::Return(value, _) => {
            let returned = value ?? return true
            bounding_expr(walk, returned, facts, context, program, words, ask)
            return true
        },
        Expr::Break(_) => {
            bounding_turn_end(walk, facts, true, true, ask)
            return true
        },
        Expr::Continue(_) => {
            bounding_turn_end(walk, facts, true, false, ask)
            return true
        },
        Expr::Throw(value, _) => {
            bounding_expr(walk, value, facts, context, program, words, ask)
            return true
        },
        // `panic(…)` does not come back.
        Expr::Call { func, args, .. } => {
            let callee = bounding_variable(func, words) ?? ""
            if callee == "panic" {
                for arg in args {
                    bounding_expr(walk, arg, facts, context, program, words, ask)
                }
                return true
            }
        },
        else => {},
    }
    bounding_expr(walk, expr, facts, context, program, words, ask)
    return false
}

fn bounding_if_leaves(mut walk: BoundsWalk, cond: ref Expr, then_branch: ref Block, else_branch: ref Block?, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    bounding_expr(walk, cond, facts, context, program, words, ask)
    let mut then_facts = facts.clone()
    bounding_assume(walk, then_facts, cond, context, program, words)
    let then_leaves = bounding_block(walk, then_branch, then_facts, context, program, words, ask)
    let mut else_facts = facts.clone()
    bounding_assume_not(walk, else_facts, cond, context, program, words)
    let else_leaves = bounding_maybe_block(walk, else_branch, else_facts, context, program, words, ask)
    if then_leaves && else_leaves {
        return true
    }
    if then_leaves {
        facts.ints = else_facts.ints
        facts.facts = else_facts.facts
    } else if else_leaves {
        facts.ints = then_facts.ints
        facts.facts = then_facts.facts
    } else {
        let mut changed = bounding_changed(then_branch, context, words)
        bounding_extend_maybe(changed, else_branch, context, words)
        bounding_after_change(walk, facts, changed)
    }
    return false
}

/// Walk an expression: prove the indices in it with what holds, and keep
/// what it changes.
fn bounding_expr(mut walk: BoundsWalk, expr: ref Expr, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    bounding_nonnegative(walk, expr, facts, context, program, words, ask)
    bounding_negation(walk, expr, facts, context, program, words, ask)
    match expr {
        Expr::Index { base, index, .. } => {
            bounding_expr(walk, base, facts, context, program, words, ask)
            bounding_expr(walk, index, facts, context, program, words, ask)
            bounding_index(walk, base, index, facts, context, program, words, ask)
        },
        Expr::Binary { op, lhs, rhs, span, .. } => bounding_binary(walk, op, lhs, rhs, span.start as i64, facts, context, program, words, ask),
        Expr::If { cond, then_branch, else_branch, .. } => {
            bounding_expr(walk, cond, facts, context, program, words, ask)
            let mut then_facts = facts.clone()
            bounding_assume(walk, then_facts, cond, context, program, words)
            bounding_block(walk, then_branch, then_facts, context, program, words, ask)
            let mut changed = bounding_changed(then_branch, context, words)
            bounding_else(walk, else_branch, cond, facts, changed, context, program, words, ask)
            bounding_after_change(walk, facts, changed)
        },
        Expr::Block(block, _) => bounding_inner_block(walk, block, facts, context, program, words, ask),
        Expr::Unsafe(block, _) => {
            bounding_inner_block(walk, block, facts, context, program, words, ask)
            // **An `assume` holds past the `unsafe` around it** (ADR-376 D1).
            for cond in prover_assumed_in_unsafe(block, words) {
                bounding_assume(walk, facts, cond, context, program, words)
            }
        },
        Expr::Match { value, arms, .. } => {
            bounding_expr(walk, value, facts, context, program, words, ask)
            let mut changed = nothing_changed()
            for arm in arms {
                // A pattern may bind a name that hides an outer one, so
                // nothing known outside is carried into an arm.
                let mut inner = BoundsFacts { ints: collections::BTreeSet(), facts: [] }
                bounding_maybe_expr(walk, arm.guard, inner, context, program, words, ask)
                bounding_expr(walk, arm.body, inner, context, program, words, ask)
                bounding_extend(changed, bounding_changed_in_expr(arm.body, context, words))
            }
            bounding_after_change(walk, facts, changed)
        },
        // Not entered: a lambda or a task may run at any later moment.
        Expr::Closure { .. } => {},
        Expr::Spawn { .. } => {},
        Expr::Overlap(_, _) => {},
        Expr::Select(_, _) => {},
        Expr::MethodCall { receiver, method, args, .. } => bounding_method_call(walk, receiver, words.resolve(method), args, facts, context, program, words, ask),
        Expr::SafeMethod { receiver, method, args, .. } => bounding_method_call(walk, receiver, words.resolve(method), args, facts, context, program, words, ask),
        Expr::Call { func, args, config, .. } => {
            bounding_expr(walk, func, facts, context, program, words, ask)
            for arg in args {
                bounding_expr(walk, arg, facts, context, program, words, ask)
            }
            for c in config {
                bounding_expr(walk, c.value, facts, context, program, words, ask)
            }
            // **What an `assert` claims holds after it** (ADR-269 D4): the
            // program stops where it does not. An `assume` is vouched for
            // (ADR-376 D1).
            // **A vector's load lies inside where its cut does** (ADR-377 D3):
            // `0 <= at` and `at + n <= len`, `n` the most a `Lanes` reads.
            let loaded = context.simd_loads[node_key(func)] ?? 0
            if loaded != 0 && args.len() == 2 {
                let list = path_of(args[0], words)
                let read = if loaded < 0 { -loaded } else { loaded }
                if list != null && bounding_word_inside(walk, list ?? "", node_key(args[0]), args[1], read, facts, context, program, words, ask) {
                    walk.proven.indices.insert(node_key(func))
                } else {
                    walk.open += 1
                }
            }
            let claimed = bounding_variable(func, words) ?? ""
            if args.len() == 1 && (claimed == "assert" || claimed == "assume") {
                bounding_assume(walk, facts, args[0], context, program, words)
            }
            let callee = callee_params(func, context.around, words)
            for at in 0..<args.len() {
                let handed = path_of(args[at], words) ?? continue
                // A load reads its bytes and changes nothing.
                if hands_on(callee, at) && loaded == 0 {
                    bounding_forget(walk, facts, handed)
                }
            }
        },
        else => bounding_children(walk, expr, facts, context, program, words, ask),
    }
}

/// **A signed value put where an unsigned type is stated** (ADR-285 D32):
/// proved `>= 0` from what holds before it runs, or left to the conversion.
fn bounding_nonnegative(mut walk: BoundsWalk, expr: ref Expr, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if walk.collecting || context.nonnegative.is_empty() {
        return
    }
    let node = node_key(expr)
    if !context.nonnegative.contains(node) {
        return
    }
    let term = bounding_lin(walk, expr, facts, context, program, words) ?? return
    let zero = walk.arena.int(0)
    let goal = walk.arena.ge(term, zero)
    if bounding_proves_goal(walk, facts, goal, ask) {
        walk.proven.nonnegative.insert(node)
    } else {
        walk.open += 1
    }
}

fn bounding_maybe_expr(mut walk: BoundsWalk, expr: ref Expr?, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    let present = expr ?? return
    bounding_expr(walk, present, facts, context, program, words, ask)
}

/// An `else` branch, walked with the condition false; what it changes is
/// added to `changed`.
fn bounding_else(mut walk: BoundsWalk, else_branch: ref Block?, cond: ref Expr, facts: ref BoundsFacts, mut changed: BoundsChanged, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    let block = else_branch ?? return
    let mut else_facts = facts.clone()
    bounding_assume_not(walk, else_facts, cond, context, program, words)
    bounding_block(walk, block, else_facts, context, program, words, ask)
    bounding_extend(changed, bounding_changed(block, context, words))
}

/// A block inside an expression: walked with what holds here, and what it
/// changes forgotten after it.
fn bounding_inner_block(mut walk: BoundsWalk, block: ref Block, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    let mut inner = facts.clone()
    bounding_block(walk, block, inner, context, program, words, ask)
    let changed = bounding_changed(block, context, words)
    bounding_after_change(walk, facts, changed)
}

fn bounding_binary(mut walk: BoundsWalk, op: ref BinaryOp, lhs: ref Expr, rhs: ref Expr, at: i64, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    match op {
        // The right side runs only where the left one decided it does.
        BinaryOp::And => {
            bounding_expr(walk, lhs, facts, context, program, words, ask)
            let mut right = facts.clone()
            bounding_assume(walk, right, lhs, context, program, words)
            bounding_expr(walk, rhs, right, context, program, words, ask)
            let changed = bounding_changed_in_expr(rhs, context, words)
            bounding_after_change(walk, facts, changed)
            return
        },
        BinaryOp::Or => {
            bounding_expr(walk, lhs, facts, context, program, words, ask)
            let mut right = facts.clone()
            bounding_assume_not(walk, right, lhs, context, program, words)
            bounding_expr(walk, rhs, right, context, program, words, ask)
            let changed = bounding_changed_in_expr(rhs, context, words)
            bounding_after_change(walk, facts, changed)
            return
        },
        else => {},
    }
    bounding_expr(walk, lhs, facts, context, program, words, ask)
    bounding_expr(walk, rhs, facts, context, program, words, ask)
    // **A shift's count is a goal, as an index is** (ADR-306 D18): `0 <= k`
    // and `k` below the width of the shifted value's type.
    let shifted = context.shifts[at]
    if shifted != null && !bounding_literal(rhs) {
        if !walk.collecting && bounding_count_fits(walk, rhs, shifted ?? "", facts, context, program, words, ask) {
            walk.proven.arithmetic.insert(at)
        } else if !walk.collecting {
            walk.open += 1
        }
        return
    }
    // **An operation that stays inside its type** (ADR-306 D6): its
    // operands first, in the order they run.
    let arithmetic = match op {
        BinaryOp::Add => true,
        BinaryOp::Sub => true,
        BinaryOp::Mul => true,
        else => false,
    }
    if !arithmetic || walk.collecting {
        return
    }
    let ty = context.arithmetic[at] ?? return
    if bounding_fits(walk, op, lhs, rhs, ty, facts, context, program, words, ask) {
        walk.proven.arithmetic.insert(at)
    } else {
        walk.open += 1
    }
}

fn bounding_method_call(mut walk: BoundsWalk, receiver: ref Expr, method: ref String, args: ref Vec[Expr], mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    bounding_expr(walk, receiver, facts, context, program, words, ask)
    for arg in args {
        bounding_expr(walk, arg, facts, context, program, words, ask)
    }
    let written = writes_a_value(method, args.len())
    if written != null {
        let key = elements_key(walk.shape, receiver, words)
        if key != null {
            bounding_write(walk, key ?? "", args[written ?? 0], facts, context, program, words, ask)
        }
    }
    let receiver_path = path_of(receiver, words)
    if receiver_path != null {
        let name = receiver_path ?? ""
        // **A word read lies inside where its cut does** (ADR-320 D12):
        // `0 <= at` and `at + n <= len`.
        let width = bytes_word_width(method)
        if width > 0 && args.len() == 1 {
            if bounding_word_inside(walk, name, node_key(receiver), args[0], width, facts, context, program, words, ask) {
                walk.proven.indices.insert(node_key(receiver))
            } else {
                walk.open += 1
            }
        }
        // **A method that may change its receiver changes the paths of
        // fields from it** (ADR-306 D17): one of this program's that takes
        // its receiver `mut`, or one `keeps_length` does not know.
        if context.around.changing_receivers.contains(method) || !keeps_length(method) {
            bounding_forget_parts(walk, facts, name)
        }
        bounding_method(walk, facts, name, method, args, context, program, words, ask)
    }
    // **Only a `mut` parameter changes what it is handed** (ADR-094 D3):
    // every other argument is `ref`, or a `Bytes` or a text view that no
    // method changes (ADR-320), and keeps its length and its values.
    if context.around.changing_methods.contains(method) {
        for arg in args {
            let text = path_of(arg, words) ?? continue
            bounding_forget(walk, facts, text)
        }
    }
}

/// A method on a name: what it does to the name's length.
fn bounding_method(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, method: ref String, args: ref Vec[Expr], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if keeps_length(method) || facts.ints.contains(name) {
        return
    }
    let length = length_of(name)
    let count = args.len()
    if (method == "push" && count == 1) || (method == "insert" && count == 2) {
        let one = walk.arena.int(1)
        bounding_shift(walk, facts, length, one)
        return
    }
    if (method == "remove" || method == "swap_remove") && count == 1 {
        let one = walk.arena.int(-1)
        bounding_shift(walk, facts, length, one)
        return
    }
    if method == "clear" && count == 0 {
        bounding_forget_length(walk, facts, name)
        let len = walk.arena.var(length)
        let zero = walk.arena.int(0)
        let fact = walk.arena.equal(len, zero)
        bounding_push(walk, facts, fact)
        return
    }
    if method == "resize" && count == 2 {
        let to = bounding_lin(walk, args[0], facts, context, program, words)
        bounding_forget_length(walk, facts, name)
        if to != null {
            let len = walk.arena.var(length)
            let fact = walk.arena.equal(len, to ?? 0)
            bounding_push(walk, facts, fact)
        }
        return
    }
    // **`extend(other)` adds `other`'s length** (#383): a name only, whose
    // length is whatever the walk knows of it - nothing, where it is not a
    // list, which leaves this length unbounded. As intervals, read before
    // either length is forgotten: `other` is handed over, and what is known
    // of it goes with it.
    if method == "extend" && count == 1 {
        let other = bounding_variable(args[0], words) ?? ""
        if !other.is_empty() && other != name {
            let mine = walk.arena.var(length)
            let theirs = walk.arena.var(length_of(other))
            let mine_known = bounding_term(walk, mine, facts, ask)
            let theirs_known = bounding_term(walk, theirs, facts, ask)
            bounding_forget_length(walk, facts, name)
            let len = walk.arena.var(length)
            if mine_known.lo != null && theirs_known.lo != null {
                let lo = (mine_known.lo ?? 0).checked_add(theirs_known.lo ?? 0)
                if lo != null {
                    let k = walk.arena.int(lo ?? 0)
                    let fact = walk.arena.ge(len, k)
                    bounding_push(walk, facts, fact)
                }
            }
            if mine_known.hi != null && theirs_known.hi != null {
                let hi = (mine_known.hi ?? 0).checked_add(theirs_known.hi ?? 0)
                if hi != null {
                    let k = walk.arena.int(hi ?? 0)
                    let fact = walk.arena.le(len, k)
                    bounding_push(walk, facts, fact)
                }
            }
            return
        }
    }
    bounding_forget_length(walk, facts, name)
}

/// Each expression directly inside `expr`, then each block, of the
/// expressions `bounding_expr` does not take apart itself.
fn bounding_children(mut walk: BoundsWalk, expr: ref Expr, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    match expr {
        Expr::Range { start, end, .. } => {
            bounding_expr(walk, start, facts, context, program, words, ask)
            bounding_expr(walk, end, facts, context, program, words, ask)
        },
        Expr::Tuple(items, _) => {
            for item in items {
                bounding_expr(walk, item, facts, context, program, words, ask)
            }
        },
        Expr::ListRepeat { value, count, .. } => {
            bounding_expr(walk, value, facts, context, program, words, ask)
            bounding_expr(walk, count, facts, context, program, words, ask)
        },
        Expr::ListLit { items, .. } => {
            for item in items {
                bounding_expr(walk, item, facts, context, program, words, ask)
            }
        },
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => bounding_expr(walk, expr, facts, context, program, words, ask),
                    else => {},
                }
            }
        },
        Expr::Field { base, .. } => bounding_expr(walk, base, facts, context, program, words, ask),
        Expr::SafeField { base, .. } => bounding_expr(walk, base, facts, context, program, words, ask),
        Expr::StructLit { fields, .. } => {
            for field in fields {
                bounding_maybe_expr(walk, field.value, facts, context, program, words, ask)
            }
        },
        Expr::With { base, fields, .. } => {
            bounding_expr(walk, base, facts, context, program, words, ask)
            for field in fields {
                bounding_maybe_expr(walk, field.value, facts, context, program, words, ask)
            }
        },
        Expr::Unary { expr, .. } => bounding_expr(walk, expr, facts, context, program, words, ask),
        Expr::Try(inner, _) => bounding_expr(walk, inner, facts, context, program, words, ask),
        Expr::Throw(inner, _) => bounding_expr(walk, inner, facts, context, program, words, ask),
        Expr::Cast { expr, .. } => bounding_expr(walk, expr, facts, context, program, words, ask),
        Expr::TryCatch { expr, handler, .. } => {
            bounding_expr(walk, expr, facts, context, program, words, ask)
            bounding_inner_block(walk, handler, facts, context, program, words, ask)
        },
        Expr::Return(value, _) => bounding_maybe_expr(walk, value, facts, context, program, words, ask),
        Expr::Coalesce { value, fallback, .. } => {
            bounding_expr(walk, value, facts, context, program, words, ask)
            bounding_expr(walk, fallback, facts, context, program, words, ask)
        },
        else => {},
    }
}

// --- what a block changes --------------------------------------------------

fn bounding_extend(mut changed: BoundsChanged, other: BoundsChanged) {
    for name in other.values {
        changed.values.insert(name.clone())
    }
    for name in other.lengths {
        changed.lengths.insert(name.clone())
    }
    for name in other.parts {
        changed.parts.insert(name.clone())
    }
    for name in other.jumps {
        changed.jumps.insert(name.clone())
    }
}

fn bounding_extend_maybe(mut changed: BoundsChanged, block: ref Block?, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) {
    let present = block ?? return
    bounding_extend(changed, bounding_changed(present, context, words))
}

/// **The names whose value, and the lists whose length, `block` may
/// change**, in it and the blocks inside it, lambdas included. A `let` in a
/// nested block hides a name only there; the walk forgets it where it is
/// bound. One in a loop's body is bound again each turn, which the walk sees
/// the same way.
fn bounding_changed(block: ref Block, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) -> BoundsChanged {
    let mut out = nothing_changed()
    changed_in_block(block, context, words, out)
    return out
}

fn bounding_changed_in_expr(expr: ref Expr, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) -> BoundsChanged {
    let mut out = nothing_changed()
    changed_in_expr(expr, context, words, out)
    return out
}

fn changed_in_block(block: ref Block, context: ref BoundsContext, words: ref winnow_grammar::InternerContext, mut out: BoundsChanged) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Assign { target, op, value } => {
                let written = path_of(target, words)
                if written != null {
                    let name = written ?? ""
                    if !bounding_steps_up(name, op, value, words) {
                        out.jumps.insert(name.clone())
                    }
                    out.lengths.insert(name.clone())
                    out.values.insert(name)
                }
                changed_in_expr(target, context, words, out)
                changed_in_expr(value, context, words, out)
            },
            Stmt::For { iter, body, .. } => {
                changed_in_expr(iter, context, words, out)
                changed_in_block(body, context, words, out)
            },
            Stmt::While { cond, body } => {
                changed_in_expr(cond, context, words, out)
                changed_in_block(body, context, words, out)
            },
            Stmt::Let { value, .. } => changed_in_expr(value, context, words, out),
            Stmt::Comptime { value, .. } => changed_in_expr(value, context, words, out),
            Stmt::Expr(value) => changed_in_expr(value, context, words, out),
            Stmt::Return(value) => changed_in_maybe(value, context, words, out),
            else => {},
        }
    }
}

fn changed_in_maybe(expr: ref Expr?, context: ref BoundsContext, words: ref winnow_grammar::InternerContext, mut out: BoundsChanged) {
    let present = expr ?? return
    changed_in_expr(present, context, words, out)
}

fn changed_in_all(exprs: ref Vec[Expr], context: ref BoundsContext, words: ref winnow_grammar::InternerContext, mut out: BoundsChanged) {
    for e in exprs {
        changed_in_expr(e, context, words, out)
    }
}

/// `expr`, every expression inside it and every block inside it.
fn changed_in_expr(expr: ref Expr, context: ref BoundsContext, words: ref winnow_grammar::InternerContext, mut out: BoundsChanged) {
    changed_by(expr, context, words, out)
    match expr {
        Expr::Match { value, arms, .. } => {
            changed_in_expr(value, context, words, out)
            for arm in arms {
                changed_in_maybe(arm.guard, context, words, out)
                changed_in_expr(arm.body, context, words, out)
            }
        },
        Expr::Range { start, end, .. } => {
            changed_in_expr(start, context, words, out)
            changed_in_expr(end, context, words, out)
        },
        Expr::Tuple(items, _) => changed_in_all(items, context, words, out),
        Expr::ListRepeat { value, count, .. } => {
            changed_in_expr(value, context, words, out)
            changed_in_expr(count, context, words, out)
        },
        Expr::ListLit { items, .. } => changed_in_all(items, context, words, out),
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => changed_in_expr(expr, context, words, out),
                    else => {},
                }
            }
        },
        Expr::If { cond, then_branch, else_branch, .. } => {
            changed_in_expr(cond, context, words, out)
            changed_in_block(then_branch, context, words, out)
            changed_in_maybe_block(else_branch, context, words, out)
        },
        Expr::Call { func, args, config, .. } => {
            changed_in_expr(func, context, words, out)
            changed_in_all(args, context, words, out)
            for c in config {
                changed_in_expr(c.value, context, words, out)
            }
        },
        Expr::Spawn { body, .. } => changed_in_expr(body, context, words, out),
        Expr::MethodCall { receiver, args, config, .. } => {
            changed_in_expr(receiver, context, words, out)
            changed_in_all(args, context, words, out)
            for c in config {
                changed_in_expr(c.value, context, words, out)
            }
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            changed_in_expr(receiver, context, words, out)
            changed_in_all(args, context, words, out)
            for c in config {
                changed_in_expr(c.value, context, words, out)
            }
        },
        Expr::Field { base, .. } => changed_in_expr(base, context, words, out),
        Expr::SafeField { base, .. } => changed_in_expr(base, context, words, out),
        Expr::StructLit { fields, .. } => {
            for field in fields {
                changed_in_maybe(field.value, context, words, out)
            }
        },
        Expr::With { base, fields, .. } => {
            changed_in_expr(base, context, words, out)
            for field in fields {
                changed_in_maybe(field.value, context, words, out)
            }
        },
        Expr::Unary { expr, .. } => changed_in_expr(expr, context, words, out),
        Expr::Try(inner, _) => changed_in_expr(inner, context, words, out),
        Expr::Throw(inner, _) => changed_in_expr(inner, context, words, out),
        Expr::Cast { expr, .. } => changed_in_expr(expr, context, words, out),
        Expr::TryCatch { expr, handler, .. } => {
            changed_in_expr(expr, context, words, out)
            changed_in_block(handler, context, words, out)
        },
        Expr::Binary { lhs, rhs, .. } => {
            changed_in_expr(lhs, context, words, out)
            changed_in_expr(rhs, context, words, out)
        },
        Expr::Return(value, _) => changed_in_maybe(value, context, words, out),
        Expr::Index { base, index, .. } => {
            changed_in_expr(base, context, words, out)
            changed_in_expr(index, context, words, out)
        },
        Expr::Coalesce { value, fallback, .. } => {
            changed_in_expr(value, context, words, out)
            changed_in_expr(fallback, context, words, out)
        },
        Expr::Select(arms, _) => {
            for arm in arms {
                changed_in_expr(arm.value, context, words, out)
                changed_in_block(arm.body, context, words, out)
            }
        },
        Expr::Block(b, _) => changed_in_block(b, context, words, out),
        Expr::Overlap(b, _) => changed_in_block(b, context, words, out),
        Expr::Unsafe(b, _) => changed_in_block(b, context, words, out),
        Expr::Closure { body, .. } => changed_in_block(body, context, words, out),
        else => {},
    }
}

fn changed_in_maybe_block(block: ref Block?, context: ref BoundsContext, words: ref winnow_grammar::InternerContext, mut out: BoundsChanged) {
    let present = block ?? return
    changed_in_block(present, context, words, out)
}

/// What one expression changes itself: a method's receiver's length and
/// what it is handed, a call's arguments its callee may change.
fn changed_by(expr: ref Expr, context: ref BoundsContext, words: ref winnow_grammar::InternerContext, mut out: BoundsChanged) {
    match expr {
        Expr::MethodCall { receiver, method, args, .. } => changed_by_method(receiver, words.resolve(method), args, context, words, out),
        Expr::SafeMethod { receiver, method, args, .. } => changed_by_method(receiver, words.resolve(method), args, context, words, out),
        Expr::Call { func, args, .. } => {
            let callee = callee_params(func, context.around, words)
            for at in 0..<args.len() {
                let handed = path_of(args[at], words) ?? continue
                // A vector's load reads its bytes and changes nothing.
                if hands_on(callee, at) && !context.simd_loads.contains_key(node_key(func)) {
                    out.lengths.insert(handed.clone())
                    out.jumps.insert(handed.clone())
                    out.values.insert(handed)
                }
            }
        },
        else => {},
    }
}

fn changed_by_method(receiver: ref Expr, method: ref String, args: ref Vec[Expr], context: ref BoundsContext, words: ref winnow_grammar::InternerContext, mut out: BoundsChanged) {
    let receiver_path = path_of(receiver, words)
    if receiver_path != null {
        let name = receiver_path ?? ""
        if !keeps_length(method) {
            out.lengths.insert(name.clone())
        }
        // A method that may change its receiver changes the paths of fields
        // from it (ADR-306 D17).
        if context.around.changing_receivers.contains(method) || !keeps_length(method) {
            out.parts.insert(name)
        }
    }
    // Only a `mut` parameter changes what it is handed (ADR-094 D3).
    if context.around.changing_methods.contains(method) {
        for arg in args {
            let text = path_of(arg, words) ?? continue
            out.values.insert(text.clone())
            out.jumps.insert(text.clone())
            out.lengths.insert(text)
        }
    }
}
