// crates/nikaia-std/src/tools/prover_walk.nika
//
// **The prover's walk over a program's bodies** (ADR-269), moved from the
// compiler's `prove` (ADR-294, #436 step 4): every function, statement and
// expression, what each binding makes known, where an `assert` stands and
// what each call to a function with a precondition asks. The passes around
// it, which repeat the walk until its answers stop changing, are the
// compiler's.
//
// **What only the compiler can do is handed in** as callbacks: the solver
// (`ask`, `model`), the language below's spelling of a name (`escape`), the
// holes of a literal (`holes_of`), a package's alias (`unaliased`), an
// expression as written (`written_of`), and another package's condition read
// back with the compiler's parser (`condition`, its nodes, the root last).
// The checker keys an expression by its id (`node_key`, ADR-340).

use std::collections

/// The walk's answers, and what it keeps from one function to the next.
pub struct ProverWalk {
    pub state: ProverState,
    pub arena: TermArena,
    /// How each `assert` the walk reached is held, by statement and the id of
    /// its condition (ADR-340).
    pub held: collections::BTreeMap[(i64, i64), ClaimHeld],
    /// How each call to a function with a precondition reaches it, by callee
    /// and arguments as written (ADR-269 D20).
    pub reaches: collections::BTreeMap[(String, String), CallReach],
    pub findings: Vec[Finding],
    /// The checker's `assert`s, by statement and the id of the condition: a call is an
    /// `assert` exactly where the checker recognised the prelude's.
    pub claims: collections::BTreeSet[(i64, i64)],
}

/// **Every body of the program, walked once**: each function and method,
/// and each test and bench, which have no callers.
pub fn prover_bodies(mut walk: ProverWalk, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    for item in program.items {
        match item.node {
            Item::Fn { .. } => prover_function(walk, item, null, false, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
            Item::Impl { methods, target, trait_name } => {
                let owner = words.resolve(target.name).clone()
                for method in methods {
                    prover_function(walk, method, owner.clone(), trait_name != null, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                }
            },
            Item::Test { body, .. } => prover_test(walk, body, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
            Item::Bench { body, .. } => prover_test(walk, body, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
            else => {},
        }
    }
}

/// A test's or a bench's body: every claim in it is the test's verdict (D11).
fn prover_test(mut walk: ProverWalk, body: ref Block, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    walk.state.in_test = true
    let at = ProverWhere { function: null, params: collections::BTreeSet(), no_precondition: "a test has no callers", top: true, free: false, lambda: false, throws_out: true }
    let mut scope = ProverScope::unknown()
    prover_block(walk, body, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    walk.state.in_test = false
}

/// One function, or a method of `owner` - in a trait's implementation where
/// `of_a_trait` says so.
fn prover_function(mut walk: ProverWalk, item: ref Spanned[Item], owner: String?, of_a_trait: bool, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    match item.node {
        Item::Fn { name, receiver, args, config, body, can_throw, .. } => {
            let has_owner = owner != null
            // The ledger's key: `f`, or `Type::m` for a method.
            let mut key: String? = null
            let plain = prover_symbol_text(name, words)
            if plain != null {
                let n = plain ?? ""
                if has_owner {
                    key = f"{owner ?? ""}::{n}"
                } else {
                    key = n
                }
            }
            // A `test` block `nikaia test` has already turned into a function
            // is still a test (D11).
            let was_a_test = key != null && prover_a_test_function(key)
            let mut scope = ProverScope::at_the_entry()
            let mut params: collections::BTreeSet[String] = collections::BTreeSet()
            if receiver != null {
                scope.locals.insert("self")
            }
            for arg in args {
                let arg_name = words.resolve(arg.name).clone()
                scope.locals.insert(arg_name.clone())
                let ty = words.resolve(arg.ty.name)
                if !arg.mutable && arg.ty.generics.is_empty() && is_whole_number(ty) {
                    scope.ints.insert(arg_name.clone())
                    scope.loose.insert(arg_name.clone())
                    params.insert(arg_name.clone())
                    let at_entry = walk.arena.var(arg_name)
                    scope.entry.insert(arg_name.clone(), at_entry)
                    if ty.starts_with("u") {
                        scope.not_negative(walk.arena, arg_name)
                    }
                }
                if !arg.mutable && has_a_length(ty) {
                    scope.has_length(walk.arena, arg_name, null)
                    params.insert(arg_name.clone())
                    let length = length_of(arg_name)
                    let at_entry = walk.arena.var(length)
                    scope.entry.insert(length, at_entry)
                }
            }
            // **An option is a parameter** (Part I 5.1): a claim about it is
            // a precondition as one about a subject parameter is (#651).
            for option in config {
                let option_name = words.resolve(option.name).clone()
                scope.locals.insert(option_name.clone())
                let ty = words.resolve(option.ty.name)
                if option.ty.generics.is_empty() && is_whole_number(ty) {
                    scope.ints.insert(option_name.clone())
                    scope.loose.insert(option_name.clone())
                    params.insert(option_name.clone())
                    let at_entry = walk.arena.var(option_name)
                    scope.entry.insert(option_name.clone(), at_entry)
                    if ty.starts_with("u") {
                        scope.not_negative(walk.arena, option_name)
                    }
                }
                if has_a_length(ty) {
                    scope.has_length(walk.arena, option_name, null)
                    params.insert(option_name.clone())
                    let length = length_of(option_name)
                    let at_entry = walk.arena.var(length)
                    scope.entry.insert(length, at_entry)
                }
            }
            // **`main`'s preconditions are derived as every function's are**
            // (ADR-360 D3): its caller is the command line, and the words are
            // checked where they arrive (D4).
            let mut no_precondition: String? = null
            if of_a_trait {
                no_precondition = "A method of a trait's implementation can't have a precondition: a call through the trait doesn't know it, and there is no second entry to check it."
            }
            let free = !has_owner && !was_a_test
            let at = ProverWhere { function: claim_text_of(key), params: params, no_precondition: no_precondition, top: true, free: free, lambda: false, throws_out: can_throw }
            walk.state.in_test = was_a_test
            // **A result summary** (ADR-359 D1): every exit of a free
            // function's body the walk reads in full.
            walk.state.summing = []
            walk.state.unsummed = !free || key == null || !prover_summable(body)
            let leaves = prover_block(walk, body, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            walk.state.in_test = false
            let summed_key = key?.clone() ?? ""
            if !summed_key.is_empty() {
                if leaves && !walk.state.unsummed && !walk.state.summing.is_empty() {
                    walk.state.summaries.insert(summed_key, walk.state.summing.clone())
                } else {
                    walk.state.summaries.remove(summed_key)
                }
            }
            // A body that can end without a `return` has an exit no candidate
            // was shown at.
            if !leaves && !walk.state.collecting && key != null {
                let function = key ?? ""
                let posts = standing_posts(walk.state.postconditions, function) ?? []
                for index in 0..<posts.len() {
                    walk.state.broken.insert((function.clone(), index))
                }
            }
        },
        else => {},
    }
}

/// A block; whether it always leaves.
fn prover_block(mut walk: ProverWalk, block: ref Block, mut scope: ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> bool {
    // **The names of this block the walk may not follow as mutable whole
    // numbers** (ADR-361 D1), asked only where it binds one.
    let mut untracked: collections::BTreeSet[String] = collections::BTreeSet()
    if prover_binds_mutable(block) {
        untracked = untracked_in(block, words)
    }
    for index in 0..<block.stmts.len() {
        let stmt = block.stmts[index]
        if walk.state.collecting && index + 1 < block.stmts.len() {
            let returned = prover_returned_name(block.stmts[index + 1].node, words)
            if returned != null {
                walk.state.before_return.insert(stmt.span.start as i64, returned ?? "")
            }
        }
        if prover_stmt(walk, stmt, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition) {
            return true
        }
        prover_follow_mutables(walk, stmt.node, scope, untracked, words)
        // A statement that may leave for some states and not for others
        // narrows what goes on past it, and only an `if` the prover reads says
        // how (`prover_expr_stmt`).
        if !prover_an_if(stmt.node) && leaves_stmt(stmt.node, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true) {
            scope.exact = false
        }
    }
    return false
}

/// One statement; whether control never goes past it.
fn prover_stmt(mut walk: ProverWalk, stmt: ref Spanned[Stmt], mut scope: ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> bool {
    let span = stmt.span
    let nested = at.inside(false)
    return match stmt.node {
        Stmt::Let { names, mutable, ty, value, .. } => {
            prover_let(walk, names, mutable, ty, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            false
        },
        Stmt::Comptime { name, value, .. } => {
            prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            let bound = words.resolve(name).clone()
            scope.rebind(walk.arena, bound)
            // **An integer `comptime` is its value** (ADR-359 D7): the one
            // the build computed, which every state that reaches here has.
            let computed = walk.state.comptime_at[span.start as i64]
            if computed != null {
                scope.ints.insert(bound.clone())
                let named = walk.arena.var(bound)
                let value = walk.arena.int(computed ?? 0)
                let fact = walk.arena.equal(named, value)
                scope.facts.push(fact)
                scope.entry.insert(bound.clone(), value)
            }
            false
        },
        Stmt::Assign { target, op, value } => {
            prover_expr(walk, target, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            match target {
                Expr::Variable(name, _) => {
                    let n = words.resolve(name).clone()
                    let tainted = from_outside(value, scope.tainted, words, library, holes_of) || (op != null && scope.tainted.contains(n))
                    if !prover_assigned(walk, n, op, value, span, scope, words) {
                        scope.rebind(walk.arena, n)
                    }
                    if tainted {
                        scope.tainted.insert(n)
                    }
                },
                else => {},
            }
            false
        },
        Stmt::For { bindings, iter, body, .. } => {
            prover_for(walk, bindings, iter, body, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            false
        },
        Stmt::While { cond, body } => {
            prover_expr(walk, cond, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            // **What the turn changes** (ADR-361 D1): unknown at the head of
            // a turn and past the loop; a whole number the walk follows is
            // read past it through the loop's invariant (D2).
            let changed = assigned_in(body, words)
            let mut state: Vec[String] = []
            for n in changed {
                if scope.mutables.contains(n) && scope.ints.contains(n) {
                    state.push(n.clone())
                }
            }
            let mut records: Vec[LoopRecord] = []
            if !state.is_empty() {
                // What the earlier values make known says where the loop
                // starts (D9).
                let at_loop = scope.with_history()
                let record = loop_record(walk.arena, span.start as i64, state, at_loop, scope.ints, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, cond, body, words, walk.claims, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of)
                if record != null {
                    records.push(record ?? return false)
                }
            }
            let mut inner = scope.clone()
            for n in changed {
                inner.rebind(walk.arena, n)
                scope.rebind(walk.arena, n)
            }
            for n in state {
                inner.ints.insert(n.clone())
                inner.loose.insert(n.clone())
                scope.ints.insert(n.clone())
                scope.loose.insert(n.clone())
            }
            if !changed.is_empty() {
                scope.exact = false
            }
            scope.loops.extend(records)
            inner.path = null
            // Which turns there are depends on what the loop changes.
            inner.exact = false
            scope.path = null
            let holds = claim_term(cond, words, fn(name) { inner.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, inner, name) }, walk.arena.nodes)
            if holds != null {
                inner.facts.push(holds ?? 0)
            }
            prover_block(walk, body, inner, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            if leaves_block(body, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, false) {
                scope.exact = false
            }
            false
        },
        Stmt::Return(value) => {
            prover_return(walk, value, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            true
        },
        Stmt::Break => true,
        Stmt::Continue => true,
        Stmt::Expr(expr) => prover_expr_stmt(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
    }
}

/// A `let`: what its value makes known of the names it binds.
fn prover_let(mut walk: ProverWalk, names: ref Vec[winnow_grammar::Symbol], mutable: bool, ty: ref Type?, value: ref Expr, span: Span, mut scope: ProverScope, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    let tainted = from_outside(value, scope.tainted, words, library, holes_of)
    // **The calls with known arguments the value reads** (ADR-359 D11), kept
    // with the name it binds, so a claim over it can have them run.
    let mut known_calls: collections::BTreeSet[String] = collections::BTreeSet()
    if names.len() == 1 && !mutable {
        known_calls = prover_known_calls(walk, value, scope, program, words, own, holes_of, unaliased, condition)
    }
    // **A call inside the value is a whole number of its own** (ADR-314 D3):
    // what its callee ensures holds of it, so `let e = 10 + f(2)` reads as
    // `10 + r` with `f`'s postconditions about `r`. The value's own call, `let
    // r = f(x)`, is the case below.
    if names.len() == 1 && !mutable {
        prover_call_results(walk, value, true, scope, program, words, own, unaliased, condition, written_of)
    }
    let leaned = prover_pin_divisors(walk, value, scope, words, ask, model)
    let value_lin = lin_term(value, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
    let mut value_at_entry: i64? = null
    if value_lin != null {
        value_at_entry = scope.at_entry(walk.arena, value_lin ?? 0)
    }
    // **A call's postconditions are facts about its result** (D17): `let r =
    // f(x)` knows what `f` ensures.
    let mut called = false
    let mut called_whole = false
    let mut called_facts: Vec[i64] = []
    let mut called_summed: Vec[SummaryAlt]? = null
    if names.len() == 1 && !mutable {
        match value {
            Expr::Call { func, args, config, .. } => {
                let callee = prover_bound_callee(func, scope, words, unaliased)
                if callee != null {
                    let c = callee ?? ""
                    let bound = words.resolve(names[0]).clone()
                    called_facts = prover_postconditions_of(walk, c, args, config, bound, scope, program, words, own, condition)
                    called_whole = prover_returns_whole(walk, c, program, words, own, condition)
                    called_summed = prover_summed(walk, c, args, config, bound, scope, program, words, written_of(value))
                    called = true
                }
            },
            else => {},
        }
    }
    for name in names {
        let n = words.resolve(name).clone()
        scope.rebind(walk.arena, n)
        if tainted {
            scope.tainted.insert(n.clone())
            scope.loose.insert(n.clone())
        }
    }
    if names.len() != 1 || mutable {
        return
    }
    let name = words.resolve(names[0]).clone()
    if !leaned.is_empty() {
        scope.leaned.insert(name.clone(), leaned)
    }
    if !known_calls.is_empty() {
        scope.calls_of.insert(name.clone(), known_calls)
    }
    if value_lin != null {
        let v = value_lin ?? 0
        scope.ints.insert(name.clone())
        // **A value that reads the name it shadows** - `let x = x + 1` - is
        // about the old binding, which a fact names the same way: `x = x + 1`
        // would be a contradiction, and from it everything follows. The name
        // is a whole number; nothing more is known.
        if !walk.arena.mentions(v, name) {
            let named = walk.arena.var(name)
            let fact = walk.arena.equal(named, v)
            scope.facts.push(fact)
        } else {
            scope.loose.insert(name.clone())
        }
        // At the entry the value is what it read there, so a shadowing `let`
        // is no trouble here.
        if value_at_entry != null {
            scope.entry.insert(name.clone(), value_at_entry ?? 0)
        }
    } else if prover_typed(ty, words, 0) || (called && called_whole) {
        scope.ints.insert(name.clone())
        scope.loose.insert(name.clone())
    }
    if called && called_whole {
        for fact in called_facts {
            scope.facts.push(fact)
        }
        if called_summed != null {
            scope.summed.insert(name.clone(), called_summed ?? [])
        }
    }
    if prover_typed(ty, words, 1) && scope.ints.contains(name) {
        scope.not_negative(walk.arena, name)
    }
    match value {
        Expr::ListLit { items, .. } => {
            let known: i64? = items.len()
            scope.has_length(walk.arena, name, known)
        },
        Expr::LitStr { .. } => scope.has_length(walk.arena, name, null),
        else => {
            if prover_typed(ty, words, 2) {
                scope.has_length(walk.arena, name, null)
            }
        },
    }
}

/// **Each call in a `let`'s value that hands back a whole number**, made a
/// name of the proof under `call_result_name` (ADR-314 D3): only what its
/// callee ensures is known of it, so it is loose. A call's arguments first, so
/// `f(g(2))` reads `g`'s result in `f`'s. `top` is the value itself, whose
/// call `prover_let` binds to the name it gives.
fn prover_call_results(mut walk: ProverWalk, expr: ref Expr, top: bool, mut scope: ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, unaliased: fn(ref String) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync, written_of: fn(ref Expr) -> String sync) {
    match expr {
        Expr::Binary { lhs, rhs, .. } => {
            prover_call_results(walk, lhs, false, scope, program, words, own, unaliased, condition, written_of)
            prover_call_results(walk, rhs, false, scope, program, words, own, unaliased, condition, written_of)
        },
        Expr::Unary { expr, .. } => prover_call_results(walk, expr, false, scope, program, words, own, unaliased, condition, written_of),
        Expr::Cast { expr, .. } => prover_call_results(walk, expr, false, scope, program, words, own, unaliased, condition, written_of),
        Expr::Call { func, args, config, .. } => {
            for arg in args {
                prover_call_results(walk, arg, false, scope, program, words, own, unaliased, condition, written_of)
            }
            if top {
                return
            }
            let callee = prover_bound_callee(func, scope, words, unaliased) ?? return
            if !prover_returns_whole(walk, callee, program, words, own, condition) {
                return
            }
            let name = call_result_name(expr)
            scope.rebind(walk.arena, name)
            let facts = prover_postconditions_of(walk, callee, args, config, name, scope, program, words, own, condition)
            scope.ints.insert(name.clone())
            scope.loose.insert(name.clone())
            for fact in facts {
                scope.facts.push(fact)
            }
            let alts = prover_summed(walk, callee, args, config, name, scope, program, words, written_of(expr))
            if alts != null {
                scope.summed.insert(name.clone(), alts ?? [])
            }
        },
        else => {},
    }
}

/// **Each divisor in `expr` that what is known pins to one value** (ADR-359
/// D6), recorded under `divisor_name` for the terms built next: a model gives
/// its value and a proof shows it is the only one - with what is known, and
/// where that leaves it open, with the summaries of the calls it reads (D2).
/// The notes say where a value that leaned on a summary came from (D8).
fn prover_pin_divisors(mut walk: ProverWalk, expr: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) -> Vec[String] {
    let mut notes: Vec[String] = []
    match expr {
        Expr::Binary { op, lhs, rhs, .. } => {
            notes.extend(prover_pin_divisors(walk, lhs, scope, words, ask, model))
            notes.extend(prover_pin_divisors(walk, rhs, scope, words, ask, model))
            if op != BinaryOp::Div && op != BinaryOp::Rem {
                return notes
            }
            let key = divisor_name(rhs)
            if walk.state.pinned.contains_key(key) {
                let said = walk.state.divisor_notes[key]?.clone() ?? []
                notes.extend(said)
                return notes
            }
            let d = lin_term(rhs, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return notes
            if walk.arena.constant(d) != null {
                return notes
            }
            walk.state.divisor_queries += 1
            let mut facts = scope.facts.clone()
            let mut pinned = prover_pinned_value(walk.arena, facts, d, ask, model)
            if pinned == null && !scope.summed.is_empty() {
                let here = walk.arena.equal(d, d)
                let read = summed_read(walk.arena, scope, here)
                if !read.is_empty() {
                    facts = summed_facts(walk.arena, scope, read)
                    walk.state.second_queries += 1
                    pinned = prover_pinned_value(walk.arena, facts, d, ask, model)
                    if pinned != null {
                        let mut said: Vec[String] = []
                        for bound in read {
                            let alts = scope.summed[bound] ?? continue
                            if alts.is_empty() {
                                continue
                            }
                            let mut whys: Vec[String] = []
                            for alt in alts {
                                whys.push(alt.why.clone())
                            }
                            said.push(f"`{alts[0].call}` is {pinned ?? 0}: {whys.join("; ")}.")
                        }
                        notes.extend(said.clone())
                        walk.state.divisor_notes.insert(key.clone(), said)
                    }
                }
            }
            if pinned != null {
                walk.state.pinned.insert(key, pinned ?? 0)
            }
        },
        Expr::Unary { expr, .. } => notes.extend(prover_pin_divisors(walk, expr, scope, words, ask, model)),
        Expr::Cast { expr, .. } => notes.extend(prover_pin_divisors(walk, expr, scope, words, ask, model)),
        else => {},
    }
    return notes
}

/// The one value `d` has where `facts` hold: a model's, proved the only one.
fn prover_pinned_value(mut arena: TermArena, facts: ref Vec[i64], d: i64, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) -> i64? {
    let falsum = arena.boolean(false)
    let values = model(arena, facts, falsum) ?? return null
    let v = arena.int_value(d, values) ?? return null
    let constant = arena.int(v)
    let same = arena.equal(d, constant)
    return match ask(arena, facts, same) {
        SolverAnswer::Proved => v,
        else => null,
    }
}

/// **A call's summary at this call** (ADR-359 D2): each exit of the callee's
/// result summary with the call's arguments in place of its parameters.
/// Nothing where the callee has none, an argument is not a term the prover
/// reads, or one reads the name the result is bound to.
fn prover_summed(mut walk: ProverWalk, callee: ref String, written: ref Vec[Expr], config: ref Vec[ConfigArg], bound: ref String, scope: ref ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext, call: String) -> Vec[SummaryAlt]? {
    let exits = walk.state.summaries[callee] ?? return null
    let function = free_function(program, words, callee) ?? return null
    let args = arguments_in_order(function, written, config, words)
    if function.params.len() != args.len() {
        return null
    }
    let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for k in 0..<args.len() {
        let term = lin_term(args[k], words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return null
        if walk.arena.mentions(term, bound) {
            return null
        }
        given.insert(function.params[k].clone(), term)
    }
    let mut alts: Vec[SummaryAlt] = []
    for exit in exits {
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(exit.guard, read)
        walk.arena.variables(exit.value, read)
        for name in read {
            if !given.contains_key(name) {
                return null
            }
        }
        let guard = walk.arena.substitute(exit.guard, given)
        let value = walk.arena.substitute(exit.value, given)
        alts.push(SummaryAlt { guard: guard, value: value, callee: callee.clone(), call: call.clone(), why: exit.written.clone() })
    }
    return alts
}

/// **An exit of the function walked, as a summary's exit** (ADR-359 D1):
/// the value handed back, each call in it read by its callee's summary,
/// carried to the entry with the path to it. Where that cannot be done - a
/// call without a summary or one that can come back here, a name whose value
/// at the entry is not known, more than the fixed term bound - the function
/// has no summary.
fn prover_sum_exit(mut walk: ProverWalk, value: ref Expr, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, unaliased: fn(ref String) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync, written_of: fn(ref Expr) -> String sync) {
    if walk.state.unsummed {
        return
    }
    let made = prover_summary_exits(walk, value, scope, at, program, words, own, unaliased, condition, written_of)
    if made == null {
        walk.state.unsummed = true
        return
    }
    for exit in made ?? [] {
        walk.state.summing.push(exit.clone())
    }
}

fn prover_summary_exits(mut walk: ProverWalk, value: ref Expr, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, unaliased: fn(ref String) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync, written_of: fn(ref Expr) -> String sync) -> Vec[SummaryExit]? {
    let function = carrying_function(at.function) ?? return null
    let path = copied_path(scope.path) ?? return null
    let mut here = scope.clone()
    prover_call_results(walk, value, false, here, program, words, own, unaliased, condition, written_of)
    let returned = lin_term(value, words, fn(name) { here.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, here, name) }, walk.arena.nodes) ?? return null
    let truth = walk.arena.boolean(true)
    let mut alts: Vec[SummaryAlt] = [SummaryAlt { guard: truth, value: returned, callee: "", call: "", why: f"`{function}` returns `{written_of(value)}`" }]
    // Each call's result replaced by what its callee's exits hand back - a
    // value may read a further call, `f(g(x))`, so a few rounds.
    for _ in 0..<4 {
        let mut next: Vec[SummaryAlt] = []
        let mut grew = false
        for alt in alts {
            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
            walk.arena.variables(alt.guard, read)
            walk.arena.variables(alt.value, read)
            let mut named: String? = null
            for name in read {
                if named == null && here.summed.contains_key(name) {
                    named = name.clone()
                }
            }
            if named == null {
                next.push(alt.clone())
                continue
            }
            grew = true
            let name = named ?? ""
            let inner = here.summed[name] ?? return null
            for c in inner {
                if c.callee == function || walk.state.reaches(c.callee, function) {
                    return null
                }
                let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
                given.insert(name.clone(), c.value)
                let v = walk.arena.substitute(alt.value, given)
                let g0 = walk.arena.substitute(alt.guard, given)
                let g = walk.arena.and([g0, c.guard])
                next.push(SummaryAlt { guard: g, value: v, callee: "", call: "", why: f"{alt.why}, {c.why}" })
            }
        }
        if next.len() > 8 {
            return null
        }
        alts = next
        if !grew {
            break
        }
    }
    let mut params = at.params.clone()
    params.insert(result_name())
    let mut out: Vec[SummaryExit] = []
    for alt in alts {
        let g = here.at_entry(walk.arena, alt.guard) ?? return null
        let v = here.at_entry(walk.arena, alt.value) ?? return null
        let mut parts = path.clone()
        prover_conjuncts(walk.arena, g, parts)
        let result = walk.arena.var(result_name())
        let equal = walk.arena.equal(result, v)
        let mut guard = walk.arena.boolean(true)
        let mut term = equal
        let guarded = !parts.is_empty()
        if parts.len() == 1 {
            guard = parts[0]
        } else if parts.len() > 1 {
            guard = walk.arena.and(parts)
        }
        if guarded {
            let not_taken = walk.arena.not(guard)
            term = walk.arena.or([not_taken, equal])
        }
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(term, read)
        for name in read {
            if !is_a_parameter(name, params) {
                return null
            }
        }
        if walk.arena.size(term) > precondition_terms() {
            return null
        }
        out.push(SummaryExit { guard: guard, value: v, term: term, written: alt.why.clone() })
    }
    return out
}

/// The parts of a conjunction, each `true` left out, added to `parts`.
fn prover_conjuncts(arena: ref TermArena, id: i64, mut parts: Vec[i64]) {
    match arena.at(id) {
        SolverTerm::Bool(b) => {
            if !b {
                parts.push(id)
            }
        },
        SolverTerm::And(inner) => {
            for part in inner {
                prover_conjuncts(arena, part, parts)
            }
        },
        else => parts.push(id),
    }
}

/// **Whether a body is one a summary reads every exit of** (ADR-359 D1):
/// `let`s, `comptime`s, `return`s and `if`s around them, with no loop, no
/// assignment, no `match`, no block or lambda inside an expression - so
/// every `return` is one the walk reaches with the path to it.
fn prover_summable(block: ref Block) -> bool {
    for stmt in block.stmts {
        let fine = match stmt.node {
            Stmt::Let { value, .. } => prover_plain(value),
            Stmt::Comptime { .. } => true,
            Stmt::Return(value) => prover_plain_maybe(value),
            Stmt::Expr(expr) => match expr {
                Expr::If { cond, then_branch, else_branch, .. } => prover_plain(cond) && prover_summable(then_branch) && prover_summable_maybe(else_branch),
                else => prover_plain(expr),
            },
            else => false,
        }
        if !fine {
            return false
        }
    }
    return true
}

fn prover_summable_maybe(block: ref Block?) -> bool {
    let b = block ?? return true
    return prover_summable(b)
}

fn prover_plain_maybe(expr: ref Expr?) -> bool {
    let e = expr ?? return true
    return prover_plain(e)
}

/// An expression with no block, lambda, `match`, jump or `?` inside.
fn prover_plain(expr: ref Expr) -> bool {
    return match expr {
        Expr::LitInt { .. } => true,
        Expr::LitBool(_, _) => true,
        Expr::LitStr { .. } => true,
        Expr::Variable(_, _) => true,
        Expr::Path(_, _) => true,
        Expr::Unary { expr, .. } => prover_plain(expr),
        Expr::Cast { expr, .. } => prover_plain(expr),
        Expr::Binary { lhs, rhs, .. } => prover_plain(lhs) && prover_plain(rhs),
        Expr::Field { .. } => false,
        Expr::Call { func, args, config, .. } => config.is_empty() && prover_plain(func) && prover_all_plain(args),
        Expr::MethodCall { receiver, args, config, .. } => config.is_empty() && prover_plain(receiver) && prover_all_plain(args),
        else => false,
    }
}

fn prover_all_plain(exprs: ref Vec[Expr]) -> bool {
    for e in exprs {
        if !prover_plain(e) {
            return false
        }
    }
    return true
}

/// A `for`: a range's binding is bounded by its ends, every other binding is
/// a name nothing pins. A `for` over a range whose turn changes whole numbers
/// the walk follows is the `while` it means (ADR-361 D1): read past it
/// through its invariant; over anything else what it changes is unknown.
fn prover_for(mut walk: ProverWalk, bindings: ref Vec[winnow_grammar::Symbol], iter: ref Expr, body: ref Block, span: Span, mut scope: ProverScope, at: ref ProverWhere, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    prover_expr(walk, iter, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    let tainted = from_outside(iter, scope.tainted, words, library, holes_of)
    // What a turn changes is unknown at its head and past the loop.
    let changed = assigned_in(body, words)
    let mut state: Vec[String] = []
    let mut records: Vec[LoopRecord] = []
    if bindings.len() == 1 {
        let counter = words.resolve(bindings[0]).clone()
        match iter {
            Expr::Range { start, end, inclusive, .. } => {
                for n in changed {
                    if scope.mutables.contains(n) && scope.ints.contains(n) {
                        state.push(n.clone())
                    }
                }
                let low = lin_term(start, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                let high = lin_term(end, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                // The end is reached once, before the first turn: a bound
                // that reads what a turn changes is not the `while`'s, and a
                // binding that shadows a whole number is not stated.
                let mut fits = !state.is_empty() && low != null && high != null && !scope.ints.contains(counter) && !changed.contains(counter)
                if fits {
                    for n in changed {
                        if walk.arena.mentions(high ?? 0, n) {
                            fits = false
                        }
                    }
                }
                if fits {
                    let mut ints = scope.ints.clone()
                    ints.insert(counter.clone())
                    let record = loop_record_range(walk.arena, span.start as i64, state, scope.facts, ints, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, counter, low ?? 0, high ?? 0, inclusive, body, words, walk.claims, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of)
                    if record != null {
                        records.push(record ?? return)
                    }
                }
            },
            else => {},
        }
    }
    let mut inner = scope.clone()
    for n in changed {
        inner.rebind(walk.arena, n)
        scope.rebind(walk.arena, n)
    }
    for n in state {
        inner.ints.insert(n.clone())
        inner.loose.insert(n.clone())
        scope.ints.insert(n.clone())
        scope.loose.insert(n.clone())
    }
    scope.loops.extend(records)
    if !changed.is_empty() {
        scope.exact = false
    }
    for binding in bindings {
        let n = words.resolve(binding).clone()
        inner.rebind(walk.arena, n)
        if tainted {
            inner.tainted.insert(n)
        }
    }
    let mut ranged = false
    if bindings.len() == 1 {
        match iter {
            Expr::Range { start, end, inclusive, .. } => {
                let low = lin_term(start, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                let high = lin_term(end, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                if low != null && high != null {
                    ranged = true
                    let name = words.resolve(bindings[0]).clone()
                    inner.ints.insert(name.clone())
                    let lo = low ?? 0
                    let hi = high ?? 0
                    // low <= n, and n <= high (inclusive) or n < high - unless
                    // a bound reads the name it shadows, as `let` above.
                    if !walk.arena.mentions(lo, name) && !walk.arena.mentions(hi, name) {
                        let n = walk.arena.var(name)
                        let above = walk.arena.le(lo, n)
                        inner.facts.push(above)
                        if inclusive {
                            let below = walk.arena.le(n, hi)
                            inner.facts.push(below)
                        } else {
                            let below = walk.arena.lt(n, hi)
                            inner.facts.push(below)
                        }
                    } else {
                        inner.loose.insert(name.clone())
                    }
                    // **Every value of the range reaches the body** only where
                    // no turn can end the loop early: after a `break` the
                    // values left are never reached.
                    if leaves_block(body, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, false) {
                        inner.loose.insert(name)
                    }
                }
            },
            else => {},
        }
    }
    if !ranged {
        for binding in bindings {
            inner.loose.insert(words.resolve(binding).clone())
        }
    }
    // A claim in a loop, or after one, is not carried back to the entry
    // (D16): that needs an invariant.
    inner.path = null
    prover_block(walk, body, inner, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    scope.path = null
    if leaves_block(body, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, false) {
        scope.exact = false
    }
}

/// A `return`: an exit of the function, where its postconditions are asked.
fn prover_return(mut walk: ProverWalk, value: ref Expr?, span: Span, scope: ref ProverScope, at: ref ProverWhere, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    let returned = value ?? return
    prover_expr(walk, returned, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    walk.state.exit(walk.arena, returned, words, scope, at.function, !at.lambda && at.free, at.params, ask)
    if !at.lambda && at.free {
        prover_sum_exit(walk, returned, scope, at, program, words, own, unaliased, condition, written_of)
    }
}

/// An expression standing as a statement: an `assert`, an `if` whose
/// branches teach the rest of the block something, or anything else.
fn prover_expr_stmt(mut walk: ProverWalk, expr: ref Expr, span: Span, mut scope: ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> bool {
    let nested = at.inside(false)
    match expr {
        Expr::Call { func, args, config, .. } => {
            if prover_an_assert_call(func, args, span, walk.claims) {
                let cond = args[0]
                prover_expr(walk, cond, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                // The `message:` a failure says, where it is text as written:
                // a precondition checked elsewhere says it too.
                let message = prover_message(config, words)
                let names = claim_names_in(cond, words, holes_of)
                let mut leaned: Vec[String] = []
                if !walk.state.in_test {
                    // **A call inside the claim is a whole number of its own**,
                    // as inside a `let`'s value (ADR-314 D3): its callee's
                    // postconditions hold of it, and its summary answers a
                    // claim what is known leaves open (ADR-359 D2).
                    prover_call_results(walk, cond, false, scope, program, words, own, unaliased, condition, written_of)
                    leaned = prover_pin_divisors(walk, cond, scope, words, ask, model)
                    leaned.extend(leaned_notes(walk.arena, scope, names))
                }
                let outcome = walk.state.an_assert(walk.arena, words, cond, written_of(cond), names, message, span, scope, at, ask, model)
                let mut held = outcome.held.clone()
                let mut findings: Vec[Finding] = []
                for found in outcome.findings {
                    let mut one = found.clone()
                    if one.code == "NK1207" {
                        for note in leaned {
                            if !one.notes.contains(note) {
                                one.notes.push(note.clone())
                            }
                        }
                    }
                    findings.push(one)
                }
                if !walk.state.in_test {
                    let read = prover_known_calls(walk, cond, scope, program, words, own, holes_of, unaliased, condition)
                    if !read.is_empty() {
                        let ran = prover_claim_ran(walk, read, held, findings, written_of(cond), span, written_of)
                        held = ran.held
                        findings = ran.findings
                    }
                }
                walk.held.insert((span.start as i64, node_key(cond)), held)
                for found in findings {
                    walk.findings.push(found.clone())
                }
                return false
            }
        },
        Expr::If { cond, then_branch, else_branch, .. } => {
            return prover_if(walk, cond, then_branch, else_branch, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Throw(value, _) => {
            prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            return true
        },
        Expr::Return(value, _) => {
            prover_return(walk, value, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            return true
        },
        Expr::Break(_) => return true,
        Expr::Continue(_) => return true,
        else => {},
    }
    prover_expr(walk, expr, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    return false
}

/// An `if` as a statement: each branch knows its condition, and what a
/// branch that always leaves rules out holds after it.
fn prover_if(mut walk: ProverWalk, cond: ref Expr, then_branch: ref Block, else_branch: ref Block?, span: Span, mut scope: ProverScope, at: ref ProverWhere, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> bool {
    prover_expr(walk, cond, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    let holds = claim_term(cond, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
    let mut fails: i64? = null
    if holds != null {
        fails = walk.arena.not(holds ?? 0)
    }
    let mut then_scope = scope.clone()
    if holds != null {
        then_scope.facts.push(holds ?? 0)
    }
    // A branch on a condition the prover cannot read is reached by some
    // states and not others, and no fact says which.
    then_scope.exact = then_scope.exact && holds != null
    let cond_leaves = leaves_expr(cond, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true)
    then_scope.on_the_path(walk.arena, holds)
    let then_leaves = prover_block(walk, then_branch, then_scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    let mut else_scope = scope.clone()
    let else_leaves = prover_else(walk, else_branch, else_scope, fails, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    if !(then_leaves && else_leaves) {
        prover_join(walk, scope, then_scope, then_leaves, then_branch, else_scope, else_leaves, else_branch, span, words)
    }
    // **What a branch that always leaves rules out** holds after it: `return
    // 250 if speed > 250` leaves `speed <= 250`.
    if then_leaves && else_leaves {
        return true
    }
    if then_leaves {
        if fails != null {
            scope.facts.push(fails ?? 0)
        }
        scope.on_the_path(walk.arena, fails)
        scope.exact = scope.exact && fails != null && !prover_else_leaves(else_branch, at, program, words, own, library, holes_of, unaliased)
    } else if else_leaves {
        if holds != null {
            scope.facts.push(holds ?? 0)
        }
        scope.on_the_path(walk.arena, holds)
        scope.exact = scope.exact && holds != null && !leaves_block(then_branch, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true)
    } else if leaves_block(then_branch, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true) || prover_else_leaves(else_branch, at, program, words, own, library, holes_of, unaliased) {
        scope.exact = false
    }
    if cond_leaves {
        scope.exact = false
    }
    return false
}

/// An `else` branch, walked knowing its condition failed; whether it always
/// leaves. No branch never leaves.
fn prover_else(mut walk: ProverWalk, else_branch: ref Block?, mut else_scope: ProverScope, fails: i64?, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> bool {
    if fails != null {
        else_scope.facts.push(fails ?? 0)
    }
    let block = else_branch ?? return false
    else_scope.exact = else_scope.exact && fails != null
    else_scope.on_the_path(walk.arena, fails)
    return prover_block(walk, block, else_scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// **The mutable whole numbers after an `if` that changes them** (ADR-361
/// D9): each is one side's value or the other's, as the condition says - an
/// `if` without `else` keeping the old value on the other side. What was
/// known of the old value is kept under a name of its own (`x#12`, the
/// `if`'s byte), and each side that goes on past the `if` adds what it made
/// known over the names that live past it. One the walk stops following on
/// either side is bound again.
fn prover_join(mut walk: ProverWalk, mut scope: ProverScope, then_scope: ref ProverScope, then_leaves: bool, then_branch: ref Block, else_scope: ref ProverScope, else_leaves: bool, else_branch: ref Block?, span: Span, words: ref winnow_grammar::InternerContext) {
    if scope.mutables.is_empty() {
        return
    }
    let then_assigns = assigned_in(then_branch, words)
    let else_assigns = prover_else_assigns(else_branch, words)
    let mut changed: Vec[String] = []
    for n in then_assigns {
        if scope.mutables.contains(n) {
            changed.push(n.clone())
        }
    }
    for n in else_assigns {
        if scope.mutables.contains(n) && !then_assigns.contains(n) {
            changed.push(n.clone())
        }
    }
    if changed.is_empty() {
        return
    }
    // Which of them every side that goes on still follows.
    let mut followed: Vec[String] = []
    let mut dropped: collections::BTreeSet[String] = collections::BTreeSet()
    for n in changed {
        let on_then = then_leaves || then_scope.ints.contains(n)
        let on_else = else_leaves || else_scope.ints.contains(n)
        if on_then && on_else {
            followed.push(n.clone())
        } else {
            dropped.insert(n.clone())
        }
    }
    // What the walk knew before the `if`, which each side's own additions
    // are told apart from.
    let mut before: collections::BTreeSet[i64] = collections::BTreeSet()
    for fact in scope.facts {
        before.insert(fact)
    }
    for fact in scope.history {
        before.insert(fact)
    }
    let outer = scope.ints.clone()
    for n in dropped {
        scope.rebind(walk.arena, n)
    }
    let mut earlier: collections::BTreeMap[String, String] = collections::BTreeMap()
    for n in followed {
        let old = f"{n}#{span.start}"
        scope.renamed(walk.arena, n, old)
        earlier.insert(n.clone(), old)
    }
    let mut sides: Vec[i64] = []
    if !then_leaves {
        let own = prover_own_names(then_branch, words)
        sides.push(prover_side(walk.arena, then_scope, own, before, outer, dropped, earlier, then_assigns))
    }
    if !else_leaves {
        let own = prover_else_own_names(else_branch, words)
        sides.push(prover_side(walk.arena, else_scope, own, before, outer, dropped, earlier, else_assigns))
    }
    if !followed.is_empty() {
        if sides.len() == 1 {
            scope.history.push(sides[0])
        } else {
            scope.history.push(walk.arena.or(sides))
        }
    }
    for n in followed {
        scope.ints.insert(n.clone())
        if (!then_leaves && then_scope.loose.contains(n)) || (!else_leaves && else_scope.loose.contains(n)) {
            scope.loose.insert(n.clone())
        }
        if (!then_leaves && then_scope.tainted.contains(n)) || (!else_leaves && else_scope.tainted.contains(n)) {
            scope.tainted.insert(n.clone())
        }
    }
    scope.exact = false
}

/// **What one side of an `if` adds**, as one term: the facts it made known
/// that read only names living past the `if` - not one its own block binds,
/// nor one the walk stops following - and, for each followed name the side
/// does not assign, that it is still its old value.
fn prover_side(mut arena: TermArena, side: ref ProverScope, own: ref collections::BTreeSet[String], before: ref collections::BTreeSet[i64], outer: ref collections::BTreeSet[String], dropped: ref collections::BTreeSet[String], earlier: ref collections::BTreeMap[String, String], assigns: ref collections::BTreeSet[String]) -> i64 {
    let mut parts: Vec[i64] = []
    for fact in side.with_history() {
        if before.contains(fact) {
            continue
        }
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        arena.variables(fact, read)
        let mut lives = true
        for name in read {
            if !name.contains("#") && (!outer.contains(name) || own.contains(name) || dropped.contains(name)) {
                lives = false
            }
        }
        if lives {
            parts.push(fact)
        }
    }
    for (n, old) in earlier {
        if !assigns.contains(n) {
            let now = arena.var(n)
            let then = arena.var(old)
            parts.push(arena.equal(now, then))
        }
    }
    if parts.is_empty() {
        return arena.boolean(true)
    }
    return arena.and(parts)
}

/// Every name an `else` branch assigns, if there is one.
fn prover_else_assigns(else_branch: ref Block?, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let block = else_branch ?? return collections::BTreeSet()
    return assigned_in(block, words)
}

/// The names an `else` branch's own statements bind, if there is one.
fn prover_else_own_names(else_branch: ref Block?, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let block = else_branch ?? return collections::BTreeSet()
    return prover_own_names(block, words)
}

/// The names a block's own statements bind.
fn prover_own_names(block: ref Block, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut own: collections::BTreeSet[String] = collections::BTreeSet()
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, .. } => {
                for name in names {
                    own.insert(words.resolve(name).clone())
                }
            },
            Stmt::Comptime { name, .. } => {
                own.insert(words.resolve(name).clone())
            },
            else => {},
        }
    }
    return own
}

/// Whether an `else` branch may leave the block it stands in.
fn prover_else_leaves(else_branch: ref Block?, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync) -> bool {
    let block = else_branch ?? return false
    return leaves_block(block, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true)
}

/// **An expression, for what it calls**: a call to a function with a
/// precondition proves it here (D5), and a nested block is walked with what
/// it may know - a lambda's body with the bindings around it, which a binding
/// the prover reads never changes; any other blind (D3).
fn prover_expr(mut walk: ProverWalk, expr: ref Expr, span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    prover_calls_in(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    prover_blocks_in(walk, expr, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// Every call inside `expr`, as `contracts::sync`'s walk reaches them: not
/// into nested blocks, the holes of literals included.
fn prover_calls_in(mut walk: ProverWalk, expr: ref Expr, span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    match expr {
        Expr::Call { func, args, config, .. } => {
            let callee = prover_called(func, words, unaliased)
            if callee != null {
                prover_a_call(walk, callee ?? "", args, config, span, scope, at, program, words, own, ask, model, escape, written_of, condition)
            }
        },
        else => {},
    }
    for hole in holes_of(expr) {
        prover_calls_in(walk, hole, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    }
    match expr {
        Expr::Call { func, args, config, .. } => {
            prover_calls_in(walk, func, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_calls_in(walk, arg, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_calls_in(walk, c.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::MethodCall { receiver, args, config, .. } => {
            prover_calls_in(walk, receiver, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_calls_in(walk, arg, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_calls_in(walk, c.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            prover_calls_in(walk, receiver, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_calls_in(walk, arg, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_calls_in(walk, c.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Binary { lhs, rhs, .. } => {
            prover_calls_in(walk, lhs, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, rhs, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Unary { expr, .. } => prover_calls_in(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Try(inner, _) => prover_calls_in(walk, inner, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Throw(inner, _) => prover_calls_in(walk, inner, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Cast { expr, .. } => prover_calls_in(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Field { base, .. } => prover_calls_in(walk, base, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::SafeField { base, .. } => prover_calls_in(walk, base, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Index { base, index, .. } => {
            prover_calls_in(walk, base, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, index, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Range { start, end, .. } => {
            prover_calls_in(walk, start, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, end, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Tuple(parts, _) => {
            for part in parts {
                prover_calls_in(walk, part, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Coalesce { value, fallback, .. } => {
            prover_calls_in(walk, value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, fallback, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::TryCatch { expr, .. } => prover_calls_in(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::If { cond, .. } => prover_calls_in(walk, cond, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Match { value, arms, .. } => {
            prover_calls_in(walk, value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arm in arms {
                prover_calls_in_maybe(walk, arm.guard, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                prover_calls_in(walk, arm.body, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::StructLit { fields, .. } => {
            for field in fields {
                prover_calls_in_maybe(walk, field.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::ListRepeat { value, count, .. } => {
            prover_calls_in(walk, value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, count, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::ListLit { items, .. } => {
            for item in items {
                prover_calls_in(walk, item, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::With { base, fields, .. } => {
            prover_calls_in(walk, base, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for field in fields {
                prover_calls_in_maybe(walk, field.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Return(value, _) => prover_calls_in_maybe(walk, value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Select(arms, _) => {
            for arm in arms {
                prover_calls_in(walk, arm.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        else => {},
    }
}

fn prover_calls_in_maybe(mut walk: ProverWalk, expr: ref Expr?, span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    let present = expr ?? return
    prover_calls_in(walk, present, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// Every block `expr` holds, as `contracts::sync`'s walk reaches them: a
/// lambda's body - which runs during the call it is given to - included.
fn prover_blocks_in(mut walk: ProverWalk, expr: ref Expr, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    match expr {
        Expr::Block(block, _) => prover_nested(walk, block, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Unsafe(block, _) => prover_nested(walk, block, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Overlap(block, _) => prover_nested(walk, block, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Closure { params, mutable, body, .. } => {
            let mut names: Vec[String] = []
            for p in params {
                names.push(words.resolve(p).clone())
            }
            for p in mutable {
                names.push(words.resolve(p).clone())
            }
            prover_nested(walk, body, names, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Call { func, args, config, .. } => {
            prover_blocks_in(walk, func, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_blocks_in(walk, arg, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_blocks_in(walk, c.value, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::MethodCall { receiver, args, config, .. } => {
            prover_blocks_in(walk, receiver, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_blocks_in(walk, arg, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_blocks_in(walk, c.value, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            prover_blocks_in(walk, receiver, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_blocks_in(walk, arg, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_blocks_in(walk, c.value, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::If { then_branch, else_branch, .. } => {
            prover_nested(walk, then_branch, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_nested_maybe(walk, else_branch, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::TryCatch { expr, handler, .. } => {
            prover_blocks_in(walk, expr, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_nested(walk, handler, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Match { arms, .. } => {
            for arm in arms {
                prover_blocks_in(walk, arm.body, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Select(arms, _) => {
            for arm in arms {
                prover_nested(walk, arm.body, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        else => {},
    }
}

fn prover_nested_maybe(mut walk: ProverWalk, block: ref Block?, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    let present = block ?? return
    prover_nested(walk, present, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// A nested block: a lambda's body, `lambda` its parameters, knows what the
/// bindings around it hold - called as often as the callee likes, or never;
/// any other block's bindings this walk cannot see, so it starts blind.
fn prover_nested(mut walk: ProverWalk, block: ref Block, lambda: Vec[String]?, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    let is_lambda = lambda != null
    if is_lambda {
        let mut inner = scope.clone()
        for param in lambda ?? [] {
            inner.rebind(walk.arena, param)
            inner.loose.insert(param.clone())
        }
        inner.path = null
        inner.exact = false
        prover_block(walk, block, inner, at.inside(true), program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    } else {
        let mut inner = scope.blind()
        prover_block(walk, block, inner, at.inside(false), program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    }
}

/// **A call by name**: an edge of the call graph, and where the callee has a
/// precondition - its own, as the walk before found it in the first pass, or
/// another package's ledger's - what the call shows of it.
fn prover_a_call(mut walk: ProverWalk, callee: ref String, args: ref Vec[Expr], config: ref Vec[ConfigArg], span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) {
    if scope.locals.contains(callee) {
        return
    }
    let caller = carrying_function(at.function)
    if caller != null {
        walk.state.edges.insert((caller ?? "", callee.clone()))
    }
    // The first pass reads the walk before's preconditions: its own are still
    // being found.
    let pre = if walk.state.collecting { prover_precondition_in(walk.state.known, callee) } else { prover_precondition_in(walk.state.preconditions, callee) }
    if pre != null {
        let function = free_function(program, words, callee) ?? return
        let found = pre ?? Precondition::none()
        let all = arguments_in_order(function, args, config, words)
        prover_record_call(walk, callee, function.params, found.claims, all, span, scope, at, words, ask, model, escape, written_of)
        return
    }
    let foreign = prover_foreign_contract(walk, callee, own, condition) ?? return
    if !foreign.requires.is_empty() {
        prover_record_call(walk, callee, foreign.params, foreign.requires, args, span, scope, at, words, ask, model, escape, written_of)
    }
}

/// What a call shows of its callee's precondition, recorded: its findings,
/// and how it reaches the callee, joined with any call that reads the same.
fn prover_record_call(mut walk: ProverWalk, callee: ref String, params: ref Vec[String], claims: ref Vec[PreClaim], args: ref Vec[Expr], span: Span, scope: ref ProverScope, at: ref ProverWhere, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync) {
    let outcome = walk.state.precondition_call(walk.arena, words, callee, params, claims, args, span, scope, at, ask, model, escape)
    for found in outcome.findings {
        walk.findings.push(found.clone())
    }
    let mut written: String = ""
    for arg in args {
        if !written.is_empty() {
            written.push_str(", ")
        }
        written.push_str(written_of(arg))
    }
    let key = (callee.clone(), written)
    let before = walk.reaches.remove(key)
    if before != null {
        walk.reaches.insert(key, joined_reach(before ?? CallReach::Proved, outcome.reach))
    } else {
        walk.reaches.insert(key, outcome.reach)
    }
}

/// **Another package's contract, read back into terms** (ADR-269 D18), once
/// per function: each `requires` and `ensures` the ledger states, parsed as
/// the language's own syntax over the parameters' names. Nothing where the
/// ledger has no such function; a condition that does not read back is left
/// out, which only ever proves less.
fn prover_foreign_contract(mut walk: ProverWalk, key: ref String, own: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> Foreign? {
    let cached = prover_cached_foreign(walk.state.foreign, key)
    if cached != null {
        return cached
    }
    let contract = own.functions[key] ?? return null
    let shape = foreign_shape(contract)
    let mut requires: Vec[i64] = []
    for text in contract.requires {
        requires.push(prover_condition_term(walk.arena, text, shape.names, condition))
    }
    let mut ensures: Vec[i64] = []
    for text in contract.ensures {
        ensures.push(prover_condition_term(walk.arena, text, shape.names, condition))
    }
    let foreign = foreign_from(contract, shape, requires, ensures)
    walk.state.foreign.insert(key.clone(), foreign.clone())
    return foreign
}

/// A condition read back into the arena: its term, or `-1` where it does not
/// read back.
fn prover_condition_term(mut arena: TermArena, text: ref String, names: ref collections::BTreeSet[String], condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> i64 {
    let nodes = condition(text, names)
    if nodes.is_empty() {
        return -1
    }
    return arena.adopt(nodes)
}

/// What a call's postconditions say of the name its result is bound to: the
/// callee's own, or another package's ledger's.
fn prover_postconditions_of(mut walk: ProverWalk, callee: ref String, args: ref Vec[Expr], config: ref Vec[ConfigArg], bound: ref String, scope: ref ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> Vec[i64] {
    let posts = standing_posts(walk.state.postconditions, callee)
    if posts != null {
        let function = free_function(program, words, callee) ?? return []
        let all = arguments_in_order(function, args, config, words)
        return postconditions_for(walk.arena, posts ?? [], function.params, all, bound, scope, words, walk.state.pinned)
    }
    let foreign = prover_foreign_contract(walk, callee, own, condition) ?? return []
    return postconditions_for(walk.arena, foreign.ensures, foreign.params, args, bound, scope, words, walk.state.pinned)
}

/// Whether a function hands back a whole number.
fn prover_returns_whole(mut walk: ProverWalk, callee: ref String, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> bool {
    let function = free_function(program, words, callee)
    if function != null {
        let found = function ?? return false
        return found.whole_result
    }
    let foreign = prover_foreign_contract(walk, callee, own, condition) ?? return false
    return foreign.whole_result
}

/// Whether a call may throw out of the function `at` is.
fn prover_throws(call: ref Expr, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, unaliased: fn(ref String) -> String sync) -> bool {
    return may_throw(call, at.throws_out, program, words, own, library, unaliased)
}

/// The callee a call names, where it is a function by name: a bare name, or
/// a path as the ledger keys it.
fn prover_called(func: ref Expr, words: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync) -> String? {
    return match func {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        Expr::Path(segments, _) => prover_qualified(segments, words, unaliased),
        else => null,
    }
}

/// The callee a `let`'s value calls, where no local shadows it.
fn prover_bound_callee(func: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync) -> String? {
    return match func {
        Expr::Variable(name, _) => {
            let text = words.resolve(name)
            if scope.locals.contains(text) {
                return null
            }
            text.clone()
        },
        Expr::Path(segments, _) => prover_qualified(segments, words, unaliased),
        else => null,
    }
}

/// A path callee as the ledger keys it: `mathx::percent`, unaliased.
fn prover_qualified(segments: ref Vec[winnow_grammar::Symbol], words: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync) -> String {
    let mut joined: String = ""
    for segment in segments {
        if !joined.is_empty() {
            joined.push_str("::")
        }
        joined.push_str(words.resolve(segment))
    }
    return unaliased(joined)
}

/// Whether a call is one of the checker's `assert`s.
pub fn prover_an_assert_call(func: ref Expr, args: ref Vec[Expr], span: Span, claims: ref collections::BTreeSet[(i64, i64)]) -> bool {
    let named = match func {
        Expr::Variable(_, _) => true,
        else => false,
    }
    if !named || args.len() != 1 {
        return false
    }
    return claims.contains((span.start as i64, node_key(args[0])))
}

/// The `message:` an `assert` gives, where it is text as written.
fn prover_message(config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext) -> String? {
    for c in config {
        if words.resolve(c.name) == "message" {
            match c.value {
                Expr::LitStr { text, .. } => return text.clone(),
                else => {},
            }
        }
    }
    return null
}

/// The name a `return name` hands back.
fn prover_returned_name(stmt: ref Stmt, words: ref winnow_grammar::InternerContext) -> String? {
    return match stmt {
        Stmt::Return(value) => prover_variable_named(value, words),
        else => null,
    }
}

fn prover_variable_named(value: ref Expr?, words: ref winnow_grammar::InternerContext) -> String? {
    let present = value ?? return null
    return match present {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        else => null,
    }
}

/// **An assignment to a mutable whole number the walk follows** (ADR-361
/// D9): `x = e`, `x += e`, `x -= e` and `x *= k` give `x` the value over the
/// old one, which keeps what was known of it under a name of its own
/// (`x#12`, the statement's byte). False where the walk does not follow `x`
/// or cannot read the value, which then binds `x` again.
fn prover_assigned(mut walk: ProverWalk, n: ref String, op: ref BinaryOp?, value: ref Expr, span: Span, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    if !scope.mutables.contains(n) {
        return false
    }
    let read = lin_term(value, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return false
    let mut term = read
    if op != null {
        if !scope.ints.contains(n) {
            return false
        }
        let old = walk.arena.var(n)
        let written = op ?? return false
        term = match written {
            BinaryOp::Add => walk.arena.add(old, read),
            BinaryOp::Sub => walk.arena.sub(old, read),
            BinaryOp::Mul => {
                if walk.arena.constant(read) == null {
                    return false
                }
                walk.arena.mul(old, read)
            },
            else => return false,
        }
    }
    // **An old value what is known pins to a number is that number**: the
    // new one then needs no earlier name, and a loop after it starts there.
    if walk.arena.mentions(term, n) {
        let known = prover_known_value(walk.arena, scope.facts, n)
        if known != null {
            let mut pinned: collections::BTreeMap[String, i64] = collections::BTreeMap()
            pinned.insert(n.clone(), walk.arena.int(known ?? 0))
            term = walk.arena.substitute(term, pinned)
            let folded = walk.arena.constant(term)
            if folded != null {
                term = walk.arena.int(folded ?? 0)
            }
        }
    }
    let at_entry = scope.at_entry(walk.arena, term)
    let mut read_names: collections::BTreeSet[String] = collections::BTreeSet()
    walk.arena.variables(term, read_names)
    let mut loose = false
    for name in read_names {
        if scope.loose.contains(name) {
            loose = true
        }
    }
    let earlier = f"{n}#{span.start}"
    scope.renamed(walk.arena, n, earlier)
    let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
    given.insert(n.clone(), walk.arena.var(earlier))
    let over = walk.arena.substitute(term, given)
    let named = walk.arena.var(n)
    let fact = walk.arena.equal(named, over)
    // A value that reads an earlier one is known only through the history.
    let mut over_names: collections::BTreeSet[String] = collections::BTreeSet()
    walk.arena.variables(over, over_names)
    let mut earlier_read = false
    for name in over_names {
        if name.contains("#") {
            earlier_read = true
        }
    }
    if earlier_read {
        scope.history.push(fact)
    } else {
        scope.facts.push(fact)
    }
    scope.ints.insert(n.clone())
    if loose {
        scope.loose.insert(n.clone())
    }
    if at_entry != null {
        scope.entry.insert(n.clone(), at_entry ?? 0)
    }
    return true
}

/// The number a fact `n == k` pins `n` to.
fn prover_known_value(arena: ref TermArena, facts: ref Vec[i64], n: ref String) -> i64? {
    for fact in facts {
        match arena.at(fact) {
            SolverTerm::Eq(a, b) => {
                if arena.is_the_variable(a, n) {
                    let value = arena.constant(b)
                    if value != null {
                        return value
                    }
                }
            },
            else => {},
        }
    }
    return null
}

/// Whether a block binds one name with `let mut`.
fn prover_binds_mutable(block: ref Block) -> bool {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, mutable, .. } => {
                if mutable && names.len() == 1 {
                    return true
                }
            },
            else => {},
        }
    }
    return false
}

/// **The mutable whole numbers, after a statement** (ADR-361 D1): `let mut`
/// binds one the walk follows where its value is a term and nothing in
/// the block hands it on; a statement that changes one inside it - a branch,
/// a block - leaves it unknown. A `while`, a `for`, an `if` and an
/// assignment see to their own (ADR-361 D9).
fn prover_follow_mutables(mut walk: ProverWalk, stmt: ref Stmt, mut scope: ProverScope, untracked: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    match stmt {
        Stmt::Let { names, mutable, value, .. } => {
            if mutable && names.len() == 1 {
                let n = words.resolve(names[0]).clone()
                if !untracked.contains(n) {
                    let term = lin_term(value, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                    if term != null && !walk.arena.mentions(term ?? 0, n) {
                        let v = term ?? 0
                        let at_entry = scope.at_entry(walk.arena, v)
                        scope.ints.insert(n.clone())
                        scope.mutables.insert(n.clone())
                        let named = walk.arena.var(n)
                        scope.facts.push(walk.arena.equal(named, v))
                        if at_entry != null {
                            scope.entry.insert(n.clone(), at_entry ?? 0)
                        }
                    }
                }
            }
        },
        Stmt::While { .. } => {},
        Stmt::For { .. } => {},
        // An assignment and an `if` see to their own (D9).
        Stmt::Assign { .. } => {},
        else => {
            if !scope.mutables.is_empty() && !prover_an_if(stmt) {
                for n in assigned_in_statement(stmt, words) {
                    if scope.mutables.contains(n) {
                        scope.rebind(walk.arena, n)
                    }
                }
            }
        },
    }
}

/// Whether a statement is an `if` standing as one.
fn prover_an_if(stmt: ref Stmt) -> bool {
    return match stmt {
        Stmt::Expr(expr) => match expr {
            Expr::If { .. } => true,
            else => false,
        },
        else => false,
    }
}

fn prover_symbol_text(symbol: ref winnow_grammar::Symbol?, words: ref winnow_grammar::InternerContext) -> String? {
    let present = symbol ?? return null
    return words.resolve(present).clone()
}

/// What a `let`'s written type says: `0` a whole number, `1` an unsigned
/// one, `2` a list or text, which has a length.
fn prover_typed(ty: ref Type?, words: ref winnow_grammar::InternerContext, asked: i64) -> bool {
    let t = ty ?? return false
    let name = words.resolve(t.name)
    if asked == 0 {
        return t.generics.is_empty() && is_whole_number(name)
    }
    if asked == 1 {
        return name.starts_with("u")
    }
    return has_a_length(name)
}

/// A function's name as `nikaia test` makes it from a `test` block:
/// `__nikaia_test_` and a number.
fn prover_a_test_function(name: ref String?) -> bool {
    let text = name ?? return false
    let prefix = "__nikaia_test_"
    if !text.starts_with(prefix) || text.len() == prefix.len() {
        return false
    }
    let c: Vec[scalar] = text.chars().collect()
    for k in 14..<c.len() {
        if c[k] < '0' || c[k] > '9' {
            return false
        }
    }
    return true
}

fn prover_precondition_in(map: ref collections::BTreeMap[String, Precondition], callee: ref String) -> Precondition? {
    let found = map[callee] ?? return null
    return found.clone()
}

fn prover_cached_foreign(map: ref collections::BTreeMap[String, Foreign?], key: ref String) -> Foreign? {
    let found = map[key] ?? return null
    return found.clone()
}

/// **The calls with arguments the build knows that `expr` reads** (ADR-359
/// D11): each call in it whose callee is a function by name that hands back
/// a whole number and whose arguments [`folded_whole`] gives, and the calls
/// the bindings it reads hold. Each is kept in the walk's state by
/// `call_result_name`, with its callee and its arguments' values.
fn prover_known_calls(mut walk: ProverWalk, expr: ref Expr, scope: ref ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[SolverTerm] sync) -> collections::BTreeSet[String] {
    let mut found: collections::BTreeSet[String] = collections::BTreeSet()
    for one in visited_in_expr(expr) {
        match one {
            Expr::Call { func, args, config, .. } => {
                let callee = prover_bound_callee(func, scope, words, unaliased)
                if callee != null && config.is_empty() {
                    let c = callee ?? ""
                    let mut values: Vec[i64] = []
                    let mut all = true
                    for arg in args {
                        let v = folded_whole(arg, words, fn(n) { prover_pinned(walk.state.pinned, scope, n) })
                        if v == null {
                            all = false
                        } else {
                            values.push(v ?? 0)
                        }
                    }
                    if all && prover_returns_whole(walk, c, program, words, own, condition) {
                        let name = call_result_name(one)
                        walk.state.call_sites.insert(name.clone(), one.clone())
                        walk.state.call_args.insert(name.clone(), (c.clone(), values))
                        found.insert(name)
                    }
                }
            },
            else => {},
        }
    }
    if scope.calls_of.is_empty() {
        return found
    }
    let read = claim_names_in(expr, words, holes_of)
    for (bound, calls) in scope.calls_of {
        if read.contains(bound) {
            for call in calls {
                found.insert(call.clone())
            }
        }
    }
    return found
}

/// What a claim comes to once the calls it reads were asked of the build.
struct ProverRan {
    held: ClaimHeld,
    findings: Vec[Finding],
}

/// **A claim and the calls with known arguments it reads** (ADR-359 D11-D13):
/// where it is still checked at run time, a call not run yet is wanted - the
/// compiler runs it and walks again -, a call that could not run says why
/// (D12), and one whose run stopped is a check the compiler shows fails
/// (`NK1207`). A refusal names the value of each call it read.
fn prover_claim_ran(mut walk: ProverWalk, read: ref collections::BTreeSet[String], held: ClaimHeld, findings: Vec[Finding], written: String, span: Span, written_of: fn(ref Expr) -> String sync) -> ProverRan {
    let mut out = ProverRan { held: held.clone(), findings: [] }
    let mut values: Vec[String] = []
    for call in read {
        let text = written_of(walk.state.call_sites[call] ?? continue)
        let value = walk.state.pinned[call]
        if value != null {
            values.push(f"`{text}` is {value ?? 0}, run while the program was built")
        }
    }
    let joined = values.join("; ")
    for found in findings {
        let mut one = found.clone()
        if one.code == "NK1207" && !values.is_empty() {
            one.notes.push(f"{joined}.")
        }
        out.findings.push(one)
    }
    let open = prover_open_reason(held) ?? return out
    // A claim what is known already rules out needs no run.
    if open.starts_with("it is false") {
        return out
    }
    let mut why = open.clone()
    for call in read {
        if walk.state.pinned[call] != null {
            continue
        }
        let text = written_of(walk.state.call_sites[call] ?? continue)
        let stop = walk.state.stopped[call]
        if stop != null {
            let words_said = (stop ?? "").clone()
            if !walk.state.collecting {
                out.findings.push(Finding {
                    code: "NK1207",
                    span: span,
                    message: f"`{text}` stops the program every time it is reached, before `{written}` is checked.",
                    notes: [f"The compiler ran `{text}` while the program was built, as the program runs it, and it stopped: {words_said}."],
                    help: "Fix the call, or the function it calls, as you would fix the program stopping there.",
                    warning: false,
                    labels: [],
                })
            }
            why = f"{why}; `{text}` stops the program: {words_said}"
            continue
        }
        let not = walk.state.not_run[call]
        if not != null {
            let because = (not ?? "").clone()
            why = f"{why}; `{text}` was not run while the program was built: {lowered_first(without_full_stops(because))}"
            continue
        }
        walk.state.wanted.insert(call.clone())
    }
    out.held = ClaimHeld::AtRunTime(why)
    return out
}

/// Why a claim is checked at run time, where it is.
fn prover_open_reason(held: ref ClaimHeld) -> String? {
    return match held {
        ClaimHeld::AtRunTime(why) => why.clone(),
        else => null,
    }
}
