// crates/nikaia-std/src/tools/types.nika
//
// Part I 2.2 and Part III C.1: **a type nothing declares is refused here
// rather than lowered** (ADR-096), and the names a file declares are declared
// once (`NK1148`). Moved from the compiler's `types` (ADR-294, #125). What the
// file declares as types and what an `impl`'s target makes a type parameter
// are the compiler's `contracts`' answers, handed in.

use std::collections

// The bounds `T: Struct` and `T: Enum` name a shape, not a trait.
comptime SHAPE_BOUNDS: Array[ref String, 2] = ["Struct", "Enum"]

// The bounds `T: Eq` and `T: Ord` name what a type can do, and the language
// answers them (ADR-341), as it does the two above.
comptime STANDARD_BOUNDS: Array[ref String, 2] = ["Eq", "Ord"]

// Types every program has without declaring them.
comptime BUILT_IN: Array[ref String, 28] = ["int", "i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128", "usize", "f32", "f64", "bool", "char", "scalar", "String", "str", "Self", "Vec", "Shared", "SharedMut", "Locked", "TaskHandle", "Array", "Bytes"]

// **The integer widths the language does not offer** (Part I 2.2): Rust's,
// written only where the representation shows - an `extern "C"` declaration.
comptime UNOFFERED_WIDTHS: Array[ref String, 7] = ["usize", "isize", "i8", "i16", "u16", "i128", "u128"]

// The modules of `std` a type may live in.
comptime STD_MODULES: Array[ref String, 7] = ["cli", "collections", "channel", "foreign", "fs", "io", "time"]

/// Every name declared twice, every bound naming no trait, and every written
/// type nothing declares. `declared` is the types the file declares;
/// `impl_parameters` holds, beside each item, what an `impl`'s target makes a
/// type parameter (empty for every other item).
pub fn types_checked(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]], own: ref Ledger, library: ref Ledger, declared: ref collections::BTreeSet[String], impl_parameters: ref Vec[Vec[String]], views: ref collections::BTreeSet[String]) -> Vec[Finding] {
    let mut found: Vec[Finding] = []
    declared_once_in(names, items, found)
    let known = known_names(own, library, declared)
    let traits = known_traits(names, items, own, library)
    let plain = types_plain_enums(names, items)
    for k in 0..<items.len() {
        let mut here = known.clone()
        for parameter in generic_names(names, items[k].node) {
            here.insert(parameter)
        }
        for parameter in impl_parameters[k] {
            here.insert(parameter.clone())
        }
        bounds_of(names, items[k].node, traits, items[k].span, found)
        item_types(names, items[k].node, here, plain, views, "", items[k].span, found)
        inherent_at_home(names, items[k].node, library, declared, items[k].span, found)
    }
    return found
}

// **`NK1209`: an `impl` with no trait on a type the program does not declare**
// (#375). Rust's rule forbids it - a type's own methods are its crate's - and
// the program would otherwise come back as `rustc`'s words about generated
// code (Part III C.1). Asked of a built-in type, one a `std` ledger declares,
// and one written with a module in front; a bare name nothing declares is
// `NK1135`'s.
fn inherent_at_home(names: ref winnow_grammar::InternerContext, item: ref Item, library: ref Ledger, declared: ref collections::BTreeSet[String], span: ref Span, mut out: Vec[Finding]) {
    let target = match item {
        Item::Impl { trait_name, target, .. } => if trait_name == null { names.resolve(target.name).clone() } else { return },
        else => return,
    }
    if declared.contains(target) || target == "Self" { return }
    let foreign = target.contains("::") || BUILT_IN.contains(target) || library.types.contains_key(target)
    if !foreign { return }
    out.push(refusal("NK1209", span.clone(), f"You can't add methods to `{target}` with `impl {target}`: your program doesn't declare it.", ["A type's own methods belong to the code that declares the type, so an `impl` without a trait works only on your own `struct` or `enum`."], f"Declare a trait and implement it for the type: `trait Doubled {{ fn doubled(self) -> ... }}` and `impl Doubled for {target} {{ ... }}`."))
}

// Every trait a bound may name: the shapes, the traits a ledger knows - by
// key and by its last segment - and the ones this file declares.
fn known_traits(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]], own: ref Ledger, library: ref Ledger) -> collections::BTreeSet[String] {
    let mut known: collections::BTreeSet[String] = collections::BTreeSet()
    for shape in SHAPE_BOUNDS {
        known.insert(shape.clone())
    }
    for standard in STANDARD_BOUNDS {
        known.insert(standard.clone())
    }
    for (key, _) in own.traits {
        with_its_last_segment(key, known)
    }
    for (key, _) in library.traits {
        with_its_last_segment(key, known)
    }
    for item in items {
        match item.node {
            Item::Trait { name, .. } => {
                known.insert(names.resolve(name).clone())
            }
            else => {}
        }
    }
    return known
}

// `key`, and what stands after its last `::`.
fn with_its_last_segment(key: ref String, mut known: collections::BTreeSet[String]) {
    known.insert(key.clone())
    let c: Vec[scalar] = key.chars().collect()
    let mut last = -1
    for at in 0..<c.len() {
        if at + 1 < c.len() && c[at] == ':' && c[at + 1] == ':' {
            last = at
        }
    }
    if last >= 0 {
        known.insert(slice(c, last + 2, c.len()))
    }
}

// Every name a written type may be: built in, a type of `std`, a type a
// ledger of this package knows - by key and by its last segment - and the
// types this file declares.
fn known_names(own: ref Ledger, library: ref Ledger, declared: ref collections::BTreeSet[String]) -> collections::BTreeSet[String] {
    let mut known: collections::BTreeSet[String] = collections::BTreeSet()
    for name in BUILT_IN {
        known.insert(name.clone())
    }
    for (key, _) in library.types {
        known.insert(key.clone())
    }
    for (key, _) in own.types {
        with_its_last_segment(key, known)
    }
    for name in declared {
        known.insert(name.clone())
    }
    return known
}

// The type parameters a function or a struct declares.
fn generic_names(names: ref winnow_grammar::InternerContext, item: ref Item) -> Vec[String] {
    let mut out: Vec[String] = []
    match item {
        Item::Fn { generics, .. } => {
            for parameter in generics {
                out.push(names.resolve(parameter.name).clone())
            }
        }
        Item::Struct { generics, .. } => {
            for parameter in generics {
                out.push(names.resolve(parameter.name).clone())
            }
        }
        else => {}
    }
    return out
}

// A bound with no `::` in it names a trait this file can see.
fn bounds_of(names: ref winnow_grammar::InternerContext, item: ref Item, traits: ref collections::BTreeSet[String], span: ref Span, mut out: Vec[Finding]) {
    match item {
        Item::Fn { generics, .. } => bounds_in(names, generics, traits, span, out),
        Item::Struct { generics, .. } => bounds_in(names, generics, traits, span, out),
        else => {}
    }
}

fn bounds_in(names: ref winnow_grammar::InternerContext, generics: ref Vec[GenericParam], traits: ref collections::BTreeSet[String], span: ref Span, mut out: Vec[Finding]) {
    for parameter in generics {
        for bound in parameter.bounds {
            let name = names.resolve(bound.clone()).clone()
            if !name.contains("::") && !traits.contains(name) {
                out.push(refusal("NK1135", span.clone(), f"There's no trait called `{name}`.", ["A bound names a trait the caller's type has to implement, and no trait by this name is declared."], f"Declare `{name}` with `trait`, or remove the bound. (Without a bound, the value can only be moved and passed on.)"))
            }
        }
    }
}

// **A name means one thing** (`NK1148`): a `fn`, a `struct`, an `enum`, a
// `trait` and a `grammar` declare a name, and the second declaration of one
// is refused where it stands.
fn declared_once_in(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]], mut out: Vec[Finding]) {
    let mut seen: collections::BTreeMap[String, String] = collections::BTreeMap()
    for item in items {
        let kind = kind_declared(item.node)
        if kind.len() == 0 {
            continue
        }
        let name = name_declared(names, item.node)
        if name.len() == 0 {
            continue
        }
        let earlier: String? = seen[name]?.clone()
        if earlier == null {
            seen.insert(name, kind)
            continue
        }
        let first = earlier ?? continue
        let kinds = if first == kind { f"both times as a `{first}`" } else { f"once as a `{first}` and once as a `{kind}`" }
        out.push(refusal("NK1148", item.span.clone(), f"`{name}` is declared twice in this file, {kinds}.", ["A name means one thing, so there's never a question of which declaration wins. All files of a package share their names for the same reason."], f"Rename one of the two. (A `struct`'s name is already its constructor, so `{name}` can't also be a function.)"))
    }
}

// What an item declares a name as, or nothing.
fn kind_declared(item: ref Item) -> String {
    return match item {
        Item::Fn { name, .. } => if name != null { "fn" } else { "" },
        Item::Struct { .. } => "struct",
        Item::Enum { .. } => "enum",
        Item::Trait { .. } => "trait",
        Item::Grammar(_) => "grammar",
        else => "",
    }
}

// The name an item declares, or nothing.
fn name_declared(names: ref winnow_grammar::InternerContext, item: ref Item) -> String {
    return match item {
        Item::Fn { name, .. } => a_symbols_text(names, name),
        Item::Struct { name, .. } => names.resolve(name).clone(),
        Item::Enum { name, .. } => names.resolve(name).clone(),
        Item::Trait { name, .. } => names.resolve(name).clone(),
        Item::Grammar(def) => names.resolve(def.name).clone(),
        else => "",
    }
}

// What a name that may be missing says, or nothing.
fn a_symbols_text(names: ref winnow_grammar::InternerContext, name: winnow_grammar::Symbol?) -> String {
    let symbol = name ?? return ""
    return names.resolve(symbol).clone()
}

// Every type an item writes.
fn item_types(names: ref winnow_grammar::InternerContext, item: ref Item, known: ref collections::BTreeSet[String], plain: ref collections::BTreeSet[String], views: ref collections::BTreeSet[String], owner: String, span: ref Span, mut out: Vec[Finding]) {
    match item {
        Item::Fn { name, args, config, ret_type, body, is_extern, .. } => {
            // The key `text_tiers` records a decided position by (`TextOwner`).
            let mut key = owner.clone()
            if name != null {
                key.push_str(names.resolve(name ?? return))
            } else {
                key.push_str("new")
            }
            let mut at = 0
            for arg in args {
                written_at(names, arg.ty, known, true, span, out)
                widths_written(names, arg.ty, is_extern, span, out)
                if !is_extern {
                    types_word_by_ref(names, arg.ty, plain, "parameter", span, out)
                    types_text_by_ref(names, arg.ty, "parameter", views, f"param {key} {at}", span, out)
                }
                at += 1
            }
            // An option is a parameter (Part I 5.1): its type is read as one.
            for option in config {
                written_at(names, option.ty, known, true, span, out)
                widths_written(names, option.ty, is_extern, span, out)
                if !is_extern {
                    types_word_by_ref(names, option.ty, plain, "parameter", span, out)
                    types_text_by_ref(names, option.ty, "parameter", views, "", span, out)
                }
            }
            maybe_written(names, ret_type, known, span, out)
            widths_written_maybe(names, ret_type, is_extern, span, out)
            if !is_extern {
                types_word_by_ref_maybe(names, ret_type, plain, span, out)
                types_text_by_ref_maybe(names, ret_type, "result", views, f"result {key}", span, out)
            }
            block_types(names, body, known, views, out)
        }
        Item::Struct { name, fields, is_extern, .. } => {
            let of = names.resolve(name).clone()
            for field in fields {
                written_at(names, field.ty, known, false, span, out)
                widths_written(names, field.ty, is_extern, span, out)
                types_word_by_ref(names, field.ty, plain, "field", span, out)
                if !is_extern {
                    types_text_by_ref(names, field.ty, "field", views, f"field {of} {names.resolve(field.name)}", span, out)
                }
            }
        }
        Item::Enum { name, variants, is_extern, .. } => {
            let of = names.resolve(name).clone()
            for variant in variants {
                match variant.fields {
                    VariantFields::Unit => {}
                    VariantFields::Tuple(parts) => {
                        let mut at = 0
                        for ty in parts {
                            written_at(names, ty, known, false, span, out)
                            widths_written(names, ty, false, span, out)
                            // A payload is a position as a field is (#680).
                            if !is_extern {
                                types_text_by_ref(names, ty, "payload", views, f"variant {of} {names.resolve(variant.name)} {at}", span, out)
                            }
                            at += 1
                        }
                    }
                    VariantFields::Named(fields) => {
                        for field in fields {
                            written_at(names, field.ty, known, false, span, out)
                            widths_written(names, field.ty, false, span, out)
                        }
                    }
                }
            }
        }
        Item::Extern { declarations, .. } => {
            for declaration in declarations {
                for arg in declaration.node.args {
                    written_foreign(names, arg.ty, known, true, declaration.span, out)
                    widths_written(names, arg.ty, true, declaration.span, out)
                }
                maybe_written_foreign(names, declaration.node.ret_type, known, declaration.span, out)
                widths_written_maybe(names, declaration.node.ret_type, true, declaration.span, out)
            }
        }
        Item::Trait { methods, .. } => {
            for method in methods {
                let mut here = known.clone()
                for parameter in method.node.generics {
                    here.insert(names.resolve(parameter.name).clone())
                }
                for arg in method.node.args {
                    written_at(names, arg.ty, here, true, method.span, out)
                    widths_written(names, arg.ty, false, method.span, out)
                    types_word_by_ref(names, arg.ty, plain, "parameter", method.span, out)
                    types_text_by_ref(names, arg.ty, "parameter", views, "", method.span, out)
                }
                maybe_written(names, method.node.ret_type, here, method.span, out)
                widths_written_maybe(names, method.node.ret_type, false, method.span, out)
                types_word_by_ref_maybe(names, method.node.ret_type, plain, method.span, out)
                types_text_by_ref_maybe(names, method.node.ret_type, "result", views, "", method.span, out)
            }
        }
        Item::Impl { target, methods, .. } => {
            let prefix = f"{names.resolve(target.name)}::"
            for method in methods {
                let mut here = known.clone()
                for parameter in generic_names(names, method.node) {
                    here.insert(parameter)
                }
                item_types(names, method.node, here, plain, views, prefix, method.span, out)
            }
        }
        else => {}
    }
}

// **`ref` on a word by its kind says nothing** (ADR-354 D2): a number, a
// `bool` or a `scalar` is copied at a read, so a parameter, a field or a
// result written `ref i64` is `NK1257` outside the C boundary. A `let` is
// refused where its value is read (`check_core_stmt`).
fn types_word_by_ref(names: ref winnow_grammar::InternerContext, ty: ref Type, plain: ref collections::BTreeSet[String], position: ref String, span: ref Span, mut out: Vec[Finding]) {
    if !ty.is_view || ty.is_mut || ty.is_slice || ty.is_tuple || ty.generics.len() > 0 {
        return
    }
    let name = names.resolve(ty.name).clone()
    let words = ["int", "i8", "i16", "i32", "i64", "i128", "u8", "u16", "u32", "u64", "u128", "isize", "usize", "f32", "f64", "bool", "scalar"]
    let mut a_word = plain.contains(name)
    for word in words {
        if word == name {
            a_word = true
        }
    }
    if !a_word {
        return
    }
    let mut written = name.clone()
    if ty.is_nullable {
        written = f"{name}?"
    }
    out.push(refusal("NK1257", span.clone(), f"A `{name}` is copied at a read, so a {position} can't be a `ref {written}`.", ["A number, a `bool`, a `scalar` and an enum whose variants hold nothing are copied at a read (ADR-279 D8): the copy is never dearer than a pointer, so `ref` on one says nothing. Only an `extern \"C\"` declaration writes it, as the pointer C expects.".clone()], f"Write `{written}` without `ref`; a parameter the function changes is `mut name: {written}`."))
}

fn types_word_by_ref_maybe(names: ref winnow_grammar::InternerContext, ty: ref Type?, plain: ref collections::BTreeSet[String], span: ref Span, mut out: Vec[Finding]) {
    types_word_by_ref(names, ty ?? return, plain, "result", span, out)
}

// **`ref String` inside Nikaia says what `String` says** (ADR-282 D2): text
// is a view wherever a view suffices, and the ledger records what a published
// signature lends and keeps, so `ref` on text written on a parameter, a field,
// a result, a variant's payload or a `let` outside the C boundary is the
// warning `NK1261`. The program means what it means with `String`, and is
// still held to the view.
fn types_text_by_ref(names: ref winnow_grammar::InternerContext, ty: ref Type, position: String, views: ref collections::BTreeSet[String], key: String, span: ref Span, mut out: Vec[Finding]) {
    // A position `text_tiers` made a view was written `String`.
    if views.contains(key) {
        return
    }
    if !ty.is_view || ty.is_mut || ty.is_slice || ty.is_tuple || ty.generics.len() > 0 {
        return
    }
    if names.resolve(ty.name) != "String" {
        return
    }
    let mut written: String = "String"
    if ty.is_nullable {
        written = "String?"
    }
    out.push(Finding { code: "NK1261", span: span.clone(), message: f"`ref` is redundant here: a {position} written `ref {written}` says what `{written}` already says.", notes: ["Text is a view wherever a view suffices, and the ledger records whether a published parameter is lent or kept and what a result points into (ADR-282 D2). Only an `extern \"C\"` declaration and a `pub extern fn` write `ref String`, as the pointer C expects.".clone()], help: f"Write `{written}` without `ref`.", warning: true, labels: [] })
}

fn types_text_by_ref_maybe(names: ref winnow_grammar::InternerContext, ty: ref Type?, position: String, views: ref collections::BTreeSet[String], key: String, span: ref Span, mut out: Vec[Finding]) {
    types_text_by_ref(names, ty ?? return, position, views, key, span, out)
}

// The program's enums whose variants hold nothing: words by their kind too.
fn types_plain_enums(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]]) -> collections::BTreeSet[String] {
    let mut plain: collections::BTreeSet[String] = collections::BTreeSet()
    for item in items {
        match item.node {
            Item::Enum { name, variants, .. } => {
                let mut holds = false
                for variant in variants {
                    match variant.fields {
                        VariantFields::Unit => {}
                        else => {
                            holds = true
                        }
                    }
                }
                if !holds {
                    plain.insert(names.resolve(name).clone())
                }
            }
            else => {}
        }
    }
    return plain
}

// **An integer's width where it is written** (Part I 2.2, ADR-285 D38): Rust's
// other widths only at the C boundary (`NK1135` elsewhere), and `int`, whose
// representation is the compiler's choice, never there (`NK1262`).
fn widths_written(names: ref winnow_grammar::InternerContext, ty: ref Type, at_c: bool, span: ref Span, mut out: Vec[Finding]) {
    let name = names.resolve(ty.name).clone()
    if at_c && name == "int" {
        out.push(refusal("NK1262", span.clone(), "`int` can't be written where C sees the value.", ["An `int` holds the values of an `i64`, but how it is stored is the compiler's choice (ADR-285 D37); C reads the bytes, so the width has to be written."], "Write `i64` here, or the fixed width the C side declares."))
        return
    }
    if !at_c && UNOFFERED_WIDTHS.contains(name) {
        out.push(refusal("NK1135", span.clone(), f"There's no type called `{name}`.", ["Nikaia's integers are `int` and the fixed widths `i64`, `i32`, `u8`, `u32` and `u64` (Part I 2.2); Rust's other widths are written only in an `extern \"C\"` declaration."], "Write `int` for an ordinary number, or the fixed width that holds the values."))
        return
    }
    for argument in ty.generics {
        widths_written(names, argument, at_c, span, out)
    }
    widths_written_maybe(names, ty.code?.result, at_c, span, out)
}

fn widths_written_maybe(names: ref winnow_grammar::InternerContext, ty: ref Type?, at_c: bool, span: ref Span, mut out: Vec[Finding]) {
    widths_written(names, ty ?? return, at_c, span, out)
}

fn maybe_written(names: ref winnow_grammar::InternerContext, ty: ref Type?, known: ref collections::BTreeSet[String], span: ref Span, mut out: Vec[Finding]) {
    written_at(names, ty ?? return, known, false, span, out)
}

fn maybe_written_foreign(names: ref winnow_grammar::InternerContext, ty: ref Type?, known: ref collections::BTreeSet[String], span: ref Span, mut out: Vec[Finding]) {
    written_foreign(names, ty ?? return, known, false, span, out)
}

// The types a body writes on its `let`s, its nested blocks included.
fn block_types(names: ref winnow_grammar::InternerContext, block: ref Block, known: ref collections::BTreeSet[String], views: ref collections::BTreeSet[String], mut out: Vec[Finding]) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { ty, value, .. } => {
                maybe_written(names, ty, known, stmt.span, out)
                types_text_by_ref_maybe(names, ty, "`let`", views, f"let {stmt.span.start}", stmt.span, out)
                widths_written_maybe(names, ty, false, stmt.span, out)
                blocks_types(names, value, known, views, out)
            }
            Stmt::Comptime { value, .. } => blocks_types(names, value, known, views, out),
            Stmt::Expr(value) => blocks_types(names, value, known, views, out),
            Stmt::Return(value) => blocks_types(names, value ?? continue, known, views, out),
            Stmt::Assign { target, value, .. } => {
                blocks_types(names, target, known, views, out)
                blocks_types(names, value, known, views, out)
            }
            Stmt::For { body, .. } => block_types(names, body, known, views, out),
            Stmt::While { body, .. } => block_types(names, body, known, views, out),
            else => {}
        }
    }
}

// The blocks an expression holds, a lambda passed as an argument included.
fn blocks_types(names: ref winnow_grammar::InternerContext, expr: ref Expr, known: ref collections::BTreeSet[String], views: ref collections::BTreeSet[String], mut out: Vec[Finding]) {
    match expr {
        Expr::Block(block, _) => block_types(names, block, known, views, out),
        Expr::Unsafe(block, _) => block_types(names, block, known, views, out),
        Expr::Overlap(block, _) => block_types(names, block, known, views, out),
        Expr::Closure { body, .. } => block_types(names, body, known, views, out),
        Expr::Call { func, args, config, .. } => {
            blocks_types(names, func, known, views, out)
            for arg in args {
                blocks_types(names, arg, known, views, out)
            }
            for setting in config {
                blocks_types(names, setting.value, known, views, out)
            }
        }
        Expr::MethodCall { receiver, args, config, .. } => {
            blocks_types(names, receiver, known, views, out)
            for arg in args {
                blocks_types(names, arg, known, views, out)
            }
            for setting in config {
                blocks_types(names, setting.value, known, views, out)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            blocks_types(names, receiver, known, views, out)
            for arg in args {
                blocks_types(names, arg, known, views, out)
            }
            for setting in config {
                blocks_types(names, setting.value, known, views, out)
            }
        }
        Expr::If { then_branch, else_branch, .. } => {
            block_types(names, then_branch, known, views, out)
            block_types(names, else_branch ?? return, known, views, out)
        }
        Expr::TryCatch { expr, handler, .. } => {
            blocks_types(names, expr, known, views, out)
            block_types(names, handler, known, views, out)
        }
        Expr::Match { arms, .. } => {
            for arm in arms {
                blocks_types(names, arm.body, known, views, out)
            }
        }
        Expr::Select(arms, _) => {
            for arm in arms {
                block_types(names, arm.body, known, views, out)
            }
        }
        else => {}
    }
}

// A type written at the C boundary: a slice is its element, and a `&mut`
// the boundary's own is checked as the type it points at.
fn written_foreign(names: ref winnow_grammar::InternerContext, ty: ref Type, known: ref collections::BTreeSet[String], a_parameter: bool, span: ref Span, mut out: Vec[Finding]) {
    if ty.is_slice && ty.generics.len() > 0 {
        written_at(names, ty.generics[0], known, false, span, out)
        return
    }
    written_at_the_boundary(names, ty, known, a_parameter, true, span, out)
}

// One written type, and the types inside it. A parameter is the one place an
// `Array[T]` with no length may stand: each call supplies the length.
fn written_at(names: ref winnow_grammar::InternerContext, ty: ref Type, known: ref collections::BTreeSet[String], a_parameter: bool, span: ref Span, mut out: Vec[Finding]) {
    written_at_the_boundary(names, ty, known, a_parameter, false, span, out)
}

// The same, where `at_c` says the type stands at the C boundary: a `ref mut`
// there is the boundary's own, and checked as the type it points at.
fn written_at_the_boundary(names: ref winnow_grammar::InternerContext, ty: ref Type, known: ref collections::BTreeSet[String], a_parameter: bool, at_c: bool, span: ref Span, mut out: Vec[Finding]) {
    if ty.is_mut && !at_c {
        out.push(refusal("NK1158", span.clone(), "`ref mut` can only be used when talking to C.", ["`ref mut` is only for `extern \"C\"` declarations. Everywhere else, Nikaia has its own way to say it."], "Put `mut` in front of the name instead: `fn fill(mut out: Vec[i64])`."))
        return
    }
    let name = names.resolve(ty.name).clone()
    // **There is no `char`** (ADR-320, Part I 2.6): one character of text is
    // a `scalar`, and one byte of it a `u8`. A ledger may still write the old
    // word (`ty.nika` reads it as `scalar`); a program's own type may not.
    if name == "char" {
        out.push(refusal("NK1135", span.clone(), "There's no type called `char`.", ["One Unicode character is a `scalar`, and one byte of text is a `u8`: which of the two a character is depends on how the text is read (Part I 2.6)."], "Write `scalar` for a character, or `u8` for a byte."))
        return
    }
    if !a_parameter && !ty.is_view && !ty.is_slice && ty.count == null && ty.generics.len() == 1 && name == "Array" {
        let element = names.resolve(ty.generics[0].name).clone()
        out.push(refusal("NK1182", span.clone(), f"`Array[{element}]` needs a length here.", [f"`Array[{element}]` without a length only works for a parameter, where each call supplies the length. A field or a result has no call to take it from."], f"Use `Vec[{element}]` for a list that can grow, `ref Array[{element}]` to look at elements something else keeps, or `Array[{element}, N]` to write the length down."))
        return
    }
    if ty.count != null {
        return
    }
    if ty.is_slice {
        for argument in ty.generics {
            written_at(names, argument, known, false, span, out)
        }
        return
    }
    if !ty.is_tuple && ty.code == null && !known.contains(name) && !name.contains("::") {
        out.push(nothing_declares(name, known, span))
    }
    for argument in ty.generics {
        written_at(names, argument, known, false, span, out)
    }
    maybe_written(names, ty.code?.result, known, span, out)
}

// `NK1135` for a type, and where a module of `std` has one by the name, the
// module it is in.
fn nothing_declares(name: ref String, known: ref collections::BTreeSet[String], span: ref Span) -> Finding {
    let module = std_module_of(name, known)
    if module.len() > 0 {
        return refusal("NK1135", span.clone(), f"`{name}` needs its module in front of it.", [f"Its full name is `{module}::{name}`: a type from a module is written with the module's name."], f"Write `use std::{module}` at the top of the file, and `{module}::{name}` here.")
    }
    return refusal("NK1135", span.clone(), f"There's no type called `{name}`.", ["A type is either built in, declared in your program with `struct` or `enum`, provided by `std`, or a type parameter."], f"Check the spelling, or declare `{name}` with `struct` or `enum`.")
}

/// **Whether nothing this compiler reads knows a type by this name**
/// ([ADR-204](../../../../docs/specification/adr/adr-204.md) D1, #379): it is
/// not built in, no ledger has an entry for it, and - written with a module in
/// front - no ledger knows that module either. A type the program declares is
/// the caller's to rule out first.
///
/// Such a name is already another refusal's business - `NK1135` for a bare one,
/// `NK2504` or `rustc` for a module nobody declared - so a question asked
/// about it, such as whether it compares, gets the answer an absent claim
/// gets (Part III C.4) rather than a second refusal naming the wrong cause.
/// A name some ledger knows is never this: there, an absent column is *no*.
pub fn nobody_knows(name: ref String, own: ref Ledger, library: ref Ledger) -> bool {
    if BUILT_IN.contains(name) || own.types.contains_key(name) || library.types.contains_key(name) {
        return false
    }
    let c: Vec[scalar] = name.chars().collect()
    let mut last = -1
    for at in 0..<c.len() {
        if at + 1 < c.len() && c[at] == ':' && c[at + 1] == ':' {
            last = at
        }
    }
    // A bare name: known where a ledger has it under a module.
    let wanted = if last < 0 { f"::{name}" } else { f"{slice(c, 0, last)}::" }
    for ledger in [own, library] {
        for (key, _) in ledger.types {
            if (last < 0 && key.ends_with(ref wanted)) || (last >= 0 && key.starts_with(ref wanted)) {
                return false
            }
        }
        for (key, _) in ledger.functions {
            if last >= 0 && key.starts_with(ref wanted) {
                return false
            }
        }
    }
    return true
}

// The module of the first known key ending in `::name`, where that module is
// one of `std`'s; otherwise nothing.
fn std_module_of(name: ref String, known: ref collections::BTreeSet[String]) -> String {
    let ending = f"::{name}"
    for key in known {
        if key.ends_with(ref ending) {
            let c: Vec[scalar] = key.chars().collect()
            let at = find_text(c, 0, "::")
            let module = slice(c, 0, at)
            for one in STD_MODULES {
                if module == one {
                    return module
                }
            }
            return ""
        }
    }
    return ""
}
