// crates/nikaia-std/src/tools/manifest.nika
//
// **What `nikaia.toml` may say, and what each key does** (ADR-037 D5,
// ADR-002 D1, ADR-286 D15, Part III 13.3).
//
// The seventh piece of the compiler moved from Rust to Nikaia, by ADR-290's
// route and on ADR-294's road: lowered ahead of time by `nikaia lower-std` to
// `manifest.rs` beside it, `include!`d as `nikaia_std::tools::manifest`, and
// called from the compiler's `Manifest::parse`.
//
// **The `toml` crate stays behind the adapter** (ADR-294): the compiler
// reads the file with it and hands this module keys, table names and the words
// a value says - plain text. What moved is every decision the manifest makes:
// which `[build]` keys exist, which have moved and which are withdrawn, which
// machines a `[build.<target>]` table may name and what it may carry, and which
// of the three shapes a dependency is.
//
// **And the manifest itself** (MF): `ManifestFile` is what the compiler's
// `Manifest` holds, built here by `manifest_parse` from the `ManifestItem`s the
// adapter reads off the document, every TOML value as its text.

use std::collections
use std::fs

/// What a `[build]` key does with its value.
pub enum Switch {
    /// Carried to the parser that owns the setting, as written.
    Kept,
    /// Accepted and read by nothing here: the note says where it went.
    Moved(String),
}

/// The keys `[build]` may carry. A key outside these is a typo until proven
/// otherwise, and saying so beats a switch that silently stayed at its
/// default: `user_parallelism` with an underscore is the mistake this catches.
/// Part I 1.2 names the options rather than counting them, and this list is
/// what a manifest is checked against.
pub fn known() -> Vec[String] {
    return ["target", "user-parallelism", "reentrancy-check", "cleanup-deadline", "optimization", "refuted-claims", "unproved-claims", "artifact", "symbol-prefix"]
}

// A key this compiler had and no longer has, with what to do instead, or
// nothing. A withdrawn key decides **nothing anywhere**, and a build that
// ignored it would run a program that differs from the file describing it.
// `ordering` is ADR-292 D7: it turned off the reordering D1 withdrew.
fn withdrawn(key: ref String) -> String {
    if key == "ordering" {
        return "statements run in the order they are written, so there's nothing left for it to turn off. To run two things together, write `overlap { … }`; `--overlaps` shows which branches did"
    }
    return ""
}

// A key the manifest still accepts and the compiler no longer reads, with where
// it went, or nothing. `cleanup-deadline` is ADR-303 D5's move: how long a
// program waits at exit is an operating property, tuned by whoever runs it.
fn moved(key: ref String) -> String {
    if key == "cleanup-deadline" {
        return "the runtime configuration file `nikaia-runtime.toml`, which is read when the program starts. How long a program waits at exit is set by whoever runs it, and the compiler no longer reads this key"
    }
    return ""
}

/// What a `[build]` key does: kept, moved with a note, or refused - as
/// withdrawn in its own words, or as a typo naming the keys there are.
pub fn build_key(key: ref String) -> Switch throws {
    let gone = withdrawn(key)
    if gone.len() > 0 {
        throw Refused::Because(f"`{key}` in `[build]` is no longer supported: {gone}")
    }
    if !contains(known(), key) {
        let expected = choices(known())
        throw Refused::Because(f"`[build]` has no key called `{key}`. The keys are: {expected}.")
    }
    let went = moved(key)
    if went.len() > 0 {
        return Switch::Moved(f"`{key}` in `[build]` has moved to {went}")
    }
    return Switch::Kept
}

/// The machines a `[build.<target>]` table may name (ADR-037 D1). A table for
/// a target that does not exist is codegen nothing will ever apply.
pub fn targets() -> Vec[String] {
    return ["x86_64-linux", "aarch64-linux", "wasm32-unknown"]
}

/// What a `[build.<target>]` table may carry (Part III 13.3). Same rule as
/// `[build]`: a silently ignored `opt_level` leaves a build at a setting its
/// author believed they had changed. `incremental` and `debug` are ADR-002 D5,
/// `codegen-units` D6.
pub fn codegen_keys() -> Vec[String] {
    return ["opt-level", "lto", "codegen-units", "incremental", "debug"]
}

/// `codegen-units` is a whole number from 1 (ADR-002 D6), or is refused
/// saying so. `units` is the value where it is a whole number; `written` is
/// the value as the manifest has it.
pub fn codegen_units(target: ref String, units: i64?, written: String) throws {
    if (units ?? 0) < 1 {
        throw Refused::Because(f"`codegen-units` in `[build.{target}]` is a whole number from 1, the number of pieces rustc cuts each crate into, not `{written}`.")
    }
}

/// `[build.<target>]` names a machine, or is refused naming the ones there are.
pub fn codegen_table(target: ref String) throws {
    if !contains(targets(), target) {
        let expected = choices(targets())
        throw Refused::Because(f"`[build.{target}]` isn't a machine Nikaia builds for. The machines are: {expected}.")
    }
}

/// A key of `[build.<target>]` is one it may carry, or is refused.
pub fn codegen_key(target: ref String, key: ref String) throws {
    if !contains(codegen_keys(), key) {
        let expected = choices(codegen_keys())
        throw Refused::Because(f"`[build.{target}]` has no key called `{key}`. The keys are: {expected}.")
    }
}

/// Which of the three shapes a `[dependencies]` entry is (ADR-002 D1,
/// ADR-286 D15).
pub enum DependencyShape {
    /// `type = "rust"`: a crate, handed to Cargo without the marker.
    Rust,
    /// `path = "…"`: a Nikaia package, read as part of this program.
    Path,
    /// Any other way of naming a Nikaia package: carried to the place that
    /// refuses it, with the reason, since nothing has decided a registry.
    Nikaia,
}

/// The shape of dependency `name`, from the `type` it says (where `typed`)
/// and whether it says a `path`. A `type` other than `rust` names no
/// ecosystem, and is refused rather than guessed at.
pub fn dependency(name: ref String, typed: bool, kind: ref String, has_path: bool) -> DependencyShape throws {
    if typed {
        if kind == "rust" {
            return DependencyShape::Rust
        }
        throw Refused::Because(f"Dependency `{name}` has `type = \"{kind}\"`, which isn't a kind of dependency Nikaia knows. The only one is `rust`, for a crate from crates.io.")
    }
    if has_path {
        return DependencyShape::Path
    }
    return DependencyShape::Nikaia
}

/// The name a program writes for the crate a manifest key declares
/// (ADR-290 D1): `hyper-shim` is `hyper_shim::serve_once`, because that is the
/// crate name Cargo makes of the key.
pub fn crate_name(key: ref String) -> String {
    let mut name: String = ""
    for c in key.chars() {
        if c == '-' {
            name.push('_')
        } else {
            name.push(c)
        }
    }
    return name
}

// Whether `words` holds `word`.
fn contains(words: ref Array[String], word: ref String) -> bool {
    for w in words {
        if w == word {
            return true
        }
    }
    return false
}

// `a, b, c`, the way a message names the choices.
fn choices(words: ref Array[String]) -> String {
    let mut out: String = ""
    for w in words {
        if out.len() > 0 {
            out.push_str(", ")
        }
        out.push_str(w)
    }
    return out
}

/// One value of `nikaia.toml`, in the plain words the `toml` reader gives it
/// (MF). The adapter walks the document once, in the file's key order, and
/// hands over the four sections this module reads (`package`, `dependencies`,
/// `library`, `build`), their entries, and each key of an entry that is a
/// table. Nothing deeper: no reader looks further in.
pub struct ManifestItem {
    /// The top-level table it is in.
    pub section: String,
    /// Its key in that table; empty for the section itself.
    pub name: String,
    /// Its key inside entry `name`; empty for the entry itself.
    pub key: String,
    /// Whether the value is a table.
    pub table: bool,
    /// The value as TOML writes it (`toml::Value::to_string`).
    pub text: String,
    /// The value where it is a text (`as_str`).
    pub word: String?,
    /// The value where it is a whole number (`as_integer`).
    pub integer: i64?,
    /// For a `[build.<target>]` table, whether `--target` takes the name as a
    /// machine (ADR-037 D9; the compiler's `Target::parse` answers it).
    pub machine: bool,
}

/// One entry of `[dependencies]`, and which of the three shapes it is.
///
/// The distinction is the whole of the translation: a native Rust crate is
/// passed to Cargo exactly as written (ADR-002 D1), a Nikaia package **by path**
/// is read as part of this program
/// ([ADR-286](../../../docs/specification/adr/adr-286.md) D15), and a Nikaia
/// package named any other way is something nothing has decided yet.
pub struct ManifestDependency {
    /// Which of the three it is.
    pub shape: DependencyShape,
    /// The value as written. For `Rust`, the compiler's `Dependency` drops its
    /// `type` key: Cargo would reject it as unknown.
    pub text: String,
    /// `path = "…"` where the entry says one: relative to the manifest's own
    /// directory, the only reading that survives the project being checked out
    /// somewhere else.
    pub path: String?,
}

/// Where a `nikaia.toml` was found, and what it said.
///
/// Absent outside a project, which is not an error: a single `.nika` file
/// compiles with the built-in defaults and the flags, and littering a manifest
/// into someone's directory to make that work would be the wrong trade.
pub struct ManifestFile {
    pub build: collections::BTreeMap[String, String],
    /// `[package]`, each value as its text.
    pub package: collections::BTreeMap[String, String],
    /// `[package] name`, which becomes the Cargo package and the binary's name.
    pub name: String?,
    /// `[package] version`. Cargo requires one, so a project that does not say
    /// gets `0.0.0` - a version nobody typed, rather than a guess at one they
    /// meant.
    pub version: String,
    pub dependencies: collections::BTreeMap[String, ManifestDependency],
    /// `[build.<target>]` - `opt-level` and `lto`, per machine (Part III 13.3).
    pub codegen: collections::BTreeMap[String, collections::BTreeMap[String, String]],
    /// `[library.<name>]`: each system library an `extern(library: …)` block
    /// names, with the `pkg-config` name it is found by (Part III 13.4,
    /// [ADR-324](../../../docs/specification/adr/adr-324.md) D2, D3).
    pub libraries: collections::BTreeMap[String, String],
    /// What this manifest carries that the compiler no longer reads, and where
    /// it went. Printed once per build rather than returned as an error:
    /// failing a manifest somebody already wrote to the specification would
    /// punish them for the move ([ADR-303](../../../docs/specification/adr/adr-303.md) D5).
    pub notes: Vec[String],
    /// The directory the manifest was found in, and therefore the project root.
    /// `None` when there was no manifest at all.
    pub root: fs::Path?,
}

/// The manifest of no project: every section empty.
pub fn manifest_empty() -> ManifestFile {
    return ManifestFile { build: collections::BTreeMap(), package: collections::BTreeMap(), name: null, version: "0.0.0", dependencies: collections::BTreeMap(), codegen: collections::BTreeMap(), libraries: collections::BTreeMap(), notes: [], root: null }
}

/// `[package]`, `[dependencies]`, `[build]` and the `[build.<target>]`
/// codegen tables.
pub fn manifest_parse(items: ref Vec[ManifestItem]) -> ManifestFile throws {
    let mut manifest = manifest_empty()
    for item in items {
        if item.section == "package" && item.name.len() > 0 && item.key.len() == 0 {
            manifest.package.insert(item.name.clone(), item.text.clone())
        }
    }
    manifest.name = manifest_word_at(items, "package", "name", "")
    manifest.version = manifest_word_at(items, "package", "version", "") ?? "0.0.0"
    manifest.dependencies = manifest_dependencies(items)
    manifest.libraries = manifest_libraries(items)

    for value in items {
        if value.section != "build" || value.name.len() == 0 || value.key.len() > 0 {
            continue
        }
        if value.table {
            manifest.codegen.insert(value.name.clone(), manifest_codegen(items, value))
            continue
        }
        // A moved key is not carried into `build`: a key nothing reads must not
        // be reachable through `setting`, or a later reader would resolve it
        // from the wrong file.
        //
        // Every switch is a word, so a bare `no` (TOML's boolean) or a
        // count is the plausible mistake. Reporting the type here would
        // hide the *reason* - `Build::parse` explains why a count is not a
        // count - so the value is stringified and passed on to the
        // parser that owns the setting.
        let switch = build_key(value.name)
        match switch {
            Switch::Moved(note) => manifest.notes.push(note),
            Switch::Kept => manifest.build.insert(value.name.clone(), value.word?.clone() ?? value.text.clone()),
        }
    }
    return manifest
}

/// Whether this manifest says anything about how to build.
///
/// What it is for is a **dependency's** `[build]`, which is ignored:
/// a package is built with the settings of the program that uses it
/// ([ADR-286](../../../docs/specification/adr/adr-286.md) D15 rule 4), and
/// anything else would put two answers to the parallelism question in one
/// build. Ignored **and said**, which is why there is a question to ask.
pub fn manifest_has_build_section(manifest: ref ManifestFile) -> bool {
    return !manifest.build.is_empty() || !manifest.codegen.is_empty()
}

/// **The Rust crates this build declares**, under the name a program writes
/// ([ADR-290](../../../docs/specification/adr/adr-290.md) D1).
///
/// `hyper-shim = { type = "rust", … }` is written `hyper_shim::serve_once`
/// in a program, because that is the crate name Cargo makes of the key and
/// the name the generated Rust carries. The manifest key is what a person
/// types and the underscore form is what a call names, so the translation
/// belongs here rather than at every reader.
///
/// **Only `type = "rust"`.** A Nikaia package by path is read as part of
/// this program and has a ledger of its own; what this names is the set at
/// whose edge D1's question is asked.
pub fn manifest_foreign_crates(manifest: ref ManifestFile) -> collections::BTreeSet[String] {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    for (name, declared) in manifest.dependencies {
        match declared.shape {
            DependencyShape::Rust => out.insert(crate_name(name)),
            else => {},
        }
    }
    return out
}

// The text of `section`.`name`.`key` where it is a text, else as TOML writes it.
fn manifest_text_at(items: ref Vec[ManifestItem], section: String, name: String, key: String) -> String? {
    for item in items {
        if item.section == section && item.name == name && item.key == key {
            return item.word?.clone() ?? item.text.clone()
        }
    }
    return null
}

// The text of `section`.`name`.`key`, where the file has it and it is a text.
fn manifest_word_at(items: ref Vec[ManifestItem], section: String, name: String, key: String) -> String? {
    for item in items {
        if item.section == section && item.name == name && item.key == key {
            return item.word?.clone()
        }
    }
    return null
}

/// `[library.<name>]`, checked: a table per library with `pkg-config` and
/// nothing else, because the compiler forms every argument itself (ADR-324 D3,
/// D4) and a key it does not read would be one somebody thought it did.
fn manifest_libraries(items: ref Vec[ManifestItem]) -> collections::BTreeMap[String, String] throws {
    let mut out: collections::BTreeMap[String, String] = collections::BTreeMap()
    for section in items {
        if section.section == "library" && section.name.len() == 0 && !section.table {
            throw Refused::Because("`library` is a table of libraries: `[library.<name>]` with `pkg-config = \"<name>\"`.")
        }
    }
    for entry in items {
        if entry.section != "library" || entry.name.len() == 0 || entry.key.len() > 0 {
            continue
        }
        let name = entry.name.clone()
        if !entry.table {
            throw Refused::Because(f"`library.{name}` is a table: `[library.{name}]` with `pkg-config = \"{name}\"`.")
        }
        for item in items {
            if item.section == "library" && item.name == name && item.key.len() > 0 && item.key != "pkg-config" {
                let key = item.key.clone()
                throw Refused::Because(f"`[library.{name}]` takes `pkg-config` and nothing else, not `{key}`: the compiler forms the linker's arguments itself (Part III 13.4).")
            }
        }
        let found_by = manifest_word_at(items, "library", name.clone(), "pkg-config") ?? throw Refused::Because(f"`[library.{name}]` needs `pkg-config = \"<name>\"`: a library is found only through `pkg-config` (Part III 13.4).")
        out.insert(name, found_by)
    }
    return out
}

/// `[build.<target>]`, checked. Any target `--target` takes may have a table
/// (ADR-037 D9); the refusal for one that is none of them is `codegen_table`'s.
fn manifest_codegen(items: ref Vec[ManifestItem], table: ref ManifestItem) -> collections::BTreeMap[String, String] throws {
    let target = table.name.clone()
    if !table.machine {
        codegen_table(target)
    }
    let mut out: collections::BTreeMap[String, String] = collections::BTreeMap()
    for value in items {
        if value.section != "build" || value.name != target || value.key.len() == 0 {
            continue
        }
        codegen_key(target, value.key)
        if value.key == "codegen-units" {
            codegen_units(target, value.integer, value.text.clone())
        }
        out.insert(value.key.clone(), value.text.clone())
    }
    return out
}

/// `[dependencies]`, split into the shapes 13.3 shows.
///
/// `type = "rust"` is the marker: Nikaia's word about which ecosystem the name
/// belongs to.
fn manifest_dependencies(items: ref Vec[ManifestItem]) -> collections::BTreeMap[String, ManifestDependency] throws {
    let mut out: collections::BTreeMap[String, ManifestDependency] = collections::BTreeMap()
    for value in items {
        if value.section != "dependencies" || value.name.len() == 0 || value.key.len() > 0 {
            continue
        }
        let kind = manifest_text_at(items, "dependencies", value.name.clone(), "type")
        let path = manifest_word_at(items, "dependencies", value.name.clone(), "path")
        let typed = kind != null
        let has_path = path != null
        let shape = dependency(value.name, typed, kind ?? "", has_path)
        out.insert(value.name.clone(), ManifestDependency { shape: shape, text: value.text.clone(), path: path })
    }
    return out
}
