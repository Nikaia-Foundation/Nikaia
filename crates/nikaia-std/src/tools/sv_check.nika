// crates/nikaia-std/src/tools/sv_check.nika
//
// **The checker** (ADR-270 D5, #1282 item 4): replays a proof log of
// `sv_proof.nika` against its query and accepts it when it derives the empty
// clause. It never searches: a learned clause is checked by unit propagation
// through exactly the clauses its hints name, in their order; a Farkas lemma
// by adding up the bounds it names with the multipliers it names; a rounding,
// a split and an extension by looking at their rows. Every number is `i64`
// with the overflow check (`sv_num.nika`): a step whose replay would leave the
// range is rejected, never wrapped. Each rejection names the step and why.
//
// Kept under 1 500 lines for clauses and linear integer arithmetic (D5); a
// rule that would push it past needs a record.

/// A bound `row REL 0` and the literals it assumes, ascending.
pub struct SvBound {
	pub row: SvRow,
	pub rel: SvRel,
	pub assumed: Vec[u32],
}

/// What an entry of the log holds.
pub enum SvEntry {
	Clause(Vec[u32]),
	Bound(SvBound),
	Gone,
}

/// The checker's answer: accepted, or the step that failed and why.
pub struct SvVerdict {
	pub ok: bool,
	pub step: i64,
	pub reason: String,
}

/// What the replay has built: the atoms (the query's, then the splits'), the
/// entries, the columns, and whether the empty clause is among them.
struct SvReplay {
	atoms: Vec[SvAtom],
	entries: Vec[SvEntry],
	columns: u32,
	/// The query's real columns: a step over the integers may not touch
	/// them (ADR-270 D27).
	reals: Vec[u32],
	refuted: bool,
	/// Per atom while a learned clause is checked: 0 open, 1 true, -1
	/// false; all 0 between checks, so a check costs its own literals, not
	/// the atoms (#1312).
	value: Vec[i64],
}

/// A combination's result, or why there is none.
struct SvSum {
	bound: SvBound?,
	why: String,
}

/// Replays `log` against `query`.
fn sv_check(query: ref SvQuery, log: ref Vec[SvStep]) -> SvVerdict {
	let mut replay = SvReplay {
		atoms: query.atoms.clone(),
		entries: [],
		columns: query.columns,
		reals: query.reals.clone(),
		refuted: false,
		value: [],
	}
	for atom in query.atoms {
		let why = replay.row_known(atom.row)
		if why != "" {
			return SvVerdict { ok: false, step: -1, reason: f"a query atom: {why}" }
		}
	}
	let mut at = 0
	for step in log {
		let why = replay.step(query, step)
		if why != "" {
			return SvVerdict { ok: false, step: at, reason: f"{sv_step_kind(step)}: {why}" }
		}
		at += 1
	}
	if !replay.refuted {
		return SvVerdict { ok: false, step: at, reason: "the log ends without the empty clause" }
	}
	return SvVerdict { ok: true, step: at, reason: "" }
}

impl SvReplay {
	/// Replays one step; `""` where it holds, else why not.
	fn step(ref mut self, query: ref SvQuery, step: ref SvStep) -> String {
		return match step {
			SvStep::Input(c) => self.input(query, c),
			SvStep::Learn(lits, hints) => self.learn(lits, hints),
			SvStep::Delete(id) => self.delete(id),
			SvStep::Farkas(lits, sources, multipliers, den) => self.farkas(
				lits,
				sources,
				multipliers,
				den,
			),
			SvStep::Combine(sources, multipliers) => {
				let sum = self.combination(sources, multipliers)
				let bound = sum.bound ?? return sum.why
				self.entries.push(SvEntry::Bound(bound))
				""
			},
			SvStep::Round(id, d) => self.round(id, d),
			SvStep::Split(le, ge) => self.split(le, ge),
			SvStep::Extend(l, m, q) => self.extend(l, m, q),
		}
	}

	/// `""` where every column of `row` exists, else which does not.
	fn row_known(ref self, row: ref SvRow) -> String {
		for c in row.cols {
			if c >= self.columns {
				return f"x{c} is no column"
			}
		}
		return ""
	}

	/// `""` where `row` has no real column, else which it has: a rounding, a
	/// split and an extension hold over the integers only (ADR-270 D27).
	fn real_in(ref self, row: ref SvRow) -> String {
		for c in row.cols {
			if self.reals.contains(c) {
				return f"x{c} is real, and an integer step may not touch it"
			}
		}
		return ""
	}

	/// `""` where every literal names an atom, else which does not.
	fn lits_known(ref self, lits: ref Vec[u32]) -> String {
		for l in lits {
			if (l / 2) as i64 >= self.atoms.len() {
				return f"literal {l} names no atom"
			}
		}
		return ""
	}

	/// Adds a clause; the empty one refutes the query.
	fn add_clause(ref mut self, lits: Vec[u32]) -> String {
		if lits.len() == 0 {
			self.refuted = true
		}
		self.entries.push(SvEntry::Clause(lits))
		return ""
	}

	fn input(ref mut self, query: ref SvQuery, c: u32) -> String {
		let at = c as i64
		if at >= query.clauses.len() {
			return f"the query has no clause {c}"
		}
		let why = self.lits_known(query.clauses[at])
		if why != "" {
			return why
		}
		return self.add_clause(query.clauses[at].clone())
	}

	/// Reverse unit propagation: every literal of `lits` false, then each
	/// hint in turn unit (its one open literal becomes true) until one is
	/// false throughout.
	fn learn(ref mut self, lits: ref Vec[u32], hints: ref Vec[u32]) -> String {
		let why = self.lits_known(lits)
		if why != "" {
			return why
		}
		while self.value.len() < self.atoms.len() {
			self.value.push(0)
		}
		let mut touched: Vec[u32] = []
		let unit = sv_unit_chain(self.entries, self.value, lits, hints, touched)
		for l in touched {
			self.value[(l / 2) as i64] = 0
		}
		if unit != "" {
			return unit
		}
		return self.add_clause(lits.clone())
	}

	fn delete(ref mut self, id: u32) -> String {
		let at = id as i64
		if at >= self.entries.len() {
			return f"entry {id} does not exist"
		}
		let gone = match self.entries[at] {
			SvEntry::Gone => true,
			else => false,
		}
		if gone {
			return f"entry {id} is already deleted"
		}
		self.entries[at] = SvEntry::Gone
		return ""
	}

	/// The bound a source adds, or why there is none.
	fn source(ref self, src: ref SvSrc) -> SvSum {
		return match src {
			SvSrc::Lit(l) => {
				let at = (l / 2) as i64
				if at >= self.atoms.len() {
					return SvSum { bound: null, why: f"literal {l} names no atom" }
				}
				let atom = self.atoms[at].clone()
				// Over the integers: not `row <= 0` is `-row + 1 <= 0`, not
				// `row < 0` is `-row <= 0`; over a real row not `row <= 0`
				// is `-row < 0` (ADR-270 D27).
				let negated = match atom.rel {
					SvRel::Eq => l % 2 == 1,
					else => false,
				}
				if negated {
					return SvSum {
						bound: null,
						why: f"literal {l} negates an equality, which is no bound",
					}
				}
				let real = sv_row_real(atom.row, self.reals)
				let b = sv_lit_bound(atom, l, real) ?? return SvSum { bound: null, why: "overflow" }
				SvSum { bound: b, why: "" }
			},
			SvSrc::Fact(id) => {
				let at = id as i64
				if at >= self.entries.len() {
					return SvSum { bound: null, why: f"entry {id} is no earlier entry" }
				}
				match self.entries[at] {
					SvEntry::Bound(b) => SvSum { bound: b.clone(), why: "" },
					else => SvSum { bound: null, why: f"entry {id} is no bound" },
				}
			},
		}
	}

	/// `Σ multipliers[i]·sources[i]`: an equality where every summand is
	/// one, strict where a strict summand has a positive multiplier.
	fn combination(ref self, sources: ref Vec[SvSrc], multipliers: ref Vec[i64]) -> SvSum {
		if sources.len() != multipliers.len() {
			return SvSum {
				bound: null,
				why: f"{multipliers.len()} multipliers for {sources.len()} sources",
			}
		}
		if sources.len() == 0 {
			return SvSum { bound: null, why: "nothing is combined" }
		}
		let mut row = sv_row_constant(0)
		let mut equality = true
		let mut strict = false
		let mut assumed: Vec[u32] = []
		let mut i = 0
		while i < sources.len() {
			let got = self.source(sources[i])
			let b = got.bound ?? return SvSum { bound: null, why: got.why }
			let m = multipliers[i]
			let is_eq = match b.rel {
				SvRel::Eq => true,
				else => false,
			}
			if !is_eq && m < 0 {
				return SvSum {
					bound: null,
					why: f"multiplier {m} of source {i} is negative on an inequality",
				}
			}
			if m != 0 {
				equality = equality && is_eq
				let is_lt = match b.rel {
					SvRel::Lt => true,
					else => false,
				}
				strict = strict || (is_lt && m > 0)
				row = sv_row_sum(1, row, m, b.row) ?? return SvSum { bound: null, why: "overflow" }
				for l in b.assumed {
					if !assumed.contains(l) {
						assumed.push(l)
					}
				}
			}
			i += 1
		}
		assumed.sort()
		let rel = if equality { SvRel::Eq } else if strict { SvRel::Lt } else { SvRel::Le }
		return SvSum {
			bound: SvBound { row: sv_row_reduced(row), rel: rel, assumed: assumed },
			why: "",
		}
	}

	/// A theory lemma: the combination ends in a contradiction, and the
	/// clause holds the negation of every literal it assumed.
	fn farkas(
		ref mut self,
		lits: ref Vec[u32],
		sources: ref Vec[SvSrc],
		multipliers: ref Vec[i64],
		den: i64,
	) -> String {
		if den <= 0 {
			return f"denominator {den} is not positive"
		}
		let why = self.lits_known(lits)
		if why != "" {
			return why
		}
		let sum = self.combination(sources, multipliers)
		let b = sum.bound ?? return sum.why
		if b.row.cols.len() > 0 {
			return f"x{b.row.cols[0]} is left in the combination"
		}
		let c = b.row.constant
		let contradiction = match b.rel {
			SvRel::Le => c > 0,
			SvRel::Lt => c >= 0,
			SvRel::Eq => c != 0,
		}
		if !contradiction {
			return f"the combination ends in {c} {sv_rel_text(b.rel)} 0, no contradiction"
		}
		for l in b.assumed {
			let negation = l ^ 1
			if !lits.contains(negation) {
				return f"the clause leaves out the negation of literal {l}"
			}
		}
		return self.add_clause(lits.clone())
	}

	/// Chvátal-Gomory: a bound over the integers divided by `d`.
	fn round(ref mut self, id: u32, d: i64) -> String {
		if d == 0 {
			return "a rounding by zero"
		}
		if d < 0 {
			return f"a rounding by {d}, not positive"
		}
		let got = self.source(SvSrc::Fact(id))
		let b = got.bound ?? return got.why
		let real = self.real_in(b.row)
		if real != "" {
			return real
		}
		let mut ks: Vec[i64] = []
		let mut i = 0
		while i < b.row.ks.len() {
			let k = b.row.ks[i]
			if k % d != 0 {
				return f"the coefficient {k} of x{b.row.cols[i]} is not divisible by {d}"
			}
			ks.push(k / d)
			i += 1
		}
		let c = b.row.constant
		let mut rel = SvRel::Le
		let mut constant: i64 = 0
		match b.rel {
			SvRel::Le => { constant = sv_ceil_div(c, d) ?? return "overflow" },
			SvRel::Lt => {
				constant = sv_ceil_div(c.checked_add(1) ?? return "overflow", d)
					?? return "overflow"
			},
			SvRel::Eq => {
				if c % d != 0 {
					// The GCD test: no integers make it hold.
					ks = []
					constant = 1
				} else {
					constant = c / d
					rel = SvRel::Eq
				}
			},
		}
		let cols = if ks.len() == 0 { [] } else { b.row.cols.clone() }
		let row = SvRow { cols: cols, ks: ks, constant: constant }
		self.entries.push(SvEntry::Bound(SvBound {
			row: row,
			rel: rel,
			assumed: b.assumed.clone(),
		}))
		return ""
	}

	/// `le <= 0 ∨ ge <= 0` with `le + ge = 1`: every integer value of `le`
	/// is on one side.
	fn split(ref mut self, le: ref SvRow, ge: ref SvRow) -> String {
		let why = self.row_known(le)
		if why != "" {
			return why
		}
		let real = self.real_in(le)
		if real != "" {
			return real
		}
		let both = sv_row_sum(1, le, 1, ge) ?? return "overflow"
		if both.cols.len() > 0 {
			return f"the two sides are not one form: x{both.cols[0]} is left"
		}
		if both.constant > 1 {
			return f"the split leaves out an alternative: its sides add up to {both.constant}, not 1"
		}
		if both.constant < 1 {
			return "the split's sides overlap; it is not L <= k or L >= k + 1"
		}
		let first = self.atoms.len().checked_u32() ?? return "overflow"
		self.atoms.push(SvAtom { row: le.clone(), rel: SvRel::Le })
		self.atoms.push(SvAtom { row: ge.clone(), rel: SvRel::Le })
		return self.add_clause([sv_lit(first, false), sv_lit(first + 1, false)])
	}

	/// `q = ⌊l / m⌋`: `0 <= l - m·q <= m - 1`.
	fn extend(ref mut self, l: ref SvRow, m: i64, q: u32) -> String {
		if m <= 0 {
			return f"divisor {m} is not positive"
		}
		let why = self.row_known(l)
		if why != "" {
			return why
		}
		let real = self.real_in(l)
		if real != "" {
			return real
		}
		if q != self.columns {
			return f"x{q} is not the next fresh column x{self.columns}"
		}
		self.columns += 1
		let mq = SvRow { cols: [q], ks: [m], constant: 0 }
		let below = sv_row_sum(-1, l, 1, mq) ?? return "overflow"
		let above0 = sv_row_sum(1, l, -1, mq) ?? return "overflow"
		let above = sv_row_sum(1, above0, -(m - 1), sv_row_constant(1)) ?? return "overflow"
		self.entries.push(SvEntry::Bound(SvBound { row: below, rel: SvRel::Le, assumed: [] }))
		self.entries.push(SvEntry::Bound(SvBound { row: above, rel: SvRel::Le, assumed: [] }))
		return ""
	}
}

/// Makes literal `l` true.
/// Unit propagation of `hints` from the negation of `lits` (RUP): `""`
/// where it ends in a conflict, else why not. Every literal assigned in
/// `value` is added to `touched`.
fn sv_unit_chain(
	entries: ref Vec[SvEntry],
	mut value: Vec[i64],
	lits: ref Vec[u32],
	hints: ref Vec[u32],
	mut touched: Vec[u32],
) -> String {
	for l in lits {
		sv_assign(value, l ^ 1)
		touched.push(l)
	}
	for h in hints {
		let at = h as i64
		if at >= entries.len() {
			return f"hint {h} is no earlier entry"
		}
		let clause = match entries[at] {
			SvEntry::Clause(c) => c,
			else => return f"hint {h} is no clause",
		}
		let mut open: Vec[u32] = []
		for l in clause {
			let v = sv_value(value, l)
			if v > 0 {
				return f"hint {h} is already true"
			}
			if v == 0 {
				open.push(l)
			}
		}
		if open.len() == 0 {
			return ""
		}
		if open.len() > 1 {
			return f"hint {h} is not unit: {open.len()} literals open"
		}
		sv_assign(value, open[0])
		touched.push(open[0])
	}
	return "the hints end without a conflict"
}

fn sv_assign(mut value: Vec[i64], l: u32) {
	let at = (l / 2) as i64
	value[at] = if l % 2 == 0 { 1 } else { -1 }
}

/// `1` where literal `l` is true, `-1` where false, `0` where open.
fn sv_value(value: ref Vec[i64], l: u32) -> i64 {
	let v = value[(l / 2) as i64]
	return if l % 2 == 0 { v } else { -v }
}

fn sv_rel_text(rel: SvRel) -> String {
	return match rel {
		SvRel::Le => "<=",
		SvRel::Lt => "<",
		SvRel::Eq => "=",
	}
}

// --- Tests: valid and broken proofs (moved from
// `tests/compiler/tests/solver_check.nika`, which compiled this file anew in a
// program of its own on every run): a valid proof of each step kind accepted,
// broken ones rejected with their reasons ---

// `Σ ks[i]·x_i + c` over the first columns.
fn sv_check_test_row(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn sv_check_test_le(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_check_test_row(ks, c), rel: SvRel::Le }
}

fn sv_check_test_eq(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_check_test_row(ks, c), rel: SvRel::Eq }
}

fn sv_check_test_lt(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_check_test_row(ks, c), rel: SvRel::Lt }
}

fn sv_check_test_pos(a: u32) -> u32 {
	return sv_lit(a, false)
}

fn sv_check_test_neg(a: u32) -> u32 {
	return sv_lit(a, true)
}

// Every atom of `atoms` a unit clause.
fn sv_check_test_units(atoms: Vec[SvAtom], columns: u32) -> SvQuery {
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	for _ in atoms {
		clauses.push([sv_check_test_pos(a)])
		a += 1
	}
	return SvQuery { atoms: atoms, clauses: clauses, columns: columns, reals: [] }
}

fn sv_check_test_report(name: String, query: ref SvQuery, log: ref SvLog) -> String {
	let v = sv_check(query, log.steps)
	if v.ok {
		return f"{name}: accepted ({log.steps.len()} steps)\n"
	}
	return f"{name}: rejected at step {v.step}: {v.reason}\n"
}

// p and q both ways: four clauses, refuted by two learned ones.
fn sv_check_test_clauses() -> SvQuery {
	let clauses: Vec[Vec[u32]] = [
		[sv_check_test_pos(0), sv_check_test_pos(1)],
		[sv_check_test_pos(0), sv_check_test_neg(1)],
		[sv_check_test_neg(0), sv_check_test_pos(1)],
		[sv_check_test_neg(0), sv_check_test_neg(1)],
	]
	return SvQuery { atoms: [sv_check_test_le([1], 0), sv_check_test_le([0, 1], 0)], clauses: clauses, columns: 2, reals: [] }
}

fn sv_check_test_clause_log(drop_hint: bool) -> SvLog {
	let query = sv_check_test_clauses()
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let c0 = log.input(0)
	let c1 = log.input(1)
	let c2 = log.input(2)
	let c3 = log.input(3)
	let p = log.learn([sv_check_test_pos(0)], [c0, c1])
	log.delete(c0)
	let hints: Vec[u32] = if drop_hint { [p, c2] } else { [p, c2, c3] }
	log.learn([], hints)
	return log
}

// x <= 2 and x >= 3.
fn sv_check_test_bounds() -> SvQuery {
	return sv_check_test_units([sv_check_test_le([1], -2), sv_check_test_le([-1], 3)], 1)
}

fn sv_check_test_farkas_log(m: i64, den: i64, lits: Vec[u32]) -> SvLog {
	let mut log = sv_log(sv_check_test_bounds()) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let f = log.farkas(lits, [SvSrc::Lit(sv_check_test_pos(0)), SvSrc::Lit(sv_check_test_pos(1))], [m, m], den)
	log.learn([], [a, b, f])
	return log
}

// 2x < 3 and 2x >= 3, multipliers 1/2 each over the denominator 2.
fn sv_check_test_strict() -> SvQuery {
	return sv_check_test_units([sv_check_test_lt([2], -3), sv_check_test_le([-2], 3)], 1)
}

// x - y = 0 and x - y >= 1, the equality with -1 written as y - x = 0.
fn sv_check_test_equal() -> SvQuery {
	return sv_check_test_units([sv_check_test_eq([-1, 1], 0), sv_check_test_le([-1, 1], 1)], 2)
}

fn sv_check_test_lemma_log(query: ref SvQuery, m: Vec[i64], den: i64) -> SvLog {
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let f = log.farkas([sv_check_test_neg(0), sv_check_test_neg(1)], [SvSrc::Lit(sv_check_test_pos(0)), SvSrc::Lit(sv_check_test_pos(1))], m, den)
	log.learn([], [a, b, f])
	return log
}

// x = 2y and x = 5: odd and even.
fn sv_check_test_parity() -> SvQuery {
	return sv_check_test_units([sv_check_test_eq([1, -2], 0), sv_check_test_eq([1], -5)], 2)
}

// The parity refuted by a combination and the GCD test, after an extension
// `q = ⌊x / 2⌋` pins `q` to 2 on the way.
fn sv_check_test_parity_log(divisor: i64, m: i64, q: u32) -> SvLog {
	let mut log = sv_log(sv_check_test_parity()) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let ext = log.extend(sv_check_test_row([1], 0), m)
	if q != 2 {
		log.steps.pop()
		log.steps.push(SvStep::Extend(sv_check_test_row([1], 0), m, q))
	}
	// 2q - x <= 0 and x = 5: 2q - 5 <= 0, rounded: q - 2 <= 0.
	let upper = log.combine([SvSrc::Fact(ext), SvSrc::Lit(sv_check_test_pos(1))], [1, 1])
	log.round(upper, 2)
	// x - 2q - 1 <= 0 and x = 5: -2q + 4 <= 0.
	log.combine([SvSrc::Fact(ext + 1), SvSrc::Lit(sv_check_test_pos(1))], [1, -1])
	// x - 2y = 0 minus x - 5 = 0: -2y + 5 = 0, not even.
	let odd = log.combine([SvSrc::Lit(sv_check_test_pos(0)), SvSrc::Lit(sv_check_test_pos(1))], [1, -1])
	let none = log.round(odd, divisor)
	let f = log.farkas([sv_check_test_neg(0), sv_check_test_neg(1)], [SvSrc::Fact(none)], [1], 1)
	log.learn([], [a, b, f])
	return log
}

// x <= 2 and x >= 1: no contradiction.
fn sv_check_test_fits() -> SvQuery {
	return sv_check_test_units([sv_check_test_le([1], -2), sv_check_test_le([-1], 1)], 1)
}

// 2x <= 1 and 2x >= 1: x = 1/2 over the rationals, no integer.
fn sv_check_test_half() -> SvQuery {
	return sv_check_test_units([sv_check_test_le([2], -1), sv_check_test_le([-2], 1)], 1)
}

// Split on x <= 0 or x >= 1 (`ge_constant` 1); each side refuted.
fn sv_check_test_split_log(ge_constant: i64) -> SvLog {
	let mut log = sv_log(sv_check_test_half()) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	let a = log.input(0)
	let b = log.input(1)
	let s = log.split(sv_check_test_row([1], 0), sv_check_test_row([-1], ge_constant))
	let low = log.farkas([sv_check_test_neg(1), sv_check_test_neg(2)], [SvSrc::Lit(sv_check_test_pos(1)), SvSrc::Lit(sv_check_test_pos(2))], [1, 2], 1)
	let high = log.farkas([sv_check_test_neg(0), sv_check_test_neg(3)], [SvSrc::Lit(sv_check_test_pos(0)), SvSrc::Lit(sv_check_test_pos(3))], [1, 2], 1)
	log.learn([], [a, b, low, high, s])
	return log
}

fn sv_check_test_single(query: ref SvQuery, steps: Vec[SvStep]) -> SvLog {
	let mut log = sv_log(query) ?? SvLog { steps: [], entries: 0, atoms: 0, columns: 0 }
	log.steps = steps
	return log
}

test "a valid proof of each step kind is accepted" {
	let mut out: String = ""
	out = out + "== accepted\n"
	out = out + sv_check_test_report("clauses (input, learn, delete)", sv_check_test_clauses(), sv_check_test_clause_log(false))
	out = out + sv_check_test_report("farkas", sv_check_test_bounds(), sv_check_test_farkas_log(1, 1, [sv_check_test_neg(0), sv_check_test_neg(1)]))
	out = out + sv_check_test_report("farkas, strict, over a denominator", sv_check_test_strict(), sv_check_test_lemma_log(sv_check_test_strict(), [1, 1], 2))
	out = out + sv_check_test_report("farkas, equality with a negative multiplier", sv_check_test_equal(), sv_check_test_lemma_log(sv_check_test_equal(), [-1, 1], 1))
	out = out + sv_check_test_report("extension, combine, round and the GCD test", sv_check_test_parity(), sv_check_test_parity_log(2, 2, 2))
	out = out + sv_check_test_report("split", sv_check_test_half(), sv_check_test_split_log(1))

	let expected = [
		"== accepted",
		"clauses (input, learn, delete): accepted (7 steps)",
		"farkas: accepted (4 steps)",
		"farkas, strict, over a denominator: accepted (4 steps)",
		"farkas, equality with a negative multiplier: accepted (4 steps)",
		"extension, combine, round and the GCD test: accepted (10 steps)",
		"split: accepted (6 steps)",
	]
	assert(out == expected.join("\n") + "\n")
}

test "broken proofs are rejected with their reasons" {
	let mut out: String = ""
	out = out + "== rejected\n"
	out = out + sv_check_test_report("negative multiplier on an inequality", sv_check_test_bounds(), sv_check_test_farkas_log(-1, 1, [sv_check_test_neg(0), sv_check_test_neg(1)]))
	out = out + sv_check_test_report("missing hint", sv_check_test_clauses(), sv_check_test_clause_log(true))
	out = out + sv_check_test_report("split leaving out an alternative", sv_check_test_half(), sv_check_test_split_log(2))
	out = out + sv_check_test_report("split with overlapping sides", sv_check_test_half(), sv_check_test_split_log(0))
	out = out + sv_check_test_report("rounding by zero", sv_check_test_parity(), sv_check_test_parity_log(0, 2, 2))
	out = out + sv_check_test_report("rounding by an indivisible divisor", sv_check_test_parity(), sv_check_test_parity_log(3, 2, 2))
	out = out + sv_check_test_report("extension by zero", sv_check_test_parity(), sv_check_test_parity_log(2, 0, 2))
	out = out + sv_check_test_report("extension on a column in use", sv_check_test_parity(), sv_check_test_parity_log(2, 2, 1))
	out = out + sv_check_test_report("farkas over a denominator of zero", sv_check_test_bounds(), sv_check_test_farkas_log(1, 0, [sv_check_test_neg(0), sv_check_test_neg(1)]))
	out = out + sv_check_test_report("farkas leaving a literal out of its clause", sv_check_test_bounds(), sv_check_test_farkas_log(1, 1, [sv_check_test_neg(0)]))
	out = out + sv_check_test_report("farkas without a contradiction", sv_check_test_fits(), sv_check_test_lemma_log(sv_check_test_fits(), [1, 1], 1))
	out = out + sv_check_test_report("farkas leaving a variable", sv_check_test_equal(), sv_check_test_lemma_log(sv_check_test_equal(), [1, 1], 1))
	out = out + sv_check_test_report(
		"farkas on a negated equality",
		sv_check_test_equal(),
		sv_check_test_single(sv_check_test_equal(), [SvStep::Farkas([], [SvSrc::Lit(sv_check_test_neg(0))], [1], 1)]),
	)
	out = out + sv_check_test_report("input the query does not hold", sv_check_test_bounds(), sv_check_test_single(sv_check_test_bounds(), [SvStep::Input(2)]))
	out = out + sv_check_test_report(
		"learn without hints",
		sv_check_test_bounds(),
		sv_check_test_single(sv_check_test_bounds(), [SvStep::Input(0), SvStep::Learn([], [])]),
	)
	out = out + sv_check_test_report(
		"hint that is a bound",
		sv_check_test_parity(),
		sv_check_test_single(sv_check_test_parity(), [SvStep::Combine([SvSrc::Lit(sv_check_test_pos(0))], [1]), SvStep::Learn([], [0])]),
	)
	out = out + sv_check_test_report(
		"deleting twice",
		sv_check_test_bounds(),
		sv_check_test_single(sv_check_test_bounds(), [SvStep::Input(0), SvStep::Delete(0), SvStep::Delete(0)]),
	)
	let big: i64 = 4611686018427387904
	out = out + sv_check_test_report(
		"a combination leaving i64",
		sv_check_test_bounds(),
		sv_check_test_single(sv_check_test_bounds(), [SvStep::Combine([SvSrc::Lit(sv_check_test_pos(0)), SvSrc::Lit(sv_check_test_pos(0))], [big, big])]),
	)
	out = out + sv_check_test_report(
		"a log without the empty clause",
		sv_check_test_bounds(),
		sv_check_test_single(sv_check_test_bounds(), [SvStep::Input(0), SvStep::Input(1)]),
	)

	let expected = [
		"== rejected",
		"negative multiplier on an inequality: rejected at step 2: farkas: multiplier -1 of source 0 is negative on an inequality",
		"missing hint: rejected at step 6: learn: the hints end without a conflict",
		"split leaving out an alternative: rejected at step 2: split: the split leaves out an alternative: its sides add up to 2, not 1",
		"split with overlapping sides: rejected at step 2: split: the split's sides overlap; it is not L <= k or L >= k + 1",
		"rounding by zero: rejected at step 7: round: a rounding by zero",
		"rounding by an indivisible divisor: rejected at step 7: round: the coefficient -2 of x1 is not divisible by 3",
		"extension by zero: rejected at step 2: extend: divisor 0 is not positive",
		"extension on a column in use: rejected at step 2: extend: x1 is not the next fresh column x2",
		"farkas over a denominator of zero: rejected at step 2: farkas: denominator 0 is not positive",
		"farkas leaving a literal out of its clause: rejected at step 2: farkas: the clause leaves out the negation of literal 2",
		"farkas without a contradiction: rejected at step 2: farkas: the combination ends in -1 <= 0, no contradiction",
		"farkas leaving a variable: rejected at step 2: farkas: x0 is left in the combination",
		"farkas on a negated equality: rejected at step 0: farkas: literal 1 negates an equality, which is no bound",
		"input the query does not hold: rejected at step 0: input: the query has no clause 2",
		"learn without hints: rejected at step 1: learn: the hints end without a conflict",
		"hint that is a bound: rejected at step 1: learn: hint 0 is no clause",
		"deleting twice: rejected at step 2: delete: entry 0 is already deleted",
		"a combination leaving i64: rejected at step 0: combine: overflow",
		"a log without the empty clause: rejected at step 2: the log ends without the empty clause",
	]
	assert(out == expected.join("\n") + "\n")
}
