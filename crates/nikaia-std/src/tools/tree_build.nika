// crates/nikaia-std/src/tools/tree_build.nika
//
// **What the grammar's actions build the tree with** - the pieces a PEG has no
// precedence table for: a head and a list of tails folded into the nesting
// they mean, a postfix step put onto what it follows, a lambda's parameters
// split into the names and the ones written `mut`, a declaration's parameters
// with the config zone split into its two shapes, and `jump if cond`. Moved
// from the compiler's `parser` (ADR-294, #125).

use std::node_id

/// What may follow a primary expression: `.field`, `.method(..)`, `?`.
pub enum Postfix {
    Field(winnow_grammar::Symbol),
    /// Part I 3.5: `?.name`, which reaches the field only if the receiver
    /// holds something.
    SafeField(winnow_grammar::Symbol),
    /// Part I 3.5 again, onto a **method**: the call happens only if the
    /// receiver holds something (ADR-278).
    SafeMethod(winnow_grammar::Symbol, Vec[Expr], Vec[ConfigArg]),
    Method(winnow_grammar::Symbol, Vec[Expr], Vec[ConfigArg]),
    Index(Expr),
    /// `[a..]`: from `a` to the end, and the word `len` the end is read with.
    IndexFrom(Expr, winnow_grammar::Symbol),
    /// `with { x: 1 }` - ADR-118 D1. The number is the byte the `with` stands
    /// at, which is the key the checker records the operand's type under.
    With(Vec[FieldInit], u32),
}

/// A lambda's parameter list, split into the names and the ones written `mut`
/// (ADR-281 D12). The grammar reads them together because that is how they
/// are written; the tree holds them apart because almost no parameter is one.
pub fn split_mut(params: ref Vec[(bool, winnow_grammar::Symbol)]) -> (Vec[winnow_grammar::Symbol], Vec[winnow_grammar::Symbol]) {
    let mut names: Vec[winnow_grammar::Symbol] = []
    let mut mutable: Vec[winnow_grammar::Symbol] = []
    for param in params {
        names.push(param.1)
        if param.0 {
            mutable.push(param.1)
        }
    }
    return (names, mutable)
}

/// **A lambda's parameter that takes a tuple apart**
/// ([ADR-358](../../../docs/specification/adr/adr-358.md) D5): `fn((k, v)) { … }`
/// is a parameter under a name nobody can write and, put first in `body`,
/// `let (k, v) = ` that name. Each unpack is the hidden name, the names and shape of
/// the pattern (as a `let` holds them), and where the pattern was written. The
/// lets come in the parameters' order, so the checker reads them as the
/// `let`s they are and a wrong width is that `let`'s finding.
pub fn unpacked(mut body: Block, unpacks: Vec[(winnow_grammar::Symbol, Vec[winnow_grammar::Symbol], Vec[i64], Span)]) {
    let mut at = 0
    for u in unpacks {
        let open = Stmt::Let { names: u.1.clone(), shape: u.2.clone(), mutable: false, ty: null, value: Expr::Variable(u.0, node_id::NodeId::parsed()) }
        body.stmts.insert(at, Spanned { node: open, span: u.3, doc: null, attributes: [] })
        at += 1
    }
}

/// A declaration's parameters, with the config zone split into its two shapes.
pub fn params_of(receiver: Receiver?, args: Vec[FnArg], zone: ConfigZone?) -> FnParams {
    if zone == null {
        return FnParams { receiver: receiver, args: args, config: [], spread: null }
    }
    match zone ?? ConfigZone::Options([]) {
        ConfigZone::Options(options) => {
            return FnParams { receiver: receiver, args: args, config: options, spread: null }
        },
        ConfigZone::Spread(name) => {
            return FnParams { receiver: receiver, args: args, config: [], spread: name }
        },
    }
}

/// `jump if cond` as the tree has always written it: `if cond { jump }`
/// (ADR-276 D23).
pub fn guarded(jump: Stmt, cond: Expr, span: Span) -> Stmt {
    return Stmt::Expr(Expr::If { cond: cond, then_branch: Block { stmts: [Spanned { node: jump, span: span, doc: null, attributes: [] }] }, else_branch: null, id: node_id::NodeId::parsed() })
}

/// Left-associative: `a - b - c` is `(a - b) - c`.
///
/// **Every binary node carries a span, and it is the operator's own.** The
/// span of the *tail* - the operator and what stands to its right - rather
/// than of the whole expression, because uniqueness is the only property a key
/// needs: two `+`s in one statement have two spans, which is exactly what a
/// statement-keyed channel could not give (ADR-081 D1).
///
/// **The nodes it makes are not numbered yet**: the numbering pass gives them
/// their ids in input order ([ADR-383](../../docs/specification/adr/adr-383.md) D1).
pub fn fold_binary(head: Expr, tail: Vec[(BinaryOp, Expr, Span)]) -> Expr {
    let mut lhs = head
    for step in tail.drain() {
        lhs = Expr::Binary { op: step.0, lhs: lhs, rhs: step.1, span: step.2, grouped: false, id: node_id::NodeId::parsed() }
    }
    return lhs
}

/// A parenthesised expression, which is the expression - with a bit operation
/// marked as written inside them (ADR-285 D4): that is the one place the tree
/// has to remember a parenthesis.
pub fn grouped(e: Expr) -> Expr {
    match e {
        // The same node, so the same id (ADR-340 D2).
        Expr::Binary { op, lhs, rhs, span, id, .. } => {
            return Expr::Binary { op: op, lhs: lhs, rhs: rhs, span: span, grouped: true, id: id }
        },
        other => {
            return other
        },
    }
}

/// Every postfix step put onto what it follows, in the order written. The
/// nodes it makes are numbered by the numbering pass
/// ([ADR-383](../../docs/specification/adr/adr-383.md) D1).
pub fn fold_postfix(base: Expr, tail: Vec[Postfix]) -> Expr {
    let mut recv = base
    for step in tail.drain() {
        let id = node_id::NodeId::parsed()
        recv = match step {
            Postfix::Field(name) => Expr::Field { base: recv, name: name, id: id },
            Postfix::SafeField(name) => Expr::SafeField { base: recv, name: name, id: id },
            Postfix::SafeMethod(method, args, config) => Expr::SafeMethod { receiver: recv, method: method, args: args, config: config, id: id },
            Postfix::Method(method, args, config) => Expr::MethodCall { receiver: recv, method: method, args: args, config: config, id: id },
            Postfix::Index(index) => Expr::Index { base: recv, index: index, id: id },
            // **`xs[a..]` is `xs[a..<xs.len()]`** (#527). The emitter writes
            // the language below's `a..` for it, so the base is evaluated once.
            Postfix::IndexFrom(start, len) => Expr::Index { base: recv.clone(), index: Expr::Range { start: start, end: Expr::MethodCall { receiver: recv, method: len, args: [], config: [], id: node_id::NodeId::parsed() }, inclusive: false, id: node_id::NodeId::parsed() }, id: id },
            Postfix::With(fields, at) => Expr::With { base: recv, fields: fields, at: at, id: id },
        }
    }
    return recv
}

/// **A repetition with its bounds as written** (ADR-grammar-1 D3): bounds that
/// are all integers written out are a `Repeat`, as they always were, and any
/// other is `Counted`, evaluated where the parser reaches it.
pub fn counted_pattern(pat: Spanned[Pattern], low: Expr, comma: bool, high: Expr?, span: Span) -> Spanned[Pattern] {
    let lo = tree_build_written_count(low)
    let mut hi: u32? = null
    let mut high_written = true
    match high {
        bound => {
            hi = tree_build_written_count(bound)
            high_written = hi != null
        },
        null => {},
    }
    if lo != null && high_written {
        let n = lo ?? 0
        let mut rep = Repeat::Exactly(n)
        if comma {
            rep = match hi {
                m => Repeat::Between(n, m),
                null => Repeat::AtLeast(n),
            }
        }
        return Spanned { node: Pattern::Repeat { pat: pat, rep: rep }, span: span, doc: null, attributes: [] }
    }
    return Spanned { node: Pattern::Counted { pat: pat, low: low, high: high, comma: comma }, span: span, doc: null, attributes: [] }
}

// An integer written out that a `Repeat` can hold.
fn tree_build_written_count(e: ref Expr) -> u32? {
    return match e {
        Expr::LitInt { value, negative, .. } => if !negative && value <= 4294967295 { value as u32 } else { null },
        else => null,
    }
}
