// A file of status `status` over the constants `names` of sort `sort`
// asserting `body`.
fn sv_walk_test_smt(status: String, sort: String, names: Vec[String], body: String) -> String {
	let logic = if sort == "Real" { "QF_LRA" } else { "QF_LIA" }
	let mut text = f"(set-logic {logic})\n(set-info :status {status})\n"
	for n in names {
		text = text + f"(declare-const {n} {sort})\n"
	}
	return text + body + "(check-sat)\n"
}

// The walk on the query of `source`, the file `name`, then the runner's line.
fn sv_walk_test_each(name: String, source: String) -> String {
	let mut reals: collections::BTreeSet[String] = collections::BTreeSet()
	let script = match sv_smtlib_script(source.clone()) {
		SvSmtRead::Script(s, sorts) => {
			reals = sorts.reals.clone()
			s.clone()
		},
		else => {
			return f"{name}: unreadable\n"
		},
	}
	let mut arena = script.arena.clone()
	let goal = arena.boolean(false)
	let mut why = lg_why()
	let line = sv_line(source, "new")
	let read = sv_cnf_sorted(arena, script.assertions, goal, reals, why)
	if read == null {
		return f"{name}: no query; {line}\n"
	}
	let cnf = read ?? return ""
	let none: Vec[Vec[u32]] = []
	let params = sv_walk_params()
	let first = sv_walk(cnf.query, none, params, 5000)
	let again = sv_walk(cnf.query, none, params, 5000)
	let same = first.moves == again.moves && first.values == again.values
	let mut values: collections::BTreeMap[String, i64] = collections::BTreeMap()
	let mut col = 0
	while col < first.values.len() && col < cnf.names.len() {
		values.insert(cnf.names[col].clone(), first.values[col])
		col += 1
	}
	let verdict = match lg_consistent_answer(arena, script.assertions, goal, true, values) {
		LgAnswer::Refuted { .. } => "a model",
		else => "no model",
	}
	return f"{name}: walk found {first.found} in {first.moves} moves, same again {same}, {verdict}; {line}\n"
}

test "the walk finds a random system's model and nothing where there is none" {
	let files = [
		("problem__003", sv_walk_test_problem003()),
		(
			"equation",
			sv_walk_test_smt(
				"sat",
				"Int",
				["x", "y"],
				"(assert (= (+ (* 3 x) (* 5 y)) 7))\n(assert (distinct x y))\n(assert (or (> x 4) (< y (- 3))))\n",
			),
		),
		("unsat", sv_walk_test_smt("unsat", "Int", ["x"], "(assert (>= x 1))\n(assert (<= x 0))\n")),
		("real", sv_walk_test_smt("sat", "Real", ["x"], "(assert (< 0 x 1))\n")),
	]
	let mut out: String = ""
	for (name, text) in files {
		out = out + sv_walk_test_each(f"{name}.smt2", text)
	}
	let expected = [
		"problem__003.smt2: walk found true in 167 moves, same again true, a model; refuted 2/walk",
		"equation.smt2: walk found true in 11 moves, same again true, a model; refuted 7",
		"unsat.smt2: walk found false in 5000 moves, same again true, no model; proved 1/interval",
		"real.smt2: walk found false in 0 moves, same again true, no model; refuted 2",
	]
	assert(out == expected.join("\n") + "\n")
}
