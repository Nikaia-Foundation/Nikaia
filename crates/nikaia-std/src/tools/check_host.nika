// crates/nikaia-std/src/tools/check_host.nika
//
// **What the checker asks of the compiler while it walks** (ADR-294, #125,
// #558, C-4): the services that stay Rust because they are the parser's, the
// interner's, the build's - reading a hole of an `f"..."` back as an expression,
// the call a named function stands for, a symbol made, a build-time value
// folded or compiled and run. `CheckHost` is what the Nikaia half of the
// checker sees of them; `check/host.rs` implements it over the parsed files and
// what the build may read. **Ids stay with the host**: an expression is known
// here by `id_of`, a symbol is whatever the host's interner says.
//
// The seven functions below the checker's core that needed those services are
// methods of `CheckState` here, generic over the host.

use std::collections

/// How folding an initialiser of literals came out: a value, or the refusal
/// the build gave, with a grammar's wall already in the checker's own words.
pub enum CheckBuilt {
    Value(BuildValue),
    /// A shape the folder does not read. **Not an error by itself.**
    Unevaluable,
    OutOfBounds { at: Integer, len: i64 },
    Circular { ring: Vec[String] },
    NotHere { what: String, why: String, way_out: String },
    MayNotRead { path: String, why: Denied },
    PathIsComputed,
    GrammarWall { owner: String, rule: String, why: CheckWall },
}

/// How compiling a `comptime` and running it came out.
pub enum CheckComputed {
    Value(BuildValue),
    /// A callee the ledger says may not run at build time, and why.
    Forbidden { callee: String, because: String },
    /// The run stopped as the program would, in its own words.
    Stopped(String),
    /// Nothing was compiled, and why: the value is refused, never interpreted
    /// (ADR-321 D1).
    NotHere(String),
}

/// What `compiled_build_time_value` came to: whether it answered at all (an
/// initialiser of literals is folded where it did not), the value, and
/// whether the reader was told what is wrong.
pub struct CheckCompiled {
    pub answered: bool,
    pub value: BuildValue?,
    pub said: bool,
}

/// Where a build-time run stopped: a byte of this file, or -1, and the name of
/// the function of another file it stopped in.
pub struct CheckPlace {
    pub at: i64,
    pub function: String?,
}

/// The services of the compiler the checker's core asks for.
pub trait CheckHost {
    /// The expression written in the hole `text` of a literal at byte `site`,
    /// where it parses.
    fn hole(ref self, site: u32, text: ref String) -> Expr? sync
    /// The parameters and the call a named function, or a method named by its
    /// path (`func`, as written), stands for where a function value is kept:
    /// a method call on the first parameter where it takes a `self`
    /// (`receiver`).
    fn kept_call(ref self, func: ref Expr, arity: i64, receiver: bool) -> (Vec[winnow_grammar::Symbol], Expr) sync
    /// A symbol for a name, in the interner of this file.
    fn intern(ref self, text: ref String) -> winnow_grammar::Symbol sync
    /// A hole with the method calls the tier pass wraps its nodes in, by id.
    fn wrap_hole(ref self, hole: ref Expr, wraps: ref Vec[(i64, winnow_grammar::Symbol)]) -> Expr sync
    /// The holes of a literal the emitter reads again, with the names a
    /// template's `<for>` binds around each.
    fn literal_holes(ref self, literal: ref Expr) -> Vec[Expr] sync
    /// The free calls a lambda's body makes, for a function field it is
    /// stored in (ADR-230 D1).
    fn free_calls(ref self, body: ref Block) -> collections::BTreeSet[String] sync
    /// What an initialiser of literals folds to, the names in `held` being
    /// what the scope knows.
    fn evaluate(ref self, value: ref Expr, held: ref collections::BTreeMap[String, BuildValue]) -> CheckBuilt sync
    /// Compile an initialiser with the program's functions and run it.
    fn compute_comptime(ref self, value: ref Expr, found: ref Ty, bound: ref String, known: ref collections::BTreeMap[String, BuildValue], steps: u64?, bytes: u64?) -> CheckComputed sync
    /// Whether a grammar can be run anywhere (a workshop to build it in).
    fn somewhere(ref self) -> bool sync
    /// The text a literal in source stands for.
    fn decoded(ref self, literal: ref String) -> String? sync
    /// The text composed (NFC), by `std`'s own normalisation (ADR-320 D8).
    fn composed(ref self, text: ref String) -> String sync
    /// The file a build reads, by the rules every read keeps.
    fn read(ref self, path: ref String) -> BtRead sync
    /// `value` with each `asset("path")` replaced by the text read for it.
    fn assets_read_in(ref self, value: ref Expr, read: ref collections::BTreeMap[String, String]) -> Expr sync
    /// The name the `comptime` itself runs under.
    fn value_fn(ref self) -> String sync
    /// Where a run that stopped at `place` (`@<file>:<byte>`) stopped, seen
    /// from file `here`.
    fn place_of(ref self, place: ref String, here: i64) -> CheckPlace sync
    /// The first escape in a literal that this language's set does not name
    /// (`build_time::an_escape_nothing_names`, U-c11).
    fn an_escape_nothing_names(ref self, text: ref String) -> NotAnEscape? sync
    /// The value as the author wrote it, where this compiler can say so: a
    /// literal, a name, a negation, and an ellipsis for the rest. A query that
    /// stays Rust until `written` moves (C-5e): the text of a string literal is
    /// Rust's `Debug`.
    fn written(ref self, value: ref Expr) -> String sync
    /// **The holes of a literal as the checker walks them** (U-c1): an
    /// `f"…"`'s as the grammar parsed them, with what the tier pass wraps
    /// inside each, and a template's beside the names its `<for>` binds around
    /// each (name, collection).
    fn holes_read(ref self, literal: ref Expr) -> Vec[(Expr, Vec[(String, String)])] sync
    /// **A declared type, read** (U-c2): the spelling checked and the type
    /// built from the parsed annotation, which stays the parser's.
    fn declared(ref self, mut state: CheckState, ty: ref Type, span: ref Span) -> Ty sync
    /// The payload of `variant` of the `enum` `ty`, in whichever file declares it.
    fn payload_of(ref self, ty: ref String, variant: ref String) -> Vec[Ty]? sync
    /// A finite float as the language below writes it.
    fn float_text(ref self, number: f64) -> String sync
    /// **`field.attribute(X)`'s `X`** (U-c4): one type, an attribute, or
    /// `null` where it is refused.
    fn an_attribute_read(ref self, mut state: CheckState, args: ref Vec[Expr], span: ref Span) -> String? sync
}

/// What the build worked out a local is: the whole value, or the integer the
/// fold left.
fn host_known(local: ref CheckLocal) -> BuildValue? {
    let built: BuildValue? = local.built?.clone()
    if built != null {
        return built
    }
    let number = local.constant ?? return null
    return BuildValue::Int(number)
}

/// The line the run printed that says what it stopped for, or the whole text.
fn host_stopped_line(said: ref String) -> String {
    for line in said.lines() {
        if line.contains("the program stopped") {
            return line.clone()
        }
    }
    return said.clone()
}

/// **Whether an initialiser is literals alone** (ADR-321 D1's last
/// paragraph), which the checker folds without a run: a literal, a name, a
/// tuple, a list, a struct, a variant built, `f"…"`, an operator, an index, a
/// field, an `if` whose branches are values, and `asset("…")`. Anything else
/// is code - a call, a method, a block with statements - and is compiled and
/// run with the program, never interpreted.
fn host_folds(world: ref CheckWorld, value: ref Expr, enums: ref collections::BTreeSet[String]) -> bool {
    return match value {
        Expr::LitInt { .. } => true,
        Expr::LitFloat(_, _) => true,
        Expr::LitBool(_, _) => true,
        Expr::LitStr { .. } => true,
        Expr::Variable(_, _) => true,
        Expr::Path(_, _) => true,
        Expr::Tuple(parts, _) => host_all_fold(world, parts, enums),
        Expr::ListLit { items, .. } => host_all_fold(world, items, enums),
        Expr::Unary { expr, .. } => host_folds(world, expr, enums),
        Expr::Binary { lhs, rhs, .. } => host_folds(world, lhs, enums) && host_folds(world, rhs, enums),
        Expr::Index { base, index, .. } => host_folds(world, base, enums) && host_folds(world, index, enums),
        Expr::Field { base, .. } => host_folds(world, base, enums),
        Expr::StructLit { fields, .. } => {
            let mut all = true
            for field in fields {
                let given = field.value?.clone()
                if given == null || !host_folds(world, given ?? Expr::LitNull(fresh_id()), enums) {
                    all = false
                }
            }
            all
        },
        Expr::LitInterpolated { parts, .. } => {
            let mut all = true
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => {
                        if !host_folds(world, expr, enums) {
                            all = false
                        }
                    },
                    else => {}
                }
            }
            all
        },
        Expr::If { cond, then_branch, else_branch, .. } => {
            let mut all = host_folds(world, cond, enums) && host_branch_folds(world, then_branch, enums)
            if else_branch != null {
                let other = else_branch?.clone() ?? Block { stmts: [] }
                all = all && host_branch_folds(world, other, enums)
            }
            all
        },
        Expr::Call { func, args, config, .. } => {
            match func {
                Expr::Variable(name, _) => world.words.resolve(name) == "asset",
                Expr::Path(path, _) => path.len() == 2 && enums.contains(world.words.resolve(path[0])) && config.len() == 0 && host_all_fold(world, args, enums),
                else => false,
            }
        },
        else => false,
    }
}

fn host_all_fold(world: ref CheckWorld, values: ref Vec[Expr], enums: ref collections::BTreeSet[String]) -> bool {
    for value in values {
        if !host_folds(world, value, enums) {
            return false
        }
    }
    return true
}

/// A branch that is one value.
fn host_branch_folds(world: ref CheckWorld, block: ref Block, enums: ref collections::BTreeSet[String]) -> bool {
    if block.stmts.len() != 1 {
        return false
    }
    return match block.stmts[0].node {
        Stmt::Expr(inner) => host_folds(world, inner, enums),
        else => false,
    }
}

fn host_enum_names(view: ref ParsedView, mut out: collections::BTreeSet[String]) {
    for item in view.items {
        let named: String = match item.node {
            Item::Enum { name, .. } => view.text(name),
            else => "",
        }
        if named != "" {
            out.insert(named)
        }
    }
}

fn host_grammar_names(view: ref ParsedView, mut out: collections::BTreeSet[String]) {
    for item in view.items {
        let named: String = match item.node {
            Item::Grammar(def) => view.text(def.name),
            else => "",
        }
        if named != "" {
            out.insert(named)
        }
    }
}

/// Whether an initialiser runs a grammar of the program: `Json.value(..)` or
/// `Json::value(..)`.
fn host_runs_a_grammar(world: ref CheckWorld, value: ref Expr, grammars: ref collections::BTreeSet[String]) -> bool {
    let mut runs = false
    for expr in visited_in_expr(value) {
        match expr {
            Expr::Call { func, .. } => {
                match func {
                    Expr::Path(path, _) => {
                        if path.len() > 0 && grammars.contains(world.words.resolve(path[0])) {
                            runs = true
                        }
                    },
                    else => {}
                }
            },
            Expr::MethodCall { receiver, .. } => {
                match receiver {
                    Expr::Variable(name, _) => {
                        if grammars.contains(world.words.resolve(name)) {
                            runs = true
                        }
                    },
                    else => {}
                }
            },
            else => {}
        }
    }
    return runs
}

/// The `asset` calls an initialiser holds, in the order they stand: the path
/// and whether it is a literal.
fn host_assets_in[H: CheckHost](world: ref CheckWorld, host: ref H, value: ref Expr) -> Vec[(String, bool)] {
    let mut found: Vec[(String, bool)] = []
    for expr in visited_in_expr(value) {
        match expr {
            Expr::Call { func, args, .. } => {
                match func {
                    Expr::Variable(name, _) => {
                        if world.words.resolve(name) == "asset" {
                            let mut path: String = ""
                            let mut literal = false
                            if args.len() == 1 {
                                match args[0] {
                                    Expr::LitStr { text, .. } => {
                                        let read = host.decoded(text)
                                        if read != null {
                                            path = read ?? ""
                                            literal = true
                                        }
                                    },
                                    else => {}
                                }
                            }
                            found.push((path, literal))
                        }
                    },
                    else => {}
                }
            },
            else => {}
        }
    }
    return found
}

/// **The names a build-time value is computed from, for its rings**
/// (Part II 10.2): each item `comptime`, and each free function with the
/// options a call may leave out.
fn host_ring_names(view: ref ParsedView, mut comptimes: collections::BTreeSet[String], mut options: collections::BTreeMap[String, Vec[String]]) {
    for item in view.items {
        match item.node {
            Item::Comptime { name, .. } => {
                comptimes.insert(view.text(name))
            },
            Item::Fn { name, receiver, config, .. } => {
                if receiver == null && name != null {
                    let mut held: Vec[String] = []
                    for option in config {
                        held.push(view.text(option.name))
                    }
                    options.insert(view.text(name ?? continue), held)
                }
            },
            else => {}
        }
    }
}

/// **Where one expression leads a ring walk**: a `comptime` it reads, a
/// function it names, and the default of each option a call of that function
/// leaves out, which the call reads in its place.
fn host_ring_edge(view: ref ParsedView, expr: ref Expr, comptimes: ref collections::BTreeSet[String], options: ref collections::BTreeMap[String, Vec[String]], mut out: Vec[String]) {
    match expr {
        Expr::Variable(name, _) => {
            let named = view.text(name)
            if comptimes.contains(named) {
                out.push(f"c:{named}")
            }
            if options.get(named) != null {
                out.push(f"f:{named}")
            }
        },
        Expr::Call { func, config, .. } => {
            match func {
                Expr::Variable(name, _) => {
                    let named = view.text(name)
                    let mut given: collections::BTreeSet[String] = collections::BTreeSet()
                    for arg in config {
                        given.insert(view.text(arg.name))
                    }
                    let declared: Vec[String] = options.get(named)?.clone() ?? []
                    for option in declared {
                        if !given.contains(option) {
                            out.push(f"d:{named}:{option}")
                        }
                    }
                },
                else => {}
            }
        },
        else => {}
    }
}

/// The steps of a ring walk out of one file: each `comptime`'s initialiser,
/// each free function's body and each of its options' defaults, with the name
/// a ring says for each.
fn host_ring_graph(view: ref ParsedView, comptimes: ref collections::BTreeSet[String], options: ref collections::BTreeMap[String, Vec[String]], mut graph: collections::BTreeMap[String, Vec[String]], mut labels: collections::BTreeMap[String, String]) {
    for item in view.items {
        match item.node {
            Item::Comptime { name, value, .. } => {
                let named = view.text(name)
                let mut out: Vec[String] = []
                for expr in visited_in_expr(value) {
                    host_ring_edge(view, expr, comptimes, options, out)
                }
                graph.insert(f"c:{named}", out)
                labels.insert(f"c:{named}", named.clone())
            },
            Item::Fn { name, receiver, config, body, .. } => {
                if receiver == null && name != null {
                    let named = view.text(name ?? continue)
                    let mut out: Vec[String] = []
                    for expr in visited_in_block(body) {
                        host_ring_edge(view, expr, comptimes, options, out)
                    }
                    graph.insert(f"f:{named}", out)
                    labels.insert(f"f:{named}", named.clone())
                    for option in config {
                        let mut read: Vec[String] = []
                        for expr in visited_in_expr(option.default) {
                            host_ring_edge(view, expr, comptimes, options, read)
                        }
                        let key = f"d:{named}:{view.text(option.name)}"
                        graph.insert(key.clone(), read)
                        labels.insert(key, named.clone())
                    }
                }
            },
            else => {}
        }
    }
}

/// **The ring reached from `at`**, as the names it goes through, or nothing:
/// `path` holds the steps being followed, `done` the ones that lead to none.
fn host_ring_reach(graph: ref collections::BTreeMap[String, Vec[String]], labels: ref collections::BTreeMap[String, String], at: ref String, mut path: Vec[String], mut done: collections::BTreeSet[String]) -> Vec[String] {
    let mut from = path.len()
    let mut i = 0
    for held in path {
        if held == at && from == path.len() {
            from = i
        }
        i += 1
    }
    if from < path.len() {
        // **A function that calls itself is no ring**: it runs. Only one
        // through a value the build computes - a `comptime` or a default - is.
        let mut computed = false
        let mut ring: Vec[String] = []
        let mut j = from
        while j < path.len() {
            if !path[j].starts_with("f:") {
                computed = true
            }
            ring.push(labels.get(path[j])?.clone() ?? "")
            j += 1
        }
        if !computed {
            return []
        }
        ring.push(labels.get(at)?.clone() ?? "")
        return ring
    }
    if done.contains(at) {
        return []
    }
    let next: Vec[String] = graph.get(at)?.clone() ?? []
    path.push(at.clone())
    for step in next {
        let ring = host_ring_reach(graph, labels, step, path, done)
        if ring.len() > 0 {
            return ring
        }
    }
    path.pop()
    done.insert(at.clone())
    return []
}

/// **A ring a build-time value stands on** (Part II 10.2): a `comptime` read,
/// a function called or an option's default a call leaves out that comes back,
/// through the bodies and defaults it reads in turn, to where it started, or
/// to a ring further on. Nothing where there is none.
fn host_ring(world: ref CheckWorld, value: ref Expr) -> Vec[String] {
    let mut comptimes: collections::BTreeSet[String] = collections::BTreeSet()
    let mut options: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    if world.here_at < 0 {
        host_ring_names(world.here, comptimes, options)
    }
    for file in world.beside {
        host_ring_names(file, comptimes, options)
    }
    let mut start: Vec[String] = []
    for expr in visited_in_expr(value) {
        host_ring_edge(world.here, expr, comptimes, options, start)
    }
    if start.len() == 0 {
        return []
    }
    let mut graph: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    let mut labels: collections::BTreeMap[String, String] = collections::BTreeMap()
    if world.here_at < 0 {
        host_ring_graph(world.here, comptimes, options, graph, labels)
    }
    for file in world.beside {
        host_ring_graph(file, comptimes, options, graph, labels)
    }
    let mut path: Vec[String] = []
    let mut done: collections::BTreeSet[String] = collections::BTreeSet()
    for step in start {
        let ring = host_ring_reach(graph, labels, step, path, done)
        if ring.len() > 0 {
            return ring
        }
    }
    return []
}

impl CheckState {
    /// **`NK1175`: a file this build may not read** (ADR-310), with the way out
    /// that can actually be taken.
    pub fn a_file_this_build_may_not_read(ref mut self, path: ref String, why: ref Denied, span: ref Span) sync {
        let note = why_not_read(why, path)
        let way_out = way_out_of_a_read(why, path)
        self.findings.push(check_refusal("NK1175", span, f"This build isn't allowed to read `{path}`.", [note], way_out))
    }

    /// **A `{..}` in a plain string that would have inserted a value** before
    /// plain strings stopped doing so: a warning, only where the braces hold an
    /// expression that resolves to something that is here.
    pub fn unmarked_hole[H: CheckHost](ref mut self, world: ref CheckWorld, host: ref H, text: ref String, span: ref Span) sync {
        if text.contains("{{") || text.contains("}}") {
            let single = text.replace("{{", "{").replace("}}", "}")
            self.warn_migration(span, "`{{{{` in a plain string is now two braces.".clone(), f"Braces in a plain string don't need escaping any more: write `\"{single}\"`.")
            return
        }
        for hole in brace_groups(text) {
            let found = host.hole(span.start, hole)
            if found == null {
                continue
            }
            let expr = found ?? continue
            if !self.names_something_here(world, expr) {
                continue
            }
            self.warn_migration(span, f"`{{{hole}}}` here is plain text now; it used to insert a value.", f"Write `f\"{text}\"` if you want the value to appear.")
            return
        }
    }

    /// **What an initialiser of literals folds to** (ADR-321 D1), and the
    /// refusal the build gave where it gave one. Nothing here runs a call.
    pub fn build_time_value[H: CheckHost](ref mut self, host: ref H, value: ref Expr, bound: ref String, span: ref Span) -> (BuildValue?, bool) sync {
        // **Read off the scope before the evaluation starts**: later bindings of
        // a name go in after earlier ones, so the innermost is the one that
        // answers.
        let mut held: collections::BTreeMap[String, BuildValue] = collections::BTreeMap()
        for frame in self.scope {
            for local in frame {
                let one = host_known(local)
                if one == null {
                    held.remove(local.name)
                } else {
                    held.insert(local.name.clone(), one ?? continue)
                }
            }
        }
        match host.evaluate(value, held) {
            CheckBuilt::Value(built) => {
                let some: BuildValue? = built
                return (some, false)
            },
            CheckBuilt::Unevaluable => return (null, false),
            CheckBuilt::OutOfBounds { at, len } => self.a_build_time_index_is_not_there(at, len, span),
            CheckBuilt::Circular { ring } => self.a_constant_built_from_itself(bound, ring, span),
            CheckBuilt::NotHere { what, why, way_out } => self.a_build_time_body_that_is_not_here(bound, what, why, way_out, span),
            CheckBuilt::MayNotRead { path, why } => self.a_file_this_build_may_not_read(path, why, span),
            CheckBuilt::PathIsComputed => self.a_path_that_is_not_a_literal(span),
            CheckBuilt::GrammarWall { owner, rule, why } => self.a_grammar_that_did_not_run(owner, rule, why, span),
        }
        return (null, true)
    }

    /// **A `comptime` whose initialiser runs code**, compiled and run
    /// (ADR-321 D1): nothing where it is literals alone, which the checker
    /// folds, or runs a grammar; refused where this check has no place to
    /// compile it (D19) or this compiler builds no program for it. **Never
    /// interpreted.**
    ///
    /// **The rule is asked first** (D2): each function the initialiser calls is
    /// read off the ledger, and one that may not run is `NK1152` before
    /// anything is compiled.
    pub fn compiled_build_time_value[H: CheckHost](ref mut self, world: ref CheckWorld, host: ref H, value: ref Expr, found: ref Ty, bound: ref String, span: ref Span) -> CheckCompiled sync {
        if !self.flow.computes {
            return CheckCompiled { answered: true, value: null, said: true }
        }
        let nothing = CheckCompiled { answered: false, value: null, said: false }
        // **A ring is refused by name** (Part II 10.2), before anything is
        // folded or compiled: one through the bodies it calls and the defaults
        // those calls leave out has no first value to compute.
        let ring = host_ring(world, value)
        if ring.len() > 0 {
            // **The constant on this line where it is in the ring**, and the
            // first one met otherwise: a default, or a value that reads a ring
            // further on.
            let mut subject = ring[0].clone()
            if !self.computing_default {
                for name in ring {
                    if name == bound {
                        subject = bound.clone()
                    }
                }
            }
            self.a_constant_built_from_itself(subject, ring, span)
            return CheckCompiled { answered: true, value: null, said: true }
        }
        // **Every file of the program** (Part I 9.1), this one among them; a
        // check handed none is this file alone.
        let mut here = world.here_at
        if here < 0 {
            here = 0
        }
        // **A grammar run is its own** (ADR-177): its parser is compiled and
        // run by the grammar's workshop, and the text it reads is folded.
        let mut grammars: collections::BTreeSet[String] = collections::BTreeSet()
        let mut enums: collections::BTreeSet[String] = collections::BTreeSet()
        if world.here_at < 0 {
            host_grammar_names(world.here, grammars)
            host_enum_names(world.here, enums)
        }
        for file in world.beside {
            host_grammar_names(file, grammars)
            host_enum_names(file, enums)
        }
        if host_runs_a_grammar(world, value, grammars) {
            return nothing
        }
        // **Code somewhere in it**, which is what D1 compiles: an initialiser
        // of literals alone is folded. A variant built is a value written down.
        if host_folds(world, value, enums) {
            return nothing
        }
        // **Nowhere to compile it is a refusal** (D19), not a value left open.
        if !host.somewhere() {
            self.a_build_time_value_with_nowhere_to_compile(bound, span)
            return CheckCompiled { answered: true, value: null, said: true }
        }
        // **The build reads, the run does not** (ADR-310): each file is read
        // here, by the rules every read keeps, and its text stands where the
        // `asset` did.
        let mut read: collections::BTreeMap[String, String] = collections::BTreeMap()
        for (path, literal) in host_assets_in(world, host, value) {
            if !literal {
                self.a_path_that_is_not_a_literal(span)
                return CheckCompiled { answered: true, value: null, said: true }
            }
            let got = host.read(path)
            if got.denied != null {
                self.a_file_this_build_may_not_read(path, got.denied ?? continue, span)
                return CheckCompiled { answered: true, value: null, said: true }
            }
            read.insert(path.clone(), got.text ?? "")
        }
        let rewritten = host.assets_read_in(value, read)
        let mut outermost: collections::BTreeMap[String, BuildValue] = collections::BTreeMap()
        if self.scope.len() > 0 {
            for local in self.scope[0] {
                let one = host_known(local)
                if one != null {
                    outermost.insert(local.name.clone(), one ?? continue)
                }
            }
        }
        match host.compute_comptime(rewritten, found, bound, outermost, self.flow.raised.0, self.flow.raised.1) {
            CheckComputed::Value(computed) => return CheckCompiled { answered: true, value: computed, said: false },
            CheckComputed::Forbidden { callee, because } => self.a_body_that_may_not_run_at_build_time(callee, because, span),
            CheckComputed::Stopped(detail) => self.a_build_time_run_that_stopped(host, bound, detail, here, span),
            CheckComputed::NotHere(why) => self.a_build_time_value_not_compiled(bound, why, span),
        }
        return CheckCompiled { answered: true, value: null, said: true }
    }

    /// **`NK1127` where this check has no place to compile build-time code**
    /// (ADR-321 D19): a value that runs code is computed by compiling it and
    /// running it, and a caller is never told a program is checked when one
    /// of its values was never computed.
    pub fn a_build_time_value_with_nowhere_to_compile(ref mut self, bound: ref String, span: ref Span) sync {
        let mut help: String = f"Check it with `nikaia check` or `nikaia build`, which have one, or write `let {bound} = …` to compute it while the program runs."
        if self.computing_default {
            help = f"Check it with `nikaia check` or `nikaia build`, which have one, or make `{bound}` a `T?` and compute it in the body."
        }
        self.findings.push(check_refusal("NK1127", span, f"`{bound}` can't be computed while the program is built.", ["This check has no place to compile build-time code in, and a value that runs code is computed only by compiling it and running it.".clone()], help))
    }

    /// **`NK1127` where this compiler builds no program for a value** (ADR-321
    /// D1): it is not computed, and nothing interprets it instead.
    pub fn a_build_time_value_not_compiled(ref mut self, bound: ref String, why: ref String, span: ref Span) sync {
        let mut help: String = f"Write `let {bound} = …` to compute it while the program runs."
        if self.computing_default {
            help = f"Make `{bound}` a `T?` and compute it in the body."
        }
        self.findings.push(check_refusal("NK1127", span, f"`{bound}` can't be computed while the program is built.", [f"{why}."], help))
    }

    /// **A build-time run that stopped as the program would** (ADR-321 D1): the
    /// same code stops the program the same way. In its own words, at the place
    /// it stopped where the run named one.
    pub fn a_build_time_run_that_stopped[H: CheckHost](ref mut self, host: ref H, bound: ref String, said: ref String, here: i64, span: ref Span) sync {
        for line in said.lines() {
            if line.starts_with("nikaia-build-time: ") {
                let over = line.strip_prefix("nikaia-build-time: ") ?? ""
                let value_fn = host.value_fn()
                self.a_build_time_run_over_its_bound(bound, over, value_fn, span)
                return
            }
        }
        let line = host_stopped_line(said)
        let mut place: String = ""
        let mut why: String = line.clone()
        let cut = line.find(": the program stopped: ")
        if cut != null {
            let at = cut ?? 0
            place = line[0..<at].clone()
            why = line[at + ": the program stopped: ".len()..].clone()
        }
        let found = host.place_of(place, here)
        self.a_build_time_run_that_stopped_at(bound, why, found.at, found.function, span)
    }

    /// **The reference the compiler writes for a lent part**: a part the arm
    /// binds `ref` is a view already (#270), and a call that lends it hands it
    /// on as it is. Decided after the arm, because whether a part is lent is
    /// known only once the arm is walked; the arguments recorded meanwhile are
    /// found again by their ids. Only where nothing in the arm binds the name
    /// again.
    pub fn a_lent_part_is_handed_on_as_it_is[H: CheckHost](ref mut self, world: ref CheckWorld, host: ref H, body: ref Expr, lent: ref collections::BTreeSet[String]) sync {
        let mut is_block = false
        let mut empty = false
        match body {
            Expr::Block(block, _) => {
                is_block = true
                empty = block.stmts.len() == 0
            },
            else => {}
        }
        if !is_block {
            self.a_lent_part_in_an_expression_arm(world, body, lent)
            return
        }
        if empty {
            return
        }
        let mut named: collections::BTreeSet[i64] = collections::BTreeSet()
        let mut bound_again = false
        let mut pending: Vec[Expr] = []
        for expr in visited_in_expr(body) {
            match expr {
                Expr::Variable(name, _) => {
                    if lent.contains(world.words.resolve(name)) {
                        named.insert(node_key(expr))
                    }
                },
                Expr::Block(inner, _) => {
                    if lent_binds_again(world, inner, lent) {
                        bound_again = true
                    }
                },
                Expr::LitInterpolated { .. } => pending.extend(host.literal_holes(expr)),
                else => {}
            }
        }
        // An `f"..."` hole is read again from its text, with the names it
        // shares with the arm, so its calls are the arm's too.
        let mut at = 0
        while at < pending.len() {
            let hole = pending[at].clone()
            at = at + 1
            for expr in visited_in_expr(hole) {
                match expr {
                    Expr::Variable(name, _) => {
                        if lent.contains(world.words.resolve(name)) {
                            named.insert(node_key(expr))
                        }
                    },
                    Expr::Block(inner, _) => {
                        if lent_binds_again(world, inner, lent) {
                            bound_again = true
                        }
                    },
                    Expr::LitInterpolated { .. } => pending.extend(host.literal_holes(expr)),
                    else => {}
                }
            }
        }
        if bound_again || named.len() == 0 {
            return
        }
        for id in named {
            self.facts.lent_args.remove(id)
        }
    }

    /// **The same for an arm that is an expression** (#456): it has no
    /// statements of its own to find its arguments by, so each argument that
    /// names a lent part is marked by its node.
    fn a_lent_part_in_an_expression_arm(ref mut self, world: ref CheckWorld, body: ref Expr, lent: ref collections::BTreeSet[String]) sync {
        let mut named: Vec[i64] = []
        let mut bound_again = false
        for expr in visited_in_expr(body) {
            match expr {
                Expr::Variable(name, _) => {
                    if lent.contains(world.words.resolve(name)) {
                        named.push(node_key(expr))
                    }
                },
                Expr::Block(inner, _) => {
                    if lent_binds_again(world, inner, lent) {
                        bound_again = true
                    }
                },
                else => {}
            }
        }
        if !bound_again {
            for id in named {
                self.facts.views_handed_on.insert(id)
            }
        }
    }
}

/// Whether a block binds one of the lent names again with a `let`.
fn lent_binds_again(world: ref CheckWorld, block: ref Block, lent: ref collections::BTreeSet[String]) -> bool {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, .. } => {
                for name in names {
                    if lent.contains(world.words.resolve(name)) {
                        return true
                    }
                }
            },
            else => {}
        }
    }
    return false
}
