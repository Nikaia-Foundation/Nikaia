// crates/nikaia-std/src/tools/sv_elim.nika
//
// **Exact equality elimination** before Fourier-Motzkin (ADR-270 D5, #1282
// item 6). An equality is two bounds `R <= 0` and `-R <= 0`. One with a
// coefficient `±1` on a column is solved for it and substituted into every
// other bound - each substitution a `Combine` of the bound and one side. One
// without is first given such a column by D5's extension, Pugh's symmetric
// step (#1312): for the coefficient `a` of least magnitude, on `x_k`, and
// `m = |a| + 1`, `L = Σ â_i·x_i + ĉ` with `â` the residue mod `m` nearest 0
// (`x_k`'s is `∓1`) and the fresh `q = ⌊L / m⌋` make `S`, with `S <= 0` the
// combination of `R <= 0` and `m·q - L <= 0` and `-S <= 0` the rounded
// combination of `-R <= 0` and `L - m·q - (m - 1) <= 0`; `S` has `x_k` with
// a unit coefficient and every other coefficient at most about `|a_i| / m`,
// so it is substituted at once and the coefficients shrink without
// overflowing (the omega test's equality step). When the equalities are gone
// the columns that steps introduced are reduced pairwise (Lagrange): an
// extension with `m = 1` names `t_v + k·t_u` and substitutes it for `t_v`, a
// unimodular change that keeps the bounds' coefficients small.
// Every bound is kept divided by its gcd and rounded (Chvátal-Gomory), so an
// equality whose coefficients' gcd does not divide its constant shows as two
// bounds whose sum is a positive constant: the GCD test, a Farkas lemma.

use std::collections

/// Whether `r` and `s` have the same columns with opposite coefficients.
fn sv_opposite(r: ref SvRow, s: ref SvRow) -> bool {
	if r.cols != s.cols {
		return false
	}
	let mut i = 0
	while i < r.ks.len() {
		let n = r.ks[i].checked_neg() ?? return false
		if n != s.ks[i] {
			return false
		}
		i += 1
	}
	return true
}

/// `h` divided by the gcd of its coefficients and constant, then by that of
/// its coefficients with the constant rounded up; each a step where it
/// changes the bound.
fn sv_tidy(h: SvHeld, mut book: SvBook) -> SvHeld? {
	let mut row = h.row.clone()
	let mut src = h.src.clone()
	if !sv_row_same(sv_row_reduced(row.clone()), row) {
		let id = book.combine([src], [1]) ?? return null
		row = (book.bounds.get(id) ?? return null).row.clone()
		src = SvSrc::Fact(id)
	}
	let g = sv_row_content(row) ?? return null
	if g > 1 && row.cols.len() > 0 {
		let id = book.combine([src], [1]) ?? return null
		let made = book.round(id) ?? return null
		row = (book.bounds.get(made) ?? return null).row.clone()
		src = SvSrc::Fact(made)
	}
	return SvHeld { row: row, src: src }
}

/// The column of `r` with a coefficient `±1` that most other bounds of
/// `held` hold, the lowest on a tie; `null` where none has one.
fn sv_unit_column(r: ref SvRow, held: ref Vec[SvHeld]) -> u32? {
	let mut best: u32? = null
	let mut best_uses = -1
	let mut i = 0
	while i < r.cols.len() {
		let k = r.ks[i]
		if k == 1 || k == -1 {
			let c = r.cols[i]
			let mut uses = 0
			for h in held {
				if sv_row_coef(h.row, c) != 0 {
					uses += 1
				}
			}
			if uses > best_uses {
				best = c
				best_uses = uses
			}
		}
		i += 1
	}
	return best
}

/// `held` with column `x` substituted by the equality `lo` (`R <= 0`) and
/// `hi` (`-R <= 0`), `R`'s coefficient `s = ±1` on `x`; the two sides
/// dropped. `null`, and nothing written, where a row leaves `i64`.
fn sv_substituted(
	held: ref Vec[SvHeld],
	lo: i64,
	hi: i64,
	x: u32,
	s: i64,
	mut book: SvBook,
) -> Vec[SvHeld]? {
	// The rows first, so an overflow writes nothing.
	let mut i = 0
	while i < held.len() {
		let b = sv_row_coef(held[i].row, x)
		if i != lo && i != hi && b != 0 {
			// #1293: `(b > 0) == (s > 0)` loses its parentheses.
			let same = b > 0
			let side = if same == (s > 0) { hi } else { lo }
			let m = b.checked_abs() ?? return null
			sv_row_sum(1, held[i].row, m, held[side].row) ?? return null
		}
		i += 1
	}
	let mut out: Vec[SvHeld] = []
	i = 0
	while i < held.len() {
		let b = sv_row_coef(held[i].row, x)
		if i == lo || i == hi {
			i += 1
			continue
		}
		if b == 0 {
			out.push(held[i].clone())
			i += 1
			continue
		}
		// #1293: `(b > 0) == (s > 0)` loses its parentheses.
		let same = b > 0
		let side = if same == (s > 0) { hi } else { lo }
		let m = b.checked_abs() ?? return null
		let id = book.combine([held[i].src.clone(), held[side].src.clone()], [1, m]) ?? return null
		let row = (book.bounds.get(id) ?? return null).row.clone()
		out.push(SvHeld { row: row, src: SvSrc::Fact(id) })
		i += 1
	}
	return out
}

/// `a mod^ m` for `m > 0` (Pugh's symmetric modulo): `a - m·⌊a/m + 1/2⌋`,
/// in `[-m/2, m/2)`.
fn sv_mod_hat(a: i64, m: i64) -> i64 {
	let r = a.rem_euclid(m)
	return if r >= m - r { r - m } else { r }
}

/// The equality `lo`, `hi` without a unit coefficient given one, by the
/// omega test's equality step with Pugh's symmetric modulo: for the
/// smallest coefficient `a > 0` on `x_k` (the row's sign chosen so) and
/// `m = a + 1`, the extension `q = ⌊L / m⌋` of `L = Σ (a_i mod^ m)·x_i +
/// (c mod^ m)`, whose `x_k` coefficient is `-1`, gives `S = q + Σ ((a_i -
/// a_i mod^ m) / m)·x_i + (c - c mod^ m) / m`, with `x_k`'s coefficient
/// `1`: `S <= 0` is `R <= 0` plus `m·q - L <= 0` divided by `m`, `-S <= 0`
/// the rounded sum of `-R <= 0` and `L - m·q - (m - 1) <= 0`. The two
/// bounds of `S` are added to `held`; their indices and `x_k`, `null`, and
/// `held` as it was, where a row leaves `i64`. Substituting `x_k` by `S`
/// leaves `R` with `q`'s coefficient `-a` and the others about `a_i / m`
/// plus `a_i mod^ m`, so the coefficients shrink at each step.
fn sv_extended(mut held: Vec[SvHeld], lo: i64, hi: i64, mut book: SvBook) -> u32? {
	let mut low = lo
	let mut high = hi
	let r = held[lo].row.clone()
	let mut k = 0
	let mut i = 1
	while i < r.ks.len() {
		if (r.ks[i].checked_abs() ?? return null) < (r.ks[k].checked_abs() ?? return null) {
			k = i
		}
		i += 1
	}
	if r.ks[k] < 0 {
		low = hi
		high = lo
	}
	let row = held[low].row.clone()
	let m = row.ks[k].checked_add(1) ?? return null
	let mut terms: Vec[SvTerm] = []
	for j in 0..<row.cols.len() {
		let h = sv_mod_hat(row.ks[j], m)
		if h != 0 {
			terms.push(SvTerm { col: row.cols[j], k: h })
		}
	}
	let l = sv_row_of(terms, sv_mod_hat(row.constant, m)) ?? return null
	// The rows of `S` first, so an overflow writes nothing.
	let mq = SvRow { cols: [book.log.columns], ks: [m], constant: 0 }
	sv_row_sum(1, row, 1, sv_row_sum(-1, l, 1, mq) ?? return null) ?? return null
	let ext = book.extend(l, m) ?? return null
	let le = book.combine([held[low].src.clone(), SvSrc::Fact(ext.first)], [1, 1]) ?? return null
	let ge0 = book.combine([held[high].src.clone(), SvSrc::Fact(ext.first + 1)], [1, 1])
		?? return null
	let ge = book.round(ge0) ?? return null
	for id in [le, ge] {
		let made = (book.bounds.get(id) ?? return null).row.clone()
		held.push(SvHeld { row: made, src: SvSrc::Fact(id) })
	}
	return row.cols[k]
}

/// The products `N_u·N_v` and `N_v·N_v` of two columns' vectors over the
/// rows of `held`; `null` where one leaves `i64`.
struct SvDots {
	uv: i64,
	vv: i64,
}

fn sv_dots(held: ref Vec[SvHeld], u: u32, v: u32) -> SvDots? {
	let mut uv: i64 = 0
	let mut vv: i64 = 0
	for h in held {
		let a = sv_row_coef(h.row, u)
		let b = sv_row_coef(h.row, v)
		uv = sv_mul_add(1, uv, a, b) ?? return null
		vv = sv_mul_add(1, vv, b, b) ?? return null
	}
	return SvDots { uv: uv, vv: vv }
}

/// One step of a pairwise (Lagrange) reduction of `held`'s columns, the
/// vectors of their coefficients over the rows: the first pair `u`, `v`
/// where `N_u - k·N_v` is shorter than `N_u` for `k` the nearest integer to
/// `N_u·N_v / N_v·N_v`. It is the change of variables `t_v = t'_v - k·t_u`:
/// the extension `t'_v = ⌊(t_v + k·t_u) / 1⌋`, an equality with `t_v`'s
/// coefficient `1`, substituted. An equality eliminated by extensions
/// leaves its solutions parametrised by a lattice basis that is far from
/// short; reduced, the bounds over it have small coefficients again.
/// `false` where no pair shortens or a row leaves `i64`.
fn sv_reduce_step(
	mut held: Vec[SvHeld],
	mut solved: Vec[SvSolved],
	mut book: SvBook,
) -> bool {
	let mut cols: Vec[u32] = []
	for h in held {
		for c in h.row.cols {
			if !cols.contains(c) {
				cols.push(c)
			}
		}
	}
	cols.sort()
	for u in cols {
		for v in cols {
			if u == v {
				continue
			}
			let dots = sv_dots(held, u, v) ?? continue
			let uv = dots.uv
			let vv = dots.vv
			if vv == 0 {
				continue
			}
			// `k = ⌊uv / vv + 1/2⌋`; shorter where `k² vv - 2k uv < 0`.
			let half = vv / 2
			let k = sv_floor_div(uv.checked_add(half) ?? continue, vv) ?? continue
			if k == 0 {
				continue
			}
			let kk = k.checked_mul(k) ?? continue
			let gain = sv_mul_add(kk, vv, -2 * k, uv) ?? continue
			if gain >= 0 {
				continue
			}
			let l = sv_row_of([SvTerm { col: v, k: 1 }, SvTerm { col: u, k: k }], 0) ?? continue
			let ext = book.extend(l, 1) ?? return false
			// `t_v + k·t_u - t'_v <= 0` and its opposite. `second` named:
			// `get(ext.first + 1)` fails in rustc (#1290).
			let second = ext.first + 1
			let lo_row = (book.bounds.get(second) ?? return false).row.clone()
			let hi_row = (book.bounds.get(ext.first) ?? return false).row.clone()
			let at = held.len()
			held.push(SvHeld { row: lo_row.clone(), src: SvSrc::Fact(second) })
			held.push(SvHeld { row: hi_row, src: SvSrc::Fact(ext.first) })
			match sv_substituted(held, at, at + 1, v, 1, book) {
				null => {
					held.pop()
					held.pop()
					return false
				},
				next => { held = next ?? return false },
			}
			solved.push(SvSolved { column: v, row: lo_row })
			return true
		}
	}
	return false
}

/// **The elimination**: `held` tidied, its constant bounds checked, its
/// equalities solved and substituted one by one (a unit coefficient first,
/// then the fewest columns), each solved column kept in `solved` for the
/// model. A conflict on the way is the answer; else `Consistent`, and what
/// is left in `held` goes to Fourier-Motzkin.
fn sv_eliminate(
	mut held: Vec[SvHeld],
	mut solved: Vec[SvSolved],
	mut book: SvBook,
) -> SvChecked {
	// Every bound here is `row <= 0` over the integers, divided and rounded:
	// a query with a real column is outside it (ADR-270 D27).
	if book.reals.len() > 0 {
		return SvChecked::Unknown(LgUnknown::OutsideTheTheory)
	}
	let mut skipped: Vec[SvRow] = []
	let mut extended = false
	let mut rounds = 0
	while rounds < 4096 {
		rounds += 1
		let mut kept: Vec[SvHeld] = []
		for h in held {
			let t = sv_tidy(h.clone(), book) ?? return SvChecked::Unknown(LgUnknown::Overflow)
			if t.row.cols.len() > 0 {
				kept.push(t)
				continue
			}
			if t.row.constant > 0 {
				let clause = book.farkas([t.src], [1])
					?? return SvChecked::Unknown(LgUnknown::Overflow)
				return SvChecked::Conflict(clause)
			}
		}
		held = kept
		// The equality to solve: `lo` and `hi`, opposite rows whose
		// constants cancel; opposite rows whose constants sum above zero
		// refute at once.
		let mut lo = -1
		let mut hi = -1
		let mut best = 0
		let mut i = 0
		while i < held.len() {
			let mut j = i + 1
			while j < held.len() {
				if sv_opposite(held[i].row, held[j].row) {
					let sum = held[i].row.constant.checked_add(held[j].row.constant)
						?? return SvChecked::Unknown(LgUnknown::Overflow)
					if sum > 0 {
						let clause = book.farkas([held[i].src.clone(), held[j].src.clone()], [1, 1])
							?? return SvChecked::Unknown(LgUnknown::Overflow)
						return SvChecked::Conflict(clause)
					}
					let mut known = false
					for s in skipped {
						known = known || sv_row_same(s, held[i].row)
					}
					if sum == 0 && !known {
						let unit = sv_unit_column(held[i].row, held) != null
						// A unit coefficient first, then the fewest columns: an
						// equality just extended has fewer columns than its `S`,
						// and chosen again it would be extended for ever (#1283).
						let cost = held[i].row.cols.len() + if unit { 0 } else { 4294967296 }
						if lo < 0 || cost < best {
							lo = i
							hi = j
							best = cost
						}
					}
				}
				j += 1
			}
			i += 1
		}
		if lo < 0 {
			// No equality left: the columns an extension made reduced.
			if extended && sv_reduce_step(held, solved, book) {
				continue
			}
			break
		}
		let column = sv_unit_column(held[lo].row, held)
		if column == null {
			let at = held.len()
			let eq = held[lo].row.clone()
			match sv_extended(held, lo, hi, book) {
				null => skipped.push(eq),
				xk => {
					// `x_k` by `S` at once: another unit column of `S`
					// substituted would grow `R` instead.
					extended = true
					let x = xk ?? break
					let s_row = held[at].row.clone()
					let unit = sv_row_coef(s_row, x)
					let next = sv_substituted(held, at, at + 1, x, unit, book)
					if next == null {
						skipped.push(eq)
						continue
					}
					held = next ?? break
					solved.push(SvSolved { column: x, row: s_row })
				},
			}
			continue
		}
		let x = column ?? break
		let s = sv_row_coef(held[lo].row, x)
		let row = held[lo].row.clone()
		let next = sv_substituted(held, lo, hi, x, s, book)
		if next == null {
			skipped.push(row)
			continue
		}
		held = next ?? break
		solved.push(SvSolved { column: x, row: row })
	}
	return SvChecked::Consistent
}

// --- Tests: exact equality elimination as the CDCL(T) engine uses it (moved
// from `tests/compiler/tests/solver_parity.nika`, which compiled the solver
// anew in a program of its own on every run): queries Fourier-Motzkin leaves
// unknown over the integers - an even and an odd value of one `x`, a gcd that
// does not divide, a sum of n values in `{-1, 1}` for n = 2..12, odd n
// answered with a model, even n proved with a log that grows linearly in n
// through `q = ⌊(x+1)/2⌋` per value (#1284 item 2) - answered over the
// simplex alone, over Fourier-Motzkin with the elimination and its extension,
// and over both, each proof a log `sv_check` replays ---

// Each query answered over the simplex, over Fourier-Motzkin with the exact
// equality elimination, and over both, the log of a proof replayed by
// `sv_check`.
fn sv_elim_test_answer_kind(answer: ref LgAnswer) -> String {
	return match answer {
		LgAnswer::Proved { .. } => "proved",
		LgAnswer::Refuted { .. } => "refuted",
		LgAnswer::Unknown { why } => sv_unknown(why),
	}
}

fn sv_elim_test_engine(arena: ref TermArena, facts: ref Vec[i64], goal: i64, theory: String) -> String {
	let run = sv_smt_engine(arena, facts, goal, lg_budget(), theory)
	return match run.driven {
		SvDriven::Proved(query, steps) => {
			let v = sv_check(query, steps)
			if v.ok { f"proved, log of {steps.len()} steps checked" } else { f"log rejected: {v.reason}" }
		},
		SvDriven::Answer(answer) => sv_elim_test_answer_kind(answer),
		SvDriven::RealModel(_) => "refuted",
	}
}

fn sv_elim_test_both(name: String, source: String) -> String {
	let script = match lg_smtlib_read(source) {
		LgRead::Script(s) => s.clone(),
		LgRead::Failed(_) => {
			return f"{name}: unreadable\n"
		},
	}
	let mut arena = script.arena.clone()
	let goal = arena.boolean(false)
	let simplex = sv_elim_test_engine(arena, script.assertions, goal, "simplex")
	let fm = sv_elim_test_engine(arena, script.assertions, goal, "fm")
	let both = sv_elim_test_engine(arena, script.assertions, goal, "both")
	return f"{name}: simplex {simplex}; fm {fm}; both {both}\n"
}

// `Σ xᵢ = 1` over `n` values `xᵢ ∈ {-1, 1}`: unsat for an even `n`.
fn sv_elim_test_sum(n: i64) -> String {
	let mut text: String = "(set-logic QF_LIA)\n"
	let mut terms: String = ""
	for i in 1..<n + 1 {
		text = text + f"(declare-const x{i} Int)\n"
		terms = terms + f" x{i}"
	}
	for i in 1..<n + 1 {
		text = text + f"(assert (or (= x{i} (- 1)) (= x{i} 1)))\n"
	}
	return text + f"(assert (= (+{terms}) 1))\n(check-sat)\n"
}

test "an even and odd value and a gcd that does not divide are proved with a checked log" {
	let decl = "(set-logic QF_LIA)\n(declare-const x Int)\n(declare-const n Int)\n(declare-const m Int)\n"
	let files: Vec[(String, String)] = [
		("even-odd", decl + "(assert (= x (* 2 n)))\n(assert (= x (+ (* 2 m) 1)))\n(check-sat)\n"),
		("gcd", decl + "(assert (= (+ (* 6 x) (* 9 n)) (+ (* 3 m) 2)))\n(check-sat)\n"),
		("even-even", decl + "(assert (= x (* 2 n)))\n(assert (= x (+ (* 4 m) 2)))\n(check-sat)\n"),
	]
	let mut out: String = ""
	for (name, text) in files {
		out = out + sv_elim_test_both(f"{name}.smt2", text)
	}
	let expected = [
		"even-odd.smt2: simplex proved, log of 10 steps checked; fm proved, log of 10 steps checked; both proved, log of 10 steps checked",
		"gcd.smt2: simplex proved, log of 4 steps checked; fm proved, log of 4 steps checked; both proved, log of 4 steps checked",
		"even-even.smt2: simplex refuted; fm refuted; both refuted",
	]
	assert(out == expected.join("\n") + "\n")
}

test "sums of n values in {-1, 1} are refuted for odd n and proved with a linear log for even n" {
	let mut out: String = ""
	for n in 2..<13 {
		out = out + sv_elim_test_both(f"sum-{n}.smt2", sv_elim_test_sum(n))
	}
	let expected = [
		"sum-2.smt2: simplex proved, log of 54 steps checked; fm proved, log of 56 steps checked; both proved, log of 54 steps checked",
		"sum-3.smt2: simplex refuted; fm refuted; both refuted",
		"sum-4.smt2: simplex proved, log of 100 steps checked; fm proved, log of 106 steps checked; both proved, log of 100 steps checked",
		"sum-5.smt2: simplex refuted; fm refuted; both refuted",
		"sum-6.smt2: simplex proved, log of 146 steps checked; fm proved, log of 156 steps checked; both proved, log of 146 steps checked",
		"sum-7.smt2: simplex refuted; fm refuted; both refuted",
		"sum-8.smt2: simplex proved, log of 192 steps checked; fm proved, log of 206 steps checked; both proved, log of 192 steps checked",
		"sum-9.smt2: simplex refuted; fm refuted; both refuted",
		"sum-10.smt2: simplex proved, log of 238 steps checked; fm proved, log of 256 steps checked; both proved, log of 238 steps checked",
		"sum-11.smt2: simplex refuted; fm refuted; both refuted",
		"sum-12.smt2: simplex proved, log of 284 steps checked; fm proved, log of 306 steps checked; both proved, log of 284 steps checked",
	]
	assert(out == expected.join("\n") + "\n")
}

// --- Tests: equalities without overflow (moved from
// `tests/compiler/tests/solver_omega.nika`, which compiled the solver anew in
// a program of its own on every run): the exact theory eliminates an
// equality through its coefficient of least magnitude with Pugh's symmetric
// step, an `Extend` with `m = |a| + 1` whose two bounds, combined with the
// equality's sides and one rounded, give a unit column; then the columns the
// steps introduced are reduced pairwise, each an `Extend` with `m = 1`. Each
// line counts the log's steps by kind and says whether `sv_check` replays it ---

fn sv_omega_test_row1(ks: Vec[i64], c: i64) -> SvRow {
	let mut terms: Vec[SvTerm] = []
	let mut i: u32 = 0
	for k in ks {
		terms.push(SvTerm { col: i, k: k })
		i += 1
	}
	return sv_row_of(terms, c) ?? sv_row_constant(0)
}

fn sv_omega_test_le(ks: Vec[i64], c: i64) -> SvAtom {
	return SvAtom { row: sv_omega_test_row1(ks, c), rel: SvRel::Le }
}

// `Σ ks_i·x_i + c = 0` as two atoms, `<=` and `>=`, as the reader gives
// an equality to the exact theory.
fn sv_omega_test_eq(mut atoms: Vec[SvAtom], ks: Vec[i64], c: i64) {
	let mut neg: Vec[i64] = []
	for k in ks {
		neg.push(-k)
	}
	atoms.push(sv_omega_test_le(ks, c))
	atoms.push(sv_omega_test_le(neg, -c))
}

// `lo <= x_i <= hi` as two atoms, `x_i` of `n` columns.
fn sv_omega_test_boxed(mut atoms: Vec[SvAtom], n: i64, i: i64, lo: i64, hi: i64) {
	let mut down: Vec[i64] = []
	let mut up: Vec[i64] = []
	let mut j = 0
	while j < n {
		down.push(if j == i { -1 } else { 0 })
		up.push(if j == i { 1 } else { 0 })
		j += 1
	}
	atoms.push(sv_omega_test_le(down, lo))
	atoms.push(sv_omega_test_le(up, -hi))
}

// The log's steps by kind.
fn sv_omega_test_kinds(steps: ref Vec[SvStep]) -> String {
	let mut e = 0
	let mut c = 0
	let mut r = 0
	let mut f = 0
	let mut l = 0
	for st in steps {
		match st {
			SvStep::Extend(..) => { e += 1 },
			SvStep::Combine(..) => { c += 1 },
			SvStep::Round(..) => { r += 1 },
			SvStep::Farkas(..) => { f += 1 },
			SvStep::Learn(..) => { l += 1 },
			else => {},
		}
	}
	return f"{e} extend, {c} combine, {r} round, {f} farkas, {l} learn"
}

// The log with one step broken: `divisor` the first extension's divisor
// one too large, `round` the first rounding by 1 (none).
fn sv_omega_test_broken(steps: ref Vec[SvStep], how: String) -> Vec[SvStep] {
	let mut out: Vec[SvStep] = []
	let mut extends = 0
	let mut rounds = 0
	for st in steps {
		let mut next = st.clone()
		match st {
			SvStep::Extend(l, m, q) => {
				extends += 1
				if how == "divisor" && extends == 1 {
					next = SvStep::Extend(l.clone(), m + 1, q)
				}
			},
			SvStep::Round(id, d) => {
				rounds += 1
				if how == "round" && rounds == 1 {
					next = SvStep::Round(id, 1)
				}
			},
			else => {},
		}
		out.push(next)
	}
	return out
}

// Whether every atom holds under `values` (the columns by name).
fn sv_omega_test_holds(atoms: ref Vec[SvAtom], names: ref Vec[String], values: ref collections::BTreeMap[String, i64]) -> bool {
	for a in atoms {
		let mut sum = a.row.constant
		let mut i = 0
		while i < a.row.cols.len() {
			let name = names[a.row.cols[i] as i64].clone()
			let v = values.get(name) ?? return false
			sum = sum + a.row.ks[i] * v
			i += 1
		}
		if sum > 0 {
			return false
		}
	}
	return true
}

// Every atom asserted to the exact theory at one level, then a final check;
// a conflict closed by one learned clause and the log replayed, broken as
// `how` says where it is not `""`.
fn sv_omega_test_run(title: String, names: Vec[String], atoms: Vec[SvAtom], how: String) -> String {
	let mut out: String = ""
	let n = atoms.len()
	let mut clauses: Vec[Vec[u32]] = []
	let mut a: u32 = 0
	while (a as i64) < n {
		clauses.push([sv_lit(a, false)])
		a += 1
	}
	let query = SvQuery { atoms: atoms.clone(), clauses: clauses, columns: names.len().checked_u32() ?? 0, reals: [] }
	let mut book = sv_book(query) ?? return "no book"
	let mut inputs: Vec[u32] = []
	let mut i: u32 = 0
	while (i as i64) < n {
		inputs.push(book.input(i))
		i += 1
	}
	let budget = lg_budget()
	let mut theory = sv_theory(names.clone())
	theory.push_level()
	let mut got = SvChecked::Consistent
	let mut j: u32 = 0
	while (j as i64) < n {
		got = theory.assert(sv_lit(j, false), book)
		match got {
			SvChecked::Consistent => {},
			else => {
				break
			},
		}
		j += 1
	}
	match got {
		SvChecked::Consistent => {
			got = theory.check(true, budget, book)
		},
		else => {},
	}
	let label = if how == "" { title.clone() } else { f"{title}, {how}" }
	match got {
		SvChecked::Conflict(c) => {
			let mut hints: Vec[u32] = []
			for l in c.lits {
				hints.push(inputs[(l / 2) as i64])
			}
			hints.push(c.id)
			book.learn([], hints)
			let steps = if how == "" { book.log.steps.clone() } else { sv_omega_test_broken(book.log.steps, how) }
			let v = sv_check(query, steps)
			let said = if v.ok { "checked" } else { f"rejected at {v.step}: {v.reason}" }
			out = out + f"  {label}: conflict; {sv_omega_test_kinds(steps)}; {said}\n"
		},
		SvChecked::Consistent => {
			let model = theory.model()
			let mut values: Vec[String] = []
			for name in names {
				let v = model.get(name.clone()) ?? 0
				values.push(f"{name} = {v}")
			}
			let ok = if sv_omega_test_holds(atoms, names, model) { "the atoms hold" } else { "an atom fails" }
			out = out + f"  {label}: consistent, {values.join(", ")}; {ok}\n"
		},
		SvChecked::Unknown(why) => {
			out = out + f"  {label}: {sv_unknown(why)}\n"
		},
		else => {
			out = out + f"  {label}: lemmas\n"
		},
	}
	return out
}

// The problem that overflowed i64 before (`replay-early-close-depth-range` of
// `tests/solver/qflia`): two equalities with five-digit coefficients over
// `[-5, 5]`.
fn sv_omega_test_big() -> Vec[SvAtom] {
	let mut big: Vec[SvAtom] = []
	sv_omega_test_eq(big, [70241, 76389, 66512, 11267, 9158], -82)
	sv_omega_test_eq(big, [55644, 74117, -29262, -76416, -75644], 175)
	let mut v = 0
	while v < 5 {
		sv_omega_test_boxed(big, 5, v, -5, 5)
		v += 1
	}
	return big
}

test "two equalities with five-digit coefficients are refuted without overflow" {
	let names: Vec[String] = ["a", "b", "c", "d", "e"]
	let mut out: String = "70241a + 76389b + 66512c + 11267d + 9158e = 82, 55644a + 74117b - 29262c - 76416d - 75644e = -175, -5 <= a..e <= 5\n"
	out = out + sv_omega_test_run("exact", names, sv_omega_test_big(), "")
	let expected = [
		"70241a + 76389b + 66512c + 11267d + 9158e = 82, 55644a + 74117b - 29262c - 76416d - 75644e = -175, -5 <= a..e <= 5",
		"  exact: conflict; 31 extend, 360 combine, 18 round, 1 farkas, 1 learn; checked",
	]
	assert(out == expected.join("\n") + "\n")
}

test "the omega test's example is consistent and its model holds" {
	let mut out: String = "7x + 12y + 31z = 17, 3x + 5y + 14z = 7, 1 <= x <= 40, -50 <= y <= 50\n"
	let mut omega: Vec[SvAtom] = []
	sv_omega_test_eq(omega, [7, 12, 31], -17)
	sv_omega_test_eq(omega, [3, 5, 14], -7)
	sv_omega_test_boxed(omega, 3, 0, 1, 40)
	sv_omega_test_boxed(omega, 3, 1, -50, 50)
	out = out + sv_omega_test_run("exact", ["x", "y", "z"], omega, "")
	let expected = [
		"7x + 12y + 31z = 17, 3x + 5y + 14z = 7, 1 <= x <= 40, -50 <= y <= 50",
		"  exact: consistent, x = 12, y = -3, z = -1; the atoms hold",
	]
	assert(out == expected.join("\n") + "\n")
}

test "an equality whose gcd does not divide is refuted by the GCD test alone" {
	let mut out: String = "4x + 6y = 5\n"
	let mut gcd: Vec[SvAtom] = []
	sv_omega_test_eq(gcd, [4, 6], -5)
	out = out + sv_omega_test_run("exact", ["x", "y"], gcd, "")
	let expected = [
		"4x + 6y = 5",
		"  exact: conflict; 0 extend, 2 combine, 2 round, 1 farkas, 1 learn; checked",
	]
	assert(out == expected.join("\n") + "\n")
}

test "the elimination's log broken twice is rejected each time" {
	let names: Vec[String] = ["a", "b", "c", "d", "e"]
	let mut out: String = "broken: the first extension's divisor one too large, the first rounding by 1 (none)\n"
	out = out + sv_omega_test_run("exact", names.clone(), sv_omega_test_big(), "divisor")
	out = out + sv_omega_test_run("exact", names, sv_omega_test_big(), "round")
	let expected = [
		"broken: the first extension's divisor one too large, the first rounding by 1 (none)",
		"  exact, divisor: conflict; 31 extend, 360 combine, 18 round, 1 farkas, 1 learn; rejected at 17: round: the coefficient -9160 of x5 is not divisible by 9159",
		"  exact, round: conflict; 31 extend, 360 combine, 18 round, 1 farkas, 1 learn; rejected at 39: round: the coefficient -707520802296 of x0 is not divisible by 298",
	]
	assert(out == expected.join("\n") + "\n")
}
