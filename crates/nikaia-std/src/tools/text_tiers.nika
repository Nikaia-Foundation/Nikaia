// crates/nikaia-std/src/tools/text_tiers.nika
//
// **What a declared `String` is below, decided by what flows into it**
// (ADR-282) - the walk the compiler's `text_tiers` runs over a whole program
// and the tiers it decides, moved from Rust (ADR-294, #125). What stays in
// Rust is writing the answer into the syntax tree, which this reads.
//
// A **position** is every place a program declares `String`: a struct's
// field, a function's result, a function's parameter, an annotated `let` -
// and inside each, the element of a list or a set and the key or value of a
// map. Four tiers, and each pays only for itself: only text of its own flows
// in, and it stays `String`; only literals, and it is a view of the program's
// static text, `&'static str` below (D29); views (and literals), and it becomes
// `ref String`; both, and it becomes `ref String` that is either, per value.
//
// **What is published may become a view but never both kinds** (D25), and a
// position a value reaches from inside an `f"…"` hole this pass cannot hand a
// value over in is never mixed.
//
// A fixpoint: a read or a call hands on the tier found for its position, and
// tiers only ever move up, so it ends. The last walk is against the final
// tiers, which is what the wraps are read off.

use std::collections

/// What kinds of text a value may be: text of its own, a view, a literal (a
/// view of text that lives as long as the program), a view of static text
/// read out of a position only literals flow into (ADR-282 D29) - which,
/// unlike a literal, cannot be built into text where it stands - or what a
/// mixed position hands back - either of the first two, per value.
pub struct Kinds {
    pub owned: bool,
    pub view: bool,
    pub lasting: bool,
    pub still: bool,
    pub either: bool,
}

fn no_kinds() -> Kinds {
    return Kinds { owned: false, view: false, lasting: false, still: false, either: false }
}

fn owned_kinds() -> Kinds {
    return Kinds { owned: true, view: false, lasting: false, still: false, either: false }
}

fn view_kinds() -> Kinds {
    return Kinds { owned: false, view: true, lasting: false, still: false, either: false }
}

fn lasting_kinds() -> Kinds {
    return Kinds { owned: false, view: false, lasting: true, still: false, either: false }
}

fn still_kinds() -> Kinds {
    return Kinds { owned: false, view: false, lasting: false, still: true, either: false }
}

fn either_kinds() -> Kinds {
    return Kinds { owned: false, view: false, lasting: false, still: false, either: true }
}

fn kinds_joined(a: ref Kinds, b: ref Kinds) -> Kinds {
    return Kinds { owned: a.owned || b.owned, view: a.view || b.view, lasting: a.lasting || b.lasting, still: a.still || b.still, either: a.either || b.either }
}

fn same_kinds(a: ref Kinds, b: ref Kinds) -> bool {
    return a.owned == b.owned && a.view == b.view && a.lasting == b.lasting && a.still == b.still && a.either == b.either
}

fn no_text(kinds: ref Kinds) -> bool {
    return !kinds.owned && !kinds.view && !kinds.lasting && !kinds.still && !kinds.either
}

/// What a set of kinds makes of a position.
pub enum Tier {
    Owned,
    View,
    Mixed,
    /// Only literals and views of them flow in: a view of the program's own
    /// static text, which needs no lifetime (ADR-282 D29).
    Lasting,
}

fn tier_of_kinds(kinds: ref Kinds) -> Tier {
    if kinds.either || ((kinds.view || kinds.still) && kinds.owned) {
        return Tier::Mixed
    }
    if kinds.view {
        return Tier::View
    }
    if kinds.lasting || kinds.still {
        if kinds.owned {
            return Tier::Owned
        }
        return Tier::Lasting
    }
    return Tier::Owned
}

fn mixed(tier: Tier) -> bool {
    return match tier {
        Tier::Mixed => true,
        else => false,
    }
}

fn lasting_tier(tier: Tier) -> bool {
    return match tier {
        Tier::Lasting => true,
        else => false,
    }
}

fn owned_tier(tier: Tier) -> bool {
    return match tier {
        Tier::Owned => true,
        else => false,
    }
}

/// Who declares a position.
pub enum TextOwner {
    Field(String, String),
    /// What a function hands back. Not `Result`: a public name `Result` in
    /// `std` makes `rustc` spell the real one in full in every message.
    Returned(String),
    Param(String, i64),
    /// An annotated `let`, by the byte its statement starts at.
    Let(i64),
}

/// A declared `String`: who declares it, and where inside the declared type -
/// the argument indices from the outside in (`HashMap[String, i64]`'s key is
/// `[0]`).
pub struct TextPosition {
    pub owner: TextOwner,
    pub path: Vec[i64],
}

/// A position as a word, which is what every map here keys it by: an enum
/// has no order of its own to key one with.
fn owner_word(owner: ref TextOwner) -> String {
    return match owner {
        TextOwner::Field(of, field) => f"field {of} {field}",
        TextOwner::Returned(key) => f"result {key}",
        TextOwner::Param(key, at) => f"param {key} {at}",
        TextOwner::Let(at) => f"let {at}",
    }
}

fn position_word(owner: ref TextOwner, path: ref Vec[i64]) -> String {
    let mut word = owner_word(owner)
    word.push_str(" @")
    for step in path {
        word.push_str(f" {step}")
    }
    return word
}

/// How a value is handed into a mixed position: the method the rewrite
/// writes after it, numbered as the rewrite's list of them is.
pub enum Hand {
    /// `value.into_either()`: into a `String`.
    Either,
    /// `value.into_either_maybe()`: into a `String?`, present or absent.
    Maybe,
    /// `iterator.either_items()`: before a `collect` into a list whose
    /// element is mixed.
    Items,
    /// `pairs.either_keys()`, `either_values()`, `either_pairs()`: before a
    /// `collect` into a map whose key, value or both are mixed (ADR-293 D26).
    Keys,
    Values,
    Pairs,
}

pub fn hand_number(hand: Hand) -> i64 {
    return match hand {
        Hand::Either => 0,
        Hand::Maybe => 1,
        Hand::Items => 2,
        Hand::Keys => 3,
        Hand::Values => 4,
        Hand::Pairs => 5,
    }
}

/// What the tier pass is handed: the program's names and aliases, and
/// `std`'s ledger. An expression is named by its id ([`id_of`],
/// [ADR-340](../../docs/specification/adr/adr-340.md)).
pub struct TierAsk {
    pub names: ref winnow_grammar::InternerContext,
    pub aliases: ref collections::BTreeMap[String, String],
    pub library: ref Ledger,
}

/// A value handed over inside an `f"…"` hole: a copy of it, whose shape is
/// what the hole is parsed into again and matched by (ADR-229 D1).
pub struct HoleWrap {
    pub value: Expr,
    pub hand: Hand,
}

/// What the pass decided: the positions that are not text of their own, the
/// `let`s bound to a literal that are declared `String`, the type to declare
/// them with, and every value handed into a mixed position - by where it
/// stands, or inside an `f"…"` hole by the hole's place and the value's
/// shape (ADR-229 D1).
pub struct TextTiers {
    pub tiers: Vec[(TextPosition, Tier)],
    pub lets: collections::BTreeSet[i64],
    pub text: Type?,
    pub wraps: collections::BTreeMap[i64, Hand],
    pub hole_wraps: collections::BTreeMap[i64, Vec[HoleWrap]],
    /// The `let`s bound to an empty list without a type that go whole into a
    /// position, by the byte they stand at: each is declared with that
    /// position's type and takes its tiers (ADR-282 D16).
    pub adopted: collections::BTreeMap[i64, TierAdopted],
}

/// The position a `let` is linked to, and the type it is declared with.
pub struct TierAdopted {
    pub owner: TextOwner,
    pub ty: Type,
}

/// A name as the program wrote it, with the alias a `use` gave its package
/// spelled out.
pub fn unaliased_in(aliases: ref collections::BTreeMap[String, String], name: ref String) -> String {
    if aliases.len() == 0 {
        return name.clone()
    }
    // A view keeps its `&`, which sits in front of the name here.
    let mut amp: String = ""
    let mut bare = name.clone()
    if name.starts_with("&") {
        amp = "&"
        let chars: Vec[scalar] = name.chars().collect()
        bare = ""
        for k in 1..<chars.len() {
            bare.push(chars[k])
        }
    }
    let parts: Vec[ref String] = bare.splitn(2, "::").collect()
    if parts.len() < 2 {
        return name.clone()
    }
    let package = aliases[parts[0]] ?? return name.clone()
    return f"{amp}{package}::{parts[1]}"
}

// --- What the program declares, read once ---

struct FieldDecl {
    ty: Type,
    published: bool,
}

struct FnDecl {
    params: Vec[Type],
    /// Which parameters are `mut`: what is handed there may be changed.
    changes: Vec[bool],
    result: Type?,
    published: bool,
}

struct TextDeclared {
    /// Every field of every struct, and whether it is published.
    fields: collections::BTreeMap[(String, String), FieldDecl],
    /// Every function and method, by key.
    fns: collections::BTreeMap[String, FnDecl],
    /// Method names declared in this program, to the keys that declare them.
    methods: collections::BTreeMap[String, Vec[String]],
    /// The keys of the grammars' rules, `G::rule`.
    rules: collections::BTreeSet[String],
}

fn declared_of(program: ref Program, names: ref winnow_grammar::InternerContext) -> TextDeclared {
    let mut declared = TextDeclared { fields: collections::BTreeMap(), fns: collections::BTreeMap(), methods: collections::BTreeMap(), rules: collections::BTreeSet() }
    for item in program.items {
        match item.node {
            Item::Struct { name, fields, is_public, .. } => {
                let owner = names.resolve(name).clone()
                for field in fields {
                    let key = (owner.clone(), names.resolve(field.name).clone())
                    declared.fields.insert(key, FieldDecl { ty: field.ty.clone(), published: is_public && field.is_public })
                }
            }
            Item::Fn { .. } => declare_function(item.node, null, names, declared, false),
            // **A trait's method has the trait's signature** (ADR-282 D29):
            // every type that implements it answers one type, so its
            // positions are published ones.
            Item::Impl { trait_name, target, methods } => {
                let owner = names.resolve(target.name).clone()
                for method in methods {
                    declare_function(method.node, owner.clone(), names, declared, trait_name != null)
                }
            }
            Item::Grammar(def) => declare_rules(def, names, declared),
            else => {}
        }
    }
    return declared
}

/// **A grammar's rule is a function of its grammar** for this walk: `G::rule`,
/// no parameters, its declared result a position, published where the grammar
/// is and the rule is its entry.
fn declare_rules(def: ref GrammarDef, names: ref winnow_grammar::InternerContext, mut declared: TextDeclared) {
    let gname = names.resolve(def.name).clone()
    for rule in def.rules {
        let key = f"{gname}::{names.resolve(rule.name)}"
        declared.rules.insert(key.clone())
        declared.fns.insert(key, FnDecl { params: [], changes: [], result: rule.ret_type?.clone(), published: def.public && rule.is_entry })
    }
}

fn declare_function(item: ref Item, target: String?, names: ref winnow_grammar::InternerContext, mut declared: TextDeclared, of_a_trait: bool) {
    let (name, args, ret_type, is_public) = match item {
        Item::Fn { name, args, ret_type, is_public, .. } => (name, args, ret_type, is_public),
        else => return,
    }
    let own = own_name(name, names)
    let key = tier_key(target, own)
    if target != null {
        let mut keys: Vec[String] = declared.methods[own]?.clone() ?? []
        keys.push(key.clone())
        declared.methods.insert(own.clone(), keys)
    }
    let mut params: Vec[Type] = []
    let mut changes: Vec[bool] = []
    for arg in args {
        params.push(arg.ty.clone())
        changes.push(arg.mutable)
    }
    declared.fns.insert(key, FnDecl { params: params, changes: changes, result: ret_type?.clone(), published: is_public || of_a_trait })
}

fn own_name(name: ref winnow_grammar::Symbol?, names: ref winnow_grammar::InternerContext) -> String {
    let symbol = name ?? return "new"
    return names.resolve(symbol).clone()
}

fn tier_key(target: ref String?, own: ref String) -> String {
    let owner = target ?? return own.clone()
    return f"{owner}::{own}"
}

/// Whether what an owner declares is published.
fn position_published(owner: ref TextOwner, declared: ref TextDeclared) -> bool {
    return match owner {
        TextOwner::Field(of, field) => field_published(of, field, declared),
        TextOwner::Returned(key) => fn_published(key, declared),
        TextOwner::Param(key, _) => fn_published(key, declared),
        TextOwner::Let(_) => false,
    }
}

fn field_published(of: ref String, field: ref String, declared: ref TextDeclared) -> bool {
    let key = (of.clone(), field.clone())
    let found = declared.fields[key] ?? return false
    return found.published
}

fn fn_published(key: ref String, declared: ref TextDeclared) -> bool {
    let found = declared.fns[key] ?? return false
    return found.published
}

/// A written `String`, to declare a binding with.
fn string_type(declared: ref TextDeclared, names: ref winnow_grammar::InternerContext) -> Type? {
    for (_, field) in declared.fields {
        if plain_string(names, field.ty) {
            return field.ty.clone()
        }
    }
    for (_, function) in declared.fns {
        for param in function.params {
            if plain_string(names, param) {
                return param.clone()
            }
        }
        let result = function.result ?? continue
        if plain_string(names, result) {
            return result.clone()
        }
    }
    return null
}

// --- The walk ---

/// The declared position a name or a place stands for, and its type.
struct Declaring {
    owner: TextOwner,
    ty: Type,
}

/// One local, as far as this walk needs it.
struct TierLocal {
    kinds: Kinds,
    /// The struct it is a value of, where that can be read off the program.
    of: String?,
    /// Bound by a `let` to a literal and nothing else: the byte the `let`
    /// stands at, and -1 for anything else.
    literal: i64,
    /// The position it is declared as, and the declared type.
    declared: Declaring?,
    /// The word of the position its value was read out of, where it is a
    /// `String` read whole: a change to it in place is a change to that
    /// position's text (ADR-282 D29).
    from: String?,
    /// Bound by a `let` without a type to an empty list, set or map: the
    /// byte the `let` stands at, and -1 for anything else (ADR-282 D16).
    empty: i64,
}

/// What one walk found, every position by its word.
struct Flows {
    positions: collections::BTreeMap[String, Kinds],
    /// Each word's position, to hand back.
    known: collections::BTreeMap[String, TextPosition],
    /// A `let` binding a name to a literal, by the byte it stands at, and the
    /// positions that name is kept in (ADR-282 D17).
    literal_lets: collections::BTreeMap[i64, collections::BTreeSet[String]],
    /// Values that go into a mixed position at a line whose lowering does not
    /// wrap them itself, by where they stand.
    wraps: collections::BTreeMap[i64, Hand],
    /// A parameter's own value going into another position (ADR-282 D24).
    param_into: collections::BTreeSet[(String, String)],
    /// The same inside an `f"…"` hole, by the hole's place and the value's
    /// shape (ADR-229 D1).
    hole_wraps: collections::BTreeMap[i64, Vec[HoleWrap]],
    /// Two positions a whole value goes between, which are therefore one
    /// representation below and get one tier (ADR-282 D16).
    links: collections::BTreeSet[(String, String)],
    /// Positions a value goes into from inside an `f"…"` hole this pass has
    /// no place to hand it over in: never mixed.
    unwrappable: collections::BTreeSet[String],
    /// Parameters handed as they are to a parse, whose result may view them:
    /// views, whatever flows in, as if written `ref String`.
    viewed: collections::BTreeSet[String],
    /// A view of static text read out of the first position going into the
    /// second (ADR-282 D29): where the second keeps text of its own, the
    /// first does too, and its literals are built where they stand.
    still_into: collections::BTreeSet[(String, String)],
    /// A `let` bound to an empty list without a type, by the byte it stands
    /// at, and the position the list goes into whole: the name is linked to
    /// it (ADR-282 D16).
    adopted: collections::BTreeMap[i64, Declaring],
    /// Positions a view of static text read out of them was kept where no
    /// position says what it is: they keep text of their own (ADR-282 D29).
    demoted: collections::BTreeSet[String],
    /// A map's keys and values: looked up by text of any kind, so never a
    /// view of static text (ADR-282 D29).
    in_maps: collections::BTreeSet[String],
}

fn no_flows() -> Flows {
    return Flows { positions: collections::BTreeMap(), known: collections::BTreeMap(), literal_lets: collections::BTreeMap(), wraps: collections::BTreeMap(), param_into: collections::BTreeSet(), hole_wraps: collections::BTreeMap(), links: collections::BTreeSet(), unwrappable: collections::BTreeSet(), viewed: collections::BTreeSet(), still_into: collections::BTreeSet(), adopted: collections::BTreeMap(), demoted: collections::BTreeSet(), in_maps: collections::BTreeSet() }
}

struct TierWalk {
    declared: TextDeclared,
    /// The tiers decided so far, by word.
    tiers: collections::BTreeMap[String, Tier],
    flows: Flows,
    /// Each name's bindings, innermost last, and the names each scope bound.
    locals: collections::BTreeMap[String, Vec[TierLocal]],
    frames: Vec[Vec[String]],
    /// The function being walked, where its result is a position.
    result: String?,
    /// Inside an `f"…"` hole.
    in_hole: bool,
    /// The place of the hole being walked - the byte its `{` stands at - and
    /// -1 outside one.
    hole_text: i64,
    /// The function being walked borrows its subject: `ref self`.
    lent_self: bool,
    /// The `let`s linked to where their list goes, found by the walk before.
    adopted: collections::BTreeMap[i64, Declaring],
    /// Every position found to keep text of its own because a view of static
    /// text read out of it went where text of its own is kept, by any walk so
    /// far: once found, it stays found, so the fixpoint does not swing.
    demoted: collections::BTreeSet[String],
}

fn open_tier_scope(mut walk: TierWalk) {
    walk.frames.push([])
}

fn close_tier_scope(mut walk: TierWalk) {
    if walk.frames.len() == 0 {
        return
    }
    let names = walk.frames[walk.frames.len() - 1].clone()
    for name in names {
        let mut stack = walk.locals[name]?.clone() ?? continue
        if stack.len() > 0 {
            stack.pop()
        }
        walk.locals.insert(name.clone(), stack)
    }
    walk.frames.pop()
}

fn tier_local(name: ref String, walk: ref TierWalk) -> TierLocal? {
    let stack = walk.locals[name] ?? return null
    if stack.len() == 0 {
        return null
    }
    return stack[stack.len() - 1].clone()
}

fn set_tier_local(name: ref String, local: TierLocal, mut walk: TierWalk) {
    let mut stack = walk.locals[name]?.clone() ?? return
    if stack.len() == 0 {
        return
    }
    stack.pop()
    stack.push(local)
    walk.locals.insert(name.clone(), stack)
}

fn bind_tier_local(name: String, local: TierLocal, mut walk: TierWalk) {
    let mut stack: Vec[TierLocal] = walk.locals[name]?.clone() ?? []
    stack.push(local)
    walk.locals.insert(name.clone(), stack)
    if walk.frames.len() > 0 {
        let last = walk.frames.len() - 1
        walk.frames[last].push(name)
    }
}

fn plain_local(kinds: Kinds) -> TierLocal {
    return TierLocal { kinds: kinds, of: null, literal: -1, declared: null, from: null, empty: -1 }
}

fn tier_at(word: ref String, walk: ref TierWalk) -> Tier {
    let found = walk.tiers[word] ?? return Tier::Owned
    return found.clone()
}

fn mixed_at(word: ref String, walk: ref TierWalk) -> bool {
    return mixed(tier_at(word, walk))
}

/// A position seen: its word, remembered with the position it stands for.
fn seen(owner: ref TextOwner, path: ref Vec[i64], mut walk: TierWalk) -> String {
    let word = position_word(owner, path)
    if !walk.flows.known.contains_key(word) {
        walk.flows.known.insert(word.clone(), TextPosition { owner: owner.clone(), path: path.clone() })
    }
    return word
}

fn a_map(names: ref winnow_grammar::InternerContext, ty: ref Type) -> bool {
    let name = container_of(names, ty) ?? return false
    return is_a_map_name(name)
}

fn a_container(names: ref winnow_grammar::InternerContext, ty: ref Type) -> bool {
    return container_of(names, ty) != null
}

/// Record that values of these kinds go into every declared `String` of
/// `ty`: the type itself, or an element of it.
fn flow_type(owner: ref TextOwner, ty: ref Type, mut path: Vec[i64], kinds: ref Kinds, ask: ref TierAsk, mut walk: TierWalk) {
    if plain_string(ask.names, ty) {
        let word = seen(owner, path, walk)
        let before = walk.flows.positions[word]?.clone() ?? no_kinds()
        walk.flows.positions.insert(word, kinds_joined(before, kinds))
        return
    }
    if a_container(ask.names, ty) {
        let mut at = 0
        let keyed = a_map(ask.names, ty)
        for arg in ty.generics {
            path.push(at)
            if keyed {
                let word = seen(owner, path, walk)
                walk.flows.in_maps.insert(word)
            }
            flow_type(owner, arg, path, kinds, ask, walk)
            path.pop()
            at += 1
        }
    }
}

/// A value going into one argument of a declared type, which is a position
/// if it is `String`: recorded, and - where that position is mixed and
/// `wrap` says the line is this pass's to wrap - marked to be handed over.
fn flow_value(going: ref TierGoing, value: ref Expr?, kinds: ref Kinds, ask: ref TierAsk, mut walk: TierWalk) {
    let owner = going.owner.clone()
    let ty = going.ty.clone()
    let path = going.path.clone()
    let plain = plain_string(ask.names, ty)
    // **A parameter handed on as it is** (ADR-282 D24), remembered so that
    // what it goes into can hold it to text of its own.
    if plain {
        let from = handed_parameter(value, ask, walk)
        if from != null {
            let from_word: String = from ?? ""
            let to = seen(owner, path, walk)
            walk.flows.param_into.insert((from_word, to))
        }
    }
    // A list that comes whole from a position is linked to it below, and the
    // link is all that flows.
    let linked = a_container(ask.names, ty) && comes_whole(value, ask, walk)
    if !linked {
        flow_type(owner, ty, path.clone(), kinds, ask, walk)
    }
    // **A view of static text read out of a position** is remembered with
    // where it goes (ADR-282 D29).
    if plain && kinds.still && value != null {
        let given_value = value ?? return
        let mut sources: Vec[String] = []
        still_sources(given_value, ask, walk, sources)
        let to = seen(owner, path, walk)
        for from_word in sources {
            if from_word != to {
                walk.flows.still_into.insert((from_word.clone(), to.clone()))
            }
        }
    }
    if a_container(ask.names, ty) && path.len() == 0 && holds_text(ask.names, ty) {
        adopt(value, going, ask, walk)
    }
    // **Into a type this walk does not follow** - a `ref` list, a tuple, a
    // type of its own - a view of static text is kept unseen (ADR-282 D29).
    if !plain && !a_container(ask.names, ty) && kinds.still && value != null {
        let unseen = value ?? return
        kept_unseen(unseen, ask, walk)
    }
    if walk.in_hole && walk.hole_text < 0 && going.wrap && plain {
        let word = seen(owner, path, walk)
        walk.flows.unwrappable.insert(word)
        return
    }
    let given = value ?? return
    // `null` is no text of either kind, and goes in as it is.
    if plain && going.wrap && !a_null(given) && mixed_at(position_word(owner, path), walk) {
        if ty.is_nullable {
            hand_value_over(given, Hand::Maybe, walk)
        } else {
            hand_value_over(given, Hand::Either, walk)
        }
    }
    kept_literal(given, owner, path, ty, ask, walk)
    if a_container(ask.names, ty) {
        flow_whole(going, given, ask, walk)
    }
}

/// Where a value goes: the position's owner, the declared type there, the
/// path inside it, and whether the line is this pass's to wrap.
struct TierGoing {
    owner: TextOwner,
    ty: Type,
    path: Vec[i64],
    wrap: bool,
}

fn going_into(owner: ref TextOwner, ty: ref Type, path: Vec[i64], wrap: bool) -> TierGoing {
    return TierGoing { owner: owner.clone(), ty: ty.clone(), path: path, wrap: wrap }
}

/// **An empty list going whole into a position is linked to it** (ADR-282
/// D16): the `let` that bound it is declared with the position's type.
fn adopt(value: ref Expr?, going: ref TierGoing, ask: ref TierAsk, mut walk: TierWalk) {
    let given = value ?? return
    let name = match given {
        Expr::Variable(name, _) => ask.names.resolve(name).clone(),
        else => return,
    }
    let local = tier_local(name, walk) ?? return
    if local.empty < 0 {
        return
    }
    // A hashed container's keys stay text of their own, and its `let` is
    // seeded by the position it goes to (ADR-010 D9): declared with the
    // position's written type it would be a local map of its own.
    let kind = container_of(ask.names, going.ty) ?? ""
    if is_a_map_name(kind) || kind == "HashSet" {
        return
    }
    walk.flows.adopted.insert(local.empty, Declaring { owner: going.owner.clone(), ty: going.ty.clone() })
}

/// `Vec()`, `collections::HashMap()`, `[]`: a list, a set or a map with
/// nothing in it yet.
fn an_empty_container(value: ref Expr, ask: ref TierAsk) -> bool {
    return match value {
        Expr::ListLit { items, .. } => items.len() == 0,
        Expr::Call { func, args, .. } => {
            if args.len() > 0 {
                return false
            }
            let callee = tier_callee(func, ask) ?? return false
            is_a_container_name(callee)
        }
        else => false,
    }
}

/// Whether a container declares `String` anywhere inside it.
fn holds_text(names: ref winnow_grammar::InternerContext, ty: ref Type) -> bool {
    if plain_string(names, ty) {
        return true
    }
    if !a_container(names, ty) {
        return false
    }
    for arg in ty.generics {
        if holds_text(names, arg) {
            return true
        }
    }
    return false
}

/// Record that values of these kinds go into the position of this word.
fn flow_word(word: ref String, kinds: ref Kinds, mut walk: TierWalk) {
    let before = walk.flows.positions[word]?.clone() ?? no_kinds()
    walk.flows.positions.insert(word.clone(), kinds_joined(before, kinds))
}

/// The word of the `String` position a value is read out of whole: a name
/// declared with one or read out of one, a field, what a function of this
/// program hands back.
fn text_source_word(value: ref Expr?, ask: ref TierAsk, mut walk: TierWalk) -> String? {
    let given = value ?? return null
    let source = source_of(given, ask, walk)
    if source != null {
        let found = source ?? return null
        if !plain_string(ask.names, found.ty) {
            return null
        }
        return seen(found.owner, no_path(), walk)
    }
    return match given {
        Expr::Variable(name, _) => {
            let local = tier_local(ask.names.resolve(name), walk) ?? return null
            local.from?.clone()
        }
        else => null,
    }
}

/// The word of the element position a loop over a declared list reads out of.
fn element_word(iter: ref Expr, ask: ref TierAsk, mut walk: TierWalk) -> String? {
    // `xs.iter()`, `xs.drain()`, `xs.into_iter()` hand out the elements of `xs`.
    match iter {
        Expr::MethodCall { receiver, method, args, .. } => {
            let name = ask.names.resolve(method)
            if args.len() == 0 && (name == "iter" || name == "drain" || name == "into_iter") {
                return element_word(receiver, ask, walk)
            }
        }
        else => {}
    }
    let found = source_of(iter, ask, walk) ?? return null
    let ty = found.ty.clone()
    if !a_container(ask.names, ty) || a_map(ask.names, ty) || ty.generics.len() == 0 {
        return null
    }
    if !plain_string(ask.names, ty.generics[0]) {
        return null
    }
    return seen(found.owner, [0], walk)
}

/// A view of static text and text of its own in one value: below they are
/// one type, so the view's position keeps text of its own (ADR-282 D29).
fn beside_its_own(kinds: ref Kinds) -> bool {
    return kinds.still && kinds.owned
}

fn any_still(given: ref Vec[Kinds]) -> bool {
    for kinds in given {
        if kinds.still {
            return true
        }
    }
    return false
}

/// Whether `std` declares a method of this name on any type.
fn std_has_method(method: ref String, ask: ref TierAsk) -> bool {
    let within = f"::{method}"
    for (key, _) in ask.library.functions {
        if key.ends_with(ref within) {
            return true
        }
    }
    return false
}

/// Each argument a view of static text is in, kept where no position says
/// what it is.
fn kept_args(args: ref Vec[Expr], given: ref Vec[Kinds], ask: ref TierAsk, mut walk: TierWalk) {
    let mut at = 0
    for arg in args {
        if at < given.len() && given[at].still {
            kept_unseen(arg, ask, walk)
        }
        at += 1
    }
}

/// A name that begins with a capital is a type's, or one of its variants'.
fn names_a_type(name: ref String) -> bool {
    let first = name.chars().next() ?? return false
    return first >= 'A' && first <= 'Z'
}

/// **A value kept where no position says what it is** - a tuple's part, an
/// enum's payload, one branch of an `if` beside text of its own - is text of
/// its own: each position a view of static text in it was read out of keeps
/// text of its own too (ADR-282 D29).
fn kept_unseen(value: ref Expr, ask: ref TierAsk, mut walk: TierWalk) {
    match value {
        Expr::ListLit { items, .. } => {
            for item in items {
                kept_unseen(item, ask, walk)
            }
        }
        Expr::Tuple(items, _) => {
            for item in items {
                kept_unseen(item, ask, walk)
            }
        }
        Expr::Coalesce { value: first, fallback, .. } => {
            kept_unseen(first, ask, walk)
            kept_unseen(fallback, ask, walk)
        }
        // An element read out of a declared container: the container.
        Expr::Index { base, .. } => {
            let whole = source_of(base, ask, walk)
            if container_source(whole, ask) {
                kept_unseen(base, ask, walk)
                return
            }
            let mut sources: Vec[String] = []
            still_sources(value, ask, walk, sources)
            for read_from in sources {
                flow_word(read_from, owned_kinds(), walk)
                walk.flows.demoted.insert(read_from.clone())
            }
        }
        else => {
            // A declared list, set or map: every `String` inside it.
            let whole = source_of(value, ask, walk)
            if whole != null {
                let found = whole ?? return
                if a_container(ask.names, found.ty) {
                    demote_inside(found.owner, found.ty, [], ask, walk)
                    return
                }
            }
            let mut sources: Vec[String] = []
            still_sources(value, ask, walk, sources)
            for read_from in sources {
                flow_word(read_from, owned_kinds(), walk)
                walk.flows.demoted.insert(read_from.clone())
            }
        }
    }
}

/// An `if` or a `match` whose values are literals and `null`: the checker
/// types it `String?`, text of its own with each literal built (#441), so it
/// is not static text yet.
fn literals_beside_null(value: ref Expr) -> bool {
    let mut tails: Vec[Expr] = []
    match value {
        Expr::If { then_branch, else_branch, .. } => {
            let otherwise = else_branch ?? return false
            if then_branch.stmts.len() != 1 || otherwise.stmts.len() != 1 {
                return false
            }
            match then_branch.stmts[0].node {
                Stmt::Expr(last) => tails.push(last.clone()),
                else => return false,
            }
            match otherwise.stmts[0].node {
                Stmt::Expr(last) => tails.push(last.clone()),
                else => return false,
            }
        }
        Expr::Match { arms, .. } => {
            for arm in arms {
                tails.push(arm.body.clone())
            }
        }
        else => return false,
    }
    let mut nulls = false
    for tail in tails {
        if a_null(tail) {
            nulls = true
        } else if !a_literal_text(tail) {
            return false
        }
    }
    return nulls
}

/// A list's items, literals and at least one `null`.
fn items_beside_null(items: ref Vec[Expr]) -> bool {
    let mut nulls = false
    for item in items {
        if a_null(item) {
            nulls = true
        } else if !a_literal_text(item) {
            return false
        }
    }
    return nulls
}

fn a_variable(expr: ref Expr) -> bool {
    return match expr {
        Expr::Variable(_, _) => true,
        else => false,
    }
}

/// Every `String` inside a declared container keeps text of its own.
fn demote_inside(owner: ref TextOwner, ty: ref Type, mut path: Vec[i64], ask: ref TierAsk, mut walk: TierWalk) {
    if plain_string(ask.names, ty) {
        let word = seen(owner, path, walk)
        flow_word(word, owned_kinds(), walk)
        walk.flows.demoted.insert(word)
        return
    }
    if !a_container(ask.names, ty) {
        return
    }
    let mut at = 0
    for arg in ty.generics {
        path.push(at)
        demote_inside(owner, arg, path.clone(), ask, walk)
        path.pop()
        at += 1
    }
}

/// Every position a value's text may be read out of whole: through the
/// branches of an `if` or a `match`, a block's last value and both sides of
/// `??`.
fn still_sources(value: ref Expr, ask: ref TierAsk, mut walk: TierWalk, mut out: Vec[String]) {
    match value {
        Expr::Block(block, _) => still_tail(block, ask, walk, out),
        Expr::If { then_branch, else_branch, .. } => {
            still_tail(then_branch, ask, walk, out)
            let otherwise = else_branch ?? return
            still_tail(otherwise, ask, walk, out)
        }
        Expr::Match { arms, .. } => {
            for arm in arms {
                still_sources(arm.body, ask, walk, out)
            }
        }
        Expr::Coalesce { value: first, fallback, .. } => {
            still_sources(first, ask, walk, out)
            still_sources(fallback, ask, walk, out)
        }
        else => {
            let read_from = text_source_word(value, ask, walk) ?? return
            out.push(read_from)
        }
    }
}

fn still_tail(block: ref Block, ask: ref TierAsk, mut walk: TierWalk, mut out: Vec[String]) {
    if block.stmts.len() == 0 {
        return
    }
    match block.stmts[block.stmts.len() - 1].node {
        Stmt::Expr(last) => still_sources(last, ask, walk, out),
        else => {}
    }
}

/// **Text changed in place is text of its own** (ADR-282 D29): the
/// position the changed value is declared as, or was read out of, has text
/// of its own flowing in.
fn changed_in_place(target: ref Expr, ask: ref TierAsk, mut walk: TierWalk) {
    // `names[i] += "!"`: the element position of the list.
    match target {
        Expr::Index { base, .. } => {
            let element = element_word(base, ask, walk) ?? return
            flow_word(element, owned_kinds(), walk)
            return
        }
        else => {}
    }
    let place = place_of(target, ask, walk)
    if place != null {
        let found = place ?? return
        if plain_string(ask.names, found.ty) {
            let word = seen(found.owner, no_path(), walk)
            flow_word(word, owned_kinds(), walk)
        }
        return
    }
    let read_from = text_source_word(target, ask, walk) ?? return
    flow_word(read_from, owned_kinds(), walk)
}

fn a_null(value: ref Expr) -> bool {
    return match value {
        Expr::LitNull(_) => true,
        else => false,
    }
}

/// The word of the parameter a value is, where it is one of `String`.
fn handed_parameter(value: ref Expr?, ask: ref TierAsk, walk: ref TierWalk) -> String? {
    let given = value ?? return null
    let name = match given {
        Expr::Variable(name, _) => ask.names.resolve(name).clone(),
        else => return null,
    }
    let local = tier_local(name, walk) ?? return null
    let declared = local.declared ?? return null
    let parameter = match declared.owner {
        TextOwner::Param(_, _) => true,
        else => false,
    }
    if !parameter || !plain_string(ask.names, declared.ty) {
        return null
    }
    let empty: Vec[i64] = []
    return position_word(declared.owner, empty)
}

fn comes_whole(value: ref Expr?, ask: ref TierAsk, walk: ref TierWalk) -> bool {
    let given = value ?? return false
    let collected = match given {
        Expr::MethodCall { method, args, .. } => args.len() == 0 && ask.names.resolve(method) == "collect",
        Expr::ListLit { .. } => true,
        else => false,
    }
    return !collected && source_of(given, ask, walk) != null
}

/// **A container going in whole** (ADR-282 D16): a literal's items one by
/// one, a `collect` item by item, and anything that already has a position
/// linked to it, so that the two are one representation below.
fn flow_whole(going: ref TierGoing, value: ref Expr, ask: ref TierAsk, mut walk: TierWalk) {
    let ty = going.ty.clone()
    let a_list = a_container(ask.names, ty) && !a_map(ask.names, ty) && ty.generics.len() > 0
    match value {
        Expr::ListLit { items, .. } => {
            if !a_list {
                return
            }
            let element = ty.generics[0].clone()
            // `["a", null]`: the checker types it `Vec[String?]`, text of its
            // own with each literal built, as an `if` of literals and `null`.
            let beside_null = items_beside_null(items)
            for item in items {
                let mut kinds = tier_expr(item, ask, walk)
                if beside_null && !a_null(item) {
                    kinds = owned_kinds()
                }
                let mut at = going.path.clone()
                at.push(0)
                flow_value(going_into(going.owner, element, at, true), item, kinds, ask, walk)
            }
        }
        Expr::MethodCall { receiver, method, args, .. } => {
            if ask.names.resolve(method) == "collect" && args.len() == 0 {
                collected_into(going, receiver, ask, walk)
                return
            }
            link_from(going, value, ask, walk)
        }
        else => link_from(going, value, ask, walk),
    }
}

fn link_from(going: ref TierGoing, value: ref Expr, ask: ref TierAsk, mut walk: TierWalk) {
    let from = source_of(value, ask, walk) ?? return
    let to = Declaring { owner: going.owner.clone(), ty: going.ty.clone() }
    link(from, [], to, going.path.clone(), ask, walk)
}

/// A `collect` into a container: a map is collected from pairs, its key and
/// its value two positions, and a list item by item.
fn collected_into(going: ref TierGoing, receiver: ref Expr, ask: ref TierAsk, mut walk: TierWalk) {
    let ty = going.ty.clone()
    if a_map(ask.names, ty) {
        let keys = mixed_part(going, 0, ask, walk)
        let values = mixed_part(going, 1, ask, walk)
        if keys && values {
            hand_value_over(receiver, Hand::Pairs, walk)
        } else if keys {
            hand_value_over(receiver, Hand::Keys, walk)
        } else if values {
            hand_value_over(receiver, Hand::Values, walk)
        }
        return
    }
    if !a_container(ask.names, ty) || ty.generics.len() == 0 {
        return
    }
    if !plain_string(ask.names, ty.generics[0]) {
        return
    }
    let mut at = going.path.clone()
    at.push(0)
    let word = seen(going.owner, at, walk)
    if walk.in_hole && walk.hole_text < 0 {
        walk.flows.unwrappable.insert(word)
    } else if mixed_at(word, walk) {
        hand_value_over(receiver, Hand::Items, walk)
    }
}

fn mixed_part(going: ref TierGoing, at: i64, ask: ref TierAsk, mut walk: TierWalk) -> bool {
    if going.ty.generics.len() <= at {
        return false
    }
    if !plain_string(ask.names, going.ty.generics[at]) {
        return false
    }
    let mut path = going.path.clone()
    path.push(at)
    let word = seen(going.owner, path, walk)
    if walk.in_hole && walk.hole_text < 0 {
        walk.flows.unwrappable.insert(word)
        return false
    }
    return mixed_at(word, walk)
}

/// The declared position a whole value comes from: a name declared with one,
/// a field, what a function of this program hands back.
fn source_of(value: ref Expr, ask: ref TierAsk, walk: ref TierWalk) -> Declaring? {
    return match value {
        Expr::Variable(_, _) => place_of(value, ask, walk),
        Expr::Field { .. } => place_of(value, ask, walk),
        Expr::Call { func, .. } => called_result(func, ask, walk),
        Expr::MethodCall { method, .. } => method_result(ask.names.resolve(method), walk),
        Expr::Try(inner, _) => source_of(inner, ask, walk),
        else => null,
    }
}

fn called_result(func: ref Expr, ask: ref TierAsk, walk: ref TierWalk) -> Declaring? {
    let callee = tier_callee(func, ask) ?? return null
    let function = walk.declared.fns[callee] ?? return null
    let result = function.result ?? return null
    return Declaring { owner: TextOwner::Returned(callee.clone()), ty: result.clone() }
}

fn method_result(method: ref String, walk: ref TierWalk) -> Declaring? {
    let keys = walk.declared.methods[method] ?? return null
    if keys.len() != 1 {
        return null
    }
    let key = keys[0].clone()
    let function = walk.declared.fns[key] ?? return null
    let result = function.result ?? return null
    return Declaring { owner: TextOwner::Returned(key.clone()), ty: result.clone() }
}

fn tier_callee(func: ref Expr, ask: ref TierAsk) -> String? {
    return written_callee(ask.names, func, fn(name) { unaliased_in(ask.aliases, name) })
}

/// Link every `String` inside two types of one shape, position to position.
fn link(from: ref Declaring, mut from_path: Vec[i64], to: ref Declaring, mut to_path: Vec[i64], ask: ref TierAsk, mut walk: TierWalk) {
    let from_ty = from.ty.clone()
    let to_ty = to.ty.clone()
    if plain_string(ask.names, from_ty) && plain_string(ask.names, to_ty) {
        let a = seen(from.owner, from_path, walk)
        let b = seen(to.owner, to_path, walk)
        if a != b {
            walk.flows.links.insert((a, b))
        }
        return
    }
    if !a_container(ask.names, from_ty) || !a_container(ask.names, to_ty) || from_ty.generics.len() != to_ty.generics.len() {
        return
    }
    let keyed = a_map(ask.names, from_ty) || a_map(ask.names, to_ty)
    for at in 0..<from_ty.generics.len() {
        from_path.push(at)
        to_path.push(at)
        if keyed {
            let a = seen(from.owner, from_path, walk)
            let b = seen(to.owner, to_path, walk)
            walk.flows.in_maps.insert(a)
            walk.flows.in_maps.insert(b)
        }
        let inner_from = Declaring { owner: from.owner.clone(), ty: from_ty.generics[at].clone() }
        let inner_to = Declaring { owner: to.owner.clone(), ty: to_ty.generics[at].clone() }
        link(inner_from, from_path.clone(), inner_to, to_path.clone(), ask, walk)
        from_path.pop()
        to_path.pop()
    }
}

/// Mark a value to be handed over as `hand` says: by where it stands, or
/// inside an `f"…"` hole by the hole's text and the value's shape (ADR-229
/// D1).
fn hand_value_over(value: ref Expr, hand: Hand, mut walk: TierWalk) {
    if walk.in_hole && walk.hole_text >= 0 {
        let at = walk.hole_text
        let mut wraps: Vec[HoleWrap] = walk.flows.hole_wraps[at]?.clone() ?? []
        wraps.push(HoleWrap { value: value.clone(), hand: hand })
        walk.flows.hole_wraps.insert(at, wraps)
        return
    }
    walk.flows.wraps.insert(node_key(value), hand)
}

/// What reading a value of a declared type gives: the tier of each `String`
/// in it.
fn kinds_of(owner: ref TextOwner, ty: ref Type, mut path: Vec[i64], ask: ref TierAsk, walk: ref TierWalk) -> Kinds {
    if plain_string(ask.names, ty) {
        return match tier_at(position_word(owner, path), walk) {
            Tier::Owned => owned_kinds(),
            Tier::View => view_kinds(),
            Tier::Mixed => either_kinds(),
            Tier::Lasting => still_kinds(),
        }
    }
    if ty.is_view && ask.names.resolve(ty.name) == "String" {
        return view_kinds()
    }
    if a_container(ask.names, ty) {
        let mut out = no_kinds()
        let mut at = 0
        for arg in ty.generics {
            path.push(at)
            out = kinds_joined(out, kinds_of(owner, arg, path.clone(), ask, walk))
            path.pop()
            at += 1
        }
        if !no_text(out) {
            return out
        }
    }
    return owned_kinds()
}

fn kinds_of_declared(declared: ref Declaring, ask: ref TierAsk, walk: ref TierWalk) -> Kinds {
    return kinds_of(declared.owner, declared.ty, [], ask, walk)
}

/// The element a read of a container hands out: a map's value, anything
/// else's element; `keys` a map's key.
fn element_kinds(declared: ref Declaring, keys: bool, ask: ref TierAsk, walk: ref TierWalk) -> Kinds {
    let ty = declared.ty.clone()
    if !a_container(ask.names, ty) {
        return kinds_of_declared(declared, ask, walk)
    }
    let mut at = 0
    if a_map(ask.names, ty) && !keys {
        at = 1
    }
    if ty.generics.len() <= at {
        return owned_kinds()
    }
    return kinds_of(declared.owner, ty.generics[at], [at], ask, walk)
}

/// The declared position an expression names as a place: a local declared
/// with a type, a field of a struct this walk can name.
fn place_of(expr: ref Expr, ask: ref TierAsk, walk: ref TierWalk) -> Declaring? {
    return match expr {
        Expr::Variable(name, _) => declared_local(ask.names.resolve(name), walk),
        Expr::Field { base, name, .. } => field_place(base, ask.names.resolve(name), ask, walk),
        else => null,
    }
}

fn declared_local(name: ref String, walk: ref TierWalk) -> Declaring? {
    let local = tier_local(name, walk) ?? return null
    return local.declared?.clone()
}

fn field_place(base: ref Expr, field: ref String, ask: ref TierAsk, walk: ref TierWalk) -> Declaring? {
    let owner = tier_struct_of(base, ask, walk) ?? return null
    let key = (owner.clone(), field.clone())
    let found = walk.declared.fields[key] ?? return null
    return Declaring { owner: TextOwner::Field(owner.clone(), field.clone()), ty: found.ty.clone() }
}

fn tier_block(block: ref Block, ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    open_tier_scope(walk)
    let mut tail = no_kinds()
    let mut k = 0
    for stmt in block.stmts {
        let kinds = tier_statement(stmt.node, stmt.span.start as i64, ask, walk)
        if k + 1 == block.stmts.len() {
            tail = kinds
        }
        k += 1
    }
    close_tier_scope(walk)
    return tail
}

/// Walk a statement; what it is worth as a block's last value.
fn tier_statement(stmt: ref Stmt, at: i64, ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    match stmt {
        Stmt::Let { names, value, ty, .. } => tier_let(names, value, ty, at, ask, walk),
        Stmt::Assign { target, op, value } => {
            tier_assign(target, value, ask, walk)
            if op != null {
                changed_in_place(target, ask, walk)
            }
        }
        Stmt::For { bindings, iter, body, .. } => {
            let kinds = tier_expr(iter, ask, walk)
            let from = element_word(iter, ask, walk)
            open_tier_scope(walk)
            for binding in bindings {
                let mut local = plain_local(kinds.clone())
                if bindings.len() == 1 {
                    local.from = from?.clone()
                }
                bind_tier_local(ask.names.resolve(binding).clone(), local, walk)
            }
            tier_block(body, ask, walk)
            close_tier_scope(walk)
        }
        Stmt::While { cond, body } => {
            tier_expr(cond, ask, walk)
            tier_block(body, ask, walk)
        }
        Stmt::Return(value) => {
            let given = value ?? return no_kinds()
            let kinds = tier_expr(given, ask, walk)
            flow_result(given, kinds, ask, walk)
        }
        Stmt::Expr(expr) => return tier_expr(expr, ask, walk),
        else => {}
    }
    return no_kinds()
}

fn tier_let(names: ref Vec[winnow_grammar::Symbol], value: ref Expr, ty: ref Type?, at: i64, ask: ref TierAsk, mut walk: TierWalk) {
    let kinds = tier_expr(value, ask, walk)
    let mut of = tier_struct_of(value, ask, walk)
    let mut literal = -1
    let mut empty = -1
    let mut declared: Declaring? = null
    let written = ty != null
    let from = text_source_word(value, ask, walk)
    if written {
        let declared_ty = ty?.clone() ?? return
        of = ask.names.resolve(declared_ty.name).clone()
        declared = Declaring { owner: TextOwner::Let(at), ty: declared_ty }
    } else {
        if a_literal_text(value) {
            literal = at
        }
        // **A name bound to a list without a type is that list** (ADR-282
        // D16): what is put into it goes where the list came from.
        let source = source_of(value, ask, walk)
        if container_source(source, ask) {
            declared = source
        }
        // **And an empty one is the list it goes into whole**: what is put
        // into it goes there.
        if declared == null && an_empty_container(value, ask) {
            empty = at
            declared = walk.adopted[at]?.clone()
        }
    }
    let mut bound = kinds
    if declared != null {
        let found = declared?.clone() ?? return
        if !written {
            bound = kinds_of_declared(found, ask, walk)
        } else {
            flow_value(going_into(found.owner, found.ty, [], true), value, kinds, ask, walk)
            bound = kinds_of_declared(found, ask, walk)
        }
    }
    if names.len() == 1 {
        let local = TierLocal { kinds: bound, of: of, literal: literal, declared: declared, from: from, empty: empty }
        bind_tier_local(ask.names.resolve(names[0]).clone(), local, walk)
        return
    }
    // **Each part of a tuple is bound to the tuple's kind** where that is one
    // kind (`let (name, rest) = line.split_at(at)` binds two views); parts of
    // different kinds are text of their own, as an unbound name is.
    if !written && !(bound.owned && (bound.view || bound.still)) && !bound.either {
        for name in names {
            bind_tier_local(ask.names.resolve(name).clone(), plain_local(bound.clone()), walk)
        }
    }
}

fn container_source(source: ref Declaring?, ask: ref TierAsk) -> bool {
    let found = source ?? return false
    return a_container(ask.names, found.ty)
}

/// A literal, or an `if` or a `match` whose every value is one (#441): static
/// text whichever way it goes, so D17 builds it into a `String` where it is
/// bound, as it does a bare literal.
fn a_literal_text(value: ref Expr) -> bool {
    return match value {
        Expr::LitStr { .. } => true,
        Expr::Block(block, _) => a_literal_tail(block),
        Expr::If { then_branch, else_branch, .. } => {
            let otherwise = else_branch ?? return false
            a_literal_tail(then_branch) && a_literal_tail(otherwise)
        }
        Expr::Match { arms, .. } => {
            if arms.is_empty() {
                return false
            }
            for arm in arms {
                if !a_literal_text(arm.body) {
                    return false
                }
            }
            true
        }
        else => false,
    }
}

/// A block whose last statement is a literal text, and nothing it says before
/// that is a value.
fn a_literal_tail(block: ref Block) -> bool {
    if block.stmts.len() != 1 {
        return false
    }
    return match block.stmts[0].node {
        Stmt::Expr(last) => a_literal_text(last),
        else => false,
    }
}

fn tier_assign(target: ref Expr, value: ref Expr, ask: ref TierAsk, mut walk: TierWalk) {
    let kinds = tier_expr(value, ask, walk)
    match target {
        // `m[k] = v`: a map's key and value, a run's element.
        Expr::Index { base, index, .. } => {
            let key = tier_expr(index, ask, walk)
            let found_place = place_of(base, ask, walk)
            if found_place == null {
                // Into a container no position this walk sees declares.
                if key.still {
                    kept_unseen(index, ask, walk)
                }
                if kinds.still {
                    kept_unseen(value, ask, walk)
                }
                return
            }
            let place = found_place ?? return
            let ty = place.ty.clone()
            if !a_container(ask.names, ty) {
                return
            }
            if a_map(ask.names, ty) {
                if ty.generics.len() == 2 {
                    flow_value(going_into(place.owner, ty.generics[0], [0], true), index, key, ask, walk)
                    flow_value(going_into(place.owner, ty.generics[1], [1], true), value, kinds, ask, walk)
                }
                return
            }
            if ty.generics.len() > 0 {
                flow_value(going_into(place.owner, ty.generics[0], [0], true), value, kinds, ask, walk)
            }
        }
        else => {
            let place = place_of(target, ask, walk)
            if place != null {
                let found = place ?? return
                flow_value(going_into(found.owner, found.ty, [], true), value, kinds, ask, walk)
            } else if kinds.still && !a_variable(target) {
                // A field of a struct this walk does not declare.
                kept_unseen(value, ask, walk)
            }
            let name = match target {
                Expr::Variable(name, _) => ask.names.resolve(name).clone(),
                else => return,
            }
            let mut local = tier_local(name, walk) ?? return
            if local.declared == null {
                local.kinds = kinds_joined(local.kinds, kinds)
                // Below, the name is of the type of the position it was read
                // out of (ADR-282 D29).
                let read_from: String = local.from?.clone() ?? ""
                if read_from != "" {
                    flow_word(read_from, kinds, walk)
                }
            }
            // Assigned again: no longer the literal it was bound to.
            local.literal = -1
            set_tier_local(name, local, walk)
        }
    }
}

/// What a function hands back: its result's position, wrapped by the emitter
/// where it is mixed (ADR-282 D14), so not marked here.
fn flow_result(value: ref Expr, kinds: ref Kinds, ask: ref TierAsk, mut walk: TierWalk) {
    let key = walk.result?.clone() ?? return
    let function = walk.declared.fns[key]?.clone() ?? return
    let result = function.result ?? return
    // **A field read through a borrowed parameter is a view of it** when it
    // is handed back (ADR-282 D2, D12, #663): `return self.path` from a
    // `ref self` method points into `self`, as `-> ref String` would.
    let mut handed = kinds.clone()
    if same_kinds(handed, owned_kinds()) && lent_field(value, ask, walk) {
        handed = view_kinds()
    }
    flow_value(going_into(TextOwner::Returned(key.clone()), result, [], false), value, handed, ask, walk)
}

/// Whether a value is a `String` field reached through a parameter the
/// function only borrows - `self.head.path` under `ref self`, `h.path` for
/// `h: ref Head` - every step a field of a struct the walk can name, and none
/// a view itself, so what it points into is that parameter.
fn lent_field(value: ref Expr, ask: ref TierAsk, walk: ref TierWalk) -> bool {
    let place = place_of(value, ask, walk) ?? return false
    if !plain_string(ask.names, place.ty) || place.ty.is_nullable {
        return false
    }
    return match value {
        Expr::Field { base, .. } => lent_root(base, ask, walk),
        else => false,
    }
}

fn lent_root(base: ref Expr, ask: ref TierAsk, walk: ref TierWalk) -> bool {
    return match base {
        Expr::Variable(name, _) => lent_parameter(ask.names.resolve(name), walk),
        Expr::Field { base: inner, .. } => {
            let place = place_of(base, ask, walk) ?? return false
            !place.ty.is_view && !place.ty.is_nullable && lent_root(inner, ask, walk)
        },
        else => false,
    }
}

/// A name bound to the borrowed subject or to a `ref` parameter of a struct.
fn lent_parameter(name: ref String, walk: ref TierWalk) -> bool {
    let local = tier_local(name, walk) ?? return false
    if name == "self" {
        return walk.lent_self && local.declared == null
    }
    let declared = local.declared ?? return false
    let parameter = match declared.owner {
        TextOwner::Param(_, _) => true,
        else => false,
    }
    return parameter && declared.ty.is_view && !declared.ty.is_nullable && local.of != null
}

/// A name bound to a literal, kept in a position: remembered with it, so that
/// where the position stays `String` the binding is declared `String`
/// (ADR-282 D17).
fn kept_literal(value: ref Expr, owner: ref TextOwner, path: ref Vec[i64], ty: ref Type, ask: ref TierAsk, mut walk: TierWalk) {
    if !plain_string(ask.names, ty) {
        return
    }
    let name = match value {
        Expr::Variable(name, _) => ask.names.resolve(name).clone(),
        else => return,
    }
    let local = tier_local(name, walk) ?? return
    if local.literal < 0 {
        return
    }
    let word = seen(owner, path, walk)
    let mut kept: collections::BTreeSet[String] = walk.flows.literal_lets[local.literal]?.clone() ?? collections::BTreeSet()
    kept.insert(word)
    walk.flows.literal_lets.insert(local.literal, kept)
}

/// The struct a value is of, where the program says so without types: a
/// literal of it, a name bound to one, `self` in its `impl`.
fn tier_struct_of(expr: ref Expr, ask: ref TierAsk, walk: ref TierWalk) -> String? {
    return match expr {
        Expr::StructLit { name, .. } => ask.names.resolve(name).clone(),
        Expr::Variable(name, _) => struct_of_local(ask.names.resolve(name), walk),
        Expr::Unary { expr, .. } => tier_struct_of(expr, ask, walk),
        Expr::Try(inner, _) => tier_struct_of(inner, ask, walk),
        Expr::Field { base, name, .. } => field_struct(base, ask.names.resolve(name), ask, walk),
        else => null,
    }
}

/// The type a field holds, by its written name, where that is one name: a
/// struct of the program's or a type of `std` (`http1::Head`).
fn field_struct(base: ref Expr, field: ref String, ask: ref TierAsk, walk: ref TierWalk) -> String? {
    let place = field_place(base, field, ask, walk) ?? return null
    if place.ty.generics.len() > 0 || place.ty.is_nullable || place.ty.is_tuple || place.ty.is_slice || place.ty.code != null {
        return null
    }
    return ask.names.resolve(place.ty.name).clone()
}

fn struct_of_local(name: ref String, walk: ref TierWalk) -> String? {
    let local = tier_local(name, walk) ?? return null
    return local.of?.clone()
}

/// Arguments handed to a function of this program: each goes into its
/// parameter's position. The emitter wraps an argument to a mixed parameter
/// itself (`Emitter::either_param`), in a hole as anywhere else.
fn flow_args(key: ref String, args: ref Vec[Expr], given: ref Vec[Kinds], ask: ref TierAsk, mut walk: TierWalk) {
    let function = walk.declared.fns[key]?.clone() ?? return
    let mut at = 0
    while at < args.len() && at < given.len() {
        if at < function.params.len() {
            let owner = TextOwner::Param(key.clone(), at)
            flow_value(going_into(owner, function.params[at], [], false), args[at], given[at], ask, walk)
            if at < function.changes.len() && function.changes[at] {
                changed_in_place(args[at], ask, walk)
            }
        }
        at += 1
    }
}

/// Walk an expression, recording what flows into the positions inside it;
/// what kind of text its value is.
fn tier_expr(expr: ref Expr, ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    return match expr {
        Expr::LitStr { .. } => lasting_kinds(),
        // `null`, a number, a truth value and a character are no text.
        Expr::LitNull(_) => no_kinds(),
        Expr::LitInt { .. } => no_kinds(),
        Expr::LitFloat(_, _) => no_kinds(),
        Expr::LitBool(_, _) => no_kinds(),
        // **A hole is code** (ADR-309), and a value handed over inside one is
        // handed over there (ADR-229 D1): each hole is walked with its place.
        Expr::LitInterpolated { parts, .. } => {
            let outer = walk.in_hole
            walk.in_hole = true
            for part in parts {
                match part {
                    FPart::Hole { expr, at, .. } => {
                        let held = walk.hole_text
                        walk.hole_text = at as i64
                        tier_expr(expr, ask, walk)
                        walk.hole_text = held
                    }
                    else => {}
                }
            }
            walk.in_hole = outer
            owned_kinds()
        }
        Expr::Variable(name, _) => kinds_of_local(ask.names.resolve(name), walk),
        Expr::MethodCall { receiver, method, args, .. } => method_kinds(receiver, ask.names.resolve(method), args, ask, walk),
        Expr::SafeMethod { receiver, method, args, .. } => method_kinds(receiver, ask.names.resolve(method), args, ask, walk),
        Expr::Call { func, args, .. } => call_kinds(func, args, ask, walk),
        Expr::Field { base, .. } => field_kinds(expr, base, ask, walk),
        Expr::SafeField { base, .. } => field_kinds(expr, base, ask, walk),
        Expr::Index { base, index, .. } => {
            let received = tier_expr(base, ask, walk)
            tier_expr(index, ask, walk)
            if a_range(index) {
                return viewed(received)
            }
            let place = place_of(base, ask, walk) ?? return received
            element_kinds(place, false, ask, walk)
        }
        Expr::StructLit { name, fields, .. } => {
            let owner = ask.names.resolve(name).clone()
            for field in fields {
                tier_struct_field(owner, field, ask, walk)
            }
            owned_kinds()
        }
        Expr::With { base, fields, .. } => {
            tier_expr(base, ask, walk)
            let owner = tier_struct_of(base, ask, walk)
            for field in fields {
                let value = field.value ?? continue
                let kinds = tier_expr(value, ask, walk)
                let of = owner?.clone() ?? continue
                let key = (of.clone(), ask.names.resolve(field.name).clone())
                let found = walk.declared.fields[key]?.clone() ?? continue
                let into = TextOwner::Field(of.clone(), ask.names.resolve(field.name).clone())
                flow_value(going_into(into, found.ty, [], false), value, kinds, ask, walk)
            }
            owned_kinds()
        }
        Expr::If { cond, then_branch, else_branch, .. } => {
            tier_expr(cond, ask, walk)
            let mut out = tier_block(then_branch, ask, walk)
            if else_branch != null {
                let otherwise = else_branch ?? return out
                out = kinds_joined(out, tier_block(otherwise, ask, walk))
            }
            if beside_its_own(out) {
                kept_unseen(expr, ask, walk)
            }
            if literals_beside_null(expr) {
                return owned_kinds()
            }
            out
        }
        Expr::Match { value, arms, .. } => {
            let scrutinee = tier_expr(value, ask, walk)
            // **What a list pattern binds** is not followed: a list of static
            // text matched on keeps text of its own (ADR-282 D29).
            if scrutinee.still {
                let whole = source_of(value, ask, walk)
                if container_source(whole, ask) {
                    kept_unseen(value, ask, walk)
                }
            }
            let mut out = no_kinds()
            for arm in arms {
                if arm.guard != null {
                    let guard = arm.guard ?? continue
                    tier_expr(guard, ask, walk)
                }
                out = kinds_joined(out, tier_expr(arm.body, ask, walk))
            }
            if beside_its_own(out) {
                kept_unseen(expr, ask, walk)
            }
            if literals_beside_null(expr) {
                return owned_kinds()
            }
            out
        }
        Expr::Block(block, _) => tier_block(block, ask, walk),
        Expr::Unsafe(block, _) => tier_block(block, ask, walk),
        Expr::Overlap(block, _) => tier_block(block, ask, walk),
        // A lambda's `return` is the lambda's, not the function's.
        Expr::Closure { body, .. } => {
            let held = walk.result?.clone()
            walk.result = null
            tier_block(body, ask, walk)
            walk.result = held
            owned_kinds()
        }
        Expr::Spawn { body, .. } => {
            let held = walk.result?.clone()
            walk.result = null
            tier_expr(body, ask, walk)
            walk.result = held
            owned_kinds()
        }
        Expr::Coalesce { value, fallback, .. } => {
            let first = tier_expr(value, ask, walk)
            let out = kinds_joined(first, tier_expr(fallback, ask, walk))
            if beside_its_own(out) {
                kept_unseen(value, ask, walk)
                kept_unseen(fallback, ask, walk)
            }
            out
        }
        Expr::TryCatch { expr, handler, .. } => {
            let out = tier_expr(expr, ask, walk)
            kinds_joined(out, tier_block(handler, ask, walk))
        }
        Expr::Try(inner, _) => tier_expr(inner, ask, walk),
        Expr::Unary { expr, .. } => tier_expr(expr, ask, walk),
        Expr::Throw(inner, _) => {
            tier_expr(inner, ask, walk)
            no_kinds()
        }
        Expr::Return(value, _) => {
            let given = value ?? return no_kinds()
            let kinds = tier_expr(given, ask, walk)
            flow_result(given, kinds, ask, walk)
            no_kinds()
        }
        Expr::Binary { op, lhs, rhs, .. } => {
            let left = tier_expr(lhs, ask, walk)
            tier_expr(rhs, ask, walk)
            let adds = match op {
                BinaryOp::Add => true,
                else => false,
            }
            if adds && left.still {
                kept_unseen(lhs, ask, walk)
            }
            owned_kinds()
        }
        Expr::Cast { expr, .. } => {
            tier_expr(expr, ask, walk)
            owned_kinds()
        }
        Expr::Tuple(items, _) => {
            let out = items_kinds(items, ask, walk)
            if out.still {
                for item in items {
                    kept_unseen(item, ask, walk)
                }
            }
            out
        }
        Expr::ListLit { items, .. } => {
            let out = items_kinds(items, ask, walk)
            if beside_its_own(out) {
                for item in items {
                    kept_unseen(item, ask, walk)
                }
            }
            out
        }
        Expr::ListRepeat { value, count, .. } => {
            tier_expr(value, ask, walk)
            tier_expr(count, ask, walk)
            owned_kinds()
        }
        Expr::Range { start, end, .. } => {
            tier_expr(start, ask, walk)
            tier_expr(end, ask, walk)
            owned_kinds()
        }
        else => owned_kinds(),
    }
}

fn a_range(index: ref Expr) -> bool {
    return match index {
        Expr::Range { .. } => true,
        else => false,
    }
}

fn kinds_of_local(name: ref String, walk: ref TierWalk) -> Kinds {
    let local = tier_local(name, walk) ?? return owned_kinds()
    return local.kinds.clone()
}

fn items_kinds(items: ref Vec[Expr], ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    let mut out = no_kinds()
    for item in items {
        out = kinds_joined(out, tier_expr(item, ask, walk))
    }
    return out
}

fn field_kinds(expr: ref Expr, base: ref Expr, ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    tier_expr(base, ask, walk)
    let place = place_of(expr, ask, walk) ?? return owned_kinds()
    return kinds_of_declared(place, ask, walk)
}

/// A field of a struct literal: what goes into it is a flow the emitter wraps
/// itself where the field is mixed (ADR-282 D14).
fn tier_struct_field(owner: ref String, field: ref FieldInit, ask: ref TierAsk, mut walk: TierWalk) {
    let shorthand = Expr::Variable(field.name, fresh_id())
    let kinds = field_value_kinds(field, shorthand, ask, walk)
    let name = ask.names.resolve(field.name).clone()
    let key = (owner.clone(), name.clone())
    if !walk.declared.fields.contains_key(key) {
        if kinds.still && field.value != null {
            let value = field.value ?? return
            kept_unseen(value, ask, walk)
        } else if kinds.still {
            kept_unseen(shorthand, ask, walk)
        }
        return
    }
    let found = walk.declared.fields[key]?.clone() ?? return
    let into = TextOwner::Field(owner.clone(), name)
    flow_value(going_into(into, found.ty, [], false), field.value, kinds, ask, walk)
    if field.value == null {
        kept_literal(shorthand, into, no_path(), found.ty, ask, walk)
    }
}

fn field_value_kinds(field: ref FieldInit, shorthand: ref Expr, ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    if field.value != null {
        let value = field.value ?? return no_kinds()
        return tier_expr(value, ask, walk)
    }
    return tier_expr(shorthand, ask, walk)
}

fn call_kinds(func: ref Expr, args: ref Vec[Expr], ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    let mut given: Vec[Kinds] = []
    for arg in args {
        given.push(tier_expr(arg, ask, walk))
    }
    let callee = tier_callee(func, ask) ?? return owned_kinds()
    if walk.declared.fns.contains_key(callee) {
        flow_args(callee, args, given, ask, walk)
        if walk.declared.rules.contains(callee) && args.len() >= 1 {
            parsed_parameter(args[0], ask, walk)
        }
        return result_kinds(callee, ask, walk)
    }
    // `Vec()`, `HashMap()`: empty, so no text of any kind.
    if args.len() == 0 && is_a_container_name(callee) {
        return no_kinds()
    }
    // **A value built by a type's name keeps what it is given** - an
    // enum's variant, `Escape::Outer(name)` - and so may a function of
    // another file of the package: no position this walk sees says what
    // (ADR-282 D29).
    if names_a_type(last_segment(callee)) || !ask.library.functions.contains_key(callee) {
        kept_args(args, given, ask, walk)
    } else {
        std_container_args(args, ask, walk)
    }
    return std_result(callee, ask)
}

/// **A container of text handed whole to `std` holds text of its own**
/// (ADR-282 D29): `std`'s signature says `Vec[String]`, and a list of views
/// is not one below.
fn std_container_args(args: ref Vec[Expr], ask: ref TierAsk, mut walk: TierWalk) {
    for arg in args {
        let whole = source_of(arg, ask, walk)
        if whole != null {
            let found = whole ?? return
            if a_container(ask.names, found.ty) && holds_text(ask.names, found.ty) {
                demote_inside(found.owner, found.ty, [], ask, walk)
            }
        }
    }
}

// **A parameter a parse is given is a view** (ADR-282 D2): what the parse
// hands back may point into it, so the caller lends its text for as long as
// that lives - what `ref String` written on it says.
fn parsed_parameter(value: ref Expr, ask: ref TierAsk, mut walk: TierWalk) {
    let name = match value {
        Expr::Variable(name, _) => ask.names.resolve(name).clone(),
        else => return,
    }
    let local = tier_local(name, walk) ?? return
    let declared = local.declared ?? return
    let parameter = match declared.owner {
        TextOwner::Param(_, _) => true,
        else => false,
    }
    if !parameter || !plain_string(ask.names, declared.ty) {
        return
    }
    let word = seen(declared.owner, no_path(), walk)
    walk.flows.viewed.insert(word)
}

fn method_kinds(receiver: ref Expr, method: ref String, args: ref Vec[Expr], ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    let received = tier_expr(receiver, ask, walk)
    if changes_its_text(method) {
        changed_in_place(receiver, ask, walk)
    }
    let mut given: Vec[Kinds] = []
    for arg in args {
        given.push(tier_expr(arg, ask, walk))
    }
    // **A method this program declares answers for itself**, before any name
    // in the lists below.
    // **On a receiver whose type is known, the method is that type's**
    // (#663): `self.head.path()` answers with `Head::path` alone, not with
    // every `path` the program declares, and on a type of `std` it is `std`'s.
    let of = tier_struct_of(receiver, ask, walk)
    let mut keys: Vec[String] = walk.declared.methods[method]?.clone() ?? []
    if of != null {
        let own = f"{of ?? ""}::{method}"
        if keys.contains(own) {
            keys = [own]
        } else if std_declares(method, of, ask) {
            keys = []
        }
    }
    if keys.len() > 0 {
        for key in keys {
            flow_args(key, args, given, ask, walk)
        }
        let mut out = no_kinds()
        for key in keys {
            out = kinds_joined(out, result_kinds(key, ask, walk))
        }
        return out
    }
    // **A method neither this file nor `std` declares** - one of another
    // file of the package - may keep what it is given (ADR-282 D29).
    if !puts_its_argument(method) && any_still(given) && !std_has_method(method, ask) {
        kept_args(args, given, ask, walk)
    }
    // **Into a container no position this walk sees declares**: a list of
    // its own or of a struct of another file.
    if puts_its_argument(method) && any_still(given) && place_of(receiver, ask, walk) == null {
        kept_args(args, given, ask, walk)
    }
    // **Into a container that declares its element `String`**.
    let place = place_of(receiver, ask, walk)
    if place != null {
        let found = place ?? return owned_kinds()
        let ty = found.ty.clone()
        if puts_its_argument(method) && a_container(ask.names, ty) {
            put_into_container(found, method, args, given, ask, walk)
            return owned_kinds()
        }
        // **`entry(k)` puts its key into the map** whatever the chain after it
        // does with the value.
        if method == "entry" && a_map(ask.names, ty) && args.len() == 1 && given.len() == 1 && ty.generics.len() == 2 {
            flow_value(going_into(found.owner, ty.generics[0], [0], true), args[0], given[0], ask, walk)
            return owned_kinds()
        }
        if hands_back_an_element(method) {
            return element_kinds(found, method == "keys", ask, walk)
        }
        // **A copy of a list is a list of the same text** below: where that
        // text is static, the copy is a list of text of its own, so the list
        // keeps text of its own (ADR-282 D29).
        if (method == "clone" || method == "to_owned" || method == "to_vec") && args.len() == 0 && a_container(ask.names, ty) && received.still {
            demote_inside(found.owner, ty, [], ask, walk)
        }
    }
    // **What `map` makes is what its lambda hands back**, with the lambda's
    // parameter bound to what came in (ADR-293 D26).
    if method == "map" && args.len() == 1 {
        match args[0] {
            Expr::Closure { params, body, .. } => return mapped(params, body, received, ask, walk),
            else => {}
        }
    }
    if method == "filter" || method == "rev" || method == "skip" || method == "take" || method == "step_by" {
        return received
    }
    if owns_its_text(method) {
        return owned_kinds()
    }
    if views_what_it_is_called_on(method) || cuts_in_two(method) {
        return viewed(received)
    }
    if hands_back_an_element(method) {
        return received
    }
    if std_method_views(method, of, ask) {
        return view_kinds()
    }
    return owned_kinds()
}

/// Whether `std` declares this method on the receiver's type: `self.head.path()`
/// on an `http1::Head` is `std`'s, whatever `path` the program declares too.
fn std_declares(method: ref String, of: ref String?, ask: ref TierAsk) -> bool {
    let receiver = of ?? return false
    let own = f"{last_segment(receiver)}::{method}"
    let within = f"::{own}"
    for (key, _) in ask.library.functions {
        if key == own || key.ends_with(ref within) {
            return true
        }
    }
    return false
}

/// **A method of `std` whose every entry by that name hands back a view of
/// text** (`head.path()`, `-> ref(self) String`): its result is a view. One
/// entry that hands back anything else leaves it text of its own. Only the
/// entry of the receiver's own type answers, so the receiver's type must be
/// known: `host.text()` on a `host: ref H` of the program's, or `ty.text()`
/// on a type of another module, is not `Bytes::text` (#663).
fn std_method_views(method: ref String, of: ref String?, ask: ref TierAsk) -> bool {
    let receiver = of ?? return false
    let own = f"{last_segment(receiver)}::{method}"
    let within = f"::{own}"
    let mut any = false
    for (key, contract) in ask.library.functions {
        if key != own && !key.ends_with(ref within) {
            continue
        }
        let signature = contract.signature ?? return false
        if !signature.takes_a_receiver() {
            continue
        }
        let result = signature.result ?? return false
        let text = match result {
            Ty::Nullable(inner) => inner.clone(),
            else => result.clone(),
        }
        if !text.is_a_view() || text.owned().text() != "String" {
            return false
        }
        any = true
    }
    return any
}

// Methods of text whose result is two views of it, in a tuple or an option of
// one: each part bound by a `let (a, b)` is that view.
fn cuts_in_two(method: ref String) -> bool {
    return method == "split_at" || method == "split_once" || method == "rsplit_once"
}

fn put_into_container(place: ref Declaring, method: ref String, args: ref Vec[Expr], given: ref Vec[Kinds], ask: ref TierAsk, mut walk: TierWalk) {
    let ty = place.ty.clone()
    if a_map(ask.names, ty) {
        if args.len() == 2 && given.len() == 2 && ty.generics.len() == 2 {
            flow_value(going_into(place.owner, ty.generics[0], [0], true), args[0], given[0], ask, walk)
            flow_value(going_into(place.owner, ty.generics[1], [1], true), args[1], given[1], ask, walk)
        }
        return
    }
    // `insert(i, v)` on a run: the value is last.
    if ty.generics.len() == 0 || args.len() == 0 || given.len() == 0 {
        return
    }
    let wrap = method != "extend" && method != "append"
    flow_value(going_into(place.owner, ty.generics[0], [0], wrap), args[args.len() - 1], given[given.len() - 1], ask, walk)
}

fn mapped(params: ref Vec[winnow_grammar::Symbol], body: ref Block, received: ref Kinds, ask: ref TierAsk, mut walk: TierWalk) -> Kinds {
    let held = walk.result?.clone()
    walk.result = null
    open_tier_scope(walk)
    if params.len() == 0 {
        bind_tier_local("a", plain_local(received.clone()), walk)
    }
    for param in params {
        bind_tier_local(ask.names.resolve(param).clone(), plain_local(received.clone()), walk)
    }
    let made = tier_block(body, ask, walk)
    close_tier_scope(walk)
    walk.result = held
    return made
}

/// What a function of this program hands back.
fn result_kinds(key: ref String, ask: ref TierAsk, walk: ref TierWalk) -> Kinds {
    let function = walk.declared.fns[key] ?? return owned_kinds()
    let result = function.result ?? return owned_kinds()
    return kinds_of(TextOwner::Returned(key.clone()), result, [], ask, walk)
}

/// A view of text of these kinds: a view of a literal is as lasting as the
/// literal, and a view of anything else is a view.
fn viewed(received: ref Kinds) -> Kinds {
    if (received.lasting || received.still) && !received.owned && !received.view && !received.either {
        if received.still {
            return still_kinds()
        }
        return lasting_kinds()
    }
    return view_kinds()
}

/// What a function of `std` hands back, off its ledger entry.
fn std_result(callee: ref String, ask: ref TierAsk) -> Kinds {
    let contract = ask.library.functions[callee] ?? return owned_kinds()
    let signature = contract.signature ?? return owned_kinds()
    let result = signature.result ?? return owned_kinds()
    if result.text() == "ref String" {
        return view_kinds()
    }
    return owned_kinds()
}

/// Walk every function of the program once against the tiers found so far.
fn walk_program(program: ref Program, ask: ref TierAsk, mut walk: TierWalk) {
    for item in program.items {
        match item.node {
            Item::Fn { .. } => walk_function(item.node, null, ask, walk),
            Item::Impl { target, methods, .. } => {
                let owner = ask.names.resolve(target.name).clone()
                for method in methods {
                    walk_function(method.node, owner.clone(), ask, walk)
                }
            }
            Item::Grammar(def) => walk_grammar(def, ask, walk),
            // A test's and a bench's values flow as a function's do.
            Item::Test { body, .. } => walk_body(body, ask, walk),
            Item::Bench { body, .. } => walk_body(body, ask, walk),
            // **A value computed while the program is built** - a `comptime`,
            // a field's default - crosses as the text of its own its type
            // says (ADR-282 D29): what it reads keeps text of its own.
            Item::Comptime { value, .. } => {
                fresh_tier_frame(walk)
                kept_unseen(value, ask, walk)
            },
            Item::Struct { fields, .. } => {
                fresh_tier_frame(walk)
                for field in fields {
                    let given = field.default ?? continue
                    kept_unseen(given.value, ask, walk)
                }
            },
            else => {}
        }
    }
}

/// A walk outside any function: no locals, no result.
fn fresh_tier_frame(mut walk: TierWalk) {
    walk.locals = collections::BTreeMap()
    walk.frames = []
    walk.result = null
    walk.in_hole = false
    walk.hole_text = -1
    walk.lent_self = false
}

fn walk_body(body: ref Block, ask: ref TierAsk, mut walk: TierWalk) {
    walk.locals = collections::BTreeMap()
    walk.frames = []
    walk.result = null
    walk.in_hole = false
    walk.hole_text = -1
    walk.lent_self = false
    tier_block(body, ask, walk)
}

/// **A rule's action is walked as a function's body is**: the names its
/// pattern binds are what they capture - a view of the input, or what the rule
/// they call hands back - and its last value goes into the rule's result. A
/// rule without an action hands back what its pattern captures.
fn walk_grammar(def: ref GrammarDef, ask: ref TierAsk, mut walk: TierWalk) {
    let gname = ask.names.resolve(def.name).clone()
    let mut rules: collections::BTreeSet[String] = collections::BTreeSet()
    for rule in def.rules {
        rules.insert(ask.names.resolve(rule.name).clone())
    }
    for rule in def.rules {
        let key = f"{gname}::{ask.names.resolve(rule.name)}"
        for alt in rule.alts {
            walk.locals = collections::BTreeMap()
            walk.frames = []
            walk.result = key.clone()
            walk.in_hole = false
            walk.hole_text = -1
            open_tier_scope(walk)
            bind_grammar_pattern(gname, rules, alt.pattern.node, ask, walk)
            if alt.action == null {
                let kinds = grammar_pattern_kinds(gname, rules, alt.pattern.node, ask, walk)
                flow_pattern_result(key, rule.ret_type, kinds, ask, walk)
            }
            walk_action(alt.action, ask, walk)
            close_tier_scope(walk)
        }
    }
}

fn flow_pattern_result(key: ref String, ret_type: ref Type?, kinds: ref Kinds, ask: ref TierAsk, mut walk: TierWalk) {
    let ty = ret_type ?? return
    if plain_string(ask.names, ty) {
        flow_type(TextOwner::Returned(key.clone()), ty, [], kinds, ask, walk)
    }
}

fn walk_action(action: ref Block?, ask: ref TierAsk, mut walk: TierWalk) {
    let block = action ?? return
    let tail = tier_block(block, ask, walk)
    if block.stmts.len() > 0 {
        match block.stmts[block.stmts.len() - 1].node {
            Stmt::Expr(last) => flow_result(last, tail, ask, walk),
            else => {}
        }
    }
}

fn bind_grammar_pattern(gname: ref String, rules: ref collections::BTreeSet[String], pattern: ref Pattern, ask: ref TierAsk, mut walk: TierWalk) {
    match pattern {
        Pattern::Bind { name, pat } => {
            let kinds = grammar_pattern_kinds(gname, rules, pat.node, ask, walk)
            bind_tier_local(ask.names.resolve(name).clone(), plain_local(kinds), walk)
            bind_grammar_pattern(gname, rules, pat.node, ask, walk)
        }
        Pattern::Seq(parts) => {
            for part in parts {
                bind_grammar_pattern(gname, rules, part.node, ask, walk)
            }
        }
        Pattern::Choice(parts) => {
            for part in parts {
                bind_grammar_pattern(gname, rules, part.node, ask, walk)
            }
        }
        Pattern::Ref { args, .. } => {
            for arg in args {
                bind_grammar_pattern(gname, rules, arg.node, ask, walk)
            }
        }
        Pattern::Repeat { pat, .. } => bind_grammar_pattern(gname, rules, pat.node, ask, walk),
        Pattern::Group(pat) => bind_grammar_pattern(gname, rules, pat.node, ask, walk),
        else => {}
    }
}

/// What kind of text a pattern captures, as the checker types it: a rule of the
/// grammar hands back its result, a repetition or a list its element's kind,
/// the primitives that capture text a view of the input the parse was given,
/// and anything else no text.
fn grammar_pattern_kinds(gname: ref String, rules: ref collections::BTreeSet[String], pattern: ref Pattern, ask: ref TierAsk, walk: ref TierWalk) -> Kinds {
    return match pattern {
        Pattern::Repeat { pat, .. } => grammar_repeat_kinds(gname, rules, pat.node, ask, walk),
        Pattern::Group(pat) => grammar_pattern_kinds(gname, rules, pat.node, ask, walk),
        Pattern::Choice(parts) => grammar_choice_kinds(gname, rules, parts, ask, walk),
        Pattern::Ref { name, generics, args } => grammar_reference_kinds(gname, rules, ask.names.resolve(name), generics.len(), args, ask, walk),
        else => no_kinds(),
    }
}

// `digit+` is the text the digits stand in; any other repetition a list of
// what it repeats.
fn grammar_repeat_kinds(gname: ref String, rules: ref collections::BTreeSet[String], pat: ref Pattern, ask: ref TierAsk, walk: ref TierWalk) -> Kinds {
    match pat {
        Pattern::Ref { name, generics, args } => {
            let called = ask.names.resolve(name)
            if generics.len() == 0 && args.len() == 0 && !rules.contains(called) && (called == "digit" || called == "hex_digit" || called == "any") {
                return view_kinds()
            }
        }
        else => {}
    }
    return grammar_pattern_kinds(gname, rules, pat, ask, walk)
}

fn grammar_choice_kinds(gname: ref String, rules: ref collections::BTreeSet[String], parts: ref Vec[Spanned[Pattern]], ask: ref TierAsk, walk: ref TierWalk) -> Kinds {
    let mut out = no_kinds()
    for part in parts {
        out = kinds_joined(out, grammar_pattern_kinds(gname, rules, part.node, ask, walk))
    }
    return out
}

fn grammar_reference_kinds(gname: ref String, rules: ref collections::BTreeSet[String], called: ref String, generics: i64, args: ref Vec[Spanned[Pattern]], ask: ref TierAsk, walk: ref TierWalk) -> Kinds {
    if rules.contains(called) {
        return result_kinds(f"{gname}::{called}", ask, walk)
    }
    if generics > 0 {
        return no_kinds()
    }
    if (called == "peek" || called == "list") && args.len() >= 1 {
        return grammar_pattern_kinds(gname, rules, args[0].node, ask, walk)
    }
    if (called == "until" || called == "text") && args.len() >= 1 {
        return view_kinds()
    }
    if args.len() == 0 && (called == "raw_ident" || called == "string" || called == "alpha1" || called == "multispace0" || called == "multispace1") {
        return view_kinds()
    }
    return no_kinds()
}

fn walk_function(item: ref Item, target: String?, ask: ref TierAsk, mut walk: TierWalk) {
    let (name, receiver, args, config, body) = match item {
        Item::Fn { name, receiver, args, config, body, .. } => (name, receiver, args, config, body),
        else => return,
    }
    let key = tier_key(target, own_name(name, ask.names))
    walk.locals = collections::BTreeMap()
    walk.frames = []
    walk.result = key.clone()
    walk.in_hole = false
    walk.hole_text = -1
    open_tier_scope(walk)
    let mut at = 0
    for arg in args {
        let owner = TextOwner::Param(key.clone(), at)
        let kinds = kinds_of(owner, arg.ty, [], ask, walk)
        let of: String = ask.names.resolve(arg.ty.name).clone()
        let local = TierLocal { kinds: kinds, of: of, literal: -1, declared: Declaring { owner: owner, ty: arg.ty.clone() }, from: null, empty: -1 }
        bind_tier_local(ask.names.resolve(arg.name).clone(), local, walk)
        at += 1
    }
    // **An option's default is computed while the program is built** and
    // crosses as the text of its own its type says (ADR-282 D29): what it
    // reads keeps text of its own.
    for option in config {
        kept_unseen(option.default, ask, walk)
    }
    walk.lent_self = false
    if receiver != null && target != null {
        walk.lent_self = receiver?.is_ref ?? false
        let local = TierLocal { kinds: owned_kinds(), of: target?.clone(), literal: -1, declared: null, from: null, empty: -1 }
        bind_tier_local("self", local, walk)
    }
    let tail = tier_block(body, ask, walk)
    // The body's last value is what it hands back.
    if body.stmts.len() > 0 {
        match body.stmts[body.stmts.len() - 1].node {
            Stmt::Expr(last) => flow_result(last, tail, ask, walk),
            else => {}
        }
    }
    close_tier_scope(walk)
}

// --- The decision ---

/// Linked positions are one representation: each gets what flows into any of
/// them, and none is mixed where one of them cannot be.
fn decide_tiers(flows: ref Flows, declared: ref TextDeclared, mut demoted: collections::BTreeSet[String]) -> collections::BTreeMap[String, Tier] {
    let mut positions = flows.positions.clone()
    for word in flows.demoted {
        demoted.insert(word.clone())
    }
    for word in demoted {
        let before = positions[word]?.clone() ?? no_kinds()
        positions.insert(word.clone(), kinds_joined(before, owned_kinds()))
    }
    // **A published parameter's text may be either kind** (ADR-282 D23):
    // below it takes whatever hands over as `EitherText`. Its elements, a
    // published field and a published result stay what they are published
    // as.
    let mut fixed: collections::BTreeSet[String] = collections::BTreeSet()
    // Positions that are never static text: inside a map.
    let mut never: collections::BTreeSet[String] = flows.in_maps.clone()
    // Every position the walk saw, also one only linked to another (a list
    // handed back whole from a call): a published one stays text of its own.
    for (word, _) in flows.known {
        if flows.unwrappable.contains(word) || fixed_by_publishing(word, flows, declared) {
            fixed.insert(word.clone())
        }
    }
    let mut changed = true
    while changed {
        changed = false
        // **Where a view of static text goes beside text of its own, the
        // position it was read out of keeps text of its own too** (ADR-282
        // D29): its literals are built where they stand, as before.
        for (from, to) in flows.still_into {
            let into = positions[to]?.clone() ?? no_kinds()
            let kept = into.owned || fixed.contains(to) || never.contains(to) || a_published_parameter(to, flows, declared)
            if kept && !into.view && !into.either && joins_kinds(from, kinds_joined(positions[from]?.clone() ?? no_kinds(), owned_kinds()), positions) {
                demoted.insert(from.clone())
                changed = true
            }
        }
        // **A name bound to a literal is one binding** (ADR-282 D17): kept
        // anywhere as text of its own, it is text of its own everywhere it
        // is kept.
        for (_, kept) in flows.literal_lets {
            let mut owned = false
            for word in kept {
                let tier = tier_of_kinds(positions[word]?.clone() ?? no_kinds())
                let published = fixed.contains(word) || never.contains(word) || a_published_parameter(word, flows, declared)
                if owned_tier(tier) || (lasting_tier(tier) && published) {
                    owned = true
                }
            }
            if owned {
                for word in kept {
                    let before = positions[word]?.clone() ?? no_kinds()
                    if lasting_tier(tier_of_kinds(before)) && joins_kinds(word, kinds_joined(before, owned_kinds()), positions) {
                        demoted.insert(word.clone())
                        changed = true
                    }
                }
            }
        }
        for (a, b) in flows.links {
            let mut both = positions[a]?.clone() ?? no_kinds()
            both = kinds_joined(both, positions[b]?.clone() ?? no_kinds())
            if joins_kinds(a, both, positions) {
                changed = true
            }
            if joins_kinds(b, both, positions) {
                changed = true
            }
            if fixed.contains(a) != fixed.contains(b) {
                fixed.insert(a.clone())
                fixed.insert(b.clone())
                changed = true
            }
            if never.contains(a) != never.contains(b) {
                never.insert(a.clone())
                never.insert(b.clone())
                changed = true
            }
        }
        // **A parameter whose value leaves through something fixed is fixed**
        // (ADR-282 D24).
        for (from, to) in flows.param_into {
            if fixed.contains(to) && !fixed.contains(from) {
                fixed.insert(from.clone())
                changed = true
            }
        }
    }
    let mut out: collections::BTreeMap[String, Tier] = collections::BTreeMap()
    for (word, kinds) in positions {
        let mut tier = tier_of_kinds(kinds)
        if mixed(tier) && fixed.contains(word) {
            tier = Tier::Owned
        }
        // **What is published keeps text of its own** where only literals
        // flow in: this walk reads one file, and another file of the package
        // may put text of its own there (ADR-282 D22, D29).
        if lasting_tier(tier) && (fixed.contains(word) || never.contains(word) || a_published_parameter(word, flows, declared)) {
            tier = Tier::Owned
        }
        if !owned_tier(tier) {
            out.insert(word.clone(), tier)
        }
    }
    // **A parameter the body only reads is the `&str` any `String` it only
    // reads is** (ADR-282 D5): only one kept holds the view (D29). One handed
    // on only to parameters that are themselves only read is read too. A
    // `String?` read is lent whole, `&Option<String>`, which a static view
    // cannot be: it stays the static view only literals flow into.
    let mut only_read: collections::BTreeSet[String] = collections::BTreeSet()
    for (word, tier) in out {
        if lasting_tier(tier) && a_parameter_itself(word, flows) && !a_nullable_parameter(word, flows, declared) {
            only_read.insert(word.clone())
        }
    }
    let mut shrinking = true
    while shrinking {
        shrinking = false
        for (from, to) in flows.param_into {
            if only_read.contains(from) && !only_read.contains(to) {
                only_read.remove(from)
                shrinking = true
            }
        }
        for (from, to) in flows.still_into {
            if only_read.contains(from) && !only_read.contains(to) {
                only_read.remove(from)
                shrinking = true
            }
        }
    }
    for word in only_read {
        out.remove(word)
    }
    for word in flows.viewed {
        out.insert(word.clone(), Tier::View)
    }
    return out
}

/// A parameter's own text, not an element of it.
fn a_parameter_itself(word: ref String, flows: ref Flows) -> bool {
    let position = flows.known[word] ?? return false
    let a_parameter = match position.owner {
        TextOwner::Param(_, _) => true,
        else => false,
    }
    return a_parameter && position.path.len() == 0
}

/// Whether a parameter is declared `String?`.
fn a_nullable_parameter(word: ref String, flows: ref Flows, declared: ref TextDeclared) -> bool {
    let position = flows.known[word] ?? return false
    return match position.owner {
        TextOwner::Param(key, at) => {
            let function = declared.fns[key] ?? return false
            at < function.params.len() && function.params[at].is_nullable
        },
        else => false,
    }
}

fn a_published_parameter(word: ref String, flows: ref Flows, declared: ref TextDeclared) -> bool {
    let position = flows.known[word] ?? return false
    let a_parameter = match position.owner {
        TextOwner::Param(_, _) => true,
        else => false,
    }
    return a_parameter && position_published(position.owner, declared)
}

fn joins_kinds(word: ref String, both: ref Kinds, mut positions: collections::BTreeMap[String, Kinds]) -> bool {
    let before = positions[word]?.clone() ?? no_kinds()
    if positions.contains_key(word) && same_kinds(before, both) {
        return false
    }
    positions.insert(word.clone(), both.clone())
    return true
}

fn fixed_by_publishing(word: ref String, flows: ref Flows, declared: ref TextDeclared) -> bool {
    let position = flows.known[word] ?? return false
    if !position_published(position.owner, declared) {
        return false
    }
    let a_parameter = match position.owner {
        TextOwner::Param(_, _) => true,
        else => false,
    }
    return !(a_parameter && position.path.len() == 0)
}

fn same_tiers(a: ref collections::BTreeMap[String, Tier], b: ref collections::BTreeMap[String, Tier]) -> bool {
    if a.len() != b.len() {
        return false
    }
    for (word, tier) in a {
        let other = b[word] ?? return false
        if tier_word(tier) != tier_word(other) {
            return false
        }
    }
    return true
}

fn tier_word(tier: Tier) -> String {
    return match tier {
        Tier::Owned => "owned",
        Tier::View => "view",
        Tier::Mixed => "mixed",
        Tier::Lasting => "lasting",
    }
}

/// **Decide the tiers of a program** - a fixpoint over walks of every
/// function - and what the rewrite needs besides.
pub fn text_tiers(program: ref Program, ask: ref TierAsk) -> TextTiers {
    let declared = declared_of(program, ask.names)
    let text = string_type(declared, ask.names)
    let mut walk = TierWalk { declared: declared, tiers: collections::BTreeMap(), flows: no_flows(), locals: collections::BTreeMap(), frames: [], result: null, in_hole: false, hole_text: -1, lent_self: false, adopted: collections::BTreeMap(), demoted: collections::BTreeSet() }
    for _ in 0..<16 {
        walk.flows = no_flows()
        walk_program(program, ask, walk)
        let demoted_before = walk.demoted.len()
        let next = decide_tiers(walk.flows, walk.declared, walk.demoted)
        let linked = same_adopted(walk.flows.adopted, walk.adopted)
        if same_tiers(next, walk.tiers) && linked && walk.demoted.len() == demoted_before {
            break
        }
        walk.tiers = next
        walk.adopted = walk.flows.adopted.clone()
    }
    let mut tiers: Vec[(TextPosition, Tier)] = []
    for (word, tier) in walk.tiers {
        let position = walk.flows.known[word]?.clone() ?? continue
        tiers.push((position, tier.clone()))
    }
    // **A name bound to a literal and kept where text of its own is wanted is
    // declared `String`** (ADR-282 D17).
    let mut lets: collections::BTreeSet[i64] = collections::BTreeSet()
    for (at, kept) in walk.flows.literal_lets {
        for word in kept {
            if !walk.tiers.contains_key(word) {
                lets.insert(at.clone())
                break
            }
        }
    }
    let mut adopted: collections::BTreeMap[i64, TierAdopted] = collections::BTreeMap()
    for (at, target) in walk.flows.adopted {
        adopted.insert(at.clone(), TierAdopted { owner: target.owner.clone(), ty: target.ty.clone() })
    }
    return TextTiers { tiers: tiers, lets: lets, text: text, wraps: walk.flows.wraps.clone(), hole_wraps: walk.flows.hole_wraps.clone(), adopted: adopted }
}

fn same_adopted(a: ref collections::BTreeMap[i64, Declaring], b: ref collections::BTreeMap[i64, Declaring]) -> bool {
    if a.len() != b.len() {
        return false
    }
    for (at, target) in a {
        let other = b[at] ?? return false
        if owner_word(target.owner) != owner_word(other.owner) {
            return false
        }
    }
    return true
}

fn no_path() -> Vec[i64] {
    return []
}
