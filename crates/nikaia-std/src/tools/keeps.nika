// crates/nikaia-std/src/tools/keeps.nika
//
// **What a body does with each of its parameters** (ADR-094 D2) - the walk the
// compiler's `contracts::keeps` runs before its fixpoint (`tools/lends.nika`),
// moved from Rust (ADR-294, #125). What needs a type - which parameters there
// are, which the author lent, what each one's fields are, whether the result
// is a view - is worked out by the compiler and handed in as `KeepsBody`.
//
// The column's polarity is the one the whole walk is written for: `keeps` is a
// restriction, so a use the walk cannot resolve counts as keeping (D2).
// Each statement's expressions are classified where they stand, the holes of a
// literal included, and then the blocks it holds - a lambda's body among them,
// because it runs during the call it is given to (ADR-288 D4). A `spawn` is not
// among them: its body runs later and elsewhere, and is read for the names it
// takes.

use std::collections

/// What the walk is told about the function whose body it reads.
pub struct KeepsBody {
    /// Every parameter, the receiver of a method included.
    pub parameters: collections::BTreeSet[String],
    /// The ones the author lent - `ref`, `mut`, `ref self` - which are
    /// references in the Rust whatever this walk decides, so a `match` over
    /// one does not keep it (issue #173).
    pub lent: collections::BTreeSet[String],
    /// The fields of each parameter whose type this file declares; a
    /// parameter of any other type has none here, and a field this cannot see
    /// keeps.
    pub fields: collections::BTreeMap[String, collections::BTreeMap[String, Ty]],
    /// The result is a view, so a `return` keeps nothing by returning.
    pub returns_a_view: bool,
    /// The body's last expression is its value and leaves the call.
    pub hands_back_its_last: bool,
    /// A method call of this body went to an entry no ledger has, so the
    /// candidates for a method name are not the whole list.
    pub unresolved: bool,
    /// The declared type of each parameter that is written as a plain type
    /// name, `self` included: a method call on one reaches that type's method
    /// (#791), not every method of the same name.
    pub types: collections::BTreeMap[String, String],
    /// **The two ledgers by a method's name** (#727): neither changes while the
/// walk runs, so the index cannot go stale. Built by the caller, because a
/// struct holding views of values the caller owns is built where they are.
    pub own_methods: ref MethodIndex,
    pub library_methods: ref MethodIndex,
    /// **The `ref Bytes` parameters**, which a `.clone()` keeps (ADR-373 D1,
    /// D4): the clone is a count on the caller's owner, so the parameter takes
    /// the `Bytes` with its owner rather than a run of bytes to copy.
    pub cloned_keeps: collections::BTreeSet[String],
}

// The walk's state: what it found, and the names a `let` bound to what may be
// a parameter - `let s = name` and then `return s` hands `name` out. Per body
// and not per scope, so a shadowing `let` counts both, which can only keep
// more. `views` holds the names bound to a call's result that points into a
// parameter (#697): the parameter leaves only where that name does.
struct KeepsWalk {
    uses: Uses,
    aliases: collections::BTreeMap[String, collections::BTreeSet[String]],
    views: collections::BTreeMap[String, collections::BTreeSet[String]],
}

/// What `body` does with each of its function's parameters.
pub fn uses_in(body: ref Block, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger) -> Uses {
    let mut walk = KeepsWalk { uses: Uses { kept: collections::BTreeSet(), passed: [] }, aliases: collections::BTreeMap(), views: collections::BTreeMap() }
    keeps_block(body, interner, holes_of, context, own, library, walk)
    // **The value a body ends in leaves the call**, as a `return` does.
    if context.hands_back_its_last && body.stmts.len() > 0 {
        match body.stmts[body.stmts.len() - 1].node {
            Stmt::Expr(value) => hand_over(value, interner, holes_of, context, own, library, walk),
            else => {}
        }
    }
    return walk.uses
}

fn keeps_block(block: ref Block, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    for stmt in block.stmts {
        keeps_statement(stmt.node, interner, holes_of, context, own, library, walk)
    }
}

fn keeps_statement(stmt: ref Stmt, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    match stmt {
        // **An assignment keeps, whatever the target is**: `self.name = x`,
        // `row.total = x` and `xs[i] = x` all put the value somewhere this call
        // does not end.
        Stmt::Assign { value, .. } => hand_over(value, interner, holes_of, context, own, library, walk),
        Stmt::Return(value) => {
            if !context.returns_a_view {
                hand_over_maybe(value, interner, holes_of, context, own, library, walk)
            }
        }
        // **A `let` does not keep**: it binds a second name inside this body,
        // and what happens to that name decides.
        Stmt::Let { names, value, mutable, .. } => {
            let reached = reached_of(value, interner, context, own, library, walk, true)
            let viewed = keeps_viewed_of(value, interner, context, own, library, walk)
            // **A `let mut` changes what it binds**, so a parameter bound to
            // one is owned: a view cannot be changed (D40). A lent one stays
            // the reference the author wrote. A call's result that points into
            // a parameter is a value of its own, and changing it changes no
            // parameter.
            if mutable {
                for name in reached_of(value, interner, context, own, library, walk, false) {
                    if !context.lent.contains(name) {
                        walk.uses.kept.insert(name.clone())
                    }
                }
            }
            if reached.len() > 0 {
                for bound in names {
                    alias(interner.resolve(bound).clone(), reached, walk.aliases)
                }
            }
            if viewed.len() > 0 {
                for bound in names {
                    alias(interner.resolve(bound).clone(), viewed, walk.views)
                }
            }
        }
        else => {}
    }
    keeps_statement_parts(stmt, interner, holes_of, context, own, library, walk)
}

// Every expression of the statement, each classified where it stands, then
// the blocks it holds.
fn keeps_statement_parts(stmt: ref Stmt, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    match stmt {
        Stmt::Let { value, .. } => keeps_expression(value, interner, holes_of, context, own, library, walk),
        Stmt::Comptime { value, .. } => keeps_expression(value, interner, holes_of, context, own, library, walk),
        Stmt::Assign { target, value, .. } => {
            keeps_expression(target, interner, holes_of, context, own, library, walk)
            keeps_expression(value, interner, holes_of, context, own, library, walk)
        }
        Stmt::For { iter, .. } => keeps_expression(iter, interner, holes_of, context, own, library, walk),
        Stmt::While { cond, .. } => keeps_expression(cond, interner, holes_of, context, own, library, walk),
        Stmt::Return(value) => {
            let returned = value ?? return
            keeps_expression(returned, interner, holes_of, context, own, library, walk)
        }
        Stmt::Expr(value) => keeps_expression(value, interner, holes_of, context, own, library, walk),
        else => {}
    }
    match stmt {
        Stmt::For { body, .. } => keeps_block(body, interner, holes_of, context, own, library, walk),
        Stmt::While { body, .. } => keeps_block(body, interner, holes_of, context, own, library, walk),
        Stmt::Let { value, .. } => keeps_blocks_in(value, interner, holes_of, context, own, library, walk),
        Stmt::Comptime { value, .. } => keeps_blocks_in(value, interner, holes_of, context, own, library, walk),
        Stmt::Expr(value) => keeps_blocks_in(value, interner, holes_of, context, own, library, walk),
        Stmt::Assign { target, value, .. } => {
            keeps_blocks_in(target, interner, holes_of, context, own, library, walk)
            keeps_blocks_in(value, interner, holes_of, context, own, library, walk)
        }
        Stmt::Return(value) => {
            let returned = value ?? return
            keeps_blocks_in(returned, interner, holes_of, context, own, library, walk)
        }
        else => {}
    }
}

fn alias(name: String, reached: ref collections::BTreeSet[String], mut into: collections::BTreeMap[String, collections::BTreeSet[String]]) {
    let mut all: collections::BTreeSet[String] = collections::BTreeSet()
    if into.contains_key(name) {
        let before = into[name] ?? return
        all.extend(before.clone())
    }
    all.extend(reached.clone())
    into.insert(name, all)
}

fn hand_over_maybe(expr: ref Expr?, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    hand_over(expr ?? return, interner, holes_of, context, own, library, walk)
}

// This expression's value leaves the call, so every parameter it may be is
// kept. **So does every parameter a lambda handed out names** (Part I 5.4,
// #1034): `return fn(x) { f(x) + 1 }` runs `f` after the call has ended.
fn hand_over(expr: ref Expr, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    walk.uses.kept.extend(reached_of(expr, interner, context, own, library, walk, true))
    keep_lambda(expr, interner, holes_of, context, walk)
}

// The parameters a lambda that leaves the call names are kept (#1034).
fn keep_lambda(expr: ref Expr?, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, mut walk: KeepsWalk) {
    let part = expr ?? return
    for name in keeps_named_by_a_lambda(part, interner, holes_of, context, walk) {
        walk.uses.kept.insert(name)
    }
}

// **The parameters an expression's value may be**, through every way it can
// come out: an `if`'s two arms, each arm of a `match`, a block's last
// expression, a name a `let` bound to one, and a moving part of a parameter -
// `return answer.text` takes a piece out of `answer` (a field that copies
// takes nothing; `self` is `NK1131`'s). With `through_calls`, also every
// parameter a call's result points into (#697): `return tag(v)` hands `v`
// out inside the `Tag`.
fn reached_of(expr: ref Expr, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, walk: ref KeepsWalk, through_calls: bool) -> collections::BTreeSet[String] {
    let mut found: collections::BTreeSet[String] = collections::BTreeSet()
    match expr {
        Expr::MethodCall { receiver, .. } => {
            if keeps_text_as_is(expr, interner, context) {
                return reached_of(receiver, interner, context, own, library, walk, through_calls)
            }
        }
        Expr::If { then_branch, else_branch, .. } => {
            reached_by_last(then_branch, interner, context, own, library, walk, through_calls, found)
            let otherwise = else_branch ?? return found
            reached_by_last(otherwise, interner, context, own, library, walk, through_calls, found)
        }
        // **An arm that hands on what it binds hands on a part of the
        // parameter it takes apart** (ADR-views-3 D1): `let model = match asked
        // { Refuted(model) => model, .. }` binds a part of `asked`, before the
        // walk of the `match` aliases the arm's own names.
        Expr::Match { value, arms, .. } => {
            for arm in arms {
                found.extend(reached_of(arm.body, interner, context, own, library, walk, through_calls))
            }
            let subject = parameter_named(value, interner, context) ?? return found
            if !context.lent.contains(subject) && an_arm_hands_on_what_it_binds(arms, interner) {
                found.insert(subject)
            }
        }
        Expr::Block(block, _) => reached_by_last(block, interner, context, own, library, walk, through_calls, found),
        Expr::AsyncGroup(block, _, _) => reached_by_last(block, interner, context, own, library, walk, through_calls, found),
        Expr::Variable(ident, _) => {
            let name = interner.resolve(ident).clone()
            if context.parameters.contains(name) {
                found.insert(name.clone())
            }
            let aliased = walk.aliases[name] ?? return found
            found.extend(aliased.clone())
        }
        Expr::Field { base, name, .. } => {
            if through_calls {
                found.extend(keeps_viewed_of(base, interner, context, own, library, walk))
            }
            // **A field of a name bound to a part of a parameter is a part
            // of it too** (ADR-views-3 D1): `Refuted(model) => model.values`
            // moves out of the parameter the arm takes apart.
            let aliased = match base {
                Expr::Variable(ident, _) => walk.aliases[interner.resolve(ident)]?.clone() ?? collections::BTreeSet(),
                else => collections::BTreeSet(),
            }
            for one in aliased {
                if one != "self" && !a_field_that_copies(one, interner.resolve(name), context) {
                    found.insert(one.clone())
                }
            }
            let parameter = parameter_named(base, interner, context) ?? return found
            if parameter != "self" && !a_field_that_copies(parameter, interner.resolve(name), context) {
                found.insert(parameter)
            }
        }
        Expr::Call { func, args, .. } => {
            if through_calls {
                found.extend(through_a_view(func, args, interner, context, own, library, walk))
            }
        }
        else => {}
    }
    return found
}

fn reached_by_last(block: ref Block, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, walk: ref KeepsWalk, through_calls: bool, mut found: collections::BTreeSet[String]) {
    if block.stmts.len() == 0 {
        return
    }
    match block.stmts[block.stmts.len() - 1].node {
        Stmt::Expr(value) => {
            found.extend(reached_of(value, interner, context, own, library, walk, through_calls))
        }
        else => {}
    }
}

// **The parameters a value points into without being one** (#697): a call
// whose result points into an argument, a name bound to one, a field of
// either, and each way such a value comes out of an `if`, a `match` or a
// block. Such a value keeps those parameters only where it leaves itself.
fn keeps_viewed_of(expr: ref Expr, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, walk: ref KeepsWalk) -> collections::BTreeSet[String] {
    let mut found: collections::BTreeSet[String] = collections::BTreeSet()
    match expr {
        Expr::Call { func, args, .. } => {
            found.extend(through_a_view(func, args, interner, context, own, library, walk))
        }
        Expr::Variable(ident, _) => {
            let viewing = walk.views[interner.resolve(ident)] ?? return found
            found.extend(viewing.clone())
        }
        Expr::Field { base, .. } => return keeps_viewed_of(base, interner, context, own, library, walk),
        Expr::If { then_branch, else_branch, .. } => {
            viewed_by_last(then_branch, interner, context, own, library, walk, found)
            let otherwise = else_branch ?? return found
            viewed_by_last(otherwise, interner, context, own, library, walk, found)
        }
        Expr::Match { arms, .. } => {
            for arm in arms {
                found.extend(keeps_viewed_of(arm.body, interner, context, own, library, walk))
            }
        }
        Expr::Block(block, _) => viewed_by_last(block, interner, context, own, library, walk, found),
        Expr::AsyncGroup(block, _, _) => viewed_by_last(block, interner, context, own, library, walk, found),
        else => {}
    }
    return found
}

fn viewed_by_last(block: ref Block, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, walk: ref KeepsWalk, mut found: collections::BTreeSet[String]) {
    if block.stmts.len() == 0 {
        return
    }
    match block.stmts[block.stmts.len() - 1].node {
        Stmt::Expr(value) => {
            found.extend(keeps_viewed_of(value, interner, context, own, library, walk))
        }
        else => {}
    }
}

// The parameters a call's result may point into: what each argument in a
// position the callee's result points into reaches.
fn through_a_view(func: ref Expr, args: ref Vec[Expr], interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, walk: ref KeepsWalk) -> collections::BTreeSet[String] {
    let mut found: collections::BTreeSet[String] = collections::BTreeSet()
    let callee = resolved_callee(func, interner, own, library)
    for at in 0..<args.len() {
        if a_position_the_result_points_into(callee, at, own, library) {
            found.extend(reached_of(args[at], interner, context, own, library, walk, true))
        }
    }
    return found
}

// **Whether the callee's result points into its parameter at `at`**: the
// ledger's `ref(..)`, whole (`borrows`) or by path (`returns`, ADR-views-3 D10). A
// callee no ledger describes is not one: its arguments keep (D2).
fn a_position_the_result_points_into(callee: ref String?, at: i64, own: ref Ledger, library: ref Ledger) -> bool {
    let known = (callee ?? return false).clone()
    if own.functions.contains_key(known) {
        return points_into_at(own.functions[known] ?? return false, at)
    }
    return points_into_at(library.functions[known] ?? return false, at)
}

/// **Whether position `at` takes a `Bytes` with its owner** (ADR-373 D1, D4):
/// a `ref Bytes` parameter of a function or a method (`at` counts `self`), that the body keeps and
/// the result does not point into. It is lowered to `&Bytes`, so a clone is a
/// count, and each call hands over the `Bytes` it has, a mapping's at a count
/// and a run of bytes copied into one. A `ref Bytes` only read, or one the
/// result views, stays a run of bytes, which any caller lends as it is.
pub fn keeps_its_bytes(contract: ref FnContract, at: i64) -> bool {
    let signature = contract.signature ?? return false
    if at < 0 || at >= signature.params.len() {
        return false
    }
    let parameter = signature.params[at].0
    let is_bytes = match signature.params[at].1 {
        Ty::Named { name, args, view } => view && args.len() == 0 && name == "Bytes",
        else => false,
    }
    return is_bytes && contract.keeps.contains(parameter) && !points_into_at(contract, at)
}

fn points_into_at(contract: ref FnContract, at: i64) -> bool {
    let signature = contract.signature ?? return false
    if at >= signature.params.len() {
        return false
    }
    let parameter = signature.params[at].0
    if contract.borrows.contains(parameter) {
        return true
    }
    return contract.returns.contains(f"ref({parameter})") || contract.returns.contains(f"ref({parameter} |") || contract.returns.contains(f"| {parameter})") || contract.returns.contains(f"| {parameter} |")
}

// Every expression inside one, the holes of a literal included and the
// bodies of nested blocks not, each classified - the order and the reach of
// the walk every derived column shares.
fn keeps_expression(expr: ref Expr, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    classify(expr, interner, holes_of, context, own, library, walk)
    for hole in holes_of(expr) {
        keeps_expression(hole, interner, holes_of, context, own, library, walk)
    }
    match expr {
        Expr::Call { func, args, config, .. } => {
            keeps_expression(func, interner, holes_of, context, own, library, walk)
            // **A `??` the result points into lends its left side** (#891):
            // `shown(p ?? "none")` hands back a view of it, so it takes
            // nothing; its two sides are walked as they stand.
            let callee = resolved_callee(func, interner, own, library)
            for at in 0..<args.len() {
                let lent = match args[at] {
                    Expr::Coalesce { value, fallback, .. } => {
                        if a_position_the_result_points_into(callee, at, own, library) {
                            keeps_expression(value, interner, holes_of, context, own, library, walk)
                            keeps_expression(fallback, interner, holes_of, context, own, library, walk)
                            true
                        } else {
                            false
                        }
                    },
                    else => false,
                }
                if !lent {
                    keeps_expression(args[at], interner, holes_of, context, own, library, walk)
                }
            }
            for setting in config {
                keeps_expression(setting.value, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::MethodCall { receiver, args, config, .. } => {
            keeps_expression(receiver, interner, holes_of, context, own, library, walk)
            keeps_expressions(args, interner, holes_of, context, own, library, walk)
            for setting in config {
                keeps_expression(setting.value, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            keeps_expression(receiver, interner, holes_of, context, own, library, walk)
            keeps_expressions(args, interner, holes_of, context, own, library, walk)
            for setting in config {
                keeps_expression(setting.value, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::Binary { lhs, rhs, .. } => {
            keeps_expression(lhs, interner, holes_of, context, own, library, walk)
            keeps_expression(rhs, interner, holes_of, context, own, library, walk)
        }
        Expr::Unary { expr, .. } => keeps_expression(expr, interner, holes_of, context, own, library, walk),
        Expr::Try(inner, _) => keeps_expression(inner, interner, holes_of, context, own, library, walk),
        Expr::Async(inner, _, _) => keeps_expression(inner, interner, holes_of, context, own, library, walk),
        Expr::Throw(inner, _) => keeps_expression(inner, interner, holes_of, context, own, library, walk),
        Expr::Cast { expr, .. } => keeps_expression(expr, interner, holes_of, context, own, library, walk),
        Expr::Field { base, .. } => keeps_expression(base, interner, holes_of, context, own, library, walk),
        Expr::SafeField { base, .. } => keeps_expression(base, interner, holes_of, context, own, library, walk),
        Expr::Index { base, index, .. } => {
            keeps_expression(base, interner, holes_of, context, own, library, walk)
            keeps_expression(index, interner, holes_of, context, own, library, walk)
        }
        Expr::Range { start, end, .. } => {
            keeps_expression(start, interner, holes_of, context, own, library, walk)
            keeps_expression(end, interner, holes_of, context, own, library, walk)
        }
        Expr::Tuple(items, _) => keeps_expressions(items, interner, holes_of, context, own, library, walk),
        Expr::Coalesce { value, fallback, .. } => {
            keeps_expression(value, interner, holes_of, context, own, library, walk)
            keeps_expression(fallback, interner, holes_of, context, own, library, walk)
        }
        Expr::TryCatch { expr, .. } => keeps_expression(expr, interner, holes_of, context, own, library, walk),
        Expr::If { cond, .. } => keeps_expression(cond, interner, holes_of, context, own, library, walk),
        Expr::Match { value, arms, .. } => {
            keeps_expression(value, interner, holes_of, context, own, library, walk)
            for arm in arms {
                keeps_maybe(arm.guard, interner, holes_of, context, own, library, walk)
                keeps_expression(arm.body, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::StructLit { fields, .. } => {
            for field in fields {
                keeps_maybe(field.value, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::ListRepeat { value, count, .. } => {
            keeps_expression(value, interner, holes_of, context, own, library, walk)
            keeps_expression(count, interner, holes_of, context, own, library, walk)
        }
        Expr::ListLit { items, .. } => keeps_expressions(items, interner, holes_of, context, own, library, walk),
        Expr::With { base, fields, .. } => {
            keeps_expression(base, interner, holes_of, context, own, library, walk)
            for field in fields {
                keeps_maybe(field.value, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::Return(value, _) => keeps_maybe(value, interner, holes_of, context, own, library, walk),
        Expr::Select(arms, _) => {
            for arm in arms {
                keeps_expression(arm.value, interner, holes_of, context, own, library, walk)
            }
        }
        else => {}
    }
}

fn keeps_expressions(items: ref Vec[Expr], interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    for item in items {
        keeps_expression(item, interner, holes_of, context, own, library, walk)
    }
}

fn keeps_maybe(expr: ref Expr?, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    keeps_expression(expr ?? return, interner, holes_of, context, own, library, walk)
}

// Every block an expression holds, a lambda passed as an argument included: it
// runs during the call it is given to. A `spawn` is a detached context and is
// not walked here.
fn keeps_blocks_in(expr: ref Expr, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    match expr {
        Expr::Block(block, _) => keeps_block(block, interner, holes_of, context, own, library, walk),
        Expr::AsyncGroup(block, _, _) => keeps_block(block, interner, holes_of, context, own, library, walk),
        Expr::Unsafe(block, _) => keeps_block(block, interner, holes_of, context, own, library, walk),
        Expr::Overlap(block, _) => keeps_block(block, interner, holes_of, context, own, library, walk),
        Expr::Closure { body, .. } => keeps_block(body, interner, holes_of, context, own, library, walk),
        Expr::Call { func, args, config, .. } => {
            keeps_blocks_in(func, interner, holes_of, context, own, library, walk)
            for arg in args {
                keeps_blocks_in(arg, interner, holes_of, context, own, library, walk)
            }
            for setting in config {
                keeps_blocks_in(setting.value, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::MethodCall { receiver, args, config, .. } => {
            keeps_blocks_in(receiver, interner, holes_of, context, own, library, walk)
            for arg in args {
                keeps_blocks_in(arg, interner, holes_of, context, own, library, walk)
            }
            for setting in config {
                keeps_blocks_in(setting.value, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            keeps_blocks_in(receiver, interner, holes_of, context, own, library, walk)
            for arg in args {
                keeps_blocks_in(arg, interner, holes_of, context, own, library, walk)
            }
            for setting in config {
                keeps_blocks_in(setting.value, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::If { then_branch, else_branch, .. } => {
            keeps_block(then_branch, interner, holes_of, context, own, library, walk)
            keeps_block(else_branch ?? return, interner, holes_of, context, own, library, walk)
        }
        Expr::TryCatch { expr, handler, .. } => {
            keeps_blocks_in(expr, interner, holes_of, context, own, library, walk)
            keeps_block(handler, interner, holes_of, context, own, library, walk)
        }
        Expr::Match { arms, .. } => {
            for arm in arms {
                keeps_blocks_in(arm.body, interner, holes_of, context, own, library, walk)
            }
        }
        Expr::Select(arms, _) => {
            for arm in arms {
                keeps_block(arm.body, interner, holes_of, context, own, library, walk)
            }
        }
        else => {}
    }
}

// What one expression does with a parameter, where it stands. Called on every
// sub-expression, so each rule is about this node and never about what is
// under it.
fn classify(expr: ref Expr, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    match expr {
        // **A struct literal keeps every field it is given**: the struct
        // outlives the call wherever it goes. `P { x }` is the field and the
        // name in one, and the name may be a parameter. **A text parameter
        // the tiers lent is not kept by moving it in** (Part I 6.5, ADR-views-3
        // D8, #945): the field it goes into is a view of it, and a result
        // built from the literal points into it (`returns`).
        Expr::StructLit { fields, .. } => {
            for field in fields {
                if field.value == null {
                    let named = interner.resolve(field.name).clone()
                    keep_viewed_name(named, walk)
                    if context.parameters.contains(named) && !keeps_a_lent_text(named, context) {
                        walk.uses.kept.insert(named)
                    }
                } else {
                    let value = field.value ?? continue
                    let lent = parameter_named(value, interner, context)
                    if lent == null || !keeps_a_lent_text(lent ?? "", context) {
                        keep_part(field.value, interner, context, own, library, walk)
                    }
                    keep_lambda(field.value, interner, holes_of, context, walk)
                }
            }
        }
        // **So does a list or a tuple literal every element it is given**
        // (ADR-297 D13): `[h]` builds a list that holds `h`.
        Expr::ListLit { items, .. } => {
            for item in items {
                keep_part(item, interner, context, own, library, walk)
                keep_lambda(item, interner, holes_of, context, walk)
            }
        }
        Expr::Tuple(items, _) => {
            for item in items {
                keep_part(item, interner, context, own, library, walk)
                keep_lambda(item, interner, holes_of, context, walk)
            }
        }
        // `[x; n]` holds `x` as many times as it says.
        Expr::ListRepeat { value, .. } => keep_part(value, interner, context, own, library, walk),
        // **Three shapes the lowering consumes**: `a ?? b` is
        // `unwrap_or_else`, `x?.f` takes the value it reaches through, and `x?`
        // unwraps one - each moves the value in the language below. **A
        // moving part on the left of `??` keeps its parameter too** (#891):
        // `p.0 ?? ".."` and `s.name ?? ".."` move the option out of it, as a
        // part handed back does.
        Expr::Coalesce { value, .. } => keep_part(value, interner, context, own, library, walk),
        Expr::SafeField { base, .. } => keep_named(base, interner, context, own, library, walk),
        Expr::Try(value, _) => keep_named(value, interner, context, own, library, walk),
        Expr::Async(value, _, _) => keep_named(value, interner, context, own, library, walk),
        // **`p with { .. }` builds a value out of the whole of `p`** (Part I
        // 4.1): `..p` moves it below, so `p` stays a value
        // (`defects_found_running::a_with_over_a_by_value_parameter_runs`). A field the literal names is a part like any other.
        Expr::With { base, fields, .. } => {
            keep_named(base, interner, context, own, library, walk)
            for field in fields {
                if field.value != null {
                    keep_part(field.value, interner, context, own, library, walk)
                }
            }
        }
        // **A parameter a `match` takes apart stays lent** (ADR-views-3 D1):
        // Rust matches through the reference with its default binding modes,
        // so an arm that only reads what it binds keeps nothing. **A name an
        // arm binds is a part of the parameter**, as a `let` of one is
        // (#665): handed to what keeps it, returned or bound `mut`, it keeps
        // the parameter. A parameter the author lent is a reference whatever
        // this column says, so it is not this arm's (issue #173).
        // **A moving part of one an arm hands on keeps it too** (#1092), as
        // `p.node ?? ..` does: `match a.node { x => x }` moves the field out.
        Expr::Match { value, arms, .. } => {
            if parameter_named(value, interner, context) == null {
                if part_of_a_parameter(value, interner, context) != null && an_arm_hands_on_what_it_binds(arms, interner) {
                    keep_part(value, interner, context, own, library, walk)
                }
                return
            }
            let name = parameter_named(value, interner, context) ?? return
            if context.lent.contains(name) {
                return
            }
            let mut whole: collections::BTreeSet[String] = collections::BTreeSet()
            whole.insert(name)
            for arm in arms {
                let mut bound: collections::BTreeSet[String] = collections::BTreeSet()
                names_a_pattern_binds(arm.pattern, interner, bound)
                for one in bound {
                    alias(one.clone(), whole, walk.aliases)
                }
            }
        }
        // **A task keeps everything it names** (ADR-312 D1).
        Expr::Spawn { body, .. } => keep_what_a_task_names(body, interner, holes_of, context, walk),
        Expr::Call { func, args, config, .. } => {
            let callee = resolved_callee(func, interner, own, library)
            // **An argument the callee's result points into leaves with the
            // result** (#697): `reached_of` and `keeps_viewed_of` follow it there.
            for at in 0..<args.len() {
                if !a_position_the_result_points_into(callee, at, own, library) {
                    keep_argument(args[at], callee, at, interner, holes_of, context, own, library, walk)
                }
            }
            for setting in config {
                keep_option(setting, callee, interner, context, own, library, walk)
            }
        }
        Expr::MethodCall { receiver, method, args, config, .. } => {
            keep_receiver(receiver, interner.resolve(method), interner, context, own, library, walk)
            keep_method_arguments(receiver, args, interner.resolve(method), interner, holes_of, context, own, library, walk)
            keep_method_options(config, interner, context, own, library, walk)
        }
        Expr::SafeMethod { receiver, method, args, config, .. } => {
            keep_receiver(receiver, interner.resolve(method), interner, context, own, library, walk)
            keep_method_arguments(receiver, args, interner.resolve(method), interner, holes_of, context, own, library, walk)
            keep_method_options(config, interner, context, own, library, walk)
        }
        else => {}
    }
}

// Recorded rather than decided where the callee is known: whether it keeps is
// the callee's answer, which the fixpoint waits for. A callee no ledger
// describes keeps (D2's fail-closed case).
fn keep_argument(arg: ref Expr, callee: ref String?, at: i64, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    let known = (callee ?? "").clone()
    let mut handed = keeps_handed(arg, interner, context, own, library, walk)
    handed.extend(keeps_named_by_a_lambda(arg, interner, holes_of, context, walk))
    for parameter in handed {
        if callee == null {
            walk.uses.kept.insert(parameter.clone())
        } else {
            walk.uses.passed.push(Passed { parameter: parameter.clone(), callee: known.clone(), at: at })
        }
    }
}

// **A parameter handed to an option** is handed to the callee's option of that
// name: at the position after the callee's parameters that the option has
// among its options, as `parameter_at` counts them. A callee no ledger
// describes, or an option it does not have, keeps.
fn keep_option(setting: ref ConfigArg, callee: ref String?, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    let names = keeps_handed(setting.value, interner, context, own, library, walk)
    if names.len() == 0 {
        return
    }
    let known = (callee ?? "").clone()
    let mut at: i64? = null
    if own.functions.contains_key(known) {
        at = option_at(own.functions[known] ?? return, interner.resolve(setting.name))
    } else if library.functions.contains_key(known) {
        at = option_at(library.functions[known] ?? return, interner.resolve(setting.name))
    }
    for parameter in names {
        if at == null {
            walk.uses.kept.insert(parameter.clone())
        } else {
            walk.uses.passed.push(Passed { parameter: parameter.clone(), callee: known.clone(), at: at ?? 0 })
        }
    }
}

// **A parameter handed to a method's option keeps**: which entry the call goes
// to is the type checker's answer (ADR-288), and an option is matched by name
// in that entry, which this walk cannot see.
fn keep_method_options(config: ref Vec[ConfigArg], interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    for setting in config {
        walk.uses.kept.extend(keeps_handed(setting.value, interner, context, own, library, walk))
    }
}

// **A receiver a method takes by value is moved out of.** Which entry the
// call goes to is the type checker's answer (ADR-288); the weaker question
// this walk can ask is whether any entry the bare name could reach takes it
// whole - and where a method call of this body went to an entry no ledger has,
// the candidates are not the whole list and may not be believed. A method that
// changes its subject needs a `&mut` this compiler does not write (D3), and a
// receiver taken by value that copies is not moved out of (issue #173).
//
// A name bound to a call's result that points into a parameter (#697) is
// asked the same, for the parameters it points into: a method that takes it
// whole may hand it on.
fn keep_receiver(receiver: ref Expr, method: ref String, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    let mut names: Vec[String] = []
    match receiver {
        Expr::Variable(ident, _) => {
            if method == "clone" && context.cloned_keeps.contains(interner.resolve(ident)) {
                walk.uses.kept.insert(interner.resolve(ident).clone())
            }
            if context.parameters.contains(interner.resolve(ident)) {
                names.push(interner.resolve(ident).clone())
            }
            for one in keeps_viewed_of(receiver, interner, context, own, library, walk) {
                names.push(one)
            }
        }
        Expr::Field { .. } => {
            // **A field of a parameter a method takes whole moves out of the
            // parameter** (`b.xs.drain()`): the parameter is kept, or it is
            // lowered as a `&B` whose field the body cannot give away. Only
            // where an entry is known to take its receiver: a field's type is
            // not asked here, so no answer is not read as a move.
            let root = keeps_field_root(receiver, interner, context) ?? return
            let ours = receiver_taken_in(own, context.own_methods, method, null)
            let theirs = receiver_taken_in(library, context.library_methods, method, null)
            if ours.hit || theirs.hit {
                walk.uses.kept.insert(root)
            }
            return
        }
        else => {}
    }
    if names.len() == 0 {
        return
    }
    let owner = keeps_owner_of(receiver, method, interner, context, own, library)
    let ours = receiver_taken_in(own, context.own_methods, method, owner)
    let theirs = receiver_taken_in(library, context.library_methods, method, owner)
    // **`.clone()` reads its receiver and makes a copy** (Part I 2.3;
    // ADR-views-3 D8, D12, #1243): its result reaches nothing of the
    // receiver, so a body whose calls did not resolve (`x.clone()` of a `T`)
    // or a call no entry describes is no reason to count it moved. An entry
    // that does take its receiver by value still says so.
    let fails_closed = method != "clone" && (context.unresolved || (!ours.any && !theirs.any))
    if fails_closed || ours.hit || theirs.hit {
        walk.uses.kept.extend(names.clone())
    }
}

/// The parameter a chain of fields `p.a.b` starts at, or `null`.
fn keeps_field_root(expr: ref Expr, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody) -> String? {
    match expr {
        Expr::Field { base, .. } => return keeps_field_root(base, interner, context),
        Expr::Variable(ident, _) => {
            if context.parameters.contains(interner.resolve(ident)) {
                return interner.resolve(ident).clone()
            }
            return null
        }
        else => return null,
    }
}

fn takes_its_receiver(contract: ref FnContract) -> bool {
    if contract.mutates {
        return true
    }
    let signature = contract.signature ?? return true
    if !signature.takes_a_receiver() {
        return true
    }
    let subject = signature.params[0].1
    if subject.is_a_view() {
        return false
    }
    return match subject {
        Ty::Named { .. } => moves(subject),
        else => true,
    }
}

// An argument kept where any entry the bare method name could reach keeps
// its position - one further along than its own, the receiver being the
// callee's first parameter. **A candidate of this package is asked through
// the fixpoint**, as a free call is: its `keeps` column is what the fixpoint
// is still filling, and read now it said *keeps nothing* for every method of
// the package - `walk.slots.force(…, fallback)` lent a `fallback` that
// `Slots::force` stores (found moving `sharing`'s walk into Nikaia, #125).
// A library's candidates answer from their ledger, and no candidate at all
// keeps (D2).
fn keep_method_arguments(receiver: ref Expr, args: ref Vec[Expr], method: ref String, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    let owner = keeps_owner_of(receiver, method, interner, context, own, library)
    let ours = candidate_keys(own, context.own_methods, method, owner, args.len())
    for k in 0..<args.len() {
        let theirs = keeps_at_in(library, context.library_methods, method, k + 1, owner)
        let mut handed = keeps_handed(args[k], interner, context, own, library, walk)
        handed.extend(keeps_named_by_a_lambda(args[k], interner, holes_of, context, walk))
        for name in handed {
            for key in ours {
                walk.uses.passed.push(Passed { parameter: name.clone(), callee: key.clone(), at: k + 1 })
            }
            if theirs.hit || (ours.len() == 0 && !theirs.any) {
                walk.uses.kept.insert(name.clone())
            }
        }
    }
}

// The keys of a ledger's candidates for a bare method name.
fn candidate_keys(ledger: ref Ledger, methods: ref MethodIndex, method: ref String, owner: ref String?, given: i64) -> Vec[String] {
    let mut keys: Vec[String] = []
    for key in method_keys_of(methods, method, owner) {
        let contract = ledger.functions[key] ?? continue
        if takes_self(contract) && has_position(contract, given) {
            keys.push(key.clone())
        }
    }
    return keys
}

// What the candidates of one ledger answer: whether there are any, and
// whether one of them says yes.
struct CandidatesSay {
    any: bool,
    hit: bool,
}

fn receiver_taken_in(ledger: ref Ledger, methods: ref MethodIndex, method: ref String, owner: ref String?) -> CandidatesSay {
    let mut asked = CandidatesSay { any: false, hit: false }
    for key in method_keys_of(methods, method, owner) {
        let contract = ledger.functions[key] ?? continue
        if takes_self(contract) {
            asked.any = true
            asked.hit = asked.hit || takes_its_receiver(contract)
        }
    }
    return asked
}

// **A candidate with no parameter at `at` is not one this call reaches**: it
// takes fewer arguments than the call gives, so `m.get(key)` is not
// `Locked::get(self)`, and that entry's silence about `key` is not a keep.
fn keeps_at_in(ledger: ref Ledger, methods: ref MethodIndex, method: ref String, at: i64, owner: ref String?) -> CandidatesSay {
    let mut asked = CandidatesSay { any: false, hit: false }
    for key in method_keys_of(methods, method, owner) {
        let contract = ledger.functions[key] ?? continue
        if takes_self(contract) && has_position(contract, at) {
            asked.any = true
            asked.hit = asked.hit || keeps_at(contract, at)
        }
    }
    return asked
}

// **The type a method call is made on** (#791): the declared type of a
// receiver that is a parameter, when one of the ledgers has that type's method
// of this name. Then `at.quoted(f)` is `GrCursor::quoted`, and another type's
// `quoted` is not a candidate. Any other receiver is asked by the bare name.
fn keeps_owner_of(receiver: ref Expr, method: ref String, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger) -> String? {
    match receiver {
        Expr::Variable(ident, _) => {
            let written = context.types[interner.resolve(ident)] ?? return null
            let declared = keeps_ledger_owner(written)
            let key = f"{declared}::{method}"
            if own.functions.contains_key(key) || library.functions.contains_key(key) {
                return declared
            }
            return null
        }
        else => return null,
    }
}

// **Text's methods are the ledger's `str::`** (#882): a `String` receiver's
// `find` is `str::find`, which lends, and not `Seq::find`, which takes its
// sequence whole.
fn keeps_ledger_owner(written: ref String) -> String {
    if written == "String" {
        return "str"
    }
    return written.clone()
}

// The keys of a bare method name, narrowed to one type's method when the
// receiver's type is known.
fn method_keys_of(methods: ref MethodIndex, method: ref String, owner: ref String?) -> Vec[String] {
    let keys = method_keys(methods, method)
    let named = owner ?? return keys
    let wanted = f"{named}::{method}"
    let mut out: Vec[String] = []
    for key in keys {
        if key == wanted || key.ends_with(ref f"::{wanted}") {
            out.push(key.clone())
        }
    }
    return out
}

// Whether a candidate's signature has a parameter at `at`; one without a
// signature may have, so it stays a candidate.
fn has_position(contract: ref FnContract, at: i64) -> bool {
    let signature = contract.signature ?? return true
    return at < signature.params.len()
}

// **Every entry a bare method name could resolve to**: one whose key ends in
// `::method` and that takes `self` - an entry that takes no `self` is a
// function a call names by its path, and `x.lines()` never reaches
// `io::lines()`. An entry with no signature is still a candidate.
fn takes_self(contract: ref FnContract) -> bool {
    let signature = contract.signature ?? return true
    return signature.takes_a_receiver()
}

// A task keeps every parameter it names; a body this walk cannot read to the
// bottom - another `spawn` inside it, or a shape it does not read - keeps them
// all, the answer that cannot be wrong.
fn keep_what_a_task_names(body: ref Expr, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, mut walk: KeepsWalk) {
    let seen = match body {
        Expr::Closure { body, .. } => seen_in(body, interner, name_as_it_is, holes_of, no_root, true),
        Expr::Block(block, _) => seen_in(block, interner, name_as_it_is, holes_of, no_root, true),
        Expr::AsyncGroup(block, _, _) => seen_in(block, interner, name_as_it_is, holes_of, no_root, true),
        else => {
            walk.uses.kept.extend(context.parameters.clone())
            return
        }
    }
    for one in seen {
        match one {
            Seen::Spawn { .. } => {
                walk.uses.kept.extend(context.parameters.clone())
                return
            }
            else => {}
        }
    }
    for one in seen {
        match one {
            Seen::Name(name) => {
                keep_if_a_parameter(name, context, walk.uses)
                keep_viewed_name(name, walk)
            }
            else => {}
        }
    }
}

// **A lambda handed to a call takes along every parameter it names** (#1025):
// where the callee keeps that position the lambda outlives the call, as a
// task does (ADR-312 D1), so its parameters are handed to the callee's
// column like a bare argument; where the callee does not keep it, the body
// runs during the call and the fixpoint leaves them lent. Not a lambda:
// nothing. A body with a `spawn` inside names them all, as for a task.
fn keeps_named_by_a_lambda(arg: ref Expr, interner: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, context: ref KeepsBody, walk: ref KeepsWalk) -> Vec[String] {
    let seen = match arg {
        Expr::Closure { body, .. } => seen_in(body, interner, name_as_it_is, holes_of, no_root, true),
        else => return [],
    }
    let mut names: Vec[String] = []
    for one in seen {
        match one {
            Seen::Spawn { .. } => return context.parameters.iter().map(fn(p) { p.clone() }).collect(),
            Seen::Name(name) => {
                if context.parameters.contains(name) {
                    names.push(name.clone())
                }
                let viewing = walk.views[name] ?? continue
                for viewed in viewing {
                    names.push(viewed.clone())
                }
            }
            else => {}
        }
    }
    return names
}

fn keep_if_a_parameter(name: ref String, context: ref KeepsBody, mut uses: Uses) {
    if context.parameters.contains(name) {
        uses.kept.insert(name.clone())
    }
}

// The parameter a consuming shape takes, and what a value it takes points
// into (#697): `a ?? b` hands `a` on, and where it goes this walk does not
// follow.
fn keep_named(expr: ref Expr, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    walk.uses.kept.extend(keeps_viewed_of(expr, interner, context, own, library, walk))
    walk.uses.kept.insert(parameter_named(expr, interner, context) ?? return)
}

// **`to_string()` of a `String` parameter is the parameter as it is**
// (ADR-282 D8, #896): where it goes, the parameter goes.
fn keeps_text_as_is(expr: ref Expr, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody) -> bool {
    match expr {
        Expr::MethodCall { receiver, method, args, .. } => {
            if args.len() > 0 || interner.resolve(method) != "to_string" {
                return false
            }
            match receiver {
                Expr::Variable(ident, _) => {
                    let ty = context.types[interner.resolve(ident)] ?? return false
                    return ty == "String"
                }
                else => return false,
            }
        }
        else => return false,
    }
}

fn keep_part(expr: ref Expr?, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, mut walk: KeepsWalk) {
    let part = expr ?? return
    walk.uses.kept.extend(keeps_handed(part, interner, context, own, library, walk))
}

// **A `String` parameter that is a view below** - lent by the tiers or
// written `ref` - and not the receiver: moved into a struct literal, the field
// views it (ADR-views-3 D9).
fn keeps_a_lent_text(name: ref String, context: ref KeepsBody) -> bool {
    if name == "self" || !context.lent.contains(name) {
        return false
    }
    let ty = context.types[name] ?? return false
    return ty == "String"
}

// What a name bound to a call's result points into leaves where the name
// does (#697).
fn keep_viewed_name(name: ref String, mut walk: KeepsWalk) {
    let viewing = (walk.views[name] ?? return).clone()
    walk.uses.kept.extend(viewing.clone())
}

// **The parameters a value handed somewhere takes with it**: the parameter it
// is or is a moving part of, and every parameter it points into (#697).
fn keeps_handed(expr: ref Expr, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody, own: ref Ledger, library: ref Ledger, walk: ref KeepsWalk) -> Vec[String] {
    match expr {
        Expr::MethodCall { receiver, .. } => {
            if keeps_text_as_is(expr, interner, context) {
                return keeps_handed(receiver, interner, context, own, library, walk)
            }
        }
        else => {}
    }
    let mut names: Vec[String] = []
    let part = part_of_a_parameter(expr, interner, context)
    if part != null {
        names.push(part ?? "")
    }
    for one in keeps_viewed_of(expr, interner, context, own, library, walk) {
        names.push(one)
    }
    // **The fallback of a `??` is handed on as it stands** (ADR-views-3 D1):
    // `store(first ?? other)` gives the callee `other` where `first` is null,
    // so what keeps the result keeps `other`.
    match expr {
        Expr::Coalesce { fallback, .. } => names.extend(keeps_handed(fallback, interner, context, own, library, walk)),
        else => {}
    }
    // **A name a `let` moved a part of a parameter into is that part** (#665):
    // handed to what keeps it, it keeps the parameter.
    match expr {
        Expr::Variable(ident, _) => {
            let moved = walk.aliases[interner.resolve(ident)] ?? return names
            for one in moved {
                names.push(one.clone())
            }
        }
        else => {}
    }
    return names
}

// The parameter this expression **is**: a bare name and nothing else.
fn parameter_named(expr: ref Expr, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody) -> String? {
    return match expr {
        Expr::Variable(ident, _) => match context.parameters.contains(interner.resolve(ident)) {
            true => interner.resolve(ident).clone(),
            false => null,
        },
        else => null,
    }
}

// **The parameter an expression is, or is a moving part of** (ADR-293 D32):
// a part handed to what keeps it keeps the whole, a field that copies takes
// nothing, a deeper part keeps, and `self` is `NK1131`'s.
fn part_of_a_parameter(expr: ref Expr, interner: ref winnow_grammar::InternerContext, context: ref KeepsBody) -> String? {
    match expr {
        Expr::Field { base, name, .. } => {
            if parameter_named(base, interner, context) == null {
                let deeper = part_of_a_parameter(base, interner, context) ?? return null
                return not_self(deeper)
            }
            let parameter = parameter_named(base, interner, context) ?? return null
            if a_field_that_copies(parameter, interner.resolve(name), context) {
                return null
            }
            return not_self(parameter)
        }
        else => {
            return parameter_named(expr, interner, context)
        }
    }
}

fn not_self(name: String) -> String? {
    if name == "self" {
        return null
    }
    return name
}

fn a_field_that_copies(parameter: ref String, field: ref String, context: ref KeepsBody) -> bool {
    let fields = context.fields[parameter] ?? return false
    let ty = fields[field] ?? return false
    return !moves(ty)
}

// The ledger key a plain call's callee resolves to, where a ledger names it.
fn resolved_callee(func: ref Expr, interner: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger) -> String? {
    let written = match func {
        Expr::Variable(ident, _) => interner.resolve(ident).clone(),
        Expr::Path(segments, _) => written_path(interner, segments),
        else => return null,
    }
    if own.functions.contains_key(written) || library.functions.contains_key(written) {
        return written
    }
    return null
}

fn name_as_it_is(name: ref String) -> String sync {
    return name.clone()
}

/// **An arm that hands on a part it binds** (#1092): its value is a name
/// its pattern binds, or a field of one.
fn an_arm_hands_on_what_it_binds(arms: ref Vec[MatchArm], interner: ref winnow_grammar::InternerContext) -> bool {
    for arm in arms {
        let mut bound: collections::BTreeSet[String] = collections::BTreeSet()
        names_a_pattern_binds(arm.pattern, interner, bound)
        if !bound.is_empty() && hands_on_a_bound_name(arm.body, interner, bound) {
            return true
        }
    }
    return false
}

/// The names a pattern binds: a lone name no capital begins, and those inside the
/// parts of a variant, a tuple, a list or an alternative.
fn names_a_pattern_binds(pattern: ref MatchPattern, interner: ref winnow_grammar::InternerContext, mut bound: collections::BTreeSet[String]) {
    match pattern {
        MatchPattern::Path(segments) => {
            if segments.len() == 1 {
                let name = interner.resolve(segments[0])
                if !names_a_type(name) {
                    bound.insert(name.clone())
                }
            }
        },
        MatchPattern::Tuple { parts, .. } => {
            for part in parts {
                names_a_pattern_binds(part, interner, bound)
            }
        },
        MatchPattern::List(parts) => {
            for part in parts {
                names_a_pattern_binds(part, interner, bound)
            }
        },
        MatchPattern::Named { fields, .. } => {
            for field in fields {
                names_a_pattern_binds(field.pat, interner, bound)
            }
        },
        MatchPattern::RestNamed(name) => {
            bound.insert(interner.resolve(name).clone())
        },
        MatchPattern::Or(alternatives) => {
            for part in alternatives {
                names_a_pattern_binds(part, interner, bound)
            }
        },
        else => {},
    }
}

/// Whether a value is a bound name, a field of one, or a branch or a
/// `return` that ends in one.
fn hands_on_a_bound_name(value: ref Expr, interner: ref winnow_grammar::InternerContext, bound: ref collections::BTreeSet[String]) -> bool {
    return match value {
        Expr::Variable(ident, _) => bound.contains(interner.resolve(ident)),
        Expr::Field { base, .. } => hands_on_a_bound_name(base, interner, bound),
        Expr::Return(held, _) => match held {
            null => false,
            one => hands_on_a_bound_name(one, interner, bound),
        },
        Expr::Block(block, _) => hands_on_a_bound_tail(block, interner, bound),
        Expr::AsyncGroup(block, _, _) => hands_on_a_bound_tail(block, interner, bound),
        Expr::If { then_branch, else_branch, .. } => hands_on_a_bound_tail(then_branch, interner, bound) || match else_branch {
            null => false,
            other => hands_on_a_bound_tail(other, interner, bound),
        },
        else => false,
    }
}

fn hands_on_a_bound_tail(block: ref Block, interner: ref winnow_grammar::InternerContext, bound: ref collections::BTreeSet[String]) -> bool {
    for tail in block_tail(block) {
        if hands_on_a_bound_name(tail, interner, bound) {
            return true
        }
    }
    return false
}

// **Which parameters a body keeps, for a whole package** (ADR-094 D2, ADR-277
// D17): each function's own evidence from the walk above, the edges between a
// trait's methods and its impls, and then the least fixpoint (`kept_by`).

/// What the compiler does for the walk: the holes of a literal are read from
/// a unit's source, and the statement that keeps a parameter is cut out of a
/// method's body, which needs the unit's tokens.
pub trait KeepsHost {
    fn holes(ref self, unit: i64, expr: ref Expr) -> Vec[Expr] sync
    fn keeping_statement(ref self, unit: i64, method: ref Spanned[Item], target: String, parameter: String, own_kept: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger, library: ref Ledger) -> Span sync
}

/// **What the impls of trait methods keep on their own evidence** (ADR-277
/// D17), for the build to say.
pub struct KeepsColumn {
    /// The impls of another package's trait that keep more than its column
    /// (`NK1264`), each with the index of its unit among those inferred.
    pub beyond: Vec[(i64, CheckFinding)],
    /// **Every trait method of this package**, with the impls that keep each
    /// parameter (named as the trait method names it): what `NK1265` and a
    /// refused lending caller name. A trait method with no keeping impl is
    /// here with nothing under it.
    pub keepers: collections::BTreeMap[String, collections::BTreeMap[String, Vec[KeepsKeeper]]],
}

/// An impl that keeps a trait method's parameter, and the statement that
/// keeps it.
pub struct KeepsKeeper {
    /// The impl method's ledger name (`Keep::take`).
    pub name: String,
    /// Its unit's index among those inferred.
    pub unit: i64,
    pub span: Span,
}

/// One method of an `impl Trait for Target`, as the walk met it.
pub struct KeepsImplRow {
    pub unit: i64,
    pub method: ref Spanned[Item],
    pub target: String,
    pub key: String,
    pub trait_name: String,
    pub at_trait: String,
    pub first: i64,
}

/// **The two ledgers by a method's name** (#727): neither changes while the
/// walk runs, so the index cannot go stale. Built by the caller, because a
/// struct holding views of values the caller owns is built where they are.
pub struct KeepsIndexes {
    pub own: ref MethodIndex,
    pub library: ref MethodIndex,
}

/// One function's key in the ledger, and what its body does with each
/// parameter.
pub struct KeepsFound {
    pub key: String,
    pub uses: Uses,
}

/// A parameter taken by value: neither written `ref` nor `mut`.
fn by_value(arg: ref FnArg) -> bool {
    return !arg.ty.is_view && !arg.mutable
}

/// **A number, a `bool`, a `char` or a `scalar`**, or such a value that may
/// be `null`: copied wherever it goes, so keeping one keeps no caller's value
/// (#1213). A type with a handle inside (`Shared`) is not one, though it copies.
fn keeps_a_copied_scalar(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, args, view } => !view && args.is_empty() && KEEPS_SCALARS.iter().any(fn(one) { one == name }),
        Ty::Nullable(inner) => keeps_a_copied_scalar(inner),
        else => false,
    }
}

comptime KEEPS_SCALARS: Array[ref String, 15] = ["i8", "i16", "i32", "i64", "isize", "usize", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "char", "scalar"]

fn no_uses() -> Uses {
    return Uses { kept: collections::BTreeSet(), passed: [] }
}

/// Give every function in the ledger the `keeps` its body earns.
///
/// A **least** fixpoint, where `sync`'s is a greatest one, and the difference
/// is which direction is safe: `sync` is a promise and is taken away on doubt,
/// `keeps` is a restriction and is added on doubt. So this starts from
/// *nothing is kept* and adds until nothing changes, and two functions that
/// pass each other a parameter neither stores keep neither.
///
/// The iteration walks `BTreeMap`s and repeats until nothing changes, so the
/// answer does not depend on the order the source declared things in - which
/// it must not, because Part III 13.5 makes this file a pure function of
/// (source, toolchain) and `--locked` compares it byte for byte.
pub fn keeps_infer[H: KeepsHost](mut ledger: Ledger, units: ref Vec[ParsedView], library: ref Ledger, resolved: ref collections::BTreeMap[String, CheckMethodCalls], indexes: KeepsIndexes, host: ref H) -> KeepsColumn {
    let mut graph: collections::BTreeMap[String, Uses] = collections::BTreeMap()
    // What the package's declarations say about the types a parse hands back,
    // read once for the grammar arm below.
    let mut package = PackageTypes::empty()
    for view in units {
        declare_unit(view.words, view.items, package)
    }
    // **An `impl`'s method keeps what its trait's method keeps**, by position
    // (ADR-277 D11), keyed by the trait method's ledger name. For a by-value
    // **data** parameter the trait's column is still the seed *by value means
    // kept* (#1012 step 3 computes it), but for one the result's `from` names,
    // which is lent (#1230); a `fn` parameter's is computed in the
    // fixpoint below (D17). Read once, from every unit, before the walk: the
    // trait may be declared after its `impl`.
    let mut trait_keeps: collections::BTreeMap[String, Vec[i64]] = collections::BTreeMap()
    for view in units {
        for item in view.items {
            match item.node {
                Item::Trait { name, methods, .. } => {
                    let owner = view.text(name)
                    for method in methods {
                        let positions: Vec[i64] = method.node.args.iter().enumerate().filter(fn((at, arg)) { by_value(arg) && arg.ty.code == null && !method.node.ret_from.contains(arg.name) && !keeps_a_copied_scalar(written_ty(view.words, view.aliases, arg.ty)) }).map(fn((at, arg)) { at }).collect()
                        let called = view.text(method.node.name)
                        trait_keeps.insert(f"{owner}::{called}", positions)
                    }
                },
                else => {},
            }
        }
    }
    // **The impls of each trait method of this package** (ADR-277 D17), by
    // the trait method's ledger name: the edges *the trait keeps what an impl
    // keeps* are added once every impl has been seen.
    let mut impls_of: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    // **Every impl of a trait method**, with its unit, for `NK1264` below:
    // which of them answer a trait of another package is known only once
    // every unit's traits are in the graph.
    let mut impl_rows: Vec[KeepsImplRow] = []
    let mut unit = 0
    for view in units {
        for item in view.items {
            match item.node {
                Item::Fn { .. } => {
                    let found = keeps_uses_of(view, item.node, null, ledger, library, indexes, resolved, fn(e) { host.holes(unit, e) }) ?? continue
                    graph.insert(found.key.clone(), found.uses)
                },
                Item::Impl { trait_name, target, methods } => {
                    let target_name = view.text(target.name)
                    let owner = match trait_name {
                        null => "",
                        t => view.text(t),
                    }
                    for method in methods {
                        let mut found = keeps_uses_of(view, method.node, target_name.clone(), ledger, library, indexes, resolved, fn(e) { host.holes(unit, e) }) ?? continue
                        if trait_name != null {
                            match method.node {
                                Item::Fn { name, receiver, args, .. } => {
                                    let own = view.text(name ?? continue)
                                    let at_trait = f"{owner}::{own}"
                                    for at in trait_positions(trait_keeps, at_trait) {
                                        if at < args.len() {
                                            found.uses.kept.insert(view.text(args[at].name))
                                        }
                                    }
                                    // **An impl keeps what its trait method keeps**
                                    // (D17, D11): a `fn` parameter is handed to the
                                    // trait method's node, in the loop rather than
                                    // before it. A trait of another package answers
                                    // from its ledger (`keeps_its`).
                                    let first = if receiver != null { 1 } else { 0 }
                                    let mut at = 0
                                    for arg in args {
                                        if by_value(arg) && arg.ty.code != null {
                                            found.uses.passed.push(Passed { parameter: view.text(arg.name), callee: at_trait.clone(), at: at + first })
                                        }
                                        at += 1
                                    }
                                    add_impl(impls_of, at_trait, found.key)
                                    impl_rows.push(KeepsImplRow { unit: unit, method: method, target: target_name.clone(), key: found.key.clone(), trait_name: owner.clone(), at_trait: at_trait.clone(), first: first })
                                },
                                else => {},
                            }
                        }
                        graph.insert(found.key.clone(), found.uses)
                    }
                },
                // **A trait's method keeps what its package's impls keep**
                // (ADR-277 D17): a call through a bound (`host.go(f)` under
                // `[H: A]`) cannot see which `impl` answers, so the column is
                // the union of theirs, and with no impl the method runs. Its
                // own evidence is empty (a trait method has no body); the
                // edges to its impls are added below. A by-value **data**
                // parameter keeps the seed *by value means kept* until #1012
                // step 3, except one the result's `from` names: the result is
                // a view of it, so it is lent (ADR-views-3 D2, D14, #1230).
                Item::Trait { name, methods, .. } => {
                    let owner = view.text(name)
                    for method in methods {
                        let mut uses = no_uses()
                        for arg in method.node.args {
                            if by_value(arg) && arg.ty.code == null && !method.node.ret_from.contains(arg.name) {
                                uses.kept.insert(view.text(arg.name))
                            }
                        }
                        let called = view.text(method.node.name)
                        graph.insert(f"{owner}::{called}", uses)
                    }
                },
                // **A `entry` rule is an entry, and its one parameter is the
                // text** (ADR-296 D1). Whether it keeps that text is not a
                // question about an action block at all: a parse keeps its
                // input exactly when what it hands back holds a view **into**
                // the input, which is ADR-283's tether read off the rule's
                // declared result.
                //
                // **Before this the entry was in the ledger with the column
                // empty**, and `keeps_its` reads an absent `keeps` on a present
                // entry as *keeps nothing* - so every caller of a parse was
                // told it could lend text a parse holds views into. That is
                // this file's own polarity inverted, and it is what ADR-186 D1
                // is about: the answer is derived now, so an empty column means
                // *asked and no*.
                Item::Grammar(def) => {
                    let named = view.text(def.name)
                    for rule in def.rules {
                        if !rule.is_entry {
                            continue
                        }
                        let mut uses = no_uses()
                        if a_parse_that_views(view.words, rule.ret_type, package) {
                            uses.kept.insert(INPUT_POSITION.clone())
                        }
                        // **The values an entry takes after its input are
                        // kept** (ADR-grammar-1 D2, #1041): the rule's parser
                        // takes each by value and holds it for the whole
                        // parse, so a caller hands it over as it would to an
                        // ordinary function that keeps it. A copied type is
                        // still copied (`lends` asks `moves` first).
                        for arg in rule.args {
                            if by_value(arg) {
                                uses.kept.insert(view.text(arg.name))
                            }
                        }
                        let called = view.text(rule.name)
                        graph.insert(f"{named}::{called}", uses)
                    }
                },
                else => {},
            }
        }
        unit += 1
    }

    // **The trait keeps what an impl keeps** (D17): each `fn` parameter of a
    // trait method is handed to every impl of it in this package, at the same
    // position. With the impls' edges back, a trait method and its impls are
    // one cycle and settle on one column; the least fixpoint leaves a cycle
    // nothing stores run.
    for view in units {
        for item in view.items {
            match item.node {
                Item::Trait { name, methods, .. } => {
                    let owner = view.text(name)
                    for method in methods {
                        let called = view.text(method.node.name)
                        let key = f"{owner}::{called}"
                        let impls = impls_of[key] ?? continue
                        let first = if method.node.receiver != null { 1 } else { 0 }
                        let mut edges: Vec[Passed] = []
                        let mut at = 0
                        for arg in method.node.args {
                            if by_value(arg) && arg.ty.code != null {
                                for callee in impls {
                                    edges.push(Passed { parameter: view.text(arg.name), callee: callee.clone(), at: at + first })
                                }
                            }
                            at += 1
                        }
                        if graph.contains_key(key) {
                            let mut uses = graph[key] ?? continue
                            uses.passed.extend(edges)
                        }
                    }
                },
                else => {},
            }
        }
    }

    // **The least fixpoint** starts from what each body keeps on its own
    // evidence and adds what the callees it hands a parameter to keep, until
    // nothing changes.
    let kept = kept_by(graph, ledger, library)
    let column = keeps_the_impls_own(units, impl_rows, graph, ledger, library, host)
    for (name, parameters) in kept {
        if ledger.functions.contains_key(name) {
            let mut contract = ledger.functions[name] ?? continue
            let mut list: Vec[String] = []
            for parameter in parameters {
                list.push(parameter.clone())
            }
            contract.keeps = list
        }
    }
    keeps_by_value(ledger, units, library)
    return column
}

// **The parameters an own method takes by value though it keeps none of
// them** (ADR-views-3 D1, #1213), for `lends_in_own`: one whose type holds a
// view, which a borrow below would need a lifetime for, and every parameter
// of a method named as a function value anywhere in the package, whose type
// the `fn(..)` parameter it is handed to fixes (`par`'s merge, `in_place`).
fn keeps_by_value(mut ledger: Ledger, units: ref Vec[ParsedView], library: ref Ledger) {
    let named = keeps_named_as_values(units, ledger)
    let mut found: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    for (key, contract) in ledger.functions {
        let signature = contract.signature ?? continue
        if !signature.takes_a_receiver() {
            continue
        }
        let mut by_value: Vec[String] = []
        for (name, ty) in signature.params {
            if name != "self" && (named.contains(key) || keeps_a_held_view(ty, ledger, library)) {
                by_value.push(name.clone())
            }
        }
        found.insert(key.clone(), by_value)
    }
    for (key, by_value) in found {
        let mut contract = ledger.functions[key] ?? continue
        contract.by_value = by_value.clone()
    }
}

// Whether a value of this type holds a view: written one, or a type a ledger
// says has a tethered field or case, or one with such a part.
fn keeps_a_held_view(ty: ref Ty, own: ref Ledger, library: ref Ledger) -> bool {
    return match ty {
        Ty::Named { name, args, view } => view || keeps_a_tethered_type(name, own) || keeps_a_tethered_type(name, library) || keeps_any_held_view(args, own, library),
        Ty::Nullable(inner) => keeps_a_held_view(inner, own, library),
        Ty::Tuple(parts) => keeps_any_held_view(parts, own, library),
        else => false,
    }
}

fn keeps_any_held_view(types: ref Vec[Ty], own: ref Ledger, library: ref Ledger) -> bool {
    for one in types {
        if keeps_a_held_view(one, own, library) {
            return true
        }
    }
    return false
}

fn keeps_a_tethered_type(name: ref String, ledger: ref Ledger) -> bool {
    let described = ledger.types[name] ?? return false
    return !described.tethered.is_empty()
}

// The own methods a body names as a value, `Summary::merge` or
// `Self::merge`, rather than calls: a path counted once more than the calls
// it stands in.
fn keeps_named_as_values(units: ref Vec[ParsedView], ledger: ref Ledger) -> collections::BTreeSet[String] {
    let mut named: collections::BTreeSet[String] = collections::BTreeSet()
    for view in units {
        for item in view.items {
            match item.node {
                Item::Fn { body, .. } => keeps_named_in(view, body, "", ledger, named),
                Item::Impl { target, methods, .. } => {
                    let owner = view.text(target.name)
                    for method in methods {
                        match method.node {
                            Item::Fn { body, .. } => keeps_named_in(view, body, owner, ledger, named),
                            else => {},
                        }
                    }
                },
                // **A grammar's `fold` and `par_fold` name methods too**: the
                // merge of `par_fold(LINE, Total, step, Total::merge)` is a
                // function value handed to the runtime, so `merge` stays by
                // value, as a method named in a function body does.
                Item::Grammar(def) => {
                    let mut exprs: Vec[ref Expr] = []
                    for rule in def.rules {
                        for alt in rule.alts {
                            exprs.extend(keeps_fold_exprs(alt.pattern.node))
                            exprs.extend(visited_in_maybe_block(alt.action))
                        }
                    }
                    keeps_named_among(view, exprs, "", ledger, named)
                },
                else => {},
            }
        }
    }
    return named
}

// The expressions of the `fold`s and `par_fold`s a pattern holds: initial
// value, step and merge, and what is inside them.
fn keeps_fold_exprs(pattern: ref Pattern) -> Vec[ref Expr] {
    let mut out: Vec[ref Expr] = []
    match pattern {
        Pattern::Fold(spec) => {
            out.extend(visited_in_expr(spec.init))
            out.extend(visited_in_expr(spec.step))
            out.extend(visited_in_maybe(spec.merge))
        },
        Pattern::Seq(all) => {
            for each in all {
                out.extend(keeps_fold_exprs(each.node))
            }
        },
        Pattern::Choice(all) => {
            for each in all {
                out.extend(keeps_fold_exprs(each.node))
            }
        },
        Pattern::Bind { pat, .. } => out.extend(keeps_fold_exprs(pat.node)),
        Pattern::Repeat { pat, .. } => out.extend(keeps_fold_exprs(pat.node)),
        Pattern::Group(inner) => out.extend(keeps_fold_exprs(inner.node)),
        Pattern::Ref { args, .. } => {
            for each in args {
                out.extend(keeps_fold_exprs(each.node))
            }
        },
        Pattern::Counted { pat, .. } => out.extend(keeps_fold_exprs(pat.node)),
        else => {},
    }
    return out
}

fn keeps_named_in(view: ref ParsedView, body: ref Block, owner: ref String, ledger: ref Ledger, mut named: collections::BTreeSet[String]) {
    keeps_named_among(view, visited_in_block(body), owner, ledger, named)
}

fn keeps_named_among(view: ref ParsedView, exprs: ref Vec[ref Expr], owner: ref String, ledger: ref Ledger, mut named: collections::BTreeSet[String]) {
    let mut seen: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for expr in exprs {
        match expr {
            Expr::Path(segments, _) => {
                let key = keeps_path_text(view, segments, owner) ?? continue
                let count = seen[key] ?? 0
                seen.insert(key, count + 1)
            },
            Expr::Call { func, .. } => {
                let key = keeps_path_key(view, func, owner) ?? continue
                let count = seen[key] ?? 0
                seen.insert(key, count - 1)
            },
            else => {},
        }
    }
    for (key, count) in seen {
        if count > 0 && ledger.functions.contains_key(key) {
            named.insert(key.clone())
        }
    }
}

fn keeps_path_key(view: ref ParsedView, expr: ref Expr, owner: ref String) -> String? {
    return match expr {
        Expr::Path(segments, _) => keeps_path_text(view, segments, owner),
        else => null,
    }
}

// `Type::method` as the ledger names it, `Self` read as the impl's type.
fn keeps_path_text(view: ref ParsedView, segments: ref Vec[winnow_grammar::Symbol], owner: ref String) -> String? {
    if segments.len() != 2 {
        return null
    }
    let first = view.text(segments[0])
    let ty = if first == "Self" { owner.clone() } else { first }
    return f"{ty}::{view.text(segments[1])}"
}

fn trait_positions(keeps: ref collections::BTreeMap[String, Vec[i64]], key: ref String) -> Vec[i64] {
    let held = keeps[key] ?? return []
    return held.clone()
}

fn add_impl(mut impls_of: collections::BTreeMap[String, collections::BTreeSet[String]], at_trait: ref String, name: ref String) {
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    if impls_of.contains_key(at_trait) {
        let held = impls_of[at_trait] ?? return
        names.extend(held.clone())
    }
    names.insert(name.clone())
    impls_of.insert(at_trait.clone(), names)
}

/// **An impl of another package's trait keeps at most the column** (ADR-277
/// D17): it is a client of the contract its callers were written against. Its
/// own evidence, without the edge back to the trait method (which would hand
/// it the column itself), against the library's column; a position it keeps
/// that the column runs is `NK1264`, at the first statement whose prefix of the
/// body keeps it.
fn keeps_the_impls_own[H: KeepsHost](units: ref Vec[ParsedView], rows: ref Vec[KeepsImplRow], graph: ref collections::BTreeMap[String, Uses], ledger: ref Ledger, library: ref Ledger, host: ref H) -> KeepsColumn {
    let mut column = KeepsColumn { beyond: [], keepers: collections::BTreeMap() }
    for row in rows {
        if graph.contains_key(row.at_trait) && !column.keepers.contains_key(row.at_trait) {
            column.keepers.insert(row.at_trait.clone(), collections::BTreeMap())
        }
    }
    // Only a by-value `fn` parameter has a column the impls make (D17; a data
    // parameter's is the seed until #1012 step 3).
    let mut asked: Vec[ref KeepsImplRow] = []
    for row in rows {
        if asks_a_column(row, graph, library) {
            asked.push(row)
        }
    }
    if asked.len() == 0 {
        return column
    }
    // **Each impl's own evidence**: no edge into a trait method, which would
    // hand an impl the column it is asked about.
    let mut traits: collections::BTreeSet[String] = collections::BTreeSet()
    for row in asked {
        traits.insert(row.at_trait.clone())
    }
    let mut own_graph: collections::BTreeMap[String, Uses] = collections::BTreeMap()
    for (name, uses) in graph {
        let mut passed: Vec[Passed] = []
        for p in uses.passed {
            if !traits.contains(p.callee) {
                passed.push(Passed { parameter: p.parameter.clone(), callee: p.callee.clone(), at: p.at })
            }
        }
        own_graph.insert(name.clone(), Uses { kept: uses.kept.clone(), passed: passed })
    }
    let own_kept = kept_by(own_graph, ledger, library)
    for row in asked {
        let foreign = !graph.contains_key(row.at_trait)
        let contract = (match foreign {
            true => library.functions[row.at_trait],
            false => ledger.functions[row.at_trait],
        }) ?? continue
        let mine = own_kept[row.key] ?? continue
        match row.method.node {
            Item::Fn { args, .. } => {
                let view = units[row.unit]
                let mut at = 0
                for arg in args {
                    at += 1
                    let parameter = view.text(arg.name)
                    if !by_value(arg) || arg.ty.code == null || !mine.contains(parameter) {
                        continue
                    }
                    // An absent position is a signature read wrongly: nothing to say.
                    let theirs = trait_parameter_at(contract, at - 1 + row.first) ?? continue
                    if foreign && contract.keeps.contains(theirs) {
                        continue
                    }
                    let span = host.keeping_statement(row.unit, row.method, row.target.clone(), parameter.clone(), own_kept, ledger, library)
                    if !foreign {
                        add_keeper(column, row.at_trait, theirs, KeepsKeeper { name: row.key.clone(), unit: row.unit, span: span })
                        continue
                    }
                    column.beyond.push((row.unit, check_refusal("NK1264", span, f"`{row.key}` keeps `{parameter}`, which the trait method `{row.at_trait}` runs.", [f"callers through `{row.at_trait}` were written against its `keeps` column, which keeps nothing at `{theirs}` (ADR-277 D17).", f"only the package that declares `{row.trait_name}` widens the column."], f"run `{parameter}` here rather than keep it, or keep it in a type of your own that does not implement `{row.trait_name}`.")))
                }
            },
            else => {},
        }
    }
    return column
}

// The name the trait method's signature gives the parameter at `at`.
fn trait_parameter_at(contract: ref FnContract, at: i64) -> String? {
    let signature = contract.signature ?? return null
    if at >= signature.params.len() {
        return null
    }
    let (name, _) = signature.params[at].clone()
    return name
}

fn asks_a_column(row: ref KeepsImplRow, graph: ref collections::BTreeMap[String, Uses], library: ref Ledger) -> bool {
    let takes_a_fn = match row.method.node {
        Item::Fn { args, .. } => args.iter().any(fn(a) { by_value(a) && a.ty.code != null }),
        else => false,
    }
    return takes_a_fn && (graph.contains_key(row.at_trait) || library.functions.contains_key(row.at_trait))
}

fn add_keeper(mut column: KeepsColumn, at_trait: ref String, parameter: ref String, keeper: KeepsKeeper) {
    let mut inner: collections::BTreeMap[String, Vec[KeepsKeeper]] = collections::BTreeMap()
    if column.keepers.contains_key(at_trait) {
        let held = column.keepers[at_trait] ?? return
        for (name, keepers) in held {
            inner.insert(name.clone(), copied_keepers(keepers))
        }
    }
    let mut list: Vec[KeepsKeeper] = []
    if inner.contains_key(parameter) {
        let had = inner[parameter] ?? return
        list = copied_keepers(had)
    }
    list.push(keeper)
    inner.insert(parameter.clone(), list)
    column.keepers.insert(at_trait.clone(), inner)
}

fn copied_keepers(keepers: ref Vec[KeepsKeeper]) -> Vec[KeepsKeeper] {
    let mut copy: Vec[KeepsKeeper] = []
    for one in keepers {
        copy.push(KeepsKeeper { name: one.name.clone(), unit: one.unit, span: one.span.clone() })
    }
    return copy
}

/// One function's parameters, and what its body does with each.
///
/// `None` for a declaration with no body - a `trait`'s method, which keeps
/// nothing because it does nothing, and whose `impl`s answer for themselves.
pub fn keeps_uses_of(view: ref ParsedView, item: ref Item, target: String?, ledger: ref Ledger, library: ref Ledger, indexes: KeepsIndexes, resolved: ref collections::BTreeMap[String, CheckMethodCalls], holes_of: fn(ref Expr) -> Vec[Expr] sync) -> KeepsFound? {
    match item {
        Item::Fn { name, receiver, args, config, body, ret_type, .. } => {
            let own = match name {
                null => "new",
                n => view.text(n),
            }
            let target_name = target?.clone() ?? ""
            let is_method = target != null
            let key = if is_method { f"{target_name}::{own}" } else { own }

            // **An option is a parameter too** (Part I 5.1): named at the call,
            // but what the body does with it is asked as of any other, so a
            // `String` option the body only reads is lent as a `String`
            // parameter is (ADR-282 D2, D5).
            let mut parameters: collections::BTreeSet[String] = collections::BTreeSet()
            for a in args {
                parameters.insert(view.text(a.name))
            }
            for c in config {
                parameters.insert(view.text(c.name))
            }
            // A method's receiver is a parameter, and `self.field = x` is one
            // of the shapes this analysis exists for - so it is in the set like
            // any other.
            if is_method {
                parameters.insert("self")
            }
            if parameters.len() == 0 {
                return KeepsFound { key: key, uses: no_uses() }
            }
            // **The parameters the author lent**: `ref self`, `ref mut self`, an
            // argument whose type is written `ref`, and one written `mut`,
            // which the callee changes in place (ADR-094 D3). Each is a
            // reference in the Rust whatever this walk decides, so a `match`
            // over one already matches through a reference - the
            // over-approximation in `classify`'s `match` arm is not for them
            // (issue #173, found at 0.0.254).
            let mut lent: collections::BTreeSet[String] = collections::BTreeSet()
            // Of those, the ones no body keeps: see below.
            let mut unkept: collections::BTreeSet[String] = collections::BTreeSet()
            for a in args {
                if a.ty.is_view || a.mutable {
                    lent.insert(view.text(a.name))
                }
                if a.mutable {
                    unkept.insert(view.text(a.name))
                }
                // **A copied scalar is never a view** (#1213): storing one
                // stores a copy, so no caller is asked to hand it over.
                if by_value(a) && keeps_a_copied_scalar(written_ty(view.words, view.aliases, a.ty)) {
                    unkept.insert(view.text(a.name))
                }
            }
            for c in config {
                if c.ty.is_view {
                    lent.insert(view.text(c.name))
                }
            }
            if is_method && (receiver?.is_ref ?? false) {
                lent.insert("self")
                unkept.insert("self")
            }

            // **A result that is a view keeps nothing by returning.** `-> &str`
            // hands back a view of a parameter, which `borrows` already
            // records; it is `-> String` that moves the value out of the call.
            // **Text both kinds flow into is not a view to hand back**
            // (ADR-282 D21): an `EitherText` may own its text, so returning a
            // field of one takes it out of the parameter, as returning a
            // `String` field does.
            // **Nor does a result that copies** (ADR-views-3 D1): `-> i64`
            // hands back a number, never the parameter, so an arm's `n =>
            // return n` over a part of one keeps nothing.
            let returns_a_view = keeps_result_is_a_view(ret_type) || keeps_result_copies(view, ret_type)

            // **The fields of each parameter whose type this file declares.** A
            // parameter of a type from a package or from `std` has none here,
            // and `hand_over` reads that absence as *unknown*, which keeps.
            let declared = fields_held(view.words, view.items)
            let mut fields: collections::BTreeMap[String, collections::BTreeMap[String, Ty]] = collections::BTreeMap()
            for arg in args {
                let mut of: collections::BTreeMap[String, Ty] = collections::BTreeMap()
                let mut found = false
                for held in declared {
                    if held.name == arg.ty.name {
                        of = collections::BTreeMap()
                        for (field, ty) in held.fields {
                            of.insert(field.clone(), written_ty(view.words, view.aliases, ty))
                        }
                        found = true
                    }
                }
                if found {
                    fields.insert(view.text(arg.name), of)
                    continue
                }
                // **A struct of another file of the package** (#1213), or of
                // a package this one uses: its fields are in the ledger's
                // `types`, which the item loop filled before this walk.
                let written = view.text(arg.ty.name)
                let contract = ledger.types[written] ?? library.types[written] ?? continue
                if contract.fields.is_empty() {
                    continue
                }
                let mut of: collections::BTreeMap[String, Ty] = collections::BTreeMap()
                for field in contract.fields {
                    of.insert(field.name.clone(), field.ty.clone())
                }
                fields.insert(view.text(arg.name), of)
            }

            // **Whether this body's method calls resolved at all.** A receiver
            // whose method nothing describes may be a `self`-by-value method,
            // and a parameter handed to one is moved out of - so the
            // fail-closed answer for a *whole body* is the one the type checker
            // already computed (ADR-288).
            let mut unresolved = false
            if resolved.contains_key(key) {
                let calls = resolved[key] ?? return null
                unresolved = calls.unresolved
            }
            // **A receiver's declared type narrows the method it reaches**
            // (#791). A generic one by its name: `re: regex::Regex[regex::Dynamic]`
            // reaches `regex::Regex::find`, not `Seq::find`, which keeps its
            // receiver.
            let mut types: collections::BTreeMap[String, String] = collections::BTreeMap()
            for a in args {
                if !a.ty.is_slice {
                    types.insert(view.text(a.name), view.text(a.ty.name))
                }
            }
            if is_method {
                types.insert("self", target_name.clone())
            }
            // **A `ref Bytes` a `.clone()` keeps** (ADR-373 D1, D4).
            let mut cloned_keeps: collections::BTreeSet[String] = collections::BTreeSet()
            for a in args {
                if a.ty.is_view && !a.ty.is_nullable && !a.ty.is_slice && a.ty.generics.len() == 0 && view.text(a.ty.name) == "Bytes" {
                    cloned_keeps.insert(view.text(a.name))
                }
            }
            // **The walk** (`uses_in`): every statement's expressions
            // classified where they stand, then the blocks it holds, and **the
            // value a body ends in leaves the call**, as a `return` does.
            let context = KeepsBody { parameters: parameters.clone(), lent: lent, fields: fields, returns_a_view: returns_a_view, hands_back_its_last: ret_type != null && !returns_a_view, unresolved: unresolved, types: types, own_methods: indexes.own, library_methods: indexes.library, cloned_keeps: cloned_keeps }
            let uses = uses_in(body, view.words, holes_of, context, ledger, library)
            // **A receiver the author wrote `ref` is not kept** (issue #173),
            // **nor an argument written `mut`** (0.0.258): each is a reference
            // by the author's word, which no walk here widens - a use that
            // would need it whole is `NK1131`'s. An argument written `ref` is
            // not in this rule: a parse keeps the text its result views
            // (ADR-186 D1).
            let mut kept: collections::BTreeSet[String] = collections::BTreeSet()
            for name in uses.kept {
                if !unkept.contains(name) {
                    kept.insert(name.clone())
                }
            }
            let mut passed: Vec[Passed] = []
            for p in uses.passed {
                if !unkept.contains(p.parameter) {
                    passed.push(Passed { parameter: p.parameter.clone(), callee: p.callee.clone(), at: p.at })
                }
            }
            return KeepsFound { key: key, uses: Uses { kept: kept, passed: passed } }
        },
        else => {
            return null
        },
    }
    return null
}

/// Whether a declared result is a number, a `bool` or a `char`, alone or
/// optional: what it hands back is a copy.
fn keeps_result_copies(view: ref ParsedView, ret_type: ref Type?) -> bool {
    let ty = ret_type ?? return false
    if ty.code != null || ty.is_slice || ty.is_view || ty.is_tuple || !ty.generics.is_empty() {
        return false
    }
    let name = view.text(ty.name)
    return ["i8", "i16", "i32", "i64", "isize", "usize", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "char"].contains(name)
}

fn keeps_result_is_a_view(ret_type: ref Type?) -> bool {
    let ty = ret_type ?? return false
    return holds_view(ty) && !keeps_holds_either(ty)
}

/// Whether a declared type has text both kinds flow into anywhere in it.
fn keeps_holds_either(ty: ref Type) -> bool {
    if ty.either {
        return true
    }
    for inner in ty.generics {
        if keeps_holds_either(inner) {
            return true
        }
    }
    return false
}
