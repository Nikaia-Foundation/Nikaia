// crates/nikaia-std/src/tools/describe.nika
//
// What `nikaia describe` drafts from a crate's surface (ADR-290) - the entries,
// the types they name and what the describer saw and did not claim - moved
// from Rust (ADR-294, #125). Reading the manifest and the crate's files, the
// hashes and the ledger's header stay Rust; reading the files' items is
// `tools/rust.nika` and `tools/surface.nika` already.

use std::collections
use std::fs
use std::hash

/// What a description holds, before the header goes on it.
pub struct Drafted {
    /// One entry per function the program writes, by `crate::name`.
    pub functions: collections::BTreeMap[String, FnContract],
    /// One entry per crate type the program writes or an entry names.
    pub types: collections::BTreeMap[String, TypeContract],
    /// What the program writes and the crate does not offer.
    pub unanswered: Vec[String],
    /// What the describer saw and did not claim (D8, D10).
    pub notes: Notes,
}

/// The description of `crate_word` for the names the program writes of it,
/// from the crate's resolved `surface`.
pub fn drafted(surface: ref Surface, crate_word: ref String, wanted: ref collections::BTreeSet[String]) -> Drafted {
    let mut functions: collections::BTreeMap[String, FnContract] = collections::BTreeMap()
    let mut unanswered: Vec[String] = []
    let mut named_types: collections::BTreeSet[String] = collections::BTreeSet()
    for name in wanted {
        // **The path a caller writes, resolved through the `pub use` items**
        // (D17's own reason for reading them): a `pub fn` inside a private
        // `mod` is reachable after all when one says so, and refusing such a
        // call would be Part III C.4.
        if !answered(surface, name) {
            unanswered.push(f"{crate_word}::{name}")
            continue
        }
        let at = surface.reachable[name] ?? continue
        let function = surface.functions[at] ?? continue
        functions.insert(f"{crate_word}::{name}", contract_of(function, crate_word, surface.types, named_types))
    }
    // **A written type is a reach across the boundary too** (D1), and a type a
    // described signature *names* is one the caller's compiler will look up.
    // So both sets get an entry: what the program wrote, and what the entries
    // mention.
    for name in wanted {
        if surface.types.contains(name) {
            named_types.insert(name.clone())
        }
    }
    let mut types: collections::BTreeMap[String, TypeContract] = collections::BTreeMap()
    let no_fields: Vec[String] = []
    let no_derives: collections::BTreeSet[String] = collections::BTreeSet()
    for name in named_types {
        // **The one claim that comes from a field** (ADR-123 D2), and what the
        // type derives (ADR-294 D9.3).
        let fields = surface.fields[name] ?? no_fields
        let derives = surface.derives[name] ?? no_derives
        types.insert(f"{crate_word}::{name}", type_entry(fields, derives))
    }
    return Drafted { functions: functions, types: types, unanswered: unanswered, notes: notes_on(surface, crate_word, wanted) }
}

// **What the describer saw and did not claim** (D8, D9, D10): the crate's
// promises, and per function the bound and a sink reached through the
// crate's own calls - which is the row an `unsafe impl Send` that took the
// bound away leaves.
fn notes_on(surface: ref Surface, crate_word: ref String, wanted: ref collections::BTreeSet[String]) -> Notes {
    let mut notes = Notes::empty()
    notes.about_the_crate = promise_lines(surface.promises)
    // What each of the crate's functions calls, by its path: what
    // `reaches_a_thread` follows.
    let mut calls: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    for (path, function) in surface.functions {
        calls.insert(path.clone(), function.calls.clone())
    }
    for name in wanted {
        let at = surface.reachable[name] ?? continue
        let function = surface.functions[at] ?? continue
        let said = thread_lines(name, bound_parameters(function), reaches_a_thread(at, calls))
        if said.len() > 0 {
            notes.about_a_function.insert(f"{crate_word}::{name}", said)
        }
    }
    return notes
}

// Whether a name the program writes reaches a function, through the
// `pub use` items.
fn answered(surface: ref Surface, name: ref String) -> bool {
    let at = surface.reachable[name] ?? return false
    return surface.functions.contains_key(at)
}

// **The parameters a `Send` bound reaches**, in declaration order (D9): a
// parameter whose type is a type variable the bounds send, and one written
// `impl … Send …` at the parameter itself.
fn bound_parameters(function: ref Function) -> Vec[String] {
    let mut names: Vec[String] = []
    let mut types: Vec[String] = []
    for arg in function.args {
        names.push(arg.name.clone())
        types.push(arg.ty.clone())
    }
    return sent_across(names, types, function.bounds)
}

// The entry for the `Function` the surface read; the crate types its
// signature names go into `mentioned`.
fn contract_of(function: ref Function, crate_word: ref String, types: ref collections::BTreeSet[String], mut mentioned: collections::BTreeSet[String]) -> FnContract {
    let mut names: Vec[String] = []
    let mut written_types: Vec[String] = []
    for arg in function.args {
        names.push(arg.name.clone())
        written_types.push(arg.ty.clone())
    }
    let written = WrittenFn {
        names: names,
        types: written_types,
        result: function.result.clone(),
        pauses: function.pauses,
        parameters: function.parameters.clone(),
    }
    return contract(written, crate_word, types, mentioned)
}

/// What `describe_names_the_program_writes` asks of the compiler: the parser
/// and the walk `NK2504` runs are Rust's.
pub trait DescribeHost {
    /// The qualified names a `.nika` text writes (`foreign::qualified_names`),
    /// `null` where the text does not parse.
    fn qualified_names(ref self, text: ref String) -> Vec[String]? sync
}

/// **Why a crate's shipped ledger is refused** (ADR-290 D22, D5), `null`
/// where it describes the crate as it is now: `text` is the shipped file,
/// `version` the crate's, `files` the crate's sources by their path in it.
///
/// A ledger that names another version than the crate's, or whose recorded
/// sources hash differently from the crate's own, describes code that is no
/// longer there, and is refused rather than believed.
pub fn describe_adopt_refusal(declared: String, crate_word: String, shipped: ref fs::Path, derived: ref fs::Path, text: String, version: String, ledger: ref Ledger, files: ref collections::BTreeMap[String, String]) -> String? {
    match describe_header_version(text, crate_word) {
        null => return f"`{declared}`'s shipped {shipped.display()} doesn't say which crate and version it describes. Its header needs the line `# crate: {crate_word} {version}`.",
        said => {
            if said != version {
                return f"`{declared}`'s shipped {shipped.display()} describes version {said}, and the crate is {version}. A description is reviewed for one version: review it again in the crate."
            }
        },
    }
    if ledger.sources.is_empty() {
        return f"`{declared}`'s shipped {shipped.display()} has no `[sources]` in {derived.display()} beside it, so nothing says which sources it was reviewed against."
    }
    let now: collections::BTreeMap[String, String] = files.iter().map(fn(entry) { (entry.0.clone(), hash::sha256_hex(entry.1.bytes().collect())) }).collect()
    let all: collections::BTreeSet[String] = now.keys().chain(ledger.sources.keys()).map(fn(x) { x.clone() }).collect()
    let moved: Vec[String] = all.iter().filter(fn(file) { now.get(file) != ledger.sources.get(file) }).map(fn(x) { x.clone() }).collect()
    let first = moved.first() ?? return null
    let more = match moved.len() {
        1 => "",
        2 => " and 1 more file",
        else => f" and {moved.len() - 1} more files",
    }
    return f"`{declared}` has changed since its shipped description was reviewed: `{first}`{more} changed since.\nA description is written by a person, so the crate's nikaia.contracts has to be reviewed again, not just regenerated."
}

/// **The manifest's key for the crate a program writes `crate_word`**
/// (ADR-290 D1), refused where that entry is no Rust crate or none is there.
///
/// The key is the manifest's and the word is Cargo's, which is the translation
/// D1 already makes: `hyper-shim` in the manifest is `hyper_shim` in a program.
pub fn describe_rust_dependency(manifest: ref ManifestFile, crate_word: String) -> String throws {
    for (key, declared) in manifest.dependencies {
        if key.replace("-", "_") != crate_word {
            continue
        }
        match declared.shape {
            DependencyShape::Rust => return key.clone(),
            else => throw Refused::Because(f"`{key}` is a Nikaia package, not a Rust crate. `nikaia describe` is for `[dependencies]` entries with `type = \"rust\"`."),
        }
    }
    // A manifest key whose program word differs (`low-bits` for `low_bits`):
    // the refusal names the word that works (Part III 15.2).
    for (key, _) in manifest.dependencies {
        let word = key.replace("-", "_")
        if key != word && key == crate_word {
            throw Refused::Because(f"`{crate_word}` is the manifest's key, not the crate's name: write `nikaia describe {word}`, the name a program writes after `use`.")
        }
    }
    throw Refused::Because(f"`{crate_word}` isn't in this project's `[dependencies]`. Add it to `nikaia.toml` first: only crates the project depends on can be described.")
}

/// **What the program writes of `crate_word` that `ledger` does not answer**
/// (ADR-290 D5): each of `names` as `crate::name`, in their order, where the
/// ledger has neither a function nor a type of that name.
pub fn describe_unanswered(names: ref collections::BTreeSet[String], crate_word: String, ledger: ref Ledger) -> Vec[String] {
    return names.iter().map(fn(name) { f"{crate_word}::{name}" }).filter(fn(name) { !ledger.functions.contains_key(name) && !ledger.types.contains_key(name) }).collect()
}

// The version the first `# crate: ` line of a shipped ledger names, where it
// names `crate_word` first; `?` where it names no version after it.
fn describe_header_version(text: String, crate_word: String) -> String? {
    let line = text.lines().find_map(fn(line) { line.strip_prefix("# crate: ") }) ?? return null
    let words: Vec[String] = line.split_whitespace().collect()
    let first = words.first() ?? return null
    if first != crate_word {
        return null
    }
    return (words.get(1) ?? "?").clone()
}

/// **Every description this build reads, as one digest**, for the cache key
/// ([ADR-290](../../../docs/specification/adr/adr-290.md) D5,
/// [ADR-021](../../../docs/specification/adr/adr-021.md) D7): each
/// `*.contracts` in `directory`, its name and the SHA-256 of its text.
///
/// Empty where there is none. The names come in byte order (ADR-005 D8: this
/// output is a cache key), and a file that cannot be read hashes as empty.
pub fn describe_descriptions_digest(directory: ref fs::Path) -> String {
    let names = fs::read_dir(directory, fs::Root::Anywhere) catch { return "" }
    let files: Vec[fs::Path] = names.iter().filter(fn(name) { (name.extension()?.text_of() ?? "") == "contracts" }).cloned().collect()
    if files.is_empty() {
        return ""
    }
    let mut all = ""
    for name in files {
        let text = fs::read_to_string(directory.join(name), fs::Root::Anywhere) catch { "" }
        all.push_str(name.text_of())
        all.push_str("\0")
        all.push_str(hash::sha256_hex(text.bytes().collect()))
        all.push_str("\0")
    }
    return hash::sha256_hex(all.bytes().collect())
}

/// **The names of `crate_word` every `.nika` under `root` writes**, without
/// the crate word in front: the walk `NK2504` runs, read one segment further.
///
/// `target/` is the build's own and `contracts` (the directory named so) holds
/// this command's own output: neither is walked. A directory or a file that
/// cannot be read is left out, and so is a file that does not parse: that is
/// the build's to report, not this command's.
pub fn describe_names_the_program_writes[H: DescribeHost](root: ref fs::Path, crate_word: String, contracts: String, host: ref H) -> collections::BTreeSet[String] {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    let mut pending: Vec[fs::Path] = [root.clone()]
    while true {
        let directory = pending.pop() ?? break
        let names = fs::read_dir(directory, fs::Root::Anywhere) catch { continue }
        for name in names {
            let path = directory.join(name)
            let meta = fs::metadata(path, fs::Root::Anywhere) catch { continue }
            if meta.is_dir() {
                let word = name.text_of()
                if word != "target" && word != contracts {
                    pending.push(path)
                }
                continue
            }
            if (path.extension()?.text_of() ?? "") != "nika" {
                continue
            }
            let text = fs::read_to_string(path, fs::Root::Anywhere) catch { continue }
            let written = host.qualified_names(text) ?? continue
            for qualified in written {
                let rest = qualified.strip_prefix(f"{crate_word}::") ?? continue
                out.insert(rest.clone())
            }
        }
    }
    return out
}

/// **A name with its `.` and `..` parts walked off**, without asking the file
/// system whether any of it exists (ADR-319 D10): a `..` takes the part before
/// it away, and one with nothing before it, or only the root, is dropped.
pub fn describe_without_dots(path: ref fs::Path) -> fs::Path {
    let mut out: fs::Path = ""
    for part in path.parts() {
        if part == "." {
            continue
        }
        if part == ".." {
            out = out.parent() ?? continue
            continue
        }
        out = out.join(part)
    }
    return out
}
