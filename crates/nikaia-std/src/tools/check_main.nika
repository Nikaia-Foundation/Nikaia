// crates/nikaia-std/src/tools/check_main.nika
//
// **`main`'s parameters are the command line** (Part I 5.5, ADR-360 D1, D2):
// what a word can be, and the names the words use. A parameter no word can
// be, or a required subject after a `T?` one, is `NK1273`; an option named
// `help` is `NK1274`. Whether the target has a command line at all is
// the emitter's to say, which knows it (`emit_entry.nika`).

/// Whether a word can be a value of the type named `name`: `int`, a
/// fixed-width integer, `f64`, `bool` or `String` (ADR-360 D2).
pub fn main_word_type(name: ref String) -> bool {
    return name == "int" || is_whole_number(name) || name == "f64" || name == "bool" || name == "String"
}

/// Why no word can be a value of `ty`, or nothing where one can. `last` is
/// whether `ty` is the last subject parameter, which may be a `Vec[T]`.
fn main_refused_type(ty: ref Type, words: ref winnow_grammar::InternerContext, last: bool) -> String? {
    if ty.is_view || ty.is_mut {
        return "a `ref` parameter".clone()
    }
    let name = words.resolve(ty.name)
    if ty.is_tuple || ty.code != null || ty.count != null {
        return f"a `{main_written_type(ty, words)}`"
    }
    if name == "Vec" && ty.generics.len() == 1 && !ty.is_nullable {
        if !last {
            return "a `Vec` that is not the last subject parameter".clone()
        }
        let item = ty.generics[0]
        if item.is_nullable || item.generics.len() > 0 || item.is_view || item.is_tuple || !main_word_type(words.resolve(item.name)) {
            return f"a `{main_written_type(ty, words)}`"
        }
        return null
    }
    if ty.generics.len() > 0 || !main_word_type(name) {
        return f"a `{main_written_type(ty, words)}`"
    }
    return null
}

/// An option's name as the command line writes it: `max_depth` is
/// `max-depth` (ADR-360 D1).
pub fn main_option_word(name: ref String) -> String {
    return name.replace("_", "-")
}

impl CheckState {
    /// **What `main`'s parameters may be** (ADR-360 D2): `NK1273` for a
    /// parameter no word can be or a required subject after a `T?` one,
    /// `NK1274` for an option named `help`. Only a free `fn main`.
    pub fn main_parameters(ref mut self, world: ref CheckWorld, item: ref Item, span: ref Span) sync {
        match item {
            Item::Fn { name, receiver, args, config, .. } => {
                let called = name ?? return
                if receiver != null || world.words.resolve(called) != "main" {
                    return
                }
                let note = "A parameter of `main` is a word the program is started with: `int`, a fixed-width integer, `f64`, `bool`, `String`, or one of these behind `?`; the last subject parameter may be a `Vec[T]` of one of them (Part I 5.5).".clone()
                let mut maybe: String = ""
                for index in 0..<args.len() {
                    let arg = args[index]
                    let param = world.words.resolve(arg.name).clone()
                    let last = index + 1 == args.len()
                    let refused = main_refused_type(arg.ty, world.words, last)
                    if refused == null && maybe != "" && !arg.ty.is_nullable && !(last && world.words.resolve(arg.ty.name) == "Vec") {
                        self.findings.push(check_refusal("NK1273", span, f"`{param}` of `main` is a required word after `{maybe}`, which may be left out.", ["A subject of type `T?` may be left out at the end; it stands after every required subject and before a last `Vec[T]` (Part I 5.5).".clone()], f"Move `{param}` before `{maybe}`, or make it a `T?` too."))
                    }
                    if arg.ty.is_nullable && maybe == "" {
                        maybe = param.clone()
                    }
                    let why = refused ?? continue
                    self.findings.push(check_refusal("NK1273", span, f"`{param}` of `main` can't be a word on the command line: it is {why}.", [note.clone()], f"Take the word as a `String` and convert it in the body, or read `cli::args()` for a shape `main`'s parameters don't have."))
                }
                for option in config {
                    let param = world.words.resolve(option.name).clone()
                    let why = main_refused_type(option.ty, world.words, false)
                    if why != null {
                        self.findings.push(check_refusal("NK1273", span, f"`{param}` of `main` can't be a word on the command line: it is {why ?? ""}.", [note.clone()], f"Take the word as a `String` and convert it in the body, or read `cli::args()` for a shape `main`'s parameters don't have."))
                    }
                    let word = main_option_word(param)
                    if word == "help" {
                        self.findings.push(check_refusal("NK1274", span, "`main` has an option named `help`, and `--help` prints the program's help.", ["`--help` and `-h` are the program's own: they print the `///` lines above `main` and its parameters (Part I 5.5).".clone()], "Name the option differently."))
                    }
                }
            },
            else => {},
        }
    }
}
