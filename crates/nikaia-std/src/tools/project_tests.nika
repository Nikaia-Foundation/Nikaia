// **The test runner's discovery, verdicts and each test's work** (P3a, P3b,
// #125): what `crates/nikaia/src/project.rs` did to find a package's output
// tests and test programs, to read what they expect, to say how a run went and
// whether a test passed, to bless it and to explain a failure, moved.
// `project.rs` keeps the loop of `run_tests` over the tests and settings, the
// `Sandbox`, the process spawns (`outcome_of`, the compiler's own runs in
// `run_program_test`) and the failures' report, and calls these; the three
// structs are Nikaia's and `project.rs` re-exports them.
//
// **What a test expects is `Bytes`**: a file is read as bytes and compared as
// bytes, never as text that might not be (ADR-269 D22, ADR-247 D2).

use std::fs
use std::collections

/// **What one test did, at one setting** ([ADR-269](../../../docs/specification/adr/adr-269.md) D1).
pub struct ProjectTestsOutcome {
    /// Whether the process ended successfully.
    pub ended_well: bool,
    pub passed: bool,
    pub stdout: Bytes,
    pub stderr: String,
    /// Each file the test's `NAME.out/` names, and what the program wrote
    /// under that name - nothing where it wrote nothing
    /// ([ADR-247](../../../docs/specification/adr/adr-247.md) D2).
    pub files: Vec[(String, Bytes?)],
}

/// **An output test** ([ADR-269](../../../docs/specification/adr/adr-269.md) D13,
/// [ADR-247](../../../docs/specification/adr/adr-247.md) D2): named by a
/// `tests/NAME.stdout` or a `tests/NAME.out/`, with what goes in beside them.
pub struct OutputTest {
    pub name: String,
    /// The package's `tests/`, where its expectations are blessed to.
    pub dir: fs::Path,
    /// `NAME.stdout`, where there is one.
    pub stdout: Bytes?,
    /// `NAME.stderr`, where there is one (ADR-269 D22).
    pub stderr: Bytes?,
    /// `NAME.out/`: each file by the name it has under the working directory.
    pub files: Vec[(String, Bytes)],
    /// `NAME.in/`, copied into the working directory before the run.
    pub inputs: fs::Path?,
    pub stdin: Bytes,
    pub args: Vec[String],
}

/// **A test program** ([ADR-269](../../../docs/specification/adr/adr-269.md)
/// D22): `tests/NAME.nika`, with what it must produce beside it.
pub struct ProgramTest {
    pub name: String,
    pub dir: fs::Path,
    pub stdout: Bytes?,
    /// What it writes to standard error, or, where it is refused, the
    /// compiler's whole message (it starts `error`).
    pub stderr: Bytes?,
}

/// Every file under `dir`, by its name relative to it with `/` between the
/// parts, sorted.
/// A test's file as the project names it: under the root, the rest after it,
/// both names canonical; else, or where either cannot be resolved, as given.
pub fn shown_path(path: ref fs::Path, root: ref fs::Path) -> String {
    let path = fs::canonical(path, fs::Root::Anywhere) catch { path.clone() }
    let root = fs::canonical(root, fs::Root::Anywhere) catch { root.clone() }
    return (path.strip_prefix(root) ?? path).display()
}

fn files_under(dir: ref fs::Path) -> Vec[(String, fs::Path)] throws {
    let mut found: Vec[(String, fs::Path)] = fs::walk(dir, fs::Root::Anywhere).iter().map(fn(name) { (name.text_of(), dir.join(name)) }).collect()
    found.sort()
    return found
}

/// Whether `path` names a directory; a name that is not there names none.
fn project_tests_is_dir(path: ref fs::Path) -> bool {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_dir()
}

/// Whether `path` names a file; a name that is not there names none.
fn project_tests_is_file(path: ref fs::Path) -> bool {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_file()
}

/// A file's bytes, nothing where it is not there; a file that is there and
/// cannot be read is the failure.
fn project_tests_optional(path: ref fs::Path) -> Bytes? throws {
    if !fs::exists(path, fs::Root::Anywhere) {
        return null
    }
    return fs::read(path, fs::Root::Anywhere)
}

/// The names in `dir` that end in `.ending`, without it, sorted: a test's
/// name is the file's stem.
fn project_tests_stems(dir: ref fs::Path, ending: String, want_dir: bool) -> collections::BTreeSet[String] {
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    let entries = fs::read_dir(dir, fs::Root::Anywhere) catch { return names }
    for name in entries.iter() {
        let text = name.text_of()
        let stem: String = (text.strip_suffix(ending) ?? "").clone()
        if stem.is_empty() {
            continue
        }
        let path = dir.join(name)
        let right = match want_dir {
            true => project_tests_is_dir(path),
            false => project_tests_is_file(path),
        }
        if right {
            names.insert(stem)
        }
    }
    return names
}

/// The package's output tests, by name. A `tests/` that is not there holds
/// none; a file that is there and cannot be read is an error, not a test that
/// quietly has no input.
pub fn output_tests(root: ref fs::Path) -> Vec[OutputTest] throws {
    let dir = root.join("tests")
    let mut names = project_tests_stems(dir, ".stdout", false)
    names.extend(project_tests_stems(dir, ".out", true))
    let mut tests: Vec[OutputTest] = []
    for name in names {
        // A `NAME.nika` beside them makes the files that program's (D22).
        if project_tests_is_file(dir.join(f"{name}.nika")) {
            continue
        }
        let stdout = project_tests_optional(dir.join(f"{name}.stdout"))
        let out = dir.join(f"{name}.out")
        let mut files: Vec[(String, Bytes)] = []
        if project_tests_is_dir(out) {
            for (relative, path) in files_under(out) {
                files.push((relative, fs::read(path, fs::Root::Anywhere)))
            }
        }
        let given = dir.join(f"{name}.in")
        let inputs: fs::Path? = match project_tests_is_dir(given) {
            true => given,
            false => null,
        }
        let stdin = project_tests_optional(dir.join(f"{name}.stdin")) ?? Bytes([])
        let mut args: Vec[String] = []
        let listed = project_tests_optional(dir.join(f"{name}.args"))
        if listed != null {
            let bytes = listed ?? Bytes([])
            args = bytes.text().lines().map(fn(line) { line.clone() }).collect()
        }
        let stderr = project_tests_optional(dir.join(f"{name}.stderr"))
        tests.push(OutputTest { name: name.clone(), dir: root.join("tests"), stdout: stdout, stderr: stderr, files: files, inputs: inputs, stdin: stdin, args: args })
    }
    return tests
}

/// Copy every file under `from` to the same name under `to`, making the
/// directories on the way.
pub fn copy_into(from: ref fs::Path, to: ref fs::Path) throws {
    for (relative, path) in files_under(from) {
        let target = to.join(relative)
        match target.parent() {
            null => {}
            parent => fs::create_dir(parent, fs::Root::Anywhere; recursive: true),
        }
        fs::copy(path, target, fs::Root::Anywhere)
    }
}

/// The package's test programs, by name.
pub fn program_tests(root: ref fs::Path) -> Vec[ProgramTest] throws {
    let dir = root.join("tests")
    let mut tests: Vec[ProgramTest] = []
    for name in project_tests_stems(dir, ".nika", false) {
        let stdout = project_tests_optional(dir.join(f"{name}.stdout"))
        let stderr = project_tests_optional(dir.join(f"{name}.stderr"))
        tests.push(ProgramTest { name: name.clone(), dir: root.join("tests"), stdout: stdout, stderr: stderr })
    }
    return tests
}

/// Whether a stderr file holds a compiler's refusal, whatever stage produced
/// it: a checker's `error[NK…]` or a parse error's plain `error:` (ADR-269 D22,
/// #834). rustc's own failure is told apart by its `could not compile`.
pub fn is_refusal(text: String) -> bool {
    return (text.starts_with("error") || text.contains("\nerror")) && !does_not_compile(text)
}

/// Whether the build failed in rustc: not a refusal by the Nikaia compiler.
pub fn does_not_compile(text: String) -> bool {
    return text.contains("could not compile")
}

/// What names an output test in its report: its `.stdout`, or its `.out/`.
pub fn named_by(output: ref OutputTest) -> String {
    return match output.stdout != null {
        true => f"{output.name}.stdout",
        false => f"{output.name}.out/",
    }
}

/// **A line difference** ([ADR-247](../../../docs/specification/adr/adr-247.md)
/// D4): `-` an expected line, `+` a produced one, and two lines of context
/// around each change, from a longest common subsequence of the lines.
pub fn project_tests_difference(expected: ref Bytes, produced: ref Bytes) -> String {
    let want = expected.text() catch { return "  the bytes differ, and they are not text\n" }
    let got = produced.text() catch { return "  the bytes differ, and they are not text\n" }
    // **The lines are Nikaia's** (`tools/diffs.nika`, #125).
    return differing_lines(want, got)
}

/// Whether every setting did the same.
pub fn project_tests_agree(outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> bool {
    return (1..<outcomes.len()).all(fn(at) { outcomes[at - 1].1 == outcomes[at].1 })
}

/// Print one test's line, and say whether it passed: at every setting, and the
/// same way at each.
pub fn project_tests_verdict(label: String, outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> bool {
    let agree = project_tests_agree(outcomes)
    let passed = agree && (0..<outcomes.len()).all(fn(at) { outcomes[at].1.passed })
    let said = match (passed, agree) {
        (true, _) => "ok",
        (false, true) => "FAILED",
        (false, false) => "FAILED (the settings disagree)",
    }
    println(f"{label} ... {said}")
    return passed
}

/// The first line `nikaia test` prints: how many tests it runs.
pub fn project_tests_running(total: i64) {
    let plural = match total == 1 {
        true => "",
        false => "s",
    }
    println(f"running {total} test{plural}")
}

/// The last line `nikaia test` prints, and the exit code it ends with.
pub fn project_tests_result(total: i64, failed: i64) -> i32 {
    let passed = total - failed
    let said = match failed == 0 {
        true => "ok",
        false => "FAILED",
    }
    println(f"\ntest result: {said}. {passed} passed; {failed} failed")
    return match failed == 0 {
        true => 0,
        false => 1,
    }
}

/// How an output test names itself in its line.
pub fn project_tests_output_label(output: ref OutputTest) -> String {
    return f"output \"{output.name}\" (tests/{named_by(output)})"
}

/// How a test program names itself in its line.
pub fn project_tests_program_label(program: ref ProgramTest) -> String {
    return f"program \"{program.name}\" (tests/{program.name}.nika)"
}

/// Whether a test wrote the `at`th file its `.out/` names, byte for byte.
fn project_tests_wrote(got: ref Vec[(String, Bytes?)], want: ref Vec[(String, Bytes)], at: i64) -> bool {
    return match got[at].1 {
        null => false,
        written => written == want[at].1,
    }
}

/// A file a test may have written, nothing where it wrote none.
fn project_tests_written(path: ref fs::Path) -> Bytes? {
    return fs::read(path, fs::Root::Anywhere) catch { null }
}

/// **How an output test went at one setting**
/// ([ADR-247](../../../docs/specification/adr/adr-247.md) D2): the program
/// ran in `own` and ended as `ended_well` says, printing `stdout` and `stderr`.
/// It passed where it ended successfully, printed what its `.stdout` and
/// `.stderr` hold, where it has them, and left each file its `.out/` names
/// byte for byte.
pub fn project_tests_output_outcome(output: ref OutputTest, own: ref fs::Path, ended_well: bool, stdout: Bytes, stderr: String) -> ProjectTestsOutcome {
    let files: Vec[(String, Bytes?)] = output.files.iter().map(fn(file) { (file.0.clone(), project_tests_written(own.join(file.0))) }).collect()
    let printed_right = match output.stdout {
        null => true,
        want => want == stdout,
    }
    let said_right = match output.stderr {
        null => true,
        want => want == stderr.bytes,
    }
    let wrote_right = (0..<output.files.len()).all(fn(at) { project_tests_wrote(files, output.files, at) })
    return ProjectTestsOutcome { ended_well: ended_well, passed: ended_well && printed_right && said_right && wrote_right, stdout: stdout, stderr: stderr, files: files }
}

/// **A test program the compiler did not build**: `stderr` is what it said,
/// with the path written `tests/NAME.nika`. A refusal passes where it is the
/// program's `.stderr`, word for word; a build that failed in rustc is no
/// refusal and never passes.
pub fn project_tests_refused_outcome(program: ref ProgramTest, stderr: String) -> ProjectTestsOutcome {
    let broken = !is_refusal(stderr)
    let shown = match broken {
        true => f"the program does not compile (rustc failed, not a refusal):\n{stderr}",
        false => stderr.clone(),
    }
    let passed = !broken && match program.stderr {
        null => false,
        want => want == shown.bytes,
    }
    return ProjectTestsOutcome { ended_well: false, passed: passed, stdout: Bytes([]), stderr: shown, files: [] }
}

/// **A test program that built and ran**: it passed where it ended
/// successfully and printed what its `.stdout` and `.stderr` hold, where it has
/// them. A `.stderr` holding a refusal expects one, so a run never matches it.
pub fn project_tests_ran_outcome(program: ref ProgramTest, ended_well: bool, stdout: Bytes, said: String) -> ProjectTestsOutcome {
    let printed_right = match program.stdout {
        null => true,
        want => want == stdout,
    }
    let said_right = match program.stderr {
        null => true,
        want => !is_refusal(want.text() catch { "" }) && want == said.bytes,
    }
    return ProjectTestsOutcome { ended_well: ended_well, passed: ended_well && printed_right && said_right, stdout: stdout, stderr: said, files: [] }
}

/// What `--bless` did with one test.
pub enum ProjectTestsBlessed {
    Unchanged,
    Written,
    /// Not blessed, and why.
    Refused(String),
}

/// Print a blessed test's line, and say whether it passed: one that could
/// not be blessed failed.
pub fn project_tests_blessed_line(label: String, blessed: ref ProjectTestsBlessed) -> bool {
    match blessed {
        ProjectTestsBlessed::Unchanged => println(f"{label} ... ok"),
        ProjectTestsBlessed::Written => println(f"{label} ... blessed"),
        ProjectTestsBlessed::Refused(why) => {
            println(f"{label} ... FAILED ({why}, so it is not blessed)")
            return false
        },
    }
    return true
}

/// `--bless` for a test program: `NAME.stdout` and `NAME.stderr` are written
/// from what happened, a refusal into `NAME.stderr` only. A program that
/// built and ended unsuccessfully, or whose settings disagree, is not blessed.
pub fn project_tests_bless_program(program: ref ProgramTest, outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> ProjectTestsBlessed throws {
    if outcomes.is_empty() {
        return ProjectTestsBlessed::Unchanged
    }
    if !project_tests_agree(outcomes) {
        return ProjectTestsBlessed::Refused("the settings disagree")
    }
    let first = outcomes[0].1
    let refused = !first.ended_well && is_refusal(first.stderr)
    if !first.ended_well && !refused && first.stderr.starts_with("the program does not compile") {
        return ProjectTestsBlessed::Refused("the program does not compile")
    }
    if !first.ended_well && !refused {
        return ProjectTestsBlessed::Refused("the program did not end successfully")
    }
    if first.passed {
        return ProjectTestsBlessed::Unchanged
    }
    if !refused && (program.stdout != null || !first.stdout.is_empty()) {
        fs::write(program.dir.join(f"{program.name}.stdout"), fs::Root::Anywhere, first.stdout.clone())
    }
    if refused || program.stderr != null {
        fs::write(program.dir.join(f"{program.name}.stderr"), fs::Root::Anywhere, first.stderr.bytes)
    }
    return ProjectTestsBlessed::Written
}

/// **What an output test got wrong, as differences**
/// ([ADR-247](../../../docs/specification/adr/adr-247.md) D4).
pub fn project_tests_explain_output(output: ref OutputTest, outcome: ref ProjectTestsOutcome) {
    if !outcome.ended_well {
        println("the program did not end successfully")
    }
    match output.stdout {
        null => {},
        want => {
            if want != outcome.stdout {
                println("standard output (- expected, + printed):")
                print(project_tests_difference(want, outcome.stdout))
            }
        },
    }
    match output.stderr {
        null => {},
        want => {
            if want != outcome.stderr.bytes {
                println("standard error (- expected, + written):")
                print(project_tests_difference(want, outcome.stderr.bytes))
            }
        },
    }
    for (wanted, written) in output.files.iter().zip(outcome.files.iter()) {
        let relative = wanted.0
        let want = wanted.1
        match written.1 {
            null => println(f"{relative}: not written"),
            got => {
                if got != want {
                    println(f"{relative} (- expected, + written):")
                    print(project_tests_difference(want, got))
                }
            },
        }
    }
}

/// **`--bless`** ([ADR-247](../../../docs/specification/adr/adr-247.md) D3):
/// what the program printed becomes `NAME.stdout`, where the test has one,
/// and each file it wrote becomes the `NAME.out/` entry of that name. Only a
/// run that ended successfully, and at two settings only one whose runs
/// agree: a difference between the settings is a fault, never an expectation.
pub fn project_tests_bless(output: ref OutputTest, outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> ProjectTestsBlessed throws {
    if outcomes.is_empty() {
        return ProjectTestsBlessed::Unchanged
    }
    if !project_tests_agree(outcomes) {
        return ProjectTestsBlessed::Refused("the settings disagree")
    }
    let first = outcomes[0].1
    if !first.ended_well {
        return ProjectTestsBlessed::Refused("the program did not end successfully")
    }
    if first.files.iter().any(fn(file) { file.1 == null }) {
        return ProjectTestsBlessed::Refused("a file its .out/ names was not written")
    }
    if first.passed {
        return ProjectTestsBlessed::Unchanged
    }
    if output.stdout != null {
        fs::write(output.dir.join(f"{output.name}.stdout"), fs::Root::Anywhere, first.stdout.clone())
    }
    if output.stderr != null {
        fs::write(output.dir.join(f"{output.name}.stderr"), fs::Root::Anywhere, first.stderr.bytes)
    }
    for (relative, got) in first.files {
        fs::write(output.dir.join(f"{output.name}.out").join(relative), fs::Root::Anywhere, match got {
            null => Bytes([]),
            written => written.clone(),
        })
    }
    return ProjectTestsBlessed::Written
}
