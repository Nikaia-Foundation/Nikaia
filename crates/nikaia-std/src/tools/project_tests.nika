// **The test runner's discovery, verdicts and each test's work** (P3a, P3b,
// #125): what `crates/nikaia/src/project.rs` did to find a package's output
// tests and test programs, to read what they expect, to say how a run went and
// whether a test passed, to bless it and to explain a failure, moved.
// The loop of `run_tests` over the tests and settings is
// `project_tests_run` (M8), the failures' report
// `project_tests_report_failures` and one test program's build and run
// `project_tests_program_test` (M13c); `project.rs` keeps the `Sandbox`, the
// process spawns (`outcome_of`, the compiler's own runs behind
// `ProjectTestsProgramHost`) and the workers of the test programs, behind
// `ProjectTestsHost`; the structs are Nikaia's and `project.rs` re-exports
// them.
//
// **What a test expects is `Bytes`**: a file is read as bytes and compared as
// bytes, never as text that might not be (ADR-269 D22, ADR-247 D2).

use std::fs
use std::collections

/// **What one test did, at one setting** ([ADR-269](../../../docs/specification/adr/adr-269.md) D1).
pub struct ProjectTestsOutcome {
    /// Whether the process ended successfully.
    pub ended_well: bool,
    pub passed: bool,
    pub stdout: Bytes,
    pub stderr: String,
    /// Each file the test's `NAME.out/` names, and what the program wrote
    /// under that name - nothing where it wrote nothing
    /// ([ADR-247](../../../docs/specification/adr/adr-247.md) D2).
    pub files: Vec[(String, Bytes?)],
    /// A test program's `--bounds` reports, each beside what it expects
    /// (#1069): the file's name (`NAME.bounds`, `NAME.loops.bounds`), what
    /// the file holds and what was reported - one entry per file there is.
    pub bounds: Vec[(String, Bytes, Bytes)],
}

/// **An output test** ([ADR-269](../../../docs/specification/adr/adr-269.md) D13,
/// [ADR-247](../../../docs/specification/adr/adr-247.md) D2): named by a
/// `tests/NAME.stdout` or a `tests/NAME.out/`, with what goes in beside them.
pub struct OutputTest {
    pub name: String,
    /// The package's `tests/`, where its expectations are blessed to.
    pub dir: fs::Path,
    /// `NAME.stdout`, where there is one.
    pub stdout: Bytes?,
    /// `NAME.stderr`, where there is one (ADR-269 D22).
    pub stderr: Bytes?,
    /// `NAME.out/`: each file by the name it has under the working directory.
    pub files: Vec[(String, Bytes)],
    /// `NAME.in/`, copied into the working directory before the run.
    pub inputs: fs::Path?,
    pub stdin: Bytes,
    pub args: Vec[String],
}

/// **A test program** ([ADR-269](../../../docs/specification/adr/adr-269.md)
/// D22): `tests/NAME.nika`, with what it must produce beside it.
pub struct ProgramTest {
    pub name: String,
    pub dir: fs::Path,
    pub stdout: Bytes?,
    /// What it writes to standard error, or, where it is refused, the
    /// compiler's whole message (it starts `error`).
    pub stderr: Bytes?,
    /// `NAME.bounds`: its `--bounds` report at `prove-through-loops:off`
    /// (#1069), where there is one.
    pub bounds: Bytes?,
    /// `NAME.loops.bounds`: the same at `prove-through-loops:on`.
    pub loops_bounds: Bytes?,
}

/// Every file under `dir`, by its name relative to it with `/` between the
/// parts, sorted.
/// A test's file as the project names it: under the root, the rest after it,
/// both names canonical; else, or where either cannot be resolved, as given.
pub fn shown_path(path: ref fs::Path, root: ref fs::Path) -> String {
    let path = fs::canonical(path, fs::Root::Anywhere) catch { path.clone() }
    let root = fs::canonical(root, fs::Root::Anywhere) catch { root.clone() }
    return (path.strip_prefix(root) ?? path).display()
}

fn files_under(dir: ref fs::Path) -> Vec[(String, fs::Path)] throws {
    let mut found: Vec[(String, fs::Path)] = fs::walk(dir, fs::Root::Anywhere).iter().map(fn(name) { (name.text_of(), dir.join(name)) }).collect()
    found.sort()
    return found
}

/// Whether `path` names a directory; a name that is not there names none.
fn project_tests_is_dir(path: ref fs::Path) -> bool {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_dir()
}

/// Whether `path` names a file; a name that is not there names none.
fn project_tests_is_file(path: ref fs::Path) -> bool {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_file()
}

/// A file's bytes, nothing where it is not there; a file that is there and
/// cannot be read is the failure.
fn project_tests_optional(path: ref fs::Path) -> Bytes? throws {
    if !fs::exists(path, fs::Root::Anywhere) {
        return null
    }
    return fs::read(path, fs::Root::Anywhere)
}

/// The names in `dir` that end in `.ending`, without it, sorted: a test's
/// name is the file's stem.
fn project_tests_stems(dir: ref fs::Path, ending: String, want_dir: bool) -> collections::BTreeSet[String] {
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    let entries = fs::read_dir(dir, fs::Root::Anywhere) catch { return names }
    for name in entries.iter() {
        let text = name.text_of()
        let stem: String = (text.strip_suffix(ending) ?? "").clone()
        if stem.is_empty() {
            continue
        }
        let path = dir.join(name)
        let right = match want_dir {
            true => project_tests_is_dir(path),
            false => project_tests_is_file(path),
        }
        if right {
            names.insert(stem)
        }
    }
    return names
}

/// The package's output tests, by name. A `tests/` that is not there holds
/// none; a file that is there and cannot be read is an error, not a test that
/// quietly has no input.
pub fn output_tests(root: ref fs::Path) -> Vec[OutputTest] throws {
    let dir = root.join("tests")
    let mut names = project_tests_stems(dir, ".stdout", false)
    names.extend(project_tests_stems(dir, ".out", true))
    let mut tests: Vec[OutputTest] = []
    for name in names {
        // A `NAME.nika` beside them makes the files that program's (D22).
        if project_tests_is_file(dir.join(f"{name}.nika")) {
            continue
        }
        let stdout = project_tests_optional(dir.join(f"{name}.stdout"))
        let out = dir.join(f"{name}.out")
        let mut files: Vec[(String, Bytes)] = []
        if project_tests_is_dir(out) {
            for (relative, path) in files_under(out) {
                files.push((relative, fs::read(path, fs::Root::Anywhere)))
            }
        }
        let given = dir.join(f"{name}.in")
        let inputs: fs::Path? = match project_tests_is_dir(given) {
            true => given,
            false => null,
        }
        let stdin = project_tests_optional(dir.join(f"{name}.stdin")) ?? Bytes([])
        let mut args: Vec[String] = []
        let listed = project_tests_optional(dir.join(f"{name}.args"))
        if listed != null {
            let bytes = listed ?? Bytes([])
            args = bytes.text().lines().map(fn(line) { line.clone() }).collect()
        }
        let stderr = project_tests_optional(dir.join(f"{name}.stderr"))
        tests.push(OutputTest { name: name.clone(), dir: root.join("tests"), stdout: stdout, stderr: stderr, files: files, inputs: inputs, stdin: stdin, args: args })
    }
    return tests
}

/// Copy every file under `from` to the same name under `to`, making the
/// directories on the way.
pub fn copy_into(from: ref fs::Path, to: ref fs::Path) throws {
    for (relative, path) in files_under(from) {
        let target = to.join(relative)
        match target.parent() {
            null => {}
            parent => fs::create_dir(parent, fs::Root::Anywhere; recursive: true),
        }
        fs::copy(path, target, fs::Root::Anywhere)
    }
}

/// The package's test programs, by name.
pub fn program_tests(root: ref fs::Path) -> Vec[ProgramTest] throws {
    let dir = root.join("tests")
    let mut tests: Vec[ProgramTest] = []
    for name in project_tests_stems(dir, ".nika", false) {
        let stdout = project_tests_optional(dir.join(f"{name}.stdout"))
        let stderr = project_tests_optional(dir.join(f"{name}.stderr"))
        let bounds = project_tests_optional(dir.join(f"{name}.bounds"))
        let loops_bounds = project_tests_optional(dir.join(f"{name}.loops.bounds"))
        tests.push(ProgramTest { name: name.clone(), dir: root.join("tests"), stdout: stdout, stderr: stderr, bounds: bounds, loops_bounds: loops_bounds })
    }
    return tests
}

/// The `.bounds` and `.loops.bounds` files in the package's `tests/` with no
/// test program beside them (#1069), by file name: each is an error, not an
/// expectation nothing checks.
pub fn project_tests_stray_bounds(root: ref fs::Path) -> Vec[String] {
    let dir = root.join("tests")
    let mut stray: Vec[String] = []
    for stem in project_tests_stems(dir, ".bounds", false) {
        let short: String = (stem.strip_suffix(".loops") ?? "").clone()
        let beside = project_tests_is_file(dir.join(f"{stem}.nika")) || (!short.is_empty() && project_tests_is_file(dir.join(f"{short}.nika")))
        if !beside {
            stray.push(f"{stem}.bounds")
        }
    }
    return stray
}

/// **The part of `check --bounds`'s output about the test program**
/// (#1069): the report whose first line names `written` (`tests/NAME.nika`,
/// the path already rewritten so), and the lines under it. The first line's
/// tail, what this build writes without its check, is cut: it depends on the
/// build, what is proved does not (ADR-306 D14).
pub fn project_tests_bounds_report(printed: String, written: String) -> Bytes {
    let head = f"bounds in {written}: "
    let mut report: String = ""
    let mut inside = false
    for line in printed.lines() {
        if inside {
            if !line.starts_with(" ") {
                break
            }
            report.push_str(line)
            report.push_str("\n")
            continue
        }
        if line.starts_with(head) {
            inside = true
            let cut = line.find(" - written without their check: ")
            if cut != null {
                let at = cut ?? 0
                report.push_str(line[0..<at])
            } else {
                report.push_str(line)
            }
            report.push_str("\n")
        }
    }
    return report.bytes.clone()
}

/// **A test program's outcome with its `--bounds` reports compared**
/// (#1069): `off` and `on` are what `check --bounds` printed for it at
/// `prove-through-loops:off` and `:on`, its path written `tests/NAME.nika`.
/// Each report its `.bounds` or `.loops.bounds` expects must be that file,
/// byte for byte, or the test fails.
pub fn project_tests_bounds_outcome(program: ref ProgramTest, outcome: ref ProjectTestsOutcome, off: String, on: String) -> ProjectTestsOutcome {
    let written = f"tests/{program.name}.nika"
    let mut bounds: Vec[(String, Bytes, Bytes)] = []
    match program.bounds {
        null => {},
        want => bounds.push((f"{program.name}.bounds", want.clone(), project_tests_bounds_report(off, written))),
    }
    match program.loops_bounds {
        null => {},
        want => bounds.push((f"{program.name}.loops.bounds", want.clone(), project_tests_bounds_report(on, written))),
    }
    let right = bounds.iter().all(fn(entry) { entry.1 == entry.2 })
    return ProjectTestsOutcome { ended_well: outcome.ended_well, passed: outcome.passed && right, stdout: outcome.stdout.clone(), stderr: outcome.stderr.clone(), files: outcome.files.clone(), bounds: bounds }
}

/// What a test program's `--bounds` reports got wrong, as differences
/// (#1069).
pub fn project_tests_explain_bounds(outcome: ref ProjectTestsOutcome) {
    for (name, want, got) in outcome.bounds {
        if want != got {
            println(f"tests/{name} (- expected, + reported):")
            print(project_tests_difference(want, got))
        }
    }
}

/// Whether a stderr file holds a compiler's refusal, whatever stage produced
/// it: a checker's `error[NK…]` or a parse error's plain `error:` (ADR-269 D22,
/// #834). rustc's own failure is told apart by its `could not compile`.
pub fn is_refusal(text: String) -> bool {
    return (text.starts_with("error") || text.contains("\nerror")) && !does_not_compile(text)
}

/// Whether the build failed in rustc: not a refusal by the Nikaia compiler.
pub fn does_not_compile(text: String) -> bool {
    return text.contains("could not compile")
}

/// What names an output test in its report: its `.stdout`, or its `.out/`.
pub fn named_by(output: ref OutputTest) -> String {
    return match output.stdout != null {
        true => f"{output.name}.stdout",
        false => f"{output.name}.out/",
    }
}

/// **A line difference** ([ADR-247](../../../docs/specification/adr/adr-247.md)
/// D4): `-` an expected line, `+` a produced one, and two lines of context
/// around each change, from a longest common subsequence of the lines.
pub fn project_tests_difference(expected: ref Bytes, produced: ref Bytes) -> String {
    let want = expected.text() catch { return "  the bytes differ, and they are not text\n" }
    let got = produced.text() catch { return "  the bytes differ, and they are not text\n" }
    // **The lines are Nikaia's** (`tools/diffs.nika`, #125).
    return differing_lines(want, got)
}

/// Whether every setting did the same.
pub fn project_tests_agree(outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> bool {
    return (1..<outcomes.len()).all(fn(at) { outcomes[at - 1].1 == outcomes[at].1 })
}

/// Print one test's line, and say whether it passed: at every setting, and the
/// same way at each.
pub fn project_tests_verdict(label: String, outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> bool {
    let agree = project_tests_agree(outcomes)
    let passed = agree && (0..<outcomes.len()).all(fn(at) { outcomes[at].1.passed })
    let said = match (passed, agree) {
        (true, _) => "ok",
        (false, true) => "FAILED",
        (false, false) => "FAILED (the settings disagree)",
    }
    println(f"{label} ... {said}")
    return passed
}

/// The first line `nikaia test` prints: how many tests it runs.
pub fn project_tests_running(total: i64) {
    let plural = match total == 1 {
        true => "",
        false => "s",
    }
    println(f"running {total} test{plural}")
}

/// The last line `nikaia test` prints, and the exit code it ends with.
pub fn project_tests_result(total: i64, failed: i64) -> i32 {
    let passed = total - failed
    let said = match failed == 0 {
        true => "ok",
        false => "FAILED",
    }
    println(f"\ntest result: {said}. {passed} passed; {failed} failed")
    return match failed == 0 {
        true => 0,
        false => 1,
    }
}

/// How an output test names itself in its line.
pub fn project_tests_output_label(output: ref OutputTest) -> String {
    return f"output \"{output.name}\" (tests/{named_by(output)})"
}

/// How a test program names itself in its line.
pub fn project_tests_program_label(program: ref ProgramTest) -> String {
    return f"program \"{program.name}\" (tests/{program.name}.nika)"
}

/// Whether a test wrote the `at`th file its `.out/` names, byte for byte.
fn project_tests_wrote(got: ref Vec[(String, Bytes?)], want: ref Vec[(String, Bytes)], at: i64) -> bool {
    return match got[at].1 {
        null => false,
        written => written == want[at].1,
    }
}

/// A file a test may have written, nothing where it wrote none.
fn project_tests_written(path: ref fs::Path) -> Bytes? {
    return fs::read(path, fs::Root::Anywhere) catch { null }
}

/// **How an output test went at one setting**
/// ([ADR-247](../../../docs/specification/adr/adr-247.md) D2): the program
/// ran in `own` and ended as `ended_well` says, printing `stdout` and `stderr`.
/// It passed where it ended successfully, printed what its `.stdout` and
/// `.stderr` hold, where it has them, and left each file its `.out/` names
/// byte for byte.
pub fn project_tests_output_outcome(output: ref OutputTest, own: ref fs::Path, ended_well: bool, stdout: Bytes, stderr: String) -> ProjectTestsOutcome {
    let files: Vec[(String, Bytes?)] = output.files.iter().map(fn(file) { (file.0.clone(), project_tests_written(own.join(file.0))) }).collect()
    let printed_right = match output.stdout {
        null => true,
        want => want == stdout,
    }
    let said_right = match output.stderr {
        null => true,
        want => want == stderr.bytes,
    }
    let wrote_right = (0..<output.files.len()).all(fn(at) { project_tests_wrote(files, output.files, at) })
    return ProjectTestsOutcome { ended_well: ended_well, passed: ended_well && printed_right && said_right && wrote_right, stdout: stdout, stderr: stderr, files: files, bounds: [] }
}

/// **A test program the compiler did not build**: `stderr` is what it said,
/// with the path written `tests/NAME.nika`. A refusal passes where it is the
/// program's `.stderr`, word for word; a build that failed in rustc is no
/// refusal and never passes.
pub fn project_tests_refused_outcome(program: ref ProgramTest, stderr: String) -> ProjectTestsOutcome {
    let broken = !is_refusal(stderr)
    let shown = match broken {
        true => f"the program does not compile (rustc failed, not a refusal):\n{stderr}",
        false => stderr.clone(),
    }
    let passed = !broken && match program.stderr {
        null => false,
        want => want == shown.bytes,
    }
    return ProjectTestsOutcome { ended_well: false, passed: passed, stdout: Bytes([]), stderr: shown, files: [], bounds: [] }
}

/// **A test program that built and ran**: it passed where it ended
/// successfully and printed what its `.stdout` and `.stderr` hold, where it has
/// them. A `.stderr` holding a refusal expects one, so a run never matches it.
pub fn project_tests_ran_outcome(program: ref ProgramTest, ended_well: bool, stdout: Bytes, said: String) -> ProjectTestsOutcome {
    let printed_right = match program.stdout {
        null => true,
        want => want == stdout,
    }
    let said_right = match program.stderr {
        null => true,
        want => !is_refusal(want.text() catch { "" }) && want == said.bytes,
    }
    return ProjectTestsOutcome { ended_well: ended_well, passed: ended_well && printed_right && said_right, stdout: stdout, stderr: said, files: [], bounds: [] }
}

/// A step of a test program's run that failed, in the words the compiler
/// reports.
pub enum ProjectTestsRefusal {
    Refused(String),
}

impl Error for ProjectTestsRefusal {
    fn message(ref self) -> String {
        return match self {
            ProjectTestsRefusal::Refused(why) => why.clone(),
        }
    }
}

/// How one process of a test program's run ended, and its two streams as
/// they came.
pub struct ProjectTestsRan {
    pub ended_well: bool,
    pub stdout: Bytes,
    pub stderr: Bytes,
}

/// What `project_tests_program_test` asks of the compiler (`project.rs`'s
/// `ProgramHost`): the manifest it reads and the processes it starts, each in
/// `own`, with no standard input and no `CARGO_TARGET_DIR`. A refusal of a
/// `throws` method is kept there and handed back unchanged.
pub trait ProjectTestsProgramHost {
    /// The package name `root`'s `nikaia.toml` gives; nothing where it names
    /// none.
    fn package_name(ref self, root: ref fs::Path) -> String? sync throws
    /// This compiler's `VERB --user-parallelism SETTING --project PROJECT`,
    /// with `own` as the test's directory; a `build` keeps Cargo quiet.
    fn compiler(ref self, verb: ref String, setting: ref String, project: ref fs::Path, own: ref fs::Path) -> ProjectTestsRan sync throws
    /// This compiler's `check --bounds --optimization LEVEL ENTRY`: what it
    /// printed.
    fn bounds(ref self, level: ref String, entry: ref fs::Path, own: ref fs::Path) -> Bytes sync throws
    /// The program the build of `project` made, run directly where the build
    /// puts it (`project_settings_own_copy`'s place, with no variant); nothing
    /// where it is not there.
    fn built(ref self, project: ref fs::Path, own: ref fs::Path) -> ProjectTestsRan? sync throws
}

/// Remove everything in `dir` but the entry named `keep`; a `dir` that cannot
/// be read holds nothing to remove.
fn project_tests_empty_but(dir: ref fs::Path, keep: String) throws {
    let names = fs::read_dir(dir, fs::Root::Anywhere) catch { return }
    for name in names {
        if name.text_of() == keep {
            continue
        }
        let path = dir.join(name)
        fs::remove(path, fs::Root::Anywhere; recursive: true) catch { throw ProjectTestsRefusal::Refused(f"emptying {path.display()}: {error}") }
    }
}

/// What a run of the program at `entry` said, read as UTF-8 lossily
/// (#1182), with the program's path written `written` (`tests/NAME.nika`).
fn project_tests_relocated(said: ref Bytes, entry: ref fs::Path, written: String) -> String {
    return said.text_lossy().replace(entry.display(), written).replace(project_members_canonical(entry).display(), written)
}

/// Both streams of a process, one after the other.
fn project_tests_joined(first: ref Bytes, then: ref Bytes) -> Bytes {
    let mut all: Vec[u8] = first.iter().collect()
    all.extend(then.iter())
    return Bytes(all)
}

/// **Build and run one test program** in a package of its own, in a directory
/// of its own: the package it tests is its dependency, so `use` reaches it. A
/// refusal is the outcome (`ended_well` false, `stderr` the message with the
/// path written `tests/NAME.nika`); a program that builds is run there.
///
/// **The directory, `own`, is kept for the next program at this setting**,
/// with only the package's `target/` left in it: the package then stays at
/// one path, so Cargo finds the tested package it depends on built and
/// compiles only the program, where a new path each time made it compile the
/// tested package again for every program. What the program sees is what a
/// new directory held: `project/` with the manifest and `src/main.nika`, and
/// no ledger, lock or file a program before it left.
///
/// **The built program is run directly**, not through a second `nikaia run`:
/// that one would build again only to find nothing changed, and then do what
/// is done here - start the binary in the same directory, with the same
/// variables and no standard input, as a child of this process (its own
/// process replaced by the program, #281). What the run wrote before the
/// program started, the build's warnings, is the build's standard error with
/// Cargo kept quiet as `run` keeps it (`CARGO_TERM_QUIET`).
pub fn project_tests_program_test[H: ProjectTestsProgramHost](host: ref H, program: ref ProgramTest, root: ref fs::Path, setting: String, own: ref fs::Path) -> ProjectTestsOutcome throws {
    let project = own.join("project")
    project_tests_empty_but(own, "project")
    project_tests_empty_but(project, "target")
    fs::create_dir(project.join("src"), fs::Root::Anywhere; recursive: true)
    let source = program.dir.join(f"{program.name}.nika")
    let entry = project.join("src").join("main.nika")
    fs::copy(source, entry, fs::Root::Anywhere) catch { throw ProjectTestsRefusal::Refused(f"copying {source.display()}: {error}") }
    let dependency: String = match host.package_name(root) {
        null => "",
        name => {
            let at = project_members_canonical(root).display()
            f"\n[dependencies]\n{name} = {{ path = {at:?} }}\n"
        }
    }
    fs::write(project.join("nikaia.toml"), fs::Root::Anywhere, f"[package]\nname = \"program_test\"\nversion = \"0.1.0\"\n{dependency}")
    let written = f"tests/{program.name}.nika"
    // **The `--bounds` reports a `.bounds` or `.loops.bounds` expects**
    // (#1069), as `check --bounds` computes them for the program; what is
    // proved does not depend on the build's settings (ADR-306 D14).
    let mut off: String = ""
    if program.bounds != null {
        off = project_tests_relocated(host.bounds("prove-through-loops:off", entry, own), entry, written)
    }
    let mut on: String = ""
    if program.loops_bounds != null {
        on = project_tests_relocated(host.bounds("prove-through-loops:on", entry, own), entry, written)
    }
    let built = host.compiler("build", setting, project, own)
    if !built.ended_well {
        let refused = project_tests_refused_outcome(program, project_tests_relocated(built.stderr, entry, written))
        return project_tests_bounds_outcome(program, refused, off, on)
    }
    // Where the program is not where it is expected, `nikaia run` finds it.
    let ran = match host.built(project, own) {
        null => {
            let out = host.compiler("run", setting, project, own)
            let said = out.stderr.clone()
            (out, said)
        }
        out => {
            let said = project_tests_joined(built.stderr, out.stderr)
            (out, said)
        }
    }
    let (out, said) = ran
    let outcome = project_tests_ran_outcome(program, out.ended_well, out.stdout, project_tests_relocated(said, entry, written))
    return project_tests_bounds_outcome(program, outcome, off, on)
}

/// What `--bless` did with one test.
pub enum ProjectTestsBlessed {
    Unchanged,
    Written,
    /// Not blessed, and why.
    Refused(String),
}

/// Print a blessed test's line, and say whether it passed: one that could
/// not be blessed failed.
pub fn project_tests_blessed_line(label: String, blessed: ref ProjectTestsBlessed) -> bool {
    match blessed {
        ProjectTestsBlessed::Unchanged => println(f"{label} ... ok"),
        ProjectTestsBlessed::Written => println(f"{label} ... blessed"),
        ProjectTestsBlessed::Refused(why) => {
            println(f"{label} ... FAILED ({why}, so it is not blessed)")
            return false
        },
    }
    return true
}

/// `--bless` for a test program: `NAME.stdout` and `NAME.stderr` are written
/// from what happened, a refusal into `NAME.stderr` only, `NAME.stdout` made where the
/// test has none and printed something (#1238), and the `--bounds`
/// reports into the `NAME.bounds` and `NAME.loops.bounds` there are (#1069). A program that
/// built and ended unsuccessfully, or whose settings disagree, is not blessed.
pub fn project_tests_bless_program(program: ref ProgramTest, outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> ProjectTestsBlessed throws {
    if outcomes.is_empty() {
        return ProjectTestsBlessed::Unchanged
    }
    if !project_tests_agree(outcomes) {
        return ProjectTestsBlessed::Refused("the settings disagree")
    }
    let first = outcomes[0].1
    let refused = !first.ended_well && is_refusal(first.stderr)
    if !first.ended_well && !refused && first.stderr.starts_with("the program does not compile") {
        return ProjectTestsBlessed::Refused("the program does not compile")
    }
    if !first.ended_well && !refused {
        return ProjectTestsBlessed::Refused("the program did not end successfully")
    }
    // A test with no `.stdout` passes whatever it prints: what it printed
    // becomes its expectation (#1238). A new `.stderr` is never made, so
    // warnings are never blessed (Part III 14.1).
    let new_stdout = !refused && program.stdout == null && !first.stdout.is_empty()
    if first.passed && !new_stdout {
        return ProjectTestsBlessed::Unchanged
    }
    if !refused && (program.stdout != null || new_stdout) {
        fs::write(program.dir.join(f"{program.name}.stdout"), fs::Root::Anywhere, first.stdout.clone())
    }
    if refused || program.stderr != null {
        fs::write(program.dir.join(f"{program.name}.stderr"), fs::Root::Anywhere, first.stderr.bytes)
    }
    for (name, _, got) in first.bounds {
        fs::write(program.dir.join(name), fs::Root::Anywhere, got.clone())
    }
    return ProjectTestsBlessed::Written
}

/// **What an output test got wrong, as differences**
/// ([ADR-247](../../../docs/specification/adr/adr-247.md) D4).
pub fn project_tests_explain_output(output: ref OutputTest, outcome: ref ProjectTestsOutcome) {
    if !outcome.ended_well {
        println("the program did not end successfully")
    }
    match output.stdout {
        null => {},
        want => {
            if want != outcome.stdout {
                println("standard output (- expected, + printed):")
                print(project_tests_difference(want, outcome.stdout))
            }
        },
    }
    match output.stderr {
        null => {},
        want => {
            if want != outcome.stderr.bytes {
                println("standard error (- expected, + written):")
                print(project_tests_difference(want, outcome.stderr.bytes))
            }
        },
    }
    for (wanted, written) in output.files.iter().zip(outcome.files.iter()) {
        let relative = wanted.0
        let want = wanted.1
        match written.1 {
            null => println(f"{relative}: not written"),
            got => {
                if got != want {
                    println(f"{relative} (- expected, + written):")
                    print(project_tests_difference(want, got))
                }
            },
        }
    }
}

/// **`--bless`** ([ADR-247](../../../docs/specification/adr/adr-247.md) D3):
/// what the program printed becomes `NAME.stdout`, where the test has one,
/// and each file it wrote becomes the `NAME.out/` entry of that name. Only a
/// run that ended successfully, and at two settings only one whose runs
/// agree: a difference between the settings is a fault, never an expectation.
pub fn project_tests_bless(output: ref OutputTest, outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> ProjectTestsBlessed throws {
    if outcomes.is_empty() {
        return ProjectTestsBlessed::Unchanged
    }
    if !project_tests_agree(outcomes) {
        return ProjectTestsBlessed::Refused("the settings disagree")
    }
    let first = outcomes[0].1
    if !first.ended_well {
        return ProjectTestsBlessed::Refused("the program did not end successfully")
    }
    if first.files.iter().any(fn(file) { file.1 == null }) {
        return ProjectTestsBlessed::Refused("a file its .out/ names was not written")
    }
    if first.passed {
        return ProjectTestsBlessed::Unchanged
    }
    if output.stdout != null {
        fs::write(output.dir.join(f"{output.name}.stdout"), fs::Root::Anywhere, first.stdout.clone())
    }
    if output.stderr != null {
        fs::write(output.dir.join(f"{output.name}.stderr"), fs::Root::Anywhere, first.stderr.bytes)
    }
    for (relative, got) in first.files {
        fs::write(output.dir.join(f"{output.name}.out").join(relative), fs::Root::Anywhere, match got {
            null => Bytes([]),
            written => written.clone(),
        })
    }
    return ProjectTestsBlessed::Written
}

/// **A test that failed** (`run_tests`'s list): its line's label, what each
/// setting did, and the output test it is, where it is one.
pub struct ProjectTestsFailed {
    pub label: String,
    pub outcomes: Vec[(String, ProjectTestsOutcome)],
    pub output: OutputTest?,
}

/// What `project_tests_run` asks of the compiler (`project.rs`'s
/// `TestsHost`): each run of a built program in a sandbox of its own, and the
/// test programs, which build and run on the host's workers. A refusal of a
/// `throws` method is kept there and handed back unchanged.
pub trait ProjectTestsHost {
    /// Runs test block `k` with the test build `binary`, in the package's
    /// directory: how it ended and what it printed.
    fn block_outcome(ref self, binary: ref fs::Path, k: i64) -> ProjectTestsOutcome sync throws
    /// Runs `output` with the program `binary`, its inputs copied into its
    /// sandbox: what it did.
    fn output_outcome(ref self, binary: ref fs::Path, output: ref OutputTest) -> ProjectTestsOutcome sync throws
    /// Runs the test programs, each one's line said by
    /// `project_tests_program_done` in the order of the programs; the ones
    /// that failed.
    fn program_failures(ref self, bless: bool) -> Vec[ProjectTestsFailed] sync throws
}

/// **One test program's line**, blessed where `bless` says: the failure,
/// where it failed.
pub fn project_tests_program_done(program: ref ProgramTest, outcomes: Vec[(String, ProjectTestsOutcome)], bless: bool) -> ProjectTestsFailed? throws {
    let label = project_tests_program_label(program)
    if bless {
        let blessed = project_tests_bless_program(program, outcomes)
        if !project_tests_blessed_line(label, blessed) {
            return ProjectTestsFailed { label: label, outcomes: outcomes, output: null }
        }
        return null
    }
    if !project_tests_verdict(label, outcomes) {
        return ProjectTestsFailed { label: label, outcomes: outcomes, output: null }
    }
    return null
}

/// **The failures' report** (`run_tests`): each failed test's label, then
/// what it did - once where the settings agree, else at each setting - with a
/// test program's standard output read as UTF-8 lossily (#1182) and each
/// standard error as it came.
pub fn project_tests_report_failures(failed: ref Vec[ProjectTestsFailed]) {
    if failed.is_empty() {
        return
    }
    println("\nfailures:")
    for one in failed {
        println(f"\n--- {one.label}")
        let agree = project_tests_agree(one.outcomes)
        let shown = match agree {
            true => 1,
            false => one.outcomes.len(),
        }
        for (setting, outcome) in one.outcomes[0..<shown] {
            if !agree {
                println(f"at user-parallelism = {setting}:")
            }
            match one.output {
                null => {
                    print(outcome.stdout.text_lossy())
                    project_tests_explain_bounds(outcome)
                }
                output => project_tests_explain_output(output, outcome),
            }
            eprint(outcome.stderr)
        }
    }
}

/// **Run each test in a process and a directory of its own, and say how each
/// went** ([ADR-269](../../../docs/specification/adr/adr-269.md) D1, D12, D13;
/// [ADR-247](../../../docs/specification/adr/adr-247.md)): the `test` blocks
/// (`blocks`, each its title, file and line) at each of `test_builds`, the
/// output tests at each of `programs`, then the test programs: the ones that
/// failed, for the failures' report (`project_tests_report_failures`).
///
/// A `test` block fails on an error that leaves it, a false `assert` or a
/// `panic` - each of which ends its process unsuccessfully. An output test
/// fails where the program does not end successfully, or prints anything but
/// its `.stdout`, or leaves any file its `.out/` names other than byte for
/// byte. At two settings either fails as well where the two outcomes differ,
/// because the meaning of a program is the same at both (Part I 1.2) and a
/// difference is a fault of this compiler. A failing test does not stop the
/// others.
pub fn project_tests_run[H: ProjectTestsHost](host: ref H, blocks: ref Vec[(String, fs::Path, i64)], test_builds: ref Vec[(String, fs::Path)], outputs: ref Vec[OutputTest], programs: ref Vec[(String, fs::Path)], program_tests: i64, root: ref fs::Path, bless: bool) -> Vec[ProjectTestsFailed] throws {
    let total = blocks.len() + outputs.len() + program_tests
    project_tests_running(total)
    let mut failed: Vec[ProjectTestsFailed] = []
    for (k, (title, path, line)) in blocks.iter().enumerate() {
        let mut outcomes: Vec[(String, ProjectTestsOutcome)] = []
        for (setting, binary) in test_builds {
            outcomes.push((setting.clone(), host.block_outcome(binary, k)))
        }
        let label = f"test \"{title}\" ({shown_path(path, root)}:{line})"
        if !project_tests_verdict(label, outcomes) {
            failed.push(ProjectTestsFailed { label: label, outcomes: outcomes, output: null })
        }
    }
    for output in outputs {
        let mut outcomes: Vec[(String, ProjectTestsOutcome)] = []
        for (setting, binary) in programs {
            outcomes.push((setting.clone(), host.output_outcome(binary, output)))
        }
        let label = project_tests_output_label(output)
        if bless {
            let blessed = project_tests_bless(output, outcomes)
            if !project_tests_blessed_line(label, blessed) {
                failed.push(ProjectTestsFailed { label: label, outcomes: outcomes, output: output.clone() })
            }
            continue
        }
        if !project_tests_verdict(label, outcomes) {
            failed.push(ProjectTestsFailed { label: label, outcomes: outcomes, output: output.clone() })
        }
    }
    for program in host.program_failures(bless) {
        failed.push(program)
    }
    return failed
}

/// **Whether `nikaia test --filter` runs the test named `name`** (#1238):
/// every test where no filter is given, else the ones whose name holds one of
/// the texts.
pub fn project_tests_wanted(name: ref String, filters: ref Vec[String]) -> bool {
    return filters.is_empty() || filters.iter().any(fn(text) { name.contains(text) })
}
