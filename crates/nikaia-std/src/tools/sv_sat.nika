// crates/nikaia-std/src/tools/sv_sat.nika
//
// **The SAT core** (ADR-270 D12, D16, #1283 item 1): conflict-driven clause
// learning over the literals of `sv_proof.nika` (`2a` atom `a`, `2a + 1` its
// negation: `variable << 1 | sign`), every clause it derives written to the
// proof log with the hints `sv_check.nika` replays it by.
//
// * **Clauses** live in one `u32` arena, each a header of three words - its
//   size, `glue << 2 | deleted << 1 | learned`, its entry in the log - and
//   its literals; a clause is named by the place of its header. The first two
//   literals are the watched ones.
// * **Watch lists** per literal hold the clauses watching it, each entry a
//   clause and a *blocking literal*: where that literal is true the clause is
//   not read. A binary clause carries its other literal as the blocker and
//   the high bit in its name, so it is never read from the arena.
// * **Search**: unit propagation, first-UIP conflict analysis, backjumping
//   to the second highest level of the learned clause, VSIDS activity in a
//   heap with saved phases, restarts by the Luby sequence.
// * **The clause database** is reduced by glue (the number of decision
//   levels of a learned clause, at its learning): at a restart once enough
//   conflicts passed, half of the learned clauses of glue above two go, the
//   worst glue first, and the arena is compacted once half of it is dead.
// * **The log**: a literal fixed at level zero has a unit clause in the log -
//   an input, a learned unit, or learned at once from its reason and the
//   units of the reason's other literals; a learned clause's hints are the
//   units of the level-zero literals the analysis met, then the reasons it
//   resolved on in the order they were assigned, then the conflict - each
//   unit in turn when the clause is assumed false (LRAT).
//
// Integers only: activities are `i64`, rescaled before they reach `2^60`.

use std::collections

/// What a search answered.
pub enum SvSatAnswer {
	Sat,
	Unsat,
	Unknown,
}

/// What a search did, counted.
pub struct SvSatStats {
	pub decisions: i64,
	pub propagations: i64,
	pub conflicts: i64,
	pub learned: i64,
	pub deleted: i64,
	pub restarts: i64,
	pub reductions: i64,
	pub compactions: i64,
}

/// What one conflict's analysis learned: the clause (its asserting literal
/// first, a literal of the backjump level second), its hints, the level it
/// jumps back to and its glue.
struct SvLearned {
	lits: Vec[u32],
	hints: Vec[u32],
	level: i64,
	glue: i64,
}

/// The solver: its book (the log, shared with a theory), its clauses and its
/// assignment.
pub struct SvSat {
	pub book: SvBook,
	pub stats: SvSatStats,
	/// Whether the log holds the empty clause.
	pub refuted: bool,
	/// Conflicts before the first reduction, and how many more before each
	/// next one.
	pub reduce_first: i64,
	pub reduce_step: i64,
	/// The conflicts of one Luby unit between restarts.
	pub restart_unit: i64,
	arena: Vec[u32],
	/// The words of deleted clauses still in the arena.
	wasted: i64,
	learnts: Vec[u32],
	/// Per literal: the clauses watching it, and their blocking literals.
	watch_clause: Vec[Vec[u32]],
	watch_blocker: Vec[Vec[u32]],
	/// Per variable: `1` true, `-1` false, `0` open; its level; the clause
	/// that implied it or `-1`; the log entry of its unit clause at level
	/// zero or `-1`.
	value: Vec[i64],
	level: Vec[i64],
	reason: Vec[i64],
	unit: Vec[i64],
	trail: Vec[u32],
	/// Where each decision level starts on the trail.
	limits: Vec[i64],
	/// The shortest the trail was cut to by a backjump since `sv_smt.nika`
	/// last looked (it hands the theory the trail from there again).
	pub undone: i64,
	/// The next trail entry to propagate.
	head: i64,
	activity: Vec[i64],
	bump: i64,
	/// The decision heap: variables by activity, the highest on top, and
	/// each variable's place in it or `-1`.
	heap: Vec[u32],
	place: Vec[i64],
	phase: Vec[bool],
	seen: Vec[bool],
	next_reduce: i64,
}

/// The variable of literal `l`.
fn sv_sat_var(l: u32) -> i64 {
	return (l >> 1) as i64
}

/// The `i`-th term (from zero) of the Luby sequence 1 1 2 1 1 2 4 ...
fn sv_luby(i: i64) -> i64 {
	let mut size: i64 = 1
	let mut seq: i64 = 0
	while size < i + 1 {
		seq += 1
		size = 2 * size + 1
	}
	let mut x = i
	while size - 1 != x {
		size = (size - 1) / 2
		seq -= 1
		x = x % size
	}
	let mut out: i64 = 1
	while seq > 0 {
		out = out * 2
		seq -= 1
	}
	return out
}

/// A solver over `vars` variables writing to `log`.
pub fn sv_sat(vars: u32, log: SvLog) -> SvSat {
	return sv_sat_book(
		vars,
		SvBook {
			log: log,
			atoms: [],
			bounds: collections::BTreeMap(),
			pre: collections::BTreeMap(),
			reals: [],
		},
	)
}

/// A solver over `vars` variables writing to `book`, which a theory shares
/// (`sv_smt.nika`).
fn sv_sat_book(vars: u32, book: SvBook) -> SvSat {
	let mut s = SvSat {
		book: book,
		stats: SvSatStats {
			decisions: 0,
			propagations: 0,
			conflicts: 0,
			learned: 0,
			deleted: 0,
			restarts: 0,
			reductions: 0,
			compactions: 0,
		},
		refuted: false,
		reduce_first: 2000,
		reduce_step: 300,
		restart_unit: 100,
		arena: [],
		wasted: 0,
		learnts: [],
		watch_clause: [],
		watch_blocker: [],
		value: [],
		level: [],
		reason: [],
		unit: [],
		trail: [],
		limits: [],
		head: 0,
		undone: 0,
		activity: [],
		bump: 65536,
		heap: [],
		place: [],
		phase: [],
		seen: [],
		next_reduce: 2000,
	}
	let mut v: u32 = 0
	while v < vars {
		s.watch_clause.push([])
		s.watch_clause.push([])
		s.watch_blocker.push([])
		s.watch_blocker.push([])
		s.value.push(0)
		s.level.push(0)
		s.reason.push(-1)
		s.unit.push(-1)
		s.activity.push(0)
		s.place.push(-1)
		s.phase.push(false)
		s.seen.push(false)
		s.heap_insert(v)
		v += 1
	}
	return s
}

/// A solver over `query`'s atoms with every clause of `query` read as an
/// input of a fresh log; `null` where the atoms leave `u32`.
pub fn sv_sat_of(query: ref SvQuery) -> SvSat? {
	let log = sv_log(query) ?? return null
	let mut s = sv_sat(log.atoms, log)
	let mut c: u32 = 0
	for clause in query.clauses {
		let id = s.book.log.input(c)
		s.add_input(clause, id)
		c += 1
	}
	return s
}

impl SvSat {
	/// `1` where literal `l` is true, `-1` where false, `0` where open.
	fn lit_value(ref self, l: u32) -> i64 {
		let v = self.value[sv_sat_var(l)]
		return if l % 2 == 0 { v } else { -v }
	}

	/// Whether literal `l` is true in the assignment (the model, after
	/// `Sat`).
	pub fn holds(ref self, l: u32) -> bool {
		return self.lit_value(l) > 0
	}

	/// Per variable, whether it is true; an open variable counts as false.
	pub fn model(ref self) -> Vec[bool] {
		let mut out: Vec[bool] = []
		for v in self.value {
			out.push(v > 0)
		}
		return out
	}

	fn decision_level(ref self) -> i64 {
		return self.limits.len()
	}

	/// Adds the clause `lits`, entry `id` of the log, at level zero: a
	/// literal true there drops the clause, one false there drops out of it
	/// (the shorter clause learned from the units), what is left is a unit
	/// to assign, the empty clause, or a clause to watch.
	fn add_input(ref mut self, lits: ref Vec[u32], id: u32) {
		if self.refuted {
			return
		}
		let mut sorted = lits.clone()
		sorted.sort()
		let mut kept: Vec[u32] = []
		let mut hints: Vec[u32] = []
		let mut changed = false
		let mut i = 0
		while i < sorted.len() {
			let l = sorted[i]
			let before: u32 = if i > 0 { sorted[i - 1] } else { l ^ 1 }
			i += 1
			if i > 1 && before == l {
				changed = true
				continue
			}
			if i > 1 && before == (l ^ 1) {
				// A tautology: always true.
				return
			}
			let v = self.lit_value(l)
			if v > 0 {
				return
			}
			if v < 0 {
				changed = true
				hints.push(self.unit[sv_sat_var(l)] as u32)
				continue
			}
			kept.push(l)
		}
		let mut entry = id
		if changed {
			hints.push(id)
			entry = self.book.log.learn(kept.clone(), hints)
			self.stats.learned += 1
		}
		if kept.len() == 0 {
			self.refuted = true
			return
		}
		if kept.len() == 1 {
			self.assign_unit(kept[0], entry)
			return
		}
		self.attach(kept, entry, 0, false)
	}

	/// Puts a clause into the arena and watches its first two literals;
	/// its name.
	fn attach(ref mut self, lits: Vec[u32], id: u32, glue: i64, learned: bool) -> u32 {
		let c = self.arena.len() as u32
		let size = lits.len() as u32
		self.arena.push(size)
		let flag: u32 = if learned { 1 } else { 0 }
		self.arena.push(((glue as u32) << 2) | flag)
		self.arena.push(id)
		for l in lits {
			self.arena.push(l)
		}
		if learned {
			self.learnts.push(c)
		}
		self.watch(c)
		return c
	}

	/// Watches the first two literals of clause `c`.
	fn watch(ref mut self, c: u32) {
		let at = c as i64
		let a = self.arena[at + 3]
		let b = self.arena[at + 4]
		// A binary clause is named with the high bit: 0x80000000.
		let name = if self.arena[at] == 2 { c | 2147483648 } else { c }
		self.watch_clause[a as i64].push(name)
		self.watch_blocker[a as i64].push(b)
		self.watch_clause[b as i64].push(name)
		self.watch_blocker[b as i64].push(a)
	}

	/// The log entry of clause `c`.
	fn clause_id(ref self, c: i64) -> u32 {
		return self.arena[c + 2]
	}

	/// Makes `l` true at the current level, implied by clause `reason` (or
	/// `-1`). At level zero its unit clause is learned from the reason.
	fn assign(ref mut self, l: u32, reason: i64) {
		let v = sv_sat_var(l)
		self.value[v] = if l % 2 == 0 { 1 } else { -1 }
		self.level[v] = self.decision_level()
		self.reason[v] = reason
		self.trail.push(l)
		if self.decision_level() == 0 && reason >= 0 {
			let mut hints: Vec[u32] = []
			let size = self.arena[reason] as i64
			let mut k = 0
			while k < size {
				let q = self.arena[reason + 3 + k]
				if q != l {
					hints.push(self.unit[sv_sat_var(q)] as u32)
				}
				k += 1
			}
			hints.push(self.clause_id(reason))
			self.unit[v] = self.book.log.learn([l], hints) as i64
			self.stats.learned += 1
		}
	}

	/// Makes `l` true at level zero, its unit clause entry `id` of the log.
	fn assign_unit(ref mut self, l: u32, id: u32) {
		let v = sv_sat_var(l)
		if self.value[v] != 0 {
			if self.lit_value(l) < 0 {
				// Its negation is a unit already: the two make the empty
				// clause.
				self.book.log.learn([], [self.unit[v] as u32, id])
				self.stats.learned += 1
				self.refuted = true
			}
			return
		}
		self.assign(l, -1)
		self.unit[v] = id as i64
	}

	/// Propagates the trail; the conflicting clause, or `-1`.
	fn propagate(ref mut self) -> i64 {
		while self.head < self.trail.len() {
			let p = self.trail[self.head]
			self.head += 1
			self.stats.propagations += 1
			let f = p ^ 1
			let fl = f as i64
			let n = self.watch_clause[fl].len()
			let mut i = 0
			let mut j = 0
			let mut conflict: i64 = -1
			while i < n {
				let name = self.watch_clause[fl][i]
				let blocker = self.watch_blocker[fl][i]
				i += 1
				if self.lit_value(blocker) > 0 {
					self.watch_clause[fl][j] = name
					self.watch_blocker[fl][j] = blocker
					j += 1
					continue
				}
				if name >= 2147483648 {
					// Binary: the blocker is the other literal.
					self.watch_clause[fl][j] = name
					self.watch_blocker[fl][j] = blocker
					j += 1
					let c = (name - 2147483648) as i64
					if self.lit_value(blocker) < 0 {
						conflict = c
						break
					}
					self.assign(blocker, c)
					continue
				}
				let c = name as i64
				let at = c + 3
				if self.arena[at] == f {
					self.arena[at] = self.arena[at + 1]
					self.arena[at + 1] = f
				}
				let first = self.arena[at]
				if first != blocker && self.lit_value(first) > 0 {
					self.watch_clause[fl][j] = name
					self.watch_blocker[fl][j] = first
					j += 1
					continue
				}
				let size = self.arena[c] as i64
				let mut k = 2
				let mut moved = false
				while k < size {
					let l = self.arena[at + k]
					if self.lit_value(l) >= 0 {
						self.arena[at + 1] = l
						self.arena[at + k] = f
						self.watch_clause[l as i64].push(name)
						self.watch_blocker[l as i64].push(first)
						moved = true
						break
					}
					k += 1
				}
				if moved {
					continue
				}
				self.watch_clause[fl][j] = name
				self.watch_blocker[fl][j] = first
				j += 1
				if self.lit_value(first) < 0 {
					conflict = c
					break
				}
				self.assign(first, c)
			}
			while i < n {
				self.watch_clause[fl][j] = self.watch_clause[fl][i]
				self.watch_blocker[fl][j] = self.watch_blocker[fl][i]
				i += 1
				j += 1
			}
			self.watch_clause[fl].truncate(j)
			self.watch_blocker[fl].truncate(j)
			if conflict >= 0 {
				self.head = self.trail.len()
				return conflict
			}
		}
		return -1
	}

	/// First-UIP analysis of the conflicting clause `conflict`.
	fn analyze(ref mut self, conflict: i64) -> SvLearned {
		let current = self.decision_level()
		let mut lits: Vec[u32] = [0]
		let mut zero: Vec[i64] = []
		let mut chain: Vec[u32] = [self.clause_id(conflict)]
		let mut path = 0
		let mut p: u32 = 0
		let mut resolving = false
		let mut c = conflict
		let mut index = self.trail.len() - 1
		while true {
			let size = self.arena[c] as i64
			let mut k = 0
			while k < size {
				let q = self.arena[c + 3 + k]
				k += 1
				if resolving && q == p {
					continue
				}
				let v = sv_sat_var(q)
				if self.seen[v] {
					continue
				}
				self.seen[v] = true
				if self.level[v] == 0 {
					zero.push(v)
					continue
				}
				self.bump_var(v)
				if self.level[v] == current {
					path += 1
				} else {
					lits.push(q)
				}
			}
			while !self.seen[sv_sat_var(self.trail[index])] {
				index -= 1
			}
			p = self.trail[index]
			index -= 1
			let v = sv_sat_var(p)
			self.seen[v] = false
			path -= 1
			if path == 0 {
				break
			}
			c = self.reason[v]
			chain.push(self.clause_id(c))
			resolving = true
		}
		lits[0] = p ^ 1
		// The hints: the level-zero units, the reasons in trail order, the
		// conflict.
		let mut hints: Vec[u32] = []
		for v in zero {
			hints.push(self.unit[v] as u32)
			self.seen[v] = false
		}
		let mut r = chain.len() - 1
		while r >= 0 {
			hints.push(chain[r])
			r -= 1
		}
		// The backjump level and the glue; a literal of that level second.
		let mut back: i64 = 0
		let mut levels: Vec[i64] = [current]
		let mut i = 1
		while i < lits.len() {
			let v = sv_sat_var(lits[i])
			self.seen[v] = false
			let lv = self.level[v]
			if !levels.contains(lv) {
				levels.push(lv)
			}
			if lv > back {
				back = lv
				let held = lits[1]
				lits[1] = lits[i]
				lits[i] = held
			}
			i += 1
		}
		return SvLearned { lits: lits, hints: hints, level: back, glue: levels.len() }
	}

	/// Undoes every level above `target`, saving the phases.
	fn backjump(ref mut self, target: i64) {
		if self.decision_level() <= target {
			return
		}
		let start = self.limits[target]
		let mut at = self.trail.len() - 1
		while at >= start {
			let l = self.trail[at]
			let v = sv_sat_var(l)
			self.value[v] = 0
			self.reason[v] = -1
			self.phase[v] = l % 2 == 0
			if self.place[v] < 0 {
				self.heap_insert(v as u32)
			}
			at -= 1
		}
		if start < self.undone {
			self.undone = start
		}
		self.trail.truncate(start)
		self.limits.truncate(target)
		self.head = start
	}

	/// Writes the empty clause, from the conflicting clause `c` at level
	/// zero and its literals' units.
	fn refute(ref mut self, c: i64) {
		let mut hints: Vec[u32] = []
		let size = self.arena[c] as i64
		let mut k = 0
		while k < size {
			hints.push(self.unit[sv_sat_var(self.arena[c + 3 + k])] as u32)
			k += 1
		}
		hints.push(self.clause_id(c))
		self.book.log.learn([], hints)
		self.stats.learned += 1
		self.refuted = true
	}

	/// Searches for at most `budget` conflicts in all.
	pub fn solve(ref mut self, budget: i64) -> SvSatAnswer {
		let mut restart: i64 = 0
		if self.stats.reductions == 0 {
			self.next_reduce = self.reduce_first
		}
		while true {
			if self.refuted {
				return SvSatAnswer::Unsat
			}
			let limit = sv_luby(restart) * self.restart_unit
			let answer = self.search(limit, budget)
			match answer {
				SvSatAnswer::Unknown => {},
				else => return answer,
			}
			if self.stats.conflicts >= budget {
				return SvSatAnswer::Unknown
			}
			self.backjump(0)
			restart += 1
			self.stats.restarts += 1
			if self.stats.conflicts >= self.next_reduce {
				self.reduce()
			}
		}
	}

	/// Searches until `limit` more conflicts (`Unknown`: restart), the
	/// budget, or an answer.
	fn search(ref mut self, limit: i64, budget: i64) -> SvSatAnswer {
		let mut met: i64 = 0
		while true {
			let conflict = self.propagate()
			if conflict >= 0 {
				self.stats.conflicts += 1
				met += 1
				if self.decision_level() == 0 {
					self.refute(conflict)
					return SvSatAnswer::Unsat
				}
				self.learn_conflict(conflict)
				if met >= limit || self.stats.conflicts >= self.next_reduce
					|| self.stats.conflicts >= budget
				{
					return SvSatAnswer::Unknown
				}
				continue
			}
			let next = self.pick() ?? return SvSatAnswer::Sat
			self.stats.decisions += 1
			self.limits.push(self.trail.len())
			self.assign(next, -1)
		}
	}

	/// Learns from the conflicting clause `conflict` above level zero: the
	/// first-UIP clause, the backjump, its first literal assigned.
	fn learn_conflict(ref mut self, conflict: i64) {
		let learned = self.analyze(conflict)
		self.backjump(learned.level)
		let id = self.book.log.learn(learned.lits.clone(), learned.hints)
		self.stats.learned += 1
		if learned.lits.len() == 1 {
			self.assign_unit(learned.lits[0], id)
		} else {
			let first = learned.lits[0]
			let c = self.attach(learned.lits, id, learned.glue, true)
			self.assign(first, c as i64)
		}
		self.bump = self.bump + self.bump / 19
		if self.bump > 1152921504606846976 {
			self.rescale()
		}
	}

	/// The trail's length and its `i`-th literal: what `sv_smt.nika` hands
	/// the theory.
	fn trail_len(ref self) -> i64 {
		return self.trail.len()
	}

	fn trail_at(ref self, i: i64) -> u32 {
		return self.trail[i]
	}

	/// The level literal `l`'s variable is assigned at.
	fn level_of(ref self, l: u32) -> i64 {
		return self.level[sv_sat_var(l)]
	}

	/// Whether `l`'s variable is one of the solver's.
	fn knows(ref self, l: u32) -> bool {
		return sv_sat_var(l) < self.value.len()
	}

	/// A decision: a new level, `l` true on it.
	fn decide(ref mut self, l: u32) {
		self.stats.decisions += 1
		self.limits.push(self.trail.len())
		self.assign(l, -1)
	}

	/// Adds the clause `lits`, entry `id` of the log, in the middle of the
	/// search: a theory's conflict or explanation, every literal false but
	/// at most one. False everywhere, it is the conflicting clause after a
	/// backjump to the highest level among its literals (the name returned;
	/// at level zero it refutes); with one open literal it implies that one
	/// at the level of the highest false one. `-1` where there is no
	/// conflict.
	fn add_lemma(ref mut self, lits: ref Vec[u32], id: u32) -> i64 {
		if self.refuted {
			return -1
		}
		// The open and true literals first, then the false ones, the highest
		// level first.
		let mut ordered: Vec[u32] = []
		let mut falsified: Vec[u32] = []
		let mut holds = false
		for l in lits {
			let v = self.lit_value(l)
			if v > 0 {
				holds = true
			}
			if v >= 0 {
				ordered.push(l)
				continue
			}
			falsified.push(l)
			let mut at = falsified.len() - 1
			while at > 0 && self.level_of(falsified[at - 1]) < self.level_of(l) {
				falsified[at] = falsified[at - 1]
				at -= 1
			}
			falsified[at] = l
		}
		let open = ordered.len()
		for l in falsified {
			ordered.push(l)
		}
		if ordered.len() == 0 {
			// The entry is the empty clause itself.
			self.refuted = true
			return -1
		}
		if ordered.len() == 1 {
			self.backjump(0)
			self.assign_unit(ordered[0], id)
			return -1
		}
		if open == 0 {
			let top = self.level_of(ordered[0])
			self.backjump(top)
			let c = self.attach(ordered, id, 2, true) as i64
			if top == 0 {
				self.refute(c)
				return -1
			}
			return c
		}
		if open == 1 && !holds {
			self.backjump(self.level_of(ordered[1]))
			let first = ordered[0]
			let c = self.attach(ordered, id, 2, true)
			self.assign(first, c as i64)
			return -1
		}
		self.attach(ordered, id, 2, true)
		return -1
	}

	/// The live learned clauses (a theory's lemmas among them), each its
	/// literals, and a unit per literal fixed at level zero: what crosses
	/// a switch of the strategy (ADR-270 D14, `sv_strategy.nika`).
	fn carried(ref self) -> Vec[Vec[u32]] {
		let mut out: Vec[Vec[u32]] = []
		let top = if self.limits.len() > 0 { self.limits[0] } else { self.trail.len() }
		for i in 0..<top {
			out.push([self.trail[i]])
		}
		for c in self.learnts {
			let at = c as i64
			if (self.arena[at + 1] & 2) != 0 {
				continue
			}
			let mut lits: Vec[u32] = []
			for i in 0..<self.arena[at] as i64 {
				lits.push(self.arena[at + 3 + i])
			}
			out.push(lits)
		}
		return out
	}

	/// The phase variable `v` is first decided in: a walk's truth of its
	/// atom (`sv_walk.nika`) handed to the search.
	fn set_phase(ref mut self, v: i64, phase: bool) {
		if v >= 0 && v < self.phase.len() {
			self.phase[v] = phase
		}
	}

	/// The next decision: the open variable of highest activity in its
	/// saved phase; `null` where every variable is assigned.
	fn pick(ref mut self) -> u32? {
		while self.heap.len() > 0 {
			let v = self.heap_pop()
			if self.value[v as i64] == 0 {
				return if self.phase[v as i64] { v << 1 } else { (v << 1) | 1 }
			}
		}
		return null
	}

	/// Halves the learned clauses of glue above two, the worst glue (then
	/// the oldest) first; compacts the arena once half of it is dead.
	/// Called at level zero, where no clause is a reason analysis reads.
	fn reduce(ref mut self) {
		self.stats.reductions += 1
		self.next_reduce = self.stats.conflicts + self.reduce_first + self.stats.reductions
			* self.reduce_step
		// Each learned clause as `glue << 32 | 2^32 - 1 - name`, sorted: the
		// last ones go first.
		let mut keys: Vec[i64] = []
		for c in self.learnts {
			let glue = (self.arena[c as i64 + 1] >> 2) as i64
			keys.push(glue * 4294967296 + (4294967295 - c as i64))
		}
		keys.sort()
		let mut going = keys.len() / 2
		let mut at = keys.len() - 1
		while at >= 0 && going > 0 {
			let key = keys[at]
			at -= 1
			if key / 4294967296 <= 2 {
				break
			}
			let c = 4294967295 - key % 4294967296
			self.arena[c + 1] = self.arena[c + 1] | 2
			self.wasted += self.arena[c] as i64 + 3
			self.book.log.delete(self.clause_id(c))
			self.stats.deleted += 1
			going -= 1
		}
		if self.wasted * 2 > self.arena.len() {
			self.compact()
		} else {
			let mut kept: Vec[u32] = []
			for c in self.learnts {
				if (self.arena[c as i64 + 1] & 2) == 0 {
					kept.push(c)
				}
			}
			self.learnts = kept
		}
		self.rewatch()
	}

	/// Copies the live clauses into a fresh arena. The reasons of level
	/// zero, all there are when it runs, are not read again.
	fn compact(ref mut self) {
		self.stats.compactions += 1
		let mut fresh: Vec[u32] = []
		let mut learnts: Vec[u32] = []
		let mut c: i64 = 0
		while c < self.arena.len() {
			let words = self.arena[c] as i64 + 3
			let info = self.arena[c + 1]
			if (info & 2) == 0 {
				if (info & 1) == 1 {
					learnts.push(fresh.len() as u32)
				}
				let mut k = 0
				while k < words {
					fresh.push(self.arena[c + k])
					k += 1
				}
			}
			c += words
		}
		self.arena = fresh
		self.learnts = learnts
		self.wasted = 0
		let mut v = 0
		while v < self.reason.len() {
			self.reason[v] = -1
			v += 1
		}
	}

	/// Builds every watch list again from the live clauses.
	fn rewatch(ref mut self) {
		let mut l = 0
		while l < self.watch_clause.len() {
			self.watch_clause[l].truncate(0)
			self.watch_blocker[l].truncate(0)
			l += 1
		}
		let mut c: i64 = 0
		while c < self.arena.len() {
			let words = self.arena[c] as i64 + 3
			if (self.arena[c + 1] & 2) == 0 {
				self.watch(c as u32)
			}
			c += words
		}
	}

	fn bump_var(ref mut self, v: i64) {
		self.activity[v] += self.bump
		if self.activity[v] > 1152921504606846976 {
			self.rescale()
		}
		if self.place[v] >= 0 {
			self.heap_up(self.place[v])
		}
	}

	/// Divides every activity and the bump by `2^30`; the order stays.
	fn rescale(ref mut self) {
		let mut v = 0
		while v < self.activity.len() {
			self.activity[v] = self.activity[v] / 1073741824
			v += 1
		}
		self.bump = self.bump / 1073741824 + 1
	}

	/// Whether variable `a` goes above `b` in the heap: higher activity,
	/// then the lower number.
	fn above(ref self, a: u32, b: u32) -> bool {
		let x = self.activity[a as i64]
		let y = self.activity[b as i64]
		return x > y || (x == y && a < b)
	}

	fn heap_insert(ref mut self, v: u32) {
		self.place[v as i64] = self.heap.len()
		self.heap.push(v)
		self.heap_up(self.heap.len() - 1)
	}

	fn heap_pop(ref mut self) -> u32 {
		let top = self.heap[0]
		let last = self.heap.len() - 1
		let moved = self.heap[last]
		self.heap[0] = moved
		self.place[moved as i64] = 0
		self.heap.truncate(last)
		self.place[top as i64] = -1
		if last > 0 {
			self.heap_down(0)
		}
		return top
	}

	fn heap_up(ref mut self, start: i64) {
		let mut i = start
		let v = self.heap[i]
		while i > 0 {
			let parent = (i - 1) / 2
			let u = self.heap[parent]
			if !self.above(v, u) {
				break
			}
			self.heap[i] = u
			self.place[u as i64] = i
			i = parent
		}
		self.heap[i] = v
		self.place[v as i64] = i
	}

	fn heap_down(ref mut self, start: i64) {
		let mut i = start
		let v = self.heap[i]
		let n = self.heap.len()
		while true {
			let left = 2 * i + 1
			if left >= n {
				break
			}
			let right = left + 1
			let child = if right < n && self.above(self.heap[right], self.heap[left]) {
				right
			} else {
				left
			}
			let u = self.heap[child]
			if !self.above(u, v) {
				break
			}
			self.heap[i] = u
			self.place[u as i64] = i
			i = child
		}
		self.heap[i] = v
		self.place[v as i64] = i
	}
}

// --- Tests: the SAT core (moved from `tests/compiler/tests/solver_sat.nika`,
// which compiled these files anew in a program of its own on every run):
// pigeonhole proved and its log accepted by `sv_check`, a learned unit
// replayed, a random 3-SAT model evaluated, a reduced and compacted search
// still accepted, a cut log rejected, a search stopped by its budget ---

// A query of `vars` Boolean atoms (each `0 <= 0`, never read by a theory)
// and `clauses`.
fn sv_sat_test_query(vars: u32, clauses: Vec[Vec[u32]]) -> SvQuery {
	let mut atoms: Vec[SvAtom] = []
	let mut v: u32 = 0
	while v < vars {
		atoms.push(SvAtom { row: sv_row_constant(0), rel: SvRel::Le })
		v += 1
	}
	return SvQuery { atoms: atoms, clauses: clauses, columns: 0, reals: [] }
}

fn sv_sat_test_pos(v: u32) -> u32 {
	return sv_lit(v, false)
}

fn sv_sat_test_neg(v: u32) -> u32 {
	return sv_lit(v, true)
}

// `p` pigeons into `h` holes, variable `i·h + j` pigeon `i` in hole `j`.
fn sv_sat_test_pigeons(p: u32, h: u32) -> SvQuery {
	let mut clauses: Vec[Vec[u32]] = []
	let mut i: u32 = 0
	while i < p {
		let mut some: Vec[u32] = []
		let mut j: u32 = 0
		while j < h {
			some.push(sv_sat_test_pos(i * h + j))
			j += 1
		}
		clauses.push(some)
		i += 1
	}
	let mut j: u32 = 0
	while j < h {
		let mut a: u32 = 0
		while a < p {
			let mut b = a + 1
			while b < p {
				clauses.push([sv_sat_test_neg(a * h + j), sv_sat_test_neg(b * h + j)])
				b += 1
			}
			a += 1
		}
		j += 1
	}
	return sv_sat_test_query(p * h, clauses)
}

// `m` random clauses of three distinct variables of `n`, from `seed`.
fn sv_sat_test_random3(n: u32, m: u32, seed: i64) -> SvQuery {
	let mut state = seed
	let mut clauses: Vec[Vec[u32]] = []
	let mut c: u32 = 0
	while c < m {
		let mut clause: Vec[u32] = []
		let mut vars: Vec[u32] = []
		while vars.len() < 3 {
			state = (state * 1103515245 + 12345) % 2147483648
			let v = ((state / 65536) % (n as i64)) as u32
			if vars.contains(v) {
				continue
			}
			vars.push(v)
			state = (state * 1103515245 + 12345) % 2147483648
			clause.push(sv_lit(v, (state / 65536) % 2 == 1))
		}
		clauses.push(clause)
		c += 1
	}
	return sv_sat_test_query(n, clauses)
}

fn sv_sat_test_answer_text(a: SvSatAnswer) -> String {
	return match a {
		SvSatAnswer::Sat => "sat",
		SvSatAnswer::Unsat => "unsat",
		SvSatAnswer::Unknown => "unknown",
	}
}

fn sv_sat_test_work(s: ref SvSatStats) -> String {
	return f"  work: decisions {s.decisions}, propagations {s.propagations}, conflicts {s.conflicts}, learned {s.learned}, deleted {s.deleted}, restarts {s.restarts}, reductions {s.reductions}, compactions {s.compactions}"
}

fn sv_sat_test_verdict(q: ref SvQuery, steps: ref Vec[SvStep]) -> String {
	let v = sv_check(q, steps)
	return if v.ok { f"accepted ({v.step} steps)" } else { f"rejected at step {v.step}: {v.reason}" }
}

// How many clauses of `q` the model of `s` makes true.
fn sv_sat_test_satisfied(q: ref SvQuery, s: ref SvSat) -> i64 {
	let mut n = 0
	for clause in q.clauses {
		let mut ok = false
		for l in clause {
			if s.holds(l) {
				ok = true
			}
		}
		if ok {
			n += 1
		}
	}
	return n
}

fn sv_sat_test_lits_text(lits: ref Vec[u32]) -> String {
	let mut parts: Vec[String] = []
	for l in lits {
		let v = l / 2
		parts.push(if l % 2 == 0 { f"x{v}" } else { f"-x{v}" })
	}
	return f"[{parts.join(" ")}]"
}

// Solves `q` within `budget` conflicts and says what came out.
// Solves `q` within `budget` conflicts and says what came out.
fn sv_sat_test_run(name: String, q: ref SvQuery, mut s: SvSat, budget: i64) -> String {
	let answer = s.solve(budget)
	let mut out: String = f"{name}: {sv_sat_test_answer_text(answer)}\n"
	out = out + sv_sat_test_work(s.stats) + "\n"
	let mut longest = 0
	for step in s.book.log.steps {
		match step {
			SvStep::Learn(_, hints) => {
				if hints.len() > longest {
					longest = hints.len()
				}
			},
			else => {},
		}
	}
	match answer {
		SvSatAnswer::Unsat => {
			out = out + f"  log: {s.book.log.steps.len()} steps, longest hint chain {longest}\n"
			out = out + f"  sv_check: {sv_sat_test_verdict(q, s.book.log.steps)}\n"
		},
		SvSatAnswer::Sat => {
			out = out + f"  model: {sv_sat_test_satisfied(q, s)} of {q.clauses.len()} clauses true\n"
		},
		SvSatAnswer::Unknown => {},
	}
	return out
}

test "pigeonhole 4-into-3 is unsat and its log is accepted" {
	let hole = sv_sat_test_pigeons(4, 3)
	let made = sv_sat_of(hole)
	assert(made != null)
	let mut s = made ?? return
	let out = sv_sat_test_run("pigeonhole 4-into-3", hole, s, 100000)
	let expected = [
		"pigeonhole 4-into-3: unsat",
		"  work: decisions 9, propagations 55, conflicts 7, learned 17, deleted 0, restarts 0, reductions 0, compactions 0",
		"  log: 39 steps, longest hint chain 12",
		"  sv_check: accepted (39 steps)",
	]
	assert(out == expected.join("\n") + "\n")
}

/// Deciding -x0 implies x1, x2, x3 and falsifies the fourth clause: the
/// unit x0 is learned through the whole chain; at level zero it implies x4
/// and x5, and the last clause is the empty clause's conflict.
test "a unit learned through a hint chain four clauses long is replayed" {
	let chain = sv_sat_test_query(6, [
		[sv_sat_test_pos(0), sv_sat_test_pos(1)],
		[sv_sat_test_pos(0), sv_sat_test_neg(1), sv_sat_test_pos(2)],
		[sv_sat_test_neg(1), sv_sat_test_neg(2), sv_sat_test_pos(3)],
		[sv_sat_test_neg(2), sv_sat_test_neg(3)],
		[sv_sat_test_neg(0), sv_sat_test_pos(4)],
		[sv_sat_test_neg(4), sv_sat_test_pos(5)],
		[sv_sat_test_neg(4), sv_sat_test_neg(5)],
	])
	let made = sv_sat_of(chain)
	assert(made != null)
	let mut s = made ?? return
	let answer = s.solve(100)
	let mut out: String = f"chain: {sv_sat_test_answer_text(answer)}\n"
	for step in s.book.log.steps {
		match step {
			SvStep::Learn(lits, hints) => {
				let text = hints.iter().join(" ")
				out = out + f"  learn {sv_sat_test_lits_text(lits)} by hints [{text}]\n"
			},
			else => {},
		}
	}
	out = out + f"  sv_check: {sv_sat_test_verdict(chain, s.book.log.steps)}\n"
	let expected = [
		"chain: unsat",
		"  learn [x0] by hints [0 1 2 3]",
		"  learn [x4] by hints [7 4]",
		"  learn [x5] by hints [8 5]",
		"  learn [] by hints [8 9 6]",
		"  sv_check: accepted (11 steps)",
	]
	assert(out == expected.join("\n") + "\n")
}

test "a satisfiable random 3-SAT instance's model holds on every clause" {
	let random = sv_sat_test_random3(150, 600, 7)
	let made = sv_sat_of(random)
	assert(made != null)
	let mut s = made ?? return
	let out = sv_sat_test_run("random 3-SAT, 150 variables, 600 clauses", random, s, 100000)
	let expected = [
		"random 3-SAT, 150 variables, 600 clauses: sat",
		"  work: decisions 990, propagations 24221, conflicts 785, learned 785, deleted 0, restarts 5, reductions 0, compactions 0",
		"  model: 600 of 600 clauses true",
	]
	assert(out == expected.join("\n") + "\n")
}

test "pigeonhole 6-into-5 reduced and compacted on the way is still accepted" {
	let six = sv_sat_test_pigeons(6, 5)
	let made = sv_sat_of(six)
	assert(made != null)
	let mut small = made ?? return
	small.reduce_first = 60
	small.reduce_step = 20
	small.restart_unit = 20
	let out = sv_sat_test_run("pigeonhole 6-into-5, reduced and compacted", six, small, 1000000)
	let expected = [
		"pigeonhole 6-into-5, reduced and compacted: unsat",
		"  work: decisions 291, propagations 2345, conflicts 203, learned 226, deleted 85, restarts 6, reductions 2, compactions 1",
		"  log: 392 steps, longest hint chain 21",
		"  sv_check: accepted (392 steps)",
	]
	assert(out == expected.join("\n") + "\n")
}

test "a log with one learned clause's hints cut to one is rejected" {
	let hole = sv_sat_test_pigeons(4, 3)
	let made = sv_sat_of(hole)
	assert(made != null)
	let mut broken = made ?? return
	let answer = broken.solve(100000)
	assert(answer == SvSatAnswer::Unsat)
	let mut cut: Vec[SvStep] = []
	let mut done = false
	for step in broken.book.log.steps {
		let taken = match step {
			SvStep::Learn(lits, hints) => {
				if !done && hints.len() > 1 {
					done = true
					SvStep::Learn(lits.clone(), [hints[0]])
				} else {
					step.clone()
				}
			},
			else => step.clone(),
		}
		cut.push(taken)
	}
	let out = f"pigeonhole 4-into-3, one learned clause's hints cut to one: {sv_sat_test_verdict(hole, cut)}\n"
	let expected = [
		"pigeonhole 4-into-3, one learned clause's hints cut to one: rejected at step 22: learn: the hints end without a conflict",
	]
	assert(out == expected.join("\n") + "\n")
}

test "a search stopped by its budget answers unknown" {
	let seven = sv_sat_test_pigeons(7, 6)
	let made = sv_sat_of(seven)
	assert(made != null)
	let mut s = made ?? return
	let out = sv_sat_test_run("pigeonhole 7-into-6 within 50 conflicts", seven, s, 50)
	let expected = [
		"pigeonhole 7-into-6 within 50 conflicts: unknown",
		"  work: decisions 84, propagations 598, conflicts 50, learned 50, deleted 0, restarts 0, reductions 0, compactions 0",
	]
	assert(out == expected.join("\n") + "\n")
}
