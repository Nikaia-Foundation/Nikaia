// crates/nikaia-std/src/tools/sv_simplex.nika
//
// **The simplex theory** (ADR-270 D12, D11, #1283 item 3): the general
// simplex of Dutertre and de Moura behind the theory interface of
// `sv_theory.nika` - `assert`, `propagate`, `check`, `explain`, `backtrack`,
// `model`, `shared` - the second theory beside Fourier-Motzkin.
//
// Every bound of an atom is a bound on one variable: a query column where
// the atom's form is one column, else the *slack* of its form, one slack per
// distinct form (`x + 2y` and `-2x - 4y` share it, the form divided by its
// gcd and its first coefficient made positive). The slack's definition is a
// row of the tableau: rows of `sv_row.nika` over the simplex's variables,
// integral, `Σ aⱼ·xⱼ - d·x_b = 0` with the basic variable's coefficient the
// row's one denominator `-d`. Values are rationals with the infinitesimal `δ`
// of `sv_num.nika`, so a strict bound `F < c` is `F <= c - δ`.
//
// `check` repairs the basic variables outside their bounds by pivots. The
// leaving variable is the lowest violated one; the entering variable the one
// with the smallest coefficient in its row (D11: small multipliers keep the
// rows small), and after `bland_after` pivots in one check the lowest
// eligible one, Bland's rule, which cannot cycle. A pivot whose rows would
// leave `i64` is not taken; when no pivot remains the answer is *unknown*,
// `Overflow`. A row with no eligible variable is a conflict: the bounds of
// its variables, each a literal's row divided by its scale, add up to a
// constant contradiction, and that sum is the Farkas lemma written to the
// log, which `sv_check.nika` replays without trusting the simplex.
//
// Integer columns by branch-and-bound (D5): a column with a fractional value
// `v` is split by `x <= ⌊v⌋ ∨ x >= ⌊v⌋ + 1` (`SvBook::split`). With
// `branching` the check searches both sides itself and learns the clause of
// the two refutations by unit propagation; without it, `check` hands the
// split to the engine as a lemma. Backtracking keeps the basis and restores
// the bounds.
//
// Real columns (ADR-270 D27): a variable whose form holds a real column,
// and a tableau row holding such a variable, gets no GCD test, no cut and no
// branch, and a strict bound on it stays `F <= c - δ`. A final check's model
// replaces `δ` by a positive rational small enough for every bound.

use std::collections

/// One side of a variable's bounds: the variable lies at most (upper) or at
/// least (lower) at `value`, from `src`, whose row is `scale·(F - value)`
/// for the variable's form `F`. `set` is false where there is no bound
/// (#1296: a `null` cannot be stored into a `Vec[SvSide?]`).
pub struct SvSide {
	pub set: bool,
	pub value: SvDelta,
	pub src: SvSrc,
	pub scale: i64,
}

fn sv_sx_unset() -> SvSide {
	return SvSide { set: false, value: sv_sx_zero(), src: SvSrc::Fact(0), scale: 1 }
}

fn sv_sx_zero() -> SvDelta {
	return sv_delta(sv_int(0), sv_int(0))
}

/// A bound the backtrack restores: the side it replaced.
pub struct SvUndo {
	pub var: i64,
	pub upper: bool,
	pub old: SvSide,
}

/// One summand of a Farkas sum: the row of `src` times `num / scale`,
/// negated where `neg`. An upper side `F <= u` with weight `c` is
/// `c·(F - u)`, a lower side `F >= l` is `c·(l - F)`.
pub struct SvPart {
	pub src: SvSrc,
	pub num: i64,
	pub scale: i64,
	pub neg: bool,
}

fn sv_side_part(side: ref SvSide, upper: bool, weight: i64) -> SvPart {
	return SvPart { src: side.src.clone(), num: weight, scale: side.scale, neg: !upper }
}

/// A literal the simplex propagated: the level it holds from, and the
/// bounds it follows from, weighted, the negated literal's weight `d`.
pub struct SvImplied {
	pub lit: u32,
	pub level: i64,
	pub parts: Vec[SvPart],
	pub d: i64,
}

/// A bound as the simplex reads it: `form REL value` on the form divided by
/// its gcd, first coefficient positive; `scale` the factor that gives the
/// atom's row back, `row = scale·(form - value)`.
pub struct SvReading {
	pub form: SvRow,
	pub upper: bool,
	pub lower: bool,
	pub value: SvDelta,
	pub scale: i64,
}

/// The reading of `row REL 0` for a row with columns; `null` where a step
/// leaves `i64`.
fn sv_reading(row: ref SvRow, rel: SvRel) -> SvReading? {
	let g = sv_row_content(row) ?? return null
	let scale = if row.ks[0] < 0 { g.checked_neg() ?? return null } else { g }
	let mut form = SvRow { cols: row.cols.clone(), ks: [], constant: 0 }
	for k in row.ks {
		form.ks.push(k / scale)
	}
	let c = sv_rat(row.constant.checked_neg() ?? return null, scale) ?? return null
	let strict = match rel {
		SvRel::Lt => true,
		else => false,
	}
	let eq = match rel {
		SvRel::Eq => true,
		else => false,
	}
	let up = scale > 0
	let k = if !strict { sv_int(0) } else if up { sv_int(-1) } else { sv_int(1) }
	return SvReading {
		form: form,
		upper: eq || up,
		lower: eq || !up,
		value: sv_delta(c, k),
		scale: scale,
	}
}

/// `¬l`. Written as a branch: #1286, #1290.
fn sv_sx_not(l: u32) -> u32 {
	return if l % 2 == 0 { l + 1 } else { l - 1 }
}

/// **The simplex theory**: the variables (query columns met so far, then
/// slacks), the tableau, the values and bounds, the trail and its levels.
pub struct SvSimplex {
	/// Each query column's name, as a model names it.
	pub names: Vec[String],
	pub col_var: collections::BTreeMap[u32, i64],
	/// Each variable's query column, `-1` for a slack.
	pub var_col: Vec[i64],
	/// Each variable's form over the query columns: its column, or the
	/// form its slack stands for.
	pub var_form: Vec[SvRow],
	pub slack_of: collections::BTreeMap[String, i64],
	pub rows: Vec[SvRow],
	/// Each row's basic variable.
	pub basic: Vec[i64],
	/// Each variable's row, `-1` where it is not basic.
	pub row_of: Vec[i64],
	pub values: Vec[SvDelta],
	pub lower: Vec[SvSide],
	pub upper: Vec[SvSide],
	pub undo: Vec[SvUndo],
	pub trail: Vec[u32],
	/// Per level above zero: the undo stack's and the trail's length when
	/// it began.
	pub levels: Vec[i64],
	pub marks: Vec[i64],
	pub implied: Vec[SvImplied],
	pub found: collections::BTreeMap[String, i64],
	/// The values of the last consistent final check as rationals, a real
	/// column's with `δ` replaced (ADR-270 D27); empty where a step left
	/// `i64`.
	pub found_real: collections::BTreeMap[String, SvRat],
	/// The query's real columns, ascending: a variable whose form holds one
	/// gets no GCD test, cut or branch (ADR-270 D27).
	pub reals: Vec[u32],
	/// Whether `check` searches a split itself (branch-and-bound) or hands
	/// it to the engine as a lemma.
	pub branching: bool,
	/// Pivots in one check before Bland's rule takes over.
	pub bland_after: i64,
	/// Pivots in one check before the check gives up.
	pub pivot_limit: i64,
	/// Whether a final check runs the GCD test on the tableau's rows.
	pub gcd_test: bool,
	/// The cut a final check tries before a split: `"gmi"` (Gomory
	/// mixed-integer, a split cut), `"cg"` (Gomory's fractional cut, a
	/// Chvátal-Gomory derivation) or `"none"`.
	pub cut_kind: String,
	/// Cuts in a row, each over the last, before the check splits.
	pub cut_rounds: i64,
	pub cut_depth: i64,
	/// What the theory did, for the runner's work column.
	pub pivots: i64,
	pub splits: i64,
	pub overflows: i64,
	pub cuts: i64,
	pub gcd_conflicts: i64,
}

fn sv_simplex(names: Vec[String]) -> SvSimplex {
	return SvSimplex {
		names: names,
		col_var: collections::BTreeMap(),
		var_col: [],
		var_form: [],
		slack_of: collections::BTreeMap(),
		rows: [],
		basic: [],
		row_of: [],
		values: [],
		lower: [],
		upper: [],
		undo: [],
		trail: [],
		levels: [],
		marks: [],
		implied: [],
		found: collections::BTreeMap(),
		found_real: collections::BTreeMap(),
		reals: [],
		branching: true,
		bland_after: 64,
		pivot_limit: 100000,
		gcd_test: true,
		cut_kind: "gmi",
		cut_rounds: 8,
		cut_depth: 0,
		pivots: 0,
		splits: 0,
		overflows: 0,
		cuts: 0,
		gcd_conflicts: 0,
	}
}

/// The parts of a Farkas sum with integer multipliers over their common
/// denominator, divided by their gcd, written to the log as the clause of
/// the negated literals it assumes. `null`, nothing written, where a step
/// leaves `i64` or the sum is no contradiction.
fn sv_sx_lemma(parts: ref Vec[SvPart], mut book: SvBook) -> SvClause? {
	let mult = sv_sx_multipliers(parts) ?? return null
	// Cloned: the plain binding is lowered as a view, #1301.
	let sources = mult.sources.clone()
	let ms = mult.ms.clone()
	let mut row = sv_row_constant(0)
	let mut equality = true
	let mut strict = false
	let mut assumed: Vec[u32] = []
	let mut i = 0
	while i < sources.len() {
		let b = book.source(sources[i]) ?? return null
		let m = ms[i]
		let is_eq = match b.rel {
			SvRel::Eq => true,
			else => false,
		}
		let is_lt = match b.rel {
			SvRel::Lt => true,
			else => false,
		}
		if !is_eq && m < 0 {
			return null
		}
		equality = equality && is_eq
		strict = strict || (is_lt && m > 0)
		row = sv_row_sum(1, row, m, b.row) ?? return null
		assumed = sv_lits_union(assumed, b.assumed)
		i += 1
	}
	if row.cols.len() > 0 {
		return null
	}
	let c = row.constant
	let closes = if equality { c != 0 } else if strict { c >= 0 } else { c > 0 }
	if !closes {
		return null
	}
	let mut lits: Vec[u32] = []
	for l in assumed {
		lits.push(sv_sx_not(l))
	}
	lits.sort()
	let id = book.log.farkas(lits.clone(), sources, ms, 1)
	return SvClause { id: id, lits: lits }
}

/// The sources of a Farkas sum and their integer multipliers.
pub struct SvMult {
	pub sources: Vec[SvSrc],
	pub ms: Vec[i64],
}

/// The parts' multipliers over their common denominator, divided by their
/// gcd; `null` where a step leaves `i64`.
fn sv_sx_multipliers(parts: ref Vec[SvPart]) -> SvMult? {
	let mut common: i64 = 1
	for p in parts {
		let a = p.scale.checked_abs() ?? return null
		let g = sv_gcd(common, a) ?? return null
		common = (common / g).checked_mul(a) ?? return null
	}
	let mut sources: Vec[SvSrc] = []
	let mut ms: Vec[i64] = []
	for p in parts {
		let mut m = p.num.checked_mul(common / p.scale) ?? return null
		if p.neg {
			m = m.checked_neg() ?? return null
		}
		if m != 0 {
			sources.push(p.src.clone())
			ms.push(m)
		}
	}
	let g = sv_content(ms) ?? return null
	if g > 1 {
		let mut reduced: Vec[i64] = []
		for m in ms {
			reduced.push(m / g)
		}
		ms = reduced
	}
	return SvMult { sources: sources, ms: ms }
}

impl SvSimplex {
	/// A new variable for query column `col` (`-1`: a slack), non-basic,
	/// value zero, no bounds.
	fn new_var(ref mut self, col: i64) -> i64 {
		let v = self.var_col.len()
		self.var_col.push(col)
		if col >= 0 {
			self.var_form.push(SvRow { cols: [col.checked_u32() ?? 0], ks: [1], constant: 0 })
		} else {
			self.var_form.push(sv_row_constant(0))
		}
		self.row_of.push(-1)
		self.values.push(sv_sx_zero())
		self.lower.push(sv_sx_unset())
		self.upper.push(sv_sx_unset())
		return v
	}

	/// The variable of query column `col`, made where it is new.
	fn column_var(ref mut self, col: u32) -> i64 {
		let known: i64? = self.col_var.get(col)
		// `known ?? 0` after the test, not `return known`: #1291.
		if known != null {
			return known ?? 0
		}
		let v = self.new_var(col as i64)
		self.col_var.insert(col, v)
		return v
	}

	/// The variable of a reading's form, `-1` where there is none yet.
	pub fn find_var(ref self, form: ref SvRow) -> i64 {
		if form.cols.len() == 1 && form.ks[0] == 1 {
			let v: i64? = self.col_var.get(form.cols[0])
			return v ?? -1
		}
		let s: i64? = self.slack_of.get(sv_row_text(form))
		return s ?? -1
	}

	/// The variable of a reading's form: its column, or its slack, made with
	/// its tableau row where it is new (`Σ aⱼ·xⱼ - s = 0`, its basic
	/// variables replaced by their rows); `null` where a step leaves `i64`.
	fn form_var(ref mut self, form: ref SvRow) -> i64? {
		if form.cols.len() == 1 && form.ks[0] == 1 {
			return self.column_var(form.cols[0])
		}
		let key = sv_row_text(form)
		let known: i64? = self.slack_of.get(key.clone())
		if known != null {
			return known ?? 0
		}
		let mut terms: Vec[SvTerm] = []
		let mut i = 0
		while i < form.cols.len() {
			let v = self.column_var(form.cols[i])
			terms.push(SvTerm { col: v.checked_u32() ?? return null, k: form.ks[i] })
			i += 1
		}
		let s = self.new_var(-1)
		self.var_form[s] = form.clone()
		terms.push(SvTerm { col: s.checked_u32() ?? return null, k: -1 })
		let mut row = sv_row_of(terms, 0) ?? return null
		let cols = row.cols.clone()
		for c in cols {
			let at = self.row_of[c as i64]
			if at >= 0 && sv_row_coef(row, c) != 0 {
				row = sv_row_eliminate(row, self.rows[at], c) ?? return null
			}
		}
		self.rows.push(row)
		self.basic.push(s)
		let r = self.rows.len() - 1
		self.row_of[s] = r
		self.values[s] = self.row_value(r) ?? return null
		self.slack_of.insert(key, s)
		return s
	}

	/// The value row `r` gives its basic variable, `Σ aⱼ·βⱼ / d`.
	fn row_value(ref self, r: i64) -> SvDelta? {
		let b = self.basic[r]
		let mut sum = sv_sx_zero()
		let mut d: i64 = 0
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let k = self.rows[r].ks[i]
			if v == b {
				d = k.checked_neg() ?? return null
			} else {
				let term = sv_delta_scale(self.values[v], sv_int(k)) ?? return null
				sum = sv_delta_add(sum, term) ?? return null
			}
			i += 1
		}
		let inverse = sv_rat(1, d) ?? return null
		return sv_delta_scale(sum, inverse)
	}

	/// Every basic variable's value from the non-basic ones; false where a
	/// step leaves `i64`.
	fn refresh(ref mut self) -> bool {
		let mut r = 0
		while r < self.rows.len() {
			let b = self.basic[r]
			self.values[b] = self.row_value(r) ?? return false
			r += 1
		}
		return true
	}

	fn bound(ref mut self, row: SvRow, rel: SvRel, src: SvSrc, mut book: SvBook) -> SvChecked {
		if row.cols.len() == 0 {
			let c = row.constant
			let fails = match rel {
				SvRel::Le => c > 0,
				SvRel::Lt => c >= 0,
				SvRel::Eq => c != 0,
			}
			if !fails {
				return SvChecked::Consistent
			}
			return self.conflict([SvPart { src: src, num: 1, scale: 1, neg: false }], book)
		}
		let reading = sv_reading(row, rel) ?? return self.overflow()
		let v = self.form_var(reading.form) ?? return self.overflow()
		if reading.upper {
			let side = SvSide {
				set: true,
				value: reading.value.clone(),
				src: src.clone(),
				scale: reading.scale,
			}
			let done = self.tighten(v, true, side, book)
			match done {
				SvChecked::Consistent => {},
				else => {
					return done
				},
			}
		}
		if reading.lower {
			let side = SvSide {
				set: true,
				value: reading.value.clone(),
				src: src.clone(),
				scale: reading.scale,
			}
			return self.tighten(v, false, side, book)
		}
		return SvChecked::Consistent
	}

	/// The side `side` on variable `v`, where it is tighter than the one it
	/// has; a non-basic variable outside it moves onto it.
	fn tighten(ref mut self, v: i64, upper: bool, side: SvSide, mut book: SvBook) -> SvChecked {
		let had = if upper { self.upper[v].clone() } else { self.lower[v].clone() }
		if had.set {
			let order = sv_delta_cmp(had.value, side.value)
			if (upper && order <= 0) || (!upper && order >= 0) {
				return SvChecked::Consistent
			}
		}
		let other = if upper { self.lower[v].clone() } else { self.upper[v].clone() }
		if other.set {
			let order = sv_delta_cmp(side.value, other.value)
			if (upper && order < 0) || (!upper && order > 0) {
				return self.conflict(
					[sv_side_part(side, upper, 1), sv_side_part(other, !upper, 1)],
					book,
				)
			}
		}
		self.undo.push(SvUndo { var: v, upper: upper, old: had })
		let value = side.value.clone()
		if upper {
			self.upper[v] = side
		} else {
			self.lower[v] = side
		}
		if self.row_of[v] < 0 {
			let order = sv_delta_cmp(self.values[v], value)
			if (upper && order > 0) || (!upper && order < 0) {
				self.values[v] = value
				if !self.refresh() {
					return self.overflow()
				}
			}
		}
		return SvChecked::Consistent
	}

	fn overflow(ref mut self) -> SvChecked {
		self.overflows += 1
		return SvChecked::Unknown(LgUnknown::Overflow)
	}

	/// The conflict the parts add up to, written as a Farkas lemma.
	fn conflict(ref mut self, parts: Vec[SvPart], mut book: SvBook) -> SvChecked {
		let clause = sv_sx_lemma(parts, book) ?? return self.overflow()
		return SvChecked::Conflict(clause)
	}

	/// The bound row `r` puts on its basic variable from above (`up`) or
	/// below, through the bounds of its other variables, as the parts of
	/// that sum; `null` where one of them lacks the side it needs.
	fn row_parts(ref self, r: i64, up: bool) -> Vec[SvPart]? {
		let b = self.basic[r]
		let mut parts: Vec[SvPart] = []
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let a = self.rows[r].ks[i]
			i += 1
			if v == b {
				continue
			}
			// From above, `a > 0` needs `v`'s upper side; from below its lower.
			// Two lines, not `(a > 0) == up`: the comparison is taken for a chain.
			let positive = a > 0
			let wants_upper = positive == up
			let side = if wants_upper { self.upper[v].clone() } else { self.lower[v].clone() }
			if !side.set {
				return null
			}
			parts.push(sv_side_part(side, wants_upper, a.checked_abs() ?? return null))
		}
		return parts
	}

	/// The bound on row `r`'s basic variable from above or below that the
	/// bounds of its other variables give, `Σ aⱼ·boundⱼ / d`; `null`
	/// where a side is missing or a step leaves `i64`.
	fn row_bound(ref self, r: i64, up: bool) -> SvDelta? {
		let b = self.basic[r]
		let mut sum = sv_sx_zero()
		let mut d: i64 = 1
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let a = self.rows[r].ks[i]
			i += 1
			if v == b {
				d = a.checked_neg() ?? return null
				continue
			}
			// Two lines, not `(a > 0) == up`: the comparison is taken for a chain.
			let positive = a > 0
			let wants_upper = positive == up
			let side = if wants_upper { self.upper[v].clone() } else { self.lower[v].clone() }
			if !side.set {
				return null
			}
			let term = sv_delta_scale(side.value, sv_int(a)) ?? return null
			sum = sv_delta_add(sum, term) ?? return null
		}
		let inverse = sv_rat(1, d) ?? return null
		return sv_delta_scale(sum, inverse)
	}

	/// Pivots row `r` on non-basic variable `j`: `j` basic in `r`, every
	/// other row with `j` combined with it by the smallest multipliers.
	/// False, nothing changed, where a row would leave `i64`.
	fn pivot(ref mut self, r: i64, j: i64) -> bool {
		let col = j.checked_u32() ?? return false
		let mut pr = self.rows[r].clone()
		if sv_row_coef(pr, col) > 0 {
			pr = sv_row_scale(pr, -1) ?? return false
		}
		let mut changed: Vec[i64] = []
		let mut made: Vec[SvRow] = []
		let mut t = 0
		while t < self.rows.len() {
			if t != r && sv_row_coef(self.rows[t], col) != 0 {
				made.push(sv_row_eliminate(self.rows[t], pr, col) ?? return false)
				changed.push(t)
			}
			t += 1
		}
		self.rows[r] = pr
		let mut i = 0
		while i < changed.len() {
			self.rows[changed[i]] = made[i].clone()
			i += 1
		}
		let old = self.basic[r]
		self.row_of[old] = -1
		self.basic[r] = j
		self.row_of[j] = r
		return true
	}

	/// The lowest basic variable outside its bounds: its row, and whether it
	/// lies below; `-1` where every one is inside.
	fn violated(ref self) -> SvViolation {
		let mut best = SvViolation { row: -1, var: -1, below: false }
		let mut r = 0
		while r < self.rows.len() {
			let b = self.basic[r]
			let below = self.lower[b].set && sv_delta_cmp(self.values[b], self.lower[b].value) < 0
			let above = self.upper[b].set && sv_delta_cmp(self.values[b], self.upper[b].value) > 0
			if (below || above) && (best.var < 0 || b < best.var) {
				best = SvViolation { row: r, var: b, below: below }
			}
			r += 1
		}
		return best
	}

	/// The variables of row `r` that can move its basic variable up
	/// (`below`) or down, in the order the rule tries them: smallest
	/// coefficient first, or, under Bland's rule, lowest first.
	fn entering(ref self, r: i64, below: bool, bland: bool) -> Vec[i64] {
		let b = self.basic[r]
		let mut out: Vec[i64] = []
		let mut cost: Vec[i64] = []
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let v = self.rows[r].cols[i] as i64
			let a = self.rows[r].ks[i]
			i += 1
			if v == b {
				continue
			}
			let can_rise = !self.upper[v].set
				|| sv_delta_cmp(self.values[v], self.upper[v].value) < 0
			let can_fall = !self.lower[v].set
				|| sv_delta_cmp(self.values[v], self.lower[v].value) > 0
			// `d·x_b = Σ a·x`: `x_b` rises with `x` where `a > 0`.
			let rises_with = a > 0
			let ok = if rises_with == below { can_rise } else { can_fall }
			if !ok {
				continue
			}
			let size = if bland { v } else { a.checked_abs() ?? continue }
			// Insert by `(size, v)`; the columns come ascending, so a tie
			// keeps the lower variable first.
			let mut at = out.len()
			while at > 0 && cost[at - 1] > size {
				at -= 1
			}
			out.insert(at, v)
			cost.insert(at, size)
		}
		return out
	}

	/// Pivots until every variable is inside its bounds (`Consistent`) or a
	/// row shows they cannot be (`Conflict`).
	fn feasible(ref mut self, mut book: SvBook) -> SvChecked {
		let mut count = 0
		while true {
			let at = self.violated()
			if at.row < 0 {
				return SvChecked::Consistent
			}
			if count >= self.pivot_limit {
				return SvChecked::Unknown(LgUnknown::TooManyCases)
			}
			let r = at.row
			let b = at.var
			let candidates = self.entering(r, at.below, count >= self.bland_after)
			if candidates.len() == 0 {
				// `d·x_b` cannot reach the violated side: the row's bound
				// from the other side and that side add up to `c < 0`.
				let mut parts = self.row_parts(r, at.below) ?? return self.overflow()
				let d = sv_row_coef(self.rows[r], b.checked_u32() ?? 0).checked_neg()
					?? return self.overflow()
				let side = if at.below { self.lower[b].clone() } else { self.upper[b].clone() }
				parts.push(sv_side_part(side, !at.below, d))
				return self.conflict(parts, book)
			}
			let mut pivoted = false
			for j in candidates {
				if self.pivot(r, j) {
					pivoted = true
					break
				}
			}
			if !pivoted {
				return self.overflow()
			}
			let target = if at.below { self.lower[b].value.clone() } else {
				self.upper[b].value.clone()
			}
			self.values[b] = target
			if !self.refresh() {
				return self.overflow()
			}
			count += 1
			self.pivots += 1
		}
	}

	/// The lowest query column whose value is no integer, `-1` where there
	/// is none.
	fn fractional(ref self) -> i64 {
		let mut v = 0
		while v < self.var_col.len() {
			let value = self.values[v].clone()
			if self.var_col[v] >= 0 && !self.is_real(v) && (value.c.den != 1 || value.k.num != 0) {
				return v
			}
			v += 1
		}
		return -1
	}

	/// Whether variable `v`'s form holds a real column (ADR-270 D27).
	fn is_real(ref self, v: i64) -> bool {
		return sv_row_real(self.var_form[v], self.reals)
	}

	/// Whether tableau row `r` holds a real variable.
	fn row_real(ref self, r: i64) -> bool {
		for c in self.rows[r].cols {
			if self.is_real(c as i64) {
				return true
			}
		}
		return false
	}

	/// The query columns' values as rationals, by name, `δ` replaced by a
	/// positive rational small enough that every variable keeps its sides:
	/// at most 1, and for a side `lc + lk·δ` below a value `c + k·δ` with
	/// `c > lc`, `k < lk`, at most `(c - lc) / (lk - k)` (above, mirrored).
	/// `null` where a step leaves `i64`.
	fn rational_values(ref self) -> collections::BTreeMap[String, SvRat]? {
		let mut delta = sv_int(1)
		let mut v = 0
		while v < self.var_col.len() {
			let value = self.values[v].clone()
			let lo = self.lower[v].clone()
			let hi = self.upper[v].clone()
			if lo.set
				&& sv_rat_cmp(value.c, lo.value.c) > 0
				&& sv_rat_cmp(value.k, lo.value.k) < 0 {
					let gap = sv_rat_sub(value.c, lo.value.c) ?? return null
					let slope = sv_rat_sub(lo.value.k, value.k) ?? return null
					let most = sv_rat_div(gap, slope) ?? return null
					if sv_rat_cmp(most, delta) < 0 {
						delta = most
					}
				}
			if hi.set
				&& sv_rat_cmp(hi.value.c, value.c) > 0
				&& sv_rat_cmp(hi.value.k, value.k) < 0 {
					let gap = sv_rat_sub(hi.value.c, value.c) ?? return null
					let slope = sv_rat_sub(value.k, hi.value.k) ?? return null
					let most = sv_rat_div(gap, slope) ?? return null
					if sv_rat_cmp(most, delta) < 0 {
						delta = most
					}
				}
			v += 1
		}
		let mut out: collections::BTreeMap[String, SvRat] = collections::BTreeMap()
		v = 0
		while v < self.var_col.len() {
			let col = self.var_col[v]
			if col >= 0 {
				let value = self.values[v].clone()
				let shift = sv_rat_mul(value.k, delta) ?? return null
				let at = sv_rat_add(value.c, shift) ?? return null
				out.insert(sv_column_name(col.checked_u32() ?? return null, self.names), at)
			}
			v += 1
		}
		return out
	}

	/// The query columns' values, by name, where every one is an integer.
	fn integer_values(ref self) -> collections::BTreeMap[String, i64] {
		let mut out: collections::BTreeMap[String, i64] = collections::BTreeMap()
		let mut v = 0
		while v < self.var_col.len() {
			let col = self.var_col[v]
			if col >= 0 {
				let c = col.checked_u32() ?? 0
				out.insert(sv_column_name(c, self.names), self.values[v].c.num)
			}
			v += 1
		}
		return out
	}

	fn is_implied(ref self, l: u32) -> bool {
		for i in self.implied {
			if i.lit == l {
				return true
			}
		}
		return false
	}
}

impl SvTh for SvSimplex {
	fn push_level(ref mut self) {
		self.levels.push(self.undo.len())
		self.marks.push(self.trail.len())
	}

	fn level(ref self) -> i64 {
		return self.levels.len()
	}

	/// `assert(lit)`: the literal's bound holds from now on. A bound that
	/// crosses the other side of its variable is a conflict at once.
	fn assert(ref mut self, lit: u32, mut book: SvBook) -> SvChecked {
		self.trail.push(lit)
		let a = book.asserted(lit) ?? return SvChecked::Unknown(LgUnknown::OutsideTheTheory)
		return self.bound(a.bound.row, a.bound.rel, a.src, book)
	}

	/// A bound entry of the log that holds at every level, asserted before
	/// the first `push` (a congruence's `x - a - d·q >= 0`).
	fn fact(ref mut self, id: u32, mut book: SvBook) -> SvChecked {
		let b = (book.bounds.get(id) ?? return SvChecked::Unknown(LgUnknown::OutsideTheTheory)).clone()
		return self.bound(b.row, b.rel, SvSrc::Fact(id), book)
	}

	/// `check(final, limit)`: whether what is asserted has rational values
	/// (not final) or integer ones (final, branch-and-bound within
	/// `limit.cases` splits).
	fn check(ref mut self, final: bool, limit: ref LgBudget, mut book: SvBook) -> SvChecked {
		let relaxed = self.feasible(book)
		match relaxed {
			SvChecked::Consistent => {},
			else => {
				return relaxed
			},
		}
		if self.gcd_test {
			let failed = self.gcd_conflict(book)
			if failed != null {
				self.gcd_conflicts += 1
				return SvChecked::Conflict(failed ?? return self.overflow())
			}
		}
		if !final {
			return SvChecked::Consistent
		}
		let v = self.fractional()
		if v < 0 {
			self.found = self.integer_values()
			self.found_real = self.rational_values() ?? collections::BTreeMap()
			return SvChecked::Consistent
		}
		if self.cut_kind != "none" && self.cut_depth < self.cut_rounds {
			let b = self.fractional_basic()
			if b >= 0 {
				let cut = self.cut_check(b, limit, book)
				if cut != null {
					return cut ?? self.overflow()
				}
			}
		}
		if self.splits >= limit.cases {
			return SvChecked::Unknown(LgUnknown::TooManyCases)
		}
		self.splits += 1
		let col = self.var_col[v]
		let value = self.values[v].clone()
		// `⌊value⌋` in the order with `δ`: `3 - δ` lies below 3.
		let floor = sv_rat_floor(value.c)
		let k = if value.c.den == 1 && value.k.num < 0 { floor - 1 } else { floor }
		let le = SvRow {
			cols: [col.checked_u32() ?? return self.overflow()],
			ks: [1],
			constant: k.checked_neg() ?? return self.overflow(),
		}
		let ge = SvRow {
			cols: [col.checked_u32() ?? return self.overflow()],
			ks: [-1],
			constant: k.checked_add(1) ?? return self.overflow(),
		}
		let split = book.split(le, ge) ?? return self.overflow()
		if !self.branching {
			return SvChecked::Lemmas([split])
		}
		let mut refuted: Vec[SvClause] = []
		for side in split.lits {
			let level = self.level()
			self.push_level()
			let mut got = self.assert(side, book)
			match got {
				SvChecked::Consistent => {
					got = self.check(true, limit, book)
				},
				else => {},
			}
			self.backtrack(level)
			match got {
				SvChecked::Conflict(clause) => {
					if !clause.lits.contains(sv_sx_not(side)) {
						// Refuted without this side: so is the branch.
						return SvChecked::Conflict(clause.clone())
					}
					refuted.push(clause.clone())
				},
				else => {
					return got
				},
			}
		}
		// Each side's clause, unit on the side's negation, then the split's
		// clause false: learned by unit propagation through the three.
		let mut lits: Vec[u32] = []
		for c in refuted {
			for l in c.lits {
				let side = sv_sx_not(l)
				if !split.lits.contains(side) && !lits.contains(l) {
					lits.push(l)
				}
			}
		}
		lits.sort()
		let id = book.learn(lits.clone(), [refuted[0].id, refuted[1].id, split.id])
		return SvChecked::Conflict(SvClause { id: id, lits: lits })
	}

	/// `propagate()`: each literal of the book's atoms, neither asserted nor
	/// propagated yet, that a bound of its variable implies, or, for a basic
	/// variable, the bounds of its row.
	fn propagate(ref mut self, book: ref SvBook) -> Vec[u32] {
		let mut out: Vec[u32] = []
		let count = book.atoms.len().checked_u32() ?? return out
		let mut a: u32 = 0
		while a < count {
			for l in [sv_lit(a, false), sv_lit(a, true)] {
				if self.trail.contains(l) || self.is_implied(l) {
					continue
				}
				let mine = book.lit_bound(l) ?? continue
				if mine.row.cols.len() == 0 {
					continue
				}
				match mine.rel {
					SvRel::Eq => continue,
					else => {},
				}
				// The explanation needs the negation's bound.
				if book.lit_bound(sv_sx_not(l)) == null {
					continue
				}
				let reading = sv_reading(mine.row, mine.rel) ?? continue
				// Every atom's form gets its variable here, as the theory
				// registers the atoms up front in Dutertre and de Moura: a
				// new slack is basic, so its row bound can imply the atom.
				let v = self.form_var(reading.form) ?? continue
				let up = reading.upper
				let side = if up { self.upper[v].clone() } else { self.lower[v].clone() }
				if side.set {
					let order = sv_delta_cmp(side.value, reading.value)
					if (up && order <= 0) || (!up && order >= 0) {
						self.implied.push(SvImplied {
							lit: l,
							level: self.level(),
							parts: [sv_side_part(side, up, 1)],
							d: 1,
						})
						out.push(l)
						continue
					}
				}
				let r = self.row_of[v]
				if r < 0 {
					continue
				}
				let got = self.row_bound(r, up) ?? continue
				let order = sv_delta_cmp(got, reading.value)
				if (up && order <= 0) || (!up && order >= 0) {
					let parts = self.row_parts(r, up) ?? continue
					let d = sv_row_coef(self.rows[r], v.checked_u32() ?? continue).checked_neg()
						?? continue
					self.implied.push(SvImplied { lit: l, level: self.level(), parts: parts, d: d })
					out.push(l)
				}
			}
			a += 1
		}
		return out
	}

	/// `explain(lit)`: the clause behind a propagated literal, a Farkas
	/// lemma of the bounds it follows from and its negation.
	fn explain(ref mut self, lit: u32, mut book: SvBook) -> SvClause? {
		for i in self.implied {
			if i.lit != lit {
				continue
			}
			let negation = sv_sx_not(lit)
			let b = book.lit_bound(negation) ?? return null
			let reading = sv_reading(b.row, b.rel) ?? return null
			let mut parts = i.parts.clone()
			parts.push(SvPart {
				src: SvSrc::Lit(negation),
				num: i.d,
				scale: reading.scale,
				neg: !reading.upper,
			})
			return sv_sx_lemma(parts, book)
		}
		return null
	}

	/// `backtrack(level)`: the bounds and the trail as they were when
	/// `level` ended; the basis and the values stay.
	fn backtrack(ref mut self, level: i64) {
		if level >= self.levels.len() {
			return
		}
		let keep = self.levels[level]
		while self.undo.len() > keep {
			let u = self.undo.pop() ?? break
			if u.upper {
				self.upper[u.var] = u.old
			} else {
				self.lower[u.var] = u.old
			}
		}
		self.trail.truncate(self.marks[level])
		self.levels.truncate(level)
		self.marks.truncate(level)
		let mut kept: Vec[SvImplied] = []
		for i in self.implied {
			if i.level <= level {
				kept.push(i.clone())
			}
		}
		self.implied = kept
	}

	/// `model()`: the integer values of the last final `check`, by name.
	fn model(ref self) -> collections::BTreeMap[String, i64] {
		return self.found.clone()
	}

	/// `real_values()`: the rational values of the last final `check`.
	fn real_values(ref self) -> collections::BTreeMap[String, SvRat] {
		return self.found_real.clone()
	}

	/// `shared()`: none while the simplex is the only theory (D13).
	fn shared(ref self) -> Vec[u32] {
		return []
	}
}

/// The side a non-basic variable sits on.
pub struct SvActive {
	pub side: SvSide,
	pub upper: bool,
}

/// A non-basic variable of a tableau row read at the vertex: its side, and
/// `β` in `x_b = v + Σ β·y'`, `y' >= 0` its distance from that side.
pub struct SvGomory {
	pub var: i64,
	pub side: SvSide,
	pub upper: bool,
	pub beta: SvRat,
}

/// A Gomory mixed-integer cut: the literal of its atom and the learned
/// clause that it holds where what it assumed holds.
pub struct SvGmi {
	pub lit: u32,
	pub clause: SvClause,
}

/// The part of a side with the rational weight `w`.
fn sv_sx_weighted(side: ref SvSide, upper: bool, w: ref SvRat) -> SvPart? {
	return SvPart {
		src: side.src.clone(),
		num: w.num,
		scale: side.scale.checked_mul(w.den) ?? return null,
		neg: !upper,
	}
}

/// Whether `value REL 0` fails.
fn sv_sx_violated(rel: SvRel, value: ref SvDelta) -> bool {
	let order = sv_delta_cmp(value, sv_sx_zero())
	return match rel {
		SvRel::Le => order > 0,
		SvRel::Lt => order >= 0,
		SvRel::Eq => order != 0,
	}
}

/// `lits` without `drop`, with `add` where it is no `null`-literal
/// (`u32::MAX` for none), ascending.
fn sv_sx_relit(lits: ref Vec[u32], drop: ref Vec[u32], add: ref Vec[u32]) -> Vec[u32] {
	let mut out: Vec[u32] = []
	for l in lits {
		if !drop.contains(l) && !out.contains(l) {
			out.push(l)
		}
	}
	for l in add {
		if !out.contains(l) {
			out.push(l)
		}
	}
	out.sort()
	return out
}

/// **Cuts** (ADR-270 D5, #1284 item 1), tried by a final check before it
/// splits. Each is written as D5 allows a cut, and the checker replays it:
///
/// * **The GCD test on a row**: a tableau row `Σ k·v = 0` whose fixed
///   variables add up to a constant `K` the gcd `g` of the other
///   coefficients does not divide. The fixed variables' sides, combined
///   once from above and once from below, give `±(P + K) <= 0` over the
///   query columns for the form `P` of the others, whose coefficients `g`
///   divides; each rounded, the two add up to `1 <= 0`.
/// * **Gomory's fractional cut** (`"cg"`), a Chvátal-Gomory derivation: for
///   a basic query column `x_b = v + Σ β·y'` with `v` no integer, the sides
///   of its row's non-basic variables with the weights `⌈β⌉ - β` combine to
///   `x_b - Σ ⌈β⌉·y' - v <= 0`, whose rounding cuts the vertex off.
/// * **Gomory's mixed-integer cut** (`"gmi"`), a split cut: on the integer
///   form `L = x_b - Σ k·y'` (`k` the floor or the ceiling of `β` as its
///   fraction lies below or above `f0`, the fraction of `v`), the split
///   `L <= ⌊L*⌋ ∨ L >= ⌊L*⌋ + 1`; the cut `Σ α·y' >= 1` is a second split's
///   atom (the cut, or one more than it fails), refuted on its failing side
///   by one Farkas lemma per side of the first split, and the resolution is
///   two learned clauses: the cut holds where the sides it used hold.
impl SvSimplex {
	/// The side non-basic variable `u` sits on; `null` where it sits on
	/// none or the side holds `δ`.
	fn active(ref self, u: i64) -> SvActive? {
		let lo = self.lower[u].clone()
		if lo.set && lo.value.k.num == 0 && sv_delta_cmp(self.values[u], lo.value) == 0 {
			return SvActive { side: lo, upper: false }
		}
		let up = self.upper[u].clone()
		if up.set && up.value.k.num == 0 && sv_delta_cmp(self.values[u], up.value) == 0 {
			return SvActive { side: up, upper: true }
		}
		return null
	}

	/// The value of a form over the query columns at the vertex; `null`
	/// where a column has no variable or a step leaves `i64`.
	fn form_value(ref self, row: ref SvRow) -> SvDelta? {
		let mut sum = sv_delta(sv_int(row.constant), sv_int(0))
		let mut i = 0
		while i < row.cols.len() {
			let known: i64? = self.col_var.get(row.cols[i])
			if known == null {
				return null
			}
			let v = known ?? 0
			let term = sv_delta_scale(self.values[v], sv_int(row.ks[i])) ?? return null
			sum = sv_delta_add(sum, term) ?? return null
			i += 1
		}
		return sum
	}

	/// The first row whose GCD test fails, as a Farkas lemma; `null` where
	/// none does.
	fn gcd_conflict(ref mut self, mut book: SvBook) -> SvClause? {
		let mut r = 0
		while r < self.rows.len() {
			let got = self.row_gcd(r, book)
			if got != null {
				return got
			}
			r += 1
		}
		return null
	}

	/// The GCD test on row `r` (see above).
	fn row_gcd(ref mut self, r: i64, mut book: SvBook) -> SvClause? {
		// A real variable may take any rational: no GCD test (ADR-270 D27).
		if self.row_real(r) {
			return null
		}
		let row = self.rows[r].clone()
		let mut g: i64 = 0
		let mut constant = sv_int(0)
		let mut above: Vec[SvPart] = []
		let mut below: Vec[SvPart] = []
		let mut i = 0
		while i < row.cols.len() {
			let v = row.cols[i] as i64
			let k = row.ks[i]
			i += 1
			let lo = self.lower[v].clone()
			let hi = self.upper[v].clone()
			let fixed = lo.set && hi.set && lo.value.k.num == 0 && hi.value.k.num == 0
				&& sv_rat_cmp(lo.value.c, hi.value.c) == 0
			if !fixed {
				g = sv_gcd(g, k) ?? return null
				continue
			}
			let a = k.checked_abs() ?? return null
			// `k·v` from above takes a positive `k`'s upper side, from below
			// its lower side.
			if k > 0 {
				above.push(sv_side_part(hi, true, a))
				below.push(sv_side_part(lo, false, a))
			} else {
				above.push(sv_side_part(lo, false, a))
				below.push(sv_side_part(hi, true, a))
			}
			let term = sv_rat_mul(lo.value.c, sv_int(k)) ?? return null
			constant = sv_rat_add(constant, term) ?? return null
		}
		if g == 0 || above.len() == 0 {
			return null
		}
		let q = sv_rat_div(constant, sv_int(g)) ?? return null
		if sv_rat_is_int(q) {
			return null
		}
		let up = sv_sx_multipliers(above) ?? return null
		let down = sv_sx_multipliers(below) ?? return null
		let a_id = book.combine(up.sources, up.ms) ?? return null
		let b_id = book.combine(down.sources, down.ms) ?? return null
		let ra = book.round(a_id) ?? return null
		let rb = book.round(b_id) ?? return null
		return book.farkas([SvSrc::Fact(ra), SvSrc::Fact(rb)], [1, 1])
	}

	/// The lowest basic query column whose value is no integer and holds no
	/// `δ`, on a row without a real variable; `-1` where there is none.
	fn fractional_basic(ref self) -> i64 {
		let mut v = 0
		while v < self.var_col.len() {
			let value = self.values[v].clone()
			let basic = self.var_col[v] >= 0 && self.row_of[v] >= 0
			if basic && value.c.den != 1 && value.k.num == 0 && !self.row_real(self.row_of[v]) {
				return v
			}
			v += 1
		}
		return -1
	}

	/// Basic `b`'s row read at the vertex; `null` where a non-basic variable
	/// sits on no side free of `δ`.
	fn gomory_row(ref self, b: i64) -> Vec[SvGomory]? {
		let r = self.row_of[b]
		let d = sv_row_coef(self.rows[r], b.checked_u32() ?? return null).checked_neg()
			?? return null
		let mut out: Vec[SvGomory] = []
		let mut i = 0
		while i < self.rows[r].cols.len() {
			let u = self.rows[r].cols[i] as i64
			let k = self.rows[r].ks[i]
			i += 1
			if u == b {
				continue
			}
			let at = self.active(u) ?? return null
			let beta0 = sv_rat(k, d) ?? return null
			let beta = if at.upper { sv_rat_neg(beta0) ?? return null } else { beta0 }
			out.push(SvGomory { var: u, side: at.side, upper: at.upper, beta: beta })
		}
		return out
	}

	/// Gomory's fractional cut on `terms`, combined and rounded in the log:
	/// its bound entry; `null`, nothing written, where it would not cut the
	/// vertex off.
	fn gomory_cg(ref mut self, terms: ref Vec[SvGomory], mut book: SvBook) -> u32? {
		let mut parts: Vec[SvPart] = []
		for t in terms {
			let w = sv_rat_sub(sv_int(sv_rat_ceil(t.beta)), t.beta) ?? return null
			if w.num != 0 {
				parts.push(sv_sx_weighted(t.side, t.upper, w) ?? return null)
			}
		}
		if parts.len() == 0 {
			return null
		}
		let mult = sv_sx_multipliers(parts) ?? return null
		let sum = book.sum(mult.sources, mult.ms) ?? return null
		let g = sv_row_content(sum.row) ?? return null
		if g <= 1 {
			return null
		}
		let cut = sv_rounded(sum, g) ?? return null
		let at = self.form_value(cut.row) ?? return null
		if !sv_sx_violated(cut.rel, at) {
			return null
		}
		let id = book.combine(mult.sources, mult.ms) ?? return null
		return book.round(id)
	}

	/// Gomory's mixed-integer cut for basic `b` on `terms`, written as the
	/// split cut described above; `null` where a step leaves `i64`.
	fn gomory_gmi(ref mut self, b: i64, terms: ref Vec[SvGomory], mut book: SvBook) -> SvGmi? {
		let v = self.values[b].c.clone()
		let f0 = sv_rat_sub(v, sv_int(sv_rat_floor(v))) ?? return null
		let rest = sv_rat_sub(sv_int(1), f0) ?? return null
		// `L = F_b - Σ k·s·F_u`, `y' = s·(F_u - bound)`, `s = -1` on an upper side.
		let mut l_terms: Vec[SvTerm] = []
		let form_b = self.var_form[b].clone()
		let mut i = 0
		while i < form_b.cols.len() {
			l_terms.push(SvTerm { col: form_b.cols[i], k: form_b.ks[i] })
			i += 1
		}
		// The cut's columns and coefficients, parallel; a map's `get` with a
		// default fails in rustc here: #1302.
		let mut cut_cols: Vec[u32] = []
		let mut cut_ks: Vec[SvRat] = []
		let mut cut_c = sv_int(1)
		let mut side1: Vec[SvRat] = []
		let mut side2: Vec[SvRat] = []
		for t in terms {
			let s: i64 = if t.upper { -1 } else { 1 }
			let bound = t.side.value.c.clone()
			// A side off the integers keeps `k = 0`, so `L*` keeps `f0`.
			let mut k: i64 = 0
			if bound.den == 1 {
				let fl = sv_rat_floor(t.beta)
				let fj = sv_rat_sub(t.beta, sv_int(fl)) ?? return null
				k = if sv_rat_cmp(fj, f0) <= 0 { fl } else { fl.checked_add(1) ?? return null }
			}
			let g = sv_rat_sub(t.beta, sv_int(k)) ?? return null
			let alpha = if g.num >= 0 { sv_rat_div(g, rest) ?? return null } else {
				sv_rat_div(sv_rat_neg(g) ?? return null, f0) ?? return null
			}
			let fa = sv_rat_mul(f0, alpha) ?? return null
			let ra = sv_rat_mul(rest, alpha) ?? return null
			side1.push(sv_rat_add(g, fa) ?? return null)
			side2.push(sv_rat_sub(ra, g) ?? return null)
			let form = self.var_form[t.var].clone()
			let ks = (k.checked_mul(s) ?? return null).checked_neg() ?? return null
			// The cut `1 - Σ α·s·(F_u - bound) <= 0`.
			let a_s = sv_rat_mul(alpha, sv_int(s)) ?? return null
			let mut j = 0
			while j < form.cols.len() {
				let c = form.cols[j]
				if ks != 0 {
					l_terms.push(SvTerm { col: c, k: ks.checked_mul(form.ks[j]) ?? return null })
				}
				let add = sv_rat_mul(a_s, sv_int(form.ks[j])) ?? return null
				let mut at = 0
				while at < cut_cols.len() && cut_cols[at] != c {
					at += 1
				}
				if at == cut_cols.len() {
					cut_cols.push(c)
					cut_ks.push(sv_int(0))
				}
				cut_ks[at] = sv_rat_sub(cut_ks[at], add) ?? return null
				j += 1
			}
			cut_c = sv_rat_add(cut_c, sv_rat_mul(a_s, bound) ?? return null) ?? return null
		}
		let l_form = sv_row_of(l_terms, 0) ?? return null
		let at = self.form_value(l_form) ?? return null
		if at.k.num != 0 || at.c.den == 1 {
			return null
		}
		let fl = sv_rat_floor(at.c)
		if sv_rat_cmp(sv_rat_sub(at.c, sv_int(fl)) ?? return null, f0) != 0 {
			return null
		}
		// The cut over one denominator.
		let mut den: i64 = cut_c.den
		for r in cut_ks {
			let g = sv_gcd(den, r.den) ?? return null
			den = (den / g).checked_mul(r.den) ?? return null
		}
		let mut c_terms: Vec[SvTerm] = []
		let mut n = 0
		while n < cut_cols.len() {
			let r = cut_ks[n].clone()
			c_terms.push(SvTerm {
				col: cut_cols[n],
				k: r.num.checked_mul(den / r.den) ?? return null,
			})
			n += 1
		}
		let hold = sv_row_of(c_terms, cut_c.num.checked_mul(den / cut_c.den) ?? return null)
			?? return null
		if hold.cols.len() == 0 {
			return null
		}
		let le = sv_row_sum(1, l_form, 1, sv_row_constant(fl.checked_neg() ?? return null))
			?? return null
		let ge = sv_row_sum(-1, l_form, 1, sv_row_constant(fl.checked_add(1) ?? return null))
			?? return null
		let fail = sv_row_sum(-1, hold, 1, sv_row_constant(1)) ?? return null
		let split_l = book.split(le, ge) ?? return null
		let split_c = book.split(hold, fail) ?? return null
		let s1 = split_l.lits[0]
		let s2 = split_l.lits[1]
		let a_hold = split_c.lits[0]
		let a_fail = split_c.lits[1]
		let mut clauses: Vec[SvClause] = []
		for (side, f, weights) in [(s1, f0.clone(), side1), (s2, rest.clone(), side2)] {
			let mut parts: Vec[SvPart] = [
				SvPart {
					src: SvSrc::Lit(a_fail),
					num: f.num,
					scale: f.den.checked_mul(den) ?? return null,
					neg: false,
				},
				SvPart { src: SvSrc::Lit(side), num: 1, scale: 1, neg: false },
			]
			let mut n = 0
			while n < terms.len() {
				if weights[n].num != 0 {
					parts.push(sv_sx_weighted(
						terms[n].side,
						terms[n].upper,
						weights[n],
					) ?? return null)
				}
				n += 1
			}
			clauses.push(sv_sx_lemma(parts, book) ?? return null)
		}
		let both = sv_lits_union(clauses[0].lits, clauses[1].lits)
		let failing = sv_sx_relit(both, [sv_sx_not(s1), sv_sx_not(s2)], [])
		let c3 = book.learn(failing.clone(), [clauses[0].id, clauses[1].id, split_l.id])
		let holding = sv_sx_relit(failing, [sv_sx_not(a_fail)], [a_hold])
		let c4 = book.learn(holding.clone(), [split_c.id, c3])
		return SvGmi { lit: a_hold, clause: SvClause { id: c4, lits: holding } }
	}

	/// A cut for basic `b` asserted in a level of its own and the check run
	/// again over it; `null`, nothing asserted, where no cut is made. A
	/// conflict over a mixed-integer cut's atom is resolved with the cut's
	/// clause, so the atom never leaves the check.
	fn cut_check(ref mut self, b: i64, limit: ref LgBudget, mut book: SvBook) -> SvChecked? {
		let terms = self.gomory_row(b) ?? return null
		let level = self.level()
		if self.cut_kind == "cg" {
			let id = self.gomory_cg(terms, book) ?? return null
			self.cuts += 1
			self.push_level()
			let mut got = self.fact(id, book)
			match got {
				SvChecked::Consistent => {
					self.cut_depth += 1
					got = self.check(true, limit, book)
					self.cut_depth -= 1
				},
				else => {},
			}
			self.backtrack(level)
			return got
		}
		let made = self.gomory_gmi(b, terms, book) ?? return null
		self.cuts += 1
		self.push_level()
		let mut got = self.assert(made.lit, book)
		match got {
			SvChecked::Consistent => {
				self.cut_depth += 1
				got = self.check(true, limit, book)
				self.cut_depth -= 1
			},
			else => {},
		}
		self.backtrack(level)
		return match got {
			SvChecked::Conflict(k) => {
				let not_hold = sv_sx_not(made.lit)
				if !k.lits.contains(not_hold) {
					return got
				}
				let open = sv_sx_relit(made.clause.lits, [made.lit], [])
				let lits = sv_sx_relit(k.lits, [not_hold], open)
				let id = book.learn(lits.clone(), [made.clause.id, k.id])
				SvChecked::Conflict(SvClause { id: id, lits: lits })
			},
			else => got,
		}
	}
}

/// The basic variable `check` repairs next.
pub struct SvViolation {
	pub row: i64,
	pub var: i64,
	pub below: bool,
}
