# **The Rust the toolchain's own Nikaia reads** (ADR-294 D9.3), described as
# `nikaia describe` describes a crate for a program: a claim reviewed like
# code. `nikaia lower-std` checks a module of `src/tools/` against `std`'s
# ledger and this one; a program never reads it.
version = 2
toolchain = "described"
inference = "described"

# `winnow_grammar::Symbol`, the table it is interned into,
# `winnow_grammar::InternerContext`, and its `new` and `resolve` are `std`'s
# (ADR-388 D3): a program makes the table its grammar interns into and reads
# its symbols back.

# The id every expression node of the tree carries (ADR-340, #558): a `u32`
# the parser gives, compared as equal whatever the number (D3), so a key is
# `get`, never the id itself.
[type."node_id::NodeId"]
pub = true
crosses = true
compares = true
copies = true

# The id of a node the compiler builds after parsing: one no other node has.
[fn."node_id::NodeId::fresh"]
pub = true
sync = true
touches = []
signature = "() -> node_id::NodeId"

# The number a table is keyed on.
[fn."node_id::NodeId::get"]
pub = true
sync = true
touches = []
signature = "(self: node_id::NodeId) -> u32"

# The id with this number: what the parser gives the nodes it makes, in order.
[fn."node_id::NodeId::numbered"]
pub = true
sync = true
touches = []
signature = "(number: u32) -> node_id::NodeId"

# The id of a node the grammar makes, not yet numbered (ADR-383 D1).
[fn."node_id::NodeId::parsed"]
pub = true
sync = true
touches = []
signature = "() -> node_id::NodeId"

# Whether the numbering pass has still to number it (ADR-383 D3).
[fn."node_id::NodeId::is_parsed"]
pub = true
sync = true
touches = []
signature = "(self: node_id::NodeId) -> bool"

# Where the node was read, until the pass numbers it (ADR-383 D4).
[fn."node_id::NodeId::span"]
pub = true
sync = true
touches = []
signature = "(self: node_id::NodeId) -> (u32, u32)?"
