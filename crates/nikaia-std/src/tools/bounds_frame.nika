// crates/nikaia-std/src/tools/bounds_frame.nika
//
// **What each function of the program may write** (ADR-391 D2, #1328): its
// frame, the paths it may change through `mut self` and through each `mut`
// parameter - a field, a field's length, an element. A call then forgets
// only what its callee's frame names, where it forgot every fact about the
// receiver (ADR-306 D17).
//
// A frame is what the walk takes a block to change (`bounding_changed`),
// read off the function's body and kept for the paths that start at `self`
// or at a `mut` parameter, each written from its root: `#self` for the
// receiver, `#0`, `#1`, ... for the parameters by position. A call in the
// body adds its callee's frame, put onto what it is handed; so every frame
// is found again from the last ones until none changes, starting from
// nothing, over the call graph. A call the walk cannot resolve writes what
// it wrote before: every path it is handed, any part of its receiver.
//
// Nothing here changes a meaning or a check: a frame only keeps facts the
// walk would throw away (ADR-391 D2), and it is never published (D4).

use std::collections

/// **The deepest a frame's path goes below its root.** A deeper one, which
/// only a recursion through a part of a part reaches, is cut there and taken
/// as written whole: the frames stay finite, and so does their search.
fn frame_depth() -> i64 {
	return 4
}

/// The most rounds the search takes; one that has not settled by then
/// leaves the program without frames, every call writing what it wrote
/// before.
fn frame_rounds() -> i64 {
	return 64
}

/// **What the program around every body says about a call**: each free
/// function's parameters, `true` where one is `mut`; the methods that take a
/// parameter `mut`, of this program and of what `ledgers` describe; those
/// that take their receiver `mut` (ADR-306 D17); and every function's frame,
/// by its name or by `Type::method` (ADR-391 D2). `beside` are the package's
/// other files, `beside_words` their words: a private function's call sites
/// may stand there (ADR-391 D1).
pub fn bounds_around(
	program: ref Program,
	beside: ref Vec[ref Program],
	beside_words: ref Vec[ref winnow_grammar::InternerContext],
	ledgers: ref Vec[ref Ledger],
	std_receivers: ref collections::BTreeMap[i64, String],
	simd_loads: ref collections::BTreeMap[i64, i64],
	words: ref winnow_grammar::InternerContext,
) -> Around {
	let mut around = Around {
		functions: collections::BTreeMap(),
		changing_methods: bm_changing_methods(ledgers),
		changing_receivers: collections::BTreeSet(),
		frames: collections::BTreeMap(),
		rules: [],
		held: collections::BTreeMap(),
		derived: no_derived(),
		fields: collections::BTreeSet(),
		field_writers: collections::BTreeSet(),
		field_bounds: collections::BTreeMap(),
		returning: collections::BTreeSet(),
	}
	for item in program.items {
		match item.node {
			Item::Impl { methods, .. } => {
				for method in methods {
					match method.node {
						Item::Fn { name, args, receiver, .. } => {
							let written = name ?? continue
							if args.iter().any(fn(a) { a.mutable }) {
								around.changing_methods.insert(words.resolve(written).clone())
							}
							if receiver?.is_mut ?? false {
								around.changing_receivers.insert(words.resolve(written).clone())
							}
						},
						else => {},
					}
				}
			},
			Item::Fn { name, receiver, args, .. } => {
				let written = name ?? continue
				if receiver == null {
					around.functions.insert(
						words.resolve(written).clone(),
						args.iter().map(fn(a) { a.mutable }).collect(),
					)
				}
			},
			else => {},
		}
	}
	let mut context = frame_context(around, std_receivers, simd_loads)
	// The search starts from every function writing nothing: a call to one
	// not found yet would write what it wrote before, and a recursion
	// would never get below that.
	for (key, _) in frames_round(program, context, words) {
		context.around.frames.insert(key.clone(), nothing_changed())
	}
	let mut round = 0
	let mut settled = false
	while round < frame_rounds() {
		let next = frames_round(program, context, words)
		if next == context.around.frames {
			settled = true
			break
		}
		context.around.frames = next
		round += 1
	}
	if !settled {
		context.around.frames = collections::BTreeMap()
	}
	// **The rules between list fields** read with the frames found
	// (ADR-369 D4, `bounds_rules.nika`): checked where a body uses them.
	let rules = rules_candidates(program, context, words)
	context.around.rules = rules
	// **The private functions their callers may bound** (ADR-391 D1).
	context.around.derived = derived_of(program, beside, beside_words, words)
	// **The list fields whose every write the walks see** (ADR-306 D21):
	// their bounds are found by `bounds_fields`, before the bodies' walks.
	let seen = fields_seen(program, beside, beside_words, words)
	context.around.fields = seen.keys
	context.around.field_writers = seen.writers
	return context.around
}

/// The context the search reads a body's changes with: only what a call
/// needs, `around` and the receivers' types.
fn frame_context(
	around: Around,
	std_receivers: ref collections::BTreeMap[i64, String],
	simd_loads: ref collections::BTreeMap[i64, i64],
) -> BoundsContext {
	return BoundsContext {
		lengths: collections::BTreeSet(),
		sized: collections::BTreeSet(),
		arithmetic: collections::BTreeMap(),
		nonnegative: collections::BTreeSet(),
		char_codes: collections::BTreeSet(),
		ensured: collections::BTreeMap(),
		required: collections::BTreeMap(),
		each: collections::BTreeMap(),
		std_receivers: std_receivers.clone(),
		simd_loads: simd_loads.clone(),
		shifts: collections::BTreeMap(),
		given: collections::BTreeMap(),
		negations: collections::BTreeMap(),
		classes: collections::BTreeMap(),
		text_lengths: collections::BTreeMap(),
		text_classes: collections::BTreeMap(),
		around: around,
		whole_fields: collections::BTreeSet(),
		whole_loops: collections::BTreeSet(),
		whole_parts: collections::BTreeMap(),
		array_lengths: collections::BTreeMap(),
		through_loops: false,
		trace: [],
		decided: collections::BTreeMap(),
		list_indices: collections::BTreeSet(),
		returns: collections::BTreeMap(),
	}
}

/// **Every function's frame, from the frames `context` holds.** Methods of
/// one type under one name are joined.
fn frames_round(
	program: ref Program,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> collections::BTreeMap[String, BoundsChanged] {
	let mut out: collections::BTreeMap[String, BoundsChanged] = collections::BTreeMap()
	for item in program.items {
		match item.node {
			Item::Fn { name, receiver, args, body, .. } => {
				let written = name ?? continue
				frame_join(
					out,
					words.resolve(written).clone(),
					frame_of_body(receiver, args, body, context, words),
				)
			},
			Item::Impl { target, methods, .. } => {
				let owner = words.resolve(target.name).clone()
				for method in methods {
					match method.node {
						Item::Fn { name, receiver, args, body, .. } => {
							let written = name ?? continue
							frame_join(
								out,
								f"{owner}::{words.resolve(written)}",
								frame_of_body(receiver, args, body, context, words),
							)
						},
						else => {},
					}
				}
			},
			else => {},
		}
	}
	return out
}

fn frame_join(
	mut frames: collections::BTreeMap[String, BoundsChanged],
	key: String,
	frame: BoundsChanged,
) {
	let mut joined = frames.get(key)?.clone() ?? nothing_changed()
	bounding_extend(joined, frame)
	frames.insert(key, joined)
}

/// **One function's frame**: what its body changes, kept for the paths from
/// `self`, where the receiver is `mut`, and from each `mut` parameter, each
/// written from its root. A name bound to a part of one of them - a `for`
/// binding, a `match` arm's, a lambda's parameter handed to a method on it -
/// writes there: what it changes is that part, written whole.
fn frame_of_body(
	receiver: ref Receiver?,
	args: ref Vec[FnArg],
	body: ref Block,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> BoundsChanged {
	let mut out = nothing_changed()
	let mut roots: collections::BTreeMap[String, String] = collections::BTreeMap()
	if receiver?.is_mut ?? false {
		roots.insert("self", "#self")
	}
	for (at, arg) in args.iter().enumerate() {
		if arg.mutable {
			roots.insert(words.resolve(arg.name).clone(), f"#{at}")
		}
	}
	if roots.is_empty() {
		return out
	}
	let changed = bounding_changed(body, context, words)
	let mut aliases: collections::BTreeMap[String, String] = collections::BTreeMap()
	// Two rounds: one alias may be bound to a part of another.
	frame_aliases_block(body, roots, aliases, words)
	frame_aliases_block(body, roots, aliases, words)
	for path in changed.values {
		frame_put(out, path, 0, roots, aliases)
	}
	for path in changed.lengths {
		frame_put(out, path, 1, roots, aliases)
	}
	for path in changed.falls {
		frame_put(out, path, 3, roots, aliases)
	}
	for path in changed.parts {
		frame_put(out, path, 2, roots, aliases)
	}
	for place in changed.elements {
		let pieces: Vec[ref String] = place.split("|").collect()
		if pieces.len() != 3 {
			continue
		}
		let list = pieces[0]
		if roots.contains_key(path_root(list)) {
			let mapped = frame_rooted(list, roots)
			if frame_deep(mapped) {
				out.values.insert(frame_cut(mapped))
			} else {
				// The element's index is the callee's own name: at the
				// call, any element.
				out.elements.insert(f"{mapped}||{pieces[2]}")
			}
		} else {
			frame_put(out, list, 0, roots, aliases)
		}
	}
	return out
}

/// A path the body changes, as `kind` says (0 its value, 1 its length, 2
/// the parts of it, 3 its length otherwise than by adding, #1414), put into
/// the frame from its root; through an alias, the part the alias is bound
/// to, written whole; a path from a local of the body's own, nowhere.
fn frame_put(
	mut out: BoundsChanged,
	path: ref String,
	kind: i64,
	roots: ref collections::BTreeMap[String, String],
	aliases: ref collections::BTreeMap[String, String],
) {
	let mut at = path.clone()
	let mut whole = false
	let mut steps = 0
	while !roots.contains_key(path_root(at)) {
		let source = aliases.get(path_root(at)) ?? return
		at = source.clone()
		whole = true
		steps += 1
		if steps > aliases.len() {
			// Bound to itself, through another: every root, written whole.
			for (_, root) in roots {
				out.values.insert(root.clone())
			}
			return
		}
	}
	let mapped = frame_rooted(at, roots)
	if whole || kind == 0 || frame_deep(mapped) {
		out.values.insert(frame_cut(mapped))
	} else if kind == 1 {
		out.lengths.insert(mapped)
	} else if kind == 3 {
		out.falls.insert(mapped)
	} else {
		out.parts.insert(mapped)
	}
}

/// `path` with its root written as the frame writes it: `#self.rows`.
fn frame_rooted(path: ref String, roots: ref collections::BTreeMap[String, String]) -> String {
	let root = path_root(path)
	let mapped = roots.get(root) ?? return path.clone()
	let rest = path.strip_prefix(root) ?? ""
	return f"{mapped}{rest}"
}

fn frame_deep(path: ref String) -> bool {
	return path.split(".").count() > frame_depth() + 1
}

/// `path` cut to the frame's depth below its root.
fn frame_cut(path: ref String) -> String {
	let kept: Vec[ref String] = path.split(".").take(frame_depth() + 1).collect()
	return kept.join(".")
}

/// **The names a body binds to a part of a root or of another such name**,
/// each with the path of that part.
fn frame_aliases_block(
	block: ref Block,
	roots: ref collections::BTreeMap[String, String],
	mut aliases: collections::BTreeMap[String, String],
	words: ref winnow_grammar::InternerContext,
) {
	for stmt in block.stmts {
		match stmt.node {
			Stmt::For { bindings, iter, .. } => {
				let source = frame_source(iter, roots, aliases, words)
				if source != null {
					for name in bindings {
						aliases.insert(words.resolve(name).clone(), (source ?? "").clone())
					}
				}
			},
			else => {},
		}
		for expr in check_visit_stmt(stmt.node) {
			match expr {
				Expr::Match { value, arms, .. } => {
					let source = frame_source(value, roots, aliases, words) ?? continue
					let mut names: Vec[String] = []
					for arm in arms {
						frame_pattern_names(arm.pattern, words, names)
					}
					for name in names {
						aliases.insert(name.clone(), source.clone())
					}
				},
				Expr::MethodCall { receiver, args, .. } => frame_lambda_aliases(
					receiver,
					args,
					roots,
					aliases,
					words,
				),
				Expr::SafeMethod { receiver, args, .. } => frame_lambda_aliases(
					receiver,
					args,
					roots,
					aliases,
					words,
				),
				else => {},
			}
		}
		for inner in check_visit_stmt_blocks(stmt.node) {
			frame_aliases_block(inner, roots, aliases, words)
		}
	}
}

/// A lambda handed to a method on a part of a root: its parameters may be
/// that part's values, changed in place (`m.update(k) fn(mut v) { ... }`).
fn frame_lambda_aliases(
	receiver: ref Expr,
	args: ref Vec[Expr],
	roots: ref collections::BTreeMap[String, String],
	mut aliases: collections::BTreeMap[String, String],
	words: ref winnow_grammar::InternerContext,
) {
	let source = frame_source(receiver, roots, aliases, words) ?? return
	for arg in args {
		match arg {
			Expr::Closure { params, .. } => {
				for name in params {
					aliases.insert(words.resolve(name).clone(), source.clone())
				}
			},
			else => {},
		}
	}
}

/// **The part of a root an expression reads**, as a path of fields: `x.rows`
/// of `x.rows[i]`, of `x.rows.iter()`, of `x.rows[i] ?? d`; none where it
/// starts at no root and no alias.
fn frame_source(
	expr: ref Expr,
	roots: ref collections::BTreeMap[String, String],
	aliases: ref collections::BTreeMap[String, String],
	words: ref winnow_grammar::InternerContext,
) -> String? {
	let path = path_of(expr, words)
	if path != null {
		let found = path ?? ""
		let root = path_root(found)
		if roots.contains_key(root) || aliases.contains_key(root) {
			return found.clone()
		}
		return null
	}
	return match expr {
		Expr::Index { base, .. } => frame_source(base, roots, aliases, words),
		Expr::Field { base, .. } => frame_source(base, roots, aliases, words),
		Expr::SafeField { base, .. } => frame_source(base, roots, aliases, words),
		Expr::MethodCall { receiver, .. } => frame_source(receiver, roots, aliases, words),
		Expr::SafeMethod { receiver, .. } => frame_source(receiver, roots, aliases, words),
		Expr::Coalesce { value, .. } => frame_source(value, roots, aliases, words),
		Expr::Unary { expr, .. } => frame_source(expr, roots, aliases, words),
		Expr::Try(inner, _) => frame_source(inner, roots, aliases, words),
		Expr::Cast { expr, .. } => frame_source(expr, roots, aliases, words),
		else => null,
	}
}

/// Every symbol a pattern names, bound or not: too many costs only a fact.
fn frame_pattern_names(
	pattern: ref MatchPattern,
	words: ref winnow_grammar::InternerContext,
	mut out: Vec[String],
) {
	match pattern {
		MatchPattern::Path(segments) => {
			for s in segments {
				out.push(words.resolve(s).clone())
			}
		},
		MatchPattern::Tuple { parts, .. } => {
			for p in parts {
				frame_pattern_names(p, words, out)
			}
		},
		MatchPattern::List(parts) => {
			for p in parts {
				frame_pattern_names(p, words, out)
			}
		},
		MatchPattern::RestNamed(name) => out.push(words.resolve(name).clone()),
		MatchPattern::Named { fields, .. } => {
			for field in fields {
				frame_pattern_names(field.pat, words, out)
			}
		},
		MatchPattern::Or(alternatives) => {
			for p in alternatives {
				frame_pattern_names(p, words, out)
			}
		},
		else => {},
	}
}

// --- a frame at a call -------------------------------------------------------

/// **What a call changes by its callee's frame** (ADR-391 D2): each path put
/// onto the receiver's path and the arguments' (`handed`, none where one is
/// not a path of fields). A value written is a value changed otherwise than
/// by a step, and its length with it.
pub fn frame_at_call(
	frame: ref BoundsChanged,
	receiver: ref String?,
	handed: ref Vec[String?],
) -> BoundsChanged {
	let mut out = nothing_changed()
	for path in frame.values {
		let on = frame_onto(path, receiver, handed) ?? continue
		out.values.insert(on.clone())
		out.jumps.insert(on.clone())
		out.drops.insert(on.clone())
		out.falls.insert(on.clone())
		out.lengths.insert(on)
	}
	for path in frame.lengths {
		out.lengths.insert(frame_onto(path, receiver, handed) ?? continue)
	}
	for path in frame.falls {
		out.falls.insert(frame_onto(path, receiver, handed) ?? continue)
	}
	for path in frame.parts {
		out.parts.insert(frame_onto(path, receiver, handed) ?? continue)
	}
	for place in frame.elements {
		let pieces: Vec[ref String] = place.split("|").collect()
		if pieces.len() != 3 {
			continue
		}
		let list = frame_onto(pieces[0], receiver, handed) ?? continue
		out.elements.insert(f"{list}|{pieces[1]}|{pieces[2]}")
	}
	return out
}

/// A frame's path from `#self` or `#n`, put onto the receiver's path or the
/// `n`-th argument's.
fn frame_onto(path: ref String, receiver: ref String?, handed: ref Vec[String?]) -> String? {
	let root = path_root(frame_list(path))
	let rest = path.strip_prefix(root) ?? ""
	if root == "#self" {
		let on = receiver ?? return null
		return f"{on}{rest}"
	}
	for (at, given) in handed.iter().enumerate() {
		if root == f"#{at}" {
			let on = given ?? return null
			return f"{on}{rest}"
		}
	}
	return null
}

/// The path part of a frame's entry: the list of an element's place.
fn frame_list(entry: ref String) -> String {
	let pieces: Vec[ref String] = entry.split("|").collect()
	return pieces[0].clone()
}

/// **Whether a frame writes anything from `root`** (`#self`, `#0`, ...).
pub fn frame_writes(frame: ref BoundsChanged, root: ref String) -> bool {
	return frame.values.iter().any(fn(e) { frame_from(e, root) })
		|| frame.lengths.iter().any(fn(e) { frame_from(e, root) })
		|| frame.parts.iter().any(fn(e) { frame_from(e, root) })
		|| frame.elements.iter().any(fn(e) { frame_from(e, root) })
}

fn frame_from(entry: ref String, root: ref String) -> bool {
	return path_root(frame_list(entry)) == root
}

/// **The list fields every write of which a walk sees** (ADR-306 D21,
/// #1397): a field of whole numbers no other package writes (D22), of a
/// type with no parameters, with no default, named by no other field and
/// written by nothing beside (#1414); each
/// written only by a literal, a `with`, an assignment of the field, an
/// assignment of one of its elements or a method that puts one value in
/// (`writes_a_value`), and touched otherwise only by a method that keeps
/// its values or only removes some, an index or a `for`, in a function's
/// body. Any other mention may hand it on, and takes it out. `keys` are
/// written `.name`; `writers` are where the bodies that write one start.
pub struct FieldsSeen {
	pub keys: collections::BTreeSet[String],
	pub writers: collections::BTreeSet[i64],
}

struct FieldsScan {
	live: collections::BTreeMap[String, bool],
	/// Inside a body the walks go through, rather than a lambda, a task,
	/// a test or a file beside.
	walked: bool,
	/// The body being scanned wrote a field.
	wrote: bool,
	/// Scanning the file being proved: a write in a file beside, whose
	/// bodies `bounds_fields` does not walk, takes the field out (#1414).
	here: bool,
}

pub fn fields_seen(
	program: ref Program,
	beside: ref Vec[ref Program],
	beside_words: ref Vec[ref winnow_grammar::InternerContext],
	words: ref winnow_grammar::InternerContext,
) -> FieldsSeen {
	let mut scan = FieldsScan { live: collections::BTreeMap(), walked: false, wrote: false, here: true }
	let mut reached: collections::BTreeSet[String] = collections::BTreeSet()
	let mut a_program = fields_declared(program, words, true, scan, reached)
	for (k, other) in beside.iter().enumerate() {
		a_program = fields_declared(other, beside_words[k], false, scan, reached) || a_program
	}
	// **A `pub` field of a `pub` type** is written only by this package's
	// files where the package is a program, which no other package
	// imports (ADR-306 D22); a library's may be written anywhere.
	if !a_program {
		for name in reached {
			fields_lose(name, scan)
		}
	}
	let mut writers: collections::BTreeSet[i64] = collections::BTreeSet()
	for item in program.items {
		fields_item(item, words, scan, writers)
	}
	scan.here = false
	for (k, other) in beside.iter().enumerate() {
		let mut ignored: collections::BTreeSet[i64] = collections::BTreeSet()
		for item in other.items {
			fields_item(item, beside_words[k], scan, ignored)
		}
	}
	let mut keys: collections::BTreeSet[String] = collections::BTreeSet()
	for (name, live) in scan.live {
		if live {
			keys.insert(f".{name}")
		}
	}
	return FieldsSeen { keys, writers }
}

/// Every field a struct declares: a candidate where `here` and it is one,
/// a `pub` field of a `pub` struct in `reached` (ADR-306 D22). Whether the
/// file declares the function `main`.
fn fields_declared(
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	here: bool,
	mut scan: FieldsScan,
	mut reached: collections::BTreeSet[String],
) -> bool {
	let mut has_main = false
	for item in program.items {
		match item.node {
			Item::Fn { name, .. } => {
				let named = name ?? continue
				has_main = has_main || words.resolve(named) == "main"
			},
			Item::Struct { generics, fields, is_extern, is_public, .. } => {
				for field in fields {
					let name = words.resolve(field.name).clone()
					let ty = ref field.ty
					if field.is_public && is_public {
						reached.insert(name.clone())
					}
					let mut fits = here && generics.is_empty() && !is_extern
						&& field.default == null && field.attributes.is_empty()
					let list = words.resolve(ty.name)
					// A map's values are held as a list's (ADR-306 D24).
					let map_name: String = (list.split("::").last() ?? "").clone()
					let map = (map_name == "BTreeMap" || map_name == "HashMap") && ty.generics.len() == 2
					fits = fits && (((list == "Vec" || list == "List") && ty.generics.len() == 1) || map)
					if fits {
						let inner = ref ty.generics[ty.generics.len() - 1]
						fits = inner.generics.is_empty() && is_whole_number(words.resolve(inner.name))
					}
					let was = scan.live.get(name) ?? true
					scan.live.insert(name, was && fits)
				}
			},
			else => {},
		}
	}
	return has_main
}

/// One item: a function's or a method's body is walked, and where it
/// writes a field it is one of `writers`; anything else is not.
fn fields_item(
	item: ref Spanned[Item],
	words: ref winnow_grammar::InternerContext,
	mut scan: FieldsScan,
	mut writers: collections::BTreeSet[i64],
) {
	match item.node {
		Item::Fn { config, body, .. } => {
			scan.walked = false
			for param in config {
				fields_expr(param.default, words, scan)
			}
			scan.walked = true
			scan.wrote = false
			fields_block(body, words, scan)
			if scan.wrote {
				writers.insert(item.span.start)
			}
			scan.walked = false
		},
		Item::Impl { methods, .. } => {
			for method in methods {
				fields_item(method, words, scan, writers)
			}
		},
		Item::Struct { rules, .. } => {
			for rule in rules {
				fields_expr(rule.node, words, scan)
			}
		},
		Item::Test { body, .. } => fields_block(body, words, scan),
		Item::Bench { body, .. } => fields_block(body, words, scan),
		Item::Comptime { value, .. } => fields_expr(value, words, scan),
		Item::Grammar(def) => {
			for rule in def.rules {
				for param in rule.config {
					fields_expr(param.default, words, scan)
				}
				for alt in rule.alts {
					let action = alt.action ?? continue
					fields_block(action, words, scan)
				}
			}
		},
		else => {},
	}
}

/// The field `name` is written here: seen where a walk goes, lost elsewhere.
fn fields_write(name: ref String, mut scan: FieldsScan) {
	if !(scan.live.get(name) ?? false) {
		return
	}
	if scan.walked && scan.here {
		scan.wrote = true
	} else {
		scan.live.insert(name.clone(), false)
	}
}

/// The field `name` is mentioned where it may be handed on.
fn fields_lose(name: ref String, mut scan: FieldsScan) {
	if scan.live.get(name) ?? false {
		scan.live.insert(name.clone(), false)
	}
}

fn fields_block(block: ref Block, words: ref winnow_grammar::InternerContext, mut scan: FieldsScan) {
	for stmt in block.stmts {
		fields_stmt(stmt.node, words, scan)
	}
}

fn fields_stmt(stmt: ref Stmt, words: ref winnow_grammar::InternerContext, mut scan: FieldsScan) {
	match stmt {
		Stmt::Let { value, .. } => fields_expr(value, words, scan),
		Stmt::Comptime { value, .. } => fields_expr(value, words, scan),
		Stmt::Assign { target, op, value } => {
			fields_expr(value, words, scan)
			match target {
				Expr::Field { base, name, .. } => {
					let text = words.resolve(name)
					if op == null {
						fields_write(text, scan)
					} else {
						fields_lose(text, scan)
					}
					fields_expr(base, words, scan)
				},
				Expr::Index { base: list, index, .. } => {
					match list {
						Expr::Field { base: owner, name, .. } => {
							let text = words.resolve(name)
							if op == null {
								fields_write(text, scan)
							} else {
								fields_lose(text, scan)
							}
							fields_expr(owner, words, scan)
						},
						else => fields_expr(list, words, scan),
					}
					fields_expr(index, words, scan)
				},
				else => fields_expr(target, words, scan),
			}
		},
		Stmt::For { iter, body, .. } => {
			match iter {
				Expr::Field { base, .. } => fields_expr(base, words, scan),
				else => fields_expr(iter, words, scan),
			}
			fields_block(body, words, scan)
		},
		Stmt::While { cond, body } => {
			fields_expr(cond, words, scan)
			fields_block(body, words, scan)
		},
		Stmt::Return(value) => fields_maybe(value, words, scan),
		Stmt::Expr(inner) => fields_expr(inner, words, scan),
		else => {},
	}
}

fn fields_maybe(expr: ref Expr?, words: ref winnow_grammar::InternerContext, mut scan: FieldsScan) {
	fields_expr(expr ?? return, words, scan)
}

fn fields_all(all: ref Vec[Expr], words: ref winnow_grammar::InternerContext, mut scan: FieldsScan) {
	for each in all {
		fields_expr(each, words, scan)
	}
}

/// A lambda's or a task's body: the walks do not go through it.
fn fields_unwalked(block: ref Block, words: ref winnow_grammar::InternerContext, mut scan: FieldsScan) {
	let was = scan.walked
	scan.walked = false
	fields_block(block, words, scan)
	scan.walked = was
}

fn fields_inits(fields: ref Vec[FieldInit], words: ref winnow_grammar::InternerContext, mut scan: FieldsScan) {
	for field in fields {
		fields_write(words.resolve(field.name), scan)
		fields_maybe(field.value, words, scan)
	}
}

fn fields_expr(expr: ref Expr, words: ref winnow_grammar::InternerContext, mut scan: FieldsScan) {
	match expr {
		Expr::Field { base, name, .. } => {
			fields_lose(words.resolve(name), scan)
			fields_expr(base, words, scan)
		},
		Expr::SafeField { base, name, .. } => {
			fields_lose(words.resolve(name), scan)
			fields_expr(base, words, scan)
		},
		Expr::Index { base, index, .. } => {
			match base {
				Expr::Field { base: owner, .. } => fields_expr(owner, words, scan),
				else => fields_expr(base, words, scan),
			}
			fields_expr(index, words, scan)
		},
		Expr::MethodCall { receiver, method, args, .. } => {
			let called = words.resolve(method)
			match receiver {
				Expr::Field { base: owner, name, .. } => {
					let text = words.resolve(name)
					if writes_a_value(called, args.len()) != null {
						fields_write(text, scan)
					} else if !keeps_length(called) && !only_removes(called) {
						fields_lose(text, scan)
					}
					fields_expr(owner, words, scan)
				},
				else => fields_expr(receiver, words, scan),
			}
			fields_all(args, words, scan)
		},
		Expr::SafeMethod { receiver, args, .. } => {
			fields_expr(receiver, words, scan)
			fields_all(args, words, scan)
		},
		Expr::StructLit { fields, .. } => fields_inits(fields, words, scan),
		Expr::With { base, fields, .. } => {
			fields_expr(base, words, scan)
			fields_inits(fields, words, scan)
		},
		Expr::Block(block, _) => fields_block(block, words, scan),
		Expr::Unsafe(block, _) => fields_block(block, words, scan),
		Expr::Overlap(block, _) => fields_block(block, words, scan),
		Expr::AsyncGroup(block, _, _, _, _) => fields_unwalked(block, words, scan),
		Expr::Closure { body, .. } => fields_unwalked(body, words, scan),
		Expr::Spawn { body, .. } => {
			let was = scan.walked
			scan.walked = false
			fields_expr(body, words, scan)
			scan.walked = was
		},
		Expr::Async(inner, _, _, _) => {
			let was = scan.walked
			scan.walked = false
			fields_expr(inner, words, scan)
			scan.walked = was
		},
		Expr::If { cond, then_branch, else_branch, .. } => {
			fields_expr(cond, words, scan)
			fields_block(then_branch, words, scan)
			if else_branch != null {
				fields_block(else_branch ?? return, words, scan)
			}
		},
		Expr::Call { func, args, .. } => {
			fields_expr(func, words, scan)
			fields_all(args, words, scan)
		},
		Expr::Match { value, arms, .. } => {
			fields_expr(value, words, scan)
			for arm in arms {
				fields_maybe(arm.guard, words, scan)
				fields_expr(arm.body, words, scan)
			}
		},
		Expr::Tuple(parts, _) => fields_all(parts, words, scan),
		Expr::ListLit { items, .. } => fields_all(items, words, scan),
		Expr::ListRepeat { value, count, .. } => {
			fields_expr(value, words, scan)
			fields_expr(count, words, scan)
		},
		Expr::Unary { expr: inner, .. } => fields_expr(inner, words, scan),
		Expr::Binary { lhs, rhs, .. } => {
			fields_expr(lhs, words, scan)
			fields_expr(rhs, words, scan)
		},
		Expr::Try(inner, _) => fields_expr(inner, words, scan),
		Expr::Throw(inner, _) => fields_expr(inner, words, scan),
		Expr::Return(value, _) => fields_maybe(value, words, scan),
		Expr::Cast { expr: inner, .. } => fields_expr(inner, words, scan),
		Expr::Coalesce { value, fallback, .. } => {
			fields_expr(value, words, scan)
			fields_expr(fallback, words, scan)
		},
		Expr::TryCatch { expr: inner, handler, .. } => {
			fields_expr(inner, words, scan)
			fields_block(handler, words, scan)
		},
		Expr::LitInterpolated { parts, .. } => {
			for part in parts {
				match part {
					FPart::Hole { expr: hole, .. } => fields_expr(hole, words, scan),
					else => {},
				}
			}
		},
		else => {},
	}
}
