// crates/nikaia-std/src/tools/modules.nika
//
// What a file of a package declares, and whether its `use` lines name what
// the package may reach - the two questions the compiler's `modules` asks of
// one parsed file, moved from Rust (ADR-294, #125); and which files a
// program is (M3a): the directory listed, each file read and checked, the
// refusals said. Parsing, the manifest and the ledgers stay Rust, asked
// through `ModulesHost` and `ModulesLedgerHost`.

use std::collections
use std::fs

/// The names a file declares: what one package's namespace counts
/// (ADR-286 D1). A method belongs to its type and a grammar's rule to its
/// grammar, so neither is among them; a `trait` and a `grammar` are
/// (ADR-286 D5).
pub fn declared_names(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]]) -> Vec[String] {
    let mut out: Vec[String] = []
    for item in items {
        let name = name_declared(names, item.node)
        if name.len() > 0 {
            out.push(name)
        }
    }
    return out
}

/// **Every `use` in a file, against the packages it may name** (ADR-286 D11,
/// D4, D5), and the refusal for the first that is wrong, or nothing. `use`
/// makes a package reachable and brings no name in, so there are four things
/// to say no to, each with the way out (Part III C.2): a path rather than a
/// package; the same name twice; a name no dependency declares, where a file
/// alone has none at all; and a file beside this one, whose package already
/// sees it. `beside` says whether `<package>.nika` is a file next to this one.
pub fn a_use_refused(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]], here: ref String, reachable: ref collections::BTreeSet[String], alone: bool, beside: fn(ref String) -> bool sync) -> String? {
    // What each `use` names, and what this file calls it: the two differ
    // exactly where an alias is written (ADR-286 D12). A path first, and every
    // one of them, because it is the only shape that is wrong about itself.
    let mut named: Vec[(String, String)] = []
    for item in items {
        let segments = use_segments(names, item.node)
        if segments.len() == 0 || segments[0] == "std" {
            continue
        }
        let first = segments[0].clone()
        if segments.len() > 1 {
            let written = segments.join("::")
            return f"`use {written}` in {here}: `use` takes a package name only, not a path into it. Write `use {first}`, and `{written}` where you need it."
        }
        let called = alias_of(names, item.node)
        if called.len() > 0 {
            named.push((first, called))
        } else {
            named.push((first.clone(), first))
        }
    }
    // **D5 before D4**: a name written twice is a fact about this file, and
    // the name counted is the one this file introduces - the alias.
    let mut once: collections::BTreeSet[String] = collections::BTreeSet()
    for (_, called) in named {
        if once.contains(called) {
            return f"`{called}` is used twice in {here}. Two packages can't have the same name in one file. Write `use … as …` to give one of them another name."
        }
        once.insert(called.clone())
    }
    for (package, _) in named {
        if reachable.contains(package) {
            continue
        }
        // **Alone before beside**: outside a project nothing beside a file
        // is read, so the advice about a package's files would be about a
        // package this file is not part of.
        if alone {
            return f"`use {package}` in {here}: a single file outside a project has no dependencies, so there's no `{package}` to use.\nDependencies are declared in a project's `nikaia.toml`. Put this file in a project whose `nikaia.toml` declares it:\n    [dependencies]\n    {package} = {{ path = \"../{package}\" }}"
        }
        if beside(package) {
            return f"`use {package}` in {here}: the files of a package already see each other, so there's nothing to bring in. Remove the line and use the name directly."
        }
        return f"`use {package}` in {here}: there's no dependency called `{package}`.\nAdd it to the project's `[dependencies]` under that name:\n    [dependencies]\n    {package} = {{ path = \"../{package}\" }}"
    }
    return null
}

// The segments a `use` names, or none for any other item.
fn use_segments(names: ref winnow_grammar::InternerContext, item: ref Item) -> Vec[String] {
    let mut out: Vec[String] = []
    match item {
        Item::Import { path, .. } => {
            for segment in path {
                out.push(names.resolve(segment).clone())
            }
        }
        else => {}
    }
    return out
}

// What a `use … as …` calls its package, or nothing.
fn alias_of(names: ref winnow_grammar::InternerContext, item: ref Item) -> String {
    return match item {
        Item::Import { alias, .. } => a_symbols_text(names, alias),
        else => "",
    }
}

// --- What a build says about its `pub` functions' pausing (ADR-288) ---

/// **What the program's own `pub` functions could promise and do not**
/// (ADR-288 D2, D29): those whose entry says `"inferred"` never pause, and
/// `sync` would promise it; those that pause only where the lambdas they are
/// given do would keep `sync(f)`, naming them - unless they keep one, which
/// `sync(f)` cannot name (D4, `NK2210`). Empty where there is nothing to say.
///
/// `theirs` is the packages this program depends on, each under its word and
/// with its ledger as it reads it itself (`Program::as_its_own`), whose
/// entries are not the program's to promise.
pub fn could_promise(contracts: ref Ledger, theirs: ref collections::BTreeMap[String, Ledger], paused_by_code: ref collections::BTreeMap[String, Vec[String]]) -> String {
    let mut never: Vec[String] = []
    for (key, contract) in contracts.functions {
        if !of_a_dependency(key, theirs) && contract.public && inferred_sync(contract.sync_claim) {
            never.push(f"`{key}`")
        }
    }
    let mut through: Vec[String] = []
    for (key, lambdas) in paused_by_code {
        let contract = contracts.functions[key] ?? continue
        // A written `sync(f)` is the promise already made.
        if of_a_dependency(key, theirs) || !contract.public || !no_sync(contract.sync_claim) {
            continue
        }
        let mut named: Vec[String] = []
        for lambda in lambdas {
            if !contract.keeps.contains(lambda) {
                named.push(lambda.clone())
            }
        }
        if named.len() == lambdas.len() {
            through.push(f"`{key}` (`sync({named.join(", ")})`)")
        }
    }
    let mut out: String = ""
    if never.len() > 0 {
        let one = never.len() == 1
        let count = if one { "" } else { f"{never.len()} " }
        let functions = if one { "1 pub function" } else { "pub functions" }
        let s = if one { "s" } else { "" }
        let es = if one { "es" } else { "" }
        out.push_str(f"note: {count}{functions} never pause{s} and do{es} not promise it: {never.join(", ")}\n  help: write `sync` after the result, and callers in other packages can rely on it\n")
    }
    if through.len() > 0 {
        let one = through.len() == 1
        let count = if one { "" } else { f"{through.len()} " }
        let functions = if one { "1 pub function" } else { "pub functions" }
        let s = if one { "s" } else { "" }
        let they = if one { "it is" } else { "they are" }
        let es = if one { "es" } else { "" }
        out.push_str(f"note: {count}{functions} pause{s} only where the lambdas {they} given do, and do{es} not promise it: {through.join(", ")}\n  help: write `sync(f)` after the result, naming those lambdas, and callers in other packages can rely on it\n")
    }
    return out
}

fn of_a_dependency(key: ref String, theirs: ref collections::BTreeMap[String, Ledger]) -> bool {
    let parts: Vec[ref String] = key.splitn(2, "::").collect()
    return parts.len() == 2 && theirs.contains_key(parts[0])
}

fn inferred_sync(claim: ref Sync) -> bool {
    return match claim {
        Sync::Inferred => true,
        else => false,
    }
}

fn no_sync(claim: ref Sync) -> bool {
    return match claim {
        Sync::No => true,
        else => false,
    }
}

/// **The way a function came to pause**, for ADR-288 D32's warning: each call
/// on the way, `a` calls `b`, which `b` calls `c`.
pub fn pause_path(chain: ref Vec[String]) -> String {
    let mut steps: Vec[String] = []
    let mut k = 0
    while k + 1 < chain.len() {
        steps.push(f"`{chain[k]}` calls `{chain[k + 1]}`")
        k += 1
    }
    return steps.join(", which ")
}

/// **[ADR-288](../../../docs/specification/adr/adr-288.md) D32's warning**:
/// every `pub` function of the program's own that the committed ledger says
/// could not pause (`"inferred"`) and that now can, at the statement that
/// made it, with the calls that lead there - empty where none has.
///
/// Under D1 no consumer is refused by this, since none relied on the
/// inference; what the author loses is the promise D2 offered, and the
/// property the package's own callers may count on. The committed ledger is
/// the acknowledgement: once the new entry is committed it is not said
/// again. A written `sync` needs no warning, because a body that breaks it
/// is refused (`NK2202`). `render` says a finding at the statement of the unit
/// it names (`diagnostics::render_finding`).
pub fn lost_sync(contracts: ref Ledger, theirs: ref collections::BTreeMap[String, Ledger], pauses: ref collections::BTreeMap[String, ModulesPause], committed: ref Ledger, render: fn(ref CheckFinding, i64) -> String sync) -> String {
    let mut out: String = ""
    for (key, now) in contracts.functions {
        if of_a_dependency(key, theirs) || !now.public || now.sync_claim.is_sync() {
            continue
        }
        let before = committed.functions[key] ?? continue
        if !inferred_sync(before.sync_claim) {
            continue
        }
        let message = f"`{key}` could not pause before, and now it can."
        let help = f"If `{key}` should not pause, move this out of it; if it may, commit `nikaia.contracts`, and this is not said again."
        // A method call only the type checker resolved: there is no
        // statement this walk can point at, and the warning says so
        // without one rather than not at all.
        let pause = pauses[key] ?? {
            out.push_str(lost_sync_unplaced(message, help))
            continue
        }
        let site = pause.site?.clone() ?? {
            out.push_str(lost_sync_unplaced(message, help))
            continue
        }
        let mut notes: Vec[String] = []
        if pause.chain.len() > 1 {
            notes.push(f"{pause_path(pause.chain)}, which pauses here.")
        }
        notes.push(f"{site.what} can pause.")
        let finding = CheckFinding { severity: CheckSeverity::Warning, span: Span { start: site.span.start, end: site.span.end }, code: "NK2211", message: message, notes: notes, help: help, labels: [] }
        out.push_str(render(finding, pause.unit))
    }
    return out
}

/// **The way from a function to the statement that makes it pause**
/// (ADR-288 D32), as `contracts::sync` finds it.
pub struct ModulesPause {
    /// The function, the ones of its package it calls on the way, and last the
    /// one that pauses itself.
    pub chain: Vec[String],
    /// The unit the last one is written in, by its place in the list the
    /// inference was handed.
    pub unit: i64,
    /// The statement and what in it pauses; `null` where it is a method call
    /// only the type checker resolved.
    pub site: Site?,
}

/// ADR-288 D32's warning where there is no statement to point at - a method
/// call only the type checker resolved - said without one rather than not at
/// all.
pub fn lost_sync_unplaced(message: ref String, help: ref String) -> String {
    return f"warning[NK2211]: {message}\n   = note: a method call it makes, or one of the calls it leads to, can pause.\n   = help: {help}\n"
}

// --- A program of several packages (ADR-286, ADR-100) ---

/// The same rule for any set of files that is one package: a project's, and
/// `std`'s toolchain package (`sysroot::lower_tools`), whose files were lowered
/// into one namespace without it - two private `a_call`s in two files were
/// read as one, and a call of the one met the other's parameters (found
/// moving `trust`'s walk into Nikaia, #125). `declared` holds the names each
/// file of `paths` declares (`declared_names`); the refusal for the first
/// name two files declare, or nothing.
pub fn declared_once(paths: ref Vec[String], declared: ref Vec[Vec[String]]) -> String? {
    let mut seen: collections::BTreeMap[String, String] = collections::BTreeMap()
    for at in 0..<paths.len() {
        let path = paths[at].clone()
        for name in declared[at] {
            if seen.contains_key(name) {
                let first = (seen[name] ?? "").clone()
                if first == path {
                    continue
                }
                return f"`{name}` is declared twice in this package: in {first} and in {path}.\nAll files of a package share their names. Rename one of the two, or keep one declaration and use it from the other file."
            }
            seen.insert(name.clone(), path.clone())
        }
    }
    return null
}

/// The runs of units that belong to one package, in the order they were read,
/// each as the place of its first unit and the place after its last; a unit
/// is named by its package, `null` for the program's own.
///
/// The units arrive grouped (`collect_with`), so this is a walk and not a sort.
pub fn groups(packages: ref Vec[String?]) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = []
    let mut at = 0
    while at < packages.len() {
        let from = at
        while at < packages.len() && packages[at] == packages[from] {
            at += 1
        }
        out.push((from, at))
    }
    return out
}

/// **What another package may rely on about pausing**
/// ([ADR-288](../../../docs/specification/adr/adr-288.md) D28): what its source
/// wrote, `sync` or `sync(f)`, and not what the inference observed about
/// today's body. Each entry `another` says is across the boundary and reads
/// `"inferred"` reads as *may pause* in `ledger` after this -
/// `Sync::Unpromised`, so a refusal can say that the callee does not promise
/// it rather than that it pauses.
///
/// **The copy is the checker's and never the lowering's** (D3): a call is
/// checked against the promise and lowered by what the body is, so an
/// unpromised `sync` callee is still called without an `.await`. `std` has no
/// `"inferred"` entry, its ledger being written by hand, so only a package's
/// entries are ever changed.
pub fn as_promised(mut ledger: Ledger, another: fn(ref String) -> bool sync) {
    let mut unpromised: Vec[String] = []
    for (key, contract) in ledger.functions {
        if inferred_sync(contract.sync_claim) && another(key) {
            unpromised.push(key.clone())
        }
    }
    for key in unpromised {
        let mut entry = (ledger.functions[key] ?? continue).clone()
        entry.sync_claim = Sync::Unpromised
        ledger.functions.insert(key.clone(), entry)
    }
}

/// **The program's contracts as its own files are checked against them**
/// ([ADR-288](../../../docs/specification/adr/adr-288.md) D28): every
/// dependency's entry reads only what that package's source promised about
/// pausing ([`as_promised`]). `contracts` stays the ledger the lowering reads
/// and the one written beside the program.
pub fn contracts_as_promised(contracts: ref Ledger, theirs: ref collections::BTreeMap[String, Ledger]) -> Ledger {
    let mut promised = contracts.clone()
    as_promised(promised, fn(key) { of_a_dependency(key, theirs) })
    return promised
}

/// **The dependencies' ledgers, merged** (ADR-100 D1, D2, D5): into `library`,
/// the ledger the program's own inference reads, as each package promised
/// them; into `contracts`, the one the lowering reads, as they are; and
/// returned, each package's under its word, as that package reads itself
/// (`Program::as_its_own`). `packages` and `renames` are each unit's,
/// `reaches` and `their_renames` each dependency's by its word, and
/// `package_ledger` one group's own ledger, by its first unit and the place
/// after its last (`groups`).
///
/// **A package at a time, not a file at a time.** `absorb` qualifies the
/// types *inside* an entry with the package's name, and it can only do
/// that for the types the ledger it is given declares - so a package whose
/// `Request` is in one file and whose `route(r: Request)` is in another has
/// to arrive as one ledger, or the signature keeps the bare name and a
/// caller writing `http::Request` is told the two are different types.
/// That was the file-level defect (issue #229's cross-file type entry,
/// since closed) one level up.
///
/// The units arrive grouped (`collect_with`), so this is a walk and not a
/// sort - and the order inside a package is the order they were read in,
/// which Part III 13.5 needs to stay a function of the tree.
///
/// **And the inference is the package's, not each file's**
/// ([ADR-100](../../../docs/specification/adr/adr-100.md) D2). The group
/// is handed over whole rather than inferred file by file and merged
/// afterwards: merging joins *answers*, and the answer to `sync` is a
/// fixpoint over a call graph, so a graph that stopped at the file
/// boundary had already read a callee in the file next door as one it
/// could not vouch for. That is what `NK1129` was refusing.
///
/// **The dependencies first, and the program's own package last**
/// (D5). A package's ledger is a build input of everything that depends
/// on it, so it has to exist before its consumer is checked - and what
/// the consumer then resolves `http::ok` against is that *answer*,
/// rather than a worse one derived here from half the graph. That order
/// is the whole of why this is two passes over the groups and not one:
/// the program's own groups are the caller's, after this.
pub fn dependency_ledgers(mut library: Ledger, mut contracts: Ledger, described: ref Ledger, packages: ref Vec[String?], renames: ref Vec[collections::BTreeMap[String, String]], reaches: ref collections::BTreeMap[String, collections::BTreeSet[String]], their_renames: ref collections::BTreeMap[String, collections::BTreeMap[String, String]], package_ledger: fn(i64, i64) -> Ledger sync) -> collections::BTreeMap[String, Ledger] {
    // **And the described crates' answers**:
    // the check reads `contracts/<crate>.contracts`
    // beside `std`, so the program's own `sync` inference does too, or a
    // function that only calls a described `sync` entry is inferred to pause
    // and a `sync` caller is refused (`NK2202`). `std` wins a collision, as
    // in `project::Foreign::library`.
    for (name, contract) in described.functions {
        if !library.functions.contains_key(name) {
            library.functions.insert(name.clone(), contract.clone())
        }
    }
    for (name, contract) in described.types {
        if !library.types.contains_key(name) {
            library.types.insert(name.clone(), contract.clone())
        }
    }
    let mut plain: collections::BTreeMap[String, Ledger] = collections::BTreeMap()
    for (from, to) in groups(packages) {
        let package = packages[from]?.clone() ?? continue
        let module: String? = package.clone()
        let own = package_ledger(from, to)
        // **The program's own inference reads the dependency as promised**
        // (ADR-288 D28): a call into it that only the inference calls `sync`
        // makes the caller *may pause*. `contracts` keeps the entry as it
        // is, because that is what the lowering reads (D3).
        let mut promised = own.clone()
        as_promised(promised, fn(key) { true })
        absorb_into(library, module, renames[from], promised)
        absorb_into(contracts, module, renames[from], own)
        plain.insert(package, own)
    }

    // **And what each reaches, under its own words for it** (#497): a file
    // of `lib` that writes `c::Id` for a package this build calls `deep` is
    // checked against `deep`'s ledger absorbed as `c`. After every package
    // is read, because the order the groups arrive in is not the order
    // they depend on each other. Without it the type was not known, and a
    // type nothing knows is refused.
    let none: collections::BTreeMap[String, String] = collections::BTreeMap()
    let mut as_its_own: collections::BTreeMap[String, Ledger] = collections::BTreeMap()
    for (package, own) in plain {
        let mut seen_by_it = own.clone()
        // The words and renames of a dependency are a few, and copied.
        let words = reaches[package]?.clone() ?? collections::BTreeSet()
        let renamed = their_renames[package]?.clone() ?? collections::BTreeMap()
        for word in words {
            let ours = (renamed[word] ?? word).clone()
            if ours == package {
                continue
            }
            let theirs = plain[ours] ?? continue
            let mut promised = theirs.clone()
            as_promised(promised, fn(key) { true })
            let module: String? = word.clone()
            absorb_into(seen_by_it, module, none, promised)
        }
        as_its_own.insert(package.clone(), seen_by_it)
    }
    return as_its_own
}

/// One group of the program's own files into `contracts`, its ledger `own`
/// (ADR-100 D2): under no package's name, and with the sources it was derived
/// from as the program's.
pub fn absorb_own(mut contracts: Ledger, renames: ref collections::BTreeMap[String, String], own: ref Ledger) {
    contracts.sources = own.sources.clone()
    let module: String? = null
    absorb_into(contracts, module, renames, own)
}

/// Each unit's path as a message says it: the entry under `shown_as` where
/// that is set (`Program::entry_shown_as`, #510).
pub fn shown_paths(paths: ref Vec[String], shown_as: ref String?) -> Vec[String] {
    return (0..<paths.len()).map(fn(at) { if at == 0 && shown_as != null { shown_as?.clone() ?? "" } else { paths[at].clone() } }).collect()
}

/// The **packages** this program reaches, by the name a `use` writes, from
/// each unit's package (`null` for the program's own).
///
/// What it is for is telling a `package::item` call from a `Type::method`
/// one. Empty for a program of its own files, which is every program today:
/// the files of a package share one namespace, so nothing in it is qualified
/// (ADR-286 D1), and depending on another package is not built (D2).
pub fn package_names(packages: ref Vec[String?]) -> collections::BTreeSet[String] {
    return packages.iter().filter_map(fn(p) { p?.clone() }).collect()
}

/// Whether a program of `units` units is one file, in which case nothing
/// about the build changes.
pub fn is_single_file(units: i64) -> bool {
    return units == 1
}

// --- A test build (ADR-269 D1) ---

/// The name the `k`th test's function has in a test build.
pub fn test_function(k: i64) -> String {
    return f"__nikaia_test_{k}"
}

/// **The dispatcher a test build appends to its entry**, in Nikaia, so it goes
/// through every check and the one lowering a program does: it runs the test
/// its first argument numbers, and a number it has no test for is a panic.
/// `cli` is the entry's word for `std::cli`, and `with_use` whether the entry
/// has none and it is added here.
pub fn test_dispatcher(cli: ref String, with_use: bool, count: i64, dispatch: ref String) -> String {
    let mut text: String = ""
    if with_use {
        text.push_str("use std::cli\n")
    }
    text.push_str(f"fn {dispatch}() throws {{\n    let which = {cli}::args().nth(1) ?? \"\"\n")
    for k in 0..<count {
        text.push_str(f"    if which == \"{k}\" {{\n        {test_function(k)}()\n        return\n    }}\n")
    }
    text.push_str("    panic(f\"this build has no test numbered `{which}`\")\n}\n")
    return text
}

/// How many `test` blocks a file has: a test build of a program whose own
/// files have none changes nothing.
pub fn modules_test_count(items: ref Vec[Spanned[Item]]) -> i64 {
    return items.iter().filter(fn(item) { match item.node { Item::Test { .. } => true, else => false } }).count()
}

/// **The entry's word for `std::cli`** (`use std::cli as c` calls it `c`),
/// or nothing where it has no `use std::cli`: the dispatcher reads its
/// arguments with it, and adds the `use` where there is none.
pub fn modules_cli_word(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]]) -> String? {
    for item in items {
        let path = use_segments(names, item.node)
        if path.len() == 2 && path[0] == "std" && path[1] == "cli" {
            let alias = alias_of(names, item.node)
            if alias.len() > 0 {
                return alias
            }
            return "cli"
        }
    }
    return null
}

/// **`main` gives its name to the dispatcher and goes**: `items` is the entry
/// parsed again with the dispatcher (`dispatch`, `test_dispatcher`) appended,
/// and the dispatcher is what a test build runs as `main`. `intern` is the
/// entry's interner, which answers the symbol `main` already has.
pub fn modules_dispatcher_as_main(mut items: Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, dispatch: ref String, intern: fn(ref String) -> winnow_grammar::Symbol sync) {
    let main = intern("main")
    let mut kept: Vec[Spanned[Item]] = []
    for item in items.drain() {
        let named = match item.node {
            Item::Fn { name, .. } => a_symbols_text(names, name),
            else => "",
        }
        if named == "main" {
            continue
        }
        if named == dispatch {
            let node = modules_named(item.node, main)
            kept.push(Spanned { node: node, span: item.span, doc: item.doc, attributes: item.attributes })
        } else {
            kept.push(item)
        }
    }
    items.extend(kept)
}

// A function under another name; any other item as it is.
fn modules_named(item: Item, to: winnow_grammar::Symbol) -> Item {
    return match item {
        Item::Fn { name, generics, receiver, args, config, spread, ret_type, body, is_sync, sync_by, is_public, can_throw, is_extern } => Item::Fn { name: to, generics: generics, receiver: receiver, args: args, config: config, spread: spread, ret_type: ret_type, body: body, is_sync: is_sync, sync_by: sync_by, is_public: is_public, can_throw: can_throw, is_extern: is_extern },
        other => other,
    }
}

/// **Every `test` block of one file, as a function** (ADR-269 D1): the `k`th
/// becomes `test_function(k)`, counted from `first` over the program's own
/// files, and `throws`, so a failure that leaves its body leaves `main` -
/// which prints it and ends the process unsuccessfully. The answer is each
/// test's title as written and the line its block starts on in `source`.
pub fn modules_tests_as_functions(mut items: Vec[Spanned[Item]], source: ref String, first: i64, intern: fn(ref String) -> winnow_grammar::Symbol sync) -> Vec[(String, i64)] {
    let mut tests: Vec[(String, i64)] = []
    let mut kept: Vec[Spanned[Item]] = []
    for item in items.drain() {
        let start = item.span.start as i64
        match item.node {
            Item::Test { name, body } => {
                let function: winnow_grammar::Symbol? = intern(test_function(first + tests.len()))
                tests.push((name, modules_line_of(source, start)))
                let node = Item::Fn { name: function, generics: [], receiver: null, args: [], config: [], spread: null, ret_type: null, body: body, is_sync: false, sync_by: [], is_public: false, can_throw: true, is_extern: false }
                kept.push(Spanned { node: node, span: item.span, doc: item.doc, attributes: item.attributes })
            },
            other => kept.push(Spanned { node: other, span: item.span, doc: item.doc, attributes: item.attributes }),
        }
    }
    items.extend(kept)
    return tests
}

// The line the byte `at` of `source` stands on, the first being 1.
fn modules_line_of(source: ref String, at: i64) -> i64 {
    let mut line = 1
    let mut seen = 0
    for b in source.bytes() {
        if seen >= at {
            break
        }
        if b as i64 == 10 {
            line += 1
        }
        seen += 1
    }
    return line
}

/// **Every name an expression of this file writes**, added to `out`: a path's
/// last segment, a variable, a method. Over-approximate on purpose (a local
/// with a function's name counts as a call of it), which is the cautious
/// direction for a permission. The holes of an `f"..."` are expressions too.
pub fn modules_names_in(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]], mut out: collections::BTreeSet[String]) {
    let mut bodies: Vec[ref Block] = []
    for item in items {
        match item.node {
            Item::Fn { body, .. } => bodies.push(body),
            Item::Impl { methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { body, .. } => bodies.push(body),
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    for body in bodies {
        for e in visited_in_block(body) {
            modules_note(names, e, out)
        }
    }
}

// The name one expression writes, into `out`. A struct literal names the type
// it builds: a `pub` type whose maps are the keyed one (a barrier) is built
// with it.
fn modules_note(names: ref winnow_grammar::InternerContext, e: ref Expr, mut out: collections::BTreeSet[String]) {
    match e {
        Expr::Path(segments, _) => {
            if segments.len() > 0 {
                out.insert(names.resolve(segments[segments.len() - 1]).clone())
            }
        },
        Expr::Variable(n, _) => {
            out.insert(names.resolve(n).clone())
        },
        Expr::MethodCall { method, .. } => {
            out.insert(names.resolve(method).clone())
        },
        Expr::SafeMethod { method, .. } => {
            out.insert(names.resolve(method).clone())
        },
        Expr::StructLit { name, .. } => {
            out.insert(names.resolve(name).clone())
        },
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => {
                        for inner in visited_in_expr(expr) {
                            modules_note(names, inner, out)
                        }
                    },
                    else => {},
                }
            }
        },
        else => {},
    }
}

/// What collecting a program's files asks of the compiler (M3a, #125).
/// `Parsed` stays Rust until the parser moves: the host parses a file, keeps
/// it, and answers about it by its number.
pub trait ModulesHost {
    /// Parses `source`, read at `path`, as a file of `package`, keeps it and
    /// gives its number; `null` where it does not parse, and the host holds
    /// the refusal, rendered against `path` where it is a finding.
    fn parse_unit(ref self, path: ref fs::Path, source: ref String, package: String?) -> i64? sync
    /// The names file `unit` declares (`declared_names`).
    fn declared(ref self, unit: i64) -> Vec[String] sync
    /// The refusal of file `unit`'s first `use` that names what it may not
    /// reach (`a_use_refused`), or nothing.
    fn use_refused(ref self, unit: i64, at: ref fs::Path, reachable: ref collections::BTreeSet[String], alone: bool) -> String? sync
    /// The Rust crates the manifest at `path` declares, under the name a
    /// program writes them by; none where it does not read.
    fn foreign_crates(ref self, path: ref fs::Path) -> Vec[String] sync
}

/// Why collecting a program's files stopped.
pub enum ModulesRefusal {
    /// A file did not parse: the host holds the refusal.
    Parse,
    /// A statement about the program, in the words the compiler reports.
    Refused(String),
    /// A file or directory that could not be read: what was read, and why not.
    Unreadable { what: String, why: String },
}

impl Error for ModulesRefusal {
    fn message(ref self) -> String {
        return match self {
            ModulesRefusal::Parse => "a file did not parse",
            ModulesRefusal::Refused(why) => why.clone(),
            ModulesRefusal::Unreadable { what, why } => f"{what}: {why}",
        }
    }
}

/// One file of a package as collecting found it. Rust makes it a `Unit`
/// with the parsed file the host kept as number `parsed`.
pub struct ModulesUnit {
    pub path: fs::Path,
    pub source: String,
    pub parsed: i64,
    /// The package this file belongs to, as a **consumer** would write it -
    /// and `null` for every file of the program being built, whose names are
    /// the program's own.
    pub package: String?,
    /// The package names **inside this file** that are another word for a
    /// package this build already has a word for - see
    /// `ProjectMembersDependency::renames`. Empty for every file of the
    /// program itself, whose words are this build's by definition.
    pub renames: collections::BTreeMap[String, String],
}

/// **Whether a file has a project to declare its dependencies in**
/// ([ADR-260](../../../docs/specification/adr/adr-260.md) D2): what a `use` of
/// a package nobody declares is told depends on it. A file of a project is
/// missing a line in its `nikaia.toml`; a file outside one has no `nikaia.toml`
/// for the line to be missing from.
pub enum ModulesStanding {
    InProject,
    Alone,
}

/// Where a project keeps its sources and what its entry point is called
/// (Part III, 13.1).
comptime MODULES_SRC: ref String = "src"

comptime MODULES_ENTRY: ref String = "main.nika"

/// How a consumer writes a name from a file of `package`: `http::serve` for
/// another package, and plain `serve` inside the program's own.
pub fn modules_qualify(package: String?, name: String) -> String {
    let package = package ?? return name.clone()
    return f"{package}::{name}"
}

/// Every file of the package the entry belongs to, entry first, and then the
/// files of the packages this program depends on
/// ([ADR-286](../../../docs/specification/adr/adr-286.md) D15).
///
/// **The directory decides, not the `use` lines** (ADR-286 D1). Every `.nika`
/// beside the entry takes part, whether or not anything names it - which is what
/// makes moving a declaration from one file to another housekeeping rather than a
/// change to the package's surface.
///
/// Entry first because the entry is where `fn main` may be written, and the rest
/// sorted by file name: the order files are emitted in has to be a function of
/// the source tree alone (Part III 13.5's determinism), and a directory listing
/// is not sorted anywhere.
///
/// A dependency's files come **after** the program's own, in the order the
/// manifest sorted its names, so the emitted file stays a function of the source
/// tree (Part III 13.5). Each is read from the package's `src/`, because a
/// dependency is a project and that is where a project keeps its files
/// (Part III, 13.1).
pub fn modules_collect_with[H: ModulesHost](entry: ref fs::Path, dependencies: ref Vec[ProjectMembersDependency], host: ref H) -> Vec[ModulesUnit] throws {
    let mut names: collections::BTreeSet[String] = dependencies.iter().map(fn(d) { d.name.clone() }).collect()
    // **A Rust crate is a package a `use` may name** (Part III 15.2's `use
    // image`), under the name a call writes it by (ADR-290 D1).
    names.extend(modules_foreign_beside(entry, host))
    let mut units = modules_package_at(entry, null, names, collections::BTreeMap(), host)

    // **Read, and not emitted** ([ADR-286](../../../docs/specification/adr/adr-286.md)
    // D1). A dependency is its own crate now, so its files are Cargo's to
    // compile - but its *surface* is this program's to check against, and a
    // package's surface is what its files declare. So they arrive here tagged
    // with the name this program reaches them by, the ledger and the checks see
    // them, and `Program::emit` writes none of them.
    //
    // **And its own `use` lines are checked against its own manifest keys**,
    // not against nothing: a package that depends on a package is a package
    // (D3), and the level below it is its business rather than a rule it broke.
    for dependency in dependencies {
        let src = dependency.root.join(MODULES_SRC)
        if !modules_is_dir(src) {
            throw ModulesRefusal::Refused(f"`{dependency.name}` is a dependency by path, but {src.display()} doesn't exist.\nA package is a directory with a `{MODULES_SRC}/` folder in it.")
        }
        let package: String? = dependency.name.clone()
        units.extend(modules_package_at(src.join(MODULES_ENTRY), package, dependency.reachable, dependency.renames, host))
    }
    return units
}

/// One package: the directory an entry sits in, checked as a namespace of its
/// own.
fn modules_package_at[H: ModulesHost](entry: ref fs::Path, package: String?, reachable: ref collections::BTreeSet[String], renames: ref collections::BTreeMap[String, String], host: ref H) -> Vec[ModulesUnit] throws {
    let base = modules_base_of(entry)
    // `read_dir` gives the names sorted by their bytes: the order Rust's
    // sorted paths had, since they differ only in that last part.
    let names = fs::read_dir(base, fs::Root::Anywhere) catch { throw ModulesRefusal::Unreadable { what: f"cannot read {base.display()}", why: f"{error}" } }
    // The entry by its name: `x.nika` and the `./x.nika` the directory
    // lists are one file (#774).
    let entry_name = entry.file_name()?.text_of() ?? ""
    let beside: Vec[fs::Path] = names.iter().filter(fn(name) { (name.extension()?.text_of() ?? "") == "nika" }).filter(fn(name) { name.text_of() != entry_name }).map(fn(name) { base.join(name) }).collect()

    // A library needs no `main.nika`: what a package offers is its public
    // surface, and an entry point is what a *program* has.
    let mut units: Vec[ModulesUnit] = []
    if modules_is_file(entry) {
        units.push(modules_read_unit(entry, package?.clone(), reachable, renames, ModulesStanding::InProject, host))
    }
    for path in beside {
        units.push(modules_read_unit(path, package?.clone(), reachable, renames, ModulesStanding::InProject, host))
    }
    modules_one_namespace(units, host)
    return units
}

/// The directory an entry sits in, `.` for a bare file name.
fn modules_base_of(entry: ref fs::Path) -> fs::Path {
    let here: fs::Path = "."
    let parent = entry.parent() ?? return here
    if parent.text_of().is_empty() {
        return here
    }
    return parent
}

/// The entry and nothing beside it - a `.nika` file compiled on its own.
///
/// `nikaia lower` outside a project is not a package: a directory of loose examples is
/// a directory of programs, and compiling one of them must not pull in the other
/// ten. A package is a directory **of a project**, which is what a `nikaia.toml`
/// declares.
pub fn modules_collect_one[H: ModulesHost](entry: ref fs::Path, host: ref H) -> Vec[ModulesUnit] throws {
    return [modules_read_unit(entry, null, collections::BTreeSet(), collections::BTreeMap(), ModulesStanding::Alone, host)]
}

/// One file read, parsed by the host and its `use` lines checked.
fn modules_read_unit[H: ModulesHost](path: ref fs::Path, package: String?, reachable: ref collections::BTreeSet[String], renames: ref collections::BTreeMap[String, String], standing: ModulesStanding, host: ref H) -> ModulesUnit throws {
    let source = fs::read_to_string(path, fs::Root::Anywhere) catch { throw ModulesRefusal::Unreadable { what: f"cannot read {path.display()}", why: f"{error}" } }
    // A parse error is a finding, rendered by the host where the path is
    // known; it is a refusal of the program rather than a failure of this
    // compiler (`diagnostics::Refused`).
    let parsed = host.parse_unit(path, source, package?.clone()) ?? throw ModulesRefusal::Parse
    modules_check_imports(parsed, path, reachable, standing, host)
    return ModulesUnit { path: path.clone(), source: source, parsed: parsed, package: package, renames: renames.clone() }
}

/// **Two files of one package may not declare the same name** (ADR-286 D1),
/// asked of a package's units (`declared_once`).
///
/// One namespace, so two `Row`s in it is an error rather than a rule about which
/// of them a line means. Refused here and not left to `rustc`: it would report a
/// duplicate definition against the generated file, which is exactly what
/// Part III C.1 forbids - and it would name a line the user never wrote.
fn modules_one_namespace[H: ModulesHost](units: ref Vec[ModulesUnit], host: ref H) throws {
    let paths: Vec[String] = units.iter().map(fn(unit) { unit.path.display() }).collect()
    let declared: Vec[Vec[String]] = units.iter().map(fn(unit) { host.declared(unit.parsed) }).collect()
    let message = declared_once(paths, declared) ?? return
    throw ModulesRefusal::Refused(message)
}

/// **Every `use` in a file, against the packages it may name**
/// ([ADR-286](../../../docs/specification/adr/adr-286.md) D11, D13, D14):
/// `a_use_refused` over file `unit`, asked through the host.
fn modules_check_imports[H: ModulesHost](unit: i64, at: ref fs::Path, reachable: ref collections::BTreeSet[String], standing: ModulesStanding, host: ref H) throws {
    let alone = match standing {
        ModulesStanding::Alone => true,
        ModulesStanding::InProject => false,
    }
    let message = host.use_refused(unit, at, reachable, alone) ?? return
    throw ModulesRefusal::Refused(message)
}

/// The directory of the project an entry belongs to: the nearest one above it
/// with a `nikaia.toml`; none outside a project.
pub fn modules_project_root(entry: ref fs::Path) -> fs::Path? {
    let mut dir = entry.parent() ?? return null
    while true {
        if modules_is_file(dir.join("nikaia.toml")) {
            return dir
        }
        dir = dir.parent() ?? return null
    }
    return null
}

/// The Rust crates the manifest of the project an entry belongs to declares,
/// under the name a program writes them by; none outside a project.
fn modules_foreign_beside[H: ModulesHost](entry: ref fs::Path, host: ref H) -> Vec[String] {
    let root = modules_project_root(entry) ?? return []
    return host.foreign_crates(root.join("nikaia.toml"))
}

/// Whether `path` names a directory; a name that is not there names none.
fn modules_is_dir(path: ref fs::Path) -> bool {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_dir()
}

/// Whether `path` names a file; a name that is not there names none.
fn modules_is_file(path: ref fs::Path) -> bool {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_file()
}

/// What a package's ledger asks of the compiler (M3a): `std` has no SHA-256,
/// and reading a ledger stays Rust (`LedgerOps`).
pub trait ModulesLedgerHost {
    /// The SHA-256 of `text`'s bytes, in lowercase hex.
    fn sha256_hex(ref self, text: ref String) -> String sync
    /// The ledger at `path`, where it is there and parses (`Ledger::read_beside`).
    fn read_beside(ref self, path: ref fs::Path) -> Ledger? sync
}

/// The units of one package, by file name and the SHA-256 of their bytes
/// ([ADR-100](../../../docs/specification/adr/adr-100.md) D3): file `at` is
/// at `paths[at]` and reads `texts[at]`.
///
/// **The same digest the cache key uses** ([ADR-021](../../../docs/specification/adr/adr-021.md)),
/// because the record says so and because a build that hashed the same file
/// twice with two digests would be paying twice to disagree with itself.
pub fn modules_sources_of[H: ModulesLedgerHost](paths: ref Vec[fs::Path], texts: ref Vec[String], host: ref H) -> collections::BTreeMap[String, String] {
    let mut sources: collections::BTreeMap[String, String] = collections::BTreeMap()
    for at in 0..<paths.len() {
        // A unit always comes from a file; a path that ends in nothing
        // is not one this compiler read, and naming it by its whole
        // spelling is better than dropping it out of the table.
        let name = paths[at].file_name()?.text_of() ?? paths[at].text_of()
        sources.insert(name, host.sha256_hex(texts[at]))
    }
    return sources
}

/// A dependency's committed `nikaia.contracts`, published to what it reaches,
/// where it may be believed against `sources`; none where the package is
/// derived again ([ADR-100](../../../docs/specification/adr/adr-100.md) D1
/// and D3).
///
/// **Believed is the fast path and the *correct* one**, not merely the quick
/// one. A package's own build had its own dependencies in view and this one does
/// not (ADR-286 D21), so an answer derived here can only be the same or worse -
/// and two builds that derive the same function differently is the divergence
/// D1 exists to make impossible.
///
/// **And it is never believed against its own sources.** The hashes in the
/// header say which files the entries are an answer about; where one does not
/// match, that package is derived again. A ledger with no `[sources]` at
/// all is treated as not matching, which is the fail-closed direction
/// ([ADR-010](../../../docs/specification/adr/adr-010.md) D1): *nothing was
/// recorded* must not read as *nothing changed*.
pub fn modules_believed[H: ModulesLedgerHost](dependency: ref ProjectMembersDependency, sources: ref collections::BTreeMap[String, String], host: ref H) -> Ledger? {
    let shipped = modules_shipped_ledger(dependency.root, host) ?? return null
    if !stale_units(shipped, sources).is_empty() {
        return null
    }
    return published_entries(shipped, dependency.reachable)
}

/// A package's committed `nikaia.contracts`, where it has one this compiler can
/// read.
///
/// **A ledger that does not parse is not an error here.** It is a generated file
/// a person may have edited or an older compiler may have written, and the
/// answer to both is the same as to a stale one: derive this package again. A
/// build that failed because a *cache* was unreadable would be a worse build
/// than one that is slower.
fn modules_shipped_ledger[H: ModulesLedgerHost](root: ref fs::Path, host: ref H) -> Ledger? {
    return host.read_beside(root.join("nikaia.contracts"))
}

/// What assembling a program's ledgers asks of the compiler (M3b, #125): the
/// units stay Rust (`Program::units`), so the host infers a run of them,
/// named by the place of its first unit and the place after its last, and
/// keeps what the inference learned beside the ledger it gives.
pub trait ModulesProgramHost {
    /// A ledger with no entries (`Ledger::empty`).
    fn empty_ledger(ref self) -> Ledger sync
    /// `std`'s ledger as the inference reads it (`contracts::std_library`).
    fn std_library(ref self) -> Ledger sync
    /// The ledger of the dependency whose units are `from..<to`: the one it
    /// ships where that may be believed, else its own inference against
    /// `std` alone. Its own dependencies are deliberately invisible here
    /// (ADR-286 D21), which is exactly why a ledger derived on this side is
    /// the second-best answer and D1 prefers the one it shipped.
    fn package_ledger(ref self, from: i64, to: i64) -> Ledger sync
    /// The ledger of the program's own units `from..<to`, inferred against
    /// `library`; the host keeps the checked units and what the `sync`
    /// inference noted (ADR-288 D29, D32), its pauses placed among all units.
    fn own_ledger(ref self, from: i64, to: i64, library: ref Ledger) -> Ledger sync
}

/// A program's ledgers, as `modules_program_of` assembled them.
pub struct ModulesProgramParts {
    /// The ledger the lowering reads and the one written beside the program.
    pub contracts: Ledger,
    /// Each dependency's ledger as its own files are checked against it.
    pub as_its_own: collections::BTreeMap[String, Ledger],
    /// The first unit of the group whose checked units the emitter may read
    /// rather than inferring the ledger a second time (#727): the one group
    /// of the program's own files, all of them, against `std` alone. `null`
    /// where the library held more, or the own files are in more than one.
    pub own_checked_from: i64?,
}

/// **The program's ledgers, the dependencies first and its own package last**
/// (ADR-100 D5). Unit `at` belongs to `packages[at]` (`null` for the
/// program's own) under `renames[at]`; `reaches` and `their_renames` are each
/// dependency's words and renames, by its name.
pub fn modules_program_of[H: ModulesProgramHost](host: ref H, described: ref Ledger, packages: ref Vec[String?], renames: ref Vec[collections::BTreeMap[String, String]], reaches: ref collections::BTreeMap[String, collections::BTreeSet[String]], their_renames: ref collections::BTreeMap[String, collections::BTreeMap[String, String]]) -> ModulesProgramParts {
    let mut contracts = host.empty_ledger()
    let mut library = host.std_library()
    let as_its_own = dependency_ledgers(library, contracts, described, packages, renames, reaches, their_renames, fn(from, to) { host.package_ledger(from, to) })

    // The library is `std`'s exactly when nothing was added to it above.
    let std_alone = described.functions.is_empty() && described.types.is_empty() && as_its_own.is_empty()
    let own_units = packages.iter().filter(fn(p) { p == null }).count()
    let mut own_checked_from: i64? = null
    let mut own_groups = 0
    for (from, to) in groups(packages) {
        if packages[from] != null {
            continue
        }
        own_groups += 1
        let own = host.own_ledger(from, to, library)
        // **Kept where it is the join's pass**: the one group of the
        // program's own files, all of them, against `std` alone.
        own_checked_from = null
        if std_alone && to - from == own_units {
            own_checked_from = from
        }
        absorb_own(contracts, renames[from], own)
    }
    if own_groups != 1 {
        own_checked_from = null
    }
    return ModulesProgramParts { contracts: contracts, as_its_own: as_its_own, own_checked_from: own_checked_from }
}

/// What emitting a program asks of the compiler (M3b, #125): the units, the
/// emitter and the source map stay Rust, so the host answers about them and
/// keeps the map and what each unit publishes.
pub trait ModulesEmitHost {
    /// **The package's trust, not the entry's** (ADR-010 D9, #581): a map is
    /// one type in every file, so a socket read in any file keys them all.
    fn trust(ref self) -> Provenance sync
    /// The functions of dependency `package` whose ledger line is `keyed`, or
    /// that have none (`contracts::maps::keyed_functions`).
    fn keyed_functions(ref self, package: ref String) -> Vec[String] sync
    /// Every name an expression of the program's own files writes.
    fn own_names(ref self) -> collections::BTreeSet[String] sync
    /// The barriers the program's own files declare, or with `all` every
    /// unit's (`emit::barrier_names`).
    fn barrier_names(ref self, all: bool) -> collections::BTreeSet[String] sync
    /// The generated file's preamble: what every unit needs, joined.
    fn preamble(ref self) -> String sync
    /// The Rust of unit `at`, written at byte `offset` of the generated file:
    /// the host keeps its lines in the source map and what it publishes. A
    /// refusal gets its line here (ADR-171 D2); the host holds it.
    fn emit_unit(ref self, at: i64, provenance: Provenance, offset: i64) -> String sync throws
    /// Whether the entry declares `main`.
    fn has_main(ref self) -> bool sync
    /// The source map's rows so far: generated byte, source byte, unit.
    fn map_rows(ref self) -> Vec[(i64, i64, i64)] sync
}

/// **The whole package as one Rust file** (ADR-286 D1): unit `at` belongs to
/// `packages[at]` (`null` for the program's own), is shown as `shown[at]`
/// and reads `sources[at]`.
pub fn modules_emit_reading[H: ModulesEmitHost](host: ref H, packages: ref Vec[String?], shown: ref Vec[String], sources: ref Vec[ref String]) -> String throws {
    let mut provenance = host.trust()
    // **A package whose `pub` items hold maps fills them with the hasher of
    // the program that uses it** (ADR-010 D9), and the ledger says what
    // each function of it puts in (13.5, `maps`): a program that calls one
    // whose line is `keyed`, or that has no line, hands its maps to a body
    // that fills them with keys the program cannot vouch for, so it is no
    // more trusted than that. `from(..)` adds nothing the program has not
    // chosen: a trusted program's arguments are trusted, and an untrusted
    // program's maps are keyed already. The ledger is read, never the
    // body.
    if provenance == Provenance::Trusted {
        let called = host.own_names()
        let mut names: collections::BTreeSet[String] = collections::BTreeSet()
        for package in packages {
            let name = package?.clone() ?? continue
            names.insert(name)
        }
        for name in names {
            let keyed = host.keyed_functions(name)
            if keyed.iter().any(fn(key) { called.contains((key.rsplit("::").next() ?? key).clone()) }) {
                provenance = Provenance::Untrusted
                break
            }
        }
    }
    // **A call to a barrier** (D9): a method of a trait that holds a map in
    // its signature, a `pub` function that hands a map to one, a function
    // of a described Rust crate that takes one. The map arrives there with
    // std's keyed hasher, so a program that calls one keeps no fast map
    // across it: its maps that leave a function are keyed.
    // And a package that declares one - a trait method with a map, a
    // function that hands a map to one, a method whose result alone holds
    // one - writes the keyed map in its own bodies where they make it.
    if provenance == Provenance::Trusted && !host.barrier_names(false).is_empty() {
        provenance = Provenance::Untrusted
    }
    if provenance == Provenance::Trusted {
        let barriers = host.barrier_names(true)
        if !barriers.is_empty() {
            for name in host.own_names() {
                if barriers.contains(name) {
                    provenance = Provenance::Untrusted
                    break
                }
            }
        }
    }

    let mut rust: String = "// Generated by the Nikaia bootstrap compiler (Stage 0).\n// Edit the .nika source, not this file.\n\n"
    rust.push_str(host.preamble())
    rust.push_str("\n")
    for at in 0..<packages.len() {
        // **A dependency's files are read and not written** (ADR-286 D19).
        // They are here so the ledger and the checks know what the package
        // offers; the crate that offers it is generated beside this one, and
        // a qualified name needs no help from us - `c::thing()` is emitted
        // as written and Rust resolves `c` to the crate the manifest names.
        //
        // The index is still the units', because a diagnostic about a
        // dependency's file has to name that file.
        if packages[at] != null {
            continue
        }
        let body = host.emit_unit(at, provenance, rust.len())
        rust.push_str(body)
        rust.push_str("\n")
    }
    // **Last, because it names lines** (ADR-300 D9). Only where the program
    // has an entry point: the table is read by the hook `fn main` installs,
    // and a package with no `main` is a library whose consumer has one.
    if host.has_main() {
        let table = emit_needs_abort_table(rust, host.map_rows(), shown, sources)
        rust.push_str(table)
    }
    return rust
}
