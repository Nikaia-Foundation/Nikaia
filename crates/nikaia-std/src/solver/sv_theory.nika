// crates/nikaia-std/src/solver/sv_theory.nika
//
// **The theory interface** (ADR-270 D12, #1282 item 5): every theory sits
// behind the same calls - `assert(lit)`, `propagate()`, `check(final,
// limit)`, `explain(lit)`, `backtrack(level)`, `model()` and `shared()` - and
// writes what it derives into the one proof log of `sv_proof.nika` (D5). The
// first theory is Fourier-Motzkin of `logic_lia.nika`, run as it is
// (`lg_contradictory`): its refutation, a chain of hypotheses, tightenings and
// combinations, is written as `Combine` and `Round` steps ending in one Farkas
// lemma, so `sv_check.nika` replays it without trusting Fourier-Motzkin.
//
// A literal names an atom of the book (`2a` the atom, `2a + 1` its negation,
// as `sv_proof.nika` says); every atom is a bound `row <= 0` over integer
// columns, so a negated atom is the bound `-row + 1 <= 0`.

/// The log and what the checker will know when it replays it: the atoms (the
/// query's, then each split's two) and the bound every bound entry holds.
pub struct SvBook {
	pub log: SvLog,
	pub atoms: Vec[SvAtom],
	pub bounds: collections::BTreeMap[u32, SvBound],
}

/// A book over `query`, its clauses not yet put in.
fn sv_book(query: ref SvQuery) -> SvBook? {
	let log = sv_log(query) ?? return null
	return SvBook { log: log, atoms: query.atoms.clone(), bounds: collections::BTreeMap() }
}

/// A clause the log derived: its entry and its literals, ascending.
pub struct SvClause {
	pub id: u32,
	pub lits: Vec[u32],
}

/// The literals in `a` and `b`, once each, ascending.
fn sv_lits_union(a: ref Vec[u32], b: ref Vec[u32]) -> Vec[u32] {
	let mut out = a.clone()
	for l in b {
		if !out.contains(l) {
			out.push(l)
		}
	}
	out.sort()
	return out
}

impl SvBook {
	/// The bound literal `l` assumes, as the checker reads it; `null` past
	/// the atoms, on a negated equality, or where the negation overflows.
	fn lit_bound(ref self, l: u32) -> SvBound? {
		let at = (l / 2) as i64
		if at >= self.atoms.len() {
			return null
		}
		let atom = self.atoms[at].clone()
		if l % 2 == 0 {
			return SvBound { row: atom.row, rel: atom.rel, assumed: [l] }
		}
		let shift: i64 = match atom.rel {
			SvRel::Le => 1,
			SvRel::Lt => 0,
			SvRel::Eq => return null,
		}
		let negated = sv_row_sum(-1, atom.row, shift, sv_row_constant(1)) ?? return null
		return SvBound { row: negated, rel: SvRel::Le, assumed: [l] }
	}

	/// The bound a source adds.
	fn source(ref self, src: ref SvSrc) -> SvBound? {
		return match src {
			SvSrc::Lit(l) => self.lit_bound(l),
			SvSrc::Fact(id) => {
				let got = self.bounds.get(id) ?? return null
				got.clone()
			},
		}
	}

	/// `Σ multipliers[i]·sources[i]` over bounds `<= 0`, reduced by its gcd
	/// as the checker reduces it; `null` where a source is unknown, a
	/// multiplier negative or a step leaves `i64`.
	fn sum(ref self, sources: ref Vec[SvSrc], multipliers: ref Vec[i64]) -> SvBound? {
		let mut row = sv_row_constant(0)
		let mut assumed: Vec[u32] = []
		let mut i = 0
		while i < sources.len() {
			let b = self.source(sources[i]) ?? return null
			let m = multipliers[i]
			if m < 0 {
				return null
			}
			if m != 0 {
				row = sv_row_sum(1, row, m, b.row) ?? return null
				assumed = sv_lits_union(assumed, b.assumed)
			}
			i += 1
		}
		return SvBound { row: sv_row_reduced(row), rel: SvRel::Le, assumed: assumed }
	}

	/// The combination kept as a bound entry; its id.
	fn combine(ref mut self, sources: Vec[SvSrc], multipliers: Vec[i64]) -> u32? {
		let b = self.sum(sources, multipliers) ?? return null
		// A bound entry taken once is itself where the checker would not
		// reduce it.
		if sources.len() == 1 && multipliers[0] == 1 {
			match sources[0] {
				SvSrc::Fact(id) => {
					let had = self.bounds.get(id) ?? return null
					if sv_row_same(had.row, b.row) {
						return id
					}
				},
				else => {},
			}
		}
		let id = self.log.combine(sources, multipliers)
		self.bounds.insert(id, b)
		return id
	}

	/// Bound entry `id` divided by the gcd of its coefficients, its constant
	/// rounded up (Chvátal-Gomory); `id` itself where the gcd is one.
	fn round(ref mut self, id: u32) -> u32? {
		let b = (self.bounds.get(id) ?? return null).clone()
		let g = sv_row_content(b.row) ?? return null
		if g <= 1 {
			return id
		}
		let row = sv_row_tightened(b.row)
		let made = self.log.round(id, g)
		self.bounds.insert(made, SvBound { row: row, rel: SvRel::Le, assumed: b.assumed.clone() })
		return made
	}

	/// A theory lemma from a combination that ends in `c <= 0` with
	/// `c > 0`: the clause of the negations of what it assumed. `null`, and
	/// nothing written, where the combination is no contradiction.
	fn farkas(ref mut self, sources: Vec[SvSrc], multipliers: Vec[i64]) -> SvClause? {
		let b = self.sum(sources, multipliers) ?? return null
		if b.row.cols.len() > 0 || b.row.constant <= 0 {
			return null
		}
		let mut lits: Vec[u32] = []
		for l in b.assumed {
			// `l ^ 1` written as a branch: #1286.
			let negation = if l % 2 == 0 { l + 1 } else { l - 1 }
			lits.push(negation)
		}
		lits.sort()
		let id = self.log.farkas(lits.clone(), sources, multipliers, 1)
		return SvClause { id: id, lits: lits }
	}

	/// The split `le <= 0 ∨ ge <= 0`: its clause, over the two atoms it adds.
	fn split(ref mut self, le: SvRow, ge: SvRow) -> SvClause? {
		let first = self.atoms.len().checked_u32() ?? return null
		self.atoms.push(SvAtom { row: le.clone(), rel: SvRel::Le })
		self.atoms.push(SvAtom { row: ge.clone(), rel: SvRel::Le })
		let id = self.log.split(le, ge)
		return SvClause { id: id, lits: [sv_lit(first, false), sv_lit(first + 1, false)] }
	}

	/// The fresh column `q = ⌊l / m⌋` and its two bounds `m·q - l <= 0` and
	/// `l - m·q - (m - 1) <= 0`, entries `first` and `first + 1`.
	fn extend(ref mut self, l: SvRow, m: i64) -> SvExtended? {
		let q = self.log.columns
		let mq = SvRow { cols: [q], ks: [m], constant: 0 }
		let below = sv_row_sum(-1, l, 1, mq) ?? return null
		let above0 = sv_row_sum(1, l, -1, mq) ?? return null
		let above = sv_row_sum(1, above0, -(m - 1), sv_row_constant(1)) ?? return null
		let first = self.log.extend(l, m)
		self.bounds.insert(first, SvBound { row: below, rel: SvRel::Le, assumed: [] })
		self.bounds.insert(first + 1, SvBound { row: above, rel: SvRel::Le, assumed: [] })
		return SvExtended { column: q, first: first }
	}

	fn input(ref mut self, clause: u32) -> u32 {
		return self.log.input(clause)
	}

	fn learn(ref mut self, lits: Vec[u32], hints: Vec[u32]) -> u32 {
		return self.log.learn(lits, hints)
	}
}

/// What an extension made: its column and its first bound entry.
pub struct SvExtended {
	pub column: u32,
	pub first: u32,
}

/// A bound the theory hands to its engine: `row <= 0`, and where it comes
/// from - a literal on the trail or a bound entry the theory derived.
pub struct SvHeld {
	pub row: SvRow,
	pub src: SvSrc,
}

/// What `check` answers.
pub enum SvChecked {
	/// What is asserted has integer values; `model()` gives them.
	Consistent,
	/// What is asserted has none: the clause, an entry of the log.
	Conflict(SvClause),
	/// Clauses to add before asking again (a split, a cut): their entries.
	Lemmas(Vec[SvClause]),
	/// The theory cannot tell.
	Unknown(LgUnknown),
}

/// A column solved by an equality on the way: `x = -(rest) / s` with `s`
/// one or minus one, back-substituted into a model.
pub struct SvSolved {
	pub column: u32,
	pub row: SvRow,
}

/// **The Fourier-Motzkin theory**: the literals asserted, level by level,
/// what it propagated and from which literal, and the last model.
pub struct SvTheory {
	/// Each column's name, as `logic_lia.nika` and a model name it.
	pub names: Vec[String],
	pub trail: Vec[u32],
	/// The trail's length when each level above zero began.
	pub levels: Vec[i64],
	pub implied: Vec[u32],
	pub implied_by: Vec[u32],
	pub values: collections::BTreeMap[String, i64],
	/// Bound entries that hold at every level: what the driver derived
	/// before the search (a congruence's `x - a - d·q >= 0`).
	pub facts: Vec[u32],
	/// Whether `check` eliminates equalities before Fourier-Motzkin (#1282
	/// item 6).
	pub exact: bool,
}

fn sv_theory(names: Vec[String]) -> SvTheory {
	return SvTheory {
		names: names,
		trail: [],
		levels: [],
		implied: [],
		implied_by: [],
		values: collections::BTreeMap(),
		facts: [],
		exact: true,
	}
}

/// A row as `logic_lia.nika` reads it, the columns by their names.
fn sv_lin(row: ref SvRow, names: ref Vec[String]) -> LgLin {
	let mut terms: collections::BTreeMap[String, i64] = collections::BTreeMap()
	let mut i = 0
	while i < row.cols.len() {
		terms.insert(sv_column_name(row.cols[i], names), row.ks[i])
		i += 1
	}
	return LgLin { terms: terms, constant: row.constant }
}

/// Column `c`'s name: the query's, or `sv#c` for one an extension made.
fn sv_column_name(c: u32, names: ref Vec[String]) -> String {
	let at = c as i64
	if at < names.len() {
		return names[at].clone()
	}
	return f"sv#{c}"
}

/// One step of a refutation spelled out as the checker reads it: a sum of
/// sources with their multipliers.
struct SvSpelled {
	sources: Vec[SvSrc],
	multipliers: Vec[i64],
}

/// `a·x + b·y`, the sources merged; `null` where a multiplier leaves `i64`.
fn sv_spelled_sum(a: i64, x: ref SvSpelled, b: i64, y: ref SvSpelled) -> SvSpelled? {
	let mut out = SvSpelled { sources: [], multipliers: [] }
	for (src, m) in x.sources.iter().zip(x.multipliers.iter()) {
		out.sources.push(src.clone())
		out.multipliers.push(a.checked_mul(m) ?? return null)
	}
	for (src, m) in y.sources.iter().zip(y.multipliers.iter()) {
		let add = b.checked_mul(m) ?? return null
		let mut found = false
		let mut i = 0
		while i < out.sources.len() {
			if sv_src_same(out.sources[i], src) {
				out.multipliers[i] = out.multipliers[i].checked_add(add) ?? return null
				found = true
				break
			}
			i += 1
		}
		if !found {
			out.sources.push(src.clone())
			out.multipliers.push(add)
		}
	}
	return out
}

fn sv_src_same(a: ref SvSrc, b: ref SvSrc) -> bool {
	return match a {
		SvSrc::Lit(x) => match b {
			SvSrc::Lit(y) => x == y,
			else => false,
		},
		SvSrc::Fact(x) => match b {
			SvSrc::Fact(y) => x == y,
			else => false,
		},
	}
}

/// Fourier-Motzkin's refutation of `held` written into the book: each
/// tightening a `Combine` and a `Round`, the last bound a Farkas lemma.
/// `null` where a multiplier leaves `i64` or the lemma does not close.
fn sv_written(refutation: ref LgRefutation, held: ref Vec[SvHeld], mut book: SvBook) -> SvClause? {
	let mut spelled: Vec[SvSpelled] = []
	for step in refutation.steps {
		let made = match step {
			LgStep::Hypothesis(i) => SvSpelled { sources: [held[i].src.clone()], multipliers: [1] },
			LgStep::Tighten(from) => {
				let at = book.combine(
					spelled[from].sources.clone(),
					spelled[from].multipliers.clone(),
				)
					?? return null
				let rounded = book.round(at) ?? return null
				SvSpelled { sources: [SvSrc::Fact(rounded)], multipliers: [1] }
			},
			LgStep::Combine { left, by_left, right, by_right } => sv_spelled_sum(
				by_left,
				spelled[left],
				by_right,
				spelled[right],
			) ?? return null,
		}
		spelled.push(made)
	}
	let last = spelled.len() - 1
	if last < 0 {
		return null
	}
	return book.farkas(spelled[last].sources.clone(), spelled[last].multipliers.clone())
}

impl SvTheory {
	/// A new level: what is asserted from now on is forgotten by
	/// `backtrack` to the level before.
	fn push(ref mut self) {
		self.levels.push(self.trail.len())
	}

	/// The current level.
	fn level(ref self) -> i64 {
		return self.levels.len()
	}

	/// `assert(lit)`: the literal holds from now on. A bound without columns
	/// that is false is a conflict at once.
	fn assert(ref mut self, lit: u32, mut book: SvBook) -> SvChecked {
		self.trail.push(lit)
		let b = book.lit_bound(lit) ?? return SvChecked::Unknown(LgUnknown::OutsideTheTheory)
		if b.row.cols.len() == 0 && b.row.constant > 0 {
			let clause = book.farkas([SvSrc::Lit(lit)], [1])
				?? return SvChecked::Unknown(LgUnknown::Overflow)
			return SvChecked::Conflict(clause)
		}
		return SvChecked::Consistent
	}

	/// `propagate()`: each literal of the book's atoms, neither asserted nor
	/// propagated yet, whose bound an asserted bound on the same form
	/// implies - `F + c <= 0` gives `F + c' <= 0` for every `c' <= c`.
	fn propagate(ref mut self, book: ref SvBook) -> Vec[u32] {
		let mut out: Vec[u32] = []
		let count = book.atoms.len().checked_u32() ?? return out
		let mut a: u32 = 0
		while a < count {
			for l in [sv_lit(a, false), sv_lit(a, true)] {
				if self.trail.contains(l) || self.implied.contains(l) {
					continue
				}
				let mine = book.lit_bound(l) ?? continue
				for t in self.trail {
					let theirs = book.lit_bound(t) ?? continue
					if mine.row.cols == theirs.row.cols
						&& mine.row.ks == theirs.row.ks
						&& mine.row.constant <= theirs.row.constant {
							self.implied.push(l)
							self.implied_by.push(t)
							out.push(l)
							break
						}
				}
			}
			a += 1
		}
		return out
	}

	/// `explain(lit)`: the clause behind a propagated literal - the literal
	/// or the negation of the bound it follows from - as a Farkas lemma.
	fn explain(ref mut self, lit: u32, mut book: SvBook) -> SvClause? {
		let mut i = 0
		while i < self.implied.len() {
			if self.implied[i] == lit {
				let negation = if lit % 2 == 0 { lit + 1 } else { lit - 1 }
				return book.farkas([SvSrc::Lit(self.implied_by[i]), SvSrc::Lit(negation)], [1, 1])
			}
			i += 1
		}
		return null
	}

	/// `backtrack(level)`: forgets what was asserted above `level`, and what
	/// was propagated from it.
	fn backtrack(ref mut self, level: i64) {
		if level >= self.levels.len() {
			return
		}
		let keep = self.levels[level]
		self.trail.truncate(keep)
		self.levels.truncate(level)
		let mut implied: Vec[u32] = []
		let mut implied_by: Vec[u32] = []
		let mut i = 0
		while i < self.implied.len() {
			if self.trail.contains(self.implied_by[i]) {
				implied.push(self.implied[i])
				implied_by.push(self.implied_by[i])
			}
			i += 1
		}
		self.implied = implied
		self.implied_by = implied_by
	}

	/// `check(final, limit)`: whether what is asserted has integer values,
	/// within `limit` (Fourier-Motzkin's bounds). Not final, it may stop at
	/// the cheap tests; this theory runs the whole test either way.
	fn check(ref mut self, final: bool, limit: ref LgBudget, mut book: SvBook) -> SvChecked {
		let mut held: Vec[SvHeld] = []
		for l in self.trail {
			let b = book.lit_bound(l) ?? return SvChecked::Unknown(LgUnknown::OutsideTheTheory)
			held.push(SvHeld { row: b.row, src: SvSrc::Lit(l) })
		}
		for f in self.facts {
			let b = book.bounds.get(f) ?? return SvChecked::Unknown(LgUnknown::OutsideTheTheory)
			held.push(SvHeld { row: b.row.clone(), src: SvSrc::Fact(f) })
		}
		let mut solved: Vec[SvSolved] = []
		if self.exact {
			let done = sv_eliminate(held, solved, book)
			match done {
				SvChecked::Consistent => {},
				else => {
					return done
				},
			}
		}
		let mut lins: Vec[LgLin] = []
		for h in held {
			lins.push(sv_lin(h.row, self.names))
		}
		return match lg_contradictory(lins, limit) {
			LgClosed::Refuted(refutation) => {
				let clause = sv_written(refutation, held, book)
					?? return SvChecked::Unknown(LgUnknown::Overflow)
				SvChecked::Conflict(clause)
			},
			LgClosed::Consistent { found, values } => {
				if !found {
					// Consistent over the rationals without integer values:
					// a branch may still split, a final check cannot tell.
					if final {
						return SvChecked::Unknown(LgUnknown::NoContradiction)
					}
					return SvChecked::Consistent
				}
				self.values = sv_back_substituted(values, solved, self.names)
					?? return SvChecked::Unknown(LgUnknown::Overflow)
				SvChecked::Consistent
			},
			LgClosed::Unknown(why) => SvChecked::Unknown(why.clone()),
		}
	}

	/// `model()`: the values of the last consistent `check`, by name.
	fn model(ref self) -> collections::BTreeMap[String, i64] {
		return self.values.clone()
	}

	/// `shared()`: the equalities this theory shares with others (D13) -
	/// none while it is the only one.
	fn shared(ref self) -> Vec[u32] {
		return []
	}
}

/// The values of the columns an elimination solved, latest first, from the
/// values of the rest (a column without one is zero).
fn sv_back_substituted(
	values: ref collections::BTreeMap[String, i64],
	solved: ref Vec[SvSolved],
	names: ref Vec[String],
) -> collections::BTreeMap[String, i64]? {
	let mut out = values.clone()
	let mut i = solved.len()
	while i > 0 {
		i -= 1
		let s = solved[i].clone()
		let mut rest: i64 = s.row.constant
		let mut unit: i64 = 0
		let mut j = 0
		while j < s.row.cols.len() {
			let c = s.row.cols[j]
			if c == s.column {
				unit = s.row.ks[j]
			} else {
				let v: i64 = out.get(sv_column_name(c, names)) ?? 0
				rest = rest.checked_add(s.row.ks[j].checked_mul(v) ?? return null) ?? return null
			}
			j += 1
		}
		if unit != 1 && unit != -1 {
			return null
		}
		// `unit·x + rest = 0`.
		let value = if unit == 1 { rest.checked_neg() ?? return null } else { rest }
		out.insert(sv_column_name(s.column, names), value)
	}
	return out
}
