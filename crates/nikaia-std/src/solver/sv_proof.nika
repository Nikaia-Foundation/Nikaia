// crates/nikaia-std/src/solver/sv_proof.nika
//
// **The proof log** (ADR-270 D5, #1282 item 4): one append-only log every
// engine, strategy and theory writes into, replayed by `sv_check.nika`
// without search.
//
// A query is its atoms (`row <= 0`, `row < 0` or `row = 0` over integer
// columns) and its clauses over literals; literal `2a` is atom `a`, `2a + 1`
// its negation, over the integers `-row + 1 <= 0` for `row <= 0` and
// `-row <= 0` for `row < 0` (the negation of an equality is no bound). The
// log numbers what it derives, its *entries*, in the order it derives them:
// every step makes one entry except an extension, which makes two. An entry
// is a clause or a bound; a bound carries the literals it assumes, and a
// Farkas lemma turns those into its clause.
//
// The steps:
//
// * `Input(c)`: clause `c` of the query, numbered by the checker itself.
// * `Learn(lits, hints)`: a clause by reverse unit propagation through the
//   hinted clauses, in order (LRAT); without hints it is refused.
// * `Delete(id)`: an entry no later step reads.
// * `Farkas(lits, sources, multipliers, den)`: the clause `lits`, justified by
//   a combination of bounds - a literal's own bound, or an earlier bound
//   entry - with integer multipliers over the one denominator `den > 0`,
//   non-negative on an inequality, ending in `c <= 0` with `c > 0`, `c < 0`
//   with `c >= 0` or `c = 0` with `c != 0`.
// * `Combine(sources, multipliers)`: the same combination kept as a bound.
// * `Round(id, d)`: Chvátal-Gomory: bound `id`, every coefficient divisible
//   by `d > 0`, divided by `d` and its constant rounded towards the integers;
//   an equality whose constant `d` does not divide is `1 <= 0` (the GCD test).
// * `Split(le, ge)`: two new atoms `le <= 0` and `ge <= 0` with `le + ge = 1`
//   (`L - k <= 0 ∨ k + 1 - L <= 0`) and the clause of both.
// * `Extend(l, m, q)`: the fresh column `q = ⌊l / m⌋` for `m > 0`, the two
//   bounds `m·q - l <= 0` and `l - m·q - (m - 1) <= 0`.
//
// The *book* (`SvBook`) is the log with what the checker will know when it
// replays it - the atoms and every bound entry's bound - so an engine and
// its theory write steps the checker accepts; the SAT core and the theory
// share one book (#1283).

/// How a row compares to zero.
pub enum SvRel {
	Le,
	Lt,
	Eq,
}

/// `row REL 0`.
pub struct SvAtom {
	pub row: SvRow,
	pub rel: SvRel,
}

/// A query as the log reads it: its atoms, its clauses over literals, and
/// how many integer columns it has.
pub struct SvQuery {
	pub atoms: Vec[SvAtom],
	pub clauses: Vec[Vec[u32]],
	pub columns: u32,
}

/// What a combination adds: the bound of a literal, assumed, or an earlier
/// bound entry.
pub enum SvSrc {
	Lit(u32),
	Fact(u32),
}

pub enum SvStep {
	Input(u32),
	Learn(Vec[u32], Vec[u32]),
	Delete(u32),
	Farkas(Vec[u32], Vec[SvSrc], Vec[i64], i64),
	Combine(Vec[SvSrc], Vec[i64]),
	Round(u32, i64),
	Split(SvRow, SvRow),
	Extend(SvRow, i64, u32),
}

/// The literal of atom `a`, negated where `negated`.
fn sv_lit(a: u32, negated: bool) -> u32 {
	return if negated { 2 * a + 1 } else { 2 * a }
}

/// The steps and what they number: entries, atoms and columns so far.
pub struct SvLog {
	pub steps: Vec[SvStep],
	pub entries: u32,
	pub atoms: u32,
	pub columns: u32,
}

/// An empty log over `query`.
fn sv_log(query: ref SvQuery) -> SvLog? {
	let atoms = query.atoms.len().checked_u32() ?? return null
	return SvLog { steps: [], entries: 0, atoms: atoms, columns: query.columns }
}

impl SvLog {
	/// Appends `step`, which makes `made` entries; the id of the first.
	fn add(ref mut self, step: SvStep, made: u32) -> u32 {
		let id = self.entries
		self.steps.push(step)
		self.entries += made
		return id
	}

	fn input(ref mut self, clause: u32) -> u32 {
		return self.add(SvStep::Input(clause), 1)
	}

	fn learn(ref mut self, lits: Vec[u32], hints: Vec[u32]) -> u32 {
		return self.add(SvStep::Learn(lits, hints), 1)
	}

	fn delete(ref mut self, id: u32) {
		self.steps.push(SvStep::Delete(id))
	}

	fn farkas(
		ref mut self,
		lits: Vec[u32],
		sources: Vec[SvSrc],
		multipliers: Vec[i64],
		den: i64,
	) -> u32 {
		return self.add(SvStep::Farkas(lits, sources, multipliers, den), 1)
	}

	fn combine(ref mut self, sources: Vec[SvSrc], multipliers: Vec[i64]) -> u32 {
		return self.add(SvStep::Combine(sources, multipliers), 1)
	}

	fn round(ref mut self, id: u32, d: i64) -> u32 {
		return self.add(SvStep::Round(id, d), 1)
	}

	/// The split `le <= 0 ∨ ge <= 0`: its clause's id; its atoms are the
	/// two after `atoms` before the call.
	fn split(ref mut self, le: SvRow, ge: SvRow) -> u32 {
		self.atoms += 2
		return self.add(SvStep::Split(le, ge), 1)
	}

	/// The extension `q = ⌊l / m⌋`: the id of its first bound, the second
	/// following; `q` is the column `columns` before the call.
	fn extend(ref mut self, l: SvRow, m: i64) -> u32 {
		let q = self.columns
		self.columns += 1
		return self.add(SvStep::Extend(l, m, q), 2)
	}
}

/// The step's name, as the checker's reasons and an export write it.
fn sv_step_kind(step: ref SvStep) -> String {
	return match step {
		SvStep::Input(_) => "input",
		SvStep::Learn(_, _) => "learn",
		SvStep::Delete(_) => "delete",
		SvStep::Farkas(_, _, _, _) => "farkas",
		SvStep::Combine(_, _) => "combine",
		SvStep::Round(_, _) => "round",
		SvStep::Split(_, _) => "split",
		SvStep::Extend(_, _, _) => "extend",
	}
}

/// The log and what the checker will know when it replays it: the atoms (the
/// query's, then each split's two) and the bound every bound entry holds.
pub struct SvBook {
	pub log: SvLog,
	pub atoms: Vec[SvAtom],
	pub bounds: collections::BTreeMap[u32, SvBound],
}

/// A book over `query`, its clauses not yet put in.
fn sv_book(query: ref SvQuery) -> SvBook? {
	let log = sv_log(query) ?? return null
	return SvBook { log: log, atoms: query.atoms.clone(), bounds: collections::BTreeMap() }
}

/// A clause the log derived: its entry and its literals, ascending.
pub struct SvClause {
	pub id: u32,
	pub lits: Vec[u32],
}

/// The literals in `a` and `b`, once each, ascending.
fn sv_lits_union(a: ref Vec[u32], b: ref Vec[u32]) -> Vec[u32] {
	let mut out = a.clone()
	for l in b {
		if !out.contains(l) {
			out.push(l)
		}
	}
	out.sort()
	return out
}

impl SvBook {
	/// The bound literal `l` assumes, as the checker reads it; `null` past
	/// the atoms, on a negated equality, or where the negation overflows.
	fn lit_bound(ref self, l: u32) -> SvBound? {
		let at = (l / 2) as i64
		if at >= self.atoms.len() {
			return null
		}
		let atom = self.atoms[at].clone()
		if l % 2 == 0 {
			return SvBound { row: atom.row, rel: atom.rel, assumed: [l] }
		}
		let shift: i64 = match atom.rel {
			SvRel::Le => 1,
			SvRel::Lt => 0,
			SvRel::Eq => return null,
		}
		let negated = sv_row_sum(-1, atom.row, shift, sv_row_constant(1)) ?? return null
		return SvBound { row: negated, rel: SvRel::Le, assumed: [l] }
	}

	/// The bound a source adds.
	fn source(ref self, src: ref SvSrc) -> SvBound? {
		return match src {
			SvSrc::Lit(l) => self.lit_bound(l),
			SvSrc::Fact(id) => {
				let got = self.bounds.get(id) ?? return null
				got.clone()
			},
		}
	}

	/// `Σ multipliers[i]·sources[i]` over bounds `<= 0`, reduced by its gcd
	/// as the checker reduces it; `null` where a source is unknown, a
	/// multiplier negative or a step leaves `i64`.
	fn sum(ref self, sources: ref Vec[SvSrc], multipliers: ref Vec[i64]) -> SvBound? {
		let mut row = sv_row_constant(0)
		let mut assumed: Vec[u32] = []
		let mut i = 0
		while i < sources.len() {
			let b = self.source(sources[i]) ?? return null
			let m = multipliers[i]
			if m < 0 {
				return null
			}
			if m != 0 {
				row = sv_row_sum(1, row, m, b.row) ?? return null
				assumed = sv_lits_union(assumed, b.assumed)
			}
			i += 1
		}
		return SvBound { row: sv_row_reduced(row), rel: SvRel::Le, assumed: assumed }
	}

	/// The combination kept as a bound entry; its id.
	fn combine(ref mut self, sources: Vec[SvSrc], multipliers: Vec[i64]) -> u32? {
		let b = self.sum(sources, multipliers) ?? return null
		// A bound entry taken once is itself where the checker would not
		// reduce it.
		if sources.len() == 1 && multipliers[0] == 1 {
			match sources[0] {
				SvSrc::Fact(id) => {
					let had = self.bounds.get(id) ?? return null
					if sv_row_same(had.row, b.row) {
						return id
					}
				},
				else => {},
			}
		}
		let id = self.log.combine(sources, multipliers)
		self.bounds.insert(id, b)
		return id
	}

	/// Bound entry `id` divided by the gcd of its coefficients, its constant
	/// rounded up (Chvátal-Gomory); `id` itself where the gcd is one.
	fn round(ref mut self, id: u32) -> u32? {
		let b = (self.bounds.get(id) ?? return null).clone()
		let g = sv_row_content(b.row) ?? return null
		if g <= 1 {
			return id
		}
		let row = sv_row_tightened(b.row)
		let made = self.log.round(id, g)
		self.bounds.insert(made, SvBound { row: row, rel: SvRel::Le, assumed: b.assumed.clone() })
		return made
	}

	/// A theory lemma from a combination that ends in `c <= 0` with
	/// `c > 0`: the clause of the negations of what it assumed. `null`, and
	/// nothing written, where the combination is no contradiction.
	fn farkas(ref mut self, sources: Vec[SvSrc], multipliers: Vec[i64]) -> SvClause? {
		let b = self.sum(sources, multipliers) ?? return null
		if b.row.cols.len() > 0 || b.row.constant <= 0 {
			return null
		}
		let mut lits: Vec[u32] = []
		for l in b.assumed {
			// `l ^ 1` written as a branch: #1286.
			let negation = if l % 2 == 0 { l + 1 } else { l - 1 }
			lits.push(negation)
		}
		lits.sort()
		let id = self.log.farkas(lits.clone(), sources, multipliers, 1)
		return SvClause { id: id, lits: lits }
	}

	/// The split `le <= 0 ∨ ge <= 0`: its clause, over the two atoms it adds.
	fn split(ref mut self, le: SvRow, ge: SvRow) -> SvClause? {
		let first = self.atoms.len().checked_u32() ?? return null
		self.atoms.push(SvAtom { row: le.clone(), rel: SvRel::Le })
		self.atoms.push(SvAtom { row: ge.clone(), rel: SvRel::Le })
		let id = self.log.split(le, ge)
		return SvClause { id: id, lits: [sv_lit(first, false), sv_lit(first + 1, false)] }
	}

	/// The fresh column `q = ⌊l / m⌋` and its two bounds `m·q - l <= 0` and
	/// `l - m·q - (m - 1) <= 0`, entries `first` and `first + 1`.
	fn extend(ref mut self, l: SvRow, m: i64) -> SvExtended? {
		let q = self.log.columns
		let mq = SvRow { cols: [q], ks: [m], constant: 0 }
		let below = sv_row_sum(-1, l, 1, mq) ?? return null
		let above0 = sv_row_sum(1, l, -1, mq) ?? return null
		let above = sv_row_sum(1, above0, -(m - 1), sv_row_constant(1)) ?? return null
		let first = self.log.extend(l, m)
		self.bounds.insert(first, SvBound { row: below, rel: SvRel::Le, assumed: [] })
		self.bounds.insert(first + 1, SvBound { row: above, rel: SvRel::Le, assumed: [] })
		return SvExtended { column: q, first: first }
	}

	fn input(ref mut self, clause: u32) -> u32 {
		return self.log.input(clause)
	}

	fn learn(ref mut self, lits: Vec[u32], hints: Vec[u32]) -> u32 {
		return self.log.learn(lits, hints)
	}
}

/// What an extension made: its column and its first bound entry.
pub struct SvExtended {
	pub column: u32,
	pub first: u32,
}
