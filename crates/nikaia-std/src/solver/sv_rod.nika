// crates/nikaia-std/src/solver/sv_rod.nika
//
// **The measuring rod's driver** (ADR-270 D17, #1281): `scripts/solver.nika`
// puts this file after the logic layer's and the engine's files of `tools/`
// into one program and runs it on SMT-LIB 2 files. The per-file line now
// lives in `tools/sv_rod_line.nika`, so the package's tests and the CLI share
// it; only the CLI entry stays here: it is the harness, not the solver.

use std::cli
use std::fs

/// The program's entry: `ENGINE FILE...`, one line per file. The engine is
/// `fm`, Fourier-Motzkin as the compiler runs it, or `new`, the CDCL(T)
/// engine of `sv_smt.nika` over both theories (`new-fm`, `new-simplex`: over
/// one).
pub fn sv_rod_main() throws {
	let mut args: Vec[String] = []
	for a in cli::args() {
		args.push(a)
	}
	// `--stats ENGINE FILE...`: each answer followed by the counters.
	let stats = args.len() > 1 && args[1] == "--stats"
	let from = if stats { 2 } else { 1 }
	let engine = args[from].clone()
	for i in from + 1..<args.len() {
		let source = fs::read_to_string(args[i].clone(), fs::Root::Anywhere)
		println(sv_line_stats(source, engine, stats))
	}
}
