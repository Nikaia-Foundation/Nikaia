// crates/nikaia-std/src/solver/sv_rod.nika
//
// **The measuring rod's driver** (ADR-270 D17, #1281): `scripts/solver.nika`
// puts this file after the logic layer's files of `tools/` into one program
// and runs it on SMT-LIB 2 files. Each file is answered by the engine, every
// *proved* is replayed by `lg_verify`, every *refuted* model is evaluated by
// `lg_verify_model`, and the answer is held against the file's status. One
// line per file: `answer work`. It stays here when the solver's files move to
// `tools/`: it is the harness, not the solver.

use std::cli
use std::fs

/// One answer and the work it took, counted in the engine's own units: the
/// branches Fourier-Motzkin's search looked at (ADR-270 D14).
struct SvRun {
	answer: LgAnswer,
	work: i64,
}

/// `lg_check`, with the work it did kept: the same steps, so the answer is the
/// one the compiler gets.
fn sv_fm_check(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	budget: ref LgBudget,
) -> SvRun {
	let mut why = lg_why()
	let read = lg_indexed(arena, facts, goal, why)
	if read == null {
		return SvRun { answer: LgAnswer::Unknown { why: why.unknown.clone() }, work: 0 }
	}
	let indexed = read
		?? return SvRun { answer: LgAnswer::Unknown { why: LgUnknown::NoContradiction }, work: 0 }
	let mut state = LgBranch { held_atoms: [], held_why: [], open_ors: [], open_why: [] }
	let none: collections::BTreeSet[i64] = collections::BTreeSet()
	state.absorb(indexed.top, none)
	let mut work = LgWork { n: 0 }
	let found = lg_search(indexed, state, budget, work)
	let answer = match found {
		LgSearched::Done { certificate, .. } => LgAnswer::Proved {
			certificate: certificate.clone()
		},
		LgSearched::Consistent { found, values } => lg_consistent_answer(
			arena,
			facts,
			goal,
			found,
			values,
		),
		LgSearched::Unknown(why_not) => LgAnswer::Unknown { why: why_not.clone() },
	}
	return SvRun { answer: answer, work: work.n }
}

/// The status a file states: `sat`, `unsat`, or empty where it states none.
/// SMT-LIB's `(set-info :status ...)` first, else a `; EXPECT:` line.
fn sv_status(source: String) -> String {
	for raw in source.lines() {
		let line = raw.trim()
		if line.starts_with("(set-info :status ") {
			let rest = line["(set-info :status ".len()..].replace(")", "").trim().clone()
			if rest == "sat" || rest == "unsat" {
				return rest
			}
		}
		if line.starts_with("; EXPECT: ") {
			let rest = line["; EXPECT: ".len()..].trim().clone()
			if rest == "sat" || rest == "unsat" {
				return rest
			}
		}
	}
	return ""
}

fn sv_unknown(why: LgUnknown) -> String {
	return match why {
		LgUnknown::OutsideTheTheory => "unknown (theory)",
		LgUnknown::Overflow => "unknown (overflow)",
		LgUnknown::TooManyCases => "unknown (cases)",
		LgUnknown::TooManyBounds => "unknown (bounds)",
		LgUnknown::NoContradiction => "unknown (no contradiction)",
		else => "unknown",
	}
}

/// The theory of a `new` engine: `new` both, `new-fm` and `new-simplex` one.
fn sv_new_theory(engine: String) -> String {
	if engine == "new-fm" {
		return "fm"
	}
	if engine == "new-simplex" {
		return "simplex"
	}
	return "both"
}

/// The engine's name of `ENGINE[:SETTINGS]`. A helper that returns early:
/// a `match` of the two parts fails in rustc (#1310).
fn sv_engine_name(engine: String) -> String {
	let at = engine.find(":") ?? return engine.clone()
	return engine[0..<at].to_string()
}

/// The settings of `ENGINE[:SETTINGS]`, empty where there are none.
fn sv_engine_settings(engine: String) -> String {
	let at = engine.find(":") ?? return ""
	return engine[at + ":".len()..].to_string()
}

/// One file's answer and the work it took: `proved`, `refuted`, `unknown
/// (why)` or `wrong (why)`, then the work.
fn sv_line(source: String, engine: String) -> String {
	return sv_line_stats(source, engine, false)
}

/// `sv_line`, where `stats` says so with the new engine's counters on a
/// second line (`stats: ...`, #1312 item 2).
fn sv_line_stats(source: String, engine: String, stats: bool) -> String {
	let status = sv_status(source)
	let mut reals: collections::BTreeSet[String] = collections::BTreeSet()
	let mut defs: Vec[SvNl] = []
	let script = match sv_smtlib_script(source) {
		SvSmtRead::Script(s, sorts) => {
			reals = sorts.reals.clone()
			defs = sorts.nl.clone()
			s.clone()
		},
		SvSmtRead::Failed(SvReadWhy::Overflow(_)) => {
			return "unknown (overflow) 0"
		},
		SvSmtRead::Failed(SvReadWhy::Malformed(why)) => {
			return f"malformed ({why}) 0"
		},
		SvSmtRead::Failed(_) => {
			return "unknown (unreadable) 0"
		},
	}
	let mut arena = script.arena.clone()
	let goal = arena.boolean(false)
	let budget = lg_budget()
	// `new:name=value,...`: the new engine with parameters of the
	// strategy's set changed (`sv_params_set_all`, #1284 item 5).
	let base = sv_engine_name(engine)
	let settings = sv_engine_settings(engine)
	if (base == "new" || base == "new-fm" || base == "new-simplex") && defs.len() > 0 {
		return sv_nl_line(arena, script.assertions, goal, budget, status, sv_new_theory(base), reals, settings, defs)
	}
	if base == "new" || base == "new-fm" || base == "new-simplex" {
		return sv_new_line(
			arena,
			script.assertions,
			goal,
			budget,
			status,
			sv_new_theory(base),
			reals,
			settings,
			stats,
		)
	}
	// `lg_check` reads every variable as an integer (ADR-270 D27): a real
	// script read so could be answered wrong.
	if reals.len() > 0 || defs.len() > 0 {
		return "unknown (theory) 0"
	}
	let run = sv_fm_check(arena, script.assertions, goal, budget)
	let answer = match run.answer {
		LgAnswer::Proved { certificate } => {
			if lg_verify(arena, script.assertions, goal, certificate) != null {
				"wrong (certificate rejected)"
			} else if status == "sat" {
				"wrong (proved, status sat)"
			} else {
				"proved"
			}
		},
		LgAnswer::Refuted { model } => {
			if !lg_verify_model(arena, script.assertions, goal, model) {
				"wrong (model rejected)"
			} else if status == "unsat" {
				"wrong (refuted, status unsat)"
			} else {
				"refuted"
			}
		},
		LgAnswer::Unknown { why } => sv_unknown(why),
	}
	return f"{answer} {run.work}"
}

/// The new engine's line (#1282, #1283) under the strategy's parameters
/// with `settings` changed (#1284): a *proved* is its proof log replayed by
/// `sv_check`, a model evaluated as Fourier-Motzkin's is, a rational one
/// (a query with a real column, ADR-270 D27) by `sv_real_model_holds`.
fn sv_new_line(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	budget: ref LgBudget,
	status: String,
	theory: String,
	reals: ref collections::BTreeSet[String],
	settings: String,
	stats: bool,
) -> String {
	let run = sv_smt_engine_set(arena, facts, goal, budget, theory, reals, settings)
		?? return f"unknown (settings {settings}) 0"
	let answer = match run.driven {
		SvDriven::Proved(query, steps) => {
			let verdict = sv_check(query, steps)
			if !verdict.ok {
				f"wrong (log rejected at {verdict.step}: {verdict.reason})"
			} else if status == "sat" {
				"wrong (proved, status sat)"
			} else {
				"proved"
			}
		},
		SvDriven::Answer(LgAnswer::Refuted { model }) => {
			if !lg_verify_model(arena, facts, goal, model) {
				"wrong (model rejected)"
			} else if status == "unsat" {
				"wrong (refuted, status unsat)"
			} else {
				"refuted"
			}
		},
		SvDriven::RealModel(values) => {
			if !sv_real_model_holds(arena, facts, goal, values) {
				"wrong (model rejected)"
			} else if status == "unsat" {
				"wrong (refuted, status unsat)"
			} else {
				"refuted"
			}
		},
		SvDriven::Answer(LgAnswer::Unknown { why }) => sv_unknown(why),
		SvDriven::Answer(_) => "unknown",
	}
	// The work of a fast path carries its name (#1283 item 4).
	let path = if run.path == "" { "" } else { f"/{run.path}" }
	let counted = if stats { f"\nstats: {sv_smt_stats_text(run.stats)}" } else { "" }
	return f"{answer} {run.work}{path}{counted}"
}

/// The line of a query with non-linear terms `defs` (ADR-270 D28): a
/// *proved* is its log replayed against the query `sv_lemma_query` builds
/// from the facts and the lemmas it re-derives, a model is evaluated on the
/// facts and held against every term's exact meaning.
fn sv_nl_line(
	arena: ref TermArena,
	facts: ref Vec[i64],
	goal: i64,
	budget: ref LgBudget,
	status: String,
	theory: String,
	reals: ref collections::BTreeSet[String],
	settings: String,
	defs: ref Vec[SvNl],
) -> String {
	let nl = sv_nl_engine(arena, facts, goal, budget, theory, reals, settings, defs)
		?? return f"unknown (settings {settings}) 0"
	let run = nl.run.clone()
	if nl.why == "budget" {
		return f"unknown (non-linear, budget) {run.work}"
	}
	if nl.why == "overflow" {
		return f"unknown (overflow) {run.work}"
	}
	let answer = match run.driven {
		SvDriven::Proved(_, steps) => {
			match sv_lemma_check(arena, facts, goal, reals, defs, nl.lemmas, steps) {
				null => "wrong (lemma rejected)",
				verdict => {
					if !verdict.ok {
						f"wrong (log rejected at {verdict.step}: {verdict.reason})"
					} else if status == "sat" {
						"wrong (proved, status sat)"
					} else {
						"proved"
					}
				},
			}
		},
		SvDriven::Answer(LgAnswer::Refuted { model }) => {
			if !lg_verify_model(arena, facts, goal, model) || !sv_nl_holds(defs, sv_nl_rats(model)) {
				"wrong (model rejected)"
			} else if status == "unsat" {
				"wrong (refuted, status unsat)"
			} else {
				"refuted"
			}
		},
		SvDriven::RealModel(values) => {
			if !sv_real_model_holds(arena, facts, goal, values) || !sv_nl_holds(defs, values) {
				"wrong (model rejected)"
			} else if status == "unsat" {
				"wrong (refuted, status unsat)"
			} else {
				"refuted"
			}
		},
		SvDriven::Answer(LgAnswer::Unknown { why }) => sv_unknown(why),
		SvDriven::Answer(_) => "unknown",
	}
	return f"{answer} {run.work}"
}

/// The program's entry: `ENGINE FILE...`, one line per file. The engine is
/// `fm`, Fourier-Motzkin as the compiler runs it, or `new`, the CDCL(T)
/// engine of `sv_smt.nika` over both theories (`new-fm`, `new-simplex`: over
/// one).
pub fn sv_rod_main() throws {
	let mut args: Vec[String] = []
	for a in cli::args() {
		args.push(a)
	}
	// `--stats ENGINE FILE...`: each answer followed by the counters.
	let stats = args.len() > 1 && args[1] == "--stats"
	let from = if stats { 2 } else { 1 }
	let engine = args[from].clone()
	for i in from + 1..<args.len() {
		let source = fs::read_to_string(args[i].clone(), fs::Root::Anywhere)
		println(sv_line_stats(source, engine, stats))
	}
}
