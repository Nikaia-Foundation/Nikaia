// crates/nikaia-std/src/compiler/check_core_stmt.nika
//
// **A statement, and a block of them** (ADR-294, #125, #558, C-6, U-c7):
// `stmt`, one function per `Stmt` variant, and `block`, which stops being a
// hub of the host. The form is the pilot's (`check_core_pilot.nika`): a free
// function over the state, the world and a host; an expression is walked
// through the hub `check_core_expr`. What stays Rust is asked through the host: a
// value with a cleanup bound by a `let` (`a_value_with_a_cleanup_bound`) and
// the spawn work's `NK2109` (`a_bound_handle_is_taken`, #605).

use std::collections

/// The empty tuple, what a statement that hands nothing back is.
fn check_core_stmt_unit() -> Ty {
    return Ty::Tuple([])
}

/// **The integer a `let`'s annotation names**, for the walk of its value
/// (`flow.reaching`): one of the five integer types, written bare.
fn check_core_stmt_reaching(world: ref CheckWorld, ty: ref Type?) -> String? sync {
    let written: ref Type = ty ?? return null
    return match written_ty(world.words, world.here.aliases, written) {
        Ty::Named { name, args, view } => {
            if !view && args.len() == 0 && (name == "u8" || name == "u32" || name == "u64" || name == "i32" || name == "i64") {
                name.clone()
            } else {
                null
            }
        },
        else => null,
    }
}

/// A closure or a list literal, the values a `let`'s annotation is expected by.
fn check_core_stmt_expects_a_lambda(value: ref Expr) -> bool sync {
    return match value {
        Expr::Closure { .. } => true,
        Expr::ListLit { .. } => true,
        Expr::ListRepeat { .. } => true,
        else => false,
    }
}

/// A function type, the one a lambda assigned to it is checked against.
fn check_core_stmt_a_fn_type(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Fn { .. } => true,
        else => false,
    }
}

/// An index or a method call: the reads of a map a name is bound to.
fn check_core_stmt_a_map_read(value: ref Expr) -> bool sync {
    return match value {
        Expr::Index { .. } => true,
        Expr::MethodCall { .. } => true,
        else => false,
    }
}

/// A call of `get`, by its method's name.
fn check_core_stmt_a_get(world: ref CheckWorld, read: ref Expr) -> bool sync {
    return match read {
        Expr::MethodCall { method, .. } => world.words.resolve(method) == "get",
        else => false,
    }
}

/// An index read, `xs[i]`.
fn check_core_stmt_an_index(read: ref Expr) -> bool sync {
    return match read {
        Expr::Index { .. } => true,
        else => false,
    }
}

/// An index into a map, whose base the index typing recorded (#1296).
fn check_core_stmt_a_map_index(state: ref CheckState, read: ref Expr) -> bool sync {
    return match read {
        Expr::Index { base, .. } => state.facts.map_indices.contains(id_of(base) as i64),
        else => false,
    }
}

/// **A value `get` hands back past a jump** (D30), or one of a chain of
/// `get`s the last of which jumps: `a.get(k) ?? b.get(k) ?? return` binds
/// the reference either hands back, as one `get` does.
fn check_core_stmt_got(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => check_core_stmt_a_get(world, read) && (state.jumps(world, fallback) || check_core_stmt_got(state, world, fallback)),
        else => false,
    }
}

/// **A list's or map's element past a jump, compared with a value, is a view
/// of it** (#1112): `let found = m.get(k) ?? return` binds the reference a
/// `std` list's or map's read hands back (the binding's `view_of`, #1044),
/// and so does that `??` of a `std` `get` itself; a `get` the program
/// declares hands back what it says. Only where the element neither copies
/// nor is text: those are #947's (`copied_jump_reads`). `ty` is the side's type.
fn check_core_stmt_got_compared(state: ref CheckState, world: ref CheckWorld, side: ref Expr, ty: ref Ty) -> bool sync {
    if ty.is_unknown() || ty.is_a_view() || check_owned_text(ty) || !state.takes_away(world, ty) {
        return false
    }
    return match side {
        Expr::Variable(name, _) => {
            let local = state.binding(world.words.resolve(name)) ?? return false
            local.view_of != ""
        }
        Expr::Coalesce { value: read, fallback, .. } => state.flow.std_gets.contains(id_of(read) as i64) && state.jumps(world, fallback),
        else => false,
    }
}

/// **And the same read spelled as a `match`** (#1089): `match m.get(k) {
/// null => throw ..  x => x }` binds what `m.get(k) ?? throw ..` does.
fn check_core_stmt_got_by_a_match(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    let (read, arms) = match value {
        Expr::Match { value: read, arms, .. } => (read, arms),
        else => return false,
    }
    if !check_core_stmt_a_get(world, read) || arms.len() != 2 {
        return false
    }
    let mut jumps = false
    let mut hands_back = false
    for arm in arms {
        if arm.guard != null {
            return false
        }
        if shapes_is_null(arm.pattern) {
            jumps = state.jumps(world, arm.body)
        } else {
            hands_back = check_core_stmt_binds_and_hands_back(world, arm.pattern, arm.body)
        }
    }
    return jumps && hands_back
}

/// An arm `x => x`: the value bound, handed back as it is.
fn check_core_stmt_binds_and_hands_back(world: ref CheckWorld, pattern: ref MatchPattern, body: ref Expr) -> bool sync {
    let bound = match pattern {
        MatchPattern::Path(path) => {
            if path.len() != 1 {
                return false
            }
            world.words.resolve(path[0]).clone()
        },
        else => return false,
    }
    return match body {
        Expr::Variable(name, _) => world.words.resolve(name) == bound,
        else => false,
    }
}

/// A read through the brackets whose fallback jumps.
// A chain `a[k] ?? b[k] ?? return` is one too (#735).
fn check_core_stmt_read_through_a_jump(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => check_core_stmt_an_index(read) && (state.jumps(world, fallback) || check_core_stmt_read_through_a_jump(state, world, fallback)),
        else => false,
    }
}

/// A list's `get`, `first` or `last` of a tuple, whose fallback jumps.
fn check_core_stmt_a_lent_list_read(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => state.flow.lent_list_reads.contains(id_of(read) as i64) && state.jumps(world, fallback),
        else => false,
    }
}

/// An option field read whose fallback jumps: `c.field ?? return`.
fn check_core_stmt_a_field_jump(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => check_core_stmt_a_field(read) && state.jumps(world, fallback),
        else => false,
    }
}

fn check_core_stmt_a_field(value: ref Expr) -> bool sync {
    return match value {
        Expr::Field { .. } => true,
        else => false,
    }
}

/// A named type, not a tuple or an option.
fn check_core_stmt_a_named(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { .. } => true,
        else => false,
    }
}

/// A tuple, which has no view form (#1535).
fn check_core_stmt_a_tuple(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Tuple(_) => true,
        else => false,
    }
}

/// A read through the brackets or a `get` whose fallback leaves.
fn check_core_stmt_a_read_that_leaves(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => (check_core_stmt_an_index(read) || check_core_stmt_a_get(world, read)) && (state.leaves(world, fallback) || check_core_stmt_a_read_that_leaves(state, world, fallback)),
        else => false,
    }
}

/// **Each read of a chain `a[k] ?? b[k] ?? return x` is copied out** (#694):
/// the read and every read its fallback chains to, so that each arm of the
/// `match`es it lowers to hands back the number and not a view of it.
fn check_core_stmt_copied_jump_reads(mut state: CheckState, value: ref Expr) sync {
    match value {
        Expr::Coalesce { fallback, .. } => {
            state.facts.copied_jump_reads.insert(id_of(value) as i64)
            check_core_stmt_copied_jump_reads(state, fallback)
        },
        else => {},
    }
}

/// **`let mut x = m[k] ?? <jump>` is a mutable view of the entry** (#816,
/// ADR-282 D7: a copy is never inserted). The place has to be a `mut` one,
/// the same rule as a change through it (`NK1138`, `NK1139`).
fn check_core_stmt_mut_view(mut state: CheckState, world: ref CheckWorld, value: ref Expr, span: ref Span, copies: bool) sync {
    match value {
        Expr::Coalesce { value: read, .. } => {
            match read {
                Expr::Field { .. } => {
                    // A field that is an option, read through a `mut` place: `as_mut`.
                    // A word that is copied stays a copy.
                    if !copies {
                        let path = dotted_path(world, read) ?? return
                        let parts: Vec[ref String] = path.split(".").collect()
                        let root = parts[0].clone()
                        let found = state.binding(root) ?? return
                        if found.without_mut == null {
                            state.facts.mut_view_reads.insert(id_of(value) as i64, "")
                        } else {
                            state.a_changed_binding_says_mut(root, "a mutable view of the field is taken here", span.clone())
                        }
                    }
                },
                // The same entry read by a `std` list's or map's `get` (#952,
                // ADR-293 D1): `get_mut`, whose receiver Rust lends itself.
                Expr::MethodCall { receiver, .. } => {
                    if state.flow.std_gets.contains(id_of(read) as i64) {
                        let path = dotted_path(world, receiver) ?? return
                        let parts: Vec[ref String] = path.split(".").collect()
                        let root = parts[0].clone()
                        let found = state.binding(root) ?? return
                        if found.without_mut == null {
                            state.facts.mut_view_reads.insert(id_of(value) as i64, "")
                            state.facts.mut_view_gets.insert(id_of(receiver) as i64)
                        } else {
                            state.a_changed_binding_says_mut(root, "a mutable view of the entry is taken here", span.clone())
                        }
                    }
                },
                Expr::Index { base, .. } => {
                    let path = dotted_path(world, base) ?? return
                    let parts: Vec[ref String] = path.split(".").collect()
                    let root = parts[0].clone()
                    let found = state.binding(root) ?? return
                    if found.without_mut == null {
                        let mut lend: String = "&mut "
                        if parts.len() == 1 && state.a_mut_parameter_place(world, base) != null {
                            lend = ""
                        }
                        state.facts.mut_view_reads.insert(id_of(value) as i64, lend)
                    } else {
                        state.a_changed_binding_says_mut(root, "a mutable view of the entry is taken here", span.clone())
                    }
                },
                else => {},
            }
        },
        else => {},
    }
}

/// **`let mut e = v[i]` over a `mut` list is a view of the element** (#959,
/// ADR-282 D7, Part I 6.5): the same view `let mut e = v[i] ?? continue` is,
/// written `&mut v[i]`. A struct is not a word by its kind, so a struct of
/// numbers is no copy either. A place the function may not change keeps the
/// copy it was.
fn check_core_stmt_mut_view_of_an_element(mut state: CheckState, world: ref CheckWorld, value: ref Expr, a_copy_type: bool) sync {
    match value {
        Expr::Index { base, .. } => {
            let path = dotted_path(world, base) ?? return
            let parts: Vec[ref String] = path.split(".").collect()
            let root = parts[0].clone()
            let found = state.binding(root) ?? return
            if found.without_mut == null {
                state.facts.mut_view_reads.insert(id_of(value) as i64, "")
            }
        },
        // The same for a field of a `mut` place (#962) that holds a struct
        // of numbers, which is no copy either; any other field is moved.
        Expr::Field { .. } => {
            if !a_copy_type {
                return
            }
            let path = dotted_path(world, value) ?? return
            let parts: Vec[ref String] = path.split(".").collect()
            let root = parts[0].clone()
            let found = state.binding(root) ?? return
            if found.without_mut == null {
                state.facts.mut_view_reads.insert(id_of(value) as i64, "")
            }
        },
        else => {},
    }
}

/// A name or a field, the values a `let` may see through.
fn check_core_stmt_a_name_or_field(value: ref Expr) -> bool sync {
    return match value {
        Expr::Variable(_, _) => true,
        Expr::Field { .. } => true,
        else => false,
    }
}

/// A list or an array of its own under a view of a run of its elements.
fn check_core_stmt_a_whole_run_viewed(found: ref Ty, want: ref Ty) -> bool sync {
    return match want {
        Ty::Pointed { item, slice, mutable } => slice && !mutable && !found.is_a_view() && match found {
            Ty::Named { name, args, .. } => (name == ARRAY || name == "Vec" || name == "List") && args.len() >= 1 && args[0].fits(item),
            else => false,
        },
        else => false,
    }
}

/// A call of a function or a method.
fn check_core_stmt_a_call(value: ref Expr) -> bool sync {
    return match value {
        Expr::Call { .. } => true,
        Expr::MethodCall { .. } => true,
        else => false,
    }
}

/// `x ?? d`.
fn check_core_stmt_a_choice(value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { .. } => true,
        else => false,
    }
}

/// A field or an index, the places a `let` is a view of. **Not off a call's
/// owned result** (#1191): `f().inner` reads a part of a value the call hands
/// over, which nothing else owns, so the `let` moves it out rather than
/// lending it.
fn check_core_stmt_a_place(state: ref CheckState, value: ref Expr) -> bool sync {
    return match value {
        Expr::Field { base, .. } => check_core_stmt_a_lent_root(state, base),
        Expr::Index { base, .. } => check_core_stmt_a_lent_root(state, base),
        else => false,
    }
}

/// What a field or an index chain is read off lends it, unless it is a call
/// whose result is handed over owned.
fn check_core_stmt_a_lent_root(state: ref CheckState, value: ref Expr) -> bool sync {
    return match value {
        Expr::Field { base, .. } => check_core_stmt_a_lent_root(state, base),
        Expr::Index { base, .. } => check_core_stmt_a_lent_root(state, base),
        Expr::Call { .. } => !state.flow.owned_call_bases.contains(id_of(value) as i64),
        Expr::MethodCall { .. } => !state.flow.owned_call_bases.contains(id_of(value) as i64),
        else => true,
    }
}

/// The place a value reads, as a message names it: `m[…]` for `m[k] ?? continue`,
/// `s.field`.
fn check_core_stmt_view_place(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> String? sync {
    match value {
        Expr::Coalesce { value: inner, .. } => return check_core_stmt_view_place(state, world, inner),
        Expr::Index { base, .. } => {
            let over = state.place_path(world, base) ?? return null
            return f"{over}[…]"
        },
        Expr::Field { .. } => return state.place_path(world, value),
        else => return null,
    }
}

/// A field path whose root is a parameter this function owns (#665).
fn check_core_stmt_a_part_of_an_owned_parameter(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Field { base, .. } => check_core_stmt_a_part_of_an_owned_parameter(state, world, base) || state.an_owned_parameter(world, base),
        else => false,
    }
}

/// A field path whose root is a `let` without `mut` that owns what it holds
/// (#1142), or the binding of a `for` over elements the loop owns (`drain()`,
/// a produced sequence; ADR-views-v4 D26): not a view of a place, not a `for`
/// binding over one, not a parameter.
fn check_core_stmt_a_part_of_an_unchanged_let(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Field { base, .. } => match base {
            Expr::Variable(symbol, _) => check_core_stmt_an_unchanged_owned_let(state, f"{world.words.resolve(symbol)}"),
            else => check_core_stmt_a_part_of_an_unchanged_let(state, world, base),
        },
        else => false,
    }
}

/// A name bound by a `let` or a `for` without `mut`, owning its value.
fn check_core_stmt_an_unchanged_owned_let(state: ref CheckState, name: ref String) -> bool sync {
    if state.lent_here(name) || state.got_past_a_jump.contains(name) {
        return false
    }
    let local: CheckLocal = state.binding(name) ?? return false
    let how: CheckImmutable = local.without_mut ?? return false
    return match how.kind {
        CheckKind::Let => true,
        CheckKind::Immutable => true,
        // The element of a walk that lends is a view (`lent_here` above).
        CheckKind::Loop => !local.lent,
        else => false,
    }
}

/// A bare name.
/// `x = x.replace(a, b)` (or `replacen`) where neither `a` nor `b` reads
/// `x` (ADR-text-reuse-1 D4).
fn check_core_stmt_replaces_itself(world: ref CheckWorld, target: ref Expr, value: ref Expr) -> bool sync {
    let named: String = match target {
        Expr::Variable(name, _) => world.words.resolve(name).clone(),
        else => return false,
    }
    return match value {
        Expr::MethodCall { receiver, method, args, .. } => {
            let by = world.words.resolve(method)
            let on_itself = match receiver {
                Expr::Variable(name, _) => world.words.resolve(name) == named,
                else => false,
            }
            if !(by == "replace" || by == "replacen") || !on_itself {
                return false
            }
            for arg in args {
                for each in visited_in_expr(arg) {
                    match each {
                        Expr::Variable(v, _) => {
                            if world.words.resolve(v) == named {
                                return false
                            }
                        },
                        else => {}
                    }
                }
            }
            true
        },
        else => false,
    }
}

fn check_core_stmt_a_name(value: ref Expr) -> bool sync {
    return match value {
        Expr::Variable(_, _) => true,
        else => false,
    }
}

/// Whether a `NK1116` was said since finding `from`.
fn check_core_stmt_overflowed_since(state: ref CheckState, from: i64) -> bool sync {
    let mut at = from
    while at < state.findings.len() as i64 {
        if state.findings[at].code == "NK1116" {
            return true
        }
        at += 1
    }
    return false
}

/// The text of a string literal, where the value is one.
fn check_core_stmt_literal(value: ref Expr) -> String? sync {
    return match value {
        Expr::LitStr { text, .. } => text.clone(),
        else => null,
    }
}

/// A `Vec` whose element type nobody knows.
fn check_core_stmt_an_unknown_list(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, args, .. } => name == "Vec" && args.len() == 1 && args[0].is_unknown(),
        else => false,
    }
}

/// How many lists stand around an element nothing typed: 1 for
/// `Vec[?]`, 2 for `Vec[Vec[?]]`, and 0 where the type is no such list
/// (#938).
fn check_core_stmt_unknown_list_levels(ty: ref Ty) -> i64 sync {
    return match ty {
        Ty::Named { name, args, .. } => {
            if name != "Vec" || args.len() != 1 {
                return 0
            }
            if args[0].is_unknown() {
                return 1
            }
            let inner = check_core_stmt_unknown_list_levels(args[0])
            if inner > 0 {
                return inner + 1
            }
            return 0
        },
        else => 0,
    }
}

/// **How many lists stand around the numbers of a list literal** whose every
/// item is a number at the same depth (#938): 1 for `[1, 2]`, 2 for
/// `[[1, 2], [3]]`; -1 for anything else, an empty list among them too.
fn check_core_stmt_number_lists(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> i64 sync {
    let items = match value {
        Expr::ListLit { items, .. } => items,
        else => return -1,
    }
    let mut depth = -1
    for item in items {
        let inner = match item {
            Expr::ListLit { .. } => check_core_stmt_number_lists(state, world, item),
            else => if state.number_shaped(world, item) { 0 } else { -1 },
        }
        if inner < 0 || (depth >= 0 && inner != depth) {
            return -1
        }
        depth = inner
    }
    if depth < 0 {
        return -1
    }
    return depth + 1
}

/// Each innermost number of a list of number lists is given to its open
/// number (#938).
fn check_core_stmt_give_lists(mut state: CheckState, world: ref CheckWorld, at: i64, value: ref Expr, span: ref Span) sync {
    match value {
        Expr::ListLit { items, .. } => {
            for item in items {
                check_core_stmt_give_lists(state, world, at, item, span)
            }
        },
        else => state.open_number_given(world, at, value, span),
    }
}

/// Which parts of a tuple's type nothing typed.
fn check_core_stmt_unknown_parts(tys: ref Vec[Ty]) -> Vec[bool] sync {
    let mut out: Vec[bool] = []
    for t in tys {
        out.push(t.is_unknown())
    }
    return out
}

/// A list's own type, `fs::Path`.
fn check_core_stmt_a_path(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, .. } => name == "fs::Path",
        else => false,
    }
}

/// A fresh open number at a `let` or a `for`.
fn check_core_stmt_open_number(name: ref String, element: bool, span: ref Span) -> CheckOpenNumber {
    return CheckOpenNumber { name: name.clone(), element: element, levels: if element { 1 } else { 0 }, at: Span { start: span.start, end: span.end }, joined: span.start as i64, asks: [], given: [], shifted: [], derived: [], written: [], casts: [], shifts: [], typed: false, sites: [] }
}

/// **A `let` whose declared type is a number and whose value is a `for`
/// binding** (ADR-182 D5), and everything else a refusal (ADR-185 D1).
fn check_core_stmt_a_number_read_through_a_lent_binding(mut state: CheckState, world: ref CheckWorld, want: ref Ty, value: ref Expr, span: ref Span) sync {
    let wanted: String = match want {
        Ty::Named { name, args, view } => {
            if view {
                return
            }
            if args.len() == 0 && (name == "i32" || name == "i64" || name == "u8" || name == "u32" || name == "u64" || name == "f32" || name == "f64" || name == "bool" || name == "char" || name == "scalar") {
                state.a_cast_over_a_lent_binding(world, value, span)
                return
            }
            name.clone()
        },
        else => {
            return
        },
    }
    let name: String = match value {
        Expr::Variable(bound, _) => f"{world.words.resolve(bound)}",
        else => {
            return
        },
    }
    let local: CheckLocal = state.binding(name) ?? return
    if !local.lent || state.number_shaped(world, value) {
        return
    }
    // **Unless the view is of a value that copies**: it is copied out
    // (ADR-387 D1).
    if state.facts.copied_views.contains(id_of(value) as i64) {
        return
    }
    state.a_copy_the_source_did_not_write(name, wanted, span)
}

/// **A value that may be wrapped into a nullable slot** (ADR-293 D3).
fn check_core_stmt_wraps_into_nullable[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, found: ref Ty, want: ref Ty, value: ref Expr, span: ref Span) sync {
    state.a_map_read_kept(world, found, want, value, span)
    let how = check_widened_slot(state, world, host, found, want, value, span)
    if how != null {
        let wrap = how ?? return
        state.facts.nullable_sites.insert(span.start as i64, wrap)
    }
}

/// A list, a map, a set, or a `struct` or an `enum` this unit declares.
fn check_core_stmt_has_no_arithmetic(world: ref CheckWorld, ty: ref Ty) -> bool sync {
    return is_a_collection_type(ty) || declared_with_no_arithmetic(world.here, ty) != null || is_a_text_position(ty)
}

/// A name nothing typed bound to `bound`.
fn check_core_stmt_lent_let(mut state: CheckState, world: ref CheckWorld, names: ref Vec[winnow_grammar::Symbol], span: ref Span) sync {
    state.facts.lent_lets.insert(span.start as i64)
    for n in names {
        let name: String = f"{world.words.resolve(n)}"
        let mut depth = state.scope.len() as i64 - 1
        if depth < 0 {
            depth = 0
        }
        state.lent_lets.insert((name, depth))
    }
}

/// **An element or a field read off a place, under a `let` that declares a
/// view of it** ([ADR-views-v4](../../../../docs/specification/adr/adr-views-v4.md) D5, #613):
/// 1 where the read is lent, 2 where it is a word by its kind and is copied
/// (`NK1257`), 0 where the rule has nothing to say.
fn check_core_stmt_element_view(state: ref CheckState, world: ref CheckWorld, value: ref Expr, found: ref Ty, want: ref Ty) -> i64 sync {
    if !check_core_stmt_a_place(state, value) {
        return 0
    }
    return check_core_stmt_read_viewed(state, world, found, want)
}

/// **A parameter the function lends, put into a literal whose parts the `let`
/// declares views, is the view** (ADR-282 D2, #2346): `name: String` says what
/// `name: ref String` says, so `[(10, name, 3)]` under `Array[(u32, ref
/// String, u32), 1]` holds the view the parameter already is. The literal's
/// type with those parts as declared, or null where a part is not such a
/// parameter: text built in the function stays its own, and `NK1103`'s.
fn check_core_stmt_lent_parts_viewed(state: ref CheckState, world: ref CheckWorld, value: ref Expr, found: ref Ty, want: ref Ty) -> Ty? sync {
    match value {
        Expr::Variable(_, _) => {
            if !state.a_lent_parameter(world, value) && !state.an_either_parameter(world, value) {
                return null
            }
            if check_core_stmt_read_viewed(state, world, found, want) != 1 {
                return null
            }
            return want.clone()
        },
        Expr::Tuple(given, _) => {
            let found_parts: Vec[Ty] = match found {
                Ty::Tuple(parts) => parts.clone(),
                else => return null,
            }
            let wanted: Vec[Ty] = match want {
                Ty::Tuple(parts) => parts.clone(),
                else => return null,
            }
            if given.len() != found_parts.len() || given.len() != wanted.len() {
                return null
            }
            let mut parts: Vec[Ty] = []
            let mut any = false
            for (k, part) in given.iter().enumerate() {
                let viewed = check_core_stmt_lent_parts_viewed(state, world, part, found_parts[k], wanted[k])
                if viewed != null {
                    any = true
                }
                parts.push(viewed ?? found_parts[k].clone())
            }
            if !any {
                return null
            }
            return Ty::Tuple(parts)
        },
        Expr::ListLit { items, .. } => {
            let (name, args, view) = match found {
                Ty::Named { name, args, view } => (name.clone(), args.clone(), view),
                else => return null,
            }
            let wanted_item: Ty = match want {
                Ty::Named { args, .. } => args.first()?.clone() ?? return null,
                else => return null,
            }
            let found_item: Ty = args.first()?.clone() ?? return null
            if items.len() == 0 {
                return null
            }
            let mut item: Ty = found_item.clone()
            for given in items {
                item = check_core_stmt_lent_parts_viewed(state, world, given, found_item, wanted_item) ?? return null
            }
            let mut out: Vec[Ty] = [item]
            for (k, arg) in args.iter().enumerate() {
                if k > 0 {
                    out.push(arg.clone())
                }
            }
            return Ty::Named { name: name, args: out, view: view }
        },
        else => return null,
    }
}

/// **The same rule for what a read is, wherever it was read**: an element
/// read off a place, or one unwrapped past a jump (`m[k] ?? return null`,
/// #1107), under a type that declares a view of it. 1 lent, 2 a word by its
/// kind (`NK1257`), 0 where the rule has nothing to say.
fn check_core_stmt_read_viewed(state: ref CheckState, world: ref CheckWorld, found: ref Ty, want: ref Ty) -> i64 sync {
    if found.is_a_view() {
        return 0
    }
    let inner = match want {
        Ty::Nullable(held) => held.clone(),
        else => want.clone(),
    }
    let is_view = match inner {
        Ty::Named { view, .. } => view,
        else => false,
    }
    let read = found.unseen()
    if !is_view || !read.fits(inner.owned()) {
        return 0
    }
    if state.a_word_by_its_kind(world, read) {
        return 2
    }
    return 1
}

/// A field path or an index read as written, for a help: `given[0]`,
/// `p.a`, `xs[i]`; `…` where it is anything else.
/// **`let mut rest = line[m..]`, with `rest` grown, gives `rest` the text of
/// `line`** (ADR-text-reuse-1 D2, D3, #1589): text `line` owns is handed
/// over, cut down in its own buffer, so a later read of `line` is `NK2105`'s;
/// text `line` only views (a literal) is copied; and a `line` only lent here
/// is not ours to give (`NK2106`), so the help asks for a copy or for `keep`.
fn check_core_stmt_given_cut(mut state: CheckState, world: ref CheckWorld, name: ref String, value: ref Expr, span: ref Span) sync {
    let source = given_cut_source(value, world.words) ?? return
    state.facts.given_cuts.insert(node_key(value))
    let held = state.binding(source) ?? return
    let shown = match value {
        Expr::Index { index, .. } => f"{source}[{check_core_stmt_key_shown(world, index)}]",
        Expr::MethodCall { method, .. } => f"{source}.{world.words.resolve(method)}()",
        else => source.clone(),
    }
    let to = f"given to `{name}`, which changes it"
    if held.lent || state.a_lent_let(world, check_core_stmt_given_source(value) ?? return) {
        state.findings.push(check_refusal("NK2106", span, f"`{shown}` is {to}, but `{source}` is only borrowed here.", [f"`{source}` belongs to whoever lent it (a parameter without `keep`, a `for` over a list, a `let` over a place): a cut that changes takes its text, which is not yours to give (ADR-text-reuse-1 D3).", "Nikaia never makes a copy behind your back."], f"Hand over a copy: `{shown}.clone()`; or, where `{source}` is a parameter, take it as `keep {source}`."))
        return
    }
    if held.ty.is_a_view() {
        return
    }
    state.facts.cut_gives.insert(node_key(value))
    state.hands_over_name(world, source, to, span)
}

/// The name a cut is cut from, as the expression it is.
fn check_core_stmt_given_source(value: ref Expr) -> ref Expr? {
    return match value {
        Expr::Index { base, .. } => base,
        Expr::MethodCall { receiver, .. } => receiver,
        else => null,
    }
}

fn check_core_stmt_read_shown(world: ref CheckWorld, value: ref Expr) -> String sync {
    return match value {
        Expr::Index { base, index, .. } => {
            let held = dotted_path(world, base) ?? return "…"
            f"{held}[{check_core_stmt_key_shown(world, index)}]"
        }
        else => dotted_path(world, value) ?? "…",
    }
}

// A key or a position as the message writes it: a name, a whole number.
fn check_core_stmt_key_shown(world: ref CheckWorld, key: ref Expr) -> String sync {
    return match key {
        Expr::Variable(name, _) => world.words.resolve(name).clone(),
        Expr::LitInt { value, negative, .. } => if negative { f"-{value}" } else { f"{value}" },
        else => "…",
    }
}

/// **An element a list or a map keeps, read past a jump** (#1044):
/// `path.last() ?? return`, `path.get(i) ?? continue`, `m[k] ?? break`. The
/// read as written (`path.last()`), which is what the name is a view of;
/// `null` for any other value.
fn check_core_stmt_element_read(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> String? sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => {
            if !state.jumps(world, fallback) {
                return null
            }
            match read {
                Expr::MethodCall { receiver, method, args, .. } => {
                    let held = dotted_path(world, receiver) ?? return null
                    let key = state.facts.method_callees.get(id_of(receiver) as i64) ?? return null
                    let name = world.words.resolve(method).clone()
                    let a_list_end = (key == "Vec::first" || key == "Vec::last") && args.len() == 0
                    let a_get = key == "Vec::get" || key == "BTreeMap::get" || key == "HashMap::get" || key == "collections::BTreeMap::get" || key == "collections::HashMap::get"
                    if a_list_end {
                        f"{held}.{name}()"
                    } else if a_get && args.len() == 1 {
                        f"{held}.{name}({check_core_stmt_key_shown(world, args[0])})"
                    } else {
                        null
                    }
                }
                Expr::Index { base, index, .. } => {
                    let held = dotted_path(world, base) ?? return null
                    // A map's, which `??` past a jump records (ADR-293 D28).
                    if state.facts.map_read_views.contains(id_of(value) as i64) { f"{held}[{check_core_stmt_key_shown(world, index)}]" } else { null }
                }
                else => null,
            }
        }
        else => null,
    }
}

/// **An element read past a jump, whatever it holds** (#1107): `m[k] ??
/// return`, `xs.get(i) ?? continue`, `path.last() ?? break` over a place.
/// What the element is (a view of it or a copy) is the caller's question.
fn check_core_stmt_an_element_past_a_jump(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Coalesce { value: read, fallback, .. } => state.jumps(world, fallback) && check_core_stmt_an_element_read(state, world, read),
        else => false,
    }
}

/// `m[k]`, `xs.get(i)`, `xs.first()`, `xs.last()` over a place.
fn check_core_stmt_an_element_read(state: ref CheckState, world: ref CheckWorld, read: ref Expr) -> bool sync {
    return match read {
        Expr::Index { base, .. } => dotted_path(world, base) != null,
        Expr::MethodCall { receiver, args, .. } => {
            if dotted_path(world, receiver) == null {
                return false
            }
            let key = state.facts.method_callees.get(id_of(receiver) as i64) ?? return false
            ((key == "Vec::first" || key == "Vec::last") && args.len() == 0) || ((key == "Vec::get" || key == "BTreeMap::get" || key == "HashMap::get" || key == "collections::BTreeMap::get" || key == "collections::HashMap::get") && args.len() == 1)
        }
        else => false,
    }
}

/// A struct of the program, which a read lends (ADR-279 D8) and which is the
/// reference below already. One that copies is a view too: where a `C` is
/// wanted, the view is copied out (ADR-387 D1, #1107). **A struct another
/// file of the package declares is one too** (ADR-286 D1, #1183): each file
/// answers alike, so `m[k] ?? return null` handed back as a `ref C` is not
/// owned because `C` is declared one file over.
fn check_core_stmt_a_lent_struct(state: ref CheckState, ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, args, view } => !view && args.len() == 0 && (state.structs.contains_key(name) || (state.parts_beside.contains_key(name) && !state.enums.contains_key(name))),
        else => false,
    }
}

/// **`let`** (Part I 2.1).
// A value that is code where it is written: a lambda, or a name.
fn check_core_stmt_code_given(value: ref Expr) -> bool {
    match value {
        Expr::Closure { .. } => return true,
        Expr::Variable(_, _) => return true,
        Expr::ListLit { .. } => return true,
        Expr::ListRepeat { .. } => return true,
        Expr::If { .. } => return true,
        Expr::Match { .. } => return true,
        else => return false,
    }
}

/// Whether a value is code, or a list or map of it (ADR-351 D1).
fn check_core_stmt_holds_code(ty: ref Ty) -> bool {
    match ty {
        Ty::Fn { .. } => return true,
        Ty::Named { args, .. } => {
            for arg in args {
                if check_core_stmt_holds_code(arg) {
                    return true
                }
            }
            return false
        },
        else => return false,
    }
}

fn check_core_stmt_let[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, names: ref Vec[winnow_grammar::Symbol], shape: ref Vec[i64], mutable: bool, mut_names: ref Vec[bool], deep: bool, ty: ref Type?, value: ref Expr, span: ref Span) -> Ty sync {
    let by_use: Ty? = state.flow.let_lambda_use?.clone()
    state.flow.let_lambda_use = null
    let typed_by_use = ty == null && by_use != null
    check_core_a_field_of_a_borrowed_subject(state, world, host, value, span, "bound")
    check_core_a_mut_parameter_given_away(state, world, host, value, span, "bound")
    let outer_read = state.flow.read_a_map
    state.flow.read_a_map = false
    state.flow.reaching = check_core_stmt_reaching(world, ty)
    if ty != null && (check_core_stmt_expects_a_lambda(value) || check_simd_a_call(world, value)) {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        state.flow.lambda_expected = written_ty(world.words, world.here.aliases, t)
    }
    // **A lambda bound without a type takes the one of its first use** (#997).
    if typed_by_use {
        let want: Ty = by_use ?? Ty::Unknown
        match want {
            Ty::Fn { params, is_sync, .. } => {
                state.facts.lambda_params_by_use.insert(id_of(value) as i64, params.clone())
                // A use that may pause runs it as the language below's
                // `async` closure, as the same lambda written into the
                // call is (#1046).
                if !is_sync {
                    state.facts.run_lambdas.insert(id_of(value) as i64)
                }
            },
            else => {}
        }
        state.flow.lambda_expected = want
    }
    // Such a lambda is code run in place, as a parameter that is (#997);
    // another `let` of the name is not.
    if names.len() == 1 {
        let bound: String = world.words.resolve(names[0]).clone()
        if typed_by_use {
            state.run_code.insert(bound)
        } else {
            let removed = state.run_code.remove(bound)
        }
    }
    // **A name bound to a function value is a place of the error-set
    // calculation** (ADR-351 D1): what it is given is what a call through it
    // reaches.
    let code_place = names.len() == 1 && state.current != null && check_core_stmt_code_given(value)
    if code_place {
        state.stored_frames.push(CheckStoredCode::empty())
    }
    let findings_before = state.findings.len() as i64
    state.flow.lending_let = !mutable
    let found = check_core_expr(state, world, host, value, span)
    state.flow.lending_let = false
    state.flow.lambda_expected = null
    // **A declared function bound without a type** (#582): called through
    // the name with its parameters by value, as a parameter of function type
    // is (#757).
    if ty == null && names.len() == 1 && check_core_args_named(state, world, value) {
        match found {
            Ty::Fn { .. } => state.facts.named_fn_values.insert(id_of(value) as i64, []),
            else => {}
        }
    }
    // **A call's whole-number result is a number of the bounds walk**
    // (#781): `let at = self.slot_of(…)` is bounded by what is assumed of
    // `at`, as a name bound to a sum is. So is a whole number out of a
    // choice, `let n = text::parse_i64(s) ?? 1` (#1571): what a guard says
    // of `n` is kept.
    if names.len() == 1 && (check_core_stmt_a_call(value) || check_core_stmt_a_choice(value)) {
        match found {
            Ty::Named { name, args, .. } => {
                if args.is_empty() && is_whole_number(name) {
                    state.facts.whole_fields.insert(id_of(value) as i64)
                }
            },
            else => {}
        }
    }
    // **A whole number bound without a type is one to the prover** (#1358):
    // `let n = text::parse_i64(s) ?? 0` is read as `let n: i64 = …` is. So
    // is a list, a text or a map (ADR-396 D4): `let parts = s.split("/")
    // .collect()` has a length, and `m[k]` of a map is no list index.
    if ty == null && names.len() == 1 && shape.len() == 0 {
        match found {
            Ty::Named { name, args, view } => {
                // **A call's result of a type of fields** (supervisor
                // decision, 2026-11-12, for ADR-396 D4): its field paths are
                // names of the prover, as a parameter's are.
                let whole = args.is_empty() && !view && is_whole_number(name)
                let fields = args.is_empty() && check_core_stmt_a_call(value)
                if whole || has_a_length(name) || a_map_type(name) || fields {
                    state.facts.whole_lets.insert(span.start as i64, name.clone())
                }
            },
            else => {}
        }
    }
    // **A map's read past a jump, bound to a declared type that owns its
    // value** (ADR-293 D15): refused or copied out as an assignment's is.
    if ty != null && names.len() == 1 && shape.len() == 0 {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        let declared = written_ty(world.words, world.here.aliases, t)
        state.a_map_read_assigned(world, declared, value, span)
    }
    // A lambda is code whatever type it was given here: one bound without
    // a type that no call hands on is not `Ty::Fn` yet, and what its body
    // calls is still what a field it is put into reaches (#1045).
    let a_lambda = match value {
        Expr::Closure { .. } => true,
        else => false,
    }
    if code_place && !a_lambda && !check_core_stmt_holds_code(found) {
        state.stored_frames.pop()
    } else if code_place {
        let current: String = state.current?.clone() ?? ""
        let key = f"{current}::{world.words.resolve(names[0])}"
        check_core_places_stored(state, world, host, value, key)
    }
    state.a_narrowed_read_given_up(value)
    // **A name bound to a map read is a view of the map** (#297).
    let was_read = state.flow.read_a_map
    state.flow.read_a_map = outer_read
    let of_a_map = was_read && check_core_stmt_a_map_read(value)
    let element_read = check_core_stmt_element_read(state, world, value)
    // **A value `get` hands back past a jump is a reference** (D30).
    let got = check_core_stmt_got(state, world, value)
    let got_by_a_match = !got && check_core_stmt_got_by_a_match(state, world, value)
    for n in names {
        let name: String = f"{world.words.resolve(n)}"
        if got || got_by_a_match {
            state.got_past_a_jump.insert(name)
        } else {
            state.got_past_a_jump.remove(name)
        }
    }
    // **A value with a cleanup, bound here, dies where this block ends**
    // (ADR-297 D2).
    if names.len() == 1 {
        let single: String = f"{world.words.resolve(names[0])}"
        check_crossings_a_value_with_a_cleanup_bound(state, world, single, found, span)
    }
    // **`let t = s` is a rename, and a rename moves** (ADR-094 D4, ADR-293
    // D29), except `let _ = s`.
    let mut bound_names: Vec[String] = []
    for n in names {
        bound_names.push(f"{world.words.resolve(n)}")
    }
    let mut any_named = false
    for n in bound_names {
        if n != "_" {
            any_named = true
        }
    }
    // **A container a `let` declares a view of what it holds is lent** (#452).
    let mut seen_through = false
    if check_core_stmt_a_name_or_field(value) && ty != null {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        let want = written_ty(world.words, world.here.aliases, t)
        seen_through = !found.fits(want) && state.fits_through_deref(world, found, want)
        // **A whole list or array under a `let` declared a view of a run is
        // lent** (ADR-views-v4 D11, #1362): `let c: Array[T] = v` cannot own,
        // having no length, so it looks at what `v` holds and `v` stays.
        seen_through = seen_through || check_core_stmt_a_whole_run_viewed(found, want)
    }
    // **An element or a field read off a place under a `ref T` is a view of
    // it** (ADR-views-v4 D5, #613).
    let mut element_view = 0
    if names.len() == 1 && ty != null {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        let want = written_ty(world.words, world.here.aliases, t)
        element_view = check_core_stmt_element_view(state, world, value, found, want)
        // **An element unwrapped past a jump is the same element** (#1107,
        // ADR-282 D7): `let c: ref C = m[k] ?? return null` lends it.
        if element_view == 0 && check_core_stmt_an_element_past_a_jump(state, world, value) {
            // The read past the jump is the reference already below, so the
            // `let` itself is not lent (3), a word by its kind is `NK1257` (2).
            let viewed = check_core_stmt_read_viewed(state, world, found, want)
            element_view = if viewed == 1 { 3 } else { viewed }
        }
        if element_view == 0 && state.lend_choice_beside_null(world, value, want) {
            // The arms are lent one by one; the `let` itself is not.
            element_view = 3
        }
    }
    // **A name bound to `s.bytes` is the view** (ADR-320 D11): nothing is
    // handed over, and the name is copied where it is kept. A `let mut` keeps
    // it, so it is copied there.
    let bytes_view = !mutable && names.len() == 1 && shape.len() == 0 && state.a_text_bytes_view(world, value)
    let mut moved_out = false
    let mut handing_refused = false
    if seen_through || element_view == 1 {
        check_core_stmt_lent_let(state, world, names, span)
    } else if any_named && !bytes_view && !(ty == null && !mutable && names.len() == 1 && shape.len() == 0 && state.a_lent_text_place(world, value, found)) {
        // A plain `let` over a `String` read through a `ref` parameter is a
        // view of it (Part I 6.5, #839), bound so below.
        let to = f"bound to `{bound_names.join("`, `")}` by a `let`"
        let before = state.findings.len()
        state.hands_over(world, value, found, to, span)
        // **A `let mut` over a part of a `let` the function may not change
        // takes the part** (#1142): no change could reach the place through
        // it, so it is no view (ADR-094 D4), and it moves, as a part of an
        // owned parameter does (#665).
        let owned_root = check_core_stmt_a_part_of_an_owned_parameter(state, world, value) || (mutable && check_core_stmt_a_part_of_an_unchanged_let(state, world, value))
        moved_out = a_name_or_a_field(value) && owned_root && state.findings.len() == before
        handing_refused = state.findings.len() > before
        check_core_places_give_handle(state, world, value, found, span)
    }
    // **And a `let` gives the name a value again**, as an assignment does.
    for n in bound_names {
        if n != "_" {
            state.written_at.push((n.clone(), span.start as i64))
        }
    }
    // **A `let` that may hold a view of names keeps their clone needed** (`NK1350`).
    state.a_let_that_may_lend(world, bound_names, value, found)
    // **A list's element past a jump is a view of it**: `let it = v.get(i) ??
    // return` binds what the list holds, as `let it = v[i]` does.
    if !mutable && ty == null && check_core_stmt_a_lent_list_read(state, world, value) {
        check_core_stmt_lent_let(state, world, names, span)
    }
    // **A `let` over a place is a view of it** (ADR-094 D4).
    // **Moved out of its owner, it is no view** (#665): the name owns what it holds.
    if !moved_out && check_core_stmt_a_place(state, value) && state.takes_away(world, found) && !state.facts.text_bytes.contains(node_key(value)) {
        check_core_stmt_lent_let(state, world, names, span)
    }
    // **The place a `let mut` is a view of**, for the messages that name it
    // (ADR-views-v4 D18).
    if mutable && names.len() == 1 && shape.len() == 0 {
        let place = check_core_stmt_view_place(state, world, value)
        if place != null {
            let mut depth = state.scope.len() as i64 - 1
            if depth < 0 {
                depth = 0
            }
            state.view_places.insert((bound_names[0].clone(), depth), (place ?? "").clone())
        }
    }
    // **A tuple of names takes the value apart** (ADR-291).
    if names.len() >= 2 || shape.len() > 0 {
        return state.tuple_let(world, names, shape, mutable, mut_names, ty != null, found, value, span)
    }
    let name: String = f"{world.words.resolve(names[0])}"
    // **`let _ = expr` is a statement wearing a `let`** (ADR-291 D7).
    if name == "_" {
        state.a_let_that_binds_nothing(span)
    }
    state.nameable(name, span, "a `let`")
    let mut bound = Ty::Unknown
    if ty != null {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        let want = check_walked_declared(state, world, t, span)
        check_reflected_field_kept(state, world, t, span, false)
        // **The annotation is no longer the constructor** (ADR-281 D2).
        state.constant_fits(world, value, want, span)
        check_core_stmt_wraps_into_nullable(state, world, host, found, want, value, span)
        // **The annotation is a use, and a use answers the literal** (ADR-152 D4).
        let by_use = check_core_literal_by_use(state, world, host, found, want, value, span)
        let found_used: Ty = by_use ?? found.clone()
        let widened = state.widened_elements(world, found_used, want, value, span)
        let mut found_kept: Ty = widened ?? found_used.clone()
        if element_view == 1 || element_view == 3 {
            found_kept = want.clone()
        } else if element_view == 2 {
            // **A word is copied at a read, so there is no view of it to
            // declare** (ADR-views-v4 D4).
            let shown = found.unseen().text()
            let written = check_core_stmt_read_shown(world, value)
            state.findings.push(check_refusal("NK1257", span, f"A `{shown}` read out of a place is a copy, so it can't be bound as a `ref {shown}`.", ["A number, a `bool`, a `scalar` and an enum whose variants hold nothing are copied at a read (ADR-279 D8); there is no view of them to keep."], f"an `{shown}` is copied at a read; write `let {name} = {written}`."))
            found_kept = want.clone()
        } else if element_view == 0 {
            let viewed = check_core_stmt_lent_parts_viewed(state, world, value, found_kept, want)
            if viewed != null {
                found_kept = viewed ?? want.clone()
            }
        }
        // **A declared function that lends a parameter fits a function type
        // that lends it** (ADR-views-v4 D2, D14, #1254): `let k: fn(s: String)
        // -> i64 = count` with `count(s: String)`, as an argument does.
        if state.lends_where_a_function_type_reads(world, value, found_kept, want) {
            found_kept = want.clone()
        }
        state.expect_kept_asked(world, found_kept, want, value, "the `let` declares a `String`, which is text of its own", span, "let", fn(was, wanted) { f"This value is `{was}`, but the `let` declares `{wanted}`." })
        check_core_stmt_a_number_read_through_a_lent_binding(state, world, want, value, span)
        bound = want
    } else if mutable && state.flow.mixed_text.contains(name) && found.is_a_view() && check_core_stmt_literal(value) != null {
        // **A `let mut` of a literal that is later given views and text of its
        // own holds `EitherText`** (ADR-282 D13, D14, #840): the literal is
        // wrapped as the assigned values are.
        state.facts.mixed_leaves.insert(node_key(check_peeled(value)), false)
        bound = found.clone()
    } else if mutable && names.len() == 1 && shape.len() == 0 && state.flow.grown_text.contains(name) && found.is_a_view() && given_cut_source(value, world.words) != null {
        // **A cut a `let mut` grows is given its source's text**
        // (ADR-text-reuse-1 D2, D3, #1589): it changes that text from here on.
        check_core_stmt_given_cut(state, world, name, value, span)
        bound = check_core_method_named("String")
    } else if mutable && state.flow.grown_text.contains(name) && found.is_a_view() && state.text_literal(world, check_core_method_named("String"), value, true) != null {
        // **A `let mut` of a literal that the body later grows holds text of
        // its own** (0.0.232).
        bound = check_core_method_named("String")
    } else {
        // **A number nothing typed is open** (ADR-285 D1).
        if !(found.is_unknown() && state.number_shaped(world, value)) {
            state.constant_fits(world, value, null, span)
        }
        if found.is_unknown() {
            let met = state.views_meet_owned_text(world, value)
            bound = met ?? found.clone()
        } else if found == a_string_type() {
            let lent = state.lent_arms_bound(world, value)
            let none_lent = lent == null
            bound = lent ?? found.clone()
            // **A plain `let` over a `String` place of a local is a view of
            // it** (ADR-views-v4 D5, #1404), as one read through a `ref`
            // parameter is (#839): the emitter lends it (`lent_lets`), so a
            // keeper handed it is refused here with a `.clone()` help instead
            // of by the language below.
            if none_lent && !mutable && !moved_out && names.len() == 1 && shape.len() == 0 && check_core_stmt_a_place(state, value) && state.facts.lent_lets.contains(span.start as i64) {
                bound = Ty::Named { name: TEXT_VIEW.clone(), args: [], view: true }
            }
        } else {
            bound = found.clone()
            // **And so is one over a place of any type that moves** (#1997): a
            // struct, an enum or a list read off a local is lent as the text
            // is, so it is typed the view the emitter writes.
            // Where handing it over was refused already (`NK2106`), that one
            // refusal stands.
            if !mutable && !moved_out && !handing_refused && names.len() == 1 && shape.len() == 0 && check_core_stmt_a_place(state, value) && state.facts.lent_lets.contains(span.start as i64) && state.takes_away(world, found) {
                match found {
                    Ty::Named { name: n, args: a, view: v } => {
                        if !v {
                            bound = Ty::Named { name: n.clone(), args: a.clone(), view: true }
                        }
                    },
                    else => {},
                }
            }
        }
        // **A `let` of a map's read of views binds the view itself** (#996):
        // the read is a view of what the map holds, copied out.
        if state.flow.view_reads.contains(id_of(value) as i64) {
            let viewed = state.facts.copied_reads.insert(id_of(value) as i64)
        }
    }
    // **A proved name bound whole by a `let` that owns its value is given
    // up** (ADR-382, #888), as one handed back by `return` is: the arm of
    // `let s: String = if b != null { b } else { … }` is `b.unwrap()`. A
    // view-typed `let` keeps its view.
    if element_view == 0 && !seen_through && !bytes_view && check_core_stmt_owns_whole(bound) {
        state.narrowed_reads_given_back(value)
    }
    let mut open: i64? = null
    if ty == null && bound.is_unknown() && state.number_shaped(world, value) {
        state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(name, false, span))
        state.open_number_given(world, span.start as i64, value, span)
        open = span.start as i64
    }
    // **A list written in numbers has one open number for its elements**
    // (ADR-285 D34).
    let mut element_at: i64? = null
    let mut element_constants: Vec[CheckConstant]? = null
    // **So has a list of number lists, for its innermost elements, and an
    // element of it for its own** (#938): `grid = [[1, 2], [3]]` holds one
    // number two lists in, `row = grid[0]` the same number one list in.
    let mut element_levels = 1
    let list_levels = check_core_stmt_unknown_list_levels(bound)
    if ty == null && list_levels > 0 {
        match value {
            Expr::ListLit { .. } => {
                if list_levels >= 2 && check_core_stmt_number_lists(state, world, value) == list_levels {
                    let mut entry = check_core_stmt_open_number(name, true, span)
                    entry.levels = list_levels
                    state.flow.open_numbers.insert(span.start as i64, entry)
                    check_core_stmt_give_lists(state, world, span.start as i64, value, span)
                    element_at = span.start as i64
                    element_levels = list_levels
                }
            },
            Expr::Index { .. } => {
                let list = state.open_list_of(world, value)
                if list != null {
                    let found = list ?? (0, 0)
                    if found.1 == list_levels {
                        element_at = found.0
                        element_levels = found.1
                    }
                }
            },
            else => {},
        }
    }
    if ty == null && check_core_stmt_an_unknown_list(bound) {
        match value {
            Expr::ListLit { items, .. } => {
                let mut all_numbers = items.len() > 0
                for item in items {
                    if all_numbers && !state.number_shaped(world, item) {
                        all_numbers = false
                    }
                }
                if all_numbers {
                    state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(name, true, span))
                    for item in items {
                        state.open_number_given(world, span.start as i64, item, span)
                    }
                    if !mutable {
                        let mut constants: Vec[CheckConstant] = []
                        let mut every = true
                        for item in items {
                            if every {
                                let c = state.constant_of(world, item)
                                if c == null {
                                    every = false
                                } else {
                                    constants.push(c ?? continue)
                                }
                            }
                        }
                        if every {
                            element_constants = constants
                        }
                    }
                    element_at = span.start as i64
                }
            },
            // **So has `[v; n]` whose `v` is a number** (ADR-362 D1).
            Expr::ListRepeat { value: item, .. } => {
                if state.number_shaped(world, item) {
                    state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(name, true, span))
                    state.open_number_given(world, span.start as i64, item, span)
                    element_at = span.start as i64
                }
            },
            else => {},
        }
    }
    // **A tuple written in numbers has one open number for each part**
    // (ADR-286 D41, #837): a part is typed by its uses, as a lone literal is.
    let mut part_opens: Vec[i64] = []
    if ty == null {
        match value {
            Expr::Tuple(parts, _) => {
                let unknowns: Vec[bool] = match bound {
                    Ty::Tuple(tys) => check_core_stmt_unknown_parts(tys),
                    else => [],
                }
                let mut i = 0
                let mut any = false
                for part in parts {
                    let mut at: i64 = -1
                    if i < unknowns.len() && unknowns[i] && state.number_shaped(world, part) {
                        at = span.start as i64 + i + 1
                        let named = f"{name}.{i}"
                        state.flow.open_numbers.insert(at, check_core_stmt_open_number(named, false, Span { start: span.start + i as u32 + 1, end: span.end }))
                        state.open_number_given(world, at, part, span)
                        any = true
                    }
                    part_opens.push(at)
                    i += 1
                }
                if !any {
                    part_opens = []
                }
            },
            else => {},
        }
    }
    // **An empty list has no element type, and D2 says where one comes
    // from** (ADR-135).
    let mut pending: i64? = null
    if ty == null {
        match value {
            Expr::ListLit { items, .. } => {
                if items.len() == 0 {
                    state.flow.empty_lists.insert(span.start as i64, (name.clone(), Span { start: span.start, end: span.end }))
                    pending = span.start as i64
                }
            },
            // **A map made without its types** is asked as an empty list is
            // (ADR-285 D43).
            Expr::Call { args, .. } => {
                if args.len() == 0 && names.len() == 1 && shape.len() == 0 && check_core_stmt_an_untyped_map(bound) {
                    state.flow.empty_lists.insert(span.start as i64, (name.clone(), Span { start: span.start, end: span.end }))
                    state.flow.empty_maps.insert(span.start as i64)
                    pending = span.start as i64
                }
            },
            else => {},
        }
    }
    // **Only an immutable `let` carries its value forward** (Part III, C.4);
    // a `let mut`'s is followed through straight-line code.
    let mut constant: Integer? = null
    let mut followed: Integer? = null
    let c = state.constant_of(world, value)
    // **A constant that overflowed is said once, where it was written**
    // (#662): the binding carries no value forward to be refused again. Nor
    // does a shift of literals beside a type: it is that type's, and its
    // exact value is not the one the binding holds (ADR-285 D40).
    let typed_shift = ty != null && (shifts_literals(value) || state.an_open_shift_in(world, value))
    if c != null && !typed_shift && !check_core_stmt_overflowed_since(state, findings_before) {
        let held: CheckConstant = c ?? return check_core_stmt_unit()
        if !mutable {
            constant = held.value
        } else if !held.beyond {
            followed = held.value
        }
    }
    // **What a task binds for itself** (ADR-055 D6).
    let tasks = state.task_bindings.len()
    if tasks > 0 {
        state.task_bindings[tasks - 1].push((name.clone(), bound.clone(), span.start as i64))
    }
    let id = state.a_new_binding()
    if state.facts.cut_gives.contains(node_key(value)) {
        state.facts.given_names.insert(id)
    }
    if ty == null && names.len() == 1 && shape.len() == 0 && check_core_stmt_expects_a_lambda(value) {
        match value {
            Expr::Closure { .. } => state.facts.let_lambdas.insert(id, value.clone()),
            else => {},
        }
        // **A `let` keeps its lambda** (Part I 5.4 C, #2047), so a change it
        // makes to a binding from outside reaches only its own copy.
        let changed: String? = state.flow.lambda_outer_changes.remove(id_of(value) as i64)
        if changed != null {
            state.a_kept_lambda_changes_a_capture(changed ?? "", check_span_at(world, value, span))
        }
    }
    if bytes_view {
        state.text_bytes_lets.insert(id)
        // **A `let` that declares `Bytes` holds the view too** (ADR-views-v4
        // D15, #1271): `let b: Bytes = s.bytes` is written without its
        // annotation, as `let b = s.bytes` is.
        if ty != null {
            state.facts.text_bytes_typed_lets.insert(span.start as i64)
        }
    }
    // **A position a text handed out keeps where it came from** (ADR-320 D5).
    if !mutable && names.len() == 1 && shape.len() == 0 {
        let position = check_core_places_text_position(state, world, value)
        if position != null {
            state.text_positions.insert(id, position ?? CheckTextPosition { text: "", step: -1 })
        }
    }
    // **A position, or a match, keeps the text it belongs to** (ADR-374 D5).
    if names.len() == 1 && shape.len() == 0 {
        let held: CheckPosText? = check_pos_text_of(state, world, value)
        if held != null {
            state.facts.pos_texts.insert(id, held ?? return check_core_stmt_unit())
        }
    }
    // **A `'…'` nothing typed is typed by its uses** (ADR-320 D8, as a
    // number is, ADR-285 D23): a `u8` where they ask one.
    if ty == null && !mutable {
        match value {
            Expr::LitChar(written, _) => {
                if literal_is_a_byte(written) {
                    let literal = id_of(value) as i64
                    state.flow.high_bytes.remove(literal)
                    state.flow.open_chars.insert(id, CheckOpenChar { name: name.clone(), written: written.clone(), literal: literal, at: span.clone(), reads: collections::BTreeMap(), bytes: collections::BTreeSet() })
                }
            },
            else => {},
        }
    }
    if followed != null {
        state.flow.followed.insert(id, followed ?? return check_core_stmt_unit())
    }
    if part_opens.len() > 0 {
        state.flow.open_parts.insert(id, part_opens)
    }
    if element_at != null {
        state.flow.open_elements.insert(id, element_at ?? 0)
        if element_levels > 1 {
            state.flow.open_levels.insert(id, element_levels)
        }
        if element_constants != null {
            state.flow.list_constants.insert(id, element_constants ?? [])
        }
    }
    // **And typed as one**: a `V?` read out of a map is an option of a view.
    // **Unless a word by its kind is copied out of it** (ADR-279 D8, #1460):
    // `let k: K? = m.get(1)` holds the `K`, as a number's read holds it.
    // **So does a tuple copied out** (#1535): `let t: (i64, i64)? = m.get(k)`
    // holds the tuple, which has no view to be typed as.
    // **And an untyped `let` of a tuple whose parts copy** (#1539): `let t =
    // m.get(k)` holds the tuple, as the inline `m.get(k) ?? (0, 0)` does.
    if of_a_map && ty == null {
        match bound {
            Ty::Nullable(inner) => {
                if check_core_stmt_a_tuple(inner) && !state.takes_away(world, inner) && state.flow.map_read_sites.contains(id_of(value) as i64) {
                    let added = state.facts.copied_reads.insert(id_of(value) as i64)
                }
            },
            else => {},
        }
    }
    let word_copied = match bound {
        Ty::Nullable(inner) => ((!a_copy_by_value(inner) && state.a_word_by_its_kind(world, inner)) || check_core_stmt_a_tuple(inner)) && (state.facts.copied_walks.contains(id_of(value) as i64) || state.facts.copied_reads.contains(id_of(value) as i64)),
        else => false,
    }
    // **A list's `get` that copies its element out holds the value** (#1609).
    // **Nor a `let` typed as an option of a struct that copies** (#1302):
    // `let known: R? = m.get(k)` holds the struct, copied out at the `let`,
    // and a `??` over it is the struct, handed to a `ref R` as `&had`.
    let declared_copy = ty != null && match bound {
        Ty::Nullable(inner) => !inner.is_a_view() && state.a_package_copy(world, inner),
        else => false,
    }
    if of_a_map && !word_copied && !declared_copy && !state.facts.copied_walks.contains(id_of(value) as i64) {
        let kept: Ty = match bound {
            Ty::Nullable(inner) => {
                if inner.is_a_view() {
                    bound.clone()
                } else {
                    Ty::Nullable(view_of_type(inner))
                }
            },
            else => bound.clone(),
        }
        bound = kept
        state.flow.map_views.insert(id)
    }
    // **A read through the brackets that jumps where nothing is there binds
    // what the container holds**, unless it reads a number, a `bool` or a
    // `char` (#456).
    let jumped = check_core_stmt_read_through_a_jump(state, world, value)
    let copied_read = a_copy_by_value(bound) && check_core_stmt_a_read_that_leaves(state, world, value)
    if copied_read {
        check_core_stmt_copied_jump_reads(state, value)
    }
    // **A map's read of a type of the package that copies, past a jump, is
    // copied out** (ADR-279 D8), as the typed `let x: T = m[k] ?? return`
    // copies it (ADR-293 D15): a word is a value, not a view of the map.
    // **An element unwrapped past a jump is a view of it** (#1107, ADR-282
    // D7), as `m[k]` bound without the jump is: handed back where a view is
    // declared, it is the same element.
    let mut viewed_past_a_jump = false
    if ty == null && !mutable && names.len() == 1 && shape.len() == 0 && check_core_stmt_an_element_past_a_jump(state, world, value) && check_core_stmt_a_lent_struct(state, bound) {
        bound = view_of_type(bound)
        viewed_past_a_jump = true
    }
    let copied_word = ty == null && jumped && !copied_read && state.a_package_copy(world, bound) && check_core_stmt_a_named(bound)
    if copied_word {
        state.a_map_read_assigned(world, bound, value, span)
    }
    let read_through_a_jump = jumped && !copied_read && !copied_word
    let got_a_view = got && !a_copy_by_value(bound) && !copies_as_a_view(bound) && !(state.a_package_copy(world, bound) && check_core_stmt_a_named(bound))
    if mutable && (read_through_a_jump || got_a_view || check_core_stmt_a_field_jump(state, world, value)) {
        check_core_stmt_mut_view(state, world, value, span, a_copy_by_value(bound))
    } else if mutable && ty == null && names.len() == 1 && shape.len() == 0 && check_core_stmt_a_named(bound) && !a_copy_by_value(bound) {
        check_core_stmt_mut_view_of_an_element(state, world, value, state.a_package_copy(world, bound))
    }
    // **A `let mut` of an entry's `or_insert` is the `&mut` Rust hands back**
    // (#974): the binding is never reassigned, so it takes no `mut`.
    if mutable && state.flow.std_entry_views.contains(id_of(value) as i64) {
        state.facts.mut_view_reads.insert(id_of(value) as i64, "")
        // **One of a number is typed as the number** (#976): every mention
        // of it is `(*c)` below, read or written.
        if copies_as_a_view(bound) {
            bound = unviewed_type(bound)
        }
    }
    if check_core_stmt_a_path(bound) && state.made_from_text(world, value) {
        state.flow.text_paths.insert(id)
    }
    // **An `f"…"` with a file's name in it takes its type from its first
    // use** (ADR-319 D4, #2328): where that use asks for text, its holes are
    // refused there.
    if ty == null && check_core_stmt_a_path(bound) {
        state.a_let_of_names_in_holes(world, id, value)
    }
    if bound.is_unknown() || state.a_drivers_row(world, value) {
        state.flow.unknown_bound.insert(id)
    }
    let mut literal: String? = null
    if ty == null {
        literal = check_core_stmt_literal(value)
    }
    let mut without_mut: CheckImmutable? = null
    if !mutable {
        let mut kind = CheckKind::Let
        if deep {
            kind = CheckKind::Immutable
            let deep_name: String = world.words.resolve(names[0]).clone()
            check_core_stmt_an_immutable_that_changes(state, world, deep_name, bound, value, span)
        }
        without_mut = CheckImmutable { at: Span { start: span.start, end: span.end }, kind: kind, over: "" }
    }
    match bound {
        Ty::Named { name, .. } => {
            if name == "TaskHandle" {
                state.flow.handle_lets.insert(span.start as i64)
            }
        },
        else => {},
    }
    state.declared_binding(id, span, name)
    let mut local = CheckLocal::free(name, bound, id)
    // **A name bound to an element a list or a map keeps is a view of it**
    // (#1044, Part III `NK1131`): handed back whole, it is refused as a `for
    // mut` element is, never copied behind the reader's back.
    if !mutable && element_read != null && (state.does_not_copy(world, local.ty) || viewed_past_a_jump) {
        local.view_of = (element_read ?? "").clone()
    }
    if !mutable && ty == null && names.len() == 1 && shape.len() == 0 && state.an_element_of_a_made_list(world, value) {
        state.flow.made_elements.insert(local.id)
    }
    local.constant = constant
    local.lent = read_through_a_jump
    local.empty_list = pending
    local.open_number = open
    local.literal = literal
    local.without_mut = without_mut
    local.written_mut = mutable
    let mut declared_option = false
    if ty != null {
        let t: ref Type = ty ?? return check_core_stmt_unit()
        declared_option = match written_ty(world.words, world.here.aliases, t) {
            Ty::Nullable(inner) => !inner.is_a_view(),
            else => false,
        }
    }
    if declared_option && names.len() == 1 && shape.len() == 0 {
        state.flow.declared_options.insert(local.id)
    }
    state.a_let_made_here(world, id, value, local.ty)
    // **A `let` over a clone of a field or an element** (`NK1350`, #1988).
    if !mutable && ty == null && names.len() == 1 && shape.len() == 0 {
        state.a_let_of_a_place_clone(world, id, local.name, value, local.ty, span)
    }
    state.bind_local(local)
    // **A mutable view is the `&mut` already** (#975): handed to a `mut`
    // parameter, it is lent on again.
    if mutable && state.facts.mut_view_reads.contains_key(id_of(value) as i64) {
        state.flow.mut_view_bindings.insert(id)
    }
    // **A `let mut` of a view of a `String` slot writes owned text through
    // it** (#1388), whatever the one text view it is typed says.
    if mutable && state.flow.text_slot_views.contains(id_of(check_core_stmt_slot_read(value)) as i64) {
        state.flow.text_slot_bindings.insert(id)
    }
    // **A name bound to views and text of its own holds `EitherText`**
    // (ADR-282 D14, #1310): a choice of both, or a literal later given both.
    if state.facts.mixed_choices.contains(node_key(value)) || state.facts.mixed_leaves.contains_key(node_key(check_peeled(value))) {
        state.flow.either_bindings.insert(id)
    }
    return check_core_stmt_unit()
}

/// **`NK1331`: an `immutable` whose value can change** (ADR-389 D2): the
/// first part its type reaches, through fields, elements, variants or the
/// captures of the lambda it is bound to, that is changeable through another
/// owner. Labelled at the initializer and named by its path
/// (`config.cache: SharedMut[Map[String, i64]]`). A `Shared[T]` passes where
/// `T` does.
///
/// A lambda's captures are read where the initializer is the lambda itself:
/// a function value of any other origin carries no captures in its type.
fn check_core_stmt_an_immutable_that_changes(mut state: CheckState, world: ref CheckWorld, name: ref String, bound: ref Ty, value: ref Expr, span: ref Span) sync {
    let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
    let mut part: String? = check_core_stmt_a_changing_part(state, world, name, bound, seen)
    let mut captured = false
    if part == null {
        part = check_core_stmt_a_changing_capture(state, world, value)
        captured = part != null
    }
    let found: String = part ?? return
    let at = check_span_at(world, value, span)
    let mut message: String = f"`{name}` is `immutable`, but its value can change: `{found}` is changeable through another owner."
    if captured {
        message = f"`{name}` is `immutable`, but the lambda it holds captures `{found}`, which is changeable through another owner."
    }
    let note: String = "`immutable` promises that nothing reachable from the value ever changes (ADR-389). A `SharedMut`, a `Locked` and a channel end are changed through every other owner of the same storage."
    let help: String = "Bind it with `let`, or hold a value that can't change: a copy, or a `Shared[T]` of a `T` that can't change."
    let label = CheckLabel { span: at.clone(), word: "", text: "can change through another owner", main: true }
    state.findings.push(CheckFinding { severity: CheckSeverity::Error, span: at, code: "NK1331", message: message, notes: [note], help: help, labels: [label], edit: null })
}

/// A handle to storage another owner changes: `SharedMut`, `Locked`, a
/// channel end. A type of the program's own that happens to be called
/// `Sender` is none.
fn check_core_stmt_changes_through_another_owner(state: ref CheckState, world: ref CheckWorld, name: ref String) -> bool sync {
    if name == "SharedMut" || name == "Locked" || name == "channel::Sender" || name == "channel::Receiver" {
        return true
    }
    if name != "Sender" && name != "Receiver" {
        return false
    }
    return !state.structs.contains_key(name) && !state.enums.contains_key(name) && !world.own.types.contains_key(name)
}

/// The first part of `ty`, at `path`, that changes through another owner, as
/// `path: Type`; `null` where none does. `seen` holds the types of the
/// program's own already walked, so a recursive type ends.
fn check_core_stmt_a_changing_part(state: ref CheckState, world: ref CheckWorld, path: ref String, ty: ref Ty, mut seen: collections::BTreeSet[String]) -> String? sync {
    match ty {
        Ty::Named { name, args, .. } => {
            if check_core_stmt_changes_through_another_owner(state, world, name) {
                return f"{path}: {ty.shown()}"
            }
            // `Shared[T]` and `Box[T]` hold one value at the same path; a
            // collection's arguments are its elements, keys and values.
            let mut inner_path: String = f"{path}[…]"
            if name == "Shared" || name == "Box" {
                inner_path = path.clone()
            }
            for arg in args {
                let inner = check_core_stmt_a_changing_part(state, world, inner_path, arg, seen)
                if inner != null {
                    return inner
                }
            }
            if seen.contains(name) {
                return null
            }
            seen.insert(name.clone())
            let fields = state.fields_of(world, name) ?? return check_core_stmt_a_changing_variant(state, world, path, name, seen)
            for field in fields {
                let inner = check_core_stmt_a_changing_part(state, world, f"{path}.{field.name}", field.ty, seen)
                if inner != null {
                    return inner
                }
            }
            return check_core_stmt_a_changing_variant(state, world, path, name, seen)
        },
        Ty::Tuple(parts) => {
            let mut i = 0
            for part in parts {
                let inner = check_core_stmt_a_changing_part(state, world, f"{path}.{i}", part, seen)
                if inner != null {
                    return inner
                }
                i += 1
            }
            return null
        },
        Ty::Pointed { item, .. } => return check_core_stmt_a_changing_part(state, world, path, item, seen),
        Ty::Nullable(inner) => return check_core_stmt_a_changing_part(state, world, path, inner, seen),
        Ty::Seq { item, .. } => return check_core_stmt_a_changing_part(state, world, f"{path}[…]", item, seen),
        else => return null,
    }
}

/// The same question of what the variants of the enum `name` hold, at
/// `path.Variant.0` or `path.Variant.field`.
fn check_core_stmt_a_changing_variant(state: ref CheckState, world: ref CheckWorld, path: ref String, name: ref String, mut seen: collections::BTreeSet[String]) -> String? sync {
    let variants = state.enums.get(name) ?? return check_core_stmt_a_changing_contract(world, state, path, name, seen)
    for variant in variants {
        let key = f"{name}::{variant}"
        if state.variant_parts.contains_key(key) {
            let parts = state.variant_parts.get(key) ?? continue
            let mut i = 0
            for part in parts {
                let inner = check_core_stmt_a_changing_part(state, world, f"{path}.{variant}.{i}", part, seen)
                if inner != null {
                    return inner
                }
                i += 1
            }
        }
        let named = state.structs.get(key) ?? continue
        for field in named {
            let inner = check_core_stmt_a_changing_part(state, world, f"{path}.{variant}.{field.name}", field.ty, seen)
            if inner != null {
                return inner
            }
        }
    }
    return null
}

/// The variants of a type of the program's contract (`world.own`), where the
/// checker's own tables do not list the enum.
fn check_core_stmt_a_changing_contract(world: ref CheckWorld, state: ref CheckState, path: ref String, name: ref String, mut seen: collections::BTreeSet[String]) -> String? sync {
    let contract = world.own.types.get(name) ?? return null
    for variant in contract.variants {
        for field in variant.holds {
            let inner = check_core_stmt_a_changing_part(state, world, f"{path}.{variant.name}.{field.name}", field.ty, seen)
            if inner != null {
                return inner
            }
        }
    }
    return null
}

/// The first name a lambda written as the initializer captures whose value
/// changes through another owner, as `name: Type`.
fn check_core_stmt_a_changing_capture(state: ref CheckState, world: ref CheckWorld, value: ref Expr) -> String? sync {
    match value {
        Expr::Closure { params, body, .. } => {
            let mut named: collections::BTreeSet[String] = collections::BTreeSet()
            names_in_block(body, world.words, named)
            let own = lambda_own(world, params)
            for captured in named {
                if own.contains(captured) {
                    continue
                }
                let local = state.binding(captured) ?? continue
                let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
                let inner = check_core_stmt_a_changing_part(state, world, captured, local.ty, seen)
                if inner != null {
                    return inner
                }
            }
            return null
        },
        else => return null,
    }
}

/// A shift, `<<` or `>>`.
fn check_core_stmt_a_shift(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Shl || o == BinaryOp::Shr
}

/// `+`, `-` or `*`, written compound.
fn check_core_stmt_add_sub_mul(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Add || o == BinaryOp::Sub || o == BinaryOp::Mul
}

/// `/` or `%`.
fn check_core_stmt_divides(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Div || o == BinaryOp::Rem
}

/// An arithmetic or bit operator a slot of numbers is read once for.
fn check_core_stmt_a_slot_operator(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Add || o == BinaryOp::Sub || o == BinaryOp::Mul || o == BinaryOp::Div || o == BinaryOp::Rem || o == BinaryOp::BitAnd || o == BinaryOp::BitOr || o == BinaryOp::BitXor || o == BinaryOp::Shl || o == BinaryOp::Shr
}

/// An arithmetic operator, `+ - * / %`.
fn check_core_stmt_arithmetic(op: ref BinaryOp?) -> bool sync {
    if op == null {
        return false
    }
    let o: ref BinaryOp = op ?? return false
    return o == BinaryOp::Add || o == BinaryOp::Sub || o == BinaryOp::Mul || o == BinaryOp::Div || o == BinaryOp::Rem
}

/// A plain, not a view, type with no arguments: its name.
fn check_core_stmt_plain_name(ty: ref Ty) -> String? sync {
    return match ty {
        Ty::Named { name, args, view } => {
            if !view && args.len() == 0 {
                name.clone()
            } else {
                null
            }
        },
        else => null,
    }
}

/// A map type that says neither its key nor its value.
fn check_core_stmt_an_untyped_map(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, args, .. } => a_map_type(name) && (args.len() == 0 || (args.len() == 2 && args[0].is_unknown() && args[1].is_unknown())),
        else => false,
    }
}

/// **The open number an assignment's target is**, its root.
fn check_core_stmt_open_target(state: ref CheckState, world: ref CheckWorld, target: ref Expr) -> i64? sync {
    match target {
        Expr::Variable(name, _) => {
            let named: String = f"{world.words.resolve(name)}"
            let local: CheckLocal = state.binding(named) ?? return null
            let at: i64 = local.open_number ?? return null
            return state.open_root(at)
        },
        Expr::Index { .. } => {
            let at: i64 = state.open_element_of(world, target) ?? return null
            return state.open_root(at)
        },
        else => {},
    }
    return null
}

/// Whether the target is a name that holds shared mutable state.
fn check_core_stmt_shared(state: ref CheckState, world: ref CheckWorld, target: ref Expr) -> bool sync {
    if !check_core_stmt_a_name(target) {
        return false
    }
    let root: String = state.rooted_at(world, target) ?? return false
    let local: CheckLocal = state.binding(root) ?? return false
    return match local.ty {
        Ty::Named { name, .. } => name == "SharedMut",
        else => false,
    }
}

/// **`x = v` and `x op= v`** (Part I 2.1).
/// **A type a place owns whole** (#888): neither a view nor an option of one, whose
/// slot takes a proved read as it is.
fn check_core_stmt_owns_whole(ty: ref Ty) -> bool sync {
    return match ty {
        // **A `T?` place owns its value whole when `T` does** (#893): the
        // proved arm is unwrapped and the whole choice wrapped in `Some(..)`,
        // as `return` from a `-> T?` function writes it.
        Ty::Nullable(inner) => check_core_stmt_owns_whole(inner),
        Ty::Unknown => false,
        else => !ty.is_a_view(),
    }
}

fn check_core_stmt_assign[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, target: ref Expr, op: ref BinaryOp?, value: ref Expr, span: ref Span) -> Ty sync {
    // **Code assigned meets what the place holds** (ADR-351 D3).
    let code_keys: Vec[String] = if op == null { check_core_places_code_keys(state, world, target) } else { [] }
    // `NK2101`: an assignment **revives** a name a task took with it, and a
    // part of one (ADR-293 D32).
    let path = state.place_path(world, target)
    if path != null {
        let written: String = (path ?? "").clone()
        let choices = state.branch.clone()
        state.gives.push(CheckGive { path: written.clone(), at: span.start as i64, choices: choices })
        state.written_at.push((written, span.start as i64))
    }
    // **An element assigned gives back one taken out** (ADR-views-v4 D18,
    // #1208): `w[i] = []` after `keep(w[i])`.
    let element = state.an_element_path(world, target, false)
    if path == null && element != null {
        state.gives.push(CheckGive { path: (element ?? "").clone(), at: span.start as i64, choices: state.branch.clone() })
    }
    // **D3**: an assignment into a parameter says `mut`.
    let shared = check_core_stmt_shared(state, world, target)
    if !shared {
        let rooted = state.rooted_at(world, target)
        if rooted != null {
            let root: String = (rooted ?? "").clone()
            let how: String = if check_core_stmt_a_name(target) { "changed here" } else { "one of its parts is changed here" }
            state.a_changed_binding_says_mut(root, how, Span { start: span.start, end: span.end })
            state.a_shared_name_changed_in_parallel(root, span)
        }
    }
    // **A write through the brackets is unchanged** (ADR-293 D2, D19).
    let outer = state.reading_only
    state.reading_only = check_core_stmt_a_name(target)
    // **A key written is handed to the map** (ADR-293 D27).
    state.flow.writing_index = op == null && check_core_stmt_an_index(target)
    // **The place written is not read as the `T` a proof made it**, and a
    // proved path on the way to it is written through (ADR-382).
    let saved_target = state.narrowing.target
    if op == null {
        state.narrowing.target = id_of(target) as i64
    }
    let mut into = check_core_expr(state, world, host, target, span)
    // A place written to is not a copy of it (#1031).
    state.facts.kept_fn_copies.remove(id_of(target) as i64)
    state.narrowing.target = saved_target
    // **A `let mut` view is written through** (#976): `*c = v`, `*c += 1`,
    // and what it is assigned is the value it views. A view of text stays
    // one: the slot holds what its tier says, and a `String` slot owned text
    // (#1388).
    if state.a_mut_view_name(world, target) {
        state.facts.view_derefs.insert(node_key(target))
        let of_text = match into {
            Ty::Named { name, .. } => name == "str",
            else => false,
        }
        if state.a_text_slot_name(world, target) {
            into = Ty::Named { name: TEXT.clone(), args: [], view: false }
        } else if !of_text {
            into = unviewed_type(into)
        }
    }
    check_narrow_written_through(state, target)
    // **A map's slot holds its `V`**, though its index reads a `V?` (D1);
    // an element of a `Vec[T?]` holds the `T?` it reads (#1296).
    if check_core_stmt_a_map_index(state, target) {
        let slot: Ty = match into {
            Ty::Nullable(inner) => inner.clone(),
            else => into.clone(),
        }
        into = slot
    }
    state.reading_only = outer
    state.flow.writing_index = false
    if code_keys.len() > 0 {
        state.stored_frames.push(CheckStoredCode::empty())
    }
    // **A lambda assigned is of the place's type** (#1627), as one bound
    // by a `let` that declares it is: `g = fn { … }` to a `fn()` is weighed
    // against `fn()`.
    if op == null && check_core_stmt_expects_a_lambda(value) && check_core_stmt_a_fn_type(into) {
        state.flow.lambda_expected = into.clone()
    }
    // **A vector assigned is made of the place's type** (ADR-377 D3).
    if op == null && check_simd_wanted(world, value, into) != null {
        state.flow.lambda_expected = into.clone()
    }
    let mut found = check_core_expr(state, world, host, value, span)
    state.flow.lambda_expected = null
    if a_child_handle(found) {
        state.a_child_handle_leaving_its_group(span, "it is assigned to a place, which may outlive its group")
    }
    if code_keys.len() > 0 {
        check_core_places_stored_keys(state, world, host, value, code_keys)
    }
    if op == null {
        state.a_map_read_assigned(world, into, value, span)
        check_fields_map_first_written(state, world, target, value, found, span)
    }
    // **An assignment keeps what it is given** (ADR-282 D3, ADR-293 D28).
    if op == null {
        check_core_a_kept_lambda(state, world, host, into, value, span)
    }
    if op == null {
        check_pos_assigned(state, world, target, value, span)
    }
    if op == null && state.mixed_text_assigned(world, target, value, found) {
        return check_core_stmt_unit()
    }
    if op == null {
        let built = state.text_literal(world, into, value, true)
        if built != null {
            found = built ?? found.clone()
        }
    }
    // **An assignment is a use of both sides** (ADR-285 D24, D25).
    if !check_core_stmt_a_shift(op) {
        let open = check_core_stmt_open_target(state, world, target)
        if open != null {
            if integer_named(value_of_a_copy(found.unseen())) != null {
                state.number_asked(world, target, found, span, true)
            } else if state.number_shaped(world, value) {
                state.open_number_given(world, open ?? 0, value, span)
            }
        }
        state.number_asked(world, value, into, span, true)
    }
    // **`x <<= k` shifts `x` as `x << k` does** (Part I 2.2).
    if check_core_stmt_a_shift(op) {
        let o: ref BinaryOp = op ?? return check_core_stmt_unit()
        state.shift_count_fits(world, o.clone(), target, value_of_a_copy(into.unseen()), value, span)
    }
    // **`x op= k` is `x = x op k`** (ADR-395, #1586): a constant divisor of
    // zero is `NK1118`, a sum of constants past its type `NK1116`, as the
    // operation written out is; read before the assignment follows `x`.
    if op != null && !check_core_stmt_a_shift(op) {
        let o: ref BinaryOp = op ?? return check_core_stmt_unit()
        state.divisor_is_not_zero(world, o.clone(), value, span)
        state.an_operation_that_overflows(world, o.clone(), target, value, null, span)
    }
    // **A `let mut` is followed through what straight-line code assigns it**.
    state.assigned_followed(world, target, op, value)
    // **What is assigned is given to the place** (ADR-293 D29).
    if op == null {
        // **Into a name that holds a view, a read through a `ref` parameter
        // is lent** (ADR-282 D13, #839).
        let lent = check_core_stmt_a_name(target) && into.is_a_view() && state.lent_views_assigned(world, value, found)
        if lent {
            found = Ty::Named { name: TEXT_VIEW.clone(), args: [], view: true }
        } else {
            let to: String = if check_core_stmt_an_index(target) { "written into a container" } else { "assigned to another name" }
            state.hands_over(world, value, found, to, span)
            check_core_places_give_handle(state, world, value, found, span)
            // **A proved name assigned whole to a place that owns it is
            // given up** (#888), as a `let`'s is.
            if check_core_stmt_owns_whole(into) {
                state.narrowed_reads_given_back(value)
            }
        }
    }
    // **A write to shared mutable state goes through a door** (ADR-281).
    let written = check_walked_written(value, world.words)
    state.a_write_that_skips_the_door(world, target, into, written, span)
    // **A compound assignment on a map slot is written out** (ADR-293 D2).
    if op != null {
        check_core_a_compound_write_to_a_map_slot(state, world, host, target, span)
    }
    // **`text += x` appends a text** (#760): whether `x` is a view or owned,
    // it goes in as a `str`.
    if op != null && is_text_type(into.unseen()) {
        let o: ref BinaryOp = op ?? return check_core_stmt_unit()
        if check_core_ops_add(o.clone()) {
            let added = state.facts.appended_texts.insert(span.start as i64)
        }
    }
    // **`x = x.replace(a, b)` replaces in `x`'s buffer** (ADR-text-reuse-1
    // D4): `x` owns its text and is not read by `a` or `b`.
    if op == null && is_text_type(into.unseen()) && !into.is_a_view() && check_core_stmt_replaces_itself(world, target, value) {
        let replaced = state.facts.replaced_assigns.insert(span.start as i64)
    }
    // **`x += a` over two integer types is `x = x + a`** (ADR-285 D32).
    if op != null && !check_core_stmt_a_shift(op) {
        let o: ref BinaryOp = op ?? return check_core_stmt_unit()
        // **`x += 1` over an `f64` `x`** is an integer beside a float (#703).
        if !state.an_integer_beside_a_float(world, target, into, value, found, span) {
            state.a_compound_over_two_integer_types(world, o.clone(), target, into, value, found, span)
        }
    }
    // **`x /= d` divides as `x / d`** (ADR-396 D7, #1578): a goal of the
    // walk, by the statement's first byte, where `x` is a path of fields; a
    // literal divisor is no check.
    if check_core_stmt_divides(op) && check_core_stmt_a_name_or_field(target) {
        let plain = check_core_stmt_plain_name(into.unseen()) ?? ""
        let given = check_core_stmt_plain_name(value_of_a_copy(found.unseen())) ?? ""
        if is_whole_number(plain) && given == plain {
            state.facts.divisions.insert(span.start as i64, plain.clone())
        }
    }
    // **`x += d` is `x = x + d`, and may be proved as one** (#387), and so
    // is `x.f += d`, a fold's counter (ADR-367 D3), and `xs[c] += d`, an
    // element the prover follows as a name (ADR-306 D33).
    if check_core_stmt_add_sub_mul(op) && (check_core_stmt_a_name_or_field(target) || check_core_stmt_an_index(target)) {
        let plain = check_core_stmt_plain_name(into.unseen())
        if plain != null {
            let name: String = (plain ?? "").clone()
            // A number this use types (ADR-285 D23) takes the name's type.
            let same = match value {
                Expr::LitInt { .. } => true,
                else => value_of_a_copy(found.unseen()) == into.unseen() || state.open_numbers_in(world, value).len() > 0,
            }
            if is_whole_number(name) && same {
                state.facts.arithmetic.insert(span.start as i64, name)
            }
        } else {
            // **`i += d` on an untyped `let mut i = 0`** takes `d`'s type
            // where `d` has one, and otherwise waits for the number's type,
            // as `i + 1` does (ADR-285 D23).
            let given = check_core_stmt_plain_name(found.unseen())
            let counted = match value {
                Expr::LitInt { .. } => true,
                else => state.open_numbers_in(world, value).len() > 0,
            }
            if given != null && is_whole_number(given ?? "") && !counted {
                state.facts.arithmetic.insert(span.start as i64, (given ?? "").clone())
            } else if counted {
                state.open_number_site(world, [target], span.start as i64)
            }
        }
    }
    // **`xs[i] += d` on a list of numbers** (#387).
    if check_core_stmt_a_slot_operator(op) && check_core_stmt_an_index(target) {
        let plain = check_core_stmt_plain_name(into.unseen())
        if plain != null {
            let name: String = (plain ?? "").clone()
            if a_number_name(name) || name == "bool" {
                state.facts.copied_slots.insert(span.start as i64)
            }
        }
    }
    // **`NK1191` for `-=` as for `-`**.
    if check_core_stmt_arithmetic(op) {
        let arithmetic: ref BinaryOp = op ?? return check_core_stmt_unit()
        if !(arithmetic == BinaryOp::Add && is_text_type(into)) && (check_core_stmt_has_no_arithmetic(world, into) || check_core_stmt_has_no_arithmetic(world, found) || text_or_bool_in_arithmetic(arithmetic.clone(), into, found)) {
            state.arithmetic_on_something_that_has_none(world, arithmetic.clone(), target, into, value, found, true, span)
        }
    }
    // Only a plain assignment.
    if op == null {
        check_core_stmt_wraps_into_nullable(state, world, host, found, into, value, span)
        if state.owned_text_into_a_literal_binding(world, target, found, into, span) {
            return check_core_stmt_unit()
        }
        if state.a_name_in_text(world, into, value, span) {
            return check_core_stmt_unit()
        }
        let at = check_span_at(world, value, span)
        let pushed = state.findings.len() as i64
        let waiting = state.slots_waiting(span)
        // **A number assigned where no integer goes** (#703) is the `i64` it
        // would be, and the mismatch says so.
        if check_float_literal_fits(value, into) {
            state.floats_beyond_f32(value, into, span)
            return check_core_stmt_unit()
        }
        let mut assigned: Ty = found.clone()
        if found.is_unknown() && state.number_shaped(world, value) && state.no_integer_is(world, into) {
            assigned = Ty::Named { name: "i64", args: [], view: false }
        }
        state.expect_type(world, assigned, into, span, "assign", fn(was, wanted) { f"You're assigning `{was}` to something that holds `{wanted}`." })
        state.findings_moved(span, at, pushed, waiting)
    }
    return check_core_stmt_unit()
}

/// **`while`** (Part I 3.3).
fn check_core_stmt_while[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, cond: ref Expr, body: ref Block, span: ref Span) -> Ty sync {
    // **The condition is read again on every turn** (ADR-382 D5).
    check_narrow_turn_begins(state, state.scope.len() as i64)
    let cond_ty = check_core_expr(state, world, host, cond, span)
    let at = check_span_at(world, cond, span)
    state.expect_bool(cond_ty, at, "A `while` loop repeats while a `bool` is `true`.")
    let depth = state.scope.len() as i64
    state.repeats.push(CheckRepeats::a_loop(world.words, depth, span.start as i64, body))
    // **The body sees what the condition proves not `null`** (ADR-382 D2).
    let proved = check_narrow_proved_here(state, world, cond, true)
    state.scope.push(proved)
    // **The body and not the condition.**
    state.flow.loops += 1
    check_core_stmt_body_discarded(state, body)
    check_core_block(state, world, host, body)
    state.flow.loops -= 1
    state.scope.pop()
    check_narrow_turn_ends(state)
    state.a_loop_ends()
    state.repeats.pop()
    return check_core_stmt_unit()
}

/// **A range's binding is a use of the numbers it counts between**
/// (ADR-285 D1, ADR-270 D8 step 1), and between two literals a number of its
/// own (D1, D3).
fn check_core_stmt_for_a_range(mut state: CheckState, world: ref CheckWorld, iter: ref Expr, mut frame: Vec[CheckLocal], span: ref Span) sync {
    match iter {
        Expr::Range { start, end, .. } => {
            let mut open: Vec[i64] = []
            for n in state.open_numbers_in(world, start) {
                open.push(n)
            }
            for n in state.open_numbers_in(world, end) {
                open.push(n)
            }
            state.open_numbers_joined(open)
            if open.len() > 0 && frame.len() > 0 {
                frame[0].open_number = state.open_root(open[0])
            }
            // **Between two literals the binding is a number of its own** (D1, D3).
            if open.len() == 0 && state.number_shaped(world, start) && state.number_shaped(world, end) && frame.len() > 0 && frame[0].ty.is_unknown() {
                let first: String = frame[0].name.clone()
                state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(first, false, span))
                frame[0].open_number = span.start as i64
                state.open_number_given(world, span.start as i64, start, span)
                state.open_number_given(world, span.start as i64, end, span)
            }
        },
        else => {},
    }
}

/// Why the element a `for` walks cannot be changed in place, as a word: `map`
/// (its key is part of the head), `set`, or `adapter` (it lends read-only
/// views); empty where it can (ADR-views-v4 D27).
fn check_core_stmt_unwritable_element(state: ref CheckState, world: ref CheckWorld, iter: ref Expr, over: ref Ty) -> String sync {
    match over {
        Ty::Named { name, .. } => {
            if a_map_type(name) {
                return "map"
            }
            let last = type_last_segment(name)
            if last == "HashSet" || last == "BTreeSet" || last == "Set" {
                return "set"
            }
        },
        else => {},
    }
    if !is_a_place(iter) && (state.flow.lent_walks.contains(id_of(iter) as i64) || check_core_stmt_from_iter(world, iter)) {
        return "adapter"
    }
    return ""
}

/// Whether a chain of calls starts with `iter()`: what it hands are views.
fn check_core_stmt_from_iter(world: ref CheckWorld, iter: ref Expr) -> bool sync {
    return match iter {
        Expr::MethodCall { receiver, method, .. } => f"{world.words.resolve(method)}" == "iter" || check_core_stmt_from_iter(world, receiver),
        else => false,
    }
}

/// The place a chain of adapters starts from, as written: `v` of
/// `v.iter().enumerate()`; `xs` where it is not a place.
fn check_core_stmt_adapter_root(world: ref CheckWorld, iter: ref Expr) -> String sync {
    return match iter {
        Expr::MethodCall { receiver, .. } => check_core_stmt_adapter_root(world, receiver),
        else => dotted_path(world, iter) ?? "xs",
    }
}

/// A `Vec` or an `Array`: the lists a `for mut` element is written through.
fn check_core_stmt_a_list_type(ty: ref Ty) -> bool sync {
    return match ty {
        Ty::Named { name, args, .. } => ((type_last_segment(name) == "Vec" || type_last_segment(name) == "List") && args.len() == 1) || (name == ARRAY && args.len() > 0),
        else => false,
    }
}

/// **`for`** (Part I 3.3).
fn check_core_stmt_for[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, bindings: ref Vec[winnow_grammar::Symbol], shape: ref Vec[i64], mutable: bool, mut_names: ref Vec[bool], iter: ref Expr, body: ref Block, span: ref Span) -> Ty sync {
    state.the_caller_writes_no_reference(iter, span, "a `for` lends what it iterates")
    // **The methods a `.collect()` walked reach a frame of their own**
    // (`NK1354`, #1975): its steps are asked whether they are pure.
    let collected = a_collect_of_a_chain(world, iter) != null
    if collected {
        state.stored_frames.push(CheckStoredCode::empty())
    }
    let over = check_core_expr(state, world, host, iter, span)
    let mut steps: Vec[String] = []
    if collected {
        let frame: CheckStoredCode = state.stored_frames.pop() ?? CheckStoredCode::empty()
        steps = state.not_pure_in(world, host, frame, iter)
    }
    state.a_loop_over_a_nullable(world, over, iter, span)
    state.a_loop_over_what_holds_no_elements(world, over, iter, span)
    // **A `for` walks what it counts, one turn per element or entry**
    // (ADR-361 D13): its length is recorded as `.len()`'s is.
    if check_core_method_counted(over) {
        state.facts.std_lengths.insert(id_of(iter) as i64)
        if state.elements_take_space(over) {
            state.facts.sized_lengths.insert(id_of(iter) as i64)
        }
    }
    // **A nested head walks its top-level width** (ADR-356).
    let mut width = bindings.len() as i64
    if shape.len() > 0 && shape[0] > 0 {
        width = shape[0]
    }
    let before = state.findings.len()
    state.fallible_step(world, over, width, span)
    // A fallible walk bound to several names is `NK2701` already.
    let stepped_fallibly = state.findings.len() > before
    // **A `for` over a walk with `within:` ends it** (ADR-async-5 D27): the
    // walk is listed first, and throws `task::TimedOut` there.
    if shape_timed(over) {
        state.facts.timed_loops.insert(span.start as i64)
        check_core_walk_timed_out(state, span)
    }
    state.pausing_step(over, span)
    // **A `for` walks a produced sequence, and that consumes it** (ADR-105 D2).
    state.a_sequence_is_walked(iter, over, span, world)
    let mut elements = elements_walked(over, width)
    if width > 1 && !stepped_fallibly {
        let refused = state.a_tuple_pattern_that_does_not_fit(element_walked(over, 1), width, "A `for`", span)
    }
    if shape.len() > 0 {
        elements = state.nested_pattern_parts(world, elements, shape, bindings.len() as i64, "A `for`", span)
    }
    // **A `for` over whole numbers binds a number of the bounds walk**
    // (ADR-306 D7): `for k in ks` is bounded by every test of `k` in the
    // body, as a name bound to a call's whole result is (#781).
    if bindings.len() == 1 && elements.len() == 1 {
        match elements[0] {
            Ty::Named { name, args, .. } => {
                if args.is_empty() && is_whole_number(name) {
                    state.facts.whole_loops.insert(id_of(iter) as i64, name.clone())
                }
            },
            else => {}
        }
    }
    // **An element with a length** (ADR-396 D4): `for line in s.split("\n")`
    // binds a text, whose `line.len()` the prover reads, by the start of the
    // `for` as a `let`'s type is.
    if bindings.len() == 1 && elements.len() == 1 {
        match elements[0] {
            Ty::Named { name, args, .. } => {
                // A struct element has the fields of a parameter's type.
                if has_a_length(name) || (args.is_empty() && !is_whole_number(name)) {
                    state.facts.whole_lets.insert(span.start as i64, name.clone())
                }
            },
            else => {}
        }
    }
    // **And each name of several a `for` binds to a whole number**: a
    // tuple's part, an `enumerate()`'s position.
    if bindings.len() > 1 && elements.len() == bindings.len() {
        let mut parts: collections::BTreeSet[i64] = collections::BTreeSet()
        for (at, element) in elements.iter().enumerate() {
            match element {
                Ty::Named { name, args, .. } => {
                    if args.is_empty() && is_whole_number(name) {
                        parts.insert(at as i64)
                    }
                },
                else => {}
            }
        }
        if !parts.is_empty() {
            state.facts.whole_parts.insert(id_of(iter) as i64, parts)
        }
    }
    // **An element of a list of code is given what the list was** (ADR-351
    // D1, D4).
    if bindings.len() == 1 && state.current != null && check_core_stmt_holds_code(over) {
        // A name of this function, or a field path: each place it names.
        let current: String = state.current?.clone() ?? ""
        let to = f"{current}::{world.words.resolve(bindings[0])}"
        let keys = check_core_places_code_keys(state, world, iter)
        let mut entry: CheckStoredCode = state.stored_code.remove(to) ?? CheckStoredCode::empty()
        if keys.len() == 0 {
            entry.unresolved = true
        }
        for from in keys {
            match state.stored_code[from] {
                null => {
                    entry.unresolved = true
                },
                given => entry.meet(given),
            }
        }
        state.stored_code.insert(to, entry)
    }
    // **A name that holds a sequence is handed over, not lent** (ADR-293 D19).
    let a_seq = match over {
        Ty::Seq { .. } => true,
        else => the_command_line(over),
    }
    let owned = is_a_place(iter) && a_seq
    if owned {
        state.facts.owned_loops.insert(span.start as i64)
    }
    // **A `for` over a place lends** (ADR-094 D4).
    let lent = is_a_place(iter) && !owned
    // **`mut` in front of the head** (ADR-views-v4 D24-D26): over elements the loop
    // owns (a range, `drain()`, a produced sequence) every name is a `let mut`
    // of the turn. Over a place, the element is a view of it (D2, step 2).
    let mut mut_view = false
    // The list a `for` without `mut` walks, as written, for `NK1139`'s help.
    let mut walked_list: String = ""
    if !mutable && lent && check_core_stmt_a_list_type(over) {
        walked_list = dotted_path(world, iter) ?? ""
    }
    // **A key, a set's element and a lending adapter's element take no `mut`**
    // (D4, section 6): `NK1306`, labelled at the `mut`.
    let mut unwritable = if mutable { check_core_stmt_unwritable_element(state, world, iter, over) } else { "" }
    // **`mut` on a map's value alone writes it in place** (section 6, #1133):
    // `for (k, mut v) in m` leaves the key unmarked, and `v` is a `let mut`
    // view of the entry's value, lowered `iter_mut()` (`values_mut()` under
    // a `_` key).
    let value_only = unwritable == "map" && mut_names.len() > 0 && !mut_names[0] && shape.len() == 0
    if value_only {
        unwritable = ""
    }
    if unwritable != "" {
        state.a_for_mut_that_cannot_write(unwritable, iter, world, span)
    } else if mutable && lent {
        // **Over a list or an array held by something the function may change
        // the element is a `let mut` view of it** (D2): lowered `iter_mut()`.
        let list: String? = dotted_path(world, iter)
        let mut names: Vec[String] = []
        let mut index = 0
        for b in bindings {
            let marked = mut_names.len() > 0 && mut_names[index]
            names.push(if marked { f"mut {world.words.resolve(b)}" } else { f"{world.words.resolve(b)}" })
            index += 1
        }
        let mut head: String = if names.len() == 1 { names[0].clone() } else { f"({names.join(", ")})" }
        if mut_names.len() == 0 {
            head = f"mut {head}"
        }
        if list != null && (check_core_stmt_a_list_type(over) || value_only) {
            let written: String = list ?? ""
            let parts: Vec[ref String] = written.split(".").collect()
            let found = state.binding(parts[0]) ?? return check_core_stmt_unit()
            match found.without_mut {
                null => {
                    mut_view = true
                    state.facts.mut_view_reads.insert(id_of(iter) as i64, if value_only { "map" } else { "" })
                    // **The list is changed through its elements**: an arm's
                    // part walked so is opened `mut` (#734).
                    state.a_change_noted(f"{parts[0]}")
                },
                kept => {
                    state.a_for_mut_over_a_list_not_mut(written, head, kept.kind == CheckKind::Parameter, span)
                },
            }
        } else {
            state.a_for_mut_over_a_place(world, iter, over, span)
        }
    }
    let mut frame: Vec[CheckLocal] = []
    let mut at = 0
    for b in bindings {
        if at >= elements.len() {
            break
        }
        let name: String = f"{world.words.resolve(b)}"
        let element = elements[at].clone()
        // **A name is `mut` where the head or the name says so** (D24,
        // section 6, #1133); over a map only the value is a view.
        let name_mut = mutable && (mut_names.len() == 0 || mut_names[at])
        let mut_view = mut_view && (!value_only || name_mut)
        at += 1
        // **A call that hands back a view lends its elements too** (#2062):
        // `for v in arena.variable_ids(id)` over a `ref Vec[i64]` reads each
        // number out of the view, as a walk over the place would.
        let lent_by_a_call = !is_a_place(iter) && over.is_a_view() && !mutable
        let copied = (lent || lent_by_a_call) && !mut_view && name != "_" && a_copy_by_value(element)
        if copied {
            state.facts.copied_loop_bindings.insert((span.start as i64, name.clone()))
        }
        // **An element of a type that copies by declaration is the value**
        // (`selfhosting_defects::a_loop_over_copies_binds_the_value`): a type
        // of the package that derives `Copy`, or a described one whose ledger
        // says `copies`, as a number is above.
        let declared_copy = lent && !mut_view && name != "_" && !copied && !element.is_a_view() && state.a_view_that_copies(world, view_of_type(element))
        // **An element `T?` of a type that copies is the option** (#1254): a
        // number's or a `Symbol`'s option is read out of the view, so `x ??
        // continue` binds the value and not a view of it.
        let an_option_that_copies = match element {
            Ty::Nullable(inner) => a_copy_by_value(inner) || (!inner.is_a_view() && state.a_view_that_copies(world, view_of_type(inner))),
            else => false,
        }
        let option_copy = lent && !mut_view && name != "_" && !copied && an_option_that_copies
        let a_view = declared_copy || option_copy || (lent && !mut_view && name != "_" && !copied && element.is_a_view())
        if a_view {
            state.facts.copied_view_bindings.insert((span.start as i64, name.clone()))
        }
        // **A binding lent something that does not copy is a view of it.**
        let named = match element {
            Ty::Named { .. } => true,
            else => false,
        }
        let mut bound = element.clone()
        if lent && !mut_view && !copied && !declared_copy && named {
            bound = view_of_type(element)
        }
        let id = state.a_new_binding()
        // **A text handed by a walk that lends is a view of it** (#688's rule,
        // for a `for`): `xs.iter()` hands `&String` below, so a comparison
        // reads it as `str`.
        // So is a part that the walk's item types as a view of text
        // (`enumerate`'s `(i64, ref String)`).
        if !lent && name != "_" && (state.flow.lent_walks.contains(id_of(iter) as i64) || element.is_a_view()) && check_owned_text(bound) {
            state.flow.lent_text_params.insert(id)
        }
        state.declared_binding(id, span, name)
        let mut local = CheckLocal::free(name, bound, id)
        local.written_mut = name_mut
        if mut_view {
            local.view_of = dotted_path(world, iter) ?? ""
        }
        local.lent = lent && !mut_view && !copied && !a_view
        // **A `for` binding changes only with `mut`** (Part I 3.3, #734,
        // ADR-views-v4 D24): its head is a `let`'s pattern, so a change to one
        // without it is `NK1139`.
        if !name_mut {
            local.without_mut = CheckImmutable { at: Span { start: span.start, end: span.end }, kind: CheckKind::Loop, over: walked_list.clone() }
        }
        frame.push(local)
    }
    // **A range's binding is a use of the numbers it counts between**
    // (ADR-285 D1, ADR-270 D8).
    if bindings.len() == 1 {
        check_core_stmt_for_a_range(state, world, iter, frame, span)
    }
    // **A walk over a list written in numbers binds its open element**
    // (ADR-285 D34).
    // A walk over a list of number lists binds a list one level in (#938),
    // and an element of one is walked as a list (`for n in grid[0]`).
    let walked: (i64, i64)? = match iter {
        Expr::Variable(..) => state.open_list_of(world, iter),
        Expr::Index { .. } => state.open_list_of(world, iter),
        else => null,
    }
    if bindings.len() == 1 && frame.len() > 0 && walked != null {
        let list = walked ?? (0, 0)
        if list.1 == 1 && frame[0].ty.is_unknown() {
            frame[0].open_number = state.open_root(list.0)
            // **Its element is a number, whichever type it gets, so a lent
            // walk binds the value** (#938), as one over `Vec[i64]` does
            // above.
            if lent && !mut_view && frame[0].name != "_" {
                state.facts.copied_loop_bindings.insert((span.start as i64, frame[0].name.clone()))
                frame[0].lent = false
            }
        } else if list.1 >= 2 && check_core_stmt_unknown_list_levels(frame[0].ty.unseen()) == list.1 - 1 {
            state.flow.open_elements.insert(frame[0].id, list.0)
            if list.1 > 2 {
                state.flow.open_levels.insert(frame[0].id, list.1 - 1)
            }
        }
    }
    if bindings.len() == 1 && frame.len() > 0 && frame[0].ty.is_unknown() {
        match iter {
            Expr::ListLit { items, .. } => {
                let mut all_numbers = items.len() > 0
                for item in items {
                    if all_numbers && !state.number_shaped(world, item) {
                        all_numbers = false
                    }
                }
                if all_numbers {
                    let first: String = frame[0].name.clone()
                    state.flow.open_numbers.insert(span.start as i64, check_core_stmt_open_number(first, false, span))
                    frame[0].open_number = span.start as i64
                    for item in items {
                        state.open_number_given(world, span.start as i64, item, span)
                    }
                }
            },
            else => {},
        }
    }
    // **A walk over a map written in numbers binds its open key and value**
    // (ADR-285 D43).
    if bindings.len() == 2 && frame.len() == 2 {
        match iter {
            Expr::Variable(name, _) => {
                let named: String = f"{world.words.resolve(name)}"
                let map = state.binding(named)
                if map != null {
                    let held: CheckLocal = map ?? return check_core_stmt_unit()
                    let a_map = match held.ty {
                        Ty::Named { name, .. } => a_map_type(name),
                        else => false,
                    }
                    let keys = state.flow.open_keys.get(held.id)
                    if a_map && keys != null && frame[0].ty.is_unknown() {
                        frame[0].open_number = state.open_root(keys ?? 0)
                    }
                    let values = state.flow.open_elements.get(held.id)
                    if a_map && values != null && frame[1].ty.is_unknown() {
                        frame[1].open_number = state.open_root(values ?? 0)
                    }
                }
            },
            else => {},
        }
    }
    for local in frame {
        state.nameable(local.name, span, "a `for` binding")
    }
    let depth = state.scope.len() as i64
    state.repeats.push(CheckRepeats::a_loop(world.words, depth, span.start as i64, body))
    check_narrow_turn_begins(state, depth)
    state.scope.push(frame)
    // **The element of a `for mut` is only borrowed from its list** (D5): a part
    // of it handed to something that keeps it is `NK1131`, as out of a `let`
    // over a place (`lent_lets`); the emitter still lends it as a `&mut`.
    let frame_at = state.scope.len() as i64 - 1
    if mut_view {
        for b in bindings {
            state.lent_lets.insert((f"{world.words.resolve(b)}", frame_at))
        }
    }
    let handed_before = state.handed.len() as i64
    state.flow.loops += 1
    check_core_stmt_body_discarded(state, body)
    check_core_block(state, world, host, body)
    state.flow.loops -= 1
    // **A `for` over a clone it only walks** (`NK1350`, #1318).
    let items = state.scope[frame_at].clone()
    state.a_loop_over_a_needless_clone(world, iter, over, body, items, handed_before, mutable, span)
    // **A `for` over a list collected only to be walked** (`NK1354`, #1975).
    if collected && steps.len() == 0 {
        state.a_loop_over_a_needless_collect(world, iter, body, mutable, span)
    }
    // **A turn's element is whole again where the turn ends** (ADR-views-v4 D19,
    // D28).
    if mut_view && body.stmts.len() > 0 {
        state.views_end(frame_at, body.stmts[body.stmts.len() - 1].span.end as i64)
    }
    if mut_view {
        for b in bindings {
            state.lent_lets.remove((f"{world.words.resolve(b)}", frame_at))
        }
    }
    state.scope.pop()
    check_narrow_turn_ends(state)
    state.a_loop_ends()
    state.repeats.pop()
    return check_core_stmt_unit()
}

/// **`return`**: `Ty::Unknown`, a statement that jumps is not a value.
fn check_core_stmt_return[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, value: ref Expr?, span: ref Span) -> Ty sync {
    check_core_returns(state, world, host, value, span, false)
    if value != null {
        let returned = value ?? return Ty::Unknown
        state.narrowed_reads_given_back(returned)
        state.place_clones_handed_back(world, returned)
        state.a_pausing_cleanup_returned(world, returned)
    }
    state.a_way_out("return", "", span)
    return Ty::Unknown
}

/// **`break` and `continue`** (Part I 3.3): `Ty::Unknown`, as a `return`.
fn check_core_stmt_jump(mut state: CheckState, word: ref String, span: ref Span) -> Ty sync {
    if state.flow.loops == 0 {
        state.a_jump_with_nowhere_to_go(word, span)
    }
    state.failing_cleanups_left(span)
    // **A jump leaves the views bound inside its loop** (ADR-views-v4 D19).
    state.a_way_out(word, "", span)
    return Ty::Unknown
}

/// **A statement, walked**: one function per variant.
fn check_core_stmt[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, stmt: ref Stmt, span: ref Span) -> Ty sync {
    state.flow.literal_receivers.clear()
    return match stmt {
        Stmt::Let { names, shape, mutable, mut_names, deep, ty, value } => check_core_stmt_let(state, world, host, names, shape, mutable, mut_names, deep, ty, value, span),
        // **`comptime` is a `let` that has to fold** (ADR-287 D4, D5).
        Stmt::Comptime { name, ty, value, bounds } => check_core_comptime_binding(state, world, host, name, ty, value, bounds, span),
        Stmt::Assign { target, op, value, .. } => check_core_stmt_assign(state, world, host, target, op, value, span),
        Stmt::While { cond, body } => check_core_stmt_while(state, world, host, cond, body, span),
        Stmt::For { bindings, shape, mutable, mut_names, iter, body } => check_core_stmt_for(state, world, host, bindings, shape, mutable, mut_names, iter, body, span),
        Stmt::Return(value) => check_core_stmt_return(state, world, host, value, span),
        Stmt::Break => check_core_stmt_jump(state, "break", span),
        Stmt::Continue => check_core_stmt_jump(state, "continue", span),
        // **One site, not two.**
        Stmt::Expr(expr) => check_core_expr(state, world, host, expr, span),
        Stmt::Emit(value) => check_core_stmt_emit(state, world, host, value, span),
    }
}

/// **`emit item`** (ADR-grammar-typed-read-v1 D7, amended 2026-11-18, #2061): only in
/// the action of a rule a `@stream` entry reaches (`NK1371`), and the item
/// has the entry's item type. Whether the parse could still undo it is the
/// grammar's question (`grammar_emits_undone`, `NK1370`).
fn check_core_stmt_emit[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, value: ref Expr, span: ref Span) -> Ty sync {
    let found = check_core_expr(state, world, host, value, span)
    match state.emitting {
        item => state.expect_type(world, found, item.clone(), span, "argument", fn(was, wanted) { f"This `emit` hands over `{was}`, but the `@stream` entry's items are `{wanted}`." }),
        null => {
            let notes: Vec[String] = ["An item goes to the walk of a `@stream` entry (ADR-grammar-typed-read-v1 D7): `for item in G::entry(input)` sees it as the parser produces it. A function, or a rule no `@stream` entry reaches, has no walk to hand it to."]
            let help: String = if state.inside_an_action != null { "Reach this rule from a `@stream` entry, `@stream entry rule items -> Item = ...`, or let the action build its value instead." } else { "Return the value instead, or emit it from the action of a rule a `@stream` entry reaches." }
            state.findings.push(check_refusal("NK1371", span, "`emit` hands an item to the walk of a `@stream` entry, but no `@stream` entry reaches this place.", notes, help))
        },
    }
    return Ty::Unknown
}

/// A `break` or a `continue`.
fn check_core_stmt_is_a_jump(stmt: ref Stmt) -> bool sync {
    return match stmt {
        Stmt::Break => true,
        Stmt::Continue => true,
        else => false,
    }
}

/// **A loop body's value is never used** (#596): its tail `if` or `match` is a
/// statement, and its arms are not asked for a common type.
fn check_core_stmt_body_discarded(mut state: CheckState, body: ref Block) sync {
    let count = body.stmts.len() as i64
    if count == 0 {
        return
    }
    match body.stmts[count - 1].node {
        Stmt::Expr(value) => {
            state.discarded.insert(id_of(value) as i64)
        },
        else => {},
    }
}

/// **Walk a block and hand back the type of its tail.**
/// **A lambda bound by `let` without a type takes it from its first use**
/// (#997), as an empty list takes its element type from its first (ADR-135
/// D2): the `fn` type of the parameter of a function it is first handed to,
/// in the rest of the block. Its body is then checked, and lowered, as the
/// same lambda written into that call is.
fn check_core_stmt_lambda_by_use[H: CheckHost](world: ref CheckWorld, host: ref H, stmt: ref Stmt, block: ref Block, at: i64) -> Ty? sync {
    let name: String = match stmt {
        Stmt::Let { names, ty, value, .. } => {
            if ty != null || names.len() != 1 || !check_core_stmt_an_untyped_lambda(value) {
                return null
            }
            world.words.resolve(names[0]).clone()
        },
        else => return null,
    }
    let mut i = at + 1
    while i < block.stmts.len() as i64 {
        let found: Ty? = check_core_stmt_handed_to(world, host, name, block.stmts[i].node)
        if found != null {
            return found
        }
        i += 1
    }
    return null
}

/// Whether `value` is a lambda that names parameters.
fn check_core_stmt_an_untyped_lambda(value: ref Expr) -> bool sync {
    return match value {
        Expr::Closure { params, .. } => params.len() > 0,
        else => false,
    }
}

/// The `fn` type a statement first hands `name` to as an argument, in it or
/// in a block it holds.
fn check_core_stmt_handed_to[H: CheckHost](world: ref CheckWorld, host: ref H, name: ref String, stmt: ref Stmt) -> Ty? sync {
    for expr in check_visit_stmt(stmt) {
        let found: Ty? = check_core_stmt_handed_in(world, host, name, expr)
        if found != null {
            return found
        }
    }
    for inner in check_visit_stmt_blocks(stmt) {
        for each in inner.stmts {
            let found: Ty? = check_core_stmt_handed_to(world, host, name, each.node)
            if found != null {
                return found
            }
        }
    }
    return null
}

/// The `fn` type one expression hands `name` to as an argument, or a call in
/// a hole of it does (#1046: `println(f"{apply(add)}")`).
fn check_core_stmt_handed_in[H: CheckHost](world: ref CheckWorld, host: ref H, name: ref String, expr: ref Expr) -> Ty? sync {
    if check_visit_has_holes(expr) {
        for hole in host.literal_holes(expr) {
            for inner in check_visit_preorder(hole) {
                let found: Ty? = check_core_stmt_handed_in(world, host, name, inner)
                if found != null {
                    return found
                }
            }
        }
    }
    match expr {
        Expr::Call { func, args, .. } => {
            let mut at = 0
            for arg in args {
                let named = match arg {
                    Expr::Variable(n, _) => world.words.resolve(n) == name,
                    else => false,
                }
                if named {
                    let want: Ty? = check_core_stmt_code_parameter(world, func, at)
                    if want != null {
                        return want
                    }
                }
                at += 1
            }
        },
        else => {},
    }
    return null
}

/// The type of the parameter at `at` of the function `func` names, where it
/// is a `fn` type.
fn check_core_stmt_code_parameter(world: ref CheckWorld, func: ref Expr, at: i64) -> Ty? sync {
    let callee: String = match func {
        Expr::Variable(n, _) => world.words.resolve(n).clone(),
        else => return null,
    }
    let resolved: CheckResolved = resolve_call(world, callee) ?? return null
    let expected = expected_arguments(resolved.contract)
    // A callee that keeps it types it too: the use makes the `let`'s lambda a
    // kept one (#1043, `check_core_a_kept_lambda`).
    if at >= expected.len() as i64 {
        return null
    }
    return match expected[at] {
        Ty::Fn { .. } => expected[at].clone(),
        else => null,
    }
}

fn check_core_block[H: CheckHost](mut state: CheckState, world: ref CheckWorld, host: ref H, block: ref Block) -> Ty sync {
    let ends_group = check_async_group_ended(state, block)
    check_async_block(state, world, block)
    state.scope.push([])
    let mut tail = check_core_stmt_unit()
    let count = block.stmts.len() as i64
    let mut last = count - 1
    if last < 0 {
        last = 0
    }
    let mut at = 0
    for stmt in block.stmts {
        if at < last {
            match stmt.node {
                Stmt::Expr(value) => {
                    state.discarded.insert(id_of(value) as i64)
                },
                else => {},
            }
        }
        state.flow.let_lambda_use = check_core_stmt_lambda_by_use(world, host, stmt.node, block, at)
        let ty = check_core_stmt(state, world, host, stmt.node, stmt.span)
        state.coalesces_not_lent_are_taken(world)
        state.failing_cleanups_bound()
        // **`break i` is two statements, and that is the point**: asked of the
        // next statement's span, because that is what the author would delete.
        if at < last && check_core_stmt_is_a_jump(stmt.node) {
            state.nothing_follows_a_jump(stmt.node, block.stmts[at + 1].span)
        }
        if at == last {
            tail = ty
        }
        at += 1
    }
    check_crossings_a_bound_handle_is_taken(state, world, block)
    // **The block's value leaves it** (#1323): `{ let r = ...; r }` hands `r`
    // on as `return r` does.
    if count > 0 {
        match block.stmts[count - 1].node {
            Stmt::Expr(value) => state.a_pausing_cleanup_returned(world, value),
            else => {},
        }
    }
    state.failing_cleanups_settled()
    if count > 0 {
        state.views_end(state.scope.len() as i64 - 1, block.stmts[count - 1].span.end as i64)
    }
    // **Before the block's names go**: a door on a lock bound in this block
    // is a touch of that lock, named by its binding (#985).
    if ends_group != null {
        state.tasks_meet_on_nothing(world, block, ends_group ?? 0)
    }
    check_core_view_lists_end(state, world, block)
    check_core_place_in_block(state, world, block)
    check_core_place_boxes(state, world, block)
    state.scope.pop()
    return tail
}

/// **A list of views ends before what it views** (#490, supervisor
/// 2026-11-09): a block's `List` has no `#[may_dangle]` drop on stable Rust,
/// so a list of views keeps what it views borrowed until it is dropped, where
/// Rust's `Vec` ended the borrow at the last use. For a `let` of this block
/// that binds such a list:
/// - where a later statement than its last use reads what its value was made
///   of (moves, returns or writes it), the statement of the last use is
///   recorded in `facts.view_list_drops`, and the emitter drops the list
///   right after it;
/// - where a later `let` binds what it may view (a name read by a statement
///   that also reads the list), that `let` is recorded in
///   `facts.view_list_rebinds`, and the emitter binds the list again right
///   after it, so the list is declared after what it views and dropped
///   first, on every way out of the scope. A drop at the last use would not
///   do: a panic before it drops the list after what it views. So is a
///   value that holds a list of text (`check_core_holds_a_list_of_text`),
///   whose text the lowering may make views.
///
/// Asked before the block's names go, while the bindings' types are still in
/// scope; a name bound twice in the block is left alone. An assignment over a
/// text that collects views of it in its own value is
/// `check_core_view_list_assigned`'s.
fn check_core_view_lists_end(mut state: CheckState, world: ref CheckWorld, block: ref Block) sync {
    let count = block.stmts.len() as i64
    let mut at = 0
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, value, .. } => {
                if names.len() == 1 {
                    let name = f"{world.words.resolve(names[0])}"
                    let views = check_core_a_list_of_views(state, name)
                    if check_core_view_list_bound_once(world, block, name) && (views || check_core_holds_a_list_of_text(state, name)) {
                        let mut last = at
                        let mut sources: collections::BTreeSet[String] = collections::BTreeSet()
                        names_in(value, world.words, sources)
                        let mut later = at + 1
                        while later < count {
                            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
                            names_in_statement(block.stmts[later].node, world.words, read)
                            if read.contains(name) {
                                last = later
                            }
                            later += 1
                        }
                        let mut needed = false
                        later = last + 1
                        while later < count {
                            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
                            names_in_statement(block.stmts[later].node, world.words, read)
                            for source in sources {
                                if read.contains(source) {
                                    needed = true
                                }
                            }
                            later += 1
                        }
                        if views && needed && !check_core_stmt_is_a_jump(block.stmts[last].node) {
                            let key = block.stmts[last].span.start as i64
                            let mut ended = state.facts.view_list_drops.get(key)?.clone() ?? []
                            ended.push(name.clone())
                            state.facts.view_list_drops.insert(key, ended)
                        }
                        let viewed_ty = if views { check_core_viewed_name(state, name) } else { "String" }
                        check_core_view_list_rebound(state, world, block, name, at, last, stmt.span.start as i64, viewed_ty)
                    }
                }
            },
            Stmt::Assign { target, op, value } => check_core_view_list_assigned(state, world, target, op, value, stmt.span.start as i64),
            else => {},
        }
        at += 1
    }
}

/// **The `let`s after the list `name`'s** (at `at`), before its last use
/// `last`, **that bind what it may view**: a name a statement up to `last`
/// reads together with the list, which is not a number, a `bool` or a `char`.
/// Each is recorded in `facts.view_list_rebinds`, with whether the list's
/// `let` said `mut`, and the list's `let` (at `start`) in
/// `facts.view_list_rebound`. What it may view is a binding whose type names
/// the type its elements view.
///
/// **Not past a `let` that reads the list** into anything but a number, a
/// `bool` or a `char`: a view of it, or a lambda over it, may still be read,
/// and the list cannot move while it is.
fn check_core_view_list_rebound(mut state: CheckState, world: ref CheckWorld, block: ref Block, name: ref String, at: i64, last: i64, start: i64, viewed_ty: ref String) sync {
    if viewed_ty == "" {
        return
    }
    let mut together: collections::BTreeSet[String] = collections::BTreeSet()
    let mut later = at + 1
    while later <= last {
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        names_in_statement(block.stmts[later].node, world.words, read)
        if read.contains(name) {
            for one in read {
                together.insert(one.clone())
            }
        }
        later += 1
    }
    let changing = state.binding(name)?.written_mut ?? false
    later = at + 1
    while later < last {
        match block.stmts[later].node {
            Stmt::Let { names, value, .. } => {
                let mut reads: collections::BTreeSet[String] = collections::BTreeSet()
                names_in(value, world.words, reads)
                if reads.contains(name) {
                    for one in names {
                        if !check_core_a_plain_binding(state, f"{world.words.resolve(one)}") {
                            return
                        }
                    }
                }
                let mut viewed = false
                for one in names {
                    let named = f"{world.words.resolve(one)}"
                    if together.contains(named) && check_core_a_binding_naming(state, named, viewed_ty) {
                        viewed = true
                    }
                }
                if viewed {
                    let key = block.stmts[later].span.start as i64
                    let mut rebound = state.facts.view_list_rebinds.get(key)?.clone() ?? []
                    rebound.push((name.clone(), changing))
                    state.facts.view_list_rebinds.insert(key, rebound)
                    state.facts.view_list_rebound.insert(start)
                }
            },
            else => {},
        }
        later += 1
    }
}

/// **An assignment whose own value collects views of what it assigns over**
/// (#490): `s = s.split("{").collect()[0].trim().clone()`. The list the value
/// collected is a temporary, dropped at the statement's end, after the new
/// text is in place; a block's `List` holds what it views until then. The
/// statement is recorded in `facts.view_list_assigns`, and the emitter binds
/// the value before the assignment, so the list ends first.
fn check_core_view_list_assigned(mut state: CheckState, world: ref CheckWorld, target: ref Expr, op: ref BinaryOp?, value: ref Expr, at: i64) sync {
    if op != null {
        return
    }
    let assigned = match target {
        Expr::Variable(name, _) => f"{world.words.resolve(name)}",
        else => return,
    }
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    names_in(value, world.words, read)
    if !read.contains(assigned) {
        return
    }
    for inner in visited_in_expr(value) {
        let listed = match inner {
            Expr::MethodCall { method, .. } => world.words.resolve(method) == "collect",
            Expr::ListLit { .. } => true,
            else => false,
        }
        if listed {
            state.facts.view_list_assigns.insert(at)
            return
        }
    }
}

/// **Which list literals go in the task's block** (ADR-327 D9, step 5 of
/// #490). A list is placed where it cannot outlive the task: bound once in
/// this block by a `let` of its own, a `Vec` whose elements are no views
/// and no functions, and every later use of the name proven local - a
/// method of the list that keeps it where it is, an index, a `for` over
/// it, a hole of an `f"…"`. Anything else - handed to a call, moved into a
/// value, a closure, a task or a group, returned, a method not on the list
/// - keeps it outside, as does every case not named here: conservative,
/// because a value of the block freed by another task would be freed in
/// the wrong place.
fn check_core_place_in_block(mut state: CheckState, world: ref CheckWorld, block: ref Block) sync {
    let count = block.stmts.len() as i64
    let mut at = 0
    while at < count {
        match block.stmts[at].node {
            Stmt::Let { names, value, mutable, .. } => {
                // **A text a task builds for itself** (#490 step 5): a
                // `let mut s = String()` that stays in its function grows in
                // the block, keyed by the `String` it calls.
                if names.len() == 1 && mutable && check_core_placeable_text(world, value) {
                    let name = f"{world.words.resolve(names[0])}"
                    if check_core_a_plain_text(state, name) && check_core_view_list_bound_once(world, block, name) {
                        let mut local = true
                        let mut later = at + 1
                        while later < count && local {
                            local = check_core_stays_in_stmt(state, world, block.stmts[later].node, name)
                            later += 1
                        }
                        if local {
                            match value {
                                Expr::Call { func, .. } => state.facts.placed_in_block.insert(node_key(func)),
                                else => {},
                            }
                        }
                    }
                }
                if names.len() == 1 && check_core_placeable_literal(value) {
                    let name = f"{world.words.resolve(names[0])}"
                    if check_core_a_plain_list(state, name) && check_core_view_list_bound_once(world, block, name) {
                        let mut local = true
                        let mut later = at + 1
                        while later < count && local {
                            local = check_core_stays_in_stmt(state, world, block.stmts[later].node, name)
                            later += 1
                        }
                        if local {
                            state.facts.placed_in_block.insert(node_key(value))
                        }
                    }
                }
            },
            else => {},
        }
        at += 1
    }
}

/// Whether `value` is a list literal the emitter can place.
fn check_core_placeable_literal(value: ref Expr) -> bool sync {
    return match value {
        Expr::ListLit { .. } => true,
        else => false,
    }
}

/// Whether `value` is `String()`, an empty text the emitter can place.
fn check_core_placeable_text(world: ref CheckWorld, value: ref Expr) -> bool sync {
    return match value {
        Expr::Call { func, args, config, .. } => args.len() == 0 && config.iter().all(fn(option) { world.words.resolve(option.name) == "capacity" }) && match func {
            Expr::Variable(found, _) => world.words.resolve(found) == "String",
            else => false,
        },
        else => false,
    }
}

/// Whether `name` is bound, in this scope, to an owned `String`.
fn check_core_a_plain_text(state: ref CheckState, name: ref String) -> bool sync {
    let found = state.binding(name) ?? return false
    return match found.ty {
        Ty::Named { name, args, view } => !view && name == "String" && args.len() == 0,
        else => false,
    }
}

/// Whether `name` is bound, in this scope, to a `Vec` whose elements are
/// neither views nor functions. A list written in number literals no
/// annotation typed (`[4, 5]`, ADR-285 D34) holds numbers whose type its
/// uses decide later: `Unknown` here, and plain all the same (#2349).
fn check_core_a_plain_list(state: ref CheckState, name: ref String) -> bool sync {
    let found = state.binding(name) ?? return false
    return match found.ty {
        Ty::Named { name, args, view } => !view && name == "Vec" && args.len() == 1 && match args[0] {
            Ty::Named { view, .. } => !view,
            Ty::Tuple(_) => true,
            Ty::Unknown => state.flow.open_elements.contains_key(found.id),
            else => false,
        },
        else => false,
    }
}

/// Whether `expr` is the name itself.
fn check_core_is_the_name(world: ref CheckWorld, expr: ref Expr, name: ref String) -> bool sync {
    return match expr {
        Expr::Variable(found, _) => world.words.resolve(found) == name,
        else => false,
    }
}

/// Whether a method of a list keeps it where it is: it reads it, changes
/// it in place or hands out an element, never the list's memory itself
/// (`clone`, `split_off`, `into_iter` and the rest are not here).
fn check_core_kept_method(method: ref String) -> bool sync {
    return method == "len" || method == "is_empty" || method == "push" || method == "pop" || method == "get" || method == "first" || method == "last" || method == "contains" || method == "iter" || method == "iter_mut" || method == "sort" || method == "sort_by" || method == "sort_by_key" || method == "reverse" || method == "clear" || method == "insert" || method == "remove" || method == "swap" || method == "truncate" || method == "extend" || method == "join" || method == "resize" || method == "retain" || method == "dedup"
}

/// Whether a method of a text keeps it where it is: it reads it or changes
/// it in place, and hands out no text and no view of it.
fn check_core_kept_text_method(method: ref String) -> bool sync {
    return method == "len" || method == "is_empty" || method == "push" || method == "push_str" || method == "pop" || method == "contains" || method == "starts_with" || method == "ends_with" || method == "clear" || method == "truncate" || method == "insert" || method == "insert_str" || method == "remove"
}

/// Whether a statement after the binding uses `name` only where it stays.
fn check_core_stays_in_stmt(state: ref CheckState, world: ref CheckWorld, stmt: ref Stmt, name: ref String) -> bool sync {
    return match stmt {
        Stmt::Let { value, .. } => check_core_stays_in(state, world, value, name),
        Stmt::Comptime { value, .. } => check_core_stays_in(state, world, value, name),
        Stmt::Expr(value) => check_core_stays_in(state, world, value, name),
        Stmt::Emit(value) => check_core_stays_in(state, world, value, name),
        Stmt::Assign { target, value, .. } => check_core_stays_in_target(state, world, target, name) && check_core_stays_in(state, world, value, name),
        Stmt::For { iter, body, .. } => (check_core_is_the_name(world, iter, name) || check_core_stays_in(state, world, iter, name)) && check_core_stays_in_block(state, world, body, name),
        Stmt::While { cond, body } => check_core_stays_in(state, world, cond, name) && check_core_stays_in_block(state, world, body, name),
        Stmt::Return(value) => check_core_stays_in(state, world, value ?? return true, name),
        Stmt::Break => true,
        Stmt::Continue => true,
    }
}

/// Whether an assignment's target writes the list, an element of it or a
/// field of one, or does not touch it.
fn check_core_stays_in_target(state: ref CheckState, world: ref CheckWorld, target: ref Expr, name: ref String) -> bool sync {
    return match target {
        Expr::Variable(_, _) => true,
        Expr::Index { base, index, .. } => (check_core_is_the_name(world, base, name) || check_core_stays_in_target(state, world, base, name)) && check_core_stays_in(state, world, index, name),
        Expr::Field { base, .. } => check_core_stays_in_target(state, world, base, name),
        else => check_core_stays_in(state, world, target, name),
    }
}

/// Whether every statement of a block uses `name` only where it stays.
fn check_core_stays_in_block(state: ref CheckState, world: ref CheckWorld, block: ref Block, name: ref String) -> bool sync {
    for stmt in block.stmts {
        if !check_core_stays_in_stmt(state, world, stmt.node, name) {
            return false
        }
    }
    return true
}

/// Whether each of `exprs` uses `name` only where it stays.
fn check_core_stays_in_all(state: ref CheckState, world: ref CheckWorld, exprs: ref Vec[Expr], name: ref String) -> bool sync {
    for expr in exprs {
        if !check_core_stays_in(state, world, expr, name) {
            return false
        }
    }
    return true
}

/// **Whether `expr` uses `name` only where the list stays in its task**: an
/// expression that does not mention it does; the name itself, bare, does
/// not (it is moved or lent somewhere this walk does not follow).
fn check_core_stays_in(state: ref CheckState, world: ref CheckWorld, expr: ref Expr, name: ref String) -> bool sync {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    names_in(expr, world.words, read)
    if !read.contains(name) {
        return true
    }
    return match expr {
        Expr::MethodCall { receiver, method, args, config, .. } => {
            if config.len() > 0 {
                return false
            }
            if check_core_is_the_name(world, receiver, name) {
                let described = state.facts.method_callees.get(id_of(receiver) as i64)
                let called = world.words.resolve(method)
                let kept = if check_core_a_plain_text(state, name) { check_core_kept_text_method(called) } else { check_core_kept_method(called) && (described?.starts_with("Vec::") ?? true) }
                kept && check_core_stays_in_all(state, world, args, name)
            } else {
                check_core_stays_in(state, world, receiver, name) && check_core_stays_in_all(state, world, args, name)
            }
        },
        Expr::Index { base, index, .. } => (check_core_is_the_name(world, base, name) || check_core_stays_in(state, world, base, name)) && check_core_stays_in(state, world, index, name),
        Expr::Field { base, .. } => check_core_stays_in(state, world, base, name),
        Expr::Binary { lhs, rhs, .. } => check_core_stays_in(state, world, lhs, name) && check_core_stays_in(state, world, rhs, name),
        Expr::Unary { expr, .. } => check_core_stays_in(state, world, expr, name),
        Expr::Cast { expr, .. } => check_core_stays_in(state, world, expr, name),
        Expr::Try(inner, _) => check_core_stays_in(state, world, inner, name),
        // An option's value is read as an argument is: `Vec(capacity:
        // xs.len())` keeps `xs` where it is (#2114).
        Expr::Call { func, args, config, .. } => check_core_stays_in(state, world, func, name) && check_core_stays_in_all(state, world, args, name) && config.iter().all(fn(option) { check_core_stays_in(state, world, option.value, name) }),
        Expr::Tuple(parts, _) => check_core_stays_in_all(state, world, parts, name),
        Expr::ListLit { items, .. } => check_core_stays_in_all(state, world, items, name),
        // A field value is read as a list item is: `Row { n: xs.len() }`
        // keeps `xs` where it is, `Row { xs }` moves it in (#2323).
        Expr::StructLit { fields, .. } => fields.iter().all(fn(field) { check_core_stays_in_field(state, world, field, name) }),
        Expr::Coalesce { value, fallback, .. } => check_core_stays_in(state, world, value, name) && check_core_stays_in(state, world, fallback, name),
        Expr::Range { start, end, .. } => check_core_stays_in(state, world, start, name) && check_core_stays_in(state, world, end, name),
        Expr::Block(inner, _) => check_core_stays_in_block(state, world, inner, name),
        Expr::If { cond, then_branch, else_branch, .. } => check_core_stays_in(state, world, cond, name) && check_core_stays_in_block(state, world, then_branch, name) && check_core_stays_in_block(state, world, else_branch ?? return true, name),
        Expr::Match { value, arms, .. } => {
            if !check_core_stays_in(state, world, value, name) {
                return false
            }
            for arm in arms {
                if !check_core_stays_in(state, world, arm.body, name) || !check_core_stays_in(state, world, arm.guard ?? continue, name) {
                    return false
                }
            }
            true
        },
        Expr::Throw(thrown, _) => check_core_stays_in(state, world, thrown, name),
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => {
                        if !check_core_is_the_name(world, expr, name) && !check_core_stays_in(state, world, expr, name) {
                            return false
                        }
                    },
                    FPart::Text(_) => {},
                }
            }
            true
        },
        else => false,
    }
}

/// Whether a struct literal's field keeps `name` where it is: its value
/// does, or, written without one (`Row { xs }`), it names another binding.
fn check_core_stays_in_field(state: ref CheckState, world: ref CheckWorld, field: ref FieldInit, name: ref String) -> bool sync {
    return match field.value {
        null => f"{world.words.resolve(field.name)}" != name,
        value => check_core_stays_in(state, world, value, name),
    }
}

/// Whether `name` is bound, in this scope, to a number, a `bool` or a `char`.
fn check_core_a_plain_binding(state: ref CheckState, name: ref String) -> bool sync {
    let found = state.binding(name) ?? return false
    return a_copy_by_value(found.ty)
}

/// **Whether `name` is bound to a value that holds a list of text**: a
/// `Vec[String]`, or a struct of this program with such a field, whose text
/// the lowering may make views (ADR-282) that the list holds until it is
/// dropped.
fn check_core_holds_a_list_of_text(state: ref CheckState, name: ref String) -> bool sync {
    let found = state.binding(name) ?? return false
    return check_core_ty_holds_a_list_of_text(state, found.ty, 3)
}

fn check_core_ty_holds_a_list_of_text(state: ref CheckState, ty: ref Ty, depth: i64) -> bool sync {
    if depth == 0 {
        return false
    }
    match ty {
        Ty::Named { name, args, view } => {
            if view {
                return false
            }
            if name == "Vec" && args.len() == 1 && check_core_ty_last_name(args[0]) == "String" {
                return true
            }
            for field in state.structs.get(name)?.clone() ?? [] {
                if check_core_ty_holds_a_list_of_text(state, field.ty, depth - 1) {
                    return true
                }
            }
            return false
        },
        Ty::Nullable(inner) => return check_core_ty_holds_a_list_of_text(state, inner, depth),
        else => return false,
    }
}

/// The type the elements of the list `name` view, by its last name, text's
/// two forms as one: `String` for `Vec[ref String]`, `Expr` for `Vec[ref
/// Expr]`; empty where it is none of these.
fn check_core_viewed_name(state: ref CheckState, name: ref String) -> String sync {
    let found = state.binding(name) ?? return ""
    return match found.ty {
        Ty::Named { args, .. } => if args.len() == 1 { check_core_ty_last_name(args[0]) } else { "" },
        else => "",
    }
}

/// A named type's last name, text's two forms as one; empty for any other.
fn check_core_ty_last_name(ty: ref Ty) -> String sync {
    return match ty {
        Ty::Named { name, .. } => check_core_text_as_one(name),
        else => "",
    }
}

fn check_core_text_as_one(name: ref String) -> String {
    let last = type_last_segment(name)
    if last == "str" {
        return "String"
    }
    return f"{last}"
}

/// Whether `name` is bound, in this scope, to a type that names `viewed`
/// anywhere in it, or to one the checker does not know.
fn check_core_a_binding_naming(state: ref CheckState, name: ref String, viewed: ref String) -> bool sync {
    let found = state.binding(name) ?? return true
    return check_core_ty_names(found.ty, viewed)
}

fn check_core_ty_names(ty: ref Ty, viewed: ref String) -> bool sync {
    return match ty {
        Ty::Unknown => true,
        Ty::Named { name, args, .. } => {
            if check_core_text_as_one(name) == viewed {
                return true
            }
            for arg in args {
                if check_core_ty_names(arg, viewed) {
                    return true
                }
            }
            false
        },
        Ty::Tuple(parts) => {
            for part in parts {
                if check_core_ty_names(part, viewed) {
                    return true
                }
            }
            false
        },
        Ty::Nullable(inner) => check_core_ty_names(inner, viewed),
        else => true,
    }
}

/// **Which boxes of a recursive type go in the task's block** (ADR-327
/// D16, #2406). A box site - a variant with a boxed part, a struct with a
/// boxed field (ADR-246) - is placed where the tree it builds cannot
/// outlive the task, one function at a time: bound in this block by a
/// `let` of its own, and every later use of the name proven local - lent
/// to a `ref` parameter, matched with every name its arms bind used so in
/// turn, read in a comparison or an `f"…"` hole, or rebuilt in place (`t =
/// Tree::Node(t, …)`, whose site goes in the block too). Anything else -
/// returned (that is D17's, across calls), handed over by value, moved
/// into a value, a closure, a task or a group, every case not named here -
/// keeps it outside (D9). Each site is written down with its place and
/// the reason, for `--sharing`.
fn check_core_place_boxes(mut state: CheckState, world: ref CheckWorld, block: ref Block) sync {
    if state.facts.boxed_members.len() == 0 {
        return
    }
    let function = state.current?.clone() ?? ""
    let count = block.stmts.len() as i64
    let mut at = 0
    while at < count {
        match block.stmts[at].node {
            Stmt::Let { names, value, .. } => {
                if names.len() == 1 && check_core_box_site(state, world, value).len() > 0 {
                    let name = f"{world.words.resolve(names[0])}"
                    let mut reason: String = if check_core_view_list_bound_once(world, block, name) { "" } else { "its name is bound again in this block" }
                    let mut later = at + 1
                    while later < count && reason.len() == 0 {
                        reason = check_core_tree_stays_in_stmt(state, world, block.stmts[later].node, name)
                        later += 1
                    }
                    let mut sites: Vec[(i64, String)] = []
                    check_core_box_sites_built(state, world, value, sites)
                    let mut rest = at + 1
                    while rest < count {
                        check_core_tree_rebuilt_sites(state, world, block.stmts[rest].node, name, sites)
                        rest += 1
                    }
                    for (key, site) in sites {
                        if reason.len() == 0 {
                            state.facts.placed_in_block.insert(key)
                            state.facts.box_sites.insert(key, f"{function}: `{site}` in the block: `{name}` stays in this function")
                        } else if !state.facts.box_sites.contains_key(key) {
                            state.facts.box_sites.insert(key, f"{function}: `{site}` outside: `{name}` {reason}")
                        }
                    }
                }
            },
            else => {},
        }
        at += 1
    }
    // **Every other site is built outside** (D9), with the reason its shape
    // gives.
    at = 0
    while at < count {
        let last = at == count - 1
        match block.stmts[at].node {
            Stmt::Let { value, .. } => check_core_box_sites_outside(state, world, value, function, "it is handed on as a value"),
            Stmt::Expr(value) => check_core_box_sites_outside(state, world, value, function, if last { "it is its block's value, which leaves the block (across calls, ADR-327 D17)" } else { "it is handed on as a value" }),
            Stmt::Return(value) => match value {
                null => {},
                given => check_core_box_sites_outside(state, world, given, function, "it is returned (across calls, ADR-327 D17)"),
            },
            Stmt::Assign { value, .. } => check_core_box_sites_outside(state, world, value, function, "it is stored into a place"),
            else => {},
        }
        at += 1
    }
}

/// **The box site `expr` is**, by its type (`Tree::Node`, `Tree`), or empty:
/// a variant call with a boxed part, a struct literal with a boxed field
/// (ADR-246), named as the emitter's `is_boxed` names them.
fn check_core_box_site(state: ref CheckState, world: ref CheckWorld, expr: ref Expr) -> String sync {
    match expr {
        Expr::Call { func, args, .. } => {
            match func {
                Expr::Path(segments, _) => {
                    if segments.len() < 2 {
                        return ""
                    }
                    let owner = f"{world.words.resolve(segments[segments.len() - 2])}"
                    let variant = f"{world.words.resolve(segments[segments.len() - 1])}"
                    let members = state.facts.boxed_members.get(owner) ?? return ""
                    for at in 0..<args.len() {
                        if members.contains(boxed_member(variant, at as i64, "")) {
                            return f"{owner}::{variant}"
                        }
                    }
                    return ""
                },
                else => return "",
            }
        },
        Expr::StructLit { name, fields, .. } => {
            let written = f"{world.words.resolve(name)}"
            let parts: Vec[String] = written.split("::").collect()
            let mut owner = written.clone()
            let mut variant: String = String()
            if parts.len() >= 2 && state.facts.boxed_members.contains_key(parts[parts.len() - 2]) {
                owner = parts[parts.len() - 2].clone()
                variant = parts[parts.len() - 1].clone()
            }
            let members = state.facts.boxed_members.get(owner) ?? return ""
            for field in fields {
                let named = f"{world.words.resolve(field.name)}"
                let member = if variant.len() > 0 { boxed_member(variant, -1, named) } else { named }
                if members.contains(member) {
                    return written
                }
            }
            return ""
        },
        else => return "",
    }
}

/// The key the emitter asks a box site by: a variant call's callee, a
/// struct literal itself.
fn check_core_box_site_key(expr: ref Expr) -> i64 sync {
    return match expr {
        Expr::Call { func, .. } => node_key(func),
        else => node_key(expr),
    }
}

/// **The box sites a tree is built by**: `expr` where it is one, and the
/// sites written straight into its parts (`Tree::Node(Tree::Node(…), …)`).
fn check_core_box_sites_built(state: ref CheckState, world: ref CheckWorld, expr: ref Expr, mut sites: Vec[(i64, String)]) sync {
    let site = check_core_box_site(state, world, expr)
    if site.len() == 0 {
        return
    }
    sites.push((check_core_box_site_key(expr), site))
    match expr {
        Expr::Call { args, .. } => {
            for arg in args {
                check_core_box_sites_built(state, world, arg, sites)
            }
        },
        Expr::StructLit { fields, .. } => {
            for field in fields {
                check_core_box_sites_built(state, world, field.value ?? continue, sites)
            }
        },
        else => {},
    }
}

/// The sites of each `name = …` that rebuilds the tree in place, in `stmt`
/// and the loops and blocks under it.
fn check_core_tree_rebuilt_sites(state: ref CheckState, world: ref CheckWorld, stmt: ref Stmt, name: ref String, mut sites: Vec[(i64, String)]) sync {
    match stmt {
        Stmt::Assign { target, value, .. } => {
            if check_core_is_the_name(world, target, name) {
                check_core_box_sites_built(state, world, value, sites)
            }
        },
        Stmt::For { body, .. } => {
            for inner in body.stmts {
                check_core_tree_rebuilt_sites(state, world, inner.node, name, sites)
            }
        },
        Stmt::While { body, .. } => {
            for inner in body.stmts {
                check_core_tree_rebuilt_sites(state, world, inner.node, name, sites)
            }
        },
        else => {},
    }
}

/// **The sites in `expr` no `let` of their own placed**, written down as
/// built outside, for `reason`.
fn check_core_box_sites_outside(mut state: CheckState, world: ref CheckWorld, expr: ref Expr, function: ref String, reason: ref String) sync {
    let site = check_core_box_site(state, world, expr)
    if site.len() > 0 && !state.facts.box_sites.contains_key(check_core_box_site_key(expr)) {
        state.facts.box_sites.insert(check_core_box_site_key(expr), f"{function}: `{site}` outside: {reason}")
    }
    match expr {
        Expr::Call { func, args, .. } => {
            let inner = if site.len() > 0 { reason } else { "it is handed on as a value" }
            check_core_box_sites_outside(state, world, func, function, inner)
            for arg in args {
                check_core_box_sites_outside(state, world, arg, function, inner)
            }
        },
        Expr::MethodCall { receiver, args, .. } => {
            check_core_box_sites_outside(state, world, receiver, function, "it is handed on as a value")
            for arg in args {
                check_core_box_sites_outside(state, world, arg, function, "it is handed on as a value")
            }
        },
        Expr::StructLit { fields, .. } => {
            let inner = if site.len() > 0 { reason } else { "it is moved into a value" }
            for field in fields {
                check_core_box_sites_outside(state, world, field.value ?? continue, function, inner)
            }
        },
        Expr::Tuple(parts, _) => {
            for part in parts {
                check_core_box_sites_outside(state, world, part, function, "it is moved into a value")
            }
        },
        Expr::ListLit { items, .. } => {
            for item in items {
                check_core_box_sites_outside(state, world, item, function, "it is moved into a value")
            }
        },
        Expr::Match { arms, .. } => {
            for arm in arms {
                check_core_box_sites_outside(state, world, arm.body, function, reason)
            }
        },
        Expr::Coalesce { value, fallback, .. } => {
            check_core_box_sites_outside(state, world, value, function, reason)
            check_core_box_sites_outside(state, world, fallback, function, reason)
        },
        Expr::Try(inner, _) => check_core_box_sites_outside(state, world, inner, function, reason),
        else => {},
    }
}

/// **Whether a statement after the tree's `let` keeps it in its task**:
/// empty where it does, else why it does not.
fn check_core_tree_stays_in_stmt(state: ref CheckState, world: ref CheckWorld, stmt: ref Stmt, name: ref String) -> String sync {
    return match stmt {
        Stmt::Let { value, .. } => check_core_tree_stays_in(state, world, value, name),
        Stmt::Comptime { value, .. } => check_core_tree_stays_in(state, world, value, name),
        Stmt::Expr(value) => check_core_tree_stays_in(state, world, value, name),
        Stmt::Emit(value) => check_core_tree_stays_in(state, world, value, name),
        Stmt::Assign { target, value, .. } => {
            if check_core_is_the_name(world, target, name) {
                check_core_tree_rebuilt(state, world, value, name)
            } else {
                let at_target = check_core_tree_stays_in(state, world, target, name)
                if at_target.len() > 0 { at_target } else { check_core_tree_stays_in(state, world, value, name) }
            }
        },
        Stmt::For { iter, body, .. } => {
            let over = check_core_tree_stays_in(state, world, iter, name)
            if over.len() > 0 { over } else { check_core_tree_stays_in_block(state, world, body, name) }
        },
        Stmt::While { cond, body } => {
            let asked = check_core_tree_stays_in(state, world, cond, name)
            if asked.len() > 0 { asked } else { check_core_tree_stays_in_block(state, world, body, name) }
        },
        Stmt::Return(value) => check_core_tree_stays_in(state, world, value ?? return "", name),
        Stmt::Break => "",
        Stmt::Continue => "",
    }
}

fn check_core_tree_stays_in_block(state: ref CheckState, world: ref CheckWorld, block: ref Block, name: ref String) -> String sync {
    for stmt in block.stmts {
        let reason = check_core_tree_stays_in_stmt(state, world, stmt.node, name)
        if reason.len() > 0 {
            return reason
        }
    }
    return ""
}

/// **Whether `name = value` rebuilds the tree in place**: `value` does not
/// read it, or is a box site whose parts are the tree itself, sites built
/// so in turn, or parts that do not read it.
fn check_core_tree_rebuilt(state: ref CheckState, world: ref CheckWorld, value: ref Expr, name: ref String) -> String sync {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    names_in(value, world.words, read)
    if !read.contains(name) {
        return ""
    }
    if check_core_box_site(state, world, value).len() == 0 {
        return check_core_tree_stays_in(state, world, value, name)
    }
    let mut parts: Vec[Expr] = []
    match value {
        Expr::Call { args, .. } => {
            for arg in args {
                parts.push(arg.clone())
            }
        },
        Expr::StructLit { fields, .. } => {
            for field in fields {
                match field.value {
                    null => return "it is moved into a field written without its value",
                    given => parts.push(given.clone()),
                }
            }
        },
        else => {},
    }
    for part in parts {
        if !check_core_is_the_name(world, part, name) {
            let reason = check_core_tree_rebuilt(state, world, part, name)
            if reason.len() > 0 {
                return reason
            }
        }
    }
    return ""
}

/// Whether `expr` is the tree itself, or a field read off it.
fn check_core_tree_read(world: ref CheckWorld, expr: ref Expr, name: ref String) -> bool sync {
    return match expr {
        Expr::Field { base, .. } => check_core_is_the_name(world, base, name) || check_core_tree_read(world, base, name),
        else => check_core_is_the_name(world, expr, name),
    }
}

/// **Whether `expr` keeps the tree `name` in its task**: empty where it
/// does - it does not mention it, lends it to a `ref` parameter, matches
/// it, compares it or formats it - else the reason it does not.
fn check_core_tree_stays_in(state: ref CheckState, world: ref CheckWorld, expr: ref Expr, name: ref String) -> String sync {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    names_in(expr, world.words, read)
    if !read.contains(name) {
        return ""
    }
    let mut parts: Vec[Expr] = []
    match expr {
        Expr::Variable(_, _) => return "is moved or handed on as a value",
        Expr::Call { func, args, config, .. } => {
            for arg in args {
                if check_core_is_the_name(world, arg, name) {
                    if !state.facts.lent_args.contains(node_key(arg)) {
                        return "is handed to a call by value"
                    }
                } else {
                    parts.push(arg.clone())
                }
            }
            parts.push(func.clone())
            for option in config {
                parts.push(option.value.clone())
            }
        },
        Expr::MethodCall { receiver, args, .. } => {
            if check_core_tree_read(world, receiver, name) {
                return "has a method called on it"
            }
            for arg in args {
                if check_core_is_the_name(world, arg, name) {
                    if !state.facts.lent_args.contains(node_key(arg)) {
                        return "is handed to a call by value"
                    }
                } else {
                    parts.push(arg.clone())
                }
            }
            parts.push(receiver.clone())
        },
        Expr::Match { value, arms, .. } => {
            let matched = check_core_is_the_name(world, value, name)
            if !matched {
                parts.push(value.clone())
            }
            for arm in arms {
                let mut watched: Vec[String] = [name.clone()]
                if matched {
                    for bound in pattern_names(world, arm.pattern) {
                        watched.push(bound)
                    }
                }
                for one in watched {
                    let reason = check_core_tree_stays_in(state, world, arm.body, one)
                    if reason.len() > 0 {
                        return reason
                    }
                    match arm.guard {
                        null => {},
                        guard => {
                            let asked = check_core_tree_stays_in(state, world, guard, one)
                            if asked.len() > 0 {
                                return asked
                            }
                        },
                    }
                }
            }
        },
        Expr::Binary { lhs, rhs, .. } => {
            if !check_core_tree_read(world, lhs, name) {
                parts.push(lhs.clone())
            }
            if !check_core_tree_read(world, rhs, name) {
                parts.push(rhs.clone())
            }
        },
        Expr::Unary { expr, .. } => parts.push(expr.clone()),
        Expr::Cast { expr, .. } => parts.push(expr.clone()),
        Expr::Try(inner, _) => parts.push(inner.clone()),
        Expr::Tuple(items, _) => {
            for item in items {
                parts.push(item.clone())
            }
        },
        Expr::ListLit { items, .. } => {
            for item in items {
                parts.push(item.clone())
            }
        },
        Expr::StructLit { fields, .. } => {
            for field in fields {
                match field.value {
                    null => {
                        if f"{world.words.resolve(field.name)}" == name {
                            return "is moved into a value"
                        }
                    },
                    given => parts.push(given.clone()),
                }
            }
        },
        Expr::Coalesce { value, fallback, .. } => {
            parts.push(value.clone())
            parts.push(fallback.clone())
        },
        Expr::Throw(thrown, _) => parts.push(thrown.clone()),
        Expr::Block(inner, _) => return check_core_tree_stays_in_block(state, world, inner, name),
        Expr::If { cond, then_branch, else_branch, .. } => {
            let asked = check_core_tree_stays_in(state, world, cond, name)
            if asked.len() > 0 {
                return asked
            }
            let then = check_core_tree_stays_in_block(state, world, then_branch, name)
            if then.len() > 0 {
                return then
            }
            return check_core_tree_stays_in_block(state, world, else_branch ?? return "", name)
        },
        Expr::LitInterpolated { parts: pieces, .. } => {
            for piece in pieces {
                match piece {
                    FPart::Hole { expr, .. } => {
                        if !check_core_tree_read(world, expr, name) {
                            parts.push(expr.clone())
                        }
                    },
                    FPart::Text(_) => {},
                }
            }
        },
        Expr::Spawn { .. } => return "is taken into a task, which can outlive this one",
        Expr::Async(..) => return "is taken into a task, which can outlive this one",
        Expr::Closure { .. } => return "is taken into a closure, which can outlive this function",
        else => return "is used where the compiler cannot follow it",
    }
    for part in parts {
        let reason = check_core_tree_stays_in(state, world, part, name)
        if reason.len() > 0 {
            return reason
        }
    }
    return ""
}

/// Whether one `let` of `block` binds `name`.
fn check_core_view_list_bound_once(world: ref CheckWorld, block: ref Block, name: ref String) -> bool sync {
    let mut seen = 0
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, .. } => {
                for one in names {
                    if world.words.resolve(one) == name {
                        seen += 1
                    }
                }
            },
            else => {},
        }
    }
    return seen == 1
}

/// Whether `name` is bound, in this scope, to a list whose elements are
/// views: `Vec[ref T]`.
fn check_core_a_list_of_views(state: ref CheckState, name: ref String) -> bool sync {
    let found = state.binding(name) ?? return false
    return match found.ty {
        Ty::Named { name, args, view } => !view && name == "Vec" && args.len() == 1 && match args[0] {
            Ty::Named { view, .. } => view,
            else => false,
        },
        else => false,
    }
}

/// The group a block is, read before `check_async_block` takes the mark:
/// the `async { }` it is the body of, else the block itself where no `async
/// { }` around it in the function holds its tasks (D9); `null` for a block
/// whose tasks are an enclosing group's, or one with no statements.
fn check_async_group_ended(state: ref CheckState, block: ref Block) -> i64? sync {
    if block.stmts.len() == 0 {
        return null
    }
    if state.flow.async_group_block != null {
        return state.flow.async_group_block
    }
    if state.flow.async_group != null {
        return null
    }
    return -1 - block.stmts[0].span.start as i64
}

/// **The wait points of the tasks one block starts** (ADR-async-5 D6, D7,
/// D9), into `facts.async_waits` by the `async` node, and `NK2110` where a
/// task's window is empty. The group is the `async { }` this block is the body
/// of, else the innermost one around it in the function, else the block
/// itself. A task in a nested block is that block's, asked when it is walked.
fn check_async_block(mut state: CheckState, world: ref CheckWorld, block: ref Block) sync {
    let own = state.flow.async_group_block
    state.flow.async_group_block = null
    let count = block.stmts.len() as i64
    if count == 0 {
        return
    }
    let mut group = -1 - block.stmts[0].span.start as i64
    let mut ends_group = true
    if own != null {
        group = own ?? group
    } else if state.flow.async_group != null {
        group = state.flow.async_group ?? group
        ends_group = false
    }
    // Where each task this block's statements started is waited for, by the
    // statement's index (`count` for the group's end): one still running
    // after a start stands beside it.
    let mut pending: Vec[i64] = []
    let mut at = 0
    for stmt in block.stmts {
        let mut beside = 0
        for wait in pending {
            if wait > at {
                beside += 1
            }
        }
        let last = ends_group && at == count - 1
        match stmt.node {
            Stmt::Let { names, value, .. } => {
                match value {
                    Expr::Spawn { child, .. } if child => pending.push(check_child_binding(state, world, block, at, names, value, group)),
                    Expr::Async(inner, _, _, _) => {
                        pending.push(check_async_binding(state, world, block, at, names, value, group, beside, last, stmt.span))
                        check_async_in(state, inner, group, stmt.span)
                    },
                    // `let x = async e catch { f }`: the fallback (D22) stands
                    // in where the task's failure arrives, the binding waits
                    // as the bare form's does.
                    Expr::TryCatch { expr: guarded, .. } => {
                        match guarded {
                            Expr::Spawn { child, .. } if child => pending.push(check_child_binding(state, world, block, at, names, guarded, group)),
                            Expr::Async(inner, _, _, _) => {
                                pending.push(check_async_binding(state, world, block, at, names, guarded, group, beside, last, stmt.span))
                                check_async_in(state, inner, group, stmt.span)
                            },
                            else => check_async_in(state, value, group, stmt.span),
                        }
                    },
                    Expr::Tuple(parts, _) => {
                        let mut computed = 0
                        for part in parts {
                            if check_async_computes(part) {
                                computed += 1
                            }
                        }
                        for part in parts {
                            match part {
                                Expr::Async(inner, _, _, _) => {
                                    pending.push(check_async_binding(state, world, block, at, names, part, group, beside + computed - 1, last, stmt.span))
                                    check_async_in(state, inner, group, stmt.span)
                                },
                                else => check_async_in(state, part, group, stmt.span),
                            }
                        }
                    },
                    else => check_async_in(state, value, group, stmt.span),
                }
            },
            Stmt::Emit(value) => check_async_in(state, value, group, stmt.span),
            Stmt::Expr(value) => {
                match value {
                    // A child task as a statement runs to its end, waited for
                    // at its group's end (8.1.2, D11).
                    Expr::Spawn { child, .. } if child => {
                        state.facts.async_waits.insert(id_of(value) as i64, CheckAsyncWait { at: CheckAsyncWaitAt::GroupEnd, group: group })
                        pending.push(count)
                    },
                    Expr::TryCatch { expr: guarded, .. } if check_a_child_task(guarded) => {
                        state.facts.async_waits.insert(id_of(guarded) as i64, CheckAsyncWait { at: CheckAsyncWaitAt::GroupEnd, group: group })
                        pending.push(count)
                    },
                    Expr::Async(inner, _, _, _) => {
                        state.facts.async_waits.insert(id_of(value) as i64, CheckAsyncWait { at: CheckAsyncWaitAt::GroupEnd, group: group })
                        if last && beside == 0 {
                            state.a_task_with_nothing_beside_it(stmt.span, "it is the last statement of its group, which waits for it at once")
                        }
                        pending.push(count)
                        check_async_in(state, inner, group, stmt.span)
                    },
                    else => check_async_in(state, value, group, stmt.span),
                }
            },
            Stmt::Comptime { value, .. } => check_async_in(state, value, group, stmt.span),
            Stmt::Assign { target, value, .. } => {
                check_async_in(state, target, group, stmt.span)
                check_async_in(state, value, group, stmt.span)
            },
            Stmt::For { iter, .. } => check_async_in(state, iter, group, stmt.span),
            Stmt::While { cond, .. } => check_async_in(state, cond, group, stmt.span),
            Stmt::Return(value) => {
                if value != null {
                    check_async_in(state, value ?? return, group, stmt.span)
                }
            },
            Stmt::Break => {},
            Stmt::Continue => {},
        }
        at += 1
    }
}

/// One task a binding waits for (D6): before the first statement after `at`
/// naming any of `names`, nested anywhere; one nothing names at its group's
/// end. `others` counts what runs beside it. Gives back the statement's index,
/// the block's length for the group's end.
fn check_async_binding(mut state: CheckState, world: ref CheckWorld, block: ref Block, at: i64, names: ref Vec[winnow_grammar::Symbol], task: ref Expr, group: i64, others: i64, last: bool, span: ref Span) -> i64 sync {
    let count = block.stmts.len() as i64
    let mut wanted: collections::BTreeSet[String] = collections::BTreeSet()
    for name in names {
        wanted.insert(world.words.resolve(name).clone())
    }
    let mut named = count
    // The tasks that name it, each waiting for it in itself (D8).
    let mut readers = 0
    let mut index = 0
    for stmt in block.stmts {
        if index > at && named == count {
            let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
            names_in_statement(stmt.node, world.words, seen)
            for name in wanted {
                if seen.contains(name) {
                    if starts_a_task(stmt.node) {
                        readers += 1
                        break
                    }
                    named = index
                }
            }
        }
        index += 1
    }
    if named == count {
        if readers > 1 {
            state.facts.async_shared.insert(id_of(task) as i64)
        }
        state.facts.async_waits.insert(id_of(task) as i64, CheckAsyncWait { at: CheckAsyncWaitAt::GroupEnd, group: group })
        if last && others == 0 {
            state.a_task_with_nothing_beside_it(span, "nothing names its binding, and it is the last statement of its group, which waits for it at once")
        }
        return count
    }
    state.facts.async_waits.insert(id_of(task) as i64, CheckAsyncWait { at: CheckAsyncWaitAt::BeforeStatement(block.stmts[named].span.start as i64), group: group })
    if named == at + 1 && others == 0 {
        state.a_task_with_nothing_beside_it(span, "its binding is named in the very next statement, which waits for it")
    }
    return named
}

/// One child task a binding holds (`let h = async(handle) fn { … }`, 8.1.2,
/// D11): its handle is used where a later statement names the binding; one
/// nothing names runs to its end, waited for at its group's end. It runs
/// beside everything up to the group's end; gives back the block's length.
fn check_child_binding(mut state: CheckState, world: ref CheckWorld, block: ref Block, at: i64, names: ref Vec[winnow_grammar::Symbol], task: ref Expr, group: i64) -> i64 sync {
    let count = block.stmts.len() as i64
    let mut wanted: collections::BTreeSet[String] = collections::BTreeSet()
    for name in names {
        wanted.insert(world.words.resolve(name).clone())
    }
    let mut named = false
    let mut index = 0
    for stmt in block.stmts {
        if index > at && !named {
            let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
            names_in_statement(stmt.node, world.words, seen)
            for name in wanted {
                if seen.contains(name) {
                    named = true
                }
            }
        }
        index += 1
    }
    let mut wait = CheckAsyncWaitAt::GroupEnd
    if named {
        wait = CheckAsyncWaitAt::Handle
    }
    state.facts.async_waits.insert(id_of(task) as i64, CheckAsyncWait { at: wait, group: group })
    return count
}

/// Whether an expression is a child task, `async(handle) fn { … }`.
fn check_a_child_task(expr: ref Expr) -> bool sync {
    return match expr {
        Expr::Spawn { child, .. } => child,
        else => false,
    }
}

/// Whether a statement starts a task as a whole, `let x = async e` or `async
/// e`: a pending binding it names is waited for in that task, so the main line
/// waits where another statement names it (D6).
fn starts_a_task(stmt: ref Stmt) -> bool sync {
    return match stmt {
        Stmt::Let { value, .. } => match value {
            Expr::Async(_, _, _, _) => true,
            Expr::TryCatch { expr, .. } => match expr {
                Expr::Async(_, _, _, _) => true,
                else => false,
            },
            else => false,
        },
        Stmt::Expr(value) => match value {
            Expr::Async(_, _, _, _) => true,
            else => false,
        },
        else => false,
    }
}

/// The tasks in one expression, outside its blocks and lambdas: an argument
/// waits before its call, an operand before its operation, a part before its
/// tuple (D6); one standing anywhere else is waited for where it stands.
fn check_async_in(mut state: CheckState, expr: ref Expr, group: i64, span: ref Span) sync {
    match expr {
        Expr::Call { func, args, .. } => {
            let mut parts: Vec[ref Expr] = [func]
            for arg in args {
                parts.push(arg)
            }
            check_async_operands(state, parts, id_of(expr) as i64, group, span)
        },
        Expr::MethodCall { receiver, args, .. } => {
            let mut parts: Vec[ref Expr] = [receiver]
            for arg in args {
                parts.push(arg)
            }
            check_async_operands(state, parts, id_of(expr) as i64, group, span)
        },
        Expr::SafeMethod { receiver, args, .. } => {
            let mut parts: Vec[ref Expr] = [receiver]
            for arg in args {
                parts.push(arg)
            }
            check_async_operands(state, parts, id_of(expr) as i64, group, span)
        },
        Expr::Binary { lhs, rhs, .. } => {
            let parts: Vec[ref Expr] = [lhs, rhs]
            check_async_operands(state, parts, id_of(expr) as i64, group, span)
        },
        Expr::Tuple(items, _) => {
            let mut parts: Vec[ref Expr] = []
            for item in items {
                parts.push(item)
            }
            check_async_operands(state, parts, id_of(expr) as i64, group, span)
        },
        // A child task anywhere else gives its handle where it stands.
        Expr::Spawn { child, .. } if child => {
            state.facts.async_waits.insert(id_of(expr) as i64, CheckAsyncWait { at: CheckAsyncWaitAt::Handle, group: group })
        },
        Expr::Async(inner, _, _, _) => {
            state.facts.async_waits.insert(id_of(expr) as i64, CheckAsyncWait { at: CheckAsyncWaitAt::Before(id_of(expr) as i64), group: group })
            state.a_task_with_nothing_beside_it(span, "where it stands, its value is needed at once")
            check_async_in(state, inner, group, span)
        },
        else => {
            for child in child_exprs_of(expr) {
                check_async_in(state, child, group, span)
            }
        },
    }
}

/// The arguments of one call, the operands of one operation or the parts of
/// one tuple: a task among them waits before `at`, and is refused (`NK2110`)
/// where nothing else among them is computed beside it.
fn check_async_operands(mut state: CheckState, parts: ref Vec[ref Expr], at: i64, group: i64, span: ref Span) sync {
    let mut computed = 0
    for part in parts {
        if check_async_computes(part) {
            computed += 1
        }
    }
    for part in parts {
        match part {
            Expr::Async(inner, _, _, _) => {
                state.facts.async_waits.insert(id_of(part) as i64, CheckAsyncWait { at: CheckAsyncWaitAt::Before(at), group: group })
                if computed < 2 {
                    state.a_task_with_nothing_beside_it(span, "nothing beside it in the same call or operation is computed while it runs")
                }
                check_async_in(state, inner, group, span)
            },
            else => check_async_in(state, part, group, span),
        }
    }
}

/// Whether an expression beside a task computes (D7): a literal or a name
/// does not; a call, an operation or another task does.
fn check_async_computes(expr: ref Expr) -> bool sync {
    return match expr {
        Expr::LitInt { .. } => false,
        Expr::LitStr { .. } => false,
        Expr::LitChar(_, _) => false,
        Expr::LitBool(_, _) => false,
        Expr::LitFloat(_, _) => false,
        Expr::LitNull(_) => false,
        Expr::Variable(_, _) => false,
        Expr::Path(_, _) => false,
        else => true,
    }
}

/// The read a `let` binds, past a `??` (#1388): `m.get(k) ?? return`.
fn check_core_stmt_slot_read(value: ref Expr) -> ref Expr {
    return match value {
        Expr::Coalesce { value: read, .. } => read,
        else => value,
    }
}

/// **Which returned trees stay in the task, across calls** (ADR-327 D17,
/// #2348). After every body of the file is checked - the walk asks which
/// arguments were lent - each call of a free function of this file is
/// written down with where its result goes: kept in the caller (a `let`
/// whose name D16 keeps in the function, an argument lent to its
/// parameter, a box of a value placed in the block, a comparison, an
/// `f"…"` hole, a statement whose value is dropped), the caller's own
/// result, or anywhere else, which counts as leaving the task. A fixed
/// point that starts from "task-local" turns a function to "outside" as
/// soon as one call lets its result leave, or hands it to the result of a
/// function that is outside. A function named anywhere but as a direct
/// call (a function value, a task's body, a closure), `pub`, `extern` or
/// `main` is outside, and a file with a grammar keeps every function
/// outside. The box sites a task-local function returns are placed in
/// the block (D16); `--sharing` names the function either way.
fn check_core_place_returned(mut state: CheckState, world: ref CheckWorld) sync {
    if state.facts.boxed_members.len() == 0 {
        return
    }
    let mut candidates: collections::BTreeSet[String] = collections::BTreeSet()
    let mut has_grammar = false
    for item in world.here.items {
        match item.node {
            Item::Fn { name, is_public, is_extern, .. } => {
                let sym = name ?? continue
                let named = f"{world.words.resolve(sym)}"
                if !is_public && !is_extern && named != "main" {
                    candidates.insert(named)
                }
            },
            Item::Grammar(_) => { has_grammar = true },
            else => {},
        }
    }
    if candidates.len() == 0 {
        return
    }
    let mut calls: Vec[(String, String)] = []
    let mut sites: Vec[(i64, String, String)] = []
    for item in world.here.items {
        match item.node {
            Item::Fn { name, body, config, .. } => {
                let sym = name ?? continue
                let owner = f"{world.words.resolve(sym)}"
                for option in config {
                    check_core_returned_leaves(world, option.default, owner, candidates, calls)
                }
                check_core_returned_block(state, world, body, owner, f"<{owner}", candidates, calls, sites)
            },
            Item::Impl { target, methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { name, body, config, .. } => {
                            let sym = name ?? continue
                            let owner = f"{world.here.text(target.name)}::{world.words.resolve(sym)}"
                            for option in config {
                                check_core_returned_leaves(world, option.default, owner, candidates, calls)
                            }
                            check_core_returned_block(state, world, body, owner, f"<{owner}", candidates, calls, sites)
                        },
                        else => {},
                    }
                }
            },
            Item::Test { name, body } => check_core_returned_block(state, world, body, name, f"!{name}", candidates, calls, sites),
            Item::Bench { name, body } => check_core_returned_block(state, world, body, name, f"!{name}", candidates, calls, sites),
            Item::Comptime { value, .. } => check_core_returned_leaves(world, value, "a constant", candidates, calls),
            Item::Struct { fields, rules, .. } => {
                for field in fields {
                    match field.default {
                        null => {},
                        given => check_core_returned_leaves(world, given.value, "a field's default", candidates, calls),
                    }
                }
                for rule in rules {
                    check_core_returned_leaves(world, rule.node, "a rule", candidates, calls)
                }
            },
            else => {},
        }
    }
    // **The fixed point**, from "task-local": a function turns outside at
    // the first call that lets its result leave, and with it every
    // function that returns its result.
    let mut local: collections::BTreeSet[String] = if has_grammar { collections::BTreeSet() } else { candidates.clone() }
    let mut why: collections::BTreeMap[String, String] = collections::BTreeMap()
    if has_grammar {
        for named in candidates {
            why.insert(named.clone(), "a grammar in this file reads code the walk does not follow")
        }
    }
    // A function the other files of the package name is called where this
    // walk does not follow: it stays outside.
    for named in check_core_returned_beside(world, candidates) {
        if local.remove(named) {
            why.insert(named.clone(), "another file of the package names it, where the walk does not follow")
        }
    }
    let mut changed = true
    while changed {
        changed = false
        for (callee, dest) in calls {
            if !local.contains(callee) {
                continue
            }
            let left: String? = match dest.strip_prefix("!") {
                null => {
                    match dest.strip_prefix("<") {
                        null => null,
                        given => if local.contains(given) { null } else { f"a call in `{given}` returns it, and the result of `{given}` leaves the task" },
                    }
                },
                caller => f"a call in `{caller}` lets it leave the task",
            }
            match left {
                null => {},
                reason => {
                    local.remove(callee)
                    why.insert(callee.clone(), reason.clone())
                    changed = true
                },
            }
        }
    }
    for (key, site, owner) in sites {
        if local.contains(owner) {
            state.facts.placed_in_block.insert(key)
            state.facts.box_sites.insert(key, f"{owner}: `{site}` in the block: its result stays in the task at every call (ADR-327 D17)")
        } else if candidates.contains(owner) {
            let reason = why.get(owner)?.clone() ?? "a call lets it leave the task"
            state.facts.box_sites.insert(key, f"{owner}: `{site}` outside: it is returned, and {reason} (ADR-327 D17)")
        }
    }
}

/// Every function of `candidates` that `expr` names, written down as a
/// call whose result leaves the task from `owner`.
fn check_core_returned_leaves(world: ref CheckWorld, expr: ref Expr, owner: ref String, candidates: ref collections::BTreeSet[String], mut calls: Vec[(String, String)]) sync {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    names_in(expr, world.words, read)
    for named in read {
        if candidates.contains(named) {
            calls.push((named.clone(), f"!{owner}"))
        }
    }
}

/// **The candidates the other files of the package name**, in a body, a
/// constant, a field's default or a rule; all of them where one of those
/// files holds a grammar, whose code the walk does not read (ADR-327 D17).
/// A name is enough: which of them hold a call of this file's function the
/// walk does not tell, so the answer stays on the safe side. `lower-std`
/// gives a file the package without it (`here_at` -1); a package's check
/// gives it among them, and its own place is passed over.
fn check_core_returned_beside(world: ref CheckWorld, candidates: ref collections::BTreeSet[String]) -> collections::BTreeSet[String] {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    let mut at = -1
    for other in world.beside {
        at += 1
        if at == world.here_at {
            continue
        }
        for item in other.items {
            match item.node {
                Item::Fn { body, config, .. } => {
                    for option in config {
                        names_in(option.default, other.words, read)
                    }
                    names_in_block(body, other.words, read)
                },
                Item::Impl { methods, .. } => {
                    for method in methods {
                        match method.node {
                            Item::Fn { body, config, .. } => {
                                for option in config {
                                    names_in(option.default, other.words, read)
                                }
                                names_in_block(body, other.words, read)
                            },
                            else => {},
                        }
                    }
                },
                Item::Test { body, .. } => names_in_block(body, other.words, read),
                Item::Bench { body, .. } => names_in_block(body, other.words, read),
                Item::Comptime { value, .. } => names_in(value, other.words, read),
                Item::Struct { fields, rules, .. } => {
                    for field in fields {
                        match field.default {
                            null => {},
                            given => names_in(given.value, other.words, read),
                        }
                    }
                    for rule in rules {
                        names_in(rule.node, other.words, read)
                    }
                },
                Item::Grammar(_) => {
                    return candidates.clone()
                },
                else => {},
            }
        }
    }
    let mut named: collections::BTreeSet[String] = collections::BTreeSet()
    for name in read {
        if candidates.contains(name) {
            named.insert(name.clone())
        }
    }
    return named
}

/// **Where each statement of `block` sends the values it computes**, in
/// `owner`; `dest` is where the block's own value goes: `=` kept in the
/// task, `<f` the result of `f`, `!f` leaving it from `f`.
fn check_core_returned_block(state: ref CheckState, world: ref CheckWorld, block: ref Block, owner: ref String, dest: ref String, candidates: ref collections::BTreeSet[String], mut calls: Vec[(String, String)], mut sites: Vec[(i64, String, String)]) sync {
    let count = block.stmts.len() as i64
    let leaves = f"!{owner}"
    let result = f"<{owner}"
    let mut at = 0
    while at < count {
        match block.stmts[at].node {
            Stmt::Let { names, value, .. } => {
                let mut kept = false
                if names.len() == 1 {
                    let name = f"{world.words.resolve(names[0])}"
                    kept = check_core_view_list_bound_once(world, block, name)
                    let mut later = at + 1
                    while later < count && kept {
                        kept = check_core_tree_stays_in_stmt(state, world, block.stmts[later].node, name).len() == 0
                        later += 1
                    }
                }
                check_core_returned_expr(state, world, value, owner, if kept { "=" } else { leaves }, candidates, calls, sites)
            },
            Stmt::Expr(value) => check_core_returned_expr(state, world, value, owner, if at == count - 1 { dest } else { "=" }, candidates, calls, sites),
            Stmt::Return(value) => {
                match value {
                    null => {},
                    given => check_core_returned_expr(state, world, given, owner, result, candidates, calls, sites),
                }
            },
            Stmt::For { iter, body, .. } => {
                check_core_returned_expr(state, world, iter, owner, leaves, candidates, calls, sites)
                check_core_returned_block(state, world, body, owner, "=", candidates, calls, sites)
            },
            Stmt::While { cond, body } => {
                check_core_returned_expr(state, world, cond, owner, "=", candidates, calls, sites)
                check_core_returned_block(state, world, body, owner, "=", candidates, calls, sites)
            },
            Stmt::Assign { target, value, .. } => {
                check_core_returned_leaves(world, target, owner, candidates, calls)
                check_core_returned_expr(state, world, value, owner, leaves, candidates, calls, sites)
            },
            Stmt::Comptime { value, .. } => check_core_returned_leaves(world, value, owner, candidates, calls),
            Stmt::Emit(value) => check_core_returned_leaves(world, value, owner, candidates, calls),
            else => {},
        }
        at += 1
    }
}

/// **Where `expr`'s parts send their values**, `expr`'s own going to
/// `dest` (`check_core_returned_block`): a call of a function of this file
/// is written down with it, and a box site the caller's result is built
/// by with the function whose result it is.
fn check_core_returned_expr(state: ref CheckState, world: ref CheckWorld, expr: ref Expr, owner: ref String, dest: ref String, candidates: ref collections::BTreeSet[String], mut calls: Vec[(String, String)], mut sites: Vec[(i64, String, String)]) sync {
    let leaves = f"!{owner}"
    match expr {
        Expr::Call { func, args, config, .. } => {
            let site = check_core_box_site(state, world, expr)
            let mut parts: String = leaves.clone()
            if site.len() > 0 {
                let key = check_core_box_site_key(expr)
                if state.facts.placed_in_block.contains(key) {
                    parts = "="
                } else {
                    match dest.strip_prefix("<") {
                        null => {},
                        returned => {
                            sites.push((key, site.clone(), returned.clone()))
                            parts = dest.clone()
                        },
                    }
                }
            } else {
                let callee: String? = match func {
                    Expr::Variable(sym, _) => f"{world.words.resolve(sym)}",
                    Expr::Path(segments, _) => if segments.len() == 1 { f"{world.words.resolve(segments[0])}" } else { null },
                    else => null,
                }
                match callee {
                    null => check_core_returned_leaves(world, func, owner, candidates, calls),
                    named => {
                        if candidates.contains(named) {
                            calls.push((named.clone(), dest.clone()))
                        }
                    },
                }
            }
            for arg in args {
                let lent = site.len() == 0 && state.facts.lent_args.contains(node_key(arg))
                check_core_returned_expr(state, world, arg, owner, if lent { "=" } else { parts }, candidates, calls, sites)
            }
            for option in config {
                check_core_returned_leaves(world, option.value, owner, candidates, calls)
            }
        },
        Expr::StructLit { fields, .. } => {
            let site = check_core_box_site(state, world, expr)
            let mut parts: String = leaves.clone()
            if site.len() > 0 {
                let key = check_core_box_site_key(expr)
                if state.facts.placed_in_block.contains(key) {
                    parts = "="
                } else {
                    match dest.strip_prefix("<") {
                        null => {},
                        returned => {
                            sites.push((key, site.clone(), returned.clone()))
                            parts = dest.clone()
                        },
                    }
                }
            }
            for field in fields {
                check_core_returned_expr(state, world, field.value ?? continue, owner, parts, candidates, calls, sites)
            }
        },
        Expr::MethodCall { receiver, args, config, .. } => {
            check_core_returned_leaves(world, receiver, owner, candidates, calls)
            for arg in args {
                check_core_returned_expr(state, world, arg, owner, if state.facts.lent_args.contains(node_key(arg)) { "=" } else { leaves }, candidates, calls, sites)
            }
            for option in config {
                check_core_returned_leaves(world, option.value, owner, candidates, calls)
            }
        },
        Expr::Match { value, arms, .. } => {
            check_core_returned_leaves(world, value, owner, candidates, calls)
            for arm in arms {
                match arm.guard {
                    null => {},
                    guard => check_core_returned_expr(state, world, guard, owner, "=", candidates, calls, sites),
                }
                check_core_returned_expr(state, world, arm.body, owner, dest, candidates, calls, sites)
            }
        },
        Expr::If { cond, then_branch, else_branch, .. } => {
            check_core_returned_expr(state, world, cond, owner, "=", candidates, calls, sites)
            check_core_returned_block(state, world, then_branch, owner, dest, candidates, calls, sites)
            match else_branch {
                null => {},
                given => check_core_returned_block(state, world, given, owner, dest, candidates, calls, sites),
            }
        },
        Expr::Block(inner, _) => check_core_returned_block(state, world, inner, owner, dest, candidates, calls, sites),
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr: hole, .. } => check_core_returned_expr(state, world, hole, owner, "=", candidates, calls, sites),
                    else => {},
                }
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            let compared = match op {
                BinaryOp::Eq => true,
                BinaryOp::Ne => true,
                BinaryOp::Lt => true,
                BinaryOp::Le => true,
                BinaryOp::Gt => true,
                BinaryOp::Ge => true,
                BinaryOp::And => true,
                BinaryOp::Or => true,
                else => false,
            }
            let parts: String = if compared { "=" } else { leaves }
            check_core_returned_expr(state, world, lhs, owner, parts, candidates, calls, sites)
            check_core_returned_expr(state, world, rhs, owner, parts, candidates, calls, sites)
        },
        Expr::Coalesce { value, fallback, .. } => {
            check_core_returned_expr(state, world, value, owner, dest, candidates, calls, sites)
            check_core_returned_expr(state, world, fallback, owner, dest, candidates, calls, sites)
        },
        Expr::Try(inner, _) => check_core_returned_expr(state, world, inner, owner, dest, candidates, calls, sites),
        Expr::Return(value, _) => {
            match value {
                null => {},
                given => check_core_returned_expr(state, world, given, owner, f"<{owner}", candidates, calls, sites),
            }
        },
        else => check_core_returned_leaves(world, expr, owner, candidates, calls),
    }
}
