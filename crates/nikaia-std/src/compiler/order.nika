// crates/nikaia-std/src/compiler/order.nika
//
// **Whether two statements have to keep the order they were written in**
// (ADR-292, Part I 8.1.1): the verdict half of the compiler's
// `contracts::order`, moved from Rust (ADR-294, #125). What stays Rust is the
// walk that reduces a statement to an `Operation`, or says why it could not.
//
// The rule is one sentence - *two operations whose touch sets are disjoint
// have no order between them* - and it says "no" for every reason it can think
// of, and for every reason it cannot (ADR-292 D3). Every refusal is either a
// real dependency or an admission of ignorance, and the two are deliberately
// worth the same; the reason is the whole point (D9).

use std::collections

/// One statement, reduced to what deciding an order needs.
pub struct Operation {
    /// The name it binds, where it binds one.
    pub binds: String?,
    /// Every name its value mentions: a statement that mentions what the one
    /// before it bound is a data dependency, and nothing else is consulted.
    pub mentions: collections::BTreeSet[String],
    /// What the call it performs reaches, as the ledger describes it with the
    /// call's own arguments filled in.
    pub reaches: Vec[Reached],
    /// The ledger key of the call, for a diagnostic that wants to name it.
    pub callee: String,
}

/// A statement, reduced - or the reason it could not be.
pub enum Accounted {
    Operation(Operation),
    /// It performs nothing at all: a loop, an `if`, an assignment, a
    /// `return`, a `let` of a value that calls nothing.
    NotAnOperation,
    /// It performs something this analysis will not take apart, named so the
    /// report says *which* thing.
    Opaque(String),
    /// Its `catch` handler can leave the function (ADR-292).
    DivertingHandler,
    /// It can fail and nothing catches the failure (ADR-292 D1).
    UncaughtFailure(String),
    /// Nothing describes what the call reaches, so it reaches everything (D4).
    NoTouches(String),
    /// Something describes what the call reaches, in a word this compiler does
    /// not know - refused, because an unknown kind would be disjoint from
    /// every kind there is.
    UnknownResource { callee: String, kind: String },
    /// What it hands back may not cross a thread, or nothing written down says
    /// it may (ADR-005 §1 Group B).
    MayNotCross { callee: String, crossing: Crossing },
    /// A value that is not a literal, which this increment will not send to
    /// another thread - D9's "implementation limit, not a language question".
    NonLiteralArgument(String),
}

impl Accounted {
    /// One line, for a report a person reads - and, where there is one, the
    /// way out.
    pub fn why(ref self) -> String {
        return match self {
            Accounted::Operation(_) => "it is an operation",
            Accounted::NotAnOperation => "one of them performs no operation at all",
            Accounted::Opaque(what) => f"one of them holds {what}",
            Accounted::DivertingHandler => "its `catch` can leave the function, so the next statement might never run. Make the handler return a value instead, and check it afterwards",
            Accounted::UncaughtFailure(name) => f"`{name}` can fail and nothing catches it, so the next statement might never run. `catch` it into a value, and check it afterwards",
            Accounted::NoTouches(name) => f"nothing says what `{name}` touches, so it might touch anything",
            Accounted::UnknownResource { callee, kind } => unknown_resource(callee, kind),
            Accounted::MayNotCross { callee, crossing } => may_not_cross(callee, crossing),
            Accounted::NonLiteralArgument(name) => f"`{name}` isn't a literal, and only literals can be sent to another thread",
        }
    }
}

fn unknown_resource(callee: ref String, kind: ref String) -> String {
    let article = an_or_a(kind)
    return f"`{callee}` says it touches {article} `{kind}`, which this version of Nikaia doesn't know, so it might touch anything"
}

fn may_not_cross(callee: ref String, crossing: ref Crossing) -> String {
    let note = crossing.note() ?? "It can't."
    return f"what `{callee}` returns would have to move to another thread. {note}"
}

/// Why two statements keep their order, or that they need not.
pub enum Verdict {
    /// They meet on nothing and neither waits for the other.
    Overlap,
    /// The later uses what the earlier bound.
    DataDependency(String),
    /// Both bind the same name, so the order decides which value survives.
    Shadowed(String),
    /// Their touch sets meet on something one of them writes. `unnameable`
    /// says the resource has no name because this compiler could not read
    /// one, rather than because the kind has only one of it.
    SameResource { kind: String, named: String?, unnameable: bool },
    /// Their touch sets meet on two resources named differently that may be
    /// the same thing - `stdout` and `stderr` under `2>&1`.
    SameDestination { one: String, other: String },
    /// One of them is not a statement this analysis can account for at all.
    NotAccountedFor,
}

impl Verdict {
    pub fn is_overlap(ref self) -> bool {
        return match self {
            Verdict::Overlap => true,
            else => false,
        }
    }

    /// One line, for a report a person reads.
    pub fn why(ref self) -> String {
        return match self {
            Verdict::Overlap => "they meet on nothing",
            Verdict::DataDependency(name) => f"the second uses `{name}`",
            Verdict::Shadowed(name) => f"both bind `{name}`",
            Verdict::SameResource { kind, named, unnameable } => same_resource(kind, named, unnameable),
            Verdict::SameDestination { one, other } => f"one touches {one} and the other {other}, which might be the same place",
            Verdict::NotAccountedFor => "the compiler can't tell what one of them does",
        }
    }
}

fn same_resource(kind: ref String, named: ref String?, unnameable: bool) -> String {
    if named != null {
        let name = named ?? ""
        // A lock is named by its binding (Part II 12.2, #985), which is a
        // name of the program's and not of the kind's.
        if kind == "lock" {
            return f"both reach the lock `{name}`, and one writes it"
        }
        return f"both reach {kind} `{name}`, and one writes it"
    }
    if unnameable {
        return f"both touch a {kind} the compiler can't name, and one writes to it"
    }
    return f"both touch {kind}, and one writes to it"
}

/// Whether `later` may run at the same time as `earlier`, and why not: a
/// **data** dependency first, then two bindings of one name, then an
/// **effect** dependency, where their touch sets meet on something one of
/// them writes.
pub fn verdict(earlier: ref Operation, later: ref Operation) -> Verdict {
    let bound = written_or_nothing(earlier.binds)
    if earlier.binds != null && later.mentions.contains(bound) {
        return Verdict::DataDependency(bound.clone())
    }
    // Two `let`s of the same name would make the order decide which value
    // survives. The parser allows shadowing, so this is reachable.
    if earlier.binds != null && later.binds != null && earlier.binds == later.binds {
        return Verdict::Shadowed(bound.clone())
    }
    for a in earlier.reaches {
        for b in later.reaches {
            if a.conflicts_with(b) {
                return conflict(a, b)
            }
        }
    }
    return Verdict::Overlap
}

// Two kinds that conflict at all are two names for what may be one thing; one
// kind is one resource, and the named half is the more useful one to print.
fn conflict(a: ref Reached, b: ref Reached) -> Verdict {
    if a.kind != b.kind {
        return Verdict::SameDestination { one: a.kind.clone(), other: b.kind.clone() }
    }
    let named = readable_name(a) ?? readable_name(b) ?? return Verdict::SameResource { kind: a.kind.clone(), named: null, unnameable: a.unknown || b.unknown }
    return Verdict::SameResource { kind: a.kind.clone(), named: named, unnameable: false }
}

// The name a reached resource was given, where it was readable.
fn readable_name(reached: ref Reached) -> String? {
    if reached.unknown {
        return null
    }
    return reached.named?.clone()
}

/// Whether a whole **run** of operations may run as one group, and why not
/// (ADR-292). **Every pair, not every adjacent pair**: disjointness is not
/// transitive, and believing it would overlap a read of a file with the write
/// of it. The pair named is the earliest.
pub fn group_verdict(run: ref Vec[Operation]) -> Verdict {
    for i in 0..<run.len() {
        for j in (i + 1)..<run.len() {
            let found = verdict(run[i], run[j])
            if !found.is_overlap() {
                return found
            }
        }
    }
    return Verdict::Overlap
}

/// How many operations from the front of `run` may go together: the longest
/// **prefix** every member of which meets every other on nothing, and `0`
/// where that is fewer than two - a group is a run the emitter replaces in
/// place, so leaving one out of the middle would reorder the rest.
pub fn group_of(run: ref Vec[Operation]) -> i64 {
    let mut taken = if run.len() > 0 { 1 } else { 0 }
    while taken < run.len() {
        if !fits_with_the_front(run, taken) {
            break
        }
        taken += 1
    }
    if taken < 2 {
        return 0
    }
    return taken
}

// Whether the operation at `at` meets every one before it on nothing.
fn fits_with_the_front(run: ref Vec[Operation], at: i64) -> bool {
    for i in 0..<at {
        if !verdict(run[i], run[at]).is_overlap() {
            return false
        }
    }
    return true
}

// The kinds of resource this compiler knows (ADR-292 D3). A ledger that names
// another is not malformed - it is a file this compiler is too old to read,
// and D4 says what to do with an effect that cannot be read.
comptime KNOWN_KINDS: Array[ref String, 6] = ["file", "stdout", "stderr", "args", "lock", "socket"]

/// A statement, reduced to an `Operation` - or the reason it could not be.
/// `walking` carries the two ledgers and the destination the result of each
/// call is asked about (`Going::Ours`, ADR-312 D6: the closure overlapping
/// builds is this compiler's own).
///
/// Two shapes are read: a `let` of one name and a bare expression statement.
/// An **assignment** is not among them and must not be: `x = 1` changes a
/// name without binding one, so the data-dependency test would miss it.
pub fn accounted(stmt: ref Stmt, words: ref winnow_grammar::InternerContext, walking: ref Walking) -> Accounted {
    return accounted_as(stmt, words, walking, false)
}

/// [`accounted`] for a statement that **runs beside** another, a task or a
/// statement in a task's window (ADR-async-5 D7, #1354): a failure nobody
/// catches leaves the function, but what runs beside it has run by then
/// already, so it is no reason to leave the statement unaccounted for.
fn accounted_beside(stmt: ref Stmt, words: ref winnow_grammar::InternerContext, walking: ref Walking) -> Accounted {
    return accounted_as(stmt, words, walking, true)
}

fn accounted_as(stmt: ref Stmt, words: ref winnow_grammar::InternerContext, walking: ref Walking, beside: bool) -> Accounted {
    return match stmt {
        Stmt::Let { names, value, ty, .. } => {
            // A written type would have to be carried onto one half of a
            // pattern; a tuple of names would need all of them carried.
            if ty != null {
                return Accounted::Opaque("a written type, which would have to be carried onto one half of a pattern")
            }
            if names.len() != 1 {
                return Accounted::Opaque("several names bound at once")
            }
            let binds: String? = words.resolve(names[0]).clone()
            accounted_value(binds, value, words, walking, beside)
        }
        Stmt::Expr(value) => accounted_value(null, value, words, walking, beside),
        else => Accounted::NotAnOperation,
    }
}

// The value of a statement, looked through a `catch` whose handler cannot
// divert: a handler that leaves makes the *next* statement conditional on
// this one (ADR-292), which a statement that runs `beside` does not care for.
// **The handler's own calls are not guarded by it** (Part I 7.1, #1370): a
// failure inside a handler leaves the statement, so only the calls before
// `catch` count as caught.
fn accounted_value(binds: String?, value: ref Expr, names: ref winnow_grammar::InternerContext, walking: ref Walking, beside: bool) -> Accounted {
    return match value {
        Expr::TryCatch { expr, handler, .. } => {
            if !beside && diverts_within(handler.stmts, false) {
                return Accounted::DivertingHandler
            }
            let mut reduced = Reduced { calls: [], performs: false, methods: [], refused: null }
            reduce(expr, names, reduced)
            let guarded = reduced.calls.len()
            // **And the handler's own effects**: it is part of the statement,
            // so what it reaches is part of what the statement touches.
            reduce_handler(handler, names, reduced)
            let mut mentions: collections::BTreeSet[String] = collections::BTreeSet()
            names_in(expr, names, mentions)
            // **The handler counts too** for a data dependency.
            names_in_block(handler, names, mentions)
            accounted_reduced(binds, mentions, reduced, guarded, beside, walking)
        }
        else => {
            let mut reduced = Reduced { calls: [], performs: false, methods: [], refused: null }
            reduce(value, names, reduced)
            let mut mentions: collections::BTreeSet[String] = collections::BTreeSet()
            names_in(value, names, mentions)
            accounted_reduced(binds, mentions, reduced, 0, beside, walking)
        }
    }
}

// What the walk found, made an answer. The ledger is consulted **before** the
// walk's own refusal is reported: "nothing says what `x` reaches" is a gap a
// reader can close, where "it holds a method call" is this compiler's own
// limit (D9). The first `guarded` calls are the ones a `catch` guards; a
// failure of any other leaves the statement, which matters only where it does
// not run `beside`. **What runs `beside`** (a task, a statement in its window,
// a `par_iter` lambda's run) is not carried into a closure of its own, so a
// value read from somewhere else (a name, a field, a `??`'s fallback, all of
// whose calls the walk did read) leaves nothing unaccounted there; a node the
// walk stopped at still does (ADR-async-5 D7, D26).
fn accounted_reduced(binds: String?, mentions: collections::BTreeSet[String], reduced: ref Reduced, guarded: i64, beside: bool, walking: ref Walking) -> Accounted {
    if reduced.calls.len() == 0 && !reduced.performs {
        // Nothing here reaches the world at all.
        return Accounted::NotAnOperation
    }
    let mut reaches: Vec[Reached] = []
    let mut named_by: Vec[String] = []
    for (at, call) in reduced.calls.iter().enumerate() {
        let refused = a_call_reaches(call, beside || at < guarded, walking, reaches, named_by)
        if refused != null {
            return refused ?? Accounted::NotAnOperation
        }
    }
    // A method call is accounted for only where **every** entry of that name
    // reaches nothing (D4).
    for method in reduced.methods {
        if !reaches_nothing(method, walking) {
            return Accounted::NoTouches(method.clone())
        }
    }
    if reduced.refused != null && (!beside || reduced.performs) {
        return reduced.refused?.clone() ?? Accounted::NotAnOperation
    }
    return Accounted::Operation(Operation { binds: binds, mentions: mentions, reaches: reaches, callee: named_by.join(" + ") })
}

// What one call reaches, added to `reaches`; the refusal where it cannot be
// accounted for.
fn a_call_reaches(call: ref OneCall, caught: bool, walking: ref Walking, mut reaches: Vec[Reached], mut named_by: Vec[String]) -> Accounted? {
    let key = call.key.clone()
    // The contract has to be found *and* has to describe its effects: an
    // entry without `touches` is the absence of an answer (D4).
    let contract = touches_described(key, walking) ?? return Accounted::NoTouches(key)
    // A failure nobody catches leaves the function, which makes the next
    // statement conditional on this one (ADR-292 D1).
    if !caught && contract.fails_with.len() > 0 {
        return Accounted::UncaughtFailure(key)
    }
    // An unknown kind differs from every kind there is, so it would be
    // disjoint from all of them: D4's answer instead.
    for touch in contract.touches {
        if !known_kind(touch.kind) {
            return Accounted::UnknownResource { callee: key.clone(), kind: touch.kind.clone() }
        }
    }
    let signature = contract.signature?.clone() ?? return Accounted::NoTouches(key)
    // **And what it hands back has to be able to cross a thread** (ADR-005
    // §1 Group B): the overlapped operation runs in a closure elsewhere and
    // hands its value back.
    let crossed = crossing(signature.result_or_unit(), walking)
    if !crossed.may() {
        return Accounted::MayNotCross { callee: key.clone(), crossing: crossed }
    }
    let parameters = call_parameters(signature)
    for touch in contract.touches {
        // A resource the callee's body named with a literal is that one,
        // whatever this call passes (#1354).
        let named = touch.named?.clone() ?? argument_named(touch.parameter, parameters, call.arguments)
        reaches.push(Reached { kind: touch.kind.clone(), unknown: touch.parameter != null && named == null, named: named, write: touch.write })
    }
    named_by.push(key)
    return null
}

// The contract a call's key names, in the program's ledger and then `std`'s,
// where it describes what it touches.
fn touches_described(key: ref String, walking: ref Walking) -> FnContract? {
    let mine: FnContract? = walking.own.functions[key]?.clone()
    let found = mine ?? walking.library.functions[key]?.clone() ?? return null
    if !found.touches_known {
        return null
    }
    return found
}

fn known_kind(kind: ref String) -> bool {
    for known in KNOWN_KINDS {
        if known == kind {
            return true
        }
    }
    return false
}

// The parameters a *call* passes, which is the parameters after a receiver.
fn call_parameters(signature: ref Signature) -> Vec[String] {
    let mut out: Vec[String] = []
    for i in 0..<signature.params.len() {
        if i > 0 || signature.params[i].0 != "self" {
            out.push(signature.params[i].0.clone())
        }
    }
    return out
}

// The literal text of the argument a touch's parameter names, where it is a
// literal: `fs::read(pfad, root)` names a file this compiler cannot identify,
// and D4 says what happens then.
fn argument_named(parameter: ref String?, parameters: ref Vec[String], arguments: ref Vec[Expr]) -> String? {
    let wanted = parameter ?? return null
    for at in 0..<parameters.len() {
        if parameters[at] == wanted {
            if at >= arguments.len() {
                return null
            }
            return literal_text(arguments[at])
        }
    }
    return null
}

fn literal_text(expr: ref Expr) -> String? {
    return match expr {
        Expr::LitStr { text, .. } => text.clone(),
        else => null,
    }
}

// Whether every entry a bare method name could resolve to reaches nothing,
// in the program's ledger if it has any, else in `std`'s. Only a method is a
// candidate: an entry whose signature takes no `self` is a function a call
// names by its path.
fn reaches_nothing(method: ref String, walking: ref Walking) -> bool {
    let mut candidates = method_entries(method, walking.own)
    if candidates.len() == 0 {
        candidates = method_entries(method, walking.library)
    }
    if candidates.len() == 0 {
        return false
    }
    for contract in candidates {
        if !contract.touches_known || contract.touches.len() > 0 {
            return false
        }
    }
    return true
}

fn method_entries(method: ref String, ledger: ref Ledger) -> Vec[FnContract] {
    let suffix = f"::{method}"
    let mut out: Vec[FnContract] = []
    for (key, contract) in ledger.functions {
        if key.ends_with(ref suffix) && takes_a_subject(contract.signature) {
            out.push(contract.clone())
        }
    }
    return out
}

fn takes_a_subject(signature: ref Signature?) -> bool {
    let written = signature ?? return true
    return written.takes_a_receiver()
}

/// One call a statement performs: its ledger key and its arguments.
pub struct OneCall {
    pub key: String,
    pub arguments: Vec[Expr],
}

// What walking a statement's value found (ADR-292): the calls it
// performs at any depth; whether it performs *something* even where this
// could not say what; every method called, by name; and the first reason it
// could not be taken apart.
struct Reduced {
    calls: Vec[OneCall],
    performs: bool,
    methods: Vec[String],
    refused: Accounted?,
}

// Record a reason, and say nothing about whether anything was performed.
fn noted(mut reduced: Reduced, why: Accounted) {
    if reduced.refused == null {
        reduced.refused = why
    }
}

// Record a reason for a node the walk stops at: what is inside was not read,
// so "performs something" has to be assumed.
fn stopped(mut reduced: Reduced, why: Accounted) {
    reduced.performs = true
    noted(reduced, why)
}

// The statements of a `catch` handler: only the two shapes whose value the
// walk can take apart are read.
fn reduce_handler(block: ref Block, names: ref winnow_grammar::InternerContext, mut reduced: Reduced) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { value, .. } => reduce(value, names, reduced),
            Stmt::Expr(value) => reduce(value, names, reduced),
            else => stopped(reduced, Accounted::Opaque("a `catch` handler doing more than handing back a value")),
        }
    }
}

// Take a statement's value apart into the calls it performs: literals, calls
// and operators over them. Everything else records a reason and stops, which
// makes adding a shape a deliberate act.
fn reduce(node: ref Expr, names: ref winnow_grammar::InternerContext, mut reduced: Reduced) {
    match node {
        Expr::LitInt { .. } => {}
        Expr::LitFloat(_, _) => {}
        Expr::LitBool(_, _) => {}
        Expr::LitNull(_) => {}
        Expr::LitChar(_, _) => {}
        Expr::LitStr { .. } => {}
        Expr::Call { func, args, config, .. } => {
            // Kap 5.1's options would have to be matched against the callee's
            // declaration order first.
            if config.len() > 0 {
                stopped(reduced, Accounted::Opaque("a call with options, which nothing matches against the callee's order yet"))
                return
            }
            let key = called_key(func, names) ?? return stopped(reduced, Accounted::Opaque("a call through something that is not a name"))
            for arg in args {
                reduce(arg, names, reduced)
            }
            reduced.calls.push(OneCall { key: key, arguments: args.clone() })
        }
        Expr::Unary { expr, .. } => reduce(expr, names, reduced),
        Expr::Cast { expr, .. } => reduce(expr, names, reduced),
        Expr::Binary { op, lhs, rhs, .. } => {
            // `&&` and `||` evaluate their right side only sometimes (D5).
            if a_short_circuit(op) {
                stopped(reduced, Accounted::Opaque("a `&&` or `||`, whose right side runs only sometimes"))
                return
            }
            reduce(lhs, names, reduced)
            reduce(rhs, names, reduced)
        }
        Expr::Tuple(parts, _) => {
            for part in parts {
                reduce(part, names, reduced)
            }
        }
        Expr::ListLit { items, .. } => {
            for item in items {
                reduce(item, names, reduced)
            }
        }
        // A jump ends the sequence (ADR-276 D20).
        Expr::Return(_, _) => stopped(reduced, Accounted::Opaque("a `return`, a `break` or a `continue`")),
        Expr::Break(_) => stopped(reduced, Accounted::Opaque("a `return`, a `break` or a `continue`")),
        Expr::Continue(_) => stopped(reduced, Accounted::Opaque("a `return`, a `break` or a `continue`")),
        // A name is a value from somewhere else, which the closure would have
        // to capture.
        Expr::Variable(name, _) => noted(reduced, Accounted::NonLiteralArgument(names.resolve(name).clone())),
        Expr::Field { base, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            reduce(base, names, reduced)
        }
        Expr::SafeField { base, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            reduce(base, names, reduced)
        }
        Expr::Index { base, index, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            reduce(base, names, reduced)
            reduce(index, names, reduced)
        }
        // **A path names an item, and an item is not a place**: nothing to
        // read, capture or carry.
        Expr::Path(_, _) => {}
        Expr::StructLit { fields, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            for field in fields {
                reduce_maybe(field.value, names, reduced)
            }
        }
        Expr::Range { start, end, .. } => {
            noted(reduced, Accounted::Opaque("a value read from somewhere else"))
            reduce(start, names, reduced)
            reduce(end, names, reduced)
        }
        // `a ?? b` runs `b` only when `a` had nothing (D5).
        Expr::Coalesce { value, fallback, .. } => {
            noted(reduced, Accounted::Opaque("a `??`, whose fallback runs only sometimes"))
            reduce(value, names, reduced)
            reduce(fallback, names, reduced)
        }
        // **A hole is an expression of the tree** (ADR-309): each is read as
        // any other value, the text between them is nothing to read.
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => reduce(expr, names, reduced),
                    else => {},
                }
            }
        }
        // *Which* entry `xs.len()` is needs the type checker (ADR-288); the
        // name is recorded and `accounted` asks whether every entry of it
        // reaches nothing. A `?.m()` is accounted for exactly as a `.m()`.
        Expr::MethodCall { receiver, method, args, config, .. } => reduce_method(receiver, method, args, config, names, reduced),
        Expr::SafeMethod { receiver, method, args, config, .. } => reduce_method(receiver, method, args, config, names, reduced),
        // A lambda's body is in the function and not in this value, and the
        // touch set has to be complete for the statement (D4).
        Expr::Closure { .. } => stopped(reduced, Accounted::Opaque("a lambda, whose body this analysis does not read")),
        // Everything with its own control flow: D5 allows only operations
        // that certainly run.
        else => stopped(reduced, Accounted::Opaque("something with its own control flow")),
    }
}

fn reduce_method(receiver: ref Expr, method: winnow_grammar::Symbol, args: ref Vec[Expr], config: ref Vec[ConfigArg], names: ref winnow_grammar::InternerContext, mut reduced: Reduced) {
    reduce(receiver, names, reduced)
    for arg in args {
        reduce(arg, names, reduced)
    }
    for option in config {
        reduce(option.value, names, reduced)
    }
    reduced.methods.push(names.resolve(method).clone())
}

fn reduce_maybe(expr: ref Expr?, names: ref winnow_grammar::InternerContext, mut reduced: Reduced) {
    reduce(expr ?? return, names, reduced)
}

fn a_short_circuit(op: ref BinaryOp) -> bool {
    return match op {
        BinaryOp::And => true,
        BinaryOp::Or => true,
        else => false,
    }
}

// The ledger key of the call an expression performs: a bare name, or a path
// joined by `::`.
fn called_key(func: ref Expr, names: ref winnow_grammar::InternerContext) -> String? {
    return match func {
        Expr::Variable(name, _) => names.resolve(name).clone(),
        Expr::Path(segments, _) => joined_segments(segments, names),
        else => null,
    }
}

fn joined_segments(segments: ref Vec[winnow_grammar::Symbol], names: ref winnow_grammar::InternerContext) -> String {
    let mut parts: Vec[String] = []
    for segment in segments {
        parts.push(names.resolve(segment).clone())
    }
    return parts.join("::")
}

/// Whether a block can leave **by a door other than its own last statement**
/// - a `return` or a `throw` anywhere in it, and a `break` or `continue` not
/// bound to a loop written inside it. `bound` says such a loop stands between
/// here and the block's end.
fn diverts_within(stmts: ref Vec[Spanned[Stmt]], bound: bool) -> bool {
    for stmt in stmts {
        let leaves = match stmt.node {
            Stmt::Return(_) => true,
            Stmt::Break => !bound,
            Stmt::Continue => !bound,
            Stmt::Expr(expr) => holds_throw(expr, bound),
            Stmt::Emit(expr) => holds_throw(expr, bound),
            Stmt::Let { value, .. } => holds_throw(value, bound),
            Stmt::Comptime { value, .. } => holds_throw(value, bound),
            Stmt::Assign { value, .. } => holds_throw(value, bound),
            Stmt::For { body, .. } => diverts_within(body.stmts, true),
            Stmt::While { body, .. } => diverts_within(body.stmts, true),
        }
        if leaves {
            return true
        }
    }
    return false
}

// Whether an expression can leave the block it is in.
fn holds_throw(expr: ref Expr, bound: bool) -> bool {
    return match expr {
        Expr::Throw(_, _) => true,
        Expr::Block(block, _) => diverts_within(block.stmts, bound),
        Expr::AsyncGroup(block, _, _, _, _) => diverts_within(block.stmts, bound),
        Expr::Overlap(block, _) => diverts_within(block.stmts, bound),
        Expr::If { then_branch, else_branch, .. } => diverts_within(then_branch.stmts, bound) || else_diverts(else_branch, bound),
        Expr::Match { arms, .. } => an_arm_throws(arms, bound),
        else => false,
    }
}

fn else_diverts(block: ref Block?, bound: bool) -> bool {
    let written = block ?? return false
    return diverts_within(written.stmts, bound)
}

fn an_arm_throws(arms: ref Vec[MatchArm], bound: bool) -> bool {
    for arm in arms {
        if holds_throw(arm.body, bound) {
            return true
        }
    }
    return false
}

/// **Every `overlap { … }` block in a program, and what it was allowed**
/// (ADR-292 D3): which branches are started first and which run while they
/// wait (D6), and - where two of them meet on something - the first pair
/// that may not run together and why. `overlaps_in` is the blocks a body
/// holds, at any depth; `pauses` whether a branch can pause, which is the
/// emitter's answer and no analysis's here (ADR-292b).
pub fn overlap_report(items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, walking: ref Walking, overlaps_in: fn(ref Block) -> Vec[Block] sync, pauses: fn(ref Spanned[Stmt]) -> bool sync) -> String {
    let mut out: String = ""
    for item in items {
        match item.node {
            Item::Fn { .. } => block_report(item.node, null, names, walking, overlaps_in, pauses, out),
            Item::Impl { target, methods, .. } => {
                let owner: String? = names.resolve(target.name).clone()
                for method in methods {
                    block_report(method.node, owner, names, walking, overlaps_in, pauses, out)
                }
            }
            else => {}
        }
    }
    if out.len() == 0 {
        out.push_str("this program writes no `overlap { … }` block.\n")
    }
    return out
}

// One function's blocks. **The header is read off the pairs rather than
// asserted**, and the first refused pair is the one named: a block that meets
// on two things has one thing wrong with it.
fn block_report(item: ref Item, target: ref String?, names: ref winnow_grammar::InternerContext, walking: ref Walking, overlaps_in: fn(ref Block) -> Vec[Block] sync, pauses: fn(ref Spanned[Stmt]) -> bool sync, mut out: String) {
    match item {
        Item::Fn { name, body, .. } => {
            let own_name = function_name(names, name)
            let key = keyed(target, own_name)
            for block in overlaps_in(body) {
                one_block_report(key, block, names, walking, pauses, out)
            }
        }
        else => {}
    }
}

fn keyed(target: ref String?, own_name: ref String) -> String {
    let owner = target ?? return own_name.clone()
    return f"{owner}::{own_name}"
}

fn one_block_report(key: ref String, block: ref Block, names: ref winnow_grammar::InternerContext, walking: ref Walking, pauses: fn(ref Spanned[Stmt]) -> bool sync, mut out: String) {
    if block.stmts.len() == 0 {
        return
    }
    let mut operations: Vec[Operation] = []
    let mut present: Vec[bool] = []
    let mut lines: Vec[String] = []
    for stmt in block.stmts {
        // A branch runs beside the others, and its failure is the block's
        // to combine (ADR-292 D11): no reason to leave it unaccounted for.
        let answer = accounted_beside(stmt.node, names, walking)
        let named = match answer {
            Accounted::Operation(operation) => operation.callee.clone(),
            else => "…",
        }
        match answer {
            Accounted::Operation(operation) => {
                operations.push(operation.clone())
                present.push(true)
            }
            else => {
                operations.push(Operation { binds: null, mentions: collections::BTreeSet(), reaches: [], callee: "" })
                present.push(false)
            }
        }
        // D6's two halves, said as they happen.
        let when = if pauses(stmt) { "started first" } else { "runs while they wait" }
        lines.push(f"    {padded_right(when, 22)} {named}")
    }
    let count = block.stmts.len()
    let refused = first_refused(operations, present)
    if refused.len() == 0 {
        out.push_str(ref f"{key}: an `overlap` of {count} branches, which meet on nothing\n")
    } else {
        out.push_str(ref refused_header(key, count, operations, refused))
    }
    for line in lines {
        out.push_str(line)
        out.push('\n')
    }
}

// The first pair, in written order, that may not run together - as its two
// positions, or nothing.
fn first_refused(operations: ref Vec[Operation], present: ref Vec[bool]) -> Vec[i64] {
    for i in 0..<operations.len() {
        for j in (i + 1)..<operations.len() {
            if present[i] && present[j] && !verdict(operations[i], operations[j]).is_overlap() {
                return [i, j]
            }
        }
    }
    return []
}

fn refused_header(key: ref String, count: i64, operations: ref Vec[Operation], pair: ref Vec[i64]) -> String {
    let first = pair[0] + 1
    let second = pair[1] + 1
    let why = verdict(operations[pair[0]], operations[pair[1]]).why()
    return f"{key}: an `overlap` of {count} branches, and branches {first} and {second} may not run together - {why}\n"
}

// `text` padded with spaces on the right to `width` characters.
fn padded_right(text: ref String, width: i64) -> String {
    let mut out = text.clone()
    let mut have = text.scalars.count()
    while have < width {
        out.push(' ')
        have += 1
    }
    return out
}

/// **Every task an `async` form starts, by function** (ADR-async-5 D32): for
/// each, in written order, its window (the first and the last line of what
/// runs beside it), where it is waited for, its group's end, and whether it
/// is started first (ADR-292 D6, D20: a task that may pause is started before
/// the main line runs on). `waits` is the checker's record of each task's
/// wait point and group (`CheckFacts::async_waits`), `pauses` whether a
/// task's expression can pause, which is the emitter's answer (ADR-292b).
/// `""` where the program starts no task.
pub fn task_report(items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, source: ref String, waits: ref collections::BTreeMap[i64, CheckAsyncWait], pauses: fn(ref Expr) -> bool sync) -> String {
    let lines: Vec[ref String] = source.split("\n").collect()
    let mut out: String = ""
    for item in items {
        match item.node {
            Item::Fn { name, body, .. } => tasks_of_function(function_name(names, name), body, lines, waits, pauses, out),
            Item::Impl { target, methods, .. } => {
                let owner: String? = names.resolve(target.name).clone()
                for method in methods {
                    match method.node {
                        Item::Fn { name, body, .. } => tasks_of_function(keyed(owner, function_name(names, name)), body, lines, waits, pauses, out),
                        else => {}
                    }
                }
            }
            else => {}
        }
    }
    return out
}

/// One task as the walk met it: the statement it stands in, innermost, by
/// its span, and whether it is `async(detached)`, which no group waits for.
struct TaskSite {
    start: i64,
    end: i64,
    detached: bool,
    pauses: bool,
}

/// What the walk over one function's body gathers: each task by its node,
/// the end of every statement, and each group's last statement's end, by the
/// group's key as the checker writes it (an `async { }`'s node, or `-1 -` a
/// block's first statement's start).
struct TaskWalk {
    sites: collections::BTreeMap[i64, TaskSite],
    ends: Vec[i64],
    groups: collections::BTreeMap[i64, i64],
}

fn tasks_of_function(key: ref String, body: ref Block, lines: ref Vec[ref String], waits: ref collections::BTreeMap[i64, CheckAsyncWait], pauses: fn(ref Expr) -> bool sync, mut out: String) {
    let mut walk = TaskWalk { sites: collections::BTreeMap(), ends: [], groups: collections::BTreeMap() }
    tasks_in_block(body, walk, pauses)
    if walk.sites.len() == 0 {
        return
    }
    let first = walk.sites.values().filter(fn(site) { site.pauses }).count()
    let count = walk.sites.len()
    let noun = if count == 1 { "task" } else { "tasks" }
    out.push_str(ref f"{key}: {count} {noun} an `async` form starts, {first} of them started first\n")
    let mut number = 0
    for (id, site) in walk.sites {
        number += 1
        let row = task_row(lines, site.start)
        if row < 0 {
            continue
        }
        let line = row + 1
        let written = lines[row].trim()
        out.push_str(ref f"    task {number}, line {line}: `{written}`\n")
        let (window, waited, ends) = task_fields(id, site, line, lines, walk, waits)
        let starts = if site.pauses { "first: it pauses (ADR-292 D6)" } else { "after the tasks before it that pause: it never pauses (ADR-292 D6)" }
        out.push_str(ref f"        window      {window}\n")
        out.push_str(ref f"        waited for  {waited}\n")
        out.push_str(ref f"        group ends  {ends}\n")
        out.push_str(ref f"        starts      {starts}\n")
    }
}

// A task's window, where it is waited for and its group's end, as the
// report says them.
fn task_fields(id: i64, site: ref TaskSite, line: i64, lines: ref Vec[ref String], walk: ref TaskWalk, waits: ref collections::BTreeMap[i64, CheckAsyncWait]) -> (String, String, String) {
    if site.detached {
        return (f"from line {line}, past its group", "where its handle is joined, if it is", "none: it may outlive its group (ADR-async-5 D13)")
    }
    let wait = waits.get(id) ?? return (f"from line {line}", "not recorded by the checker", "not recorded by the checker")
    let group_end = task_last_line(lines, walk.groups.get(wait.group) ?? site.end)
    let ends = f"after line {group_end}"
    return match wait.at {
        CheckAsyncWaitAt::Before(_) => (task_lines(line, task_last_line(lines, site.end)), f"before the call or operation it is part of, line {line}", ends),
        CheckAsyncWaitAt::BeforeStatement(at) => {
            let mut last = site.end
            for end in walk.ends {
                if end <= at && end > last {
                    last = end
                }
            }
            (task_lines(line, task_last_line(lines, last)), f"before line {task_line_of(lines, at)}", ends)
        },
        CheckAsyncWaitAt::GroupEnd => (task_lines(line, group_end), "at its group's end", ends),
        CheckAsyncWaitAt::Handle => (f"{task_lines(line, group_end)} at most", "where its handle is joined, else at its group's end", ends),
    }
}

// The 1-based line the byte `at` stands on.
fn task_line_of(lines: ref Vec[ref String], at: i64) -> i64 {
    return task_row(lines, at) + 1
}

// The 0-based line the byte `at` stands on, -1 where `lines` holds none.
fn task_row(lines: ref Vec[ref String], at: i64) -> i64 {
    let row = line_at(lines, at).0
    if row < 0 || row >= lines.len() {
        return -1
    }
    return row
}

// The 1-based line a span ending at the byte `end` ends on: a statement's
// span runs on to the next one's start, so the blank space before `end`,
// lines included, is left out.
fn task_last_line(lines: ref Vec[ref String], end: i64) -> i64 {
    let at = line_at(lines, end)
    let mut line = at.0
    if line < 0 || line >= lines.len() {
        return 0
    }
    let text = lines[line]
    if line > 0 && text.len() - text.trim_start().len() >= end - at.1 {
        line -= 1
        while line > 0 && lines[line].trim().len() == 0 {
            line -= 1
        }
    }
    return line + 1
}

// `line 3`, or `lines 3-5`.
fn task_lines(first: i64, last: i64) -> String {
    if last <= first {
        return f"line {first}"
    }
    return f"lines {first}-{last}"
}

// Each task of a block's statements, by the innermost statement it stands
// in: a statement's tasks are noted with its span first, and the blocks
// inside it, walked after, note theirs again with their own.
fn tasks_in_block(block: ref Block, mut walk: TaskWalk, pauses: fn(ref Expr) -> bool sync) {
    if block.stmts.len() == 0 {
        return
    }
    let last = block.stmts[block.stmts.len() - 1].span.end as i64
    walk.groups.insert(-1 - block.stmts[0].span.start as i64, last)
    for stmt in block.stmts {
        let start = stmt.span.start as i64
        let end = stmt.span.end as i64
        walk.ends.push(end)
        let exprs = visited_in_stmt(stmt.node)
        for each in exprs {
            match each {
                Expr::Async(_, _, _, _) => {
                    walk.sites.insert(id_of(each) as i64, TaskSite { start: start, end: end, detached: false, pauses: pauses(each) })
                },
                Expr::Spawn { written_async, child, .. } if written_async || child => {
                    walk.sites.insert(id_of(each) as i64, TaskSite { start: start, end: end, detached: !child, pauses: pauses(each) })
                },
                else => {}
            }
        }
        for each in exprs {
            match each {
                Expr::Block(inner, _) => tasks_in_block(inner, walk, pauses),
                Expr::AsyncGroup(inner, _, _, _, _) => {
                    tasks_in_block(inner, walk, pauses)
                    if inner.stmts.len() > 0 {
                        walk.groups.insert(id_of(each) as i64, inner.stmts[inner.stmts.len() - 1].span.end as i64)
                    }
                },
                Expr::Unsafe(inner, _) => tasks_in_block(inner, walk, pauses),
                Expr::Overlap(inner, _) => tasks_in_block(inner, walk, pauses),
                Expr::If { then_branch, else_branch, .. } => {
                    tasks_in_block(then_branch, walk, pauses)
                    let other = else_branch ?? continue
                    tasks_in_block(other, walk, pauses)
                },
                Expr::Closure { body, .. } => tasks_in_block(body, walk, pauses),
                Expr::TryCatch { handler, .. } => tasks_in_block(handler, walk, pauses),
                else => {}
            }
        }
        match stmt.node {
            Stmt::For { body, .. } => tasks_in_block(body, walk, pauses),
            Stmt::While { body, .. } => tasks_in_block(body, walk, pauses),
            else => {}
        }
    }
}

/// **Every `par_iter` call and the execution chosen for it**, for
/// `--overlaps` (ADR-async-5 D25, D32): one task per element where a `map`,
/// `filter` or `for_each` of the walk has a lambda that pauses, named by the
/// call in it that pauses; in pieces on the cores where none does. `fanned`
/// answers, by a lambda's node, whether the checker handed it to the
/// one-task-per-element entry; `pauses` whether an expression may pause.
pub fn par_report(items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, source: ref String, fanned: fn(i64) -> bool sync, pauses: fn(ref Expr) -> bool sync) -> String {
    let lines: Vec[ref String] = source.split("\n").collect()
    let mut out: String = ""
    let sites = par_sites(items, names, fanned, pauses)
    let mut at = 0
    while at < sites.len() {
        let key = sites[at].function.clone()
        let mut count = 0
        while at + count < sites.len() && sites[at + count].function == key {
            count += 1
        }
        let noun = if count == 1 { "call" } else { "calls" }
        out.push_str(ref f"{key}: {count} `par_iter` {noun}\n")
        for k in 0..<count {
            let site: ref ParSite = sites[at + k]
            let line = line_at(lines, site.start).0 + 1
            let written = lines[line - 1].trim()
            out.push_str(ref f"    par_iter {site.number}, line {line}: `{written}`\n")
            let runs = match site.pausing {
                null => "in pieces on the cores: no lambda of it pauses (ADR-async-5 D25)",
                pause => f"one task per element: a lambda of it pauses at its call of `{pause?.callee ?? ""}` (ADR-async-5 D25)",
            }
            out.push_str(ref f"        runs        {runs}\n")
        }
        at += count
    }
    return out
}

/// **One `par_iter` call of a function and the execution chosen for it**
/// (ADR-async-5 D25, D32): what `--overlaps` reports, what the ledger's
/// `par_iter` column records, and what `NK2119` compares against it.
pub struct ParSite {
    /// The function it stands in, by the ledger's key.
    pub function: String,
    /// Its place among that function's `par_iter` calls, from 1.
    pub number: i64,
    /// The start of the statement it stands in, innermost.
    pub start: i64,
    /// The call that makes a lambda of it pause, where one does: it then
    /// runs one task per element; `null` runs it in pieces.
    pub pausing: ParPause?,
}

/// **The call that makes a `par_iter` lambda pause**: its callee as a
/// message names it, and the statement of the lambda it stands in.
pub struct ParPause {
    pub callee: String,
    pub span: Span,
}

/// **Every `par_iter` call of the items**, function by function in their
/// order and each function's calls in theirs. `fanned` answers, by a
/// lambda's node, whether the checker handed it to the one-task-per-element
/// entry; `pauses` whether an expression may pause.
pub fn par_sites(items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, fanned: fn(i64) -> bool sync, pauses: fn(ref Expr) -> bool sync) -> Vec[ParSite] {
    let mut out: Vec[ParSite] = []
    for item in items {
        match item.node {
            Item::Fn { name, body, .. } => par_walks_of_function(function_name(names, name), body, names, fanned, pauses, out),
            Item::Impl { target, methods, .. } => {
                let owner: String? = names.resolve(target.name).clone()
                for method in methods {
                    match method.node {
                        Item::Fn { name, body, .. } => par_walks_of_function(keyed(owner, function_name(names, name)), body, names, fanned, pauses, out),
                        else => {}
                    }
                }
            }
            else => {}
        }
    }
    return out
}

/// **The `par_iter` sites of a checked unit** (ADR-async-5 D32): a lambda
/// is fanned where the check handed it to a `fan_*` entry, and a call pauses
/// as the emitter decides it - a free call by the key it resolves to in
/// `own` or `library`, a method call by what the check said of it.
pub fn par_sites_checked(items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, aliases: ref collections::BTreeMap[String, String], facts: ref CheckFacts, own: ref Ledger, library: ref Ledger) -> Vec[ParSite] {
    return par_sites(items, names, fn(lambda) { par_fanned(facts, lambda) }, fn(call) { par_call_pauses(names, aliases, facts, own, library, call) })
}

fn par_fanned(facts: ref CheckFacts, lambda: i64) -> bool sync {
    let entry = facts.pausing_lambdas.get(lambda) ?? return false
    return match entry {
        FactPausing::Function(name) => name.starts_with("fan_"),
        else => false,
    }
}

fn par_call_pauses(names: ref winnow_grammar::InternerContext, aliases: ref collections::BTreeMap[String, String], facts: ref CheckFacts, own: ref Ledger, library: ref Ledger, call: ref Expr) -> bool sync {
    return match call {
        Expr::Call { func, .. } => call_pausing_key(names, aliases, own, library, func) != null,
        Expr::MethodCall { receiver, .. } => facts.pausing_methods.contains(node_key(receiver)),
        Expr::SafeMethod { receiver, .. } => facts.pausing_methods.contains(node_key(receiver)),
        else => false,
    }
}

/// One `par_iter` call as the walk met it: the start of the statement it
/// stands in, innermost, and the call that made a lambda of it pause.
struct ParWalkSite {
    start: i64,
    cause: ParPause?,
}

fn par_walks_of_function(key: ref String, body: ref Block, names: ref winnow_grammar::InternerContext, fanned: fn(i64) -> bool sync, pauses: fn(ref Expr) -> bool sync, mut out: Vec[ParSite]) {
    let mut sites: collections::BTreeMap[i64, ParWalkSite] = collections::BTreeMap()
    par_walks_in_block(body, sites, names, fanned, pauses)
    let mut number = 0
    for (_, site) in sites {
        number += 1
        out.push(ParSite { function: key.clone(), number: number, start: site.start, pausing: site.cause?.clone() })
    }
}

fn par_walks_in_block(block: ref Block, mut sites: collections::BTreeMap[i64, ParWalkSite], names: ref winnow_grammar::InternerContext, fanned: fn(i64) -> bool sync, pauses: fn(ref Expr) -> bool sync) {
    for stmt in block.stmts {
        let start = stmt.span.start as i64
        let exprs = visited_in_stmt(stmt.node)
        for each in exprs {
            match each {
                Expr::MethodCall { method, .. } if names.resolve(method) == "par_iter" => {
                    let id = id_of(each) as i64
                    let mut site = sites.get(id)?.clone() ?? ParWalkSite { start: start, cause: null }
                    site.start = start
                    sites.insert(id, site)
                },
                else => {}
            }
        }
        for each in exprs {
            let (walk, lambda) = par_lambda_step(each, names) ?? continue
            if !fanned(id_of(lambda) as i64) {
                continue
            }
            let at: i64 = id_of(walk) as i64
            let mut site = sites.get(at)?.clone() ?? ParWalkSite { start: start, cause: null }
            if site.cause == null {
                site.cause = par_pausing_call(lambda, names, pauses)
            }
            sites.insert(at, site)
        }
        for each in exprs {
            match each {
                Expr::Closure { body, .. } => par_walks_in_block(body, sites, names, fanned, pauses),
                else => {}
            }
        }
        match stmt.node {
            Stmt::For { body, .. } => par_walks_in_block(body, sites, names, fanned, pauses),
            Stmt::While { body, .. } => par_walks_in_block(body, sites, names, fanned, pauses),
            else => {}
        }
    }
}

/// A `map`, `filter` or `for_each` over a walk a `par_iter` call starts:
/// that call and the step's lambda.
fn par_lambda_step(each: ref Expr, names: ref winnow_grammar::InternerContext) -> (ref Expr, ref Expr)? {
    let (receiver, method, args) = match each {
        Expr::MethodCall { receiver, method, args, .. } => (receiver, names.resolve(method), args),
        else => return null,
    }
    if method != "map" && method != "filter" && method != "for_each" || args.len() != 1 {
        return null
    }
    let lambda: ref Expr = args[0]
    let mut on: ref Expr = receiver
    while true {
        match on {
            Expr::MethodCall { receiver: inner, method: step, .. } => {
                if names.resolve(step) == "par_iter" {
                    return (on, lambda)
                }
                on = inner
            },
            else => return null,
        }
    }
    return null
}

/// The innermost call in a lambda that may pause, by its callee, and the
/// statement of the lambda's body it stands in.
fn par_pausing_call(lambda: ref Expr, names: ref winnow_grammar::InternerContext, pauses: fn(ref Expr) -> bool sync) -> ParPause? {
    let body: ref Block = match lambda {
        Expr::Closure { body, .. } => body,
        else => return null,
    }
    for stmt in body.stmts {
        for each in visited_in_stmt(stmt.node) {
            let callee: String = match each {
                Expr::Call { func, .. } => called_key(func, names) ?? continue,
                Expr::MethodCall { method, .. } => names.resolve(method).clone(),
                else => continue,
            }
            if !pauses(each) || par_call_inside_pauses(each, pauses) {
                continue
            }
            return ParPause { callee: callee, span: Span { start: stmt.span.start, end: stmt.span.end } }
        }
    }
    return null
}

/// Whether a call inside `call`, not `call` itself, may pause.
fn par_call_inside_pauses(call: ref Expr, pauses: fn(ref Expr) -> bool sync) -> bool {
    let own = id_of(call)
    for each in visited_in_expr(call) {
        if id_of(each) == own {
            continue
        }
        let a_call = match each {
            Expr::Call { .. } => true,
            Expr::MethodCall { .. } => true,
            else => false,
        }
        if a_call && pauses(each) {
            return true
        }
    }
    return false
}
