// crates/nikaia-std/src/compiler/prover_solver.nika
//
// **What the prover asks the solver** (ADR-269 D8, ADR-270 D3-D5), moved
// from the compiler's `prove` (ADR-294, #436 step 4). The solver itself is
// `nikaia-logic`, reached through two callbacks that read the walk's arena:
// `ask`, whether facts imply a goal with a checked certificate, and
// `model`, values that make the facts true and the goal false, checked by
// evaluating them.

use std::collections
use logic

/// What the solver says to one question.
pub enum SolverAnswer {
    /// Shown, with a certificate that was checked.
    Proved,
    /// The certificate was rejected, for the reason given.
    Rejected(String),
    /// Not shown.
    NotProved,
}

/// **The values that show a claim false every time it is reached**
/// (ADR-269 D8): the solver proves, with a checked certificate, that the
/// facts rule the claim out - so it is false in every state the program
/// reaches it in - and a model of the facts, checked by evaluating it, gives
/// values for the claim's names. A model alone would not do: the facts are
/// true but not all that is true, so a value they allow need not be one the
/// program reaches. Nothing where either is missing.
fn refuting_values(mut arena: logic::TermArena, facts: ref Vec[i64], claim: i64, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) -> collections::BTreeMap[String, i64]? {
    let negation = arena.not(claim)
    match ask(arena, facts, negation) {
        SolverAnswer::Proved => {},
        else => return null,
    }
    let falsum = arena.boolean(false)
    let values = model(arena, facts, falsum) ?? return null
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    arena.variables(claim, names)
    return values_of(names, values)
}

/// **The values the facts force on an `i64` operation, where it overflows
/// on them** (ADR-396 D8 step 2, ADR-270 D11, #1810): the solver, counting
/// in `i64` and never wrapping, answers nothing about a goal at the type's
/// ends, so `assert(x == 9223372036854775000)` then `x + 1000` is refuted
/// by neither `refuting_values` nor `breaking_values`. A model of the facts
/// gives each name of `term` a value; where `term` leaves `i64` on them in
/// checked arithmetic and the solver proves every name equal to its value,
/// every state that reaches it overflows. Nothing where a name is read by
/// no fact (no model is asked then), the model is missing, `term` fits, or
/// a value is not forced.
fn forced_overflow_values(mut arena: logic::TermArena, facts: ref Vec[i64], term: i64, names: ref collections::BTreeSet[String], ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) -> collections::BTreeMap[String, i64]? {
    if names.is_empty() {
        return null
    }
    let mut tied: collections::BTreeSet[String] = collections::BTreeSet()
    for fact in facts {
        arena.variables(fact, tied)
    }
    for name in names {
        if !tied.contains(name) {
            return null
        }
    }
    let falsum = arena.boolean(false)
    let found = model(arena, facts, falsum) ?? return null
    let values = values_of(names, found)
    if values.len() != names.len() || arena.int_value(term, values) != null {
        return null
    }
    for (name, value) in values {
        let named = arena.var(name)
        let pinned = arena.int(value)
        let forced = arena.equal(named, pinned)
        match ask(arena, facts, forced) {
            SolverAnswer::Proved => {},
            else => return null,
        }
    }
    return values
}

/// **Values that reach a claim and make it false** (ADR-269 D8), where it
/// is not false every time: a model of the facts and the claim's negation,
/// checked by evaluating it, read where the facts are exactly what reaches
/// here and pin every name the claim depends on (`ProverScope::pinned_names`).
/// Then the model is a state the program reaches, unless it stops or leaves
/// before. Every name the state is made of is given, so that a loop's counter
/// is shown beside what was computed from it. Nothing everywhere else.
fn breaking_values(mut arena: logic::TermArena, scope: ref ProverScope, claim: i64, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) -> collections::BTreeMap[String, i64]? {
    let names = scope.pinned_names(arena, claim) ?? return null
    let values = model(arena, scope.facts, claim) ?? return null
    let shown = values_of(names, values)
    if shown.is_empty() {
        return null
    }
    return shown
}

/// Each of `names` the model gives a value, with it.
fn values_of(names: ref collections::BTreeSet[String], values: ref collections::BTreeMap[String, i64]) -> collections::BTreeMap[String, i64] {
    let mut shown: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for name in names {
        let value = values[name] ?? continue
        shown.insert(name.clone(), value)
    }
    return shown
}
