// crates/nikaia-std/src/compiler/prover_calls.nika
//
// **What the prover reads of a call's callee** (ADR-269), moved from the
// compiler's `prove` (ADR-294, #436 step 4): a free function of this
// program by name, whether a call may throw out of the function it
// stands in, and whether a value came from outside the program.

use std::collections

/// What the prover reads of a free function of this program.
pub struct FreeFunction {
    /// Its parameters' names, in order: the subject parameters, then the
    /// options (Part I 5.1) in the order they are declared.
    pub params: Vec[String],
    /// Its options' names and defaults, in the order they are declared.
    pub options: Vec[(String, Expr)],
    /// It `throws`.
    pub can_throw: bool,
    /// It hands back a whole number.
    pub whole_result: bool,
}

/// The free function of `program` named `wanted`: not a method, which a call
/// by name never reaches.
fn free_function(program: ref Program, words: ref winnow_grammar::InternerContext, wanted: ref String) -> FreeFunction? {
    for item in program.items {
        match item.node {
            Item::Fn { name, receiver, args, config, ret_type, can_throw, .. } => {
                if receiver == null && named_as(name, words, wanted) {
                    let mut params: Vec[String] = []
                    for arg in args {
                        params.push(words.resolve(arg.name).clone())
                    }
                    let mut options: Vec[(String, Expr)] = []
                    for option in config {
                        params.push(words.resolve(option.name).clone())
                        options.push((words.resolve(option.name).clone(), option.default.clone()))
                    }
                    return FreeFunction { params: params, options: options, can_throw: can_throw, whole_result: whole_type(ret_type, words) }
                }
            },
            else => {},
        }
    }
    return null
}

/// The method `wanted` of `owner`'s own `impl` (not a trait's), as a call
/// `self.wanted(…)` in a method of `owner` reaches it: its parameters without
/// the receiver (#776).
fn own_method(program: ref Program, words: ref winnow_grammar::InternerContext, owner: ref String, wanted: ref String) -> FreeFunction? {
    for item in program.items {
        match item.node {
            Item::Impl { methods, target, trait_name } => {
                if trait_name == null && words.resolve(target.name) == owner {
                    for method in methods {
                        match method.node {
                            Item::Fn { name, receiver, args, config, ret_type, can_throw, .. } => {
                                if receiver != null && named_as(name, words, wanted) {
                                    let mut params: Vec[String] = []
                                    for arg in args {
                                        params.push(words.resolve(arg.name).clone())
                                    }
                                    let mut options: Vec[(String, Expr)] = []
                                    for option in config {
                                        params.push(words.resolve(option.name).clone())
                                        options.push((words.resolve(option.name).clone(), option.default.clone()))
                                    }
                                    return FreeFunction { params: params, options: options, can_throw: can_throw, whole_result: whole_type(ret_type, words) }
                                }
                            },
                            else => {},
                        }
                    }
                }
            },
            else => {},
        }
    }
    return null
}

/// **A call's arguments in the order of `function`'s parameters**: the
/// positional ones as written, then each option as the call names it, or its
/// default where the call leaves it out (ADR-318), so a claim about an option
/// is proved at the call as one about a subject parameter is (ADR-269 D5).
fn arguments_in_order(function: ref FreeFunction, args: ref Vec[Expr], config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext) -> Vec[Expr] {
    let mut all: Vec[Expr] = args.clone()
    for (option, default) in function.options {
        let mut value = default.clone()
        for given in config {
            if words.resolve(given.name) == option {
                value = given.value.clone()
            }
        }
        all.push(value)
    }
    return all
}

fn named_as(named: ref winnow_grammar::Symbol?, words: ref winnow_grammar::InternerContext, name: ref String) -> bool {
    let symbol = named ?? return false
    return words.resolve(symbol) == name
}

fn whole_type(ty: ref Type?, words: ref winnow_grammar::InternerContext) -> bool {
    let t = ty ?? return false
    return t.generics.is_empty() && is_whole_number(words.resolve(t.name))
}

/// **Whether a call may throw out of the function it stands in**, where
/// that one `throws` (`in_throwing`): what the callee declares, by its
/// `throws` or its ledger's; a call nothing describes may. `unaliased`
/// resolves a package's alias.
///
/// **A failure only the world decides does not count** (ADR-392): a call
/// whose every failure is `io::IoError` - a `println`, a file read - fails or
/// not by what is outside the program, never by its values, so it narrows no
/// state past it; for each state there is a world in which it goes on.
fn may_throw(call: ref Expr, in_throwing: bool, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, unaliased: fn(ref String) -> String sync) -> bool {
    if !in_throwing {
        return false
    }
    let name = thrower_named(call, words, unaliased) ?? return true
    let function = free_function(program, words, name)
    if function != null {
        let found = function ?? return true
        if !found.can_throw {
            return false
        }
        let inferred = own.functions[name] ?? return true
        return inferred.fails_with.is_empty() || fails_by_the_program(inferred.fails_with)
    }
    if own.functions.contains_key(name) {
        let contract = own.functions[name] ?? return true
        return fails_by_the_program(contract.fails_with)
    }
    let contract = library.functions[name] ?? return true
    return fails_by_the_program(contract.fails_with)
}

/// Whether one of the failures a contract names is not the world's
/// (`io::IoError`), so the program's values may decide it.
fn fails_by_the_program(fails_with: ref Vec[String]) -> bool {
    for one in fails_with {
        if one != "io::IoError" {
            return true
        }
    }
    return false
}

/// The callee a call names: a bare name, or a path as the ledger keys it.
fn thrower_named(call: ref Expr, words: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync) -> String? {
    return match call {
        Expr::Call { func, .. } => match func {
            Expr::Variable(name, _) => words.resolve(name).clone(),
            Expr::Path(segments, _) => {
                let mut joined: String = ""
                for segment in segments {
                    if !joined.is_empty() {
                        joined.push_str("::")
                    }
                    joined.push_str(words.resolve(segment))
                }
                unaliased(joined)
            },
            else => null,
        },
        else => null,
    }
}

/// **Whether a value came from outside the program** (ADR-010 D2): it names
/// a binding in `tainted`, or calls a source `std`'s ledger calls untrusted
/// without writing `trusted: true` (ADR-365 D2) and not as the operator's
/// read of the environment (ADR-397 D2) - anywhere inside it, as `contracts::sync`'s walk reads it: every
/// expression, not into its blocks, the holes of its literals included; an
/// `if`, a `match` and a block by the value each ends in.
fn from_outside(expr: ref Expr, tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    match expr {
        Expr::Variable(name, _) => {
            if tainted.contains(words.resolve(name)) {
                return true
            }
        },
        Expr::Call { func, args, config, .. } => {
            let source = outside_source_named(func, words)
            // **A read of the environment the operator chose** (ADR-397 D1,
            // D2) is no outside data, by the name it reads.
            if source != null && untrusted(library, source ?? "") && !says_trusted(words, config) && !operator_read(library, source ?? "", args) {
                return true
            }
            // **A function that hands back its proof** (ADR-raw-sinks-1
            // D10, D14): each value it returns is a literal or a guarded
            // name joined to a clean part. A parameter it reads as that
            // clean part must not come from outside here.
            if source != null && state.outside.proved_result(source ?? "") {
                let led = state.outside.leads.get(source ?? "")?.clone() ?? collections::BTreeSet()
                for at in led {
                    if at < args.len() && from_outside(args[at], tainted, words, library, state, holes_of) {
                        return true
                    }
                }
                return false
            }
            // **A function of the package whose result comes from outside**
            // (#1573): its value is as untrusted as its source.
            if source != null && state.outside.results.contains_key(source ?? "") {
                return true
            }
        },
        // **A source method marked `trusted: true`** (ADR-365 D2): what it
        // hands back is the operator's, whatever its receiver came from.
        // Unmarked, the method the checker resolved it to (`callees`, by
        // the receiver's node) says whether it reads from outside (#1446).
        Expr::MethodCall { receiver, method, config, .. } => {
            if says_trusted(words, config) && a_source_method(library, words.resolve(method)) {
                return false
            }
            if untrusted(library, state.method_callees.get(id_of(receiver) as i64) ?? "") && !says_trusted(words, config) {
                return true
            }
            if state.outside.results.contains_key(state.method_callees.get(id_of(receiver) as i64) ?? "") {
                return true
            }
        },
        Expr::SafeMethod { receiver, method, config, .. } => {
            if says_trusted(words, config) && a_source_method(library, words.resolve(method)) {
                return false
            }
            if untrusted(library, state.method_callees.get(id_of(receiver) as i64) ?? "") && !says_trusted(words, config) {
                return true
            }
            if state.outside.results.contains_key(state.method_callees.get(id_of(receiver) as i64) ?? "") {
                return true
            }
        },
        else => {},
    }
    for hole in holes_of(expr) {
        if from_outside(hole, tainted, words, library, state, holes_of) {
            return true
        }
    }
    return match expr {
        Expr::Call { func, args, config, .. } => from_outside(func, tainted, words, library, state, holes_of) || any_from_outside(args, tainted, words, library, state, holes_of) || config_from_outside(config, tainted, words, library, state, holes_of),
        Expr::MethodCall { receiver, args, config, .. } => from_outside(receiver, tainted, words, library, state, holes_of) || any_from_outside(args, tainted, words, library, state, holes_of) || config_from_outside(config, tainted, words, library, state, holes_of),
        Expr::SafeMethod { receiver, args, config, .. } => from_outside(receiver, tainted, words, library, state, holes_of) || any_from_outside(args, tainted, words, library, state, holes_of) || config_from_outside(config, tainted, words, library, state, holes_of),
        Expr::Binary { lhs, rhs, .. } => from_outside(lhs, tainted, words, library, state, holes_of) || from_outside(rhs, tainted, words, library, state, holes_of),
        Expr::Unary { expr, .. } => from_outside(expr, tainted, words, library, state, holes_of),
        Expr::Try(inner, _) => from_outside(inner, tainted, words, library, state, holes_of),
        Expr::Async(inner, _, _, _) => from_outside(inner, tainted, words, library, state, holes_of),
        Expr::Throw(inner, _) => from_outside(inner, tainted, words, library, state, holes_of),
        Expr::Cast { expr, .. } => from_outside(expr, tainted, words, library, state, holes_of),
        Expr::Field { base, name, .. } => outside_field(base, name, words, state) != null || from_outside(base, tainted, words, library, state, holes_of),
        Expr::SafeField { base, .. } => from_outside(base, tainted, words, library, state, holes_of),
        Expr::Index { base, index, .. } => from_outside(base, tainted, words, library, state, holes_of) || from_outside(index, tainted, words, library, state, holes_of),
        Expr::Range { start, end, .. } => from_outside(start, tainted, words, library, state, holes_of) || from_outside(end, tainted, words, library, state, holes_of),
        Expr::Tuple(parts, _) => any_from_outside(parts, tainted, words, library, state, holes_of),
        Expr::Coalesce { value, fallback, .. } => from_outside(value, tainted, words, library, state, holes_of) || from_outside(fallback, tainted, words, library, state, holes_of),
        Expr::TryCatch { expr, .. } => from_outside(expr, tainted, words, library, state, holes_of),
        // **An `if` or a `match` is the value of the branch taken**
        // (ADR-raw-sinks-1 D10): a choice among the program's own values by
        // an outside condition hands back one of them, not outside data, and
        // an outside value in a branch makes the whole value outside.
        Expr::If { then_branch, else_branch, .. } => {
            if tail_from_outside(then_branch, tainted, words, library, state, holes_of) {
                return true
            }
            let other = else_branch ?? return false
            tail_from_outside(other, tainted, words, library, state, holes_of)
        },
        Expr::Block(block, _) => tail_from_outside(block, tainted, words, library, state, holes_of),
        Expr::Match { arms, .. } => {
            for arm in arms {
                if from_outside(arm.body, tainted, words, library, state, holes_of) {
                    return true
                }
            }
            false
        },
        Expr::StructLit { fields, .. } => {
            for field in fields {
                if maybe_from_outside(field.value, tainted, words, library, state, holes_of) {
                    return true
                }
            }
            false
        },
        Expr::ListRepeat { value, count, .. } => from_outside(value, tainted, words, library, state, holes_of) || from_outside(count, tainted, words, library, state, holes_of),
        Expr::ListLit { items, .. } => any_from_outside(items, tainted, words, library, state, holes_of),
        Expr::With { base, fields, .. } => {
            if from_outside(base, tainted, words, library, state, holes_of) {
                return true
            }
            for field in fields {
                if maybe_from_outside(field.value, tainted, words, library, state, holes_of) {
                    return true
                }
            }
            false
        },
        Expr::Return(value, _) => maybe_from_outside(value, tainted, words, library, state, holes_of),
        Expr::Select(arms, _) => {
            for arm in arms {
                if from_outside(arm.value, tainted, words, library, state, holes_of) {
                    return true
                }
            }
            false
        },
        else => false,
    }
}

/// Whether the value `block` ends in comes from outside (`tail_value_of`).
fn tail_from_outside(block: ref Block, tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    let tail = tail_value_of(block) ?? return false
    return from_outside(tail, tainted, words, library, state, holes_of)
}

fn maybe_from_outside(expr: ref Expr?, tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    let present = expr ?? return false
    return from_outside(present, tainted, words, library, state, holes_of)
}

fn any_from_outside(exprs: ref Vec[Expr], tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    for e in exprs {
        if from_outside(e, tainted, words, library, state, holes_of) {
            return true
        }
    }
    return false
}

fn config_from_outside(config: ref Vec[ConfigArg], tainted: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    for c in config {
        if from_outside(c.value, tainted, words, library, state, holes_of) {
            return true
        }
    }
    return false
}

/// A call's callee as `std`'s ledger keys a source: a bare name, or a path.
/// **The source a value from outside reads** (ADR-396 D1), as the message
/// of an index it reaches names it: the first call to an untrusted source
/// inside it (`io::read_to_string`), or the source of a name in `tainted`
/// it reads. Null where `from_outside` would find none, or only one this
/// shorter walk does not reach; the message then names the binding alone.
fn outside_source(expr: ref Expr, tainted: ref collections::BTreeSet[String], sources: ref collections::BTreeMap[String, String], words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> String? {
    match expr {
        Expr::Variable(name, _) => {
            let n = words.resolve(name)
            if tainted.contains(n) {
                return sources[n]?.clone() ?? n.clone()
            }
            return null
        },
        Expr::Call { func, args, config, .. } => {
            let source = outside_source_named(func, words)
            if source != null && untrusted(library, source ?? "") && !says_trusted(words, config) {
                return source
            }
            if source != null {
                let own = state.outside.results[source ?? ""]
                if own != null {
                    return own?.clone()
                }
            }
            return outside_source_in(args, tainted, sources, words, library, state, holes_of)
        },
        Expr::MethodCall { receiver, args, config, .. } => {
            let callee = state.method_callees.get(id_of(receiver) as i64) ?? ""
            if untrusted(library, callee) && !says_trusted(words, config) {
                return callee.clone()
            }
            let own = state.outside.results[callee]
            if own != null {
                return own?.clone()
            }
            return outside_source(receiver, tainted, sources, words, library, state, holes_of) ?? outside_source_in(args, tainted, sources, words, library, state, holes_of)
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            let callee = state.method_callees.get(id_of(receiver) as i64) ?? ""
            if untrusted(library, callee) && !says_trusted(words, config) {
                return callee.clone()
            }
            let own = state.outside.results[callee]
            if own != null {
                return own?.clone()
            }
            return outside_source(receiver, tainted, sources, words, library, state, holes_of) ?? outside_source_in(args, tainted, sources, words, library, state, holes_of)
        },
        Expr::Binary { lhs, rhs, .. } => return outside_source(lhs, tainted, sources, words, library, state, holes_of) ?? outside_source(rhs, tainted, sources, words, library, state, holes_of),
        Expr::Unary { expr, .. } => return outside_source(expr, tainted, sources, words, library, state, holes_of),
        Expr::Try(inner, _) => return outside_source(inner, tainted, sources, words, library, state, holes_of),
        Expr::Cast { expr, .. } => return outside_source(expr, tainted, sources, words, library, state, holes_of),
        Expr::Field { base, name, .. } => return outside_field(base, name, words, state) ?? outside_source(base, tainted, sources, words, library, state, holes_of),
        Expr::SafeField { base, .. } => return outside_source(base, tainted, sources, words, library, state, holes_of),
        Expr::Index { base, index, .. } => return outside_source(index, tainted, sources, words, library, state, holes_of) ?? outside_source(base, tainted, sources, words, library, state, holes_of),
        Expr::Coalesce { value, fallback, .. } => return outside_source(value, tainted, sources, words, library, state, holes_of) ?? outside_source(fallback, tainted, sources, words, library, state, holes_of),
        Expr::TryCatch { expr, .. } => return outside_source(expr, tainted, sources, words, library, state, holes_of),
        Expr::If { then_branch, else_branch, .. } => {
            let then_tail = tail_value_of(then_branch)
            if then_tail != null {
                let first = outside_source(then_tail ?? return null, tainted, sources, words, library, state, holes_of)
                if first != null {
                    return first
                }
            }
            let other = else_branch ?? return null
            let else_tail = tail_value_of(other) ?? return null
            return outside_source(else_tail, tainted, sources, words, library, state, holes_of)
        },
        Expr::Block(block, _) => {
            let tail = tail_value_of(block) ?? return null
            return outside_source(tail, tainted, sources, words, library, state, holes_of)
        },
        Expr::Match { arms, .. } => {
            for arm in arms {
                let found = outside_source(arm.body, tainted, sources, words, library, state, holes_of)
                if found != null {
                    return found
                }
            }
            return null
        },
        Expr::StructLit { fields, .. } => {
            for field in fields {
                let named = words.resolve(field.name)
                let found = match field.value {
                    null => match tainted.contains(named) {
                        true => sources[named]?.clone() ?? named.clone(),
                        false => null,
                    },
                    given => outside_source(given, tainted, sources, words, library, state, holes_of),
                }
                if found != null {
                    return found
                }
            }
            return null
        },
        else => {},
    }
    return outside_source_in(holes_of(expr), tainted, sources, words, library, state, holes_of)
}

fn outside_source_in(exprs: ref Vec[Expr], tainted: ref collections::BTreeSet[String], sources: ref collections::BTreeMap[String, String], words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> String? {
    for e in exprs {
        let found = outside_source(e, tainted, sources, words, library, state, holes_of)
        if found != null {
            return found
        }
    }
    return null
}

/// **The source of a field a struct literal of the package filled from
/// outside** (#1573), `Type.field` by the struct the checker read it from;
/// null for any other field.
fn outside_field(base: ref Expr, name: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext, state: ref ProverState) -> String? {
    let owner = state.field_owners.get(id_of(base) as i64) ?? return null
    let key = f"{owner}.{words.resolve(name)}"
    return state.outside.fields[key]?.clone()
}

fn outside_source_named(func: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match func {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        Expr::Path(segments, _) => {
            let mut joined: String = ""
            for segment in segments {
                if !joined.is_empty() {
                    joined.push_str("::")
                }
                joined.push_str(words.resolve(segment))
            }
            joined
        },
        else => null,
    }
}

/// Whether `name` is the last name of a method `library` calls an untrusted
/// source (ADR-010 D2): the prover reads the tree, not the receiver's type.
fn a_source_method(library: ref Ledger, name: ref String) -> bool {
    let tail = f"::{name}"
    for (key, contract) in library.functions {
        let provenance = contract.provenance ?? continue
        let a_method = contract.signature?.takes_a_receiver() ?? false
        if provenance == Provenance::Untrusted && a_method && key.ends_with(tail) {
            return true
        }
    }
    return false
}

fn untrusted(library: ref Ledger, name: ref String) -> bool {
    let contract = library.functions[name] ?? return false
    let provenance = contract.provenance ?? return false
    return provenance == Provenance::Untrusted
}

/// **What carries outside data in a package** (ADR-396 D1, #1573), by the
/// source each one reads: the functions whose result comes from outside,
/// by the ledger's key, and the fields a struct literal fills with it, as
/// `Type.field`. The walk follows a value through a call and a field of the
/// package as it follows it through a binding. `returning` holds the
/// functions with a result and `valued` those of them that hand back a
/// value that is not proved: one in `returning` but not in `valued` hands
/// back only literals (ADR-raw-sinks-1 D10, as a `match` whose arms are
/// literals) and guarded names joined to a clean part (D14, #2375), so its
/// result is not outside, whatever its arguments are. `leads` holds, by
/// function, the parameters (by position) such a join starts with: the
/// clean part only where the call's argument there is not outside.
pub struct ProverOutside {
    pub results: collections::BTreeMap[String, String],
    pub fields: collections::BTreeMap[String, String],
    pub returning: collections::BTreeSet[String],
    pub valued: collections::BTreeSet[String],
    pub leads: collections::BTreeMap[String, collections::BTreeSet[i64]],
}

impl ProverOutside {
    pub fn nothing() -> ProverOutside {
        return ProverOutside { results: collections::BTreeMap(), fields: collections::BTreeMap(), returning: collections::BTreeSet(), valued: collections::BTreeSet(), leads: collections::BTreeMap() }
    }

    /// Whether every value the function `key` hands back is proved: a
    /// literal or a guarded name joined to a clean part (ADR-raw-sinks-1
    /// D10, D14).
    pub fn proved_result(ref self, key: ref String) -> bool {
        return self.returning.contains(key) && !self.valued.contains(key)
    }
}

/// **One round of what carries outside data** (#1573): every function and
/// method of `program` read with what `state.outside` already holds, so the
/// rounds repeat until nothing is added. Bindings are followed in the order
/// they are written, without branches told apart: a value that may come
/// from outside is taken as coming from outside.
fn prover_outside(program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> ProverOutside {
    let mut found = ProverOutside { results: state.outside.results.clone(), fields: state.outside.fields.clone(), returning: collections::BTreeSet(), valued: collections::BTreeSet(), leads: collections::BTreeMap() }
    for item in program.items {
        match item.node {
            Item::Fn { .. } => prover_outside_function(found, item, null, words, library, state, holes_of),
            Item::Impl { methods, target, .. } => {
                let owner = words.resolve(target.name).clone()
                for method in methods {
                    prover_outside_function(found, method, owner.clone(), words, library, state, holes_of)
                }
            },
            else => {},
        }
    }
    return found
}

/// One function or method of `owner`: its body read twice, so a binding a
/// loop taints later is seen where it is read before.
fn prover_outside_function(mut found: ProverOutside, item: ref Spanned[Item], owner: String?, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) {
    match item.node {
        Item::Fn { name, body, ret_type, receiver, args, .. } => {
            let symbol = name ?? return
            let plain = words.resolve(symbol)
            let key = if owner != null { f"{owner ?? ""}::{plain}" } else { plain.clone() }
            let mut tainted: collections::BTreeSet[String] = collections::BTreeSet()
            let mut sources: collections::BTreeMap[String, String] = collections::BTreeMap()
            if ret_type != null {
                found.returning.insert(key.clone())
            }
            for _ in 0..<2 {
                let mut proof = OutsideProof::of(args, receiver != null, words)
                prover_outside_block(found, body, key, ret_type != null, tainted, sources, proof, words, library, state, holes_of)
            }
        },
        else => {},
    }
}

/// The statements of `block`: what each binds from outside, each `return`
/// and, where `tail` says the block's value is the result, its last
/// expression; each struct literal's fields; then the blocks inside.
fn prover_outside_block(mut found: ProverOutside, block: ref Block, key: ref String, tail: bool, mut tainted: collections::BTreeSet[String], mut sources: collections::BTreeMap[String, String], mut proof: OutsideProof, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) {
    let last = block.stmts.len() - 1
    // What a guard or a binding proves holds to the end of its block.
    let before = proof.clone()
    for (at, stmt) in block.stmts.iter().enumerate() {
        match stmt.node {
            Stmt::Let { names, value, mutable, .. } => {
                proof.bind(names, mutable, value, words, holes_of)
                if from_outside(value, tainted, words, library, state, holes_of) {
                    let source: String = outside_source(value, tainted, sources, words, library, state, holes_of) ?? ""
                    for name in names {
                        let n = words.resolve(name).clone()
                        if !source.is_empty() {
                            sources.insert(n.clone(), source.clone())
                        }
                        tainted.insert(n)
                    }
                }
            },
            Stmt::Assign { target, value, .. } => {
                match target {
                    Expr::Variable(name, _) => {
                        proof.forget(words.resolve(name))
                        if from_outside(value, tainted, words, library, state, holes_of) {
                            let n = words.resolve(name).clone()
                            let source = outside_source(value, tainted, sources, words, library, state, holes_of)
                            if source != null {
                                sources.insert(n.clone(), source ?? "")
                            }
                            tainted.insert(n)
                        }
                    },
                    else => {},
                }
            },
            Stmt::For { bindings, iter, .. } => {
                for name in bindings {
                    proof.forget(words.resolve(name))
                }
                if from_outside(iter, tainted, words, library, state, holes_of) {
                    let source: String = outside_source(iter, tainted, sources, words, library, state, holes_of) ?? ""
                    for name in bindings {
                        let n = words.resolve(name).clone()
                        if !source.is_empty() {
                            sources.insert(n.clone(), source.clone())
                        }
                        tainted.insert(n)
                    }
                }
            },
            Stmt::Return(value) => {
                let returned = value ?? continue
                prover_outside_result(found, returned, key, tainted, sources, proof, words, library, state, holes_of)
            },
            Stmt::Expr(inner) => {
                if tail && at == last {
                    prover_outside_tail(found, inner, key, tainted, sources, proof, words, library, state, holes_of)
                }
            },
            else => {},
        }
        for expr in check_visit_stmt(stmt.node) {
            prover_outside_expr(found, expr, key, tainted, sources, proof, words, library, state, holes_of)
        }
        for inner in check_visit_stmt_blocks(stmt.node) {
            prover_outside_block(found, inner, key, false, tainted, sources, proof, words, library, state, holes_of)
        }
        proof.guard(stmt.node, words)
    }
    proof.restore(before)
}

/// A block's last expression where it is the function's result: an `if`'s
/// and a block's by their own last expression, a `match` by each arm's.
fn prover_outside_tail(mut found: ProverOutside, expr: ref Expr, key: ref String, mut tainted: collections::BTreeSet[String], mut sources: collections::BTreeMap[String, String], mut proof: OutsideProof, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) {
    match expr {
        Expr::If { then_branch, else_branch, .. } => {
            prover_outside_block(found, then_branch, key, true, tainted, sources, proof, words, library, state, holes_of)
            let other = else_branch ?? return
            prover_outside_block(found, other, key, true, tainted, sources, proof, words, library, state, holes_of)
        },
        Expr::Block(block, _) => prover_outside_block(found, block, key, true, tainted, sources, proof, words, library, state, holes_of),
        Expr::Match { arms, .. } => {
            for arm in arms {
                prover_outside_tail(found, arm.body, key, tainted, sources, proof, words, library, state, holes_of)
            }
        },
        else => prover_outside_result(found, expr, key, tainted, sources, proof, words, library, state, holes_of),
    }
}

/// `value` handed back by the function `key`: when it comes from outside,
/// so does the function's result, unless it is proved (ADR-raw-sinks-1 D10,
/// D14): a literal, or a guarded name joined to a clean part, the
/// parameters it reads unguarded kept in `leads`.
fn prover_outside_result(mut found: ProverOutside, value: ref Expr, key: ref String, tainted: ref collections::BTreeSet[String], sources: ref collections::BTreeMap[String, String], proof: ref OutsideProof, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) {
    let mut leads: collections::BTreeSet[i64] = collections::BTreeSet()
    if !proof.proved(value, words, holes_of, leads) {
        found.valued.insert(key.clone())
    } else {
        if !leads.is_empty() {
            let mut known = found.leads.get(key)?.clone() ?? collections::BTreeSet()
            for at in leads {
                known.insert(at)
            }
            found.leads.insert(key.clone(), known)
        }
        return
    }
    if found.results.contains_key(key) || !from_outside(value, tainted, words, library, state, holes_of) {
        return
    }
    let source = outside_source(value, tainted, sources, words, library, state, holes_of) ?? key.clone()
    found.results.insert(key.clone(), source)
}

/// Whether `value` is a literal without holes, or an `if`, a `match` or a
/// block every value of which is one.
fn literal_only(value: ref Expr) -> bool {
    return match value {
        Expr::LitStr { .. } => true,
        Expr::LitInt { .. } => true,
        Expr::LitBool(_, _) => true,
        Expr::LitFloat(_, _) => true,
        Expr::LitChar(_, _) => true,
        Expr::If { then_branch, else_branch, .. } => {
            let other = else_branch ?? return false
            literal_tail(then_branch) && literal_tail(other)
        },
        Expr::Block(block, _) => literal_tail(block),
        Expr::Match { arms, .. } => {
            for arm in arms {
                if !literal_only(arm.body) {
                    return false
                }
            }
            true
        },
        else => false,
    }
}

/// Whether the value `block` ends in is a literal (`literal_only`).
fn literal_tail(block: ref Block) -> bool {
    let tail = tail_value_of(block) ?? return false
    return literal_only(tail)
}

/// **What proves the values a function hands back** (ADR-raw-sinks-1 D14,
/// #2375), read in the order its statements are written, as the walk reads
/// a guard before a sink but by the tree alone, since it runs before the
/// walk: `params` the parameters by position (none for a method, whose
/// call is not read by position), `fixed` the names no statement changes
/// (bound without `mut`), `guarded` those of them a guard proved
/// `path::is_component` or `path::is_below` of, and `joined` the names
/// bound to a proved join, with the parameters it reads unguarded.
struct OutsideProof {
    params: collections::BTreeMap[String, i64],
    fixed: collections::BTreeSet[String],
    guarded: collections::BTreeSet[String],
    joined: collections::BTreeMap[String, collections::BTreeSet[i64]],
}

impl OutsideProof {
    fn of(args: ref Vec[FnArg], method: bool, words: ref winnow_grammar::InternerContext) -> OutsideProof {
        let mut proof = OutsideProof { params: collections::BTreeMap(), fixed: collections::BTreeSet(), guarded: collections::BTreeSet(), joined: collections::BTreeMap() }
        for (at, arg) in args.iter().enumerate() {
            if arg.mutable {
                continue
            }
            let n = words.resolve(arg.name).clone()
            proof.fixed.insert(n.clone())
            if !method {
                proof.params.insert(n, at as i64)
            }
        }
        return proof
    }

    fn restore(mut self, before: OutsideProof) {
        self.params = before.params
        self.fixed = before.fixed
        self.guarded = before.guarded
        self.joined = before.joined
    }

    /// `name` bound or changed again: nothing proved of it holds.
    fn forget(mut self, name: ref String) {
        self.params.remove(name)
        self.fixed.remove(name)
        self.guarded.remove(name)
        self.joined.remove(name)
    }

    /// `let names = value`: a single name bound without `mut` to a proved
    /// join carries its proof (D14, as `ProverScope::joined` does).
    fn bind(mut self, names: ref Vec[winnow_grammar::Symbol], mutable: bool, value: ref Expr, words: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync) {
        let mut leads: collections::BTreeSet[i64] = collections::BTreeSet()
        let carried = names.len() == 1 && !mutable && !literal_only(value) && self.proved(value, words, holes_of, leads)
        for name in names {
            let n = words.resolve(name).clone()
            self.forget(n)
            if !mutable {
                self.fixed.insert(n.clone())
            }
            if carried {
                self.joined.insert(n, leads.clone())
            }
        }
    }

    /// `if cond { return ... }` (`return ... if cond`), whose block always
    /// leaves: a name `cond` is true for where `!path::is_component(name)`
    /// (or `path::is_below`) holds, by itself or as one side of an `||`, is
    /// guarded after it.
    fn guard(mut self, stmt: ref Stmt, words: ref winnow_grammar::InternerContext) {
        match stmt {
            Stmt::Expr(inner) => {
                match inner {
                    Expr::If { cond, then_branch, else_branch, .. } => {
                        if else_branch == null && always_leaves(then_branch) {
                            self.guard_cond(cond, words)
                        }
                    },
                    else => {},
                }
            },
            else => {},
        }
    }

    fn guard_cond(mut self, cond: ref Expr, words: ref winnow_grammar::InternerContext) {
        match cond {
            Expr::Binary { op, lhs, rhs, .. } => {
                if op == BinaryOp::Or {
                    self.guard_cond(lhs, words)
                    self.guard_cond(rhs, words)
                }
            },
            Expr::Unary { op, expr, .. } => {
                if op != UnaryOp::Not {
                    return
                }
                match expr {
                    Expr::Call { func, args, config, .. } => {
                        let called = outside_source_named(func, words) ?? return
                        if (called != "path::is_component" && called != "path::is_below") || args.len() != 1 || !config.is_empty() {
                            return
                        }
                        let on = raw_sink_name(args[0], words) ?? return
                        if self.fixed.contains(on) {
                            self.guarded.insert(on)
                        }
                    },
                    else => {},
                }
            },
            else => {},
        }
    }

    /// Whether `value` is proved: a literal, a name bound to a proved join,
    /// or a join that starts with a clean part (a literal piece, a parameter
    /// or such a name) whose every part is a literal, a guarded name, such a
    /// name or a parameter, those parameters (and those such names start
    /// with) added to `leads`; an `if`, a `match` or a one-statement block by
    /// each value it ends in.
    fn proved(ref self, value: ref Expr, words: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, mut leads: collections::BTreeSet[i64]) -> bool {
        if literal_only(value) {
            return true
        }
        match value {
            Expr::If { then_branch, else_branch, .. } => {
                let other = else_branch ?? return false
                return self.proved_tail(then_branch, words, holes_of, leads) && self.proved_tail(other, words, holes_of, leads)
            },
            Expr::Block(block, _) => return self.proved_tail(block, words, holes_of, leads),
            Expr::Match { arms, .. } => {
                for arm in arms {
                    if !self.proved(arm.body, words, holes_of, leads) {
                        return false
                    }
                }
                return true
            },
            Expr::LitInterpolated { .. } => {},
            Expr::Binary { op, .. } => {
                if op != BinaryOp::Add {
                    return false
                }
            },
            else => {
                let name = raw_sink_name(value, words) ?? return false
                let carried = self.joined.get(name) ?? return false
                for at in carried {
                    leads.insert(at)
                }
                return true
            },
        }
        let lead = self.lead_of(value, words) ?? return false
        if lead >= 0 {
            leads.insert(lead)
        }
        let mut parts: Vec[Expr] = []
        raw_sink_parts(value, holes_of, parts)
        for part in parts {
            if literal_only(part) {
                continue
            }
            let name = raw_sink_name(part, words) ?? return false
            if self.guarded.contains(name) {
                continue
            }
            match self.joined.get(name) {
                null => {},
                carried => {
                    for at in carried {
                        leads.insert(at)
                    }
                    continue
                },
            }
            let at = self.params.get(name) ?? return false
            leads.insert(at)
        }
        return true
    }

    /// A block's value, where the block is that value alone: a binding
    /// before it would be read with what holds outside the block.
    fn proved_tail(ref self, block: ref Block, words: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, mut leads: collections::BTreeSet[i64]) -> bool {
        if block.stmts.len() != 1 {
            return false
        }
        let tail = tail_value_of(block) ?? return false
        return self.proved(tail, words, holes_of, leads)
    }

    /// The clean part a join starts with: the position of a parameter, -1
    /// for a literal piece or a name bound to a proved join (whose
    /// parameters its parts add); null for anything else.
    fn lead_of(ref self, value: ref Expr, words: ref winnow_grammar::InternerContext) -> i64? {
        match value {
            Expr::LitInterpolated { parts, .. } => {
                for part in parts {
                    match part {
                        FPart::Text(text) => {
                            if !text.is_empty() {
                                return -1
                            }
                        },
                        FPart::Hole { expr, .. } => return self.lead_of(expr, words),
                    }
                }
                return null
            },
            Expr::LitStr { text, .. } => return if text.is_empty() { null } else { -1 },
            Expr::Binary { op, lhs, .. } => return if op == BinaryOp::Add { self.lead_of(lhs, words) } else { null },
            else => {
                let name = raw_sink_name(value, words) ?? return null
                if self.joined.contains_key(name) {
                    return -1
                }
                return self.params.get(name)
            },
        }
    }
}

/// Whether `block` always leaves where it ends: its last statement is a
/// `return`, a `throw`, a `break` or a `continue`.
fn always_leaves(block: ref Block) -> bool {
    let last = block.stmts.last() ?? return false
    return match last.node {
        Stmt::Return(_) => true,
        Stmt::Break => true,
        Stmt::Continue => true,
        Stmt::Expr(inner) => match inner {
            Expr::Throw(_, _) => true,
            Expr::Return(_, _) => true,
            Expr::Break(_) => true,
            Expr::Continue(_) => true,
            else => false,
        },
        else => false,
    }
}

/// One expression outside the blocks it holds: a `return` inside it hands
/// its value back, a struct literal fills each field with what it is given.
fn prover_outside_expr(mut found: ProverOutside, expr: ref Expr, key: ref String, tainted: ref collections::BTreeSet[String], sources: ref collections::BTreeMap[String, String], proof: ref OutsideProof, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) {
    match expr {
        Expr::Return(value, _) => {
            let returned = value ?? return
            prover_outside_result(found, returned, key, tainted, sources, proof, words, library, state, holes_of)
        },
        Expr::StructLit { name, fields, .. } => {
            let owner = words.resolve(name)
            for field in fields {
                let named = words.resolve(field.name)
                let at = f"{owner}.{named}"
                if found.fields.contains_key(at) {
                    continue
                }
                match field.value {
                    null => {
                        // `Reading { name }`: the binding of the same name.
                        if tainted.contains(named) {
                            found.fields.insert(at.clone(), sources[named]?.clone() ?? named.clone())
                        }
                    },
                    given => {
                        if from_outside(given, tainted, words, library, state, holes_of) {
                            let source = outside_source(given, tainted, sources, words, library, state, holes_of) ?? at.clone()
                            found.fields.insert(at.clone(), source)
                        }
                    },
                }
            }
        },
        else => {},
    }
}
