// crates/nikaia-std/src/compiler/prove_text.nika
//
// **How the prover writes a term and a value** (ADR-269 D7, D18), moved from
// the compiler's `prove` (ADR-294, #436 step 1): a term as the language below
// writes it for a check, as a reader writes it in a message, and as the
// ledger writes it; a model's values as a sentence. The terms are read one
// node at a time (`solver_terms.nika`).

use std::collections
use logic

/// **A term as the language below writes it**, for a check that is not the
/// `assert` as written: every number in `i128`, so that the check cannot
/// overflow where the claim's own arithmetic would have stopped the program
/// (Part I 2.2) - the prover reads numbers without a limit, and so does this.
/// A name is the escaped name the emitter writes (`escape`); `xs.len()` the
/// length.
fn rust_of(id: i64, term_of: fn(i64) -> logic::SolverTerm sync, escape: fn(ref String) -> String sync) -> String {
    return match term_of(id) {
        logic::SolverTerm::Bool(b) => if b { "true" } else { "false" },
        logic::SolverTerm::Int(n) => f"({n}i128)",
        logic::SolverTerm::Var(name) => rust_of_name(name, escape),
        logic::SolverTerm::Neg(a) => f"(-{rust_of(a, term_of, escape)})",
        logic::SolverTerm::Not(a) => f"(!{rust_of(a, term_of, escape)})",
        logic::SolverTerm::Add(a, b) => f"({rust_of(a, term_of, escape)} + {rust_of(b, term_of, escape)})",
        logic::SolverTerm::Sub(a, b) => f"({rust_of(a, term_of, escape)} - {rust_of(b, term_of, escape)})",
        logic::SolverTerm::Mul(a, b) => f"({rust_of(a, term_of, escape)} * {rust_of(b, term_of, escape)})",
        logic::SolverTerm::Quot(a, k) => f"({rust_of(a, term_of, escape)} / ({k}i128))",
        logic::SolverTerm::Le(a, b) => f"({rust_of(a, term_of, escape)} <= {rust_of(b, term_of, escape)})",
        logic::SolverTerm::Lt(a, b) => f"({rust_of(a, term_of, escape)} < {rust_of(b, term_of, escape)})",
        logic::SolverTerm::Ge(a, b) => f"({rust_of(a, term_of, escape)} >= {rust_of(b, term_of, escape)})",
        logic::SolverTerm::Gt(a, b) => f"({rust_of(a, term_of, escape)} > {rust_of(b, term_of, escape)})",
        logic::SolverTerm::Eq(a, b) => f"({rust_of(a, term_of, escape)} == {rust_of(b, term_of, escape)})",
        logic::SolverTerm::Ne(a, b) => f"({rust_of(a, term_of, escape)} != {rust_of(b, term_of, escape)})",
        logic::SolverTerm::And(parts) => rust_joined(" && ", parts, "true", term_of, escape),
        logic::SolverTerm::Or(parts) => rust_joined(" || ", parts, "false", term_of, escape),
        else => "",
    }
}

fn rust_joined(op: ref String, parts: ref Vec[i64], empty: ref String, term_of: fn(i64) -> logic::SolverTerm sync, escape: fn(ref String) -> String sync) -> String {
    if parts.is_empty() {
        return empty.clone()
    }
    let mut written: Vec[String] = []
    for part in parts {
        written.push(rust_of(part, term_of, escape))
    }
    return f"({written.join(op)})"
}

/// A name of the proof as the language below reads it, in `i128`.
fn rust_of_name(name: ref String, escape: fn(ref String) -> String sync) -> String {
    if name.ends_with(".len()") {
        let c: Vec[scalar] = name.scalars.collect()
        let mut base: String = ""
        for k in 0..<c.len() - 6 {
            base.push(c[k])
        }
        return f"({escape(base)}.len() as i128)"
    }
    // **A named property is its call** (ADR-381 D3): `xs.prop@p()` checked
    // at a call is `p(&xs)`, `true` 1.
    let base = property_base(name)
    if base != null {
        let on = base ?? ""
        let called = name.strip_prefix(f"{on}.{property_mark()}") ?? name
        let rest = (called.strip_suffix("()") ?? called).clone()
        return f"(({escape(rest)}(&{escape(on)})) as i128)"
    }
    return f"({escape(name)}.clone() as i128)"
}

/// Values as a reader writes them: `` `x` is 5, `xs.len()` is 0 ``.
pub fn shown(values: ref collections::BTreeMap[String, i64]) -> String {
    if values.is_empty() {
        return "no value of its own; the claim is false as written"
    }
    let mut said: Vec[String] = []
    for (name, value) in values {
        said.push(f"`{name}` is {value}")
    }
    return said.join(", ")
}

/// `"A method can't …"` as the rest of a sentence.
fn lowered_first(text: ref String) -> String {
    let c: Vec[scalar] = text.scalars.collect()
    if c.is_empty() {
        return ""
    }
    let mut head: String = ""
    head.push(c[0])
    let mut out = head.to_lowercase()
    for k in 1..<c.len() {
        out.push(c[k])
    }
    return out
}

/// A type whose `len()` the prover reads: a list, text, an array.
fn has_a_length(ty: ref String) -> bool {
    return match ty {
        "Vec" => true, "String" => true, "str" => true, "Array" => true, "Bytes" => true,
        else => false,
    }
}
