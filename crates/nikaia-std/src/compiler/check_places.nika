// crates/nikaia-std/src/compiler/check_places.nika
//
// **Small questions about a place, a jump and a lock's door** - moved from the
// compiler's checker (ADR-294, #125, #558, C-5a): a `break` with no loop
// (`NK1132`), a door written wrong (`NK1124`), a `match` over a place this
// function owns (ADR-291), what a value's type arguments bind, the stamp a
// lock's value passes on (ADR-281 D22), and the `match` over a `catch`'s error
// (`NK1151`, ADR-280 D18).

use std::collections

/// The members, as a message names them: `` `ConfigError`, `io::IoError` ``.
fn members_named(members: ref Vec[Ty]) -> String sync {
    let mut names: Vec[String] = []
    for member in members {
        names.push(f"`{member.shown()}`")
    }
    return names.join(", ")
}

/// What an `fs::Root` parameter is, where the signature has one: the root is
/// either `fs::Root::Dir(store)` or `fs::Root::Anywhere`.
fn a_root_is_one_of_two(wanted: ref Vec[(String, Ty)]) -> String sync {
    for one in wanted {
        let text = one.1.text()
        let mut bare: String = text.clone()
        if text.starts_with("ref ") {
            bare = (text.strip_prefix("ref ") ?? "").clone()
        }
        if one.0 == "root" && bare == "fs::Root" {
            return ". The root is either `fs::Root::Dir(store)`, which keeps the path inside `store`, or `fs::Root::Anywhere`, which checks nothing and says so where a reviewer will look"
        }
    }
    return ""
}

/// **A type stamped as read from a lock** (ADR-281 D22): an option is stamped
/// inside (#2334), since `Seen[T]?` may be `null`, as `match` and `??` ask,
/// and `Seen[T?]` never would be.
fn stamped_type(ty: ref Ty) -> Ty sync {
    let plain = ty.unseen()
    match plain {
        Ty::Nullable(inner) => {
            return Ty::Nullable(Ty::Named { name: SEEN.clone(), args: [inner.clone()], view: false })
        }
        else => {}
    }
    return Ty::Named { name: SEEN.clone(), args: [plain], view: false }
}

impl CheckState {
    /// The one message shape for a door written wrong.
    fn no_door(ref mut self, written: ref String, shape: ref String, wanted: ref String, span: ref Span) sync {
        self.findings.push(check_refusal("NK1124", span, f"Write `{written}` like this: `{shape}`.", [wanted.clone()], null))
    }

    /// **A value that came out of a lock passes the stamp on** (ADR-281 D22): a
    /// callee that touches a lock, or that nothing describes, does not. A
    /// stamped receiver passes it on as an argument does (D23, `stand.abs()`,
    /// #2334).
    fn stamped_through(ref self, contract: ref FnContract, given: ref Vec[Ty], receiver_seen: bool, result: Ty) -> Ty sync {
        let mut any_seen = receiver_seen
        for one in given {
            if one.is_seen() {
                any_seen = true
            }
        }
        if result.is_seen() || !any_seen {
            return result
        }
        let mut reaches_a_lock = !contract.touches_known
        for touch in contract.touches {
            if touch.names_a_lock() {
                reaches_a_lock = true
            }
        }
        if reaches_a_lock {
            return result
        }
        return stamped_type(result)
    }

    /// **`NK1132`: a `break` or a `continue` with no loop to act on.** Two shapes
    /// and one code: there is no loop, or there is one and a function boundary
    /// stands between.
    fn a_jump_with_nowhere_to_go(ref mut self, word: ref String, span: ref Span) sync {
        let mut does: String = "starts the innermost loop's next turn"
        if word == "break" {
            does = "leaves the innermost loop around it"
        }
        if self.flow.barrier != null {
            let what = (self.flow.barrier ?? "").clone()
            self.findings.push(check_refusal("NK1132", span, f"`{word}` {does}, but the nearest loop is outside this {what}.", [f"{with_article(what)} runs as a function of its own, and `{word}` can't jump out of a function."], f"Decide inside the {what} and act on the answer outside it: return a `bool` and test it in the loop."))
            return
        }
        self.findings.push(check_refusal("NK1132", span, f"`{word}` {does}, but this isn't inside a loop.", ["It only works inside a `while` or a `for`."], "To leave the function instead, write `return`."))
    }

    /// **`NK2120`: an `async` form inside a loop's body** (ADR-async-5 D30).
    /// `async` starts only tasks whose number stands in the source; a lambda
    /// is a function of its own, so one written in a loop may hold the form
    /// (the count starts again at zero there, `enter_boundary`). `spawn` is
    /// not asked.
    fn an_async_inside_a_loop(ref mut self, span: ref Span) sync {
        self.findings.push(check_refusal("NK2120", span, "This `async` stands inside a loop's body, but `async` starts only tasks whose number stands in the source.", ["A loop would start one task each time round, and a group's tasks are counted where they are written."], "To run the body for every element beside the others, write `xs.par_iter().for_each fn(x) { … }`."))
    }

    /// **`NK2123` (warning): `spawn fn { … }`**, the earlier spelling of
    /// `async(detached) fn { … }` (ADR-async-5 D13, D39). The edit writes
    /// the new word before the lambda; inside a loop's body, where the
    /// `async` form is refused (`NK2120`, D30), there is no edit.
    fn a_spawn_replaced(ref mut self, world: ref CheckWorld, whole: ref Expr, span: ref Span) sync {
        let mut edit: CheckEdit? = null
        let mut help: String = "Write `async(detached) fn { … }`, the same task; `nikaia fix --only NK2123` makes the edit."
        if self.flow.loops > 0 {
            help = "`async(detached)` is refused inside a loop's body (`NK2120`): to run the body for every element beside the others, write `xs.par_iter().for_each fn(x) { … }`."
        } else {
            edit = word_replaced(world, whole, "spawn", "async(detached)")
        }
        let mut warned = check_refusal("NK2123", span, "`spawn` is replaced by `async(detached)`, which starts the same task.", ["`spawn fn { … }` is the earlier spelling of `async(detached) fn { … }` (ADR-async-5 D13); it is removed once every use is rewritten."], help)
        warned.severity = CheckSeverity::Warning
        warned.edit = edit
        self.findings.push(warned)
    }

    /// **`NK2124` (warning): an `overlap` block** (ADR-async-5 D39). Where
    /// each of two or more branches is one expression and no branch changes
    /// a name the others see, the edit writes `(async a(), async b())` (D6),
    /// or, where every branch gives nothing, `async { async a()  async b() }`
    /// (D9); none inside a loop's body, where `async` is refused (`NK2120`),
    /// nor under a `catch`, which the tuple's failures pass by (#990).
    fn an_overlap_replaced(ref mut self, world: ref CheckWorld, whole: ref Expr, block: ref Block, parts: ref Vec[Ty], keep: bool, span: ref Span) sync {
        let mut edit: CheckEdit? = null
        let mut nothing = true
        for part in parts {
            if part.text() != "()" {
                nothing = false
            }
        }
        if !keep {
            edit = overlap_rewritten(world, whole, block, nothing)
        }
        let mut help: String = "Write `let (x, y) = (async a(), async b())` for the values, or `async { async a()  async b() }` for branches that give nothing."
        if edit != null {
            help = f"{help} `nikaia fix --only NK2124` makes the edit."
        } else {
            help = f"{help} A branch of several steps is `async fn {{ … }}`; inside a loop's body, `xs.par_iter()`."
        }
        let mut warned = check_refusal("NK2124", span, "`overlap` is replaced by `async`, which starts each branch as a task.", ["Each branch of an `overlap` is a task beside the others; `async e` starts one, waited for where its value is first needed, and `async { … }` waits for the tasks it starts at its end (ADR-async-5 D6, D9). The block is removed once every use is rewritten."], help)
        warned.severity = CheckSeverity::Warning
        warned.edit = edit
        self.findings.push(warned)
    }

    /// **`NK2125` (warning): a `task::scope`** (ADR-async-5 D39). Where its
    /// body is one `for` that starts one task per element and waits for none,
    /// and the task neither prints nor writes anything the others see, the
    /// edit writes `xs.par_iter().for_each fn(x) { … }`; any other scope is a
    /// warning without one, whose help names `async(handle)` and `par_iter`.
    fn a_scope_replaced(ref mut self, world: ref CheckWorld, whole: ref Expr, func: ref Expr, args: ref Vec[Expr], span: ref Span) sync {
        match func {
            Expr::Path(segments, _) => {
                let count = segments.len()
                if count < 2 || world.words.resolve(segments[count - 1]) != "scope" || world.words.resolve(segments[count - 2]) != "task" {
                    return
                }
            },
            else => return,
        }
        let edit = scope_rewritten(world, whole, args)
        let mut help: String = "For one task per element, write `xs.par_iter().for_each fn(x) { … }`; for tasks whose results are joined, `async(handle) fn { … }` and `.join()` (ADR-async-5 D13)."
        if edit != null {
            help = f"{help} `nikaia fix --only NK2125` makes the edit."
        }
        let mut warned = check_refusal("NK2125", span, "`task::scope` is replaced by `par_iter` and `async(handle)`.", ["A scope's tasks are written with `async` now: `par_iter` runs a body for every element beside the others, and `async(handle)` starts a task whose result is joined (ADR-async-5 D13, D30). The scope is removed once every use is rewritten."], help)
        warned.severity = CheckSeverity::Warning
        warned.edit = edit
        self.findings.push(warned)
    }

    /// **`NK2110`: a task with nothing beside it** (ADR-async-5 D7): nothing
    /// runs between its start and its wait point; `why` says which shape.
    fn a_task_with_nothing_beside_it(ref mut self, span: ref Span, why: String) sync {
        self.findings.push(check_refusal("NK2110", span, f"This `async` starts a task with nothing beside it: {why}.", ["A task runs beside the code between its start and its wait point; here that is nothing, so it would only be waited for."], "Remove the word `async`: the expression runs on the main line with the same value."))
    }

    /// **`NK2111`: an `async { … }` that starts no task** (ADR-async-5 D9).
    fn a_group_with_no_task(ref mut self, span: ref Span) sync {
        self.findings.push(check_refusal("NK2111", span, "This `async { … }` starts no task, so it waits for nothing.", ["Its statements run in order, as any block's; only an `async` inside it starts a task its end waits for."], "Remove the word `async`. For one task of several steps, write `async fn { … }`."))
    }

    /// **`NK2122`: a child handle that leaves its group** (Part I 8.1.2,
    /// ADR-async-5 D11): it borrows from the group, which waits for it.
    fn a_child_handle_leaving_its_group(ref mut self, span: ref Span, why: ref String) sync {
        self.findings.push(check_refusal("NK2122", span, f"A child handle (`async(handle)`) leaves its group here: {why}.", ["A child task is bound to the group it starts in: it may borrow from it, and the group waits for it at its end, so its handle cannot outlive the group."], "Write `async(detached) fn { … }` for a task whose handle outlives its group."))
    }

    /// **`NK1132`: a `return` that would leave an `async` form** (ADR-async-5
    /// D10): a task is a boundary no jump leaves.
    fn a_return_out_of_an_async_form(ref mut self, span: ref Span) sync {
        self.findings.push(check_refusal("NK1132", span, "`return` leaves the function, but it stands inside an `async` form.", ["A task is a boundary no jump leaves, and an `async { … }` waits for its tasks at its end."], "For a task of several steps that can end early, write `async fn { … }`: `return` in it ends the task with its value."))
    }

    /// What a value's own type arguments bind its declaration's parameters to:
    /// `Pair[i64]` against `struct Pair[T]` gives `T = i64`, positionally.
    fn arguments_of(ref self, on: ref Ty) -> collections::BTreeMap[String, Ty] sync {
        let mut bound: collections::BTreeMap[String, Ty] = collections::BTreeMap()
        match on {
            Ty::Named { name, args, .. } => {
                let order = self.struct_parameters[name] ?? return bound
                let mut at = 0
                while at < order.len() && at < args.len() {
                    if !args[at].is_unknown() {
                        bound.insert(order[at].clone(), args[at].clone())
                    }
                    at = at + 1
                }
            }
            else => {}
        }
        return bound
    }

    /// **Whether a `match` is over a place this function owns**: a name, or a
    /// field of one, that is not itself a view. Only there can a part be lent and
    /// the whole stay.
    fn an_owned_place(ref self, world: ref CheckWorld, value: ref Expr, on: ref Ty) -> bool sync {
        let a_name = match on {
            Ty::Named { .. } => true,
            else => false,
        }
        if on.is_a_view() || !a_name {
            return false
        }
        let mut root = value
        let mut walking = true
        while walking {
            match root {
                Expr::Field { base, .. } => {
                    root = base
                }
                else => {
                    walking = false
                }
            }
        }
        return match root {
            Expr::Variable(name, _) => {
                let word = world.words.resolve(name).clone()
                let local = self.binding(word) ?? return false
                // A name `get`, `first` or `last` handed back past a jump is
                // a reference to the element (D30, #2240), whatever type it
                // was given: its parts are views, as through a view's.
                !local.lent && !local.ty.is_a_view() && !self.lent_here(word) && !self.got_past_a_jump.contains(word)
            }
            else => false,
        }
    }

    /// Whether parameter `at` is a by-value type variable that nothing else in
    /// the signature binds: no receiver, and no other parameter names it.
    fn decided_by_this_argument(ref self, signature: ref Signature, wanted: ref Vec[(String, Ty)], at: i64) -> bool sync {
        assert(0 <= at)
        if at >= wanted.len() {
            return false
        }
        let name = match wanted[at].1 {
            Ty::Var { name, view } => {
                if view {
                    return false
                }
                name.clone()
            }
            else => return false,
        }
        if signature.takes_a_receiver() {
            return false
        }
        let mark = f"${name}"
        let mut other = 0
        while other < wanted.len() {
            if other != at && wanted[other].1.text().contains(ref mark) {
                return false
            }
            other = other + 1
        }
        return true
    }

    /// **A kept function takes its arguments by value**, so a text literal handed
    /// to one where it keeps text is built there (ADR-282 D4).
    fn kept_arguments_are_its_own(ref mut self, world: ref CheckWorld, args: ref Vec[Expr], params: ref Vec[Ty]) sync {
        let mut at = 0
        while at < args.len() && at < params.len() {
            let built = self.text_literal(world, params[at], args[at], true)
            at = at + 1
        }
    }

    /// **`NK1151` for a `match` over a `catch`'s error** (ADR-280 D18): the
    /// variants within one error type are closed and the set of error types is
    /// open, so a handler that names variants of two of them has covered no set
    /// at all; `else` is what says the rest.
    ///
    /// *Changed by ADR-357 D1, D2:* where the set is known, closed, a `match`
    /// naming every type in it is complete (`a_closed_set_that_misses_a_case`
    /// asks that); `else` stays needed where the set cannot be named.
    fn a_match_over_several_error_types(ref mut self, world: ref CheckWorld, on: ref Ty, value: ref Expr, arms: ref Vec[MatchArm], span: ref Span) sync {
        if !self.flow.caught_several || several_errors_of(on).len() > 0 {
            return
        }
        let is_error = match value {
            Expr::Variable(name, _) => world.words.resolve(name) == "error",
            else => false,
        }
        if !is_error {
            return
        }
        let mut caught = false
        for arm in arms {
            if arm.guard == null && catches_everything(arm.pattern) {
                caught = true
            }
        }
        if !caught {
            self.a_case_is_missing("else", span)
        }
    }
}

// **An edit that writes `text` for the keyword `word`** a node starts with
// (ADR-async-5 D39): `spawn` before `fn { … }`, whose own span the parser does
// not keep, so the word is where the node's span starts.
fn word_replaced(world: ref CheckWorld, whole: ref Expr, word: ref String, text: ref String) -> CheckEdit? sync {
    let at = world.here.spans.get(id_of(whole)) ?? return null
    let end = at.start + word.len() as u32
    if end >= at.end {
        return null
    }
    return CheckEdit { span: Span { start: at.start, end: end }, text: text.clone(), also: [] }
}

// **The edit `NK2124` suggests** (ADR-async-5 D39): `overlap { a()  b() }`
// written `(async a(), async b())`, or, where every branch gives nothing
// (`nothing`), `async` for the word and `async ` before each branch. Only
// where there are two branches or more, each one expression that is not a
// block of its own, and every span is known.
fn overlap_rewritten(world: ref CheckWorld, whole: ref Expr, block: ref Block, nothing: bool) -> CheckEdit? sync {
    if block.stmts.len() < 2 {
        return null
    }
    let at = world.here.spans.get(id_of(whole)) ?? return null
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Expr(value) => {
                match value {
                    Expr::Block(_, _) => return null,
                    Expr::AsyncGroup(_, _, _, _, _) => return null,
                    Expr::Unsafe(_, _) => return null,
                    Expr::Overlap(_, _) => return null,
                    Expr::If { .. } => return null,
                    Expr::Match { .. } => return null,
                    else => {},
                }
            },
            else => return null,
        }
        if stmt.span.start <= at.start || stmt.span.end >= at.end {
            return null
        }
    }
    let first = block.stmts[0].span.clone()
    let mut also: Vec[CheckEditPart] = []
    if nothing {
        for stmt in block.stmts {
            also.push(CheckEditPart { span: Span { start: stmt.span.start, end: stmt.span.start }, text: "async " })
        }
        return CheckEdit { span: Span { start: at.start, end: at.start + "overlap".len() as u32 }, text: "async", also: also }
    }
    let mut before = first.clone()
    let mut index = 0
    for stmt in block.stmts {
        let read = match stmt.node {
            Stmt::Expr(value) => world.here.spans.get(id_of(value)) ?? return null,
            else => return null,
        }
        if index > 0 {
            also.push(CheckEditPart { span: Span { start: before.end, end: read.start }, text: ", async " })
        }
        before = read.clone()
        index += 1
    }
    also.push(CheckEditPart { span: Span { start: before.end, end: at.end }, text: ")" })
    return CheckEdit { span: Span { start: at.start, end: first.start }, text: "(async ", also: also }
}

// **The edit `NK2125` suggests** (ADR-async-5 D39): `task::scope fn(s) {
// for x in xs { s.spawn fn { … } } }` written `xs.par_iter().for_each fn(x)
// { … }`. Only where the loop walks a name with one binding, its body is that
// one `s.spawn` and the task's steps are expressions that neither print nor
// write: `print`, `write`, a lock, a channel, a file or anything the text of
// an expression leaves out (`…`) keeps the scope as written.
fn scope_rewritten(world: ref CheckWorld, whole: ref Expr, args: ref Vec[Expr]) -> CheckEdit? sync {
    if args.len() != 1 {
        return null
    }
    let (scope, outer) = match args[0] {
        Expr::Closure { params, body, .. } => {
            if params.len() != 1 || body.stmts.len() != 1 {
                return null
            }
            (params[0], body.stmts[0].node.clone())
        },
        else => return null,
    }
    let (bound, walked, round) = match outer {
        Stmt::For { bindings, iter, body, .. } => {
            if bindings.len() != 1 || body.stmts.len() != 1 {
                return null
            }
            (bindings[0], iter.clone(), body.stmts[0].node.clone())
        },
        else => return null,
    }
    match walked {
        Expr::Variable(_, _) => {},
        else => return null,
    }
    let task = match round {
        Stmt::Expr(Expr::MethodCall { receiver, method, args, .. }) => {
            if args.len() != 1 || world.words.resolve(method) != "spawn" {
                return null
            }
            match receiver {
                Expr::Variable(name, _) => {
                    if name != scope {
                        return null
                    }
                },
                else => return null,
            }
            args[0].clone()
        },
        else => return null,
    }
    let mut opened: Span? = null
    let mut closed: Span? = null
    match task {
        Expr::Closure { params, body, .. } => {
            if !params.is_empty() || body.stmts.is_empty() {
                return null
            }
            opened = body.stmts[0].span.clone()
            for step in body.stmts {
                match step.node {
                    Stmt::Expr(value) => {
                        closed = world.here.spans.get(id_of(value)) ?? return null
                        let text = written_expression(world.words, value)
                        for word in ["…", "print", "write", "lock", "send", "fs::", "env::", "push", "insert", "spawn", "async"] {
                            if text.contains(word) {
                                return null
                            }
                        }
                    },
                    else => return null,
                }
            }
        },
        else => return null,
    }
    let at = world.here.spans.get(id_of(whole)) ?? return null
    let first = opened ?? return null
    let last = closed ?? return null
    if first.start <= at.start || last.end >= at.end {
        return null
    }
    let named = written_expression(world.words, walked)
    let name = world.words.resolve(bound)
    return CheckEdit {
        span: Span { start: at.start, end: first.start },
        text: f"{named}.par_iter().for_each fn({name}) {{ ",
        also: [CheckEditPart { span: Span { start: last.end, end: at.end }, text: " }" }],
    }
}
