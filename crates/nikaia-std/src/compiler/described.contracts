# **The Rust the toolchain's own Nikaia reads** (ADR-294 D9.3), described as
# `nikaia describe` describes a crate for a program: a claim reviewed like
# code. `nikaia lower-std` checks a module of `src/compiler/` against `std`'s
# ledger and this one; a program never reads it.
version = 2
toolchain = "described"
inference = "described"

# `winnow_grammar::Symbol`, the table it is interned into,
# `winnow_grammar::InternerContext`, and its `new` and `resolve` are `std`'s
# (ADR-388 D3): a program makes the table its grammar interns into and reads
# its symbols back.

# A name interned into the table (#1592): the text tiers declare a `let`
# with a type of `std`'s ledger the file never wrote. The table is shared
# (`&self`), so interning reads it as a view.
[fn."winnow_grammar::InternerContext::intern_string"]
pub = true
panics = false
sync = true
touches = []
signature = "(self: ref winnow_grammar::InternerContext, text: ref String) -> winnow_grammar::Symbol"

# FNV-1a over a key's bytes from a seeded offset basis (ADR-311 D9): lives in
# the runtime, `runtime/fixed.nika`, which `Fixed::get` calls at run time; the
# table builder (`fixed.nika`) hashes with the same function (#2026).
[fn."runtime::fnv"]
pub = true
panics = false
sync = true
touches = []
signature = "(key: ref String, seed: u64) -> u64"

# CHD's displacement, as the `phf` crate writes it: lives in the runtime,
# `runtime/fixed.nika`, beside `fnv` (#2026).
[fn."runtime::displace"]
pub = true
panics = false
sync = true
touches = []
signature = "(f1: u32, f2: u32, d1: u32, d2: u32) -> u32"

# The id every expression node of the tree carries (ADR-340, #558): a `u32`
# the parser gives, compared as equal whatever the number (D3), so a key is
# `get`, never the id itself.
[type."node_id::NodeId"]
pub = true
crosses = true
compares = true
copies = true

# The id of a node the compiler builds after parsing: one no other node has.
[fn."node_id::NodeId::fresh"]
pub = true
sync = true
touches = []
signature = "() -> node_id::NodeId"

# The number a table is keyed on.
[fn."node_id::NodeId::get"]
pub = true
sync = true
touches = []
signature = "(self: node_id::NodeId) -> u32"

# The id with this number: what the parser gives the nodes it makes, in order.
[fn."node_id::NodeId::numbered"]
pub = true
sync = true
touches = []
signature = "(number: u32) -> node_id::NodeId"

# The id of a node the grammar makes, not yet numbered (ADR-383 D1).
[fn."node_id::NodeId::parsed"]
pub = true
sync = true
touches = []
signature = "() -> node_id::NodeId"

# Whether the numbering pass has still to number it (ADR-383 D3).
[fn."node_id::NodeId::is_parsed"]
pub = true
sync = true
touches = []
signature = "(self: node_id::NodeId) -> bool"

# This id with the node read from `start..end`, unless it carries a span
# already (ADR-383 D4): how the postfix fold gives each step its span (#1977).
[fn."node_id::NodeId::at"]
pub = true
sync = true
touches = []
signature = "(self: node_id::NodeId, start: u32, end: u32) -> node_id::NodeId"

# Where the node was read, until the pass numbers it (ADR-383 D4).
[fn."node_id::NodeId::span"]
pub = true
sync = true
touches = []
signature = "(self: node_id::NodeId) -> (u32, u32)?"
