// crates/nikaia-std/src/compiler/findings.nika
//
// **What a check written in Nikaia hands back** (ADR-294, ADR-294): one
// finding, in the shape Part III C.2 gives every diagnostic - a code, the
// statement it is about, a headline, the notes that say why, and one way out.
// The compiler's `check::Finding` is built from it at one place
// (`check::from_nikaia`), so a check that moves to Nikaia says exactly what it
// said in Rust.

/// One diagnostic. `warning` is the one severity that does not stop the build
/// (`NK1111`, `NK2211`); everything else is a refusal.
pub struct Finding {
    pub code: String,
    pub span: Span,
    pub message: String,
    pub notes: Vec[String],
    pub help: String?,
    pub warning: bool,
    /// The places it points at, each with what happens there.
    pub labels: Vec[CheckLabel],
}

/// A refusal at `span`.
pub fn refusal(code: ref String, span: Span, message: String, notes: Vec[String], help: String) -> Finding {
    return Finding { code: code.clone(), span: span, message: message, notes: notes, help: help, warning: false, labels: [] }
}

/// **One file's block of `lower-std --findings`** (#1625): the line
/// `findings in PATH: N`, then every warning the checker gave the file, one
/// line each, `  PATH:LINE  NKnnnn  headline`, in the order the checker
/// found them. `scripts/analysis_scale.nika` sums the blocks by code.
pub fn findings_report(findings: ref Vec[CheckFinding], source: ref String, path: ref String) -> String {
    let mut lines: Vec[String] = []
    for finding in findings {
        if finding.severity != CheckSeverity::Warning {
            continue
        }
        let mut end = finding.span.start as i64
        if end > source.bytes.len() {
            end = source.bytes.len()
        }
        let mut line = 1
        for c in source.bytes[0..<end] {
            if c == '\n' {
                line = line + 1
            }
        }
        lines.push(f"  {path}:{line}  {finding.code}  {finding.message.replace("\n", " ")}\n")
    }
    let mut out = f"findings in {path}: {lines.len()}\n"
    for each in lines {
        out.push_str(each)
    }
    return out
}
