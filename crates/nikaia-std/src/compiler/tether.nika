// crates/nikaia-std/src/compiler/tether.nika
//
// Which of Part I 6.6's states each view in a signature is in (ADR-tether-v1 D2,
// D7), and whether a body makes a buffer of its own - the analysis half of
// the compiler's `contracts::tether`, moved from Rust (ADR-294, #125). What
// stays Rust is writing the answers into the ledger, the `--tethers` report
// and the refusal, both of which read the keep plan.
//
// **Only Borrowed is built as a representation**, and `keep::infer` says
// otherwise where a view really leaves (ADR-tether-v1 D13): so every position this
// file writes is Borrowed, and it errs **towards Tethered** wherever it
// cannot decide - a wider representation, never a program that does the
// wrong thing.

use std::collections
use std::node_id
use std::text
use std::winnow_grammar

/// The position a function's result occupies in the column - the spelling
/// `sharing` uses for the same position.
pub comptime RESULT_POSITION: ref String = "<result>"

/// The position a parse's input occupies in the column.
pub comptime INPUT_POSITION: ref String = "input"

/// Whether a body makes a buffer, and whether this walk could **name** it.
/// A named buffer is a fact a refusal may stand on; `Unknown` is a call no
/// ledger describes, which the state errs towards and no refusal may.
pub enum Buffer {
    /// Nothing here owns text or bytes.
    None,
    /// This type, made here: `String`, `Bytes`, `Mapped`, a run of `u8`.
    Named(String),
    /// A call this walk could not resolve, which may be one.
    Unknown,
}

/// What a **package's** declarations say about the types a parse can hand
/// back, by name: a `Symbol` belongs to the parse that interned it, and the
/// question crosses files.
pub struct PackageTypes {
    /// Every struct or enum of this package that holds a view.
    pub borrowing: collections::BTreeSet[String],
    /// Every type name this package declares.
    pub named: collections::BTreeSet[String],
}

impl PackageTypes {
    pub fn empty() -> PackageTypes {
        return PackageTypes { borrowing: collections::BTreeSet(), named: collections::BTreeSet() }
    }
}

/// One unit's declarations, added to the package's.
fn declare_unit(names: ref winnow_grammar::InternerContext, items: ref Vec[Spanned[Item]], mut package: PackageTypes) {
    package.borrowing.extend(borrowing_types(names, items))
    for item in items {
        match item.node {
            Item::Struct { name, .. } => {
                package.named.insert(names.resolve(name).clone())
            }
            Item::Enum { name, .. } => {
                package.named.insert(names.resolve(name).clone())
            }
            else => {}
        }
    }
}

/// Whether a grammar entry's result **may point into the text it parsed**:
/// the result is a view or names a type of this package that holds one; or
/// it names only types with no room for a view; or - anything this walk did
/// not read a declaration for - it may. One question with two readers, the
/// `views` column and `keeps`, and the polarity of the second.
fn a_parse_that_views(names: ref winnow_grammar::InternerContext, result: ref Type?, package: ref PackageTypes) -> bool {
    let ty = result ?? return false
    let name = names.resolve(ty.name)
    if (ty.is_view && !ty.lasting) || package.borrowing.contains(name) {
        return true
    }
    for argument in ty.generics {
        let inner: Type? = argument.clone()
        if a_parse_that_views(names, inner, package) {
            return true
        }
    }
    return !package.named.contains(name) && !a_type_with_no_room_for_a_view(name)
}

// The names the language below owns outright, and the containers whose
// arguments the walk above already read.
comptime ROOMLESS: Array[ref String, 28] = ["i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128", "usize", "f32", "f64", "bool", "char", "scalar", "String", "Duration", "Instant", "Vec", "List", "Array", "Option", "Map", "Set", "Shared", "SharedMut"]

fn a_type_with_no_room_for_a_view(name: ref String) -> bool {
    let base = base_name(name)
    if base == "Locked" {
        return true
    }
    for one in ROOMLESS {
        if one == base {
            return true
        }
    }
    return false
}

/// The states one function's views solved to (D7): the receiver where its
/// `impl`'s target carries a view, every parameter that carries one, and the
/// result where it does - all Borrowed, the column's one author for anything
/// else being the walk that follows views (`keep::infer`). Empty where the
/// signature has no view.
fn function_views(item: ref Item, target: ref String?, names: ref winnow_grammar::InternerContext, borrowing: ref collections::BTreeSet[String]) -> Vec[Held] {
    let mut held: Vec[Held] = []
    match item {
        Item::Fn { receiver, args, ret_type, .. } => {
            // **A parameter is lent for the call**, so the buffer is the
            // caller's; a receiver carries whatever its type does.
            if receiver != null && a_borrowing_target(target, borrowing) {
                held.push(Held { position: "self", state: State::Borrowed })
            }
            for arg in args {
                if carries_a_view(names, arg.ty, borrowing) {
                    held.push(Held { position: names.resolve(arg.name).clone(), state: State::Borrowed })
                }
            }
            if result_carries(names, ret_type, borrowing) {
                held.push(Held { position: RESULT_POSITION.clone(), state: State::Borrowed })
            }
        }
        else => {}
    }
    return held
}

/// **The `views` column of a package's ledger** (D7), the whole package at
/// once: every function's and method's states (`tether_of_function`), and an
/// `entry` rule's whose result may point into the text it parsed - the entry
/// holds the input and the result borrows it (ADR-grammar-syntax-v1 D5).
/// The reference the per-function entry is held to (ADR-100 D7). Which
/// positions really leave is `keep::infer`'s, run after this.
pub fn tether_infer(mut ledger: Ledger, units: ref Vec[ParsedView], library: ref Ledger) {
    let mut solved: collections::BTreeMap[String, Vec[Held]] = collections::BTreeMap()
    let mut package = PackageTypes::empty()
    for view in units {
        declare_unit(view.words, view.items, package)
    }
    let package_borrowing = emit_tables_package_borrowing(units)
    for view in units {
        // By **name**: a `Symbol` belongs to the parse that interned it.
        let borrowing: collections::BTreeSet[String] = emit_tables_borrowing_structs_beside(view.words, view.items, package_borrowing).iter().map(fn(sym) { view.words.resolve(sym).clone() }).collect()
        for item in view.items {
            match item.node {
                Item::Fn { name, .. } => {
                    let key = tether_function_key(view.words, name, null)
                    solved_into(solved, key, tether_of_function(item.node, null, key, view.words, borrowing, ledger, library))
                }
                Item::Impl { target, methods, .. } => {
                    let owner: String? = view.words.resolve(target.name).clone()
                    for method in methods {
                        match method.node {
                            Item::Fn { name, .. } => {
                                let key = tether_function_key(view.words, name, owner)
                                solved_into(solved, key, tether_of_function(method.node, owner, key, view.words, borrowing, ledger, library))
                            }
                            else => {}
                        }
                    }
                }
                Item::Grammar(def) => {
                    let named = view.words.resolve(def.name).clone()
                    for rule in def.rules {
                        if rule.is_entry {
                            solved_into(solved, f"{named}::{view.words.resolve(rule.name)}", tether_of_entry_rule(view.words, rule.ret_type, package))
                        }
                    }
                }
                else => {}
            }
        }
    }
    for (key, held) in solved {
        let mut contract = ledger.functions.get(key) ?? continue
        contract.views = held.clone()
    }
}

/// A column with something in it is the answer for its key; an empty one
/// says nothing.
fn solved_into(mut solved: collections::BTreeMap[String, Vec[Held]], key: ref String, held: Vec[Held]) {
    if held.len() > 0 {
        solved.insert(key.clone(), held)
    }
}

/// **One function's final column** (ADR-100 D7): the states its signature's
/// views solve to (`function_views`), with the `String` parameters its body
/// only reads lent beside them. It reads the function's own declaration and
/// its own entry of `own` (the signature, `keeps` and `by_value` the passes
/// before this one wrote) and **no callee's column**: so every function is a
/// unit of its own, any order is callees first, and a recursive group needs no
/// fixpoint. `key` is the function's key in the ledger, `target` its `impl`'s.
pub fn tether_of_function(item: ref Item, target: ref String?, key: ref String, names: ref winnow_grammar::InternerContext, borrowing: ref collections::BTreeSet[String], own: ref Ledger, library: ref Ledger) -> Vec[Held] {
    let held = function_views(item, target, names, borrowing)
    return lent_text(held, item, key, own, library, names)
}

/// **An `entry` rule's column**: its input and result Borrowed where its
/// result may point into the text it parsed, else nothing.
fn tether_of_entry_rule(names: ref winnow_grammar::InternerContext, result: ref Type?, package: ref PackageTypes) -> Vec[Held] {
    if !a_parse_that_views(names, result, package) {
        return []
    }
    return [Held { position: INPUT_POSITION.clone(), state: State::Borrowed }, Held { position: RESULT_POSITION.clone(), state: State::Borrowed }]
}

/// `Type::method`, or the function's own name; `new` for Part I 4.2's
/// anonymous constructor.
fn tether_function_key(names: ref winnow_grammar::InternerContext, name: ref winnow_grammar::Symbol?, target: ref String?) -> String {
    let mut own: String = "new"
    let symbol: winnow_grammar::Symbol? = name?.clone()
    if symbol != null {
        own = names.resolve(symbol ?? return "").clone()
    }
    let owner = target ?? return own
    return f"{owner}::{own}"
}

/// **A `String` parameter the body only reads is lent** (ADR-282 D2, D5): a
/// `&str` below, as one written `ref String` is, so the ledger says
/// `borrowed` for both alike. In the order the signature has them: the
/// receiver, the parameters, the result.
fn lent_text(held: Vec[Held], item: ref Item, key: ref String, own: ref Ledger, library: ref Ledger, names: ref winnow_grammar::InternerContext) -> Vec[Held] {
    let contract = own.functions[key] ?? return held
    return match item {
        Item::Fn { receiver, args, .. } => lent_arguments(held, receiver != null, args, contract, library, names),
        else => held,
    }
}

fn lent_arguments(held: Vec[Held], has_receiver: bool, args: ref Vec[FnArg], contract: ref FnContract, library: ref Ledger, names: ref winnow_grammar::InternerContext) -> Vec[Held] {
    let copying: Vec[ref Ledger] = [library]
    let shift = if has_receiver { 1 } else { 0 }
    let params: Vec[String] = args.iter().map(fn(arg) { names.resolve(arg.name).clone() }).collect()
    let lent: Vec[String] = (0..<args.len()).filter(fn(at) { a_plain_text_parameter(args[at], names) && !held.iter().any(fn(h) { h.position == params[at] }) && lends_in_own(contract, at + shift, copying) }).map(fn(at) { params[at].clone() }).collect()
    if lent.len() == 0 {
        return held
    }
    let mut out: Vec[Held] = held.iter().filter(fn(h) { h.position == "self" }).cloned().collect()
    for name in params {
        let found = held.iter().find(fn(h) { h.position == name })
        if found != null {
            out.push(found?.clone() ?? continue)
        } else if lent.contains(name) {
            out.push(Held { position: name.clone(), state: State::Borrowed })
        }
    }
    out.extend(held.iter().filter(fn(h) { h.position != "self" && !params.contains(h.position) }).cloned())
    return out
}

/// A parameter written plain `String`: no view, no argument, no `?`, no run,
/// not `mut`.
fn a_plain_text_parameter(arg: ref FnArg, names: ref winnow_grammar::InternerContext) -> bool {
    return names.resolve(arg.ty.name) == "String" && arg.ty.generics.len() == 0 && !arg.ty.is_view && !arg.ty.is_nullable && !arg.ty.is_slice && !arg.mutable
}

fn a_borrowing_target(target: ref String?, borrowing: ref collections::BTreeSet[String]) -> bool {
    let named = target ?? return false
    return borrowing.contains(named)
}

fn result_carries(names: ref winnow_grammar::InternerContext, result: ref Type?, borrowing: ref collections::BTreeSet[String]) -> bool {
    return carries_a_view(names, result ?? return false, borrowing)
}

/// Whether a written type **carries** a view: it is one, it names a type that
/// holds one, or one of its arguments does.
fn carries_a_view(names: ref winnow_grammar::InternerContext, ty: ref Type, borrowing: ref collections::BTreeSet[String]) -> bool {
    if holds_view(ty) || borrowing.contains(names.resolve(ty.name)) {
        return true
    }
    for argument in ty.generics {
        if carries_a_view(names, argument, borrowing) {
            return true
        }
    }
    return false
}

/// **A name declared `String` holds text of this frame's own**, whatever its
/// initialiser was (ADR-282 D4, ADR-282 D3).
fn declares_text(names: ref winnow_grammar::InternerContext, ty: ref Type?) -> bool {
    let written = ty ?? return false
    return names.resolve(written.name) == "String" && written.generics.len() == 0 && !written.is_view && !written.is_nullable
}

/// Whether this expression hands back a buffer of its own. `asked` is the
/// interner and the two ledgers; `unaliased` resolves a package's alias
/// (ADR-286 D12).
///
/// `to_owned` is owned text by the name; `to_string` is the text form of a
/// value (ADR-282 D3) - a literal's is the literal, a number's or an
/// `f"…"`'s is text of its own, anything else unsure; a copy of a literal is
/// text of its own (D2). A call is answered by its ledger entry's result -
/// owned text or bytes - and a call no ledger describes is a buffer this
/// walk cannot rule out. `catch` hands back whichever half ran.
pub fn makes_a_buffer(expr: ref Expr, asked: ref Asked, unaliased: fn(ref String) -> String sync) -> Buffer {
    return match expr {
        Expr::MethodCall { method, receiver, .. } => a_method_buffer(asked.names.resolve(method), receiver),
        Expr::Call { func, .. } => a_call_buffer(func, asked, unaliased),
        Expr::TryCatch { expr, .. } => makes_a_buffer(expr, asked, unaliased),
        // An `f"…"` is text of its own.
        Expr::LitInterpolated { .. } => Buffer::Named("String"),
        else => Buffer::None,
    }
}

fn a_method_buffer(method: ref String, receiver: ref Expr) -> Buffer {
    if method == "to_owned" {
        return Buffer::Named("String")
    }
    if method == "to_string" {
        return match receiver {
            Expr::LitStr { .. } => Buffer::None,
            Expr::LitInterpolated { .. } => Buffer::Named("String"),
            Expr::LitInt { .. } => Buffer::Named("String"),
            Expr::LitFloat(_, _) => Buffer::Named("String"),
            else => Buffer::Unknown,
        }
    }
    if method == "clone" {
        return match receiver {
            Expr::LitStr { .. } => Buffer::Named("String"),
            Expr::LitInterpolated { .. } => Buffer::Named("String"),
            else => Buffer::None,
        }
    }
    return Buffer::None
}

fn a_call_buffer(func: ref Expr, asked: ref Asked, unaliased: fn(ref String) -> String sync) -> Buffer {
    let name = match func {
        Expr::Variable(name, _) => asked.names.resolve(name).clone(),
        Expr::Path(segments, _) => unaliased(joined_segments(segments, asked.names)),
        else => return Buffer::None,
    }
    let constructor = f"{name}::new"
    let contract = an_entry(name, asked) ?? an_entry(constructor, asked) ?? return Buffer::Unknown
    let signature = contract.signature ?? return Buffer::None
    let result = signature.result ?? return Buffer::None
    if is_a_buffer(result) {
        return Buffer::Named(result.text())
    }
    return Buffer::None
}

// The program's entry by this key, else `std`'s.
fn an_entry(key: ref String, asked: ref Asked) -> FnContract? {
    let mine: FnContract? = asked.own.functions[key]?.clone()
    return mine ?? asked.library.functions[key]?.clone()
}

// Owned text or bytes - something a view can point **into**: `String`,
// `Bytes`, a mapped file, a run of `u8`. A `Vec[Entry]` is not one.
fn is_a_buffer(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, args, .. } => a_buffer_name(name, args),
        else => false,
    }
}

fn a_buffer_name(name: ref String, args: ref Vec[Ty]) -> bool {
    let base = base_name(name)
    if base == "String" || base == "Bytes" || base == "Mapped" {
        return true
    }
    if (base == "Vec" || base == "List") && args.len() > 0 {
        return names_u8(args[0])
    }
    return false
}

fn names_u8(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, .. } => base_name(name) == "u8",
        else => false,
    }
}

// ---------------------------------------------------------------------------
// `--tethers`: what the analysis solved, per function (ADR-tether-v1 D4), moved from
// the compiler's `contracts::tether` (ADR-294, #125).
//
// *The inverse tool is inspection, not assertion*: it shows what was chosen
// without being asked, read off the ledger the build produced rather than
// computed again, so that what a person reads is what the file records.
// ---------------------------------------------------------------------------

/// The words `--tethers` uses for a keep.
fn keep_words(keep: ref KeepAt) -> String {
    return match keep {
        KeepAt::Param => "in the caller's keep, because views of it leave this function",
        KeepAt::Frame => "in a keep of this function until it returns, because something outside the loop or block keeps views of it",
        KeepAt::Local(_) => "in a keep beside the call, as long as what the call hands back",
        KeepAt::Task => "in a keep the task carries with it (one count per task, not per view)",
        KeepAt::Element(_) => "in a keep of its own, held by each view kept of it, because what keeps the views drops entries while the loop goes on",
    }
}

fn goes_in_the_callers_keep(keep: ref KeepAt) -> bool {
    return match keep {
        KeepAt::Param => true,
        else => false,
    }
}

fn lives_in_a_local_keep(keep: ref KeepAt) -> bool {
    return match keep {
        KeepAt::Local(_) => true,
        else => false,
    }
}

/// How `--tethers` names an argument made in a call (ADR-tether-v1 D24), from the
/// key the keep plan files it under: `e#0` is *the argument made for `e`*.
fn an_argument(key: ref String) -> String {
    let parts: Vec[ref String] = key.split("#").collect()
    if parts.len() < 2 {
        return f"what `{key}` reads"
    }
    let place = (text::parse_i64(parts[1]) ?? 0) + 1
    return f"argument {place} made in the call to `{parts[0]}`"
}

/// The name a buffer put at statement `wanted` is bound to, which is what a reader
/// looks for in the source.
fn buffer_named(plan: ref BufferPlan, wanted: i64) -> String? {
    for (source, _) in plan.escapes {
        match source {
            Source::Buffer { at, name, .. } => {
                if at == wanted {
                    return f"`{name}`"
                }
            },
            else => {}
        }
    }
    return null
}

fn padded(word: ref String, width: i64) -> String {
    let mut out = word.clone()
    let mut n = word.scalars.count()
    while n < width {
        out.push(' ')
        n = n + 1
    }
    return out
}

/// **Each give and each reuse a check narrated, by line** (ADR-text-reuse-1
/// D5, #2514): the first byte of the site, its line from 0 and what it says,
/// in the order of the file, once per line and text (`x = x.replace(..)` is
/// narrated as an assignment and as the last use of `x`, which is one site).
fn narrated_lines(narrated: ref collections::BTreeSet[(i64, String)], source: ref String) -> Vec[(i64, i64, String)] {
    let mut out: Vec[(i64, i64, String)] = []
    let mut said: collections::BTreeSet[(i64, String)] = collections::BTreeSet()
    for (at, text) in narrated {
        let (line, _) = lsp_position(source, at)
        if said.insert((line, text.clone())) {
            out.push((at, line, text.clone()))
        }
    }
    return out
}

/// **`--tethers`' lines of the gives and reuses** (ADR-text-reuse-1 D5,
/// #2514): one per site, `FILE:LINE: rest takes the buffer of line` or
/// `FILE:LINE: replace works in the buffer of x`, the line from 1.
pub fn reuses_report(narrated: ref collections::BTreeSet[(i64, String)], source: ref String, path: ref String) -> String {
    let mut out = String()
    for (_, line, text) in narrated_lines(narrated, source) {
        out.push_str(f"{path}:{line + 1}: {text}\n")
    }
    return out
}

/// What the analysis solved, in the words a reader asks the question in:
/// first what a `String` field or result is below (`texts`, ADR-282 D26), then
/// each function of this file that holds a view, and where each buffer lives
/// (ADR-tether-v1 D13). `here` is this file's own entries, because a report is about
/// one file and the ledger is the package's.
pub fn tethers_report(texts: ref Vec[String], ledger: ref Ledger, here: ref collections::BTreeSet[String], plans: ref Vec[BufferPlan], library: ref Ledger) -> String {
    let mut lines: Vec[String] = []
    if texts.len() > 0 {
        lines.push("text (declared `String`):\n")
        for line in texts {
            lines.push(f"    {line}\n")
        }
    }
    let copying: Vec[ref Ledger] = [library]
    for (key, contract) in ledger.functions {
        if contract.views.len() == 0 || !here.contains(key) {
            continue
        }
        lines.push(f"{key}:\n")
        // **What a borrowed result borrows from** (ADR-tether-v1 D24): the
        // parameters lowered as views, each the caller's argument.
        let mut lent: Vec[String] = []
        if contract.signature != null {
            let signature = contract.signature ?? continue
            let mut at = 0
            for (name, ty) in signature.params {
                if ty.is_a_view() || lends_in(contract, at, copying) {
                    lent.push(f"`{name}`")
                }
                at = at + 1
            }
        }
        for held in contract.views {
            let state = held.state.as_str()
            let mut from = ""
            if state == "borrowed" && held.position == "<result>" && lent.len() > 0 {
                from = f" - from the caller's argument for {lent.join(", ")}"
            }
            lines.push(f"    {padded(state, 9)} `{held.position}`{from}\n")
        }
    }
    // **What a callee hands back in its caller's keep**, by callee: the
    // buffers it puts there (D9, D23).
    let mut handed: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    for plan in plans {
        let mut names: Vec[String] = []
        for (at, keep) in plan.puts {
            if goes_in_the_callers_keep(keep) {
                let found = buffer_named(plan, at) ?? continue
                names.push(found)
            }
        }
        // **An argument it made in a call** (D24) is there too.
        for (id, keep) in plan.calls {
            let (_, callee) = id
            if callee.contains("#") && goes_in_the_callers_keep(keep) {
                names.push(an_argument(callee))
            }
        }
        handed.insert(plan.key.clone(), names)
    }
    for plan in plans {
        let mut said: Vec[String] = []
        for (at, keep) in plan.puts {
            let name = buffer_named(plan, at) ?? "a buffer"
            said.push(f"    {name} lives {keep_words(keep)}\n")
        }
        for (id, keep) in plan.calls {
            let (_, callee) = id
            if callee.contains("#") {
                said.push(f"    {an_argument(callee)} lives {keep_words(keep)}\n")
                continue
            }
            // **Named, where the callee says what it puts there** (D23): `s`
            // lives in `main`'s keep, handed back by `d`.
            let mut names: Vec[String] = []
            let found = handed.get(callee)
            if found != null {
                let list = found ?? return ""
                for one in list {
                    names.push(one.clone())
                }
            }
            if lives_in_a_local_keep(keep) && names.len() > 0 {
                said.push(f"    {names.join(", ")} lives in `{plan.key}`'s keep: handed back by `{callee}`\n")
            } else {
                said.push(f"    what `{callee}` reads lives {keep_words(keep)}\n")
            }
        }
        for keeper in plan.element_keepers {
            // ADR-tether-v1: a struct of views carries a handle on each buffer it
            // points into, and the report says how many that is.
            if plan.struct_keepers.contains(keeper) {
                let width = plan.widths.get(keeper) ?? 1
                let mut handles = "a handle on the buffer it points into"
                if width != 1 {
                    handles = f"a handle on each of the {width} buffers it points into"
                }
                said.push(f"    `{keeper}` holds each struct with {handles}\n")
            } else {
                said.push(f"    `{keeper}` holds each view with its own handle\n")
            }
        }
        if said.len() == 0 {
            continue
        }
        lines.push(f"{plan.key} (keeps):\n")
        for line in said {
            lines.push(line.clone())
        }
    }
    // "here" and not "in this program", for the reason `sharing`'s report
    // gives: a report is about one file.
    if lines.len() == 0 {
        return "no view in a signature here, so there is no state to solve.\n"
    }
    return lines.join("")
}

/// One function of a test package: `name(param: String or ref String) ->
/// ref String`, whose body calls `callee`.
fn tether_test_fn(words: ref winnow_grammar::InternerContext, name: ref String, param: ref String, viewed: bool, result: bool, callee: ref String?) -> Spanned[Item] {
    let text = Type { name: words.intern_string("String"), generics: [], is_view: viewed, is_tuple: false, is_nullable: false, code: null, count: null, is_mut: false, is_slice: false, either: false, lasting: false }
    let mut ret_type: Type? = null
    if result {
        let mut viewing = text.clone()
        viewing.is_view = true
        ret_type = viewing
    }
    let mut stmts: Vec[Spanned[Stmt]] = []
    if callee != null {
        let called = Expr::Variable(words.intern_string(callee ?? ""), node_id::NodeId::fresh())
        let call = Expr::Call { func: called, args: [], config: [], id: node_id::NodeId::fresh() }
        stmts.push(Spanned { node: Stmt::Expr(call), span: Span::nowhere(), doc: null, attributes: [] })
    }
    let args: Vec[FnArg] = [FnArg { name: words.intern_string(param), ty: text, mutable: false, keep: false, span: Span::nowhere(), attributes: [] }]
    let item = Item::Fn { name: words.intern_string(name), generics: [], receiver: null, args: args, config: [], spread: null, ret_type: ret_type, body: Block { stmts: stmts }, is_sync: false, sync_by: [], is_public: false, can_throw: false, is_extern: false, ret_from: [] }
    return Spanned { node: item, span: Span::nowhere(), doc: null, attributes: [] }
}

/// **The per-function entry answers what the whole-package entry answers**
/// (ADR-100 D7, ADR-403 D3): on a call chain `a -> b -> c` and a recursive
/// pair `p <-> q`, each function's column comes from its own declaration and
/// ledger entry alone, with no callee's column stored.
test "the per-function tether entry gives the whole-package column" {
    let words = winnow_grammar::InternerContext()
    let items: Vec[Spanned[Item]] = [tether_test_fn(words, "a", "s", true, true, "b"), tether_test_fn(words, "b", "t", false, false, "c"), tether_test_fn(words, "c", "u", false, true, null), tether_test_fn(words, "p", "v", false, false, "q"), tether_test_fn(words, "q", "w", true, false, "p")]
    let mut own = Ledger::blank()
    let params = [("a", "s"), ("b", "t"), ("c", "u"), ("p", "v"), ("q", "w")]
    for (name, param) in params {
        let mut contract = FnContract::empty()
        let mut signature = Signature::empty()
        signature.params.push((param.clone(), Ty::Named { name: "String", args: [], view: false }))
        contract.signature = signature
        own.functions.insert(name.clone(), contract)
    }
    let aliases: collections::BTreeMap[String, String] = collections::BTreeMap()
    let spans: collections::BTreeMap[u32, Span] = collections::BTreeMap()
    let arms: collections::BTreeSet[i64] = collections::BTreeSet()
    let pushes: collections::BTreeSet[i64] = collections::BTreeSet()
    let units: Vec[ParsedView] = [ParsedView { words: words, aliases: aliases, items: items, package: null, spans: spans, viewed_arms: arms, given_pushes: pushes }]
    let mut whole = own.clone()
    tether_infer(whole, units, Ledger::blank())
    let borrowing: collections::BTreeSet[String] = collections::BTreeSet()
    // Callees first or callers first: no column of another function is read.
    for at in [4, 3, 2, 1, 0] {
        let key = words.resolve(match items[at].node {
            Item::Fn { name, .. } => name ?? continue,
            else => continue,
        }).clone()
        let alone = tether_of_function(items[at].node, null, key, words, borrowing, own, Ledger::blank())
        let written = whole.functions[key]?.views?.clone() ?? []
        assert(alone == written)
    }
    // A view handed back gives a column: the loop compared real ones.
    let a_column = whole.functions["a"]?.views?.clone() ?? []
    assert(a_column.len() != 0)
    let c_column = whole.functions["c"]?.views?.clone() ?? []
    assert(c_column.len() != 0)
}
