// crates/nikaia-std/src/compiler/emit_text.nika
//
// **The text the emitter writes Rust with**, moved from `emit/mod.rs`
// (ADR-294, #125, #558): a string literal as Rust spells it, a format string's
// braces, the parts of a comma-separated list at the top level, the format of
// an f-string, the name of a `truncating_*` or `checked_*` method, and how a
// type and a literal are written when the declaration is plain Rust. Leaves:
// each calls only the others in this file.

/// A string as a Rust literal: quotes, backslash and the three control
/// characters escaped.
fn rust_string(text: ref String) -> String {
    let mut out: String = "\""
    for c in text.scalars {
        if c == '"' {
            out.push_str("\\\"")
        } else if c == '\\' {
            out.push_str("\\\\")
        } else if c == '\n' {
            out.push_str("\\n")
        } else if c == '\r' {
            out.push_str("\\r")
        } else if c == '\t' {
            out.push_str("\\t")
        } else {
            out.push(c)
        }
    }
    out.push('"')
    return out
}

/// Text written as it is read, as a Rust format string takes it: an escape
/// stays two characters (`\u{..}` keeps its braces) and every other brace is
/// doubled.
fn rust_format_escape(text: ref String) -> String {
    let mut out: String = ""
    let chars: Vec[scalar] = text.scalars.collect()
    let mut at = 0
    while at < chars.len() {
        let c = chars[at]
        at += 1
        if c == '\\' {
            out.push('\\')
            if at >= chars.len() {
                break
            }
            let escape = chars[at]
            at += 1
            out.push(escape)
            if escape == 'u' && at < chars.len() && chars[at] == '{' {
                while at < chars.len() {
                    let inner = chars[at]
                    at += 1
                    out.push(inner)
                    if inner == '}' {
                        break
                    }
                }
            }
        } else if c == '{' {
            out.push_str("{{")
        } else if c == '}' {
            out.push_str("}}")
        } else {
            out.push(c)
        }
    }
    return out
}

/// The parts of `inside` separated by a comma that stands at depth zero,
/// outside a string, each trimmed; a last empty part is left out.
fn top_level_parts(inside: ref String) -> Vec[String] {
    let mut parts: Vec[String] = []
    let mut current: String = ""
    let mut depth = 0
    let mut in_text = false
    let mut escaped_next = false
    for c in inside.scalars {
        if in_text {
            current.push(c)
            if escaped_next {
                escaped_next = false
            } else if c == '\\' {
                escaped_next = true
            } else if c == '"' {
                in_text = false
            }
            continue
        }
        if c == '"' {
            in_text = true
        } else if c == '{' || c == '(' || c == '[' {
            depth += 1
        } else if c == '}' || c == ')' || c == ']' {
            depth -= 1
        } else if c == ',' && depth == 0 {
            parts.push(current.trim().clone())
            current = ""
            continue
        }
        current.push(c)
    }
    if current.trim().len() > 0 {
        parts.push(current.trim().clone())
    }
    return parts
}

/// The Rust format string of an f-string's parts: its text, and a `{}` or
/// `{:spec}` for each hole.
pub fn format_of(parts: ref Vec[FPart]) -> String {
    let mut format: String = ""
    for part in parts {
        match part {
            FPart::Text(text) => format.push_str(text),
            FPart::Hole { spec, .. } => format.push_str(a_hole_format(spec)),
        }
    }
    return format
}

fn a_hole_format(spec: ref String?) -> String {
    let held = spec ?? return "{}"
    return f"{{:{held}}}"
}

/// `truncating_i32` and `bits_as_i32` (ADR-285 D42): the integer type the
/// method names, if it is one the language converts to with Rust's `as`.
pub fn truncating(method: ref String) -> String? {
    if method.starts_with("bits_as_") {
        let bits = method.strip_prefix("bits_as_") ?? ""
        return an_integer_type(bits)
    }
    let ty = method.strip_prefix("truncating_") ?? return null
    return an_integer_type(ty)
}

/// `checked_i32`, likewise.
pub fn checked(method: ref String) -> String? {
    let ty = method.strip_prefix("checked_") ?? return null
    return an_integer_type(ty)
}

fn an_integer_type(ty: ref String) -> String? {
    return match ty {
        "i32" => "i32",
        "i64" => "i64",
        "u8" => "u8",
        "u32" => "u32",
        "u64" => "u64",
        else => null,
    }
}

fn owned_text(ty: ref Ty) -> bool {
    return match ty {
        Ty::Named { name, view, .. } => an_owned_text_name(name, view),
        else => false,
    }
}

fn an_owned_text_name(name: ref String, view: bool) -> bool {
    if view {
        return false
    }
    return name == "String"
}

/// A declared literal as it stands in a `const`/`static` of type `ty`: an
/// owned `String` is made from it and a nullable holds it in a `Some`.
fn held_literal(literal: ref String, ty: ref Ty) -> String {
    if owned_text(ty) && literal.starts_with("\"") {
        return f"String::from({literal})"
    }
    return match ty {
        Ty::Nullable(inner) => held_nullable(literal, inner),
        else => literal.clone(),
    }
}

fn held_nullable(literal: ref String, inner: ref Ty) -> String {
    if literal == "None" {
        return literal.clone()
    }
    if owned_text(inner) && literal.starts_with("\"") {
        return f"Some(String::from({literal}))"
    }
    return f"Some({literal})"
}

/// A type as plain Rust spells it, `_` where it cannot be said.
fn plain_rust_spelling(ty: ref Ty) -> String {
    return match ty {
        Ty::Named { name, args, view } => plain_named(name, args, view),
        Ty::Nullable(inner) => f"::core::option::Option<{plain_rust_spelling(inner)}>",
        else => "_",
    }
}

fn plain_named(written: ref String, args: ref Vec[Ty], view: bool) -> String {
    let mut name = written.clone()
    if name == "List" {
        name = "Vec"
    }
    let mut inner: String = ""
    if args.len() > 0 {
        let mut spelled: Vec[String] = []
        for arg in args {
            spelled.push(plain_rust_spelling(arg))
        }
        inner = f"<{spelled.join(", ")}>"
    }
    if view {
        if name == "str" || name == "String" {
            return "&str"
        }
        return "_"
    }
    if name == "str" {
        return "String"
    }
    return f"{name}{inner}"
}

/// The check `emit_format_compared` writes on the lent text `__nikaia_t` and
/// the parts `pieces`, each a `str` literal or a lent hole (#2405).
pub fn format_compared_check(kind: ref String, pieces: ref Vec[String]) -> String {
    if kind == "!=" {
        return f"!({format_compared_check("==", pieces)})"
    }
    if pieces.is_empty() {
        return if kind == "==" { "__nikaia_t.is_empty()" } else { "true" }
    }
    if pieces.len() == 1 && kind != "==" {
        return f"__nikaia_t.{kind}({pieces.join("")})"
    }
    if kind == "ends_with" {
        let mut reversed = pieces.clone()
        reversed.reverse()
        return f"{format_stripped("__nikaia_t", reversed, 0, "strip_suffix")}.is_some()"
    }
    if kind == "==" {
        let mut lengths: Vec[String] = []
        for piece in pieces {
            lengths.push(f"{piece}.len()")
        }
        return f"__nikaia_t.len() == {lengths.join(" + ")} && {format_stripped("__nikaia_t", pieces, 0, "strip_prefix")}.is_some()"
    }
    if kind == "contains" {
        let first = pieces.first() ?? ""
        let after = format_stripped(f"__nikaia_rest[__nikaia_i + {first}.len()..]", pieces, 1, "strip_prefix")
        return f"{{ let mut __nikaia_rest: &str = __nikaia_t; loop {{ match __nikaia_rest.find({first}) {{ Some(__nikaia_i) => {{ if {after}.is_some() {{ break true; }} match __nikaia_rest[__nikaia_i..].chars().next() {{ Some(__nikaia_c) => __nikaia_rest = &__nikaia_rest[__nikaia_i + __nikaia_c.len_utf8()..], None => break false, }} }}, None => break false, }} }} }}"
    }
    return f"{format_stripped("__nikaia_t", pieces, 0, "strip_prefix")}.is_some()"
}

/// `base` with the parts of `pieces` from `from` on stripped in turn by
/// `method`, `strip_prefix` or `strip_suffix`: the rest, or `None` where a
/// part is not there (#2405).
fn format_stripped(base: ref String, pieces: ref Vec[String], from: i64, method: ref String) -> String {
    let mut chain: String = ""
    let mut i = 0
    for piece in pieces {
        if i == from {
            chain = f"{base}.{method}({piece})"
        } else if i > from {
            chain.push_str(f".and_then(|__nikaia_r| __nikaia_r.{method}({piece}))")
        }
        i += 1
    }
    return chain
}
