// crates/nikaia-std/src/compiler/check_grammar.nika
//
// **What a grammar's pattern gives its action** (Part II 10.1, #500, #558,
// #125), moved from the compiler's checker: the type a pattern's result has
// (`pattern_type`) and the names a rule's pattern binds with it
// (`bindings_of`). Text is a view, a repeat of a built-in is text, a repeat of
// anything else is a list, an optional is nullable, and a reference to a rule
// has the type that rule declares.

use std::collections

/// A named type with no arguments.
fn pattern_named(name: ref String, view: bool) -> Ty sync {
    return Ty::Named { name: name.clone(), args: [], view: view }
}

fn pattern_text() -> Ty sync {
    return Ty::Named { name: "str", args: [], view: true }
}

fn pattern_scalar() -> Ty sync {
    return Ty::Named { name: "scalar", args: [], view: false }
}

/// A `Vec` of an item type, or `?` where the item is not known.
fn list_of_known(item: Ty) -> Ty sync {
    if item.is_unknown() {
        return Ty::Unknown
    }
    return Ty::Named { name: "Vec", args: [item], view: false }
}

/// The name of a reference to a rule or built-in with no arguments or
/// generics, and an empty one for any other pattern.
fn bare_reference(pattern: ref Pattern, world: ref CheckWorld) -> String sync {
    return match pattern {
        Pattern::Ref { name, generics, args } => if generics.len() == 0 && args.len() == 0 { world.words.resolve(name).clone() } else { "" },
        else => "",
    }
}

/// The built-in `text(..)` with a pattern inside, not a rule of that name.
fn grammar_a_text_call(world: ref CheckWorld, pattern: ref Pattern, rules: ref collections::BTreeSet[String]) -> bool sync {
    return match pattern {
        Pattern::Ref { name, generics, args } => generics.len() == 0 && args.len() >= 1 && world.words.resolve(name) == "text" && !rules.contains(world.words.resolve(name)),
        else => false,
    }
}

/// The built-in `span(p)`, not a rule of that name.
fn grammar_a_span_call(world: ref CheckWorld, pattern: ref Pattern, rules: ref collections::BTreeSet[String]) -> bool sync {
    return match pattern {
        Pattern::Ref { name, generics, args } => generics.len() == 0 && args.len() == 1 && world.words.resolve(name) == "span" && !rules.contains(world.words.resolve(name)),
        else => false,
    }
}

/// **A pattern through every group around one element**: what a label on it
/// binds, as Part II 10.8 reads `( p )` (the emitter's `emit_ungrouped`).
fn grammar_ungrouped(pattern: ref Pattern) -> ref Pattern sync {
    return match pattern {
        Pattern::Group(inner) => match inner.node {
            Pattern::Seq(_) => pattern,
            Pattern::Choice(_) => pattern,
            else => grammar_ungrouped(inner.node),
        },
        else => pattern,
    }
}

fn an_offered_number_name(name: ref String) -> bool sync {
    return name == "i32" || name == "i64" || name == "u8" || name == "u32" || name == "u64" || name == "f32" || name == "f64"
}

/// **An `@stream` entry repeats one item on a fixed path** (ADR-grammar-2
/// D7, `NK1349`): one alternative, no action, and through its sequences and
/// groups exactly one element that repeats a rule of the grammar whose type is
/// the entry's (`item*`, `item+`, a counted repeat, `list(item, sep)`). What
/// stands around it is matched and dropped, so nothing is built from the
/// items and each can be handed over as it is parsed. An entry whose items
/// are handed over by `emit` in the rules it reaches (`emitted`, amended
/// 2026-11-18, #2061) needs neither the one alternative nor the repetition.
fn grammar_stream_refused(world: ref CheckWorld, rule: ref GrammarRule, results: ref collections::BTreeMap[String, Ty], rules: ref collections::BTreeSet[String], emitted: bool) -> CheckFinding? {
    let entry = world.words.resolve(rule.name).clone()
    let wanted: Ty = results[entry]?.clone() ?? Ty::Unknown
    if wanted.is_unknown() {
        return grammar_stream_refusal(entry, rule.span, "it names no item type", f"Write the type of one item after the arrow: `@stream entry rule {entry} -> Item = item*`.")
    }
    if emitted {
        for alt in rule.alts {
            if alt.action != null {
                return grammar_stream_refusal(entry, rule.span, "it has an action", "Leave the action out: the items are handed over by `emit` in the rules below it, so the entry builds nothing.")
            }
        }
        return null
    }
    if rule.alts.len() != 1 {
        return grammar_stream_refusal(entry, rule.span, f"it has {rule.alts.len()} alternatives", "Put the choice into the item's rule, and leave the entry one repetition: `item*`.")
    }
    if rule.alts[0].action != null {
        return grammar_stream_refusal(entry, rule.span, "it has an action", "Leave the action out: each item goes to the caller as it is parsed, so there is no list for an action to read.")
    }
    let found = grammar_stream_paths(world, rule.alts[0].pattern.node, wanted, results, rules)
    if found == 1 {
        return null
    }
    let item = wanted.text()
    if found == 0 {
        return grammar_stream_refusal(entry, rule.span, f"no element of it repeats a rule of type `{item}`", f"Repeat the rule of one item: `item*`, `item+` or `list(item, \",\")`, where `item` is a rule `-> {item}`.")
    }
    return grammar_stream_refusal(entry, rule.span, f"{found} of its elements repeat a rule of type `{item}`", "Stream one repetition, and fold the others into the item's rule.")
}

fn grammar_stream_refusal(entry: ref String, span: ref Span, why: String, help: String) -> CheckFinding sync {
    let notes: Vec[String] = ["A streamed entry hands each item to the caller's `for` as the parser produces it (ADR-grammar-2 D7): its body is one repetition of the item's rule, with only what is matched and dropped around it."]
    return check_refusal("NK1349", span, f"`{entry}` is `@stream`, so its body has to repeat one item on a fixed path, but {why}.", notes, help)
}

/// How many elements on the body's one path repeat an item of type `wanted`:
/// a sequence and a group hand on what they hold, a choice or anything else
/// counts none.
fn grammar_stream_paths(world: ref CheckWorld, pattern: ref Pattern, wanted: ref Ty, results: ref collections::BTreeMap[String, Ty], rules: ref collections::BTreeSet[String]) -> i64 sync {
    match pattern {
        Pattern::Group(inner) => return grammar_stream_paths(world, inner.node, wanted, results, rules),
        Pattern::Seq(parts) => {
            let mut count = 0
            for part in parts {
                count += grammar_stream_paths(world, part.node, wanted, results, rules)
            }
            return count
        },
        Pattern::Repeat { pat, rep } => {
            if rep != Repeat::Optional && grammar_stream_item(world, pat.node, wanted, results, rules) {
                return 1
            }
            return 0
        },
        Pattern::Counted { pat, .. } => {
            if grammar_stream_item(world, pat.node, wanted, results, rules) {
                return 1
            }
            return 0
        },
        Pattern::Ref { name, generics, args } => {
            let called = world.words.resolve(name).clone()
            if called == "list" && !rules.contains(called) && generics.len() == 0 && args.len() == 2 && grammar_stream_item(world, args[0].node, wanted, results, rules) {
                return 1
            }
            return 0
        },
        else => return 0,
    }
}

/// A call of a rule of the grammar whose declared type is the item's.
fn grammar_stream_item(world: ref CheckWorld, pattern: ref Pattern, wanted: ref Ty, results: ref collections::BTreeMap[String, Ty], rules: ref collections::BTreeSet[String]) -> bool sync {
    let mut called: String = ""
    match pattern {
        Pattern::Group(inner) => return grammar_stream_item(world, inner.node, wanted, results, rules),
        Pattern::Ref { name, generics, .. } => {
            if generics.len() == 0 {
                called = world.words.resolve(name).clone()
            }
        },
        Pattern::Call { name, .. } => {
            called = world.words.resolve(name).clone()
        },
        else => {},
    }
    if called == "" || !rules.contains(called) {
        return false
    }
    let declared: Ty = results[called]?.clone() ?? return false
    return declared.text() == wanted.text()
}

impl CheckState {
    /// **The type a pattern's result has** in a rule's action.
    fn pattern_type(ref self, world: ref CheckWorld, pattern: ref Pattern, rules: ref collections::BTreeSet[String]) -> Ty sync {
        return match pattern {
            Pattern::Repeat { pat, rep } => self.repeat_type(world, pat.node, rep, rules),
            Pattern::Group(pat) => self.pattern_type(world, pat.node, rules),
            Pattern::Choice(alternatives) => self.choice_type(world, alternatives, rules),
            Pattern::Ref { name, generics, args } => self.reference_type(world, name, generics, args, rules),
            // a rule handed values hands back its result (ADR-grammar-1 D2)
            Pattern::Call { name, .. } => self.rule_results[world.words.resolve(name).clone()]?.clone() ?? Ty::Unknown,
            Pattern::Counted { pat, .. } => self.repeat_type(world, pat.node, Repeat::Star, rules),
            // a label on a literal binds the text matched (Part II 10.8, #1030)
            Pattern::Literal(_) => pattern_text(),
            // `members[S](..)` builds an `S` (ADR-grammar-2 D3)
            Pattern::Members { ty, .. } => if ty.generics.len() == 0 && !ty.is_tuple { pattern_named(world.words.resolve(ty.name), ty.is_nullable) } else { Ty::Unknown },
            else => Ty::Unknown,
        }
    }

    fn repeat_type(ref self, world: ref CheckWorld, pat: ref Pattern, rep: ref Repeat, rules: ref collections::BTreeSet[String]) -> Ty sync {
        if rep == Repeat::Optional {
            let inner = self.pattern_type(world, pat, rules)
            return match inner {
                Ty::Nullable(_) => inner,
                else => Ty::Nullable(inner),
            }
        }
        let called = bare_reference(pat, world)
        if (called == "digit" || called == "hex_digit" || called == "any") && !rules.contains(called) {
            return pattern_text()
        }
        return list_of_known(self.pattern_type(world, pat, rules))
    }

    fn choice_type(ref self, world: ref CheckWorld, alternatives: ref Vec[Spanned[Pattern]], rules: ref collections::BTreeSet[String]) -> Ty sync {
        let mut first = Ty::Unknown
        let mut at = 0
        while at < alternatives.len() {
            let ty = self.pattern_type(world, alternatives[at].node, rules)
            if at == 0 {
                if ty.is_unknown() {
                    return Ty::Unknown
                }
                first = ty
            } else if ty.text() != first.text() {
                return Ty::Unknown
            }
            at = at + 1
        }
        return first
    }

    fn reference_type(ref self, world: ref CheckWorld, name: winnow_grammar::Symbol, generics: ref Vec[Type], args: ref Vec[Spanned[Pattern]], rules: ref collections::BTreeSet[String]) -> Ty sync {
        let called = world.words.resolve(name).clone()
        if rules.contains(called) {
            return self.rule_results[called]?.clone() ?? Ty::Unknown
        }
        if called == "dec" && generics.len() == 1 {
            let written = world.words.resolve(generics[0].name).clone()
            if generics[0].generics.len() == 0 && an_offered_number_name(written) {
                return pattern_named(written, false)
            }
            return Ty::Unknown
        }
        if generics.len() == 0 {
            if args.len() == 0 {
                if called == "digit" || called == "hex_digit" || called == "any" || called == "char" {
                    return pattern_scalar()
                }
                if called == "raw_ident" || called == "string" || called == "alpha1" || called == "multispace0" || called == "multispace1" {
                    return pattern_text()
                }
            }
            if (called == "until" || called == "text") && args.len() >= 1 {
                return pattern_text()
            }
            // **`ident` and `intern(p)` yield the `Symbol` interned into the
            // table** (Part II 10.6, ADR-388): known here, an action handing
            // it to a `Symbol?` result is wrapped as any other value (#1202).
            if (called == "ident" && args.len() == 0) || (called == "intern" && args.len() == 1) {
                return pattern_named("winnow_grammar::Symbol", false)
            }
            // **`bytes(p)` is what `p` covered, as bytes** (ADR-366 D4), over
            // either input.
            if called == "bytes" && args.len() >= 1 {
                return pattern_named("Bytes", true)
            }
            // **`span(p)` is the range `p` covered, `here` the position**
            // (ADR-339 D1): over a `Bytes`, a `text::Span` of two `u32` and a
            // `u32`. Over text they wait for #743 (`grammar_positions_over_text`).
            if called == "span" && args.len() == 1 {
                return pattern_named("text::Span", false)
            }
            if called == "here" && args.len() == 0 {
                return pattern_named("u32", false)
            }
            // **`same_line` matches nothing and fails after a line break**
            // (ADR-339 D2): it covers no input and yields no value.
            if called == "same_line" && args.len() == 0 {
                return Ty::Tuple([])
            }
            // **How often `p` matched**, an `i64` (ADR-grammar-1 D5).
            if called == "count" && args.len() == 1 {
                return pattern_named("i64", false)
            }
            if called == "peek" && args.len() == 1 {
                return self.pattern_type(world, args[0].node, rules)
            }
            if called == "list" && args.len() == 2 {
                return list_of_known(self.pattern_type(world, args[0].node, rules))
            }
        }
        return Ty::Unknown
    }

    /// **The names a rule's pattern binds**, each with its pattern's type, in
    /// the order they stand: those the emitter binds at the alternative's
    /// level (#1039, `EmitWalk.grammar_nested`). A sequence, a group and a
    /// label hand on what they hold, and so do `text(..)`, bound or not, and
    /// a bound `span(..)`; below a repeat, a counted repeat, a choice or any
    /// other built-in's argument a name stays there (Part II 10).
    fn bindings_of(ref mut self, world: ref CheckWorld, pattern: ref Pattern, rules: ref collections::BTreeSet[String]) -> Vec[CheckLocal] sync {
        let mut out: Vec[CheckLocal] = []
        match pattern {
            Pattern::Bind { name, pat } => {
                let ty = self.pattern_type(world, pat.node, rules)
                self.next_binding = self.next_binding + 1
                out.push(CheckLocal::free(world.words.resolve(name).clone(), ty, self.next_binding))
                // a bound `span(p)` is `p` with the range it covered (ADR-339 D1)
                let inner = grammar_ungrouped(pat.node)
                match inner {
                    Pattern::Ref { args, .. } if grammar_a_span_call(world, inner, rules) => {
                        for bound in self.bindings_of(world, args[0].node, rules) {
                            out.push(bound)
                        }
                    },
                    else => {
                        for bound in self.bindings_of(world, pat.node, rules) {
                            out.push(bound)
                        }
                    },
                }
            },
            Pattern::Seq(parts) => {
                for part in parts {
                    for inner in self.bindings_of(world, part.node, rules) {
                        out.push(inner)
                    }
                }
            },
            Pattern::Ref { args, .. } if grammar_a_text_call(world, pattern, rules) => {
                for arg in args {
                    for inner in self.bindings_of(world, arg.node, rules) {
                        out.push(inner)
                    }
                }
            },
            Pattern::Group(pat) => {
                for inner in self.bindings_of(world, pat.node, rules) {
                    out.push(inner)
                }
            },
            else => {},
        }
        return out
    }
}

/// The first `span(p)` or `here` a pattern writes, where the grammar declares
/// no rule of that name, or an empty text.
fn grammar_position_written(world: ref CheckWorld, pattern: ref Pattern, rules: ref collections::BTreeSet[String]) -> String sync {
    return match pattern {
        Pattern::Ref { name, generics, args } => {
            let called = world.words.resolve(name).clone()
            let built_in = !rules.contains(called) && generics.len() == 0
            if built_in && ((called == "span" && args.len() == 1) || (called == "here" && args.len() == 0)) {
                return called
            }
            grammar_position_in_any(world, args, rules)
        },
        Pattern::Seq(parts) => grammar_position_in_any(world, parts, rules),
        Pattern::Choice(parts) => grammar_position_in_any(world, parts, rules),
        Pattern::Bind { pat, .. } => grammar_position_written(world, pat.node, rules),
        Pattern::Repeat { pat, .. } => grammar_position_written(world, pat.node, rules),
        Pattern::Group(inner) => grammar_position_written(world, inner.node, rules),
        else => "",
    }
}

fn grammar_position_in_any(world: ref CheckWorld, parts: ref Vec[Spanned[Pattern]], rules: ref collections::BTreeSet[String]) -> String sync {
    for part in parts {
        let found = grammar_position_written(world, part.node, rules)
        if found != "" {
            return found
        }
    }
    return ""
}

/// The first `span(p)` or `here` the grammar `named` writes in this file or
/// beside it, or an empty text.
fn grammar_position_of(world: ref CheckWorld, named: ref String) -> String sync {
    let found = grammar_position_in_view(world, world.here, named)
    if found != "" {
        return found
    }
    for view in world.beside {
        let beside = grammar_position_in_view(world, view, named)
        if beside != "" {
            return beside
        }
    }
    return ""
}

fn grammar_position_in_view(world: ref CheckWorld, view: ref ParsedView, named: ref String) -> String sync {
    for item in view.items {
        match item.node {
            Item::Grammar(def) => {
                if view.text(def.name) == named {
                    let mut rules: collections::BTreeSet[String] = collections::BTreeSet()
                    for rule in def.rules {
                        rules.insert(view.text(rule.name))
                    }
                    for rule in def.rules {
                        for alt in rule.alts {
                            let found = grammar_position_written(world, alt.pattern.node, rules)
                            if found != "" {
                                return found
                            }
                        }
                    }
                }
            },
            else => {},
        }
    }
    return ""
}

/// **`span(p)` and `here` over text are not built yet** (`NK1187`, ADR-339
/// D1, #557): over a `Bytes` they are a `text::Span` and a `u32`; over text
/// they are a `text::Match` and a `text::Pos`, which wait for #743. Asked
/// where an entry of the grammar `named` is handed text.
fn grammar_positions_over_text(world: ref CheckWorld, key: ref String, named: ref String, span: ref Span) -> CheckFinding? {
    let written = grammar_position_of(world, named)
    if written == "" {
        return null
    }
    let notes: Vec[String] = [f"Over a `Bytes` `{written}` is built (Part II 10.8); over text it is a `text::Match` or a `text::Pos`, which are not built yet (#743)."]
    return check_refusal("NK1187", span, f"`{key}` is handed text, and its grammar uses `{written}`, which this engine has over a `Bytes` only.", notes, f"Hand `{key}` the input as a `Bytes`.")
}

impl CheckState {
    /// **The values a rule takes** (ADR-grammar-1 D2): its parameters and its
    /// options, each a local of its patterns and of its actions.
    /// A value written plain or `ref` is lent (ADR-grammar-1 D6, ADR-views-3
    /// D1): the action reads the caller's, as a function's parameter does.
    /// Plain text is a view of text there, as in a function (ADR-282 D2).
    fn rule_values[H: CheckHost](ref mut self, world: ref CheckWorld, host: ref H, rule: ref GrammarRule) -> Vec[CheckLocal] sync {
        let mut out: Vec[CheckLocal] = []
        let owner: String = self.current?.clone() ?? ""
        for arg in rule.args {
            self.next_binding = self.next_binding + 1
            let name = world.words.resolve(arg.name).clone()
            let mut ty = host.type_of(arg.ty)
            if self.a_lent_rule_value(world, host, arg) {
                self.facts.lent_rule_values.insert(f"{owner}::{name}")
                let plain_text = world.words.resolve(arg.ty.name) == "String" && arg.ty.generics.len() == 0 && !arg.ty.is_nullable && !arg.ty.is_slice
                if plain_text && !arg.ty.is_view {
                    let mut viewed = arg.ty.clone()
                    viewed.is_view = true
                    ty = host.type_of(viewed)
                }
            }
            out.push(CheckLocal::free(name, ty, self.next_binding))
        }
        for option in rule.config {
            self.next_binding = self.next_binding + 1
            out.push(CheckLocal::free(world.words.resolve(option.name).clone(), host.type_of(option.ty), self.next_binding))
        }
        return out
    }

    /// **What a pattern computes, checked where it stands** (ADR-grammar-1
    /// D2-D4): a rule's arguments against its values, a bound as an `i64`, a
    /// guard as a `bool`, each over what is in scope there - the rule's own
    /// values and the bindings written before it in its sequence. Hands back
    /// what is in scope after it: a sequence's bindings are its followers',
    /// and what an alternative, a group or a repetition binds stays inside.
    /// What the pattern inside a `text(..)`, bound or not, binds is handed on
    /// as well (#1013, #1039): a guard after `s:text(d:P+)` or `text(d:P+)`
    /// reads `d`, as the action does.
    fn grammar_values[H: CheckHost](ref mut self, world: ref CheckWorld, host: ref H, gram: ref GrammarDef, pattern: ref Spanned[Pattern], rules: ref collections::BTreeSet[String], scope: Vec[CheckLocal]) -> Vec[CheckLocal] sync {
        match pattern.node {
            Pattern::Seq(parts) => {
                let mut now = scope
                for part in parts {
                    now = self.grammar_values(world, host, gram, part, rules, now)
                }
                return now
            },
            Pattern::Bind { name, pat } => {
                let mut out = scope.clone()
                match pat.node {
                    Pattern::Ref { args, .. } if grammar_a_text_call(world, pat.node, rules) => {
                        for arg in args {
                            out = self.grammar_values(world, host, gram, arg, rules, out)
                        }
                    },
                    else => {
                        self.grammar_values(world, host, gram, pat, rules, scope.clone())
                    },
                }
                let ty = self.pattern_type(world, pat.node, rules)
                self.next_binding = self.next_binding + 1
                out.push(CheckLocal::free(world.words.resolve(name).clone(), ty, self.next_binding))
                return out
            },
            Pattern::Choice(parts) => {
                for part in parts {
                    self.grammar_values(world, host, gram, part, rules, scope.clone())
                }
                return scope
            },
            Pattern::Group(inner) => {
                self.grammar_values(world, host, gram, inner, rules, scope.clone())
                return scope
            },
            Pattern::Repeat { pat, .. } => {
                self.grammar_values(world, host, gram, pat, rules, scope.clone())
                return scope
            },
            // an unbound `text(..)` hands on what its pattern binds, as a
            // bound one does (#1039)
            Pattern::Ref { args, .. } if grammar_a_text_call(world, pattern.node, rules) => {
                let mut out = scope
                for arg in args {
                    out = self.grammar_values(world, host, gram, arg, rules, out)
                }
                return out
            },
            Pattern::Ref { name, args, .. } => {
                for arg in args {
                    self.grammar_values(world, host, gram, arg, rules, scope.clone())
                }
                // **A rule that takes values is called with them**: `Block`
                // alone, where `Block(n: i64)` was declared, has none to give.
                let called = world.words.resolve(name).clone()
                if args.len() == 0 && rules.contains(called) {
                    for rule in gram.rules {
                        if rule.name == name && rule.args.len() > 0 {
                            self.findings.push(check_refusal("NK1101", pattern.span, f"`{called}` takes {counted(rule.args.len() as i64, "value")} before the `;`, but none is given.", ["A rule declared with values is called with them, as a function is (ADR-grammar-1 D2)."], f"Write `{called}(…)` with a value for each."))
                        }
                    }
                }
                return scope
            },
            Pattern::Counted { pat, low, high, .. } => {
                self.grammar_values(world, host, gram, pat, rules, scope.clone())
                let whole = pattern_named("i64", false)
                self.grammar_fixed(world, host, low, whole.clone(), scope, pattern.span, "A bound", "A bound counts repetitions: write an `i64`, such as `n` or `n - 1`.")
                match high {
                    bound => self.grammar_fixed(world, host, bound, whole, scope, pattern.span, "A bound", "A bound counts repetitions: write an `i64`, such as `n` or `n - 1`."),
                    null => {},
                }
                return scope
            },
            // Resolved by the copying before any check (grammar_types.nika).
            Pattern::Choose { .. } => {
                return scope
            },
            Pattern::Members { key, sep, .. } => {
                self.grammar_values(world, host, gram, key, rules, scope.clone())
                self.grammar_values(world, host, gram, sep, rules, scope.clone())
                return scope
            },
            Pattern::Guard { cond, .. } => {
                self.grammar_fixed(world, host, cond, pattern_named("bool", false), scope, pattern.span, "A guard", "A guard is a condition: compare, as in `if(m > n)`.")
                return scope
            },
            Pattern::Call { name, args, config } => {
                self.grammar_call(world, host, gram, name, args, config, scope, pattern.span)
                return scope
            },
            else => return scope,
        }
    }

    /// A bound or a guard: a value whose type the grammar fixes, so the help
    /// says what to write rather than which declaration to change.
    ///
    /// **It reads the labels, it does not take them** (#1050): the engine
    /// runs it as a closure below the alternative, whose action reads the
    /// labels after it, so a label handed to a parameter that keeps it is
    /// `NK2105`, as it is inside a lambda.
    fn grammar_fixed[H: CheckHost](ref mut self, world: ref CheckWorld, host: ref H, value: ref Expr, want: Ty, scope: ref Vec[CheckLocal], span: ref Span, what: ref String, help: String) sync {
        self.scope.push(scope.clone())
        let mut word: String = "bound"
        if what == "A guard" {
            word = "guard"
        }
        self.repeats.push(CheckRepeats { frame: self.scope.len() as i64, what: word, revived: collections::BTreeSet(), revived_parts: collections::BTreeSet(), leaves: false, opened: -1, held: [] })
        let found = check_core_expr(self, world, host, value, span)
        self.repeats.pop()
        self.scope.pop()
        if found.is_unknown() || found.text() == want.text() {
            return
        }
        self.findings.push(check_refusal("NK1102", span, spoken_in(f"{what} here is `{found.text()}`, but it has to be `{want.text()}`.", found, want), [], shown_in(help, found, want)))
    }

    /// **Whether a rule's value is lent** (ADR-grammar-1 D6): written plain or
    /// `ref`, neither `mut` nor `keep`, and of a type a word does not hold
    /// (ADR-279 D8), which is copied as a function's is.
    pub fn a_lent_rule_value[H: CheckHost](ref self, world: ref CheckWorld, host: ref H, arg: ref FnArg) -> bool sync {
        if arg.mutable || arg.keep || arg.ty.code != null {
            return false
        }
        let ty = host.type_of(arg.ty)
        return !ty.is_unknown() && !self.a_word_by_its_kind(world, ty.owned())
    }

    /// One value, typed in the scope it stands in, against what it must be.
    /// **A lent value takes a view as well** (ADR-grammar-1 D6): the rule
    /// reads what it is handed, as a function's lent parameter does.
    fn grammar_value[H: CheckHost](ref mut self, world: ref CheckWorld, host: ref H, value: ref Expr, want: Ty, lent: bool, scope: ref Vec[CheckLocal], span: ref Span, what: ref String) sync {
        self.scope.push(scope.clone())
        let mut found = check_core_expr(self, world, host, value, span)
        self.scope.pop()
        let mut wanted = want
        if lent {
            found = found.owned()
            wanted = wanted.owned()
        }
        self.expect_type(world, found, wanted, span, "argument", fn(was, wanted) { f"{what} here is `{was}`, but it has to be `{wanted}`." })
    }

    /// **A rule of the grammar handed values** (ADR-grammar-1 D2), checked as
    /// a function's call is: one value per parameter before the `;`, an
    /// option by a name the rule declares, each of its type.
    fn grammar_call[H: CheckHost](ref mut self, world: ref CheckWorld, host: ref H, gram: ref GrammarDef, name: winnow_grammar::Symbol, args: ref Vec[Expr], config: ref Vec[ConfigArg], scope: ref Vec[CheckLocal], span: ref Span) sync {
        let called = world.words.resolve(name).clone()
        let grammar_name = world.words.resolve(gram.name).clone()
        for rule in gram.rules {
            if rule.name != name {
                continue
            }
            if args.len() != rule.args.len() {
                self.findings.push(check_refusal("NK1101", span, f"`{called}` takes {counted(rule.args.len() as i64, "value")} before the `;`, but you passed {args.len()}.", ["A rule takes its values as a function takes its arguments (ADR-grammar-1 D2)."], "Give one value for each, by position; an option goes after the `;` by name."))
            }
            for i in 0..<args.len() {
                if i < rule.args.len() {
                    let want = host.type_of(rule.args[i].ty)
                    let what = f"The value for `{world.words.resolve(rule.args[i].name)}`"
                    let lent = self.a_lent_rule_value(world, host, rule.args[i])
                    self.grammar_value(world, host, args[i], want, lent, scope, span, what)
                }
            }
            for given in config {
                let option = world.words.resolve(given.name).clone()
                let mut found = false
                for declared in rule.config {
                    if declared.name == given.name {
                        found = true
                        let what = f"The option `{option}`"
                        self.grammar_value(world, host, given.value, host.type_of(declared.ty), false, scope, span, what)
                    }
                }
                if !found {
                    self.findings.push(check_refusal("NK1109", span, f"`{called}` has no option called `{option}`.", [f"It is a rule of grammar `{grammar_name}`; its options are what it declares after its `;`."], "Name an option the rule declares, or declare it."))
                }
            }
            return
        }
        self.findings.push(check_refusal("NK1171", span, f"Grammar `{grammar_name}` has no rule called `{called}`.", ["A name called with values is a rule of the grammar; the built-ins that take patterns are Part II 10.8's."], "Declare the rule, or call one the grammar has."))
    }
}

/// **The rules a pattern calls**: a rule of the grammar referred to, called
/// with values or folded, through every element that holds a pattern.
fn grammar_called_rules(world: ref CheckWorld, pattern: ref Pattern, rules: ref collections::BTreeSet[String], mut out: collections::BTreeSet[String]) sync {
    match pattern {
        Pattern::Seq(parts) => {
            for part in parts {
                grammar_called_rules(world, part.node, rules, out)
            }
        },
        Pattern::Choice(parts) => {
            for part in parts {
                grammar_called_rules(world, part.node, rules, out)
            }
        },
        Pattern::Bind { pat, .. } => grammar_called_rules(world, pat.node, rules, out),
        Pattern::Repeat { pat, .. } => grammar_called_rules(world, pat.node, rules, out),
        Pattern::Counted { pat, .. } => grammar_called_rules(world, pat.node, rules, out),
        Pattern::Group(inner) => grammar_called_rules(world, inner.node, rules, out),
        Pattern::Ref { name, args, .. } => {
            let called = world.words.resolve(name).clone()
            if rules.contains(called) {
                out.insert(called)
            }
            for arg in args {
                grammar_called_rules(world, arg.node, rules, out)
            }
        },
        Pattern::Call { name, .. } => {
            let called = world.words.resolve(name).clone()
            if rules.contains(called) {
                out.insert(called)
            }
        },
        Pattern::Fold(spec) => {
            let called = world.words.resolve(spec.rule).clone()
            if rules.contains(called) {
                out.insert(called)
            }
        },
        Pattern::Choose { arms, .. } => {
            for arm in arms {
                for alt in arm.alts {
                    grammar_called_rules(world, alt.pattern.node, rules, out)
                }
            }
        },
        Pattern::Members { key, sep, .. } => {
            grammar_called_rules(world, key.node, rules, out)
            grammar_called_rules(world, sep.node, rules, out)
        },
        else => {},
    }
}

/// **The rules each `@stream` entry reaches** (ADR-grammar-2 D7, amended
/// 2026-11-18, #2061), the entry with them: a rule's name and the item type
/// of the first entry, in the grammar's order, that reaches it.
fn grammar_streamed_rules(world: ref CheckWorld, gram: ref GrammarDef, results: ref collections::BTreeMap[String, Ty], rules: ref collections::BTreeSet[String]) -> collections::BTreeMap[String, Ty] sync {
    let mut out: collections::BTreeMap[String, Ty] = collections::BTreeMap()
    for rule in gram.rules {
        if rule.stream && rule.is_entry {
            let entry = world.words.resolve(rule.name).clone()
            let item: Ty = results[entry]?.clone() ?? Ty::Unknown
            for reached in grammar_reached_from(world, gram, entry, rules) {
                if !out.contains_key(reached) {
                    out.insert(reached.clone(), item.clone())
                }
            }
        }
    }
    return out
}

/// The rules reached from `start`, `start` among them.
fn grammar_reached_from(world: ref CheckWorld, gram: ref GrammarDef, start: ref String, rules: ref collections::BTreeSet[String]) -> collections::BTreeSet[String] sync {
    let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
    let mut todo: Vec[String] = [start.clone()]
    while todo.len() > 0 {
        let next = todo.pop() ?? break
        if seen.contains(next) {
            continue
        }
        seen.insert(next.clone())
        for rule in gram.rules {
            if world.words.resolve(rule.name) == next {
                let mut called: collections::BTreeSet[String] = collections::BTreeSet()
                for alt in rule.alts {
                    grammar_called_rules(world, alt.pattern.node, rules, called)
                }
                for one in called {
                    if !seen.contains(one) {
                        todo.push(one.clone())
                    }
                }
            }
        }
    }
    return seen
}

/// The spans of the `emit` statements in a block, through the blocks nested
/// in its statements.
fn grammar_emits_in(block: ref Block, mut out: Vec[Span]) sync {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Emit(_) => out.push(stmt.span.clone()),
            else => {},
        }
        for inner in check_visit_stmt_blocks(stmt.node) {
            grammar_emits_in(inner, out)
        }
    }
}

/// Whether one of a rule's actions holds an `emit`.
fn grammar_rule_emits(rule: ref GrammarRule) -> bool sync {
    for alt in rule.alts {
        let action = alt.action?.clone() ?? continue
        let mut found: Vec[Span] = []
        grammar_emits_in(action, found)
        if found.len() > 0 {
            return true
        }
    }
    return false
}

/// Whether some rule `entry` reaches hands over its items with `emit`: then
/// the entry states no repetition of its own (`NK1349` asks none).
fn grammar_entry_emits(world: ref CheckWorld, gram: ref GrammarDef, entry: ref String, rules: ref collections::BTreeSet[String]) -> bool sync {
    let reached = grammar_reached_from(world, gram, entry, rules)
    for rule in gram.rules {
        if reached.contains(world.words.resolve(rule.name)) && grammar_rule_emits(rule) {
            return true
        }
    }
    return false
}

/// **What a pattern does to an `emit` run inside a call it holds**: the call
/// is not in it (`Absent`), a choice it holds is tried after the call ran
/// (`Undone`, with that choice said), or neither, and whether a failure at or
/// after the call can leave the pattern (`Passed`).
enum GrammarUndo {
    Absent,
    Undone(String),
    Passed(bool),
}

/// Whether a pattern can fail: a `*` or `?` repetition, a cut, and what holds
/// only those cannot; anything else may.
fn grammar_can_fail(pattern: ref Pattern) -> bool sync {
    return match pattern {
        Pattern::Repeat { rep, .. } => rep != Repeat::Star && rep != Repeat::Optional,
        Pattern::Cut => false,
        Pattern::Group(inner) => grammar_can_fail(inner.node),
        Pattern::Bind { pat, .. } => grammar_can_fail(pat.node),
        Pattern::Seq(parts) => parts.iter().any(fn(part) { grammar_can_fail(part.node) }),
        Pattern::Choice(parts) => parts.iter().all(fn(part) { grammar_can_fail(part.node) }),
        else => true,
    }
}

/// The text a pattern is written as, for a message: its first characters.
fn grammar_undo_said(world: ref CheckWorld, rule: ref String, what: ref String) -> String sync {
    return f"{what} in rule `{rule}`"
}

/// **The calls of `target` in a pattern, and what stands around them**
/// (ADR-grammar-2 D7, amended 2026-11-18): `failing` says whether the call
/// itself fails after the `emit` ran (the rule it is in gave up after it).
/// A sequence lets a failure out unless a cut stands before the call; a
/// choice that has an option left, a repetition that may stop short and a
/// lookahead undo what ran inside them.
fn grammar_undo_in(world: ref CheckWorld, pattern: ref Pattern, target: ref String, failing: bool, rule: ref String) -> GrammarUndo sync {
    match pattern {
        Pattern::Seq(parts) => {
            let mut found = false
            let mut out = false
            let mut cut = false
            for i in 0..<parts.len() {
                match parts[i].node {
                    Pattern::Cut => { cut = true },
                    else => {},
                }
                match grammar_undo_in(world, parts[i].node, target, failing, rule) {
                    GrammarUndo::Absent => {},
                    GrammarUndo::Undone(said) => return GrammarUndo::Undone(said),
                    GrammarUndo::Passed(inner) => {
                        found = true
                        if !cut {
                            let mut after = inner
                            let mut j = i + 1
                            while j < parts.len() {
                                match parts[j].node {
                                    Pattern::Cut => break,
                                    else => {},
                                }
                                if grammar_can_fail(parts[j].node) {
                                    after = true
                                }
                                j += 1
                            }
                            out = out || after
                        }
                    },
                }
            }
            return if found { GrammarUndo::Passed(out) } else { GrammarUndo::Absent }
        },
        Pattern::Choice(options) => {
            let mut found = false
            let mut out = false
            for k in 0..<options.len() {
                match grammar_undo_in(world, options[k].node, target, failing, rule) {
                    GrammarUndo::Absent => {},
                    GrammarUndo::Undone(said) => return GrammarUndo::Undone(said),
                    GrammarUndo::Passed(inner) => {
                        if inner && k + 1 < options.len() {
                            return GrammarUndo::Undone(grammar_undo_said(world, rule, f"option {k + 2} of a choice"))
                        }
                        found = true
                        out = out || inner
                    },
                }
            }
            return if found { GrammarUndo::Passed(out) } else { GrammarUndo::Absent }
        },
        Pattern::Group(inner) => return grammar_undo_in(world, inner.node, target, failing, rule),
        Pattern::Bind { pat, .. } => return grammar_undo_in(world, pat.node, target, failing, rule),
        Pattern::Repeat { pat, rep } => {
            let inner = grammar_undo_in(world, pat.node, target, failing, rule)
            return match inner {
                GrammarUndo::Passed(out) => match rep {
                    Repeat::Exactly(_) => GrammarUndo::Passed(out),
                    else => if out { GrammarUndo::Undone(grammar_undo_said(world, rule, "the end of a repetition")) } else { GrammarUndo::Passed(false) },
                },
                else => inner,
            }
        },
        Pattern::Counted { pat, .. } => return grammar_undo_repeated(world, grammar_undo_in(world, pat.node, target, failing, rule), rule),
        Pattern::Members { key, sep, .. } => {
            let keyed = grammar_undo_repeated(world, grammar_undo_in(world, key.node, target, failing, rule), rule)
            return match keyed {
                GrammarUndo::Absent => grammar_undo_repeated(world, grammar_undo_in(world, sep.node, target, failing, rule), rule),
                else => keyed,
            }
        },
        Pattern::Fold(spec) => {
            if world.words.resolve(spec.rule) != target {
                return GrammarUndo::Absent
            }
            return grammar_undo_repeated(world, GrammarUndo::Passed(failing), rule)
        },
        Pattern::Call { name, .. } => return if world.words.resolve(name) == target { GrammarUndo::Passed(failing) } else { GrammarUndo::Absent },
        Pattern::Ref { name, args, .. } => {
            let called = world.words.resolve(name).clone()
            if called == target {
                return GrammarUndo::Passed(failing)
            }
            let mut found = false
            let mut out = false
            for arg in args {
                match grammar_undo_in(world, arg.node, target, failing, rule) {
                    GrammarUndo::Absent => {},
                    GrammarUndo::Undone(said) => return GrammarUndo::Undone(said),
                    GrammarUndo::Passed(inner) => {
                        found = true
                        out = out || inner
                    },
                }
            }
            if !found {
                return GrammarUndo::Absent
            }
            // A lookahead goes back to where it started, whatever it
            // matched; a list is a repetition.
            if called == "peek" || called == "not" {
                return GrammarUndo::Undone(grammar_undo_said(world, rule, f"the lookahead `{called}(..)`"))
            }
            if called == "list" {
                return grammar_undo_repeated(world, GrammarUndo::Passed(out), rule)
            }
            return GrammarUndo::Passed(out)
        },
        Pattern::Choose { arms, .. } => {
            let mut found = false
            let mut out = false
            for arm in arms {
                for k in 0..<arm.alts.len() {
                    match grammar_undo_in(world, arm.alts[k].pattern.node, target, failing, rule) {
                        GrammarUndo::Absent => {},
                        GrammarUndo::Undone(said) => return GrammarUndo::Undone(said),
                        GrammarUndo::Passed(inner) => {
                            if inner && k + 1 < arm.alts.len() {
                                return GrammarUndo::Undone(grammar_undo_said(world, rule, f"alternative {k + 2} of a `choose` arm"))
                            }
                            found = true
                            out = out || inner
                        },
                    }
                }
            }
            return if found { GrammarUndo::Passed(out) } else { GrammarUndo::Absent }
        },
        else => return GrammarUndo::Absent,
    }
}

/// A repetition that may stop short, around what a call did: undone where a
/// failure leaves the item.
fn grammar_undo_repeated(world: ref CheckWorld, inner: GrammarUndo, rule: ref String) -> GrammarUndo sync {
    return match inner {
        GrammarUndo::Passed(out) => if out { GrammarUndo::Undone(grammar_undo_said(world, rule, "the end of a repetition")) } else { GrammarUndo::Passed(false) },
        else => inner,
    }
}

/// **What could undo an `emit` in rule `target`'s action**, from the rules
/// that call it up to the `@stream` entries (ADR-grammar-2 D7, amended
/// 2026-11-18): the first choice that is still tried after the call has
/// run, or `null` where every way up is committed or ends the parse.
/// `failing` says whether `target` gives up after the `emit`; `seen` holds
/// the rules asked already, by failing or not.
fn grammar_undone_from(world: ref CheckWorld, gram: ref GrammarDef, target: ref String, failing: bool, streamed: ref collections::BTreeMap[String, Ty], mut seen: collections::BTreeSet[String]) -> String? sync {
    let key = f"{target}/{failing}"
    if seen.contains(key) {
        return null
    }
    seen.insert(key)
    for rule in gram.rules {
        let name = world.words.resolve(rule.name).clone()
        if !streamed.contains_key(name) {
            continue
        }
        let mut found = false
        let mut out = false
        for j in 0..<rule.alts.len() {
            match grammar_undo_in(world, rule.alts[j].pattern.node, target, failing, name) {
                GrammarUndo::Absent => {},
                GrammarUndo::Undone(said) => return said,
                GrammarUndo::Passed(inner) => {
                    if inner && j + 1 < rule.alts.len() {
                        return grammar_undo_said(world, name, f"alternative {j + 2}")
                    }
                    found = true
                    out = out || inner
                },
            }
        }
        if found && !(rule.stream && rule.is_entry) {
            match grammar_undone_from(world, gram, name, out, streamed, seen) {
                said => return said,
                null => {},
            }
        }
    }
    return null
}

/// **`NK1370`: an `emit` the parse could still undo** (ADR-grammar-2 D7,
/// amended 2026-11-18, #2061): one finding per `emit` in the action of a
/// rule a `@stream` entry reaches, where a choice around the rule can still
/// be tried after the action ran. An alternative of the rule itself after
/// the one whose action emits is no such choice: the action runs once its
/// pattern has matched, and the rule does not try another after it.
fn grammar_emits_undone(world: ref CheckWorld, gram: ref GrammarDef, streamed: ref collections::BTreeMap[String, Ty]) -> Vec[CheckFinding] sync {
    let mut out: Vec[CheckFinding] = []
    for rule in gram.rules {
        let name = world.words.resolve(rule.name).clone()
        if !streamed.contains_key(name) {
            continue
        }
        let mut emits: Vec[Span] = []
        for alt in rule.alts {
            let action = alt.action?.clone() ?? continue
            grammar_emits_in(action, emits)
        }
        if emits.len() == 0 {
            continue
        }
        let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
        let undone = grammar_undone_from(world, gram, name, false, streamed, seen) ?? continue
        for at in emits {
            let notes: Vec[String] = [f"The item goes to the caller's walk when the action runs (ADR-grammar-2 D7): if what follows the call of `{name}` fails, the parse goes back and tries {undone}, and the item is already handed over. The compiler does not hold items back to hide that."]
            out.push(check_refusal("NK1370", at, f"This `emit` in rule `{name}` could be undone: {undone} can still be tried after it runs.", notes, "Commit before the call: a cut `=>` in front of it, or the choice made before it, so that the parse cannot go back past the `emit`."))
        }
    }
    return out
}
