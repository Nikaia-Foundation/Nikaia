// crates/nikaia-std/src/compiler/prove_terms.nika
//
// **An expression as a term of the proof** (ADR-269 D7, ADR-270), moved from
// the compiler's `prove` (ADR-294, #436 step 4): a whole number as a linear
// term, and a claim as a formula over them, where they are ones the prover
// reads.
//
// **The terms are built into the prover's arena.** Each node is appended to
// `out` - `prover_arena.nika`'s nodes - in the order it is made, its children
// named by their place in `out`: the same terms in the same order the Rust
// made them.

use logic

/// **A value a `let mut` or an assignment gives, as a term** (ADR-361 D13,
/// #1848): a `bool` name is a number to the walk, `true` 1 and `false` 0, so a
/// flag a loop sets is a state name like a counter. `lin_term` itself reads
/// numbers only: the ledgers and the summaries read it too.
fn value_term(expr: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[logic::SolverTerm]) -> i64? {
    return match expr {
        Expr::LitBool(b, _) => built(logic::SolverTerm::Int(if b { 1 } else { 0 }), out),
        else => lin_term(expr, words, var, pinned, out),
    }
}

/// `expr` as a linear term over the names `var` admits: the node's place in
/// `out`, or nothing where it is not one. A product is linear where one side
/// is a constant. A name or a call `pinned` gives a value the build knows is
/// that value: a `comptime` binding (ADR-359 D7), a call run while the
/// program was built (D11).
fn lin_term(expr: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[logic::SolverTerm]) -> i64? {
    let mut calls: Vec[i64] = []
    return lin_term_in(expr, words, var, pinned, out, false, calls)
}

/// **An operation's goal reads each method result as a fresh variable, one
/// per call** (ADR-270 D29, #1972): `expr` as [`lin_term`] reads it, where a
/// method call it reads no whole number of, `asked.length()`, is a variable
/// named by the call's id, never by its text, so two calls are two values.
/// Each such variable's node goes into `calls`, for the caller to bound by
/// the operation's type: an operand of a `+`, `-` or `*` has the type of
/// the operation, and a call under a conversion, of another type, is none.
fn goal_term(expr: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[logic::SolverTerm], mut calls: Vec[i64]) -> i64? {
    return lin_term_in(expr, words, var, pinned, out, true, calls)
}

/// [`lin_term`], and with `fresh` [`goal_term`].
fn lin_term_in(expr: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[logic::SolverTerm], fresh: bool, mut calls: Vec[i64]) -> i64? {
    return match expr {
        // A literal no `i64` holds is outside what the solver reads.
        Expr::LitInt { value, negative, .. } => {
            let n = literal_value(value, negative) ?? return null
            built(logic::SolverTerm::Int(n), out)
        },
        Expr::Variable(name, _) => {
            let text = words.resolve(name)
            if !var(text) {
                let known = pinned(text) ?? return null
                return built(logic::SolverTerm::Int(known), out)
            }
            built(logic::SolverTerm::Var(text.clone()), out)
        },
        // `xs.len()` of a list that does not change is a variable of its own.
        Expr::MethodCall { receiver, method, args, .. } => {
            if args.is_empty() && words.resolve(method) == "len" {
                // **A literal's length is its bytes** (ADR-396 D4):
                // `"\n".len()` is 1.
                let counted = text_literal_length(receiver)
                if counted != null {
                    return built(logic::SolverTerm::Int(counted ?? 0), out)
                }
                // A path of fields counts as a name does (ADR-306 D17).
                let length = length_path(receiver, words, var)
                if length != null {
                    return built(logic::SolverTerm::Var(length ?? String()), out)
                }
            }
            if !fresh {
                return null
            }
            let result = built(logic::SolverTerm::Var(f"call@{node_key(expr)}"), out)
            calls.push(result)
            result
        },
        // **A path of fields from a name** (ADR-306 D17, ADR-269 D9): `p.end`
        // is a name of its own where the walk made it one.
        Expr::Field { .. } => {
            let path = path_of(expr, words) ?? return null
            if !var(path) {
                return null
            }
            built(logic::SolverTerm::Var(path), out)
        },
        // **One element of a list** (ADR-306 D33): `xs[c]` of a list that is
        // a path, indexed by a name or a literal, is a name of its own where
        // the walk made it one, keyed as D20's element paths are.
        Expr::Index { .. } => {
            let element = element_name(expr, words) ?? return null
            if !var(element) {
                return null
            }
            built(logic::SolverTerm::Var(element), out)
        },
        // **A call's result**, where the walk made it a name of its own
        // (`call_result_name`, ADR-314 D3).
        Expr::Call { .. } => {
            let name = call_result_name(expr)
            let ran = pinned(name)
            if ran != null {
                return built(logic::SolverTerm::Int(ran ?? 0), out)
            }
            if !var(name) {
                return null
            }
            built(logic::SolverTerm::Var(name), out)
        },
        Expr::Unary { op, expr, .. } => {
            if op != UnaryOp::Neg {
                return null
            }
            let a = lin_term_in(expr, words, var, pinned, out, fresh, calls) ?? return null
            built(logic::SolverTerm::Neg(a), out)
        },
        // **A conversion into a whole number keeps the value or stops the
        // program** (Part III A.2), so where it goes on the number is the one
        // converted: `c as i32` over a name `var` admits is that name
        // (ADR-314 D3's `result == c as i32 - 48`).
        Expr::Cast { expr, ty, .. } => {
            if !ty.generics.is_empty() || !is_whole_number(words.resolve(ty.name)) {
                return null
            }
            lin_term_in(expr, words, var, pinned, out, false, calls)
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            let l = lin_term_in(lhs, words, var, pinned, out, fresh, calls) ?? return null
            let r = lin_term_in(rhs, words, var, pinned, out, fresh, calls) ?? return null
            match op {
                BinaryOp::Add => built(logic::SolverTerm::Add(l, r), out),
                BinaryOp::Sub => built(logic::SolverTerm::Sub(l, r), out),
                BinaryOp::Mul => {
                    if constant_at(l, out) == null && constant_at(r, out) == null {
                        return null
                    }
                    built(logic::SolverTerm::Mul(l, r), out)
                },
                // **A quotient or a remainder of two known numbers is its
                // value** (ADR-359 D5), as Part I 2.2 folds it: truncated
                // toward zero. A division by zero or past the type's range
                // stops the program, and is no number here. **By a positive
                // constant**, a quotient is a term of its own, truncated
                // toward zero, and `e % k` is `e - k·(e / k)`.
                BinaryOp::Div => {
                    let y = constant_at(r, out) ?? pinned(divisor_name(rhs)) ?? return null
                    let known = constant_at(l, out)
                    if known != null {
                        let q = (known ?? 0).checked_div(y) ?? return null
                        return built(logic::SolverTerm::Int(q), out)
                    }
                    if y <= 0 {
                        return null
                    }
                    built(logic::SolverTerm::Quot(l, y), out)
                },
                BinaryOp::Rem => {
                    let y = constant_at(r, out) ?? pinned(divisor_name(rhs)) ?? return null
                    let known = constant_at(l, out)
                    if known != null {
                        let m = (known ?? 0).checked_rem(y) ?? return null
                        return built(logic::SolverTerm::Int(m), out)
                    }
                    if y <= 0 {
                        return null
                    }
                    let q = built(logic::SolverTerm::Quot(l, y), out)
                    let k = built(logic::SolverTerm::Int(y), out)
                    let kq = built(logic::SolverTerm::Mul(k, q), out)
                    built(logic::SolverTerm::Sub(l, kq), out)
                },
                else => null,
            }
        },
        else => null,
    }
}

/// **The bytes a text literal stands for**, its escapes read (Part I 2.5):
/// nothing where `expr` is no literal, or holds a `\x` or `\u{…}`.
fn text_literal_length(expr: ref Expr) -> i64? {
    let text = match expr {
        Expr::LitStr { text, .. } => text,
        else => return null,
    }
    let mut escapes = 0
    let mut escaped = false
    for c in text.scalars {
        if escaped {
            if c == 'x' || c == 'u' {
                return null
            }
            escaped = false
        } else if c == '\\' {
            escaped = true
            escapes += 1
        }
    }
    return text.len() - escapes
}

/// **The name of a length the walk reads**: a path's (ADR-306 D17), or for
/// the `.bytes` of a text, the text's: `s.bytes.len() == s.len()`
/// (supervisor decision, 2026-11-12, for ADR-396 D4).
fn length_path(list: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync) -> String? {
    let path = path_of(list, words) ?? return null
    let length = f"{path}.len()"
    if var(length) {
        return length
    }
    match list {
        Expr::Field { base, name, .. } => {
            if words.resolve(name) != "bytes" {
                return null
            }
            let text = path_of(base, words) ?? return null
            let counted = f"{text}.len()"
            if var(counted) {
                return counted
            }
            return null
        },
        else => return null,
    }
}

/// **The name of one element** (ADR-306 D33, D20): `xs[c]` or `t.slots[0]`,
/// the list a path, the index a name or an integer literal that is not
/// negative; nothing for any other index or list.
fn element_name(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match expr {
        Expr::Index { base, index, .. } => {
            let list = path_of(base, words) ?? return null
            let at = element_index(index, words) ?? return null
            f"{list}[{at}]"
        },
        else => null,
    }
}

/// An element's index as its name says it: a name, or the digits of an
/// integer literal that is not negative.
fn element_index(index: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match index {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        Expr::LitInt { value, negative, .. } => {
            if negative {
                return null
            }
            let n = literal_value(value, negative) ?? return null
            f"{n}"
        },
        else => null,
    }
}

/// **The name a divisor what is known pins has** (ADR-359 D6): by the
/// divisor's id, in a form no binding can spell.
fn divisor_name(divisor: ref Expr) -> String {
    return f"divisor@{node_key(divisor)}"
}

/// **The name a call's result has in the proof**: the call's id (ADR-340),
/// in a form no binding of a program can spell.
fn call_result_name(call: ref Expr) -> String {
    return f"result@{node_key(call)}"
}

/// **The name a named property has in the proof** (ADR-381 D1): `p(xs)`, a
/// call by name whose arguments are paths of fields, is `xs.prop@p()`, and
/// `p(xs, n)` is `xs.prop@p(n)`; the method form `xs.m(n)` is
/// `xs.prop@.m(n)`. Keyed under its first argument's path, it goes where
/// the path goes (ADR-306 D17): bound again, the argument takes it along
/// (`ProverScope::rebind`), and a call hands it on as it hands on
/// `xs.len()` (`given_paths`); a change to any other argument drops it
/// (`property_args`). Whether the callee is one (a `bool` that changes
/// nothing) the walk decides where it makes the name.
fn property_name(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match expr {
        Expr::Call { func, args, config, .. } => {
            if args.is_empty() || !config.is_empty() {
                return null
            }
            let callee = match func {
                Expr::Variable(name, _) => words.resolve(name).clone(),
                Expr::Path(segments, _) => path_text(segments, words),
                else => return null,
            }
            let on = path_of(args[0], words) ?? return null
            let rest = property_paths(args, 1, words) ?? return null
            f"{on}.{property_mark()}{callee}({rest})"
        },
        Expr::MethodCall { receiver, method, args, config, .. } => {
            if !config.is_empty() {
                return null
            }
            let on = path_of(receiver, words) ?? return null
            let rest = property_paths(args, 0, words) ?? return null
            f"{on}.{property_mark()}.{words.resolve(method)}({rest})"
        },
        else => null,
    }
}

/// A path's segments as written, joined by `::`: the callee of a property
/// of `std`, `html::is_plain` (ADR-381 D5).
fn path_text(segments: ref Vec[winnow_grammar::Symbol], words: ref winnow_grammar::InternerContext) -> String {
    let parts: Vec[String] = segments.iter().map(fn(segment) { words.resolve(segment).clone() }).collect()
    return parts.join("::")
}

/// The paths of `args` from the one at `from`, as a property's name lists
/// them after its first (ADR-381 D1): nothing where one is not a path of
/// fields.
fn property_paths(args: ref Vec[Expr], from: i64, words: ref winnow_grammar::InternerContext) -> String? {
    let mut paths: Vec[String] = []
    for (i, arg) in args.iter().enumerate() {
        if i >= from {
            paths.push(path_of(arg, words) ?? return null)
        }
    }
    return paths.join(", ")
}

/// What a property's name holds after its argument's path (ADR-381 D1): a
/// form no binding or field of a program can spell.
fn property_mark() -> String {
    return "prop@"
}

/// **The path a property's name is keyed under** (ADR-381 D1), where `name`
/// is one: `xs` of `xs.prop@p()`.
fn property_base(name: ref String) -> String? {
    let at = name.find(f".{property_mark()}") ?? return null
    return name[0..<at].clone()
}

/// What follows a property's mark: `p()`, `p(n)`, `.m(n)`.
fn property_called(name: ref String) -> String? {
    let on = property_base(name) ?? return null
    return (name.strip_prefix(f"{on}.{property_mark()}") ?? return null).clone()
}

/// **Every path a property reads** (ADR-381 D1): its first argument's, or
/// its receiver's, and each other argument's, so a change to any one drops
/// it. Nothing where `name` is no property.
fn property_args(name: ref String) -> Vec[String] {
    let on = property_base(name) ?? return []
    let mut paths: Vec[String] = [on.clone()]
    let called = property_called(name) ?? return paths
    let inner = property_inner(called) ?? return paths
    if inner.is_empty() {
        return paths
    }
    for part in inner.split(", ") {
        paths.push(part.clone())
    }
    return paths
}

/// Whether the property `name` reads `path` or a part of it among its
/// other arguments: `n` of `xs.prop@p(n)`, `t` of `xs.prop@p(t.k)`.
fn property_reads(name: ref String, path: ref String) -> bool {
    let all = property_args(name)
    for (i, arg) in all.iter().enumerate() {
        if i > 0 && (arg == path || arg.starts_with(f"{path}.")) {
            return true
        }
    }
    return false
}

/// **Whether a property goes to a caller** (ADR-381 D3): one call by name
/// of one argument, whose parameter the call's argument takes the place of.
/// One with more arguments, or in method form, is known where it stands,
/// not carried as a precondition or a postcondition.
fn property_carried(name: ref String) -> bool {
    let called = property_called(name) ?? return false
    return !called.starts_with(".") && called.ends_with("()")
}

/// The other arguments' paths of what follows a property's mark: `n` of
/// `p(n)`, empty of `p()`.
fn property_inner(called: ref String) -> String? {
    let open = called.find("(") ?? return null
    let tail = called[open..<called.len()]
    let inner = tail.strip_prefix("(") ?? return null
    return (inner.strip_suffix(")") ?? return null).clone()
}

/// **A name as the program writes it** (ADR-381 D1): a property's
/// `xs.prop@p(n)` is the call `p(xs, n)`, `xs.prop@.m(n)` is `xs.m(n)`; any
/// other name is itself.
fn property_shown(name: ref String) -> String {
    let on = property_base(name) ?? return name.clone()
    let called = property_called(name) ?? return name.clone()
    if called.starts_with(".") {
        return f"{on}{called}"
    }
    let open = called.find("(") ?? return name.clone()
    let callee = called[0..<open].clone()
    let inner = property_inner(called) ?? ""
    if inner.is_empty() {
        return f"{callee}({on})"
    }
    return f"{callee}({on}, {inner})"
}

/// The claim `expr` as a formula over [`lin_term`]s, where it is one this
/// prover reads.
pub fn claim_term(expr: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[logic::SolverTerm]) -> i64? {
    return match expr {
        Expr::LitBool(b, _) => built(logic::SolverTerm::Bool(b), out),
        // **A `bool` name the walk follows is a number** (ADR-361 D13):
        // `true` is 1, so the claim is that it is at least 1 (#1848).
        Expr::Variable(name, _) => {
            let n = words.resolve(name)
            if !var(n) {
                return null
            }
            let named = built(logic::SolverTerm::Var(n.clone()), out)
            let one = built(logic::SolverTerm::Int(1), out)
            built(logic::SolverTerm::Ge(named, one), out)
        },
        // **A named property is a fact of its own** (ADR-381 D1): `p(xs)`,
        // where the walk made `property_name` a name, is that name `== 1`.
        Expr::Call { .. } => {
            let name = property_name(expr, words) ?? return null
            if !var(name) {
                return null
            }
            let named = built(logic::SolverTerm::Var(name), out)
            let one = built(logic::SolverTerm::Int(1), out)
            built(logic::SolverTerm::Eq(named, one), out)
        },
        // **`xs.is_empty()` is `xs.len() == 0`** (#1576), where the length is
        // a name of its own as `lin_term` reads it; any other method is a
        // named property where the walk made it one (ADR-381 D1).
        Expr::MethodCall { receiver, method, args, .. } => {
            if !args.is_empty() || words.resolve(method) != "is_empty" {
                let name = property_name(expr, words) ?? return null
                if !var(name) {
                    return null
                }
                let named = built(logic::SolverTerm::Var(name), out)
                let one = built(logic::SolverTerm::Int(1), out)
                return built(logic::SolverTerm::Eq(named, one), out)
            }
            let length = length_path(receiver, words, var) ?? return null
            let counted = built(logic::SolverTerm::Var(length), out)
            let zero = built(logic::SolverTerm::Int(0), out)
            built(logic::SolverTerm::Eq(counted, zero), out)
        },
        Expr::Unary { op, expr, .. } => {
            if op != UnaryOp::Not {
                return null
            }
            let a = claim_term(expr, words, var, pinned, out) ?? return null
            built(logic::SolverTerm::Not(a), out)
        },
        Expr::Binary { op, lhs, rhs, .. } => match op {
            BinaryOp::And => {
                let l = claim_term(lhs, words, var, pinned, out) ?? return null
                let r = claim_term(rhs, words, var, pinned, out) ?? return null
                built(logic::SolverTerm::And([l, r]), out)
            },
            BinaryOp::Or => {
                let l = claim_term(lhs, words, var, pinned, out) ?? return null
                let r = claim_term(rhs, words, var, pinned, out) ?? return null
                built(logic::SolverTerm::Or([l, r]), out)
            },
            BinaryOp::Lt => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Le => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Gt => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Ge => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Eq => compared(op, lhs, rhs, words, var, pinned, out),
            BinaryOp::Ne => compared(op, lhs, rhs, words, var, pinned, out),
            else => null,
        },
        else => null,
    }
}

/// **What a condition the prover cannot read whole still says** (#1576):
/// where it holds (`holds`), each part of an `&&` it reads holds; where it
/// fails, each part of an `||` it reads fails; a `!` swaps the two.
/// `return 0 if key != "exit" || args.len() == 0` leaves `args.len() != 0`.
fn claim_parts(expr: ref Expr, holds: bool, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[logic::SolverTerm]) -> Vec[i64] {
    let mut parts: Vec[i64] = []
    claim_parts_into(expr, holds, words, var, pinned, out, parts)
    return parts
}

fn claim_parts_into(expr: ref Expr, holds: bool, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[logic::SolverTerm], mut parts: Vec[i64]) {
    match expr {
        Expr::Unary { op, expr, .. } => {
            if op == UnaryOp::Not {
                claim_parts_into(expr, !holds, words, var, pinned, out, parts)
                return
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            if (op == BinaryOp::And && holds) || (op == BinaryOp::Or && !holds) {
                claim_parts_into(lhs, holds, words, var, pinned, out, parts)
                claim_parts_into(rhs, holds, words, var, pinned, out, parts)
                return
            }
        },
        else => {},
    }
    let part = claim_term(expr, words, var, pinned, out) ?? return
    if holds {
        parts.push(part)
    } else {
        parts.push(built(logic::SolverTerm::Not(part), out))
    }
}

/// A comparison of two linear terms.
fn compared(op: BinaryOp, lhs: ref Expr, rhs: ref Expr, words: ref winnow_grammar::InternerContext, var: fn(ref String) -> bool sync, pinned: fn(ref String) -> i64? sync, mut out: Vec[logic::SolverTerm]) -> i64? {
    let a = lin_term(lhs, words, var, pinned, out) ?? return null
    let b = lin_term(rhs, words, var, pinned, out) ?? return null
    return match op {
        BinaryOp::Lt => built(logic::SolverTerm::Lt(a, b), out),
        BinaryOp::Le => built(logic::SolverTerm::Le(a, b), out),
        BinaryOp::Gt => built(logic::SolverTerm::Gt(a, b), out),
        BinaryOp::Ge => built(logic::SolverTerm::Ge(a, b), out),
        BinaryOp::Eq => built(logic::SolverTerm::Eq(a, b), out),
        else => built(logic::SolverTerm::Ne(a, b), out),
    }
}

/// `node` appended, and its place.
fn built(node: logic::SolverTerm, mut out: Vec[logic::SolverTerm]) -> i64 {
    out.push(node)
    return out.len() - 1
}

/// The value of the term at `at` where it reads no variable and fits, as
/// `nikaia-logic`'s `Arena::constant` reads it.
fn constant_at(at: i64, out: ref Vec[logic::SolverTerm]) -> i64? {
    return match out[at] {
        logic::SolverTerm::Int(n) => n,
        logic::SolverTerm::Neg(a) => {
            let v = constant_at(a, out) ?? return null
            v.checked_neg()
        },
        logic::SolverTerm::Add(a, b) => {
            let x = constant_at(a, out) ?? return null
            let y = constant_at(b, out) ?? return null
            x.checked_add(y)
        },
        logic::SolverTerm::Sub(a, b) => {
            let x = constant_at(a, out) ?? return null
            let y = constant_at(b, out) ?? return null
            x.checked_sub(y)
        },
        logic::SolverTerm::Mul(a, b) => {
            let x = constant_at(a, out) ?? return null
            let y = constant_at(b, out) ?? return null
            x.checked_mul(y)
        },
        logic::SolverTerm::Quot(a, k) => {
            let x = constant_at(a, out) ?? return null
            x.checked_div(k)
        },
        else => null,
    }
}

/// An integer literal's value where an `i64` holds it.
fn literal_value(value: u64, negative: bool) -> i64? {
    if value <= 9223372036854775807 {
        let n = value as i64
        if negative {
            return -n
        }
        return n
    }
    if negative && value == 9223372036854775808 {
        return -9223372036854775808
    }
    return null
}

/// No name pinned: for a term read where no `comptime` and no call run
/// while building can stand.
fn nothing_pinned(name: ref String) -> i64? {
    return null
}

/// **A whole number the build knows** (ADR-359 D11): a literal, a name or a
/// call `pinned` gives, and their negation, `+`, `-`, `*`, `/` and `%`, as
/// Part I 2.2 folds them. Nothing where it reads anything else or a step has
/// no answer in an `i64`.
fn folded_whole(expr: ref Expr, words: ref winnow_grammar::InternerContext, pinned: fn(ref String) -> i64? sync) -> i64? {
    return match expr {
        Expr::LitInt { value, negative, .. } => literal_value(value, negative),
        Expr::Variable(name, _) => pinned(words.resolve(name)),
        Expr::Call { .. } => pinned(call_result_name(expr)),
        Expr::Unary { op, expr, .. } => {
            if op != UnaryOp::Neg {
                return null
            }
            let v = folded_whole(expr, words, pinned) ?? return null
            v.checked_neg()
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            let x = folded_whole(lhs, words, pinned) ?? return null
            let y = folded_whole(rhs, words, pinned) ?? return null
            match op {
                BinaryOp::Add => x.checked_add(y),
                BinaryOp::Sub => x.checked_sub(y),
                BinaryOp::Mul => x.checked_mul(y),
                BinaryOp::Div => x.checked_div(y),
                BinaryOp::Rem => x.checked_rem(y),
                else => null,
            }
        },
        else => null,
    }
}
