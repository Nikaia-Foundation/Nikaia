// crates/nikaia-std/src/compiler/check_calls.nika
//
// **What the checker reads off a callee's signature** - the arguments a call
// passes, what the receiver's and the arguments' types bind the signature's
// variables to, and what a sequence a call hands back is as a whole - moved
// from the compiler's checker (ADR-294, #125).

use std::collections

/// The arguments a *call* passes: the parameters after a receiver.
fn call_arguments(signature: ref Signature) -> Vec[(String, Ty)] {
    let mut out: Vec[(String, Ty)] = []
    let mut first = true
    for (name, ty) in signature.params {
        if first && name == "self" {
            first = false
            continue
        }
        first = false
        out.push((name.clone(), ty.clone()))
    }
    return out
}

/// The types a call's arguments are expected to be, in order.
fn expected_arguments(contract: ref FnContract) -> Vec[Ty] {
    let mut out: Vec[Ty] = []
    let signature = contract.signature ?? return out
    for (_, ty) in call_arguments(signature) {
        out.push(ty.clone())
    }
    return out
}

/// **What the receiver's actual type binds the signature's variables to**:
/// the receiver is the first parameter where there is one, so this is one
/// `bind` against one pattern (ADR-288).
fn receiver_bindings(contract: ref FnContract, receiver: ref Ty) -> collections::BTreeMap[String, Ty] {
    let mut bound: collections::BTreeMap[String, Ty] = collections::BTreeMap()
    let signature = contract.signature ?? return bound
    if signature.params.len() > 0 && signature.params[0].0 == "self" {
        bind(signature.params[0].1, receiver, bound)
    }
    return bound
}

/// What the arguments' actual types bind the signature's variables to.
fn argument_bindings(contract: ref FnContract, found: ref Vec[Ty]) -> collections::BTreeMap[String, Ty] {
    let mut bound: collections::BTreeMap[String, Ty] = collections::BTreeMap()
    let signature = contract.signature ?? return bound
    let arguments = call_arguments(signature)
    let mut at = 0
    while at < arguments.len() && at < found.len() {
        bind(arguments[at].1, found[at], bound)
        at += 1
    }
    return bound
}

/// Whether a call's receiver is a sequence it walks, and so consumes.
fn walks_by_value(contract: ref FnContract) -> bool {
    let signature = contract.signature ?? return false
    if signature.params.len() == 0 {
        return false
    }
    return match signature.params[0].1 {
        Ty::Seq { .. } => true,
        else => false,
    }
}

/// **What a sequence a call hands back is as a whole** (ADR-293 D16): it
/// ends from the back and knows its length only where every sequence it was
/// made from does, and - for a callee that ends by length - only where they
/// are all sized.
fn shape_through(contract: ref FnContract, receiver: ref Ty, found: ref Vec[Ty], result: Ty) -> Ty {
    let (item, is_sync, pauses, fails, parallel, written) = match result {
        Ty::Seq { item, is_sync, pauses, fails, parallel, shape } => (item.clone(), is_sync, pauses, fails.clone(), parallel, shape.clone()),
        else => return result,
    }
    let mut ends = true
    let mut sized = true
    let mut on_every_core = parallel
    let mut timed = false
    let mut one_at_a_time = false
    let mut failing_items = false
    let mut failing_set: Vec[String] = []
    if contract.signature != null {
        let signature = contract.signature?.clone() ?? Signature::empty()
        if signature.params.len() > 0 && signature.params[0].0 == "self" && a_sequence_type(signature.params[0].1) {
            ends = ends && shape_ends(receiver)
            sized = sized && shape_sized(receiver)
            // **A walk made from a `Par` is a `Par`** (ADR-235 D1): `map`,
            // `filter` and the rest are `Seq`'s entries, and what they hand
            // back still runs on every core, so it has `Par`'s `fold`.
            on_every_core = on_every_core || shape_parallel(receiver)
            // **And a walk's deadline goes on to the step that ends it**
            // (ADR-async-5 D27).
            timed = shape_timed(receiver)
            // **So does `limit: 1`** (ADR-async-5 D15, D26), from the walk
            // the step is called on only.
            one_at_a_time = shape_one_at_a_time(receiver)
            // **And each element's failure goes on to the step that ends
            // it** (#2736): a step over a walk of failing elements fails
            // where that walk does.
            failing_items = shape_failing_items(receiver)
            failing_set = sequence_failures(receiver)
        }
        let arguments = call_arguments(signature)
        let mut at = 0
        while at < arguments.len() && at < found.len() {
            if a_sequence_type(arguments[at].1) {
                ends = ends && shape_ends(found[at])
                sized = sized && shape_sized(found[at])
                // **A walk handed to another carries its deadline into what
                // they make** (`zip`, `chain`; ADR-async-5 D27, #1423).
                timed = timed || shape_timed(found[at])
            }
            at += 1
        }
    }
    ends = ends && (!contract.ends_by_length || sized)
    return Ty::Seq { item: item, is_sync: is_sync, pauses: pauses, fails: failures_joined(fails, failing_set), parallel: on_every_core, shape: Shape { ends: written.ends && ends, sized: written.sized && sized, replays: written.replays, timed: written.timed || timed, one_at_a_time: written.one_at_a_time || one_at_a_time, failing_items: written.failing_items || failing_items } }
}

/// **What a step of a walk fails with** (#2742): empty for what is no
/// walk or cannot fail.
pub fn sequence_failures(ty: ref Ty) -> Vec[String] {
    return match ty {
        Ty::Seq { fails, .. } => fails.clone(),
        else => [],
    }
}

/// Whether each element of a walk carries its step's failure (#2736).
fn shape_failing_items(ty: ref Ty) -> bool {
    return match ty {
        Ty::Seq { shape, .. } => shape.failing_items,
        else => false,
    }
}

fn shape_parallel(ty: ref Ty) -> bool {
    return match ty {
        Ty::Seq { parallel, .. } => parallel,
        else => false,
    }
}

/// Whether a walk carries a deadline to the step that ends it (ADR-async-5
/// D27).
fn shape_timed(ty: ref Ty) -> bool {
    return match ty {
        Ty::Seq { shape, .. } => shape.timed,
        else => false,
    }
}

/// Whether a walk's elements run one at a time, `par_iter(limit: 1)`
/// (ADR-async-5 D15).
fn shape_one_at_a_time(ty: ref Ty) -> bool {
    return match ty {
        Ty::Seq { shape, .. } => shape.one_at_a_time,
        else => false,
    }
}

fn shape_ends(ty: ref Ty) -> bool {
    return match ty {
        Ty::Seq { shape, .. } => shape.ends,
        else => false,
    }
}

fn shape_sized(ty: ref Ty) -> bool {
    return match ty {
        Ty::Seq { shape, .. } => shape.sized,
        else => false,
    }
}

/// A step of a chain over a sequence that pauses: what it makes pauses too.
fn a_paused_chain(key: ref String, on: ref Ty) -> bool {
    let a_step = key == "Seq::map" || key == "Seq::cloned" || key == "Seq::filter" || key == "Seq::take" || key == "Seq::skip" || key == "Seq::step_by" || key == "Seq::zip"
    return a_step && match on {
        Ty::Seq { pauses, .. } => pauses,
        else => false,
    }
}

/// **A sequence made over one that pauses pauses**, fails where it does, and
/// neither ends from the back nor knows its length.
fn a_pausing_sequence(result: Ty, on: ref Ty) -> Ty {
    let on_fails = sequence_failures(on)
    return match result {
        Ty::Seq { item, fails, parallel, shape, .. } => Ty::Seq { item: item.clone(), is_sync: false, pauses: true, fails: failures_joined(fails, on_fails), parallel: parallel, shape: Shape { ends: false, sized: false, replays: shape.replays, timed: shape.timed, one_at_a_time: shape.one_at_a_time, failing_items: shape.failing_items } },
        else => result,
    }
}
