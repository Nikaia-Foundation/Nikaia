// crates/nikaia-std/src/compiler/prover_loops.nika
//
// **A loop, read by the prover through its invariant** (ADR-361 D1-D5,
// D7): the frontend's half. A `while` whose turn changes whole numbers the
// walk follows becomes the logic layer's loop problem (`logic_horn.nika`):
// each path through the body is one alternative of a turn, or a way out of
// its own - a `break`, a `continue` that ends the turn, a `return`. Only a
// claim what is known leaves open asks for it (D2); then the strategies
// propose, cheapest first - closed forms, then intervals (D5) - and only
// what the three queries prove is used (D4).
//
// The names: a state name `i` is itself at the head of a turn and `i'` after
// it (`lg_primed`); `i@S` is its value when the loop at byte `S` is reached,
// and `i#S` its value at the head of the turn the loop is left in. Neither
// can be a name of the program.

use std::collections
use std::text
use logic

/// **A loop the walk passed, as the logic layer states it** (ADR-361 D1),
/// kept in the scope after it until one of its names is bound again.
pub struct LoopRecord {
    /// Where the loop starts, which names its values before it and at the
    /// head of the last turn.
    pub start: i64,
    pub problem: logic::LgLoop,
    /// **What one turn adds to each state name**, path by path, where every
    /// path adds a constant: the closed forms' and the intervals' input.
    pub steps: collections::BTreeMap[String, Vec[i64]],
    /// **A `for` over a range's binding** (ADR-361 D1), the last state
    /// name: it starts at the range's start and goes up by one each turn.
    /// Empty for a `while`.
    pub counter: String,
    /// **Each path that ends a turn**, what it met and each state name's
    /// value over the head of the turn: the input of the turn-indexed
    /// intervals (ADR-361 D12).
    pub turns: Vec[LoopTurn],
    /// **The claims of the `assert`s in the body that read a state name**,
    /// each read over the head of the turn on the path that reaches it:
    /// candidates of their own (ADR-361 D3, D5.4).
    pub asserts: Vec[i64],
}

/// One path through a turn that reaches the next head: the conditions it
/// met and each state name's value at its end.
pub struct LoopTurn {
    pub constraints: Vec[i64],
    pub values: collections::BTreeMap[String, i64],
}

/// **The invariant the strategies found and the three queries proved**
/// (ADR-361 D4, D5): its parts, each with the strategy that proposed it.
pub struct LoopFound {
    pub parts: Vec[(i64, String)],
}

/// One path through a turn: what it has met, and each name's value as a term
/// over the head of the turn.
struct LoopPath {
    constraints: Vec[i64],
    values: collections::BTreeMap[String, i64],
    /// Locals of the body that are no whole number the prover reads.
    unread: collections::BTreeSet[String],
    /// The claims of the `assert`s the path passed, read over the head.
    asserted: Vec[i64],
}

/// A path that left the turn: `turn` (its end or a `continue`), `break` or
/// `return`.
struct LoopEnd {
    kind: String,
    path: LoopPath,
}

/// The paths a turn may take, at most: past it the loop is not stated.
fn loop_paths_most() -> i64 {
    return 32
}

/// The name of a state name's value when the loop is reached.
fn loop_before_name(name: ref String, start: i64) -> String {
    return f"{name}@{start}"
}

/// The name of a state name's value at the head of the turn the loop is left in.
fn loop_head_name(name: ref String, start: i64) -> String {
    return f"{name}#{start}"
}

/// The name of a `for` binding's value when the loop is left: out of scope
/// past it, so not the name of anything the program reads there.
fn loop_after_name(name: ref String, start: i64) -> String {
    return f"{name}${start}"
}

/// **A `while` as the logic layer's loop problem** (ADR-361 D1): `state` the
/// whole numbers its turn changes, `facts` what holds before it, `ints` the
/// whole numbers the prover reads there. Nothing where a turn holds what this
/// does not follow - a way out it does not know, more paths than it counts.
fn loop_record(mut arena: logic::TermArena, start: i64, state: ref Vec[String], facts: ref Vec[i64], ints: ref collections::BTreeSet[String], pinned: fn(ref String) -> i64? sync, cond: ref Expr, body: ref Block, words: ref winnow_grammar::InternerContext, claims: ref collections::BTreeSet[(i64, i64)], throwing: fn(ref Expr) -> bool sync, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> LoopRecord? {
    let condition = claim_term(cond, words, fn(name) { ints.contains(name) }, pinned, arena.nodes)
    return loop_record_of(arena, start, state, facts, ints, pinned, condition, "", -1, body, words, claims, throwing, holes_of)
}

/// **A `for` over a range as the `while` it means** (ADR-361 D1): its
/// binding `counter` is a state name that starts at `low` and goes up by one
/// at the end of each turn, a `continue`'s too; the loop ends once it passes
/// `high` (`inclusive`) or reaches it. `low` and `high` are terms over the
/// names before the loop; `high` reads none the turn changes.
fn loop_record_range(mut arena: logic::TermArena, start: i64, state: ref Vec[String], facts: ref Vec[i64], ints: ref collections::BTreeSet[String], pinned: fn(ref String) -> i64? sync, counter: ref String, low: i64, high: i64, inclusive: bool, body: ref Block, words: ref winnow_grammar::InternerContext, claims: ref collections::BTreeSet[(i64, i64)], throwing: fn(ref Expr) -> bool sync, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> LoopRecord? {
    let here = arena.var(counter)
    let mut condition = arena.lt(here, high)
    if inclusive {
        condition = arena.le(here, high)
    }
    return loop_record_of(arena, start, state, facts, ints, pinned, condition, counter, low, body, words, claims, throwing, holes_of)
}

/// The loop problem of a `while` (`counter` empty) or of a `for` over a
/// range: `condition` the term that keeps it turning, if the prover reads it.
fn loop_record_of(mut arena: logic::TermArena, start: i64, outer: ref Vec[String], facts: ref Vec[i64], ints: ref collections::BTreeSet[String], pinned: fn(ref String) -> i64? sync, condition: i64?, counter: ref String, low: i64, body: ref Block, words: ref winnow_grammar::InternerContext, claims: ref collections::BTreeSet[(i64, i64)], throwing: fn(ref Expr) -> bool sync, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> LoopRecord? {
    let mut state = outer.clone()
    if counter != "" {
        state.push(counter.clone())
    }
    let mut before: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let mut entry: Vec[i64] = []
    let mut head: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for name in outer {
        let ghost = arena.var(loop_before_name(name, start))
        before.insert(name.clone(), ghost)
        let here = arena.var(name)
        head.insert(name.clone(), here)
        entry.push(arena.equal(here, ghost))
    }
    let mut fixed: Vec[i64] = []
    for fact in facts {
        fixed.push(arena.substitute(fact, before))
    }
    // A `for`'s binding starts at the range's start, read before the loop.
    if counter != "" {
        let ghost = arena.var(loop_before_name(counter, start))
        let here = arena.var(counter)
        head.insert(counter.clone(), here)
        entry.push(arena.equal(here, ghost))
        let begins = arena.substitute(low, before)
        fixed.push(arena.equal(ghost, begins))
    }
    let first = LoopPath { constraints: [], values: head, unread: collections::BTreeSet(), asserted: [] }
    let mut ends: Vec[LoopEnd] = []
    let live = loop_block(arena, body, [first], ends, state, ints, pinned, words, claims, throwing, holes_of) ?? return null
    for path in live {
        ends.push(LoopEnd { kind: "turn", path: path.clone() })
    }
    // A `for`'s binding goes up by one at the end of every turn.
    if counter != "" {
        let one = arena.int(1)
        let mut stepped: Vec[LoopEnd] = []
        for end in ends {
            let mut p = end.path.clone()
            if end.kind == "turn" {
                let value = p.values[counter] ?? arena.var(counter)
                let next = arena.add(value, one)
                p.values.insert(counter.clone(), next)
            }
            stepped.push(LoopEnd { kind: end.kind.clone(), path: p })
        }
        ends = stepped
    }
    let mut turns: Vec[i64] = []
    let mut exits: Vec[logic::LgExit] = []
    let mut same: Vec[i64] = []
    for name in state {
        let primed = arena.var(logic::lg_primed(name))
        let here = arena.var(name)
        same.push(arena.equal(primed, here))
    }
    let c = condition ?? -1
    if c >= 0 {
        let not_c = arena.not(c)
        same.insert(0, not_c)
    }
    exits.push(logic::LgExit { kind: "condition", relation: arena.and(same) })
    let mut steps: collections::BTreeMap[String, Vec[i64]] = collections::BTreeMap()
    let mut unsteady: collections::BTreeSet[String] = collections::BTreeSet()
    let mut kept_turns: Vec[LoopTurn] = []
    for end in ends {
        let mut parts = end.path.constraints.clone()
        if end.kind == "turn" {
            let mut values: collections::BTreeMap[String, i64] = collections::BTreeMap()
            for name in state {
                values.insert(name.clone(), end.path.values[name] ?? arena.var(name))
            }
            kept_turns.push(LoopTurn { constraints: end.path.constraints.clone(), values: values })
        }
        for name in state {
            let primed = arena.var(logic::lg_primed(name))
            let value = end.path.values[name] ?? arena.var(name)
            parts.push(arena.equal(primed, value))
            if end.kind == "turn" {
                let delta = loop_constant_step(arena, name, value)
                if delta == null {
                    unsteady.insert(name.clone())
                } else {
                    let mut seen = steps.remove(name) ?? []
                    seen.push(delta ?? 0)
                    steps.insert(name.clone(), seen)
                }
            }
        }
        if end.kind == "turn" {
            turns.push(arena.and(parts))
        } else {
            if c >= 0 {
                parts.insert(0, c)
            }
            exits.push(logic::LgExit { kind: end.kind.clone(), relation: arena.and(parts) })
        }
    }
    for name in unsteady {
        steps.remove(name)
    }
    let mut step = arena.boolean(false)
    if !turns.is_empty() {
        step = arena.or(turns)
    }
    // An `assert` that reads a state name and nothing the path made up.
    let mut asserts: Vec[i64] = []
    let mut asserted_texts: collections::BTreeSet[String] = collections::BTreeSet()
    for end in ends {
        for claim in end.path.asserted {
            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
            arena.variables(claim, read)
            let mut reads_state = false
            let mut made_up = false
            for n in read {
                if state.contains(n) {
                    reads_state = true
                }
                if n.contains("~") {
                    made_up = true
                }
            }
            let text = arena.text(claim)
            if reads_state && !made_up && !asserted_texts.contains(text) {
                asserted_texts.insert(text)
                asserts.push(claim)
            }
        }
    }
    let problem = logic::LgLoop { state: state.clone(), fixed: fixed, entry: entry, condition: condition, step: step, exits: exits, goals: [] }
    return LoopRecord { start: start, problem: problem, steps: steps, counter: counter.clone(), turns: kept_turns, asserts: asserts }
}

/// What a turn adds to `name` where `value` is it plus a constant: the same
/// difference under two choices of every name it reads. A guess only - what
/// it proposes is proved or dropped (D4).
fn loop_constant_step(mut arena: logic::TermArena, name: ref String, value: i64) -> i64? {
    let here = arena.var(name)
    let difference = arena.sub(value, here)
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    arena.variables(difference, read)
    let mut low: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let mut high: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let mut k = 0
    for n in read {
        low.insert(n.clone(), 3 + 7 * k)
        high.insert(n.clone(), 11 + 13 * k)
        k += 1
    }
    let a = arena.int_value(difference, low) ?? return null
    let b = arena.int_value(difference, high) ?? return null
    if a != b {
        return null
    }
    return a
}

/// A term of the body, read on `path`: each name the path has a value for
/// replaced by it.
fn loop_read(mut arena: logic::TermArena, expr: ref Expr, path: ref LoopPath, ints: ref collections::BTreeSet[String], pinned: fn(ref String) -> i64? sync, words: ref winnow_grammar::InternerContext, claim: bool) -> i64? {
    let mut term: i64? = null
    if claim {
        term = claim_term(expr, words, fn(name) { path.values.contains_key(name) || (ints.contains(name) && !path.unread.contains(name)) }, pinned, arena.nodes)
    } else {
        term = lin_term(expr, words, fn(name) { path.values.contains_key(name) || (ints.contains(name) && !path.unread.contains(name)) }, pinned, arena.nodes)
    }
    let t = term ?? return null
    return arena.substitute(t, path.values)
}

/// **A value a `let` or an assignment of the body gives**, read on `path`: a
/// `bool` literal is the number 1 or 0 (ADR-361 D13).
fn loop_value(mut arena: logic::TermArena, expr: ref Expr, path: ref LoopPath, ints: ref collections::BTreeSet[String], pinned: fn(ref String) -> i64? sync, words: ref winnow_grammar::InternerContext) -> i64? {
    return match expr {
        Expr::LitBool(b, _) => arena.int(if b { 1 } else { 0 }),
        else => loop_read(arena, expr, path, ints, pinned, words, false),
    }
}

/// **The list a statement `list.push(x)` grows by one** (ADR-361 D15), or
/// empty.
fn loop_grown(stmt: ref Stmt, words: ref winnow_grammar::InternerContext) -> String {
    let expr = match stmt {
        Stmt::Expr(e) => e,
        else => return "",
    }
    return match expr {
        Expr::MethodCall { receiver, method, args, .. } => {
            if args.len() != 1 || words.resolve(method) != "push" {
                return ""
            }
            let list = match receiver {
                Expr::Variable(s, _) => words.resolve(s).clone(),
                else => return "",
            }
            // What is pushed is read first: one that changes the list
            // itself leaves its length unknown.
            let none: collections::BTreeSet[String] = collections::BTreeSet()
            if changes_length_in_expr(args[0], list, none, words) {
                return ""
            }
            list
        },
        else => "",
    }
}

/// `name` gets a value nothing follows on `path`.
fn loop_forget(mut arena: logic::TermArena, mut path: LoopPath, name: ref String) {
    let fresh = arena.var(f"{name}~{arena.nodes.len()}")
    path.values.insert(name.clone(), fresh)
}

/// **The statements of a block, on each live path** (ADR-361 D1): the paths
/// still running after it; each that left is in `ends`. Nothing where a
/// statement leaves in a way this does not follow.
fn loop_block(mut arena: logic::TermArena, block: ref Block, first: ref Vec[LoopPath], mut ends: Vec[LoopEnd], state: ref Vec[String], ints: ref collections::BTreeSet[String], pinned: fn(ref String) -> i64? sync, words: ref winnow_grammar::InternerContext, claims: ref collections::BTreeSet[(i64, i64)], throwing: fn(ref Expr) -> bool sync, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> Vec[LoopPath]? {
    let mut live = first.clone()
    for stmt in block.stmts {
        let mut next: Vec[LoopPath] = []
        // **A followed list's length in the state** (ADR-361 D15): one more
        // past `list.push(x)`; unknown before and past any other statement
        // that may change it, an `if` only by its condition (its branches
        // are read statement by statement).
        let grown = loop_grown(stmt.node, words)
        let mut moved: Vec[String] = []
        let none: collections::BTreeSet[String] = collections::BTreeSet()
        for name in state {
            if !name.ends_with(".len()") {
                continue
            }
            let list = (name.strip_suffix(".len()") ?? "").clone()
            if list == grown {
                continue
            }
            let changes = match stmt.node {
                Stmt::Expr(expr) => match expr {
                    Expr::If { cond, .. } => changes_length_in_expr(cond, list, none, words),
                    else => changes_length_in_statement(stmt.node, list, none, words),
                },
                else => changes_length_in_statement(stmt.node, list, none, words),
            }
            if changes {
                moved.push(name.clone())
            }
        }
        for path in live {
            let mut p = path.clone()
            let mut ended: String = ""
            let mut keep = true
            for name in moved {
                loop_forget(arena, p, name)
            }
            let from = next.len()
            match stmt.node {
                Stmt::Break => {
                    ended = "break"
                },
                Stmt::Continue => {
                    ended = "turn"
                },
                Stmt::Return(_) => {
                    ended = "return"
                },
                Stmt::Let { names, ty, value, .. } => {
                    if leaves_stmt(stmt.node, throwing, holes_of, true) {
                        return null
                    }
                    for n in assigned_in_statement(stmt.node, words) {
                        if p.values.contains_key(n) {
                            loop_forget(arena, p, n)
                        }
                    }
                    let mut term: i64? = null
                    if names.len() == 1 {
                        term = loop_value(arena, value, p, ints, pinned, words)
                    }
                    for name in names {
                        let n = words.resolve(name).clone()
                        if state.contains(n) || state.contains(f"{n}.len()") {
                            return null
                        }
                        p.values.remove(n)
                        p.unread.insert(n.clone())
                    }
                    if term == null && names.len() == 1 && loop_whole_let(ty, value, words) {
                        // A whole number nothing here reads is a name of
                        // its own, fresh on each path, so what tests it
                        // constrains it (`let d: i64 = ds[k]`, then
                        // `return 0 if d > 15`).
                        let n = words.resolve(names[0]).clone()
                        term = arena.var(f"{n}~{arena.nodes.len()}")
                    }
                    if term != null {
                        let n = words.resolve(names[0]).clone()
                        p.unread.remove(n)
                        p.values.insert(n, term ?? 0)
                    }
                },
                Stmt::Assign { target, op, value } => {
                    if leaves_stmt(stmt.node, throwing, holes_of, true) {
                        return null
                    }
                    let name = match target {
                        Expr::Variable(s, _) => words.resolve(s).clone(),
                        else => "",
                    }
                    if name != "" && p.values.contains_key(name) {
                        let read = loop_value(arena, value, p, ints, pinned, words)
                        let old = p.values[name] ?? arena.var(name)
                        let mut updated: i64? = null
                        // What `name op= value` makes of `old`: the value
                        // itself for `=`, a sum or a difference for `+=` and
                        // `-=`, nothing else.
                        if read != null {
                            let r = read ?? 0
                            if op == null {
                                updated = r
                            } else {
                                updated = match op ?? BinaryOp::Mul {
                                    BinaryOp::Add => arena.add(old, r),
                                    BinaryOp::Sub => arena.sub(old, r),
                                    else => null,
                                }
                            }
                        }
                        if updated == null {
                            loop_forget(arena, p, name)
                        } else {
                            p.values.insert(name.clone(), updated ?? 0)
                        }
                    }
                },
                Stmt::Expr(expr) => {
                    let handled = loop_expr_stmt(arena, expr, stmt.span, p, next, ends, state, ints, pinned, words, claims, throwing, holes_of) ?? return null
                    if handled {
                        keep = false
                    } else {
                        if leaves_stmt(stmt.node, throwing, holes_of, true) {
                            return null
                        }
                        for n in assigned_in_statement(stmt.node, words) {
                            if p.values.contains_key(n) {
                                loop_forget(arena, p, n)
                            }
                        }
                    }
                },
                else => {
                    if leaves_stmt(stmt.node, throwing, holes_of, true) {
                        return null
                    }
                    for n in assigned_in_statement(stmt.node, words) {
                        if p.values.contains_key(n) {
                            loop_forget(arena, p, n)
                        }
                    }
                },
            }
            if ended != "" {
                ends.push(LoopEnd { kind: ended, path: p })
            } else if keep {
                next.push(p)
            }
            for k in from..<next.len() {
                for name in moved {
                    loop_forget(arena, next[k], name)
                }
                if grown != "" {
                    let length = f"{grown}.len()"
                    let old = next[k].values[length] ?? continue
                    let one = arena.int(1)
                    next[k].values.insert(length, arena.add(old, one))
                }
            }
        }
        live = next
        if live.len() + ends.len() > loop_paths_most() {
            return null
        }
    }
    return live
}

/// **The parts of `cond` known where it is `holds`**, each read on `path`:
/// both sides of an `&&` that holds or of an `||` that fails, and the part
/// itself otherwise. A part no term reads is left out, which only weakens
/// what the branch knows (#1848).
fn loop_read_parts(mut arena: logic::TermArena, cond: ref Expr, path: ref LoopPath, ints: ref collections::BTreeSet[String], pinned: fn(ref String) -> i64? sync, words: ref winnow_grammar::InternerContext, holds: bool) -> Vec[i64] {
    match cond {
        Expr::Unary { op, expr, .. } => {
            if op == UnaryOp::Not {
                return loop_read_parts(arena, expr, path, ints, pinned, words, !holds)
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            if (op == BinaryOp::And && holds) || (op == BinaryOp::Or && !holds) {
                let mut parts = loop_read_parts(arena, lhs, path, ints, pinned, words, holds)
                parts.extend(loop_read_parts(arena, rhs, path, ints, pinned, words, holds))
                return parts
            }
        },
        else => {},
    }
    let c = loop_read(arena, cond, path, ints, pinned, words, true) ?? return []
    return [if holds { c } else { arena.not(c) }]
}

/// An `if` or an `assert` standing as a statement, on one path: whether it
/// was handled - the paths it leaves running pushed onto `next` - or is an
/// ordinary statement. Nothing where a branch leaves in a way not followed.
fn loop_expr_stmt(mut arena: logic::TermArena, expr: ref Expr, span: Span, path: ref LoopPath, mut next: Vec[LoopPath], mut ends: Vec[LoopEnd], state: ref Vec[String], ints: ref collections::BTreeSet[String], pinned: fn(ref String) -> i64? sync, words: ref winnow_grammar::InternerContext, claims: ref collections::BTreeSet[(i64, i64)], throwing: fn(ref Expr) -> bool sync, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool? {
    match expr {
        Expr::If { cond, then_branch, else_branch, .. } => {
            let c = loop_read(arena, cond, path, ints, pinned, words, true)
            let mut yes = path.clone()
            let mut no = path.clone()
            if c != null {
                yes.constraints.push(c ?? 0)
                no.constraints.push(arena.not(c ?? 0))
            } else {
                // A condition with a part no term reads (`i < n && ok(i)`)
                // still says the parts it does on the branch they hold on.
                yes.constraints.extend(loop_read_parts(arena, cond, path, ints, pinned, words, true))
                no.constraints.extend(loop_read_parts(arena, cond, path, ints, pinned, words, false))
            }
            let after_yes = loop_block(arena, then_branch, [yes], ends, state, ints, pinned, words, claims, throwing, holes_of) ?? return null
            next.extend(after_yes)
            let otherwise = else_branch ?? {
                next.push(no)
                return true
            }
            let after_no = loop_block(arena, otherwise, [no], ends, state, ints, pinned, words, claims, throwing, holes_of) ?? return null
            next.extend(after_no)
            return true
        },
        // **A `throw` leaves the function** as a `return` does: a way out
        // that never reaches past the loop, not a turn (ADR-361 D12).
        Expr::Throw(_, _) => {
            ends.push(LoopEnd { kind: "return", path: path.clone() })
            return true
        },
        Expr::Call { func, args, .. } => {
            if prover_an_assert_call(func, args, span, claims) {
                // Past an `assert` its claim holds: proved, or checked
                // where it is reached.
                let mut p = path.clone()
                let c = loop_read(arena, args[0], p, ints, pinned, words, true)
                if c != null {
                    p.constraints.push(c ?? 0)
                    p.asserted.push(c ?? 0)
                }
                next.push(p)
                return true
            }
            return false
        },
        else => return false,
    }
}

/// **The candidates, cheapest strategy first** (ADR-361 D5): closed forms
/// - a name a turn changes by one constant on every path is its start plus
/// that constant times the turns taken, and a counter stops at its bound -
/// then intervals.
fn loop_candidates(mut arena: logic::TermArena, record: ref LoopRecord, proved: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync, mut asked: Vec[i64]) -> Vec[(i64, String)] sync {
    let mut found: Vec[(i64, String)] = []
    let start = record.start
    // Closed forms: each name against its start, each pair against each other.
    let mut steady: Vec[(String, i64)] = []
    for (name, deltas) in record.steps {
        if deltas.is_empty() {
            continue
        }
        let k = deltas[0]
        let mut one = true
        for d in deltas {
            if d != k {
                one = false
            }
        }
        if one {
            steady.push((name.clone(), k))
            continue
        }
        // A name that moves one way only, by steps that differ, stays on
        // its side of its start (#1384).
        let here = arena.var(name)
        let before = arena.var(loop_before_name(name, start))
        if deltas.iter().all(fn(d) { d >= 0 }) {
            found.push((arena.ge(here, before), "closed forms"))
        } else if deltas.iter().all(fn(d) { d <= 0 }) {
            found.push((arena.le(here, before), "closed forms"))
        }
    }
    for (name, k) in steady {
        let here = arena.var(name)
        let before = arena.var(loop_before_name(name, start))
        if k == 0 {
            found.push((arena.equal(here, before), "closed forms"))
        } else if k > 0 {
            found.push((arena.ge(here, before), "closed forms"))
        } else {
            found.push((arena.le(here, before), "closed forms"))
        }
    }
    for i in 0..<steady.len() {
        for j in (i + 1)..<steady.len() {
            let (x, kx) = steady[i]
            let (y, ky) = steady[j]
            if kx == 0 || ky == 0 {
                continue
            }
            // ky · (x - x@) == kx · (y - y@)
            let left = loop_scaled_offset(arena, record, x, ky)
            let right = loop_scaled_offset(arena, record, y, kx)
            found.push((arena.equal(left, right), "closed forms"))
        }
    }
    // A counter against its bound: it ends within one step past it, or
    // never moved.
    let c = record.problem.condition ?? -1
    if c >= 0 {
        for (name, k) in steady {
            let bound = loop_bound_of(arena, c, name, record.problem.state) ?? continue
            let op = bound.op.clone()
            let e = bound.value
            let here = arena.var(name)
            let before = arena.var(loop_before_name(name, start))
            let kc = arena.int(k)
            let mut reach = arena.add(e, kc)
            let constant = arena.constant(e)
            if constant != null {
                reach = arena.int((constant ?? 0) + k)
            }
            let mut near: i64? = null
            if k > 0 && op == "<" {
                near = arena.lt(here, reach)
            } else if k > 0 && op == "<=" {
                near = arena.le(here, reach)
            } else if k < 0 && op == ">" {
                near = arena.gt(here, reach)
            } else if k < 0 && op == ">=" {
                near = arena.ge(here, reach)
            }
            let n = near ?? continue
            found.push((n, "closed forms"))
            let unmoved = arena.equal(here, before)
            found.push((arena.or([n, unmoved]), "closed forms"))
        }
    }
    // Intervals, widened to what the condition stops: a name whose every
    // path adds a constant of one sign, from a known start.
    for (name, deltas) in record.steps {
        let mut up = true
        let mut down = true
        let mut most = 0
        let mut least = 0
        for d in deltas {
            if d < 0 {
                up = false
            }
            if d > 0 {
                down = false
            }
            if d > most {
                most = d
            }
            if d < least {
                least = d
            }
        }
        if deltas.is_empty() || (up && down) {
            continue
        }
        let ghost = loop_before_name(name, start)
        let known = loop_known_value(arena, record.problem.fixed, ghost) ?? continue
        let here = arena.var(name)
        let at_start = arena.int(known)
        let limit = loop_constant_limit(arena, c, name)
        if up {
            found.push((arena.ge(here, at_start), "intervals"))
            let found_limit = limit ?? continue
            let op = found_limit.op.clone()
            let value = found_limit.value
            let mut top: i64? = null
            if op == "<" {
                top = value - 1 + most
            } else if op == "<=" {
                top = value + most
            }
            let t = top ?? continue
            let highest = if t > known { t } else { known }
            let h = arena.int(highest)
            found.push((arena.le(here, h), "intervals"))
        } else {
            found.push((arena.le(here, at_start), "intervals"))
            let found_limit = limit ?? continue
            let op = found_limit.op.clone()
            let value = found_limit.value
            let mut bottom: i64? = null
            if op == ">" {
                bottom = value + 1 + least
            } else if op == ">=" {
                bottom = value + least
            }
            let b = bottom ?? continue
            let lowest = if b < known { b } else { known }
            let l = arena.int(lowest)
            found.push((arena.ge(here, l), "intervals"))
        }
    }
    // The program's own `assert`s in the body (D5.4).
    for claim in record.asserts {
        found.push((claim, "asserts"))
    }
    found.extend(loop_octagons(arena, record))
    found.extend(loop_flagged(arena, record))
    found.extend(loop_unrolled(arena, record, steady, proved, asked))
    return found
}

/// The origin of a guess [`loop_flagged`] made, as `--asserts` and
/// `--bounds` name it (D7).
fn loop_flagged_origin() -> String {
    return "flag facts"
}

/// **What held where a flag rose** (ADR-361 D13, D15): a state name some path
/// of the turn raises - sets to a constant, as a `bool` set `true`, or adds
/// to, as a list's length that grew - and no path lowers offers
/// `x == x@ || fact` for each fact that held on every path that raised it,
/// with the loop's condition. A name the loop changes is projected out of
/// those facts through its start and its direction (D13: `i >= i@` where `i`
/// only grows), by Fourier-Motzkin on at most 2 names and 8 facts; what is
/// beyond that is dropped, which only weakens the guess. Each guess is
/// checked as any other (D4).
fn loop_flagged(mut arena: logic::TermArena, record: ref LoopRecord) -> Vec[(i64, String)] sync {
    let mut found: Vec[(i64, String)] = []
    let start = record.start
    let state = record.problem.state.clone()
    // What the closed forms bound each name by that moves one way only.
    let mut directions: collections::BTreeMap[String, Form] = collections::BTreeMap()
    for (name, deltas) in record.steps {
        if deltas.is_empty() {
            continue
        }
        let mut vars: collections::BTreeMap[String, i64] = collections::BTreeMap()
        if deltas.iter().all(fn(d) { d >= 0 }) {
            // x@ - x <= 0
            vars.insert(name.clone(), -1)
            vars.insert(loop_before_name(name, start), 1)
        } else if deltas.iter().all(fn(d) { d <= 0 }) {
            vars.insert(name.clone(), 1)
            vars.insert(loop_before_name(name, start), -1)
        } else {
            continue
        }
        directions.insert(name.clone(), Form { vars: vars, k: 0 })
    }
    let mut kept_condition: Vec[i64] = []
    let c = record.problem.condition ?? -1
    if c >= 0 {
        loop_atoms(arena, c, false, kept_condition)
    }
    for flag in state {
        let mut rises = 0
        let mut lowers = false
        let mut common: collections::BTreeMap[String, Form] = collections::BTreeMap()
        for turn in record.turns {
            let value = turn.values[flag] ?? continue
            let raise = loop_raise(arena, value, flag)
            if raise < 0 {
                lowers = true
                break
            }
            if raise == 0 {
                continue
            }
            let mut said: Vec[i64] = kept_condition.clone()
            for constraint in turn.constraints {
                loop_atoms(arena, constraint, false, said)
            }
            let mut facts: Vec[Form] = []
            for atom in said {
                atoms(atom, fn(at) { arena.at(at) }, facts)
            }
            let projected = loop_projected(facts, state, directions)
            let mut here: collections::BTreeMap[String, Form] = collections::BTreeMap()
            for f in projected {
                here.insert(loop_form_key(f), f.clone())
            }
            if rises == 0 {
                common = here
            } else {
                let mut both: collections::BTreeMap[String, Form] = collections::BTreeMap()
                for (key, f) in common {
                    if here.contains_key(key) {
                        both.insert(key.clone(), f.clone())
                    }
                }
                common = both
            }
            rises += 1
        }
        if lowers || rises == 0 {
            continue
        }
        let named = arena.var(flag)
        let before = arena.var(loop_before_name(flag, start))
        for (_, f) in common {
            let unmoved = arena.equal(named, before)
            let fact = loop_form_term(arena, f) ?? continue
            found.push((arena.or([unmoved, fact]), loop_flagged_origin()))
        }
    }
    return found
}

/// **`facts` with the names `state` and the names made up on the path
/// projected out** (ADR-361 D15), by Fourier-Motzkin over whole numbers: a
/// name of `directions` with its bound added, the facts that read a name left
/// without one dropped. At most 2 names and 8 facts that read them; past that
/// only the facts that read none are kept. Each form says `form <= 0`.
fn loop_projected(facts: ref Vec[Form], state: ref Vec[String], directions: ref collections::BTreeMap[String, Form]) -> Vec[Form] sync {
    let mut gone: collections::BTreeSet[String] = collections::BTreeSet()
    let mut reading = 0
    for f in facts {
        let mut reads = false
        for (name, _) in f.vars {
            if state.contains(name) || name.contains("~") {
                gone.insert(name.clone())
                reads = true
            }
        }
        if reads {
            reading += 1
        }
    }
    let mut now: Vec[Form] = []
    if gone.len() > 2 || reading > 8 {
        for f in facts {
            let mut reads = false
            for (name, _) in f.vars {
                if gone.contains(name) {
                    reads = true
                }
            }
            if !reads {
                now.push(f.clone())
            }
        }
        return now
    }
    now = facts.clone()
    for name in gone {
        let bound = directions.get(name) ?? continue
        now.push(bound.clone())
    }
    for x in gone {
        let mut kept: Vec[Form] = []
        let mut ups: Vec[Form] = []
        let mut downs: Vec[Form] = []
        for f in now {
            let cx = f.vars.get(x) ?? 0
            if cx > 0 {
                ups.push(f.clone())
            } else if cx < 0 {
                downs.push(f.clone())
            } else {
                kept.push(f.clone())
            }
        }
        for u in ups {
            for d in downs {
                let cu = u.vars.get(x) ?? 0
                let cd = (d.vars.get(x) ?? 0).checked_neg() ?? continue
                let a = scaled(u, cd) ?? continue
                let b = scaled(d, cu) ?? continue
                let mut joined = sum(a, b, 1) ?? continue
                joined.vars.remove(x)
                kept.push(joined)
            }
        }
        now = kept
    }
    let mut out: Vec[Form] = []
    for f in now {
        let mut nothing = true
        for (_, cx) in f.vars {
            if cx != 0 {
                nothing = false
            }
        }
        if !nothing {
            out.push(f.clone())
        }
    }
    return out
}

/// A form's text, the same for two forms that say the same.
fn loop_form_key(f: ref Form) -> String sync {
    let mut parts: Vec[String] = []
    for (name, cx) in f.vars {
        if cx != 0 {
            parts.push(f"{cx}*{name}")
        }
    }
    parts.push(f"{f.k}")
    return parts.join(" + ")
}

/// **`form <= 0` as a term**, each side without a negative coefficient:
/// `i@ + 1 <= args.len()`.
fn loop_form_term(mut arena: logic::TermArena, f: ref Form) -> i64? sync {
    let mut left: i64? = null
    let mut right: i64? = null
    for (name, cx) in f.vars {
        if cx == 0 {
            continue
        }
        let v = arena.var(name)
        let size = cx.checked_abs() ?? return null
        let mut part = v
        if size != 1 {
            let times = arena.int(size)
            part = arena.mul(times, v)
        }
        if cx > 0 {
            left = if left == null { part } else { arena.add(left ?? 0, part) }
        } else {
            right = if right == null { part } else { arena.add(right ?? 0, part) }
        }
    }
    if f.k > 0 {
        let k = arena.int(f.k)
        left = if left == null { k } else { arena.add(left ?? 0, k) }
    } else if f.k < 0 {
        let k = arena.int(f.k.checked_neg() ?? return null)
        right = if right == null { k } else { arena.add(right ?? 0, k) }
    }
    let l = left ?? arena.int(0)
    let r = right ?? arena.int(0)
    return arena.le(l, r)
}

/// **Differences of two state names that keep a sign** (ADR-361 D5.2, the
/// first octagons): where on every path the step of `x` is at most that of
/// `y`, `x - y` never grows past its start, `x - y <= x@ - y@`; the other
/// way round it never falls below it. Two names that both step by one
/// constant are the closed forms' already.
fn loop_octagons(mut arena: logic::TermArena, record: ref LoopRecord) -> Vec[(i64, String)] sync {
    let mut found: Vec[(i64, String)] = []
    let origin: String = "octagons"
    let mut names: Vec[String] = []
    for (name, _) in record.steps {
        names.push(name.clone())
    }
    for a in 0..<names.len() {
        for b in (a + 1)..<names.len() {
            let x = names[a].clone()
            let y = names[b].clone()
            let dx = record.steps[x] ?? continue
            let dy = record.steps[y] ?? continue
            if dx.is_empty() || dx.len() != dy.len() {
                continue
            }
            let mut at_most = true
            let mut at_least = true
            let mut x_steady = true
            let mut y_steady = true
            for k in 0..<dx.len() {
                if dx[k] > dy[k] {
                    at_most = false
                }
                if dx[k] < dy[k] {
                    at_least = false
                }
                if dx[k] != dx[0] {
                    x_steady = false
                }
                if dy[k] != dy[0] {
                    y_steady = false
                }
            }
            if (x_steady && y_steady) || (at_most && at_least) {
                continue
            }
            // `x - x@ <= y - y@`, said `x <= y` where both start alike.
            let mut left = arena.var(x)
            let mut right = arena.var(y)
            let sx = loop_start_of(arena, record, x)
            let sy = loop_start_of(arena, record, y)
            if arena.text(sx) != arena.text(sy) {
                left = arena.sub(left, sx)
                right = arena.sub(right, sy)
            }
            if at_most {
                found.push((arena.le(left, right), origin.clone()))
            }
            if at_least {
                found.push((arena.ge(left, right), origin.clone()))
            }
        }
    }
    return found
}

/// What a state name was when the loop was reached: the term the facts
/// before it pin, or the name of that value.
fn loop_start_of(mut arena: logic::TermArena, record: ref LoopRecord, name: ref String) -> i64 sync {
    let ghost = loop_before_name(name, record.start)
    return loop_start_term(arena, record.problem.fixed, ghost) ?? arena.var(ghost)
}

/// The most turns a loop may take for the turn-indexed intervals
/// (ADR-361 D12).
fn loop_turns_most() -> i64 sync {
    return 16
}

/// The origin `--asserts` names for a turn-indexed interval (ADR-361 D7).
fn loop_unrolled_origin() -> String sync {
    return "turn-indexed intervals"
}

/// **Turn-indexed intervals** (ADR-361 D12: unrolling stated as an
/// invariant): where a counter goes from a known start by one constant to a
/// constant limit, the loop takes at most `T` turns; nothing is proposed
/// where `T` is more than 16 or not read. For every other state name with a
/// known start, each turn's paths are evaluated over intervals - what the
/// path met, and the name's interval after `j` turns - and give its interval
/// after `j + 1`. The candidates are `counter > start + j·k || lo_j <= x <=
/// hi_j`, one per turn, each linear; they are proved or dropped as every
/// candidate is (D4). `v = v * 16 + d` with `0 <= d <= 15` over four turns
/// is `0 <= v <= 65535`.
fn loop_unrolled(mut arena: logic::TermArena, record: ref LoopRecord, steady: ref Vec[(String, i64)], proved: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync, mut asked: Vec[i64]) -> Vec[(i64, String)] sync {
    let mut found: Vec[(i64, String)] = []
    let c = record.problem.condition ?? return found
    let start = record.start
    // The counter and how many turns it allows.
    let mut counter: String = ""
    let mut first = 0
    let mut step = 0
    let mut turns = -1
    for (name, k) in steady {
        if k <= 0 {
            continue
        }
        let limit = loop_constant_limit(arena, c, name) ?? continue
        let begins = loop_known_value(arena, record.problem.fixed, loop_before_name(name, start)) ?? continue
        let mut t = 0
        if limit.op == "<" {
            if limit.value > begins {
                t = (limit.value - begins + k - 1) / k
            }
        } else if limit.op == "<=" {
            if limit.value >= begins {
                t = (limit.value - begins) / k + 1
            }
        } else {
            continue
        }
        if t <= loop_turns_most() {
            counter = name.clone()
            first = begins
            step = k
            turns = t
            break
        }
    }
    if turns < 0 {
        return found
    }
    // The paths of a turn that can be taken at all, each as plain atoms.
    let mut paths: Vec[LoopTurn] = []
    let falsum = arena.boolean(false)
    for turn in record.turns {
        asked.push(1)
        if proved(arena, turn.constraints, falsum) {
            continue
        }
        let mut atoms: Vec[i64] = []
        for constraint in turn.constraints {
            loop_atoms(arena, constraint, false, atoms)
        }
        paths.push(LoopTurn { constraints: atoms, values: turn.values.clone() })
    }
    if paths.is_empty() {
        return found
    }
    let here_counter = arena.var(counter)
    for name in record.problem.state {
        if name == counter || record.steps.contains_key(name) {
            continue
        }
        let x0 = loop_known_value(arena, record.problem.fixed, loop_before_name(name, start)) ?? continue
        let here = arena.var(name)
        let mut lo = x0
        let mut hi = x0
        let mut hull_lo = x0
        let mut hull_hi = x0
        for j in 0..<(turns + 1) {
            let at_most = arena.int(first + j * step)
            let past = arena.gt(here_counter, at_most)
            let low = arena.int(hull_lo)
            let high = arena.int(hull_hi)
            let above = arena.ge(here, low)
            let below = arena.le(here, high)
            let within = arena.and([above, below])
            found.push((arena.or([past, within]), loop_unrolled_origin()))
            if j == turns {
                break
            }
            // The interval after one more turn: every path's, joined.
            let mut next_lo: i64? = null
            let mut next_hi: i64? = null
            let mut open = false
            for path in paths {
                let value = path.values[name] ?? arena.var(name)
                let mut facts = path.constraints.clone()
                let lo_term = arena.int(lo)
                let hi_term = arena.int(hi)
                facts.push(arena.ge(here, lo_term))
                facts.push(arena.le(here, hi_term))
                let range = candidate(value, facts, fn(at) { arena.at(at) })
                if range.lo == null || range.hi == null {
                    open = true
                    break
                }
                let rl = range.lo ?? 0
                let rh = range.hi ?? 0
                if next_lo == null || rl < (next_lo ?? 0) {
                    next_lo = rl
                }
                if next_hi == null || rh > (next_hi ?? 0) {
                    next_hi = rh
                }
            }
            if open {
                break
            }
            lo = next_lo ?? 0
            hi = next_hi ?? 0
            if lo < hull_lo {
                hull_lo = lo
            }
            if hi > hull_hi {
                hull_hi = hi
            }
        }
    }
    return found
}

/// **A condition as comparisons it implies**, the negation pushed inward:
/// a conjunction's parts, a negated disjunction's parts negated, a negated
/// comparison turned. A disjunction implies none of its parts and is left
/// out - what is left out only weakens a guess.
fn loop_atoms(mut arena: logic::TermArena, c: i64, negated: bool, mut out: Vec[i64]) sync {
    match arena.at(c) {
        logic::SolverTerm::And(parts) => {
            if !negated {
                for part in parts {
                    loop_atoms(arena, part, false, out)
                }
            }
        },
        logic::SolverTerm::Or(parts) => {
            if negated {
                for part in parts {
                    loop_atoms(arena, part, true, out)
                }
            }
        },
        logic::SolverTerm::Not(a) => loop_atoms(arena, a, !negated, out),
        logic::SolverTerm::Lt(a, b) => out.push(if negated { arena.ge(a, b) } else { c }),
        logic::SolverTerm::Le(a, b) => out.push(if negated { arena.gt(a, b) } else { c }),
        logic::SolverTerm::Gt(a, b) => out.push(if negated { arena.le(a, b) } else { c }),
        logic::SolverTerm::Ge(a, b) => out.push(if negated { arena.lt(a, b) } else { c }),
        logic::SolverTerm::Eq(a, b) => {
            if !negated {
                out.push(c)
            }
        },
        else => {},
    }
}

/// **A `let` that binds a whole number**: its type says so, or its value
/// is a cast into one.
fn loop_whole_let(ty: ref Type?, value: ref Expr, words: ref winnow_grammar::InternerContext) -> bool sync {
    let declared = ty ?? {
        return match value {
            Expr::Cast { ty, .. } => ty.generics.is_empty() && is_whole_number(words.resolve(ty.name)),
            else => false,
        }
    }
    return declared.generics.is_empty() && is_whole_number(words.resolve(declared.name))
}

/// `k · (name - start)`, written as plainly as the start allows: a start
/// the facts before the loop pin is its value, and `0` and `1` leave no trace.
fn loop_scaled_offset(mut arena: logic::TermArena, record: ref LoopRecord, name: ref String, k: i64) -> i64 {
    let ghost = loop_before_name(name, record.start)
    let here = arena.var(name)
    let known = loop_known_value(arena, record.problem.fixed, ghost)
    let mut offset = here
    if known == null {
        let before = arena.var(ghost)
        offset = arena.sub(here, before)
    } else if (known ?? 0) != 0 {
        let before = arena.int(known ?? 0)
        offset = arena.sub(here, before)
    }
    if k == 1 {
        return offset
    }
    let factor = arena.int(k)
    return arena.mul(factor, offset)
}

/// **`name op e`, where the condition is that comparison** and `e` reads no
/// state name: `<`, `<=`, `>` or `>=`, with the sides turned where `name`
/// stands on the right.
fn loop_bound_of(arena: ref logic::TermArena, c: i64, name: ref String, state: ref Vec[String]) -> LoopBound? {
    let (op, left, right) = match arena.at(c) {
        logic::SolverTerm::Lt(a, b) => ("<", a, b),
        logic::SolverTerm::Le(a, b) => ("<=", a, b),
        logic::SolverTerm::Gt(a, b) => (">", a, b),
        logic::SolverTerm::Ge(a, b) => (">=", a, b),
        else => return null,
    }
    let mut other = right
    let mut turned = false
    if arena.is_the_variable(left, name) {
        other = right
    } else if arena.is_the_variable(right, name) {
        other = left
        turned = true
    } else {
        return null
    }
    for s in state {
        if arena.mentions(other, s) {
            return null
        }
    }
    if !turned {
        return LoopBound { op: op.clone(), value: other }
    }
    let flipped = if op == "<" { ">" } else if op == "<=" { ">=" } else if op == ">" { "<" } else { "<=" }
    return LoopBound { op: flipped.clone(), value: other }
}

/// A comparison's operator and its other side: a term, or a constant.
struct LoopBound {
    op: String,
    value: i64,
}

/// The condition as `name op constant`, where it is one.
fn loop_constant_limit(arena: ref logic::TermArena, c: i64, name: ref String) -> LoopBound? {
    if c < 0 {
        return null
    }
    let none: Vec[String] = []
    let bound = loop_bound_of(arena, c, name, none) ?? return null
    let value = arena.constant(bound.value) ?? return null
    return LoopBound { op: bound.op.clone(), value: value }
}

/// **What a state name was when the loop was reached**, as a term over the
/// names the loop does not change: the other side of a fact `name == t`.
fn loop_start_term(arena: ref logic::TermArena, facts: ref Vec[i64], name: ref String) -> i64? {
    for fact in facts {
        match arena.at(fact) {
            logic::SolverTerm::Eq(a, b) => {
                if arena.is_the_variable(a, name) && !arena.text(b).contains("@") {
                    return b
                }
                if arena.is_the_variable(b, name) && !arena.text(a).contains("@") {
                    return a
                }
            },
            else => {},
        }
    }
    return null
}

/// The value a fact `name == constant` among `facts` pins `name` to.
fn loop_known_value(arena: ref logic::TermArena, facts: ref Vec[i64], name: ref String) -> i64? {
    for fact in facts {
        match arena.at(fact) {
            logic::SolverTerm::Eq(a, b) => {
                if arena.is_the_variable(a, name) {
                    let v = arena.constant(b)
                    if v != null {
                        return v
                    }
                }
                if arena.is_the_variable(b, name) {
                    let v = arena.constant(a)
                    if v != null {
                        return v
                    }
                }
            },
            else => {},
        }
    }
    return null
}

/// **The invariant, found and checked** (ADR-361 D4, D5): every candidate
/// that holds at entry, then those a turn keeps while the others are
/// assumed, until none falls; what is left is asked once more as one
/// invariant, by the three queries' first two - the third is the claim's
/// own (`loop_facts`). Nothing where no candidate survives. `asked` counts
/// the queries.
fn loop_found(mut arena: logic::TermArena, record: ref LoopRecord, proved: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync, mut asked: Vec[i64]) -> LoopFound? {
    let mut kept: Vec[(i64, String)] = []
    // A turn-indexed interval may be dropped one turn at a time: only a loop
    // that got them gets the rounds for it (ADR-258 D2).
    let mut most_rounds = 4
    for (term, origin) in loop_candidates(arena, record, proved, asked) {
        if origin == loop_unrolled_origin() {
            most_rounds = 4 + loop_turns_most()
        }
        let query = logic::lg_loop_entry_query(record.problem, term)
        asked.push(1)
        if proved(arena, query.facts, query.goal) {
            kept.push((term, origin.clone()))
        }
    }
    let mut rounds = 0
    let mut changed = true
    while changed && !kept.is_empty() && rounds < most_rounds {
        changed = false
        rounds += 1
        let mut all: Vec[i64] = []
        for (term, _) in kept {
            all.push(term)
        }
        let assumed = arena.and(all)
        let mut still: Vec[(i64, String)] = []
        for (term, origin) in kept {
            let mut query = logic::lg_loop_turn_query(arena, record.problem, assumed)
            query.goal = logic::lg_loop_primed(arena, record.problem, term)
            asked.push(1)
            if proved(arena, query.facts, query.goal) {
                still.push((term, origin.clone()))
            } else {
                changed = true
            }
        }
        kept = still
    }
    if kept.is_empty() || changed {
        return null
    }
    let mut all: Vec[i64] = []
    for (term, _) in kept {
        all.push(term)
    }
    let invariant = arena.and(all)
    let verdict = logic::lg_loop_check(arena, record.problem, invariant, fn(on, given, goal) { loop_proved_each(on, given, goal, proved) })
    asked.push(2)
    if !verdict.proved() {
        return null
    }
    return LoopFound { parts: kept }
}

/// **A conjunction proved part by part** (ADR-361 D4): `facts` give every
/// part, each a query of its own with its own certificate; anything else is
/// one query. An invariant's turn query asked whole adds its parts' cases up
/// past the solver's budget (seven turn-indexed intervals already do), where
/// each part alone, as the Houdini rounds ask it, stays well within.
fn loop_proved_each(arena: ref logic::TermArena, facts: ref Vec[i64], goal: i64, proved: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync) -> bool sync {
    match arena.at(goal) {
        logic::SolverTerm::And(parts) => {
            for part in parts {
                if !proved(arena, facts, part) {
                    return false
                }
            }
            return true
        },
        else => return proved(arena, facts, goal),
    }
}

/// **What holds past the loop** (ADR-361 D4): what held before it, about
/// the values it started from; the invariant at the head of the last turn;
/// and one of the ways out that reach past it, from there.
fn loop_facts(mut arena: logic::TermArena, record: ref LoopRecord, found: ref LoopFound) -> Vec[i64] {
    let start = record.start
    let mut renamed: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let mut ghosts: Vec[String] = []
    for name in record.problem.state {
        renamed.insert(name.clone(), arena.var(loop_head_name(name, start)))
        if name == record.counter {
            renamed.insert(logic::lg_primed(name), arena.var(loop_after_name(name, start)))
        } else {
            renamed.insert(logic::lg_primed(name), arena.var(name))
        }
        ghosts.push(loop_before_name(name, start))
    }
    let mut facts: Vec[i64] = []
    for fact in record.problem.fixed {
        for g in ghosts {
            if arena.mentions(fact, g) {
                facts.push(fact)
                break
            }
        }
    }
    for (term, _) in found.parts {
        facts.push(arena.substitute(term, renamed))
    }
    let mut ways: Vec[i64] = []
    for exit in record.problem.exits {
        if exit.kind != "return" {
            ways.push(arena.substitute(exit.relation, renamed))
        }
    }
    facts.push(arena.or(ways))
    return facts
}

/// The name of a state name's value at the head of the turn a point in the
/// loop's body stands in: tied to the name itself there (ADR-361 D2, D3).
fn loop_turn_name(name: ref String, start: i64) -> String {
    return f"{name}^{start}"
}

/// **What holds inside the loop's body** (ADR-361 D2, D3): what held before
/// it, about the values it started from, and the invariant at the head of the
/// turn the point stands in. The condition and the path from the head are the
/// walk's own facts there.
fn loop_turn_facts(mut arena: logic::TermArena, record: ref LoopRecord, found: ref LoopFound) -> Vec[i64] {
    let start = record.start
    let mut renamed: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let mut ghosts: Vec[String] = []
    for name in record.problem.state {
        renamed.insert(name.clone(), arena.var(loop_turn_name(name, start)))
        ghosts.push(loop_before_name(name, start))
    }
    let mut facts: Vec[i64] = []
    for fact in record.problem.fixed {
        for g in ghosts {
            if arena.mentions(fact, g) {
                facts.push(fact)
                break
            }
        }
    }
    for (term, _) in found.parts {
        facts.push(arena.substitute(term, renamed))
    }
    return facts
}

/// **The invariant as `--asserts` names it** (ADR-361 D7): its parts, each
/// start the facts before the loop pin written as its value, and the
/// strategies that found them.
fn loop_found_text(mut arena: logic::TermArena, record: ref LoopRecord, found: ref LoopFound) -> String {
    return loop_said(arena, record, found, "through")
}

/// The same for a claim inside the loop's body: `through` past
/// the loop and `inside` in it (`place`).
fn loop_said(mut arena: logic::TermArena, record: ref LoopRecord, found: ref LoopFound, place: ref String) -> String {
    let mut known: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for name in record.problem.state {
        let ghost = loop_before_name(name, record.start)
        let value = loop_start_term(arena, record.problem.fixed, ghost) ?? continue
        known.insert(ghost, value)
    }
    let mut parts: Vec[String] = []
    let mut origins: Vec[String] = []
    for (term, origin) in found.parts {
        let shown = arena.substitute(term, known)
        let mut text = arena.text(shown)
        if text.contains(" || ") {
            text = f"({text})"
        }
        // A part another already says - the same text, or a disjunction
        // whose first side stands on its own - is not said twice.
        let mut said = parts.contains(text)
        for other in parts {
            if text.starts_with(f"({other} || ") {
                said = true
            }
        }
        if said {
            continue
        }
        parts.push(text)
        if !origins.contains(origin) {
            origins.push(origin.clone())
        }
    }
    let changes = record.problem.state.join("`, `")
    return f"proved {place} the loop that changes `{changes}`, with the invariant `{parts.join(" && ")}`, found by {origins.join(" and ")} and checked by three queries"
}

/// **Why a claim past a loop stays open** (ADR-361 D7): the loop and the
/// names it changes.
fn loop_open_text(records: ref Vec[LoopRecord]) -> String {
    let mut names: Vec[String] = []
    for record in records {
        for n in record.problem.state {
            if !names.contains(n) {
                names.push(n.clone())
            }
        }
    }
    return f"nothing before it shows it; no invariant found for the loop that changes `{names.join("`, `")}` carries it"
}

/// **What a turn's path does to a flag** (ADR-361 D15): 1 where it raises
/// it - sets it to a constant, or adds a positive constant to it - 0 where
/// it leaves it, -1 where it may lower it.
fn loop_raise(arena: ref logic::TermArena, value: i64, flag: ref String) -> i64 {
    let read = linear_form(value, fn(at) { arena.at(at) })
    if read == null {
        return -1
    }
    let form = read ?? Form { vars: collections::BTreeMap(), k: 0 }
    if form.vars.is_empty() {
        return 1
    }
    if form.vars.len() != 1 || (form.vars.get(flag) ?? 0) != 1 || form.k < 0 {
        return -1
    }
    return if form.k > 0 { 1 } else { 0 }
}

/// **Whether a state name is a flag** (ADR-361 D15): some path of a turn
/// raises it and none lowers it.
fn loop_is_flag(arena: ref logic::TermArena, record: ref LoopRecord, flag: ref String) -> bool {
    let mut rises = false
    for turn in record.turns {
        let value = turn.values[flag] ?? continue
        let raise = loop_raise(arena, value, flag)
        if raise < 0 {
            return false
        }
        if raise > 0 {
            rises = true
        }
    }
    return rises
}

/// **Whether a claim reads what one of the loops changes** (ADR-361 D2):
/// through the facts that tie its names to others, one of their state names; or, as a flag's fact ties what held where it
/// rose to the flag (D15), a fact that reads a flag of one of them.
fn loop_reads(arena: ref logic::TermArena, facts: ref Vec[i64], claim: i64, records: ref Vec[LoopRecord]) -> bool {
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    arena.variables(claim, names)
    let mut flags: collections::BTreeSet[String] = collections::BTreeSet()
    for record in records {
        for s in record.problem.state {
            if loop_is_flag(arena, record, s) {
                flags.insert(s.clone())
            }
        }
    }
    if !flags.is_empty() {
        for fact in facts {
            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
            arena.variables(fact, read)
            for n in read {
                if flags.contains(n) {
                    return true
                }
            }
        }
    }
    let mut used: collections::BTreeSet[i64] = collections::BTreeSet()
    let mut grew = true
    while grew {
        grew = false
        for record in records {
            for s in record.problem.state {
                if names.contains(s) {
                    return true
                }
            }
        }
        for k in 0..<facts.len() {
            if used.contains(k) {
                continue
            }
            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
            arena.variables(facts[k], read)
            let mut ties = false
            for n in read {
                if names.contains(n) {
                    ties = true
                    break
                }
            }
            if ties {
                used.insert(k)
                for n in read {
                    if !names.contains(n) {
                        names.insert(n.clone())
                        grew = true
                    }
                }
            }
        }
    }
    return false
}

/// A loop's record.problem as text: the key its invariant is kept under, so that a
/// later pass that states it again finds it.
fn loop_key(arena: ref logic::TermArena, record: ref LoopRecord) -> String {
    let mut parts: Vec[String] = [f"{record.start}"]
    for fact in record.problem.fixed {
        parts.push(arena.text(fact))
    }
    for fact in record.problem.entry {
        parts.push(arena.text(fact))
    }
    parts.push(arena.text(record.problem.step))
    parts.push(arena.text(record.problem.condition ?? record.problem.step))
    for exit in record.problem.exits {
        parts.push(arena.text(exit.relation))
    }
    return parts.join(" ; ")
}

/// **An invariant as `nikaia.proofs` keeps it** (ADR-361 D4): its parts in
/// order, each `strategy=term`, joined by `;`. A term is written as its
/// operator and its operands, `ge(i,0)`; a space in a strategy's name is a
/// `-`.
fn loop_parts_text(arena: ref logic::TermArena, found: ref LoopFound) -> String {
    let mut parts: Vec[String] = []
    for (term, origin) in found.parts {
        parts.push(f"{origin.replace(" ", "-")}={loop_term_word(arena, term)}")
    }
    return parts.join(";")
}

fn loop_term_word(arena: ref logic::TermArena, id: i64) -> String {
    return match arena.at(id) {
        logic::SolverTerm::Bool(b) => f"{b}",
        logic::SolverTerm::Int(n) => f"{n}",
        logic::SolverTerm::Var(name) => loop_name_word(name),
        logic::SolverTerm::Add(a, b) => loop_pair_word(arena, "add", a, b),
        logic::SolverTerm::Sub(a, b) => loop_pair_word(arena, "sub", a, b),
        logic::SolverTerm::Neg(a) => f"neg({loop_term_word(arena, a)})",
        logic::SolverTerm::Mul(a, b) => loop_pair_word(arena, "mul", a, b),
        logic::SolverTerm::Quot(a, k) => f"quot({loop_term_word(arena, a)},{k})",
        logic::SolverTerm::Le(a, b) => loop_pair_word(arena, "le", a, b),
        logic::SolverTerm::Lt(a, b) => loop_pair_word(arena, "lt", a, b),
        logic::SolverTerm::Ge(a, b) => loop_pair_word(arena, "ge", a, b),
        logic::SolverTerm::Gt(a, b) => loop_pair_word(arena, "gt", a, b),
        logic::SolverTerm::Eq(a, b) => loop_pair_word(arena, "eq", a, b),
        logic::SolverTerm::Ne(a, b) => loop_pair_word(arena, "ne", a, b),
        logic::SolverTerm::And(parts) => f"and({loop_list_word(arena, parts)})",
        logic::SolverTerm::Or(parts) => f"or({loop_list_word(arena, parts)})",
        logic::SolverTerm::Not(a) => f"not({loop_term_word(arena, a)})",
        else => f"?",
    }
}

fn loop_pair_word(arena: ref logic::TermArena, op: ref String, a: i64, b: i64) -> String {
    return f"{op}({loop_term_word(arena, a)},{loop_term_word(arena, b)})"
}

fn loop_list_word(arena: ref logic::TermArena, parts: ref Vec[i64]) -> String {
    let mut words: Vec[String] = []
    for p in parts {
        words.push(loop_term_word(arena, p))
    }
    return words.join(",")
}

/// A name with the characters the term's text uses escaped as `%XX`.
fn loop_name_word(name: ref String) -> String {
    return name.replace("%", "%25").replace("(", "%28").replace(")", "%29").replace(",", "%2C").replace(";", "%3B").replace("=", "%3D").replace("|", "%7C").replace(" ", "%20")
}

fn loop_name_of(word: ref String) -> String? {
    if word.len() == 0 || word.contains("?") {
        return null
    }
    return word.replace("%20", " ").replace("%7C", "|").replace("%3D", "=").replace("%3B", ";").replace("%2C", ",").replace("%29", ")").replace("%28", "(").replace("%25", "%")
}

/// A term read and what is left of the text.
struct LoopParsed {
    term: i64,
    rest: String,
}

/// **`loop_term_word` read back**, its nodes appended to the arena; nothing
/// for text it did not write.
fn loop_term_of(mut arena: logic::TermArena, word: ref String) -> LoopParsed? {
    let open = word.find("(")?.start ?? word.end()
    let comma = word.find(",")?.start ?? word.end()
    let close = word.find(")")?.start ?? word.end()
    let first = if open < comma { open } else { comma }
    let end = if first < close { first } else { close }
    let head = word.before(end).clone()
    let rest = word.after(end).clone()
    if !rest.starts_with("(") {
        if head == "true" || head == "false" {
            return LoopParsed { term: arena.boolean(head == "true"), rest: rest }
        }
        let n = text::parse_i64(head)
        if n != null {
            return LoopParsed { term: arena.int(n ?? 0), rest: rest }
        }
        let name = loop_name_of(head) ?? return null
        return LoopParsed { term: arena.var(name), rest: rest }
    }
    let mut after = (rest.strip_prefix("(") ?? "").clone()
    if head == "quot" {
        let inner = loop_term_of(arena, after) ?? return null
        if !inner.rest.starts_with(",") {
            return null
        }
        let tail = (inner.rest.strip_prefix(",") ?? "").clone()
        let shut = tail.find(")") ?? return null
        let k = text::parse_i64(tail.before(shut.start).clone()) ?? return null
        if k <= 0 {
            return null
        }
        return LoopParsed { term: arena.quot(inner.term, k), rest: tail.after(shut.end).clone() }
    }
    let mut args: Vec[i64] = []
    while true {
        let arg = loop_term_of(arena, after) ?? return null
        args.push(arg.term)
        if arg.rest.starts_with(",") {
            after = (arg.rest.strip_prefix(",") ?? "").clone()
        } else if arg.rest.starts_with(")") {
            after = (arg.rest.strip_prefix(")") ?? "").clone()
            break
        } else {
            return null
        }
    }
    let term = loop_built(arena, head, args) ?? return null
    return LoopParsed { term: term, rest: after }
}

fn loop_built(mut arena: logic::TermArena, op: ref String, args: Vec[i64]) -> i64? {
    if op == "and" {
        return arena.and(args)
    }
    if op == "or" {
        return arena.or(args)
    }
    if args.len() == 1 {
        if op == "neg" {
            return arena.neg(args[0])
        }
        if op == "not" {
            return arena.not(args[0])
        }
        return null
    }
    if args.len() != 2 {
        return null
    }
    let a = args[0]
    let b = args[1]
    if op == "add" {
        return arena.add(a, b)
    }
    if op == "sub" {
        return arena.sub(a, b)
    }
    if op == "mul" {
        return arena.mul(a, b)
    }
    if op == "le" {
        return arena.le(a, b)
    }
    if op == "lt" {
        return arena.lt(a, b)
    }
    if op == "ge" {
        return arena.ge(a, b)
    }
    if op == "gt" {
        return arena.gt(a, b)
    }
    if op == "eq" {
        return arena.equal(a, b)
    }
    if op == "ne" {
        return arena.unequal(a, b)
    }
    return null
}

/// **The invariant `nikaia.proofs` holds for a loop, checked** (ADR-361
/// D4): its parts read back, then the three queries asked of them as of any
/// invariant found - nothing is searched. Nothing where the text does not
/// read or a query is not proved; the loop is then searched as if the file
/// held nothing for it. `asked` counts the queries.
fn loop_recorded(mut arena: logic::TermArena, record: ref LoopRecord, recorded: ref String, proved: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync, mut asked: Vec[i64]) -> LoopFound? {
    let mut parts: Vec[(i64, String)] = []
    let mut all: Vec[i64] = []
    for part in recorded.split(";") {
        let at = part.find("=") ?? return null
        let origin = part.before(at.start).replace("-", " ")
        let read = loop_term_of(arena, part.after(at.end).clone()) ?? return null
        if read.rest.len() != 0 || origin.len() == 0 {
            return null
        }
        parts.push((read.term, origin))
        all.push(read.term)
    }
    if parts.is_empty() {
        return null
    }
    let invariant = arena.and(all)
    let verdict = logic::lg_loop_check(arena, record.problem, invariant, fn(on, given, goal) { loop_proved_each(on, given, goal, proved) })
    asked.push(2)
    if !verdict.proved() {
        return null
    }
    return LoopFound { parts: parts }
}
