// **The test runner's discovery, verdicts and each test's work** (P3a, P3b,
// #125): what `crates/nikaia/src/project.rs` did to find a package's output
// tests and test programs, to read what they expect, to say how a run went and
// whether a test passed, to bless it and to explain a failure, moved.
// The loop of `run_tests` over the tests and settings is
// `project_tests_run` (M8), the failures' report
// `project_tests_report_failures` and one test program's build and run
// `project_tests_program_test` (M13c); `project.rs` keeps the `Sandbox`, the
// process spawns (`outcome_of`, the compiler's own runs behind
// `ProjectTestsProgramHost`) and the workers of the test programs, behind
// `ProjectTestsHost`; the structs are Nikaia's and `project.rs` re-exports
// them.
//
// **What a test expects is `Bytes`**: a file is read as bytes and compared as
// bytes, never as text that might not be (ADR-269 D22, ADR-247 D2).

use std::env
use std::fs
use std::collections
use std::hash
use std::text

/// **What one test did, at one setting** ([ADR-269](../../../docs/specification/adr/adr-269.md) D1).
pub struct ProjectTestsOutcome {
    /// Whether the process ended successfully.
    pub ended_well: bool,
    /// Whether the program stopped: its own `panic` or a broken run-time
    /// check, exit code 101 (#1260), not a signal or a refusal.
    pub stopped: bool,
    pub passed: bool,
    pub stdout: Bytes,
    pub stderr: String,
    /// Each file the test's `NAME.out/` names, and what the program wrote
    /// under that name - nothing where it wrote nothing
    /// ([ADR-247](../../../docs/specification/adr/adr-247.md) D2).
    pub files: Vec[(String, Bytes?)],
    /// A test program's `--bounds` reports, each beside what it expects
    /// (#1069): the file's name (`NAME.bounds`, `NAME.asserts`,
    /// `NAME.sharing`), what
    /// the file holds and what was reported - one entry per file there is.
    pub bounds: Vec[(String, Bytes, Bytes)],
}

/// **An output test** ([ADR-269](../../../docs/specification/adr/adr-269.md) D13,
/// [ADR-247](../../../docs/specification/adr/adr-247.md) D2): named by a
/// `tests/NAME.stdout` or a `tests/NAME.out/`, with what goes in beside them.
pub struct OutputTest {
    pub name: String,
    /// The package's `tests/`, where its expectations are blessed to.
    pub dir: fs::Path,
    /// `NAME.stdout`, where there is one.
    pub stdout: Bytes?,
    /// `NAME.stderr`, where there is one (ADR-269 D22).
    pub stderr: Bytes?,
    /// `NAME.stops`, where there is one: the program is expected to stop,
    /// writing this to standard error (#1260).
    pub stops: Bytes?,
    /// `NAME.out/`: each file by the name it has under the working directory.
    pub files: Vec[(String, Bytes)],
    /// `NAME.in/`, copied into the working directory before the run.
    pub inputs: fs::Path?,
    pub stdin: Bytes,
    pub args: Vec[String],
}

/// **A test program** ([ADR-269](../../../docs/specification/adr/adr-269.md)
/// D22): `tests/NAME.nika`, with what it must produce beside it.
pub struct ProgramTest {
    pub name: String,
    pub dir: fs::Path,
    pub stdout: Bytes?,
    /// What it writes to standard error, or, where it is refused, the
    /// compiler's whole message (it starts `error`).
    pub stderr: Bytes?,
    /// `NAME.stops`, where there is one: the program is expected to stop,
    /// writing this to standard error (#1260).
    pub stops: Bytes?,
    /// `NAME.bounds`: its `--bounds` report (#1069), where there is one;
    /// every build asks through a loop, so there is one report (ADR-361 D14).
    pub bounds: Bytes?,
    /// `NAME.asserts`: its `check --asserts` report (ADR-269 D7), where
    /// there is one.
    pub asserts: Bytes?,
    /// `NAME.sharing`: its `check --sharing` report (ADR-269 D22, #1907),
    /// where there is one.
    pub sharing: Bytes?,
    /// `NAME.stdin`, what the program reads on standard input; nothing where
    /// there is none (#1347).
    pub stdin: Bytes,
}

/// Every file under `dir`, by its name relative to it with `/` between the
/// parts, sorted.
/// A test's file as the project names it: under the root, the rest after it,
/// both names canonical; else, or where either cannot be resolved, as given.
fn shown_path(path: ref fs::Path, root: ref fs::Path) -> String {
    let path = fs::canonical(path, fs::Root::Anywhere) catch { path.clone() }
    let root = fs::canonical(root, fs::Root::Anywhere) catch { root.clone() }
    return (path.strip_prefix(root) ?? path).display()
}

fn files_under(dir: ref fs::Path) -> Vec[(String, fs::Path)] throws {
    let mut found: Vec[(String, fs::Path)] = fs::walk(dir, fs::Root::Anywhere).iter().map(fn(name) { (name.text_of(), dir.join(name)) }).collect()
    found.sort()
    return found
}

/// Whether `path` names a directory; a name that is not there names none.
fn project_tests_is_dir(path: ref fs::Path) -> bool {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_dir()
}

/// Whether `path` names a file; a name that is not there names none.
fn project_tests_is_file(path: ref fs::Path) -> bool {
    let found = fs::metadata(path, fs::Root::Anywhere) catch { return false }
    return found.is_file()
}

/// A file's bytes, nothing where it is not there; a file that is there and
/// cannot be read is the failure.
fn project_tests_optional(path: ref fs::Path) -> Bytes? throws {
    if !fs::exists(path, fs::Root::Anywhere) {
        return null
    }
    return fs::read(path, fs::Root::Anywhere)
}

/// The names in `dir` that end in `.ending`, without it, sorted: a test's
/// name is the file's stem.
fn project_tests_stems(dir: ref fs::Path, ending: String, want_dir: bool) -> collections::BTreeSet[String] {
    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
    let entries = fs::read_dir(dir, fs::Root::Anywhere) catch { return names }
    for name in entries.iter() {
        let text = name.text_of()
        let stem: String = (text.strip_suffix(ending) ?? "").clone()
        if stem.is_empty() {
            continue
        }
        let path = dir.join(name)
        let right = match want_dir {
            true => project_tests_is_dir(path),
            false => project_tests_is_file(path),
        }
        if right {
            names.insert(stem)
        }
    }
    return names
}

/// The package's output tests, by name. A `tests/` that is not there holds
/// none; a file that is there and cannot be read is an error, not a test that
/// quietly has no input.
pub fn output_tests(root: ref fs::Path) -> Vec[OutputTest] throws {
    let dir = root.join("tests")
    let mut names = project_tests_stems(dir, ".stdout", false)
    names.extend(project_tests_stems(dir, ".out", true))
    names.extend(project_tests_stems(dir, ".stops", false))
    let mut tests: Vec[OutputTest] = []
    for name in names {
        // A `NAME.nika` beside them makes the files that program's (D22).
        if project_tests_is_file(dir.join(f"{name}.nika")) {
            continue
        }
        let stdout = project_tests_optional(dir.join(f"{name}.stdout"))
        let out = dir.join(f"{name}.out")
        let mut files: Vec[(String, Bytes)] = []
        if project_tests_is_dir(out) {
            for (relative, path) in files_under(out) {
                files.push((relative, fs::read(path, fs::Root::Anywhere)))
            }
        }
        let given = dir.join(f"{name}.in")
        let inputs: fs::Path? = match project_tests_is_dir(given) {
            true => given,
            false => null,
        }
        let stdin = project_tests_optional(dir.join(f"{name}.stdin")) ?? Bytes([])
        let mut args: Vec[String] = []
        let listed = project_tests_optional(dir.join(f"{name}.args"))
        if listed != null {
            let bytes = listed ?? Bytes([])
            args = bytes.text().lines().map(fn(line) { line.clone() }).collect()
        }
        let stderr = project_tests_optional(dir.join(f"{name}.stderr"))
        let stops = project_tests_optional(dir.join(f"{name}.stops"))
        tests.push(OutputTest { name: name.clone(), dir: root.join("tests"), stdout: stdout, stderr: stderr, stops: stops, files: files, inputs: inputs, stdin: stdin, args: args })
    }
    return tests
}

/// Copy every file under `from` to the same name under `to`, making the
/// directories on the way.
pub fn copy_into(from: ref fs::Path, to: ref fs::Path) throws {
    for (relative, path) in files_under(from) {
        let target = to.join(relative)
        match target.parent() {
            null => {}
            parent => fs::create_dir(parent, fs::Root::Anywhere; recursive: true),
        }
        fs::copy(path, target, fs::Root::Anywhere)
    }
}

/// **Whether `file` is a test program of the project at `root`**
/// ([ADR-269](../../../docs/specification/adr/adr-269.md) D22, #972): a
/// `.nika` file straight in its `tests/`. Such a file is a program of its own
/// that may `use` the package, not a file of a package `tests/`, so `check`
/// and `lower` read it as `nikaia test` builds it
/// (`project_tests_program_test`), and never with the other test programs.
pub fn project_tests_is_program(file: ref fs::Path, root: ref fs::Path) -> bool {
    if (file.extension()?.text_of() ?? "") != "nika" {
        return false
    }
    let here: fs::Path = "."
    let parent = match file.parent() {
        null => here,
        parent => if parent.text_of().is_empty() { here } else { parent },
    }
    return project_members_canonical(parent) == project_members_canonical(root.join("tests"))
}

/// **The manifest a test program is built under**: the one
/// `project_tests_program_test` writes, a package of its own that depends on
/// the project's package, by its name, where the project names one (#972).
pub fn project_tests_program_manifest(root: ref fs::Path, package: String?) -> ProjectMembersManifest {
    let mut keys: Vec[String] = []
    let mut paths: Vec[(String, fs::Path)] = []
    match package {
        null => {},
        name => {
            keys.push(name.clone())
            paths.push((name, project_members_canonical(root)))
        },
    }
    return ProjectMembersManifest { name: "program_test", keys: keys, paths: paths, versions: [], foreign: [], has_build: false, uses_in: root.join("tests") }
}

/// The package's test programs, by name.
pub fn program_tests(root: ref fs::Path) -> Vec[ProgramTest] throws {
    let dir = root.join("tests")
    let mut tests: Vec[ProgramTest] = []
    // **One `--bounds` expectation per test** (ADR-361 D14): a
    // `NAME.loops.bounds` left from the switch is an error, not a file
    // nothing reads.
    for stem in project_tests_stems(dir, ".loops.bounds", false) {
        throw ProjectTestsRefusal::Refused(f"tests/{stem}.loops.bounds: a test program has one `--bounds` expectation, `{stem}.bounds`, since every build asks a check through its loop (ADR-361 D14): move what it holds into `{stem}.bounds` and delete it")
    }
    for name in project_tests_stems(dir, ".nika", false) {
        let stdout = project_tests_optional(dir.join(f"{name}.stdout"))
        let stderr = project_tests_optional(dir.join(f"{name}.stderr"))
        let bounds = project_tests_optional(dir.join(f"{name}.bounds"))
        let asserts = project_tests_optional(dir.join(f"{name}.asserts"))
        let sharing = project_tests_optional(dir.join(f"{name}.sharing"))
        let stops = project_tests_optional(dir.join(f"{name}.stops"))
        let stdin = project_tests_optional(dir.join(f"{name}.stdin")) ?? Bytes([])
        tests.push(ProgramTest { name: name.clone(), dir: root.join("tests"), stdout: stdout, stderr: stderr, stops: stops, bounds: bounds, asserts: asserts, sharing: sharing, stdin: stdin })
    }
    return tests
}

/// The `.bounds`, `.asserts` and `.sharing` files in the package's `tests/` with no test
/// program beside them (#1069), by file name: each is an error, not an
/// expectation nothing checks. A `.loops.bounds` is left to
/// [`program_tests`], which refuses every one (ADR-361 D14).
pub fn project_tests_stray_bounds(root: ref fs::Path) -> Vec[String] {
    let dir = root.join("tests")
    let mut stray: Vec[String] = []
    for stem in project_tests_stems(dir, ".bounds", false) {
        if !stem.ends_with(".loops") && !project_tests_is_file(dir.join(f"{stem}.nika")) {
            stray.push(f"{stem}.bounds")
        }
    }
    for stem in project_tests_stems(dir, ".asserts", false) {
        if !project_tests_is_file(dir.join(f"{stem}.nika")) {
            stray.push(f"{stem}.asserts")
        }
    }
    for stem in project_tests_stems(dir, ".sharing", false) {
        if !project_tests_is_file(dir.join(f"{stem}.nika")) {
            stray.push(f"{stem}.sharing")
        }
    }
    return stray
}

/// **The part of `check --bounds`'s output about the test program**
/// (#1069): the report whose first line names `written` (`tests/NAME.nika`,
/// the path already rewritten so), and the lines under it. The first line's
/// tail, what this build writes without its check, is cut: it depends on the
/// build, what is proved does not (ADR-306 D14).
fn project_tests_bounds_report(printed: String, written: String) -> Bytes {
    let head = f"bounds in {written}: "
    let mut report: String = ""
    let mut inside = false
    for line in printed.lines() {
        if inside {
            if !line.starts_with(" ") {
                break
            }
            report.push_str(line)
            report.push_str("\n")
            continue
        }
        if line.starts_with(head) {
            inside = true
            let cut = line.find(" - written without their check: ")
            if cut != null {
                let at = cut ?? 0
                report.push_str(line[0..<at])
            } else {
                report.push_str(line)
            }
            report.push_str("\n")
        }
    }
    return report.bytes.clone()
}

/// **The part of `check --asserts`'s output about the test program**
/// (ADR-269 D7): the report whose first line names `written`, and the rows
/// under it.
fn project_tests_asserts_report(printed: String, written: String) -> Bytes {
    let head = f"asserts in {written}: "
    let mut report: String = ""
    let mut inside = false
    for line in printed.lines() {
        if inside && !line.starts_with(" ") {
            break
        }
        if inside || line.starts_with(head) {
            inside = true
            report.push_str(line)
            report.push_str("\n")
        }
    }
    return report.bytes.clone()
}

/// **The part of `check --sharing`'s output about the test program**
/// (ADR-269 D22, #1907): the report under the line `--- {written}`, up to
/// the next unit's `--- ` line. The check reads the package the program
/// uses as well, one report per file of it under its own `--- ` line; where
/// there is no such line, the program is the only unit, and the report is
/// all that was printed but the closing `Checked` line.
fn project_tests_sharing_report(printed: String, written: String) -> Bytes {
    let head = f"--- {written}"
    let units = printed.lines().any(fn(line) { line.starts_with("--- ") })
    let mut report: String = ""
    let mut inside = !units
    for line in printed.lines() {
        if line.starts_with("--- ") {
            inside = line == head
            continue
        }
        if inside && !line.starts_with("Checked ") {
            report.push_str(line)
            report.push_str("\n")
        }
    }
    return report.bytes.clone()
}

/// **A test program's outcome with its `--bounds`, `--asserts` and
/// `--sharing` reports compared** (#1069, #1907): `report` is what `check
/// --bounds` printed for it, `asserts` what `check --asserts` printed,
/// `sharing` what `check --sharing` printed, its path written
/// `tests/NAME.nika`. Each report its `.bounds`, `.asserts` or `.sharing`
/// expects must be that file, byte for byte, or the test fails.
fn project_tests_bounds_outcome(program: ref ProgramTest, outcome: ref ProjectTestsOutcome, report: String, asserts: String, sharing: String) -> ProjectTestsOutcome {
    let written = f"tests/{program.name}.nika"
    let mut bounds: Vec[(String, Bytes, Bytes)] = []
    match program.bounds {
        null => {},
        want => bounds.push((f"{program.name}.bounds", want.clone(), project_tests_bounds_report(report, written))),
    }
    match program.asserts {
        null => {},
        want => bounds.push((f"{program.name}.asserts", want.clone(), project_tests_asserts_report(asserts, written))),
    }
    match program.sharing {
        null => {},
        want => bounds.push((f"{program.name}.sharing", want.clone(), project_tests_sharing_report(sharing, written))),
    }
    let right = bounds.iter().all(fn(entry) { entry.1 == entry.2 })
    return ProjectTestsOutcome { ended_well: outcome.ended_well, stopped: outcome.stopped, passed: outcome.passed && right, stdout: outcome.stdout.clone(), stderr: outcome.stderr.clone(), files: outcome.files.clone(), bounds: bounds }
}

/// What a test program's `--bounds` reports got wrong, as differences
/// (#1069).
fn project_tests_explain_bounds(outcome: ref ProjectTestsOutcome) throws {
    for (name, want, got) in outcome.bounds {
        if want != got {
            println(f"tests/{name} (- expected, + reported):")
            print(project_tests_difference(want, got))
        }
    }
}

/// Whether a stderr file holds a compiler's refusal, whatever stage produced
/// it: a checker's `error[NK…]` or a parse error's plain `error:` (ADR-269 D22,
/// #834). rustc's own failure is told apart by its `could not compile`.
pub fn is_refusal(text: String) -> bool {
    return (text.starts_with("error") || text.contains("\nerror")) && !does_not_compile(text)
}

/// Whether the build failed in rustc: not a refusal by the Nikaia compiler.
/// Cargo's `could not compile`, or `NK1343`, the internal compiler error the
/// build reports in its place (Part III C.1, #1373): neither is a refusal a
/// `.stderr` can expect, so `--bless` writes none.
fn does_not_compile(text: String) -> bool {
    return text.contains("could not compile") || text.contains("error[NK1343]")
}

/// What names an output test in its report: its `.stdout`, or its `.out/`.
fn named_by(output: ref OutputTest) -> String {
    return match output.stdout != null {
        true => f"{output.name}.stdout",
        false => f"{output.name}.out/",
    }
}

/// **A line difference** ([ADR-247](../../../docs/specification/adr/adr-247.md)
/// D4): `-` an expected line, `+` a produced one, and two lines of context
/// around each change, from a longest common subsequence of the lines.
fn project_tests_difference(expected: ref Bytes, produced: ref Bytes) -> String {
    let want = expected.text() catch { return "  the bytes differ, and they are not text\n" }
    let got = produced.text() catch { return "  the bytes differ, and they are not text\n" }
    // **The lines are Nikaia's** (`tools/diffs.nika`, #125).
    return differing_lines(want, got)
}

/// Whether every setting did the same.
fn project_tests_agree(outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> bool {
    return (1..<outcomes.len()).all(fn(at) { outcomes[at - 1].1 == outcomes[at].1 })
}

/// Print one test's line, and say whether it passed: at every setting, and the
/// same way at each.
fn project_tests_verdict(label: String, outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> bool throws {
    let agree = project_tests_agree(outcomes)
    let passed = agree && (0..<outcomes.len()).all(fn(at) { outcomes[at].1.passed })
    let said = match (passed, agree) {
        (true, _) => "ok",
        (false, true) => "FAILED",
        (false, false) => "FAILED (the settings disagree)",
    }
    println(f"{label} ... {said}")
    return passed
}

/// The first line `nikaia test` prints: how many tests it runs.
fn project_tests_running(total: i64) throws {
    let plural = match total == 1 {
        true => "",
        false => "s",
    }
    println(f"running {total} test{plural}")
}

/// The last line `nikaia test` prints, and the exit code it ends with.
pub fn project_tests_result(total: i64, failed: i64) -> i32 throws {
    let passed = total - failed
    let said = match failed == 0 {
        true => "ok",
        false => "FAILED",
    }
    println(f"\ntest result: {said}. {passed} passed; {failed} failed")
    return match failed == 0 {
        true => 0,
        false => 1,
    }
}

/// How an output test names itself in its line.
fn project_tests_output_label(output: ref OutputTest) -> String {
    return f"output \"{output.name}\" (tests/{named_by(output)})"
}

/// How a test program names itself in its line.
fn project_tests_program_label(program: ref ProgramTest) -> String {
    return f"program \"{program.name}\" (tests/{program.name}.nika)"
}

/// Whether a test wrote the `at`th file its `.out/` names, byte for byte.
fn project_tests_wrote(got: ref Vec[(String, Bytes?)], want: ref Vec[(String, Bytes)], at: i64) -> bool {
    return match got[at].1 {
        null => false,
        written => written == want[at].1,
    }
}

/// A file a test may have written, nothing where it wrote none.
fn project_tests_written(path: ref fs::Path) -> Bytes? {
    return fs::read(path, fs::Root::Anywhere) catch { null }
}

/// **How an output test went at one setting**
/// ([ADR-247](../../../docs/specification/adr/adr-247.md) D2): the program
/// ran in `own` and ended with exit `code`, printing `stdout` and `stderr`.
/// It passed where it printed what its `.stdout` holds, where it has one,
/// left each file its `.out/` names byte for byte, and ended as it should:
/// with a `.stops`, stopped, having written that to standard error (#1260);
/// without, successfully, having written its `.stderr`, where it has one.
pub fn project_tests_output_outcome(output: ref OutputTest, own: ref fs::Path, code: i64, stdout: Bytes, stderr: String) -> ProjectTestsOutcome {
    let ended_well = code == 0
    let stopped = project_tests_stopped(code)
    let files: Vec[(String, Bytes?)] = output.files.iter().map(fn(file) { (file.0.clone(), project_tests_written(own.join(file.0))) }).collect()
    let printed_right = match output.stdout {
        null => true,
        want => want == stdout,
    }
    let ended_right = match output.stops {
        null => ended_well && match output.stderr {
            null => true,
            want => want == stderr.bytes,
        },
        want => stopped && want == stderr.bytes,
    }
    let wrote_right = (0..<output.files.len()).all(fn(at) { project_tests_wrote(files, output.files, at) })
    return ProjectTestsOutcome { ended_well: ended_well, stopped: stopped, passed: ended_right && printed_right && wrote_right, stdout: stdout, stderr: stderr, files: files, bounds: [] }
}

/// **Whether a process that ended with exit `code` stopped** (#1260): the
/// program's own `panic` or a broken run-time check ends it with 101. A
/// signal leaves no code (the host hands -1), and any other code is another
/// bad end, never a stop.
fn project_tests_stopped(code: i64) -> bool {
    return code == 101
}

/// **How a `test` block went**: it passed where its process, which ended
/// with exit `code`, ended successfully.
pub fn project_tests_block_outcome(code: i64, stdout: Bytes, stderr: String) -> ProjectTestsOutcome {
    let ended_well = code == 0
    return ProjectTestsOutcome { ended_well: ended_well, stopped: project_tests_stopped(code), passed: ended_well, stdout: stdout, stderr: stderr, files: [], bounds: [] }
}

/// **A test program the compiler did not build**: `stderr` is what it said,
/// with the path written `tests/NAME.nika`. A refusal passes where it is the
/// program's `.stderr`, word for word; a build that failed in rustc is no
/// refusal and never passes.
fn project_tests_refused_outcome(program: ref ProgramTest, stderr: String) -> ProjectTestsOutcome {
    let broken = !is_refusal(stderr)
    let shown = match broken {
        true => f"the program does not compile (rustc failed, not a refusal):\n{stderr}",
        false => stderr.clone(),
    }
    let passed = !broken && program.stops == null && match program.stderr {
        null => false,
        want => want == shown.bytes,
    }
    return ProjectTestsOutcome { ended_well: false, stopped: false, passed: passed, stdout: Bytes([]), stderr: shown, files: [], bounds: [] }
}

/// **A test program that built and ran**, ending with exit `code`: it passed
/// where it printed what its `.stdout` holds, where it has one, and ended as
/// it should. With a `.stops` it stopped, having written that to standard
/// error (#1260); without, it ended successfully, having written its
/// `.stderr`, where it has one. A `.stderr` holding a refusal expects one, so
/// a run never matches it.
fn project_tests_ran_outcome(program: ref ProgramTest, code: i64, stdout: Bytes, said: String) -> ProjectTestsOutcome {
    let ended_well = code == 0
    let stopped = project_tests_stopped(code)
    let printed_right = match program.stdout {
        null => true,
        want => want == stdout,
    }
    let ended_right = match program.stops {
        null => ended_well && match program.stderr {
            null => true,
            want => !is_refusal(want.text() catch { "" }) && want == said.bytes,
        },
        want => stopped && want == said.bytes,
    }
    return ProjectTestsOutcome { ended_well: ended_well, stopped: stopped, passed: ended_right && printed_right, stdout: stdout, stderr: said, files: [], bounds: [] }
}

/// A step of a test program's run that failed, in the words the compiler
/// reports.
pub enum ProjectTestsRefusal {
    Refused(String),
}

impl Error for ProjectTestsRefusal {
    fn message(ref self) -> String {
        return match self {
            ProjectTestsRefusal::Refused(why) => why.clone(),
        }
    }
}

/// How one process of a test program's run ended, and its two streams as
/// they came.
pub struct ProjectTestsRan {
    /// Its exit code: 0 where it ended successfully, -1 where it has none (a
    /// signal ended it).
    pub code: i64,
    pub stdout: Bytes,
    pub stderr: Bytes,
    /// Whether it ran past the time limit it was given, and it and every
    /// process it started were ended (#1672).
    pub timed_out: bool,
    /// The cap on processes and threads it ran into, where a fork or a
    /// thread was refused because of it (#1919); 0 where it ran into none,
    /// or where that cannot be told (a cap that is no cgroup).
    pub capped: i64,
}

/// **How long a test program may run** (#1672): `NIKAIA_TEST_TIME_LIMIT`
/// seconds, 300 where it is not set. A program that runs longer is ended,
/// with every process it started, and fails, so a program that never ends
/// costs its run that limit and names itself, not the whole job's time. The
/// limit is the machine's, not the package's, like `NIKAIA_CACHE_LIMIT`:
/// a slow runner raises it, the package stays as it is. Zero or less, or a
/// value that is no number, gives the default.
fn project_tests_time_limit() -> i64 {
    let given = text::parse_i64((env::var("NIKAIA_TEST_TIME_LIMIT") ?? "").trim()) ?? 0
    return match given > 0 {
        true => given,
        false => 300,
    }
}

/// **How many processes and threads a test program may hold** (#1919):
/// `NIKAIA_TEST_PROCESS_LIMIT`, 4096 where it is not set, counted over the
/// program and every process it starts. A program that forks without end
/// fails on that cap and names it, so it cannot fill the machine's PID
/// space and take every other session on it down. Like the time limit, it
/// is the machine's, not the package's; zero or less, or a value that is no
/// number, gives the default. Only the program's run is capped, not its
/// build: a build's tasks grow with the machine's cores.
fn project_tests_process_limit() -> i64 {
    let given = text::parse_i64((env::var("NIKAIA_TEST_PROCESS_LIMIT") ?? "").trim()) ?? 0
    return match given > 0 {
        true => given,
        false => 4096,
    }
}

/// **A test program that ran into its cap on processes** (#1919): it
/// failed, whatever it printed, and says so first on standard error, with
/// the switch that sets the cap.
fn project_tests_capped_outcome(cap: i64, stdout: Bytes, said: String) -> ProjectTestsOutcome {
    let shown = f"ran into its cap of {cap} processes and threads (NIKAIA_TEST_PROCESS_LIMIT): a fork or a thread past it was refused, and every process it started was ended\n{said}"
    return ProjectTestsOutcome { ended_well: false, stopped: false, passed: false, stdout: stdout, stderr: shown, files: [], bounds: [] }
}

/// **How long a test program's build may take** (#1774, #1775):
/// `NIKAIA_TEST_BUILD_TIME_LIMIT` seconds, ten times the run's limit
/// (`project_tests_time_limit`, so 3000 s) where it is not set or is no
/// number; zero or less sets no limit. A build that takes longer - one stuck
/// on a Cargo lock a nested `cargo` waits for (#1727) never ends - is ended,
/// with every process it started, and its program fails with its name, so
/// the run goes on and names it. Ten runs' time leaves a cold build, which
/// compiles `std` in minutes, room to end. A batch build that runs past it
/// is dropped, and its programs are built alone. Ten times a run's limit set
/// past what an `i64` holds is the most it holds, not an overflow (ADR-396
/// D7, #1660).
fn project_tests_build_time_limit() -> i64 {
    let given = text::parse_i64((env::var("NIKAIA_TEST_BUILD_TIME_LIMIT") ?? "").trim())
    return match given {
        null => project_tests_time_limit().saturating_mul(10),
        seconds => match seconds > 0 {
            true => seconds,
            false => 0,
        },
    }
}

/// **A test program that ran past its time limit** (#1672): it failed,
/// whatever it printed, and says so first on standard error.
fn project_tests_timed_out_outcome(limit: i64, stdout: Bytes, said: String) -> ProjectTestsOutcome {
    let shown = f"timed out after {limit} s\n{said}"
    return ProjectTestsOutcome { ended_well: false, stopped: false, passed: false, stdout: stdout, stderr: shown, files: [], bounds: [] }
}

/// **A test program whose build ran past its time limit** (#1774, #1775):
/// it failed unrun, and says so first on standard error, with the switch
/// that sets the limit and the likely cause, another `cargo` holding the
/// build lock (#1727), and how to see it, before what the build wrote.
fn project_tests_build_timed_out_outcome(limit: i64, said: String) -> ProjectTestsOutcome {
    let hint = "hint: a build that hangs often waits on a Cargo lock another cargo holds; check once with `ps -ef --forest | grep -B2 -E 'cargo (rustc|build) .*--target-dir'`, or raise NIKAIA_TEST_BUILD_TIME_LIMIT (0: no limit)"
    let shown = f"build timed out after {limit} s\n{hint}\n{said}"
    return ProjectTestsOutcome { ended_well: false, stopped: false, passed: false, stdout: Bytes([]), stderr: shown, files: [], bounds: [] }
}

/// What `project_tests_program_test` asks of the compiler (`project.rs`'s
/// `ProgramHost`): the manifest it reads and the processes it starts, each in
/// `own`, with no standard input and no `CARGO_TARGET_DIR`. A refusal of a
/// `throws` method is kept there and handed back unchanged.
pub trait ProjectTestsProgramHost {
    /// The package name `root`'s `nikaia.toml` gives; nothing where it names
    /// none.
    fn package_name(ref self, root: ref fs::Path) -> String? sync throws
    /// This compiler's `VERB --user-parallelism SETTING --project PROJECT`,
    /// run in `dir`, with `own` as the test's directory (where `fs::scratch`
    /// makes its directories) and `stdin` on its standard input (none where it
    /// is empty); a `build` keeps Cargo quiet. Where `within` is more than
    /// zero, it and every process it started are ended after that many
    /// seconds, and the run says it `timed_out` (#1672); where `processes`
    /// is more than zero, it and every process it started may hold that many
    /// processes and threads, are ended when it ends or this compiler does,
    /// and the run says where it was `capped` (#1919); so for the methods
    /// below that take them.
    fn compiler(ref self, verb: ref String, setting: ref String, project: ref fs::Path, dir: ref fs::Path, own: ref fs::Path, stdin: ref Bytes, within: i64, processes: i64) -> ProjectTestsRan sync throws
    /// This compiler's `check ARGS ENTRY` (`--bounds --optimization LEVEL`,
    /// `--asserts`): what it printed.
    fn explained(ref self, args: ref Vec[String], entry: ref fs::Path, own: ref fs::Path) -> Bytes sync throws
    /// The program the build of `project` made, run directly where the build
    /// puts it (`project_settings_own_copy`'s place, with no variant), in
    /// `dir`, with `own` as the test's directory; nothing where it is not
    /// there. `stdin` goes to its standard input, none where it is empty.
    fn built(ref self, project: ref fs::Path, dir: ref fs::Path, own: ref fs::Path, stdin: ref Bytes, within: i64, processes: i64) -> ProjectTestsRan? sync throws
    /// **The batch build** (`project_batch.nika`): this compiler's `build
    /// --user-parallelism SETTING --project PROJECT` in `own`, with
    /// `project_batch_var()` naming `list`, ended after `within` seconds; the
    /// program it made, nothing where the build failed or ran out of time.
    fn batched(ref self, setting: ref String, project: ref fs::Path, own: ref fs::Path, list: ref fs::Path, within: i64) -> ProjectTestsBatchBuilt sync throws
    /// The batch's `binary NAME`, run in `dir`, with `own` as the test's
    /// directory and `stdin` on its standard input (none where it is empty).
    fn ran_batched(ref self, binary: ref fs::Path, name: ref String, dir: ref fs::Path, own: ref fs::Path, stdin: ref Bytes, within: i64, processes: i64) -> ProjectTestsRan sync throws
}

/// **How a batch build ended** (`ProjectTestsProgramHost::batched`): the
/// program it made, nothing where it failed; and whether it ran past its time
/// limit (#1774).
pub struct ProjectTestsBatchBuilt {
    pub binary: fs::Path?,
    pub timed_out: bool,
}

/// **What a program of a batch is run from**: the batch's binary, and the
/// entry the program was lowered from (its path in what the compiler says).
pub struct ProjectTestsBatched {
    pub binary: fs::Path,
    pub entry: fs::Path,
}

/// **Where the run times of `root`'s test programs are kept** (#1600): a
/// file per project under `cache`, named after its canonical path.
pub fn project_tests_times_file(cache: ref fs::Path, root: ref fs::Path) -> fs::Path {
    let shown = f"{project_members_canonical(root).display()}"
    let name: String = shown.chars().map(fn(c) { if c.is_alphanumeric() { c } else { '-' } }).collect()
    return cache.join("test-times").join(name)
}

/// **Where the test programs of the package at `root` are built, from one
/// run to the next** (#1750): one entry of the user cache, `cache`, per
/// package, holding a directory per program and setting and one per
/// setting's batches. A place kept between runs keeps its build's record, so
/// a program that did not change is not handed to Cargo again
/// (`project_drive_fresh`); a place of a new name each run made Cargo
/// compile every program again.
pub fn project_tests_places(cache: ref fs::Path, root: ref fs::Path) -> fs::Path {
    let shown = f"{project_members_canonical(root).display()}"
    let tag: String = hash::sha256_hex(shown.bytes().collect()).chars().take(16).collect()
    return cache.join("test-places").join(tag)
}

/// The run times a times file holds, `name<TAB>milliseconds` a line; a line
/// that is not one is left out, a missing file is none.
fn project_tests_times_read(file: ref fs::Path) -> collections::BTreeMap[String, i64] {
    let mut times: collections::BTreeMap[String, i64] = collections::BTreeMap()
    let bytes = project_tests_written(file) ?? Bytes([])
    for line in bytes.text_lossy().lines() {
        match line.split_once("\t") {
            null => {}
            (name, ms) => match text::parse_i64(ms.trim()) {
                null => {}
                given => times.insert(name.clone(), given),
            },
        }
    }
    return times
}

/// **The order to start `programs` in, longest first** (#1600): the indexes
/// of `programs`, those whose last run time `file` holds by it, the longest
/// first; those it does not know before all, in their own order. The run ends
/// when its last program does, so one long program started last is the run's
/// tail while the other workers wait.
pub fn project_tests_order(programs: ref Vec[ProgramTest], file: ref fs::Path) -> Vec[i64] {
    let times = project_tests_times_read(file)
    let mut keyed: Vec[(i64, i64)] = []
    let mut k = 0
    for program in programs {
        let ms = times.get(program.name) ?? -1
        keyed.push((if ms < 0 { i64::MIN } else { -ms }, k))
        k += 1
    }
    keyed.sort()
    return keyed.iter().map(fn(pair) { pair.1 }).collect()
}

/// **Keep the run times of this run** in `file` (#1600): `ran` replaces
/// what the file held for those programs; the others' are kept, as a run
/// with `--filter` runs a few. A file that cannot be written is no failure:
/// the next run starts in the programs' own order.
pub fn project_tests_remember(file: ref fs::Path, ran: ref Vec[(String, i64)]) {
    let mut times = project_tests_times_read(file)
    for (name, ms) in ran {
        times.insert(name.clone(), ms)
    }
    let text: String = times.iter().map(fn(pair) { f"{pair.0}\t{pair.1}\n" }).collect().join("")
    match file.parent() {
        null => {}
        parent => fs::create_dir(parent, fs::Root::Anywhere; recursive: true) catch { return },
    }
    fs::write(file, fs::Root::Anywhere, text) catch { return }
}

/// The fewest programs worth a batch: below it the extra build costs more than
/// it saves.
fn project_tests_batch_least() -> i64 {
    return 8
}

/// **The entry of a batch's package**: the wrapper builds the batch in its
/// place, but the build reads the dependencies the program crate needs from
/// what this entry lowers to, and a program of the batch may use a grammar
/// (`winnow_grammar`, `winnow`); so the entry holds one.
fn project_tests_batch_carrier() -> String {
    return "grammar Carrier {\n    rule n -> ref Bytes = s:bytes(until(\";\")) -> { s }\n    entry rule top -> i64 = x:n \";\" -> { x.len() }\n}\n\nfn main() throws {\n    let r = Carrier::top(\"abc;\") catch { -1 }\n    println(f\"{r}\")\n}\n"
}

/// **One setting's batches of `programs`** (`project_batch.nika`), each a
/// package in a directory of its own under `own`: by program name, the binary
/// that holds it and its entry. A batch whose build fails is built again
/// without the programs whose modules rustc's messages cite (#1582), or, where
/// they cite none, split in two and each half built again, down to a few
/// programs; what is in no batch is built
/// alone by `project_tests_program_test`. A program with a `.bounds` or
/// `.asserts` report is batched too: the report is checked once per program
/// (`project_tests_reports`), not at its build. Nothing is batched where there
/// are too few programs or `NIKAIA_TEST_NO_BATCH` is set.
pub fn project_tests_batches[H: ProjectTestsProgramHost](host: ref H, programs: ref Vec[ProgramTest], root: ref fs::Path, setting: String, own: ref fs::Path) -> collections::BTreeMap[String, ProjectTestsBatched] throws {
    let mut found: collections::BTreeMap[String, ProjectTestsBatched] = collections::BTreeMap()
    if env::var("NIKAIA_TEST_NO_BATCH") != null {
        return found
    }
    let wanted: Vec[ProgramTest] = programs.iter().map(fn(program) { program.clone() }).collect()
    if wanted.len() < project_tests_batch_least() {
        return found
    }
    let dependency: String = match host.package_name(root) {
        null => "",
        name => {
            let at = project_members_canonical(root).display()
            f"\n[dependencies]\n{name} = {{ path = {at:?} }}\n"
        }
    }
    let manifest = f"[package]\nname = \"program_test\"\nversion = \"0.1.0\"\n{dependency}"
    let mut chunks: Vec[Vec[ProgramTest]] = [wanted]
    let mut made: i64 = 0
    while !chunks.is_empty() {
        let chunk = chunks.pop() ?? break
        let dir = own.join(f"batch-{made}")
        made = made + 1
        fs::create_dir(dir.join("project").join("src"), fs::Root::Anywhere; recursive: true)
        fs::write(dir.join("project").join("nikaia.toml"), fs::Root::Anywhere, manifest.clone())
        fs::write(dir.join("project").join("src").join("main.nika"), fs::Root::Anywhere, project_tests_batch_carrier())
        let mut lines: Vec[String] = []
        for program in chunk {
            let at = dir.join("programs").join(program.name)
            fs::create_dir(at.join("src"), fs::Root::Anywhere; recursive: true)
            fs::write(at.join("nikaia.toml"), fs::Root::Anywhere, manifest.clone())
            let entry = at.join("src").join("main.nika")
            let source = program.dir.join(f"{program.name}.nika")
            fs::copy(source, entry, fs::Root::Anywhere) catch { throw ProjectTestsRefusal::Refused(f"copying {source.display()}: {error}") }
            lines.push(f"{program.name}\t{entry.display()}\n")
        }
        let list = dir.join("batch.list")
        fs::write(list, fs::Root::Anywhere, lines.join(""))
        let built = host.batched(setting, dir.join("project"), dir, list, project_tests_build_time_limit())
        // **A batch that ran out of time is not built again** (#1774), in
        // part or in halves, to run out of it again: its programs are built
        // alone, each within the limit, and one that hangs fails by name.
        if built.timed_out {
            continue
        }
        match built.binary {
            null => {
                // **Leave out the programs rustc named, and build the rest
                // again** (#1582): the lines it cites are in their modules.
                let said = fs::read_to_string(dir.join("batch.said"), fs::Root::Anywhere) catch { "" }
                let ranges = fs::read_to_string(dir.join("batch.modules"), fs::Root::Anywhere) catch { "" }
                let cited = project_batch_cited(said, ranges, "program_test")
                let rest: Vec[ProgramTest] = chunk.iter().filter(fn(program) { !cited.contains(program.name) }).map(fn(program) { program.clone() }).collect()
                if !cited.is_empty() && rest.len() < chunk.len() {
                    if rest.len() >= project_tests_batch_least() {
                        chunks.push(rest)
                    }
                    continue
                }
                // **Else split, and build each half again**: one program that
                // does not compile as a module leaves its half out, not the
                // rest.
                if chunk.len() >= 2 * project_tests_batch_least() {
                    let half = chunk.len() / 2
                    chunks.push(chunk.iter().take(half).map(fn(program) { program.clone() }).collect())
                    chunks.push(chunk.iter().skip(half).map(fn(program) { program.clone() }).collect())
                }
            },
            binary => {
                let included = fs::read_to_string(dir.join("batch.included"), fs::Root::Anywhere) catch { "" }
                for name in included.lines() {
                    let entry = dir.join("programs").join(name).join("src").join("main.nika")
                    found.insert(name.clone(), ProjectTestsBatched { binary: binary.clone(), entry: entry })
                }
            },
        }
    }
    return found
}

/// Remove everything in `dir` but the entry named `keep`; a `dir` that cannot
/// be read holds nothing to remove.
fn project_tests_empty_but(dir: ref fs::Path, keep: String) throws {
    let names = fs::read_dir(dir, fs::Root::Anywhere) catch { return }
    for name in names {
        if name.text_of() == keep {
            continue
        }
        let path = dir.join(name)
        fs::remove(path, fs::Root::Anywhere; recursive: true) catch { throw ProjectTestsRefusal::Refused(f"emptying {path.display()}: {error}") }
    }
}

/// What a run of the program at `entry` said, read as UTF-8 lossily
/// (#1182), with the program's path written `written` (`tests/NAME.nika`)
/// and a file of the tested package at `root` written from there
/// (`src/over.nika`), as a stop inside the package names it (#1351).
fn project_tests_relocated(said: ref Bytes, entry: ref fs::Path, written: String, root: ref fs::Path) -> String {
    let package = f"{project_members_canonical(root).display()}/"
    return said.text_lossy().replace(entry.display(), written).replace(project_members_canonical(entry).display(), written).replace(package, "")
}

/// Both streams of a process, one after the other.
fn project_tests_joined(first: ref Bytes, then: ref Bytes) -> Bytes {
    let mut all: Vec[u8] = first.iter().collect()
    all.extend(then.iter())
    return Bytes(all)
}

/// **The package a test program is built as**, in `own`: `project/` with the
/// manifest and `src/main.nika`, and nothing a program before it left but
/// the package's `target/`. Its entry.
fn project_tests_prepared[H: ProjectTestsProgramHost](host: ref H, program: ref ProgramTest, root: ref fs::Path, own: ref fs::Path) -> fs::Path throws {
    let project = own.join("project")
    project_tests_empty_but(own, "project")
    project_tests_empty_but(project, "target")
    fs::create_dir(project.join("src"), fs::Root::Anywhere; recursive: true)
    let source = program.dir.join(f"{program.name}.nika")
    let entry = project.join("src").join("main.nika")
    fs::copy(source, entry, fs::Root::Anywhere) catch { throw ProjectTestsRefusal::Refused(f"copying {source.display()}: {error}") }
    let dependency: String = match host.package_name(root) {
        null => "",
        name => {
            let at = project_members_canonical(root).display()
            f"\n[dependencies]\n{name} = {{ path = {at:?} }}\n"
        }
    }
    fs::write(project.join("nikaia.toml"), fs::Root::Anywhere, f"[package]\nname = \"program_test\"\nversion = \"0.1.0\"\n{dependency}")
    return entry
}

/// **A test program's `--bounds`, `--asserts` and `--sharing` reports**,
/// each empty where the test expects none.
pub struct ProjectTestsReports {
    pub bounds: String,
    pub asserts: String,
    pub sharing: String,
}

/// **The reports a test program's `.bounds`, `.asserts` and `.sharing`
/// expect** (#1069, ADR-269 D7 and D22), as `check --bounds`, `check
/// --asserts` and `check --sharing` compute them for
/// the program in a package prepared in `own`. **Once per program, not once
/// per setting**: what is proved does not depend on the build's settings
/// (ADR-306 D14, ADR-361 D14), and a check of a program that stresses the
/// prover is the longest part of its test. Nothing is checked for a program
/// that expects neither.
pub fn project_tests_reports[H: ProjectTestsProgramHost](host: ref H, program: ref ProgramTest, root: ref fs::Path, own: ref fs::Path) -> ProjectTestsReports throws {
    let mut found = ProjectTestsReports { bounds: "", asserts: "", sharing: "" }
    if program.bounds == null && program.asserts == null && program.sharing == null {
        return found
    }
    let entry = project_tests_prepared(host, program, root, own)
    let written = f"tests/{program.name}.nika"
    if program.bounds != null {
        found.bounds = project_tests_relocated(host.explained(["--bounds"], entry, own), entry, written, root)
    }
    if program.asserts != null {
        found.asserts = project_tests_relocated(host.explained(["--asserts"], entry, own), entry, written, root)
    }
    if program.sharing != null {
        found.sharing = project_tests_relocated(host.explained(["--sharing"], entry, own), entry, written, root)
    }
    return found
}

/// **Build and run one test program** in a package of its own, in a directory
/// of its own: the package it tests is its dependency, so `use` reaches it. A
/// refusal is the outcome (`ended_well` false, `stderr` the message with the
/// path written `tests/NAME.nika`); a program that builds is run there.
///
/// **The directory, `own`, is this program's at this setting, kept from one
/// run to the next** (`project_tests_places`, #1750), with only the
/// package's `target/` left in it: the package then stays at one path, so
/// Cargo finds the tested package it depends on built and the build's record
/// finds nothing changed, where a new path each time made Cargo compile the
/// program again on every run. What the program sees is what a
/// new directory held: `project/` with the manifest and `src/main.nika`, and
/// no ledger, lock or file a program before it left.
///
/// **The built program is run directly**, not through a second `nikaia run`:
/// that one would build again only to find nothing changed, and then do what
/// is done here - start the binary in the same directory, with the same
/// variables and no standard input, as a child of this process (its own
/// process replaced by the program, #281). What the run wrote before the
/// program started, the build's warnings, is the build's standard error with
/// Cargo kept quiet as `run` keeps it (`CARGO_TERM_QUIET`).
pub fn project_tests_program_test[H: ProjectTestsProgramHost](host: ref H, program: ref ProgramTest, root: ref fs::Path, setting: String, own: ref fs::Path, batched: ProjectTestsBatched?, reports: ref ProjectTestsReports) -> ProjectTestsOutcome throws {
    let project = own.join("project")
    let entry = project_tests_prepared(host, program, root, own)
    let written = f"tests/{program.name}.nika"
    let limit = project_tests_time_limit()
    let processes = project_tests_process_limit()
    // **Run from the batch, where it is in one** (`project_tests_batches`):
    // a pass that wrote nothing on standard error is the verdict; anything
    // else is built and run alone. What a run writes there - a panic's place,
    // a warning of the build - names the batch's Rust, which is not the
    // program's own and differs between the settings.
    match batched {
        null => {},
        batch => {
            let out = host.ran_batched(batch.binary, program.name, root, own, program.stdin, limit, processes)
            // One that ran out of time, or into its cap, is not run alone
            // again, to run out of it twice.
            if out.capped > 0 {
                return project_tests_capped_outcome(out.capped, out.stdout, project_tests_relocated(out.stderr, batch.entry, written, root))
            }
            if out.timed_out {
                return project_tests_timed_out_outcome(limit, out.stdout, project_tests_relocated(out.stderr, batch.entry, written, root))
            }
            let ran = project_tests_ran_outcome(program, out.code, out.stdout, project_tests_relocated(out.stderr, batch.entry, written, root))
            let outcome = project_tests_bounds_outcome(program, ran, reports.bounds.clone(), reports.asserts.clone(), reports.sharing.clone())
            if outcome.passed && out.stderr.len() == 0 {
                return outcome
            }
            project_tests_empty_but(own, "project")
        },
    }
    let report = reports.bounds.clone()
    let asserts = reports.asserts.clone()
    let sharing = reports.sharing.clone()
    let building = project_tests_build_time_limit()
    let built = host.compiler("build", setting, project, own, own, Bytes([]), building, 0)
    if built.timed_out {
        return project_tests_build_timed_out_outcome(building, project_tests_relocated(built.stderr, entry, written, root))
    }
    if built.code != 0 {
        let refused = project_tests_refused_outcome(program, project_tests_relocated(built.stderr, entry, written, root))
        return project_tests_bounds_outcome(program, refused, report, asserts, sharing)
    }
    // **The program runs in the package's directory** (ADR-269 D22, #1398),
    // as a `test` block does, so it reads the package's files by relative
    // name; what it writes goes under `fs::scratch()`, inside `own`. Where
    // the program is not where it is expected, `nikaia run` finds it.
    let ran = match host.built(project, root, own, program.stdin, limit, processes) {
        null => {
            let out = host.compiler("run", setting, project, root, own, program.stdin, limit, processes)
            let said = out.stderr.clone()
            (out, said)
        }
        out => {
            let said = project_tests_joined(built.stderr, out.stderr)
            (out, said)
        }
    }
    let (out, said) = ran
    if out.capped > 0 {
        return project_tests_capped_outcome(out.capped, out.stdout, project_tests_relocated(said, entry, written, root))
    }
    if out.timed_out {
        return project_tests_timed_out_outcome(limit, out.stdout, project_tests_relocated(said, entry, written, root))
    }
    let outcome = project_tests_ran_outcome(program, out.code, out.stdout, project_tests_relocated(said, entry, written, root))
    return project_tests_bounds_outcome(program, outcome, report, asserts, sharing)
}

/// What `--bless` did with one test.
pub enum ProjectTestsBlessed {
    Unchanged,
    Written,
    /// Not blessed, and why.
    Refused(String),
}

/// Print a blessed test's line, and say whether it passed: one that could
/// not be blessed failed.
fn project_tests_blessed_line(label: String, blessed: ref ProjectTestsBlessed) -> bool throws {
    match blessed {
        ProjectTestsBlessed::Unchanged => println(f"{label} ... ok"),
        ProjectTestsBlessed::Written => println(f"{label} ... blessed"),
        ProjectTestsBlessed::Refused(why) => {
            println(f"{label} ... FAILED ({why}, so it is not blessed)")
            return false
        },
    }
    return true
}

/// `--bless` for a test program: `NAME.stdout` and `NAME.stderr` are written
/// from what happened, a refusal into `NAME.stderr` only, where it has one or
/// `stderr` says so, else it fails (#1236), `NAME.stdout` made where the
/// test has none and printed something (#1238), `NAME.stderr` made likewise
/// where `stderr` (`--bless-stderr`) says so, and the `--bounds`,
/// `--asserts` and `--sharing` reports into the `NAME.bounds`,
/// `NAME.asserts` and `NAME.sharing` there are (#1069, #1907). A program that
/// built and ended unsuccessfully, or whose settings disagree, is not blessed;
/// one that stopped is, into its `NAME.stops`, where it has one, never a new
/// one: a stop nobody declared stays a failure (#1260).
fn project_tests_bless_program(program: ref ProgramTest, outcomes: ref Vec[(String, ProjectTestsOutcome)], stderr: bool) -> ProjectTestsBlessed throws {
    if outcomes.is_empty() {
        return ProjectTestsBlessed::Unchanged
    }
    if !project_tests_agree(outcomes) {
        return ProjectTestsBlessed::Refused("the settings disagree")
    }
    let first = outcomes[0].1
    let refused = !first.ended_well && !first.stopped && is_refusal(first.stderr)
    let stops = first.stopped && program.stops != null
    // A refusal is an expectation only where a `.stderr` holds one, or
    // `--bless-stderr` asks for a new one: else it fails like at a plain run
    // and nothing is written (#1236).
    if refused && program.stderr == null && !stderr {
        return ProjectTestsBlessed::Refused("the program is refused and no .stderr expects it")
    }
    if !first.ended_well && !refused && !stops && first.stderr.starts_with("the program does not compile") {
        return ProjectTestsBlessed::Refused("the program does not compile")
    }
    if !first.ended_well && !refused && !stops {
        return ProjectTestsBlessed::Refused("the program did not end successfully")
    }
    if !stops && program.stops != null {
        return ProjectTestsBlessed::Refused("the program did not stop, as its .stops expects")
    }
    // A test with no `.stdout` passes whatever it prints: what it printed
    // becomes its expectation (#1238). A new `.stderr` for warnings or what
    // the program wrote there is made only at `--bless-stderr`.
    let new_stdout = !refused && program.stdout == null && !first.stdout.is_empty()
    let new_stderr = stderr && !refused && !stops && program.stderr == null && !first.stderr.is_empty()
    if first.passed && !new_stdout && !new_stderr {
        return ProjectTestsBlessed::Unchanged
    }
    if !refused && (program.stdout != null || new_stdout) {
        fs::write(program.dir.join(f"{program.name}.stdout"), fs::Root::Anywhere, first.stdout.clone())
    }
    if stops {
        fs::write(program.dir.join(f"{program.name}.stops"), fs::Root::Anywhere, first.stderr.bytes)
    } else if refused || program.stderr != null || new_stderr {
        fs::write(program.dir.join(f"{program.name}.stderr"), fs::Root::Anywhere, first.stderr.bytes)
    }
    for (name, _, got) in first.bounds {
        fs::write(program.dir.join(name), fs::Root::Anywhere, got.clone())
    }
    return ProjectTestsBlessed::Written
}

/// What a test wrote to standard error, `written`, against what it should
/// have, `want` (its `.stderr`, or its `.stops`, #1260), as differences.
fn project_tests_explain_said(want: ref Bytes, written: ref Bytes) throws {
    if want != written {
        println("standard error (- expected, + written):")
        print(project_tests_difference(want, written))
    }
}

/// **What an output test got wrong, as differences**
/// ([ADR-247](../../../docs/specification/adr/adr-247.md) D4).
fn project_tests_explain_output(output: ref OutputTest, outcome: ref ProjectTestsOutcome) throws {
    match output.stops {
        null => {
            if !outcome.ended_well {
                println("the program did not end successfully")
            }
        },
        else => {
            if !outcome.stopped {
                println("the program did not stop, as its .stops expects")
            }
        },
    }
    match output.stdout {
        null => {},
        want => {
            if want != outcome.stdout {
                println("standard output (- expected, + printed):")
                print(project_tests_difference(want, outcome.stdout))
            }
        },
    }
    // A `.stops` is what standard error must hold, in place of a `.stderr`.
    match output.stops {
        null => {
            match output.stderr {
                null => {},
                want => project_tests_explain_said(want, outcome.stderr.bytes),
            }
        },
        want => project_tests_explain_said(want, outcome.stderr.bytes),
    }
    for (wanted, written) in output.files.iter().zip(outcome.files.iter()) {
        let relative = wanted.0
        let want = wanted.1
        match written.1 {
            null => println(f"{relative}: not written"),
            got => {
                if got != want {
                    println(f"{relative} (- expected, + written):")
                    print(project_tests_difference(want, got))
                }
            },
        }
    }
}

/// **`--bless`** ([ADR-247](../../../docs/specification/adr/adr-247.md) D3):
/// what the program printed becomes `NAME.stdout`, where the test has one,
/// and each file it wrote becomes the `NAME.out/` entry of that name. Only a
/// run that ended successfully, or one that stopped where the test has a
/// `NAME.stops` (rewritten, never made: a stop nobody declared stays a
/// failure, #1260), and at two settings only one whose runs
/// agree: a difference between the settings is a fault, never an expectation.
fn project_tests_bless(output: ref OutputTest, outcomes: ref Vec[(String, ProjectTestsOutcome)]) -> ProjectTestsBlessed throws {
    if outcomes.is_empty() {
        return ProjectTestsBlessed::Unchanged
    }
    if !project_tests_agree(outcomes) {
        return ProjectTestsBlessed::Refused("the settings disagree")
    }
    let first = outcomes[0].1
    let stops = first.stopped && output.stops != null
    if !first.ended_well && !stops {
        return ProjectTestsBlessed::Refused("the program did not end successfully")
    }
    if !stops && output.stops != null {
        return ProjectTestsBlessed::Refused("the program did not stop, as its .stops expects")
    }
    if first.files.iter().any(fn(file) { file.1 == null }) {
        return ProjectTestsBlessed::Refused("a file its .out/ names was not written")
    }
    if first.passed {
        return ProjectTestsBlessed::Unchanged
    }
    if output.stdout != null {
        fs::write(output.dir.join(f"{output.name}.stdout"), fs::Root::Anywhere, first.stdout.clone())
    }
    if stops {
        fs::write(output.dir.join(f"{output.name}.stops"), fs::Root::Anywhere, first.stderr.bytes)
    } else if output.stderr != null {
        fs::write(output.dir.join(f"{output.name}.stderr"), fs::Root::Anywhere, first.stderr.bytes)
    }
    for (relative, got) in first.files {
        fs::write(output.dir.join(f"{output.name}.out").join(relative), fs::Root::Anywhere, match got {
            null => Bytes([]),
            written => written.clone(),
        })
    }
    return ProjectTestsBlessed::Written
}

/// **A test that failed** (`run_tests`'s list): its line's label, what each
/// setting did, and the output test it is, where it is one.
pub struct ProjectTestsFailed {
    pub label: String,
    pub outcomes: Vec[(String, ProjectTestsOutcome)],
    pub output: OutputTest?,
}

/// What `project_tests_run` asks of the compiler (`project.rs`'s
/// `TestsHost`): each run of a built program in a sandbox of its own, and the
/// test programs, which build and run on the host's workers. A refusal of a
/// `throws` method is kept there and handed back unchanged.
pub trait ProjectTestsHost {
    /// Runs test block `k` with the test build `binary`, in the package's
    /// directory: how it ended and what it printed.
    fn block_outcome(ref self, binary: ref fs::Path, k: i64) -> ProjectTestsOutcome sync throws
    /// Runs `output` with the program `binary`, its inputs copied into its
    /// sandbox: what it did.
    fn output_outcome(ref self, binary: ref fs::Path, output: ref OutputTest) -> ProjectTestsOutcome sync throws
    /// Runs the test programs, each one's line said by
    /// `project_tests_program_done` in the order of the programs; the ones
    /// that failed.
    fn program_failures(ref self, bless: bool, stderr: bool) -> Vec[ProjectTestsFailed] sync throws
}

/// **One test program's line**, blessed where `bless` says (and a new
/// `NAME.stderr` made where `stderr` does): the failure, where it failed.
pub fn project_tests_program_done(program: ref ProgramTest, outcomes: Vec[(String, ProjectTestsOutcome)], bless: bool, stderr: bool) -> ProjectTestsFailed? throws {
    let label = project_tests_program_label(program)
    if bless {
        let blessed = project_tests_bless_program(program, outcomes, stderr)
        if !project_tests_blessed_line(label, blessed) {
            return ProjectTestsFailed { label: label, outcomes: outcomes, output: null }
        }
        return null
    }
    if !project_tests_verdict(label, outcomes) {
        return ProjectTestsFailed { label: label, outcomes: outcomes, output: null }
    }
    return null
}

/// **The failures' report** (`run_tests`): each failed test's label, then
/// what it did - once where the settings agree, else at each setting - with a
/// test program's standard output read as UTF-8 lossily (#1182) and each
/// standard error as it came.
pub fn project_tests_report_failures(failed: ref Vec[ProjectTestsFailed]) throws {
    if failed.is_empty() {
        return
    }
    println("\nfailures:")
    for one in failed {
        println(f"\n--- {one.label}")
        let agree = project_tests_agree(one.outcomes)
        let shown = match agree {
            true => 1,
            false => one.outcomes.len(),
        }
        for (setting, outcome) in one.outcomes[0..<shown] {
            if !agree {
                println(f"at user-parallelism = {setting}:")
            }
            match one.output {
                null => {
                    print(outcome.stdout.text_lossy())
                    project_tests_explain_bounds(outcome)
                }
                output => project_tests_explain_output(output, outcome),
            }
            // The child's stderr is several lines and untrusted (ADR-398): escape
            // each line by hand, so the lines stay lines.
            for line in outcome.stderr.lines() {
                eprintln(text::escape_control(line.clone()))
            }
        }
    }
}

/// **Run each test in a process and a directory of its own, and say how each
/// went** ([ADR-269](../../../docs/specification/adr/adr-269.md) D1, D12, D13;
/// [ADR-247](../../../docs/specification/adr/adr-247.md)): the `test` blocks
/// (`blocks`, each its title, file and line) at each of `test_builds`, the
/// output tests at each of `programs`, then the test programs: the ones that
/// failed, for the failures' report (`project_tests_report_failures`).
///
/// A `test` block fails on an error that leaves it, a false `assert` or a
/// `panic` - each of which ends its process unsuccessfully. An output test
/// fails where the program does not end successfully, or prints anything but
/// its `.stdout`, or leaves any file its `.out/` names other than byte for
/// byte. At two settings either fails as well where the two outcomes differ,
/// because the meaning of a program is the same at both (Part I 1.2) and a
/// difference is a fault of this compiler. A failing test does not stop the
/// others.
pub fn project_tests_run[H: ProjectTestsHost](host: ref H, blocks: ref Vec[(String, fs::Path, i64)], test_builds: ref Vec[(String, fs::Path)], outputs: ref Vec[OutputTest], programs: ref Vec[(String, fs::Path)], program_tests: i64, root: ref fs::Path, bless: bool, stderr: bool) -> Vec[ProjectTestsFailed] throws {
    let total = blocks.len() + outputs.len() + program_tests
    project_tests_running(total)
    let mut failed: Vec[ProjectTestsFailed] = []
    for (k, (title, path, line)) in blocks.iter().enumerate() {
        let mut outcomes: Vec[(String, ProjectTestsOutcome)] = []
        for (setting, binary) in test_builds {
            outcomes.push((setting.clone(), host.block_outcome(binary, k)))
        }
        let label = f"test \"{title}\" ({shown_path(path, root)}:{line})"
        if !project_tests_verdict(label, outcomes) {
            failed.push(ProjectTestsFailed { label: label, outcomes: outcomes, output: null })
        }
    }
    for output in outputs {
        let mut outcomes: Vec[(String, ProjectTestsOutcome)] = []
        for (setting, binary) in programs {
            outcomes.push((setting.clone(), host.output_outcome(binary, output)))
        }
        let label = project_tests_output_label(output)
        if bless {
            let blessed = project_tests_bless(output, outcomes)
            if !project_tests_blessed_line(label, blessed) {
                failed.push(ProjectTestsFailed { label: label, outcomes: outcomes, output: output.clone() })
            }
            continue
        }
        if !project_tests_verdict(label, outcomes) {
            failed.push(ProjectTestsFailed { label: label, outcomes: outcomes, output: output.clone() })
        }
    }
    for program in host.program_failures(bless, stderr) {
        failed.push(program)
    }
    return failed
}

/// **Whether `nikaia test --filter` runs the test named `name`** (#1238):
/// every test where no filter is given, else the ones whose name holds one of
/// the texts.
pub fn project_tests_wanted(name: ref String, filters: ref Vec[String]) -> bool {
    return filters.is_empty() || filters.iter().any(fn(text) { name.contains(text) })
}
