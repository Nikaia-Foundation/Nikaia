// **One build for a package's test programs** (owner, 2026-11-14: CI in
// minutes, not 40-70). `nikaia test` built every `tests/NAME.nika` as a
// package of its own: one `nikaia build`, one Cargo and one `rustc` per
// program and setting, 2600 of each for tests/compiler, and the Cargo builds
// waited for one another on the shared build directory's lock. Here the
// programs of one setting are lowered by one wrapper process, each as a module
// of one crate, and built by one `rustc`; a dispatcher `main` runs the program
// its first argument names. Each test still runs in a process of its own
// (ADR-269 D1, D22); only the build is shared.
//
// **The batch only speeds a test up, it never decides one**: a program the
// batch leaves out (it does not lower alone, it has a `.bounds` or `.asserts`
// report, its chunk did not compile) and a program whose batched run did not
// pass is built and run alone, as before, and that run is the verdict.

use std::env
use std::fs
use std::collections
use std::text

/// The variable that hands the wrapper the list of programs to build as one
/// crate: a file of `NAME<TAB>ENTRY` lines. Beside it the wrapper writes
/// `LIST.included`, the names of the programs the crate holds, and
/// `LIST.modules`, where each module is ([`project_batch_ranges`]); the build
/// of a batch that failed keeps what rustc said in `LIST.said` (#1582).
pub fn project_batch_var() -> String {
    return "NIKAIA_TEST_BATCH"
}

/// **A lowered program as the module `p{k}` of the batch**, or nothing where
/// it has no `main` the batch can call. The emitter lowered it as that module
/// (`lower_batch`, #1582): paths to the crate root name the module, `main` and
/// the types its signature names are `pub`, and the allocator is the batch's.
/// So it is only wrapped. A `main` the emitter wrote `pub` starts a line; a
/// program whose own `main` it does not wrap (ADR-360 D1) has none, and is
/// built alone.
fn project_batch_module(k: i64, rust: ref String) -> String? {
    if !rust.starts_with("pub fn main(") && !rust.contains("\npub fn main(") {
        return null
    }
    return f"pub mod p{k} " + "{\n" + rust + "\n}\n"
}

/// **The header of the batch's crate**: what comes before its modules.
fn project_batch_header() -> String {
    return "#![allow(warnings)]\n#[global_allocator]\nstatic NIKAIA_HEAP: nikaia_std::block::Counting = nikaia_std::block::Counting;\n"
}

/// **Where each module is in the batch's crate** (#1582), the lines of
/// `LIST.modules`: `NAME\tFIRST\tLAST`, the lines of the generated file the
/// module `modules[k]` of the program `names[k]` holds, counted from 1. What
/// rustc says about a line names the program to leave out
/// ([`project_batch_cited`]).
fn project_batch_ranges(names: ref Vec[String], modules: ref Vec[String]) -> String {
    let mut first = project_batch_header().lines().count() + 1
    let mut parts: Vec[String] = []
    for (name, module) in names.iter().zip(modules.iter()) {
        let last = first + module.lines().count() - 1
        parts.push(f"{name}\t{first}\t{last}\n")
        first = last + 1
    }
    return parts.join("")
}

/// **The programs what rustc said is about** (#1582): every line of the
/// batch's generated file (`FILE.rs:LINE`) that `said` cites, as the program
/// whose module holds it by `ranges` ([`project_batch_ranges`]). A note that
/// points into another module names that one too; it is then built alone,
/// which never changes a verdict.
fn project_batch_cited(said: ref String, ranges: ref String, file: ref String) -> Vec[String] {
    let mut lines: Vec[i64] = []
    for piece in said.split(f"{file}.rs:").skip(1) {
        let digits: String = piece.scalars.take_while(fn(c) { c.is_ascii_digit() }).collect()
        let line = text::parse_i64(digits) ?? continue
        lines.push(line)
    }
    let mut cited: Vec[String] = []
    for range in ranges.lines() {
        let parts: Vec[String] = range.split("\t").map(fn(part) { part.clone() }).collect()
        if parts.len() != 3 {
            continue
        }
        let first = text::parse_i64(parts[1]) ?? continue
        let last = text::parse_i64(parts[2]) ?? continue
        if lines.iter().any(fn(line) { line >= first && line <= last }) {
            cited.push(parts[0].clone())
        }
    }
    return cited
}

/// **The batch's crate**: the allocator once, every module, and the
/// dispatcher. `names[k]` is the program the module `p{ks[k]}` holds;
/// `main`'s result is reported as a `main` of its own would report it, so the
/// exit code and what is written on an error are the same.
fn project_batch_crate(names: ref Vec[String], ks: ref Vec[i64], modules: ref Vec[String]) -> String {
    let mut parts: Vec[String] = [project_batch_header()]
    for module in modules {
        parts.push(module.clone())
    }
    parts.push("fn main() -> std::process::ExitCode {\n    match std::env::args().nth(1).as_deref().unwrap_or(\"\") {\n")
    for (name, k) in names.iter().zip(ks.iter()) {
        parts.push(f"        {name:?} => std::process::Termination::report(p{k}::main()),\n")
    }
    parts.push("        _ => std::process::ExitCode::from(2),\n    }\n}\n")
    return parts.join("")
}

/// **What the wrapper builds for a batch** (`project_drive_wrapper`, where
/// [`project_batch_var`] is set and the crate is the program): every program
/// of `list` lowered as the module `p{k}` (`lower_batch`, on every core), the
/// ones that lower made modules of one crate, their names written to
/// `LIST.included` and where each module is to `LIST.modules`. The Rust,
/// and every source the programs read.
fn project_batch_lowered[H: ProjectDriveWrapperHost](host: ref H, list: ref fs::Path, no_cache: bool) -> (String, Vec[fs::Path]) throws {
    let text = fs::read_to_string(list, fs::Root::Anywhere) catch { throw ProjectDriveRefusal::Failed(f"reading the batch list {list.display()}: {error}") }
    let mut listed: Vec[String] = []
    let mut entries: Vec[fs::Path] = []
    let mut roots: Vec[String] = []
    for line in text.lines() {
        let (name, entry) = line.split_once("\t") ?? continue
        let path: fs::Path = entry
        roots.push(f"crate::p{listed.len()}")
        listed.push(name.clone())
        entries.push(path)
    }
    let lowered = host.lower_batch(entries, roots, no_cache)
    let mut names: Vec[String] = []
    let mut ks: Vec[i64] = []
    let mut modules: Vec[String] = []
    let mut sources: Vec[fs::Path] = []
    for (k, made) in lowered.iter().enumerate() {
        // The host hands back one answer per program of the list it was
        // given, read from outside (ADR-396 D2, #2371).
        if k >= listed.len() {
            continue
        }
        let (rust, read) = made ?? continue
        let module = project_batch_module(k, rust) ?? continue
        names.push(listed[k].clone())
        ks.push(k)
        modules.push(module)
        for source in read {
            sources.push(source.clone())
        }
    }
    let included = list.with_extension("included")
    fs::write(included, fs::Root::Anywhere, names.iter().map(fn(name) { name.clone() + "\n" }).collect().join("")) catch { throw ProjectDriveRefusal::Failed(f"writing {included.display()}: {error}") }
    let ranges = list.with_extension("modules")
    fs::write(ranges, fs::Root::Anywhere, project_batch_ranges(names, modules)) catch { throw ProjectDriveRefusal::Failed(f"writing {ranges.display()}: {error}") }
    return (project_batch_crate(names, ks, modules), sources)
}
