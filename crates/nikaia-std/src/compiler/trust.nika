// crates/nikaia-std/src/compiler/trust.nika
//
// **What `--trust` says about a program** (ADR-010 D7, ADR-108 D4): which
// sources it reads and who chose their bytes, and every file access whose
// root is a word rather than a directory.
//
// The second module of the ring after the tree (ADR-294) moved from Rust
// to Nikaia, by ADR-rust-boundary-1's route: lowered by `nikaia lower-std` to `trust.rs`
// beside it, `include!`d as `nikaia_std::compiler::trust`, and called from the
// compiler's `contracts::trust`.
//
// **What moved is the module's decisions**: which written root is a way
// around the root check, and what the report says. What stays Rust is what
// it reads, the ledger and the call walk (ADR-294 D2): the compiler's
// `contracts::trust` finds the calls, asks the ledger who chose a source's
// bytes and which parameter is a root, and hands this module plain data - a
// name, a `bool`, a line and a column.

/// Which of the two spellings ADR-108 D4 lists a root is.
pub enum Wrote {
    /// `fs::Root::Anywhere`: no check, and the program answers for the name.
    Anywhere,
    /// `fs::Root::Dir("/")`: a check whose root is everything, which is
    /// `Anywhere` with more characters.
    TheFilesystemRoot,
}

/// How the report names it.
pub fn spelled(wrote: Wrote) -> String {
    return match wrote {
        Wrote::Anywhere => "Anywhere",
        Wrote::TheFilesystemRoot => "Dir(\"/\") - which is every directory",
    }
}

/// The root an argument writes, where it is one the review wants to see:
/// `Root::Anywhere`, or `Root::Dir("/")`, under whatever module path.
fn written_root(names: ref winnow_grammar::InternerContext, arg: ref Expr) -> Wrote? {
    return match arg {
        Expr::Path(segments, _) => if ends_with_variant(names, segments, "Anywhere") { Wrote::Anywhere } else { null },
        Expr::Call { func, args, .. } => the_whole_filesystem(names, func, args),
        else => null,
    }
}

/// `Root::Dir("/")`, and no other directory.
fn the_whole_filesystem(names: ref winnow_grammar::InternerContext, func: ref Expr, args: ref Vec[Expr]) -> Wrote? {
    let is_dir = match func {
        Expr::Path(segments, _) => ends_with_variant(names, segments, "Dir"),
        else => false,
    }
    return null if !is_dir || args.len() == 0
    return match args[0] {
        Expr::LitStr { text, .. } => if text == "/" { Wrote::TheFilesystemRoot } else { null },
        else => null,
    }
}

/// Whether a path ends `Root::<variant>`.
fn ends_with_variant(names: ref winnow_grammar::InternerContext, segments: ref Vec[winnow_grammar::Symbol], variant: ref String) -> bool {
    let n = segments.len()
    return n >= 2 && names.resolve(segments[n - 2]) == "Root" && names.resolve(segments[n - 1]) == variant
}

/// A source the program calls, and whether someone else chose its bytes.
pub struct Reason {
    pub source: String,
    pub untrusted: bool,
    /// Where a call wrote `trusted: true` (ADR-365 D2), as `file:line`, or
    /// empty where the ledger's provenance is the answer.
    pub marked_at: String,
}

/// **Whether a call writes `trusted: true`** (ADR-365 D2, ADR-010 D3): the
/// one marker that makes a source's bytes the operator's. Only the literal
/// counts: a value worked out while the program runs says nothing the
/// compiler can read, so the source stays as untrusted as its ledger says
/// (fail closed).
fn says_trusted(names: ref winnow_grammar::InternerContext, config: ref Vec[ConfigArg]) -> bool {
    for option in config {
        if names.resolve(option.name) == "trusted" {
            return match option.value {
                Expr::LitBool(value, _) => value,
                else => false,
            }
        }
    }
    return false
}

/// **The meta-variables a CGI host fills** (ADR-397 D2, RFC 3875 4.1):
/// a stranger's request chose their bytes, as it chose every `HTTP_` name's.
fn host_names() -> Vec[String] {
    return ["AUTH_TYPE", "CONTENT_LENGTH", "CONTENT_TYPE", "GATEWAY_INTERFACE", "PATH_INFO", "PATH_TRANSLATED", "QUERY_STRING", "REMOTE_ADDR", "REMOTE_HOST", "REMOTE_IDENT", "REMOTE_USER", "REQUEST_METHOD", "SCRIPT_NAME", "SERVER_NAME", "SERVER_PORT", "SERVER_PROTOCOL", "SERVER_SOFTWARE"]
}

/// **Whether a host may fill a variable this argument reaches** (ADR-397
/// D2): for `"name"`, the name starts with `HTTP_` or is a meta-variable;
/// for `"prefix"`, a name the list holds can start with it (`""`, `"H"`,
/// `"HTTP_X"`, `"REMOTE"`).
fn reaches_a_host_name(by: ref String, written: ref String) -> bool {
    if written.starts_with("HTTP_") {
        return true
    }
    for name in host_names() {
        if by == "prefix" && name.starts_with(written) || name == written {
            return true
        }
    }
    return by == "prefix" && "HTTP_".starts_with(written)
}

/// **Whether a read of the environment hands back the operator's text**
/// (ADR-397 D1, D2): the source decides it by its first argument
/// (`provenance_by`), `first` is that argument where it is a literal, and
/// no name a CGI host fills is reached. A name not known while building
/// is the stranger's; so is every name where the build's environment is
/// `"untrusted"`, which leaves `provenance_by` empty (D4).
pub fn read_by_operator(contract: ref FnContract, first: String?) -> bool {
    if contract.provenance_by.is_empty() {
        return false
    }
    let written = first ?? return false
    return !reaches_a_host_name(contract.provenance_by, written)
}

/// The first argument of a call, where it is a string literal with no hole.
pub fn first_literal(args: ref Vec[Expr]) -> String? {
    let first = args.get(0) ?? return null
    return match first {
        Expr::LitStr { text, .. } => text.clone(),
        else => null,
    }
}

/// Whether a call by name of `source` reads the operator's text (ADR-397
/// D1, D2), as `read_by_operator` decides it.
pub fn operator_read(library: ref Ledger, source: ref String, args: ref Vec[Expr]) -> bool {
    let contract = library.functions[source] ?? return false
    return read_by_operator(contract, first_literal(args))
}

/// **One call of a source** (ADR-365 D2): the function it stands in and
/// the source, both as the ledger keys them, whether it is a method, and
/// whether it wrote `trusted: true`. `at` is the first byte of the
/// statement it stands in, the place `--trust` names too.
pub struct SourceCall {
    pub function: String,
    pub source: String,
    pub method: bool,
    pub marked: bool,
    pub at: i64,
}

/// **Every call of a source in a file** (ADR-365 D2, ADR-010 D3), in each
/// function and method body, its lambdas and its tasks included. A call by
/// name is a source where `library` says so; a method call where the
/// checker resolved it (`callees`, by the receiver's node) to an entry with
/// a provenance.
pub fn source_calls(program: ref Program, names: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync) -> Vec[SourceCall] {
    let mut out: Vec[SourceCall] = []
    for item in program.items {
        match item.node {
            Item::Fn { name, body, .. } => {
                let key = key_of_function(name, "", names)
                sc_block(key, body, names, library, callees, holes_of, out)
            }
            Item::Impl { target, methods, .. } => {
                let owner = names.resolve(target.name).clone()
                for method in methods {
                    match method.node {
                        Item::Fn { name, body, .. } => {
                            let key = key_of_function(name, owner, names)
                            sc_block(key, body, names, library, callees, holes_of, out)
                        }
                        else => {}
                    }
                }
            }
            else => {}
        }
    }
    return out
}

fn sc_block(function: ref String, block: ref Block, names: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync, mut out: Vec[SourceCall]) {
    for stmt in block.stmts {
        let at = stmt.span.start as i64
        for expr in check_visit_stmt(stmt.node) {
            sc_expr(function, expr, at, names, library, callees, holes_of, out)
        }
        for inner in check_visit_stmt_blocks(stmt.node) {
            sc_block(function, inner, names, library, callees, holes_of, out)
        }
    }
}

fn sc_expr(function: ref String, expr: ref Expr, at: i64, names: ref winnow_grammar::InternerContext, library: ref Ledger, callees: ref collections::BTreeMap[i64, String], holes_of: fn(ref Expr) -> Vec[Expr] sync, mut out: Vec[SourceCall]) {
    match expr {
        Expr::Call { func, config, .. } => {
            let name = match func {
                Expr::Variable(one, _) => names.resolve(one).clone(),
                Expr::Path(segments, _) => written_path(names, segments),
                else => "",
            }
            if a_source(library, name) {
                out.push(sc_call(function, name, false, config, at, names))
            }
        }
        Expr::MethodCall { receiver, config, .. } => {
            let key: String = callees.get(id_of(receiver) as i64)?.clone() ?? ""
            if a_source(library, key) {
                out.push(sc_call(function, key, true, config, at, names))
            }
        }
        // **A task's body is the function's text** (ADR-010 D3): a marker
        // there is written in it as anywhere else.
        Expr::Spawn { body, .. } => {
            for inner in check_visit_expr_blocks(body) {
                sc_block(function, inner, names, library, callees, holes_of, out)
            }
        }
        else => {}
    }
    if check_visit_has_holes(expr) {
        for hole in holes_of(expr) {
            for inner in check_visit_preorder(hole) {
                sc_expr(function, inner, at, names, library, callees, holes_of, out)
            }
        }
    }
}

fn sc_call(function: ref String, source: ref String, method: bool, config: ref Vec[ConfigArg], at: i64, names: ref winnow_grammar::InternerContext) -> SourceCall {
    return SourceCall { function: function.clone(), source: source.clone(), method: method, marked: says_trusted(names, config), at: at }
}

/// **The `trusted` key of each function this file holds** (Part III 13.5,
/// ADR-365 D2): every marked call, `SOURCE at FILE:LINE`, sorted by place.
/// `file` is the file as the ledger's `[sources]` names it. A function the
/// ledger has no entry for gets none.
pub fn mark_trusted(mut ledger: Ledger, calls: ref Vec[SourceCall], file: ref String, text: ref String) {
    let mut marks: Vec[(String, i64, String)] = []
    for call in calls {
        if call.marked && ledger.functions.contains_key(call.function) {
            let line = line_of_byte(text, call.at)
            marks.push((call.function.clone(), call.at, f"{call.source} at {file}:{line}"))
        }
    }
    marks.sort()
    for (function, _, mark) in marks {
        let mut entry = ledger.functions.get(function)?.clone() ?? continue
        entry.trusted.push(mark.clone())
        ledger.functions.insert(function.clone(), entry)
    }
}

/// What `--trust` names for `main`'s parameters (ADR-399 D1).
pub fn main_parameters_source() -> String {
    return "the command line, through `main`'s parameters,"
}

/// **Whether the file's free `main` takes parameters** (ADR-cli-v1 D1,
/// ADR-399 D1): they are read from the words of the command line, so they
/// are an untrusted source with no call to see. No marker makes them
/// trusted (owner, 2026-11-14): `cli::args(trusted: true)` is the way.
pub fn takes_the_command_line(program: ref Program, names: ref winnow_grammar::InternerContext) -> bool {
    for item in program.items {
        match item.node {
            Item::Fn { name, receiver, args, config, .. } => {
                let called = name ?? continue
                if receiver == null && names.resolve(called) == "main" && (args.len() > 0 || config.len() > 0) {
                    return true
                }
            }
            else => {}
        }
    }
    return false
}

/// Whether `library` describes `name` as a source: an entry with a
/// provenance (ADR-010 D2).
fn a_source(library: ref Ledger, name: ref String) -> bool {
    let contract = library.functions[name] ?? return false
    return contract.provenance != null
}

/// The 1-based line the byte `at` of `text` stands on.
fn line_of_byte(text: ref String, at: i64) -> i64 {
    let mut line = 1
    let mut i = 0
    for b in text.bytes() {
        if i >= at {
            break
        }
        if b == 10 {
            line += 1
        }
        i += 1
    }
    return line
}

/// A call that wrote a root the review wants to see, where it stands.
pub struct Place {
    pub line: i64,
    pub column: i64,
    pub entry: String,
    pub wrote: Wrote,
}

/// The report `--trust` prints for one file.
pub fn render(untrusted: bool, reasons: ref Array[Reason], places: ref Array[Place], path: ref String) -> String {
    let mut out = f"input provenance: {provenance(untrusted)}\n"
    if reasons.len() == 0 {
        out.push_str("    no source is read, so nothing entered from outside\n")
    }
    for reason in reasons {
        if reason.marked_at.is_empty() {
            out.push_str(ref f"    {reason.source} is {provenance(reason.untrusted)}\n")
        } else {
            out.push_str(ref f"    {reason.source} is {provenance(reason.untrusted)}: `trusted: true` at {reason.marked_at}\n")
        }
    }
    let hash = if untrusted {
        "keyed, per-process random seed - key choice cannot be aimed at the table"
    } else {
        "fast, fixed seed - no adversary chooses these keys"
    }
    out.push_str(ref f"hash for a map keyed by the input: {hash}\n")
    out.push_str("file access with no root to check against:\n")
    if places.len() == 0 {
        out.push_str("    none - every path here names a directory it may not leave\n")
    }
    for place in places {
        out.push_str(ref f"    {path}:{place.line}:{place.column}  {place.entry} writes {spelled(place.wrote)}\n")
    }
    return out
}

/// **The raw sinks the build lets data from outside reach unproved**, as
/// `--trust` lists them (ADR-raw-sinks-1 D4, D5, D10, D15): each word of the
/// application's `[allow]`, a dependency's as `NAME:key`, then each
/// `--allow`, as the build resolved them.
pub fn render_allowed(allow: ref Vec[String]) -> String {
    let mut out: String = "raw sinks allowed data from outside unproved ([allow] and --allow):\n"
    if allow.len() == 0 {
        out.push_str("    none - every raw sink asks for a proof\n")
    }
    for word in allow {
        out.push_str(ref f"    {word}\n")
    }
    return out
}

fn provenance(untrusted: bool) -> String {
    return if untrusted { "untrusted" } else { "trusted" }
}

// **Which maps are keyed by what the program wrote itself** (ADR-010 D2), the
// walk the compiler's `contracts::trust` ran in Rust, moved (ADR-294, #125).
//
// A map made by `HashMap()` or `HashSet()` gets the fast fixed-seed hash when
// everything that ever becomes one of its keys is made only of what the
// program wrote and of what a trusted source handed back, each name followed
// to the binding it reads.
//
// **Everything not seen is untrusted** (D1, a barrier widens): a parameter, a
// pattern's binding, a function of the program's own, a method that is a
// source somewhere in `std` by its name, and any shape this does not read. A
// map that gets the keyed hash needlessly is slower; the opposite is an
// attack.

use std::collections

/// What a value is made of: the bindings it reads, or `known: false` where
/// something in it is never trusted.
struct KeyDeps {
    known: bool,
    ids: Vec[i64],
    /// The source that made it untrusted, where one did; empty for a value
    /// that is not followed (ADR-398 D5 names it).
    why: String,
}

/// The names a body's functions share, which the walk of one does not change.
struct MapEnv {
    /// A method is a source where `std` names one by that name, whatever it
    /// is called on.
    sources: collections::BTreeSet[String],
    /// The functions whose result counts as trusted whatever they are given:
    /// `text::escape_control` for the log (ADR-398 D4), none for a map,
    /// whose hash an escaped key still aims at.
    cleaners: collections::BTreeSet[String],
    /// The functions of the program's own.
    own: collections::BTreeSet[String],
    /// The private functions that stand alone (not `pub`, no type parameters,
    /// not `extern`), with their number of parameters: the only ones whose
    /// every caller is seen, so the only ones a map may pass through.
    privates: collections::BTreeMap[winnow_grammar::Symbol, i64],
    /// **The map fields this file follows** (ADR-010 D9, #1607), as
    /// `Struct.field`: a field of a struct the file declares, not `pub` and
    /// with no type parameters, whose type is written `HashMap[..]` or
    /// `HashSet[..]` with no default, and which is not `pub` itself, so no
    /// other file uses it (Part I 9.2). A `pub` struct's map field is a
    /// hidden type parameter instead (D9 step 3).
    map_fields: collections::BTreeSet[String],
    /// The names of those fields: a use `x.counts` is read by the name, as
    /// the walk reads the tree and not the receiver's type, so fields of one
    /// name are one class.
    field_names: collections::BTreeSet[String],
    /// The structs whose literals are followed field by field: declared here,
    /// not `pub`, not `extern`, with no type parameters.
    followed_structs: collections::BTreeSet[String],
}

/// **The classes of the map positions of one file** (ADR-010 D9, #581): a
/// position is a `let` (`l:<start>`), a private function's parameter
/// (`p:<fn>:<n>`) or result (`r:<fn>`). Positions a map passes between are
/// one class (union-find), and the class has one Rust type. A class is keyed
/// where any position in it is `poisoned`: a key that is not trusted reaches
/// it, or a value of it goes somewhere this does not follow. Everything not
/// seen is keyed (D1, a barrier widens).
struct MapClasses {
    parent: collections::BTreeMap[String, String],
    poisoned: collections::BTreeSet[String],
    /// Every `let` that names one binding, by the start of the statement.
    lets: Vec[i64],
    /// Every parameter and result of a function that stands alone.
    slots: Vec[String],
    /// Some function was not read to the end, so what it calls is unknown.
    unread: bool,
    /// The `let`s whose map leaves the function (returned, stored, handed on).
    escaped: Vec[i64],
}

/// The answer: the `let`s and the parameters and results that keep the fast
/// hash in a program that reads untrusted input.
pub struct MapPlan {
    pub lets: collections::BTreeSet[i64],
    pub slots: collections::BTreeSet[String],
    /// The `let`s whose map leaves its function: where the function's
    /// positions are type parameters, such a map may stand at one (D9).
    pub escaped: collections::BTreeSet[i64],
}

/// A `let` that makes a map: the statement, the name, the binding.
struct MapMade {
    at: i64,
    name: winnow_grammar::Symbol,
    id: i64,
}

/// One use of a map, with what the use hands it (the iterable of a `for`
/// hands it nothing).
struct MapKept {
    id: i64,
    deps: KeyDeps,
}

/// One function's bindings, followed lexically.
struct MapWalk {
    /// The class position of each binding, parallel to `given`.
    nodes: Vec[String],
    /// The result position of the function walked.
    ret: String,
    /// Each block's names, innermost last, to the binding they read; `-1` is
    /// one never trusted (a parameter, a pattern's binding).
    scopes: Vec[collections::BTreeMap[winnow_grammar::Symbol, i64]],
    /// What each binding is given.
    given: Vec[Vec[KeyDeps]],
    made: Vec[MapMade],
    kept: Vec[MapKept],
    /// The bindings whose name stands somewhere else: an argument, a value
    /// bound or returned, an assignment.
    escapes: collections::BTreeSet[i64],
    /// How often each name is bound in the body.
    bound: collections::BTreeMap[winnow_grammar::Symbol, i64],
    unread: bool,
    /// The start of the statement walked.
    at: i64,
    /// Each value a log sink is given, judged once the bindings are settled
    /// (ADR-398 D3).
    sinks: Vec[EscSink],
    /// What a use of a map field hands it (#1607), by the field's position,
    /// judged as `kept` is.
    field_kept: Vec[(String, KeyDeps)],
}

/// One value a log sink writes: an f-string's hole or a whole argument, by
/// its node, with what it is made of.
struct EscSink {
    at: i64,
    sink: String,
    key: i64,
    /// A value written whole, not a hole.
    whole: bool,
    deps: KeyDeps,
}

fn tm_never() -> KeyDeps {
    return KeyDeps { known: false, ids: [], why: "" }
}

/// Never trusted, because `source` handed it over.
fn tm_from(source: ref String) -> KeyDeps {
    return KeyDeps { known: false, ids: [], why: source.clone() }
}

fn tm_nothing() -> KeyDeps {
    return KeyDeps { known: true, ids: [], why: "" }
}

fn tm_reading(id: i64) -> KeyDeps {
    return KeyDeps { known: true, ids: [id], why: "" }
}

fn tm_join(a: ref KeyDeps, b: ref KeyDeps) -> KeyDeps {
    if !a.known {
        return KeyDeps { known: false, ids: [], why: if a.why.is_empty() { b.why.clone() } else { a.why.clone() } }
    }
    if !b.known {
        return KeyDeps { known: false, ids: [], why: b.why.clone() }
    }
    let mut ids: Vec[i64] = []
    for id in a.ids {
        ids.push(id)
    }
    for id in b.ids {
        ids.push(id)
    }
    return KeyDeps { known: true, ids: ids, why: "" }
}

fn mc_find(classes: ref MapClasses, node: ref String) -> String {
    let mut at: String = node.clone()
    let mut moving = true
    while moving {
        let up = classes.parent.get(at)
        if up == null {
            moving = false
        } else {
            let next = (up ?? "").clone()
            if next == at {
                moving = false
            } else {
                at = next
            }
        }
    }
    return at
}

fn mc_union(mut classes: MapClasses, a: ref String, b: ref String) {
    let ra = mc_find(classes, a)
    let rb = mc_find(classes, b)
    if ra != rb {
        classes.parent.insert(ra, rb)
    }
}

fn mc_poison(mut classes: MapClasses, node: ref String) {
    classes.poisoned.insert(node.clone())
}

/// The positions of a private function, all keyed: it is used as a value, or
/// called with other than its number of arguments.
fn mc_poison_function(mut classes: MapClasses, name: ref String, arity: i64) {
    let ret = f"r:{name}"
    mc_poison(classes, ret)
    let mut at = 0
    while at < arity {
        let param = f"p:{name}:{at}"
        mc_poison(classes, param)
        at = at + 1
    }
}

/// The names every function of a file shares: the source methods, the
/// program's own functions and its private ones.
fn tm_env(program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger) -> MapEnv {
    let mut env = MapEnv { sources: collections::BTreeSet(), cleaners: collections::BTreeSet(), own: collections::BTreeSet(), privates: collections::BTreeMap(), map_fields: collections::BTreeSet(), field_names: collections::BTreeSet(), followed_structs: collections::BTreeSet() }
    for (key, contract) in library.functions {
        let provenance = contract.provenance ?? continue
        // **A method, by its name**: `net::Connection::read` is read through
        // whatever value has that method. A function of a module, `fs::map`,
        // is called by its path and followed by `tm_call_deps`, so `.map(..)`
        // and `.lines()` on a value of the program's are not sources.
        let a_method = contract.signature?.takes_a_receiver() ?? true
        if provenance == Provenance::Untrusted && a_method {
            let parts: Vec[ref String] = key.split("::").collect()
            env.sources.insert(parts[parts.len() - 1].clone())
        }
    }
    for item in program.items {
        match item.node {
            Item::Fn { name, generics, args, is_public, is_extern, .. } => {
                tm_remember(name, words, env.own)
                if !is_public && !is_extern && generics.len() == 0 {
                    let symbol = name ?? continue
                    env.privates.insert(symbol, args.len())
                }
            },
            Item::Impl { methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { name, .. } => tm_remember(name, words, env.own),
                        else => {}
                    }
                }
            },
            Item::Struct { name, generics, fields, is_public, is_extern, .. } => {
                if !is_public && !is_extern && generics.len() == 0 {
                    let owner = words.resolve(name).clone()
                    env.followed_structs.insert(owner.clone())
                    for field in fields {
                        if !field.is_public && field.default == null && tm_a_map_type(field.ty, words) {
                            let field_name = words.resolve(field.name).clone()
                            env.map_fields.insert(f"{owner}.{field_name}")
                            env.field_names.insert(field_name)
                        }
                    }
                }
            },
            else => {}
        }
    }
    return env
}

/// Whether a written type is `HashMap[..]` or `HashSet[..]`, by its last name.
fn tm_a_map_type(ty: ref Type, words: ref winnow_grammar::InternerContext) -> bool {
    if ty.is_view || ty.is_tuple {
        return false
    }
    let written = words.resolve(ty.name)
    let parts: Vec[ref String] = written.split("::").collect()
    let last = parts[parts.len() - 1]
    return last == "HashMap" || last == "HashSet"
}

/// The class position of a map field, by its name (#1607).
fn tm_field_node(name: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext) -> String {
    return f"f:{words.resolve(name)}"
}

/// Whether `name` is the name of a map field the file follows.
fn tm_a_map_field(name: winnow_grammar::Symbol, words: ref winnow_grammar::InternerContext, env: ref MapEnv) -> bool {
    return env.field_names.contains(words.resolve(name))
}

/// The field a receiver names where it is `x.counts` of a followed map
/// field, else nothing.
fn tm_field_named(receiver: ref Expr, words: ref winnow_grammar::InternerContext, env: ref MapEnv) -> winnow_grammar::Symbol? {
    return match receiver {
        Expr::Field { name, .. } => {
            if tm_a_map_field(name, words, env) { name.clone() } else { null }
        },
        else => null,
    }
}

/// The classes of the maps of one file, and which of them keep the fast hash:
/// the `let`s, parameters and results of every class no untrusted key reaches
/// and nothing unseen touches.
pub fn trusted_maps(program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger) -> MapPlan {
    let env = tm_env(program, words, library)
    let mut classes = MapClasses { parent: collections::BTreeMap(), poisoned: collections::BTreeSet(), lets: [], slots: [], unread: false, escaped: [] }
    // **A map field is a position** (ADR-010 D9, #1607): `f:Struct.field`
    // is the one the emitter asks, one class with `f:field`, which every
    // use by the name reaches.
    for written in env.map_fields {
        let parts: Vec[ref String] = written.split(".").collect()
        let slot = f"f:{written}"
        let by_name = f"f:{parts[parts.len() - 1]}"
        classes.slots.push(slot.clone())
        mc_union(classes, slot, by_name)
    }
    let mut counter = 0
    for item in program.items {
        match item.node {
            Item::Fn { name, generics, args, body, is_public, is_extern, .. } => {
                let mut fname: String = "fn"
                let mut alone = false
                if !is_public && !is_extern && generics.len() == 0 {
                    let symbol = name
                    if symbol != null {
                        fname = words.resolve(symbol ?? continue).clone()
                        alone = true
                    }
                }
                if !alone {
                    counter = counter + 1
                    fname = f"#{counter}"
                }
                tm_walk_function(fname, alone, args, body, words, library, env, classes)
            },
            Item::Impl { methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { args, body, .. } => {
                            counter = counter + 1
                            let fname = f"#{counter}"
                            tm_walk_function(fname, false, args, body, words, library, env, classes)
                        },
                        else => {}
                    }
                }
            },
            Item::Struct { .. } => {},
            Item::Enum { .. } => {},
            Item::Extern { .. } => {},
            Item::Import { .. } => {},
            // A test, a bench, a trait's default, a comptime block or a grammar:
            // code this does not read, which could call any function.
            else => {
                classes.unread = true
            }
        }
    }
    if classes.unread {
        let every = classes.slots.clone()
        for slot in every {
            mc_poison(classes, slot)
        }
    }
    let mut bad: collections::BTreeSet[String] = collections::BTreeSet()
    for node in classes.poisoned {
        bad.insert(mc_find(classes, node))
    }
    let mut plan = MapPlan { lets: collections::BTreeSet(), slots: collections::BTreeSet(), escaped: collections::BTreeSet() }
    plan.escaped.extend(classes.escaped.clone())
    for at in classes.lets {
        let node = f"l:{at}"
        if !bad.contains(mc_find(classes, node)) {
            plan.lets.insert(at)
        }
    }
    for slot in classes.slots {
        if !bad.contains(mc_find(classes, slot)) {
            plan.slots.insert(slot.clone())
        }
    }
    return plan
}

fn tm_remember(name: winnow_grammar::Symbol?, words: ref winnow_grammar::InternerContext, mut own: collections::BTreeSet[String]) {
    let symbol = name ?? return
    own.insert(words.resolve(symbol).clone())
}

fn tm_walk_function(fname: ref String, alone: bool, args: ref Vec[FnArg], body: ref Block, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses) {
    let ret = f"r:{fname}"
    let mut first: collections::BTreeMap[winnow_grammar::Symbol, i64] = collections::BTreeMap()
    let mut walk = MapWalk { nodes: [], ret: ret.clone(), scopes: [], given: [], made: [], kept: [], escapes: collections::BTreeSet(), bound: collections::BTreeMap(), unread: false, at: 0, sinks: [], field_kept: [] }
    if alone {
        classes.slots.push(ret.clone())
    } else {
        mc_poison(classes, ret)
    }
    let mut at = 0
    for arg in args {
        let node = f"p:{fname}:{at}"
        if alone {
            classes.slots.push(node.clone())
        } else {
            mc_poison(classes, node)
        }
        let id = walk.given.len()
        walk.given.push([tm_never()])
        walk.nodes.push(node.clone())
        let name = arg.name.clone()
        walk.made.push(MapMade { at: -1, name: name.clone(), id: id })
        tm_count_binding(name, walk)
        first.insert(name.clone(), id)
        at = at + 1
    }
    walk.scopes.push(first)
    tm_walk_block(body, words, library, env, classes, walk)
    if walk.unread {
        classes.unread = true
        for made in walk.made {
            if made.at >= 0 && walk.escapes.contains(made.id) {
                classes.escaped.push(made.at)
            }
        }
        for node in walk.nodes {
            mc_poison(classes, node)
        }
        mc_poison(classes, ret)
        return
    }
    let trusted = tm_trusted_bindings(walk.given)
    for kept in walk.kept {
        let mut keys_trusted = kept.deps.known
        for dep in kept.deps.ids {
            if !trusted.contains(dep) {
                keys_trusted = false
            }
        }
        if !keys_trusted {
            mc_poison(classes, walk.nodes[kept.id])
        }
    }
    for (field, deps) in walk.field_kept {
        let mut keys_trusted = deps.known
        for dep in deps.ids {
            if !trusted.contains(dep) {
                keys_trusted = false
            }
        }
        if !keys_trusted {
            mc_poison(classes, field)
        }
    }
    // **Any other use is the map leaving**: bound again, returned from a
    // block, assigned, handed to anything but a private function's parameter.
    for id in walk.escapes {
        mc_poison(classes, walk.nodes[id])
    }
    for made in walk.made {
        // Bound once, so every use of the name in the body is this binding.
        if (walk.bound.get(made.name) ?? 0) != 1 {
            mc_poison(classes, walk.nodes[made.id])
        }
        if made.at >= 0 {
            classes.lets.push(made.at)
            if walk.escapes.contains(made.id) {
                classes.escaped.push(made.at)
            }
        }
    }
}

/// Which bindings are trusted: the greatest answer that holds, so a name that
/// feeds itself (`x = x + 1`) is as trusted as what else it is given.
fn tm_trusted_bindings(given: ref Vec[Vec[KeyDeps]]) -> collections::BTreeSet[i64] {
    let mut trusted: collections::BTreeSet[i64] = collections::BTreeSet()
    let mut id = 0
    while id < given.len() {
        let mut every = true
        for one in given[id] {
            if !one.known {
                every = false
            }
        }
        if every {
            trusted.insert(id)
        }
        id = id + 1
    }
    let mut settled = false
    while !settled {
        let mut now: collections::BTreeSet[i64] = collections::BTreeSet()
        now.extend(trusted)
        let mut next: collections::BTreeSet[i64] = collections::BTreeSet()
        for id in now {
            let mut holds = true
            for one in given[id] {
                if !one.known {
                    holds = false
                }
                for dep in one.ids {
                    if !now.contains(dep) {
                        holds = false
                    }
                }
            }
            if holds {
                next.insert(id)
            }
        }
        if next.len() == now.len() {
            settled = true
        }
        trusted = next
    }
    return trusted
}

fn tm_bind(name: winnow_grammar::Symbol, given: ref KeyDeps, node: ref String, mut walk: MapWalk) -> i64 {
    let id = walk.given.len()
    walk.nodes.push(node.clone())
    walk.given.push([KeyDeps { known: given.known, ids: given.ids.clone(), why: given.why.clone() }])
    tm_count_binding(name, walk)
    let last = walk.scopes.len() - 1
    walk.scopes[last].insert(name.clone(), id)
    return id
}

fn tm_opaque(name: winnow_grammar::Symbol, mut walk: MapWalk) {
    tm_count_binding(name, walk)
    let last = walk.scopes.len() - 1
    walk.scopes[last].insert(name.clone(), -1)
}

fn tm_count_binding(name: winnow_grammar::Symbol, mut walk: MapWalk) {
    let before = walk.bound.get(name) ?? 0
    walk.bound.insert(name.clone(), before + 1)
}

/// The binding a name reads here: `-2` where nothing binds it, `-1` where
/// what binds it is never trusted.
fn tm_resolve(name: winnow_grammar::Symbol, walk: ref MapWalk) -> i64 {
    let mut at = walk.scopes.len()
    while at > 0 {
        at = at - 1
        let found = walk.scopes[at].get(name)
        if found != null {
            return found ?? -2
        }
    }
    return -2
}

fn tm_walk_block(block: ref Block, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    walk.scopes.push(collections::BTreeMap())
    for stmt in block.stmts {
        walk.at = stmt.span.start as i64
        match stmt.node {
            Stmt::Let { names, value, .. } => {
                let given = tm_deps_of(value, words, library, env, walk)
                if names.len() == 1 {
                    let name = names[0].clone()
                    let node = f"l:{stmt.span.start}"
                    // **Where the value comes from decides the class**: a
                    // map made here has none to join; a name or a private
                    // function's result is the same class as the let.
                    if is_a_map_made(value, words) {
                        tm_walk_expr(value, words, library, env, classes, walk)
                    } else {
                        tm_flow(node, value, words, library, env, classes, walk)
                    }
                    let id = tm_bind(name, given, node, walk)
                    walk.made.push(MapMade { at: stmt.span.start as i64, name: name.clone(), id: id })
                } else {
                    tm_walk_expr(value, words, library, env, classes, walk)
                    for one in names {
                        tm_opaque(one.clone(), walk)
                    }
                }
            },
            Stmt::Assign { target, value, .. } => {
                // **A map field given a map** (#1607): the value flows into
                // the field's position, as into a `let`'s.
                let field = tm_field_named(target, words, env)
                if field != null {
                    let named = field ?? continue
                    match target {
                        Expr::Field { base, .. } => tm_walk_expr(base, words, library, env, classes, walk),
                        else => {}
                    }
                    tm_flow(tm_field_node(named, words), value, words, library, env, classes, walk)
                    continue
                }
                tm_walk_expr(target, words, library, env, classes, walk)
                tm_walk_expr(value, words, library, env, classes, walk)
                match target {
                    Expr::Variable(name, _) => {
                        let given = tm_deps_of(value, words, library, env, walk)
                        let id = tm_resolve(name.clone(), walk)
                        if id >= 0 {
                            walk.given[id].push(given)
                        }
                    },
                    else => {}
                }
            },
            Stmt::For { bindings, iter, body, .. } => {
                match iter {
                    Expr::Variable(name, _) => {
                        let id = tm_resolve(name.clone(), walk)
                        if id >= 0 {
                            walk.kept.push(MapKept { id: id, deps: tm_nothing() })
                        }
                    },
                    // Iterating a map field hands it nothing (#1607).
                    Expr::Field { base, name, .. } => {
                        if tm_a_map_field(name, words, env) {
                            tm_walk_expr(base, words, library, env, classes, walk)
                        } else {
                            tm_walk_expr(iter, words, library, env, classes, walk)
                        }
                    },
                    else => tm_walk_expr(iter, words, library, env, classes, walk),
                }
                let given = tm_deps_of(iter, words, library, env, walk)
                walk.scopes.push(collections::BTreeMap())
                for one in bindings {
                    let node = f"b:{walk.given.len()}"
                    tm_bind(one.clone(), given, node, walk)
                }
                tm_walk_block(body, words, library, env, classes, walk)
                walk.scopes.pop()
            },
            Stmt::While { cond, body } => {
                tm_walk_expr(cond, words, library, env, classes, walk)
                tm_walk_block(body, words, library, env, classes, walk)
            },
            Stmt::Expr(value) => tm_walk_expr(value, words, library, env, classes, walk),
            Stmt::Return(value) => {
                if value != null {
                    let ret = walk.ret.clone()
                    tm_flow(ret, value ?? return, words, library, env, classes, walk)
                }
            },
            else => {
                walk.unread = true
                for expr in check_visit_stmt(stmt.node) {
                    es_fog(expr, words, library, env, walk)
                }
                for inner in check_visit_stmt_blocks(stmt.node) {
                    es_fog_block(inner, words, library, env, walk)
                }
            }
        }
    }
    walk.scopes.pop()
}

/// The private function `func` names, where it is called by its name and no
/// binding in the body hides it; nothing otherwise.
fn tm_private_callee(func: ref Expr, env: ref MapEnv, walk: ref MapWalk) -> winnow_grammar::Symbol? {
    return match func {
        Expr::Variable(name, _) => {
            if tm_resolve(name.clone(), walk) == -2 && env.privates.contains_key(name) {
                name.clone()
            } else {
                null
            }
        },
        else => null,
    }
}

/// What a call hands a private function: each argument is a value flowing
/// into the parameter of its place.
fn tm_call_args(callee: winnow_grammar::Symbol, args: ref Vec[Expr], config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    let arity = env.privates.get(callee) ?? -1
    let written = words.resolve(callee)
    if arity != args.len() {
        mc_poison_function(classes, written, arity)
        for a in args {
            tm_walk_expr(a, words, library, env, classes, walk)
        }
    } else {
        let mut at = 0
        for a in args {
            let param = f"p:{written}:{at}"
            tm_flow(param, a, words, library, env, classes, walk)
            at = at + 1
        }
    }
    for c in config {
        tm_walk_expr(c.value, words, library, env, classes, walk)
    }
}

/// A value flowing into the position `sink`: from a name, or from a private
/// function's result, it is one class with that; from anything else the
/// class is keyed, because where it comes from is not followed.
fn tm_flow(sink: ref String, value: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    match value {
        Expr::Variable(name, _) => {
            let id = tm_resolve(name.clone(), walk)
            if id >= 0 {
                let node = walk.nodes[id].clone()
                mc_union(classes, sink, node)
            } else {
                mc_poison(classes, sink)
                tm_walk_expr(value, words, library, env, classes, walk)
            }
        },
        Expr::Call { func, args, config, .. } => {
            let found = tm_private_callee(func, env, walk)
            if found != null {
                let callee = found ?? return
                let ret = f"r:{words.resolve(callee)}"
                mc_union(classes, sink, ret)
                tm_call_args(callee, args, config, words, library, env, classes, walk)
            } else {
                mc_poison(classes, sink)
                tm_walk_expr(value, words, library, env, classes, walk)
            }
        },
        else => {
            mc_poison(classes, sink)
            tm_walk_expr(value, words, library, env, classes, walk)
        }
    }
}

/// A value given to a map field (#1607): a map made here joins no class,
/// as for a `let`; anything else flows as `tm_flow` says.
fn tm_into(sink: ref String, value: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    if is_a_map_made(value, words) {
        tm_walk_expr(value, words, library, env, classes, walk)
    } else {
        tm_flow(sink, value, words, library, env, classes, walk)
    }
}

/// The map `receiver` names, if it names one: its binding, else `-1`.
fn map_named(receiver: ref Expr, words: ref winnow_grammar::InternerContext, walk: ref MapWalk) -> i64 {
    return match receiver {
        Expr::Variable(name, _) => {
            let id = tm_resolve(name.clone(), walk)
            if id >= 0 { id } else { -1 }
        },
        else => -1,
    }
}

/// An expression where it stands: the uses of a map in it, read with the
/// names bound here, and the blocks inside it walked with their own.
fn tm_walk_expr(expr: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut classes: MapClasses, mut walk: MapWalk) {
    match expr {
        Expr::Block(b, _) => tm_walk_block(b, words, library, env, classes, walk),
        Expr::AsyncGroup(b, _, _, _, _) => tm_walk_block(b, words, library, env, classes, walk),
        Expr::Unsafe(b, _) => tm_walk_block(b, words, library, env, classes, walk),
        Expr::If { cond, then_branch, else_branch, .. } => {
            tm_walk_expr(cond, words, library, env, classes, walk)
            tm_walk_block(then_branch, words, library, env, classes, walk)
            if else_branch != null {
                tm_walk_block(else_branch ?? return, words, library, env, classes, walk)
            }
        },
        Expr::MethodCall { receiver, method, args, config, .. } => {
            let id = map_named(receiver, words, walk)
            let field = tm_field_named(receiver, words, env)
            if id >= 0 && words.resolve(method) != "clone" {
                let mut all = tm_nothing()
                for a in args {
                    all = tm_join(all, tm_deps_of(a, words, library, env, walk))
                }
                walk.kept.push(MapKept { id: id, deps: all })
            } else if field != null && words.resolve(method) != "clone" {
                // **A method of a map field** (#1607): what it is handed may
                // become a key, as for a map named by a binding.
                let named = field ?? return
                let mut all = tm_nothing()
                for a in args {
                    all = tm_join(all, tm_deps_of(a, words, library, env, walk))
                }
                walk.field_kept.push((tm_field_node(named, words), all))
                match receiver {
                    Expr::Field { base, .. } => tm_walk_expr(base, words, library, env, classes, walk),
                    else => {}
                }
            } else {
                tm_walk_expr(receiver, words, library, env, classes, walk)
            }
            for a in args {
                tm_walk_expr(a, words, library, env, classes, walk)
            }
            for c in config {
                tm_walk_expr(c.value, words, library, env, classes, walk)
            }
        },
        Expr::Index { base, index, .. } => {
            let id = map_named(base, words, walk)
            let field = tm_field_named(base, words, env)
            if id >= 0 {
                let deps = tm_deps_of(index, words, library, env, walk)
                walk.kept.push(MapKept { id: id, deps: deps })
            } else if field != null {
                let named = field ?? return
                let deps = tm_deps_of(index, words, library, env, walk)
                walk.field_kept.push((tm_field_node(named, words), deps))
                match base {
                    Expr::Field { base, .. } => tm_walk_expr(base, words, library, env, classes, walk),
                    else => {}
                }
            } else {
                tm_walk_expr(base, words, library, env, classes, walk)
            }
            tm_walk_expr(index, words, library, env, classes, walk)
        },
        Expr::Call { func, args, config, .. } => {
            let found = tm_private_callee(func, env, walk)
            if found != null {
                let callee = found ?? return
                // Its result is used where no class follows it.
                let ret = f"r:{words.resolve(callee)}"
                mc_poison(classes, ret)
                tm_call_args(callee, args, config, words, library, env, classes, walk)
            } else {
                es_sink_call(func, args, config, words, library, env, walk)
                tm_walk_expr(func, words, library, env, classes, walk)
                for a in args {
                    tm_walk_expr(a, words, library, env, classes, walk)
                }
                for c in config {
                    tm_walk_expr(c.value, words, library, env, classes, walk)
                }
            }
        },
        Expr::Binary { lhs, rhs, .. } => {
            tm_walk_expr(lhs, words, library, env, classes, walk)
            tm_walk_expr(rhs, words, library, env, classes, walk)
        },
        Expr::Unary { expr, .. } => tm_walk_expr(expr, words, library, env, classes, walk),
        Expr::Cast { expr, .. } => tm_walk_expr(expr, words, library, env, classes, walk),
        Expr::Try(inner, _) => tm_walk_expr(inner, words, library, env, classes, walk),
        Expr::Async(inner, _, _, _) => tm_walk_expr(inner, words, library, env, classes, walk),
        Expr::Throw(inner, _) => tm_walk_expr(inner, words, library, env, classes, walk),
        // **A map field used as a value** (#1607): handed on, returned or
        // bound, it goes where no class follows it.
        Expr::Field { base, name, .. } => {
            if tm_a_map_field(name, words, env) {
                mc_poison(classes, tm_field_node(name, words))
            }
            tm_walk_expr(base, words, library, env, classes, walk)
        },
        Expr::SafeField { base, name, .. } => {
            if tm_a_map_field(name, words, env) {
                mc_poison(classes, tm_field_node(name, words))
            }
            tm_walk_expr(base, words, library, env, classes, walk)
        },
        Expr::Coalesce { value, fallback, .. } => {
            tm_walk_expr(value, words, library, env, classes, walk)
            tm_walk_expr(fallback, words, library, env, classes, walk)
        },
        Expr::Tuple(items, _) => {
            for i in items {
                tm_walk_expr(i, words, library, env, classes, walk)
            }
        },
        Expr::ListLit { items, .. } => {
            for i in items {
                tm_walk_expr(i, words, library, env, classes, walk)
            }
        },
        Expr::ListRepeat { value, count, .. } => {
            tm_walk_expr(value, words, library, env, classes, walk)
            tm_walk_expr(count, words, library, env, classes, walk)
        },
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => tm_walk_expr(expr, words, library, env, classes, walk),
                    else => {}
                }
            }
        },
        Expr::Return(value, _) => {
            if value != null {
                let ret = walk.ret.clone()
                tm_flow(ret, value ?? return, words, library, env, classes, walk)
            }
        },
        Expr::Variable(name, _) => {
            let id = tm_resolve(name.clone(), walk)
            if id >= 0 {
                walk.escapes.insert(id)
            }
            // A private function's name where it is not called: a value, so
            // its callers are not all seen.
            if id == -2 {
                let arity = env.privates.get(name) ?? -1
                if arity >= 0 {
                    mc_poison_function(classes, words.resolve(name), arity)
                }
            }
        },
        // A struct literal is code this does not follow (the function stays
        // unread), but what it is built from leaves: a map named in a field is a
        // map that may stand at a hidden parameter (D9).
        //
        // **A literal of a struct the file follows is read field by field**
        // (#1607): a map field's value flows into its position; every other
        // field's value is walked where it stands.
        Expr::StructLit { name, fields, .. } => {
            let owner = words.resolve(name).clone()
            let followed = env.followed_structs.contains(owner)
            for field in fields {
                let field_name = words.resolve(field.name)
                let into = f"{owner}.{field_name}"
                if followed && env.map_fields.contains(into) {
                    let node = tm_field_node(field.name, words)
                    if field.value != null {
                        tm_into(node, field.value ?? return, words, library, env, classes, walk)
                    } else {
                        let id = tm_resolve(field.name.clone(), walk)
                        if id >= 0 {
                            mc_union(classes, node, walk.nodes[id].clone())
                        } else {
                            mc_poison(classes, node)
                        }
                    }
                } else {
                    if tm_a_map_field(field.name, words, env) {
                        mc_poison(classes, tm_field_node(field.name, words))
                    }
                    if field.value != null {
                        tm_walk_expr(field.value ?? return, words, library, env, classes, walk)
                    } else {
                        let id = tm_resolve(field.name.clone(), walk)
                        if id >= 0 {
                            walk.escapes.insert(id)
                        }
                        if id == -2 {
                            let arity = env.privates.get(field.name) ?? -1
                            if arity >= 0 {
                                mc_poison_function(classes, field_name, arity)
                            }
                        }
                    }
                }
            }
            if !followed {
                walk.unread = true
            }
        },
        Expr::Path(_, _) => {},
        Expr::LitInt { .. } => {},
        Expr::LitFloat(_, _) => {},
        Expr::LitStr { .. } => {},
        Expr::LitChar(_, _) => {},
        Expr::LitBool(_, _) => {},
        Expr::LitNull(_) => {},
        Expr::Break(_) => {},
        Expr::Continue(_) => {},
        // A lambda, a `match`, a `catch`, a task: names bound some way this
        // does not follow. A log sink inside writes what is not followed,
        // so escaped (ADR-398 D3).
        else => {
            walk.unread = true
            es_fog(expr, words, library, env, walk)
        }
    }
}

fn tm_all_deps(items: ref Vec[Expr], words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, walk: ref MapWalk) -> KeyDeps {
    let mut all = tm_nothing()
    for item in items {
        all = tm_join(all, tm_deps_of(item, words, library, env, walk))
        if !all.known {
            return all
        }
    }
    return all
}

/// The bindings a value is made of, or nothing where something in it is never
/// trusted.
fn tm_deps_of(value: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, walk: ref MapWalk) -> KeyDeps {
    return match value {
        Expr::LitInt { .. } => tm_nothing(),
        Expr::LitFloat(_, _) => tm_nothing(),
        Expr::LitStr { .. } => tm_nothing(),
        Expr::LitChar(_, _) => tm_nothing(),
        Expr::LitBool(_, _) => tm_nothing(),
        Expr::LitNull(_) => tm_nothing(),
        Expr::Variable(name, _) => {
            let id = tm_resolve(name.clone(), walk)
            if id >= 0 { tm_reading(id) } else { tm_never() }
        },
        Expr::LitInterpolated { parts, .. } => {
            let mut all = tm_nothing()
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => {
                        all = tm_join(all, tm_deps_of(expr, words, library, env, walk))
                    },
                    else => {}
                }
            }
            all
        },
        Expr::Tuple(items, _) => tm_all_deps(items, words, library, env, walk),
        Expr::ListLit { items, .. } => tm_all_deps(items, words, library, env, walk),
        Expr::ListRepeat { value, count, .. } => tm_join(tm_deps_of(value, words, library, env, walk), tm_deps_of(count, words, library, env, walk)),
        Expr::Unary { expr, .. } => tm_deps_of(expr, words, library, env, walk),
        Expr::Cast { expr, .. } => tm_deps_of(expr, words, library, env, walk),
        Expr::Binary { lhs, rhs, .. } => tm_join(tm_deps_of(lhs, words, library, env, walk), tm_deps_of(rhs, words, library, env, walk)),
        Expr::Field { base, .. } => tm_deps_of(base, words, library, env, walk),
        Expr::Index { base, index, .. } => tm_join(tm_deps_of(base, words, library, env, walk), tm_deps_of(index, words, library, env, walk)),
        Expr::Coalesce { value, fallback, .. } => tm_join(tm_deps_of(value, words, library, env, walk), tm_deps_of(fallback, words, library, env, walk)),
        Expr::Call { func, args, config, .. } => tm_call_deps(func, args, config, words, library, env, walk),
        Expr::MethodCall { receiver, method, args, config, .. } => {
            let name = words.resolve(method)
            // **A source method marked `trusted: true`** (ADR-365 D2): the
            // operator chose what it hands back, as at a call by name.
            if env.sources.contains(name) && !env.own.contains(name) && says_trusted(words, config) {
                tm_nothing()
            } else if env.sources.contains(name) && !env.own.contains(name) {
                tm_from(name)
            } else if env.own.contains(name) {
                tm_never()
            } else {
                tm_join(tm_deps_of(receiver, words, library, env, walk), tm_all_deps(args, words, library, env, walk))
            }
        },
        else => tm_never(),
    }
}

fn tm_call_deps(func: ref Expr, args: ref Vec[Expr], config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, walk: ref MapWalk) -> KeyDeps {
    let name = match func {
        Expr::Path(segments, _) => {
            let mut joined: String = ""
            for segment in segments {
                if !joined.is_empty() {
                    joined.push_str("::")
                }
                joined.push_str(words.resolve(segment))
            }
            joined
        },
        Expr::Variable(one, _) => words.resolve(one).clone(),
        else => return tm_never(),
    }
    if env.own.contains(name) {
        return tm_never()
    }
    if env.cleaners.contains(name) {
        return tm_nothing()
    }
    let contract = library.functions[name] ?? return tm_never()
    if contract.provenance != null {
        let provenance = contract.provenance ?? return tm_never()
        if provenance == Provenance::Trusted || says_trusted(words, config) || read_by_operator(contract, first_literal(args)) {
            return tm_nothing()
        }
        return tm_from(name)
    }
    let mut all = tm_all_deps(args, words, library, env, walk)
    for c in config {
        all = tm_join(all, tm_deps_of(c.value, words, library, env, walk))
    }
    return all
}

/// `HashMap()` and `HashSet()`, with nothing in the parentheses.
fn is_a_map_made(value: ref Expr, words: ref winnow_grammar::InternerContext) -> bool {
    return match value {
        Expr::Call { func, args, .. } => {
            if args.len() != 0 {
                false
            } else {
                match func {
                    Expr::Path(segments, _) => {
                        let last = words.resolve(segments[segments.len() - 1])
                        last == "HashMap" || last == "HashSet"
                    },
                    Expr::Variable(one, _) => {
                        let last = words.resolve(one)
                        last == "HashMap" || last == "HashSet"
                    },
                    else => false,
                }
            }
        },
        else => false,
    }
}

// **Which values a log sink escapes** (ADR-398 D3, #1598): `eprint`,
// `eprintln`, `panic` and a failed `assert`'s message write to the log, and a
// value whose bytes the program did not choose is written there escaped.
// Each hole of an `f"…"` is judged by its own provenance, any other value
// whole; the literal text is never. The walk is the map walk's: the same
// bindings, the same fixpoint, the same rule that what is not seen is
// untrusted. Only `text::escape_control` makes a value trusted that was not
// (D4).

/// The values to escape, by node: the holes of an `f"…"`, and the values
/// written whole; and every call that escapes one with the source that made
/// it untrusted (D5).
pub struct EscapePlan {
    pub holes: collections::BTreeSet[i64],
    pub wholes: collections::BTreeSet[i64],
    pub calls: Vec[EscapedCall],
}

/// A log sink that escapes: the start of its statement, its name, and the
/// source of the value it escapes.
pub struct EscapedCall {
    pub at: i64,
    pub sink: String,
    pub source: String,
}

/// Nothing escaped: a program that reads nothing untrusted (D3).
pub fn no_escapes() -> EscapePlan {
    return EscapePlan { holes: collections::BTreeSet(), wholes: collections::BTreeSet(), calls: [] }
}

/// The values every log sink of `program` escapes.
pub fn escaped_sinks(program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger) -> EscapePlan {
    let mut env = tm_env(program, words, library)
    env.cleaners.insert("text::escape_control")
    let mut plan = EscapePlan { holes: collections::BTreeSet(), wholes: collections::BTreeSet(), calls: [] }
    for item in program.items {
        match item.node {
            Item::Fn { args, body, .. } => es_walk_function(args, body, words, library, env, plan),
            Item::Impl { methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { args, body, .. } => es_walk_function(args, body, words, library, env, plan),
                        else => {}
                    }
                }
            },
            else => {}
        }
    }
    return plan
}

fn es_walk_function(args: ref Vec[FnArg], body: ref Block, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut plan: EscapePlan) {
    let mut classes = MapClasses { parent: collections::BTreeMap(), poisoned: collections::BTreeSet(), lets: [], slots: [], unread: false, escaped: [] }
    let mut first: collections::BTreeMap[winnow_grammar::Symbol, i64] = collections::BTreeMap()
    let mut walk = MapWalk { nodes: [], ret: "r", scopes: [], given: [], made: [], kept: [], escapes: collections::BTreeSet(), bound: collections::BTreeMap(), unread: false, at: 0, sinks: [], field_kept: [] }
    for arg in args {
        let id = walk.given.len()
        let name = arg.name.clone()
        walk.given.push([tm_from(f"the parameter `{words.resolve(name)}`")])
        walk.nodes.push("p")
        first.insert(name.clone(), id)
    }
    walk.scopes.push(first)
    tm_walk_block(body, words, library, env, classes, walk)
    // **Code not followed may assign any name**, so where some was, no
    // binding counts as trusted.
    let trusted = if walk.unread { collections::BTreeSet() } else { tm_trusted_bindings(walk.given) }
    for one in walk.sinks {
        let mut untrusted = !one.deps.known
        let mut why = one.deps.why.clone()
        for dep in one.deps.ids {
            if !trusted.contains(dep) {
                untrusted = true
                if why.is_empty() {
                    let mut seen: collections::BTreeSet[i64] = collections::BTreeSet()
                    why = es_why(dep, walk.given, trusted, seen)
                }
            }
        }
        if untrusted {
            if one.whole {
                plan.wholes.insert(one.key)
            } else {
                plan.holes.insert(one.key)
            }
            if why.is_empty() {
                why = "a value this does not follow"
            }
            let mut fresh = true
            for call in plan.calls {
                if call.at == one.at && call.sink == one.sink && call.source == why {
                    fresh = false
                }
            }
            if fresh {
                plan.calls.push(EscapedCall { at: one.at, sink: one.sink.clone(), source: why })
            }
        }
    }
}

/// The source behind an untrusted binding: the first one its values name.
fn es_why(id: i64, given: ref Vec[Vec[KeyDeps]], trusted: ref collections::BTreeSet[i64], mut seen: collections::BTreeSet[i64]) -> String {
    if seen.contains(id) {
        return ""
    }
    seen.insert(id)
    for one in given[id] {
        if !one.why.is_empty() {
            return one.why.clone()
        }
        for dep in one.ids {
            if !trusted.contains(dep) {
                let found = es_why(dep, given, trusted, seen)
                if !found.is_empty() {
                    return found
                }
            }
        }
    }
    return ""
}

/// The log sink a call names: `eprint`, `eprintln`, `panic` or `assert`,
/// called by its name where nothing of the program's own hides it.
fn es_sink_name(func: ref Expr, words: ref winnow_grammar::InternerContext, env: ref MapEnv, walk: ref MapWalk) -> String {
    return match func {
        Expr::Variable(name, _) => {
            let written = words.resolve(name)
            if tm_resolve(name.clone(), walk) == -2 && !env.own.contains(written) && (written == "eprint" || written == "eprintln" || written == "panic" || written == "assert") {
                written.clone()
            } else {
                ""
            }
        },
        else => "",
    }
}

/// A call to a log sink: each value it writes is judged with the names bound
/// here. `assert` writes only its message.
fn es_sink_call(func: ref Expr, args: ref Vec[Expr], config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut walk: MapWalk) {
    let sink = es_sink_name(func, words, env, walk)
    if sink.is_empty() {
        return
    }
    if sink == "assert" {
        for c in config {
            if words.resolve(c.name) == "message" {
                es_value(sink, c.value, words, library, env, walk)
            }
        }
        return
    }
    for a in args {
        es_value(sink, a, words, library, env, walk)
    }
}

fn es_value(sink: ref String, value: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut walk: MapWalk) {
    match value {
        Expr::LitStr { .. } => {},
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => {
                        let deps = tm_deps_of(expr, words, library, env, walk)
                        walk.sinks.push(EscSink { at: walk.at, sink: sink.clone(), key: node_key(expr), whole: false, deps: deps })
                    },
                    else => {}
                }
            }
        },
        else => {
            let deps = tm_deps_of(value, words, library, env, walk)
            walk.sinks.push(EscSink { at: walk.at, sink: sink.clone(), key: node_key(value), whole: true, deps: deps })
        },
    }
}

/// The log sinks in code the walk does not follow: what they write is judged
/// with no name bound, so only what literals make counts as trusted.
fn es_fog(expr: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut walk: MapWalk) {
    let mut blank = MapWalk { nodes: [], ret: "r", scopes: [], given: [], made: [], kept: [], escapes: collections::BTreeSet(), bound: collections::BTreeMap(), unread: false, at: walk.at, sinks: [], field_kept: [] }
    es_fog_into(expr, words, library, env, blank)
    walk.sinks.extend(blank.sinks)
}

fn es_fog_block(block: ref Block, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut walk: MapWalk) {
    let mut blank = MapWalk { nodes: [], ret: "r", scopes: [], given: [], made: [], kept: [], escapes: collections::BTreeSet(), bound: collections::BTreeMap(), unread: false, at: walk.at, sinks: [], field_kept: [] }
    es_fog_block_into(block, words, library, env, blank)
    walk.sinks.extend(blank.sinks)
}

fn es_fog_block_into(block: ref Block, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut blank: MapWalk) {
    for stmt in block.stmts {
        blank.at = stmt.span.start as i64
        for expr in check_visit_stmt(stmt.node) {
            es_fog_into(expr, words, library, env, blank)
        }
        for inner in check_visit_stmt_blocks(stmt.node) {
            es_fog_block_into(inner, words, library, env, blank)
        }
    }
}

fn es_fog_into(expr: ref Expr, words: ref winnow_grammar::InternerContext, library: ref Ledger, env: ref MapEnv, mut blank: MapWalk) {
    for one in check_visit_preorder(expr) {
        match one {
            Expr::Call { func, args, config, .. } => es_sink_call(func, args, config, words, library, env, blank),
            Expr::LitInterpolated { parts, .. } => {
                for part in parts {
                    match part {
                        FPart::Hole { expr, .. } => es_fog_into(expr, words, library, env, blank),
                        else => {}
                    }
                }
            },
            else => {}
        }
        for inner in check_visit_expr_blocks(one) {
            es_fog_block_into(inner, words, library, env, blank)
        }
    }
}

/// What `--trust` says of the log (ADR-398 D5): every sink call that escapes
/// a value, by line, with the source that made it untrusted.
pub fn render_escapes(plan: ref EscapePlan, text: ref String, path: ref String) -> String {
    let mut out: String = "log sinks that write untrusted text escaped:\n"
    if plan.calls.is_empty() {
        out.push_str("    none - no log sink writes untrusted text\n")
        return out
    }
    for call in plan.calls {
        out.push_str(ref f"    {path}:{line_of_byte(text, call.at)}  {call.sink} escapes text from {call.source}\n")
    }
    return out
}
