// crates/nikaia-std/src/compiler/bounds_walk.nika
//
// **The aggressive bounds and overflow walk** (ADR-306 D4, D6, D7), moved
// from the compiler's `bounds` (ADR-294, #435 step 3): each body walked
// forward, keeping the linear facts that hold at each point - ranges, branch
// and loop conditions, the operands of `&&` and `||`, `let`s and
// assignments, the lengths a list is built or resized to - and the solver
// asked whether an index is inside its list and an operation inside its
// type. What it proves is a set of index nodes and a set of operators.
//
// **What only the compiler can do is handed in** as a callback: the solver
// (`ask`, whether facts imply a goal on a certificate the checker accepts).
// A node is named by its id (`id_of`, ADR-340), which the emitter reads again.
// A term is a place in the walk's arena (`prover_arena.nika`).

use std::text
use std::collections
use std::node_id
use logic

/// **What the program around every body says**, read once per program.
pub struct BoundsContext {
	/// The receivers of the `len()` calls that count a `std` list, text or
	/// map, by node: only those are numbers of a proof.
	pub lengths: collections::BTreeSet[i64],
	/// Of `lengths`, those below 2^60 (#383).
	pub sized: collections::BTreeSet[i64],
	/// Every `+`, `-` and `*` whose two sides are one whole-number type, by
	/// the byte its operator starts at, with that type.
	pub arithmetic: collections::BTreeMap[i64, String],
	/// Signed values put where an unsigned type is stated, by node: each is
	/// taken without a conversion where it is proved `>= 0` (ADR-285 D32).
	pub nonnegative: collections::BTreeSet[i64],
	/// The `char`s converted to a whole number, by node: each such
	/// conversion is a code in `0..=0x10FFFF` (ADR-314 D2).
	pub char_codes: collections::BTreeSet[i64],
	/// What a callee's ledger entry ensures, by the name a call writes
	/// (ADR-314 D3).
	pub ensured: collections::BTreeMap[String, Ensured],
	/// What a callee's ledger entry requires, by the name a call writes:
	/// every condition read back, or no entry (ADR-269 D5, #776).
	pub required: collections::BTreeMap[String, Ensured],
	/// What each element of a sequence a ledger entry hands back holds, by
	/// the entry's key (ADR-375 D5).
	pub each: collections::BTreeMap[String, Ensured],
	/// What a sequence's ledger entry ensures of how many it yields, over
	/// `result.len()`, by the entry's key (#1546): a list it is collected
	/// into is as long.
	pub collected: collections::BTreeMap[String, Ensured],
	/// The method calls on a type `std`'s ledger describes, by node, with the
	/// type's name as the ledger keys it (ADR-314 D3, ADR-375 D5).
	pub std_receivers: collections::BTreeMap[i64, String],
	/// [`CheckFacts::simd_loads`]: a vector's load, by the called path's
	/// node, with the bytes it reads (minus the most, for a `Lanes`).
	pub simd_loads: collections::BTreeMap[i64, i64],
	/// Every shift whose count is not a literal, by the byte its operator
	/// starts at, with the shifted value's type (ADR-306 D18).
	pub shifts: collections::BTreeMap[i64, String],
	/// [`CheckFacts::divisions`]: every `/` and `%` whose divisor is not a
	/// literal, by the byte its operator starts at, with the type it divides
	/// in (ADR-396 D7, #1578).
	pub divisions: collections::BTreeMap[i64, String],
	/// **What a grammar binding matched** (ADR-314 D1), for the action it
	/// stands in: a whole number's range by name (`dec[i32](digit{1,2})` is
	/// `0..=99`), and a `char`'s code by name (`digit` is `48..=57`). Empty
	/// for a function.
	pub given: collections::BTreeMap[String, Range],
	/// Every `-x` of a signed whole number, by node, with that type
	/// (ADR-314 D5).
	pub negations: collections::BTreeMap[i64, String],
	pub classes: collections::BTreeMap[String, Range],
	/// A text binding's length by name (`x:digit{1,2}` is `1..=2`), and the
	/// code of each of its characters (`48..=57`).
	pub text_lengths: collections::BTreeMap[String, Range],
	pub text_classes: collections::BTreeMap[String, Range],
	pub around: Around,
	/// **The field reads of a whole-number type**, by node (ADR-306 D17):
	/// a path of fields from a name, `p.end`, is a number of the walk.
	pub whole_fields: collections::BTreeSet[i64],
	/// Of `whole_fields`, each field and element read with its type
	/// (ADR-306 D34): a term's type is its range.
	pub whole_types: collections::BTreeMap[i64, String],
	/// The `for` heads that bind one whole number, by the node walked,
	/// with its type.
	pub whole_loops: collections::BTreeMap[i64, String],
	/// The `for` heads that bind several names, by the node walked, with
	/// the positions of those bound to a whole number.
	pub whole_parts: collections::BTreeMap[i64, collections::BTreeSet[i64]],
	/// **The length an `Array[T, N]`'s type says**, by the node of the
	/// array read or counted: `len()` is `N` (#711).
	pub array_lengths: collections::BTreeMap[i64, i64],
	/// **`prove-through-loops:on`** (ADR-361 D10): a check a loop leaves
	/// open is asked once more through the loop's invariant.
	pub through_loops: bool,
	/// **The bytes `--bounds-trace` asks about** (#1495): `[from, to]` of a
	/// line, empty when it asks nothing. A goal of a statement starting
	/// there is written into `BoundsProven::trace`.
	pub trace: Vec[i64],
	/// **A `comptime` of the module of type `bool`, by name, with what the
	/// build computed for it**: an `if` on it takes one arm only.
	pub decided: collections::BTreeMap[String, bool],
	/// **The indexed bases the checker typed as a std list** (ADR-306 D23,
	/// #1431), by node: a read of one stops the program outside, so past it
	/// the position is inside, whatever bound the base.
	pub list_indices: collections::BTreeSet[i64],
	/// **The reads `s.bytes` of a text `s`** (ADR-320 D11), by node:
	/// `s.bytes.len()` is the length `s.len()` names (#1556).
	pub text_bytes: collections::BTreeSet[i64],
	/// **The reads `s.scalars` of a text `s`** (ADR-320 D3), by node: a walk
	/// over them hands at most `s.len()` scalars, as `s.chars()` did (#1974).
	pub text_scalars: collections::BTreeSet[i64],
	/// **What each function of the file is found to return** (ADR-306 D23),
	/// by name: never published, like a frame (ADR-391 D4).
	pub returns: collections::BTreeMap[String, BoundsReturns],
	/// **The type whose own `impl` holds the body walked**, `""` outside
	/// one: a call `self.m(…)` there is `T::m`, whose result summary the
	/// walk assumes (ADR-359 D14, #1904).
	pub owner: String,
}

/// **A callee's found postcondition** (ADR-306 D23): the list parameters, by
/// position, that what it returns lies below the length of, `0 <= result <
/// p.len()`; with `each`, every element of the list it returns does (D24).
/// `sized` holds those of them whose length the callee's walk read as one
/// of a list whose elements take space (#383): the caller's length of the
/// list handed there is at most `length_below()` as well (#1465).
///
/// `range` is the bound D7 found on every element of the list returned
/// (D24): `0 <= x < 10` of a list of digits. `pending` while the rounds
/// collect: a call of one adds nothing to what it is written into, as a
/// recursive call has not returned yet.
pub struct BoundsReturns {
	pub each: bool,
	pub below: collections::BTreeSet[i64],
	pub sized: collections::BTreeSet[i64],
	pub range: Range?,
	pub pending: bool,
	/// **A whole number's relations to its arguments** (ADR-306 D31): the
	/// positions of the whole-number arguments it is at least, and of the
	/// lists it is at most as long as.
	pub at_least: collections::BTreeSet[i64],
	pub within: collections::BTreeSet[i64],
	/// Of `within`, the lists it is below the length of, `result <
	/// p.len()` (#1757): a search's `-1` or a position found, the floor of
	/// `range` with it; a caller's `r >= 0` makes it an index of `p`.
	pub under: collections::BTreeSet[i64],
	/// **A method's receiver, as one more argument** (ADR-306 D34): the
	/// list fields of `self` a position past the last argument names, the
	/// first of them at `args.len()`; empty for a free function.
	pub fields: Vec[String],
	/// **The lengths of what it hands back** (ADR-306 D23, D25, #1756): of a
	/// list it returns (`""`) or of each list field of a struct it returns
	/// (the field's name), the positions of the arguments the length is
	/// found equal to (`lengths`) or at least (`reaches`): a whole number's
	/// value, or the length of a list argument (`listed`); and the pairs
	/// `a|b` of fields found as long as each other (`alike`). `plain` where
	/// the bounds above are looked for too: a whole number, a list of them.
	pub plain: bool,
	pub measures: Vec[String],
	pub lengths: collections::BTreeMap[String, collections::BTreeSet[i64]],
	pub reaches: collections::BTreeMap[String, collections::BTreeSet[i64]],
	pub listed: collections::BTreeSet[i64],
	pub alike: collections::BTreeSet[String],
	/// The whole-number parameters, by position, the lengths were proved
	/// with at zero or more: a list a counted loop builds is as long as the
	/// count only where it is not below zero (ADR-391 D1's `0 <= n` is
	/// derived after these rounds). A call reads each length as holding
	/// where its argument is (`p < 0 || ...`).
	pub guards: collections::BTreeSet[i64],
	/// **The whole-number field of a struct result this entry reads**
	/// (ADR-306 D35), keyed `callee#field`: what the field holds at every
	/// return that builds the struct by a literal; empty for the result
	/// itself.
	pub projected: String,
}

/// **What a callee's ledger entry ensures** (ADR-314 D3): each condition read
/// back over its parameters and `result`, for the walk to assume of a call.
pub struct Ensured {
	pub params: Vec[String],
	/// Of `params`, those that are `char`s: each is handed the argument's
	/// code (D2).
	pub chars: Vec[bool],
	/// The options it takes by name, each with its default as the ledger
	/// writes it (`ensures_each`, ADR-375 D5).
	pub options: Vec[(String, String)],
	pub conditions: Vec[Vec[logic::SolverTerm]],
}

/// What the walk proved: index nodes (the `id_of` of the indexed `base`) and
/// arithmetic operators (by the byte their operator starts at).
pub struct BoundsProven {
	pub indices: collections::BTreeSet[i64],
	pub arithmetic: collections::BTreeSet[i64],
	/// Of the context's `nonnegative`, those proved `>= 0` where they stand.
	pub nonnegative: collections::BTreeSet[i64],
	/// Of the context's `negations`, those proved not to negate the type's
	/// least value.
	pub negations: collections::BTreeSet[i64],
	/// **The method calls whose callee's precondition holds where they
	/// stand** (ADR-269 D5, D20, #776), by the receiver's node, with the
	/// callee's ledger key: each reaches the entry that does not check it.
	pub calls: collections::BTreeMap[i64, String],
	/// **The invariants that carried a check through a loop** (ADR-361 D4,
	/// D10), by the byte the loop starts at: its parts as `nikaia.proofs`
	/// keeps them, each with the strategy that found it.
	pub loops: collections::BTreeMap[i64, String],
	/// **What each call of a private function proved of its claims**
	/// (ADR-391 D1, `bounds_derived.nika`), by the call's node: the claims
	/// held at every visit of the call.
	pub derived: collections::BTreeMap[i64, collections::BTreeSet[i64]],
	/// **What the body wrote into the list fields the walks see** (ADR-306
	/// D21): each field's values joined, and the fields it wrote something
	/// unbounded into.
	pub fields: collections::BTreeMap[String, Range],
	pub fields_lost: collections::BTreeSet[String],
	/// **The list parameters the body's every return was proved below**
	/// (ADR-306 D23), by position, where the walk was asked; nothing where a
	/// return was lost.
	pub returned: collections::BTreeSet[i64]?,
	/// **What `--bounds-trace` shows** (#1495): each goal of the asked line,
	/// with the facts the walk held, on the last pass.
	pub trace: Vec[String],
	/// **The rules that hold of each type this walk found itself**
	/// (`rules_settle`, #1581): kept by `bounds_proven` for the next bodies,
	/// as long as nothing they depend on changed.
	pub held: collections::BTreeMap[String, Vec[BoundsRule]],
}

/// What holds at one point of a body.
struct BoundsFacts {
	/// Names that are whole numbers here.
	ints: collections::BTreeSet[String],
	facts: Vec[i64],
	/// How many facts the `most_held()` cap dropped here, for
	/// `--bounds-trace` (#1495).
	evicted: i64,
}

/// The names whose value, and the lists whose length, a block may change.
pub struct BoundsChanged {
	pub values: collections::BTreeSet[String],
	pub lengths: collections::BTreeSet[String],
	/// Values whose paths of fields may change (ADR-306 D17), their own
	/// length aside: the receivers of methods that may change them.
	pub parts: collections::BTreeSet[String],
	/// Of `values`, those changed otherwise than by adding to them: by a
	/// call, or by an assignment of another shape (#711).
	pub jumps: collections::BTreeSet[String],
	/// Of `values`, those changed otherwise than by taking from them
	/// (#1329): a name in `jumps` and not here only falls.
	pub drops: collections::BTreeSet[String],
	/// Of `lengths`, those that may fall (#1414): changed otherwise than
	/// by a method that only adds to the list. A list in `lengths` and not
	/// here only grows.
	pub falls: collections::BTreeSet[String],
	/// **Of `falls`, those that may fall otherwise than through a method of
	/// this program called on the value the list is a field of** (#1808):
	/// such a method keeps its type's rules at every exit (ADR-306 D21), so
	/// a `capped` bound against the list's length stands past it
	/// (`rules_capped_grown`). Each fall goes into both sets
	/// (`changed_falls`); only `changed_by_method` leaves one out here.
	pub bare_falls: collections::BTreeSet[String],
	/// Places written through an element (#781), as `list|at|.fields`:
	/// the same fields of every element of `list` may change.
	pub elements: collections::BTreeSet[String],
}

struct BoundsWalk {
	arena: logic::TermArena,
	/// **The names the body never binds again that are lists by their
	/// stated type**: a parameter, a `let` with its type written. Past a
	/// read of one, its position lies inside (`rules_read_inside`).
	lists: collections::BTreeSet[String],
	proven: BoundsProven,
	/// **What every length the walk read of a container whose elements take
	/// space is**, by the length's name: `0 <= len(x) <= 2^60` (#383). A fact
	/// of every list, so it holds whatever the program did to it, and every
	/// proof is handed it.
	axioms: collections::BTreeMap[String, Vec[i64]],
	/// Names a length was read of where the elements may take no space: a
	/// name read both ways - one `xs` shadowing another - gets no axiom.
	unsized_names: collections::BTreeSet[String],
	/// **`0 <= len(x)` for those** (#439): a length is never negative, however
	/// little its elements take - only the upper bound depends on memory. Its
	/// upper bound is its type's (`typed`, ADR-385 D1).
	floors: collections::BTreeMap[String, i64],
	/// Names a lambda, a task or an `overlap` branch changes: they may change
	/// whenever one runs, so no fact is kept about them anywhere.
	pinned: collections::BTreeSet[String],
	/// Whole numbers that are never negative anywhere in the body.
	nonnegative: collections::BTreeSet[String],
	/// How many `char` codes the walk has read: each reading is a number of
	/// its own (ADR-314 D2).
	codes: i64,
	/// **The calls of the condition being assumed, each by the name of its
	/// result** (ADR-306 D23, D31, #1785): `bounding_name_calls` binds
	/// them for the one claim, as a `let` binds a call.
	call_names: collections::BTreeMap[i64, String],
	/// The binding of a `for d in x.scalars` over a text binding, with the
	/// code of `x`'s characters (ADR-314 D1).
	loop_classes: collections::BTreeMap[String, Range],
	/// What the body is, read once before any pass.
	shape: BodyShape,
	/// The bounds on lists' values this pass may read (ADR-306 D7), by key:
	/// a list's name for its values, `name[]` for the values of the lists it
	/// holds.
	assumed: collections::BTreeMap[String, Range],
	/// The join of what this pass saw written, by key.
	written: collections::BTreeMap[String, Range],
	/// Keys a write this pass put something unbounded in.
	poisoned: collections::BTreeSet[String],
	/// **The lists each key's values lie below** (ADR-306 D21, #1397): `0
	/// <= x < e.len()` for every value `x` of the key, with `e` a list the
	/// body never changes. Found and checked as `assumed` is.
	assumed_ends: collections::BTreeMap[String, collections::BTreeSet[String]],
	/// Of those, what every write this pass saw was proved below, by key.
	written_ends: collections::BTreeMap[String, collections::BTreeSet[String]],
	/// What the whole body may change: an end is a list it changes nothing
	/// of.
	steady: BoundsChanged,
	/// The names an end may be read of: the parameters, and the names a
	/// statement of the body's own block binds once.
	end_roots: collections::BTreeSet[String],
	/// **The lists whose values the body never reads** (#1587), only pushed
	/// to and measured: no end of theirs is asked about, since nothing reads
	/// one, and each write would ask about every list the facts name.
	unread: collections::BTreeSet[String],
	/// A pass that only finds bounds and proves nothing.
	collecting: bool,
	/// The first byte of the statement being walked: the key a compound
	/// assignment's operation is recorded by (#387).
	at: i64,
	/// **The counters the loops being walked take to only grow** (#711):
	/// each is at least what it was when its loop began, while every
	/// assignment to it adds what is proved not negative.
	growing: collections::BTreeSet[String],
	/// Of `growing`, those an assignment was not proved to grow: a loop that
	/// took one is walked again without it.
	grow_failed: collections::BTreeSet[String],
	/// **The counters the loops being walked take to only fall** (#1329,
	/// ADR-361 D5): each is at most what it was when its loop began, while
	/// every assignment to it adds what is proved not positive. A loop
	/// takes a counter so that it changes only by taking from it.
	falling: collections::BTreeSet[String],
	/// Of `falling`, those an assignment was not proved to lower.
	fall_failed: collections::BTreeSet[String],
	/// How many values at a loop's start the walk has named.
	entries: i64,
	/// **How many goals the walk has left open** (ADR-361 D2): a loop that
	/// left none is not asked through its invariant.
	open: i64,
	/// **The names a goal left open read**, each with the open count when it
	/// last did: a loop is asked through its invariant only where one of
	/// them is a name it changes.
	missed: collections::BTreeMap[String, i64],
	/// The newest goals left open, for that test.
	missed_goals: Vec[BoundsMissed],
	/// `prove-through-loops:on`: the walk keeps `open` and `missed`.
	through_loops: bool,
	/// **The loops whose invariant is being checked**, innermost last
	/// (ADR-361 D4): what a turn's end, a `continue` or a `break` must keep.
	turns: Vec[BoundsTurn],
	/// **The candidates a `break` need not keep** (ADR-361 D4): `!c` of a
	/// guard `if c { break }`, which holds at each turn's head and not where
	/// the loop is left, so nothing past the loop reads it.
	leaving: collections::BTreeSet[i64],
	/// **The loops whose invariant carried a check inside them**, by the
	/// byte each starts at, on the visit being walked: a check after one is
	/// not asked through it again (ADR-361 D4, #1383).
	settled_loops: collections::BTreeSet[i64],
	/// **What held where a `bool` name was set `true`** (ADR-361 D4, #1634),
	/// by the name: a loop that sets a flag offers `!flag || fact` for each
	/// fact that reads a name it changes, so what held where the flag went up
	/// holds past the loop wherever it is up.
	flagged: collections::BTreeMap[String, Vec[i64]],
	/// **The whole-number parameters the body never binds again**, with
	/// their types, and every length the walk read, an `i64` (ADR-385 D1):
	/// a value of such a type is what a goal may be stated against
	/// (`bounding_relative`).
	typed: collections::BTreeMap[String, String],
	/// **The rules between list fields this body uses** (ADR-369 D4,
	/// `bounds_rules.nika`), and the values they hold of, by their type.
	rules: Vec[BoundsRule],
	rule_roots: collections::BTreeMap[String, String],
	/// What the `index` and `inner` rules say of every element, by the
	/// element it names (`self.col[].each()`): they hold at every point
	/// (each write is checked where it stands), so they stand beside the
	/// facts, not among the newest `most_facts()`, and join a question that
	/// names that element (`bounding_known`).
	rule_facts: Vec[(String, i64)],
	/// **The `capped` bounds among `rule_facts`** (ADR-306 D21, #1785): the
	/// fresh name that stands at most the length while it lasts, the length,
	/// the element and the bound (`rules_capped_stand`).
	capped: Vec[(String, String, String, i64)],
	/// **The elements read out of an `ascending` list by position**
	/// (#1785): the fresh name that stands while it lasts, the list, the
	/// position and the name read (`rules_order_read`).
	ordered: Vec[(String, String, i64, String)],
	/// Whether this walk checks `rules` in a method: the index of each rule
	/// the method is not proved to keep goes into `rule_failed`; the
	/// `result` rules of the method are `checked_results`.
	checking: bool,
	checked_results: collections::BTreeSet[i64],
	rule_failed: collections::BTreeSet[i64],
	/// **The rules of `self` each loop around the walk was given at its
	/// head**, innermost last (`rules_loop_entry`, #1925): asked for at each
	/// end of its turn (`bounding_turn_end`).
	rule_loops: Vec[Vec[i64]],
	/// **The value a builder builds** (`rules_builder`, ADR-306 D25): its
	/// `length` rules are asked for where it is handed back and before each
	/// method of its type is called on it, not given; empty in any other
	/// body.
	rule_built: collections::BTreeSet[String],
	/// The `node_key` of that builder's literal, -1 where none: a literal
	/// asks its `length` rules where it stands (`rules_literal_holds`),
	/// but not this one.
	rule_built_literal: i64,
	/// **The postcondition this walk looks for** (ADR-306 D23): the name of
	/// each list parameter by position, empty for any other and when the
	/// walk looks for none; whether the function returns a list (`each`).
	return_params: Vec[String],
	return_each: bool,
	/// Of `return_params`, the positions every return seen was proved below
	/// (`null` before the first); the lists a list return handed back; the
	/// returns seen, by the node of their value; whether one was lost.
	return_below: collections::BTreeSet[i64]?,
	return_names: collections::BTreeSet[String],
	return_seen: collections::BTreeSet[i64],
	return_lost: bool,
	/// **The interval every value handed back lies in** (ADR-306 D32), where
	/// `return_ranging` asks for it: a function or a grammar action returning
	/// a whole number. `return_unranged` once one return has none.
	return_ranging: bool,
	return_range: Range?,
	return_unranged: bool,
	/// **The relations every value handed back holds** (ADR-306 D31): the
	/// name of each whole-number parameter it may be at least, and of each
	/// list parameter it may be at most as long as, by position (empty for
	/// none); of those, the positions every return seen was proved to hold
	/// (`null` before the first).
	return_scalars: Vec[String],
	return_lens: Vec[String],
	return_at_least: collections::BTreeSet[i64]?,
	return_within: collections::BTreeSet[i64]?,
	return_under: collections::BTreeSet[i64]?,
	/// **The lengths of what is handed back looked for** (ADR-306 D23,
	/// #1756, `BoundsReturns.lengths`): by measure, the positions asked; the
	/// parameter each position names (empty for none) and those that are
	/// lists; the pairs of fields asked; of those, what every return seen
	/// was proved to hold (`null` before the first).
	return_wanted: collections::BTreeMap[String, collections::BTreeSet[i64]],
	return_wanted_alike: collections::BTreeSet[String],
	return_sources: Vec[String],
	return_listed: collections::BTreeSet[i64],
	return_lengths: collections::BTreeMap[String, collections::BTreeSet[i64]]?,
	return_reaches: collections::BTreeMap[String, collections::BTreeSet[i64]]?,
	return_alike: collections::BTreeSet[String]?,
	return_measured: collections::BTreeSet[i64],
	/// The parameters a walk of found lengths takes at zero or more
	/// (`BoundsReturns.guards`).
	return_assumed: Vec[String],
	/// **The field of a struct result the walk reads at each return**
	/// (ADR-306 D35), empty for the value itself: a return that builds the
	/// struct otherwise than by a literal is lost.
	return_field: String,
	/// **A call read for one field of its struct result** (ADR-306 D35):
	/// the call's node and the field, so that [`bounding_found_key`] names
	/// the entry `callee#field` of that call alone; -1 and empty otherwise.
	found_at: i64,
	found_field: String,
	/// The context's `trace`: the bytes `--bounds-trace` asks about.
	trace: Vec[i64],
	/// **What a number of its own the statement being walked named is**
	/// (#1631): `2 * q <= l <= 2 * q + 1` for `q` standing for `l >> 1`, by
	/// `q`'s name. Only while the statement that named it is walked: a fact
	/// pushed then that reads `q` takes these along, and leaves with them when
	/// a name they read changes; a later statement that reads `q` again speaks
	/// of other values.
	defining: collections::BTreeMap[String, Vec[i64]],
	/// **The rows `--bounds-trace` shows of a loop's invariant search**
	/// (#1669): kept apart from `proven`, which the search puts back, and
	/// added to its trace when the pass ends.
	turn_rows: Vec[String],
}

/// **A loop's candidate invariant, while its body is walked** (ADR-361 D4):
/// the guesses assumed at the head of a turn, those an end of a turn or a
/// `break` did not keep, and where those ends were checked.
struct BoundsTurn {
	guesses: Vec[i64],
	failed: collections::BTreeSet[i64],
	jumps: collections::BTreeSet[i64],
}

/// No length of a container whose elements take space reaches this (#383):
/// each element takes a byte, and no target this compiler builds for
/// addresses more than 2^57 bytes. One number for every target, with a margin
/// of 8 (ADR-037 D1).
fn length_below() -> i64 {
	return 1152921504606846976
}

/// The widest bound a proof of a whole number states (#444): `2^62`, far
/// enough from `i64`'s ends that the solver, which counts in `i64`, can
/// combine it with a length's bound without overflowing.
fn solvable() -> i64 {
	return 4611686018427387904
}

/// How many facts a question is asked with (ADR-306 D30): the newest of
/// those connected to its goal, so that a long body costs the solver what a
/// short one does.
fn most_facts() -> i64 {
	return 48
}

/// How many facts a point keeps (ADR-306 D30): the newest; each question
/// takes from them the facts nearest its goal (`bounding_nearest`).
fn most_held() -> i64 {
	return 256
}

/// How deep a call to an expression function is followed into another: far
/// enough for a helper over a helper, and a recursion stops.
fn call_depth() -> i64 {
	return 4
}

fn no_proofs() -> BoundsProven {
	return BoundsProven {
		indices: collections::BTreeSet(),
		arithmetic: collections::BTreeSet(),
		nonnegative: collections::BTreeSet(),
		negations: collections::BTreeSet(),
		calls: collections::BTreeMap(),
		loops: collections::BTreeMap(),
		derived: collections::BTreeMap(),
		fields: collections::BTreeMap(),
		fields_lost: collections::BTreeSet(),
		returned: null,
		trace: [],
		held: collections::BTreeMap(),
	}
}

fn nothing_changed() -> BoundsChanged {
	return BoundsChanged {
		values: collections::BTreeSet(),
		lengths: collections::BTreeSet(),
		parts: collections::BTreeSet(),
		jumps: collections::BTreeSet(),
		drops: collections::BTreeSet(),
		falls: collections::BTreeSet(),
		bare_falls: collections::BTreeSet(),
		elements: collections::BTreeSet(),
	}
}

/// `name`'s length may fall, otherwise than through a method of its own
/// value (`BoundsChanged.bare_falls`, #1808).
fn changed_falls(mut out: BoundsChanged, name: ref String) {
	out.falls.insert(name.clone())
	out.bare_falls.insert(name.clone())
}

/// **Every index and every operation the walk proves in one body**, a
/// function whose parameters are `args`; `nonnegative` are its whole numbers
/// that are never negative anywhere.
///
/// **A bound on a list's values is an invariant, found and then checked**
/// (ADR-306 D7): each pass reads the bounds the last one found, and the last
/// pass keeps only those every write is proved to stay within, assuming all
/// of them. Reads before the writes they depend on, and writes that depend on
/// each other, are why one pass is not enough; a bound that only holds by
/// assuming itself larger is dropped. The passes that only collect prove
/// nothing. The pass that checks proves too, and when it keeps every bound it
/// assumed, what it proved stands.
fn bounds_aggressive(
	args: ref Vec[FnArg],
	body: ref Block,
	nonnegative: collections::BTreeSet[String],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> BoundsProven {
	let mut walk = bounding_new(args, body, nonnegative, context, program, words)
	return bounds_rounds(walk, args, body, context, program, words, ask)
}

/// **D7's rounds over one body**, with `walk` made for it.
fn bounds_rounds(
	mut walk: BoundsWalk,
	args: ref Vec[FnArg],
	body: ref Block,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> BoundsProven {
	let found_held = rules_settle(walk, args, body, context, program, words, ask)
	let mut settled = false
	if !walk.shape.roots.is_empty() {
		walk.collecting = true
		for _round in 0..<2 {
			bounding_pass(walk, args, body, context, program, words, ask)
			walk.assumed = bounding_found(walk)
			for (key, bound) in context.around.field_bounds {
				walk.assumed.insert(key.clone(), bound.clone())
			}
			walk.assumed_ends = bounding_found_ends(walk)
		}
		walk.collecting = false
		for _round in 0..<4 {
			walk.proven = no_proofs()
			bounding_pass(walk, args, body, context, program, words, ask)
			let found = bounding_found(walk)
			let before = walk.assumed.len()
			let mut kept: collections::BTreeMap[String, Range] = collections::BTreeMap()
			for (key, bound) in walk.assumed {
				if key.starts_with(".") {
					kept.insert(key.clone(), bound.clone())
					continue
				}
				let seen = found.get(key) ?? continue
				if bound.holds(seen) {
					kept.insert(key.clone(), bound.clone())
				}
			}
			walk.assumed = kept
			// An end every write was proved below stays (ADR-306 D21); a key
			// this pass wrote nothing into keeps what it had.
			let mut ends_kept = true
			let mut ends: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
			for (key, lists) in walk.assumed_ends {
				let seen = walk.written_ends.get(key) ?? {
					ends.insert(key.clone(), lists.clone())
					continue
				}
				let mut held: collections::BTreeSet[String] = collections::BTreeSet()
				for list in lists {
					if seen.contains(list) {
						held.insert(list.clone())
					} else {
						ends_kept = false
					}
				}
				ends.insert(key.clone(), held)
			}
			walk.assumed_ends = ends
			if walk.assumed.len() == before && ends_kept {
				settled = true
				break
			}
		}
	}
	if !settled {
		if !walk.shape.roots.is_empty() {
			walk.assumed = context.around.field_bounds.clone()
		}
		walk.assumed_ends.clear()
		walk.proven = no_proofs()
		bounding_pass(walk, args, body, context, program, words, ask)
	}
	// **What the body wrote into the list fields** (ADR-306 D21), for
	// `bounds_fields`.
	for (key, bound) in walk.written {
		if key.starts_with(".") && bound.is_bounded() {
			walk.proven.fields.insert(key.clone(), bound.clone())
		}
	}
	for key in walk.poisoned {
		if key.starts_with(".") {
			walk.proven.fields_lost.insert(key_root(key))
		}
	}
	if !walk.return_params.is_empty() {
		walk.proven.returned = bounding_returns_found(walk, body, words)
	}
	walk.proven.held = found_held
	return walk.proven.clone()
}

/// **The bounds of the list fields' values, found program-wide** (ADR-306
/// D21, #1397): D7's rounds, over the bodies that write a field the walks
/// see. Two rounds collect what they write, the second with what the first
/// found assumed; then each round keeps of the assumed bounds those every
/// write held, with them assumed, until none is dropped. Not settled, no
/// field has one.
fn bounds_fields(
	mut context: BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	context.around.field_bounds.clear()
	if context.around.fields.is_empty() {
		return
	}
	let writers = context.around.field_writers.clone()
	let mut bodies: Vec[ref Spanned[Item]] = []
	for item in program.items {
		match item.node {
			Item::Fn { .. } => {
				if writers.contains(item.span.start as i64) {
					bodies.push(item)
				}
			},
			Item::Impl { methods, .. } => {
				for method in methods {
					if writers.contains(method.span.start as i64) {
						bodies.push(method)
					}
				}
			},
			else => {},
		}
	}
	for _round in 0..<2 {
		context.around.field_bounds = fields_round(context, bodies, program, words, ask)
	}
	for _round in 0..<4 {
		let found = fields_round(context, bodies, program, words, ask)
		let before = context.around.field_bounds.len()
		let mut kept: collections::BTreeMap[String, Range] = collections::BTreeMap()
		for (key, bound) in context.around.field_bounds {
			let seen = found.get(key) ?? continue
			if bound.holds(seen) {
				kept.insert(key.clone(), bound.clone())
			}
		}
		context.around.field_bounds = kept
		if context.around.field_bounds.len() == before {
			return
		}
	}
	context.around.field_bounds.clear()
}

/// One round of [`bounds_fields`]: what every body wrote into each field,
/// joined, of the fields none wrote something unbounded into.
fn fields_round(
	mut context: BoundsContext,
	bodies: ref Vec[ref Spanned[Item]],
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> collections::BTreeMap[String, Range] {
	let mut written: collections::BTreeMap[String, Range] = collections::BTreeMap()
	let mut lost: collections::BTreeSet[String] = collections::BTreeSet()
	// The rules that hold depend on the context alone, not on the body
	// walked: found once a round, by the first body that needs them, not
	// once a body (#1581).
	context.around.held.clear()
	for item in bodies {
		match item.node {
			Item::Fn { args, body, .. } => {
				let proven = bounds_aggressive(args, body, collections::BTreeSet(), context, program, words, ask)
				for (of, holding) in proven.held {
					context.around.held.insert(of.clone(), holding.clone())
				}
				for (key, bound) in proven.fields {
					let was = written.get(key)
					if was != null {
						written.insert(key.clone(), (was ?? Range::open()).join(bound.clone()))
					} else {
						written.insert(key.clone(), bound.clone())
					}
				}
				lost.extend(proven.fields_lost.clone())
			},
			else => {},
		}
	}
	context.around.held.clear()
	let mut out: collections::BTreeMap[String, Range] = collections::BTreeMap()
	for (key, bound) in written {
		if !lost.contains(key) {
			out.insert(key.clone(), bound.clone())
		}
	}
	return out
}

fn bounding_new(
	args: ref Vec[FnArg],
	body: ref Block,
	nonnegative: collections::BTreeSet[String],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> BoundsWalk {
	let pinned = pinned_in(body, words)
	let mut shape = shape_of(args, body, pinned, context.around, words)
	// **A `comptime` of the module, written as a number**, is that number
	// wherever the body does not bind its name again.
	for item in program.items {
		match item.node {
			Item::Comptime { name, ty, value, .. } => {
				let text = words.resolve(name)
				let whole = bounding_declared_whole(ty, words) ?? true
				let n = match value {
					Expr::LitInt { value: digits, negative, .. } => integer_as_count(integer(
						digits,
						negative,
					)),
					else => null,
				}
				if whole
					&& n != null
					&& !shape.bound.contains(text)
					&& !shape.constants.contains_key(text) {
						shape.constants.insert(text.clone(), n ?? 0)
					}
			},
			else => {},
		}
	}
	let mut walk = BoundsWalk {
		arena: logic::TermArena::empty(),
		proven: no_proofs(),
		axioms: collections::BTreeMap(),
		unsized_names: collections::BTreeSet(),
		floors: collections::BTreeMap(),
		pinned: pinned,
		nonnegative: nonnegative,
		codes: 0,
		call_names: collections::BTreeMap(),
		loop_classes: collections::BTreeMap(),
		shape: shape,
		assumed: context.around.field_bounds.clone(),
		written: collections::BTreeMap(),
		poisoned: collections::BTreeSet(),
		assumed_ends: collections::BTreeMap(),
		written_ends: collections::BTreeMap(),
		steady: bounding_changed(body, context, words),
		end_roots: collections::BTreeSet(),
		unread: collections::BTreeSet(),
		collecting: false,
		at: 0,
		growing: collections::BTreeSet(),
		grow_failed: collections::BTreeSet(),
		falling: collections::BTreeSet(),
		fall_failed: collections::BTreeSet(),
		entries: 0,
		open: 0,
		missed: collections::BTreeMap(),
		missed_goals: [],
		through_loops: context.through_loops,
		turns: [],
		leaving: collections::BTreeSet(),
		settled_loops: collections::BTreeSet(),
		flagged: collections::BTreeMap(),
		typed: collections::BTreeMap(),
		rules: [],
		rule_roots: collections::BTreeMap(),
		rule_facts: [],
		capped: [],
		ordered: [],
		checking: false,
		checked_results: collections::BTreeSet(),
		rule_failed: collections::BTreeSet(),
		rule_loops: [],
		rule_built: collections::BTreeSet(),
		rule_built_literal: -1,
		lists: collections::BTreeSet(),
		return_params: [],
		return_each: false,
		return_below: null,
		return_names: collections::BTreeSet(),
		return_seen: collections::BTreeSet(),
		return_lost: false,
		return_ranging: false,
		return_range: null,
		return_unranged: false,
		return_scalars: [],
		return_lens: [],
		return_at_least: null,
		return_within: null,
		return_under: null,
		return_wanted: collections::BTreeMap(),
		return_wanted_alike: collections::BTreeSet(),
		return_sources: [],
		return_listed: collections::BTreeSet(),
		return_lengths: null,
		return_reaches: null,
		return_alike: null,
		return_measured: collections::BTreeSet(),
		return_assumed: [],
		return_field: "",
		found_at: -1,
		found_field: "",
		trace: context.trace.clone(),
		defining: collections::BTreeMap(),
		turn_rows: [],
	}
	for arg in args {
		let name = words.resolve(arg.name).clone()
		let ty = words.resolve(arg.ty.name).clone()
		if bounding_is_list_type(arg.ty, words) && !walk.shape.twice.contains(name) {
			walk.lists.insert(name.clone())
		}
		if arg.ty.generics.is_empty() && is_whole_number(ty) && !walk.shape.twice.contains(name) {
			walk.typed.insert(name.clone(), ty)
		}
		if !walk.shape.twice.contains(name) {
			walk.end_roots.insert(name)
		}
	}
	walk.end_roots.insert("self")
	for stmt in body.stmts {
		match stmt.node {
			Stmt::Let { names, ty, .. } => {
				for symbol in names {
					let name = words.resolve(symbol)
					if !walk.shape.twice.contains(name) {
						walk.end_roots.insert(name.clone())
						let tracked = walk.shape.roots.contains(name)
						if tracked && !values_read(body, name, words) {
							walk.unread.insert(name.clone())
						}
					}
				}
				let declared = ty ?? continue
				if names.len() == 1 && bounding_is_list_type(declared, words) && !walk.shape.twice.contains(words.resolve(names[0])) {
					walk.lists.insert(words.resolve(names[0]).clone())
				}
			},
			else => {},
		}
	}
	return walk
}

/// Whether `ty` is a `Vec`, a `List`, an `Array` or `Bytes` (#1516): an
/// index into one stops the program where it lies outside (Part III A.2),
/// where a map's hands back `null`.
fn bounding_is_list_type(ty: ref Type, words: ref winnow_grammar::InternerContext) -> bool {
	let name = words.resolve(ty.name)
	return !ty.is_nullable && !ty.is_tuple
		&& (name == "Vec" || name == "List" || name == "Array" || name == "Bytes")
}

/// One pass over the body: proofs into `proven`, what is written into
/// `written`.
fn bounding_pass(
	mut walk: BoundsWalk,
	args: ref Vec[FnArg],
	body: ref Block,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	walk.written.clear()
	walk.poisoned.clear()
	walk.written_ends.clear()
	walk.return_below = null
	walk.return_names.clear()
	walk.return_seen.clear()
	walk.return_lost = false
	walk.return_range = null
	walk.return_unranged = false
	walk.return_at_least = null
	walk.return_within = null
	walk.return_under = null
	walk.return_lengths = null
	walk.return_reaches = null
	walk.return_alike = null
	walk.return_measured.clear()
	let mut facts = BoundsFacts { ints: collections::BTreeSet(), facts: [], evicted: 0 }
	for arg in args {
		let name = words.resolve(arg.name).clone()
		let ty = words.resolve(arg.ty.name).clone()
		if arg.ty.generics.is_empty() && is_whole_number(ty) {
			facts.ints.insert(name.clone())
			if ty.starts_with("u") {
				bounding_at_least_zero(walk, facts, name)
			}
		}
		if ty == "Vec" || ty == "List" || ty == "Array" || ty == "Bytes" {
			bounding_at_least_zero(walk, facts, length_of(name))
		}
	}
	// **A grammar binding** (ADR-314 D1): a number within what it matched,
	// unless the action binds the name again.
	for (name, range) in context.given {
		if !walk.shape.bound.contains(name) {
			facts.ints.insert(name.clone())
			bounding_bounded(walk, facts, name, range)
		}
	}
	// A text binding's length, which nothing changes.
	for (name, range) in context.text_lengths {
		if !walk.shape.bound.contains(name) {
			bounding_bounded(walk, facts, length_of(name), range)
		}
	}
	// **What every caller proved** (ADR-391 D1): a derived precondition
	// holds at the entry like an `assert` written at the top.
	bounding_derived_entry(walk, facts, args, body, context)
	for name in walk.return_assumed.clone() {
		bounding_at_least_zero(walk, facts, name)
	}
	// **The rules between list fields** (ADR-369 D4), of `self` and of each
	// parameter of a type that has them.
	rules_given(walk, facts, args, words)
	// The body's statements walked as a block's, but what it ends with is
	// asked with the facts of its own names still held, as a `return` there
	// would be (#1653): a builder's tail hands back a local.
	let mut bound: Vec[String] = []
	let leaves = bounding_stmts(walk, body, 0, facts, bound, context, program, words, ask)
	if !leaves {
		// What the body ends with is what it hands back.
		rules_exit(walk, facts, rules_tail(body), false, context, program, words, ask)
	}
	for row in walk.turn_rows.clone() {
		bounding_trace_row(walk, row)
	}
}

/// **A value handed back, joined into the interval of every one** (ADR-306
/// D32), where the walk asks for it; one the walk has no interval of, or a
/// return without a value, leaves none.
fn bounding_return_range(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	returned: ref Expr?,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if !walk.return_ranging || walk.return_unranged {
		return
	}
	let value = returned ?? {
		walk.return_unranged = true
		return
	}
	let range = bounding_range(walk, value, facts, context, program, words, ask) ?? Range::open()
	if !range.is_bounded() {
		walk.return_unranged = true
		return
	}
	walk.return_range = match walk.return_range {
		null => range,
		before => before.join(range),
	}
}

/// **A return, against the relations the walk looks for** (ADR-306 D31):
/// the value proved at least each whole-number parameter of
/// `return_scalars`, at most as long as each list of `return_lens`, the
/// positions kept over every return.
fn bounding_return_relations(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	returned: ref Expr?,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if walk.return_scalars.is_empty() && walk.return_lens.is_empty() {
		return
	}
	let mut at_least: collections::BTreeSet[i64] = collections::BTreeSet()
	let mut within: collections::BTreeSet[i64] = collections::BTreeSet()
	let mut under: collections::BTreeSet[i64] = collections::BTreeSet()
	let term = match returned {
		null => null,
		value => bounding_lin(walk, value, facts, context, program, words),
	}
	if term != null {
		let v = term ?? 0
		for k in 0..<walk.return_scalars.len() {
			let param = walk.return_scalars[k].clone()
			if param.is_empty() {
				continue
			}
			let p = walk.arena.var(param)
			let goal = walk.arena.ge(v, p)
			if bounding_proves(walk, facts, goal, ask) {
				at_least.insert(k)
			}
		}
		for k in 0..<walk.return_lens.len() {
			let param = walk.return_lens[k].clone()
			if param.is_empty() {
				continue
			}
			let len = walk.arena.var(length_of(param))
			let goal = walk.arena.le(v, len)
			if bounding_proves(walk, facts, goal, ask) {
				within.insert(k)
				// Below it too (#1757): `return -1` as `return i` of an
				// `i < xs.len()`.
				let strict = walk.arena.lt(v, len)
				if bounding_proves(walk, facts, strict, ask) {
					under.insert(k)
				}
			}
		}
	}
	// **A call handed back holds what it is found to** (D31): a recursive
	// one's as the rounds assume them.
	if term == null && returned != null {
		let mut relations: Vec[(bool, i64)] = []
		match returned {
			null => {},
			value => {
				relations = bounding_relations_of(walk, facts, "result#", value, context, program, words, ask)
			},
		}
		for (least, bound) in relations {
			let names = if least { walk.return_scalars.clone() } else { walk.return_lens.clone() }
			for k in 0..<names.len() {
				if names[k].is_empty() {
					continue
				}
				let goal = if least {
					let p = walk.arena.var(names[k])
					walk.arena.ge(bound, p)
				} else {
					let len = walk.arena.var(length_of(names[k]))
					walk.arena.le(bound, len)
				}
				if bounding_proves(walk, facts, goal, ask) {
					if least {
						at_least.insert(k)
					} else {
						within.insert(k)
						let len = walk.arena.var(length_of(names[k]))
						let strict = walk.arena.lt(bound, len)
						if bounding_proves(walk, facts, strict, ask) {
							under.insert(k)
						}
					}
				}
			}
		}
	}
	if walk.return_at_least != null {
		at_least = bounding_kept(walk.return_at_least ?? collections::BTreeSet(), at_least)
	}
	if walk.return_within != null {
		within = bounding_kept(walk.return_within ?? collections::BTreeSet(), within)
	}
	if walk.return_under != null {
		under = bounding_kept(walk.return_under ?? collections::BTreeSet(), under)
	}
	walk.return_at_least = at_least
	walk.return_within = within
	walk.return_under = under
}

/// The positions both sets hold.
fn bounding_kept(before: ref collections::BTreeSet[i64], now: ref collections::BTreeSet[i64]) -> collections::BTreeSet[i64] {
	let mut kept: collections::BTreeSet[i64] = collections::BTreeSet()
	for k in before {
		if now.contains(k) {
			kept.insert(k)
		}
	}
	return kept
}

/// **What a call's found relations say of the name it is bound to**
/// (ADR-306 D31), stated before the name moves: for each argument the
/// result is at least, its term, or where it reads the name, the least it
/// is known to be; for each list it is at most as long as, the length.
/// Each is `(at least, term)`; nothing of a pending callee or one the walk
/// binds again.
fn bounding_relations_of(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Vec[(bool, i64)] {
	let mut out: Vec[(bool, i64)] = []
	if bounding_found_options(value) {
		return out
	}
	let callee = bounding_found_key(walk, value, context, words) ?? return out
	let found = context.returns.get(callee) ?? return out
	if found.each || found.pending {
		return out
	}
	for k in found.at_least {
		let term = bounding_found_term(walk, value, k, facts, context, program, words) ?? continue
		if !walk.arena.mentions(term, name) {
			out.push((true, term))
			continue
		}
		let least = bounding_term(walk, term, facts, ask).lo ?? continue
		out.push((true, walk.arena.int(least)))
	}
	for k in found.within {
		let path = bounding_found_path(value, found, k, words) ?? continue
		if walk.pinned.contains(path_root(path)) || path_within(path, name) || path_within(name, path) {
			continue
		}
		let len = bounding_length_named(walk, path, false)
		// Below the length (#1757): at most one less.
		if found.under.contains(k) {
			let one = walk.arena.int(1)
			out.push((false, walk.arena.sub(len, one)))
		} else {
			out.push((false, len))
		}
	}
	return out
}

/// **Whether a call's result is found at least an argument that is at
/// least `name`** (ADR-306 D31): what it is assigned to `name` raises it.
fn bounding_relation_grows(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	if bounding_found_options(value) {
		return false
	}
	let callee = bounding_found_key(walk, value, context, words) ?? return false
	let found = context.returns.get(callee) ?? return false
	if found.each || found.pending {
		return false
	}
	let now = walk.arena.var(name)
	for k in found.at_least {
		let term = bounding_found_term(walk, value, k, facts, context, program, words) ?? continue
		let goal = walk.arena.ge(term, now)
		if bounding_proves(walk, facts, goal, ask) {
			return true
		}
	}
	return false
}

/// The relations [`bounding_relations_of`] found, as facts of `name`.
fn bounding_relations_push(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, relations: ref Vec[(bool, i64)]) {
	if relations.is_empty() {
		return
	}
	let n = walk.arena.var(name)
	for (least, term) in relations {
		let fact = if least { walk.arena.ge(n, term) } else { walk.arena.le(n, term) }
		bounding_push(walk, facts, fact)
	}
}

/// **The interval a body's every value handed back lies in** (ADR-306 D32):
/// a grammar action's, walked with `context` as its alternative's bindings
/// give it; nothing where one value has none.
fn bounds_action_range(
	body: ref Block,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Range? {
	let none: Vec[FnArg] = []
	let mut walk = bounding_new(none, body, bp_names(nonnegative_locals(body), words), context, program, words)
	walk.return_ranging = true
	bounds_rounds(walk, none, body, context, program, words, ask)
	if walk.return_unranged || walk.return_lost {
		return null
	}
	if seek_block(body, Seek::Unvisited(walk.return_seen.clone()), words) {
		return null
	}
	return walk.return_range?.clone()
}

/// The bounds this pass found: every key written, none written something
/// unbounded.
fn bounding_found(walk: ref BoundsWalk) -> collections::BTreeMap[String, Range] {
	let mut out: collections::BTreeMap[String, Range] = collections::BTreeMap()
	for (key, bound) in walk.written {
		if bound.is_bounded() && !bounding_poisoned(walk, key) && !key.starts_with(".") {
			out.insert(key.clone(), bound.clone())
		}
	}
	return out
}

/// The ends this pass found (ADR-306 D21): of each key, the lists every
/// write into it was proved below.
fn bounding_found_ends(walk: ref BoundsWalk) -> collections::BTreeMap[String, collections::BTreeSet[String]] {
	let mut out: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
	for (key, lists) in walk.written_ends {
		if !lists.is_empty() {
			out.insert(key.clone(), lists.clone())
		}
	}
	return out
}

/// A key is out where it, or a list it is part of, was written something
/// unbounded: `xs.push(ys)` with `ys` unknown says nothing of `xs[]`.
fn bounding_poisoned(walk: ref BoundsWalk, key: ref String) -> bool {
	let mut at = key_root(key)
	let parts: Vec[ref String] = key.split("[").collect()
	for _part in 0..<parts.len() {
		if walk.poisoned.contains(at) {
			return true
		}
		at.push_str("[]")
	}
	return false
}

/// The bound assumed of `key`'s values, where there is one.
fn bounding_assumed(walk: ref BoundsWalk, key: ref String) -> Range? {
	let bound = walk.assumed.get(key) ?? return null
	return bound.clone()
}

/// **`value` is written into the list whose elements are `key`** (ADR-306
/// D7): a number joins the key's bound, a list's items join `key[]`'s, a
/// list the walk knows joins its bound into `key[]`.
fn bounding_write(
	mut walk: BoundsWalk,
	key: ref String,
	value: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if !tracks(walk.shape, key) {
		return
	}
	let inner = f"{key}[]"
	match value {
		Expr::ListLit { items, .. } => {
			for item in items {
				bounding_write(walk, inner, item, facts, context, program, words, ask)
			}
			return
		},
		Expr::ListRepeat { value: item, .. } => {
			bounding_write(walk, inner, item, facts, context, program, words, ask)
			return
		},
		else => {},
	}
	bounding_end_write(walk, key, value, facts, context, program, words, ask)
	let range = bounding_range(walk, value, facts, context, program, words, ask)
	if range != null {
		bounding_join(walk, key, range ?? Range::open())
		return
	}
	let elements = elements_key(walk.shape, value, words)
	if elements != null {
		let bound = bounding_assumed(walk, elements ?? "")
		if bound != null {
			bounding_join(walk, inner, bound ?? Range::open())
		} else {
			walk.poisoned.insert(inner)
		}
		return
	}
	walk.poisoned.insert(key.clone())
}

/// **The lists `value`, written into `key`'s list, is proved to lie below**
/// (ADR-306 D21, #1397): of the lengths the facts read, those of a list the
/// body never changes, read through a name that is one thing all through
/// it, `0 <= value < e.len()`. A value read out of a list takes that list's
/// ends. What the key's writes so far were proved below keeps only these.
fn bounding_end_write(
	mut walk: BoundsWalk,
	key: ref String,
	value: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if key.contains("[") || key.starts_with(".") || walk.unread.contains(key) {
		return
	}
	let mut below: collections::BTreeSet[String] = collections::BTreeSet()
	// **Only the lists an end can still be** are asked about (#1590): what
	// the key's writes so far this pass were proved below, and on a pass
	// that proves, of the ends assumed; the rest is dropped by the
	// intersection below or by the round's own (`bounds_rounds`).
	let mut only = walk.written_ends.get(key)?.clone()
	if only == null && !walk.collecting {
		only = walk.assumed_ends.get(key)?.clone() ?? collections::BTreeSet()
	}
	let term = bounding_lin(walk, value, facts, context, program, words)
	if term != null {
		let v = term ?? 0
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		for fact in facts.facts {
			walk.arena.variables(fact, read)
		}
		let zero = walk.arena.int(0)
		for name in read {
			let list = name.strip_suffix(".len()") ?? continue
			if only != null && !(only?.contains(list) ?? false) {
				continue
			}
			if !bounding_end_list(walk, list, key) {
				continue
			}
			let low = walk.arena.ge(v, zero)
			let len = walk.arena.var(name)
			let high = walk.arena.lt(v, len)
			let goal = walk.arena.and([low, high])
			if bounding_proves(walk, facts, goal, ask) {
				below.insert(list.clone())
			}
		}
	} else {
		match value {
			Expr::Index { base, .. } => {
				let from = elements_key(walk.shape, base, words) ?? ""
				below = walk.assumed_ends.get(from)?.clone() ?? collections::BTreeSet()
			},
			else => {},
		}
	}
	let was = walk.written_ends.get(key)?.clone()
	if was != null {
		let mut kept: collections::BTreeSet[String] = collections::BTreeSet()
		for list in was ?? collections::BTreeSet() {
			if below.contains(list) {
				kept.insert(list.clone())
			}
		}
		below = kept
	}
	walk.written_ends.insert(key.clone(), below)
}

/// Whether `list` may be an end of `key`'s values: its root is one thing
/// all through the body, and the body changes neither it, nor a value it is
/// a part of, nor its length.
fn bounding_end_list(walk: ref BoundsWalk, list: ref String, key: ref String) -> bool {
	let root = path_root(list)
	if root == key_root(key) || !walk.end_roots.contains(root) || walk.pinned.contains(root) {
		return false
	}
	// A list that only grows stays an end (#1414): a value below its
	// length at the write stays below it.
	if walk.steady.falls.contains(list) {
		return false
	}
	for name in walk.steady.values {
		if list == name || list.starts_with(f"{name}.") {
			return false
		}
	}
	// A change to the parts of the list itself leaves its length aside.
	for name in walk.steady.parts {
		if list.starts_with(f"{name}.") {
			return false
		}
	}
	return true
}

/// **What `key`'s ends say of a value read out of it**, bound to `name`:
/// `0 <= name < e.len()` for each (ADR-306 D21).
fn bounding_end_facts(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, key: ref String) {
	let ends = walk.assumed_ends.get(key) ?? return
	if ends.is_empty() {
		return
	}
	let lists = ends.clone()
	let n = walk.arena.var(name)
	let zero = walk.arena.int(0)
	facts.ints.insert(name.clone())
	let low = walk.arena.ge(n, zero)
	bounding_push(walk, facts, low)
	for list in lists {
		let len = walk.arena.var(length_of(list))
		let high = walk.arena.lt(n, len)
		bounding_push(walk, facts, high)
	}
}

/// **An index read out of a list whose ends bound its values** (ADR-306
/// D21): `list[xs[i]]` lies inside where `xs`'s ends do.
fn bounding_end_inside(
	mut walk: BoundsWalk,
	len: i64,
	index: ref Expr,
	facts: ref BoundsFacts,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let base = match index {
		Expr::Index { base, .. } => base,
		else => return false,
	}
	let key = elements_key(walk.shape, base, words) ?? return false
	if !walk.assumed_ends.contains_key(key) {
		return false
	}
	let mut known = BoundsFacts { ints: facts.ints.clone(), facts: facts.facts.clone(), evicted: facts.evicted }
	let each = f"{key}.end()"
	bounding_end_facts(walk, known, each, key)
	let n = walk.arena.var(each)
	let zero = walk.arena.int(0)
	let low = walk.arena.ge(n, zero)
	let high = walk.arena.lt(n, len)
	let goal = walk.arena.and([low, high])
	return bounding_proves_goal(walk, known, goal, ask)
}

/// **The list fields a literal or a `with` gives** (ADR-306 D21), each the
/// whole list it is written: `name` alone is `name: name`.
fn bounding_field_inits(
	mut walk: BoundsWalk,
	fields: ref Vec[FieldInit],
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	for field in fields {
		let name = words.resolve(field.name)
		let key = f".{name}"
		if !walk.shape.fields.contains(key) {
			continue
		}
		if field.value != null {
			bounding_field_list(walk, key, field.value ?? continue, facts, context, program, words, ask)
			continue
		}
		let mut elements: String? = null
		if walk.shape.roots.contains(name) {
			elements = name.clone()
		} else {
			elements = walk.shape.aliases.get(name)?.clone()
		}
		let bound = bounding_assumed(walk, elements ?? "")
		if elements != null && bound != null {
			bounding_join(walk, key, bound ?? Range::open())
		} else {
			walk.poisoned.insert(key)
		}
	}
}

/// **`value`, a whole list, is written into the field whose values are
/// `key`** (ADR-306 D21): a literal's items each, a list the walk knows its
/// bound; anything else leaves the field unbounded.
fn bounding_field_list(
	mut walk: BoundsWalk,
	key: ref String,
	value: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	match value {
		Expr::ListLit { items, .. } => {
			for item in items {
				bounding_write(walk, key, item, facts, context, program, words, ask)
			}
			return
		},
		Expr::ListRepeat { value: item, .. } => {
			bounding_write(walk, key, item, facts, context, program, words, ask)
			return
		},
		else => {},
	}
	// An empty map writes no value (ADR-306 D24).
	if is_empty_map(value, words) {
		return
	}
	let elements = elements_key(walk.shape, value, words)
	if elements != null {
		let bound = bounding_assumed(walk, elements ?? "")
		if bound != null {
			bounding_join(walk, key, bound ?? Range::open())
			return
		}
	}
	walk.poisoned.insert(key.clone())
}

fn bounding_join(mut walk: BoundsWalk, key: ref String, range: Range) {
	if !range.is_bounded() {
		walk.poisoned.insert(key.clone())
		return
	}
	let mut joined = range
	let was = walk.written.get(key)
	if was != null {
		joined = (was ?? Range::open()).join(range)
	}
	walk.written.insert(key.clone(), joined)
}

/// **A goal's question** (an index, an operation, a conversion): as
/// [`bounding_proves`], and where it is left open, the names it reads are
/// what the walk missed (ADR-361 D2), stamped with the open count.
fn bounding_proves_goal(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	goal: i64,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	if bounding_proves(walk, facts, goal, ask) {
		bounding_traced(walk, facts, goal, true)
		return true
	}
	bounding_traced(walk, facts, goal, false)
	bounding_missed(walk, facts, goal)
	return false
}

/// Whether `--bounds-trace` asks about the statement being walked
/// (#1495): never on a pass that only collects.
fn bounding_tracing(walk: ref BoundsWalk) -> bool {
	return walk.trace.len() == 2 && !walk.collecting && walk.at >= walk.trace[0] && walk.at < walk.trace[1]
}

/// **A goal as `--bounds-trace` shows it** (#1495): the goal and whether it
/// was proved, every fact the question was asked with (`bounding_known`,
/// the rule facts among them), how many facts were connected to it and held
/// (ADR-306 D30), how many the `most_held()` cap dropped, and
/// the rules of the types the body uses.
fn bounding_traced(mut walk: BoundsWalk, facts: ref BoundsFacts, goal: i64, proved: bool) {
	if !bounding_tracing(walk) {
		return
	}
	let verdict = if proved { "proved" } else { "open" }
	let mut known: Vec[String] = []
	for fact in bounding_known(walk, facts, goal) {
		known.push(walk.arena.text(fact))
	}
	let mut rules: Vec[String] = []
	for rule in walk.rules {
		rules.push(if rule.times == 1 { f"{rule.owner}: {rule.kind} {rule.a} {rule.b}" } else { f"{rule.owner}: {rule.kind} {rule.a} {rule.times}*{rule.b}" })
	}
	let held = if known.is_empty() { "none" } else { known.join(", ") }
	let found = if rules.is_empty() { "none" } else { rules.join(", ") }
	let connected = bounding_nearest(walk, facts, goal, facts.facts.len()).iter().filter(fn(taken) { taken }).count()
	bounding_trace_row(walk, f"  goal {walk.arena.text(goal)}: {verdict}\n    facts ({known.len()} asked; {connected} connected of {facts.facts.len()} held, {facts.evicted} evicted by the cap of {most_held()}): {held}\n    rules: {found}")
}

/// **A row of a loop's invariant search** (#1669), where `--bounds-trace`
/// asks about the statement at `at`, collecting walks too.
fn bounding_turn_row(mut walk: BoundsWalk, at: i64, row: String) {
	if walk.trace.len() == 2 && at >= walk.trace[0] && at < walk.trace[1] && !walk.turn_rows.contains(row) {
		walk.turn_rows.push(row)
	}
}

fn bounding_texts(walk: ref BoundsWalk, terms: ref Vec[i64]) -> String {
	let mut out: Vec[String] = []
	for term in terms {
		out.push(walk.arena.text(term))
	}
	return if out.is_empty() { "none" } else { out.join(", ") }
}

/// One row of `--bounds-trace`, once however often a loop is walked again.
fn bounding_trace_row(mut walk: BoundsWalk, row: String) {
	if !walk.proven.trace.contains(row) {
		walk.proven.trace.push(row)
	}
}

/// A goal left open: where the walk keeps them (ADR-361 D2), what it read.
fn bounding_missed(mut walk: BoundsWalk, facts: ref BoundsFacts, goal: i64) {
	if walk.through_loops {
		walk.open += 1
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(goal, read)
		// **A name a fact ties to the goal's names by itself** (#1634):
		// `was[k]` under `k < a` asks the loop that changes `a` before it.
		let mut tied: Vec[String] = []
		for fact in facts.facts {
			let mut names: collections::BTreeSet[String] = collections::BTreeSet()
			walk.arena.variables(fact, names)
			if names.len() != 2 {
				continue
			}
			let mut touches = false
			for name in names {
				if read.contains(name) {
					touches = true
				}
			}
			if touches {
				for name in names {
					if !read.contains(name) {
						tied.push(name.clone())
					}
				}
			}
		}
		for name in read {
			walk.missed.insert(name.clone(), walk.open)
		}
		for name in tied {
			walk.missed.insert(name.clone(), walk.open)
		}
		walk.missed_goals.push(BoundsMissed {
			stamp: walk.open,
			goal: goal,
			facts: facts.facts.clone(),
		})
		if walk.missed_goals.len() > 64 {
			walk.missed_goals.remove(0)
		}
	}
}

/// **A goal left open**, with what held where it was asked: the cheap test
/// of whether a loop's candidates could prove anything (ADR-361 D2).
struct BoundsMissed {
	stamp: i64,
	goal: i64,
	facts: Vec[i64],
}

/// Whether `goal` follows from what holds, on a certificate the checker
/// accepts.
fn bounding_proves(
	walk: ref BoundsWalk,
	facts: ref BoundsFacts,
	goal: i64,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	return ask(walk.arena, bounding_known(walk, facts, goal), goal)
}

/// **Which facts held a question about `asked` takes** (ADR-306 D30), by
/// their position: at most `most` of those connected to the goal, the
/// nearest first. A fact is reached through a name it shares with the goal
/// or with a fact reached before, and the way through a name is as long as
/// the number of facts that name it: a name every turn fact reads (a loop's
/// `#turn`) joins everything and tells little, so the narrow ways are
/// followed first. Of one distance the newest is taken. A fact that names
/// nothing (a contradiction) is nearest of all. What the ledgers ensure
/// (`axioms`) and the rule facts of a named element are ways between names
/// too, though they are not among the facts taken.
fn bounding_nearest(walk: ref BoundsWalk, facts: ref BoundsFacts, asked: i64, most: i64) -> Vec[bool] {
	let mut ways: Vec[collections::BTreeSet[String]] = []
	for fact in facts.facts {
		let mut own: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(fact, own)
		ways.push(own)
	}
	let held = ways.len()
	for (_, axiom) in walk.axioms {
		let mut own: collections::BTreeSet[String] = collections::BTreeSet()
		for fact in axiom {
			walk.arena.variables(fact, own)
		}
		if own.len() > 1 {
			ways.push(own)
		}
	}
	for (each, fact) in walk.rule_facts {
		let mut own: collections::BTreeSet[String] = collections::BTreeSet()
		own.insert(each.clone())
		walk.arena.variables(fact, own)
		if own.len() > 1 {
			ways.push(own)
		}
	}
	let mut ids: collections::BTreeMap[String, i64] = collections::BTreeMap()
	let mut readers: Vec[Vec[i64]] = []
	for k in 0..<ways.len() {
		for name in ways[k] {
			let id = ids.get(name) ?? readers.len()
			if id == readers.len() {
				ids.insert(name.clone(), id)
				readers.push([])
			}
			readers[id].push(k)
		}
	}
	let mut near: Vec[i64] = []
	let mut taken: Vec[bool] = []
	for own in ways {
		near.push(if own.is_empty() { 0 } else { -1 })
		taken.push(false)
	}
	let mut reached: Vec[bool] = []
	for _ in readers {
		reached.push(false)
	}
	let mut goal: collections::BTreeSet[String] = collections::BTreeSet()
	walk.arena.variables(asked, goal)
	for name in goal {
		let id = ids.get(name) ?? continue
		reached[id] = true
		let through = readers[id].len()
		for k in readers[id] {
			if near[k] < 0 || through < near[k] {
				near[k] = through
			}
		}
	}
	let mut count = 0
	while count < most {
		let mut best = -1
		for k in 0..<ways.len() {
			if !taken[k] && near[k] >= 0 && (best < 0 || near[k] <= near[best]) {
				best = k
			}
		}
		if best < 0 {
			break
		}
		taken[best] = true
		if best < held {
			count += 1
		}
		for name in ways[best] {
			let id = ids.get(name) ?? continue
			if reached[id] {
				continue
			}
			reached[id] = true
			let through = near[best] + readers[id].len()
			for k in readers[id] {
				if near[k] < 0 || through < near[k] {
					near[k] = through
				}
			}
		}
	}
	let mut out: Vec[bool] = []
	for k in 0..<held {
		out.push(taken[k])
	}
	return out
}

/// The facts a question is asked with (ADR-306 D30): every fact held
/// where they are no more than `most_facts()`, else the nearest
/// `most_facts()` to its goal (`bounding_nearest`), in the order they hold;
/// and what the ledgers ensure of the values the walk named.
fn bounding_known(walk: ref BoundsWalk, facts: ref BoundsFacts, asked: i64) -> Vec[i64] {
	let mut all: Vec[i64] = []
	if facts.facts.len() <= most_facts() {
		all = facts.facts.clone()
	} else {
		let asking = bounding_nearest(walk, facts, asked, most_facts())
		for k in 0..<facts.facts.len() {
			if asking[k] {
				all.push(facts.facts[k])
			}
		}
	}
	if !walk.rule_facts.is_empty() {
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(asked, read)
		for fact in all {
			walk.arena.variables(fact, read)
		}
		for (each, fact) in walk.rule_facts {
			if read.contains(each) && rules_standing(walk, facts, fact) {
				all.push(fact)
			}
		}
	}
	for (name, axiom) in walk.axioms {
		if !walk.unsized_names.contains(name) {
			for fact in axiom {
				all.push(fact)
			}
		}
	}
	for (_, defined) in walk.defining {
		for fact in defined {
			all.push(fact)
		}
	}
	for (name, floor) in walk.floors {
		if walk.unsized_names.contains(name) {
			all.push(floor)
		}
	}
	return all
}

/// **What is known of a linear term, as constants**: a candidate from
/// interval propagation over the facts, as Wuffs bounds a value, each end
/// then confirmed by the solver on a certificate the checker accepts. An end
/// the solver does not confirm is open.
fn bounding_term(
	mut walk: BoundsWalk,
	term: i64,
	facts: ref BoundsFacts,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Range {
	let known = walk.arena.constant(term)
	if known != null {
		return Range::exactly(known ?? 0)
	}
	let guess = candidate(term, bounding_known(walk, facts, term), fn(at) { walk.arena.at(at) })
	let mut confirmed = Range::open()
	if guess.hi != null {
		let hi = guess.hi ?? 0
		let k = walk.arena.int(hi)
		let goal = walk.arena.le(term, k)
		if bounding_proves(walk, facts, goal, ask) {
			confirmed.hi = hi
		}
	}
	if guess.lo != null {
		let lo = guess.lo ?? 0
		let k = walk.arena.int(lo)
		let goal = walk.arena.ge(term, k)
		if bounding_proves(walk, facts, goal, ask) {
			confirmed.lo = lo
		}
	}
	return confirmed
}

/// **The whole-number type of a name, field or element** the walk reads as a
/// term (ADR-306 D34), where it knows one.
fn bounding_type_of(
	walk: ref BoundsWalk,
	expr: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> String? {
	match expr {
		Expr::Variable(name, _) => {
			let ty = walk.typed.get(words.resolve(name)) ?? return null
			return ty.clone()
		},
		Expr::Field { .. } => {},
		Expr::Index { .. } => {},
		else => return null,
	}
	let ty = context.whole_types.get(node_key(expr)) ?? return null
	return ty.clone()
}

/// **The constants a whole number lies between**, where the walk can tell:
/// a linear term by the solver, and around it `%` (ADR-306 D8), `>>`, `&`, a
/// conversion, a truncation, and a value read out of a list whose values are
/// bounded (D2). Nothing is "not a number the walk knows", which is also
/// what anything else is.
fn bounding_range(
	mut walk: BoundsWalk,
	expr: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Range? {
	let term = bounding_lin(walk, expr, facts, context, program, words)
	if term != null {
		let found = bounding_term(walk, term ?? 0, facts, ask)
		// **A quotient, a shift or a turned bit is a number of its own**
		// (#1631), of which the solver may find less than the interval rules
		// of its operator do: the narrower of the two.
		if !bounding_reads_own(walk, term ?? 0) {
			return found
		}
		let shaped = bounding_range_shaped(walk, expr, facts, context, program, words, ask)
			?? return found
		let solved = found ?? return shaped
		return solved.meet(shaped)
	}
	return bounding_range_shaped(walk, expr, facts, context, program, words, ask)
}

/// `bounding_range` by the shape of `expr`, its linear term aside.
fn bounding_range_shaped(
	mut walk: BoundsWalk,
	expr: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Range? {
	match expr {
		Expr::Binary { op, lhs, rhs, span, .. } => return bounding_range_of(
			walk,
			op,
			lhs,
			rhs,
			span.start as i64,
			facts,
			context,
			program,
			words,
			ask,
		),
		Expr::Unary { op, expr, .. } => {
			match op {
				UnaryOp::Neg => {
					let inner = bounding_range(walk, expr, facts, context, program, words, ask)
						?? return null
					return inner.neg()
				},
				else => {},
			}
		},
		// A conversion keeps its value or stops the program.
		Expr::Cast { expr, ty, .. } => {
			if ty.generics.is_empty() {
				let into = Range::held_by_type(words.resolve(ty.name)) ?? return null
				let got = bounding_range(walk, expr, facts, context, program, words, ask)
					?? return into
				return got.meet(into)
			}
		},
		Expr::MethodCall { receiver, method, args, .. } => {
			if args.is_empty() {
				let name = words.resolve(method)
				if name == "len" {
					return Range { lo: 0, hi: null }
				}
				// `bits_as_` too (ADR-285 D42): a value the destination holds
				// keeps it, any other is somewhere in the destination's range.
				// Any other method of no argument is read for its found
				// returns below (ADR-306 D34, #1920).
				if name.starts_with("bits_as_") || name.starts_with("truncating_") {
					let mut dropped = 11
					if name.starts_with("bits_as_") {
						dropped = 8
					}
					let into = Range::held_by_type(bounding_dropped(name, dropped)) ?? return null
					let got = bounding_range(walk, receiver, facts, context, program, words, ask)
						?? return into
					if into.holds(got) {
						return got
					}
					return into
				}
			}
			// **A value read out of a map lies where every value put into it
			// does** (ADR-306 D24), as one read out of a list.
			if args.len() == 1 && words.resolve(method) == "get" {
				let key = elements_key(walk.shape, receiver, words) ?? return null
				return bounding_assumed(walk, key)
			}
			// **A method's value lies where its every return is found
			// to** (ADR-306 D34), as a free function's below.
			if !bounding_found_options(expr) {
				let callee = bounding_found_key(walk, expr, context, words) ?? return null
				let found = context.returns.get(callee) ?? return null
				if found.each || found.pending {
					return null
				}
				return found.range?.clone()
			}
		},
		Expr::Index { base, .. } => {
			let key = elements_key(walk.shape, base, words) ?? return null
			return bounding_assumed(walk, key)
		},
		// **A call's value lies where the callee's every return is found
		// to** (ADR-306 D23, D32): `hex_value(c)` in `0..=156678`.
		Expr::Call { func, config, .. } => {
			if !config.is_empty() {
				return null
			}
			let callee = bounding_found_key(walk, expr, context, words) ?? return null
			let found = context.returns.get(callee) ?? return null
			if found.each || found.pending {
				return null
			}
			return found.range?.clone()
		},
		Expr::If { cond, then_branch, else_branch, .. } => return bounding_if_range(
			walk,
			cond,
			then_branch,
			else_branch,
			facts,
			context,
			program,
			words,
			ask,
		),
		// **`x ?? d` lies where the number `x` holds or `d` does**: what the
		// ledger ensures of a callee's `result` is said of the number in it.
		Expr::Coalesce { value, fallback, .. } => {
			let held = bounding_range(walk, value, facts, context, program, words, ask)
				?? return null
			// `x ?? return`, `?? continue`, `?? break` leave: `x` is read.
			if bounding_leaves(fallback) {
				return held
			}
			let otherwise = bounding_range(walk, fallback, facts, context, program, words, ask)
				?? return null
			let joined = held.join(otherwise)
			if joined.is_bounded() {
				return joined
			}
		},
		else => {},
	}
	return null
}

/// **An `if` expression lies where both its arms do**: the join of each
/// arm's range, each under its condition. Where the condition is a `comptime`
/// the build decided, the arm it takes.
fn bounding_if_range(
	mut walk: BoundsWalk,
	cond: ref Expr,
	then_branch: ref Block,
	else_branch: ref Block?,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Range? {
	let otherwise = else_branch ?? return null
	let decided = bounding_decided(walk, cond, context, words)
	let mut then_range: Range? = null
	if decided ?? true {
		let mut then_facts = facts.clone()
		bounding_assume(walk, then_facts, cond, context, program, words)
		then_range = bounding_arm_range(walk, then_branch, then_facts, context, program, words, ask)
		if decided != null {
			return then_range
		}
	}
	let mut else_facts = facts.clone()
	bounding_assume_not(walk, else_facts, cond, context, program, words)
	let else_range = bounding_arm_range(walk, otherwise, else_facts, context, program, words, ask)
		?? return null
	if decided != null {
		return else_range
	}
	let first = then_range ?? return null
	let joined = first.join(else_range)
	if joined.is_bounded() {
		return joined
	}
	return null
}

/// The range of an arm that is only its value: an arm that binds a name
/// first may bind one the facts speak of.
fn bounding_arm_range(
	mut walk: BoundsWalk,
	arm: ref Block,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Range? {
	if arm.stmts.len() != 1 {
		return null
	}
	return match arm.stmts[0].node {
		Stmt::Expr(value) => bounding_range(walk, value, facts, context, program, words, ask),
		else => null,
	}
}

/// **The value the build computed for a condition**: a `comptime` of the
/// module of type `bool` the body does not bind again, or `!` of one.
fn bounding_decided(
	walk: ref BoundsWalk,
	cond: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> bool? {
	match cond {
		Expr::Variable(name, _) => {
			let text = words.resolve(name)
			if walk.shape.bound.contains(text) {
				return null
			}
			return context.decided[text]
		},
		Expr::Unary { op, expr, .. } => {
			match op {
				UnaryOp::Not => {
					let inner = bounding_decided(walk, expr, context, words) ?? return null
					return !inner
				},
				else => {},
			}
		},
		else => {},
	}
	return null
}

/// `text` without its first `count` characters.
fn bounding_dropped(text: ref String, count: i64) -> String {
	let c: Vec[scalar] = text.scalars.collect()
	let mut out: String = ""
	for k in count..<c.len() {
		out.push(c[k])
	}
	return out
}

/// `lhs op rhs`, where it is not a linear term.
fn bounding_range_of(
	mut walk: BoundsWalk,
	op: ref BinaryOp,
	lhs: ref Expr,
	rhs: ref Expr,
	at: i64,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Range? {
	match op {
		BinaryOp::Add => {
			let a = bounding_range(walk, lhs, facts, context, program, words, ask) ?? return null
			let b = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
			return a.add(b)
		},
		BinaryOp::Sub => {
			let a = bounding_range(walk, lhs, facts, context, program, words, ask) ?? return null
			let b = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
			return a.add(b.neg())
		},
		BinaryOp::Mul => {
			let a = bounding_range(walk, lhs, facts, context, program, words, ask) ?? return null
			let b = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
			return a.mul(b)
		},
		// **`x / d` with `1 <= d1 <= d <= d2` and `a <= x <= b`** lies
		// between `a / d1` (`a / d2` where `a >= 0`) and `b / d1` (`b / d2`
		// where `b < 0`): the quotient is rounded toward zero, so it moves
		// with `x` and toward zero with `d` (ADR-306 D34).
		BinaryOp::Div => {
			let d = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
			let d1 = d.lo ?? return null
			let d2 = d.hi ?? return null
			if d1 < 1 {
				return null
			}
			// **A term's type is its range** (ADR-306 D34), where nothing
			// narrower is found: `self.bump / 1073741824` of an `i64`.
			let mut x = bounding_range(walk, lhs, facts, context, program, words, ask) ?? Range::open()
			let ty = bounding_type_of(walk, lhs, context, words)
			if ty != null {
				let held = Range::held_by_type(ty ?? "")
				if held != null {
					x = x.meet(held ?? Range::open())
				}
			}
			let mut out = Range::open()
			if x.lo != null {
				let a = x.lo ?? 0
				out.lo = if a >= 0 { a / d2 } else { a / d1 }
			}
			if x.hi != null {
				let b = x.hi ?? 0
				out.hi = if b >= 0 { b / d1 } else { b / d2 }
			}
			return out
		},
		// **`0 <= x % n < n`** where `x` is not negative and `n` is
		// positive; `|x % n| < n` where only `n` is known.
		BinaryOp::Rem => {
			let n = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
			let low = n.lo ?? return null
			let high = n.hi ?? return null
			if low < 1 {
				return null
			}
			let x = bounding_range(walk, lhs, facts, context, program, words, ask)
			return bounding_remainder(x, high)
		},
		BinaryOp::Shr => {
			let by = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
			let k = by.lo ?? return null
			let same = by.hi ?? return null
			if k != same || k < 0 || k >= 64 {
				return null
			}
			// **An unsigned value shifted right by `k` is below `2^(w - k)`**
			// for its type's width `w`, whatever the walk knows of it.
			let mut widest: Range? = null
			let ty = context.shifts[at] ?? ""
			let width = bounding_bits(ty) ?? 0
			if ty.starts_with("u") && width > 0 && k >= 1 && k < width {
				let most = (1 << (width - k).min(62)) - 1
				widest = Range { lo: 0, hi: most }
			}
			// **A signed value shifted right by `k` is inside
			// `-2^(w - 1 - k)..<2^(w - 1 - k)`**: the shift keeps the sign,
			// so `x >> 63` of an `i64` is `0` or `-1` (#776).
			if ty.starts_with("i") && width > 0 && k >= 1 && k < width {
				let by = width - 1 - k
				let half: i64 = 1 << by
				let below = half - 1
				widest = Range { lo: -half, hi: below }
			}
			let known = bounding_range(walk, lhs, facts, context, program, words, ask)
			let x = known ?? return widest
			let lo = x.lo ?? return widest
			if lo < 0 {
				return widest
			}
			let mut shifted = Range { lo: lo >> k, hi: (widest ?? Range { lo: 0, hi: null }).hi }
			if x.hi != null {
				shifted.hi = (x.hi ?? 0) >> k
			}
			return shifted
		},
		// **`a ^ b` of two values inside `-2^m..<2^m` stays inside it**: in
		// two's complement both have only copies of their sign above bit
		// `m`, and so has the result (#776).
		BinaryOp::BitXor => {
			let a = bounding_range(walk, lhs, facts, context, program, words, ask) ?? return null
			let b = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return null
			let m = (bounding_sign_bits(a) ?? return null).max(bounding_sign_bits(b) ?? return null)
			let half = 1 << m
			return Range { lo: -half, hi: half - 1 }
		},
		BinaryOp::BitAnd => {
			let mut mask: i64? = null
			let first = bounding_mask(walk, lhs, facts, context, program, words)
			if first != null {
				mask = first
			}
			let second = bounding_mask(walk, rhs, facts, context, program, words)
			if second != null {
				mask = second
			}
			let most = mask ?? return null
			return Range { lo: 0, hi: most }
		},
		else => {},
	}
	return null
}

/// The least `m <= 62` with `range` inside `-2^m..<2^m`; nothing where it
/// is open or wider.
fn bounding_sign_bits(range: ref Range) -> i64? {
	let lo = range.lo ?? return null
	let hi = range.hi ?? return null
	for m in 0..<63 {
		let half = 1 << m
		if lo >= -half && hi < half {
			return m
		}
	}
	return null
}

/// `x % n` for an `n` of at most `high`.
fn bounding_remainder(x: ref Range?, high: i64) -> Range {
	let either = Range { lo: 1 - high, hi: high - 1 }
	let known = x ?? return either
	let lo = known.lo ?? return either
	if lo < 0 {
		return either
	}
	let hi = known.hi ?? return Range { lo: 0, hi: high - 1 }
	return Range { lo: 0, hi: hi.min(high - 1) }
}

/// Whether the walk proves `side` is not below zero.
fn bounding_not_negative(
	mut walk: BoundsWalk,
	side: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let term = bounding_lin(walk, side, facts, context, program, words) ?? return false
	let zero = walk.arena.int(0)
	let goal = walk.arena.ge(term, zero)
	return bounding_proves(walk, facts, goal, ask)
}

/// A side of `&` that is a constant not below zero: the mask.
fn bounding_mask(
	mut walk: BoundsWalk,
	side: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	let term = bounding_lin(walk, side, facts, context, program, words) ?? return null
	let c = walk.arena.constant(term) ?? return null
	if c >= 0 {
		return c
	}
	return null
}

/// Whether `lhs op rhs`, an operation of type `ty`, stays inside it.
///
/// **A goal the solver can state** (#444): the solver counts in `i64` and
/// refuses on overflow, so `term <= i64::MAX` - negated, `term >= 2^63` - was
/// never decided. Inside `±2^62` is inside the type, and leaves the solver
/// room to add facts as large as a length without overflowing; a value it
/// does not cover keeps its check.
fn bounding_fits(
	mut walk: BoundsWalk,
	op: ref BinaryOp,
	lhs: ref Expr,
	rhs: ref Expr,
	ty: ref String,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let bounds = Range::of_type(ty) ?? return false
	let widest_lo = bounds.lo ?? return false
	let widest_hi = bounds.hi ?? return false
	let lo = widest_lo.max(0 - solvable())
	let hi = widest_hi.min(solvable())
	let term = bounding_lin_of(walk, op, lhs, rhs, facts, context, program, words)
	let subtracting = match op {
		BinaryOp::Sub => true,
		else => false,
	}
	if term != null {
		let t = term ?? 0
		let low = walk.arena.int(lo)
		let high = walk.arena.int(hi)
		let above = walk.arena.ge(t, low)
		let below = walk.arena.le(t, high)
		// **A constant that is not negative moves a value of the type one way
		// only** (ADR-306 D6): `i + k` cannot leave below, nor `i - k` above,
		// so the bound on that side is not asked.
		let side = bounding_one_way(op, lhs, rhs)
		let mut goal = walk.arena.and([above, below])
		if side > 0 {
			goal = below
		} else if side < 0 {
			goal = above
		}
		if bounding_proves(walk, facts, goal, ask) {
			return true
		}
		// **A difference of two values not below zero** lies in
		// `-hi..=hi`, inside a signed type (#1516): `n - i` after a loop
		// whose counter stops at `n` or past its start.
		if subtracting && widest_lo <= 0 - widest_hi
			&& bounding_not_negative(walk, lhs, facts, context, program, words, ask)
			&& bounding_not_negative(walk, rhs, facts, context, program, words, ask) {
				return true
			}
		let mut relatives: Vec[i64] = []
		if side != 0 {
			relatives = bounding_relatives(walk, t, side, bounds, facts)
		}
		for relative in relatives {
			if bounding_proves(walk, facts, relative, ask) {
				return true
			}
		}
		// Left open: a loop's invariant may prove either goal (ADR-361 D2).
		if !relatives.is_empty() {
			relatives.insert(0, goal)
			goal = walk.arena.or(relatives)
		}
		// **The interval rules of `/`, `>>` and `^`** (#1631) where the
		// solver finds no bound on the number of its own they are: the rules
		// below, as before they had a term.
		if !bounding_reads_own(walk, t) {
			bounding_missed(walk, facts, goal)
			return false
		}
	}
	// **A side the walk only bounds** (#714): `l + x` with `a <= x <= b`
	// lies between `l + a` and `l + b`, linear goals the solver can state.
	let adds = match op {
		BinaryOp::Add => true,
		else => false,
	}
	let subtracts = match op {
		BinaryOp::Sub => true,
		else => false,
	}
	if (adds || subtracts)
		&& bounding_mixed_fits(
			walk,
			lhs,
			rhs,
			subtracts,
			lo,
			hi,
			facts,
			context,
			program,
			words,
			ask,
		) {
			return true
		}
	if adds
		&& bounding_mixed_fits(walk, rhs, lhs, false, lo, hi, facts, context, program, words, ask) {
			return true
		}
	let range = bounding_range_of(walk, op, lhs, rhs, -1, facts, context, program, words, ask)
		?? return false
	return bounds.holds(range)
}

/// How many names a goal is stated against (`bounding_relative`).
fn most_relatives() -> i64 {
	return 8
}

/// **Goals relative to a value of the type** (ADR-306, #1054): `t <= y`
/// (`t >= y` where `side < 0`) for a name `y` whose type lies inside
/// `bounds`, so that `t` does too. The names a fact of the point reads, the
/// newest facts first and those that read a name of `t` before the others,
/// at most `most_relatives()`: goals with no constant past 2^62, so `i + 1`
/// under `i < n`, `n: i64`, is proved.
fn bounding_relatives(
	mut walk: BoundsWalk,
	t: i64,
	side: i64,
	bounds: ref Range,
	facts: ref BoundsFacts,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	if walk.typed.is_empty() {
		return out
	}
	let mut own: collections::BTreeSet[String] = collections::BTreeSet()
	walk.arena.variables(t, own)
	let mut tried: collections::BTreeSet[String] = collections::BTreeSet()
	for near in [true, false] {
		let mut at = facts.facts.len()
		while at > 0 && tried.len() < most_relatives() {
			at -= 1
			let mut read: collections::BTreeSet[String] = collections::BTreeSet()
			walk.arena.variables(facts.facts[at], read)
			let shares = read.iter().any(fn(name) { own.contains(name) })
			if shares != near {
				continue
			}
			for y in read {
				if own.contains(y) || tried.contains(y) || tried.len() >= most_relatives() {
					continue
				}
				let ty = walk.typed.get(y) ?? continue
				let held = Range::held_by_type(ty) ?? continue
				if !bounds.holds(held) {
					continue
				}
				tried.insert(y.clone())
				let v = walk.arena.var(y)
				if side < 0 {
					out.push(walk.arena.ge(t, v))
				} else {
					out.push(walk.arena.le(t, v))
				}
			}
		}
	}
	return out
}

/// `linear + ranged` (or `linear - ranged` where `subtracts`) inside `lo..=hi`:
/// `linear` a term of the solver, `ranged` a value between two constants.
fn bounding_mixed_fits(
	mut walk: BoundsWalk,
	linear: ref Expr,
	ranged: ref Expr,
	subtracts: bool,
	lo: i64,
	hi: i64,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let l = bounding_lin(walk, linear, facts, context, program, words) ?? return false
	let r = bounding_range(walk, ranged, facts, context, program, words, ask) ?? return false
	let a = r.lo ?? return false
	let b = r.hi ?? return false
	let mut least = a
	let mut most = b
	if subtracts {
		least = 0 - b
		most = 0 - a
	}
	let least_term = walk.arena.int(least)
	let most_term = walk.arena.int(most)
	let low = walk.arena.add(l, least_term)
	let high = walk.arena.add(l, most_term)
	let floor = walk.arena.int(lo)
	let ceiling = walk.arena.int(hi)
	let above = walk.arena.ge(low, floor)
	let below = walk.arena.le(high, ceiling)
	let goal = walk.arena.and([above, below])
	return bounding_proves_goal(walk, facts, goal, ask)
}

/// **A shift's count lies in `0..<w`** (ADR-306 D18), `w` the width of the
/// shifted value's type `ty`.
fn bounding_count_fits(
	mut walk: BoundsWalk,
	count: ref Expr,
	ty: ref String,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let width = bounding_bits(ty) ?? return false
	let term = bounding_lin(walk, count, facts, context, program, words)
	if term != null {
		let k = term ?? 0
		let zero = walk.arena.int(0)
		let most = walk.arena.int(width - 1)
		let above = walk.arena.ge(k, zero)
		let below = walk.arena.le(k, most)
		let goal = walk.arena.and([above, below])
		return bounding_proves_goal(walk, facts, goal, ask)
	}
	let range = bounding_range(walk, count, facts, context, program, words, ask) ?? return false
	let lo = range.lo ?? return false
	let hi = range.hi ?? return false
	return lo >= 0 && hi < width
}

/// **What a `/` or `%` asks** (ADR-396 D7, ADR-395 D2, #1578): `d != 0`,
/// and on a signed type `d != -1` or the dividend above the type's least
/// value. Asked once, without a loop's invariant (no `bounding_missed`): a
/// divisor left open is listed as checked, and no new question reaches
/// `nikaia.proofs`. An unknown type is taken as signed.
fn bounding_divides(
	mut walk: BoundsWalk,
	lhs: ref Expr,
	rhs: ref Expr,
	ty: ref String,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let typed = Range::of_type(ty) ?? Range { lo: -1, hi: null }
	let least = typed.lo ?? -1
	let term = bounding_lin(walk, rhs, facts, context, program, words)
	if term == null {
		let range = bounding_range(walk, rhs, facts, context, program, words, ask) ?? return false
		// Below `-1` on a signed type, so neither zero nor `-1`.
		let under = if least < 0 { -1 } else { 0 }
		let above = range.lo != null && (range.lo ?? 0) > 0
		let below = range.hi != null && (range.hi ?? 0) < under
		return above || below
	}
	let d = term ?? 0
	let zero = walk.arena.int(0)
	let mut goal = walk.arena.unequal(d, zero)
	if least < 0 {
		let minus_one = walk.arena.int(-1)
		let mut apart = walk.arena.unequal(d, minus_one)
		let dividend = bounding_lin(walk, lhs, facts, context, program, words)
		if dividend != null {
			let low = walk.arena.int(least.max(0 - solvable()))
			let higher = walk.arena.gt(dividend ?? 0, low)
			apart = walk.arena.or([apart, higher])
		}
		goal = walk.arena.and([goal, apart])
	}
	return bounding_proves(walk, facts, goal, ask)
}

/// A whole-number literal.
fn bounding_literal(expr: ref Expr) -> bool {
	return match expr {
		Expr::LitInt { .. } => true,
		else => false,
	}
}

/// How many bits a whole-number type has.
fn bounding_bits(ty: ref String) -> i64? {
	return match ty {
		"i8" => 8, "u8" => 8, "i16" => 16, "u16" => 16, "i32" => 32, "u32" => 32,
		"i64" => 64, "u64" => 64, "int" => 64, "isize" => 64, "usize" => 64,
		"i128" => 128, "u128" => 128,
		else => null,
	}
}

/// Which way an operation with a constant that is not negative moves the
/// other side: `1` up (`x + k`, `k + x`), `-1` down (`x - k`), `0` either.
fn bounding_one_way(op: ref BinaryOp, lhs: ref Expr, rhs: ref Expr) -> i64 {
	match op {
		BinaryOp::Add => {
			if bounding_a_count(rhs) || bounding_a_count(lhs) {
				return 1
			}
		},
		BinaryOp::Sub => {
			if bounding_a_count(rhs) {
				return -1
			}
		},
		else => {},
	}
	return 0
}

/// A literal whole number that is not negative.
fn bounding_a_count(expr: ref Expr) -> bool {
	return match expr {
		Expr::LitInt { negative, .. } => !negative,
		else => false,
	}
}

/// `name` lies within `range`, where it is a whole number.
///
/// **A bound past `±2^62` is not stated** (#444): the solver counts in `i64`
/// and refuses a query whose sums overflow, so `c >= -2^63` beside the facts
/// that matter would leave every later index unproved, and a bound that wide
/// says nothing an `i64` does not. Leaving it out only weakens what is known.
fn bounding_bounded(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	name: ref String,
	range: ref Range,
) {
	let n = walk.arena.var(name)
	if range.lo != null && (range.lo ?? 0) >= 0 - solvable() {
		let lo = walk.arena.int(range.lo ?? 0)
		let fact = walk.arena.ge(n, lo)
		bounding_push(walk, facts, fact)
	}
	if range.hi != null && (range.hi ?? 0) <= solvable() {
		let hi = walk.arena.int(range.hi ?? 0)
		let fact = walk.arena.le(n, hi)
		bounding_push(walk, facts, fact)
	}
}

fn bounding_push(walk: ref BoundsWalk, mut facts: BoundsFacts, fact: i64) {
	// A conjunction is held part by part: forgetting a name then keeps the
	// parts that do not read it (ADR-306 D33, an element in one part).
	match walk.arena.nodes[fact] {
		logic::SolverTerm::And(parts) => {
			for part in parts {
				bounding_push(walk, facts, part)
			}
			return
		},
		else => {},
	}
	let mut read: collections::BTreeSet[String] = collections::BTreeSet()
	walk.arena.variables(fact, read)
	for name in read {
		if walk.pinned.contains(path_root(name)) {
			return
		}
	}
	// **A number of its own the statement named comes with what it is**
	// (#1631), held as facts so that they go when what they read changes.
	// What one reads may be another's (`l >> 1 >> 1`): each name once.
	let mut pending: Vec[String] = read.iter().cloned().collect()
	let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
	while !pending.is_empty() {
		let name = pending.pop() ?? break
		if !seen.insert(name.clone()) {
			continue
		}
		let defined = walk.defining.get(name) ?? continue
		for part in defined {
			if part != fact && !facts.facts.contains(part) {
				bounding_hold(facts, part)
				let mut more: collections::BTreeSet[String] = collections::BTreeSet()
				walk.arena.variables(part, more)
				for other in more {
					pending.push(other.clone())
				}
			}
		}
	}
	bounding_hold(facts, fact)
}

/// `fact` held, the oldest fact going past the cap.
fn bounding_hold(mut facts: BoundsFacts, fact: i64) {
	facts.facts.push(fact)
	if facts.facts.len() > most_held() {
		facts.facts.remove(0)
		facts.evicted += 1
	}
}

/// **What the numbers of its own a value named are becomes facts** before
/// the name it is given to changes (#1631): a definition reads the old value,
/// and pulled in after the change it would speak of the new one.
fn bounding_settle(mut walk: BoundsWalk, mut facts: BoundsFacts) {
	let mut parts: Vec[i64] = []
	for (_, defined) in walk.defining {
		for part in defined {
			parts.push(part)
		}
	}
	walk.defining.clear()
	for part in parts {
		if !facts.facts.contains(part) {
			bounding_push(walk, facts, part)
		}
	}
}

fn bounding_at_least_zero(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String) {
	let n = walk.arena.var(name)
	let zero = walk.arena.int(0)
	let fact = walk.arena.ge(n, zero)
	bounding_push(walk, facts, fact)
	// **A name of a narrow unsigned type is at most what its type holds**
	// (ADR-306 D34, #1786): `let d = b as i64` of a byte `b` is below 256,
	// so `digits[d / 16]` of 16 digits is proved.
	let most = walk.shape.narrow.get(name) ?? return
	let top = walk.arena.int(most)
	let below = walk.arena.le(n, top)
	bounding_push(walk, facts, below)
}

/// Nothing known about `name`, its length or a path of fields from it
/// (ADR-306 D17) holds any more.
fn bounding_forget(walk: ref BoundsWalk, mut facts: BoundsFacts, name: ref String) {
	let mut kept: Vec[i64] = []
	for fact in facts.facts {
		if !bounding_touches(walk, fact, name) {
			kept.push(fact)
		}
	}
	facts.facts = kept
}

/// Whether `term` reads `name`, its length or a path of fields from it.
fn bounding_touches(walk: ref BoundsWalk, term: i64, name: ref String) -> bool {
	let mut read: collections::BTreeSet[String] = collections::BTreeSet()
	walk.arena.variables(term, read)
	for v in read {
		if path_within(v, name) || bounding_in_elements(v, name) {
			return true
		}
	}
	return false
}

/// **A path through an element** (`t.slots[at].sum`) is part of the list it
/// indexes and reads the name it is indexed by: it moves when either does.
fn bounding_in_elements(path: ref String, name: ref String) -> bool {
	return path.starts_with(f"{name}[") || path.contains(f"[{name}]")
}

/// What is known of the paths of fields from `name` (ADR-306 D17) holds no
/// more, its own length aside: a method changed the value they are part of.
fn bounding_forget_parts(walk: ref BoundsWalk, mut facts: BoundsFacts, name: ref String) {
	let length = length_of(name)
	let under = f"{name}."
	let mut kept: Vec[i64] = []
	for fact in facts.facts {
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(fact, read)
		let mut touched = false
		for v in read {
			// A loop's value where it was reached (`at.len()@98`) is no part.
			if (v.starts_with(under) || v.starts_with(f"{name}[")) && v != length && !v.contains("@") {
				touched = true
			}
		}
		if !touched {
			kept.push(fact)
		}
	}
	facts.facts = kept
}

fn bounding_forget_length(walk: ref BoundsWalk, mut facts: BoundsFacts, name: ref String) {
	let length = length_of(name)
	let mut kept: Vec[i64] = []
	for fact in facts.facts {
		if !walk.arena.mentions(fact, length) {
			kept.push(fact)
		}
	}
	facts.facts = kept
}

/// **The path of a place through at most one element** (ADR-306 D17,
/// #781): `t.slots[at].sum`, the element's index a name. A path of fields
/// alone is `path_of`'s.
fn bounding_place_path(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
	return match expr {
		Expr::Variable(name, _) => words.resolve(name).clone(),
		Expr::Field { base, name, .. } => {
			let inner = bounding_place_path(base, words) ?? return null
			f"{inner}.{words.resolve(name)}"
		},
		Expr::Index { .. } => element_name(expr, words),
		else => null,
	}
}

/// The list a place writes into through an element, the element's index
/// where it is a name (else empty), and the fields after the element:
/// `t.slots`, `at` and `.sum` of `t.slots[at].sum`. Where the list is not a
/// path of fields, its root, with the index and the fields empty.
fn bounding_element_written(
	expr: ref Expr,
	words: ref winnow_grammar::InternerContext,
) -> (String, String, String)? {
	match expr {
		Expr::Field { base, name, .. } => {
			let (list, at, rest) = bounding_element_written(base, words) ?? return null
			if at.is_empty() && rest.is_empty() {
				return (list, at, rest)
			}
			return (list, at, f"{rest}.{words.resolve(name)}")
		},
		Expr::Index { base, index, .. } => {
			let list = path_of(base, words)
			if list == null {
				// An element of an element of a list (`t.col[c][i]`): every
				// element of that list (ADR-306 D28).
				match base {
					Expr::Index { base: outer, .. } => {
						let of = path_of(outer, words)
						if of != null {
							return ((of ?? "").clone(), "", "")
						}
					},
					else => {},
				}
				let root = bounding_root_of(base, words) ?? return null
				return (root, "", "")
			}
			let at = element_index(index, words) ?? ""
			return ((list ?? "").clone(), at.clone(), "")
		},
		else => return null,
	}
}

fn bounding_root_of(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
	return match expr {
		Expr::Variable(name, _) => words.resolve(name).clone(),
		Expr::Field { base, .. } => bounding_root_of(base, words),
		Expr::Index { base, .. } => bounding_root_of(base, words),
		else => null,
	}
}

/// **A write through an element** (#781): what was known of the same fields
/// of every element goes, the index not being known to differ; another
/// field of the same element stays. The written path itself is the
/// write's own (`bounding_assign`). Where the element's index is not a
/// name, every element of the list goes; where the list is not a path of
/// fields, every element under its root.
fn bounding_forget_aliases(
	walk: ref BoundsWalk,
	mut facts: BoundsFacts,
	target: ref Expr,
	words: ref winnow_grammar::InternerContext,
) {
	let (list, at, rest) = bounding_element_written(target, words) ?? return
	bounding_forget_element(walk, facts, f"{list}|{at}|{rest}", true)
}

/// A place written through an element, kept as `list|at|.fields` among
/// what a block changes.
fn bounding_element_changed(
	target: ref Expr,
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	let (list, at, rest) = bounding_element_written(target, words) ?? return
	out.elements.insert(f"{list}|{at}|{rest}")
}

/// What is known of the paths `place` (`list|at|.fields`) may change goes;
/// with `keep_own`, the written path itself stays, for the write to move it.
fn bounding_forget_element(
	walk: ref BoundsWalk,
	mut facts: BoundsFacts,
	place: ref String,
	keep_own: bool,
) {
	let mut kept: Vec[i64] = []
	for fact in facts.facts {
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(fact, read)
		let mut touched = false
		for v in read {
			if bounding_element_hit(v, place, keep_own) {
				touched = true
			}
		}
		if !touched {
			kept.push(fact)
		}
	}
	facts.facts = kept
}

/// Whether a write to `place` (`list|at|.fields`) may change the path `v`:
/// `v` goes through an element of the same list, the index not being known
/// to differ, to the same fields, a part of them or a whole they are part
/// of. Where the index is not a name, every element of the list; where the
/// list is only the root of the written place, every element under it.
fn bounding_element_hit(v: ref String, place: ref String, keep_own: bool) -> bool {
	let parts: Vec[ref String] = place.split("|").collect()
	let list = parts[0]
	let at = parts[1]
	let rest = parts[2]
	if keep_own && v == f"{list}[{at}]{rest}" {
		return false
	}
	// Every element read by its index, and only those (ADR-306 D33).
	if at == "*" {
		return v.starts_with(f"{list}[")
	}
	// What holds of every element no longer does once one is written.
	if v == bounding_element_of(list) || v.starts_with(f"{bounding_element_of(list)}.") {
		return true
	}
	if v.starts_with(f"{list}[") {
		let after: String = (v.split("]").last() ?? "").clone()
		return at.is_empty()
			|| rest.is_empty()
			|| after.is_empty()
			|| after == rest
			|| after.starts_with(f"{rest}.")
			|| rest.starts_with(f"{after}.")
	}
	return at.is_empty() && v.starts_with(f"{list}.") && v.contains("[")
}

/// What was known of an element indexed by `name` goes when `name` moves.
fn bounding_forget_elements_at(walk: ref BoundsWalk, mut facts: BoundsFacts, name: ref String) {
	let mut kept: Vec[i64] = []
	for fact in facts.facts {
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(fact, read)
		let mut touched = false
		for v in read {
			if v.contains(f"[{name}]") {
				touched = true
			}
		}
		if !touched {
			kept.push(fact)
		}
	}
	facts.facts = kept
}

/// Every fact `name` reads, rewritten for `name` now being `old + by`: what
/// held of the old value holds of `name - by`.
fn bounding_shift(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, by: i64) {
	let now = walk.arena.var(name)
	let old = walk.arena.sub(now, by)
	let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
	given.insert(name.clone(), old)
	for mut fact in facts.facts {
		if walk.arena.mentions(fact, name) {
			fact = walk.arena.substitute(fact, given)
		}
	}
}

/// What holds again after a loop's body or a branch changed `changed`: a
/// name that is never negative still is not.
fn bounding_after_change(mut walk: BoundsWalk, mut facts: BoundsFacts, changed: ref BoundsChanged) {
	for name in changed.values {
		bounding_forget(walk, facts, name)
		if (walk.nonnegative.contains(name) || walk.shape.unsigned.contains(name))
			&& facts.ints.contains(name) {
				bounding_at_least_zero(walk, facts, name)
			}
	}
	for name in changed.lengths {
		// A `capped` rule's marker stands through a list that only grows
		// (#1785).
		let grown = rules_capped_grown(walk, facts, name, changed)
		bounding_forget_length(walk, facts, name)
		for fact in grown {
			bounding_push(walk, facts, fact)
		}
	}
	for name in changed.parts {
		bounding_forget_parts(walk, facts, name)
	}
	for place in changed.elements {
		bounding_forget_element(walk, facts, place, false)
	}
}

/// **The halves of `let (r, o) = a.overflowing_add(b)` and of `let (low,
/// high) = a.widening_mul(b)`** (#1555), as one fact: `o >= 1 || r == a + b`
/// (and `-`, and `*` by a constant), so `if !o { … }` reads the exact value as
/// a `checked_add` guard does; and `high != 0 || low > MAX || low == a * b`,
/// the product where it fits the receiver's type. Null where the call is none
/// of these, a side is no linear term, a product has no constant factor, or a
/// side reads a name the `let` binds again.
fn bounding_halves(
	mut walk: BoundsWalk,
	names: ref Vec[winnow_grammar::Symbol],
	value: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	match value {
		Expr::MethodCall { receiver, method, args, .. } => {
			if args.len() != 1 {
				return null
			}
			let picked = words.resolve(method)
			let ty = context.std_receivers[node_key(value)] ?? return null
			if !is_whole_number(ty) {
				return null
			}
			let a = bounding_lin(walk, receiver, facts, context, program, words) ?? return null
			let b = bounding_lin(walk, args[0], facts, context, program, words) ?? return null
			let first = words.resolve(names[0]).clone()
			let second = words.resolve(names[1]).clone()
			for side in [a, b] {
				if walk.arena.mentions(side, first) || walk.arena.mentions(side, second) {
					return null
				}
			}
			let product = picked == "overflowing_mul" || picked == "widening_mul"
			if product && walk.arena.constant(a) == null && walk.arena.constant(b) == null {
				return null
			}
			let exact = match picked {
				"overflowing_add" => walk.arena.add(a, b),
				"overflowing_sub" => walk.arena.sub(a, b),
				"overflowing_mul" => walk.arena.mul(a, b),
				"widening_mul" => walk.arena.mul(a, b),
				else => return null,
			}
			let result = walk.arena.var(first)
			let same = walk.arena.equal(result, exact)
			let other = walk.arena.var(second)
			if picked == "widening_mul" {
				let top = (Range::of_type(ty) ?? return null).hi ?? return null
				let zero = walk.arena.int(0)
				let high = walk.arena.unequal(other, zero)
				let most = walk.arena.int(top)
				let past = walk.arena.gt(result, most)
				return walk.arena.or([high, past, same])
			}
			let one = walk.arena.int(1)
			let up = walk.arena.ge(other, one)
			return walk.arena.or([up, same])
		},
		else => {},
	}
	return null
}

/// **`expr` as a linear term**, where it is one.
fn bounding_lin(
	mut walk: BoundsWalk,
	expr: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	// A call of the condition assumed, by its result's name (#1785).
	if !walk.call_names.is_empty() {
		let named = walk.call_names.get(node_key(expr))?.clone()
		if named != null {
			return walk.arena.var(named ?? "")
		}
	}
	match expr {
		Expr::LitInt { value, negative, .. } => {
			let n = integer_as_count(integer(value, negative)) ?? return null
			return walk.arena.int(n)
		},
		Expr::Variable(name, _) => {
			let text = words.resolve(name)
			if walk.shape.constants.contains_key(text) {
				let n = walk.shape.constants[text] ?? 0
				return walk.arena.int(n)
			}
			if facts.ints.contains(text) {
				return walk.arena.var(text)
			}
		},
		Expr::MethodCall { receiver, method, args, .. } => {
			// **A `len()` of no list the walk counts** (`http1::Buffer`'s,
			// #1811) is no length of the walk: it falls through to what the
			// ledger ensures of it below, as a `let` of it already did.
			if args.is_empty() && words.resolve(method) == "len" {
				let path = path_of(receiver, words) ?? return null
				let counted = bounding_length(walk, receiver, path, context)
				if counted != null {
					return counted
				}
			}
			// **`a.min(b)` is at most each of the two, `a.max(b)` at least
			// each** (#1516), of whole numbers: `let mut i = at.min(n)`
			// starts a counter below `n`. And either is one of the two
			// (#1514): `0 <= at` and `0 <= n` give `0 <= at.min(n)`, so
			// `s.bytes[0..<at.min(s.bytes.len())]` is inside.
			let picked = words.resolve(method)
			if args.len() == 1 && (picked == "min" || picked == "max") {
				let whole = context.std_receivers[node_key(expr)] ?? return null
				if !is_whole_number(whole) {
					return null
				}
				let a = bounding_lin(walk, receiver, facts, context, program, words) ?? return null
				let b = bounding_lin(walk, args[0], facts, context, program, words) ?? return null
				let name = f"result#{walk.codes}"
				walk.codes += 1
				let result = walk.arena.var(name)
				let mut held: Vec[i64] = []
				if picked == "min" {
					held.push(walk.arena.le(result, a))
					held.push(walk.arena.le(result, b))
				} else {
					held.push(walk.arena.ge(result, a))
					held.push(walk.arena.ge(result, b))
				}
				let is_a = walk.arena.equal(result, a)
				let is_b = walk.arena.equal(result, b)
				held.push(walk.arena.or([is_a, is_b]))
				walk.axioms.insert(name, held)
				return result
			}
			// **A call `self.m(…)` to the type's own method has its result
			// summary** (ADR-359 D14, #1904), as the prover reads it.
			if !context.owner.is_empty() && bounding_on_self(receiver, words) {
				let summed = context.ensured[f"{context.owner}::{words.resolve(method)}"]
				if summed != null {
					return bounding_ensured(walk, summed ?? return null, args, facts, context, program, words)
				}
			}
			// **What `std`'s ledger ensures of a method's result** (ADR-314
			// D3): `x.trailing_zeros()` of a `u64` is in `0..=64`.
			let ty = context.std_receivers[node_key(expr)] ?? return null
			let ensured = context.ensured[f"{ty}::{words.resolve(method)}"] ?? return null
			return bounding_ensured(walk, ensured, args, facts, context, program, words)
		},
		// **A path of fields from a name** (ADR-306 D17), of a whole-number
		// type: a number of its own, `p.end`.
		Expr::Field { .. } => {
			if context.whole_fields.contains(node_key(expr)) {
				let path = bounding_place_path(expr, words) ?? return null
				// **Its type is its range** (ADR-306 D34): a goal may be
				// stated against it as against a parameter (#1054).
				let ty = context.whole_types[node_key(expr)]
				if ty != null && !walk.shape.twice.contains(path) {
					walk.typed.insert(path.clone(), (ty ?? "").clone())
				}
				return walk.arena.var(path)
			}
		},
		// **One element of a list** (ADR-306 D33), of a whole-number type,
		// its index a name or a literal: a number of its own, `xs[c]`, within
		// what is assumed of every element of the list (D7).
		Expr::Index { base, .. } => {
			if context.whole_fields.contains(node_key(expr)) {
				let path = bounding_place_path(expr, words) ?? return null
				return bounding_element_var(walk, path, base, words)
			}
		},
		Expr::Unary { op, expr, .. } => {
			match op {
				UnaryOp::Neg => {
					let a = bounding_lin(walk, expr, facts, context, program, words) ?? return null
					return walk.arena.neg(a)
				},
				else => {},
			}
		},
		// **A conversion keeps the value or stops the program** (Part III
		// A.2: one that does not fit is checked at every build), so where the
		// program goes on, the number is the one converted.
		Expr::Cast { expr, ty, .. } => {
			if ty.generics.is_empty() && is_whole_number(words.resolve(ty.name)) {
				if context.char_codes.contains(node_key(expr)) {
					return bounding_code_of(walk, expr, context, words)
				}
				return bounding_lin(walk, expr, facts, context, program, words)
			}
		},
		Expr::Call { func, args, config, .. } => {
			if config.is_empty() {
				let callee = bounding_callee(func, words) ?? return null
				let mut given: Vec[i64] = []
				let mut every = true
				for arg in args {
					let term = bounding_lin(walk, arg, facts, context, program, words)
					if term == null {
						every = false
					} else {
						given.push(term ?? 0)
					}
				}
				if every {
					let inlined = bounding_called(walk, callee, given, 0, program, words)
					if inlined != null {
						return inlined
					}
				}
				let ensured = context.ensured[callee] ?? return null
				return bounding_ensured(walk, ensured, args, facts, context, program, words)
			}
		},
		Expr::Binary { op, lhs, rhs, .. } => return bounding_lin_of(
			walk,
			op,
			lhs,
			rhs,
			facts,
			context,
			program,
			words,
		),
		// **A call checked against a type's rule first** (ADR-369 D3): the
		// block the rule's `assert`s are put in has the call's value (#776).
		Expr::Block(block, _) => {
			let last = block.stmts.len() - 1
			if last < 0 {
				return null
			}
			for k in 0..<last {
				if !bounding_an_assert(block.stmts[k].node, words) {
					return null
				}
			}
			return match block.stmts[last].node {
				Stmt::Expr(inner) => bounding_lin(walk, inner, facts, context, program, words),
				else => null,
			}
		},
		Expr::AsyncGroup(block, _, _, _, _) => {
			let last = block.stmts.len() - 1
			if last < 0 {
				return null
			}
			for k in 0..<last {
				if !bounding_an_assert(block.stmts[k].node, words) {
					return null
				}
			}
			return match block.stmts[last].node {
				Stmt::Expr(inner) => bounding_lin(walk, inner, facts, context, program, words),
				else => null,
			}
		},
		else => {},
	}
	return null
}

/// Whether a statement is an `assert(…)` and nothing else.
fn bounding_an_assert(stmt: ref Stmt, words: ref winnow_grammar::InternerContext) -> bool {
	return match stmt {
		Stmt::Expr(inner) => match inner {
			Expr::Call { func, args, .. } => args.len() == 1
				&& (bounding_variable(func, words) ?? "") == "assert",
			else => false,
		},
		else => false,
	}
}

/// **A `char`'s code** (ADR-314 D2): a number in `0..=0x10FFFF`, and a new
/// one at every reading, because the walk keeps no fact about which character
/// it is. Every proof is handed its bounds, as a list's length's.
fn bounding_code(mut walk: BoundsWalk) -> i64 {
	let name = f"code#{walk.codes}"
	walk.codes += 1
	let v = walk.arena.var(name)
	let zero = walk.arena.int(0)
	let most = walk.arena.int(1114111)
	let low = walk.arena.ge(v, zero)
	let high = walk.arena.le(v, most)
	walk.axioms.insert(name, [low, high])
	return v
}

/// **The code of the `char` `expr`**: within its class where it is a grammar
/// binding the action does not bind again (ADR-314 D1), any code otherwise
/// (D2).
fn bounding_code_of(
	mut walk: BoundsWalk,
	expr: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> i64 {
	let v = bounding_code(walk)
	let name = bounding_variable(expr, words) ?? return v
	let class = bounding_class_of(walk, name, context) ?? return v
	let key = f"code#{walk.codes - 1}"
	let mut held: Vec[i64] = []
	if class.lo != null {
		let lo = walk.arena.int(class.lo ?? 0)
		held.push(walk.arena.ge(v, lo))
	}
	if class.hi != null {
		let hi = walk.arena.int(class.hi ?? 0)
		held.push(walk.arena.le(v, hi))
	}
	walk.axioms.insert(key, held)
	return v
}

/// **`-x` that stays inside its type** (ADR-314 D5): `x` is proved above the
/// type's least value, whose negation is the one that does not fit.
fn bounding_negation(
	mut walk: BoundsWalk,
	expr: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if walk.collecting || context.negations.is_empty() {
		return
	}
	let node = node_key(expr)
	let ty = context.negations[node] ?? return
	let operand = match expr {
		Expr::Unary { op, expr, .. } => match op {
			UnaryOp::Neg => expr,
			else => return,
		},
		else => return,
	}
	let least = Range::of_type(ty) ?? return
	let lo = least.lo ?? return
	let above = (lo + 1).max(0 - solvable())
	let term = bounding_lin(walk, operand, facts, context, program, words) ?? return
	let k = walk.arena.int(above)
	let goal = walk.arena.ge(term, k)
	if bounding_proves_goal(walk, facts, goal, ask) {
		walk.proven.negations.insert(node)
	} else {
		walk.open += 1
	}
}

/// The class of the `char` named `name`: a grammar binding's, or a loop's
/// over a text binding's characters, where nothing binds the name again.
fn bounding_class_of(walk: ref BoundsWalk, name: ref String, context: ref BoundsContext) -> Range? {
	if walk.loop_classes.contains_key(name) && !walk.shape.twice.contains(name) {
		return walk.loop_classes[name]
	}
	if walk.shape.bound.contains(name) {
		return null
	}
	return context.classes[name]
}

/// `x` where `iter` is the scalars `x.scalars` of a text `x` (ADR-320 D3,
/// #1974).
fn bounding_chars_of(iter: ref Expr, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) -> String? {
	return match iter {
		Expr::Field { base, .. } => {
			if !context.text_scalars.contains(node_key(iter)) {
				return null
			}
			bounding_variable(base, words)
		},
		else => null,
	}
}

/// The name a call writes for its callee: a bare one, or a path such as
/// `text::digit_value`.
fn bounding_callee(func: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
	return match func {
		Expr::Variable(name, _) => words.resolve(name).clone(),
		Expr::Path(parts, _) => {
			let mut out: String = ""
			for part in parts {
				if !out.is_empty() {
					out.push_str("::")
				}
				out.push_str(words.resolve(part))
			}
			out
		},
		else => null,
	}
}

/// **A callee's `ensures` is a fact about the call's value** (ADR-314 D3):
/// the value is a number of its own, and each condition the ledger states
/// holds of it, with the arguments for the parameters - a `char` argument as
/// its code. Every proof is handed them, as a length's bounds.
fn bounding_ensured(
	mut walk: BoundsWalk,
	ensured: ref Ensured,
	args: ref Vec[Expr],
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	if args.len() != ensured.params.len() || ensured.conditions.is_empty() {
		return null
	}
	let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
	for k in 0..<args.len() {
		if ensured.chars[k] {
			given.insert(ensured.params[k].clone(), bounding_code_of(walk, args[k], context, words))
		} else {
			// An argument the walk does not read is a number of its own: what
			// the callee ensures holds whatever it is (#776).
			let term = bounding_lin(walk, args[k], facts, context, program, words)
				?? bounding_fresh(walk)
			given.insert(ensured.params[k].clone(), term)
		}
	}
	let name = f"result#{walk.codes}"
	walk.codes += 1
	let result = walk.arena.var(name)
	given.insert("result", result)
	let mut read: Vec[i64] = []
	let mut names: collections::BTreeSet[String] = collections::BTreeSet()
	for nodes in ensured.conditions {
		let condition = walk.arena.adopt(nodes)
		walk.arena.variables(condition, names)
		read.push(condition)
	}
	// **A parameter's length is the argument's** (ADR-359 D14): a result
	// summary reads `t.len()`. Any other name it reads is a number of its own
	// at each call, never one two calls share.
	for name in names {
		if given.contains_key(name) {
			continue
		}
		let mut length: i64? = null
		for k in 0..<args.len() {
			if length_of(ensured.params[k]) == name {
				let path = path_of(args[k], words)
				if path != null && !walk.pinned.contains(path_root(path ?? "")) {
					length = bounding_length_named(walk, path ?? "", true)
				}
			}
		}
		given.insert(name.clone(), length ?? bounding_fresh(walk))
	}
	let mut holds: Vec[i64] = []
	for condition in read {
		holds.push(walk.arena.substitute(condition, given))
	}
	walk.axioms.insert(name, holds)
	return result
}

/// Whether a call's receiver is `self` itself.
fn bounding_on_self(receiver: ref Expr, words: ref winnow_grammar::InternerContext) -> bool {
	return (path_of(receiver, words) ?? "") == "self"
}

/// **A method call's precondition, proved where the call stands** (ADR-269
/// D5, #776): each condition the callee's ledger entry requires, with the
/// call's arguments for its parameters and their lengths, from what holds
/// before the call. Only where the receiver and every argument are read
/// without running anything; a call proved is recorded by its receiver.
fn bounding_required(
	mut walk: BoundsWalk,
	expr: ref Expr,
	receiver: ref Expr,
	method: ref String,
	args: ref Vec[Expr],
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if walk.collecting {
		return
	}
	let ty = context.std_receivers[node_key(expr)] ?? return
	let key = f"{ty}::{method}"
	let required = context.required[key] ?? return
	if args.len() != required.params.len() || required.conditions.is_empty() {
		return
	}
	let on = path_of(receiver, words) ?? return
	if walk.pinned.contains(path_root(on)) {
		return
	}
	let mut conditions: Vec[i64] = []
	let mut read: collections::BTreeSet[String] = collections::BTreeSet()
	for nodes in required.conditions {
		let condition = walk.arena.adopt(nodes)
		walk.arena.variables(condition, read)
		conditions.push(condition)
	}
	let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
	for k in 0..<args.len() {
		let param = required.params[k].clone()
		if required.chars[k] && read.contains(param) {
			return
		}
		let term = bounding_lin(walk, args[k], facts, context, program, words)
		let path = path_of(args[k], words)
		if term == null && path == null {
			return
		}
		given.insert(param.clone(), term ?? bounding_fresh(walk))
		let length = length_of(param)
		if read.contains(length) {
			if path == null || walk.pinned.contains(path_root(path ?? "")) {
				return
			}
			given.insert(length, bounding_length_named(walk, path ?? "", true))
		}
	}
	let mut goals: Vec[i64] = []
	for condition in conditions {
		goals.push(walk.arena.substitute(condition, given))
	}
	let goal = walk.arena.and(goals)
	if bounding_proves_goal(walk, facts, goal, ask) {
		walk.proven.calls.insert(node_key(receiver), key)
	} else {
		walk.open += 1
	}
}

/// **A derived precondition, asked where a private function is called**
/// (ADR-391 D1, D3): each claim of the callee with the call's arguments for
/// its parameters and their lengths, from what holds before the call. What
/// a visit proves is kept by the call's node; a second visit keeps only what
/// both proved, and one that cannot ask keeps nothing.
fn bounding_derived_call(
	mut walk: BoundsWalk,
	expr: ref Expr,
	name: ref String,
	on: String?,
	args: ref Vec[Expr],
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if walk.collecting {
		return
	}
	let callee = context.around.derived.functions[name] ?? return
	let mut proved: collections::BTreeSet[i64] = collections::BTreeSet()
	if args.len() == callee.params.len() {
		for k in 0..<callee.claims.len() {
			let claim = callee.claims[k].clone()
			// What holds of every value of a list handed for a side over
			// its values (ADR-306 D21).
			let mut given: Vec[i64] = []
			// The elements an argument read out of a list stands for, of
			// each side (#1668).
			let mut left_reads: collections::BTreeSet[String] = collections::BTreeSet()
			let mut right_reads: collections::BTreeSet[String] = collections::BTreeSet()
			let left = bounding_derived_side(
				walk,
				callee.params,
				claim.left,
				false,
				claim.each,
				args,
				on,
				facts,
				given,
				left_reads,
				context,
				program,
				words,
			)
				?? continue
			// A number as a side (#1571).
			let right = if claim.fixed != null { walk.arena.int(claim.fixed ?? 0) } else {
				bounding_derived_side(
					walk,
					callee.params,
					claim.right,
					claim.length,
					claim.each,
					args,
					on,
					facts,
					given,
					right_reads,
					context,
					program,
					words,
				)
					?? continue
			}
			let right = if claim.length { bounding_scaled(walk, claim, right) } else { right }
			// Two reads out of one list stand for every element both: the
			// goal would compare an element with itself, not `xs[i]` with
			// `xs[j]`.
			if left_reads.iter().any(fn(name) { right_reads.contains(name) }) {
				continue
			}
			let side = if claim.apart { walk.arena.unequal(left, right) } else if claim.strict {
				walk.arena.lt(left, right)
			} else {
				walk.arena.le(left, right)
			}
			// Of every value of a list: as the callee knows it (#1483).
			let goal = bounding_each_guarded(walk, side)
			if given.is_empty() {
				if bounding_proves(walk, facts, goal, ask) {
					proved.insert(k)
				}
			} else {
				let mut known = facts.clone()
				for fact in given {
					bounding_push(walk, known, fact)
				}
				if bounding_proves(walk, known, goal, ask) {
					proved.insert(k)
				}
			}
		}
	}
	let node = node_key(expr)
	if walk.proven.derived.contains_key(node) {
		let was = walk.proven.derived.get(node)?.clone() ?? collections::BTreeSet()
		let mut kept: collections::BTreeSet[i64] = collections::BTreeSet()
		for claim in was {
			if proved.contains(claim) {
				kept.insert(claim)
			}
		}
		walk.proven.derived.insert(node, kept)
	} else {
		walk.proven.derived.insert(node, proved)
	}
}

/// One side of a claim at a call: `0` for an empty `param`, the argument
/// handed for it, or that argument's length where `length`; a field of
/// `self` is the receiver's field, where the receiver is a path. Where
/// `each` and not `length`, `param` is a list or a path of fields from one,
/// and the side is every value the list handed holds: what the walk knows
/// of those goes into `given`. An argument read out of a list whose every
/// element facts bound (`self.place[v]`) is every element of it, as an
/// index read out of one is (`rules_element_inside`, ADR-306 D22), and its
/// element goes into `reads` (#1668).
fn bounding_derived_side(
	mut walk: BoundsWalk,
	params: ref Vec[String],
	param: String,
	length: bool,
	each: bool,
	args: ref Vec[Expr],
	on: ref String?,
	facts: ref BoundsFacts,
	mut given: Vec[i64],
	mut reads: collections::BTreeSet[String],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	if param == "" {
		return walk.arena.int(0)
	}
	if each && !length {
		return bounding_derived_each(walk, params, param, args, given, words)
	}
	let field = param.strip_prefix("self.")
	if field != null {
		if !length {
			return null
		}
		let path = f"{on ?? return null}.{field ?? ""}"
		if walk.pinned.contains(path_root(path)) {
			return null
		}
		return bounding_length_named(walk, path, true)
	}
	// **A path of fields from a parameter** (ADR-391 D1, #1832): the same
	// path from the argument handed for it, `w.walked` for `p.walked`.
	let root = path_root(param)
	if root != param {
		for k in 0..<params.len() {
			if params[k] != root {
				continue
			}
			let handed = path_of(args[k], words) ?? return null
			if walk.pinned.contains(path_root(handed)) {
				return null
			}
			let path = f"{handed}{param.strip_prefix(root) ?? ""}"
			if length {
				return bounding_length_named(walk, path, true)
			}
			return walk.arena.var(path)
		}
		return null
	}
	for k in 0..<params.len() {
		if params[k] != param {
			continue
		}
		if !length {
			let element = rules_element_read(walk, args[k], facts, words)
			if element != null {
				walk.arena.variables(element ?? 0, reads)
				return element
			}
			return bounding_lin(walk, args[k], facts, context, program, words)
		}
		let path = path_of(args[k], words) ?? return null
		if walk.pinned.contains(path_root(path)) {
			return null
		}
		return bounding_length_named(walk, path, true)
	}
	return null
}

/// **Every value of the list a claim's side names, at a call** (ADR-306
/// D21): the element of the path handed for it, `param`'s root replaced by
/// the argument's path. Where the argument is a list whose every write the
/// walk sees (D7), its bound on its values goes into `given`.
fn bounding_derived_each(
	mut walk: BoundsWalk,
	params: ref Vec[String],
	param: ref String,
	args: ref Vec[Expr],
	mut given: Vec[i64],
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	let root = path_root(param)
	for k in 0..<params.len() {
		if params[k] != root {
			continue
		}
		let handed = path_of(args[k], words) ?? return null
		if walk.pinned.contains(path_root(handed)) {
			return null
		}
		let rest = param.strip_prefix(root) ?? ""
		let path = f"{handed}{rest}"
		let element = walk.arena.var(bounding_element_of(path))
		let mut key = elements_key(walk.shape, args[k], words)
		if !rest.is_empty() {
			// A field's values, where the walks see every write of it
			// (ADR-306 D21).
			key = null
			let parts: Vec[ref String] = rest.split(".").collect()
			let field = f".{parts[parts.len() - 1]}"
			if walk.shape.fields.contains(field) {
				key = field
			}
		}
		if key != null {
			let bound = bounding_assumed(walk, key ?? "") ?? return element
			if bound.lo != null {
				let lo = walk.arena.int(bound.lo ?? 0)
				let low = walk.arena.ge(element, lo)
				given.push(bounding_each_guarded(walk, low))
			}
			if bound.hi != null {
				let hi = walk.arena.int(bound.hi ?? 0)
				let high = walk.arena.le(element, hi)
				given.push(bounding_each_guarded(walk, high))
			}
		}
		return element
	}
	return null
}

/// **A claim's length side**, `scale * length + offset` (ADR-391 D1, #1673).
fn bounding_scaled(mut walk: BoundsWalk, claim: ref DerivedClaim, length: i64) -> i64 {
	let mut term = length
	if claim.scale != 1 {
		let times = walk.arena.int(claim.scale)
		term = walk.arena.mul(times, term)
	}
	if claim.offset != 0 {
		let by = walk.arena.int(claim.offset)
		term = walk.arena.add(term, by)
	}
	return term
}

/// **The derived preconditions at a function's entry** (ADR-391 D1): the
/// claims every call site proved, known as a written top `assert` is.
fn bounding_derived_entry(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	args: ref Vec[FnArg],
	body: ref Block,
	context: ref BoundsContext,
) {
	let key = derived_key(args, body) ?? return
	let held = context.around.derived.entry[key] ?? return
	for claim in held {
		// A side over every value of a list is its element (ADR-306 D21).
		let left = if claim.left == "" { walk.arena.int(0) } else if claim.each {
			walk.arena.var(bounding_element_of(claim.left))
		} else {
			walk.arena.var(claim.left)
		}
		let right = if claim.fixed != null { walk.arena.int(claim.fixed ?? 0) } else if claim.length {
			// **The length is an `i64`** (ADR-385 D1), known before the
			// body reads it (#1767): `at < xs.len() - 1` proves `at + 1`
			// fits, as `bounding_length_named` states for a read length.
			walk.typed.insert(length_of(claim.right), "i64")
			let length = walk.arena.var(length_of(claim.right))
			bounding_scaled(walk, claim, length)
		} else if claim.each {
			walk.arena.var(bounding_element_of(claim.right))
		} else {
			walk.arena.var(claim.right)
		}
		let side = if claim.apart { walk.arena.unequal(left, right) } else if claim.strict {
			walk.arena.lt(left, right)
		} else {
			walk.arena.le(left, right)
		}
		// A claim over every value says nothing of an empty list (#1483).
		let fact = bounding_each_guarded(walk, side)
		bounding_push(walk, facts, fact)
	}
}

/// **What `std`'s ledger states of each element a sequence yields**
/// (ADR-375 D5): `b.find_all(set; from: f)` yields positions with
/// `f <= s < b.len()`, rising, so the one after `turn` others is at or above
/// `turn` (#432). The facts of `item` for the call `iter`, with `turn` for
/// the number of elements before it where a `for` counts them (ADR-361 D13)
/// and a number of its own elsewhere; none where `iter` is no call whose
/// entry states any, or its receiver is no path.
fn bounding_each(
	mut walk: BoundsWalk,
	iter: ref Expr,
	item: i64,
	turn: i64?,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	match iter {
		Expr::MethodCall { receiver, method, args, config, .. } => {
			let ty = context.std_receivers[node_key(iter)] ?? return out
			let each = context.each[f"{ty}::{words.resolve(method)}"] ?? return out
			let path = path_of(receiver, words) ?? return out
			if args.len() != each.params.len() {
				return out
			}
			let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
			for k in 0..<args.len() {
				given.insert(
					each.params[k].clone(),
					bounding_given(walk, args[k], facts, context, program, words),
				)
			}
			for (name, default) in each.options {
				let mut term: i64? = null
				for option in config {
					if words.resolve(option.name) == name {
						term = bounding_given(walk, option.value, facts, context, program, words)
					}
				}
				if term == null {
					let written = text::parse_i64(default)
					if written != null {
						term = walk.arena.int(written ?? 0)
					} else {
						term = bounding_fresh(walk)
					}
				}
				given.insert(name.clone(), term ?? 0)
			}
			given.insert("item", item)
			let before = turn ?? bounding_fresh(walk)
			given.insert("turn", before)
			given.insert(length_of("self"), bounding_length_named(walk, path, true))
			for nodes in each.conditions {
				let read = walk.arena.adopt(nodes)
				out.push(walk.arena.substitute(read, given))
			}
		},
		// **Each element of a list a call is found to return** (ADR-306
		// D23, D24): `0 <= item < p.len()`.
		Expr::Call { .. } => {
			let zero = walk.arena.int(0)
			// The length is one as `len()` hands back (ADR-385 D1), so that
			// `item + 1` is proved as after a counted loop (#1465).
			for (list, sized) in bounding_returned_below(walk, iter, true, context, words) {
				out.push(walk.arena.ge(item, zero))
				let len = bounding_length_named(walk, list, sized)
				out.push(walk.arena.lt(item, len))
			}
			// And the range D7 found of its values (D24): `lo <= item <= hi`.
			let range = bounding_returned_values(walk, iter, context, words) ?? return out
			if range.lo != null && (range.lo ?? 0) >= 0 - solvable() {
				let lo = walk.arena.int(range.lo ?? 0)
				out.push(walk.arena.ge(item, lo))
			}
			if range.hi != null && (range.hi ?? 0) <= solvable() {
				let hi = walk.arena.int(range.hi ?? 0)
				out.push(walk.arena.le(item, hi))
			}
		},
		else => {},
	}
	return out
}

/// An argument as a term of the walk, or a number of its own where the walk
/// has none for it: a fact over that one says nothing of any other.
fn bounding_given(
	mut walk: BoundsWalk,
	arg: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64 {
	let term = bounding_lin(walk, arg, facts, context, program, words)
	if term != null {
		return term ?? 0
	}
	return bounding_fresh(walk)
}

/// A number of its own, that no other term reads.
fn bounding_fresh(mut walk: BoundsWalk) -> i64 {
	let name = f"given#{walk.codes}"
	walk.codes += 1
	return walk.arena.var(name)
}

/// **An element as a name** (ADR-306 D33): what the walk assumes of every
/// element of its list (D7) is handed to every proof, as a length's bounds.
fn bounding_element_var(mut walk: BoundsWalk, path: ref String, base: ref Expr, words: ref winnow_grammar::InternerContext) -> i64 {
	let v = walk.arena.var(path)
	walk.axioms.remove(path)
	let key = elements_key(walk.shape, base, words) ?? return v
	let bound = bounding_assumed(walk, key) ?? return v
	let mut held: Vec[i64] = []
	if bound.lo != null {
		let lo = walk.arena.int(bound.lo ?? 0)
		held.push(walk.arena.ge(v, lo))
	}
	if bound.hi != null {
		let hi = walk.arena.int(bound.hi ?? 0)
		held.push(walk.arena.le(v, hi))
	}
	walk.axioms.insert(path.clone(), held)
	return v
}

/// The name a sequence's element is known by while the sequence is held
/// under `name` (ADR-375 D5): a path within it, so that what is known goes
/// when `name` changes.
fn bounding_element_of(name: ref String) -> String {
	return f"{name}.each()"
}

/// **What holds of every element says nothing of an empty list** (ADR-306
/// D21, #1483): `len(xs) <= 0 || fact` for each list `xs` whose element
/// `xs.each()` the fact reads. Unguarded, `0 <= xs.each() < len(ys)` would
/// claim `len(ys) >= 1` where `xs` is empty, and contradict `len(ys) == 0`.
fn bounding_each_guarded(mut walk: BoundsWalk, fact: i64) -> i64 {
	let mut read: collections::BTreeSet[String] = collections::BTreeSet()
	walk.arena.variables(fact, read)
	let zero = walk.arena.int(0)
	let mut parts: Vec[i64] = []
	for name in read {
		let pieces: Vec[ref String] = name.split(".each()").collect()
		if pieces.len() < 2 {
			continue
		}
		let len = walk.arena.var(length_of(pieces[0]))
		parts.push(walk.arena.le(len, zero))
	}
	if parts.is_empty() {
		return fact
	}
	parts.push(fact)
	return walk.arena.or(parts)
}

/// `len(list) >= 1`: where an element of `list` was read, or a loop over it
/// runs its body, so that what holds of every element holds of that one.
fn bounding_each_present(mut walk: BoundsWalk, list: ref String) -> i64 {
	let len = walk.arena.var(length_of(list))
	let one = walk.arena.int(1)
	return walk.arena.ge(len, one)
}

/// The name `expr` is, where it is a bare one.
fn bounding_variable(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
	return match expr {
		Expr::Variable(name, _) => words.resolve(name).clone(),
		else => null,
	}
}

/// `name.len()`, where `receiver` counts a `std` container.
fn bounding_length(
	mut walk: BoundsWalk,
	receiver: ref Expr,
	name: ref String,
	context: ref BoundsContext,
) -> i64? {
	let fixed = context.array_lengths.get(node_key(receiver))
	if fixed != null {
		return walk.arena.int(fixed ?? 0)
	}
	if !context.lengths.contains(node_key(receiver)) {
		return null
	}
	let counted = bounding_counted_list(name, node_key(receiver), context)
	return bounding_length_named(walk, counted, context.sized.contains(node_key(receiver)))
}

/// **The list whose length `list.len()` is, read at `node`**: the text `s`
/// for its bytes `s.bytes`, `list` itself for any other. `s.bytes.len()`
/// counts the text's bytes (ADR-320 D4), and so does the `s.len()` the
/// compiler still takes where D3 removes it, so a fact on one holds of the
/// other (#1556).
fn bounding_counted_list(list: ref String, node: i64, context: ref BoundsContext) -> String {
	if context.text_bytes.contains(node) {
		return list.strip_suffix(".bytes")?.clone() ?? list.clone()
	}
	return list.clone()
}

/// `name.len()` as a number of the walk: not negative, an `i64` (ADR-385
/// D1), and below 2^60 where the elements take space (`sized`).
fn bounding_length_named(mut walk: BoundsWalk, name: ref String, sized: bool) -> i64 {
	let length = length_of(name)
	let n = walk.arena.var(length)
	// **Every length is at most 2^63 - 1** (ADR-385 D1): `len()` hands back
	// an `i64`, whatever its elements take, so a goal may be stated against
	// it as against an `i64` parameter (`bounding_relatives`): `i < n`
	// proves `i + 1 <= n`. No constant of 2^63 goes to the solver (#444).
	walk.typed.insert(length.clone(), "i64")
	if sized {
		if !walk.axioms.contains_key(length) {
			let zero = walk.arena.int(0)
			let most = walk.arena.int(length_below())
			let low = walk.arena.ge(n, zero)
			let high = walk.arena.le(n, most)
			walk.axioms.insert(length, [low, high])
		}
	} else {
		walk.unsized_names.insert(length.clone())
		if !walk.floors.contains_key(length) {
			let zero = walk.arena.int(0)
			let low = walk.arena.ge(n, zero)
			walk.floors.insert(length, low)
		}
	}
	return n
}

/// `lhs op rhs` as a linear term: a sum, a difference, or a product with a
/// constant side.
fn bounding_lin_of(
	mut walk: BoundsWalk,
	op: ref BinaryOp,
	lhs: ref Expr,
	rhs: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	let l = bounding_lin(walk, lhs, facts, context, program, words) ?? return null
	let r = bounding_lin(walk, rhs, facts, context, program, words) ?? return null
	return bounding_combined(walk, op, l, r)
}

fn bounding_combined(mut walk: BoundsWalk, op: ref BinaryOp, l: i64, r: i64) -> i64? {
	match op {
		BinaryOp::Add => return walk.arena.add(l, r),
		BinaryOp::Sub => return walk.arena.sub(l, r),
		BinaryOp::Mul => return bounding_product(walk, l, r),
		BinaryOp::Div => return bounding_quotient(walk, l, r),
		BinaryOp::Shr => return bounding_halved(walk, l, r),
		BinaryOp::BitXor => {
			if (walk.arena.constant(l) ?? 0) == 1 {
				return bounding_flipped(walk, r)
			}
			if (walk.arena.constant(r) ?? 0) == 1 {
				return bounding_flipped(walk, l)
			}
		},
		else => {},
	}
	return null
}

/// Whether `term` reads a number of its own a `/`, `>>` or `^` made
/// (`bounding_defined`, #1631).
fn bounding_reads_own(walk: ref BoundsWalk, term: i64) -> bool {
	let mut read: collections::BTreeSet[String] = collections::BTreeSet()
	walk.arena.variables(term, read)
	for name in read {
		if name.starts_with("quotient#") || name.starts_with("shifted#") || name.starts_with("half#") {
			return true
		}
	}
	return false
}

/// A fresh number of its own for the statement being walked, `what#N`;
/// the caller puts what it is in `defining`.
fn bounding_defined(mut walk: BoundsWalk, what: ref String) -> (String, i64) {
	let name = f"{what}#{walk.codes}"
	walk.codes += 1
	let v = walk.arena.var(name)
	return (name, v)
}

/// **`l / c` for a constant `c >= 1`** (#1631): the quotient `q` rounded
/// toward zero, `c * q <= l <= c * q + c - 1` where `l` is not negative and
/// `c * q - c + 1 <= l <= c * q` where it is, so `(i - 1) / 2 < i` for
/// `i >= 1`.
fn bounding_quotient(mut walk: BoundsWalk, l: i64, r: i64) -> i64? {
	let c = walk.arena.constant(r) ?? return null
	if c < 1 {
		return null
	}
	if c == 1 {
		return l
	}
	let (name, q) = bounding_defined(walk, "quotient")
	let k = walk.arena.int(c)
	let cq = walk.arena.mul(k, q)
	let slack = walk.arena.int(c - 1)
	let zero = walk.arena.int(0)
	let up = walk.arena.add(cq, slack)
	let down = walk.arena.sub(cq, slack)
	let at_least = walk.arena.ge(l, zero)
	let from_below = walk.arena.le(cq, l)
	let to_above = walk.arena.le(l, up)
	let not_negative = walk.arena.and([at_least, from_below, to_above])
	let below = walk.arena.lt(l, zero)
	let from_down = walk.arena.le(down, l)
	let to_cq = walk.arena.le(l, cq)
	let negative = walk.arena.and([below, from_down, to_cq])
	let either = walk.arena.or([not_negative, negative])
	walk.defining.insert(name, [either])
	return q
}

/// **`l >> k` for a constant `k`** (#1631): a shift right rounds down,
/// signed or not, so the result `q` is `2^k * q <= l <= 2^k * q + 2^k - 1`:
/// `l >> 1 < n` where `0 <= l < 2 * n`.
fn bounding_halved(mut walk: BoundsWalk, l: i64, r: i64) -> i64? {
	let k = walk.arena.constant(r) ?? return null
	if k < 0 || k > 62 {
		return null
	}
	if k == 0 {
		return l
	}
	let (name, q) = bounding_defined(walk, "shifted")
	let power = walk.arena.int(1 << k)
	let pq = walk.arena.mul(power, q)
	let slack = walk.arena.int((1 << k) - 1)
	let up = walk.arena.add(pq, slack)
	let from_below = walk.arena.le(pq, l)
	let to_above = walk.arena.le(l, up)
	walk.defining.insert(name, [from_below, to_above])
	return q
}

/// **`l ^ 1`** (#1631): `l` with its lowest bit turned, `4 * h + 1 - l` for
/// `h` its half rounded down (`2 * h <= l <= 2 * h + 1`): `p ^ 1 < 2 * n`
/// where `0 <= p < 2 * n`.
fn bounding_flipped(mut walk: BoundsWalk, l: i64) -> i64 {
	let (name, h) = bounding_defined(walk, "half")
	let two = walk.arena.int(2)
	let four = walk.arena.int(4)
	let one = walk.arena.int(1)
	let th = walk.arena.mul(two, h)
	let up = walk.arena.add(th, one)
	let from_below = walk.arena.le(th, l)
	let to_above = walk.arena.le(l, up)
	walk.defining.insert(name, [from_below, to_above])
	let fh = walk.arena.mul(four, h)
	let raised = walk.arena.add(fh, one)
	return walk.arena.sub(raised, l)
}

/// `l * r`, linear where one side is a constant.
fn bounding_product(mut walk: BoundsWalk, l: i64, r: i64) -> i64? {
	if walk.arena.constant(l) == null && walk.arena.constant(r) == null {
		return null
	}
	return walk.arena.mul(l, r)
}

/// **A call to an expression function is its expression** (ADR-314 D3,
/// #421): a free function whose body is one `return e` gives `e` with the
/// arguments for its parameters, which is the `ensures result == e` it
/// publishes. Where `e` overflows, the function's own check stops the
/// program, so where the caller goes on the value is the one written.
///
/// **Only what `e` says of its parameters**: a name the body does not take
/// as a parameter belongs to the callee's scope, not the caller's, and is not
/// read. A call inside `e` is followed as far as `call_depth`.
fn bounding_called(
	mut walk: BoundsWalk,
	wanted: ref String,
	given: ref Vec[i64],
	depth: i64,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	if depth >= call_depth() {
		return null
	}
	for item in program.items {
		match item.node {
			Item::Fn { name, receiver, args, config, ret_type, body, .. } => {
				if receiver != null || !config.is_empty() {
					continue
				}
				let declared = name ?? continue
				if words.resolve(declared) != wanted {
					continue
				}
				let ret = ret_type ?? continue
				if !ret.generics.is_empty()
					|| !is_whole_number(words.resolve(ret.name))
					|| body.stmts.len() != 1 {
						continue
					}
				for only in body.stmts {
					match only.node {
						Stmt::Return(returned) => {
							let value = returned ?? continue
							if args.len() != given.len() {
								return null
							}
							let mut env: collections::BTreeMap[String, i64] = collections::BTreeMap()
							for k in 0..<args.len() {
								env.insert(words.resolve(args[k].name).clone(), given[k])
							}
							return bounding_inline(walk, value, env, depth, program, words)
						},
						else => {},
					}
				}
			},
			else => {},
		}
	}
	return null
}

/// `expr`, a callee's expression, over `env`'s terms for its parameters.
fn bounding_inline(
	mut walk: BoundsWalk,
	expr: ref Expr,
	env: ref collections::BTreeMap[String, i64],
	depth: i64,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	match expr {
		Expr::LitInt { value, negative, .. } => {
			let n = integer_as_count(integer(value, negative)) ?? return null
			return walk.arena.int(n)
		},
		Expr::Variable(name, _) => {
			let term = env[words.resolve(name)] ?? return null
			return term
		},
		Expr::Unary { op, expr, .. } => {
			match op {
				UnaryOp::Neg => {
					let a = bounding_inline(walk, expr, env, depth, program, words) ?? return null
					return walk.arena.neg(a)
				},
				else => {},
			}
		},
		Expr::Cast { expr, ty, .. } => {
			if ty.generics.is_empty() && is_whole_number(words.resolve(ty.name)) {
				return bounding_inline(walk, expr, env, depth, program, words)
			}
		},
		Expr::Call { func, args, config, .. } => {
			if config.is_empty() {
				let callee = bounding_variable(func, words) ?? return null
				let mut given: Vec[i64] = []
				for arg in args {
					let term = bounding_inline(walk, arg, env, depth, program, words) ?? return null
					given.push(term)
				}
				return bounding_called(walk, callee, given, depth + 1, program, words)
			}
		},
		Expr::Binary { op, lhs, rhs, .. } => {
			let l = bounding_inline(walk, lhs, env, depth, program, words) ?? return null
			let r = bounding_inline(walk, rhs, env, depth, program, words) ?? return null
			return bounding_combined(walk, op, l, r)
		},
		else => {},
	}
	return null
}

/// **What holds where `expr` is true**: a formula `expr` implies, which may
/// say less than `expr` does - of `a && b`, what is read of either half - and
/// never more.
fn bounding_claim(
	mut walk: BoundsWalk,
	expr: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	match expr {
		Expr::LitBool(b, _) => return walk.arena.boolean(b),
		Expr::Variable(name, _) => return bounding_flag_term(walk, facts, words.resolve(name), true),
		Expr::Unary { op, expr, .. } => {
			match op {
				UnaryOp::Not => return bounding_denial(walk, expr, facts, context, program, words),
				else => {},
			}
		},
		Expr::Binary { op, lhs, rhs, .. } => {
			match op {
				BinaryOp::And => {
					let l = bounding_claim(walk, lhs, facts, context, program, words)
					let r = bounding_claim(walk, rhs, facts, context, program, words)
					if l != null && r != null {
						return walk.arena.and([l ?? 0, r ?? 0])
					}
					if l != null {
						return l
					}
					return r
				},
				// A disjunction says something only where both halves do.
				BinaryOp::Or => {
					let l = bounding_claim(walk, lhs, facts, context, program, words) ?? return null
					let r = bounding_claim(walk, rhs, facts, context, program, words) ?? return null
					return walk.arena.or([l, r])
				},
				else => {},
			}
		},
		else => {},
	}
	return bounding_comparison(walk, expr, facts, context, program, words)
}

/// **What holds where `expr` is false**: a formula `!expr` implies, by the
/// same rule as `bounding_claim` - so `a || b` false says what is read of
/// either half false, and `a && b` false says something only where both
/// halves can be denied.
fn bounding_denial(
	mut walk: BoundsWalk,
	expr: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	match expr {
		Expr::LitBool(b, _) => return walk.arena.boolean(!b),
		Expr::Variable(name, _) => return bounding_flag_term(walk, facts, words.resolve(name), false),
		Expr::Unary { op, expr, .. } => {
			match op {
				UnaryOp::Not => return bounding_claim(walk, expr, facts, context, program, words),
				else => {},
			}
		},
		Expr::Binary { op, lhs, rhs, .. } => {
			match op {
				BinaryOp::Or => {
					let l = bounding_denial(walk, lhs, facts, context, program, words)
					let r = bounding_denial(walk, rhs, facts, context, program, words)
					if l != null && r != null {
						return walk.arena.and([l ?? 0, r ?? 0])
					}
					if l != null {
						return l
					}
					return r
				},
				BinaryOp::And => {
					let l = bounding_denial(walk, lhs, facts, context, program, words)
						?? return null
					let r = bounding_denial(walk, rhs, facts, context, program, words)
						?? return null
					return walk.arena.or([l, r])
				},
				else => {},
			}
			// **A denied comparison is its opposite** (#1482): `n <= 0`
			// false states `n > 0`, which the range of `n % 3` reads, where
			// `not(n <= 0)` gave `n` no lower bound.
			let compares = match op {
				BinaryOp::Lt => true,
				BinaryOp::Le => true,
				BinaryOp::Gt => true,
				BinaryOp::Ge => true,
				BinaryOp::Eq => true,
				BinaryOp::Ne => true,
				else => false,
			}
			if compares {
				let a = bounding_lin(walk, lhs, facts, context, program, words) ?? return null
				let b = bounding_lin(walk, rhs, facts, context, program, words) ?? return null
				match op {
					BinaryOp::Lt => return walk.arena.ge(a, b),
					BinaryOp::Le => return walk.arena.gt(a, b),
					BinaryOp::Gt => return walk.arena.le(a, b),
					BinaryOp::Ge => return walk.arena.lt(a, b),
					BinaryOp::Eq => return walk.arena.unequal(a, b),
					else => return walk.arena.equal(a, b),
				}
			}
		},
		else => {},
	}
	return null
}

/// **A `bool` name as a number** (ADR-361 D4, #1634): `1` where it is
/// `true`, `0` where it is `false`, so `if !found` reads what a loop knew
/// where it set `found`. `up` asks for the name true. A whole-number name or
/// a constant is no flag.
fn bounding_flag_term(mut walk: BoundsWalk, facts: ref BoundsFacts, name: ref String, up: bool) -> i64? {
	if facts.ints.contains(name) || walk.shape.constants.contains_key(name) {
		return null
	}
	let n = walk.arena.var(name)
	if up {
		let one = walk.arena.int(1)
		return walk.arena.ge(n, one)
	}
	let zero = walk.arena.int(0)
	return walk.arena.le(n, zero)
}

/// **`name = true` or `false`** (#1634): the name is `1` or `0` from here,
/// and what holds where it goes up is kept for a loop's guesses (`flagged`),
/// the newest few, none that reads the name itself.
fn bounding_flag_set(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, up: bool) {
	let n = walk.arena.var(name)
	let value = walk.arena.int(if up { 1 } else { 0 })
	if up {
		let mut held = walk.flagged.get(name)?.clone() ?? []
		for fact in facts.facts {
			if !bounding_touches(walk, fact, name) && !held.contains(fact) {
				held.push(fact)
			}
		}
		while held.len() > most_flagged() {
			held.remove(0)
		}
		walk.flagged.insert(name.clone(), held)
	}
	let fact = walk.arena.equal(n, value)
	bounding_push(walk, facts, fact)
}

/// How many facts `flagged` keeps of one name.
fn most_flagged() -> i64 {
	return 24
}

/// A comparison of two linear terms, exactly.
fn bounding_comparison(
	mut walk: BoundsWalk,
	expr: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	match expr {
		Expr::Binary { op, lhs, rhs, .. } => {
			let compares = match op {
				BinaryOp::Lt => true,
				BinaryOp::Le => true,
				BinaryOp::Gt => true,
				BinaryOp::Ge => true,
				BinaryOp::Eq => true,
				BinaryOp::Ne => true,
				else => false,
			}
			if !compares {
				return null
			}
			let a = bounding_lin(walk, lhs, facts, context, program, words) ?? return null
			let b = bounding_lin(walk, rhs, facts, context, program, words) ?? return null
			match op {
				BinaryOp::Lt => return walk.arena.lt(a, b),
				BinaryOp::Le => return walk.arena.le(a, b),
				BinaryOp::Gt => return walk.arena.gt(a, b),
				BinaryOp::Ge => return walk.arena.ge(a, b),
				BinaryOp::Eq => return walk.arena.equal(a, b),
				else => return walk.arena.unequal(a, b),
			}
		},
		else => {},
	}
	return null
}

fn bounding_assume(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	cond: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) {
	bounding_name_calls(walk, facts, cond, context, program, words)
	let holds = bounding_claim(walk, cond, facts, context, program, words)
	walk.call_names = collections::BTreeMap()
	if holds != null {
		bounding_push(walk, facts, holds ?? 0)
	}
}

fn bounding_assume_not(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	cond: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) {
	bounding_name_calls(walk, facts, cond, context, program, words)
	let holds = bounding_denial(walk, cond, facts, context, program, words)
	walk.call_names = collections::BTreeMap()
	if holds != null {
		bounding_push(walk, facts, holds ?? 0)
	}
}

/// **A call compared in a condition is a number of its own** (ADR-306 D23,
/// D31, #1785): `if self.level() <= target { return }` says what `let d =
/// self.level()` and `if d <= target` say. Each call a comparison reads
/// whose callee has a found postcondition gets a fresh name, its relations
/// and bounds stated of it among `facts`, for the one claim being assumed;
/// a length it is stated against moves with the facts.
fn bounding_name_calls(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	cond: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) {
	match cond {
		Expr::Unary { op, expr, .. } => match op {
			UnaryOp::Not => bounding_name_calls(walk, facts, expr, context, program, words),
			else => {},
		},
		Expr::Binary { op, lhs, rhs, .. } => {
			if op == BinaryOp::And || op == BinaryOp::Or {
				bounding_name_calls(walk, facts, lhs, context, program, words)
				bounding_name_calls(walk, facts, rhs, context, program, words)
			} else if op == BinaryOp::Lt || op == BinaryOp::Le || op == BinaryOp::Gt || op == BinaryOp::Ge || op == BinaryOp::Eq || op == BinaryOp::Ne {
				bounding_name_call(walk, facts, lhs, context, program, words)
				bounding_name_call(walk, facts, rhs, context, program, words)
			}
		},
		else => {},
	}
}

/// One side of a comparison, where it is a call [`bounding_name_calls`]
/// names.
fn bounding_name_call(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	side: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) {
	let call = match side {
		Expr::Call { .. } => true,
		Expr::MethodCall { .. } => true,
		else => false,
	}
	if !call || bounding_found_options(side) || bounding_lin(walk, side, facts, context, program, words) != null {
		return
	}
	let callee = bounding_found_key(walk, side, context, words) ?? return
	let found = context.returns.get(callee) ?? return
	if found.each || found.pending {
		return
	}
	let name = f"call#{walk.codes}"
	walk.codes += 1
	let n = walk.arena.var(name)
	let mut held: Vec[i64] = []
	for k in found.at_least {
		let term = bounding_found_term(walk, side, k, facts, context, program, words) ?? continue
		held.push(walk.arena.ge(n, term))
	}
	for k in found.within {
		let path = bounding_found_path(side, found, k, words) ?? continue
		if walk.pinned.contains(path_root(path)) {
			continue
		}
		let len = bounding_length_named(walk, path, false)
		held.push(if found.under.contains(k) { walk.arena.lt(n, len) } else { walk.arena.le(n, len) })
	}
	if held.is_empty() {
		return
	}
	facts.ints.insert(name.clone())
	for fact in held {
		bounding_push(walk, facts, fact)
	}
	walk.call_names.insert(node_key(side), name)
}

/// Whether `0 <= index < list.len()` follows from what holds.
fn bounding_inside(
	mut walk: BoundsWalk,
	list: ref String,
	node: i64,
	index: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	if walk.collecting || walk.pinned.contains(path_root(list)) {
		return false
	}
	let len = bounding_list_length(walk, list, node, context)
	// **A cut lies inside where its ends do** (ADR-306 D4): `0 <= a <= b <=
	// len` for `a..<b`, and `b < len` for `a..=b`.
	match index {
		Expr::Range { start, end, inclusive, .. } => {
			let from = bounding_lin(walk, start, facts, context, program, words) ?? return false
			let to = bounding_lin(walk, end, facts, context, program, words) ?? return false
			let zero = walk.arena.int(0)
			let low = walk.arena.ge(from, zero)
			let ordered = walk.arena.le(from, to)
			let mut high = walk.arena.le(to, len)
			if inclusive {
				high = walk.arena.lt(to, len)
			}
			let goal = walk.arena.and([low, ordered, high])
			return bounding_proves_goal(walk, facts, goal, ask)
		},
		else => {},
	}
	let at = bounding_lin(walk, index, facts, context, program, words)
	if at != null {
		let position = at ?? 0
		let zero = walk.arena.int(0)
		let low = walk.arena.ge(position, zero)
		let high = walk.arena.lt(position, len)
		let goal = walk.arena.and([low, high])
		if bounding_proves_goal(walk, facts, goal, ask) {
			return true
		}
		// An element as a name (ADR-306 D33) may still be a position read
		// out of a list of positions, below.
		match index {
			Expr::Index { .. } => {},
			else => return false,
		}
	}
	// **A position read out of a list of positions** (ADR-369 D4): what
	// holds of its every element.
	if rules_element_inside(walk, len, index, facts, words, ask) {
		return true
	}
	if bounding_end_inside(walk, len, index, facts, words, ask) {
		return true
	}
	// A position read out of a list whose values are bounded (ADR-306
	// D7), or one `%` keeps small (D3).
	let range = bounding_range(walk, index, facts, context, program, words, ask) ?? return false
	let lo = range.lo ?? return false
	let hi = range.hi ?? return false
	if lo < 0 {
		return false
	}
	let most = walk.arena.int(hi)
	let goal = walk.arena.lt(most, len)
	return bounding_proves_goal(walk, facts, goal, ask)
}

/// Whether the `width` elements from `at` lie inside `list`, as the cut
/// `list[at..<at + width]` does: `0 <= at` and `at + width <= list.len()`.
fn bounding_word_inside(
	mut walk: BoundsWalk,
	list: ref String,
	node: i64,
	at: ref Expr,
	width: i64,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	if walk.collecting || walk.pinned.contains(path_root(list)) {
		return false
	}
	let len = bounding_list_length(walk, list, node, context)
	let from = bounding_lin(walk, at, facts, context, program, words) ?? return false
	let zero = walk.arena.int(0)
	let n = walk.arena.int(width)
	let to = walk.arena.add(from, n)
	let low = walk.arena.ge(from, zero)
	let high = walk.arena.le(to, len)
	let goal = walk.arena.and([low, high])
	return bounding_proves_goal(walk, facts, goal, ask)
}

/// `base[index]`, read or written: proved where `base` is a list by name.
fn bounding_index(
	mut walk: BoundsWalk,
	base: ref Expr,
	index: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let list = path_of(base, words) ?? return
	if bounding_inside(walk, list, node_key(base), index, facts, context, program, words, ask) {
		walk.proven.indices.insert(node_key(base))
		if bounding_tracing(walk) {
			bounding_trace_row(walk, f"  read {list}[…]: proved")
		}
	} else {
		walk.open += 1
		if bounding_tracing(walk) {
			bounding_trace_row(walk, f"  read {list}[…]: checked")
		}
	}
}

/// **The length of the list `list`, read at `node`**: the `N` of an
/// `Array[T, N]`, or the list's length as a name.
fn bounding_list_length(
	mut walk: BoundsWalk,
	list: ref String,
	node: i64,
	context: ref BoundsContext,
) -> i64 {
	let fixed = context.array_lengths.get(node)
	if fixed != null {
		return walk.arena.int(fixed ?? 0)
	}
	return walk.arena.var(length_of(bounding_counted_list(list, node, context)))
}

/// A block; whether control never goes past its end.
fn bounding_block(
	mut walk: BoundsWalk,
	block: ref Block,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let before = facts.ints.clone()
	let mut bound: Vec[String] = []
	let leaves = bounding_stmts(walk, block, 0, facts, bound, context, program, words, ask)
	// The block's own names leave with it; a name it hid is the outer one
	// again, and what was known of that was forgotten where it was hidden.
	for name in bound {
		bounding_leave(walk, facts, name)
		facts.ints.remove(name)
		if before.contains(name) {
			facts.ints.insert(name.clone())
		}
	}
	return leaves
}

/// **A block's own name leaves by its value** (#1669): where a fact states
/// it equal to a term that does not read it (`l == i + 1`, `i == child`),
/// the facts that read it are restated over that term, so `i == l` past
/// `let l = i + 1` keeps `i == i#k + 1` at the end of a loop's turn; the
/// facts left that read it leave with it.
fn bounding_leave(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String) {
	let mut value: i64? = null
	let mut by = -1
	for fact in facts.facts {
		match walk.arena.at(fact) {
			logic::SolverTerm::Eq(a, b) => {
				if walk.arena.is_the_variable(a, name) && !walk.arena.mentions(b, name) {
					value = b
				} else if walk.arena.is_the_variable(b, name) && !walk.arena.mentions(a, name) {
					value = a
				}
			},
			else => {},
		}
		if value != null {
			by = fact
			break
		}
	}
	if value != null {
		let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
		given.insert(name.clone(), value ?? 0)
		let mut kept: Vec[i64] = []
		for fact in facts.facts {
			if fact == by {
				continue
			}
			if walk.arena.mentions(fact, name) {
				kept.push(walk.arena.substitute(fact, given))
			} else {
				kept.push(fact)
			}
		}
		facts.facts = kept
	}
	bounding_forget(walk, facts, name)
}

/// **The statements of `block` from the one at `from`**, the names they
/// bind gathered in `bound`: whether one of them leaves the block. Under
/// `prove-through-loops:on` a loop's walk goes on in [`bounding_past_loop`],
/// which may walk the statements after it twice (ADR-361 D10).
fn bounding_stmts(
	mut walk: BoundsWalk,
	block: ref Block,
	from: i64,
	mut facts: BoundsFacts,
	mut bound: Vec[String],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let mut at = from
	for stmt in block.stmts[from..] {
		match stmt.node {
			Stmt::Let { names, .. } => {
				for name in names {
					bound.push(words.resolve(name).clone())
				}
			},
			Stmt::Comptime { name, .. } => bound.push(words.resolve(name).clone()),
			else => {},
		}
		walk.at = stmt.span.start as i64
		let looped = match stmt.node {
			Stmt::For { .. } => true,
			Stmt::While { .. } => true,
			else => false,
		}
		if looped && context.through_loops && !walk.collecting {
			return bounding_past_loop(
				walk,
				block,
				at,
				stmt.node,
				facts,
				bound,
				context,
				program,
				words,
				ask,
			)
		}
		if bounding_stmt(walk, stmt.node, facts, context, program, words, ask) {
			return true
		}
		at += 1
	}
	return false
}

fn bounding_maybe_block(
	mut walk: BoundsWalk,
	block: ref Block?,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let present = block ?? return false
	return bounding_block(walk, present, facts, context, program, words, ask)
}

fn bounding_stmt(
	mut walk: BoundsWalk,
	stmt: ref Stmt,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	walk.defining.clear()
	match stmt {
		Stmt::Let { names, ty, value, .. } => {
			bounding_let(walk, names, ty, value, facts, context, program, words, ask)
			return false
		},
		Stmt::Comptime { name, value, .. } => {
			bounding_expr(walk, value, facts, context, program, words, ask)
			let text = words.resolve(name)
			bounding_forget(walk, facts, text)
			facts.ints.remove(text)
			return false
		},
		// **The value first, and then the write**, in the order the lowering
		// runs them (ADR-293 D2): a value that shrinks the list is reached
		// before the index it is written at.
		Stmt::Assign { target, op, value } => {
			let at = walk.at
			bounding_expr(walk, value, facts, context, program, words, ask)
			bounding_place(walk, target, facts, context, program, words, ask)
			rules_element_write(walk, facts, target, op, value, context, program, words, ask)
			bounding_compound(walk, op, target, value, at, facts, context, program, words, ask)
			if op == null {
				match target {
					Expr::Field { name, .. } => {
						let key = f".{words.resolve(name)}"
						if walk.shape.fields.contains(key) {
							bounding_field_list(walk, key, value, facts, context, program, words, ask)
						}
					},
					Expr::Index { base, .. } => {
						let key = elements_key(walk.shape, base, words)
						if key != null {
							bounding_write(
								walk,
								key ?? "",
								value,
								facts,
								context,
								program,
								words,
								ask,
							)
						}
					},
					else => {},
				}
			}
			bounding_forget_aliases(walk, facts, target, words)
			match target {
				Expr::Variable(name, _) => {
					bounding_forget_elements_at(walk, facts, words.resolve(name))
					bounding_assign(
						walk,
						facts,
						words.resolve(name),
						op,
						value,
						context,
						program,
						words,
						ask,
					)
				},
				// **A write to a path of fields** (ADR-306 D17): the path
				// moves as a name does, and what was known of its parts goes.
				Expr::Field { .. } => bounding_assign_place(walk, facts, target, op, value, context, program, words, ask),
				// **A write to an element** (ADR-306 D33): the element moves
				// as a name does; the others went with `bounding_forget_aliases`.
				Expr::Index { .. } => bounding_assign_place(walk, facts, target, op, value, context, program, words, ask),
				else => {},
			}
			return false
		},
		Stmt::For { .. } => {
			bounding_loop_stmt(walk, stmt, facts, context, program, words, ask)
			return false
		},
		Stmt::While { .. } => {
			bounding_loop_stmt(walk, stmt, facts, context, program, words, ask)
			return false
		},
		Stmt::Return(value) => {
			if value != null {
				let returned = value ?? return true
				bounding_expr(walk, returned, facts, context, program, words, ask)
			}
			rules_exit(walk, facts, value, false, context, program, words, ask)
			return true
		},
		Stmt::Break => {
			bounding_turn_end(walk, facts, true, true, ask)
			return true
		},
		Stmt::Continue => {
			bounding_turn_end(walk, facts, true, false, ask)
			return true
		},
		Stmt::Expr(expr) => return bounding_expr_leaves(
			walk,
			expr,
			facts,
			context,
			program,
			words,
			ask,
		),
	}
}

/// `for bindings in iter { body }`, with `invariant` assumed at the head of
/// each turn (ADR-361 D10).
fn bounding_for_stmt(
	mut walk: BoundsWalk,
	bindings: ref Vec[winnow_grammar::Symbol],
	iter: ref Expr,
	body: ref Block,
	mut facts: BoundsFacts,
	invariant: ref Vec[i64],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let changed = bounding_changed(body, context, words)
	let mut cands = bounding_candidates(walk, changed, facts)
	if cands.is_empty() {
		bounding_for(
			walk,
			bindings,
			iter,
			body,
			facts,
			cands,
			invariant,
			context,
			program,
			words,
			ask,
		)
		return
	}
	let start = facts.clone()
	let proven = walk.proven.clone()
	let written = walk.written.clone()
	let poisoned = walk.poisoned.clone()
	// **Walked again without the counters that did not grow**, until
	// every one left did: each pass takes fewer. One changed only by
	// taking from it is taken to fall instead (#1329).
	let falls = bounding_falls(changed, cands)
	while true {
		let added = bounding_grow(walk, cands, falls)
		bounding_for(
			walk,
			bindings,
			iter,
			body,
			facts,
			cands,
			invariant,
			context,
			program,
			words,
			ask,
		)
		let failed = bounding_grew(walk, cands, added)
		if failed.is_empty() {
			return
		}
		walk.proven = proven.clone()
		walk.written = written.clone()
		walk.poisoned = poisoned.clone()
		facts.facts = start.facts.clone()
		facts.ints = start.ints.clone()
		cands = bounding_without(cands, failed)
	}
	return
}

/// `while cond { body }`, with `invariant` assumed at the head of each turn.
fn bounding_while_stmt(
	mut walk: BoundsWalk,
	cond: ref Expr,
	body: ref Block,
	mut facts: BoundsFacts,
	invariant: ref Vec[i64],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let mut changed = bounding_changed(body, context, words)
	bounding_extend(changed, bounding_changed_in_expr(cond, context, words))
	let mut cands = bounding_candidates(walk, changed, facts)
	if cands.is_empty() {
		bounding_while(
			walk,
			cond,
			body,
			changed,
			cands,
			facts,
			invariant,
			context,
			program,
			words,
			ask,
		)
		return
	}
	let start = facts.clone()
	let proven = walk.proven.clone()
	let written = walk.written.clone()
	let poisoned = walk.poisoned.clone()
	// **Walked again without the counters that did not grow**, until
	// every one left did: each pass takes fewer. One changed only by
	// taking from it is taken to fall instead (#1329).
	let falls = bounding_falls(changed, cands)
	while true {
		let added = bounding_grow(walk, cands, falls)
		bounding_while(
			walk,
			cond,
			body,
			changed,
			cands,
			facts,
			invariant,
			context,
			program,
			words,
			ask,
		)
		let failed = bounding_grew(walk, cands, added)
		if failed.is_empty() {
			return
		}
		walk.proven = proven.clone()
		walk.written = written.clone()
		walk.poisoned = poisoned.clone()
		facts.facts = start.facts.clone()
		facts.ints = start.ints.clone()
		cands = bounding_without(cands, failed)
	}
	return
}

/// **A loop, and under `prove-through-loops:on` its invariant** (ADR-361 D2,
/// D4, D10). The loop is walked as ADR-306 walks it; where that leaves a goal
/// open, it is walked again with a candidate invariant assumed at the head of
/// each turn: the facts before it that the loop's changes take away, an
/// equality as its two halves (D5's guess and check, its candidates the
/// facts the loop is reached with). Each candidate is asked where the loop is
/// reached, and at each end of a turn, `continue` and `break` while all of
/// them are assumed; one that fails is dropped and the loop walked again,
/// until none fails. What that walk proves stands only where it proves more
/// than the walk without it; its invariant is kept for `nikaia.proofs` (D7).
fn bounding_loop_stmt(
	mut walk: BoundsWalk,
	stmt: ref Stmt,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let start = walk.at
	let open = walk.open
	walk.settled_loops.remove(start)
	if !context.through_loops || walk.collecting {
		bounding_loop_framed(walk, stmt, facts, context, program, words, ask)
		return
	}
	let entry = facts.clone()
	let proven = walk.proven.clone()
	let written = walk.written.clone()
	let poisoned = walk.poisoned.clone()
	bounding_loop_framed(walk, stmt, facts, context, program, words, ask)
	if walk.open == open {
		return
	}
	// **Only a goal that reads a name the loop changes** is asked through
	// it (D10): the names such goals left open, and of the candidates only
	// those that read one of them.
	let changed = bounding_loop_changed(stmt, context, words)
	let mut wanted: collections::BTreeSet[String] = collections::BTreeSet()
	for (name, stamp) in walk.missed {
		if stamp > open && bounding_changes_name(changed, name) {
			wanted.insert(name.clone())
		}
	}
	if wanted.is_empty() {
		return
	}
	let after = facts.clone()
	let after_proven = walk.proven.clone()
	let after_written = walk.written.clone()
	let after_poisoned = walk.poisoned.clone()
	let after_open = walk.open
	let found = bounding_loop_invariant(
		walk,
		stmt,
		start,
		entry,
		written,
		poisoned,
		changed,
		wanted,
		open,
		context,
		program,
		words,
		ask,
	)
	// The candidates left are asked the same once more.
	if found != null {
		let invariant = found ?? return
		if invariant.settled && bounding_could_pay(walk, invariant.guesses, open, ask) {
			walk.proven = proven.clone()
			walk.written = written.clone()
			walk.poisoned = poisoned.clone()
			walk.open = open
			let mut here = invariant.entry.clone()
			walk.turns.push(BoundsTurn {
				guesses: invariant.guesses.clone(),
				failed: collections::BTreeSet(),
				jumps: collections::BTreeSet(),
			})
			bounding_loop_walk(walk, stmt, here, invariant.guesses, context, program, words, ask)
			let frame = walk.turns.pop()
				?? BoundsTurn {
					guesses: [],
					failed: collections::BTreeSet(),
					jumps: collections::BTreeSet(),
				}
			if frame.failed.is_empty()
				&& frame.jumps.len() == invariant.ways
				&& bounding_proven_count(walk.proven) > bounding_proven_count(after_proven) {
					bounding_loop_found(walk, start, invariant)
					facts.facts = here.facts.clone()
					facts.ints = here.ints.clone()
					bounding_loop_left(walk, facts, invariant.guesses, changed)
					walk.settled_loops.insert(start)
					return
				}
		}
	}
	walk.proven = after_proven
	walk.written = after_written
	walk.poisoned = after_poisoned
	walk.open = after_open
	facts.facts = after.facts.clone()
	facts.ints = after.ints.clone()
}

/// **A loop's invariant, as the D10 portfolio found it** (ADR-361 D4, D5):
/// the candidates that hold where the loop is reached and that the walks
/// without goals kept, with the strategy that found each.
struct BoundsInvariant {
	guesses: Vec[i64],
	origins: collections::BTreeMap[i64, String],
	/// What holds where the loop is reached, the prover's ghosts with it.
	entry: BoundsFacts,
	/// What holds past the loop, from the last walk that kept them all.
	past: BoundsFacts,
	/// Whether a walk kept them all, through every way out.
	settled: bool,
	/// How many ways out of a turn the loop has.
	ways: i64,
}

/// **The candidate invariant of a loop for the goals that read `wanted`**
/// (ADR-361 D4, D5, D10): the prover's candidates first, then the walk's own
/// guesses, those that hold where it is reached (`entry`, before the loop's
/// `written` and `poisoned`); where `open` is given, only if they could pay
/// for a goal left open since. They then settle in walks that ask no goal.
/// The walk's state is what those walks leave: the caller puts it back.
fn bounding_loop_invariant(
	mut walk: BoundsWalk,
	stmt: ref Stmt,
	start: i64,
	entry: BoundsFacts,
	written: ref collections::BTreeMap[String, Range],
	poisoned: ref collections::BTreeSet[String],
	changed: ref BoundsChanged,
	wanted: ref collections::BTreeSet[String],
	open: i64?,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> BoundsInvariant? {
	let ways = match stmt {
		Stmt::For { body, .. } => turn_jumps(body, words),
		Stmt::While { body, .. } => turn_jumps(body, words),
		else => return null,
	}
	let mut reached = entry
	// **The prover's candidates first, then the walk's own guesses**
	// (D5, D10): one portfolio for an `assert` and a check.
	let own_guesses = bounding_loop_guesses(walk, stmt, reached, changed, context, program, words)
	let proposals = bounding_loop_proposals(walk, stmt, start, reached, changed, words, ask)
	let mut offered = proposals.candidates.clone()
	for guess in own_guesses {
		offered.push((guess, "guess and check"))
	}
	for ghost in proposals.ghosts {
		reached.facts.push(ghost)
	}
	let mut origins: collections::BTreeMap[i64, String] = collections::BTreeMap()
	let mut guesses: Vec[i64] = []
	// What held before the loop, over the values it was reached with: true
	// at every turn, since nothing changes those values.
	for fixed in proposals.fixed {
		guesses.push(fixed)
		origins.insert(fixed, "closed forms")
	}
	for (guess, origin) in offered {
		if origins.contains_key(guess) {
			continue
		}
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(guess, read)
		let mut useful = false
		for name in read {
			if wanted.contains(name) {
				useful = true
			}
		}
		// D4's first query: it holds where the loop is reached.
		if useful && bounding_proves(walk, reached, guess, ask) {
			guesses.push(guess)
			origins.insert(guess, origin.clone())
		}
	}
	let mut asked: Vec[i64] = []
	for (guess, _) in offered {
		asked.push(guess)
	}
	bounding_turn_row(walk, start, f"  loop: offered {bounding_texts(walk, asked)}\n    held where reached: {bounding_texts(walk, guesses)}")
	if guesses.len() == proposals.fixed.len() {
		return null
	}
	if guesses.is_empty() {
		return null
	}
	// **Worth a walk only where it could pay**: a goal this loop left open
	// that its candidates, added to what held there, prove. A guess only -
	// what the walk then proves is what counts.
	if open != null && !bounding_could_pay(walk, guesses, open ?? 0, ask) {
		return null
	}
	// **The candidates settle first in walks that ask no goal** (they only
	// carry the facts to each end of a turn), then one walk asks the goals
	// with what is left assumed and checks it once more.
	let mut settled = false
	let mut past = reached.clone()
	for attempt in 0..<4 {
		walk.written = written.clone()
		walk.poisoned = poisoned.clone()
		let mut here = reached.clone()
		walk.collecting = true
		walk.turns.push(BoundsTurn {
			guesses: guesses.clone(),
			failed: collections::BTreeSet(),
			jumps: collections::BTreeSet(),
		})
		bounding_loop_walk(walk, stmt, here, guesses, context, program, words, ask)
		walk.collecting = false
		let frame = walk.turns.pop() ?? break
		bounding_turn_row(walk, start, f"  loop round {attempt}: {frame.jumps.len()} of {ways} ways out walked, {frame.failed.len()} of {guesses.len()} not kept")
		// A way out the walk did not reach is one nothing checked.
		if frame.jumps.len() != ways {
			break
		}
		if frame.failed.is_empty() {
			settled = true
			past = here
			break
		}
		let mut kept: Vec[i64] = []
		for k in 0..<guesses.len() {
			if !frame.failed.contains(k) {
				kept.push(guesses[k])
			}
		}
		guesses = kept
		if guesses.is_empty() {
			break
		}
	}
	return BoundsInvariant {
		guesses: guesses,
		origins: origins,
		entry: reached,
		past: past,
		settled: settled,
		ways: ways,
	}
}

/// **The invariant that carried a check through the loop at `start`**, kept
/// for `nikaia.proofs` (D7) with the strategy that found each part.
fn bounding_loop_found(mut walk: BoundsWalk, start: i64, invariant: ref BoundsInvariant) {
	let mut parts: Vec[(i64, String)] = []
	for guess in invariant.guesses {
		parts.push((guess, (invariant.origins[guess] ?? "guess and check").clone()))
	}
	walk.proven.loops.insert(start, loop_parts_text(walk.arena, LoopFound { parts: parts }))
}

/// What a guess a `break` need not keep says of the names the loop changes
/// does not hold past it.
fn bounding_loop_left(
	walk: ref BoundsWalk,
	mut facts: BoundsFacts,
	guesses: ref Vec[i64],
	changed: ref BoundsChanged,
) {
	for guess in guesses {
		if walk.leaving.contains(guess) {
			let mut read: collections::BTreeSet[String] = collections::BTreeSet()
			walk.arena.variables(guess, read)
			for name in read {
				if bounding_changes_name(changed, name) {
					bounding_forget(walk, facts, name)
				}
			}
		}
	}
}

/// **Where the walk stands**, to walk the statements after a loop again
/// (ADR-361 D10): what holds, what it proved and every set a statement adds
/// to.
struct BoundsMark {
	facts: BoundsFacts,
	proven: BoundsProven,
	written: collections::BTreeMap[String, Range],
	poisoned: collections::BTreeSet[String],
	open: i64,
	missed: collections::BTreeMap[String, i64],
	missed_goals: Vec[BoundsMissed],
	turns: Vec[BoundsTurn],
	grow_failed: collections::BTreeSet[String],
	fall_failed: collections::BTreeSet[String],
	checked_results: collections::BTreeSet[i64],
	rule_failed: collections::BTreeSet[i64],
	bound: Vec[String],
}

fn bounding_mark(walk: ref BoundsWalk, facts: ref BoundsFacts, bound: ref Vec[String]) -> BoundsMark {
	return BoundsMark {
		facts: facts.clone(),
		proven: walk.proven.clone(),
		written: walk.written.clone(),
		poisoned: walk.poisoned.clone(),
		open: walk.open,
		missed: walk.missed.clone(),
		missed_goals: walk.missed_goals.clone(),
		turns: walk.turns.clone(),
		grow_failed: walk.grow_failed.clone(),
		fall_failed: walk.fall_failed.clone(),
		checked_results: walk.checked_results.clone(),
		rule_failed: walk.rule_failed.clone(),
		bound: bound.clone(),
	}
}

fn bounding_back(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	mut bound: Vec[String],
	mark: ref BoundsMark,
) {
	facts.facts = mark.facts.facts.clone()
	facts.ints = mark.facts.ints.clone()
	walk.proven = mark.proven.clone()
	walk.written = mark.written.clone()
	walk.poisoned = mark.poisoned.clone()
	walk.open = mark.open
	walk.missed = mark.missed.clone()
	walk.missed_goals = mark.missed_goals.clone()
	walk.turns = mark.turns.clone()
	walk.grow_failed = mark.grow_failed.clone()
	walk.fall_failed = mark.fall_failed.clone()
	walk.checked_results = mark.checked_results.clone()
	walk.rule_failed = mark.rule_failed.clone()
	bound.clear()
	for name in mark.bound {
		bound.push(name.clone())
	}
}

/// **A check after a loop, asked through it** (ADR-361 D10, #1383): the
/// loop at `from` in `block` is walked, then the statements after it. Where
/// those leave a goal open that reads a name the loop changes, and the loop
/// carried no invariant already, the loop's invariant is sought for those
/// names (the same portfolio as for a goal inside it), and the statements
/// after it are walked again from what holds past the loop with it. That
/// walk stands only where it proves more.
fn bounding_past_loop(
	mut walk: BoundsWalk,
	block: ref Block,
	from: i64,
	stmt: ref Stmt,
	mut facts: BoundsFacts,
	mut bound: Vec[String],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let start = walk.at
	let entry = facts.clone()
	let written = walk.written.clone()
	let poisoned = walk.poisoned.clone()
	bounding_stmt(walk, stmt, facts, context, program, words, ask)
	let past = bounding_mark(walk, facts, bound)
	let leaves = bounding_stmts(walk, block, from + 1, facts, bound, context, program, words, ask)
	if walk.open == past.open || walk.settled_loops.contains(start) {
		return leaves
	}
	let changed = bounding_loop_changed(stmt, context, words)
	let mut wanted: collections::BTreeSet[String] = collections::BTreeSet()
	for (name, stamp) in walk.missed {
		if stamp > past.open && bounding_changes_name(changed, name) {
			wanted.insert(name.clone())
		}
	}
	// **A flag the loop raised, read where a goal past it was left open**
	// (ADR-361 D15): `if !seen { return }` or `if at.len() == 0 { return }`
	// before `args[0]` asks the loop for what held where the flag rose,
	// though the goal reads no name the loop changes. Such a search is
	// walked only where its candidates could pay.
	let mut only_flags: i64? = null
	if wanted.is_empty() {
		for missed in walk.missed_goals {
			if missed.stamp <= past.open {
				continue
			}
			for fact in missed.facts {
				let mut read: collections::BTreeSet[String] = collections::BTreeSet()
				walk.arena.variables(fact, read)
				for name in read {
					if bounding_changes_name(changed, name)
						&& (walk.flagged.contains_key(name) || name.ends_with(".len()")) {
							wanted.insert(name.clone())
						}
				}
			}
		}
		only_flags = past.open
	}
	if wanted.is_empty() {
		return leaves
	}
	let end = bounding_mark(walk, facts, bound)
	let found = bounding_loop_invariant(
		walk,
		stmt,
		start,
		entry,
		written,
		poisoned,
		changed,
		wanted,
		only_flags,
		context,
		program,
		words,
		ask,
	)
	if found != null {
		let invariant = found ?? return leaves
		if invariant.settled {
			bounding_back(walk, facts, bound, past)
			facts.facts = invariant.past.facts.clone()
			facts.ints = invariant.past.ints.clone()
			bounding_loop_left(walk, facts, invariant.guesses, changed)
			let again = bounding_stmts(walk, block, from + 1, facts, bound, context, program, words, ask)
			if bounding_proven_count(walk.proven) > bounding_proven_count(end.proven) {
				bounding_loop_found(walk, start, invariant)
				return again
			}
		}
	}
	bounding_back(walk, facts, bound, end)
	return leaves
}

/// **Whether `guesses` could pay for a walk**: a goal left open since the
/// open count was `open` that they, added to what held there, prove.
fn bounding_could_pay(
	mut walk: BoundsWalk,
	guesses: ref Vec[i64],
	open: i64,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	for missed in walk.missed_goals {
		if missed.stamp <= open {
			continue
		}
		let mut there = BoundsFacts { ints: collections::BTreeSet(), facts: missed.facts.clone(), evicted: 0 }
		for guess in guesses {
			there.facts.push(guess)
		}
		if bounding_proves(walk, there, missed.goal, ask) {
			return true
		}
	}
	return false
}

/// A loop walked once, in a frame of its own where an outer loop's
/// invariant is being checked: its `break`s and `continue`s are its own.
fn bounding_loop_framed(
	mut walk: BoundsWalk,
	stmt: ref Stmt,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let none: Vec[i64] = []
	if walk.turns.is_empty() {
		bounding_loop_walk(walk, stmt, facts, none, context, program, words, ask)
		return
	}
	walk.turns.push(BoundsTurn {
		guesses: [],
		failed: collections::BTreeSet(),
		jumps: collections::BTreeSet(),
	})
	bounding_loop_walk(walk, stmt, facts, none, context, program, words, ask)
	walk.turns.pop()
}

fn bounding_loop_walk(
	mut walk: BoundsWalk,
	stmt: ref Stmt,
	mut facts: BoundsFacts,
	invariant: ref Vec[i64],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	match stmt {
		Stmt::For { bindings, iter, body, .. } => bounding_for_stmt(
			walk,
			bindings,
			iter,
			body,
			facts,
			invariant,
			context,
			program,
			words,
			ask,
		),
		Stmt::While { cond, body } => bounding_while_stmt(
			walk,
			cond,
			body,
			facts,
			invariant,
			context,
			program,
			words,
			ask,
		),
		else => {},
	}
}

/// **The candidates of a loop's invariant**: the facts it is reached with
/// that its changes take away, an equality as its two halves, none that
/// reads a `for`'s binding.
fn bounding_loop_guesses(
	mut walk: BoundsWalk,
	stmt: ref Stmt,
	entry: ref BoundsFacts,
	changed: ref BoundsChanged,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> Vec[i64] {
	let mut bound: Vec[String] = []
	match stmt {
		Stmt::For { bindings, .. } => {
			for binding in bindings {
				bound.push(words.resolve(binding).clone())
			}
		},
		else => {},
	}
	let mut head = entry.clone()
	bounding_after_change(walk, head, changed)
	let mut kept: collections::BTreeSet[i64] = collections::BTreeSet()
	kept.extend(head.facts.clone())
	let mut out: Vec[i64] = []
	for fact in entry.facts {
		if kept.contains(fact) {
			continue
		}
		let mut reads_bound = false
		for name in bound {
			if bounding_touches(walk, fact, name) {
				reads_bound = true
			}
		}
		if reads_bound {
			continue
		}
		match walk.arena.at(fact) {
			logic::SolverTerm::Eq(a, b) => {
				out.push(walk.arena.le(a, b))
				out.push(walk.arena.ge(a, b))
				for restated in bounding_restated(walk, entry, changed, a, b) {
					if !out.contains(restated) {
						out.push(restated)
					}
				}
			},
			else => out.push(fact),
		}
	}
	// **A guard that leaves the loop holds the other way where the next turn
	// starts** (D4): `if c { break }` in the body makes `!c` a candidate,
	// asked where the loop is reached as any other.
	let body = match stmt {
		Stmt::For { body, .. } => body,
		Stmt::While { body, .. } => body,
		else => return out,
	}
	// **What held where the loop sets a flag holds wherever it is up**
	// (#1634): `found = true` under `b <= now.len()` offers `!found || b <=
	// now.len()`, kept through each turn where nothing past the flag changes
	// `b`, and read past the loop under `if found`.
	for (flag, held) in walk.flagged {
		if !bounding_changes_name(changed, flag) {
			continue
		}
		let n = walk.arena.var(flag)
		let zero = walk.arena.int(0)
		let down = walk.arena.le(n, zero)
		for fact in held {
			let mut read: collections::BTreeSet[String] = collections::BTreeSet()
			walk.arena.variables(fact, read)
			let mut reads_changed = false
			for name in read {
				if bounding_changes_name(changed, name) {
					reads_changed = true
				}
			}
			let mut reads_bound = false
			for name in bound {
				if bounding_touches(walk, fact, name) {
					reads_bound = true
				}
			}
			if reads_changed && !reads_bound {
				let guess = walk.arena.or([down, fact])
				if !out.contains(guess) {
					out.push(guess)
				}
			}
		}
	}
	// **A name a turn sets to a remainder lies inside what its divisor
	// leaves** (#1690): `state = (state * a + c) % m`, `m` a constant, offers
	// `0 <= state` and `state <= m - 1`, asked where the loop is reached and
	// kept through each turn as any other.
	let mut remainders: Vec[(String, i64)] = []
	bounding_remainders_set(walk, body, entry, changed, context, program, words, remainders)
	for (name, most) in remainders {
		if bound.contains(name) {
			continue
		}
		let n = walk.arena.var(name)
		let zero = walk.arena.int(0)
		let top = walk.arena.int(most)
		for guess in [walk.arena.ge(n, zero), walk.arena.le(n, top)] {
			if !out.contains(guess) {
				out.push(guess)
			}
		}
	}
	for each in body.stmts {
		let guard = bounding_break_guard(each.node) ?? continue
		let denied = bounding_denial(walk, guard, entry, context, program, words) ?? continue
		let mut reads_bound = false
		for name in bound {
			if bounding_touches(walk, denied, name) {
				reads_bound = true
			}
		}
		if !reads_bound {
			walk.leaving.insert(denied)
			out.push(denied)
		}
	}
	return out
}

/// The whole-number names of `changed` that `block` sets to `e % m` or by
/// `x %= m`, at any depth of its `if`s, with `m - 1` for `m` a constant of at
/// least one (#1690).
fn bounding_remainders_set(
	mut walk: BoundsWalk,
	block: ref Block,
	entry: ref BoundsFacts,
	changed: ref BoundsChanged,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	mut out: Vec[(String, i64)],
) {
	for each in block.stmts {
		match each.node {
			Stmt::Assign { target, op, value } => {
				let place = path_of(target, words) ?? continue
				if place.contains(".") || !entry.ints.contains(place) || !bounding_changes_name(changed, place) {
					continue
				}
				let mut divisor: Expr? = null
				if bounding_is_op(op, BinaryOp::Rem) {
					divisor = value.clone()
				} else if op == null {
					match value {
						Expr::Binary { op, rhs, .. } => {
							if op == BinaryOp::Rem {
								divisor = rhs.clone()
							}
						},
						else => {},
					}
				}
				let d = divisor ?? continue
				let term = bounding_lin(walk, d, entry, context, program, words) ?? continue
				let m = walk.arena.constant(term) ?? continue
				if m >= 1 {
					out.push((place.clone(), m - 1))
				}
			},
			Stmt::Expr(expr) => match expr {
				Expr::If { then_branch, else_branch, .. } => {
					bounding_remainders_set(walk, then_branch, entry, changed, context, program, words, out)
					let other = else_branch ?? continue
					bounding_remainders_set(walk, other, entry, changed, context, program, words, out)
				},
				else => {},
			},
			else => {},
		}
	}
}

/// **What held of the value a changed name starts with, said of the name**
/// (#1669): `i == start` where the loop is reached, with `0 <= start` and
/// `start < xs.len()`, offers `0 <= i` and `i < xs.len()`. `start` is a
/// name the loop does not change; the facts restated read no changed name.
fn bounding_restated(
	mut walk: BoundsWalk,
	entry: ref BoundsFacts,
	changed: ref BoundsChanged,
	a: i64,
	b: i64,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	let (counter, start) = match walk.arena.at(a) {
		logic::SolverTerm::Var(x) => {
			match walk.arena.at(b) {
				logic::SolverTerm::Var(v) => (x.clone(), v.clone()),
				else => return out,
			}
		},
		else => return out,
	}
	let mut moving = false
	let mut still = true
	for name in changed.values {
		if name == counter {
			moving = true
		}
		if path_within(start, name) {
			still = false
		}
	}
	if !moving || !still {
		return out
	}
	let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
	given.insert(start.clone(), a)
	for fact in entry.facts {
		if !walk.arena.mentions(fact, start) || walk.arena.mentions(fact, counter) {
			continue
		}
		let mut touched = false
		for name in changed.values {
			if bounding_touches(walk, fact, name) {
				touched = true
			}
		}
		if !touched {
			out.push(walk.arena.substitute(fact, given))
		}
	}
	return out
}

/// **What the prover proposes for a loop** (ADR-361 D5, D10): its
/// candidates over the values the loop was reached with (`x@S`), an
/// equality as its two halves; `ghosts`, `x == x@S` for each name the loop
/// changes, which hold where it is reached; `fixed`, the facts it is reached
/// with restated over those values, which hold at every turn.
struct BoundsProposals {
	ghosts: Vec[i64],
	fixed: Vec[i64],
	candidates: Vec[(i64, String)],
}

fn bounding_loop_proposals(
	mut walk: BoundsWalk,
	stmt: ref Stmt,
	start: i64,
	entry: ref BoundsFacts,
	changed: ref BoundsChanged,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> BoundsProposals {
	return match stmt {
		Stmt::While { cond, body } => bounding_while_proposals(
			walk,
			start,
			cond,
			body,
			entry,
			changed,
			words,
			ask,
		),
		else => BoundsProposals { ghosts: [], fixed: [], candidates: [] },
	}
}

/// [`bounding_loop_proposals`] of `while cond { body }`: the prover's loop
/// problem stated over the walk's terms (`loop_record`), and its strategies'
/// candidates (`loop_candidates`). Only proposals: the walk checks each where
/// the loop is reached and for one turn before it uses it (D4), so a way out
/// the problem does not see costs a candidate, never a wrong proof.
fn bounding_while_proposals(
	mut walk: BoundsWalk,
	start: i64,
	cond: ref Expr,
	body: ref Block,
	entry: ref BoundsFacts,
	changed: ref BoundsChanged,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> BoundsProposals {
	let mut out = BoundsProposals { ghosts: [], fixed: [], candidates: [] }
	let mut state: Vec[String] = []
	let mut ints = entry.ints.clone()
	for name in changed.values {
		if entry.ints.contains(name) && !walk.pinned.contains(path_root(name)) {
			state.push(name.clone())
		}
	}
	// **A flag is a name of the state too** (ADR-361 D15): a `bool` the
	// body sets `true` (`flagged`) and a plain list's length the body grows,
	// so the prover's `loop_flagged` offers what held where they rose.
	let none: collections::BTreeSet[String] = collections::BTreeSet()
	// The lengths what held where the loop is reached reads are whole
	// numbers its turns read too: `if i < args.len() as i64` is a branch
	// the problem follows.
	for fact in entry.facts {
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(fact, read)
		for name in read {
			if name.ends_with(".len()") {
				ints.insert(name.clone())
			}
		}
	}
	for name in changed.values {
		if !entry.ints.contains(name)
			&& walk.flagged.contains_key(name)
			&& !name.contains(".")
			&& !walk.pinned.contains(name)
			&& !walk.shape.constants.contains_key(name) {
				state.push(name.clone())
				ints.insert(name.clone())
			}
	}
	for list in changed.lengths {
		let length = length_of(list)
		if !list.contains(".")
			&& !list.contains("#")
			&& !list.contains("[")
			&& !list.contains("(")
			&& !walk.pinned.contains(list)
			&& !state.contains(length)
			&& prover_length_follows(length, cond, body, none, words) {
				state.push(length.clone())
				ints.insert(length)
			}
	}
	if state.is_empty() {
		return out
	}
	let constants = walk.shape.constants.clone()
	let claims: collections::BTreeSet[(i64, i64)] = collections::BTreeSet()
	let record = loop_record(
		walk.arena,
		start,
		state,
		entry.facts,
		ints,
		fn(name) { constants[name] },
		cond,
		body,
		words,
		claims,
		fn(e) { bounding_no_throw(e) },
		fn(e) { bounding_no_holes(e) },
	)
		?? return out
	for name in state {
		let here = walk.arena.var(name)
		let before = walk.arena.var(loop_before_name(name, start))
		out.ghosts.push(walk.arena.equal(here, before))
	}
	for k in 0..<entry.facts.len() {
		let mut moved = false
		for name in state {
			if walk.arena.mentions(entry.facts[k], name) {
				moved = true
			}
		}
		if moved && k < record.problem.fixed.len() {
			out.fixed.push(record.problem.fixed[k])
		}
	}
	let mut asked: Vec[i64] = []
	for (candidate, origin) in loop_candidates(walk.arena, record, ask, asked) {
		match walk.arena.at(candidate) {
			logic::SolverTerm::Eq(a, b) => {
				out.candidates.push((walk.arena.le(a, b), origin.clone()))
				out.candidates.push((walk.arena.ge(a, b), origin.clone()))
			},
			else => out.candidates.push((candidate, origin.clone())),
		}
	}
	return out
}

/// The bounds walk asks no question of what a loop may throw: its
/// candidates are checked before use.
fn bounding_no_throw(e: ref Expr) -> bool sync {
	return false
}

fn bounding_no_holes(e: ref Expr) -> Vec[Expr] sync {
	return []
}

/// The condition `c` of a statement `if c { break }`.
fn bounding_break_guard(stmt: ref Stmt) -> Expr? {
	return match stmt {
		Stmt::Expr(expr) => match expr {
			Expr::If { cond, then_branch, else_branch, .. } => {
				if else_branch != null || then_branch.stmts.len() != 1 {
					return null
				}
				match then_branch.stmts[0].node {
					Stmt::Break => cond.clone(),
					else => null,
				}
			},
			else => null,
		},
		else => null,
	}
}

/// What a loop's turn may change: its body's changes, and a `while`'s
/// condition's.
fn bounding_loop_changed(
	stmt: ref Stmt,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> BoundsChanged {
	let mut changed = nothing_changed()
	match stmt {
		Stmt::For { body, .. } => {
			changed = bounding_changed(body, context, words)
		},
		Stmt::While { cond, body } => {
			changed = bounding_changed(body, context, words)
			bounding_extend(changed, bounding_changed_in_expr(cond, context, words))
		},
		else => {},
	}
	return changed
}

/// Whether `name`, a name of the walk, is one `changed` changes: a value, a
/// path of fields from one, or a length.
fn bounding_changes_name(changed: ref BoundsChanged, name: ref String) -> bool {
	for value in changed.values {
		if path_within(name, value) {
			return true
		}
	}
	for list in changed.lengths {
		if name == length_of(list) {
			return true
		}
	}
	for part in changed.parts {
		if path_within(name, part) {
			return true
		}
	}
	for value in changed.values {
		if bounding_in_elements(name, value) {
			return true
		}
	}
	for place in changed.elements {
		if bounding_element_hit(name, place, false) {
			return true
		}
	}
	return false
}

/// **An end of a turn, a `continue` or a `break`** (ADR-361 D4): each
/// candidate of the innermost loop whose invariant is being checked is asked
/// of what holds here; one that does not follow is dropped. `jump` where it
/// is a `break` or a `continue`, counted by where it stands.
fn bounding_turn_end(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	jump: bool,
	leaves: bool,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	rules_turn_end(walk, facts, ask)
	if walk.turns.is_empty() {
		return
	}
	let mut frame = walk.turns.pop() ?? return
	if jump {
		frame.jumps.insert(walk.at)
	}
	for k in 0..<frame.guesses.len() {
		if leaves && walk.leaving.contains(frame.guesses[k]) {
			continue
		}
		if !frame.failed.contains(k) && !bounding_proves(walk, facts, frame.guesses[k], ask) {
			frame.failed.insert(k)
			let at = walk.at
			bounding_turn_row(walk, at, f"  turn end: {walk.arena.text(frame.guesses[k])} not kept\n    facts: {bounding_texts(walk, facts.facts)}")
		}
	}
	walk.turns.push(frame)
}

fn bounding_proven_count(proven: ref BoundsProven) -> i64 {
	return proven.indices.len()
		+ proven.arithmetic.len()
		+ proven.nonnegative.len()
		+ proven.negations.len()
}

/// `while cond { body }`, with the counters `cands` taken to only grow.
fn bounding_while(
	mut walk: BoundsWalk,
	cond: ref Expr,
	body: ref Block,
	changed: ref BoundsChanged,
	cands: ref Vec[String],
	mut facts: BoundsFacts,
	invariant: ref Vec[i64],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	// **A `while` counts its turns by a name each grows by exactly one**
	// (ADR-361 D13): `t` is `i - i@`, and its other counters lie within
	// their steps times `t`, at the head of each turn (not past a `break`).
	let outside = bounding_changed_in_expr(cond, context, words).values
	let mut pairs: Vec[(String, String)] = []
	let steps = bounding_turn_steps(walk, body, outside, changed, facts, context, words, ask, pairs)
	let mut turn_facts: Vec[i64] = []
	let mut step: Vec[(String, i64, i64, i64?)] = []
	let mut others: Vec[(String, i64, i64, i64?)] = []
	// Of the counters that grow by exactly one, the one the condition
	// compares counts the turns, so that it is bounded by the condition's
	// end (#1391: `while j < hi { i = i + 1; j = j + 1 }`).
	let compared = bounding_compared(cond, words)
	let mut counter = String()
	for (name, low, high, floor) in steps {
		if low == 1 && high == 1 && floor == null && (counter.is_empty() || name == compared) {
			counter = name.clone()
		}
	}
	for (name, low, high, floor) in steps {
		if step.is_empty() && name == counter {
			step.push((name.clone(), low, high, floor))
		} else {
			others.push((name.clone(), low, high, floor))
		}
	}
	let mut head_facts: Vec[i64] = []
	if !step.is_empty() {
		let below = bounding_counter_below(walk, cond, step[0].0, changed, facts, context, program, words, ask)
		if below != null {
			head_facts.push(below ?? 0)
		}
	}
	// **A name each turn scales, in a loop of at most `k` turns** (#1644):
	// within constants, at each head and past the loop. A loop that only
	// adds is asked only where its bound is a constant: D13 bounds it
	// inside by its turns.
	let scales = bounding_turn_scales(walk, body, outside, changed, facts, context, words)
	if !scales.is_empty() {
		let multiplies = scales.iter().any(fn(s) { s.1 > 1 })
		let most = bounding_turns_most(walk, cond, steps, changed, facts, !multiplies, context, program, words, ask)
		for fact in bounding_scaled_bounds(walk, facts, scales, most, ask) {
			head_facts.push(fact)
		}
	}
	if !step.is_empty() && !others.is_empty() {
		let t = walk.arena.var(f"#turn{walk.entries}")
		walk.entries += 1
		let zero = walk.arena.int(0)
		turn_facts.push(walk.arena.ge(t, zero))
		for fact in bounding_turn_bounds(walk, facts, step, t) {
			turn_facts.push(fact)
		}
		for fact in bounding_turn_bounds(walk, facts, others, t) {
			turn_facts.push(fact)
		}
	}
	for fact in bounding_pair_bounds(walk, facts, pairs, counter) {
		turn_facts.push(fact)
	}
	let kept = rules_loop_entry(walk, facts, changed, ask)
	bounding_loop_change(walk, facts, changed, cands)
	rules_loop_give(walk, facts, kept, changed)
	for fact in invariant {
		bounding_push(walk, facts, fact)
	}
	for fact in head_facts {
		bounding_push(walk, facts, fact)
	}
	bounding_expr(walk, cond, facts, context, program, words, ask)
	let mut inner = facts.clone()
	bounding_assume(walk, inner, cond, context, program, words)
	for fact in turn_facts {
		bounding_push(walk, inner, fact)
	}
	walk.rule_loops.push(kept)
	if !bounding_block(walk, body, inner, context, program, words, ask) {
		bounding_turn_end(walk, inner, false, false, ask)
	}
	walk.rule_loops.pop()
	// **Past a loop no `break` leaves, its turn's facts hold too**: it is
	// left only at a head, by the condition (ADR-306 D23, D25: two lists a
	// turn grows by fixed steps keep their lengths' relation).
	if !breaks(body, words) {
		bounding_assume_not(walk, facts, cond, context, program, words)
		for fact in turn_facts {
			bounding_push(walk, facts, fact)
		}
	}
}

/// The name `while x < e` compares, or nothing.
fn bounding_compared(cond: ref Expr, words: ref winnow_grammar::InternerContext) -> String {
	match cond {
		Expr::Binary { op, lhs, rhs, .. } => {
			if op == BinaryOp::Lt {
				return path_of(lhs, words) ?? ""
			}
			// A conjunct compares as the whole would (#1557): the body
			// runs only where each holds.
			if op == BinaryOp::And {
				let left = bounding_compared(lhs, words)
				if !left.is_empty() {
					return left
				}
				return bounding_compared(rhs, words)
			}
			return ""
		},
		else => return "",
	}
}

/// **`while x < e`, `x` the counter each turn grows by exactly one**
/// (ADR-361 D13): `x <= e` at each head, where it holds where the loop is
/// reached and the loop changes nothing `e` reads; each turn starts with
/// `x < e` and adds one. Past the loop, with the condition false, `x == e`.
/// `x < e` may be one conjunct of an `&&` (#1557: `while i < n && cs[i] !=
/// ' '`): each turn starts with every conjunct true, so with `x < e` too.
fn bounding_counter_below(
	mut walk: BoundsWalk,
	cond: ref Expr,
	x: ref String,
	changed: ref BoundsChanged,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> i64? {
	match cond {
		Expr::Binary { op, lhs, rhs, .. } => {
			if op == BinaryOp::And {
				let left = bounding_counter_below(walk, lhs, x, changed, facts, context, program, words, ask)
				if left != null {
					return left
				}
				return bounding_counter_below(walk, rhs, x, changed, facts, context, program, words, ask)
			}
			if op != BinaryOp::Lt || (path_of(lhs, words) ?? "") != x || !bounding_unchanged_end(rhs, changed, words) {
				return null
			}
			let end = bounding_lin(walk, rhs, facts, context, program, words) ?? return null
			let now = walk.arena.var(x)
			let below = walk.arena.le(now, end)
			if !bounding_proves(walk, facts, below, ask) {
				return null
			}
			return below
		},
		else => return null,
	}
}

/// Whether `end` is a name or a list's length a loop that changed `changed`
/// leaves as it is, converted or not (#1557: `cs.len() as i64`).
fn bounding_unchanged_end(end: ref Expr, changed: ref BoundsChanged, words: ref winnow_grammar::InternerContext) -> bool {
	let named = path_of(end, words)
	if named != null {
		return !bounding_changes_name(changed, named ?? "")
	}
	match end {
		Expr::Cast { expr, .. } => return bounding_unchanged_end(expr, changed, words),
		Expr::MethodCall { receiver, method, args, .. } => {
			if !args.is_empty() || words.resolve(method) != "len" {
				return false
			}
			let list = path_of(receiver, words) ?? return false
			return !bounding_changes_name(changed, length_of(list))
		},
		else => return false,
	}
}

/// **The counters a loop may take to only grow** (#711): changed in it only
/// by assignments that add to them - `i += k`, `i = i + k` - with nothing
/// they are part of changed, and not pinned. Whether each addition is not
/// negative is proved where it stands.
fn bounding_candidates(
	walk: ref BoundsWalk,
	changed: ref BoundsChanged,
	facts: ref BoundsFacts,
) -> Vec[String] {
	let mut out: Vec[String] = []
	for x in changed.values {
		if (changed.jumps.contains(x) && changed.drops.contains(x))
			|| walk.pinned.contains(path_root(x)) {
				continue
			}
		if !facts.ints.contains(x) && !x.contains(".") {
			continue
		}
		let mut inside = false
		for v in changed.values {
			if v != x && path_within(x, v) {
				inside = true
			}
		}
		for v in changed.parts {
			if path_within(x, v) {
				inside = true
			}
		}
		if !inside {
			out.push(x.clone())
		}
	}
	return out
}

/// `cands` taken to grow while their loop is walked, those of `falls` to
/// fall: those no loop around it takes already, which this loop answers for.
fn bounding_grow(
	mut walk: BoundsWalk,
	cands: ref Vec[String],
	falls: ref Vec[String],
) -> Vec[String] {
	let mut added: Vec[String] = []
	for c in cands {
		if walk.growing.contains(c) || walk.falling.contains(c) {
			continue
		}
		if falls.contains(c) {
			walk.falling.insert(c.clone())
			walk.fall_failed.remove(c)
		} else {
			walk.growing.insert(c.clone())
			walk.grow_failed.remove(c)
		}
		added.push(c.clone())
	}
	return added
}

/// The loop is walked: the counters it took to grow that did not, and those
/// it took to fall that did not.
fn bounding_grew(
	mut walk: BoundsWalk,
	cands: ref Vec[String],
	added: ref Vec[String],
) -> Vec[String] {
	let mut failed: Vec[String] = []
	for c in cands {
		if walk.falling.contains(c) {
			if walk.fall_failed.contains(c) {
				failed.push(c.clone())
			}
		} else if walk.grow_failed.contains(c) {
			failed.push(c.clone())
		}
	}
	for c in added {
		walk.growing.remove(c)
		walk.falling.remove(c)
	}
	return failed
}

/// `cands` without `failed`.
fn bounding_without(cands: ref Vec[String], failed: ref Vec[String]) -> Vec[String] {
	let mut kept: Vec[String] = []
	for c in cands {
		if !failed.contains(c) {
			kept.push(c.clone())
		}
	}
	return kept
}

/// Of `cands`, those `changed` changes only by taking from them (#1329).
fn bounding_falls(changed: ref BoundsChanged, cands: ref Vec[String]) -> Vec[String] {
	let mut out: Vec[String] = []
	for c in cands {
		if changed.jumps.contains(c) {
			out.push(c.clone())
		}
	}
	return out
}

/// **What holds again at a loop's start** (`bounding_after_change`), and of
/// each counter in `cands` that it is at least what it was when the loop
/// began (at most, for one taken to fall, #1329): what was known of it then
/// is kept about that value.
fn bounding_loop_change(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	changed: ref BoundsChanged,
	cands: ref Vec[String],
) {
	let mut entries: Vec[(String, String)] = []
	for x in cands {
		let entry = f"{x}#{walk.entries}"
		walk.entries += 1
		let e = walk.arena.var(entry)
		let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
		given.insert(x.clone(), e)
		for mut fact in facts.facts {
			if walk.arena.mentions(fact, x) {
				fact = walk.arena.substitute(fact, given)
			}
		}
		entries.push((x.clone(), entry))
	}
	bounding_after_change(walk, facts, changed)
	for (x, entry) in entries {
		let now = walk.arena.var(x)
		let then = walk.arena.var(entry)
		let fact = if walk.falling.contains(x) { walk.arena.le(now, then) } else {
			walk.arena.ge(now, then)
		}
		bounding_push(walk, facts, fact)
	}
}

/// Whether `name = value` or `name op= value` adds to `name`.
fn bounding_steps_up(
	name: ref String,
	op: ref BinaryOp?,
	value: ref Expr,
	words: ref winnow_grammar::InternerContext,
) -> bool {
	if op != null {
		return bounding_is_op(op, BinaryOp::Add)
	}
	return match value {
		Expr::Binary { op: added, lhs, rhs, .. } => added == BinaryOp::Add
			&& ((path_of(lhs, words) ?? "") == name || (path_of(rhs, words) ?? "") == name),
		// **A call handed the name, or the name added to** (ADR-306 D31):
		// `i = skip(cs, i + 1)` may raise it; the walk proves it does from
		// what the callee is found to hold of that argument.
		Expr::Call { args, .. } => args.iter().any(fn(arg) {
			(path_of(arg, words) ?? "") == name || bounding_steps_up(name, null, arg, words)
		}),
		else => false,
	}
}

/// Whether `name = value` or `name op= value` takes from `name` (#1329):
/// `n -= d`, `n = n - d`, or may, set to another name (`i = parent`,
/// #1631), which the walk proves is not above it.
fn bounding_steps_down(
	name: ref String,
	op: ref BinaryOp?,
	value: ref Expr,
	words: ref winnow_grammar::InternerContext,
) -> bool {
	if op != null {
		return bounding_is_op(op, BinaryOp::Sub)
	}
	return match value {
		Expr::Binary { op: taken, lhs, .. } => taken == BinaryOp::Sub
			&& (path_of(lhs, words) ?? "") == name,
		Expr::Variable(other, _) => words.resolve(other) != name,
		else => false,
	}
}

/// **What one turn adds to each name it changes only by constants**
/// (ADR-361 D13): `names[k]` grows by at least `low[k]` and at most
/// `high[k]` along every path from the head of a turn to its end; `live`
/// where a path still runs. `gap_low[a * n + b]` and `gap_high[a * n +
/// b]`, `n` the number of names, are the least and the most `names[a]`
/// grows by beyond `names[b]` along one path (#1634): what makes the
/// relation between two counters an induction too.
struct BoundsSteps {
	names: Vec[String],
	low: Vec[i64],
	high: Vec[i64],
	gap_low: Vec[i64],
	gap_high: Vec[i64],
	live: bool,
}

/// `state.names[k]` grows by `by` along the path: its sums, and its gap to
/// each other name.
fn bounding_steps_add(mut state: BoundsSteps, k: i64, by: i64) {
	state.low[k] += by
	state.high[k] += by
	let n = state.names.len()
	for j in 0..<n {
		if j != k {
			state.gap_low[k * n + j] += by
			state.gap_high[k * n + j] += by
			state.gap_low[j * n + k] -= by
			state.gap_high[j * n + k] -= by
		}
	}
}

/// `a` and `b` joined: the paths of either.
fn bounding_steps_join(mut a: BoundsSteps, b: ref BoundsSteps) {
	if !b.live {
		return
	}
	if !a.live {
		a.low = b.low.clone()
		a.high = b.high.clone()
		a.gap_low = b.gap_low.clone()
		a.gap_high = b.gap_high.clone()
		a.live = true
		return
	}
	for k in 0..<a.names.len() {
		if b.low[k] < a.low[k] {
			a.low[k] = b.low[k]
		}
		if b.high[k] > a.high[k] {
			a.high[k] = b.high[k]
		}
	}
	for k in 0..<a.gap_low.len() {
		if b.gap_low[k] < a.gap_low[k] {
			a.gap_low[k] = b.gap_low[k]
		}
		if b.gap_high[k] > a.gap_high[k] {
			a.gap_high[k] = b.gap_high[k]
		}
	}
}

/// **The counters of a turn** (ADR-361 D13): each whole-number name of
/// `changed` the body changes only by adding or taking constants - `n += 2`,
/// `n = n - 1` - with `(name, low, high)`, the least and the most one turn
/// adds along any path to a turn's end, its fall-through end or a
/// `continue`; only those of one sign. A name changed any other way, in an
/// inner loop, a lambda, by a call, bound again in the body, or one of
/// `outside` (the loop's bindings, what a `while`'s condition changes) is
/// none. With the head of a turn the base, these sums are the step of the
/// induction: `low * t <= n - n@ <= high * t` holds at each head, `t` the
/// turns ended before it.
///
/// **A counter set back to a constant** (`column = 0`, #1516) is one too
/// where the body adds to it only, and every constant it is set to lies at
/// or below its value where the loop is reached: a turn that sets it back
/// ends at most its adds since above that value, so `n - n@ <= high * t`
/// still holds, and `n` stays at or above the least constant (the fourth
/// part, its `low` 0).
///
/// **Two counters a turn raises together** (#1634, ADR-361 D5 item 2's
/// octagons): `(n, m)` goes into `pairs` where both only grow, neither is
/// set back, and no path of a turn raises `n` more than `m`; then `n - n@
/// <= m - m@` holds at each head by the same induction, whether or not
/// anything counts the turns (`while a < cap { if c { a += 1; b += 1 } }`).
fn bounding_turn_steps(
	mut walk: BoundsWalk,
	body: ref Block,
	outside: ref collections::BTreeSet[String],
	changed: ref BoundsChanged,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
	mut pairs: Vec[(String, String)],
) -> Vec[(String, i64, i64, i64?)] {
	let mut start = BoundsSteps { names: [], low: [], high: [], gap_low: [], gap_high: [], live: true }
	for x in changed.values {
		if walk.pinned.contains(path_root(x)) || outside.contains(x) || !facts.ints.contains(x) {
			continue
		}
		let mut inside = false
		for v in changed.values {
			if v != x && path_within(x, v) {
				inside = true
			}
		}
		for v in changed.parts {
			if path_within(x, v) {
				inside = true
			}
		}
		for place in changed.elements {
			if bounding_element_hit(x, place, false) {
				inside = true
			}
		}
		if !inside {
			start.names.push(x.clone())
			start.low.push(0)
			start.high.push(0)
		}
	}
	// **A list's length a turn only pushes to** is a counter as well
	// (ADR-306 D23, D25): `xs.push(v)` adds one to `xs.len()`.
	for list in changed.lengths {
		let x = length_of(list)
		if walk.pinned.contains(path_root(list)) || changed.falls.contains(list) || outside.contains(list) {
			continue
		}
		let mut inside = false
		for v in changed.values {
			if path_within(list, v) {
				inside = true
			}
		}
		for v in changed.parts {
			if v != list && path_within(list, v) {
				inside = true
			}
		}
		for place in changed.elements {
			if bounding_element_hit(list, place, false) {
				inside = true
			}
		}
		if !inside {
			start.names.push(x)
			start.low.push(0)
			start.high.push(0)
		}
	}
	if start.names.is_empty() {
		return []
	}
	for _ in 0..<(start.names.len() * start.names.len()) {
		start.gap_low.push(0)
		start.gap_high.push(0)
	}
	let mut ends = BoundsSteps {
		names: start.names.clone(),
		low: start.low.clone(),
		high: start.high.clone(),
		gap_low: start.gap_low.clone(),
		gap_high: start.gap_high.clone(),
		live: false,
	}
	let mut bad: collections::BTreeSet[String] = collections::BTreeSet()
	let mut resets: collections::BTreeMap[String, (i64, i64)] = collections::BTreeMap()
	bounding_steps_block(body, start, ends, bad, resets, context, words)
	bounding_steps_join(ends, start)
	let mut out: Vec[(String, i64, i64, i64?)] = []
	if !ends.live {
		return out
	}
	for k in 0..<ends.names.len() {
		let name = ends.names[k].clone()
		if bad.contains(name)
			|| (ends.low[k] < 0 && ends.high[k] > 0)
			|| (ends.low[k] == 0 && ends.high[k] == 0) {
				continue
			}
		if !resets.contains_key(name) {
			out.push((name, ends.low[k], ends.high[k], null))
			continue
		}
		let (least, most) = resets.get(name) ?? (0, 0)
		if ends.low[k] < 0 || ends.high[k] <= 0 {
			continue
		}
		let now = walk.arena.var(name)
		let top = walk.arena.int(most)
		let under = walk.arena.le(top, now)
		if bounding_proves(walk, facts, under, ask) {
			out.push((name, 0, ends.high[k], least))
		}
	}
	let n = ends.names.len()
	for a in 0..<n {
		for b in 0..<n {
			if a != b
				&& ends.gap_high[a * n + b] <= 0
				&& bounding_steps_rising(out, ends.names[a])
				&& bounding_steps_rising(out, ends.names[b]) {
					pairs.push((ends.names[a].clone(), ends.names[b].clone()))
				}
		}
	}
	return out
}

/// Whether `name` is one of the counters `steps` found that only grows and
/// is never set back.
fn bounding_steps_rising(steps: ref Vec[(String, i64, i64, i64?)], name: ref String) -> bool {
	for (each, low, high, floor) in steps {
		if each == name {
			return floor == null && low >= 0 && high > 0
		}
	}
	return false
}

fn bounding_steps_block(
	block: ref Block,
	mut state: BoundsSteps,
	mut ends: BoundsSteps,
	mut bad: collections::BTreeSet[String],
	mut resets: collections::BTreeMap[String, (i64, i64)],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	for each in block.stmts {
		if !state.live {
			return
		}
		match each.node {
			Stmt::Let { names, .. } => {
				bounding_steps_other(each, state, ends, bad, context, words)
				for name in names {
					bad.insert(words.resolve(name).clone())
				}
			},
			Stmt::Comptime { name, .. } => {
				bounding_steps_other(each, state, ends, bad, context, words)
				bad.insert(words.resolve(name).clone())
			},
			Stmt::Assign { target, op, value } => {
				let place = path_of(target, words) ?? ""
				let by = bounding_step_by(place, op, value, words)
				let mut k = 0
				while k < state.names.len() && state.names[k] != place {
					k += 1
				}
				let back = bounding_step_literal(value)
				if by != null && k < state.names.len() {
					bounding_steps_add(state, k, by ?? 0)
				} else if op == null && back != null && k < state.names.len() {
					// Set back to a constant: what the turn adds counts
					// from here (`bounding_turn_steps`).
					let c = back ?? 0
					state.low[k] = 0
					state.high[k] = 0
					let (least, most) = resets.get(place) ?? (c, c)
					resets.insert(place.clone(), (least.min(c), most.max(c)))
				} else {
					bounding_steps_other(each, state, ends, bad, context, words)
				}
			},
			Stmt::Return(value) => {
				bounding_steps_other(each, state, ends, bad, context, words)
				state.live = false
			},
			Stmt::Break => {
				state.live = false
			},
			Stmt::Continue => {
				bounding_steps_join(ends, state)
				state.live = false
			},
			Stmt::Expr(expr) => match expr {
				Expr::If { cond, then_branch, else_branch, .. } => {
					bounding_steps_cond(
						each,
						cond,
						then_branch,
						else_branch,
						state,
						ends,
						bad,
						context,
						words,
					)
					let mut other = BoundsSteps {
						names: state.names.clone(),
						low: state.low.clone(),
						high: state.high.clone(),
						gap_low: state.gap_low.clone(),
						gap_high: state.gap_high.clone(),
						live: state.live,
					}
					bounding_steps_block(then_branch, state, ends, bad, resets, context, words)
					bounding_steps_maybe(else_branch, other, ends, bad, resets, context, words)
					bounding_steps_join(state, other)
				},
				Expr::MethodCall { receiver, method, args, .. } => {
					if !bounding_steps_push(each, receiver, method, args, state, bad, context, words) {
						bounding_steps_other(each, state, ends, bad, context, words)
					}
				},
				else => bounding_steps_other(each, state, ends, bad, context, words),
			},
			else => bounding_steps_other(each, state, ends, bad, context, words),
		}
	}
}

/// **`xs.push(v)` of a list a turn counts** (ADR-306 D23): one more for
/// `xs.len()`, and what `v` changes is no counter. False where the
/// statement is no such push: a jump in `v` may end the turn before it.
fn bounding_steps_push(
	each: ref Spanned[Stmt],
	receiver: ref Expr,
	method: winnow_grammar::Symbol,
	args: ref Vec[Expr],
	mut state: BoundsSteps,
	mut bad: collections::BTreeSet[String],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> bool {
	if words.resolve(method) != "push" || args.len() != 1 {
		return false
	}
	let list = path_of(receiver, words) ?? return false
	let x = length_of(list)
	let mut k = 0
	while k < state.names.len() && state.names[k] != x {
		k += 1
	}
	let one = Block { stmts: [each.clone()] }
	if k >= state.names.len() || turn_jumps(one, words) > 0 {
		return false
	}
	let changed = bounding_changed_in_expr(args[0], context, words)
	for name in state.names {
		if bounding_changes_name(changed, name) {
			bad.insert(name.clone())
		}
	}
	for name in assigned_in_expr(args[0], words) {
		bad.insert(name.clone())
	}
	bounding_steps_add(state, k, 1)
	return true
}

fn bounding_steps_maybe(
	block: ref Block?,
	mut state: BoundsSteps,
	mut ends: BoundsSteps,
	mut bad: collections::BTreeSet[String],
	mut resets: collections::BTreeMap[String, (i64, i64)],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	let present = block ?? return
	bounding_steps_block(present, state, ends, bad, resets, context, words)
}

fn bounding_maybe_jumps(block: ref Block?, words: ref winnow_grammar::InternerContext) -> i64 {
	let present = block ?? return 0
	return turn_jumps(present, words)
}

/// An `if`'s condition: what it changes is no counter, and a `break` or
/// `continue` in it - one the statement has beyond its branches' - may end
/// the turn here.
fn bounding_steps_cond(
	each: ref Spanned[Stmt],
	cond: ref Expr,
	then_branch: ref Block,
	else_branch: ref Block?,
	mut state: BoundsSteps,
	mut ends: BoundsSteps,
	mut bad: collections::BTreeSet[String],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	let changed = bounding_changed_in_expr(cond, context, words)
	for name in state.names {
		if bounding_changes_name(changed, name) {
			bad.insert(name.clone())
		}
	}
	for name in assigned_in_expr(cond, words) {
		bad.insert(name.clone())
	}
	let one = Block { stmts: [each.clone()] }
	if turn_jumps(one, words)
		> turn_jumps(then_branch, words) + bounding_maybe_jumps(else_branch, words) {
			bounding_steps_join(ends, state)
		}
}

/// **Any other statement of a turn**: a name it changes, at any depth, is no
/// counter; a `break` or `continue` of this loop in it may end the turn
/// with the sums of here (an inner loop's own are its own).
fn bounding_steps_other(
	each: ref Spanned[Stmt],
	mut state: BoundsSteps,
	mut ends: BoundsSteps,
	mut bad: collections::BTreeSet[String],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	let one = Block { stmts: [each.clone()] }
	let changed = bounding_changed(one, context, words)
	for name in state.names {
		if bounding_changes_name(changed, name) {
			bad.insert(name.clone())
		}
	}
	for name in assigned_in_statement(each.node, words) {
		bad.insert(name.clone())
	}
	if turn_jumps(one, words) > 0 {
		bounding_steps_join(ends, state)
	}
}

/// What `name op= value` or `name = value` adds to `name`, where that is a
/// constant: `n += 2` is 2, `n = n - 1` is -1.
fn bounding_step_by(
	name: ref String,
	op: ref BinaryOp?,
	value: ref Expr,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	if name == "" {
		return null
	}
	if op != null {
		let by = bounding_step_literal(value) ?? return null
		if bounding_is_op(op, BinaryOp::Add) {
			return by
		}
		if bounding_is_op(op, BinaryOp::Sub) {
			return 0 - by
		}
		return null
	}
	return match value {
		Expr::Binary { op: added, lhs, rhs, .. } => {
			let left = (path_of(lhs, words) ?? "") == name
			let right = (path_of(rhs, words) ?? "") == name
			if added == BinaryOp::Add && left {
				return bounding_step_literal(rhs)
			}
			if added == BinaryOp::Add && right {
				return bounding_step_literal(lhs)
			}
			if added == BinaryOp::Sub && left {
				let by = bounding_step_literal(rhs) ?? return null
				return 0 - by
			}
			null
		},
		else => null,
	}
}

/// A whole-number literal small enough to be a turn's step.
fn bounding_step_literal(expr: ref Expr) -> i64? {
	return match expr {
		Expr::LitInt { value, negative, .. } => {
			if value > 1048576 {
				return null
			}
			if negative {
				return 0 - (value as i64)
			}
			value as i64
		},
		else => null,
	}
}

/// **A loop's counters bounded by its turns** (ADR-361 D13): for each of
/// `steps`, a name for the value it had where the loop was reached, what
/// held of that value pushed onto `facts` (the facts the loop is reached
/// with, before its changes are taken away), and the facts to assume at
/// each head of a turn, `low * t <= n - n@ <= high * t` (for a counter set
/// back, `n` at or above its least constant in place of the first).
fn bounding_turn_bounds(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	steps: ref Vec[(String, i64, i64, i64?)],
	turns: i64,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	for (name, low, high, floor) in steps {
		let e = bounding_entry_value(walk, facts, name)
		let now = walk.arena.var(name)
		let moved = walk.arena.sub(now, e)
		let least = walk.arena.int(low)
		let most = walk.arena.int(high)
		let ceiling = walk.arena.mul(most, turns)
		if floor != null {
			// A counter set back: at or above the least constant.
			let back = walk.arena.int(floor ?? 0)
			out.push(walk.arena.ge(now, back))
		} else {
			let lowest = walk.arena.mul(least, turns)
			out.push(walk.arena.ge(moved, lowest))
		}
		out.push(walk.arena.le(moved, ceiling))
	}
	return out
}

/// **A name for the value `name` has where a loop is reached**, handed
/// back as a term; what held of that value is pushed onto `facts` (the
/// facts the loop is reached with, before its changes are taken away). A
/// length's copy is named outside the list's path: what the loop changes
/// of the list does not take it away.
fn bounding_entry_value(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String) -> i64 {
	let entry = if name.ends_with(".len()") { f"#{walk.entries}:{name}" } else {
		f"{name}#{walk.entries}"
	}
	walk.entries += 1
	let e = walk.arena.var(entry)
	let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
	given.insert(name.clone(), e)
	let mut copies: Vec[i64] = []
	for fact in facts.facts {
		if walk.arena.mentions(fact, name) {
			copies.push(walk.arena.substitute(fact, given))
		}
	}
	for copy in copies {
		bounding_push(walk, facts, copy)
	}
	return e
}

/// **The relations of `pairs` at each head of a turn** (#1634): `n - n@
/// <= m - m@` for each `(n, m)`, with fresh names for the values where the
/// loop is reached (`bounding_entry_value`); none that reads `skip`, the
/// name that counts the turns, whose own facts already say it. At most
/// eight, so a loop of many counters does not swell the facts.
fn bounding_pair_bounds(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	pairs: ref Vec[(String, String)],
	skip: ref String,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	let mut entered: collections::BTreeMap[String, i64] = collections::BTreeMap()
	for (n, m) in pairs {
		if out.len() >= 8 || n == skip || m == skip {
			continue
		}
		if !entered.contains_key(n) {
			let e = bounding_entry_value(walk, facts, n)
			entered.insert(n.clone(), e)
		}
		if !entered.contains_key(m) {
			let e = bounding_entry_value(walk, facts, m)
			entered.insert(m.clone(), e)
		}
		let n_then = entered.get(n) ?? continue
		let m_then = entered.get(m) ?? continue
		let n_now = walk.arena.var(n)
		let m_now = walk.arena.var(m)
		let n_moved = walk.arena.sub(n_now, n_then)
		let m_moved = walk.arena.sub(m_now, m_then)
		out.push(walk.arena.le(n_moved, m_moved))
	}
	return out
}

/// **The most turns a `while` takes, as a constant** (#1644, ADR-361 D13):
/// of each part of its condition `&&` joins, `x < e` or `x <= e` with `x` a
/// counter of `steps` each turn raises by at least `low` (`x > e`, `x >= e`
/// for one each turn lowers), and `e` a term the loop leaves as it is. A turn
/// starts only while `x` has not reached `e`, so no more turns start than
/// the steps from `x` to `e` where the loop is reached; the most of those
/// there bounds them all. Where `constant_only`, an `e` that is no constant
/// is not asked. Nothing where no part gives a bound.
fn bounding_turns_most(
	mut walk: BoundsWalk,
	cond: ref Expr,
	steps: ref Vec[(String, i64, i64, i64?)],
	changed: ref BoundsChanged,
	facts: ref BoundsFacts,
	constant_only: bool,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> i64? {
	match cond {
		Expr::Binary { op, lhs, rhs, .. } => {
			if op == BinaryOp::And {
				let left = bounding_turns_most(walk, lhs, steps, changed, facts, constant_only, context, program, words, ask)
				let right = bounding_turns_most(walk, rhs, steps, changed, facts, constant_only, context, program, words, ask)
				if left == null {
					return right
				}
				if right == null {
					return left
				}
				return (left ?? 0).min(right ?? 0)
			}
			let x = path_of(lhs, words) ?? return null
			let rising = op == BinaryOp::Lt || op == BinaryOp::Le
			let falling = op == BinaryOp::Gt || op == BinaryOp::Ge
			let mut by = 0
			for (name, low, high, floor) in steps {
				if name == x && floor == null {
					if rising && low >= 1 {
						by = low
					}
					if falling && high <= -1 {
						by = 0 - high
					}
				}
			}
			if by == 0 {
				return null
			}
			let end = bounding_lin(walk, rhs, facts, context, program, words) ?? return null
			if (constant_only && walk.arena.constant(end) == null) || !bounding_stable(walk, end, changed, x) {
				return null
			}
			let now = walk.arena.var(x)
			let mut gap = if rising { walk.arena.sub(end, now) } else { walk.arena.sub(now, end) }
			if op == BinaryOp::Le || op == BinaryOp::Ge {
				let one = walk.arena.int(1)
				gap = walk.arena.add(gap, one)
			}
			let most = bounding_term(walk, gap, facts, ask).hi ?? return null
			if most <= 0 {
				return 0
			}
			return (most + by - 1) / by
		},
		else => return null,
	}
}

/// **The most turns `for x in low..<high` takes, as a constant** (#1644):
/// the most of its span where the loop is reached, where neither end reads
/// what the body changes. Where `constant_only`, a span that is no constant
/// is not asked.
fn bounding_for_turns_most(
	mut walk: BoundsWalk,
	low: i64?,
	high: i64?,
	closed: bool,
	changed: ref BoundsChanged,
	name: ref String,
	facts: ref BoundsFacts,
	constant_only: bool,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> i64? {
	let l = low ?? return null
	let h = high ?? return null
	if !bounding_stable(walk, l, changed, name) || !bounding_stable(walk, h, changed, name) {
		return null
	}
	let mut span = walk.arena.sub(h, l)
	if closed {
		let one = walk.arena.int(1)
		span = walk.arena.add(span, one)
	}
	if constant_only && walk.arena.constant(span) == null {
		return null
	}
	let most = bounding_term(walk, span, facts, ask).hi ?? return null
	return most.max(0)
}

/// What each name of `names` is, as `a * v + b` of `v` its value at the head
/// of a turn, along the paths walked so far.
struct BoundsScales {
	names: Vec[String],
	a: Vec[i64],
	b: Vec[i64],
}

/// **The names a turn scales** (#1644): each whole-number name of `changed`
/// the body changes only by `v = c * v + d`, `v *= c`, `v += d` and the like,
/// `c >= 1` and `d >= 0` constants, as `(name, a, b)`: on any path of a turn
/// it ends at most `a * v + b`, `v` its value at the head, and where `v >= 0`
/// at no less than `v`. Paths join to the larger `a` and `b`, which bound
/// each path's end where `v >= 0`, every such map lying at or above `v`; a
/// path a `continue` or `break` cuts short ends below where it would. A name
/// changed any other way, also in an `if`'s condition, an inner loop or by a
/// call, or bound again in the body, is none; so is one the turn leaves as
/// it is.
fn bounding_turn_scales(
	walk: ref BoundsWalk,
	body: ref Block,
	outside: ref collections::BTreeSet[String],
	changed: ref BoundsChanged,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> Vec[(String, i64, i64)] {
	let mut state = BoundsScales { names: [], a: [], b: [] }
	for x in changed.values {
		if walk.pinned.contains(path_root(x)) || outside.contains(x) || !facts.ints.contains(x) || x.contains(".") {
			continue
		}
		state.names.push(x.clone())
		state.a.push(1)
		state.b.push(0)
	}
	if state.names.is_empty() {
		return []
	}
	let mut bad: collections::BTreeSet[String] = collections::BTreeSet()
	bounding_scales_block(body, state, bad, context, words)
	let mut out: Vec[(String, i64, i64)] = []
	for k in 0..<state.names.len() {
		if !bad.contains(state.names[k]) && (state.a[k] > 1 || state.b[k] > 0) {
			out.push((state.names[k].clone(), state.a[k], state.b[k]))
		}
	}
	return out
}

fn bounding_scales_block(
	block: ref Block,
	mut state: BoundsScales,
	mut bad: collections::BTreeSet[String],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	for each in block.stmts {
		match each.node {
			Stmt::Let { names, .. } => {
				bounding_scales_other(each, state, bad, context, words)
				for name in names {
					bad.insert(words.resolve(name).clone())
				}
			},
			Stmt::Comptime { name, .. } => {
				bounding_scales_other(each, state, bad, context, words)
				bad.insert(words.resolve(name).clone())
			},
			Stmt::Assign { target, op, value } => {
				let place = path_of(target, words) ?? ""
				let mut k = 0
				while k < state.names.len() && state.names[k] != place {
					k += 1
				}
				let map = bounding_scale_by(place, op, value, words)
				if k < state.names.len() && map != null {
					let (a, b) = map ?? (1, 0)
					if state.a[k] > 1048576 || state.b[k] > 1048576 {
						bad.insert(place.clone())
					} else {
						// This change after those before it on the path.
						state.a[k] = a * state.a[k]
						state.b[k] = a * state.b[k] + b
					}
				} else {
					bounding_scales_other(each, state, bad, context, words)
				}
			},
			Stmt::Expr(expr) => match expr {
				Expr::If { cond, then_branch, else_branch, .. } => {
					let changed = bounding_changed_in_expr(cond, context, words)
					for name in state.names {
						if bounding_changes_name(changed, name) {
							bad.insert(name.clone())
						}
					}
					for name in assigned_in_expr(cond, words) {
						bad.insert(name.clone())
					}
					let mut other = BoundsScales { names: state.names.clone(), a: state.a.clone(), b: state.b.clone() }
					bounding_scales_block(then_branch, state, bad, context, words)
					if else_branch != null {
						bounding_scales_maybe(else_branch, other, bad, context, words)
					}
					for k in 0..<state.names.len() {
						state.a[k] = state.a[k].max(other.a[k])
						state.b[k] = state.b[k].max(other.b[k])
					}
				},
				else => bounding_scales_other(each, state, bad, context, words),
			},
			else => bounding_scales_other(each, state, bad, context, words),
		}
	}
}

fn bounding_scales_maybe(
	block: ref Block?,
	mut state: BoundsScales,
	mut bad: collections::BTreeSet[String],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	let present = block ?? return
	bounding_scales_block(present, state, bad, context, words)
}

/// Any other statement of a turn: a name it changes, at any depth, is scaled
/// by no map the walk knows.
fn bounding_scales_other(
	each: ref Spanned[Stmt],
	state: ref BoundsScales,
	mut bad: collections::BTreeSet[String],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	let one = Block { stmts: [each.clone()] }
	let changed = bounding_changed(one, context, words)
	for name in state.names {
		if bounding_changes_name(changed, name) {
			bad.insert(name.clone())
		}
	}
	for name in assigned_in_statement(each.node, words) {
		bad.insert(name.clone())
	}
}

/// What `name op= value` or `name = value` makes of `name`, as `(a, b)` of
/// `a * name + b`, where both are constants, `a >= 1` and `b >= 0`.
fn bounding_scale_by(
	name: ref String,
	op: ref BinaryOp?,
	value: ref Expr,
	words: ref winnow_grammar::InternerContext,
) -> (i64, i64)? {
	if name == "" {
		return null
	}
	let mut map: (i64, i64)? = null
	if op != null {
		let c = bounding_step_literal(value) ?? return null
		if bounding_is_op(op, BinaryOp::Add) {
			map = (1, c)
		}
		if bounding_is_op(op, BinaryOp::Mul) {
			map = (c, 0)
		}
	} else {
		map = bounding_affine(value, name, words)
	}
	let (a, b) = map ?? return null
	if a < 1 || b < 0 {
		return null
	}
	return (a, b)
}

/// `expr` as `(a, b)` of `a * name + b`, of small constants, where it is one:
/// `2 * size + 1` is `(2, 1)`.
fn bounding_affine(expr: ref Expr, name: ref String, words: ref winnow_grammar::InternerContext) -> (i64, i64)? {
	if (path_of(expr, words) ?? "") == name {
		return (1, 0)
	}
	let c = bounding_step_literal(expr)
	if c != null {
		return (0, c ?? 0)
	}
	match expr {
		Expr::Binary { op, lhs, rhs, .. } => {
			let (la, lb) = bounding_affine(lhs, name, words) ?? return null
			let (ra, rb) = bounding_affine(rhs, name, words) ?? return null
			let mut a = 0
			let mut b = 0
			if op == BinaryOp::Add {
				a = la + ra
				b = lb + rb
			} else if op == BinaryOp::Sub {
				a = la - ra
				b = lb - rb
			} else if op == BinaryOp::Mul && la == 0 {
				a = lb * ra
				b = lb * rb
			} else if op == BinaryOp::Mul && ra == 0 {
				a = rb * la
				b = rb * lb
			} else {
				return null
			}
			if a.abs() > 1048576 || b.abs() > 1048576 {
				return null
			}
			return (a, b)
		},
		else => return null,
	}
}

/// **What a turn's scaling leaves of each name** (#1644): of each of
/// `scales` that lies in `[lo, hi]` where the loop is reached, `lo >= 0`,
/// `v >= lo` at each head and past the loop, since no map lowers it; and
/// where at most `turns` turns start, `v <= f^turns(hi)` too, `f` the map
/// `a * v + b`, computed here as a constant, so that no product of two
/// unknowns reaches the solver. A turn cut short ends below. One whose bound
/// passes `solvable()` gets no upper fact; one that only grows by adding
/// (`a` 1), whose turns D13 counts, none without `turns`.
fn bounding_scaled_bounds(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	scales: ref Vec[(String, i64, i64)],
	turns: i64?,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	for (name, a, b) in scales {
		if a == 1 && turns == null {
			continue
		}
		let now = walk.arena.var(name)
		let range = bounding_term(walk, now, facts, ask)
		let lo = range.lo ?? continue
		if lo < 0 {
			continue
		}
		let least = walk.arena.int(lo)
		out.push(walk.arena.ge(now, least))
		let most_turns = turns ?? continue
		let mut top = range.hi ?? continue
		let mut fits = top <= solvable()
		if fits && a == 1 {
			if b > 0 && most_turns > (solvable() - top) / b {
				fits = false
			} else {
				top += most_turns * b
			}
		} else if fits {
			let mut k = 0
			if top == 0 && b == 0 {
				k = most_turns
			}
			while fits && k < most_turns {
				if top > (solvable() - b) / a {
					fits = false
				} else {
					top = a * top + b
				}
				k += 1
			}
		}
		if fits {
			let most = walk.arena.int(top)
			out.push(walk.arena.le(now, most))
		}
	}
	return out
}

/// `let names: ty = value`.
fn bounding_let(
	mut walk: BoundsWalk,
	names: ref Vec[winnow_grammar::Symbol],
	ty: ref Type?,
	value: ref Expr,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	bounding_expr(walk, value, facts, context, program, words, ask)
	let value_lin = bounding_lin(walk, value, facts, context, program, words)
	bounding_settle(walk, facts)
	// The call a `?? return` unwraps (#1758): what it is found to return
	// holds of the name.
	let unwrapped = bounding_unwrapped(value)
	// **A number the walk bounds without a linear term**: a value read out
	// of a list, a `%` (ADR-306 D7, D8).
	let mut value_range: Range? = null
	// A quotient's too, where what it divides is no linear term (#1631).
	if value_lin == null || bounding_reads_own(walk, value_lin ?? 0) {
		let range = bounding_range(walk, value, facts, context, program, words, ask)
			?? Range::open()
		if range.is_bounded() {
			value_range = range
		}
	}
	// A field of a whole-number type read through an index (`xs[i].count`)
	// is a number too, of which nothing is known yet (#714).
	let whole_field = match value {
		Expr::Field { .. } => context.whole_fields.contains(node_key(value)),
		// A call's whole-number result too (#781).
		Expr::Call { .. } => context.whole_fields.contains(node_key(value)),
		Expr::MethodCall { .. } => context.whole_fields.contains(node_key(value)),
		// A choice's: `text::parse_i64(s) ?? 1` (#1571).
		Expr::Coalesce { .. } => context.whole_fields.contains(node_key(value)),
		else => false,
	}
	let whole = bounding_declared_whole(ty, words)
		?? (value_lin != null || value_range != null || whole_field
			|| bounding_found_whole(walk, unwrapped, context, words))
	let mut relations: Vec[(bool, i64)] = []
	if names.len() == 1 && value_lin == null {
		relations = bounding_relations_of(walk, facts, words.resolve(names[0]), unwrapped, context, program, words, ask)
	}
	// **The lengths the callee is found to hand back** (ADR-306 D23, #1756),
	// and of a struct result's fields (ADR-306 D35), stated before the name
	// moves, as the relations are.
	let mut measured: Vec[i64] = []
	let mut field_paths: Vec[String] = []
	let mut field_facts: Vec[i64] = []
	if names.len() == 1 {
		let root = words.resolve(names[0])
		measured = bounding_measured(walk, facts, root, root, value, context, program, words)
		field_facts = bounding_fields_found(walk, facts, root, value, field_paths, context, program, words, ask)
	}
	// **What `a.overflowing_add(b)` or `a.widening_mul(b)` says of its
	// two halves** (#1555), read before the names move.
	let mut halves: i64? = null
	if names.len() == 2 {
		halves = bounding_halves(walk, names, value, facts, context, program, words)
	}
	for symbol in names {
		let name = words.resolve(symbol)
		bounding_forget(walk, facts, name)
		facts.ints.remove(name)
	}
	if halves != null {
		facts.ints.insert(words.resolve(names[0]).clone())
		// The high half of a product is a number, a flag is not.
		match value {
			Expr::MethodCall { method, .. } => {
				if words.resolve(method) == "widening_mul" {
					facts.ints.insert(words.resolve(names[1]).clone())
				}
			},
			else => {},
		}
		bounding_push(walk, facts, halves ?? 0)
	}
	if names.len() != 1 {
		return
	}
	let name = words.resolve(names[0]).clone()
	match value {
		Expr::LitBool(up, _) => bounding_flag_set(walk, facts, name, up),
		else => {},
	}
	// **What every arm of a choice holds** (#1516), beside the range the
	// arms join to.
	if value_lin == null {
		let chosen = bounding_choice_facts(walk, facts, name, value, context, program, words, ask)
		if !chosen.is_empty() {
			facts.ints.insert(name.clone())
			for fact in chosen {
				bounding_push(walk, facts, fact)
			}
		}
	}
	// **A sequence held under a name keeps what `std`'s ledger states of
	// each element** (ADR-375 D5), as facts of a name within it.
	let held = walk.arena.var(bounding_element_of(name))
	for each in bounding_each(walk, value, held, null, facts, context, program, words) {
		// Nothing where the sequence is empty (#1483).
		let fact = bounding_each_guarded(walk, each)
		bounding_push(walk, facts, fact)
	}
	// **What a rule between list fields says of the value** (ADR-369 D4):
	// a method's result inside a list, an element of a list of positions.
	rules_result_facts(walk, facts, name, value, context, words)
	// **What the callee is found to return** (ADR-306 D23).
	bounding_returned_facts(walk, facts, name, unwrapped, context, words)
	// **What the callee is found to hold of its arguments** (ADR-306 D31).
	bounding_relations_push(walk, facts, name, relations)
	// **What each field of its struct result is found to hold** (ADR-306
	// D35), as facts of the path.
	for fact in field_facts {
		bounding_push(walk, facts, fact)
	}
	for path in field_paths {
		facts.ints.insert(path.clone())
	}
	let read_from = bounding_read_out_of(value, words)
	if read_from != null {
		let key = elements_key(walk.shape, read_from ?? value, words)
		if key != null {
			bounding_end_facts(walk, facts, name, key ?? "")
		}
	}
	rules_element_facts(walk, facts, name, value, words)
	rules_ascending_facts(walk, facts, name, value, context, program, words, ask)
	if whole {
		facts.ints.insert(name.clone())
		if value_lin != null {
			let v = value_lin ?? 0
			if !walk.arena.mentions(v, name) {
				let n = walk.arena.var(name)
				let fact = walk.arena.equal(n, v)
				bounding_push(walk, facts, fact)
			}
		}
		if bounding_declared_unsigned(ty, words) {
			bounding_at_least_zero(walk, facts, name)
		}
		if value_range != null {
			bounding_bounded(walk, facts, name, value_range ?? Range::open())
		}
	}
	bounding_built(walk, facts, name, value, words)
	for fact in measured {
		bounding_push(walk, facts, fact)
	}
	bounding_built_choice(walk, facts, name, value, context, program, words, ask)
	if bounding_declared_list(ty, words) {
		bounding_collected(walk, facts, name, value, context, program, words)
	}
	if walk.shape.roots.contains(name) {
		match value {
			Expr::ListLit { items, .. } => {
				for item in items {
					bounding_write(walk, name, item, facts, context, program, words, ask)
				}
			},
			Expr::ListRepeat { value: item, .. } => bounding_write(
				walk,
				name,
				item,
				facts,
				context,
				program,
				words,
				ask,
			),
			Expr::Call { .. } => bounding_call_root(walk, name, value, context, words),
			else => {},
		}
	}
}

/// **The length of a list chosen by an `if`** (#1702): `let cols = if
/// ks.len() == 0 { [] } else { r.cols.clone() }` holds of `cols` what
/// `if … { cols = [] } else { cols = r.cols.clone() }` does: each arm's
/// length (`bounding_built`) under its condition or its denial, joined as
/// past an `if` (`bounding_if_join`, `bounding_flag_join`). Nothing where an
/// arm is more than a value or its length is not known. `facts` hold
/// nothing of `name`.
fn bounding_built_choice(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	match value {
		Expr::If { cond, then_branch, else_branch, .. } => {
			let otherwise = else_branch ?? return
			let first = bounding_arm_value(then_branch) ?? return
			let second = bounding_arm_value(otherwise) ?? return
			let length = length_of(name)
			let mut taken = facts.clone()
			bounding_assume(walk, taken, cond, context, program, words)
			bounding_built(walk, taken, name, first, words)
			let mut passed = facts.clone()
			bounding_assume_not(walk, passed, cond, context, program, words)
			bounding_built(walk, passed, name, second, words)
			if !bounding_reads_name(walk, taken, length) || !bounding_reads_name(walk, passed, length) {
				return
			}
			let mut changed = nothing_changed()
			changed.values.insert(name.clone())
			bounding_if_join(walk, facts, changed, taken, passed, ask)
			bounding_flag_join(walk, facts, changed, taken, passed, ask)
		},
		else => {},
	}
}

/// Whether a fact among `facts` reads the name `name`.
fn bounding_reads_name(walk: ref BoundsWalk, facts: ref BoundsFacts, name: ref String) -> bool {
	for fact in facts.facts {
		if walk.arena.mentions(fact, name) {
			return true
		}
	}
	return false
}

/// **What every arm of a choice holds of `name`** (#1516): `let b = match
/// k { 0 => 0, else => last(xs) }` gives `b <= xs.len()` where the first
/// arm's value proves what the second's callee is found to hold (ADR-306
/// D23, D31). Of each arm what a `let` of its value alone would give; of
/// those facts, the ones every other arm's own facts prove. Nothing where
/// an arm is more than a value, binds a name, or is no whole number the
/// walk reads. `facts` hold nothing of `name`.
fn bounding_choice_facts(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Vec[i64] {
	let mut own: Vec[Vec[i64]] = []
	// What holds where each arm is taken: an `if`'s condition or its
	// denial (#1669); a `match` arm, what holds before it.
	let mut states: Vec[BoundsFacts] = []
	match value {
		Expr::If { cond, then_branch, else_branch, .. } => {
			let otherwise = else_branch ?? return []
			let mut taken = facts.clone()
			bounding_assume(walk, taken, cond, context, program, words)
			let mut passed = facts.clone()
			bounding_assume_not(walk, passed, cond, context, program, words)
			let first = bounding_arm_value(then_branch) ?? return []
			let mut held = bounding_arm_facts(walk, facts, name, first, context, program, words, ask) ?? return []
			bounding_arm_restated(walk, facts, taken, name, first, context, program, words, held)
			own.push(held)
			states.push(taken)
			let second = bounding_arm_value(otherwise) ?? return []
			let mut held_else = bounding_arm_facts(walk, facts, name, second, context, program, words, ask) ?? return []
			bounding_arm_restated(walk, facts, passed, name, second, context, program, words, held_else)
			own.push(held_else)
			states.push(passed)
		},
		Expr::Match { arms, .. } => {
			for arm in arms {
				// A name the arm binds is not the one outside it; a path of
				// more than one segment (`Kind::Size`) binds none.
				let mut bound: Vec[String] = []
				match arm.pattern {
					MatchPattern::Path(segments) => {
						if segments.len() == 1 {
							return []
						}
					},
					else => frame_pattern_names(arm.pattern, words, bound),
				}
				if !bound.is_empty() {
					return []
				}
				let arm_value = bounding_arm_body(arm.body) ?? return []
				own.push(bounding_arm_facts(walk, facts, name, arm_value, context, program, words, ask) ?? return [])
				states.push(facts.clone())
			}
		},
		// **`x ?? d` is the value `x` holds or `d`** (#1758): of a call
		// with a nullable result, what it is found to return of the one.
		Expr::Coalesce { value: held, fallback, .. } => {
			if bounding_leaves(fallback) {
				return []
			}
			own.push(bounding_arm_facts(walk, facts, name, held, context, program, words, ask) ?? return [])
			states.push(facts.clone())
			own.push(bounding_arm_facts(walk, facts, name, fallback, context, program, words, ask) ?? return [])
			states.push(facts.clone())
		},
		else => return [],
	}
	let mut out: Vec[i64] = []
	if own.len() < 2 {
		return out
	}
	for k in 0..<own.len() {
		for fact in own[k] {
			if out.contains(fact) {
				continue
			}
			let mut every = true
			for j in 0..<own.len() {
				if !every || j == k || own[j].contains(fact) {
					continue
				}
				let mut trial = states[j].clone()
				for held in own[j] {
					bounding_push(walk, trial, held)
				}
				every = bounding_proves(walk, trial, fact, ask)
			}
			if every {
				out.push(fact)
			}
		}
	}
	return out
}

/// **What an arm's condition says of its value, said of `name`** (#1669):
/// in `if right < n && … { right } else { left }` the first arm's `right <
/// n` gives `name < n`, the second's denial nothing of `left`; each fact
/// the condition adds to `facts` (in `state`) that reads the arm's one
/// name `v` of a value `v + c` is restated with `v` as `name - c`.
fn bounding_arm_restated(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	state: ref BoundsFacts,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	mut held: Vec[i64],
) {
	let term = bounding_lin(walk, value, facts, context, program, words) ?? return
	let mut read: collections::BTreeSet[String] = collections::BTreeSet()
	walk.arena.variables(term, read)
	if read.len() != 1 {
		return
	}
	let mut v: String = ""
	for only in read {
		v = only.clone()
	}
	let mut at_zero: collections::BTreeMap[String, i64] = collections::BTreeMap()
	at_zero.insert(v.clone(), walk.arena.int(0))
	let mut at_one: collections::BTreeMap[String, i64] = collections::BTreeMap()
	at_one.insert(v.clone(), walk.arena.int(1))
	let zero = walk.arena.substitute(term, at_zero)
	let one = walk.arena.substitute(term, at_one)
	let c = walk.arena.constant(zero) ?? return
	let d = walk.arena.constant(one) ?? return
	if d - c != 1 {
		return
	}
	let named = walk.arena.var(name)
	let shift = walk.arena.int(c)
	let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
	given.insert(v.clone(), walk.arena.sub(named, shift))
	for fact in state.facts {
		if facts.facts.contains(fact) || !walk.arena.mentions(fact, v) {
			continue
		}
		let restated = walk.arena.substitute(fact, given)
		if !held.contains(restated) {
			held.push(restated)
		}
	}
}

// A `match` arm's value: its body, or the last expression of a block body
// with no statement before it.
fn bounding_arm_body(body: ref Expr) -> ref Expr? {
	match body {
		Expr::Block(block, _) => {
			return bounding_arm_value(block)
		},
		else => {},
	}
	return body
}

/// The value of an arm that is only its value.
fn bounding_arm_value(arm: ref Block) -> ref Expr? {
	if arm.stmts.len() != 1 {
		return null
	}
	return match arm.stmts[0].node {
		Stmt::Expr(value) => value,
		else => null,
	}
}

/// **What a `let` of `value` alone gives of `name`** (#1516): its linear
/// term, or of a call's whole-number result what the callee is found to
/// return (ADR-306 D23) and to hold of its arguments (D31); nothing where
/// it is neither.
fn bounding_arm_facts(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Vec[i64]? {
	let n = walk.arena.var(name)
	let lin = bounding_lin(walk, value, facts, context, program, words)
	if lin != null {
		let term = lin ?? 0
		if walk.arena.mentions(term, name) {
			return null
		}
		// Both sides apart, so that each can hold of every arm alone.
		let mut sides = [walk.arena.le(n, term), walk.arena.ge(n, term)]
		// An element read gives what a rule says of every element, as a
		// `let` of it does (ADR-306 D21, #1785): `if xs.len() > 0 { xs[0] }
		// else { b.len() }` of a list capped by `b`'s length.
		let mut read = facts.clone()
		rules_element_facts(walk, read, name, value, words)
		for fact in read.facts {
			if walk.arena.mentions(fact, name) && !sides.contains(fact) {
				sides.push(fact)
			}
		}
		return sides
	}
	// The checker marks only a `let` value's call a whole number; an arm's
	// is one where the callee is found to hand back one (`context.returns`,
	// which both readers below look up).
	let call = match value {
		Expr::Call { .. } => true,
		// A method's, read as a free function (ADR-306 D34).
		Expr::MethodCall { .. } => true,
		else => false,
	}
	if !call {
		return null
	}
	let relations = bounding_relations_of(walk, facts, name, value, context, program, words, ask)
	let mut given = facts.clone()
	given.facts = []
	bounding_returned_facts(walk, given, name, value, context, words)
	bounding_relations_push(walk, given, name, relations)
	// The interval its result is found in (D23): the floor a list's
	// relation (`at most xs.len()`) leaves open.
	let range = bounding_range(walk, value, facts, context, program, words, ask) ?? Range::open()
	if range.lo != null {
		let least = walk.arena.int(range.lo ?? 0)
		let low = walk.arena.ge(n, least)
		bounding_push(walk, given, low)
	}
	if range.hi != null {
		let most = walk.arena.int(range.hi ?? 0)
		let high = walk.arena.le(n, most)
		bounding_push(walk, given, high)
	}
	return given.facts.clone()
}

/// **What `value` is an element of**: `xs` of `xs[i]` and of a map's
/// `m.get(k)`, through a `??` that leaves (ADR-306 D21, D24).
fn bounding_read_out_of(value: ref Expr, words: ref winnow_grammar::InternerContext) -> ref Expr? {
	return match value {
		Expr::Index { base, .. } => base,
		Expr::MethodCall { receiver, method, args, .. } => {
			if args.len() == 1 && words.resolve(method) == "get" {
				return receiver
			}
			return null
		},
		Expr::Coalesce { value: inner, fallback, .. } => {
			if bounding_leaves(fallback) {
				return bounding_read_out_of(inner, words)
			}
			return null
		},
		else => null,
	}
}

/// Whether evaluating `expr` leaves where it stands: `return`, `continue`,
/// `break`.
fn bounding_leaves(expr: ref Expr) -> bool {
	return match expr {
		Expr::Return(_, _) => true,
		Expr::Continue(_) => true,
		Expr::Break(_) => true,
		else => false,
	}
}

/// **The value a `?? return` unwraps** (#1758): `x` of `x ?? return`, `??
/// continue`, `?? break`, which is read only where it holds a value;
/// `value` itself otherwise.
fn bounding_unwrapped(value: ref Expr) -> ref Expr {
	return match value {
		Expr::Coalesce { value: inner, fallback, .. } => {
			if bounding_leaves(fallback) {
				return bounding_unwrapped(inner)
			}
			value
		},
		else => value,
	}
}

/// **Whether a call's whole-number result is found** (ADR-306 D23, #1758):
/// a nullable one's too, which the checker does not mark a whole number.
fn bounding_found_whole(
	walk: ref BoundsWalk,
	value: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> bool {
	let call = match value {
		Expr::Call { .. } => true,
		Expr::MethodCall { .. } => true,
		else => false,
	}
	if !call {
		return false
	}
	let callee = bounding_found_key(walk, value, context, words) ?? return false
	let found = context.returns.get(callee) ?? return false
	return !found.each && found.plain
}

/// Whether a declared type is a whole number; nothing where none is
/// declared.
fn bounding_declared_whole(ty: ref Type?, words: ref winnow_grammar::InternerContext) -> bool? {
	let t = ty ?? return null
	return t.generics.is_empty() && is_whole_number(words.resolve(t.name))
}

/// Whether a declared type is a list, `Vec[T]`: a sequence collected into
/// it holds one element for each item.
fn bounding_declared_list(ty: ref Type?, words: ref winnow_grammar::InternerContext) -> bool {
	let t = ty ?? return false
	let name = words.resolve(t.name)
	return t.generics.len() == 1 && (name == "Vec" || name == "List")
}

/// **A sequence collected into a list keeps what `std`'s ledger ensures of
/// how many it yields** (ADR-306 D4, #1546): `t.split(", ").collect()` is one
/// piece at least, so `name.len() >= 1`. The arguments stand for the
/// parameters, each a number of its own where the walk does not read it.
fn bounding_collected(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) {
	match value {
		Expr::MethodCall { receiver: sequence, method, args, .. } => {
			if !args.is_empty() || words.resolve(method) != "collect" {
				return
			}
			match sequence {
				Expr::MethodCall { method: made, args: given, .. } => {
					let ty = context.std_receivers[node_key(sequence)] ?? return
					let collected = context.collected[f"{ty}::{words.resolve(made)}"] ?? return
					if given.len() != collected.params.len() {
						return
					}
					let mut named: collections::BTreeMap[String, i64] = collections::BTreeMap()
					for k in 0..<given.len() {
						let term = if collected.chars[k] {
							bounding_code_of(walk, given[k], context, words)
						} else {
							bounding_lin(walk, given[k], facts, context, program, words) ?? bounding_fresh(walk)
						}
						named.insert(collected.params[k].clone(), term)
					}
					named.insert(length_of("result"), walk.arena.var(length_of(name)))
					for nodes in collected.conditions {
						let read = walk.arena.adopt(nodes)
						let fact = walk.arena.substitute(read, named)
						bounding_push(walk, facts, fact)
					}
				},
				else => {},
			}
		},
		else => {},
	}
}

fn bounding_declared_unsigned(ty: ref Type?, words: ref winnow_grammar::InternerContext) -> bool {
	let t = ty ?? return false
	return words.resolve(t.name).starts_with("u")
}

/// **A write to a place** (ADR-306 D17, D33): a path of fields or an
/// element moves as a name does.
fn bounding_assign_place(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	target: ref Expr,
	op: ref BinaryOp?,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let p = bounding_place_path(target, words) ?? return
	if context.whole_fields.contains(node_key(target)) {
		facts.ints.insert(p.clone())
	} else {
		facts.ints.remove(p)
	}
	bounding_assign(walk, facts, p, op, value, context, program, words, ask)
}

/// **`x += d` proved as `x + d`** (#387), before the name moves: what is
/// known of `x` is what the operation reads.
fn bounding_compound(
	mut walk: BoundsWalk,
	op: ref BinaryOp?,
	target: ref Expr,
	value: ref Expr,
	at: i64,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let operation = op ?? return
	let arithmetic = match operation {
		BinaryOp::Add => true,
		BinaryOp::Sub => true,
		BinaryOp::Mul => true,
		else => false,
	}
	if walk.collecting {
		return
	}
	// **`x /= d` asks what `x / d` asks** (ADR-396 D7, #1578).
	let divided = context.divisions[at]
	if divided != null {
		if bounding_place_path(target, words) != null
			&& bounding_divides(walk, target, value, divided ?? "", facts, context, program, words, ask) {
				walk.proven.arithmetic.insert(at)
			}
		return
	}
	if !arithmetic {
		return
	}
	// A path of fields, through at most one element (#781), or an element
	// (ADR-306 D33).
	let place = bounding_place_path(target, words)
	if place == null {
		return
	}
	let ty = context.arithmetic[at] ?? return
	if bounding_fits(walk, operation, target, value, ty, facts, context, program, words, ask) {
		walk.proven.arithmetic.insert(at)
	} else {
		walk.open += 1
	}
}

fn bounding_for(
	mut walk: BoundsWalk,
	bindings: ref Vec[winnow_grammar::Symbol],
	iter: ref Expr,
	body: ref Block,
	mut facts: BoundsFacts,
	cands: ref Vec[String],
	invariant: ref Vec[i64],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	bounding_expr(walk, iter, facts, context, program, words, ask)
	let changed = bounding_changed(body, context, words)
	let kept = rules_loop_entry(walk, facts, changed, ask)
	// `for k in low..<high`: the binding, its ends as terms, and whether the
	// range takes its end.
	let mut counted = false
	let mut name: String = ""
	let mut low: i64? = null
	let mut high: i64? = null
	let mut closed = false
	if bindings.len() == 1 {
		match iter {
			Expr::Range { start, end, inclusive, .. } => {
				low = bounding_lin(walk, start, facts, context, program, words)
				high = bounding_lin(walk, end, facts, context, program, words)
				counted = true
				name = words.resolve(bindings[0]).clone()
				closed = inclusive
			},
			else => {},
		}
	}
	let mut inner = facts.clone()
	// **A `for` counts its turns** (ADR-361 D13): at the head of each, `t`
	// turns have ended, `0 <= t` and `t` below the range's span or the
	// length of the collection where the loop is reached (a `for` cannot
	// change what it walks, NK2305); a counter lies within its steps times
	// `t`, and a range's binding is its start plus `t`.
	let mut outside: collections::BTreeSet[String] = collections::BTreeSet()
	for binding in bindings {
		outside.insert(words.resolve(binding).clone())
	}
	let mut pairs: Vec[(String, String)] = []
	let steps = bounding_turn_steps(walk, body, outside, changed, facts, context, words, ask, pairs)
	let mut turn_facts: Vec[i64] = []
	// The turns the loop ends with when no `break` leaves it: a range's
	// span where its start lies at or below its end, a collection's length.
	let mut all_turns: i64? = null
	if !steps.is_empty() {
		let turn_name = f"#turn{walk.entries}"
		let t = walk.arena.var(turn_name)
		walk.entries += 1
		let mut limit: i64? = null
		let mut binding_at: i64? = null
		if counted && low != null && high != null {
			let l = low ?? 0
			let h = high ?? 0
			if bounding_stable(walk, l, changed, name) && bounding_stable(walk, h, changed, name) {
				let reached = walk.arena.add(l, t)
				limit = bounding_below(walk, reached, h, closed)
				let bound = walk.arena.var(name)
				binding_at = walk.arena.equal(bound, reached)
				let mut span = walk.arena.sub(h, l)
				if closed {
					let one = walk.arena.int(1)
					span = walk.arena.add(span, one)
				}
				let ordered = walk.arena.le(l, h)
				if bounding_proves(walk, facts, ordered, ask) {
					all_turns = span
				}
			}
		} else if !counted {
			let walked = path_of(iter, words) ?? ""
			let mut stable = walked != "" && !changed.lengths.contains(walked)
			for v in changed.values {
				if path_within(walked, v) {
					stable = false
				}
			}
			if stable {
				let length = bounding_length(walk, iter, walked, context)
				if length != null {
					limit = walk.arena.lt(t, length ?? 0)
					all_turns = length
				}
			}
			// **`for c in s.scalars` turns at most `s.len()` times** (ADR-361
			// D13, #1516): each character takes one byte or more.
			let text = bounding_chars_of(iter, context, words) ?? ""
			if limit == null && text != "" && !text.contains(".") && !changed.values.contains(text) && !changed.lengths.contains(text) {
				let length = bounding_length_named(walk, text, false)
				limit = walk.arena.lt(t, length)
			}
		}
		// **A sequence whose ledger ties its elements to the turns** (#432,
		// ADR-375 D5): `find_all`'s positions rise, so the one a turn binds
		// lies at or above `t` and below the bytes' length, and `t` below it.
		// Stated of an element of its own: one exists at each head.
		let mut counted_by: Vec[i64] = []
		if limit == null && bindings.len() == 1 {
			let element = bounding_fresh(walk)
			let mut tied = false
			for fact in bounding_each(walk, iter, element, t, facts, context, program, words) {
				tied = tied || walk.arena.mentions(fact, turn_name)
				counted_by.push(fact)
			}
			if !tied {
				counted_by = []
			}
		}
		if limit != null || !counted_by.is_empty() {
			let zero = walk.arena.int(0)
			turn_facts.push(walk.arena.ge(t, zero))
			if limit != null {
				turn_facts.push(limit ?? 0)
			}
			turn_facts.extend(counted_by)
			if binding_at != null {
				turn_facts.push(binding_at ?? 0)
			}
			for fact in bounding_turn_bounds(walk, inner, steps, t) {
				turn_facts.push(fact)
			}
		}
	}
	// **Two counters a turn raises together keep their gap** (#1634,
	// #1654): `n - n@ <= m - m@` at each head, whatever counts the turns;
	// both ways for two lists every path pushes both or neither (`if k != 0
	// { cols.push(i); ks.push(k) }`), so their lengths stay equal.
	for fact in bounding_pair_bounds(walk, inner, pairs, "") {
		turn_facts.push(fact)
	}
	// **A name that only takes the binding's values follows it** (ADR-361
	// D13, #1516): `prev = i` the one change of `prev` in the body of `for
	// i in low..<high`, with `prev` below `low` where the loop is reached.
	// At the head of each turn it holds its value from before the loop or
	// one the binding had, so it lies at or above the first and below the
	// binding; past the loop, below the range's end.
	let followers = bounding_followers(walk, body, name, counted, low, high, changed, facts, words, ask)
	// **A name each turn scales, in a range of at most `k` turns** (#1644):
	// within constants, at each head and past the loop.
	let mut scaled: Vec[i64] = []
	let scales = bounding_turn_scales(walk, body, outside, changed, facts, context, words)
	if !scales.is_empty() {
		let multiplies = scales.iter().any(fn(s) { s.1 > 1 })
		let mut most: i64? = null
		if counted {
			most = bounding_for_turns_most(walk, low, high, closed, changed, name, facts, !multiplies, ask)
		}
		scaled = bounding_scaled_bounds(walk, facts, scales, most, ask)
	}
	let mut entered: Vec[(String, i64)] = []
	for x in followers {
		let e = bounding_rename(walk, inner, x)
		entered.push((x.clone(), e))
	}
	bounding_loop_change(walk, inner, changed, cands)
	rules_loop_give(walk, inner, kept, changed)
	for binding in bindings {
		let bound = words.resolve(binding)
		bounding_forget(walk, inner, bound)
		inner.ints.remove(bound)
	}
	for (x, e) in entered {
		let v = walk.arena.var(x)
		let n = walk.arena.var(name)
		let above = walk.arena.ge(v, e)
		bounding_push(walk, inner, above)
		let below = walk.arena.lt(v, n)
		bounding_push(walk, inner, below)
	}
	for fact in invariant {
		bounding_push(walk, inner, fact)
	}
	for fact in turn_facts {
		bounding_push(walk, inner, fact)
	}
	for fact in scaled {
		bounding_push(walk, inner, fact)
	}
	// `for d in x.scalars` over a text binding: `d` is in its class
	// (ADR-314 D1).
	let mut classed: String? = null
	if bindings.len() == 1 && !counted {
		let over = bounding_chars_of(iter, context, words)
		if over != null {
			let text = over ?? ""
			let class = context.text_classes[text]
			if class != null && !walk.shape.bound.contains(text) {
				let only = words.resolve(bindings[0]).clone()
				walk.loop_classes.insert(only.clone(), class ?? Range::open())
				classed = only
			}
		}
	}
	// `for x in xs` over whole numbers: `x` is a number of the walk, of
	// which every test in the body is a fact (ADR-306 D7, #781).
	if bindings.len() == 1 && !counted {
		let element = context.whole_loops.get(node_key(iter))
		if element != null {
			let only = words.resolve(bindings[0]).clone()
			inner.ints.insert(only.clone())
			// **Its type is its range** (ADR-306 D34, #1786): `for b in
			// s.bytes()` binds a number in `0..=255`.
			let held = Range::held_by_type(element ?? "")
			if held != null {
				bounding_bounded(walk, inner, only, held ?? Range::open())
			}
		}
	}
	// `for (at, unit) in rows`: each name bound to a whole number is one
	// too, of which every test in the body is a fact.
	let parts = context.whole_parts.get(node_key(iter))
	if bindings.len() > 1 && parts != null {
		for (at, binding) in bindings.iter().enumerate() {
			if parts?.contains(at as i64) ?? false {
				inner.ints.insert(words.resolve(binding).clone())
			}
		}
	}
	// `for x in xs`, where what `xs` holds is bounded (ADR-306 D7).
	if bindings.len() == 1 && !counted {
		let key = elements_key(walk.shape, iter, words)
		if key != null {
			let bound = bounding_assumed(walk, key ?? "")
			if bound != null {
				let only = words.resolve(bindings[0]).clone()
				inner.ints.insert(only.clone())
				bounding_bounded(walk, inner, only, bound ?? Range::open())
			}
			let only = words.resolve(bindings[0]).clone()
			bounding_end_facts(walk, inner, only, key ?? "")
		}
	}
	// **A position a search hands back lies in the buffer** (ADR-375 D5):
	// what `std`'s ledger states of each element holds of the name bound,
	// from the call itself or from the name the sequence was held under, while
	// nothing it reads changes in the body.
	if bindings.len() == 1 && !counted {
		let only = words.resolve(bindings[0]).clone()
		let item = walk.arena.var(only)
		let mut stated = bounding_each(walk, iter, item, null, facts, context, program, words)
		// An inner list of a field (`t.col[c]`, its `.clone()`) is named
		// by its list's `t.col[]` (ADR-306 D28).
		// A list field by its path (`self.at`, #1688), what its rules and
		// reads state of every element.
		let mut held = path_of(iter, words)
		if held == null {
			let outer = rules_inner_of(iter, words)
			if outer != null {
				held = f"{outer ?? ""}[]"
			}
		}
		if held != null {
			let element = bounding_element_of(held ?? "")
			let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
			given.insert(element.clone(), item)
			let mut of_every = false
			for fact in facts.facts {
				if walk.arena.mentions(fact, element) {
					stated.push(walk.arena.substitute(fact, given))
					of_every = true
				}
			}
			for (each, fact) in walk.rule_facts.clone() {
				if each == element && rules_standing(walk, facts, fact) {
					stated.push(walk.arena.substitute(fact, given))
					of_every = true
				}
			}
			// The body runs only where the sequence holds an element, so
			// what holds of every one, guarded by its emptiness, holds of
			// the binding (#1483).
			if of_every {
				stated.push(bounding_each_present(walk, held ?? ""))
			}
		}
		for fact in stated {
			if bounding_unchanged(walk, fact, changed) {
				inner.ints.insert(only.clone())
				bounding_push(walk, inner, fact)
			}
		}
	}
	if counted {
		inner.ints.insert(name.clone())
		let n = walk.arena.var(name)
		// A bound is read once, before the first turn: it holds of the
		// binding while nothing it reads has changed.
		if low != null {
			let l = low ?? 0
			if bounding_stable(walk, l, changed, name) {
				let fact = walk.arena.le(l, n)
				bounding_push(walk, inner, fact)
			}
		}
		if high != null {
			let h = high ?? 0
			if bounding_stable(walk, h, changed, name) {
				let fact = bounding_below(walk, n, h, closed)
				bounding_push(walk, inner, fact)
			}
		}
	}
	walk.rule_loops.push(kept.clone())
	if !bounding_block(walk, body, inner, context, program, words, ask) {
		bounding_turn_end(walk, inner, false, false, ask)
	}
	walk.rule_loops.pop()
	if classed != null {
		walk.loop_classes.remove(classed ?? "")
	}
	// **A loop that pushes once per turn adds its count to the length**
	// (ADR-306 D9).
	let mut filled: Vec[String] = []
	let mut count = 0
	if counted && low != null && high != null {
		let l = low ?? 0
		let h = high ?? 0
		let mut stable = true
		for c in changed.values {
			if bounding_reads(walk, l, h, c) {
				stable = false
			}
		}
		for c in changed.lengths {
			if bounding_reads(walk, l, h, c) {
				stable = false
			}
		}
		let mut lists: Vec[String] = []
		if stable {
			lists = filled_once(body, walk.pinned, words)
		}
		let not_empty = walk.arena.le(l, h)
		if !lists.is_empty() && bounding_proves(walk, facts, not_empty, ask) {
			let mut taken = 0
			if closed {
				taken = 1
			}
			let one = walk.arena.int(taken)
			let span = walk.arena.sub(h, l)
			count = walk.arena.add(span, one)
			filled = lists
		}
	}
	let mut outer = BoundsChanged {
		values: changed.values.clone(),
		lengths: changed.lengths.clone(),
		parts: changed.parts.clone(),
		jumps: changed.jumps.clone(),
		drops: changed.drops.clone(),
		falls: changed.falls.clone(),
		bare_falls: changed.bare_falls.clone(),
		elements: changed.elements.clone(),
	}
	for list in filled {
		outer.lengths.remove(list)
		outer.falls.remove(list)
		outer.bare_falls.remove(list)
	}
	// **Past the loop, its counters are bounded by the turns it ended**
	// (ADR-361 D10, D13): with no `break`, the loop leaves at the head of
	// its last turn plus one, so `low * T <= n - n@ <= high * T` holds there
	// with `T` all its turns. Under `prove-through-loops:on` only.
	let mut past: Vec[i64] = []
	if walk.through_loops && all_turns != null && !breaks(body, words) {
		// A list D9 fills is moved by its count below, not here too.
		let mut counters: Vec[(String, i64, i64, i64?)] = []
		for (name, low, high, floor) in steps {
			if !filled.iter().any(fn(list) { length_of(list) == name }) {
				counters.push((name.clone(), low, high, floor))
			}
		}
		past = bounding_turn_bounds(walk, facts, counters, all_turns ?? 0)
	}
	// A loop no `break` leaves is left at a head, where the pairs' gaps
	// hold; the values they were reached with are named before the change.
	let mut paired: Vec[i64] = []
	if !breaks(body, words) {
		paired = bounding_pair_bounds(walk, facts, pairs, "")
	}
	let mut left: Vec[(String, i64)] = []
	for x in followers {
		let e = bounding_rename(walk, facts, x)
		left.push((x.clone(), e))
	}
	bounding_loop_change(walk, facts, outer, cands)
	rules_loop_give(walk, facts, kept, outer)
	for fact in invariant {
		bounding_push(walk, facts, fact)
	}
	for (x, e) in left {
		let v = walk.arena.var(x)
		let above = walk.arena.ge(v, e)
		bounding_push(walk, facts, above)
		// Every value of the binding lies below the end, so the name does
		// where the value it entered with does.
		let h = high ?? 0
		let entered_below = bounding_below(walk, e, h, closed)
		if bounding_proves(walk, facts, entered_below, ask) {
			let below = bounding_below(walk, v, h, closed)
			bounding_push(walk, facts, below)
		}
	}
	for fact in past {
		bounding_push(walk, facts, fact)
	}
	for fact in scaled {
		bounding_push(walk, facts, fact)
	}
	for list in filled {
		bounding_shift(walk, facts, length_of(list), count)
	}
	for fact in paired {
		bounding_push(walk, facts, fact)
	}
}

/// **The names that follow the binding of `for name in low..<high`**
/// (ADR-361 D13, #1516): whole numbers the body changes only by `x = name`,
/// below `low` where the loop is reached, with both ends unchanged in it.
fn bounding_followers(
	mut walk: BoundsWalk,
	body: ref Block,
	name: ref String,
	counted: bool,
	low: i64?,
	high: i64?,
	changed: ref BoundsChanged,
	facts: ref BoundsFacts,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Vec[String] {
	let mut found: Vec[String] = []
	if !counted || low == null || high == null {
		return found
	}
	let l = low ?? 0
	let h = high ?? 0
	if !bounding_stable(walk, l, changed, name) || !bounding_stable(walk, h, changed, name) {
		return found
	}
	for x in changed.values {
		if x == name || x.contains(".") || !facts.ints.contains(x) || walk.pinned.contains(x) {
			continue
		}
		if !follows_only(body, x, name, words) {
			continue
		}
		let v = walk.arena.var(x)
		let before = walk.arena.lt(v, l)
		if bounding_proves(walk, facts, before, ask) {
			found.push(x.clone())
		}
	}
	return found
}

/// **What is known of `name` becomes known of a fresh name for its value
/// here**, which is handed back as a term: the facts that read `name` are
/// kept, read of that value instead.
fn bounding_rename(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String) -> i64 {
	let e = walk.arena.var(f"{name}#{walk.entries}")
	walk.entries += 1
	let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
	given.insert(name.clone(), e)
	let mut kept: Vec[i64] = []
	for fact in facts.facts {
		if walk.arena.mentions(fact, name) {
			kept.push(walk.arena.substitute(fact, given))
		}
		kept.push(fact)
	}
	facts.facts = kept
	return e
}

/// `n <= h` where the range takes its end, `n < h` where it does not.
fn bounding_below(mut walk: BoundsWalk, n: i64, h: i64, closed: bool) -> i64 {
	if closed {
		return walk.arena.le(n, h)
	}
	return walk.arena.lt(n, h)
}

/// Whether `t` holds while the loop's body runs: it reads nothing the body
/// changes, nor the binding.
fn bounding_stable(
	walk: ref BoundsWalk,
	t: i64,
	changed: ref BoundsChanged,
	name: ref String,
) -> bool {
	return bounding_unchanged(walk, t, changed) && !walk.arena.mentions(t, name)
}

/// Whether `t` reads nothing a loop's body changes.
fn bounding_unchanged(walk: ref BoundsWalk, t: i64, changed: ref BoundsChanged) -> bool {
	for c in changed.values {
		if bounding_touches(walk, t, c) {
			return false
		}
	}
	for c in changed.lengths {
		if walk.arena.mentions(t, length_of(c)) {
			return false
		}
	}
	for c in changed.parts {
		if bounding_touches(walk, t, c) {
			return false
		}
	}
	let mut read: collections::BTreeSet[String] = collections::BTreeSet()
	walk.arena.variables(t, read)
	for v in read {
		for place in changed.elements {
			if bounding_element_hit(v, place, false) {
				return false
			}
		}
	}
	return true
}

/// Whether either end reads `c` or its length.
fn bounding_reads(walk: ref BoundsWalk, l: i64, h: i64, c: ref String) -> bool {
	let length = length_of(c)
	return bounding_touches(walk, l, c)
		|| bounding_touches(walk, h, c)
		|| walk.arena.mentions(l, length)
		|| walk.arena.mentions(h, length)
}

/// Whether an assignment that adds `by` to its name is proved not to raise
/// it (#1329).
fn bounding_lowers(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	by: i64?,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	let step = by ?? return false
	let zero = walk.arena.int(0)
	let goal = walk.arena.le(step, zero)
	return bounding_proves(walk, facts, goal, ask)
}

/// **Whether `name = value` is proved not to raise `name`** (#1631), the
/// value not reading it: `i = parent` with `parent = (i - 1) / 2`.
fn bounding_set_lower(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	name: ref String,
	op: ref BinaryOp?,
	value_lin: i64?,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	if op != null {
		return false
	}
	let v = value_lin ?? return false
	if walk.arena.mentions(v, name) {
		return false
	}
	let now = walk.arena.var(name)
	let goal = walk.arena.le(v, now)
	return bounding_proves(walk, facts, goal, ask)
}

/// `name = value`, or `name op= value`.
fn bounding_assign(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	name: ref String,
	op: ref BinaryOp?,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if !facts.ints.contains(name) {
		if walk.growing.contains(name) {
			walk.grow_failed.insert(name.clone())
		}
		if walk.falling.contains(name) {
			walk.fall_failed.insert(name.clone())
		}
		let mut measured: Vec[i64] = []
		if op == null {
			measured = bounding_measured(walk, facts, name, name, value, context, program, words)
		}
		bounding_forget(walk, facts, name)
		bounding_built(walk, facts, name, value, words)
		for fact in measured {
			bounding_push(walk, facts, fact)
		}
		if op == null {
			match value {
				Expr::LitBool(up, _) => bounding_flag_set(walk, facts, name, up),
				else => {},
			}
		}
		return
	}
	let value_lin = bounding_lin(walk, value, facts, context, program, words)
	bounding_settle(walk, facts)
	let now = walk.arena.var(name)
	let mut by: i64? = null
	if value_lin != null {
		let v = value_lin ?? 0
		if bounding_is_op(op, BinaryOp::Add) && !walk.arena.mentions(v, name) {
			by = v
		} else if bounding_is_op(op, BinaryOp::Sub) && !walk.arena.mentions(v, name) {
			by = walk.arena.neg(v)
		} else if op == null && walk.arena.mentions(v, name) {
			// `n = n + d`, with `d` not reading `n`: linear in `n` with
			// coefficient one exactly where setting `n` to zero and to one
			// gives the same difference.
			let d = walk.arena.sub(v, now)
			let mut at_zero: collections::BTreeMap[String, i64] = collections::BTreeMap()
			at_zero.insert(name.clone(), walk.arena.int(0))
			let d0 = walk.arena.substitute(d, at_zero)
			let mut at_one: collections::BTreeMap[String, i64] = collections::BTreeMap()
			at_one.insert(name.clone(), walk.arena.int(1))
			let d1 = walk.arena.substitute(d, at_one)
			let same = walk.arena.equal(d0, d1)
			let none: Vec[i64] = []
			if ask(walk.arena, none, same) {
				by = d0
			}
		}
	}
	if walk.growing.contains(name) {
		let mut grows = false
		if by != null {
			let zero = walk.arena.int(0)
			let goal = walk.arena.ge(by ?? 0, zero)
			grows = bounding_proves(walk, facts, goal, ask)
		}
		// **A call found at least an argument that is at least the counter**
		// (ADR-306 D31): `i = skip(cs, i + 1)` raises it.
		if !grows && op == null && value_lin == null {
			grows = bounding_relation_grows(walk, facts, name, value, context, program, words, ask)
		}
		if !grows {
			walk.grow_failed.insert(name.clone())
		}
	}
	if walk.falling.contains(name)
		&& !bounding_lowers(walk, facts, by, ask)
		&& !bounding_set_lower(walk, facts, name, op, value_lin, ask) {
			walk.fall_failed.insert(name.clone())
		}
	if by != null {
		bounding_shift(walk, facts, name, by ?? 0)
		return
	}
	if op == null && value_lin != null {
		// A quotient's range too, where what it divides is no linear term
		// (#1631).
		let mut own_range: Range? = null
		if bounding_reads_own(walk, value_lin ?? 0) {
			own_range = bounding_range(walk, value, facts, context, program, words, ask)
		}
		// **A value that reads the name it is given reads the old value**
		// (#1644): `t = t * 5` states `t == 5 * t#k` over the value `t` had,
		// renamed with what held of it; `t == 5 * t` said `t` is zero.
		// **A value of other names keeps what tied them to the old value**
		// (#1669): `i = child` past `let child = if … { left + 1 } else
		// { left }` and `left == 2 * i + 1` keeps those over `i#k`, so `i`
		// is still known at least zero; forgotten, `child` was unbounded.
		let mut given = value_lin ?? 0
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(given, read)
		if walk.arena.mentions(given, name) || !read.is_empty() {
			let old = bounding_rename(walk, facts, name)
			let mut renamed: collections::BTreeMap[String, i64] = collections::BTreeMap()
			renamed.insert(name.clone(), old)
			given = walk.arena.substitute(given, renamed)
		}
		bounding_forget(walk, facts, name)
		let n = walk.arena.var(name)
		let fact = walk.arena.equal(n, given)
		bounding_push(walk, facts, fact)
		if own_range != null {
			bounding_bounded(walk, facts, name, own_range ?? Range::open())
		}
		return
	}
	let mut range: Range? = null
	let mut relations: Vec[(bool, i64)] = []
	if op == null && value_lin == null {
		range = bounding_range(walk, value, facts, context, program, words, ask)
		relations = bounding_relations_of(walk, facts, name, value, context, program, words, ask)
	}
	bounding_forget(walk, facts, name)
	if walk.nonnegative.contains(name) || walk.shape.unsigned.contains(name) {
		bounding_at_least_zero(walk, facts, name)
	}
	if range != null {
		bounding_bounded(walk, facts, name, range ?? Range::open())
	}
	// **What the callee is found to hold of its arguments** (ADR-306 D31).
	bounding_relations_push(walk, facts, name, relations)
}

/// How many scalars `"text".scalars` hands, for ASCII text.
fn bounding_literal_chars(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> i64? {
	return match expr {
		// A literal is text, so its `scalars` is the view (ADR-320 D3).
		Expr::Field { base, name, .. } => {
			if words.resolve(name) != "scalars" {
				return null
			}
			bounding_ascii_length(base)
		},
		else => null,
	}
}

/// The length of a literal of ASCII text: its characters, one byte each.
fn bounding_ascii_length(expr: ref Expr) -> i64? {
	return match expr {
		Expr::LitStr { text, .. } => {
			if text.scalars.count() != text.len() {
				return null
			}
			text.len() as i64
		},
		else => null,
	}
}

fn bounding_is_op(op: ref BinaryOp?, wanted: BinaryOp) -> bool {
	let given = op ?? return false
	return given == wanted
}

/// What is known of `name`'s length from the value it was given.
fn bounding_built(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, value: ref Expr, words: ref winnow_grammar::InternerContext) {
	match value {
		Expr::ListLit { items, .. } => {
			let length = length_of(name)
			let len = walk.arena.var(length)
			let n = walk.arena.int(items.len())
			let fact = walk.arena.equal(len, n)
			bounding_push(walk, facts, fact)
		},
		// **A copy is as long as what it copies** (ADR-306 D4).
		Expr::MethodCall { receiver, method, args, .. } => {
			if !args.is_empty() {
				return
			}
			// **A literal's characters, collected**, are as many as it has
			// (#1516); of ASCII text only, where a `String` they are
			// collected into counts its bytes the same.
			if words.resolve(method) == "collect" {
				let count = bounding_literal_chars(receiver, words) ?? return
				let len = walk.arena.var(length_of(name))
				let n = walk.arena.int(count)
				let fact = walk.arena.equal(len, n)
				bounding_push(walk, facts, fact)
				return
			}
			if words.resolve(method) != "clone" {
				return
			}
			let from = path_of(receiver, words) ?? return
			if path_within(from, name) || path_within(name, from) {
				return
			}
			let len = walk.arena.var(length_of(name))
			let copied = walk.arena.var(length_of(from))
			let fact = walk.arena.equal(len, copied)
			bounding_push(walk, facts, fact)
		},
		// Each list field of a literal, as its value is built; a field given
		// a whole-number literal holds it (#1634: `Tally { seen: 0 }` starts
		// a counter a loop then raises).
		Expr::StructLit { fields, .. } => {
			for field in fields {
				let given = field.value ?? continue
				let path = f"{name}.{words.resolve(field.name)}"
				let literal = bounding_step_literal(given)
				if literal != null {
					let v = walk.arena.var(path)
					let c = walk.arena.int(literal ?? 0)
					let fact = walk.arena.equal(v, c)
					bounding_push(walk, facts, fact)
					facts.ints.insert(path.clone())
				}
				bounding_built(walk, facts, path, given, words)
			}
		},
		else => {},
	}
}

/// The target of an assignment: an index there is a write, proved as a read
/// is.
fn bounding_place(
	mut walk: BoundsWalk,
	target: ref Expr,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	match target {
		Expr::Index { base, index, .. } => {
			bounding_place(walk, base, facts, context, program, words, ask)
			bounding_expr(walk, index, facts, context, program, words, ask)
			bounding_index(walk, base, index, facts, context, program, words, ask)
		},
		Expr::Field { base, .. } => bounding_place(walk, base, facts, context, program, words, ask),
		else => {},
	}
}

/// An expression as a statement; whether control never goes past it.
fn bounding_expr_leaves(
	mut walk: BoundsWalk,
	expr: ref Expr,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	match expr {
		Expr::If { cond, then_branch, else_branch, .. } => return bounding_if_leaves(
			walk,
			cond,
			then_branch,
			else_branch,
			facts,
			context,
			program,
			words,
			ask,
		),
		Expr::Return(value, _) => {
			if value != null {
				let returned = value ?? return true
				bounding_expr(walk, returned, facts, context, program, words, ask)
			}
			rules_exit(walk, facts, value, false, context, program, words, ask)
			return true
		},
		Expr::Break(_) => {
			bounding_turn_end(walk, facts, true, true, ask)
			return true
		},
		Expr::Continue(_) => {
			bounding_turn_end(walk, facts, true, false, ask)
			return true
		},
		Expr::Throw(value, _) => {
			bounding_expr(walk, value, facts, context, program, words, ask)
			rules_exit(walk, facts, null, true, context, program, words, ask)
			return true
		},
		// `panic(…)` does not come back.
		Expr::Call { func, args, .. } => {
			let callee = bounding_variable(func, words) ?? ""
			if callee == "panic" {
				for arg in args {
					bounding_expr(walk, arg, facts, context, program, words, ask)
				}
				return true
			}
		},
		else => {},
	}
	bounding_expr(walk, expr, facts, context, program, words, ask)
	return false
}

fn bounding_if_leaves(
	mut walk: BoundsWalk,
	cond: ref Expr,
	then_branch: ref Block,
	else_branch: ref Block?,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> bool {
	bounding_expr(walk, cond, facts, context, program, words, ask)
	let mut then_facts = facts.clone()
	bounding_assume(walk, then_facts, cond, context, program, words)
	let mut then_leaves = bounding_block(
		walk,
		then_branch,
		then_facts,
		context,
		program,
		words,
		ask,
	)
	let mut else_facts = facts.clone()
	bounding_assume_not(walk, else_facts, cond, context, program, words)
	let mut else_leaves = bounding_maybe_block(
		walk,
		else_branch,
		else_facts,
		context,
		program,
		words,
		ask,
	)
	// **The arm a `comptime` condition does not take is not in the
	// program**: what holds after the `if` is what the other arm leaves.
	let decided = bounding_decided(walk, cond, context, words)
	if decided != null {
		if decided ?? false {
			else_leaves = true
		} else {
			then_leaves = true
		}
	}
	if then_leaves && else_leaves {
		return true
	}
	if then_leaves {
		facts.ints = else_facts.ints
		facts.facts = else_facts.facts
	} else if else_leaves {
		facts.ints = then_facts.ints
		facts.facts = then_facts.facts
	} else {
		let mut changed = bounding_changed(then_branch, context, words)
		bounding_extend_maybe(changed, else_branch, context, words)
		bounding_after_change(walk, facts, changed)
		bounding_if_join(walk, facts, changed, then_facts, else_facts, ask)
		bounding_flag_join(walk, facts, changed, then_facts, else_facts, ask)
	}
	return false
}

/// **What a branch holds, under the flag that tells it from the other**
/// (ADR-306 D9, #1634): where one branch ends with `found` up (`found >=
/// 1`) and the other with it down, each fact only the first holds is kept as
/// `found <= 0 || fact`, and the other way round, so `if !found { … }` later
/// reads what held where `found` was set. Both forms hold past the `if`,
/// whatever the flag's type: each is true in either branch.
fn bounding_flag_join(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	changed: ref BoundsChanged,
	then_facts: ref BoundsFacts,
	else_facts: ref BoundsFacts,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if changed.values.is_empty() {
		return
	}
	let mut flags: collections::BTreeSet[String] = collections::BTreeSet()
	bounding_flag_names(walk, then_facts, flags)
	bounding_flag_names(walk, else_facts, flags)
	for flag in flags {
		let n = walk.arena.var(flag)
		let one = walk.arena.int(1)
		let zero = walk.arena.int(0)
		let up = walk.arena.ge(n, one)
		let down = walk.arena.le(n, zero)
		if bounding_proves(walk, then_facts, up, ask) && bounding_proves(walk, else_facts, down, ask) {
			bounding_flag_kept(walk, facts, then_facts, flag, down)
			bounding_flag_kept(walk, facts, else_facts, flag, up)
		} else if bounding_proves(walk, then_facts, down, ask) && bounding_proves(walk, else_facts, up, ask) {
			bounding_flag_kept(walk, facts, then_facts, flag, up)
			bounding_flag_kept(walk, facts, else_facts, flag, down)
		}
	}
}

/// The names a fact of `branch` about one name alone reads (`found >= 1`,
/// `found == 0`): the flags `bounding_flag_join` asks about. A field path
/// or a name the walk made is none.
///
/// **The length of a plain name is a flag too** (#1702): past `if
/// ks.len() == 0 { cols = [] } else { cols = r.cols.clone() }` the first
/// branch's end holds `ks.len() <= 0` and the second's `ks.len() >= 1`, so
/// `ks.len() >= 1 || cols.len() == 0` and `ks.len() <= 0 || cols.len() ==
/// r.cols.len()` are kept.
fn bounding_flag_names(walk: ref BoundsWalk, branch: ref BoundsFacts, mut flags: collections::BTreeSet[String]) {
	for fact in branch.facts {
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(fact, read)
		if read.len() != 1 {
			continue
		}
		for name in read {
			let list = name.strip_suffix(".len()") ?? name
			if !list.contains(".") && !list.contains("#") && !list.contains("[") && !list.contains("(") {
				flags.insert(name.clone())
			}
		}
	}
}

/// Each fact of `branch` that does not hold past the `if` already, and does
/// not read `flag`, kept as `other || fact`: the newest few.
fn bounding_flag_kept(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	branch: ref BoundsFacts,
	flag: ref String,
	other: i64,
) {
	let mut own: Vec[i64] = []
	for fact in branch.facts {
		if !facts.facts.contains(fact) && !bounding_touches(walk, fact, flag) {
			own.push(fact)
		}
	}
	while own.len() > most_flagged() {
		own.remove(0)
	}
	for fact in own {
		let kept = walk.arena.or([other, fact])
		if !facts.facts.contains(kept) {
			bounding_push(walk, facts, kept)
		}
	}
}

/// Walk an expression: prove the indices in it with what holds, and keep
/// what it changes.
fn bounding_expr(
	mut walk: BoundsWalk,
	expr: ref Expr,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	bounding_nonnegative(walk, expr, facts, context, program, words, ask)
	bounding_negation(walk, expr, facts, context, program, words, ask)
	match expr {
		Expr::Index { base, index, .. } => {
			bounding_expr(walk, base, facts, context, program, words, ask)
			bounding_expr(walk, index, facts, context, program, words, ask)
			bounding_index(walk, base, index, facts, context, program, words, ask)
			rules_read_inside(walk, base, index, facts, context, program, words)
		},
		Expr::Binary { op, lhs, rhs, span, .. } => bounding_binary(
			walk,
			op,
			lhs,
			rhs,
			span.start as i64,
			facts,
			context,
			program,
			words,
			ask,
		),
		Expr::If { cond, then_branch, else_branch, .. } => {
			bounding_expr(walk, cond, facts, context, program, words, ask)
			let mut then_facts = facts.clone()
			bounding_assume(walk, then_facts, cond, context, program, words)
			bounding_block(walk, then_branch, then_facts, context, program, words, ask)
			let mut changed = bounding_changed(then_branch, context, words)
			bounding_else(walk, else_branch, cond, facts, changed, context, program, words, ask)
			bounding_after_change(walk, facts, changed)
		},
		Expr::Block(block, _) => bounding_inner_block(
			walk,
			block,
			facts,
			context,
			program,
			words,
			ask,
		),
		Expr::AsyncGroup(block, _, _, _, _) => bounding_inner_block(
			walk,
			block,
			facts,
			context,
			program,
			words,
			ask,
		),
		Expr::Unsafe(block, _) => {
			bounding_inner_block(walk, block, facts, context, program, words, ask)
			// **An `assume` holds past the `unsafe` around it** (ADR-376 D1).
			for cond in prover_assumed_in_unsafe(block, words) {
				bounding_assume(walk, facts, cond, context, program, words)
			}
		},
		Expr::Match { value, arms, .. } => {
			bounding_expr(walk, value, facts, context, program, words, ask)
			let mut changed = nothing_changed()
			let mut ends: Vec[BoundsFacts] = []
			let mut bound: Vec[Vec[String]] = []
			for arm in arms {
				// What is known outside holds in an arm, but of the names
				// its pattern binds: such a name hides an outer one, so
				// what was known of that is forgotten (as a `let` hides).
				let mut inner = facts.clone()
				let mut hidden: Vec[String] = []
				frame_pattern_names(arm.pattern, words, hidden)
				for name in hidden {
					bounding_forget(walk, inner, name)
					inner.ints.remove(name)
				}
				// **An arm's bare name is the value matched** (#1758): of a
				// call's nullable result, the value it holds, of which what
				// the callee is found to return holds.
				match arm.pattern {
					MatchPattern::Path(segments) => {
						if segments.len() == 1 && bounding_found_whole(walk, value, context, words) {
							let name = words.resolve(segments[0]).clone()
							let held = bounding_arm_facts(walk, facts, name, value, context, program, words, ask) ?? []
							if !held.is_empty() {
								inner.ints.insert(name.clone())
								for fact in held {
									bounding_push(walk, inner, fact)
								}
							}
						}
					},
					else => {},
				}
				bounding_maybe_expr(walk, arm.guard, inner, context, program, words, ask)
				// **An arm's block ends with what it changed** (#1702), as an
				// `if`'s branch does: walked as a block of the arm, not as a
				// block inside an expression, which forgets what it changed
				// before the join could read it. An arm that leaves does not
				// reach the join.
				let mut leaves = false
				match arm.body {
					Expr::Block(block, _) => {
						leaves = bounding_block(walk, block, inner, context, program, words, ask)
					},
					else => bounding_expr(walk, arm.body, inner, context, program, words, ask),
				}
				bounding_extend(changed, bounding_changed_in_expr(arm.body, context, words))
				if !leaves {
					ends.push(inner)
					bound.push(hidden)
				}
			}
			bounding_after_change(walk, facts, changed)
			bounding_match_join(walk, facts, changed, ends, bound, ask)
		},
		// Not entered: a lambda or a task may run at any later moment.
		Expr::Closure { .. } => {},
		Expr::Spawn { .. } => {},
		Expr::Overlap(_, _) => {},
		Expr::Select(_, _) => {},
		Expr::MethodCall { receiver, method, args, .. } => {
			bounding_derived_call(
				walk,
				expr,
				words.resolve(method),
				path_of(receiver, words),
				args,
				facts,
				context,
				program,
				words,
				ask,
			)
			bounding_required(
				walk,
				expr,
				receiver,
				words.resolve(method),
				args,
				facts,
				context,
				program,
				words,
				ask,
			)
			bounding_method_call(
				walk,
				expr,
				receiver,
				words.resolve(method),
				args,
				facts,
				context,
				program,
				words,
				ask,
			)
		},
		Expr::SafeMethod { receiver, method, args, .. } => {
			bounding_derived_call(
				walk,
				expr,
				words.resolve(method),
				path_of(receiver, words),
				args,
				facts,
				context,
				program,
				words,
				ask,
			)
			bounding_method_call(
				walk,
				expr,
				receiver,
				words.resolve(method),
				args,
				facts,
				context,
				program,
				words,
				ask,
			)
		},
		Expr::Call { func, args, config, .. } => {
			let called = bounding_variable(func, words)
			if called != null {
				bounding_derived_call(
					walk,
					expr,
					called ?? "",
					null,
					args,
					facts,
					context,
					program,
					words,
					ask,
				)
			}
			bounding_expr(walk, func, facts, context, program, words, ask)
			for arg in args {
				bounding_expr(walk, arg, facts, context, program, words, ask)
			}
			for c in config {
				bounding_expr(walk, c.value, facts, context, program, words, ask)
			}
			// **What an `assert` claims holds after it** (ADR-269 D4): the
			// program stops where it does not. An `assume` is vouched for
			// (ADR-376 D1).
			// **A vector's load lies inside where its cut does** (ADR-377 D3):
			// `0 <= at` and `at + n <= len`, `n` the most a `Lanes` reads.
			let loaded = context.simd_loads[node_key(func)] ?? 0
			if loaded != 0 && args.len() == 2 {
				let list = path_of(args[0], words)
				let read = if loaded < 0 { -loaded } else { loaded }
				if list != null
					&& bounding_word_inside(
						walk,
						list ?? "",
						node_key(args[0]),
						args[1],
						read,
						facts,
						context,
						program,
						words,
						ask,
					) {
						walk.proven.indices.insert(node_key(func))
					} else {
						walk.open += 1
					}
			}
			let claimed = bounding_variable(func, words) ?? ""
			if args.len() == 1 && (claimed == "assert" || claimed == "assume") {
				bounding_assume(walk, facts, args[0], context, program, words)
			}
			let frame = called_function_frame(func, context, words)
			let callee = callee_params(func, context.around, words)
			if walk.checking && loaded == 0 {
				let mut handed: Vec[String] = []
				for at in 0..<args.len() {
					if hands_on(callee, at) {
						handed.push(path_of(args[at], words) ?? continue)
					}
				}
				let changed = rules_changed_by(frame, null, frame_handed(args, words), handed)
				rules_at_call(
					walk,
					expr,
					null,
					claimed,
					args,
					changed,
					facts,
					context,
					program,
					words,
					ask,
				)
			}
			if frame != null && loaded == 0 {
				bounding_by_frame(walk, facts, frame ?? nothing_changed(), func, args, words)
				return
			}
			for at in 0..<args.len() {
				let handed = path_of(args[at], words) ?? continue
				// A load reads its bytes and changes nothing.
				if hands_on(callee, at) && loaded == 0 {
					bounding_forget(walk, facts, handed)
				}
			}
		},
		else => bounding_children(walk, expr, facts, context, program, words, ask),
	}
}

/// **A signed value put where an unsigned type is stated** (ADR-285 D32):
/// proved `>= 0` from what holds before it runs, or left to the conversion.
fn bounding_nonnegative(
	mut walk: BoundsWalk,
	expr: ref Expr,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if walk.collecting || context.nonnegative.is_empty() {
		return
	}
	let node = node_key(expr)
	if !context.nonnegative.contains(node) {
		return
	}
	let term = bounding_lin(walk, expr, facts, context, program, words) ?? return
	let zero = walk.arena.int(0)
	let goal = walk.arena.ge(term, zero)
	if bounding_proves_goal(walk, facts, goal, ask) {
		walk.proven.nonnegative.insert(node)
	} else {
		walk.open += 1
	}
}

fn bounding_maybe_expr(
	mut walk: BoundsWalk,
	expr: ref Expr?,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let present = expr ?? return
	bounding_expr(walk, present, facts, context, program, words, ask)
}

/// An `else` branch, walked with the condition false; what it changes is
/// added to `changed`.
fn bounding_else(
	mut walk: BoundsWalk,
	else_branch: ref Block?,
	cond: ref Expr,
	facts: ref BoundsFacts,
	mut changed: BoundsChanged,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let block = else_branch ?? return
	let mut else_facts = facts.clone()
	bounding_assume_not(walk, else_facts, cond, context, program, words)
	bounding_block(walk, block, else_facts, context, program, words, ask)
	bounding_extend(changed, bounding_changed(block, context, words))
}

/// **What holds past an `if` both of whose branches go on, of what they
/// changed** (#1391): a fact of one branch's end that reads a changed name
/// holds past the `if` where the other branch's end holds it too, or
/// proves it. So `if c { i = i + 1 }` keeps `i - i@ <= t + 1` of the
/// turn's `i - i@ <= t`, where it was forgotten.
fn bounding_if_join(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	changed: ref BoundsChanged,
	then_facts: ref BoundsFacts,
	else_facts: ref BoundsFacts,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if changed.values.is_empty() && changed.lengths.is_empty() {
		return
	}
	let mut kept: Vec[i64] = []
	for fact in bounding_join_candidates(walk, facts, changed, then_facts) {
		if else_facts.facts.contains(fact) || bounding_proves(walk, else_facts, fact, ask) {
			kept.push(fact)
		}
	}
	for fact in bounding_join_candidates(walk, facts, changed, else_facts) {
		if !kept.contains(fact) && bounding_proves(walk, then_facts, fact, ask) {
			kept.push(fact)
		}
	}
	bounding_emptied_join(walk, facts, changed, then_facts, else_facts, kept)
	bounding_emptied_join(walk, facts, changed, else_facts, then_facts, kept)
	for fact in kept {
		bounding_push(walk, facts, fact)
	}
}

/// **What holds past a `match`, of what its arms changed** (#1702), as
/// `bounding_if_join` keeps it past an `if`: a fact of one arm's end that
/// reads a changed name holds past the `match` where every other arm's end
/// holds or proves it. A fact that reads a name the arm's pattern binds is
/// that arm's own. So `match rel { Le => { c = 1 }, Eq => { if odd { ks =
/// [] } } }` keeps `ks.len() == 0 || ks.len() == r.ks.len()`, which the
/// first arm proves of its `ks.len() == r.ks.len()`.
fn bounding_match_join(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	changed: ref BoundsChanged,
	ends: ref Vec[BoundsFacts],
	bound: ref Vec[Vec[String]],
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if (changed.values.is_empty() && changed.lengths.is_empty()) || ends.len() < 2 {
		return
	}
	let mut kept: Vec[i64] = []
	for k in 0..<ends.len() {
		for fact in bounding_join_candidates(walk, facts, changed, ends[k]) {
			if kept.contains(fact) {
				continue
			}
			let mut own = false
			for name in bound[k] {
				if bounding_touches(walk, fact, name) {
					own = true
				}
			}
			let mut every = !own
			for j in 0..<ends.len() {
				if !every || j == k || ends[j].facts.contains(fact) {
					continue
				}
				every = bounding_proves(walk, ends[j], fact, ask)
			}
			if every {
				kept.push(fact)
			}
		}
	}
	for fact in kept {
		bounding_push(walk, facts, fact)
	}
}

/// **A list one branch empties keeps the other branch's facts beside its
/// length** (#1702): where `pinning`'s end holds a changed list's length at
/// a number (`ks.len() == 0` after `ks = []`), each fact of `other`'s end
/// over a changed name that the join did not keep is kept as `ks.len() == 0
/// || fact`, true at either end: so `if c % d != 0 { ks = [] }` keeps
/// `ks.len() == 0 || ks.len() == r.ks.len()`, and a later `ks.len() >= 1`
/// reads the second. The newest few of `other`'s facts.
fn bounding_emptied_join(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	changed: ref BoundsChanged,
	pinning: ref BoundsFacts,
	other: ref BoundsFacts,
	mut kept: Vec[i64],
) {
	let pins = bounding_pinned_lengths(walk, facts, changed, pinning)
	if pins.is_empty() {
		return
	}
	let mut own: Vec[i64] = []
	for fact in bounding_join_candidates(walk, facts, changed, other) {
		if !kept.contains(fact) && !pins.contains(fact) {
			own.push(fact)
		}
	}
	while own.len() > most_flagged() {
		own.remove(0)
	}
	for pin in pins {
		for fact in own {
			let either = walk.arena.or([pin, fact])
			if !kept.contains(either) && !facts.facts.contains(either) {
				kept.push(either)
			}
		}
	}
}

/// The facts of `branch` that pin the length of a name the `if` changed to
/// a number (`ks.len() == 0`), and do not hold past it already.
fn bounding_pinned_lengths(
	walk: ref BoundsWalk,
	facts: ref BoundsFacts,
	changed: ref BoundsChanged,
	branch: ref BoundsFacts,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	for fact in branch.facts {
		if facts.facts.contains(fact) {
			continue
		}
		match walk.arena.at(fact) {
			logic::SolverTerm::Eq(a, b) => {
				let mut name: String? = null
				let mut value: i64? = null
				match walk.arena.at(a) {
					logic::SolverTerm::Var(v) => {
						name = v.clone()
						value = walk.arena.constant(b)
					},
					else => {
						match walk.arena.at(b) {
							logic::SolverTerm::Var(v) => {
								name = v.clone()
								value = walk.arena.constant(a)
							},
							else => {},
						}
					},
				}
				let n = name ?? continue
				if value == null {
					continue
				}
				let list = n.strip_suffix(".len()") ?? continue
				if changed.values.contains(list) || changed.lengths.contains(list) {
					out.push(fact)
				}
			},
			else => {},
		}
	}
	return out
}

/// The facts of a branch's end that read a name, or the length of a list,
/// the `if` changed and do not hold past it already.
///
/// **A name the walk made inside the branch, pinned there to a number, is
/// read as that number** (#1655): a loop's entry length (`#29:cols.len()
/// == 0`) is unknown to the other branch, so `cols.len() - #29:cols.len()
/// >= ks.len()` is also offered as `cols.len() - 0 >= ks.len()`, which the
/// branch holds as well and the other one may prove.
fn bounding_join_candidates(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	changed: ref BoundsChanged,
	branch: ref BoundsFacts,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	for fact in branch.facts {
		if facts.facts.contains(fact) || out.contains(fact) {
			continue
		}
		let mut touched = false
		for name in changed.values {
			if bounding_touches(walk, fact, name) {
				touched = true
				break
			}
		}
		// A list both ends grew or shrank (#1755): `if c { b.push(1) } else
		// { b.push(2) }` keeps `a.len() == b.len()` where both ends hold it.
		for name in changed.lengths {
			if !touched && bounding_touches(walk, fact, length_of(name)) {
				touched = true
			}
		}
		if touched {
			out.push(fact)
		}
	}
	let pinned = bounding_pinned(walk, branch)
	if pinned.is_empty() {
		return out
	}
	let mut settled: Vec[i64] = []
	for fact in out {
		let mut read: collections::BTreeSet[String] = collections::BTreeSet()
		walk.arena.variables(fact, read)
		let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
		for v in read {
			if pinned.contains_key(v) {
				given.insert(v.clone(), walk.arena.int(pinned[v] ?? 0))
			}
		}
		if given.is_empty() {
			continue
		}
		let plain = walk.arena.substitute(fact, given)
		if !out.contains(plain) && !settled.contains(plain) && !facts.facts.contains(plain) {
			settled.push(plain)
		}
	}
	for fact in settled {
		out.push(fact)
	}
	return out
}

/// The names the walk made (`#` in them: a loop's entry value, a renamed
/// value) that a fact of `branch` pins to a number, `x == n`.
fn bounding_pinned(walk: ref BoundsWalk, branch: ref BoundsFacts) -> collections::BTreeMap[String, i64] {
	let mut out: collections::BTreeMap[String, i64] = collections::BTreeMap()
	for fact in branch.facts {
		match walk.arena.at(fact) {
			logic::SolverTerm::Eq(a, b) => {
				let mut name: String? = null
				let mut value: i64? = null
				match walk.arena.at(a) {
					logic::SolverTerm::Var(v) => {
						name = v.clone()
						value = walk.arena.constant(b)
					},
					else => {
						match walk.arena.at(b) {
							logic::SolverTerm::Var(v) => {
								name = v.clone()
								value = walk.arena.constant(a)
							},
							else => {},
						}
					},
				}
				let n = name ?? continue
				let k = value ?? continue
				if n.contains("#") {
					out.insert(n, k)
				}
			},
			else => {},
		}
	}
	return out
}

/// A block inside an expression: walked with what holds here, and what it
/// changes forgotten after it.
fn bounding_inner_block(
	mut walk: BoundsWalk,
	block: ref Block,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let mut inner = facts.clone()
	bounding_block(walk, block, inner, context, program, words, ask)
	let changed = bounding_changed(block, context, words)
	bounding_after_change(walk, facts, changed)
}

fn bounding_binary(
	mut walk: BoundsWalk,
	op: ref BinaryOp,
	lhs: ref Expr,
	rhs: ref Expr,
	at: i64,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	match op {
		// The right side runs only where the left one decided it does.
		BinaryOp::And => {
			bounding_expr(walk, lhs, facts, context, program, words, ask)
			let mut right = facts.clone()
			bounding_assume(walk, right, lhs, context, program, words)
			bounding_expr(walk, rhs, right, context, program, words, ask)
			let changed = bounding_changed_in_expr(rhs, context, words)
			bounding_after_change(walk, facts, changed)
			return
		},
		BinaryOp::Or => {
			bounding_expr(walk, lhs, facts, context, program, words, ask)
			let mut right = facts.clone()
			bounding_assume_not(walk, right, lhs, context, program, words)
			bounding_expr(walk, rhs, right, context, program, words, ask)
			let changed = bounding_changed_in_expr(rhs, context, words)
			bounding_after_change(walk, facts, changed)
			return
		},
		else => {},
	}
	bounding_expr(walk, lhs, facts, context, program, words, ask)
	bounding_expr(walk, rhs, facts, context, program, words, ask)
	// **A shift's count is a goal, as an index is** (ADR-306 D18): `0 <= k`
	// and `k` below the width of the shifted value's type.
	let shifted = context.shifts[at]
	if shifted != null && !bounding_literal(rhs) {
		if !walk.collecting
			&& bounding_count_fits(walk, rhs, shifted ?? "", facts, context, program, words, ask) {
				walk.proven.arithmetic.insert(at)
			} else if !walk.collecting {
				walk.open += 1
			}
		return
	}
	// **A divisor that is not zero** (ADR-396 D7, #1578): proved, it is
	// listed so by `--bounds`; its check stays (ADR-395 D3), which every
	// reader of `arithmetic` keeps, since none reads a `/` or `%` there.
	let divided = context.divisions[at]
	if divided != null {
		if !walk.collecting
			&& bounding_divides(walk, lhs, rhs, divided ?? "", facts, context, program, words, ask) {
				walk.proven.arithmetic.insert(at)
			}
		return
	}
	// **An operation that stays inside its type** (ADR-306 D6): its
	// operands first, in the order they run.
	let arithmetic = match op {
		BinaryOp::Add => true,
		BinaryOp::Sub => true,
		BinaryOp::Mul => true,
		else => false,
	}
	if !arithmetic || walk.collecting {
		return
	}
	let ty = context.arithmetic[at] ?? return
	if bounding_fits(walk, op, lhs, rhs, ty, facts, context, program, words, ask) {
		walk.proven.arithmetic.insert(at)
	} else {
		walk.open += 1
	}
}

fn bounding_method_call(
	mut walk: BoundsWalk,
	call: ref Expr,
	receiver: ref Expr,
	method: ref String,
	args: ref Vec[Expr],
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	bounding_expr(walk, receiver, facts, context, program, words, ask)
	for arg in args {
		bounding_expr(walk, arg, facts, context, program, words, ask)
	}
	let written = writes_a_value(method, args.len())
	if written != null {
		let key = elements_key(walk.shape, receiver, words)
		if key != null {
			bounding_write(walk, key ?? "", args[written ?? 0], facts, context, program, words, ask)
		}
	}
	// **A method of this program changes only what its frame names**
	// (ADR-391 D2): what it writes through `mut self` and its `mut`
	// parameters, put onto the receiver and the arguments.
	let frame = called_frame(call, method, context)
	let receiver_path = path_of(receiver, words)
	if walk.checking {
		let mut handed: Vec[String] = []
		if context.around.changing_receivers.contains(method) {
			// An inner list (`t.col[c]`) is part of its list (ADR-306 D28).
			handed.push(path_of(receiver, words) ?? rules_inner_of(receiver, words) ?? "self")
		}
		if context.around.changing_methods.contains(method) {
			for arg in args {
				handed.push(path_of(arg, words) ?? continue)
			}
		}
		let changed = rules_changed_by(frame, receiver_path, frame_handed(args, words), handed)
		rules_at_call(
			walk,
			call,
			receiver_path,
			method,
			args,
			changed,
			facts,
			context,
			program,
			words,
			ask,
		)
	}
	if frame != null {
		let known = frame ?? nothing_changed()
		bounding_by_frame(walk, facts, known, receiver, args, words)
		let written = frame_at_call(known, receiver_path, frame_handed(args, words))
		rules_after_call(walk, facts, call, path_of(receiver, words), context, false, written)
		return
	}
	// **A method on an element may change it** and, the index not being
	// known to differ, any element's same fields (#781).
	if context.around.changing_receivers.contains(method) || !keeps_length(method) {
		bounding_forget_aliases(walk, facts, receiver, words)
	}
	if receiver_path != null {
		let name = receiver_path ?? ""
		// **A word read lies inside where its cut does** (ADR-320 D12):
		// `0 <= at` and `at + n <= len`.
		let width = bytes_word_width(method)
		if width > 0 && args.len() == 1 {
			if bounding_word_inside(
				walk,
				name,
				node_key(receiver),
				args[0],
				width,
				facts,
				context,
				program,
				words,
				ask,
			) {
				walk.proven.indices.insert(node_key(receiver))
			} else {
				walk.open += 1
			}
		}
		// **A method that may change its receiver changes the paths of
		// fields from it** (ADR-306 D17): one of this program's that takes
		// its receiver `mut`, or one `keeps_length` does not know. What a
		// `truncate` leaves of an ordered list is read first (#1785).
		let left = rules_truncated(walk, facts, name, method, args, context, program, words, ask)
		if context.around.changing_receivers.contains(method) || !keeps_length(method) {
			bounding_forget_parts(walk, facts, name)
		} else if !keeps_items(method) {
			// One that moves or overwrites its items (`sort`, `fill`) changes
			// each element read by its index (ADR-306 D33).
			bounding_forget_element(walk, facts, f"{name}|*|", false)
		}
		bounding_method(walk, facts, name, method, args, context, program, words, ask)
		for fact in left {
			bounding_push(walk, facts, fact)
		}
		rules_capped_call(walk, name, method)
	}
	// **Only a `mut` parameter changes what it is handed** (ADR-094 D3):
	// every other argument is `ref`, or a `Bytes` or a text view that no
	// method changes (ADR-320), and keeps its length and its values.
	if context.around.changing_methods.contains(method) {
		for arg in args {
			bounding_forget_aliases(walk, facts, arg, words)
			let text = path_of(arg, words) ?? continue
			bounding_forget(walk, facts, text)
		}
	}
	rules_after_call(walk, facts, call, path_of(receiver, words), context, true, nothing_changed())
}

/// A method on a name: what it does to the name's length.
fn bounding_method(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	name: ref String,
	method: ref String,
	args: ref Vec[Expr],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if keeps_length(method) || facts.ints.contains(name) {
		return
	}
	let length = length_of(name)
	let count = args.len()
	if (method == "push" && count == 1) || (method == "insert" && count == 2) {
		let one = walk.arena.int(1)
		bounding_shift(walk, facts, length, one)
		// **A list just grown holds at least one element**: a fact of the
		// length even where none was left, as at the head of a loop that
		// grows it, so a value below it is seen to be (ADR-306 D21).
		let len = walk.arena.var(length)
		let fact = walk.arena.ge(len, one)
		bounding_push(walk, facts, fact)
		return
	}
	if (method == "remove" || method == "swap_remove") && count == 1 {
		let one = walk.arena.int(-1)
		bounding_shift(walk, facts, length, one)
		return
	}
	// **`truncate(n)` with `n` at most the length leaves `n`** (ADR-306
	// D34): `heap.truncate(last)` after `last = heap.len() - 1`. An `n`
	// that reads the length itself is not carried past it.
	if method == "truncate" && count == 1 {
		let to = bounding_lin(walk, args[0], facts, context, program, words)
		if to != null {
			let n = to ?? 0
			let mut read: collections::BTreeSet[String] = collections::BTreeSet()
			walk.arena.variables(n, read)
			let len = walk.arena.var(length)
			let within = walk.arena.le(n, len)
			if !read.contains(length) && bounding_proves(walk, facts, within, ask) {
				bounding_forget_length(walk, facts, name)
				let now = walk.arena.var(length)
				let fact = walk.arena.equal(now, n)
				bounding_push(walk, facts, fact)
				return
			}
		}
	}
	if method == "clear" && count == 0 {
		bounding_forget_length(walk, facts, name)
		let len = walk.arena.var(length)
		let zero = walk.arena.int(0)
		let fact = walk.arena.equal(len, zero)
		bounding_push(walk, facts, fact)
		return
	}
	if method == "resize" && count == 2 {
		let to = bounding_lin(walk, args[0], facts, context, program, words)
		bounding_forget_length(walk, facts, name)
		if to != null {
			let len = walk.arena.var(length)
			let fact = walk.arena.equal(len, to ?? 0)
			bounding_push(walk, facts, fact)
		}
		return
	}
	// **`extend(other)` adds `other`'s length** (#383): a name only, whose
	// length is whatever the walk knows of it - nothing, where it is not a
	// list, which leaves this length unbounded. As intervals, read before
	// either length is forgotten: `other` is handed over, and what is known
	// of it goes with it.
	if method == "extend" && count == 1 {
		let other = bounding_variable(args[0], words) ?? ""
		if !other.is_empty() && other != name {
			let mine = walk.arena.var(length)
			let theirs = walk.arena.var(length_of(other))
			let mine_known = bounding_term(walk, mine, facts, ask)
			let theirs_known = bounding_term(walk, theirs, facts, ask)
			bounding_forget_length(walk, facts, name)
			let len = walk.arena.var(length)
			if mine_known.lo != null && theirs_known.lo != null {
				let lo = (mine_known.lo ?? 0).checked_add(theirs_known.lo ?? 0)
				if lo != null {
					let k = walk.arena.int(lo ?? 0)
					let fact = walk.arena.ge(len, k)
					bounding_push(walk, facts, fact)
				}
			}
			if mine_known.hi != null && theirs_known.hi != null {
				let hi = (mine_known.hi ?? 0).checked_add(theirs_known.hi ?? 0)
				if hi != null {
					let k = walk.arena.int(hi ?? 0)
					let fact = walk.arena.le(len, k)
					bounding_push(walk, facts, fact)
				}
			}
			return
		}
	}
	bounding_forget_length(walk, facts, name)
}

/// Each expression directly inside `expr`, then each block, of the
/// expressions `bounding_expr` does not take apart itself.
fn bounding_children(
	mut walk: BoundsWalk,
	expr: ref Expr,
	mut facts: BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	match expr {
		Expr::Range { start, end, .. } => {
			bounding_expr(walk, start, facts, context, program, words, ask)
			bounding_expr(walk, end, facts, context, program, words, ask)
		},
		Expr::Tuple(items, _) => {
			for item in items {
				bounding_expr(walk, item, facts, context, program, words, ask)
			}
		},
		Expr::ListRepeat { value, count, .. } => {
			bounding_expr(walk, value, facts, context, program, words, ask)
			bounding_expr(walk, count, facts, context, program, words, ask)
		},
		Expr::ListLit { items, .. } => {
			for item in items {
				bounding_expr(walk, item, facts, context, program, words, ask)
			}
		},
		Expr::LitInterpolated { parts, .. } => {
			for part in parts {
				match part {
					FPart::Hole { expr, .. } => bounding_expr(
						walk,
						expr,
						facts,
						context,
						program,
						words,
						ask,
					),
					else => {},
				}
			}
		},
		Expr::Field { base, .. } => bounding_expr(walk, base, facts, context, program, words, ask),
		Expr::SafeField { base, .. } => bounding_expr(
			walk,
			base,
			facts,
			context,
			program,
			words,
			ask,
		),
		Expr::StructLit { name, fields, .. } => {
			for field in fields {
				bounding_maybe_expr(walk, field.value, facts, context, program, words, ask)
			}
			bounding_field_inits(walk, fields, facts, context, program, words, ask)
			// A list given by a name keeps the `length` rules only where
			// the names are as long (#1652).
			if walk.checking && node_key(expr) != walk.rule_built_literal {
				rules_literal_holds(walk, words.resolve(name), fields, facts, context, program, words, ask)
			}
		},
		Expr::With { base, fields, .. } => {
			bounding_expr(walk, base, facts, context, program, words, ask)
			for field in fields {
				bounding_maybe_expr(walk, field.value, facts, context, program, words, ask)
			}
			bounding_field_inits(walk, fields, facts, context, program, words, ask)
		},
		Expr::Unary { expr, .. } => bounding_expr(walk, expr, facts, context, program, words, ask),
		Expr::Try(inner, _) => {
			bounding_expr(walk, inner, facts, context, program, words, ask)
			rules_exit(walk, facts, null, true, context, program, words, ask)
		},
		Expr::Async(inner, _, _, _) => bounding_expr(walk, inner, facts, context, program, words, ask),
		Expr::Throw(inner, _) => {
			bounding_expr(walk, inner, facts, context, program, words, ask)
			rules_exit(walk, facts, null, true, context, program, words, ask)
		},
		Expr::Cast { expr, .. } => bounding_expr(walk, expr, facts, context, program, words, ask),
		Expr::TryCatch { expr, handler, .. } => {
			bounding_expr(walk, expr, facts, context, program, words, ask)
			bounding_inner_block(walk, handler, facts, context, program, words, ask)
		},
		Expr::Return(value, _) => {
			bounding_maybe_expr(walk, value, facts, context, program, words, ask)
			rules_exit(walk, facts, value, false, context, program, words, ask)
		},
		Expr::Coalesce { value, fallback, .. } => {
			bounding_expr(walk, value, facts, context, program, words, ask)
			bounding_expr(walk, fallback, facts, context, program, words, ask)
		},
		else => {},
	}
}

// --- what a block changes --------------------------------------------------

fn bounding_extend(mut changed: BoundsChanged, other: BoundsChanged) {
	changed.values.extend(other.values.clone())
	changed.lengths.extend(other.lengths.clone())
	changed.parts.extend(other.parts.clone())
	changed.jumps.extend(other.jumps.clone())
	changed.drops.extend(other.drops.clone())
	changed.falls.extend(other.falls.clone())
	changed.bare_falls.extend(other.bare_falls.clone())
	changed.elements.extend(other.elements.clone())
}

fn bounding_extend_maybe(
	mut changed: BoundsChanged,
	block: ref Block?,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	let present = block ?? return
	bounding_extend(changed, bounding_changed(present, context, words))
}

/// **The names whose value, and the lists whose length, `block` may
/// change**, in it and the blocks inside it, lambdas included. A `let` in a
/// nested block hides a name only there; the walk forgets it where it is
/// bound. One in a loop's body is bound again each turn, which the walk sees
/// the same way.
fn bounding_changed(
	block: ref Block,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> BoundsChanged {
	let mut out = nothing_changed()
	changed_in_block(block, context, words, out)
	return out
}

fn bounding_changed_in_expr(
	expr: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> BoundsChanged {
	let mut out = nothing_changed()
	changed_in_expr(expr, context, words, out)
	return out
}

fn changed_in_block(
	block: ref Block,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	for stmt in block.stmts {
		match stmt.node {
			Stmt::Assign { target, op, value } => {
				let written = path_of(target, words)
				if written != null {
					let name = written ?? ""
					if !bounding_steps_up(name, op, value, words) {
						out.jumps.insert(name.clone())
					}
					if !bounding_steps_down(name, op, value, words) {
						out.drops.insert(name.clone())
					}
					out.lengths.insert(name.clone())
					changed_falls(out, name)
					out.values.insert(name)
				}
				bounding_element_changed(target, words, out)
				changed_in_expr(target, context, words, out)
				changed_in_expr(value, context, words, out)
			},
			Stmt::For { iter, body, .. } => {
				changed_in_expr(iter, context, words, out)
				changed_in_block(body, context, words, out)
			},
			Stmt::While { cond, body } => {
				changed_in_expr(cond, context, words, out)
				changed_in_block(body, context, words, out)
			},
			Stmt::Let { value, .. } => changed_in_expr(value, context, words, out),
			Stmt::Comptime { value, .. } => changed_in_expr(value, context, words, out),
			Stmt::Expr(value) => changed_in_expr(value, context, words, out),
			Stmt::Return(value) => changed_in_maybe(value, context, words, out),
			else => {},
		}
	}
}

fn changed_in_maybe(
	expr: ref Expr?,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	let present = expr ?? return
	changed_in_expr(present, context, words, out)
}

fn changed_in_all(
	exprs: ref Vec[Expr],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	for e in exprs {
		changed_in_expr(e, context, words, out)
	}
}

/// `expr`, every expression inside it and every block inside it.
fn changed_in_expr(
	expr: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	changed_by(expr, context, words, out)
	match expr {
		Expr::Match { value, arms, .. } => {
			changed_in_expr(value, context, words, out)
			for arm in arms {
				changed_in_maybe(arm.guard, context, words, out)
				changed_in_expr(arm.body, context, words, out)
			}
		},
		Expr::Range { start, end, .. } => {
			changed_in_expr(start, context, words, out)
			changed_in_expr(end, context, words, out)
		},
		Expr::Tuple(items, _) => changed_in_all(items, context, words, out),
		Expr::ListRepeat { value, count, .. } => {
			changed_in_expr(value, context, words, out)
			changed_in_expr(count, context, words, out)
		},
		Expr::ListLit { items, .. } => changed_in_all(items, context, words, out),
		Expr::LitInterpolated { parts, .. } => {
			for part in parts {
				match part {
					FPart::Hole { expr, .. } => changed_in_expr(expr, context, words, out),
					else => {},
				}
			}
		},
		Expr::If { cond, then_branch, else_branch, .. } => {
			changed_in_expr(cond, context, words, out)
			changed_in_block(then_branch, context, words, out)
			changed_in_maybe_block(else_branch, context, words, out)
		},
		Expr::Call { func, args, config, .. } => {
			changed_in_expr(func, context, words, out)
			changed_in_all(args, context, words, out)
			for c in config {
				changed_in_expr(c.value, context, words, out)
			}
		},
		Expr::Spawn { body, .. } => changed_in_expr(body, context, words, out),
		Expr::MethodCall { receiver, args, config, .. } => {
			changed_in_expr(receiver, context, words, out)
			changed_in_all(args, context, words, out)
			for c in config {
				changed_in_expr(c.value, context, words, out)
			}
		},
		Expr::SafeMethod { receiver, args, config, .. } => {
			changed_in_expr(receiver, context, words, out)
			changed_in_all(args, context, words, out)
			for c in config {
				changed_in_expr(c.value, context, words, out)
			}
		},
		Expr::Field { base, .. } => changed_in_expr(base, context, words, out),
		Expr::SafeField { base, .. } => changed_in_expr(base, context, words, out),
		Expr::StructLit { fields, .. } => {
			for field in fields {
				changed_in_maybe(field.value, context, words, out)
			}
		},
		Expr::With { base, fields, .. } => {
			changed_in_expr(base, context, words, out)
			for field in fields {
				changed_in_maybe(field.value, context, words, out)
			}
		},
		Expr::Unary { expr, .. } => changed_in_expr(expr, context, words, out),
		Expr::Try(inner, _) => changed_in_expr(inner, context, words, out),
		Expr::Async(inner, _, _, _) => changed_in_expr(inner, context, words, out),
		Expr::Throw(inner, _) => changed_in_expr(inner, context, words, out),
		Expr::Cast { expr, .. } => changed_in_expr(expr, context, words, out),
		Expr::TryCatch { expr, handler, .. } => {
			changed_in_expr(expr, context, words, out)
			changed_in_block(handler, context, words, out)
		},
		Expr::Binary { lhs, rhs, .. } => {
			changed_in_expr(lhs, context, words, out)
			changed_in_expr(rhs, context, words, out)
		},
		Expr::Return(value, _) => changed_in_maybe(value, context, words, out),
		Expr::Index { base, index, .. } => {
			changed_in_expr(base, context, words, out)
			changed_in_expr(index, context, words, out)
		},
		Expr::Coalesce { value, fallback, .. } => {
			changed_in_expr(value, context, words, out)
			changed_in_expr(fallback, context, words, out)
		},
		Expr::Select(arms, _) => {
			for arm in arms {
				changed_in_expr(arm.value, context, words, out)
				changed_in_block(arm.body, context, words, out)
			}
		},
		Expr::Block(b, _) => changed_in_block(b, context, words, out),
		Expr::AsyncGroup(b, _, _, _, _) => changed_in_block(b, context, words, out),
		Expr::Overlap(b, _) => changed_in_block(b, context, words, out),
		Expr::Unsafe(b, _) => changed_in_block(b, context, words, out),
		Expr::Closure { body, .. } => changed_in_block(body, context, words, out),
		else => {},
	}
}

fn changed_in_maybe_block(
	block: ref Block?,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	let present = block ?? return
	changed_in_block(present, context, words, out)
}

/// What one expression changes itself: a method's receiver's length and
/// what it is handed, a call's arguments its callee may change.
fn changed_by(
	expr: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	match expr {
		Expr::MethodCall { receiver, method, args, .. } => changed_by_method(
			expr,
			receiver,
			words.resolve(method),
			args,
			context,
			words,
			out,
		),
		Expr::SafeMethod { receiver, method, args, .. } => changed_by_method(
			expr,
			receiver,
			words.resolve(method),
			args,
			context,
			words,
			out,
		),
		Expr::Call { func, args, .. } => {
			let frame = called_function_frame(func, context, words)
			if frame != null && !context.simd_loads.contains_key(node_key(func)) {
				changed_by_frame(frame ?? nothing_changed(), func, args, words, out)
				return
			}
			let callee = callee_params(func, context.around, words)
			for at in 0..<args.len() {
				let handed = path_of(args[at], words) ?? continue
				// A vector's load reads its bytes and changes nothing.
				if hands_on(callee, at) && !context.simd_loads.contains_key(node_key(func)) {
					out.lengths.insert(handed.clone())
					changed_falls(out, handed)
					out.jumps.insert(handed.clone())
					out.drops.insert(handed.clone())
					out.values.insert(handed)
				}
			}
		},
		else => {},
	}
}

fn changed_by_method(
	call: ref Expr,
	receiver: ref Expr,
	method: ref String,
	args: ref Vec[Expr],
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	// A method of this program changes what its frame names (ADR-391 D2).
	let frame = called_frame(call, method, context)
	if frame != null {
		let mut got = nothing_changed()
		changed_by_frame(frame ?? nothing_changed(), receiver, args, words, got)
		// A field of the receiver the method shortens falls through a method
		// of its own value, which keeps its type's rules (#1808).
		let on = path_of(receiver, words)
		if on != null {
			let root = on ?? ""
			let mut bare: collections::BTreeSet[String] = collections::BTreeSet()
			for path in got.bare_falls {
				let field = path.strip_prefix(root)?.strip_prefix(".") ?? ""
				if field.is_empty() || field.contains(".") {
					bare.insert(path.clone())
				}
			}
			got.bare_falls = bare
		}
		bounding_extend(out, got)
		return
	}
	if context.around.changing_receivers.contains(method) || !keeps_length(method) {
		bounding_element_changed(receiver, words, out)
	}
	let receiver_path = path_of(receiver, words)
	if receiver_path != null {
		let name = receiver_path ?? ""
		if !keeps_length(method) {
			out.lengths.insert(name.clone())
			if !only_adds(method) {
				changed_falls(out, name)
			}
		}
		// A method that may change its receiver changes the paths of fields
		// from it (ADR-306 D17); one that moves or overwrites its items,
		// each element read by its index (D33).
		if context.around.changing_receivers.contains(method) || !keeps_length(method) {
			out.parts.insert(name)
		} else if !keeps_items(method) {
			out.elements.insert(f"{name}|*|")
		}
	}
	// Only a `mut` parameter changes what it is handed (ADR-094 D3).
	if context.around.changing_methods.contains(method) {
		for arg in args {
			bounding_element_changed(arg, words, out)
			let text = path_of(arg, words) ?? continue
			out.values.insert(text.clone())
			out.jumps.insert(text.clone())
			out.drops.insert(text.clone())
			changed_falls(out, text)
			out.lengths.insert(text)
		}
	}
}

// --- frames (ADR-391 D2) -----------------------------------------------------

/// **The frame of the method a call runs** (ADR-391 D2), found by its
/// receiver's own type (`Type::method`); none where the type is not one of
/// this program's, is generic, or the method has no frame.
fn called_frame(call: ref Expr, method: ref String, context: ref BoundsContext) -> BoundsChanged? {
	let owner = context.std_receivers.get(node_key(call)) ?? return null
	return context.around.frames.get(f"{owner}::{method}")?.clone()
}

/// The frame of the free function a call names.
fn called_function_frame(
	func: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> BoundsChanged? {
	let name = bounding_variable(func, words) ?? return null
	return context.around.frames.get(name)?.clone()
}

/// The paths of fields a call hands its callee, by position.
fn frame_handed(args: ref Vec[Expr], words: ref winnow_grammar::InternerContext) -> Vec[String?] {
	return args.iter().map(fn(arg) { path_of(arg, words) }).collect()
}

/// **What a call forgets by its callee's frame**: the paths it names, put
/// onto the receiver (`on`) and the arguments; and where it writes through
/// one that is an element, that element's same fields of every element
/// (#781). A free function's `on` is its name, never written.
fn bounding_by_frame(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	frame: ref BoundsChanged,
	on: ref Expr,
	args: ref Vec[Expr],
	words: ref winnow_grammar::InternerContext,
) {
	if frame_writes(frame, "#self") {
		bounding_forget_aliases(walk, facts, on, words)
	}
	for (at, arg) in args.iter().enumerate() {
		if frame_writes(frame, f"#{at}") {
			bounding_forget_aliases(walk, facts, arg, words)
		}
	}
	let changed = frame_at_call(frame, path_of(on, words), frame_handed(args, words))
	bounding_after_change(walk, facts, changed)
}

/// What a call changes by its callee's frame, added to `out`.
fn changed_by_frame(
	frame: ref BoundsChanged,
	on: ref Expr,
	args: ref Vec[Expr],
	words: ref winnow_grammar::InternerContext,
	mut out: BoundsChanged,
) {
	if frame_writes(frame, "#self") {
		bounding_element_changed(on, words, out)
	}
	for (at, arg) in args.iter().enumerate() {
		if frame_writes(frame, f"#{at}") {
			bounding_element_changed(arg, words, out)
		}
	}
	bounding_extend(out, frame_at_call(frame, path_of(on, words), frame_handed(args, words)))
}

/// **What every function of the file returns, found** (ADR-306 D23): each
/// free function that hands back a whole number or a list of them and takes
/// a list, walked for the list parameters its every return lies below. A
/// call in a cycle (a recursive `find`) takes the bound as D7's third pass
/// takes a loop's: every one is assumed, then each walk keeps those proved
/// at every return under the assumption, until none is dropped. A name
/// two free functions share has none.
fn bounds_returns(
	mut context: BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	let mut assumed: collections::BTreeMap[String, BoundsReturns] = collections::BTreeMap()
	let mut bodies: Vec[ref Spanned[Item]] = []
	let mut keys: Vec[String] = []
	// A name two free functions share is no candidate: a call is resolved
	// by its name alone.
	let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
	let mut twice: collections::BTreeSet[String] = collections::BTreeSet()
	// **Each type's list fields** (ADR-306 D34): a method's `self.X`
	// counts as the list parameters do.
	let mut list_fields: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
	// **Each type's whole-number fields** (ADR-306 D35): a function
	// returning the type is walked once for each.
	let mut whole_fields: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
	for item in program.items {
		match item.node {
			Item::Struct { name, generics, fields, .. } => {
				if !generics.is_empty() {
					continue
				}
				let mut lists: Vec[String] = []
				let mut wholes: Vec[String] = []
				for field in fields {
					if bounding_is_list_type(field.ty, words) {
						lists.push(words.resolve(field.name).clone())
					} else if !(bounding_returns_each(field.ty, words) ?? true) {
						wholes.push(words.resolve(field.name).clone())
					}
				}
				list_fields.insert(words.resolve(name).clone(), lists)
				whole_fields.insert(words.resolve(name).clone(), wholes)
			},
			else => {},
		}
	}
	for item in program.items {
		match item.node {
			Item::Fn { name, receiver, .. } => {
				if receiver == null {
					let named = words.resolve(name ?? continue).clone()
					if seen.contains(named) {
						twice.insert(named)
					} else {
						seen.insert(named)
					}
				}
			},
			else => {},
		}
	}
	for item in program.items {
		match item.node {
			Item::Fn { name, generics, receiver, args, config, spread, ret_type, .. } => {
				if receiver != null || !config.is_empty() || spread != null || !generics.is_empty() {
					continue
				}
				let symbol = name ?? continue
				if twice.contains(words.resolve(symbol)) {
					continue
				}
				let ret = ret_type ?? continue
				let kind = bounding_returns_kind(ret, words)
				let measures = bounding_returns_measures(ret, list_fields, words)
				// **A struct's whole-number fields, each its own entry** (ADR-306
				// D35), read as a whole number is.
				let mut projections: Vec[String] = []
				if kind == null {
					projections = bounding_struct_wholes(ret, whole_fields, words)
				}
				if kind == null && measures.is_empty() && projections.is_empty() {
					continue
				}
				let each = kind ?? false
				let mut below: collections::BTreeSet[i64] = collections::BTreeSet()
				let mut at_least: collections::BTreeSet[i64] = collections::BTreeSet()
				if kind != null || !projections.is_empty() {
					for k in 0..<args.len() {
						if bounding_is_list_type(args[k].ty, words) {
							below.insert(k)
						} else if !each && args[k].ty.generics.is_empty() && is_whole_number(words.resolve(args[k].ty.name)) {
							at_least.insert(k)
						}
					}
				}
				// **A whole number's relations** (D31): to its whole-number
				// arguments and the lengths of its lists.
				let within = if each { collections::BTreeSet() } else { below.clone() }
				// A list of numbers may be bounded by its values alone (D24),
				// a whole number by its interval (D32).
				if kind != null || !measures.is_empty() {
					let key = words.resolve(symbol).clone()
					let mut found = BoundsReturns {
						each: each,
						below: below.clone(),
						sized: collections::BTreeSet(),
						range: null,
						pending: true,
						at_least: at_least.clone(),
						within: within.clone(),
						under: within.clone(),
						fields: [],
						plain: kind != null,
						measures: [],
						lengths: collections::BTreeMap(),
						reaches: collections::BTreeMap(),
						listed: collections::BTreeSet(),
						alike: collections::BTreeSet(),
						guards: collections::BTreeSet(),
						projected: "",
					}
					if kind == null {
						// Of a struct, its lengths alone: the bounds above are read
						// for its whole-number fields, each below (D35).
						found.below = collections::BTreeSet()
						found.at_least = collections::BTreeSet()
						found.within = collections::BTreeSet()
						found.under = collections::BTreeSet()
					}
					bounding_returns_measured(found, measures, args, words)
					assumed.insert(key.clone(), found)
					bodies.push(item)
					keys.push(key)
				}
				for projected in projections {
					let key = bounding_projected_key(words.resolve(symbol).clone(), projected)
					assumed.insert(key.clone(), BoundsReturns {
						each: false,
						below: below.clone(),
						sized: collections::BTreeSet(),
						range: null,
						pending: true,
						at_least: at_least.clone(),
						within: within.clone(),
						under: within.clone(),
						fields: [],
						plain: true,
						measures: [],
						lengths: collections::BTreeMap(),
						reaches: collections::BTreeMap(),
						listed: collections::BTreeSet(),
						alike: collections::BTreeSet(),
						guards: collections::BTreeSet(),
						projected: projected.clone(),
					})
					bodies.push(item)
					keys.push(key)
				}
			},
			// **A method, read as a free function with `self` as one more
			// argument** (ADR-306 D34): of an inherent `impl` of a type
			// declared here, keyed `Type.method` (`bounding_found_key`).
			Item::Impl { trait_name, target, methods } => {
				if trait_name != null || !target.generics.is_empty() {
					continue
				}
				let owner = words.resolve(target.name).clone()
				let lists = list_fields.get(owner)?.clone() ?? continue
				for method in methods {
					match method.node {
						Item::Fn { name, generics, receiver, args, config, spread, ret_type, .. } => {
							let taken = receiver ?? continue
							if !config.is_empty() || spread != null || !generics.is_empty() || taken.is_keep {
								continue
							}
							let symbol = name ?? continue
							let ret = ret_type ?? continue
							let kind = bounding_returns_kind(ret, words)
							let measures = bounding_returns_measures(ret, list_fields, words)
							// **A struct's whole-number fields, each its own entry** (ADR-306
							// D35), read as a whole number is.
							let mut projections: Vec[String] = []
							if kind == null {
								projections = bounding_struct_wholes(ret, whole_fields, words)
							}
							if kind == null && measures.is_empty() && projections.is_empty() {
								continue
							}
							let each = kind ?? false
							let mut below: collections::BTreeSet[i64] = collections::BTreeSet()
							let mut at_least: collections::BTreeSet[i64] = collections::BTreeSet()
							let mut within: collections::BTreeSet[i64] = collections::BTreeSet()
							if kind != null || !projections.is_empty() {
								for k in 0..<args.len() {
									if bounding_is_list_type(args[k].ty, words) {
										below.insert(k)
									} else if !each && args[k].ty.generics.is_empty() && is_whole_number(words.resolve(args[k].ty.name)) {
										at_least.insert(k)
									}
								}
								within = if each { collections::BTreeSet() } else { below.clone() }
								for j in 0..<lists.len() {
									below.insert(args.len() + j)
									// A field keeps its length where `self` is not
									// taken `mut`.
									if !each && !taken.is_mut {
										within.insert(args.len() + j)
									}
								}
							}
							if kind != null || !measures.is_empty() {
								let key = f"{owner}.{words.resolve(symbol)}"
								let mut found = BoundsReturns {
									each: each,
									below: below.clone(),
									sized: collections::BTreeSet(),
									range: null,
									pending: true,
									at_least: at_least.clone(),
									within: within.clone(),
									under: within.clone(),
									fields: lists.clone(),
									plain: kind != null,
									measures: [],
									lengths: collections::BTreeMap(),
									reaches: collections::BTreeMap(),
									listed: collections::BTreeSet(),
									alike: collections::BTreeSet(),
									guards: collections::BTreeSet(),
									projected: "",
								}
								if kind == null {
									// Of a struct, its lengths alone: the bounds above are read
									// for its whole-number fields, each below (D35).
									found.below = collections::BTreeSet()
									found.at_least = collections::BTreeSet()
									found.within = collections::BTreeSet()
									found.under = collections::BTreeSet()
								}
								bounding_returns_measured(found, measures, args, words)
								assumed.insert(key.clone(), found)
								bodies.push(method)
								keys.push(key)
							}
							for projected in projections {
								let key = bounding_projected_key(f"{owner}.{words.resolve(symbol)}", projected)
								assumed.insert(key.clone(), BoundsReturns {
									each: false,
									below: below.clone(),
									sized: collections::BTreeSet(),
									range: null,
									pending: true,
									at_least: at_least.clone(),
									within: within.clone(),
									under: within.clone(),
									fields: lists.clone(),
									plain: true,
									measures: [],
									lengths: collections::BTreeMap(),
									reaches: collections::BTreeMap(),
									listed: collections::BTreeSet(),
									alike: collections::BTreeSet(),
									guards: collections::BTreeSet(),
									projected: projected.clone(),
								})
								bodies.push(method)
								keys.push(key)
							}
						},
						else => {},
					}
				}
			},
			else => {},
		}
	}
	if assumed.is_empty() {
		return
	}
	for (name, wanted) in assumed {
		if wanted.each {
			context.around.returning.insert(name.clone())
		}
	}
	// **The values each returned list holds, collected** (D24, as D7's
	// first passes): every candidate's call adds nothing, so a recursive
	// one's base cases are what its values start from; the rounds below
	// assume them and keep those proved.
	context.returns = assumed.clone()
	let mut collected = bounding_returns_round(context, bodies, keys, assumed, program, words, ask)
	// **A whole number's interval through a chain of calls** (D32): one
	// found while its callees' were pending is found again with theirs
	// known. A pending call has none, so what is collected needs no
	// assumption, a recursive call's included.
	for _more in 0..<assumed.len() {
		let mut known = assumed.clone()
		for (name, found) in collected {
			if !found.each && found.range != null {
				let mut next = found.clone()
				next.pending = false
				known.insert(name.clone(), next)
			}
		}
		context.returns = known.clone()
		let again = bounding_returns_round(context, bodies, keys, known, program, words, ask)
		let before = bounding_returns_ranged(collected)
		collected = again
		if bounding_returns_ranged(collected) == before {
			break
		}
	}
	let mut started: collections::BTreeMap[String, BoundsReturns] = collections::BTreeMap()
	for (name, wanted) in assumed {
		let mut next = wanted.clone()
		next.pending = false
		next.range = collected.get(name)?.range?.clone()
		started.insert(name.clone(), next)
	}
	assumed = started
	// Each round keeps a part of the last one's bounds, so the rounds end
	// where one keeps them all, or none is left.
	let rounds = bounding_returns_count(assumed) + 1
	for _round in 0..<rounds {
		context.returns = assumed.clone()
		let found = bounding_returns_round(context, bodies, keys, assumed, program, words, ask)
		if bounding_returns_count(found) == bounding_returns_count(assumed) {
			bounding_returns_settle(context, found)
			return
		}
		assumed = found
	}
	bounding_returns_settle(context, collections::BTreeMap())
}

/// **The returns found, settled**: the functions a `let` root may be bound
/// to a call of are those found to return a list (ADR-306 D24).
fn bounding_returns_settle(mut context: BoundsContext, found: collections::BTreeMap[String, BoundsReturns]) {
	context.around.returning.clear()
	for (name, wanted) in found {
		if wanted.each {
			context.around.returning.insert(name.clone())
		}
	}
	context.returns = found
}

/// **One round of [`bounds_returns`]**: each body walked for the bounds
/// `assumed` asks, with `context.returns` assumed of its calls; of each, the
/// list parameters every return was proved below, and the range D7 found
/// on the values of every list returned, held within the assumed one where
/// one was assumed.
fn bounding_returns_round(
	mut context: BoundsContext,
	bodies: ref Vec[ref Spanned[Item]],
	keys: ref Vec[String],
	assumed: ref collections::BTreeMap[String, BoundsReturns],
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> collections::BTreeMap[String, BoundsReturns] {
	let mut found: collections::BTreeMap[String, BoundsReturns] = collections::BTreeMap()
	// **The rules that hold, found once a round** (#1581): its bodies all
	// walk the same context.
	context.around.held.clear()
	for at in 0..<bodies.len() {
		let item = bodies[at]
		match item.node {
			Item::Fn { args, body, receiver, .. } => {
				let key = keys[at].clone()
				let wanted = assumed.get(key) ?? continue
				// `self`'s list fields, past the last argument (ADR-306 D34).
				let taken_mut = receiver?.is_mut ?? false
				let mut walk = bounding_new(args, body, bp_names(nonnegative_locals(body), words), context, program, words)
				for k in 0..<args.len() {
					let param = words.resolve(args[k].name).clone()
					if wanted.below.contains(k) && walk.lists.contains(param) {
						walk.return_params.push(param)
					} else {
						walk.return_params.push("")
					}
				}
				for field in wanted.fields {
					let k = walk.return_params.len()
					walk.return_params.push(if wanted.below.contains(k) { f"self.{field}" } else { "" })
				}
				walk.return_each = wanted.each && wanted.plain
				walk.return_ranging = !wanted.each && wanted.plain
				walk.return_field = wanted.projected.clone()
				// **The relations looked for** (D31), of a parameter the body
				// does not bind again and a list whose length it keeps.
				for k in 0..<args.len() {
					let param = words.resolve(args[k].name).clone()
					let mut scalar: String = ""
					let mut list: String = ""
					if wanted.at_least.contains(k) && !seek_block(body, Seek::Rebound(param.clone()), words) {
						scalar = param.clone()
					}
					// A parameter not written `mut` changes only where it
					// is bound again: a call it is handed to cannot change it
					// (ADR-094 D3; #1516).
					let stays = if args[k].mutable {
						length_stays(body, param, words)
					} else {
						!seek_block(body, Seek::Rebound(param.clone()), words)
					}
					if wanted.within.contains(k) && walk.lists.contains(param) && stays {
						list = param.clone()
					}
					walk.return_scalars.push(scalar)
					walk.return_lens.push(list)
				}
				for field in wanted.fields {
					let k = walk.return_lens.len()
					walk.return_scalars.push("")
					walk.return_lens.push(if wanted.within.contains(k) && !taken_mut { f"self.{field}" } else { "" })
				}
				let proven = bounds_rounds(walk, args, body, context, program, words, ask)
				for (of, holding) in proven.held {
					context.around.held.insert(of.clone(), holding.clone())
				}
				let mut held: collections::BTreeSet[i64] = collections::BTreeSet()
				let mut sized: collections::BTreeSet[i64] = collections::BTreeSet()
				let returned = proven.returned != null
				for k in proven.returned ?? collections::BTreeSet() {
					if wanted.below.contains(k) {
						held.insert(k)
						if walk.axioms.contains_key(length_of(walk.return_params[k])) {
							sized.insert(k)
						}
					}
				}
				let mut range: Range? = null
				if wanted.each && returned {
					range = bounding_returned_range(walk)
				}
				// **A whole number's interval** (D32): every value handed
				// back, the body's last one among them, had one.
				if !wanted.each && !walk.return_unranged && !walk.return_lost
					&& !seek_block(body, Seek::Unvisited(walk.return_seen.clone()), words) {
					range = walk.return_range?.clone()
				}
				let mut at_least: collections::BTreeSet[i64] = collections::BTreeSet()
				let mut within: collections::BTreeSet[i64] = collections::BTreeSet()
				let mut under: collections::BTreeSet[i64] = collections::BTreeSet()
				if !wanted.each && !walk.return_lost
					&& !seek_block(body, Seek::Unvisited(walk.return_seen.clone()), words) {
					at_least = walk.return_at_least?.clone() ?? collections::BTreeSet()
					within = walk.return_within?.clone() ?? collections::BTreeSet()
					// Only below what was assumed below (#1757).
					under = bounding_kept(wanted.under, walk.return_under?.clone() ?? collections::BTreeSet())
				}
				if range != null && !wanted.pending {
					let seen = range ?? Range::open()
					if !(wanted.range ?? Range::open()).holds(seen) || wanted.range == null {
						range = null
					} else {
						range = wanted.range?.clone()
					}
				}
				// **The lengths every return was proved to hold** (#1756),
				// in a walk of their own: it takes the whole-number
				// parameters at zero or more.
				let mut lengths: collections::BTreeMap[String, collections::BTreeSet[i64]] = collections::BTreeMap()
				let mut reaches: collections::BTreeMap[String, collections::BTreeSet[i64]] = collections::BTreeMap()
				let mut alike: collections::BTreeSet[String] = collections::BTreeSet()
				let mut guards: collections::BTreeSet[i64] = collections::BTreeSet()
				if !wanted.lengths.is_empty() || !wanted.alike.is_empty() {
					let mut measuring = bounding_new(args, body, bp_names(nonnegative_locals(body), words), context, program, words)
					measuring.return_wanted = wanted.lengths.clone()
					measuring.return_wanted_alike = wanted.alike.clone()
					measuring.return_listed = wanted.listed.clone()
					for k in 0..<args.len() {
						let param = words.resolve(args[k].name).clone()
						let mut stays = !seek_block(body, Seek::Rebound(param.clone()), words)
						if wanted.listed.contains(k) {
							// A list not written `mut` changes only where it
							// is bound again (ADR-094 D3), as D31's above.
							if args[k].mutable {
								stays = length_stays(body, param, words)
							}
							stays = stays && measuring.lists.contains(param)
						} else if stays && args[k].ty.generics.is_empty() && is_whole_number(words.resolve(args[k].ty.name)) {
							guards.insert(k)
							measuring.return_assumed.push(param.clone())
						}
						measuring.return_sources.push(if stays { param } else { "" })
					}
					bounds_rounds(measuring, args, body, context, program, words, ask)
					if !seek_block(body, Seek::Unvisited(measuring.return_measured.clone()), words) {
						lengths = bounding_nonempty(measuring.return_lengths ?? collections::BTreeMap())
						reaches = bounding_nonempty(measuring.return_reaches ?? collections::BTreeMap())
						alike = measuring.return_alike?.clone() ?? collections::BTreeSet()
					}
				}
				if !held.is_empty() || range != null || !at_least.is_empty() || !within.is_empty()
					|| !lengths.is_empty() || !reaches.is_empty() || !alike.is_empty() {
					found.insert(key, BoundsReturns {
						each: wanted.each,
						below: held,
						sized: sized,
						range: range,
						pending: false,
						at_least: at_least,
						within: within,
						under: under,
						fields: wanted.fields.clone(),
						plain: wanted.plain,
						measures: wanted.measures.clone(),
						lengths: lengths,
						reaches: reaches,
						listed: wanted.listed.clone(),
						alike: alike,
						guards: guards,
						projected: wanted.projected.clone(),
					})
				}
			},
			else => {},
		}
	}
	context.around.held.clear()
	return found
}

/// **The range of every value of the lists a walk returned** (ADR-306
/// D24): the join of what D7 found of each, nothing where one has none or
/// only empty lists were returned. A list nothing was written into holds
/// no value to join.
fn bounding_returned_range(walk: ref BoundsWalk) -> Range? {
	let mut out: Range? = null
	for name in walk.return_names {
		if !walk.written.contains_key(name) && !bounding_poisoned(walk, name) {
			continue
		}
		let bound = walk.assumed.get(name) ?? return null
		if out == null {
			out = bound.clone()
		} else {
			out = (out ?? Range::open()).join(bound)
		}
	}
	let range = out ?? return null
	if !range.is_bounded() {
		return null
	}
	return range
}

/// Whether a function returning `ty` is one D23 finds a bound of: `false`
/// for a whole number, `true` for a list of them, nothing for any other.
fn bounding_returns_each(ty: ref Type, words: ref winnow_grammar::InternerContext) -> bool? {
	if ty.is_nullable || ty.is_tuple {
		return null
	}
	let name = words.resolve(ty.name)
	if ty.generics.is_empty() && is_whole_number(name) {
		return false
	}
	if ty.generics.len() == 1 && (name == "Vec" || name == "List") {
		let inner = ty.generics[0]
		if !inner.is_nullable && !inner.is_tuple && inner.generics.is_empty() && is_whole_number(words.resolve(inner.name)) {
			return true
		}
	}
	return null
}

/// **What a function's result is found as** (ADR-306 D23): as
/// [`bounding_returns_each`], and a nullable whole number, `i64?`, as a whole
/// number (#1758): what is found of every present value it hands back holds
/// of what a caller unwraps from it (`??`, a `match` arm's name, a `let`
/// narrowed by `!= null`); a `return null` gives the bound nothing.
fn bounding_returns_kind(ty: ref Type, words: ref winnow_grammar::InternerContext) -> bool? {
	if ty.is_nullable && !ty.is_tuple && ty.generics.is_empty() && is_whole_number(words.resolve(ty.name)) {
		return false
	}
	return bounding_returns_each(ty, words)
}

/// How many whole-number results of `returns` have an interval (D32).
fn bounding_returns_ranged(returns: ref collections::BTreeMap[String, BoundsReturns]) -> i64 {
	let mut out = 0
	for (_name, found) in returns {
		if !found.each && found.range != null {
			out += 1
		}
	}
	return out
}

/// How many bounds `returns` holds, over every function.
fn bounding_returns_count(returns: ref collections::BTreeMap[String, BoundsReturns]) -> i64 {
	let mut out = 0
	for (_name, found) in returns {
		out += found.below.len() + found.at_least.len() + found.within.len() + found.under.len() + found.alike.len()
		for (_m, positions) in found.lengths {
			out += positions.len()
		}
		for (_m, positions) in found.reaches {
			out += positions.len()
		}
		if found.range != null {
			out += 1
		}
	}
	return out
}

/// **A return, against the postcondition the walk looks for** (ADR-306
/// D23): a number proved `0 <= value < p.len()` for each list parameter
/// `p`, the positions joined over every return; a list one whose every
/// write the walk sees, its ends read at the end. Any other return is lost.
fn bounding_returned(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	returned: ref Expr?,
	throwing: bool,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if throwing {
		return
	}
	// **A `return null` of a nullable result** (#1758) hands back no
	// value, so it bounds nothing the found facts say of one.
	if bounding_null_returned(returned) {
		walk.return_seen.insert(node_key(returned ?? return))
		return
	}
	bounding_return_lengths(walk, facts, returned, context, program, words, ask)
	if !walk.return_field.is_empty() {
		// **One field of the struct handed back** (ADR-306 D35): its value
		// in the literal; any other return gives the field nothing.
		let built = returned ?? {
			walk.return_lost = true
			walk.return_unranged = true
			return
		}
		walk.return_seen.insert(node_key(built))
		let field = walk.return_field.clone()
		let picked = bounding_field_built(built, field, words) ?? {
			walk.return_lost = true
			walk.return_unranged = true
			return
		}
		bounding_returned_value(walk, facts, picked, context, program, words, ask)
		return
	}
	bounding_returned_value(walk, facts, returned, context, program, words, ask)
}

/// Whether a `return` hands back `null`.
fn bounding_null_returned(returned: ref Expr?) -> bool {
	let given = returned ?? return false
	return match given {
		Expr::LitNull(_) => true,
		else => false,
	}
}

/// **A value handed back, against what the walk looks for** (ADR-306 D23,
/// D31, D32): the value itself, or one field of the struct handed back.
fn bounding_returned_value(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	returned: ref Expr?,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if walk.return_ranging {
		bounding_return_range(walk, facts, returned, context, program, words, ask)
		bounding_return_relations(walk, facts, returned, context, program, words, ask)
	}
	if walk.return_params.is_empty() {
		if walk.return_ranging {
			let seen = returned ?? return
			walk.return_seen.insert(node_key(seen))
		}
		return
	}
	let value = returned ?? {
		walk.return_lost = true
		return
	}
	walk.return_seen.insert(node_key(value))
	if walk.return_each {
		match value {
			Expr::Variable(name, _) => {
				let list = words.resolve(name)
				if walk.shape.roots.contains(list) {
					walk.return_names.insert(list.clone())
				} else {
					walk.return_lost = true
				}
			},
			Expr::ListLit { items, .. } => {
				if !items.is_empty() {
					walk.return_lost = true
				}
			},
			else => {
				walk.return_lost = true
			},
		}
		return
	}
	let called = bounding_returned_below(walk, value, false, context, words)
	let term = bounding_lin(walk, value, facts, context, program, words)
	let mut below: collections::BTreeSet[i64] = collections::BTreeSet()
	for k in 0..<walk.return_params.len() {
		let param = walk.return_params[k].clone()
		if param.is_empty() {
			continue
		}
		if called.contains_key(param) {
			below.insert(k)
			continue
		}
		let v = term ?? continue
		let zero = walk.arena.int(0)
		let len = walk.arena.var(length_of(param))
		let low = walk.arena.ge(v, zero)
		let high = walk.arena.lt(v, len)
		let goal = walk.arena.and([low, high])
		if bounding_proves(walk, facts, goal, ask) {
			below.insert(k)
		}
	}
	let before = walk.return_below?.clone() ?? {
		walk.return_below = below
		return
	}
	let mut kept: collections::BTreeSet[i64] = collections::BTreeSet()
	for k in before {
		if below.contains(k) {
			kept.insert(k)
		}
	}
	walk.return_below = kept
}

/// **What a function returning `ty` is found the lengths of** (ADR-306
/// D23, #1756): `""` for a list, each list field of a struct `fields` holds
/// for one declared here, nothing else.
fn bounding_returns_measures(
	ty: ref Type,
	fields: ref collections::BTreeMap[String, Vec[String]],
	words: ref winnow_grammar::InternerContext,
) -> Vec[String] {
	if ty.is_nullable || ty.is_tuple {
		return []
	}
	if bounding_is_list_type(ty, words) {
		return [""]
	}
	if !ty.generics.is_empty() {
		return []
	}
	return fields.get(words.resolve(ty.name))?.clone() ?? []
}

/// **The lengths a candidate is asked** (#1756): of each measure, every
/// whole-number and every list argument, as equal and as at most; of a
/// struct's, each pair of its list fields.
fn bounding_returns_measured(
	mut found: BoundsReturns,
	measures: ref Vec[String],
	args: ref Vec[FnArg],
	words: ref winnow_grammar::InternerContext,
) {
	let mut sources: collections::BTreeSet[i64] = collections::BTreeSet()
	for k in 0..<args.len() {
		if bounding_is_list_type(args[k].ty, words) {
			found.listed.insert(k)
			sources.insert(k)
		} else if args[k].ty.generics.is_empty() && is_whole_number(words.resolve(args[k].ty.name)) {
			sources.insert(k)
		}
	}
	for m in measures {
		if !sources.is_empty() {
			found.lengths.insert(m.clone(), sources.clone())
			found.reaches.insert(m.clone(), sources.clone())
		}
		for other in measures {
			if !m.is_empty() && m < other {
				found.alike.insert(f"{m}|{other}")
			}
		}
	}
	found.measures = measures.clone()
}

/// The entries of `sets` that hold a position.
fn bounding_nonempty(sets: ref collections::BTreeMap[String, collections::BTreeSet[i64]]) -> collections::BTreeMap[String, collections::BTreeSet[i64]] {
	let mut out: collections::BTreeMap[String, collections::BTreeSet[i64]] = collections::BTreeMap()
	for (m, positions) in sets {
		if !positions.is_empty() {
			out.insert(m.clone(), positions.clone())
		}
	}
	return out
}

/// **A return, against the lengths the walk looks for** (ADR-306 D23,
/// #1756): the length of the list handed back, or of each list field of
/// the struct, proved equal to or at least each parameter asked (its value,
/// or a list's length), and each pair of fields proved as long as each
/// other; the positions kept over every return. A value read by a path is
/// asked by its path; any other one as `result#`, with what its literal and
/// the calls in it build (`bounding_built`, `bounding_measured`).
fn bounding_return_lengths(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	returned: ref Expr?,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) {
	if walk.return_wanted.is_empty() && walk.return_wanted_alike.is_empty() {
		return
	}
	let mut lengths: collections::BTreeMap[String, collections::BTreeSet[i64]] = collections::BTreeMap()
	let mut reaches: collections::BTreeMap[String, collections::BTreeSet[i64]] = collections::BTreeMap()
	let mut alike: collections::BTreeSet[String] = collections::BTreeSet()
	let value = returned ?? {
		walk.return_lengths = lengths
		walk.return_reaches = reaches
		walk.return_alike = alike
		return
	}
	walk.return_measured.insert(node_key(value))
	let mut given = facts.clone()
	let mut base = path_of(value, words) ?? ""
	if base.is_empty() {
		base = "result#"
		let measured = bounding_measured(walk, facts, base, base, value, context, program, words)
		bounding_forget(walk, given, base)
		bounding_built(walk, given, base, value, words)
		for fact in measured {
			bounding_push(walk, given, fact)
		}
	}
	for (m, asked) in walk.return_wanted.clone() {
		let path = if m.is_empty() { base.clone() } else { f"{base}.{m}" }
		let len = bounding_length_named(walk, path, false)
		let before = walk.return_lengths?.get(m)?.clone()
		let before_reach = walk.return_reaches?.get(m)?.clone()
		let mut equal: collections::BTreeSet[i64] = collections::BTreeSet()
		let mut least: collections::BTreeSet[i64] = collections::BTreeSet()
		for k in asked {
			if k >= walk.return_sources.len() || walk.return_sources[k].is_empty() {
				continue
			}
			let held_equal = before?.contains(k) ?? (walk.return_lengths == null)
			let held_least = before_reach?.contains(k) ?? (walk.return_reaches == null)
			if !held_equal && !held_least {
				continue
			}
			let source = walk.return_sources[k].clone()
			let term = if walk.return_listed.contains(k) {
				bounding_length_named(walk, source, false)
			} else {
				walk.arena.var(source)
			}
			if held_equal {
				let goal = walk.arena.equal(len, term)
				if bounding_proves(walk, given, goal, ask) {
					equal.insert(k)
					continue
				}
			}
			let goal = walk.arena.ge(len, term)
			if bounding_proves(walk, given, goal, ask) {
				least.insert(k)
			}
		}
		lengths.insert(m.clone(), equal)
		reaches.insert(m.clone(), least)
	}
	for pair in walk.return_wanted_alike.clone() {
		if walk.return_alike != null && !(walk.return_alike?.contains(pair) ?? false) {
			continue
		}
		let parts: Vec[ref String] = pair.split("|").collect()
		if parts.len() != 2 {
			continue
		}
		let a = bounding_length_named(walk, f"{base}.{parts[0]}", false)
		let b = bounding_length_named(walk, f"{base}.{parts[1]}", false)
		let goal = walk.arena.equal(a, b)
		if bounding_proves(walk, given, goal, ask) {
			alike.insert(pair.clone())
		}
	}
	// A position proved equal at one return and at least at another is at
	// least over both.
	if walk.return_lengths != null {
		let was = walk.return_lengths ?? collections::BTreeMap()
		let was_reach = walk.return_reaches ?? collections::BTreeMap()
		let mut kept: collections::BTreeMap[String, collections::BTreeSet[i64]] = collections::BTreeMap()
		let mut kept_reach: collections::BTreeMap[String, collections::BTreeSet[i64]] = collections::BTreeMap()
		for (m, now) in lengths {
			let old = was.get(m)?.clone() ?? collections::BTreeSet()
			let old_reach = was_reach.get(m)?.clone() ?? collections::BTreeSet()
			let now_reach = reaches.get(m)?.clone() ?? collections::BTreeSet()
			let mut same: collections::BTreeSet[i64] = collections::BTreeSet()
			let mut most: collections::BTreeSet[i64] = collections::BTreeSet()
			for k in now {
				if old.contains(k) {
					same.insert(k)
				} else if old_reach.contains(k) {
					most.insert(k)
				}
			}
			for k in now_reach {
				if old.contains(k) || old_reach.contains(k) {
					most.insert(k)
				}
			}
			kept.insert(m.clone(), same)
			kept_reach.insert(m.clone(), most)
		}
		lengths = kept
		reaches = kept_reach
		alike = bounding_kept_names(walk.return_alike ?? collections::BTreeSet(), alike)
	}
	walk.return_lengths = lengths
	walk.return_reaches = reaches
	walk.return_alike = alike
}

/// The names both sets hold.
fn bounding_kept_names(before: ref collections::BTreeSet[String], now: ref collections::BTreeSet[String]) -> collections::BTreeSet[String] {
	let mut kept: collections::BTreeSet[String] = collections::BTreeSet()
	for name in before {
		if now.contains(name) {
			kept.insert(name.clone())
		}
	}
	return kept
}

/// **What a call's found lengths say of the value it builds** (ADR-306
/// D23, #1756): `name.len()`, or `name.f.len()` of a struct's field, equal
/// to or at least the argument's value or a list argument's length, and two
/// fields as long as each other; a struct literal's fields each, as the
/// calls in them build them. Stated before `root` moves: a term that reads
/// it is left out.
fn bounding_measured(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	root: ref String,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	match value {
		Expr::StructLit { fields, .. } => {
			for field in fields {
				let given = field.value ?? continue
				let path = f"{name}.{words.resolve(field.name)}"
				for fact in bounding_measured(walk, facts, root, path, given, context, program, words) {
					out.push(fact)
				}
			}
			return out
		},
		Expr::Call { .. } => {},
		Expr::MethodCall { .. } => {},
		else => return out,
	}
	if bounding_found_options(value) {
		return out
	}
	let callee = bounding_found_key(walk, value, context, words) ?? return out
	let found = context.returns.get(callee) ?? return out
	if found.pending {
		return out
	}
	// Each holds where every guarded argument is zero or more.
	let mut below: Vec[i64] = []
	for k in found.guards {
		let term = bounding_found_term(walk, value, k, facts, context, program, words) ?? return out
		if bounding_touches(walk, term, root) {
			return out
		}
		let zero = walk.arena.int(0)
		below.push(walk.arena.lt(term, zero))
	}
	let mut stated: Vec[i64] = []
	for at_least in [false, true] {
		let sets = if at_least { found.reaches.clone() } else { found.lengths.clone() }
		for (m, positions) in sets {
			let path = if m.is_empty() { name.clone() } else { f"{name}.{m}" }
			let len = bounding_length_named(walk, path, false)
			for k in positions {
				let term = if found.listed.contains(k) {
					let arg = bounding_found_path(value, found, k, words) ?? continue
					if walk.pinned.contains(path_root(arg)) {
						continue
					}
					bounding_length_named(walk, arg, false)
				} else {
					bounding_found_term(walk, value, k, facts, context, program, words) ?? continue
				}
				if bounding_touches(walk, term, root) {
					continue
				}
				stated.push(if at_least { walk.arena.ge(len, term) } else { walk.arena.equal(len, term) })
			}
		}
	}
	for pair in found.alike {
		let parts: Vec[ref String] = pair.split("|").collect()
		if parts.len() != 2 {
			continue
		}
		let a = bounding_length_named(walk, f"{name}.{parts[0]}", false)
		let b = bounding_length_named(walk, f"{name}.{parts[1]}", false)
		stated.push(walk.arena.equal(a, b))
	}
	for fact in stated {
		if below.is_empty() {
			out.push(fact)
		} else {
			let mut either = below.clone()
			either.push(fact)
			out.push(walk.arena.or(either))
		}
	}
	return out
}

/// **The list parameters every return was found below**, by position, at
/// the end of the walk; nothing where a return was lost or one the body
/// holds was not seen (a `return` in a lambda among them). A list return's
/// are the ends its every list kept that stay ends all through the body.
fn bounding_returns_found(
	walk: ref BoundsWalk,
	body: ref Block,
	words: ref winnow_grammar::InternerContext,
) -> collections::BTreeSet[i64]? {
	if walk.return_lost || seek_block(body, Seek::Unvisited(walk.return_seen.clone()), words) {
		return null
	}
	if !walk.return_each {
		return walk.return_below?.clone()
	}
	let mut out: collections::BTreeSet[i64] = collections::BTreeSet()
	for k in 0..<walk.return_params.len() {
		let param = walk.return_params[k]
		if param.is_empty() {
			continue
		}
		let mut held = true
		for name in walk.return_names {
			let ends = walk.assumed_ends.get(name) ?? {
				held = false
				break
			}
			if !ends.contains(param) || !bounding_end_list(walk, param, name) {
				held = false
				break
			}
		}
		if held {
			out.insert(k)
		}
	}
	return out
}

/// **The lists a call's result lies below** (ADR-306 D23): of a function
/// the file found a bound of (`each` for a list's elements), the arguments
/// at its positions that are paths the walk reads, each with whether its
/// length is a sized one (`BoundsReturns.sized`).
fn bounding_returned_below(
	walk: ref BoundsWalk,
	value: ref Expr,
	each: bool,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> collections::BTreeMap[String, bool] {
	let mut out: collections::BTreeMap[String, bool] = collections::BTreeMap()
	let callee = bounding_found_key(walk, value, context, words) ?? return out
	let found = context.returns.get(callee) ?? return out
	if found.each != each {
		return out
	}
	for k in found.below {
		let path = bounding_found_path(value, found, k, words) ?? continue
		if !walk.pinned.contains(path_root(path)) {
			out.insert(path, found.sized.contains(k))
		}
	}
	return out
}

/// **The callee a call is found of** (ADR-306 D23, D34): a free function's
/// name the walk does not bind again, or `Type.method` of a method, the type
/// as `std_receivers` names the receiver's.
fn bounding_found_key(
	walk: ref BoundsWalk,
	value: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> String? {
	let callee = bounding_found_callee(walk, value, context, words) ?? return null
	// **The entry of one field of its struct result** (ADR-306 D35), for
	// the call being read for it.
	if !walk.found_field.is_empty() && node_key(value) == walk.found_at {
		return bounding_projected_key(callee, walk.found_field)
	}
	return callee
}

/// The callee of [`bounding_found_key`], before a field is named.
fn bounding_found_callee(
	walk: ref BoundsWalk,
	value: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> String? {
	return match value {
		Expr::Call { func, .. } => {
			let callee = bounding_callee(func, words) ?? return null
			if walk.shape.bound.contains(callee) {
				return null
			}
			callee
		},
		Expr::MethodCall { method, .. } => {
			let owner = context.std_receivers.get(node_key(value)) ?? return null
			f"{owner}.{words.resolve(method)}"
		},
		else => null,
	}
}

/// Whether a call names options (`f(x, limit: 3)`).
fn bounding_found_options(value: ref Expr) -> bool {
	return match value {
		Expr::Call { config, .. } => !config.is_empty(),
		Expr::MethodCall { config, .. } => !config.is_empty(),
		else => false,
	}
}

/// **The path a found callee's position `k` names at a call**: the
/// argument there, or past the last argument, the receiver's field
/// (`BoundsReturns.fields`, ADR-306 D34).
fn bounding_found_path(
	value: ref Expr,
	found: ref BoundsReturns,
	k: i64,
	words: ref winnow_grammar::InternerContext,
) -> String? {
	return match value {
		Expr::Call { args, .. } => {
			if k < 0 || k >= args.len() {
				return null
			}
			bounding_argument_path(args[k], words)
		},
		Expr::MethodCall { receiver, args, .. } => {
			if k >= 0 && k < args.len() {
				return bounding_argument_path(args[k], words)
			}
			let j = k - args.len()
			if j < 0 || j >= found.fields.len() {
				return null
			}
			let on = path_of(receiver, words) ?? return null
			f"{on}.{found.fields[j]}"
		},
		else => null,
	}
}

/// **The term of a found callee's argument `k` at a call** (ADR-306 D31).
fn bounding_found_term(
	mut walk: BoundsWalk,
	value: ref Expr,
	k: i64,
	facts: ref BoundsFacts,
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
) -> i64? {
	return match value {
		Expr::Call { args, .. } => {
			if k < 0 || k >= args.len() {
				return null
			}
			bounding_lin(walk, args[k], facts, context, program, words)
		},
		Expr::MethodCall { args, .. } => {
			if k < 0 || k >= args.len() {
				return null
			}
			bounding_lin(walk, args[k], facts, context, program, words)
		},
		else => null,
	}
}

/// **The range a call's list is found to hold its values in** (ADR-306
/// D24), of a callee the walk does not bind again; nothing while the
/// rounds collect or where none was found.
fn bounding_returned_values(
	walk: ref BoundsWalk,
	value: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) -> Range? {
	return match value {
		Expr::Call { func, .. } => {
			let callee = bounding_callee(func, words) ?? return null
			if walk.shape.bound.contains(callee) {
				return null
			}
			let found = context.returns.get(callee) ?? return null
			if !found.each || found.pending {
				return null
			}
			found.range?.clone()
		},
		else => null,
	}
}

/// **A `let` root bound to a call's list** (ADR-306 D24): its first values
/// lie in the range the callee is found to return, below the lists it is
/// found to return them below; while the rounds collect, they add nothing.
fn bounding_call_root(
	mut walk: BoundsWalk,
	key: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	let callee = match value {
		Expr::Call { func, .. } => bounding_callee(func, words) ?? "",
		else => "",
	}
	// **Only a call of a function found to return whole numbers** writes
	// the root here: `collections::BTreeMap()` of an empty map is a call
	// too, and its writes come later.
	let found = context.returns.get(callee)
	if found == null || !(found?.each ?? false) || (found?.pending ?? false) {
		return
	}
	let range = bounding_returned_values(walk, value, context, words)
	if range != null {
		bounding_join(walk, key, range ?? Range::open())
	} else {
		walk.poisoned.insert(key.clone())
	}
	let mut below: collections::BTreeSet[String] = collections::BTreeSet()
	for (list, _sized) in bounding_returned_below(walk, value, true, context, words) {
		if bounding_end_list(walk, list, key) {
			below.insert(list.clone())
		}
	}
	let was = walk.written_ends.get(key)?.clone()
	if was != null {
		let mut kept: collections::BTreeSet[String] = collections::BTreeSet()
		for list in was ?? collections::BTreeSet() {
			if below.contains(list) {
				kept.insert(list.clone())
			}
		}
		below = kept
	}
	walk.written_ends.insert(key.clone(), below)
}

/// An argument's path, through a `ref`.
fn bounding_argument_path(arg: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
	return match arg {
		Expr::Unary { op: UnaryOp::Ref, expr, .. } => path_of(expr, words),
		else => path_of(arg, words),
	}
}

/// **What a call's found postcondition says of the name it is bound to**
/// (ADR-306 D23): `0 <= name < p.len()` for each list `p` it lies below.
fn bounding_returned_facts(
	mut walk: BoundsWalk,
	mut facts: BoundsFacts,
	name: ref String,
	value: ref Expr,
	context: ref BoundsContext,
	words: ref winnow_grammar::InternerContext,
) {
	let lists = bounding_returned_below(walk, value, false, context, words)
	if lists.is_empty() {
		return
	}
	let n = walk.arena.var(name)
	let zero = walk.arena.int(0)
	let low = walk.arena.ge(n, zero)
	bounding_push(walk, facts, low)
	for (list, sized) in lists {
		let len = bounding_length_named(walk, list, sized)
		let high = walk.arena.lt(n, len)
		bounding_push(walk, facts, high)
	}
}

/// **The key of one field of a struct result** (ADR-306 D35): `callee#field`,
/// or the callee's own where no field is named.
fn bounding_projected_key(callee: ref String, field: ref String) -> String {
	if field.is_empty() {
		return callee.clone()
	}
	return f"{callee}#{field}"
}

/// **The whole-number fields of a struct type declared here** (ADR-306
/// D35), each a result D23, D31 and D32 read; none of any other type.
fn bounding_struct_wholes(
	ty: ref Type,
	whole_fields: ref collections::BTreeMap[String, Vec[String]],
	words: ref winnow_grammar::InternerContext,
) -> Vec[String] {
	if ty.is_nullable || ty.is_tuple || !ty.generics.is_empty() {
		return []
	}
	return whole_fields.get(words.resolve(ty.name))?.clone() ?? []
}

/// **The value a struct literal gives `field`** (ADR-306 D35): written, or
/// the name of the shorthand `E { offset }`; nothing of any other value.
fn bounding_field_built(built: ref Expr, field: ref String, words: ref winnow_grammar::InternerContext) -> Expr? {
	return match built {
		Expr::StructLit { fields, .. } => {
			for each in fields {
				if words.resolve(each.name) != field {
					continue
				}
				return match each.value {
					null => Expr::Variable(each.name, node_id::NodeId::fresh()),
					written => written.clone(),
				}
			}
			null
		},
		else => null,
	}
}

/// **What a call's struct result is found to hold in each whole-number
/// field** (ADR-306 D35): of `name.field`, what a `let` of the field alone
/// would give (D23, D31, D32), each path pushed onto `paths`. A fact that
/// reads another part of `name` reads its old value, and is left out.
fn bounding_fields_found(
	mut walk: BoundsWalk,
	facts: ref BoundsFacts,
	name: ref String,
	value: ref Expr,
	mut paths: Vec[String],
	context: ref BoundsContext,
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> bool sync,
) -> Vec[i64] {
	let mut out: Vec[i64] = []
	let call = match value {
		Expr::Call { .. } => true,
		Expr::MethodCall { .. } => true,
		else => false,
	}
	if !call || bounding_found_options(value) {
		return out
	}
	let callee = bounding_found_key(walk, value, context, words) ?? return out
	let prefix = f"{callee}#"
	let mut projected: Vec[String] = []
	for (key, found) in context.returns {
		if key.starts_with(prefix) && !found.each && !found.pending {
			projected.push(found.projected.clone())
		}
	}
	for field in projected {
		let path = f"{name}.{field}"
		walk.found_at = node_key(value)
		walk.found_field = field.clone()
		let relations = bounding_relations_of(walk, facts, path, value, context, program, words, ask)
		let mut given = facts.clone()
		given.facts = []
		bounding_returned_facts(walk, given, path, value, context, words)
		bounding_relations_push(walk, given, path, relations)
		let range = bounding_range(walk, value, facts, context, program, words, ask) ?? Range::open()
		walk.found_at = -1
		walk.found_field = ""
		let n = walk.arena.var(path)
		if range.lo != null {
			let least = walk.arena.int(range.lo ?? 0)
			let low = walk.arena.ge(n, least)
			bounding_push(walk, given, low)
		}
		if range.hi != null {
			let most = walk.arena.int(range.hi ?? 0)
			let high = walk.arena.le(n, most)
			bounding_push(walk, given, high)
		}
		for fact in given.facts {
			let mut read: collections::BTreeSet[String] = collections::BTreeSet()
			walk.arena.variables(fact, read)
			let mut stale = false
			for v in read {
				if v != path && path_within(v, name) {
					stale = true
				}
			}
			if !stale {
				out.push(fact)
			}
		}
		paths.push(path)
	}
	return out
}
