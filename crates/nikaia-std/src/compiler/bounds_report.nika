// crates/nikaia-std/src/compiler/bounds_report.nika
//
// **The `--bounds` report's walk** (ADR-306, #389), moved from the compiler's
// `bounds_report` (ADR-294, #125): every index into a list and every `+`, `-`
// and `*` the optimizations of ADR-306 may drop the check of, every `/` and
// `%` whose divisor is not a literal (ADR-396 D7, #1578), and what became of
// each. The reason a check stayed is `bounds_reasons.nika`; what is proved
// is handed in as sets of nodes, built by the compiler.

use std::collections
use std::text

/// **What the check and the proof say about one file**, read once: the lists
/// whose index is a candidate, the operations and negations with their types,
/// and the three sets of nodes the walk proved.
pub struct BoundsReportFacts {
	pub lists: collections::BTreeSet[i64],
	pub arithmetic: collections::BTreeMap[i64, String],
	/// **Every `/` and `%` whose divisor is not a literal** (ADR-396 D7,
	/// #1578), as `CheckFacts::divisions` has them; proved ones are in
	/// `proven_arithmetic`, and their check stays (ADR-395 D3).
	pub divisions: collections::BTreeMap[i64, String],
	pub negations: collections::BTreeMap[i64, String],
	pub proven_indices: collections::BTreeSet[i64],
	pub proven_arithmetic: collections::BTreeSet[i64],
	pub proven_negations: collections::BTreeSet[i64],
	/// The derived preconditions, each with the call sites that prove it
	/// (ADR-391 D4, `derived_rows`).
	pub derived: Vec[String],
	/// What keeps each function from its callers' bounds, as the prover's
	/// derivation found it (`derived_gates`, #1863).
	pub gates: collections::BTreeMap[String, String],
	/// **Each index data from outside reaches** (ADR-396 D5), and each
	/// `/`, `%`, `+`, `-` and `*` (D7), as the prover's walk left it
	/// (`CheckFacts::outside_indices`).
	pub outside: collections::BTreeMap[(i64, String), OutsideIndex],
	/// Whether the build lets an unproved claim through with a check
	/// (`unproved-claims = "warn"`, ADR-396 D3).
	pub unproved_warn: bool,
}

/// One site a check stands at.
struct BoundsReportSite {
	line: i64,
	/// The site as written, near enough (`written_expression`).
	text: String,
	index: bool,
	proved: bool,
	/// Why it was not, where it was not.
	blocked: String?,
	/// Where it stands: an operation's own span, else its statement's.
	span: Span,
	/// What it is not proved to keep (`in bounds`), for `NK1313`.
	keeps: String,
	/// The guard that proves it where the value arrives, for `NK1313`'s help.
	guard: String,
}

struct BoundsReportWalk {
	/// Index nodes already listed: an index read in a statement is listed once.
	seen: collections::BTreeSet[i64],
	sites: Vec[BoundsReportSite],
	/// What keeps the function walked from its callers' bounds
	/// (`derived_gates`, #1863): `""` where its callers bound it (ADR-391
	/// D1).
	gate: String,
	/// The statement walked, where a site has no span of its own.
	at: Span,
}

/// The gate `gates` names for the function `name`; a function it does not
/// name, which `derived_of` never weighed, is none its callers bound.
fn bounds_report_gate(gates: ref collections::BTreeMap[String, String], name: ref String) -> String {
	return gates[name]?.clone() ?? "a function the derivation does not weigh"
}

/// The gate outside a function: a grammar's action has no callers.
fn bounds_report_no_function() -> String {
	return "a grammar's action"
}

/// The report, for one file, over a check the caller ran. What is proved does
/// not depend on what the build drops (ADR-306 D14); the first line says
/// whether this build writes it without its check.
pub fn bounds_report_checked(
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	source: String,
	path: String,
	facts: ref BoundsReportFacts,
	bounds: BoundsChecks,
	overflow: OverflowChecks,
	holes_of: fn(ref Expr) -> Vec[Expr] sync,
) -> String {
	let sites = bounds_report_sites(program, words, source, facts, holes_of)
	let indexes = sites.iter().filter(fn(s) { s.index }).count()
	let operations = sites.len() - indexes
	let proved_indexes = sites.iter().filter(fn(s) { s.index && s.proved }).count()
	let proved_operations = sites.iter().filter(fn(s) { !s.index && s.proved }).count()
	let mut out = f"bounds in {path}: {indexes} indexes, {proved_indexes} proved; {operations} operations, {proved_operations} proved - written without their check: indexes {bounds.name()}, operations {overflow.name()}\n"
	let widest = sites.iter().map(fn(s) { s.text.len() }).max() ?? 0
	let width = widest.min(40)
	for site in sites {
		let how = match site.proved {
			true => "proved",
			false => match site.blocked {
				null => "checked",
				why => f"checked: {why}",
			},
		}
		let line = site.line.to_string()
		out.push_str(f"  {bounds_report_spaces(line, 4)}{line}  {site.text}{bounds_report_spaces(site.text, width)}  {how}\n")
	}
	// **Each index data from outside reaches** (ADR-396 D5): its source,
	// and whether it is proved, with the guard that proves it, refused
	// (`NK1302`), or checked because the build lets it through.
	for row in bounds_report_outside(facts, source) {
		out.push_str(f"  outside  {row}\n")
	}
	// **What callers proved** (ADR-391 D4): each derived precondition, with
	// the lines of the calls that prove it.
	for row in bounds_report_derived(facts.derived, source) {
		out.push_str(f"  derived  {row}\n")
	}
	return out
}

/// **`unproved-checks = "error"`: each check the walk does not prove is
/// refused** ([ADR-306](../../docs/specification/adr/adr-306.md) D29,
/// `NK1313`): the sites `--bounds` reports as checked, each with the walk's
/// reason as a note and the guard where the value arrives as the help.
pub fn bounds_report_unproved(
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	source: String,
	facts: ref BoundsReportFacts,
	holes_of: fn(ref Expr) -> Vec[Expr] sync,
) -> Vec[CheckFinding] {
	let mut refused: Vec[CheckFinding] = []
	for site in bounds_report_sites(program, words, source, facts, holes_of) {
		if site.proved {
			continue
		}
		let mut notes: Vec[String] = []
		match site.blocked {
			null => {},
			why => notes.push(f"The walk does not prove it: {why}."),
		}
		notes.push("`unproved-checks = \"error\"` refuses every index, overflow and division the compiler does not prove; `nikaia check --bounds` lists each with its reason.")
		refused.push(CheckFinding { severity: CheckSeverity::Error, span: Span { start: site.span.start, end: site.span.end }, code: "NK1313", message: f"`{site.text}` is not proved {site.keeps}, and this package refuses a check the compiler does not prove.", notes: notes, help: site.guard.clone(), labels: [], edit: null })
	}
	return refused
}

/// Every site of the file in source order, proved or not, with why not.
fn bounds_report_sites(
	program: ref Program,
	words: ref winnow_grammar::InternerContext,
	source: ref String,
	facts: ref BoundsReportFacts,
	holes_of: fn(ref Expr) -> Vec[Expr] sync,
) -> Vec[BoundsReportSite] {
	let mut walk = BoundsReportWalk { seen: collections::BTreeSet(), sites: [], gate: bounds_report_no_function(), at: Span { start: 0, end: 0 } }
	let none: Vec[FnArg] = []
	for item in program.items {
		match item.node {
			Item::Fn { name, args, body, .. } => {
				walk.gate = bounds_report_gate(facts.gates, words.resolve(name ?? continue))
				bounds_report_function(args, body, words, source, facts, holes_of, walk)
				walk.gate = bounds_report_no_function()
			},
			Item::Impl { trait_name, methods, .. } => {
				for method in methods {
					match method.node {
						Item::Fn { name, args, body, .. } => {
							walk.gate = if trait_name != null {
								"a method of a trait's `impl`, called wherever the trait is"
							} else {
								bounds_report_gate(facts.gates, words.resolve(name ?? continue))
							}
							bounds_report_function(args, body, words, source, facts, holes_of, walk)
							walk.gate = bounds_report_no_function()
						},
						else => {},
					}
				}
			},
			// A grammar's actions are walked too (ADR-314 D1).
			Item::Grammar(def) => {
				for rule in def.rules {
					for alt in rule.alts {
						match alt.action {
							null => {},
							action => bounds_report_function(
								none,
								action,
								words,
								source,
								facts,
								holes_of,
								walk,
							),
						}
						// And a fold's lambdas (ADR-367 D3).
						for spec in fb_folds(alt.pattern.node) {
							bounds_report_lambda(
								spec.init,
								none,
								words,
								source,
								facts,
								holes_of,
								walk,
							)
							bounds_report_lambda(
								spec.step,
								none,
								words,
								source,
								facts,
								holes_of,
								walk,
							)
							match spec.merge {
								null => {},
								merge => bounds_report_lambda(
									merge,
									none,
									words,
									source,
									facts,
									holes_of,
									walk,
								),
							}
						}
					}
				}
			},
			else => {},
		}
	}
	walk.sites.sort_by_key(fn(s) { s.line })
	return walk.sites
}

/// **Each index and operation data from outside reaches, as `--bounds`
/// writes it** (ADR-396 D5, D7), in the order of the file: the line it stands at (the call
/// that hands it the value, where a call does), the index, the name and its
/// source, and the verdict - `proved by the guard on line 14
/// (`!(0 <= m && m < 12)`)`, `refused NK1302`, or `checked (unproved-claims =
/// warn)`; an operation not proved is `checked: not proved, an NK1303
/// site`, since `NK1303` is not switched on yet (D8), and one the bounds
/// walk proved by ranges is `proved by the bounds walk's ranges`.
fn bounds_report_outside(facts: ref BoundsReportFacts, source: ref String) -> Vec[String] {
	let mut rows: Vec[String] = []
	for (_, found) in facts.outside {
		let mut from = "from outside"
		if found.source != "" {
			from = f"from `{found.source}`"
		}
		let mut verdict = "refused NK1302"
		if found.operation && !found.proved && found.site >= 0 && facts.proven_arithmetic.contains(found.site) {
			// **The bounds walk proved it** (ADR-395 D2): by ranges, where
			// the prover states no goal or leaves it open - an `i64`'s
			// `n + 1` after `if n > 1000 { return }`.
			verdict = "proved by the bounds walk's ranges"
		} else if found.operation && !found.proved {
			// **Not refused yet** (ADR-396 D7, D8 step 3): the site
			// `NK1303` will refuse, and whether the walk stated its goal.
			verdict = "checked: not proved, an NK1303 site (ADR-396 D8)"
			if found.within != "" {
				// **The goal an `i64` or `u64` was asked within** (D8 step
				// 2, #1810): the window, not the type's ends.
				verdict = f"checked: not proved within {found.within}, an NK1303 site (ADR-396 D8)"
			} else if !found.stated {
				// Every whole-number type has its goal now (#1810): only an
				// operand the prover reads no whole number of, `line.len()`,
				// leaves it unstated.
				verdict = "checked: the prover reads no whole number of an operand, an NK1303 site (ADR-396 D8)"
			}
		} else if found.proved {
			verdict = "proved"
			if found.guard_at >= 0 {
				verdict = f"proved by the guard on line {bounds_report_line(source, found.guard_at)} (`{found.guard}`)"
			}
		} else if facts.unproved_warn {
			verdict = "checked (unproved-claims = warn)"
		}
		rows.push(f"{bounds_report_line(source, found.at)}  {found.written}, `{found.name}` {from}: {verdict}")
	}
	return rows
}

/// **Each derived precondition as the reports write it** (ADR-391 D4), from
/// `derived_rows`: the function, its claims and the lines of the calls that
/// prove them (`pick: 0 <= at, proved at the calls on lines 17, 18`).
/// `--bounds` and `--asserts` both list these.
pub fn bounds_report_derived(derived: ref Vec[String], source: ref String) -> Vec[String] {
	let mut out: Vec[String] = []
	for row in derived {
		let parts: Vec[String] = row.split("\t").map(fn(p) { p.to_string() }).collect()
		if parts.len() != 3 {
			continue
		}
		let mut lines: Vec[String] = []
		for byte in parts[2].split(" ") {
			lines.push(bounds_report_line(source, text::parse_i64(byte) ?? 0).to_string())
		}
		out.push(f"{parts[0]}: {parts[1]}, proved at the calls on lines {lines.join(", ")}")
	}
	return out
}

/// The spaces that pad a text to `width`, by characters as Rust's `{:>4}` and
/// `{:<width$}` count them.
fn bounds_report_spaces(text: ref String, width: i64) -> String {
	let count = text.scalars.count()
	if count >= width {
		return ""
	}
	return " ".repeat(width - count)
}

fn bounds_report_function(
	args: ref Vec[FnArg],
	body: ref Block,
	words: ref winnow_grammar::InternerContext,
	source: ref String,
	facts: ref BoundsReportFacts,
	holes_of: fn(ref Expr) -> Vec[Expr] sync,
	mut walk: BoundsReportWalk,
) {
	bounds_report_block(body, args, body, words, source, facts, holes_of, walk)
}

fn bounds_report_lambda(
	lambda: ref Expr,
	args: ref Vec[FnArg],
	words: ref winnow_grammar::InternerContext,
	source: ref String,
	facts: ref BoundsReportFacts,
	holes_of: fn(ref Expr) -> Vec[Expr] sync,
	mut walk: BoundsReportWalk,
) {
	match lambda {
		Expr::Closure { body, .. } => bounds_report_function(
			args,
			body,
			words,
			source,
			facts,
			holes_of,
			walk,
		),
		else => {},
	}
}

/// **The bytes `--bounds-trace` asks about in this file** (#1495): `asked`
/// is `LINE` or `FILE:LINE`, a file named by the end of its path; the
/// result is `[from, to]` of that line, empty where it names another file
/// or no line of this one.
pub fn bounds_report_trace(source: ref String, path: ref String, asked: ref String) -> Vec[i64] {
	let mut number = text::parse_i64(asked.trim())
	let split = asked.rsplit_once(":")
	if split != null {
		let (file, line) = split ?? ("", "")
		if !path.ends_with(file) {
			return []
		}
		number = text::parse_i64(line.trim())
	}
	let wanted = number ?? return []
	if wanted < 1 {
		return []
	}
	let mut seen = 1
	let mut from = -1
	if wanted == 1 {
		from = 0
	}
	let mut at = 0
	while at < source.bytes.len() {
		if source.bytes[at] == 10 {
			if seen == wanted {
				return [from, at + 1]
			}
			seen += 1
			if seen == wanted {
				from = at + 1
			}
		}
		at += 1
	}
	if from < 0 {
		return []
	}
	return [from, source.bytes.len()]
}

/// **`--bounds-trace`'s block** (#1495), after the report: the line asked,
/// then each goal of a statement starting there with the facts it was asked
/// with, and each read with its verdict.
pub fn bounds_report_trace_rows(asked: ref String, rows: ref Vec[String]) -> String {
	if rows.is_empty() {
		return f"bounds trace {asked}: no goal\n"
	}
	return f"bounds trace {asked}:\n{rows.join("\n")}\n"
}

/// The line of a byte offset, counted from 1.
fn bounds_report_line(source: ref String, at: i64) -> i64 {
	let end = at.min(source.bytes.len())
	return source.bytes[0..<end].iter().filter(fn(b) { b == 10 }).count() + 1
}

fn bounds_report_block(
	block: ref Block,
	args: ref Vec[FnArg],
	body: ref Block,
	words: ref winnow_grammar::InternerContext,
	source: ref String,
	facts: ref BoundsReportFacts,
	holes_of: fn(ref Expr) -> Vec[Expr] sync,
	mut walk: BoundsReportWalk,
) {
	for stmt in block.stmts {
		bounds_report_stmt(stmt.node, stmt.span, args, body, words, source, facts, holes_of, walk)
		for inner in check_visit_stmt_blocks(stmt.node) {
			bounds_report_block(inner, args, body, words, source, facts, holes_of, walk)
		}
	}
}

/// Whether an operator is one the walk asks about: `+`, `-`, `*`, and `/`
/// and `%`, whose divisor is a goal (ADR-396 D7, #1578).
fn bounds_report_checked_op(op: BinaryOp) -> bool {
	return match op {
		BinaryOp::Add => true,
		BinaryOp::Sub => true,
		BinaryOp::Mul => true,
		BinaryOp::Div => true,
		BinaryOp::Rem => true,
		else => false,
	}
}

/// Whether the check sees the operation at `at`: an overflow in
/// `arithmetic`, a divisor in `divisions`.
fn bounds_report_seen(facts: ref BoundsReportFacts, at: i64) -> bool {
	return facts.arithmetic.contains_key(at) || facts.divisions.contains_key(at)
}

fn bounds_report_symbol(op: BinaryOp) -> String {
	return match op {
		BinaryOp::Add => "+",
		BinaryOp::Sub => "-",
		BinaryOp::Div => "/",
		BinaryOp::Rem => "%",
		else => "*",
	}
}

fn bounds_report_stmt(
	stmt: ref Stmt,
	span: ref Span,
	args: ref Vec[FnArg],
	body: ref Block,
	words: ref winnow_grammar::InternerContext,
	source: ref String,
	facts: ref BoundsReportFacts,
	holes_of: fn(ref Expr) -> Vec[Expr] sync,
	mut walk: BoundsReportWalk,
) {
	let at = span.start as i64
	let line = bounds_report_line(source, at)
	walk.at = Span { start: span.start, end: span.end }
	// **A compound assignment is its operation** (ADR-306 D5a): keyed by the
	// statement's first byte, where no operator of an expression stands.
	match stmt {
		Stmt::Assign { target, op, value } => {
			let which = op ?? BinaryOp::BitAnd
			if bounds_report_checked_op(which) && bounds_report_seen(facts, at) {
				let proved = facts.proven_arithmetic.contains(at)
				let mut blocked: String? = null
				if !proved {
					blocked = blocked_operation(
						which,
						target,
						value,
						args,
						body,
						words,
						source,
						walk.gate,
					)
				}
				walk.sites.push(BoundsReportSite {
					line: line,
					text: f"{written_expression(words, target)} {bounds_report_symbol(which)}= {written_expression(words, value)}",
					index: false,
					proved: proved,
					blocked: blocked,
					span: Span { start: span.start, end: span.end },
					keeps: bounds_report_keeps(which),
					guard: bounds_report_operation_guard(which, words, target, value),
				})
			}
		},
		else => {},
	}
	for expr in bounds_report_roots(stmt) {
		bounds_report_visit(expr, line, args, body, words, source, facts, holes_of, walk)
	}
}

/// The expressions a statement holds directly, without the blocks inside it.
fn bounds_report_roots(stmt: ref Stmt) -> Vec[ref Expr] {
	let mut out: Vec[ref Expr] = []
	match stmt {
		Stmt::Let { value, .. } => out.push(value),
		Stmt::Comptime { value, .. } => out.push(value),
		Stmt::Assign { target, value, .. } => {
			out.push(target)
			out.push(value)
		},
		Stmt::For { iter, .. } => out.push(iter),
		Stmt::While { cond, .. } => out.push(cond),
		Stmt::Return(value) => {
			match value {
				null => {},
				inner => out.push(inner),
			}
		},
		Stmt::Break => {},
		Stmt::Continue => {},
		Stmt::Expr(inner) => out.push(inner),
	}
	return out
}

/// Each expression a statement holds, in preorder, and a literal's holes right
/// after it (`contracts/sync.rs` `visit_expr`).
fn bounds_report_visit(
	expr: ref Expr,
	line: i64,
	args: ref Vec[FnArg],
	body: ref Block,
	words: ref winnow_grammar::InternerContext,
	source: ref String,
	facts: ref BoundsReportFacts,
	holes_of: fn(ref Expr) -> Vec[Expr] sync,
	mut walk: BoundsReportWalk,
) {
	bounds_report_site(expr, line, args, body, words, source, facts, walk)
	if check_visit_has_holes(expr) {
		for hole in holes_of(expr) {
			bounds_report_visit(hole, line, args, body, words, source, facts, holes_of, walk)
		}
	}
	for child in check_visit_children(expr) {
		bounds_report_visit(child, line, args, body, words, source, facts, holes_of, walk)
	}
}

fn bounds_report_site(
	expr: ref Expr,
	line: i64,
	args: ref Vec[FnArg],
	body: ref Block,
	words: ref winnow_grammar::InternerContext,
	source: ref String,
	facts: ref BoundsReportFacts,
	mut walk: BoundsReportWalk,
) {
	match expr {
		Expr::Index { base, index, .. } => {
			let key = node_key(base)
			if facts.lists.contains(key) && !walk.seen.contains(key) {
				walk.seen.insert(key)
				let proved = facts.proven_indices.contains(key)
				let mut blocked: String? = null
				if !proved {
					blocked = blocked_index(base, index, args, body, words, source, walk.gate)
				}
				walk.sites.push(BoundsReportSite {
					line: line,
					text: written_expression(words, expr),
					index: true,
					proved: proved,
					blocked: blocked,
					span: Span { start: walk.at.start, end: walk.at.end },
					keeps: "in bounds",
					guard: bounds_report_index_guard(words, base, index),
				})
			}
		},
		// **A word read of a `Bytes`** (ADR-320 D12), a candidate as the cut it
		// reads is: keyed by its receiver.
		Expr::MethodCall { receiver, args: given, .. } => {
			let key = node_key(receiver)
			if given.len() == 1 && facts.lists.contains(key) && !walk.seen.contains(key) {
				walk.seen.insert(key)
				let proved = facts.proven_indices.contains(key)
				let mut blocked: String? = null
				if !proved {
					blocked = blocked_index(receiver, given[0], args, body, words, source, walk.gate)
				}
				walk.sites.push(BoundsReportSite {
					line: line,
					text: written_expression(words, expr),
					index: true,
					proved: proved,
					blocked: blocked,
					span: Span { start: walk.at.start, end: walk.at.end },
					keeps: "in bounds",
					guard: bounds_report_index_guard(words, receiver, given[0]),
				})
			}
		},
		Expr::Binary { op, lhs, rhs, span, .. } => {
			let at = span.start as i64
			if bounds_report_checked_op(op) && bounds_report_seen(facts, at) {
				let proved = facts.proven_arithmetic.contains(at)
				let mut blocked: String? = null
				if !proved {
					blocked = blocked_operation(op, lhs, rhs, args, body, words, source, walk.gate)
				}
				walk.sites.push(BoundsReportSite {
					line: bounds_report_line(source, at),
					text: written_expression(words, expr),
					index: false,
					proved: proved,
					blocked: blocked,
					span: Span { start: span.start, end: span.end },
					keeps: bounds_report_keeps(op),
					guard: bounds_report_operation_guard(op, words, lhs, rhs),
				})
			}
		},
		// **A negation** (ADR-314 D5): it leaves its type only from the type's
		// least value.
		Expr::Unary { op, expr: operand, .. } => {
			let key = node_key(expr)
			if op == UnaryOp::Neg && facts.negations.contains_key(key) {
				let proved = facts.proven_negations.contains(key)
				let mut blocked: String? = null
				if !proved {
					blocked = "no fact keeps it above its type's least value"
				}
				let negated = written_expression(words, operand)
				walk.sites.push(BoundsReportSite {
					line: line,
					text: written_expression(words, expr),
					index: false,
					proved: proved,
					blocked: blocked,
					span: Span { start: walk.at.start, end: walk.at.end },
					keeps: "above its type's least value",
					guard: f"Keep `{negated}` above its type's least value where it arrives, with a guard the program handles (`return if {negated} < -LIMIT`, or a `throw` there). After that line, the negation is proved.",
				})
			}
		},
		else => {},
	}
}

/// What an operation is not proved to keep, for `NK1313`.
fn bounds_report_keeps(op: BinaryOp) -> String {
	return match op {
		BinaryOp::Div => "to divide by a value other than zero",
		BinaryOp::Rem => "to divide by a value other than zero",
		else => "inside its type",
	}
}

/// **The guard that proves an index** where the value arrives (ADR-306
/// D29): `return if i < 0 || i >= xs.len()`, a cut's bounds likewise.
fn bounds_report_index_guard(words: ref winnow_grammar::InternerContext, base: ref Expr, index: ref Expr) -> String {
	let list = written_expression(words, base)
	let guard = match index {
		Expr::Range { start, end, inclusive, .. } => {
			let from = written_expression(words, start)
			let to = written_expression(words, end)
			let past = if inclusive { ">=" } else { ">" }
			f"return if {from} < 0 || {from} > {to} || {to} {past} {list}.len()"
		},
		else => {
			let at = written_expression(words, index)
			f"return if {at} < 0 || {at} >= {list}.len()"
		},
	}
	return f"Check it where the value arrives, with a guard the program handles: `{guard}`, or a `throw` there. After that line, the read is proved and costs nothing."
}

/// **The guard that proves an operation** where its operands arrive
/// (ADR-306 D29): a divisor that is not zero, or the operands bounded.
fn bounds_report_operation_guard(op: BinaryOp, words: ref winnow_grammar::InternerContext, lhs: ref Expr, rhs: ref Expr) -> String {
	let left = written_expression(words, lhs)
	let right = written_expression(words, rhs)
	return match op {
		BinaryOp::Div => f"Check the divisor where it arrives, with a guard the program handles: `return if {right} == 0`, or a `throw` there. After that line, the division is proved.",
		BinaryOp::Rem => f"Check the divisor where it arrives, with a guard the program handles: `return if {right} == 0`, or a `throw` there. After that line, the division is proved.",
		else => {
			let named = [left.clone(), right.clone()].iter().filter(fn(t) { !bounds_report_number(t) }).map(fn(t) { t.clone() }).collect()
			let first = named.first()?.clone() ?? left
			let others = if named.len() > 1 { f", and the same for `{named[1]}`" } else { "" }
			f"Bound the operands where they arrive, with a guard the program handles: `return if {first} > LIMIT || {first} < -LIMIT`{others}, or a `throw` there. After that, the operation is proved."
		},
	}
}

/// Whether a written operand is a number, which needs no guard.
fn bounds_report_number(written: ref String) -> bool {
	return written.bytes.len() > 0 && written.bytes[0] >= 48 && written.bytes[0] <= 57
}
