// crates/nikaia-std/src/compiler/locks.nika
//
// Kap 9.4: **which functions can open a lock** - the lattice of the compiler's
// `contracts::locks`, moved from Rust (ADR-294, #125), as `throws.nika` holds
// `contracts::throws`'.
//
// **The walk and the fixpoint.** Per function, the door it opens itself and
// whom it calls: the base case is the checker's answer about method calls
// (ADR-288), which the compiler hands in as `BodyCalls`, and the free calls
// are `tools/foreign.nika`'s walk. A function field's stored code is a node
// of its own, keyed `field:Type.field` (ADR-230 D1). `locks_infer` hands in
// each unit and writes the answer into the ledger (#1913); what stays Rust is
// the adapter that times the pass and reads a unit's holes.
//
// Whether a function **touches a lock** (ADR-281 D3), propagated over the same call graph `sync` uses and with the opposite
// lattice.
//
// ## One traversal and two lattices
//
// | | starts from | rule |
// | :--- | :--- | :--- |
// | `sync` | everyone is `sync` | **greatest** fixpoint — take the claim from whoever reaches a non-holder |
// | this | nobody touches one | **least** fixpoint — give the property to whoever reaches a holder |
//
// So mutual recursion between pure functions keeps `sync`
// (ADR-288 D1) and correctly
// gets nothing here, for the mirrored reason — the same shape `keeps` has
// beside it, and for the same reason: a restriction is added on doubt where a
// promise is taken away on doubt.
//
// ## What a base case is, and why the checker answers it
//
// A **door** is `get`, `set`, `access` or `update` on a `Locked` or a
// `SharedMut`, and `access_all` or `update_all` over several
// (ADR-281 D10,
// ADR-281). Which of those a
// call goes to is a question about the **receiver's type**, and this file has
// none: `kasse.set(42)` names `set`, and so does a `Config::set` somebody
// wrote. So the base case is read from `check::MethodCalls::resolved`, which is
// the type checker's answer (ADR-288)
// — the same arrangement `keeps` uses for its receivers, and for the same
// reason.
//
// **Guessing by name would make the column worthless rather than merely
// coarse.** `set` and `get` are among the most common method names a program
// writes; a column that answered *touches a lock* for every one of them would
// be set almost everywhere, and a refusal reading it would refuse correct
// programs — which is the one thing Part III C.4 forbids.
//
// ## Fail-closed, and what that costs here
//
// An **unresolvable** call sets the property, which is D3's own sentence: it
// takes the `sync` claim away *and* sets this, so one polarity decision serves
// both. That is the safe direction for a refusal about deadlock — the wrong
// answer the other way is a program that hangs.
//
// **It is also why nothing reads this column yet.** The measurement comes
// first: a property that lands on most of the corpus is one whose refusals
// would be noise, and that is a thing to find out before `NK2201` and `NK2203`
// are written against it, not after.
//
// ## Where it is written
//
// **The walk, the doors, the fixpoint and writing the answer are Nikaia**
// (this file, #125, #1913). What stays in `contracts/locks.rs` is the adapter
// that hands in each unit's view, its literals' holes and the checker's
// resolved calls as plain data.
//
// ## A scope's tasks count and a `spawn` does not
//
// A scope waits for its tasks, so they run **during** the call and their bodies
// belong to the surrounding function — the same reason a trailing lambda's body
// does (ADR-288 D16). A task
// started with `spawn` runs later and elsewhere, so taking a lock in one is the
// ordinary case and its body is not walked.

use std::collections

/// The entries that open a lock, by their ledger keys (ADR-281 D10). A closed
/// list, like `touch`'s kinds and for the same reason: a name this does not
/// know is answered *no*, and a name it knew wrongly would be a claim about a
/// program nobody made. The witness door (D5) is under the key it is written
/// with, and opens a lock exactly as `set` does.
comptime DOORS: Array[ref String, 10] = ["Locked::get", "Locked::set", "Locked::set(after)", "Locked::access", "Locked::update", "SharedMut::get", "SharedMut::set", "SharedMut::set(after)", "SharedMut::access", "SharedMut::update"]

/// The doors over **several** locks, which are free calls rather than
/// methods, and so are named here rather than found among the resolved
/// receivers.
comptime MULTI: Array[ref String, 2] = ["access_all", "update_all"]

/// The prefix a function field's node is keyed by: no function's key starts
/// with it.
comptime FIELD: ref String = "field:"

/// What the checker resolved in one body, the part this walk reads: the calls
/// it resolved **outside** a `spawn` (a task's body runs later and elsewhere,
/// so a lock taken there is the ordinary case, D3), whether one of those could
/// not be resolved, and the function fields it called.
pub struct BodyCalls {
    pub resolved: collections::BTreeSet[String],
    pub unresolved: bool,
    pub fields_called: collections::BTreeSet[String],
}

/// What one body reaches, before the fixpoint: what it says on its own - a
/// door it opens, or the doubt an unresolvable call leaves - and whom it
/// calls, by the keys the ledger records them under.
pub struct Reaches {
    pub itself: Lock,
    pub callees: collections::BTreeSet[String],
}

/// Code stored in a function field, as a node of its own (ADR-230 D1): what
/// every lambda and function put there reaches, under `field:Type.field`.
pub fn stored_reaches(field: ref String, resolved: ref collections::BTreeSet[String], unresolved: bool, free: ref collections::BTreeSet[String], mut graph: collections::BTreeMap[String, Reaches]) {
    let mut reaches = Reaches { itself: Lock::No, callees: collections::BTreeSet() }
    if unresolved {
        reaches.itself = reaches.itself.or(Lock::Undecided)
    }
    if any_in(resolved, DOORS) || any_in(free, MULTI) {
        reaches.itself = reaches.itself.or(Lock::Holds)
    }
    reaches.callees.extend(resolved.clone())
    for to in free {
        // `@F::p` is a parameter of code handed on (ADR-351 D4): code this
        // walk does not see.
        if to.starts_with("@") {
            reaches.itself = reaches.itself.or(Lock::Undecided)
            continue
        }
        reaches.callees.insert(to.clone())
    }
    graph.insert(f"{FIELD}{field}", reaches)
}

/// Every function, method and `pub` grammar rule of one unit, into `graph`,
/// under the key the ledger uses. `calls` is the checker's answer by that key.
fn unit_reaches(items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, calls: ref collections::BTreeMap[String, BodyCalls], mut graph: collections::BTreeMap[String, Reaches]) {
    for item in items {
        match item.node {
            Item::Fn { name, body, .. } => {
                let key = key_of_function(name, "", names)
                graph.insert(key.clone(), body_reaches(body, calls[key], names, unaliased, holes_of))
            }
            Item::Impl { target, methods, .. } => {
                let owner = names.resolve(target.name).clone()
                for method in methods {
                    match method.node {
                        Item::Fn { name, body, .. } => {
                            let key = key_of_function(name, owner, names)
                            graph.insert(key.clone(), body_reaches(body, calls[key], names, unaliased, holes_of))
                        }
                        else => {}
                    }
                }
            }
            // **A `entry` rule is an entry, so it gets the walk too** (ADR-grammar-syntax-v1
            // D5). Its body is every action block in the grammar: a rule's
            // pattern names other rules of the same grammar and their actions
            // run with it, so the grammar is the unit - which is the safe
            // direction here, because a lock this walk does not see is a
            // deadlock the checker does not refuse.
            Item::Grammar(def) => rules_reaches(def, names, unaliased, holes_of, calls, graph),
            else => {}
        }
    }
}

/// **The `locks` column of a package's ledger** (Kap 9.4): whether each
/// function can open a lock, and which function fields' stored code can,
/// from the checker's method answers (`resolved`, by the ledger's key) and
/// the code stored in function fields (`stored`). `holes_of(unit, expr)` is
/// what unit `unit` wrote in a hole of `expr`.
pub fn locks_infer(mut ledger: Ledger, units: ref Vec[ParsedView], library: ref Ledger, resolved: ref collections::BTreeMap[String, CheckMethodCalls], stored: ref collections::BTreeMap[String, CheckStoredCode], holes_of: fn(i64, ref Expr) -> Vec[Expr] sync) {
    // A call made inside a `spawn` runs later and elsewhere (D3), so it is
    // left out of the body's own calls.
    let calls: collections::BTreeMap[String, BodyCalls] = resolved.iter().map(fn(entry) { (entry.0.clone(), outside_a_task(entry.1)) }).collect()
    let mut graph: collections::BTreeMap[String, Reaches] = collections::BTreeMap()
    for (field, code) in stored {
        stored_reaches(field, code.resolved, code.unresolved, code.free, graph)
    }
    let mut declared: collections::BTreeSet[String] = collections::BTreeSet()
    for unit in 0..<units.len() {
        let view = units[unit]
        unit_reaches(view.items, view.words, fn(name) { view.unaliased(name) }, fn(expr) { holes_of(unit, expr) }, calls, graph)
        declared_types(view.items, view.words, declared)
    }
    declared.extend(ledger.types.keys().cloned())
    declared.extend(library.types.keys().cloned())
    let answer = locking_callees_first(graph, declared, library, ledger)
    for (name, holds) in answer.functions {
        let mut contract = ledger.functions.get(name) ?? continue
        contract.touches_a_lock = holds
    }
    ledger.code_locks.extend(answer.fields)
}

/// What the walk reads of one body's method answers: the calls outside a
/// `spawn`, whether one of those could not be resolved, and the function
/// fields it called.
fn outside_a_task(calls: ref CheckMethodCalls) -> BodyCalls {
    return BodyCalls { resolved: calls.resolved.iter().filter(fn(to) { !calls.in_a_task.resolved.contains(to) }).cloned().collect(), unresolved: calls.unresolved && !calls.in_a_task.unresolved, fields_called: calls.fields_called.clone() }
}

/// The free calls a lambda's body makes, for the checker to remember with the
/// function field it is stored in (ADR-230 D1).
pub fn free_calls(body: ref Block, names: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> collections::BTreeSet[String] {
    let mut reaches = Reaches { itself: Lock::No, callees: collections::BTreeSet() }
    walk_calls(body, names, unaliased, holes_of, reaches)
    return reaches.callees
}

/// The types one unit declares, into `declared`: **a variant is a value, not
/// a callee** - `Json::Array(items)` builds a value and runs no body - and the
/// type is everything but the last segment.
fn declared_types(items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, mut declared: collections::BTreeSet[String]) {
    for item in items {
        match item.node {
            Item::Enum { name, .. } => {
                declared.insert(names.resolve(name).clone())
            }
            Item::Struct { name, .. } => {
                declared.insert(names.resolve(name).clone())
            }
            else => {}
        }
    }
}

/// The fixpoint over a graph the walk built, the whole package at once: the
/// reference the callees-first route is held to (ADR-100 D7).
pub fn locking_of(graph: ref collections::BTreeMap[String, Reaches], declared: ref collections::BTreeSet[String], library: ref Ledger, own: ref Ledger) -> Locking {
    let mut itself: collections::BTreeMap[String, Lock] = collections::BTreeMap()
    let mut callees: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    for (name, reaches) in graph {
        itself.insert(name.clone(), reaches.itself.clone())
        callees.insert(name.clone(), reaches.callees.clone())
    }
    return locking(itself, callees, declared, library, own)
}

// The key a function is recorded under: its name, after its type's where it
// is a method; the anonymous constructor of Part I 4.2 is `new`, which a
// caller reaches as `Type::new`.
fn key_of_function(name: ref winnow_grammar::Symbol?, owner: ref String, names: ref winnow_grammar::InternerContext) -> String {
    let symbol = name ?? return with_owner(owner, "new")
    return with_owner(owner, names.resolve(symbol))
}

fn with_owner(owner: ref String, own: ref String) -> String {
    if owner.len() == 0 {
        return own.clone()
    }
    return f"{owner}::{own}"
}

// What one body reaches: the checker's resolved calls, then the free calls the
// walk finds.
fn body_reaches(body: ref Block, calls: ref BodyCalls?, names: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> Reaches {
    let mut reaches = Reaches { itself: Lock::No, callees: collections::BTreeSet() }
    resolved_into(calls, true, reaches)
    walk_calls(body, names, unaliased, holes_of, reaches)
    return reaches
}

// **The base case is the checker's answer** (ADR-288): which entry
// `kasse.set(42)` goes to is a question about the receiver's type. A rule's
// entry has no function fields of its own to call.
fn resolved_into(calls: ref BodyCalls?, with_fields: bool, mut reaches: Reaches) {
    let known = calls ?? return
    if known.unresolved {
        reaches.itself = reaches.itself.or(Lock::Undecided)
    }
    if any_in(known.resolved, DOORS) {
        reaches.itself = reaches.itself.or(Lock::Holds)
    }
    reaches.callees.extend(known.resolved.clone())
    if with_fields {
        for field in known.fields_called {
            reaches.callees.insert(f"{FIELD}{field}")
        }
    }
}

fn rules_reaches(def: ref GrammarDef, names: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, calls: ref collections::BTreeMap[String, BodyCalls], mut graph: collections::BTreeMap[String, Reaches]) {
    let named = names.resolve(def.name).clone()
    let mut whole = Reaches { itself: Lock::No, callees: collections::BTreeSet() }
    for rule in def.rules {
        for alt in rule.alts {
            let action = alt.action ?? continue
            walk_calls(action, names, unaliased, holes_of, whole)
        }
    }
    for rule in def.rules {
        if !rule.is_entry {
            continue
        }
        let key = f"{named}::{names.resolve(rule.name)}"
        let mut reaches = Reaches { itself: whole.itself.clone(), callees: whole.callees.clone() }
        resolved_into(calls[key], false, reaches)
        graph.insert(key, reaches)
    }
}

// Every free call a body makes, the blocks it holds included, by the walk of
// `tools/foreign.nika`, each name with the file's alias resolved. A `spawn`'s
// body is not descended into (D3). **A door over several locks is a free
// call** (ADR-281), so it is named here where every other free call is.
fn walk_calls(block: ref Block, names: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, mut reaches: Reaches) {
    for seen in seen_in(block, names, unaliased, holes_of, no_root, false) {
        match seen {
            Seen::Call { name, .. } => {
                let called = unaliased(name)
                if a_name_in(called, MULTI) {
                    reaches.itself = reaches.itself.or(Lock::Holds)
                }
                reaches.callees.insert(called)
            }
            else => {}
        }
    }
}

// Nobody asks this walk where a `root` stands.
fn no_root(_name: ref String) -> i64 sync {
    return -1
}

fn any_in(names: ref collections::BTreeSet[String], table: ref Array[ref String]) -> bool {
    for name in names {
        if a_name_in(name, table) {
            return true
        }
    }
    return false
}

fn a_name_in(name: ref String, table: ref Array[ref String]) -> bool {
    for one in table {
        if one == name {
            return true
        }
    }
    return false
}

/// What the fixpoint answers: each function's `touches_a_lock`, and each
/// function field's, by the keys the ledger records them under.
pub struct Locking {
    pub functions: collections::BTreeMap[String, Lock],
    pub fields: collections::BTreeMap[String, Lock],
}

/// The least fixpoint: give the property to whoever reaches a holder, until
/// nothing changes. `itself` is what each node says on its own - a door it
/// opens, or the doubt an unresolvable call leaves - and `callees` whom it
/// calls. `declared` is every type this package or a library declares, so a
/// variant reads as the value it is. Maps throughout, so the answer does not
/// depend on the order the source declared things in: Part III 13.5 makes the
/// ledger a pure function of (source, toolchain), and `--locked` compares it
/// byte for byte.
pub fn locking(itself: ref collections::BTreeMap[String, Lock], callees: ref collections::BTreeMap[String, collections::BTreeSet[String]], declared: ref collections::BTreeSet[String], library: ref Ledger, own: ref Ledger) -> Locking {
    let mut touches = itself.clone()
    let mut changed = true
    while changed {
        changed = false
        for (name, called) in callees {
            let before = touches[name]?.clone() ?? Lock::No
            if before.holds() {
                continue
            }
            let mut reached = Lock::No
            for callee in called {
                reached = reached.or(theirs_of(touches, nothing_stored(), library, declared, callee))
            }
            let grown = before.or(reached)
            if grown != before {
                touches.insert(name.clone(), grown)
                changed = true
            }
        }
    }
    return settled(touches, own)
}

/// **The answer the ledger records**, from every node's final column: a
/// function this package describes keeps its own, and a function field's
/// column is doubted where the field is published.
fn settled(touches: ref collections::BTreeMap[String, Lock], own: ref Ledger) -> Locking {
    let mut answer = Locking { functions: collections::BTreeMap(), fields: collections::BTreeMap() }
    for (name, holds) in touches {
        if name.starts_with("field:") {
            let c: Vec[scalar] = name.scalars.collect()
            let field = slice(c, 6, c.len())
            // **A published field is stored into by packages that do not exist
            // yet** (ADR-230 D1), so what this one stores is not all there is.
            let settled = if published(own, field) { holds.clone().or(Lock::Undecided) } else { holds.clone() }
            answer.fields.insert(field, settled)
        } else if own.functions.contains_key(name) {
            answer.functions.insert(name.clone(), holds.clone())
        }
    }
    return answer
}

/// What a callee brings, **by the rule `sync::reached` resolves a call with**,
/// so the two analyses agree on what a call is: the name as written, then the
/// anonymous constructor's key (`Stats(t)` is `Stats::new`, Part I 4.2,
/// ADR-140 D2), in this package before the library. A variant is a value and
/// opens no door; a callee no ledger describes is the doubt an unresolvable
/// method is, reached from the other side.
/// `touches` holds the columns being derived, `stored` those already final
/// (ADR-100 D7): a callee is read from the first that has it.
fn theirs_of(touches: ref collections::BTreeMap[String, Lock], stored: ref collections::BTreeMap[String, Lock], library: ref Ledger, declared: ref collections::BTreeSet[String], callee: ref String) -> Lock {
    let constructed = f"{callee}::new"
    for key in [callee.clone(), constructed] {
        let found = touches[key]?.clone() ?? stored[key]?.clone() ?? described(library, key) ?? continue
        return found
    }
    return if is_a_variant(declared, callee) { Lock::No } else { Lock::Undecided }
}

/// No column stored yet: the whole-package fixpoint derives every node itself.
fn nothing_stored() -> collections::BTreeMap[String, Lock] {
    return collections::BTreeMap()
}

/// **One function's final column, or its recursive group's** (ADR-100 D7):
/// `unit` is the function, or the strongly connected component it is a part
/// of, `graph` what each body reaches, and `stored` the final columns of the
/// callees outside the unit. The least fixpoint runs inside the unit only; a
/// callee neither in it nor stored is read as `locking` reads it, from the
/// library's ledger, as a variant or as the doubt. Answers every node of the
/// unit, a function field's raw column included.
pub fn locks_of_unit(unit: ref Vec[String], graph: ref collections::BTreeMap[String, Reaches], stored: ref collections::BTreeMap[String, Lock], declared: ref collections::BTreeSet[String], library: ref Ledger) -> collections::BTreeMap[String, Lock] {
    let mut touches: collections::BTreeMap[String, Lock] = collections::BTreeMap()
    for name in unit {
        let itself = graph[name]?.itself?.clone() ?? Lock::No
        touches.insert(name.clone(), itself)
    }
    let mut changed = true
    while changed {
        changed = false
        for name in unit {
            let before = touches[name]?.clone() ?? Lock::No
            if before.holds() {
                continue
            }
            let reaches = graph[name] ?? continue
            let mut reached = Lock::No
            for callee in reaches.callees {
                reached = reached.or(theirs_of(touches, stored, library, declared, callee))
            }
            let grown = before.or(reached)
            if grown != before {
                touches.insert(name.clone(), grown)
                changed = true
            }
        }
    }
    return touches
}

/// **The whole package, callees first** (ADR-100 D7): the graph's strongly
/// connected components in reverse topological order, each derived by
/// `locks_of_unit` from the columns its callees already have. The least
/// fixpoint is unique, so this answers what `locking_of` answers.
pub fn locking_callees_first(graph: ref collections::BTreeMap[String, Reaches], declared: ref collections::BTreeSet[String], library: ref Ledger, own: ref Ledger) -> Locking {
    let mut stored: collections::BTreeMap[String, Lock] = collections::BTreeMap()
    for unit in callees_first(graph, library) {
        let column = locks_of_unit(unit, graph, stored, declared, library)
        stored.extend(column)
    }
    return settled(stored, own)
}

/// The node of the graph a call reaches, by the order `theirs_of` reads a
/// callee in: the name as written, then, where no library describes it, the
/// anonymous constructor's key. None where the call leaves the graph.
fn edge_of(graph: ref collections::BTreeMap[String, Reaches], library: ref Ledger, callee: ref String) -> String? {
    if graph.contains_key(callee) {
        return callee.clone()
    }
    if library.functions.contains_key(callee) {
        return null
    }
    let constructed = f"{callee}::new"
    if graph.contains_key(constructed) {
        return constructed
    }
    return null
}

/// Tarjan's walk over the call graph: each node's visit number and lowest
/// reachable one, the nodes still open, and the components in the order they
/// close, which is callees first.
struct Components {
    index: collections::BTreeMap[String, i64],
    low: collections::BTreeMap[String, i64],
    open: collections::BTreeSet[String],
    stack: Vec[String],
    units: Vec[Vec[String]],
    next: i64,
}

/// The graph's recursive groups, each a unit, in reverse topological order: a
/// unit comes after every unit it calls into.
pub fn callees_first(graph: ref collections::BTreeMap[String, Reaches], library: ref Ledger) -> Vec[Vec[String]] {
    let mut walk = Components { index: collections::BTreeMap(), low: collections::BTreeMap(), open: collections::BTreeSet(), stack: [], units: [], next: 0 }
    for (name, _) in graph {
        if !walk.index.contains_key(name) {
            connect(graph, library, name, walk)
        }
    }
    return walk.units
}

fn connect(graph: ref collections::BTreeMap[String, Reaches], library: ref Ledger, name: ref String, mut walk: Components) {
    walk.index.insert(name.clone(), walk.next)
    walk.low.insert(name.clone(), walk.next)
    walk.next = walk.next + 1
    walk.stack.push(name.clone())
    walk.open.insert(name.clone())
    let reaches = graph[name] ?? return
    for callee in reaches.callees {
        let to = edge_of(graph, library, callee) ?? continue
        let mut reached = -1
        if !walk.index.contains_key(to) {
            connect(graph, library, to, walk)
            reached = walk.low[to] ?? -1
        } else if walk.open.contains(to) {
            reached = walk.index[to] ?? -1
        }
        let mine = walk.low[name] ?? 0
        if reached >= 0 && reached < mine {
            walk.low.insert(name.clone(), reached)
        }
    }
    if (walk.low[name] ?? -1) != (walk.index[name] ?? -2) {
        return
    }
    let mut unit: Vec[String] = []
    while true {
        let top = walk.stack.pop() ?? break
        walk.open.remove(top)
        let last = top == name
        unit.push(top)
        if last {
            break
        }
    }
    walk.units.push(unit)
}

/// What a library's ledger says a function does about locks, where it says.
fn described(library: ref Ledger, key: ref String) -> Lock? {
    let contract = library.functions[key] ?? return null
    return contract.touches_a_lock.clone()
}

/// **A variant is a value, not a callee**: `Json::Array(items)` builds a value
/// and runs no body. The type is everything but the last segment, and one this
/// package or a library declares. `Type::new` is the constructor, never a
/// variant: a constructor no ledger describes stays the doubt it is, the safe
/// direction - a lock this walk does not see is a deadlock nothing refuses.
fn is_a_variant(declared: ref collections::BTreeSet[String], callee: ref String) -> bool {
    let mut parts: Vec[String] = []
    for part in callee.split("::") {
        parts.push(part.clone())
    }
    if parts.len() < 2 || parts[parts.len() - 1] == "new" {
        return false
    }
    return declared.contains(struct_type(callee))
}

/// Whether `Type.field` is a public field of a public type.
fn published(own: ref Ledger, field: ref String) -> bool {
    let c: Vec[scalar] = field.scalars.collect()
    let dot = find_text(c, 0, ".")
    if dot < 0 {
        return false
    }
    let owner = slice(c, 0, dot)
    let name = slice(c, dot + 1, c.len())
    let contract = own.types[owner] ?? return false
    if !contract.public {
        return false
    }
    for one in contract.fields {
        if one.name == name && one.public {
            return true
        }
    }
    return false
}

/// One node of a test graph: what it does itself and the one function it
/// calls, if any.
fn locks_test_node(mut graph: collections::BTreeMap[String, Reaches], name: String, itself: Lock, callee: String?) {
    let mut reaches = Reaches { itself: itself, callees: collections::BTreeSet() }
    if callee != null {
        reaches.callees.insert(callee ?? "")
    }
    graph.insert(name, reaches)
}

/// **A pass entry is tested by a `test` block in its own file** (ADR-403 D3,
/// #1983): `locking_of`, the whole-package fixpoint, over a call chain into a
/// door, a recursive pair that opens none, and a call nothing describes; and
/// the private `with_owner`, which a program outside std cannot reach.
test "the locks entry answers a call chain, a recursive pair and an unknown call" {
    let mut graph: collections::BTreeMap[String, Reaches] = collections::BTreeMap()
    locks_test_node(graph, "a", Lock::No, "b")
    locks_test_node(graph, "b", Lock::No, "c")
    locks_test_node(graph, "c", Lock::Holds, null)
    locks_test_node(graph, "p", Lock::No, "q")
    locks_test_node(graph, "q", Lock::No, "p")
    locks_test_node(graph, "r", Lock::No, "mystery")
    let mut own = Ledger::blank()
    for name in ["a", "b", "c", "p", "q", "r"] {
        own.functions.insert(with_owner("", name), FnContract::empty())
    }
    let answer = locking_of(graph, collections::BTreeSet(), Ledger::blank(), own)
    assert(answer.functions.len() == 6)
    assert((answer.functions["a"] ?? Lock::No) == Lock::Holds)
    assert((answer.functions["b"] ?? Lock::No) == Lock::Holds)
    assert((answer.functions["c"] ?? Lock::No) == Lock::Holds)
    assert((answer.functions["p"] ?? Lock::Holds) == Lock::No)
    assert((answer.functions["q"] ?? Lock::Holds) == Lock::No)
    assert((answer.functions["r"] ?? Lock::No) == Lock::Undecided)
    assert(with_owner("Config", "set") == "Config::set")
}

/// **The per-function entry answers what the whole-package entry answers**
/// (ADR-100 D7, ADR-403 D3): on a call chain into a door, a recursive pair
/// that opens none, a recursive group of three one of whose members opens a
/// door, and a call nothing describes. The chain's head is derived from its callee's
/// stored column alone, each pair as one unit.
test "the per-function locks entry gives the whole-package column" {
    let mut graph: collections::BTreeMap[String, Reaches] = collections::BTreeMap()
    locks_test_node(graph, "a", Lock::No, "b")
    locks_test_node(graph, "b", Lock::No, "c")
    locks_test_node(graph, "c", Lock::Holds, null)
    locks_test_node(graph, "p", Lock::No, "q")
    locks_test_node(graph, "q", Lock::No, "p")
    locks_test_node(graph, "s", Lock::No, "t")
    let mut both = Reaches { itself: Lock::No, callees: collections::BTreeSet() }
    both.callees.insert("s")
    both.callees.insert("u")
    graph.insert("t", both)
    locks_test_node(graph, "u", Lock::Holds, "t")
    locks_test_node(graph, "r", Lock::No, "mystery")
    let mut own = Ledger::blank()
    for name in ["a", "b", "c", "p", "q", "s", "t", "u", "r"] {
        own.functions.insert(with_owner("", name), FnContract::empty())
    }
    let whole = locking_of(graph, collections::BTreeSet(), Ledger::blank(), own)
    let first = locking_callees_first(graph, collections::BTreeSet(), Ledger::blank(), own)
    assert(whole.functions == first.functions)
    assert(whole.fields == first.fields)
    assert((first.functions["s"] ?? Lock::No) == Lock::Holds)
    assert((first.functions["p"] ?? Lock::Holds) == Lock::No)
    let units = callees_first(graph, Ledger::blank())
    let mut pair = 0
    for unit in units {
        if unit.len() > 1 {
            pair = pair + 1
        }
    }
    // `p, q` and `s, t, u` are the recursive groups.
    assert(pair == 2)
    let mut stored: collections::BTreeMap[String, Lock] = collections::BTreeMap()
    stored.insert("b", Lock::Holds)
    let alone: Vec[String] = [with_owner("", "a")]
    let head = locks_of_unit(alone, graph, stored, collections::BTreeSet(), Ledger::blank())
    assert((head["a"] ?? Lock::No) == (whole.functions["a"] ?? Lock::No))
}
