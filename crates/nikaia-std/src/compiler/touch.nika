// crates/nikaia-std/src/compiler/touch.nika
//
// **What an operation reaches, and whether it changes it** (ADR-292, ADR-288
// D2) - the decisions of the compiler's `contracts::touch`, moved from Rust
// (ADR-294, #125): when two reached resources might be one and force an
// order, and the fixpoint that gives every function the `touches` its body
// earns.
//
// The walk that finds what each body reaches and whom it calls is here too
// (ADR-288 D22): the calls are `tools/foreign.nika`'s walk, what each goes to
// is `callee_named`, and a method call is the type checker's answer, handed
// in, and so is the answer written into the ledger, in the order a set is
// kept (`touches_infer`). The fixpoint has two entries (ADR-100 D7): one
// function's column, or its recursive group's, from its callees' stored
// columns (`touches_of_unit`), which the package runs callees first, and the
// whole package at once (`touches_of_graph`), the reference. What stays Rust
// is building each unit's view and the holes the emitter reads in it.

use std::collections

/// Which resource a **call** reaches, with the parameter filled in. A ledger
/// says `file(path)`; a call site says `file` of `"measurements.txt"`, and
/// this is the second, what two calls are compared on.
pub struct Reached {
    pub kind: String,
    /// The argument that named it, where the compiler could see one. `null`
    /// means the kind's only resource (`stdout`) **or** an argument this
    /// compiler cannot evaluate - not told apart, because an unknown argument
    /// is "might be any of them", which is the answer both want.
    pub named: String?,
    /// Where the argument was not readable, so `named` is not a name.
    pub unknown: bool,
    pub write: bool,
}

impl Reached {
    /// Whether two reached resources might be the same one. Different
    /// **families** never are (`stdout` and `stderr` are one destination as
    /// soon as somebody writes `2>&1`); the same family under two different
    /// known names never are. Everything else might be, and "might be" is the
    /// answer that keeps the order.
    fn might_be_same(ref self, other: ref Reached) -> bool {
        if family(self.kind) != family(other.kind) {
            return false
        }
        if self.unknown || other.unknown {
            return true
        }
        let mine = self.named?.clone() ?? return true
        let theirs = other.named?.clone() ?? return true
        return mine == theirs
    }

    /// Whether two reached resources force an order between their operations.
    /// Two reads never do, however much they overlap: reading does not change
    /// what the other one sees.
    fn conflicts_with(ref self, other: ref Reached) -> bool {
        return (self.write || other.write) && self.might_be_same(other)
    }
}

/// The family a kind belongs to, which is what two resources are compared
/// on: the two console handles are one, and every other kind is its own.
/// Deliberately not the claim that any two resources might coincide - D2
/// names the file the program named, and ordinary statements (ADR-292 D1) are the escape for
/// resources that look disjoint and are not.
fn family(kind: ref String) -> String {
    if kind == "stderr" {
        return "stdout"
    }
    return kind.clone()
}

/// **What every function whose claim holds touches**, by name - the greatest
/// fixpoint, for `sync`'s reason: start from "every function touches
/// nothing", and take the claim away from anything that reaches one without
/// it, until nothing changes. Mutual recursion between two functions that
/// touch nothing keeps the claim, which is right. `unknown` is a body that
/// reaches something unaccounted for, `outside` what it reaches through
/// callees a library describes, `calls` whom in this package it calls. The
/// set is a union over the whole reachable graph, because what a caller
/// reaches is what everything it calls reaches.
fn touches_of(unknown: ref collections::BTreeMap[String, bool], outside: ref collections::BTreeMap[String, Vec[Touch]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]]) -> collections::BTreeMap[String, Vec[Touch]] {
    let mut known: collections::BTreeMap[String, bool] = collections::BTreeMap()
    for (name, lost) in unknown {
        known.insert(name.clone(), !lost)
    }
    let mut changed = true
    while changed {
        changed = false
        for (name, called) in calls {
            let holds = known[name] ?? false
            if !holds {
                continue
            }
            let mut reaches_unknown = false
            for callee in called {
                let theirs = known[callee] ?? false
                if !theirs {
                    reaches_unknown = true
                }
            }
            if reaches_unknown {
                known.insert(name.clone(), false)
                changed = true
            }
        }
    }
    let mut settled: collections::BTreeMap[String, Vec[Touch]] = collections::BTreeMap()
    for (name, holds) in known {
        if !holds {
            continue
        }
        let mut found: Vec[Touch] = []
        let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
        let mut todo: Vec[String] = [name.clone()]
        while todo.len() > 0 {
            let here = todo.pop() ?? break
            if seen.contains(here) {
                continue
            }
            seen.insert(here.clone())
            for touch in outside[here]?.clone() ?? [] {
                found.push(touch)
            }
            for callee in calls[here]?.clone() ?? collections::BTreeSet() {
                todo.push(callee)
            }
        }
        settled.insert(name.clone(), found)
    }
    return settled
}

/// What one body reaches, before the fixpoint joins it up (ADR-288 D22):
/// whether something it calls is not accounted for - a name no ledger knows,
/// a construct that runs something, a described callee whose own touch set is
/// *"nobody said"* - what it reaches through callees a library describes, and
/// the functions in this package it calls, whose claims its own rests on.
pub struct Reach {
    pub unknown: bool,
    pub outside: Vec[Touch],
    pub calls: collections::BTreeSet[String],
}

/// The graph the walk builds, with the type checker's method calls by the
/// key it files each body's answers under (ADR-288) - one record, because
/// every function of a unit reads the one and writes the other.
pub struct TouchGraph {
    pub methods: collections::BTreeMap[String, MethodsCalled],
    pub reaches: collections::BTreeMap[String, Reach],
}

/// Every function, method and `pub` grammar rule of one unit, into `graph`.
/// What a call by name goes to is `callee_named`, the one resolution every
/// analysis shares (ADR-288); a method call is the type checker's answer.
fn unit_touches(items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, own: ref Ledger, library: ref Ledger, mut graph: TouchGraph) {
    for item in items {
        match item.node {
            Item::Fn { name, body, .. } => {
                let key = key_of_function(name, "", names)
                let mut reach = Reach { unknown: false, outside: [], calls: collections::BTreeSet() }
                reached_by(seen_in(body, names, unaliased, holes_of, no_root, false), items, names, own, library, reach)
                methods_reach(graph.methods[key], own, library, reach)
                graph.reaches.insert(key, reach)
            }
            Item::Impl { target, methods, .. } => {
                let owner = names.resolve(target.name).clone()
                for method in methods {
                    match method.node {
                        Item::Fn { name, body, .. } => {
                            let key = key_of_function(name, owner, names)
                            let mut reach = Reach { unknown: false, outside: [], calls: collections::BTreeSet() }
                            reached_by(seen_in(body, names, unaliased, holes_of, no_root, false), items, names, own, library, reach)
                            methods_reach(graph.methods[key], own, library, reach)
                            graph.reaches.insert(key, reach)
                        }
                        else => {}
                    }
                }
            }
            // **A `entry` rule is an entry, so it gets the walk too** (ADR-grammar-syntax-v1
            // D5). Its body is every action block in the grammar: which
            // rules' actions run with it is the parser backend's question, so
            // the grammar is the unit - the over-approximation ADR-292 D4
            // asks for in this column.
            Item::Grammar(def) => {
                let mut whole = Reach { unknown: false, outside: [], calls: collections::BTreeSet() }
                for rule in def.rules {
                    for alt in rule.alts {
                        let action = alt.action ?? continue
                        reached_by(seen_in(action, names, unaliased, holes_of, no_root, false), items, names, own, library, whole)
                    }
                }
                rules_into(def, names, whole, own, library, graph)
            }
            else => {}
        }
    }
}

/// The fixpoint over a graph the walk built (`touches_of`), the whole package
/// at once: the reference the callees-first route is held to (ADR-100 D7).
fn touches_of_graph(graph: ref TouchGraph) -> collections::BTreeMap[String, Vec[Touch]] {
    let mut unknown: collections::BTreeMap[String, bool] = collections::BTreeMap()
    let mut outside: collections::BTreeMap[String, Vec[Touch]] = collections::BTreeMap()
    let mut calls: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    for (name, reach) in graph.reaches {
        unknown.insert(name.clone(), reach.unknown)
        outside.insert(name.clone(), reach.outside.clone())
        calls.insert(name.clone(), reach.calls.clone())
    }
    return touches_of(unknown, outside, calls)
}

/// **The `touches` column of a package's ledger** (ADR-288 D22): the walk over
/// each unit's view, the fixpoint callees first, and the answer written only
/// where nobody said - a hand-written entry is what its author wrote, the way
/// `sync` leaves an assertion alone - in the order a set is kept, once each.
/// `resolved` is the type checker's method answers by the ledger's key, and
/// `holes_of(unit, expr)` what unit `unit` wrote in a hole of `expr`.
pub fn touches_infer(mut ledger: Ledger, units: ref Vec[ParsedView], library: ref Ledger, resolved: ref collections::BTreeMap[String, CheckMethodCalls], holes_of: fn(i64, ref Expr) -> Vec[Expr] sync) {
    let mut graph = TouchGraph { methods: collections::BTreeMap(), reaches: collections::BTreeMap() }
    for (key, calls) in resolved {
        let called = MethodsCalled { resolved: calls.resolved.clone(), unseen: calls.unresolved, fields: collections::BTreeSet(), swallowed: collections::BTreeMap() }
        graph.methods.insert(key.clone(), called)
    }
    for unit in 0..<units.len() {
        let view = units[unit]
        unit_touches(view.items, view.words, fn(name) { view.unaliased(name) }, fn(expr) { holes_of(unit, expr) }, ledger, library, graph)
    }
    let answer = touches_callees_first(graph)
    for (name, touches) in answer {
        let mut contract = ledger.functions.get(name) ?? continue
        if contract.touches_known {
            continue
        }
        contract.touches = in_ledger_order(touches)
        contract.touches_known = true
    }
}

/// **The order a set of touches is kept and written in**: the kind, then the
/// parameter (none first), then the resource a literal named (none first),
/// then read before write - the order the derive gave while `Touch` was Rust
/// (ADR-204 §4), so a ledger written before and after reads the same. A touch
/// twice is kept once.
fn in_ledger_order(touches: ref Vec[Touch]) -> Vec[Touch] {
    let mut found: collections::BTreeMap[(String, String?, String?, bool), Touch] = collections::BTreeMap()
    for touch in touches {
        found.insert((touch.kind.clone(), touch.parameter?.clone(), touch.named?.clone(), touch.write), touch.clone())
    }
    let mut kept: Vec[Touch] = []
    for (_, touch) in found {
        kept.push(touch.clone())
    }
    return kept
}

/// **One function's final column, or its recursive group's** (ADR-100 D7):
/// `unit` is the function, or the strongly connected component it is a part
/// of, `reaches` what each body reaches, and `stored` the final columns of the
/// callees outside the unit, where their claim holds. The greatest fixpoint
/// runs inside the unit only: a member keeps its claim while everything it
/// calls keeps one, and a callee neither in the unit nor stored has none. A
/// member whose claim holds touches what the unit's bodies it reaches touch
/// and what its stored callees do; one whose claim falls is left out, as
/// `touches_of` leaves it out.
fn touches_of_unit(unit: ref Vec[String], reaches: ref collections::BTreeMap[String, Reach], stored: ref collections::BTreeMap[String, Vec[Touch]]) -> collections::BTreeMap[String, Vec[Touch]] {
    let mut members: collections::BTreeSet[String] = collections::BTreeSet()
    let mut known: collections::BTreeMap[String, bool] = collections::BTreeMap()
    for name in unit {
        members.insert(name.clone())
        let lost = reaches[name]?.unknown ?? true
        known.insert(name.clone(), !lost)
    }
    let mut changed = true
    while changed {
        changed = false
        for name in unit {
            let holds = known[name] ?? false
            if !holds {
                continue
            }
            let reach = reaches[name] ?? continue
            let mut reaches_unknown = false
            for callee in reach.calls {
                let theirs = if members.contains(callee) { known[callee] ?? false } else { stored.contains_key(callee) }
                if !theirs {
                    reaches_unknown = true
                }
            }
            if reaches_unknown {
                known.insert(name.clone(), false)
                changed = true
            }
        }
    }
    let mut settled: collections::BTreeMap[String, Vec[Touch]] = collections::BTreeMap()
    for name in unit {
        let holds = known[name] ?? false
        if !holds {
            continue
        }
        let mut found: Vec[Touch] = []
        let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
        let mut todo: Vec[String] = [name.clone()]
        while todo.len() > 0 {
            let here = todo.pop() ?? break
            if seen.contains(here) {
                continue
            }
            seen.insert(here.clone())
            if !members.contains(here) {
                for touch in stored[here]?.clone() ?? [] {
                    found.push(touch)
                }
                continue
            }
            let reach = reaches[here] ?? continue
            for touch in reach.outside {
                found.push(touch.clone())
            }
            for callee in reach.calls {
                todo.push(callee.clone())
            }
        }
        settled.insert(name.clone(), found)
    }
    return settled
}

/// **The whole package, callees first** (ADR-100 D7): the graph's strongly
/// connected components in reverse topological order, each derived by
/// `touches_of_unit` from the columns its callees already have. The greatest
/// fixpoint is unique, so this answers what `touches_of_graph` answers, each
/// set the same touches (the order a set is kept in is `in_ledger_order`'s).
fn touches_callees_first(graph: ref TouchGraph) -> collections::BTreeMap[String, Vec[Touch]] {
    let mut stored: collections::BTreeMap[String, Vec[Touch]] = collections::BTreeMap()
    for unit in touch_units(graph.reaches) {
        let column = touches_of_unit(unit, graph.reaches, stored)
        stored.extend(column)
    }
    return stored
}

/// Tarjan's walk over the touch graph: each node's visit number and lowest
/// reachable one, the nodes still open, and the components in the order they
/// close, which is callees first.
struct TouchComponents {
    index: collections::BTreeMap[String, i64],
    low: collections::BTreeMap[String, i64],
    open: collections::BTreeSet[String],
    stack: Vec[String],
    units: Vec[Vec[String]],
    next: i64,
}

/// The graph's recursive groups, each a unit, in reverse topological order: a
/// unit comes after every unit it calls into. A call that leaves the graph is
/// no edge.
fn touch_units(reaches: ref collections::BTreeMap[String, Reach]) -> Vec[Vec[String]] {
    let mut walk = TouchComponents { index: collections::BTreeMap(), low: collections::BTreeMap(), open: collections::BTreeSet(), stack: [], units: [], next: 0 }
    for (name, _) in reaches {
        if !walk.index.contains_key(name) {
            touch_connect(reaches, name, walk)
        }
    }
    return walk.units
}

fn touch_connect(reaches: ref collections::BTreeMap[String, Reach], name: ref String, mut walk: TouchComponents) {
    walk.index.insert(name.clone(), walk.next)
    walk.low.insert(name.clone(), walk.next)
    walk.next = walk.next + 1
    walk.stack.push(name.clone())
    walk.open.insert(name.clone())
    let reach = reaches[name] ?? return
    for to in reach.calls {
        if !reaches.contains_key(to) {
            continue
        }
        let mut reached = -1
        if !walk.index.contains_key(to) {
            touch_connect(reaches, to, walk)
            reached = walk.low[to] ?? -1
        } else if walk.open.contains(to) {
            reached = walk.index[to] ?? -1
        }
        let mine = walk.low[name] ?? 0
        if reached >= 0 && reached < mine {
            walk.low.insert(name.clone(), reached)
        }
    }
    if (walk.low[name] ?? -1) != (walk.index[name] ?? -2) {
        return
    }
    let mut unit: Vec[String] = []
    while true {
        let top = walk.stack.pop() ?? break
        walk.open.remove(top)
        let last = top == name
        unit.push(top)
        if last {
            break
        }
    }
    walk.units.push(unit)
}

/// Every resource a `touches` entry may name (ADR-292 D3): `KNOWN_KINDS` in
/// `order.nika`, moved here with the check from the compiler's `contracts::touch`.
///
/// It grows when a function needs it and never before - ADR-288 D11's rule,
/// which is the same rule the rest of the ledger lives under. What is here is
/// what `std`'s own entries reach:
///
/// | kind | the resource | who asked |
/// | :--- | :--- | :--- |
/// | `file(path)` | the file that parameter names | `fs::read`, `fs::write`, `fs::map` |
/// | `stdout` | the program's standard output | `print`, `println` |
/// | `stderr` | the program's standard error | `eprint`, `eprintln` |
/// | `args` | the arguments the program was started with | `cli::args` |
///
/// **What is deliberately not here**, and each for the same reason. ADR-292
/// D2's table names `endpoint(url)` for `net::post` and a lock for
/// `counter.access fn { … }`, and §3 rests Part II 12.2's
/// no-pausing-while-locked rule on the second - neither function exists. And
/// **standard input**, which is the near miss: `io::read`, `io::lines` and
/// `io::read_to_string` are all in `std`'s ledger already and none of them
/// says what it reaches, so all three order against everything. Nothing in
/// `examples/` asks - the two programs that read a pipe do it inside a `for`
/// or behind a handler that `return`s, so no pair reaches the question - and
/// ADR-288 D11 is the rule that keeps a word out until a program asks for it.
///
/// When one does, the entry is `stdin` **write** and not `stdin read`, and the
/// reason is worth leaving here rather than being rediscovered. `write` in a
/// touch set means *it changes the resource*, and reading a stream consumes
/// it: two `io::read_to_string()` calls do not both get the bytes, so the
/// read/read rule that lets two file reads overlap would be exactly wrong.
///
/// **And the clock, which is the one that is asked about before it is needed.**
/// `std` has no function that reads one - `Instant::now` appears in the runtime's
/// own executor and nowhere a program can reach - so the rule above keeps it out,
/// and the rule is the same one that let `lock` in the day the doors existed.
///
/// What to write when the day comes: **`clock read`**, and the read is right,
/// because two calls genuinely conflict over nothing and neither changes
/// anything - the opposite of `stdin`, whose read is a write. The reason it is
/// worth a paragraph anyway is the **second consumer**
/// ([ADR-288](../../../../docs/specification/adr/adr-288.md)): to
/// `contracts::order` an empty touch set is a *speed*, and to a repetition it
/// would be a *permission*. A clock left out of an entry would read as "repeat me
/// freely" and the repetition would see a different time. Naming it at all is
/// enough to stop that - any named resource makes the set non-empty - which is
/// why the note is here and not a special case somewhere.
/// | `lock` | **a** lock, never which one | `get`, `set`, `access`, `update`, and the two doors over several |
///
/// **`lock` joined the list the day the doors existed**
/// ([ADR-288](../../../../docs/specification/adr/adr-288.md) D23). It was named in
/// [ADR-292](../../../../docs/specification/adr/adr-292.md) D3's own table and
/// kept out of this one under the rule the paragraph above states - a word waits
/// until a program asks for it - and until [ADR-281](../../../../docs/specification/adr/adr-281.md)
/// and [ADR-281](../../../../docs/specification/adr/adr-281.md) no program could.
///
/// **It names no parameter, and that is [ADR-281](../../../../docs/specification/adr/adr-281.md)
/// D4's decision rather than a limit here**: the property says *a lock* and never
/// *which* lock, because telling two handles apart would make whether a program
/// compiles depend on whether that proof happened to succeed. Two `access`
/// calls are two **reads** and do not conflict; two doors that write do, whether
/// or not they are the same lock.
/// | `socket` | **a** socket, never which one | `net::listen`, `accept`, `read`, `write`, `close` |
///
/// **`socket` joined the list the day `std` had one**
/// ([ADR-289](../../../../docs/specification/adr/adr-289.md) D6), under the same
/// rule `lock` joined it under: a word waits until a program can ask for it.
/// [ADR-292](../../../../docs/specification/adr/adr-292.md) D3 named it in the
/// same breath as a file - *a file, a socket, `stdout` and a `Locked` value are
/// not in the set of things that can be pointed at* - and it waited until one
/// existed.
///
/// **It names no parameter**, for `lock`'s reason rather than for want of a
/// name: a *listener* could be named by the address it is bound to, and a
/// **connection** is what a program actually touches, and telling two of those
/// apart is the alias analysis
/// [ADR-281](../../../../docs/specification/adr/adr-281.md) D30 refuses to make
/// a program's compilation depend on. So two reads of two different sockets do
/// not conflict - reads never do - and a write orders against every socket
/// touch, which is the safe direction and the one a server's two writes want
/// anyway.
///
/// **Whether this compiler knows what a touch's resource *is*** (ADR-292 D3):
/// `order.nika`'s list of kinds. Kept apart from reading a touch back on
/// purpose: a ledger that names a kind from a newer vocabulary is not
/// malformed, it is a file this compiler is too old to read, and refusing it
/// would turn a library's forward step into a build failure. D4 answers an
/// effect that cannot be read the same way here as everywhere else: it reaches
/// everything, so the statement stays put.
pub fn touch_kind_is_known(touch: ref Touch) -> bool {
    return known_kind(touch.kind)
}

// Each `entry` rule of a grammar reaches what the whole grammar does, and the
// method calls the type checker resolved under the rule's own key.
fn rules_into(def: ref GrammarDef, names: ref winnow_grammar::InternerContext, whole: ref Reach, own: ref Ledger, library: ref Ledger, mut graph: TouchGraph) {
    let named = names.resolve(def.name).clone()
    for rule in def.rules {
        if !rule.is_entry {
            continue
        }
        let key = f"{named}::{names.resolve(rule.name)}"
        let mut reach = Reach { unknown: whole.unknown, outside: whole.outside.clone(), calls: whole.calls.clone() }
        methods_reach(graph.methods[key], own, library, reach)
        graph.reaches.insert(key, reach)
    }
}

// What the calls the walk met reach: a function of this package is a call, a
// library's brings its touch set, and a `spawn`, a `dsl` statement and a call
// of something that is not a name are calls nobody can name.
fn reached_by(seen: ref Vec[Seen], items: ref Vec[Spanned[Item]], names: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, mut reach: Reach) {
    for one in seen {
        match one {
            Seen::Call { name, literals, .. } => reached_call(callee_named(names, name.clone(), own, library, items), literals, library, reach),
            Seen::Spawn { .. } => {
                reach.unknown = true
            }
            Seen::Opaque { .. } => {
                reach.unknown = true
            }
            else => {}
        }
    }
}

fn reached_call(callee: ref Callee?, literals: ref Vec[String?], library: ref Ledger, mut reach: Reach) {
    let known = callee ?? return
    match known {
        Callee::Own(name) => {
            reach.calls.insert(name.clone())
        }
        Callee::Library { key, .. } => absorb(library.functions[key], literals, reach),
        Callee::Opaque(_) => {
            reach.unknown = true
        }
        else => {}
    }
}

// The method calls the type checker resolved, which this walk cannot
// (ADR-288): one of this package is a call, any other brings its touch set.
fn methods_reach(resolved: ref MethodsCalled?, own: ref Ledger, library: ref Ledger, mut reach: Reach) {
    let known = resolved ?? return
    if known.unseen {
        reach.unknown = true
    }
    for callee in known.resolved {
        if own.functions.contains_key(callee) {
            reach.calls.insert(callee.clone())
        } else {
            absorb(library.functions[callee], [], reach)
        }
    }
}

// Take a described callee's touch set into a caller's, or give up. A resource
// named by a **parameter** is named in the callee's words: the caller reaches
// the resource its argument names where that argument is a text literal
// (`literals`, by the call's argument; #1354), and anything else would be
// claiming something about the wrong resource.
fn absorb(contract: ref FnContract?, literals: ref Vec[String?], mut reach: Reach) {
    if !touches_said(contract) {
        reach.unknown = true
        return
    }
    let known = contract ?? return
    for touch in known.touches {
        if touch.parameter != null {
            let named = literal_for(known, touch.parameter ?? "", literals) ?? ""
            if named.len() == 0 {
                reach.unknown = true
                continue
            }
            let mine = Touch { kind: touch.kind.clone(), parameter: null, named: named, write: touch.write }
            if !holds_touch(reach.outside, mine) {
                reach.outside.push(mine)
            }
        } else if !holds_touch(reach.outside, touch) {
            reach.outside.push(touch.clone())
        }
    }
}

// The literal a call by name hands the parameter `parameter`, where it is one
// a ledger can write back (no `"`, `\` or line break in it). A method's
// `self` may or may not be among the arguments, so a method gives none.
fn literal_for(contract: ref FnContract, parameter: ref String, literals: ref Vec[String?]) -> String? {
    let signature = contract.signature ?? return null
    let mut at = 0
    for (name, _) in signature.params {
        if name == "self" {
            return null
        }
        if name == parameter {
            if at >= literals.len() {
                return null
            }
            let text = literals[at]?.clone() ?? return null
            if text.contains("\"") || text.contains("\\") || text.contains("\n") {
                return null
            }
            return text
        }
        at += 1
    }
    return null
}

fn touches_said(contract: ref FnContract?) -> bool {
    let known = contract ?? return false
    return known.touches_known
}

// A touch named by no parameter is its kind, the resource a literal named, and
// whether it writes.
fn holds_touch(touches: ref Vec[Touch], touch: ref Touch) -> bool {
    for one in touches {
        if one.kind == touch.kind && one.named == touch.named && one.write == touch.write {
            return true
        }
    }
    return false
}

// --- Tests moved from the compiler's `contracts::touch` (ADR-294, #125) ---

fn touch_test_reached(kind: String, named: String?, write: bool) -> Reached {
    return Reached { kind: kind, named: named, unknown: false, write: write }
}

test "a touch round trips through its text" {
    for written in ["file(path) read", "file(path) write", "file('a.txt') write", "stdout write", "stderr write", "args read"] {
        let touch = touch_of(written) catch {
            assert(false)
            return
        }
        assert(touch.text() == written)
    }
}

test "a touch names its kind and parameter" {
    let touch = touch_of("file(path) read") catch {
        assert(false)
        return
    }
    assert(touch.kind == "file")
    assert((touch.parameter ?? "") == "path")
    assert(!touch.write)

    let out = touch_of("stdout write") catch {
        assert(false)
        return
    }
    assert(out.kind == "stdout")
    assert(out.parameter == null)
    assert(out.write)
}

test "a malformed touch says what is wrong" {
    for written in ["file(path)", "file(path) maybe", "file(path read", "(x) read"] {
        let mut parsed = true
        touch_of(written) catch {
            parsed = false
        }
        assert(!parsed)
    }
}

/// An unknown kind would be disjoint from everything: written as an assertion
/// about the wrong answer, so that anyone who makes `conflicts_with` the guard
/// sees why it cannot be.
test "an unknown kind would be disjoint from everything" {
    let typo = touch_test_reached("stdoutt", null, true)
    assert(!typo.conflicts_with(touch_test_reached("stdout", null, true)))
    assert(!typo.conflicts_with(touch_test_reached("file", "a.txt", true)))
}

/// Different kinds never meet. The cheap half of the rule.
test "different kinds never conflict" {
    let file = touch_test_reached("file", "a.txt", true)
    let out = touch_test_reached("stdout", null, true)
    assert(!file.conflicts_with(out))
}

/// The two console handles are one destination under `2>&1`.
test "the two console handles may be one destination" {
    let out = touch_test_reached("stdout", null, true)
    let err = touch_test_reached("stderr", null, true)
    assert(out.conflicts_with(err))
    assert(err.conflicts_with(out))
    assert(!out.conflicts_with(touch_test_reached("file", "a.txt", true)))
    assert(!err.conflicts_with(touch_test_reached("args", null, false)))
}

/// Two reads never conflict - a processor's rule for two loads.
test "two reads never conflict" {
    let one = touch_test_reached("file", "a.txt", false)
    let same = touch_test_reached("file", "a.txt", false)
    assert(!one.conflicts_with(same))
    let written = touch_test_reached("file", "a.txt", true)
    assert(one.conflicts_with(written))
    assert(written.conflicts_with(one))
}

/// Two different files do not conflict even when both are written.
test "two named resources are compared by name" {
    let a = touch_test_reached("file", "a.txt", true)
    let b = touch_test_reached("file", "b.txt", true)
    assert(!a.conflicts_with(b))
}

/// Every kind the vocabulary names is known, and nothing else is: an unknown
/// kind differs from every kind there is, so a misspelled resource would be
/// disjoint from everything and buy an overlap (moved from the compiler's
/// `contracts::touch`).
test "a kind outside the vocabulary is not known" {
    for kind in KNOWN_KINDS {
        let touch = touch_of(f"{kind} read") catch {
            assert(false)
            return
        }
        assert(touch_kind_is_known(touch))
    }
    for written in ["stdoutt write", "stdin write", "endpoint(url) write"] {
        let touch = touch_of(written) catch {
            assert(false)
            return
        }
        assert(!touch_kind_is_known(touch))
    }
}

fn touch_test_node(mut graph: TouchGraph, name: String, unknown: bool, outside: Vec[String], calls: Vec[String]) {
    let mut reach = Reach { unknown: unknown, outside: [], calls: collections::BTreeSet() }
    for kind in outside {
        reach.outside.push(Touch { kind: kind.clone(), parameter: null, named: null, write: true })
    }
    for callee in calls {
        reach.calls.insert(callee.clone())
    }
    graph.reaches.insert(name, reach)
}

fn touch_test_texts(touches: ref Vec[Touch]) -> Vec[String] {
    let mut texts: Vec[String] = []
    for touch in in_ledger_order(touches) {
        texts.push(touch.text())
    }
    return texts
}

/// **The per-function entry answers what the whole-package entry answers**
/// (ADR-100 D7, ADR-403 D3): on a call chain into a body that writes standard
/// output, a recursive pair each of which writes something, a recursive pair
/// one of whose members reaches something unaccounted for, a caller of that
/// pair, and a call that leaves the graph. The chain's head is derived from
/// its callee's stored column alone, each pair as one unit.
test "the per-function touches entry gives the whole-package column" {
    let mut graph = TouchGraph { methods: collections::BTreeMap(), reaches: collections::BTreeMap() }
    touch_test_node(graph, "a", false, ["stderr"], ["b"])
    touch_test_node(graph, "b", false, [], ["c"])
    touch_test_node(graph, "c", false, ["stdout"], [])
    touch_test_node(graph, "p", false, ["args"], ["q", "c"])
    touch_test_node(graph, "q", false, ["lock"], ["p"])
    touch_test_node(graph, "x", false, [], ["y"])
    touch_test_node(graph, "y", true, [], ["x"])
    touch_test_node(graph, "w", false, [], ["x"])
    touch_test_node(graph, "r", false, [], ["gone"])
    let whole = touches_of_graph(graph)
    let first = touches_callees_first(graph)
    assert(whole.len() == first.len())
    for (name, touches) in whole {
        let mine = first[name] ?? {
            assert(false)
            continue
        }
        assert(touch_test_texts(touches) == touch_test_texts(mine))
    }
    assert(touch_test_texts(first["a"]?.clone() ?? []) == ["stderr write", "stdout write"])
    assert(touch_test_texts(first["q"]?.clone() ?? []) == ["args write", "lock write", "stdout write"])
    for lost in ["x", "y", "w", "r"] {
        assert(!first.contains_key(lost))
    }
    let mut pair = 0
    for unit in touch_units(graph.reaches) {
        if unit.len() > 1 {
            pair = pair + 1
        }
    }
    // `p, q` and `x, y` are the recursive groups.
    assert(pair == 2)
    let mut stored: collections::BTreeMap[String, Vec[Touch]] = collections::BTreeMap()
    stored.insert("b", [Touch { kind: "stdout", parameter: null, named: null, write: true }])
    let alone: Vec[String] = ["a"]
    let head = touches_of_unit(alone, graph.reaches, stored)
    assert(touch_test_texts(head["a"]?.clone() ?? []) == touch_test_texts(whole["a"]?.clone() ?? []))
}

/// A resource the compiler could not name might be any of them: the
/// fail-closed half.
test "an unnameable resource conflicts with its whole kind" {
    let unknown = Reached { kind: "file", named: null, unknown: true, write: true }
    let read = touch_test_reached("file", "a.txt", false)
    assert(unknown.conflicts_with(read))
    assert(read.conflicts_with(unknown))
    assert(!unknown.conflicts_with(touch_test_reached("stdout", null, true)))
}
