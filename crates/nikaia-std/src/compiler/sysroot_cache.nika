// **The sysroot's paths, the tools package as files, and `lower-std`'s cache
// keys** (S2, #125): what `crates/nikaia/src/sysroot.rs` did with the file
// system and SHA-256, moved. `sysroot.rs` keeps the driver (`lower_std`, the
// runs of `lower_compiler*`, `in_parallel`, `Phases`), `Sysroot::resolve`, the
// compiled `std`'s directory and the `ASKED` memo of `native_cpu`, and calls
// these; what `std` cannot say yet (the user cache, a `rustc`
// process) it answers as the `SysrootHost`.
//
// **The keys**: a part is its length as a `u64` little-endian and then its
// bytes, a part of a module key ends with a `0`. A file key reads the
// package by name (#1909, `sysroot_named_key`).

use std::collections
use std::fs
use std::hash

/// `std`'s directory inside a sysroot. The same name it has in the checkout, so
/// that `crates/` *is* a sysroot and the in-tree flow needs no special case.
comptime SYSROOT_STD_DIR: ref String = "nikaia-std"

/// The extension `std`'s Nikaia half carries.
comptime SYSROOT_NIKA: ref String = "nika"

/// Where the Nikaia that the **toolchain** uses lives, under `std`'s `src`.
///
/// A directory rather than a naming convention, because what separates the two
/// is not what the files are like but what `std` promises about them
/// (`sysroot_tool_modules`).
comptime SYSROOT_COMPILER: ref String = "compiler"

/// **Where `std`'s own unpublished Nikaia lives** (#723), under `std`'s `src`:
/// what a *program* runs - the HTTP/1 head's grammar - as opposed to what only
/// the compiler runs, in `SYSROOT_COMPILER`.
comptime SYSROOT_RUNTIME: ref String = "runtime"

/// **The toolchain's Nikaia is one package** (ADR-294), lowered into this one
/// index file beside its sources.
comptime SYSROOT_COMPILER_PACKAGE: ref String = "lowered.rs"

/// The directory beside the index that holds one generated file per `.nika`
/// (#667 step 4).
comptime SYSROOT_COMPILER_FILES: ref String = "lowered"

/// The line that starts a file in a package's cache entry.
comptime SYSROOT_PACKED: ref String = "//@@ file "

/// The file in an entry's directory that holds what was lowered.
comptime SYSROOT_LOWERED: ref String = "lowered.rs"

/// What the sysroot's cache asks of the compiler.
pub trait SysrootHost {
    /// Marks a cache entry as used now, so the user cache's pruning keeps it.
    fn use_entry(ref self, entry: ref fs::Path) sync
    /// A name beside `path` that no other writer takes, for a file that is
    /// renamed onto `path` once it is whole.
    fn unique_beside(ref self, path: ref fs::Path) -> fs::Path sync
    /// `rustc --print target-cpus` for `triple`, with `more` arguments.
    fn rustc_cpus(ref self, triple: ref String, more: ref Vec[String]) -> String sync throws
}

/// The `nikaia-std` a generated project depends on by path.
pub fn sysroot_std_dir(root: ref fs::Path) -> fs::Path sync {
    return root.join(SYSROOT_STD_DIR)
}

/// The directory of the toolchain's Nikaia package, which `std` compiles
/// only under its `compiler` feature (#723).
///
/// `tools/rust.nika` is the reading half of `nikaia describe`
/// ([ADR-290](../../../docs/specification/adr/adr-290.md) D13), lowered the
/// same way `std`'s own Nikaia half is and reached by the compiler as an
/// ordinary Rust module ([ADR-290](../../../docs/specification/adr/adr-290.md)
/// D1). It lives in this crate because this is where the release step
/// already looks, and in a directory of its own because **a `.nika` beside
/// `lib.rs` means something**: that `std` offers it, and that
/// `std.contracts` has to say so. This one is not offered and must not be
/// in that file.
pub fn sysroot_tools_dir(root: ref fs::Path) -> fs::Path sync {
    return sysroot_std_dir(root).join("src").join(SYSROOT_COMPILER)
}

/// The directory of `std`'s run-time Nikaia package (#723): unpublished
/// like the tools, but compiled into every program.
pub fn sysroot_runtime_dir(root: ref fs::Path) -> fs::Path sync {
    return sysroot_std_dir(root).join("src").join(SYSROOT_RUNTIME)
}

/// `std`'s Nikaia half, in a fixed order.
///
/// Sorted, because [ADR-005](../../../docs/specification/adr/adr-005.md) D8
/// bans consuming a directory listing in filesystem order anywhere output
/// depends on it, and the release step writes files from this list.
///
/// **The top level only, and that is the rule that says what `std` is.**
/// A `.nika` beside `lib.rs` is a module of `std` and
/// `crates/nikaia/tests/contracts.rs` requires `std.contracts` to carry
/// every `pub` thing it declares. What is in `sysroot_tool_modules` is not.
pub fn sysroot_std_modules(root: ref fs::Path) -> Vec[fs::Path] sync throws {
    return sysroot_nika_in(sysroot_std_dir(root).join("src"))
}

/// **Nikaia the toolchain uses and `std` does not publish**, in `src/compiler`;
/// none where the sysroot has no such directory.
pub fn sysroot_tool_modules(root: ref fs::Path) -> Vec[fs::Path] sync throws {
    let dir = sysroot_tools_dir(root)
    let found = fs::metadata(dir, fs::Root::Anywhere) catch { return [] }
    if !found.is_dir() {
        return []
    }
    return sysroot_nika_in(dir)
}

/// Every `.nika` directly in one directory, sorted: `std`'s modules, and the
/// files of a tools package.
pub fn sysroot_nika_in(src: ref fs::Path) -> Vec[fs::Path] sync throws {
    let mut names: Vec[String] = fs::read_dir(src, fs::Root::Anywhere).iter().filter(fn(name) { (name.extension()?.text_of() ?? "") == SYSROOT_NIKA }).map(fn(name) { name.text_of() }).collect()
    names.sort()
    return names.iter().map(fn(name) { src.join(name) }).collect()
}

/// **The CPU levels `--cpu` takes for `triple`**, the baseline first
/// ([ADR-002](../../docs/specification/adr/adr-002.md) D6). x86-64 has its four
/// named levels; a target without named levels takes only its baseline, the
/// CPU `rustc` builds for when told none. Every target takes `native`.
pub fn sysroot_cpu_levels[H: SysrootHost](triple: ref String, host: ref H) -> Vec[String] sync throws {
    let mut levels: Vec[String] = match triple.starts_with("x86_64") {
        true => ["x86-64", "x86-64-v2", "x86-64-v3", "x86-64-v4"],
        false => {
            let cpus = host.rustc_cpus(triple, [])
            let line = cpus.lines().find(fn(line) { line.contains("default target CPU") }) ?? ""
            [(line.split_whitespace().next() ?? "generic").clone()]
        }
    }
    levels.push("native")
    return levels
}

/// **What `native` means on this machine**, as the compiled `std`'s key
/// holds it (ADR-002 D6), from what `rustc` said for `-C target-cpu=native`:
/// the CPU it finds and the features it turns on, never the word, so a cache
/// directory moved to another machine is not taken for that machine's.
pub fn sysroot_native_cpu(said: ref String) -> String sync {
    let line = said.lines().find(fn(line) { line.trim_start().starts_with("native ") }) ?? ""
    let mut cpu: String = (line.split("currently ").nth(1) ?? "").clone()
    while cpu.ends_with(")") || cpu.ends_with(".") {
        let cut: String = cpu.trim_end_matches(")").trim_end_matches(".").clone()
        cpu = cut
    }
    let features: Vec[String] = said.lines().filter(fn(line) { line.starts_with("target_feature=") }).collect()
    return f"native={cpu};{features.join(",")}"
}

/// `n` as the eight bytes of a `u64`, little-endian.
fn sysroot_length(mut read: Vec[u8], n: i64) sync {
    for i in 0..<8 {
        read.push(((n >> (8 * i)) & 255) as u8)
    }
}

/// One part of a key: the length of `text` in bytes, then its bytes.
fn sysroot_part(mut read: Vec[u8], text: ref String) sync {
    sysroot_length(read, text.len())
    for b in text.bytes() {
        read.push(b)
    }
}

/// One part of a module key: the bytes of `text`, then a `0`.
fn sysroot_ended(mut read: Vec[u8], text: ref String) sync {
    for b in text.bytes() {
        read.push(b)
    }
    read.push(0)
}

/// **One declaration another file of the package may read** (#1909, C): the
/// names it is reached by and its text without bodies, docs or comments. A
/// row of a per-name table (a ledger row, a graph row, a tier fact) is one
/// too: its names are the words of its key and its text the row.
pub struct SysrootDeclared {
    pub names: Vec[String],
    pub text: String,
}

/// **Each file's declarations by name, and what stays whole** (#1909, C):
/// built once per package, read by `sysroot_named_key` for every file.
pub struct SysrootNames {
    /// The package's parts no name reaches, hashed: see `sysroot_names`.
    pub whole: String,
    /// Every declaration of every file and every row, in file and table
    /// order.
    pub declared: Vec[SysrootDeclared],
    /// The words of each declaration's text, by its index.
    pub words: Vec[Vec[String]],
    /// A name to the declarations reached by it.
    pub by_name: collections::BTreeMap[String, Vec[i64]],
}

/// Every word of `text` (letters, digits, `_`, not starting with a digit),
/// each once, in the order first met.
pub fn sysroot_words(text: ref String) -> Vec[String] sync {
    let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
    let mut out: Vec[String] = []
    let n = text.bytes.len()
    let mut at = 0
    while at < n {
        let b = text.bytes[at] as i64
        if sysroot_package_word_byte(b) && !(b >= 48 && b <= 57) {
            let start = at
            while at < n && sysroot_package_word_byte(text.bytes[at] as i64) {
                at += 1
            }
            let word = sysroot_package_slice(text, start, at).clone()
            if seen.insert(word.clone()) {
                out.push(word)
            }
        } else if b >= 48 && b <= 57 {
            while at < n && sysroot_package_word_byte(text.bytes[at] as i64) {
                at += 1
            }
        } else {
            at += 1
        }
    }
    return out
}

/// The bytes `start` to `end` of `source` without the `cut` ranges inside
/// them (the bodies) and without comment or doc lines: a line that is only a
/// comment says nothing to another file, and neither does a `///` doc (#1909,
/// D): no pass reads another file's docs (the one reader, `main_words` in
/// `emit_entry.nika`, reads the file's own `main`).
fn sysroot_declared_text(source: ref String, start: i64, end: i64, cut: ref Vec[(i64, i64)]) -> String sync {
    let mut kept: String = ""
    let mut at = start
    for (a, b) in cut {
        if a < at || b > end {
            return sysroot_package_slice(source, start, end).clone()
        }
        kept.push_str(sysroot_package_slice(source, at, a))
        at = b
    }
    kept.push_str(sysroot_package_slice(source, at, end))
    let lines: Vec[String] = kept.lines().filter(fn(line) { !line.trim_start().starts_with("//") }).map(fn(line) { f"{line}\n" }).collect()
    return lines.join("")
}

/// **One file's declarations by name, and the text of what no name reaches**
/// (#1909, C). A function, a struct, a `comptime` and a grammar are reached by
/// their name; an enum by its name and its variants'; a trait by its name and
/// its methods'; an inherent `impl` by its methods' names; an `extern` block
/// by the names it declares. What stays whole, and why: a trait `impl` (the
/// checker and the emitter find it by the type and the trait, which the
/// file's text need not name: a `{x}`, a `==`, a `for`), a `use` line (it
/// names a package, not a declaration), and an item without a name. A `test`
/// or `bench` is read by no other file (what only tests reach is keyed by
/// `only_tests`) and is left out.
pub fn sysroot_declared(source: ref String, unit: ref ParsedView) -> (Vec[SysrootDeclared], String) sync {
    let mut out: Vec[SysrootDeclared] = []
    let mut whole: String = ""
    for item in unit.items {
        let names = match item.node {
            Item::Test { .. } | Item::Bench { .. } => continue,
            else => sysroot_item_names(item, unit),
        }
        let mut cut: Vec[(i64, i64)] = []
        sysroot_package_bodies(item, cut)
        cut.sort()
        let text = sysroot_declared_text(source, item.span.start as i64, item.span.end as i64, cut)
        if !names.is_empty() {
            out.push(SysrootDeclared { names: names, text: text })
        } else {
            whole.push_str(text)
            whole.push_str("\n")
        }
    }
    return (out, whole)
}

/// The names `item` is reached by, empty where it stays whole (see
/// `sysroot_declared`).
fn sysroot_item_names(item: ref Spanned[Item], unit: ref ParsedView) -> Vec[String] sync {
    let mut names: Vec[String] = []
    match item.node {
        Item::Fn { name, .. } => names.push(unit.text(name ?? return names)),
        Item::Struct { name, .. } => names.push(unit.text(name)),
        Item::Comptime { name, .. } => names.push(unit.text(name)),
        Item::Grammar(def) => names.push(unit.text(def.name)),
        Item::Enum { name, variants, .. } => {
            names.push(unit.text(name))
            for variant in variants {
                names.push(unit.text(variant.name))
            }
        }
        Item::Trait { name, methods, .. } => {
            names.push(unit.text(name))
            for method in methods {
                names.push(unit.text(method.node.name))
            }
        }
        Item::Impl { trait_name: null, methods, .. } => {
            for method in methods {
                let said = sysroot_item_names(method, unit)
                if said.is_empty() {
                    return []
                }
                for one in said {
                    names.push(one.clone())
                }
            }
        }
        Item::Extern { declarations, opaque, .. } => {
            for declaration in declarations {
                names.push(unit.text(declaration.node.name))
            }
            for one in opaque {
                names.push(unit.text(one.node.name))
            }
        }
        else => return [],
    }
    return names
}

/// A row of a per-name table: reached by every word of `key` and of `more`.
fn sysroot_row(mut rows: Vec[SysrootDeclared], key: ref String, more: ref Vec[String], text: String) sync {
    let mut names = sysroot_words(key)
    for one in more {
        for word in sysroot_words(one) {
            names.push(word)
        }
    }
    rows.push(SysrootDeclared { names: names, text: text })
}

/// **The package's names, built once** (#1909, C). `declared` and `wholes`
/// are `sysroot_declared`'s answers in file order, `names` the files' names.
/// Split per name: the ledger's `functions`, `types`, `code_locks` and
/// `code_throws`, both call graphs (a row is reached by its key and by every
/// function in it), and the text tiers' facts beside (`fields`, `fills`,
/// `calls`). What stays whole, and why: the compiler, the salt and `setting`
/// (the build, the package's one trust answer and whether facts are reused:
/// one value for the package, no name reads it); the ledger's head
/// (`version`, `toolchain`, `inference`, `sources`) and its `traits` and
/// `implementations`, which the checker reads by a type and a trait as the
/// trait `impl`s are; each file's whole part (`sysroot_declared`); and the
/// files' names, so a file added or taken away lowers every file again.
pub fn sysroot_names(compiler: ref String, salt: ref String, setting: ref String, names: ref Vec[String], declared: ref Vec[Vec[SysrootDeclared]], wholes: ref Vec[String], own: ref Ledger, graphs: ref EmitReachGraphs, fields: ref collections::BTreeMap[String, Vec[FieldContract]], fills: ref SliceFills, calls: ref collections::BTreeSet[String]) -> SysrootNames sync {
    let mut read: Vec[u8] = []
    sysroot_part(read, "nikaia-lower-file-v2")
    sysroot_part(read, compiler)
    sysroot_part(read, salt)
    sysroot_part(read, setting)
    sysroot_part(read, f"{own.version} {own.toolchain} {own.inference} {own.sources:?}")
    sysroot_part(read, f"{own.traits:?}")
    sysroot_part(read, f"{own.implementations:?}")
    for at in 0..<names.len() {
        sysroot_part(read, names[at])
        sysroot_part(read, wholes[at])
    }
    let mut all: Vec[SysrootDeclared] = []
    for file in declared {
        for one in file {
            all.push(one.clone())
        }
    }
    let none: Vec[String] = []
    for (key, row) in own.functions.iter() {
        sysroot_row(all, key, none, f"function {key} {row:?}")
    }
    for (key, row) in own.types.iter() {
        sysroot_row(all, key, none, f"type {key} {row:?}")
    }
    for (key, row) in own.code_locks.iter() {
        sysroot_row(all, key, none, f"code lock {key} {row:?}")
    }
    for (key, row) in own.code_throws.iter() {
        sysroot_row(all, key, row, f"code throws {key} {row:?}")
    }
    for (key, row) in graphs.pausing_reach.iter() {
        let more: Vec[String] = row.iter().cloned().collect()
        sysroot_row(all, key, more, f"pausing reach {key} {row:?}")
    }
    for (key, row) in graphs.code_cycle_graph.iter() {
        let more: Vec[String] = row.iter().cloned().collect()
        sysroot_row(all, key, more, f"code cycle {key} {row:?}")
    }
    for (key, row) in fields.iter() {
        sysroot_row(all, key, none, f"fields beside {key} {row:?}")
    }
    for (key, row) in fills.filled.iter() {
        sysroot_row(all, key, none, f"filled {key} {row}")
    }
    for (key, row) in fills.pieces.iter() {
        sysroot_row(all, key, none, f"pieces {key} {row}")
    }
    for key in calls {
        sysroot_row(all, key, none, f"called beside {key}")
    }
    let mut words: Vec[Vec[String]] = []
    let mut by_name: collections::BTreeMap[String, Vec[i64]] = collections::BTreeMap()
    for at in 0..<all.len() {
        words.push(sysroot_words(all[at].text))
        for name in all[at].names {
            by_name.entry(name.clone()).or_default().push(at)
        }
    }
    return SysrootNames { whole: hash::sha256_hex(read), declared: all, words: words, by_name: by_name }
}

/// **A file's key** (#1909, C): the package's whole part, the file's name and
/// text, what only tests reach of it, and every declaration and row its text
/// reaches by name, the names in those declarations' texts followed in turn
/// (a function's signature names the types its result is made of). A name
/// no other file declares reaches nothing, so a body change, or a new
/// function no other file names, lowers that file alone.
pub fn sysroot_named_key(names: ref SysrootNames, name: ref String, text: ref String, only_tests: ref String) -> String sync {
    let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
    let mut reached: collections::BTreeSet[i64] = collections::BTreeSet()
    let mut work: Vec[String] = sysroot_words(text)
    while !work.is_empty() {
        let word = work.pop() ?? break
        if !seen.insert(word.clone()) {
            continue
        }
        let found = names.by_name.get(word) ?? continue
        for at in found {
            if reached.insert(at) {
                for next in names.words[at] {
                    if !seen.contains(next) {
                        work.push(next.clone())
                    }
                }
            }
        }
    }
    let mut read: Vec[u8] = []
    sysroot_part(read, names.whole)
    sysroot_part(read, name)
    sysroot_part(read, text)
    sysroot_part(read, only_tests)
    for at in reached {
        sysroot_part(read, names.declared[at].text)
    }
    return hash::sha256_hex(read)
}

/// What is committed in `dir`: the index and every file under `lowered/`,
/// each with its text (empty where it cannot be read).
pub fn sysroot_committed(dir: ref fs::Path) -> Vec[(String, String)] {
    let mut names: Vec[String] = [SYSROOT_COMPILER_PACKAGE.clone()]
    names.extend(sysroot_stale(dir, []))
    let mut files: Vec[(String, String)] = []
    for name in names {
        let text = fs::read_to_string(dir.join(name), fs::Root::Anywhere) catch { "" }
        files.push((name.clone(), text))
    }
    return files
}

/// The package as one text, each `include!` of the index replaced by the
/// file it names: what a test compiles when it has no directory.
pub fn sysroot_inlined(files: ref Vec[(String, String)]) -> String sync {
    if files.is_empty() {
        return ""
    }
    let mut text: String = files[0].1.clone()
    for at in 1..<files.len() {
        let replaced = text.replace(f"include!(\"{files[at].0}\");", files[at].1)
        text = replaced
    }
    return text
}

/// Whether any file holds `needle`.
pub fn sysroot_contains(files: ref Vec[(String, String)], needle: ref String) -> bool sync {
    return files.iter().any(fn(file) { file.1.contains(needle) })
}

/// Whether `path` holds exactly `text`; not where it cannot be read.
fn sysroot_holds(path: ref fs::Path, text: ref String) -> bool {
    let now = fs::read_to_string(path, fs::Root::Anywhere) catch { return false }
    return now == text
}

/// The paths below `dir` that differ from what is committed there, or
/// are committed and no longer generated.
pub fn sysroot_drift(files: ref Vec[(String, String)], dir: ref fs::Path) -> Vec[String] {
    let mut drifted: Vec[String] = []
    for file in files {
        if !sysroot_holds(dir.join(file.0), file.1) {
            drifted.push(file.0.clone())
        }
    }
    let kept: Vec[String] = files.iter().map(fn(file) { file.0.clone() }).collect()
    drifted.extend(sysroot_stale(dir, kept))
    return drifted
}

/// The generated files under `dir/lowered/` that `kept` does not name.
pub fn sysroot_stale(dir: ref fs::Path, kept: ref Vec[String]) -> Vec[String] sync {
    let mut stale: Vec[String] = sysroot_generated(dir).iter().filter(fn(name) { !kept.contains(name) }).map(fn(name) { name.clone() }).collect()
    stale.sort()
    return stale
}

/// **Every generated file under `dir/lowered/`**: one per file of the
/// package, and a directory per dependency (#1163) with that package's index
/// and its own `lowered/` files.
fn sysroot_generated(dir: ref fs::Path) -> Vec[String] sync {
    let mut names: Vec[String] = []
    let listed = fs::read_dir(dir.join(SYSROOT_COMPILER_FILES), fs::Root::Anywhere) catch { [] }
    for entry in listed {
        let name = f"{SYSROOT_COMPILER_FILES}/{entry.text_of()}"
        let meta = fs::metadata(dir.join(name), fs::Root::Anywhere) catch { continue }
        if !meta.is_dir() {
            names.push(name)
            continue
        }
        names.push(f"{name}/{SYSROOT_COMPILER_PACKAGE}")
        let theirs = fs::read_dir(dir.join(name).join(SYSROOT_COMPILER_FILES), fs::Root::Anywhere) catch { [] }
        for file in theirs {
            names.push(f"{name}/{SYSROOT_COMPILER_FILES}/{file.text_of()}")
        }
    }
    return names
}

/// A package as one text, for its cache entry: each file after a
/// `SYSROOT_PACKED` line that names it.
pub fn sysroot_pack(files: ref Vec[(String, String)]) -> String sync {
    return files.iter().map(fn(file) { f"{SYSROOT_PACKED}{file.0}\n{file.1}" }).join("")
}

/// The files of a packed package; none where the text does not start with a
/// `SYSROOT_PACKED` line or names no file.
pub fn sysroot_unpack(packed: ref String) -> Vec[(String, String)]? sync {
    let mut files: Vec[(String, String)] = []
    let pieces: Vec[String] = packed.split("\n").collect()
    for at in 0..<pieces.len() {
        // Each line with its own `\n`, as it stood in the text.
        let line: String = match at + 1 < pieces.len() {
            true => f"{pieces[at]}\n",
            false => pieces[at].clone(),
        }
        if line.is_empty() {
            continue
        }
        if line.starts_with(SYSROOT_PACKED) {
            files.push(((line.strip_prefix(SYSROOT_PACKED) ?? "").trim_end().clone(), ""))
        } else {
            if files.is_empty() {
                return null
            }
            let last = files.len() - 1
            files[last].1.push_str(line)
        }
    }
    if files.is_empty() {
        return null
    }
    return files
}

/// **The key for lowering `files` as `what`** (#667): the compiler, `what`,
/// and the name and bytes of every file read, in order; none where one of
/// them cannot be read (the lowering then says why) or there is no compiler.
pub fn sysroot_lowered_key[H: SysrootHost](compiler: String?, what: ref String, files: ref Vec[fs::Path], host: ref H) -> String? {
    let given = compiler ?? return null
    let mut read: Vec[u8] = []
    sysroot_ended(read, "nikaia-lower-std-v1")
    sysroot_ended(read, given)
    sysroot_ended(read, what)
    for file in files {
        let source = fs::read(file, fs::Root::Anywhere) catch { return null }
        let name = file.file_name() ?? return null
        sysroot_part(read, name.text_of())
        sysroot_length(read, source.len())
        for b in source.iter() {
            read.push(b)
        }
    }
    return hash::sha256_hex(read)
}

/// What the cache under `root` holds for `key`, marked as used; none where
/// there is no key, no compiler (`cached` false) or no readable entry.
pub fn sysroot_lowered_get[H: SysrootHost](root: ref fs::Path, cached: bool, key: String?, host: ref H) -> String? {
    let entry = root.join(key ?? return null)
    if !cached {
        return null
    }
    let rust = fs::read_to_string(entry.join(SYSROOT_LOWERED), fs::Root::Anywhere) catch { return null }
    host.use_entry(entry)
    return rust
}

/// Writes `rust` as the cache's entry for `key`, whole or not at all: a
/// reader never sees half an entry. An entry that cannot be written is not.
pub fn sysroot_lowered_put[H: SysrootHost](root: ref fs::Path, cached: bool, key: String?, rust: ref String, host: ref H) {
    let at = key ?? return
    if !cached {
        return
    }
    let entry = root.join(at)
    fs::create_dir(entry, fs::Root::Anywhere; recursive: true) catch { return }
    let partial = host.unique_beside(entry.join(SYSROOT_LOWERED))
    if sysroot_written(partial, entry.join(SYSROOT_LOWERED), rust) {
        host.use_entry(entry)
        return
    }
    fs::remove(partial, fs::Root::Anywhere) catch { return }
}

/// Whether `rust` went to `partial` and `partial` became `whole`.
fn sysroot_written(partial: ref fs::Path, whole: ref fs::Path, rust: ref String) -> bool {
    fs::write(partial, fs::Root::Anywhere, rust) catch { return false }
    fs::rename(partial, whole, fs::Root::Anywhere) catch { return false }
    return true
}
