// crates/nikaia-std/src/compiler/emit_keeps.nika
//
// **What the emitter writes and asks for a function's keeps and tethers**,
// moved from `emit/mod.rs` (ADR-294, #125, #558, step E7): where a keep is
// named in the Rust, which lines declare the keeps before a statement, which
// keep a call is handed, whether a field of a struct of views carries a view,
// and which lifetimes a function that takes a keep is written with. Methods of
// `EmitState`; the plans are `buffers.nika`'s, found by the function's key or
// else by the function being written.

use std::collections

/// The name of a keep that stands at a statement: `__keep_3`, or `&__keep_3`
/// where it is lent.
fn emit_keep_numbered(at: i64, lent: bool) -> String {
    if lent {
        return f"&__keep_{at}"
    }
    return f"__keep_{at}"
}

/// How a keep is named in the Rust, owned or lent.
fn emit_keep_expr(keep: ref KeepAt, lent: bool) -> String {
    match keep {
        KeepAt::Param => return "__keep",
        KeepAt::Frame => {
            if lent {
                return "&__keep_frame"
            }
            return "__keep_frame"
        },
        KeepAt::Local(at) => return emit_keep_numbered(at, lent),
        KeepAt::Element(at) => return emit_keep_numbered(at, lent),
        KeepAt::Task => return "(&*__keep_task)",
    }
}

/// **The pool of the loop over a stream at `at`** (ADR-stream-buffers-v1
/// D3), where the plan has one there.
fn emit_stream_pool(plan: ref BufferPlan, at: i64) -> i64? {
    for stream in plan.streams {
        if stream.at == at {
            return stream.pool
        }
    }
    return null
}

/// Whether a keep is the element keep of the statement `at`.
fn emit_is_element(keep: ref KeepAt, at: i64) -> bool {
    return match keep {
        KeepAt::Element(held) => held == at,
        else => false,
    }
}

impl EmitState {
    /// The key a function's plan is under: the function's own, or else the
    /// one being written.
    fn keep_plan_key(ref self, walk: ref EmitWalk, function: ref String) -> String? {
        if self.keep_plans.contains_key(function) {
            return function.clone()
        }
        if self.keep_plans.contains_key(walk.keep_function) {
            return walk.keep_function.clone()
        }
        return null
    }

    /// The lines that declare the keeps of the statement `at`, where a
    /// function has any.
    fn keep_prelude(ref self, walk: ref EmitWalk, function: ref String, at: i64) -> String? {
        let key = self.keep_plan_key(walk, function) ?? return null
        let plan = self.keep_plans.get(key) ?? return null
        let mut lines: Vec[String] = []
        if plan.first == at {
            if plan.frame_keep {
                lines.push("let __keep_frame = nikaia_std::tether::Keep::new();")
            }
            if plan.task_keep {
                lines.push("let __keep_task = std::sync::Arc::new(nikaia_std::tether::Keep::new());")
            }
            // **A buffer read per turn gets a spare before the loop** (#2859):
            // the buffer of the turn whose last view died, for the next read.
            for read in plan.reads {
                lines.push(f"let __spare_{read} = nikaia_std::tether::Spare::<nikaia_std::block::Text>::new();")
            }
        }
        if plan.local_keeps.contains(at) {
            lines.push(f"let __keep_{at} = nikaia_std::tether::Keep::new();")
        }
        let mut element = false
        for (_, keep) in plan.puts {
            if emit_is_element(keep, at) {
                element = true
            }
        }
        for (_, keep) in plan.calls {
            if emit_is_element(keep, at) {
                element = true
            }
        }
        // **A loop over a stream binds its keep from each line**
        // (ADR-stream-buffers-v1 D1): the chunk's, not one of its own.
        if element && emit_stream_pool(plan, at) == null {
            // **The keep of a turn's read hands its buffer back** (#2859).
            if plan.reads.contains(at) {
                lines.push(f"let __keep_{at} = std::sync::Arc::new(nikaia_std::tether::Keep::returning(&__spare_{at}));")
            } else {
                lines.push(f"let __keep_{at} = std::sync::Arc::new(nikaia_std::tether::Keep::new());")
            }
        }
        if lines.len() == 0 {
            return null
        }
        return lines.join(" ")
    }

    /// **Whether `name` holds a line of a stream across turns**
    /// (ADR-stream-buffers-v1 D2, D3): a name a loop over a stream counts,
    /// which holds each line with a handle on its buffer, `Held` in its type.
    fn stream_counted(ref self, walk: ref EmitWalk, function: ref String, name: ref String) -> bool {
        let key = self.keep_plan_key(walk, function) ?? return false
        let plan = self.keep_plans.get(key) ?? return false
        for stream in plan.streams {
            if stream.counted.contains(name) {
                return true
            }
        }
        return false
    }

    /// **Whether the `let` at `at` reads its buffer into the spare of its
    /// loop** (#2859): a file read into a keep of its own per turn.
    fn reads_into_spare(ref self, walk: ref EmitWalk, function: ref String, at: i64) -> bool {
        let key = self.keep_plan_key(walk, function) ?? return false
        let plan = self.keep_plans.get(key) ?? return false
        return plan.reads.contains(at)
    }

    /// The pool of the loop over a stream at `at`, in the plan of the
    /// function being written.
    fn stream_pool(ref self, walk: ref EmitWalk, function: ref String, at: i64) -> i64? {
        let key = self.keep_plan_key(walk, function) ?? return null
        let plan = self.keep_plans.get(key) ?? return null
        return emit_stream_pool(plan, at)
    }

    /// The keep argument `i` of a call to `callee` at the statement is lent.
    fn argument_keep(ref self, walk: ref EmitWalk, function: ref String, statement: i64, callee: ref String, i: i64) -> String? {
        let key = self.keep_plan_key(walk, function) ?? return null
        let plan = self.keep_plans.get(key) ?? return null
        let keep = plan.calls.get((statement, f"{callee}#{i}")) ?? return null
        return emit_keep_expr(keep, true)
    }

    /// The keep a call to `callee` at the statement is handed.
    fn keep_handed(ref self, walk: ref EmitWalk, function: ref String, statement: i64, callee: ref String) -> String? {
        let key = self.keep_plan_key(walk, function) ?? return null
        let plan = self.keep_plans.get(key) ?? return null
        let keep = plan.calls.get((statement, callee.clone())) ?? return null
        return emit_keep_expr(keep, true)
    }

    /// The lifetimes a function that takes a keep is written with, where the
    /// function is one.
    fn kept_lifetimes(ref self, key: ref String, lifetimes: EmitLifetimes) -> EmitLifetimes? {
        let contract = self.own_contracts.functions.get(key) ?? return null
        if !takes_a_keep(contract) {
            return null
        }
        if lifetimes.params() == "'a" {
            return EmitLifetimes::Named
        }
        return EmitLifetimes::Kept
    }

    /// Whether the view at `position` of the function is tethered.
    fn tethered_position(ref self, key: ref String, position: ref String) -> bool {
        let contract = self.own_contracts.functions.get(key) ?? return false
        for held in contract.views {
            if held.position == position && held.state == State::Tethered {
                return true
            }
        }
        return false
    }

    /// Whether the expression is a name the function's plan reads through a
    /// handle.
    fn reads_through_handle(ref self, world: ref EmitWorld, walk: ref EmitWalk, function: ref String, expr: ref Expr) -> bool {
        match expr {
            Expr::Variable(name, _) => {
                let key = self.keep_plan_key(walk, function) ?? return false
                let plan = self.keep_plans.get(key) ?? return false
                return plan.struct_keepers.contains(world.words.resolve(name))
            },
            else => {},
        }
        return false
    }

    /// Whether a type names a struct that holds a view.
    fn names_borrowing(ref self, world: ref EmitWorld, ty: ref Type) -> bool {
        let code = ty.code ?? return self.names_borrowing_written(world, ty)
        let result = code.result ?? return false
        return self.names_borrowing(world, result)
    }

    fn names_borrowing_written(ref self, world: ref EmitWorld, ty: ref Type) -> bool {
        if self.borrowing.contains(world.words.resolve(ty.name)) {
            return true
        }
        for inner in ty.generics {
            if self.names_borrowing(world, inner) {
                return true
            }
        }
        return false
    }

    /// Whether the field of the struct a keeper name stands for carries a view;
    /// it does where nothing says it does not.
    fn held_field_carries_view(ref self, world: ref EmitWorld, walk: ref EmitWalk, function: ref String, keeper: ref Expr, field: winnow_grammar::Symbol) -> bool {
        match keeper {
            Expr::Variable(held, _) => {
                let key = self.keep_plan_key(walk, function) ?? return true
                let plan = self.keep_plans.get(key) ?? return true
                let owner = plan.keeper_structs.get(world.words.resolve(held)) ?? return true
                let wanted = world.words.resolve(field)
                for item in world.items {
                    match item.node {
                        Item::Struct { name, fields, .. } => {
                            if world.words.resolve(name) == owner {
                                for each in fields {
                                    if world.words.resolve(each.name) == wanted {
                                        return holds_view(each.ty) || self.names_borrowing(world, each.ty)
                                    }
                                }
                            }
                        },
                        else => {},
                    }
                }
                return true
            },
            else => {},
        }
        return true
    }
}

/// The result type of the function of the file called `wanted`.
fn emit_returned_by(world: ref EmitWorld, wanted: ref String) -> Type? {
    for item in world.items {
        match item.node {
            Item::Fn { name, ret_type, .. } => {
                let called = name ?? continue
                if world.words.resolve(called) == wanted {
                    let result = ret_type ?? continue
                    return result.clone()
                }
            },
            else => {},
        }
    }
    return null
}

/// The type a tethered `let` holds: the one written, or else the result type
/// of the function the value calls.
fn emit_tethered_type(world: ref EmitWorld, ty: ref Type?, value: ref Expr) -> Type? {
    if ty != null {
        return ty?.clone()
    }
    match value {
        Expr::Try(inner, _) => return emit_tethered_call(world, inner),
        Expr::Async(inner, _, _, _) => return emit_tethered_call(world, inner),
        else => return emit_tethered_call(world, value),
    }
}

fn emit_tethered_call(world: ref EmitWorld, call: ref Expr) -> Type? {
    match call {
        Expr::Call { func, .. } => {
            match func {
                Expr::Variable(name, _) => {
                    return emit_returned_by(world, world.words.resolve(name))
                },
                else => {},
            }
        },
        else => {},
    }
    return null
}

/// **What stands before and after a value held by `keeps`** (ADR-tether-v1
/// D12, D15, #2842): where the plan names the one buffer it points into, the
/// view is checked against that buffer's place - `Held::in_place` for plainly
/// a view of it, where a miss is the compiler's fault, `hold_near` where it
/// may be a literal; elsewhere it is found again among the keeps.
fn emit_held_around(keeps: ref String, place: (i64, bool)?) -> (String, String) {
    let named = place ?? return ("{ use nikaia_std::tether::Hold as _; (", f").hold([{keeps}]) }}")
    if named.1 {
        return (f"nikaia_std::tether::Held::in_place(std::sync::Arc::clone(&__keep_{named.0}), __place_{named.0}, ", ")")
    }
    return ("{ use nikaia_std::tether::Hold as _; (", f").hold_near([{keeps}], __place_{named.0}) }}")
}

/// **Whether a held value is an `if` the emitter checks arm by arm**
/// (ADR-tether-v1 D15, #2848): each arm one expression, with an `else`,
/// ending in a literal or a value.
fn emit_held_arms_fit(value: ref Expr) -> bool {
    return match value {
        Expr::If { then_branch, else_branch, .. } => {
            let other = else_branch ?? return false
            emit_held_arm_fits(then_branch) && emit_held_arm_fits(other)
        }
        else => false,
    }
}

fn emit_held_arm_fits(block: ref Block) -> bool {
    if block.stmts.len() != 1 {
        return false
    }
    let tail = ending_of(block) ?? return false
    return match tail {
        Expr::If { .. } => emit_held_arms_fit(tail),
        else => true,
    }
}

impl EmitState {
    /// **A value held by `keeps`, checked against the buffer the plan names**
    /// (ADR-tether-v1 D12, D14, D15, #2842, #2848): plainly a view of it,
    /// `Held::in_place`; an `if` whose arms are a plain view or a literal,
    /// each arm on its own - the view checked, a miss the compiler's fault,
    /// the literal held with no keep; a struct literal, each field against its
    /// own buffer (`__hold_at`); else `hold_near`, or found again among the
    /// keeps where the plan names no buffer. `buffers` are the keeps' buffers
    /// in their order, empty where they are not known.
    fn emit_held_value[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, value: ref Expr, keeps: ref String, buffers: ref Vec[i64], place: (i64, bool)?, function: ref String, depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        let key = self.keep_plan_key(walk, function) ?? ""
        let plan = self.keep_plans.get(key)
        let parts: collections::BTreeSet[i64] = plan?.plain_parts?.clone() ?? collections::BTreeSet()
        let fields: collections::BTreeMap[String, (i64, bool)]? = plan?.field_places?.get(node_key(value))?.clone()
        let at = self.emit_held_fields(world, value, fields, place, buffers, false)
        if at != null {
            // A struct of views is written bare, so its `__hold_at` is
            // reached (no `Cleaned` around it: `emit_held_fields`).
            out.push("(")
            self.emit_expr(world, walk, out, host, value, depth, flow, scope)
            out.push(f").__hold_at([{keeps}], {at ?? ""})")
            return
        }
        let named = place ?? (-1, false)
        if named.0 >= 0 && !named.1 && emit_held_arms_fit(value) && self.emit_held_arms_plain(world, walk, host, value, parts, depth, flow, scope) {
            self.emit_held_arm(world, walk, out, host, value, keeps, named.0, parts, depth, flow, scope)
            return
        }
        let (before, after) = emit_held_around(keeps, place)
        out.push(before)
        self.emit_expr(world, walk, out, host, value, depth, flow, scope)
        out.push(after)
    }

    /// **Whether every arm of a held `if` is a literal or a plain view**
    /// (#2848), each written as it stands - a literal as static text, a view
    /// with nothing around it (no `Some(..)` of a nullable place): only then
    /// is each arm held on its own, the literal with no keep.
    fn emit_held_arms_plain[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, host: ref H, value: ref Expr, parts: ref collections::BTreeSet[i64], depth: i64, flow: EmitFlow, scope: ref EmitScope) -> bool sync throws {
        match value {
            Expr::If { then_branch, else_branch, .. } => {
                let other = else_branch ?? return false
                let first = ending_of(then_branch) ?? return false
                let second = ending_of(other) ?? return false
                return self.emit_held_arms_plain(world, walk, host, first, parts, depth, flow, scope) && self.emit_held_arms_plain(world, walk, host, second, parts, depth, flow, scope)
            }
            Expr::LitStr { .. } => {
                let mut written = EmitOut::empty()
                self.emit_expr(world, walk, written, host, value, depth, flow, scope)
                return written.buf.starts_with("\"") && written.buf.ends_with("\"")
            }
            else => {
                if !parts.contains(node_key(value)) {
                    return false
                }
                let mut written = EmitOut::empty()
                self.emit_expr(world, walk, written, host, value, depth, flow, scope)
                return !written.buf.starts_with("Some(")
            }
        }
    }

    /// One arm of a held `if` (#2848): a literal held with no keep, a plain
    /// view checked against the buffer at `buffer`, anything else `hold_near`.
    fn emit_held_arm[H: EmitHost](ref self, world: ref EmitWorld, mut walk: EmitWalk, mut out: EmitOut, host: ref H, value: ref Expr, keeps: ref String, buffer: i64, parts: ref collections::BTreeSet[i64], depth: i64, flow: EmitFlow, scope: ref EmitScope) sync throws {
        match value {
            Expr::If { cond, then_branch, else_branch, .. } => {
                let other = else_branch ?? return
                let first = ending_of(then_branch) ?? return
                let second = ending_of(other) ?? return
                out.push("if ")
                self.emit_expr(world, walk, out, host, cond, depth, flow, scope)
                out.push(" { ")
                self.emit_held_arm(world, walk, out, host, first, keeps, buffer, parts, depth, flow, scope)
                out.push(" } else { ")
                self.emit_held_arm(world, walk, out, host, second, keeps, buffer, parts, depth, flow, scope)
                out.push(" }")
            }
            Expr::LitStr { .. } => {
                out.push("nikaia_std::tether::Held::literal(")
                self.emit_expr(world, walk, out, host, value, depth, flow, scope)
                out.push(")")
            }
            else => {
                let (before, after) = emit_held_around(keeps, (buffer, parts.contains(node_key(value))))
                out.push(before)
                self.emit_expr(world, walk, out, host, value, depth, flow, scope)
                out.push(after)
            }
        }
    }

    /// **Where each field of a struct literal held or packed is checked**
    /// (ADR-tether-v1 D14, D15, #2848): `[At; fields]` in the order the struct
    /// declares them, for its `__hold_at` / `__rebase_at` - a view field at
    /// the place of its own buffer, `In` where it is plainly a view of it,
    /// `Near` where it may be a literal, `Copied` for a literal; a field the
    /// plan names no buffer for at the value's one buffer, else `Found`. The
    /// keep is the buffer's among `buffers`, or the task's (`packed`). Null
    /// where it is no struct literal of views or the plan names nothing.
    fn emit_held_fields(ref self, world: ref EmitWorld, value: ref Expr, named: collections::BTreeMap[String, (i64, bool)]?, place: (i64, bool)?, buffers: ref Vec[i64], packed: bool) -> String? {
        let name = match value {
            Expr::StructLit { name, .. } => emit_text(world, name).clone(),
            else => return null,
        }
        if named == null && place == null {
            return null
        }
        let by_field = named ?? collections::BTreeMap()
        let mut declared: Vec[FieldDef]? = null
        for item in world.items {
            match item.node {
                Item::Struct { name: own, generics, fields, .. } => {
                    if world.words.resolve(own) == name && generics.len() == 0 && self.borrowing.contains(name) {
                        declared = fields.clone()
                    }
                },
                else => {},
            }
        }
        let fields = declared ?? return null
        if self.cleaned_types.contains(name) {
            return null
        }
        let mut at: Vec[String] = []
        for field in fields {
            if !holds_view(field.ty) && !self.names_borrowing(world, field.ty) {
                at.push("nikaia_std::tether::At::Found")
                continue
            }
            let mut named_here: (i64, bool)? = by_field.get(world.words.resolve(field.name))?.clone()
            if named_here == null && place != null {
                let whole = place ?? (-1, false)
                named_here = (whole.0, false)
            }
            let (buffer, sure) = named_here ?? (-2, false)
            if buffer == -1 {
                at.push("nikaia_std::tether::At::Copied(0)")
                continue
            }
            let mut keep = -1
            if packed {
                keep = 0
            } else {
                for k in 0..<buffers.len() {
                    if keep < 0 && buffers[k] == buffer {
                        keep = k
                    }
                }
            }
            if buffer < 0 || keep < 0 {
                at.push("nikaia_std::tether::At::Found")
            } else if sure {
                at.push(f"nikaia_std::tether::At::In({keep}, __place_{buffer})")
            } else {
                at.push(f"nikaia_std::tether::At::Near({keep}, __place_{buffer})")
            }
        }
        let joined = at.join(", ")
        return f"[{joined}]"
    }
}
