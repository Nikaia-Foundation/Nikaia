// crates/nikaia-std/src/compiler/signature.nika
//
// **A Rust signature in the ledger's words** (ADR-rust-boundary-1 D3, D4; ADR-rust-boundary-1 D9): one
// type at a time, whether a value of it is kept, what a `Result` throws, and
// which parameters a `Send` bound reaches.
//
// Moved from the compiler's `describe.rs` by ADR-rust-boundary-1's route (#124): lowered
// by `nikaia lower-std` to `signature.rs` beside it, `include!`d as
// `nikaia_std::compiler::signature`, and called from `describe`. It reads the
// ledger's records beside it for `Ty`, as `ledger.nika` does.
//
// **What it cannot translate is `Ty::Unknown`**, the ledger's `?`: the absence
// of a claim and never a guess (D4), for a reviewer to fill (D5).

use std::collections

/// One type as the ledger writes it, and whether a value of it is **kept**:
/// D3's first row - `&T` is a view and `T` by value is kept, because the crate
/// takes it and the caller may not go on using it.
pub struct Translated {
    pub ty: Ty,
    pub kept: bool,
}

/// A result type as the ledger writes it, and what it throws where it is a
/// `Result`: the crate's own error by its path, and `"?"` for any other.
pub struct Resulted {
    pub ty: Ty,
    pub fails: String?,
}

/// One Rust type as the ledger's. `parameters` are the function's own type
/// parameters, which the ledger spells as variables; `types` are the crate's
/// own types, each of which the signature names is added to `mentioned`.
pub fn translate(written: ref String, crate_word: ref String, parameters: ref Vec[String], types: ref collections::BTreeSet[String], mut mentioned: collections::BTreeSet[String]) -> Translated {
    let text = written.trim()
    // `&mut T` is *changed in place*, which the ledger says with `mutates` on
    // the entry rather than on the type - and there is no place for it here.
    if text.starts_with("&mut ") {
        return Translated { ty: Ty::Unknown, kept: false }
    }
    if text.starts_with("&") {
        let c: Vec[scalar] = text.scalars.collect()
        let rest = slice(c, 1, c.len())
        let inner = translate(rest, crate_word, parameters, types, mentioned)
        return Translated { ty: view_of(inner.ty), kept: false }
    }
    // `[T]`, behind the `&` above, is the list Part III 15.2 says crosses to
    // `&[T]` for free: `Array[T]` without a length (#1545). `[T; N]` has a
    // length this does not read, and stays `?`.
    if text.starts_with("[") && text.ends_with("]") {
        let c: Vec[scalar] = text.scalars.collect()
        let element = slice(c, 1, c.len() - 1)
        if element.contains(";") {
            return Translated { ty: Ty::Unknown, kept: true }
        }
        let inner = translate(element, crate_word, parameters, types, mentioned)
        return Translated { ty: Ty::Named { name: "Array", args: [inner.ty], view: false }, kept: true }
    }
    // `(A, B)` is the ledger's tuple, part by part, kept where a part is
    // kept (#1679). `()` is the unit, which `contract` leaves out of the
    // result; a one-part `(A,)` has no ledger spelling and stays `?`.
    if text.starts_with("(") && text.ends_with(")") {
        let c: Vec[scalar] = text.scalars.collect()
        let inside = slice(c, 1, c.len() - 1)
        let written_parts = split_top_level(inside)
        if written_parts.len() == 1 {
            return Translated { ty: Ty::Unknown, kept: true }
        }
        let mut parts: Vec[Ty] = []
        let mut kept = false
        for part in written_parts {
            let one = translate(part, crate_word, parameters, types, mentioned)
            if one.kept {
                kept = true
            }
            parts.push(one.ty)
        }
        return Translated { ty: Ty::Tuple(parts), kept: kept }
    }
    let optional = generic_of(text, "Option")
    if optional != null {
        let inner = translate(optional ?? "", crate_word, parameters, types, mentioned)
        return Translated { ty: Ty::Nullable(inner.ty), kept: inner.kept }
    }
    let listed = generic_of(text, "Vec")
    if listed != null {
        let inner = translate(listed ?? "", crate_word, parameters, types, mentioned)
        return Translated { ty: Ty::Named { name: "Vec", args: [inner.ty], view: false }, kept: true }
    }
    for parameter in parameters {
        if text == parameter {
            return Translated { ty: Ty::Var { name: text.clone(), view: false }, kept: true }
        }
    }
    if is_plain(text) {
        return Translated { ty: Ty::Named { name: text.clone(), args: [], view: false }, kept: false }
    }
    if text == "String" {
        return Translated { ty: Ty::Named { name: "String", args: [], view: false }, kept: true }
    }
    if types.contains(text) {
        mentioned.insert(text.clone())
        return Translated { ty: Ty::Named { name: f"{crate_word}::{text}", args: [], view: false }, kept: true }
    }
    // Anything else - another crate's type, a trait object, a path with
    // segments - is a name this cannot account for.
    return Translated { ty: Ty::Unknown, kept: true }
}

/// `Result<T, E>` in the result position: the `T` is the type and the `E` is a
/// `throws` - the crate's own error by its path, and `"?"` for any other.
pub fn result_of(written: ref String, crate_word: ref String, parameters: ref Vec[String], types: ref collections::BTreeSet[String], mut mentioned: collections::BTreeSet[String]) -> Resulted {
    let resulted = generic_of(written, "Result")
    if resulted == null {
        let plain = translate(written, crate_word, parameters, types, mentioned)
        return Resulted { ty: plain.ty, fails: null }
    }
    let parts = split_top_level(resulted ?? "")
    let mut ok: String = ""
    if parts.len() > 0 {
        ok = parts[0].clone()
    }
    let fine = translate(ok, crate_word, parameters, types, mentioned)
    let mut fails: String = "?"
    if parts.len() > 1 {
        let error = parts[1].trim()
        if types.contains(error) {
            fails = f"{crate_word}::{error}"
        }
    }
    return Resulted { ty: fine.ty, fails: fails }
}

/// A view of a type, which the ledger's language writes with the `&` on the
/// name.
fn view_of(ty: Ty) -> Ty {
    return match ty {
        Ty::Named { name, args, .. } => Ty::Named { name: name, args: args, view: true },
        Ty::Var { name, .. } => Ty::Var { name: name, view: true },
        else => ty,
    }
}

/// **The parameters a `Send` bound reaches**, in declaration order (ADR-rust-boundary-1
/// D4): one whose type is a type variable the bounds send, and one written
/// `impl … Send …` at the parameter itself. `names` and `types` are the
/// parameters' names and written types, in order; `bounds` is the `<…>` list
/// and the `where` clause, joined.
pub fn sent_across(names: ref Vec[String], types: ref Vec[String], bounds: ref String) -> Vec[String] {
    let sent = sends(bounds)
    let mut out: Vec[String] = []
    for at in 0..<names.len() {
        let ty = types[at].trim()
        let named = unreferenced(ty)
        let mut reached = bounds_send(ty)
        for one in sent {
            if one == named {
                reached = true
            }
        }
        if reached {
            out.push(names[at].clone())
        }
    }
    return out
}

/// The type parameters a bound list binds `Send`.
pub fn sends(bounds: ref String) -> Vec[String] {
    let mut out: Vec[String] = []
    for one in split_top_level(bounds) {
        let c: Vec[scalar] = one.scalars.collect()
        let colon = find(c, 0, ':')
        if colon < 0 {
            continue
        }
        let head = slice(c, 0, colon)
        let name = head.trim()
        let bound = slice(c, colon + 1, c.len())
        if bounds_send(bound) && !name.is_empty() && !name.starts_with("'") && !out.contains(name.clone()) {
            out.push(name.clone())
        }
    }
    out.sort()
    return out
}

// A parameter's type without the `&`s and the `mut ` in front.
fn unreferenced(ty: ref String) -> String {
    let c: Vec[scalar] = ty.scalars.collect()
    let mut from = 0
    while from < c.len() && (c[from] == '&' || c[from] == ' ') {
        from += 1
    }
    let rest = slice(c, from, c.len())
    let trimmed = rest.trim()
    if trimmed.starts_with("mut ") {
        let t: Vec[scalar] = trimmed.scalars.collect()
        let after = slice(t, 4, t.len())
        return after.clone()
    }
    return trimmed.clone()
}

/// **One `fn` as it was written**: its parameters' names and written types,
/// in order, its result's text (empty where there is none), whether it is an
/// `async fn`, and its own type parameters.
pub struct WrittenFn {
    pub names: Vec[String],
    pub types: Vec[String],
    pub result: String,
    pub pauses: bool,
    pub parameters: Vec[String],
}

/// **One `pub fn`'s entry, from its signature** (ADR-rust-boundary-1 D3): each parameter
/// in the ledger's words, kept where it is taken by value, the result and what
/// a `Result` throws, and `sync` as the source says it - a plain `fn` cannot
/// pause and an `async fn` can, nothing between them. The crate types the
/// signature names go into `mentioned`.
pub fn contract(written: ref WrittenFn, crate_word: ref String, types: ref collections::BTreeSet[String], mut mentioned: collections::BTreeSet[String]) -> FnContract {
    let mut keeps: Vec[String] = []
    let mut os_text: Vec[String] = []
    let mut params: Vec[(String, Ty)] = []
    for at in 0..<written.names.len() {
        // **A `&OsStr` parameter is `ref String`, named in `os_text`** (Part
        // III 13.5, 15.2, #2351): a Nikaia `String` is UTF-8, which every
        // platform's `OsStr` holds, so the call hands it over as
        // `OsStr::new(arg)`. Only the parameter itself: inside an `Option`
        // or a list there is no argument to wrap, and it stays `?`.
        if takes_os_text(written.types[at]) {
            os_text.push(written.names[at].clone())
            params.push((written.names[at].clone(), Ty::Named { name: "String", args: [], view: true }))
            continue
        }
        let translated = translate(written.types[at], crate_word, written.parameters, types, mentioned)
        if translated.kept {
            keeps.push(written.names[at].clone())
        }
        params.push((written.names[at].clone(), translated.ty))
    }
    let mut fails: Vec[String] = []
    let mut answer: Ty? = null
    if !written.result.is_empty() {
        let resulted = result_of(written.result, crate_word, written.parameters, types, mentioned)
        if resulted.fails != null {
            fails.push(resulted.fails ?? "?")
        }
        // A unit `()` (as in `Result<(), E>`) is no result in the ledger.
        let unit = match resulted.ty {
            Ty::Tuple(parts) => parts.is_empty(),
            else => false,
        }
        if !unit {
            answer = resulted.ty
        }
    }
    let mut signature = Signature::empty()
    signature.params = params
    signature.result = answer
    let mut entry = FnContract::empty()
    entry.public = true
    entry.sync_claim = if written.pauses { Sync::No } else { Sync::Asserted }
    entry.fails_with = fails
    entry.keeps = keeps
    entry.os_text = os_text
    entry.signature = signature
    return entry
}

/// Whether a parameter's written Rust type is `&OsStr`, by any of the paths
/// a source names it with.
fn takes_os_text(written: ref String) -> bool {
    let text = written.trim()
    return text == "&OsStr" || text == "&ffi::OsStr" || text == "&std::ffi::OsStr"
}

/// A view is not kept, a value is; the crate's own type is named by its path
/// and noted; anything else is `?`.
test "a rust type reads as the ledgers" {
    let mut types: collections::BTreeSet[String] = collections::BTreeSet()
    types.insert("Conn")
    let params: Vec[String] = ["T"]
    let mut mentioned: collections::BTreeSet[String] = collections::BTreeSet()
    let view = translate("&str", "db", params, types, mentioned)
    assert(view.ty.text() == "ref String")
    assert(!view.kept)
    let own = translate("Vec<Conn>", "db", params, types, mentioned)
    assert(own.ty.text() == "Vec[db::Conn]")
    assert(own.kept)
    let variable = translate("Option<T>", "db", params, types, mentioned)
    assert(variable.ty.text() == "$T?")
    assert(variable.kept)
    let small = translate("u8", "db", params, types, mentioned)
    assert(small.ty.text() == "u8")
    assert(!small.kept)
    let lent = translate("&mut u8", "db", params, types, mentioned)
    assert(lent.ty.text() == "?")
    assert(!lent.kept)
    let foreign = translate("other::Thing", "db", params, types, mentioned)
    assert(foreign.kept)
    let noted = mentioned.contains("Conn")
    assert(noted)
}

/// A `&OsStr` parameter is `ref String` in the signature and named in
/// `os_text`; one inside an `Option` is not (Part III 13.5, #2351).
test "an os str parameter reads as os text" {
    let types: collections::BTreeSet[String] = collections::BTreeSet()
    let mut mentioned: collections::BTreeSet[String] = collections::BTreeSet()
    let written = WrittenFn {
        names: ["a", "b", "windows", "c"],
        types: ["&OsStr", "&std::ffi::OsStr", "bool", "Option<&OsStr>"],
        result: "bool",
        pauses: false,
        parameters: [],
    }
    let entry = contract(written, "process", types, mentioned)
    assert(entry.os_text == ["a", "b"])
    let said = entry.signature?.text() ?? ""
    assert(said.starts_with("(a: ref String, b: ref String, windows: bool, c: "))
    assert(!entry.keeps.contains("a"))
}

/// A `Result` throws the crate's own error by its path, and `?` for any
/// other.
test "a result names what it throws" {
    let mut types: collections::BTreeSet[String] = collections::BTreeSet()
    types.insert("Error")
    let none: Vec[String] = []
    let mut mentioned: collections::BTreeSet[String] = collections::BTreeSet()
    let own = result_of("Result<u8, Error>", "db", none, types, mentioned)
    assert((own.fails ?? "none") == "db::Error")
    let other = result_of("Result<(), io::Error>", "db", none, types, mentioned)
    assert((other.fails ?? "none") == "?")
    let plain = result_of("u8", "db", none, types, mentioned)
    assert(plain.fails == null)
}

/// A bound reaches a parameter through its type variable or an `impl Send`
/// at the parameter itself.
test "a send bound reaches its parameters" {
    let variables = sends("T: Send + 'static, U: Clone, 'a: 'b")
    assert(variables == ["T"])
    let names: Vec[String] = ["job", "name", "f"]
    let types: Vec[String] = ["&mut T", "&str", "impl FnOnce() + Send"]
    let sent = sent_across(names, types, "T: Send, ")
    assert(sent == ["job", "f"])
}
