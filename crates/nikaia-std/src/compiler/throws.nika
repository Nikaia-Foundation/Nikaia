// crates/nikaia-std/src/compiler/throws.nika
//
// Kap 7.1: **which errors can leave a function** - the lattice of the
// compiler's `contracts::throws`, moved from Rust (ADR-294, #125).
//
// **The walk, the graph and the fixpoint.** Per `throws` function, what it
// throws itself and whom in this package it calls: the body's walk is here,
// what one expression reaches is `sync`'s single resolution (ADR-288), handed
// in as `contribution_of`, and the method calls are the type checker's,
// handed in as `MethodsCalled`. The compiler hands in each unit and writes
// back what this answers.
//
// An error set is a **least** fixpoint, `sync`'s walk with the lattice turned
// around: everyone starts with what they throw themselves and grows by what
// their callees throw, until nothing changes. Mutual recursion ends because
// the sets only grow, and there are finitely many names to grow by.

use std::collections

/// The name for an error nobody can name (ADR-280): what a call that cannot
/// be seen contributes, because "I cannot see it" may never be read as "it
/// does not fail" (ADR-010 D1).
comptime UNNAMED: ref String = "?"

/// The checker's entry for the functions of this package named as a value
/// (ADR-351 D4): not a place, the list of whose callers are not all seen.
pub comptime AS_VALUE: ref String = "<as a value>"

/// The method calls of one body as the type checker resolved them
/// (ADR-288): the entries reached, and whether something could not be seen
/// - a call that did not resolve, or code handed in that may fail.
pub struct MethodsCalled {
    pub resolved: collections::BTreeSet[String],
    pub unseen: bool,
    /// The function fields it calls through, as `Type.field` (ADR-351 D2).
    pub fields: collections::BTreeSet[String],
    /// Those of `resolved` called only inside a `catch` that keeps what it
    /// caught, with the fatal types its handler names (#725).
    pub swallowed: collections::BTreeMap[String, collections::BTreeSet[String]],
}

/// The graph the walk builds - what each `throws` function throws itself and
/// whom in this package it calls - with the type checker's method calls by
/// the key it files each body's answers under: one record, because every
/// function of a unit reads the one and writes the others.
pub struct ThrowsGraph {
    pub methods: collections::BTreeMap[String, MethodsCalled],
    pub direct: collections::BTreeMap[String, collections::BTreeSet[String]],
    pub calls: collections::BTreeMap[String, collections::BTreeSet[String]],
    /// **What a `catch` lets through** (ADR-345 D2): per function, the callees
    /// of this package called inside a `catch`, with the fatal types its
    /// handler names; the others of their fatal errors still reach the caller.
    pub fatal_calls: collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]],
    /// The fatal error types (ADR-345 D1), for a library's method a `catch`
    /// keeps.
    pub fatal: collections::BTreeSet[String],
}

/// **The graph before any unit is walked**: the type checker's method calls
/// as plain data, keyed as it files each body (ADR-288), and the fatal types
/// (ADR-345 D1).
pub fn throws_graph(own: ref Ledger, library: ref Ledger, resolved: ref collections::BTreeMap[String, CheckMethodCalls]) -> ThrowsGraph {
    let mut methods: collections::BTreeMap[String, MethodsCalled] = collections::BTreeMap()
    for (key, calls) in resolved {
        let called = MethodsCalled { resolved: calls.resolved.clone(), unseen: calls.unresolved || calls.code_fails, fields: calls.fields_called.clone(), swallowed: calls.swallowed.clone() }
        methods.insert(key.clone(), called)
    }
    return ThrowsGraph { methods: methods, direct: collections::BTreeMap(), calls: collections::BTreeMap(), fatal_calls: collections::BTreeMap(), fatal: fatal_types(own, library) }
}

/// **The fatal error types** (ADR-345 D1): every type an `impl Fatal` names,
/// in this package or a library.
pub fn fatal_types(own: ref Ledger, library: ref Ledger) -> collections::BTreeSet[String] {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    out.extend(own.implementations["Fatal"]?.clone() ?? collections::BTreeSet())
    out.extend(library.implementations["Fatal"]?.clone() ?? collections::BTreeSet())
    return out
}

/// **Each function field, name and parameter of code is a place of the
/// graph** (ADR-351 D1, D3, D4), given the checker's stored code: each goes
/// into `graph`, and a parameter whose callers this package does not all see
/// starts as `from(F::p)`, which its callers replace with what they hand.
/// Returns the places, which `error_sets` takes.
pub fn throws_places(own: ref Ledger, library: ref Ledger, mut stored: collections::BTreeMap[String, CheckStoredCode], mut graph: ThrowsGraph) -> collections::BTreeSet[String] {
    let open = params_as_places(own, stored)
    let mut places: collections::BTreeSet[String] = collections::BTreeSet()
    for (field, code) in stored {
        places.insert(field.clone())
        stored_throws(field, code.resolved, code.unresolved, code.free, code.thrown, own, library, graph)
    }
    for key in open {
        let mut set: collections::BTreeSet[String] = graph.direct.remove(key) ?? collections::BTreeSet()
        set.insert(f"from({key})")
        graph.direct.insert(key.clone(), set)
    }
    return places
}

/// **The answer written into the ledger**: a place's union into
/// `code_throws`, a function's set as it publishes it into its `fails_with`.
/// The package is derived callees first (ADR-100 D7).
pub fn throws_record(mut ledger: Ledger, graph: ref ThrowsGraph, places: ref collections::BTreeSet[String]) {
    let answer = error_sets_callees_first(graph.direct, graph.calls, graph.fatal_calls, graph.fatal, ledger, places)
    for (name, errors) in answer {
        if places.contains(name) {
            ledger.code_throws.insert(name.clone(), errors.clone())
            continue
        }
        let mut contract = ledger.functions.get(name) ?? continue
        contract.fails_with = throws_published(name, errors)
    }
}

/// Every `throws` function and method of one unit, by the key the ledger
/// records it under, into `graph`, which `error_sets` takes.
pub fn unit_throws(program: ref Program, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, own: ref Ledger, library: ref Ledger, raw_sinks_warn: bool, mut graph: ThrowsGraph) {
    for item in program.items {
        match item.node {
            Item::Fn { name, body, can_throw, .. } => {
                if can_throw {
                    let thrown = thrown_by_at(body, names, holes_of, contribution_of, raw_sinks_warn)
                    with_methods(key_of_function(name, "", names), thrown, own, library, graph)
                }
            }
            Item::Impl { target, methods, .. } => {
                let owner = names.resolve(target.name).clone()
                for method in methods {
                    match method.node {
                        Item::Fn { name, body, can_throw, .. } => {
                            if can_throw {
                                let thrown = thrown_by_at(body, names, holes_of, contribution_of, raw_sinks_warn)
                                with_methods(key_of_function(name, owner, names), thrown, own, library, graph)
                            }
                        }
                        else => {}
                    }
                }
            }
            else => {}
        }
    }
}

// What the walk left to somebody else: the body's method calls, merged rather
// than reconciled - the walk skips method calls entirely and this covers those
// and nothing else. A resolved callee of this package is a call; one of a
// library brings what its ledger says it fails with; one no ledger carries
// after all is `?`, as an unresolved one is.
fn with_methods(key: ref String, thrown: ref Thrown, own: ref Ledger, library: ref Ledger, mut graph: ThrowsGraph) {
    let mut named = thrown.direct.clone()
    let mut called: collections::BTreeSet[String] = collections::BTreeSet()
    // **A call by a name is the place of that name** (ADR-351 D1, D4): a
    // parameter or a name of code the checker saw called, `?` where not.
    let fields: collections::BTreeSet[String] = graph.methods[key]?.fields?.clone() ?? collections::BTreeSet()
    for callee in thrown.calls {
        if !callee.starts_with("@") {
            called.insert(callee.clone())
            continue
        }
        let local: String = (callee.strip_prefix("@") ?? "").clone()
        let place = f"{key}::{local}"
        if !fields.contains(place) {
            named.insert(UNNAMED.clone())
        }
    }
    let mut fatal_calls = thrown.fatal_calls.clone()
    methods_into(graph.methods[key], own, library, graph.fatal, named, called, fatal_calls)
    graph.direct.insert(key.clone(), named)
    graph.calls.insert(key.clone(), called)
    graph.fatal_calls.insert(key.clone(), fatal_calls)
}

// **A method a `catch` keeps adds only the fatal errors its handler does not
// name** (Part I 7.1, ADR-345 D2, #725): one of this package as a caught call,
// one of a library by its ledger's set.
fn methods_into(resolved: ref MethodsCalled?, own: ref Ledger, library: ref Ledger, fatal: ref collections::BTreeSet[String], mut named: collections::BTreeSet[String], mut called: collections::BTreeSet[String], mut fatal_calls: collections::BTreeMap[String, collections::BTreeSet[String]]) {
    let known = resolved ?? return
    called.extend(known.fields.clone())
    if known.unseen {
        named.insert(UNNAMED.clone())
    }
    for callee in known.resolved {
        if known.swallowed.contains_key(callee) {
            let taken: collections::BTreeSet[String] = known.swallowed[callee]?.clone() ?? collections::BTreeSet()
            if own.functions.contains_key(callee) {
                if !fatal_calls.contains_key(callee) {
                    fatal_calls.insert(callee.clone(), taken)
                }
            } else {
                for error in fails_with_of(library, callee) {
                    if fatal.contains(error) && !taken.contains(error) {
                        named.insert(error)
                    }
                }
            }
            continue
        }
        if own.functions.contains_key(callee) {
            called.insert(callee.clone())
        } else {
            named.extend(fails_with_of(library, callee))
        }
    }
}

/// **A function field is a place in the graph** (ADR-351 D1, D3): it calls
/// whatever was stored in it, and its set is the union of theirs. `free` are
/// the functions named or called by the stored code, `resolved` its method
/// calls, `thrown` what its lambdas' own `throw`s name (#1627); code this
/// walk did not see makes it `?`.
pub fn stored_throws(field: ref String, resolved: ref collections::BTreeSet[String], unresolved: bool, free: ref collections::BTreeSet[String], thrown: ref collections::BTreeSet[String], own: ref Ledger, library: ref Ledger, mut graph: ThrowsGraph) {
    let mut named: collections::BTreeSet[String] = thrown.clone()
    let mut called: collections::BTreeSet[String] = collections::BTreeSet()
    if unresolved {
        named.insert(UNNAMED.clone())
    }
    for callee in free {
        // **A parameter of code handed on** (ADR-351 D4): the place it is.
        if callee.starts_with("@") {
            called.insert((callee.strip_prefix("@") ?? "").clone())
        } else if own.functions.contains_key(callee) {
            called.insert(callee.clone())
        } else if library.functions.contains_key(callee) {
            named.extend(fails_with_of(library, callee))
        }
    }
    let known: MethodsCalled? = MethodsCalled { resolved: resolved.clone(), unseen: false, fields: collections::BTreeSet(), swallowed: collections::BTreeMap() }
    let mut fatal_calls: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    methods_into(known, own, library, graph.fatal, named, called, fatal_calls)
    graph.direct.insert(field.clone(), named)
    graph.calls.insert(field.clone(), called)
}

/// **A parameter of code is a place** (ADR-351 D1, D4), given what every
/// caller of this package hands it. One whose callers this package cannot
/// all see - a `pub` function, or one used as a value - is `from(F::p)`
/// besides: the callers this package does not see hand it more. Those places
/// are returned.
pub fn params_as_places(own: ref Ledger, mut stored: collections::BTreeMap[String, CheckStoredCode]) -> collections::BTreeSet[String] {
    let mut open: collections::BTreeSet[String] = collections::BTreeSet()
    let mut kept: collections::BTreeSet[String] = collections::BTreeSet()
    // The functions named as a value anywhere - returned, handed on, kept.
    let named: CheckStoredCode = stored.remove(AS_VALUE) ?? CheckStoredCode::empty()
    kept.extend(named.free.clone())
    for (_, code) in stored {
        kept.extend(code.free.clone())
    }
    // **A published field of a published type is stored into by packages this
    // one does not see** (ADR-351 D4): its set cannot be named here.
    for (owner, contract) in own.types {
        if !contract.public {
            continue
        }
        for field in contract.fields {
            if !field.public || !check_core_stmt_holds_code(field.ty) {
                continue
            }
            let key = f"{owner}.{field.name}"
            let mut entry: CheckStoredCode = stored.remove(key) ?? CheckStoredCode::empty()
            entry.unresolved = true
            stored.insert(key, entry)
        }
    }
    for (name, contract) in own.functions {
        if name.contains("::") {
            continue
        }
        let signature: ref Signature = contract.signature ?? continue
        for (param, ty) in signature.params {
            if !check_core_stmt_holds_code(ty) {
                continue
            }
            let key = f"{name}::{param}"
            let entry: CheckStoredCode = stored.remove(key) ?? CheckStoredCode::empty()
            if contract.public || kept.contains(name) {
                open.insert(key.clone())
            }
            stored.insert(key, entry)
        }
    }
    return open
}

/// **A set member that stands for the code a parameter was given** (ADR-351
/// D4): `from(p)`, or `from(F::p)` inside the inference.
pub fn throws_given(error: ref String) -> bool {
    return error.starts_with("from(") && error.ends_with(")")
}

/// **What a function publishes for its own parameters' code** (ADR-351 D4):
/// `from(F::p)` is written `from(p)` in `F`'s set; one of another function's
/// parameters is code this ledger cannot name, `?`.
pub fn throws_published(name: ref String, errors: ref Vec[String]) -> Vec[String] {
    let prefix = f"from({name}::"
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    for error in errors {
        if !throws_given(error) {
            out.insert(error.clone())
        } else if error.starts_with(prefix) {
            let rest: String = (error.strip_prefix(prefix) ?? "").clone()
            out.insert(f"from({rest}")
        } else {
            out.insert(UNNAMED.clone())
        }
    }
    let mut list: Vec[String] = []
    for error in out {
        list.push(error.clone())
    }
    return list
}

// What a library's ledger says a callee fails with, and `?` for one it does
// not carry.
fn fails_with_of(library: ref Ledger, callee: ref String) -> Vec[String] {
    let contract = library.functions[callee] ?? return ["?"]
    return contract.fails_with.clone()
}

/// What every `throws` function of the ledger fails with, by name: `direct`
/// is what each throws itself (`"?"` where it cannot be named) and `calls`
/// whom in this package it calls. A function the ledger does not carry, or
/// carries as one that cannot fail, has no entry - a function that cannot
/// fail cannot propagate. A declared `throws` whose body names nothing keeps
/// `["?"]`: the declaration is a promise a caller already relies on, and this
/// is here to say more than it, never less.
///
/// The whole package at once: the reference the callees-first route,
/// `error_sets_callees_first`, is held to (ADR-100 D7).
pub fn error_sets(direct: ref collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], fatal_calls: ref collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]], fatal: ref collections::BTreeSet[String], own: ref Ledger, places: ref collections::BTreeSet[String]) -> collections::BTreeMap[String, Vec[String]] {
    let mut sets = direct.clone()
    throws_grow(sets, calls, fatal_calls, fatal, own)
    // **A declared `throws` that names nothing fails with `?`, and so does
    // whoever calls it** (#725): its set is `?` before its callers settle,
    // not only in what it publishes, or a caller left with one named type
    // could not hand on the unnamed error.
    let unnamed = names_nothing(sets, own, places)
    if unnamed.len() > 0 {
        for name in unnamed {
            let mut only: collections::BTreeSet[String] = collections::BTreeSet()
            only.insert(UNNAMED.clone())
            sets.insert(name.clone(), only)
        }
        throws_grow(sets, calls, fatal_calls, fatal, own)
    }
    return throws_settled(sets, calls, own, places)
}

/// The nodes of `sets` whose set is empty while the ledger declares them
/// `throws`: a function field is no such promise.
fn names_nothing(sets: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger, places: ref collections::BTreeSet[String]) -> Vec[String] {
    let mut unnamed: Vec[String] = []
    for (name, set) in sets {
        if set.len() > 0 || places.contains(name) {
            continue
        }
        let contract = own.functions[name] ?? continue
        if contract.fails_with.len() > 0 {
            unnamed.push(name.clone())
        }
    }
    return unnamed
}

/// **One function's final error set, or its recursive group's** (ADR-100
/// D7): `unit` is the function, or the strongly connected component it is a
/// part of, and `stored` the final sets of the callees outside it. The least
/// fixpoint runs inside the unit only; a callee neither in it nor stored is
/// read as `throws_grow` reads it, from the ledger. A declared `throws` of the
/// unit left naming nothing is `?` and the unit grows once more, as
/// `error_sets` does for the package: a stored callee's set differs from its
/// first-round one only by `?`, which that round adds anyway. Answers every
/// node of the unit, a place's union included.
pub fn throws_of_unit(unit: ref Vec[String], direct: ref collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], fatal_calls: ref collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]], fatal: ref collections::BTreeSet[String], stored: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger, places: ref collections::BTreeSet[String]) -> collections::BTreeMap[String, collections::BTreeSet[String]] {
    let mut sets: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    for name in unit {
        let itself: collections::BTreeSet[String] = direct[name]?.clone() ?? collections::BTreeSet()
        sets.insert(name.clone(), itself)
    }
    throws_grow_unit(unit, sets, calls, fatal_calls, fatal, stored, own)
    let unnamed = names_nothing(sets, own, places)
    if unnamed.len() > 0 {
        for name in unnamed {
            let mut only: collections::BTreeSet[String] = collections::BTreeSet()
            only.insert(UNNAMED.clone())
            sets.insert(name.clone(), only)
        }
        throws_grow_unit(unit, sets, calls, fatal_calls, fatal, stored, own)
    }
    return sets
}

/// The least fixpoint inside one unit: `throws_grow` with the callees outside
/// the unit read from their stored sets.
fn throws_grow_unit(unit: ref Vec[String], mut sets: collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], fatal_calls: ref collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]], fatal: ref collections::BTreeSet[String], stored: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger) {
    let mut changed = true
    while changed {
        changed = false
        for name in unit {
            let before = sets[name]?.clone() ?? collections::BTreeSet()
            let mut grown = before.clone()
            let callees = calls[name]?.clone() ?? collections::BTreeSet()
            for callee in callees {
                grown.extend(theirs_stored(sets, stored, own, callee))
            }
            let caught = fatal_calls[name]?.clone() ?? collections::BTreeMap()
            for (callee, named) in caught {
                for error in theirs_stored(sets, stored, own, callee) {
                    if fatal.contains(error) && !named.contains(error) {
                        grown.insert(error)
                    }
                }
            }
            if grown.len() != before.len() {
                sets.insert(name.clone(), grown)
                changed = true
            }
        }
    }
}

/// What a callee fails with, from the unit's sets, then the stored ones.
fn theirs_stored(sets: ref collections::BTreeMap[String, collections::BTreeSet[String]], stored: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger, callee: ref String) -> Vec[String] {
    if sets.contains_key(callee) {
        return theirs(sets, own, callee)
    }
    return theirs(stored, own, callee)
}

/// **The whole package, callees first** (ADR-100 D7): the graph's strongly
/// connected components in reverse topological order, each derived by
/// `throws_of_unit` from the sets its callees already have. Answers what
/// `error_sets` answers.
pub fn error_sets_callees_first(direct: ref collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], fatal_calls: ref collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]], fatal: ref collections::BTreeSet[String], own: ref Ledger, places: ref collections::BTreeSet[String]) -> collections::BTreeMap[String, Vec[String]] {
    let mut stored: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    for unit in throws_callees_first(direct, calls, fatal_calls) {
        let column = throws_of_unit(unit, direct, calls, fatal_calls, fatal, stored, own, places)
        stored.extend(column)
    }
    return throws_settled(stored, calls, own, places)
}

/// Tarjan's walk over the throws graph: each node's visit number and lowest
/// reachable one, the nodes still open, and the components in the order they
/// close, which is callees first.
struct ThrowsComponents {
    index: collections::BTreeMap[String, i64],
    low: collections::BTreeMap[String, i64],
    open: collections::BTreeSet[String],
    stack: Vec[String],
    units: Vec[Vec[String]],
    next: i64,
}

/// The graph's recursive groups, each a unit, in reverse topological order: a
/// unit comes after every unit it calls into. A node is a key of `direct`; an
/// edge is a call, plain or inside a `catch`, to another node.
pub fn throws_callees_first(direct: ref collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], fatal_calls: ref collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]]) -> Vec[Vec[String]] {
    let mut walk = ThrowsComponents { index: collections::BTreeMap(), low: collections::BTreeMap(), open: collections::BTreeSet(), stack: [], units: [], next: 0 }
    for (name, _) in direct {
        if !walk.index.contains_key(name) {
            throws_connect(direct, calls, fatal_calls, name, walk)
        }
    }
    return walk.units
}

fn throws_connect(direct: ref collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], fatal_calls: ref collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]], name: ref String, mut walk: ThrowsComponents) {
    walk.index.insert(name.clone(), walk.next)
    walk.low.insert(name.clone(), walk.next)
    walk.next = walk.next + 1
    walk.stack.push(name.clone())
    walk.open.insert(name.clone())
    let mut edges: collections::BTreeSet[String] = calls[name]?.clone() ?? collections::BTreeSet()
    for (callee, _) in (fatal_calls[name]?.clone() ?? collections::BTreeMap()) {
        edges.insert(callee.clone())
    }
    for to in edges {
        if !direct.contains_key(to) {
            continue
        }
        let mut reached = -1
        if !walk.index.contains_key(to) {
            throws_connect(direct, calls, fatal_calls, to, walk)
            reached = walk.low[to] ?? -1
        } else if walk.open.contains(to) {
            reached = walk.index[to] ?? -1
        }
        let mine = walk.low[name] ?? 0
        if reached >= 0 && reached < mine {
            walk.low.insert(name.clone(), reached)
        }
    }
    if (walk.low[name] ?? -1) != (walk.index[name] ?? -2) {
        return
    }
    let mut unit: Vec[String] = []
    while true {
        let top = walk.stack.pop() ?? break
        walk.open.remove(top)
        let last = top == name
        unit.push(top)
        if last {
            break
        }
    }
    walk.units.push(unit)
}

/// **What the ledger records**, from every node's final set: a place keeps
/// its union, a declared `throws` its set with the code its callers handed
/// on named by its own parameter, `?` where it names nothing.
fn throws_settled(sets: ref collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger, places: ref collections::BTreeSet[String]) -> collections::BTreeMap[String, Vec[String]] {
    let mut settled: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    for (name, set) in sets {
        // **A function field settles to its union as it is** (ADR-351 D3):
        // empty where no failing value reaches it.
        if places.contains(name) {
            let mut union: Vec[String] = []
            for error in set {
                union.push(error.clone())
            }
            settled.insert(name.clone(), union)
            continue
        }
        let contract = own.functions[name] ?? continue
        if contract.fails_with.len() == 0 {
            continue
        }
        // **Code a caller handed on reaches this function through its own
        // parameter** (ADR-351 D4): `from(G::q)` that arrived in the place
        // `F::p` is, for `F`'s callers, what they hand `p`: `from(F::p)`.
        let own_prefix = f"from({name}::"
        let mut mapped: collections::BTreeSet[String] = collections::BTreeSet()
        for error in set {
            if !throws_given(error) || error.starts_with(own_prefix) {
                mapped.insert(error.clone())
                continue
            }
            let mut through: String = error.clone()
            for callee in (calls[name]?.clone() ?? collections::BTreeSet()) {
                if places.contains(callee) && callee.starts_with(f"{name}::") {
                    let held = sets[callee]?.clone() ?? collections::BTreeSet()
                    if held.contains(error) {
                        through = f"from({callee})"
                    }
                }
            }
            mapped.insert(through)
        }
        let mut errors: Vec[String] = []
        for error in mapped {
            errors.push(error.clone())
        }
        if errors.len() == 0 {
            errors.push("?")
        }
        settled.insert(name.clone(), errors)
    }
    return settled
}

// The least fixpoint: each function's set grows by what its callees throw,
// and by the fatal errors a `catch` around a callee does not name (ADR-345
// D2), until nothing changes.
fn throws_grow(mut sets: collections::BTreeMap[String, collections::BTreeSet[String]], calls: ref collections::BTreeMap[String, collections::BTreeSet[String]], fatal_calls: ref collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]], fatal: ref collections::BTreeSet[String], own: ref Ledger) {
    let mut changed = true
    while changed {
        changed = false
        for (name, callees) in calls {
            let before = sets[name]?.clone() ?? collections::BTreeSet()
            let mut grown = before.clone()
            for callee in callees {
                grown.extend(theirs(sets, own, callee))
            }
            let caught = fatal_calls[name]?.clone() ?? collections::BTreeMap()
            for (callee, named) in caught {
                for error in theirs(sets, own, callee) {
                    if fatal.contains(error) && !named.contains(error) {
                        grown.insert(error)
                    }
                }
            }
            if grown.len() != before.len() {
                sets.insert(name.clone(), grown)
                changed = true
            }
        }
    }
}

/// What a callee fails with. **One the walk did not see still has a set**
/// (ADR-grammar-actions-v1 D6): a grammar's entry rule is not an `Item::Fn`, and its contract
/// is written straight into the ledger (ADR-grammar-syntax-v1 D5). Read as nothing, what a
/// parse throws reached no caller, and the caller's channel was inferred
/// without it - a file `rustc` refused.
fn theirs(sets: ref collections::BTreeMap[String, collections::BTreeSet[String]], own: ref Ledger, callee: ref String) -> Vec[String] {
    let mut errors: Vec[String] = []
    // **A callee's own `from(F::p)` is what its callers hand it** (ADR-351
    // D4): the caller's arguments already reached the place `F::p`.
    let prefix = f"from({callee}::"
    if sets.contains_key(callee) {
        let set = sets[callee] ?? return errors
        for error in set {
            if !error.starts_with(prefix) {
                errors.push(error.clone())
            }
        }
        return errors
    }
    let contract = own.functions[callee] ?? return errors
    for error in contract.fails_with {
        errors.push(error.clone())
    }
    return errors
}

/// The type a `throw` raises. `ConfigError::NotFound(p)` and
/// `ConfigError::NotFound` are both `ConfigError`: a variant is written under
/// the type that declares it (Part I, 3.4), so **everything but the last
/// segment** is the type - `io::IoError::NotFound` is `io::IoError`, a type
/// keyed with its module (ADR-313 D3). A variant with named fields is a
/// struct literal, `ConfigError::BadSyntax { line }`, and records the type and
/// not the variant too (ADR-023 D1, ADR-280 D9).
pub fn error_type(names: ref winnow_grammar::InternerContext, thrown: ref Expr) -> String? {
    return match thrown {
        Expr::Path(segments, _) => if segments.len() > 1 { all_but_the_last(names, segments) } else { null },
        Expr::Call { func, .. } => error_type(names, func),
        Expr::StructLit { name, .. } => struct_type(names.resolve(name)),
        else => null,
    }
}

/// `io::IoError::NotFound` read as the path of its type.
fn all_but_the_last(names: ref winnow_grammar::InternerContext, segments: ref Vec[winnow_grammar::Symbol]) -> String {
    let mut written: String = ""
    for k in 0..<segments.len() - 1 {
        if k > 0 {
            written = f"{written}::"
        }
        let segment = names.resolve(segments[k])
        written = f"{written}{segment}"
    }
    return written
}

/// `ConfigError::BadSyntax` is `ConfigError`; a struct with no `::` is itself.
fn struct_type(written: ref String) -> String {
    let mut parts: Vec[String] = []
    for part in written.split("::") {
        parts.push(part.clone())
    }
    if parts.len() < 2 {
        return written.clone()
    }
    let mut ty: String = ""
    for k in 0..<parts.len() - 1 {
        if k > 0 {
            ty = f"{ty}::"
        }
        ty = f"{ty}{parts[k]}"
    }
    return ty
}

// ---------------------------------------------------------------------------
// **What a function throws itself, and whom it calls** - the walk, moved from
// the compiler's `contracts::throws` (#125). What a call resolves to is the
// compiler's to say (`contribution_of`): `sync`'s single resolution (ADR-288),
// handed in as an answer per expression, as the holes of a literal are.

/// What one function contributes to its own error set before its callees are
/// taken into account: what it names in a `throw` (`?` where it cannot be
/// named), and the functions of this package it calls.
pub struct Thrown {
    pub direct: collections::BTreeSet[String],
    pub calls: collections::BTreeSet[String],
    /// Whether a `throw error` stood anywhere in what was walked: a handler
    /// that has one passes what it caught on (ADR-280 D10).
    passes_on: bool,
    /// The fatal types the handler of the `catch` being walked names
    /// (ADR-345 D2).
    named: collections::BTreeSet[String],
    pub fatal_calls: collections::BTreeMap[String, collections::BTreeSet[String]],
    /// **Under `raw-sinks = "warn"`, a raw sink's part throws its error**
    /// (ADR-raw-sinks-1 D7): what `raw_sink_thrown` reads.
    raw_sinks_warn: bool,
}

/// What an expression contributes, as the compiler resolved it: a function of
/// this package it calls, or the errors a ledger names for a callee outside
/// it (`?` for a call nobody can name), or neither.
pub struct Contribution {
    pub call: String?,
    /// **The functions of this package handed to a library's `from(p)`**
    /// (ADR-351 D4): called by the library, so what they throw is the call's.
    pub given: Vec[String],
    pub errors: Vec[String],
    /// Those of `errors` that are fatal (ADR-345 D1).
    pub fatal: Vec[String],
    /// The type the callee is declared to return, where the expression is a
    /// call the compiler resolved: what `throw` of it throws.
    pub result: String?,
}

/// What a function's body throws itself, and whom in this package it calls.
fn thrown_by(body: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync) -> Thrown {
    return thrown_by_at(body, names, holes_of, contribution_of, false)
}

/// `thrown_by`, with whether the build is at `raw-sinks = "warn"`.
fn thrown_by_at(body: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, raw_sinks_warn: bool) -> Thrown {
    let mut out = Thrown { direct: collections::BTreeSet(), calls: collections::BTreeSet(), passes_on: false, named: collections::BTreeSet(), fatal_calls: collections::BTreeMap(), raw_sinks_warn: raw_sinks_warn }
    thrown_in_block(body, names, holes_of, contribution_of, false, out)
    return out
}

/// **What a raw sink's call throws under `raw-sinks = "warn"`**
/// (ADR-raw-sinks-1 D7, #2524): an `html::Raw(...)` with a part that is not
/// a literal throws `html::HtmlError`, a `db::raw(...)` with one
/// `db::NotIdentifier`, since the emitter checks such a part where it runs
/// where the prover does not prove it. Read off the call as written, before
/// the prover: a proof takes away the check, not the entry.
fn raw_sink_thrown(func: ref Expr, args: ref Vec[Expr], names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> String? {
    let (error, given) = raw_sink_error(func, args.len(), names) ?? return null
    for k in 0..<given {
        if raw_sink_has_a_part(args[k], holes_of) {
            return error
        }
    }
    return null
}

/// **The raw sink a call goes to** (ADR-raw-sinks-1 D7, #2524): the error
/// its check throws and how many of its `count` arguments are its parts, or
/// `null` for a call to anything else. The checker asks it too (`NK1134`).
pub fn raw_sink_error(func: ref Expr, count: i64, names: ref winnow_grammar::InternerContext) -> (String, i64)? {
    let callee = match func {
        Expr::Path(segments, _) => if segments.len() == 2 { all_but_the_last(names, segments) + "::" + names.resolve(segments[1]) } else { return null },
        else => return null,
    }
    if callee == "html::Raw" {
        return ("html::HtmlError", count)
    }
    if callee == "db::raw" {
        return ("db::NotIdentifier", if count == 0 { 0 } else { 1 })
    }
    return null
}

/// Whether a raw sink's argument has a part that is not a literal: the
/// holes of an `f"..."` and the sides of a `+` are its parts.
fn raw_sink_has_a_part(expr: ref Expr, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    return match expr {
        Expr::LitInterpolated { .. } => holes_of(expr).iter().any(fn(hole) { raw_sink_has_a_part(hole, holes_of) }),
        Expr::Binary { op, lhs, rhs, .. } => if op == BinaryOp::Add { raw_sink_has_a_part(lhs, holes_of) || raw_sink_has_a_part(rhs, holes_of) } else { true },
        Expr::LitStr { .. } => false,
        Expr::LitInt { .. } => false,
        Expr::LitFloat(..) => false,
        Expr::LitChar(..) => false,
        Expr::LitBool(..) => false,
        Expr::LitNull(..) => false,
        else => true,
    }
}

// Each statement's expressions, then the blocks it holds - each with whether
// it is the handler of a `catch`, which is where `throw error` passes on what
// the guarded half threw rather than naming something new.
fn thrown_in_block(block: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, mut out: Thrown) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { value, .. } => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Comptime { value, .. } => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Expr(value) => thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Return(value) => thrown_in(value ?? continue, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::Assign { target, value, .. } => {
                thrown_in(target, names, holes_of, contribution_of, in_a_handler, false, out)
                thrown_in(value, names, holes_of, contribution_of, in_a_handler, false, out)
            }
            Stmt::For { iter, .. } => thrown_in(iter, names, holes_of, contribution_of, in_a_handler, false, out),
            Stmt::While { cond, .. } => thrown_in(cond, names, holes_of, contribution_of, in_a_handler, false, out),
            else => {}
        }
        match stmt.node {
            // **A lambda in a loop's head is walked too** (#2736), as one
            // in a `let`'s value is: `for d in xs.iter().map(fn(x) { f(x) })`
            // fails with what `f` does.
            Stmt::For { iter, body, .. } => {
                thrown_in_blocks(iter, names, holes_of, contribution_of, in_a_handler, out)
                thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out)
            }
            Stmt::While { cond, body, .. } => {
                thrown_in_blocks(cond, names, holes_of, contribution_of, in_a_handler, out)
                thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out)
            }
            Stmt::Let { value, .. } => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Comptime { value, .. } => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Expr(value) => thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Return(value) => thrown_in_blocks(value ?? continue, names, holes_of, contribution_of, in_a_handler, out),
            Stmt::Assign { target, value, .. } => {
                thrown_in_blocks(target, names, holes_of, contribution_of, in_a_handler, out)
                thrown_in_blocks(value, names, holes_of, contribution_of, in_a_handler, out)
            }
            else => {}
        }
    }
}

// Every expression inside one, the holes of a literal included, and not the
// bodies of nested blocks. **What a handler catches and does not pass on is
// not the function's** (Part I 7.1): everything in the guarded half of a
// `catch` whose handler never writes `throw error` is `caught`, and fails into
// the handler and nowhere else.
fn thrown_in(expr: ref Expr, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    a_contribution(expr, names, contribution_of, in_a_handler, caught, out)
    for hole in holes_of(expr) {
        thrown_in(hole, names, holes_of, contribution_of, in_a_handler, caught, out)
    }
    match expr {
        Expr::Call { func, args, config, .. } => {
            if out.raw_sinks_warn && !caught {
                match raw_sink_thrown(func, args, names, holes_of) {
                    error => {
                        out.direct.insert(error)
                    },
                    null => {}
                }
            }
            thrown_in(func, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::MethodCall { receiver, method, args, config, .. } => {
            // **`xs.par_iter(within: d)`** (ADR-async-5 D27): the step that
            // ends the walk throws `task::TimedOut` once `d` ran out.
            if !caught && names.resolve(method) == "par_iter" && config.iter().any(fn(setting) { names.resolve(setting.name) == "within" }) {
                out.direct.insert("task::TimedOut")
            }
            thrown_in(receiver, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            thrown_in(receiver, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arg in args {
                thrown_in(arg, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
            for setting in config {
                thrown_in(setting.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Binary { lhs, rhs, .. } => {
            thrown_in(lhs, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(rhs, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Unary { expr, .. } => thrown_in(expr, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Try(inner, _) => thrown_in(inner, names, holes_of, contribution_of, in_a_handler, caught, out),
        // **A task's crash is an error to whoever waits for it** (Part II
        // 12.7, ADR-328 D8): the function that starts it throws
        // `task::Crashed`, as a `task::scope` in it does, where the task can
        // panic (ADR-async-5 D35); the host's answer for the form says so.
        Expr::Async(inner, _, within, _) => {
            if !caught {
                out.direct.extend(contribution_of(expr).errors.clone())
            }
            thrown_by_a_deadline(within, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(inner, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        // **A deadline that runs out is the failure `task::TimedOut`**
        // (ADR-async-5 D16, #986): it arrives where the task's own do, so a
        // fallback stands in for it.
        Expr::AsyncGroup(_, _, within, _, _) => thrown_by_a_deadline(within, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Spawn { within, .. } => thrown_by_a_deadline(within, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Throw(inner, _) => thrown_in(inner, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Cast { expr, .. } => thrown_in(expr, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Field { base, .. } => thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::SafeField { base, .. } => thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Index { base, index, .. } => {
            thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(index, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Range { start, end, .. } => {
            thrown_in(start, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(end, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::Tuple(parts, _) => {
            for part in parts {
                thrown_in(part, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Coalesce { value, fallback, .. } => {
            thrown_in(value, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(fallback, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::TryCatch { expr, handler, .. } => {
            let into_the_handler = caught || !passes_on(handler, names, holes_of, contribution_of)
            let outer = out.named.clone()
            if !caught {
                out.named = fatal_named(handler, names)
            }
            thrown_in(expr, names, holes_of, contribution_of, in_a_handler, into_the_handler, out)
            out.named = outer
        }
        Expr::If { cond, .. } => thrown_in(cond, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Match { value, arms, .. } => {
            thrown_in(value, names, holes_of, contribution_of, in_a_handler, caught, out)
            for arm in arms {
                maybe_thrown_in(arm.guard, names, holes_of, contribution_of, in_a_handler, caught, out)
                thrown_in(arm.body, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::StructLit { fields, .. } => {
            for field in fields {
                maybe_thrown_in(field.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::ListRepeat { value, count, .. } => {
            thrown_in(value, names, holes_of, contribution_of, in_a_handler, caught, out)
            thrown_in(count, names, holes_of, contribution_of, in_a_handler, caught, out)
        }
        Expr::ListLit { items, .. } => {
            for item in items {
                thrown_in(item, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::With { base, fields, .. } => {
            thrown_in(base, names, holes_of, contribution_of, in_a_handler, caught, out)
            for field in fields {
                maybe_thrown_in(field.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        Expr::Return(value, _) => thrown_in(value ?? return, names, holes_of, contribution_of, in_a_handler, caught, out),
        Expr::Select(arms, _) => {
            for arm in arms {
                thrown_in(arm.value, names, holes_of, contribution_of, in_a_handler, caught, out)
            }
        }
        else => {}
    }
}

fn maybe_thrown_in(expr: ref Expr?, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    thrown_in(expr ?? return, names, holes_of, contribution_of, in_a_handler, caught, out)
}

// Every block an expression holds, the body of a lambda passed as an argument
// included - and a `catch`'s handler, walked as one.
fn thrown_in_blocks(expr: ref Expr, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, mut out: Thrown) {
    match expr {
        Expr::Block(block, _) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::AsyncGroup(block, _, _, _, _) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Unsafe(block, _) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Overlap(block, _) => thrown_in_block(block, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Closure { body, .. } => thrown_in_block(body, names, holes_of, contribution_of, in_a_handler, out),
        // ADR-346 D5: a task's errors reach whoever joins it; the starter is
        // where its handle is joined or handed on.
        Expr::Spawn { body, .. } => thrown_in_blocks(body, names, holes_of, contribution_of, in_a_handler, out),
        Expr::Call { func, args, config, .. } => {
            thrown_in_blocks(func, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::MethodCall { receiver, args, config, .. } => {
            thrown_in_blocks(receiver, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::SafeMethod { receiver, args, config, .. } => {
            thrown_in_blocks(receiver, names, holes_of, contribution_of, in_a_handler, out)
            for arg in args {
                thrown_in_blocks(arg, names, holes_of, contribution_of, in_a_handler, out)
            }
            for setting in config {
                thrown_in_blocks(setting.value, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::If { then_branch, else_branch, .. } => {
            thrown_in_block(then_branch, names, holes_of, contribution_of, in_a_handler, out)
            thrown_in_block(else_branch ?? return, names, holes_of, contribution_of, in_a_handler, out)
        }
        Expr::TryCatch { expr, handler, .. } => {
            thrown_in_blocks(expr, names, holes_of, contribution_of, in_a_handler, out)
            thrown_in_block(handler, names, holes_of, contribution_of, true, out)
        }
        Expr::Match { arms, .. } => {
            for arm in arms {
                thrown_in_blocks(arm.body, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        Expr::Select(arms, _) => {
            for arm in arms {
                thrown_in_block(arm.body, names, holes_of, contribution_of, in_a_handler, out)
            }
        }
        else => {}
    }
}

// What one expression contributes. **`throw error` in a handler passes the
// caught error on** (ADR-280 D10): its types are the guarded expression's,
// which the call there already contributed - read as a value nobody can name
// it added `?`, and the function's sum fell back to the unnamed error. Noted
// wherever it stands, caught or not, for `passes_on`.
fn a_contribution(expr: ref Expr, names: ref winnow_grammar::InternerContext, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    let passing = the_caught_error(expr, names)
    if passing {
        out.passes_on = true
    }
    if in_a_handler && passing {
        return
    }
    if caught {
        // **A fatal error passes a `catch` that does not name it** (ADR-345 D2).
        match expr {
            Expr::Throw(_, _) => {}
            else => {
                let given = contribution_of(expr)
                for error in given.fatal {
                    if !out.named.contains(error) {
                        out.direct.insert(error.clone())
                    }
                }
                let call = given.call ?? ""
                if call.len() > 0 {
                    out.fatal_calls.entry(call).or_insert_with(fn() { out.named.clone() })
                }
            }
        }
        return
    }
    match expr {
        // **A `throw` of a call throws the type the callee returns**: `throw
        // made()` with `fn made() -> Bad` fails with `Bad`, as `throw Bad::No`
        // does. One this compiler cannot name fails; with what is the absence
        // of a claim rather than an answer.
        Expr::Throw(thrown, _) => {
            let written: String = error_type(names, thrown) ?? ""
            if written.len() > 0 {
                out.direct.insert(written)
            } else {
                let given = contribution_of(thrown)
                out.direct.insert(given.result ?? "?")
            }
        }
        else => {
            let given = contribution_of(expr)
            let call = given.call ?? ""
            if call.len() > 0 {
                out.calls.insert(call)
            }
            out.calls.extend(given.given.clone())
            out.direct.extend(given.errors.clone())
        }
    }
}

// `throw error`, the caught error handed on.
fn the_caught_error(expr: ref Expr, names: ref winnow_grammar::InternerContext) -> bool {
    return match expr {
        Expr::Throw(thrown, _) => match thrown {
            Expr::Variable(name, _) => names.resolve(name) == "error",
            else => false,
        },
        else => false,
    }
}

// Whether a handler passes what it caught on: `throw error` anywhere in it
// (ADR-280 D10).
fn passes_on(handler: ref Block, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync) -> bool {
    let mut seen = Thrown { direct: collections::BTreeSet(), calls: collections::BTreeSet(), passes_on: false, named: collections::BTreeSet(), fatal_calls: collections::BTreeMap(), raw_sinks_warn: false }
    thrown_in_block(handler, names, holes_of, contribution_of, false, seen)
    return seen.passes_on
}

/// **Whether a handler passes what it caught on**, read from the tree alone:
/// `throw error` anywhere in it, its nested blocks included (ADR-280 D10). The
/// checker asks it before the guarded half is walked (#725).
fn throws_handler_passes_on(handler: ref Block, names: ref winnow_grammar::InternerContext) -> bool {
    for stmt in handler.stmts {
        for expr in check_visit_stmt(stmt.node) {
            if the_caught_error(expr, names) {
                return true
            }
        }
        for block in check_visit_stmt_blocks(stmt.node) {
            if throws_handler_passes_on(block, names) {
                return true
            }
        }
    }
    return false
}

/// **The fatal types a handler takes** (ADR-345 D2): those whose variant a
/// `match` arm over `error` names, at the handler's top level.
fn fatal_named(handler: ref Block, names: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    for stmt in handler.stmts {
        match stmt.node {
            Stmt::Expr(value) => named_in_match(value, names, out),
            Stmt::Let { value, .. } => named_in_match(value, names, out),
            Stmt::Return(value) => named_in_match(value ?? continue, names, out),
            else => {}
        }
    }
    return out
}

fn named_in_match(expr: ref Expr, names: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[String]) {
    match expr {
        Expr::Match { value, arms, .. } => {
            if !the_error(value, names) {
                return
            }
            for arm in arms {
                let path = pattern_path(arm.pattern) ?? continue
                if path.len() < 2 {
                    continue
                }
                let mut parts: Vec[String] = []
                for at in 0..<path.len() - 1 {
                    parts.push(names.resolve(path[at]).clone())
                }
                out.insert(parts.join("::"))
            }
        }
        else => {}
    }
}

fn the_error(expr: ref Expr, names: ref winnow_grammar::InternerContext) -> bool {
    return match expr {
        Expr::Variable(name, _) => names.resolve(name) == "error",
        else => false,
    }
}

fn pattern_path(pattern: ref MatchPattern) -> Vec[winnow_grammar::Symbol]? {
    match pattern {
        MatchPattern::Path(path) => {
            return path.clone()
        },
        MatchPattern::Tuple { path, .. } => {
            return path.clone()
        },
        MatchPattern::Named { path, .. } => {
            return path.clone()
        },
        else => {},
    }
    return null
}

// `within: d` of an `async(…)` form (ADR-async-5 D16): `d` itself, and the
// `task::TimedOut` its running out ends the task with.
fn thrown_by_a_deadline(within: ref Expr?, names: ref winnow_grammar::InternerContext, holes_of: fn(ref Expr) -> Vec[Expr] sync, contribution_of: fn(ref Expr) -> Contribution sync, in_a_handler: bool, caught: bool, mut out: Thrown) {
    let d = within ?? return
    if !caught {
        out.direct.insert("task::TimedOut")
    }
    thrown_in(d, names, holes_of, contribution_of, in_a_handler, caught, out)
}

/// One node of a test graph: what it throws itself and whom it calls.
fn throws_test_node(mut direct: collections::BTreeMap[String, collections::BTreeSet[String]], mut calls: collections::BTreeMap[String, collections::BTreeSet[String]], name: String, thrown: String?, callee: String?) {
    let mut set: collections::BTreeSet[String] = collections::BTreeSet()
    if thrown != null {
        set.insert(thrown ?? "")
    }
    let mut called: collections::BTreeSet[String] = collections::BTreeSet()
    if callee != null {
        called.insert(callee ?? "")
    }
    direct.insert(name.clone(), set)
    calls.insert(name, called)
}

/// **The per-function entry answers what the whole-package entry answers**
/// (ADR-100 D7, ADR-403 D3): on a call chain into a `throw`, a recursive pair
/// one of whose members throws, a recursive group of three with a fatal error
/// a `catch` lets through, a declared `throws` that names nothing and its
/// caller, and a parameter's place its function calls. The chain's head is
/// derived from its callee's stored set alone.
test "the per-function throws entry gives the whole-package column" {
    let mut direct: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    let mut calls: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    let mut fatal_calls: collections::BTreeMap[String, collections::BTreeMap[String, collections::BTreeSet[String]]] = collections::BTreeMap()
    throws_test_node(direct, calls, "a", null, "b")
    throws_test_node(direct, calls, "b", null, "c")
    throws_test_node(direct, calls, "c", "E", null)
    throws_test_node(direct, calls, "p", "F", "q")
    throws_test_node(direct, calls, "q", null, "p")
    throws_test_node(direct, calls, "s", null, "t")
    throws_test_node(direct, calls, "t", null, "u")
    throws_test_node(direct, calls, "u", "Boom", null)
    let mut kept: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    kept.insert("s", collections::BTreeSet())
    fatal_calls.insert("u", kept)
    throws_test_node(direct, calls, "n", null, null)
    throws_test_node(direct, calls, "m", null, "n")
    throws_test_node(direct, calls, "h", "G", "h::f")
    throws_test_node(direct, calls, "h::f", "from(h::f)", null)
    let mut own = Ledger::blank()
    for name in ["a", "b", "c", "p", "q", "s", "t", "u", "n", "m", "h"] {
        let mut contract = FnContract::empty()
        contract.fails_with = ["?"]
        own.functions.insert(name.clone(), contract)
    }
    let mut fatal: collections::BTreeSet[String] = collections::BTreeSet()
    fatal.insert("Boom")
    let mut places: collections::BTreeSet[String] = collections::BTreeSet()
    places.insert("h::f")
    let whole = error_sets(direct, calls, fatal_calls, fatal, own, places)
    let first = error_sets_callees_first(direct, calls, fatal_calls, fatal, own, places)
    assert(whole == first)
    assert((first["a"]?.clone() ?? []) == ["E"])
    assert((first["q"]?.clone() ?? []) == ["F"])
    assert((first["s"]?.clone() ?? []) == ["Boom"])
    assert((first["m"]?.clone() ?? []) == ["?"])
    assert((first["h"]?.clone() ?? []) == ["G", "from(h::f)"])
    let units = throws_callees_first(direct, calls, fatal_calls)
    let mut groups = 0
    for unit in units {
        if unit.len() > 1 {
            groups = groups + 1
        }
    }
    // `p, q` and `s, t, u` are the recursive groups.
    assert(groups == 2)
    let mut stored: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    let mut thrown: collections::BTreeSet[String] = collections::BTreeSet()
    thrown.insert("E")
    stored.insert("b", thrown)
    let alone: Vec[String] = ["a"]
    let head = throws_of_unit(alone, direct, calls, fatal_calls, fatal, stored, own, places)
    let mut expected: collections::BTreeSet[String] = collections::BTreeSet()
    expected.insert("E")
    assert((head["a"]?.clone() ?? collections::BTreeSet()) == expected)
}
