// crates/nikaia-std/src/compiler/check_facts.nika
//
// **What the checker found out about the program and the emitter reads**
// (ADR-294, #125, #558; the coordinator's design): one struct, `CheckFacts`,
// that the checker fills and the emitter holds as its single `facts` field.
// Each table is keyed by the id of the node it is about (ADR-340 D4), or by a
// statement's start byte where the fact is about the statement (D5), so a key
// is an `i64`. A name is a `String`.

use std::collections

/// How a plain value is put into a nullable slot, a name or a number's slot
/// (Part I 2.3, ADR-278, ADR-285 D32, ADR-319 D2).
pub enum FactWrap {
    /// `Some(value)`: the type is known and is not a `T?`.
    Constructor,
    /// Text where a file's name is asked: an `fs::Path` made from it.
    Path,
    /// ...and a view of one.
    PathView,
    /// ...and wrapped as a `T?` of it: text into `fs::Path?` (#1986).
    PathSome,
    /// ...and a view of one, where the slot lends it (`Option<&Path>`).
    PathViewSome,
    /// An integer widened where no value can be lost: the type the slot states.
    Widen(String),
    /// ...and wrapped as a `T?` of it: `u32` into `i64?`.
    WidenSome(String),
    /// A signed value proved not negative, in the unsigned type the slot states.
    Unsigned(String),
    /// A mapping where a `Bytes` is kept (ADR-373 D3): the mapping at a count.
    MappedBytes,
}

/// How a map's key is handed over.
pub enum FactKeyForm {
    Handed,
    Lent,
    AsIs,
    /// Text of its own looked up in a map keyed by views of text: read as the
    /// `str` it holds, which every key of text borrows as (#659).
    Viewed,
}

/// What a reach is a view of.
pub enum FactViewed {
    Text,
    Plain,
}

/// A cast that narrows.
pub enum FactNarrowing {
    Integer,
    FromFloat,
}

/// What a lambda that pauses is rewritten to: the word, as a function, a lent
/// one or a method.
pub enum FactPausing {
    Function(String),
    Lent(String),
    Method(String),
}

/// **Which text a position belongs to** (ADR-374 D5): the text as
/// `check_core_places_text_key` writes it and the expression that names it, or
/// `chosen` where it is one of two texts picked at run time (`ref(a | b)`).
pub struct CheckPosText {
    pub key: String,
    pub text: Expr,
    pub chosen: bool,
}

/// One `assert` (ADR-269 D2): what its failure says, which only the compiler
/// knows.
pub struct FactClaim {
    pub held: ClaimHeld?,
    pub written: String,
    pub left: String?,
    pub right: String?,
    /// **An `assume`** (ADR-376): a fact from where it stands, never a goal.
    pub assumed: bool,
}

/// **Where a task of `async e` is waited for** (ADR-async-v6 D6), for the
/// lowering onto tasks (#986): before a call or an operation (its node), before
/// a statement of the binding's block (its span's start), or at its group's end.
/// `Handle` is an `async(handle)`'s task (D11): waited for where its handle is
/// joined, and at its group's end where it is left live.
pub enum CheckAsyncWaitAt {
    Before(i64),
    BeforeStatement(i64),
    GroupEnd,
    Handle,
}

/// One task's wait point and its group (D9): an `async { }`'s node, or for the
/// innermost block holding the form `-1 -` its first statement's start.
pub struct CheckAsyncWait {
    pub at: CheckAsyncWaitAt,
    pub group: i64,
}

pub struct CheckFacts {
    /// **A call of a `std` helper** (`pub = false` in `std`'s ledger, #1606),
    /// by the start of the call's span: refused (`NK1110`) in a program, and
    /// let through by `check_access_inside_std` where the file is `std`'s own;
    /// so is a `use` of a module with nothing public (`NK1186`, #2320).
    pub std_helpers_reached: collections::BTreeSet[i64],
    /// **A non-`pub` name of a package reached** (`NK1110`), by the start of
    /// the finding's span, with the package: let through by
    /// `check_access_in_own_tests` where the program is one of that package's
    /// own `tests/` (ADR-403 D1).
    pub privates_reached: collections::BTreeMap[i64, String],
    /// What a task binds and still holds at a pause (ADR-055 D6): seen by the tests.
    pub held_across_a_pause: collections::BTreeSet[(i64, String)],
    pub comptime_values: collections::BTreeMap[i64, (String, String)],
    /// A `comptime` that reads the turn's field (#1087), once per turn: by
    /// `"<start>:<type>:<field>"`, as `comptime_values` has it.
    pub turn_comptime_values: collections::BTreeMap[String, (String, String)],
    pub dsl_values: collections::BTreeMap[i64, (String, String)],
    pub with_types: collections::BTreeMap[i64, String],
    pub unrolled: collections::BTreeMap[(String, String), Vec[FieldContract]],
    pub walks_fields: collections::BTreeMap[String, String],
    pub unrolled_calls: collections::BTreeMap[i64, String],
    /// **The copies of a function that takes a reflected field** (Part II
    /// 10.3, ADR-grammar-typed-read-v2 D4): keyed by the function and the struct whose
    /// fields it is called with, one copy per field.
    pub field_copies: collections::BTreeMap[(String, String), Vec[FieldContract]],
    /// **The kind of each type a copy is made for, or a path names**
    /// (ADR-330 D3): `Vec[i64]` is `List`, keyed by the type as written.
    pub type_kinds: collections::BTreeMap[String, String],
    /// **The types each type is made of**, as written (ADR-330 D3, D4):
    /// `Vec[i64]` is `[i64]`, a struct its own name; what an arm of a `match`
    /// on a kind binds.
    pub type_parts: collections::BTreeMap[String, Vec[String]],
    /// The fields of each struct among them, for `field.ty::fields` and
    /// `s::fields` in a `Struct(s)` arm (ADR-330 D4, D5).
    pub type_fields: collections::BTreeMap[String, Vec[FieldContract]],
    /// **The subjects of a `match` on a kind** (ADR-330 D4): each copy
    /// emits the one arm its type takes.
    pub kind_matches: collections::BTreeSet[i64],
    /// **`T()` in a `Map` or `List` arm of a `match` on a kind**
    /// (ADR-grammar-typed-read-v2 D14), by the callee's id: each copy writes the
    /// empty collection of its own type.
    pub kind_constructors: collections::BTreeSet[i64],
    /// The functions that make such a `T()`, each with its parameter: a copy
    /// for a type with parts asks the language below for its empty value.
    pub constructs_by_kind: collections::BTreeSet[(String, String)],
    /// The comparisons of two kinds, decided per copy (ADR-330 D6).
    pub kind_compares: collections::BTreeSet[i64],
    /// The paths that are `T::name` (ADR-330 D2).
    pub reflected_names: collections::BTreeSet[i64],
    /// **The paths and members that are a documentation** (ADR-329 D2,
    /// ADR-330 D2): `T::doc`, `field.doc` and `field.ty::doc`, each text
    /// known while building.
    pub reflected_docs: collections::BTreeSet[i64],
    /// **The paths and members that are an access as a value** (ADR-330
    /// D8): `T::access` and `field.ty::access` outside a comparison of two
    /// accesses, a `meta::Access` case decided per copy.
    pub reflected_accesses: collections::BTreeSet[i64],
    /// **The `///` lines of each type the package declares**, keyed by its
    /// name, and of each of its fields, keyed `Type.field` (ADR-329 D2).
    /// A type without them, or without source here, has none.
    pub docs: collections::BTreeMap[String, String],
    pub fallible_loops: collections::BTreeSet[i64],
    pub pausing_walks: collections::BTreeSet[i64],
    pub pausing_loops: collections::BTreeSet[i64],
    pub owned_loops: collections::BTreeSet[i64],
    /// **The `for`s over a `@stream` call, whose one binding is lent from the
    /// input** (ADR-grammar-typed-read-v2 D7, #2708), by the `for`'s start:
    /// the emitter binds the item by reference, never a copy of it.
    pub lent_stream_loops: collections::BTreeSet[i64],
    /// **A `let` bound to a `@stream` call that one `for` walks** (#2708):
    /// the binding's id to the `let`'s start (`check_core_stmt_a_stream_let`),
    /// and the `for`'s start to the `let`'s it walks. The emitter writes the
    /// call where that `for` stands, as a `for` over the call itself.
    pub stream_lets: collections::BTreeMap[i64, i64],
    pub stream_let_loops: collections::BTreeMap[i64, i64],
    pub walked_stream_lets: collections::BTreeSet[i64],
    pub copied_loop_bindings: collections::BTreeSet[(i64, String)],
    pub copied_view_bindings: collections::BTreeSet[(i64, String)],
    pub unsigned_literals: collections::BTreeMap[i64, String],
    pub number_lets: collections::BTreeMap[i64, String],
    pub changed_elements: collections::BTreeSet[i64],
    pub text_finds: collections::BTreeSet[i64],
    /// **The receivers of a text `replace` or `replacen`**, by node.
    pub text_replaces: collections::BTreeSet[i64],
    /// **A text `replace` whose receiver is a `replace` itself**, by that
    /// receiver's node (ADR-text-reuse-1 D4): the emitter replaces in the
    /// temporary's buffer.
    pub replaced_in_place: collections::BTreeSet[i64],
    /// **`x = x.replace(a, b)` on an owned text name**, by the assignment's
    /// start (ADR-text-reuse-1 D4): replaced in `x`'s own buffer.
    pub replaced_assigns: collections::BTreeSet[i64],
    /// **A text `replace` at the last use of a `let`'s text**, by the
    /// receiver's node (ADR-text-reuse-1 D4): the text is handed to it and
    /// replaced in its own buffer.
    pub replaced_last_uses: collections::BTreeSet[i64],
    /// **Each give and each reuse, narrated** (ADR-text-reuse-1 D5, #2514):
    /// the first byte of the site and its line, `rest takes the buffer of
    /// line` or `replace works in the buffer of x`, which `--tethers` prints
    /// and the language server shows as an inlay hint.
    pub narrated: collections::BTreeSet[(i64, String)],
    /// **`into.add(part)` of an `impl Hash`**, by the receiver's node
    /// (ADR-010 D12): the emitter writes the part's own hash.
    pub hasher_adds: collections::BTreeSet[i64],
    /// **A method of text whose result is a view of the text it is called
    /// on** (`s.trim()`, `s.split(",")`, ADR-views-v4 D9, #1478), by the
    /// call's node: the view-change walk watches the receiver while the
    /// result is used.
    pub receiver_views: collections::BTreeSet[i64],
    /// **A `Bytes` cut by a set** (ADR-375 D3), by the receiver: written
    /// `nikaia_std::bytes::split(&b, set)`, since a slice's own `split` takes
    /// a closure and is the one the language below would pick.
    pub bytes_splits: collections::BTreeSet[i64],
    /// **A text pattern of one scalar is that character** (#617), by the
    /// argument: `split(";")` on text is written `split(';')`, the character
    /// literal kept here as Rust spells it. A `&str` pattern is Rust's two-way
    /// searcher, built for every call; a `char` is a `memchr`.
    pub char_patterns: collections::BTreeMap[i64, String],
    /// **`a.compare(b)` and `a.eq(b)` on a type the language orders or equates**
    /// (ADR-341 D2), by the receiver: which side is a view (bit 0 the receiver,
    /// bit 1 the argument), so the emitter writes `std::cmp::Ord::cmp(&*a, &b)`.
    pub standard_compares: collections::BTreeMap[i64, i64],
    pub count_args: collections::BTreeSet[i64],
    pub path_methods: collections::BTreeMap[i64, bool],
    pub map_keys: collections::BTreeMap[(i64, bool), FactKeyForm],
    pub slice_indices: collections::BTreeSet[i64],
    pub list_indices: collections::BTreeSet[i64],
    /// **The base of each index that reads a map's key** (ADR-396 D4,
    /// #2371), by its node: such an index has no bound, so outside data in
    /// its key is no `NK1302`, whatever the base is written as.
    pub map_indices: collections::BTreeSet[i64],
    /// **A function value read by index is a copy** (Part I, *A function type stands wherever a type does*, #1018):
    /// the bases of the reads whose element is a `fn`, so the lowering clones
    /// the `Kept` handle the list holds instead of moving it out.
    pub kept_fn_reads: collections::BTreeSet[i64],
    /// **A function value copied from a place is a copy too** (Part I, #1031):
    /// a name or a field read whose type is a `fn` that holds a `Kept` (not
    /// a parameter that only runs it, not a named function), keyed by the
    /// read; where it stands as a value the lowering clones the handle.
    /// A callee and an assignment target are taken out again.
    pub kept_fn_copies: collections::BTreeSet[i64],
    /// `P { f }` over such a name, by the struct literal and the field.
    pub kept_fn_fields: collections::BTreeSet[(i64, String)],
    /// **A handle on a shared value stored by value is duplicated** (ADR-312
    /// D1, #1411): a name or a field path of `Shared`/`SharedMut` type put
    /// into a struct literal's field or a list literal, by the value's id;
    /// the lowering clones the handle, as a call's argument does.
    pub stored_handles: collections::BTreeSet[i64],
    /// `P { a }` over such a name, by the struct literal and the field.
    pub stored_handle_fields: collections::BTreeSet[(i64, String)],
    /// **A handle handed on at its last use is moved, not duplicated**
    /// (ADR-312 D2, #1502): a call's argument naming one that nothing reads
    /// afterwards, by the argument's id. Taken out of `stored_handles`,
    /// `stored_handle_fields` and `task_handles` likewise.
    pub moved_handles: collections::BTreeSet[i64],
    pub copied_tuple_parts: collections::BTreeSet[(i64, String)],
    pub std_lengths: collections::BTreeSet[i64],
    pub sized_lengths: collections::BTreeSet[i64],
    /// **The field reads of a whole-number type**, by node (ADR-306 D17):
    /// the bounds walk reads a path of fields to one as a number. And the
    /// calls of that type a `let` binds (#781).
    pub whole_fields: collections::BTreeSet[i64],
    /// **Of `whole_fields`, the field and element reads, with their type**
    /// (ADR-306 D34): a term's type is its range.
    pub whole_types: collections::BTreeMap[i64, String],
    /// **The `for` heads that bind one whole number**, by the node of what
    /// they walk (ADR-306 D7), with its type: the bounds walk reads the
    /// binding as a number in its type's range (D34).
    pub whole_loops: collections::BTreeMap[i64, String],
    /// **The `for` heads that bind several names**, by the node of what they
    /// walk, with the positions of the names bound to a whole number
    /// (ADR-306 D7): `for (at, unit) in rows` reads each as a number.
    pub whole_parts: collections::BTreeMap[i64, collections::BTreeSet[i64]],
    /// **Each `let` of one name without a written type whose value is a whole
    /// number**, by the statement's start, with the type (#1358): the prover
    /// reads the name as a whole number, as it reads `let n: i64`. A list, a
    /// text or a map is kept too, by its type's name (ADR-396 D4), and so is
    /// the type of a call's result, whose fields the prover then reads, and
    /// an element with a length a `for` binds, by the `for`'s start.
    pub whole_lets: collections::BTreeMap[i64, String],
    /// **Each divisor `NK1118` refused**, by its node (#1566): a zero the
    /// checker folds is its refusal, and the prover asks no `d != 0` of it.
    pub zero_divisors: collections::BTreeSet[i64],
    /// **Each statement `NK1116` refused a folded number at**, by its start:
    /// the prover refuses no overflow there again (ADR-306 D15).
    pub unfit_numbers: collections::BTreeSet[i64],
    /// **The `N` of each `Array[T, N]` read or counted**, by node (#711).
    pub array_lengths: collections::BTreeMap[i64, i64],
    pub char_codes: collections::BTreeSet[i64],
    pub arithmetic: collections::BTreeMap[i64, String],
    pub negations: collections::BTreeMap[i64, String],
    /// **Every `x << k` and `x >> k` whose count is not a literal**, by the
    /// byte its operator starts at, with `x`'s whole-number type: its count is
    /// a goal of the bounds walk (ADR-306 D18).
    pub shifts: collections::BTreeMap[i64, String],
    /// **Every `/` and `%` on one whole-number type**, by the byte its
    /// operator starts at (the statement's first byte for `x /= d`), with
    /// that type: `d != 0`, and on a signed type not the least value by
    /// `-1`, is a goal of the bounds walk, which `--bounds` lists (ADR-396
    /// D7, #1578). The check stays in the machine code (ADR-395 D3).
    pub divisions: collections::BTreeMap[i64, String],
    /// **A method call on a type `std`'s ledger describes**, by the call's
    /// node, with that type's name as the ledger keys it (`Bytes`, `u64`):
    /// the bounds walk reads the entry's `ensures` and `ensures_each`
    /// (ADR-314 D3, ADR-375 D5).
    pub std_receivers: collections::BTreeMap[i64, String],
    /// **A call of `std`'s `Wide[T]`** (Part I 2.2, #2619), by the node the
    /// emitter reads (the method call, or the callee of `Wide::of` and the
    /// two other makers): the operation and `T`, as `"add i64"`. The
    /// emitter writes the native type of twice `T`'s width from it.
    pub wide_calls: collections::BTreeMap[i64, String],
    /// **The method a call resolves to by its receiver's type** (#842), by the
    /// receiver's node, as the ledger keys it (`Holder::put`).
    pub method_callees: collections::BTreeMap[i64, String],
    /// **The struct a field is read from** (#1573), by the node of the
    /// field's base: the prover carries outside data through `Type.field`.
    pub field_owners: collections::BTreeMap[i64, String],
    /// **What carries outside data in the package** (ADR-396 D1, #1573):
    /// read off the walk's facts in the ledger's pass too, which runs no
    /// prover, so a dependency's ledger names its sources.
    pub outside: ProverOutside,
    /// **A vector's load, read as the cut it reads** (ADR-377 D3), by the
    /// node of the called path: the bytes it reads, or minus the most a
    /// `Lanes` reads on any CPU level where its count is the build's.
    pub simd_loads: collections::BTreeMap[i64, i64],
    pub copied_slots: collections::BTreeSet[i64],
    pub owned_copies: collections::BTreeSet[i64],
    /// **A door over values that copy** (ADR-327 D11): an `update` by its
    /// receiver's id, an `update_all` by its first lock's, where every value
    /// is a number, a `bool` or a `char`. The emitter writes `update_copied` /
    /// `update_all_copied`, whose block works on copies, so a panic in it
    /// poisons nothing.
    pub copied_doors: collections::BTreeSet[i64],
    /// **A door's view handed back out of its block is the value** (#1454),
    /// by the read's id: an `access` or `access_all` block that ends in its
    /// parameter, over a number, a `bool`, a `char` (or a tuple of them) or
    /// an open number. The block sees a reference into the lock, so the
    /// emitter writes `*v`, the copy.
    pub door_copies: collections::BTreeSet[i64],
    /// The copies among them that copy text, by the receiver's id: reached
    /// through `?.`, the receiver is a reference to the text, which may itself
    /// be a view (ADR-282 D29), and only `to_string` copies both.
    pub text_copies: collections::BTreeSet[i64],
    /// **A copy of a tuple with view parts is owned** (ADR-293 D24, #1184),
    /// by the receiver's id: each part's copy, `to_string` for text,
    /// `to_owned` for another view and `clone` for an owned part.
    pub tuple_copies: collections::BTreeMap[i64, Vec[String]],
    /// Reads of a field declared `String` that holds static text (ADR-282
    /// D29), by the read's id: typed as the view it is below, said as the
    /// `String` the program wrote.
    pub static_field_reads: collections::BTreeSet[i64],
    pub text_as_is: collections::BTreeSet[i64],
    pub lent_coalesces: collections::BTreeMap[i64, String],
    pub plain_reaches: collections::BTreeSet[i64],
    pub copied_jump_reads: collections::BTreeSet[i64],
    /// `let mut x = m[k] ?? <jump>` over a `mut` place, by the `??`'s id: `x`
    /// is a mutable view of the entry (#816), lowered to `index::get_mut`;
    /// the text is what lends the place: `&mut ` for a local or a field, and
    /// nothing for a `mut` parameter, which already is the `&mut`.
    pub mut_view_reads: collections::BTreeMap[i64, String],
    /// The same view written `let mut x = m.get(k) ?? <jump>` (#952, ADR-293
    /// D1: the bracket says what `get` says), by the receiver's id: the call
    /// is lowered to `get_mut`.
    pub mut_view_gets: collections::BTreeSet[i64],
    pub view_coalesces: collections::BTreeSet[i64],
    /// The `??`s whose fallback is a name of the word the left side holds, a
    /// number, `bool`, `char` or `scalar` (#1841): the fallback is written as
    /// it is, never `.into()`, which left `Or`'s type open beside an
    /// `Option<&f64>`; and so is any fallback of the struct that copies the
    /// left side holds (#1302), `m.get(k) ?? zero()`.
    pub word_fallbacks: collections::BTreeSet[i64],
    /// The `??`s whose left side holds a view of text and whose fallback is
    /// a name that is a view of text (#719): the fallback is read as `str`.
    pub text_view_fallbacks: collections::BTreeSet[i64],
    /// The `??`s whose left side holds text, `String` or `&String` below,
    /// and whose fallback is a name that is a view of text (#752): both sides
    /// are made the `String` the answer is.
    pub text_owned_fallbacks: collections::BTreeSet[i64],
    pub lent_map_fallbacks: collections::BTreeSet[i64],
    /// **The `??`s whose left side holds a view and whose fallback is a value
    /// made here** (#1256): the answer is a view, and the fallback goes into a
    /// slot declared before the statement, filled only on `null`; `true`
    /// where the answer is a view of text.
    pub slot_fallbacks: collections::BTreeMap[i64, bool],
    pub optional_fallbacks: collections::BTreeSet[i64],
    pub flat_reads: collections::BTreeSet[i64],
    /// **Where each `async e` task is waited for**, by the `async` node
    /// (ADR-async-v6 D6, D9): what the lowering joins it at.
    pub async_waits: collections::BTreeMap[i64, CheckAsyncWait],
    /// **What each handle's task can fail with where it runs**, by its
    /// function and its `async` node (ADR-async-v6 D40): the task's set, or
    /// its fallback's where it has one. The function's group carries it to
    /// the join, where the function's own set may not.
    pub task_sets: collections::BTreeMap[String, collections::BTreeMap[i64, collections::BTreeSet[String]]],
    /// **The `async e` bindings only other tasks name, two or more of them**
    /// (ADR-async-v6 D8, a diamond, #986), by the `async` node: they read the
    /// one value, so the lowering keeps it for all (`task::Read`). One that
    /// moves it leaves the other's mention refused (`NK2105`).
    pub async_shared: collections::BTreeSet[i64],
    /// **The later readers of such a binding, whose own binding is read**
    /// (ADR-async-v6 D41), by their `async` node, each with the shared task's
    /// `async` node: where that task fails, the first reader receives it and
    /// these are cancelled where they wait, so a read of one throws
    /// `task::Abandoned` (`names::diamond_waiters`).
    pub async_abandoned: collections::BTreeMap[i64, i64],
    /// **`m.get(k)` on a map**, by the call: an `Option<&T>` below already,
    /// so a nullable view it is lent to opens nothing.
    pub map_gets: collections::BTreeSet[i64],
    pub copied_reads: collections::BTreeSet[i64],
    pub text_in_lists: collections::BTreeSet[i64],
    pub owned_patterns: collections::BTreeSet[i64],
    /// **A view of text handed to a pattern of `str`** (#490), by the
    /// argument: on the block types it may be a `&Text`, which Rust's
    /// `Pattern` does not take, so it is lent as the `str` it holds.
    pub view_patterns: collections::BTreeSet[i64],
    /// **The lists of views a statement is the last use of** (#490), by the
    /// statement's start: the emitter drops each right after it, since a
    /// block's `List` holds what it views to its scope's end
    /// (`check_core_view_lists_end`).
    pub view_list_drops: collections::BTreeMap[i64, Vec[String]],
    /// **The assignments whose value collects views of the place they
    /// assign over** (#490), by the statement's start: the emitter binds the
    /// value first, so the temporary list ends before the assignment
    /// (`check_core_view_list_assigned`).
    pub view_list_assigns: collections::BTreeSet[i64],
    /// **The list literals placed in the running task's block** (ADR-327
    /// D9, step 5 of #490), by the literal's node, and the texts by the
    /// `String` of their `String()`: the emitter writes `Place::Block`
    /// there, `Place::Outside` everywhere else
