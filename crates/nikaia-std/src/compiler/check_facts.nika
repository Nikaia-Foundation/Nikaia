    pub view_derefs: collections::BTreeSet[i64],
    pub copied_args: collections::BTreeSet[i64],
    /// **A name that is a view of a value that copies, where the value is
    /// wanted** (ADR-387 D1): a `let`, a `return`, a field, a described
    /// method's argument. Written `*name` below.
    pub copied_views: collections::BTreeSet[i64],
    pub settle_fns: collections::BTreeMap[String, bool],
    /// **The type parameters a std operation weighs, by function** (ADR-327
    /// D9, #1559): a `T` handed to a channel's `send` or a shared value's
    /// `set`, whose Rust is bounded by `DeepSize`. The emitter writes the
    /// bound; no Nikaia bound says it.
    pub weighed: collections::BTreeMap[String, collections::BTreeSet[String]],
    /// **A generic call that hands its own type parameter on**, by caller:
    /// the callee, the callee's parameter, and the caller's parameter in the
    /// type it is bound to. Where the callee weighs it, the caller does.
    pub weighed_through: collections::BTreeMap[String, collections::BTreeSet[(String, String, String)]],
    pub settle_lets: collections::BTreeMap[i64, bool],
    pub lent_lets: collections::BTreeSet[i64],
    pub lent_returns: collections::BTreeSet[i64],
    pub compares: collections::BTreeSet[String],
    pub compares_totally: collections::BTreeSet[String],
    /// The declared types whose `Hash` is derived from their fields (ADR-010 D11).
    pub hashes: collections::BTreeSet[String],
    pub copies: collections::BTreeSet[String],
    /// The declared types that do not copy, so derive no `Clone` (#2238).
    pub uncloned: collections::BTreeSet[String],
    pub viewed_numbers: collections::BTreeSet[(i64, String)],
    pub array_literals: collections::BTreeSet[i64],
    pub byte_literals: collections::BTreeSet[i64],
    pub owned_texts: collections::BTreeSet[i64],
    /// A text literal handed to a type variable the callee lends
    /// (ADR-views-v4 D2, #1342): the view it is, with the one `&` the
    /// parameter takes, `&"b"`.
    pub lent_literals: collections::BTreeSet[i64],
    /// A `catch` whose guarded value is a view of text and whose handler's is
    /// text of its own: the guarded value is made owned.
    pub owned_catches: collections::BTreeSet[i64],
    /// A `catch` whose handler hands back `null` over a guarded `T` that is
    /// not `T?`: the guarded value is `Some` (#884).
    pub nullable_catches: collections::BTreeSet[i64],
    /// A `catch` whose value is not used (#885): the guarded value and the
    /// handler's are both dropped.
    pub dropped_catches: collections::BTreeSet[i64],
    /// `s.bytes` on text: the text's own bytes, borrowed (ADR-320 D11).
    pub text_bytes: collections::BTreeSet[i64],
    /// **A cut a `let mut` changes, given its source's text**
    /// (ADR-text-reuse-1 D2, #1589): `let mut rest = line[m..]` with `rest`
    /// grown takes `line`'s buffer where `line` owns one, and copies a view.
    pub given_cuts: collections::BTreeSet[i64],
    /// The given cuts whose source hands its own buffer over (not a view's
    /// copy, not a refused loan): a view of the source still read after one
    /// is refused (`NK2305`, ADR-text-reuse-1 D2, #2243).
    pub cut_gives: collections::BTreeSet[i64],
    /// The bindings (`CheckLocal::id`) a `let mut` of a giving cut made: the
    /// text in them sits in the whole source's buffer (ADR-text-reuse-1 D2).
    pub given_names: collections::BTreeSet[i64],
    /// **The uses of a given name where its text leaves** (returned, pushed,
    /// stored in a place, the body's last value): the emitter shrinks the
    /// buffer there when the text fills less than half of it
    /// (`index::shrunk`, ADR-text-reuse-1 D2, #1589). A local is not shrunk.
    pub shrunk_leaves: collections::BTreeSet[i64],
    /// **A cut of a local that dies where it is pushed into a parameter's
    /// list, given the local's buffer** (ADR-text-reuse-1 D2, #2291): the
    /// tier pass took it as text of its own (`given_pushes`), so the element
    /// owns it, shrunk as it leaves, and nothing tethers the local.
    pub pushed_cuts: collections::BTreeSet[i64],
    /// `s.scalars` on text: its scalars, walked (ADR-320 D3).
    pub text_scalars: collections::BTreeSet[i64],
    /// `s.graphemes` on text: its graphemes by UAX #29, walked (ADR-320 D9).
    pub text_graphemes: collections::BTreeSet[i64],
    /// `b[a..<c]` on a `Bytes`: a cut, a `&[u8]` into `b` below (ADR-320
    /// D7): kept, it is a `Bytes` cut from the same owner at a count
    /// (`counted_cuts`); read as a map's key, it goes in as it is (#1345).
    pub bytes_cuts: collections::BTreeSet[i64],
    /// **A cut of a `Bytes` kept is the same owner at a count** (ADR-373 D1,
    /// D3, #2190): `b.cut(a..c)`, not a copy, so a mapping stays mapped while
    /// the cut lives. A cut of a text's bytes is not here: those are copied
    /// (ADR-320 D11). Read only beside `kept_text_bytes`, which a slot that
    /// takes a view takes the node out of.
    pub counted_cuts: collections::BTreeSet[i64],
    /// `s.bytes`, or a name a `let` bound to it, where the program keeps it
    /// beyond the text: copied into a `Bytes` of its own (ADR-320 D11).
    pub kept_text_bytes: collections::BTreeSet[i64],
    /// The `let`s, by start, that declare `Bytes` and are bound to a text's
    /// own bytes: the view, written without the annotation (ADR-320 D11,
    /// ADR-views-v4 D15, #1271).
    pub text_bytes_typed_lets: collections::BTreeSet[i64],
    /// The receivers of a `Bytes`'s `clone()`: a `Bytes` or a `&[u8]` below,
    /// copied into a `Bytes` of its own (ADR-320 D11).
    pub byte_copies: collections::BTreeSet[i64],
    /// The receivers of a map's `drain()`: where the map stays the caller's,
    /// it is emptied by Rust's `drain()`, which takes no range (#707).
    pub map_drains: collections::BTreeSet[i64],
    pub take_drains: collections::BTreeSet[i64],
    /// The receivers of a `Par`'s `fold(init, step, merge)` (ADR-372 D2):
    /// `fold_merged` below, which a list's `iter()` at `no` has as well as a
    /// walk on every core, beside the language below's own two-argument `fold`.
    pub par_folds: collections::BTreeSet[i64],
    /// **The steps that end a walk with `within:`** (ADR-async-v6 D27), by
    /// their receiver's node: the lowering writes `par::ended(…)` around
    /// each, which throws `task::TimedOut`.
    pub timed_ends: collections::BTreeSet[i64],
    /// **The `for` loops over a walk with `within:`**, by the loop's start:
    /// the lowering lists the walk first, through `par::listed`.
    pub timed_loops: collections::BTreeSet[i64],
    /// **A fold's step or merge that changes its accumulator in place**
    /// (ADR-372 D9), by the argument: `1` takes the second argument by value,
    /// `2` lent. The lowering wraps it in `|mut a, x| { f(&mut a, x); a }`.
    pub in_place_folds: collections::BTreeMap[i64, i64],
    /// **A grammar fold's `init` written as a name that holds a value**
    /// (#2423), by the `init`: a binding beside the fold, `m`, is the
    /// accumulator's first value, not a function or a type to call. The
    /// lowering hands it over as `|| (m).clone()`, as it does a literal.
    pub fold_value_inits: collections::BTreeSet[i64],
    /// The receivers of a `drain()` that stay the caller's - rooted in a `mut`
    /// parameter or in `self` under `ref mut self` - which it empties (#707).
    pub kept_drains: collections::BTreeSet[i64],
    /// `P { b }` over a name bound to `s.bytes`, by the struct literal and the
    /// field: the name copied into a `Bytes` of its own (ADR-320 D11).
    pub kept_byte_fields: collections::BTreeSet[(i64, String)],
    pub lent_list_reads: collections::BTreeSet[i64],
    /// **An arm that reads an element or a field off a place, lent** (#613).
    pub lent_reads: collections::BTreeSet[i64],
    /// **A `T?` place handed back into a `ref T?` result** (#1486): written
    /// `.as_ref()`, the option of a view, not `&` before it.
    pub lent_option_results: collections::BTreeSet[i64],
    /// **A `String?` handed back into a `ref String?` result** (#1666): the
    /// option of a view of a map's text, written as the option of a text view.
    pub text_option_results: collections::BTreeSet[i64],
    pub view_fallbacks: collections::BTreeSet[i64],
    /// **A map read that jumps where it finds nothing** (`m[k] ?? return`),
    /// by the `??`: of a value that moves, the answer is a view of the map
    /// (ADR-293 D28), which `view_changes` watches (#739).
    pub map_read_views: collections::BTreeSet[i64],
    /// **The keep plans the check made against `std` alone** (#727): the
    /// emitter's own, where it reads this check's facts.
    pub keep_plans: Vec[BufferPlan]?,
    /// **What each name a use names** (#1396), by the use's node: what
    /// `nikaia lsp` answers "go to definition" from (`check_declared.nika`).
    /// Nothing in a build reads it.
    pub declared: collections::BTreeMap[i64, CheckDeclared],
    /// **Where each local was bound** (#1396), by its binding's id
    /// (`CheckLocal::id`): its `let`, `for`, `match` or parameter.
    pub bound_at: collections::BTreeMap[i64, (Span, String)],
    /// **Where a use stands whose node the grammar gave no span** (#1396):
    /// a callee, from its call's start, as wide as the name written.
    pub declared_at: collections::BTreeMap[i64, Span],
}

