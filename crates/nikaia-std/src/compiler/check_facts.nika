    /// **The type parameters of `key` that are weighed** (ADR-327 D9,
    /// #1559): those a std operation in its body weighs, and those it hands
    /// to a generic callee that weighs them, to a fixed point.
    fn weighed_of(ref self, key: ref String) -> collections::BTreeSet[String] {
        let mut all: collections::BTreeMap[String, collections::BTreeSet[String]] = self.weighed.clone()
        let mut changed = true
        while changed {
            changed = false
            for (caller, edges) in self.weighed_through {
                for edge in edges {
                    let (callee, param, own) = edge.clone()
                    let reached = all.get(callee)?.contains(param) ?? false
                    if !reached {
                        continue
                    }
                    let mut held: collections::BTreeSet[String] = all.get(caller)?.clone() ?? collections::BTreeSet()
                    if !held.contains(own) {
                        held.insert(own)
                        all.insert(caller.clone(), held)
                        changed = true
                    }
                }
            }
        }
        return all.get(key)?.clone() ?? collections::BTreeSet()
    }
}

/// How the compiler holds one `assert`, as `--asserts` says it (ADR-269 D7).
fn check_claim_held(held: ref ClaimHeld?) -> String {
    let given = held ?? return "refused: a claim about data from outside the program"
    return match given {
        ClaimHeld::Proved => "proved",
        ClaimHeld::ProvedThrough(how) => how.clone(),
        ClaimHeld::Precondition(f, n) => {
            // **`main`'s caller is the command line** (ADR-cli-v1 D4).
            if f == "main" {
                "precondition of `main`, checked where the words arrive"
            } else if n == 0 {
                f"precondition of `{f}`: proved at every call the compiler sees; any other reaches the entry that checks it"
            } else if n == 1 {
                f"precondition of `{f}`: one call checks it when it runs; any other call proves it or reaches the entry that checks it"
            } else {
                f"precondition of `{f}`: {n} calls check it when they run; any other call proves it or reaches the entry that checks it"
            }
        }
        ClaimHeld::AtRunTime(why) => f"checked at run time: {why}",
        ClaimHeld::ByTheTest => "checked when the test runs",
        ClaimHeld::Refused => "refused: a claim about data from outside the program",
    }
}

/// How a claim the build refuses as not proved (`NK1300`, ADR-380 D1) is
/// listed; nothing where it is not refused so.
fn check_claim_refused(held: ref ClaimHeld?) -> String? {
    let given = held ?? return null
    match given {
        ClaimHeld::AtRunTime(why) => return f"refused, not proved: {why}",
        ClaimHeld::Precondition(f, n) => {
            if f == "main" || n == 0 {
                return null
            }
            if n == 1 {
                return f"refused, precondition of `{f}`: one call does not prove it"
            }
            return f"refused, precondition of `{f}`: {n} calls do not prove it"
        },
        else => return null,
    }
}

/// **`--asserts`** (ADR-269 D7): every `assert` of one file, by line, how
/// the compiler holds it, and how many of each. What is not proved comes
/// first, in red - refused, checked at run time, checked by a test -, then
/// what is checked where outside data arrives (`main`'s preconditions), in
/// light blue, and what the build proved last, in green: proved claims, and
/// preconditions proved at every call. Within a group the claims are in the
/// order of their lines; `colour` asks for the colours. `published` gives
/// `main`'s preconditions carried back from a callee (ADR-269 D15, ADR-cli-v1
/// D3), which no `assert` of `main` states: each is a row of its own.
/// `derived` gives the preconditions the build derived from a private
/// function's callers (ADR-391 D4), as `bounds_report_derived` writes them:
/// each a row marked `derived`, in green after the rest, counted apart from
/// the asserts.
///
/// **A type's rules come last** (ADR-369 D5): each written rule with each
/// point it is checked at, what the point is and how it is held (its
/// claims counted with the rest, listed only under the rule), then each rule
/// the walk looked for where none is written, from `rules` (`rules_report`):
/// found, with what found it, or not found, with what broke it.
pub fn check_claims_report(claims: ref collections::BTreeMap[(i64, i64), FactClaim], source: ref String, path: ref String, published: ref collections::BTreeMap[String, Published], derived: ref Vec[String], rules: ref Vec[String], colour: bool, refuses: bool) -> String {
    // Each written rule by its message, in the order first met, with its
    // points painted as their group is.
    let mut written: Vec[String] = []
    let mut points: Vec[Vec[(String, String)]] = []
    let mut ruled: collections::BTreeSet[String] = collections::BTreeSet()
    let mut refused: Vec[String] = []
    let mut at_run_time: Vec[String] = []
    let mut arrives: Vec[String] = []
    let mut by_the_test: Vec[String] = []
    let mut proved: Vec[String] = []
    let mut through_loops = 0
    let mut preconditions: Vec[String] = []
    let mut assumed: Vec[String] = []
    let mut mains: collections::BTreeSet[String] = collections::BTreeSet()
    let mut line = 1
    let mut at = 0
    for (key, claim) in claims {
        let mut start = key.0
        if start > source.bytes.len() {
            start = source.bytes.len()
        }
        if start > at {
            for c in source.bytes[at..<start] {
                if c == '\n' {
                    line = line + 1
                }
            }
            at = start
        }
        // **Every `assume` is listed** (ADR-376 D3): vouched for, not proved.
        if claim.assumed {
            assumed.push(f"  {path}:{line}  {claim.written}  assumed: a fact the program vouches for in `unsafe`, checked only where the build removes no checks")
            continue
        }
        // **Where the build refuses what it did not prove** (ADR-380 D1),
        // such a claim is refused, not checked at run time.
        let how = match refuses {
            true => check_claim_refused(claim.held) ?? check_claim_held(claim.held),
            false => check_claim_held(claim.held),
        }
        let row = f"  {path}:{line}  {claim.written}  {how}"
        let rule = check_claim_rule(claim.written)
        if rule != null {
            let label = rule ?? ""
            let point = check_claim_point(source, start, line, label)
            let paint = check_claim_paint(how, claim.held != null)
            ruled.insert(row.clone())
            let shown = f"    {path}:{line}  {point}  {how}"
            match written.iter().position(fn(w) { w == label }) {
                k => points[k].push((shown, paint)),
                null => {
                    written.push(label)
                    points.push([(shown, paint)])
                },
            }
        }
        if how == "proved" || how.starts_with("proved: known from") {
            proved.push(row)
        } else if how.starts_with("proved through") || how.starts_with("proved inside") {
            through_loops += 1
            proved.push(row)
        } else if how.starts_with("precondition of `main`") {
            mains.insert(claim.written.clone())
            arrives.push(row)
        } else if how.starts_with("precondition") && how.contains("proved at every call") {
            preconditions.push(row)
        } else if how.starts_with("precondition") || how.starts_with("checked at run time") {
            at_run_time.push(row)
        } else if how.starts_with("checked when") {
            by_the_test.push(row)
        } else if claim.held != null {
            refused.push(row)
        }
    }
    let main = published["main"]
    if main != null {
        let entry = main?.clone() ?? Published::nothing()
        for k in 0..<entry.requires.len() {
            if k >= entry.from.len() {
                continue
            }
            let from = entry.from[k]
            if mains.contains(from) {
                continue
            }
            arrives.push(f"  {path}  {entry.requires[k]}  precondition of `main` carried back from `{from}`, checked where the words arrive")
        }
    }
    let unproved = refused.len() + at_run_time.len() + by_the_test.len()
    let done = proved.len() + preconditions.len()
    // **What a loop carried** (ADR-361 D7), counted where there is any.
    let mut looped: String = ""
    if through_loops > 0 {
        looped = f", through a loop {through_loops}"
    }
    let mut vouched: String = ""
    if assumed.len() > 0 {
        vouched = f"; assumed {assumed.len()}"
    }
    // **What callers proved** (ADR-391 D4): no `assert` states it, so it is
    // counted on its own.
    if derived.len() > 0 {
        vouched = f"{vouched}; derived from the callers {derived.len()}"
    }
    // **A type's rules** (ADR-369 D5), counted apart: their written points
    // are among the asserts already.
    let found = rules.iter().filter(fn(r) { r.starts_with("found\t") }).count()
    if written.len() + rules.len() > 0 {
        vouched = f"{vouched}; type rules {written.len() + rules.len()} (written {written.len()}, found {found}, not found {rules.len() - found})"
    }
    let mut out: String = f"asserts in {path}: {unproved + arrives.len() + done} - not proved {unproved} (refused {refused.len()}, checked at run time {at_run_time.len()}, checked by a test {by_the_test.len()}); checked where the words arrive {arrives.len()}; proved {done} (proved {proved.len()}{looped}, preconditions proved at every call {preconditions.len()}){vouched}\n"
    let mut red: Vec[String] = []
    red.extend(refused.iter().filter(fn(r) { !ruled.contains(r) }).cloned())
    red.extend(at_run_time.iter().filter(fn(r) { !ruled.contains(r) }).cloned())
    red.extend(by_the_test.iter().filter(fn(r) { !ruled.contains(r) }).cloned())
    let mut green: Vec[String] = []
    green.extend(proved.iter().filter(fn(r) { !ruled.contains(r) }).cloned())
    green.extend(preconditions.iter().filter(fn(r) { !ruled.contains(r) }).cloned())
    for row in derived {
        green.push(f"  {path}  derived  {row}")
    }
    out.push_str(check_report_rows(red, "\x1b[31m", colour))
    out.push_str(check_report_rows(arrives.iter().filter(fn(r) { !ruled.contains(r) }).cloned().collect(), "\x1b[94m", colour))
    out.push_str(check_report_rows(assumed, "\x1b[33m", colour))
    out.push_str(check_report_rows(green, "\x1b[32m", colour))
    for (k, label) in written.iter().enumerate() {
        out.push_str(f"  {path}  written  {label}: checked at {points[k].len()} points\n")
        for (row, paint) in points[k] {
            out.push_str(check_report_rows([row.clone()], paint, colour))
        }
    }
    for row in rules {
        let parts: Vec[String] = row.split("\t").collect()
        if parts.len() != 4 {
            continue
        }
        let paint = if parts[0] == "found" { "\x1b[32m" } else { "\x1b[33m" }
        out.push_str(check_report_rows([f"  {path}  {parts[0]}  `{parts[1]}`: {parts[2]} - {parts[3]}"], paint, colour))
    }
    return out
}

/// **The rule a claim checks** (ADR-369 D2): `the rule of `T`` and its
/// message, as `type_rules.nika` wrote it into the claim's `message:`;
/// nothing for any other claim.
fn check_claim_rule(written: ref String) -> String? {
    let at = written.find("message: \"the rule of `") ?? return null
    let said = written.after(at.end)
    let message = said.strip_suffix("\")") ?? return null
    return f"the rule of `{message}"
}

/// **What a rule's point is** (ADR-369 D2), read off the source where its
/// claim stands: the end of a method that changes the value, a `return` or
/// a `throw` of one, a construction, or a write to a field.
fn check_claim_point(source: ref String, start: i64, line: i64, rule: ref String) -> String {
    let text = (source.lines().nth(line - 1) ?? "").clone()
    let lead = text.trim_start()
    if start < source.bytes.len() && source.bytes[start] == '}' {
        return "where a method that changes it ends"
    }
    // The type's name, between the backticks of `the rule of `T``.
    let named = rule.strip_prefix("the rule of `") ?? ""
    let tick = named.find("`")
    let ty = match tick {
        at => named.before(at.start).clone(),
        null => named.clone(),
    }
    if text.contains(f"{ty} {{") || text.contains(f"{ty}(") || text.contains(" with ") {
        return "where a value of it is built"
    }
    if lead.starts_with("return") {
        return "at a `return` of a method that changes it"
    }
    if lead.starts_with("throw") {
        return "at a `throw` of a method that changes it"
    }
    return "after a write to its fields"
}

/// The colour of a claim's row by how it is held, as its group has it.
fn check_claim_paint(how: ref String, held: bool) -> String {
    if how == "proved" || how.starts_with("proved") || (how.starts_with("precondition") && how.contains("proved at every call")) {
        return "\x1b[32m"
    }
    if how.starts_with("precondition of `main`") {
        return "\x1b[94m"
    }
    if !held {
        return ""
    }
    return "\x1b[31m"
}

/// Each row on a line of its own, in `paint` where `colour` asks for it.
fn check_report_rows(rows: ref Vec[String], paint: ref String, colour: bool) -> String {
    let mut out: String = ""
    for row in rows {
        if colour {
            out.push_str(paint)
            out.push_str(row)
            out.push_str("\x1b[0m\n")
        } else {
            out.push_str(row)
            out.push_str("\n")
        }
    }
    return out
}
