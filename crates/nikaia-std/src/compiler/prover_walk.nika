// crates/nikaia-std/src/compiler/prover_walk.nika
//
// **The prover's walk over a program's bodies** (ADR-269), moved from the
// compiler's `prove` (ADR-294, #436 step 4): every function, statement and
// expression, what each binding makes known, where an `assert` stands and
// what each call to a function with a precondition asks. The passes around
// it, which repeat the walk until its answers stop changing, are the
// compiler's.
//
// **What only the compiler can do is handed in** as callbacks: the solver
// (`ask`, `model`), the language below's spelling of a name (`escape`), the
// holes of a literal (`holes_of`), a package's alias (`unaliased`), an
// expression as written (`written_of`), and another package's condition read
// back with the compiler's parser (`condition`, its nodes, the root last).
// The checker keys an expression by its id (`node_key`, ADR-340).

use std::collections
use logic

/// The walk's answers, and what it keeps from one function to the next.
pub struct ProverWalk {
    pub state: ProverState,
    pub arena: logic::TermArena,
    /// How each `assert` the walk reached is held, by statement and the id of
    /// its condition (ADR-340).
    pub held: collections::BTreeMap[(i64, i64), ClaimHeld],
    /// How each call to a function with a precondition reaches it, by callee
    /// and arguments as written (ADR-269 D20).
    pub reaches: collections::BTreeMap[(String, String), CallReach],
    pub findings: Vec[Finding],
    /// The checker's `assert`s, by statement and the id of the condition: a call is an
    /// `assert` exactly where the checker recognised the prelude's.
    pub claims: collections::BTreeSet[(i64, i64)],
    /// **`std`'s preconditions at the calls the walk reached** (ADR-269 D5,
    /// #1003), keyed as `held` is, by statement and the call's id: each is a
    /// claim the program makes there, written `callee: condition`.
    pub std_claims: collections::BTreeMap[(i64, i64), String],
    /// **Each index data from outside reaches, and what became of it**
    /// (ADR-396 D5), by where it stands and how it is written: the last
    /// walk's, for `--bounds`.
    pub outside: collections::BTreeMap[(i64, String), OutsideIndex],
}

/// **Every body of the program, walked once**: each function and method,
/// and each test and bench, which have no callers.
fn prover_bodies(mut walk: ProverWalk, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) sync {
    for item in program.items {
        match item.node {
            Item::Fn { .. } => prover_function(walk, item, null, false, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
            Item::Impl { methods, target, trait_name } => {
                let owner = words.resolve(target.name).clone()
                for method in methods {
                    prover_function(walk, method, owner.clone(), trait_name != null, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                }
            },
            Item::Test { body, .. } => prover_test(walk, body, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
            Item::Bench { body, .. } => prover_test(walk, body, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
            Item::Grammar(def) => {
                for rule in def.rules {
                    for alt in rule.alts {
                        let action = alt.action ?? continue
                        prover_action(walk, def, rule, alt.pattern.node, action, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                    }
                }
            },
            else => {},
        }
    }
}

/// **A grammar rule's action, with what its pattern has shown** (ADR-grammar-syntax-v1
/// D14, ADR-yaml-1 D11): the rule's whole-number values and the whole numbers
/// its pattern binds at its top are variables of the proof, and each guard at
/// the top holds where the action runs. An action has no callers, so a claim
/// in it is proved there or refused.
fn prover_action(mut walk: ProverWalk, def: ref GrammarDef, rule: ref GrammarRule, pattern: ref Pattern, action: ref Block, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) sync {
    let at = ProverWhere { function: null, params: collections::BTreeSet(), no_precondition: "a grammar action has no callers", top: true, free: false, posts: false, lambda: true, throws_out: true }
    let mut scope = ProverScope::unknown()
    for arg in rule.args {
        let name = words.resolve(arg.name).clone()
        scope.locals.insert(name.clone())
        let ty = words.resolve(arg.ty.name)
        if !arg.mutable && arg.ty.generics.is_empty() && is_whole_number(ty) {
            prover_action_number(walk, scope, name, ty)
        }
    }
    for option in rule.config {
        scope.locals.insert(words.resolve(option.name).clone())
    }
    let mut parts: Vec[Pattern] = []
    match pattern {
        Pattern::Seq(items) => {
            for item in items {
                parts.push(item.node.clone())
            }
        },
        else => parts.push(pattern.clone()),
    }
    for part in parts {
        prover_action_locals(part, scope, words)
        match part {
            Pattern::Bind { name, pat } => {
                let ty = prover_bound_number(def, pat.node, words)
                if ty != null {
                    prover_action_number(walk, scope, words.resolve(name).clone(), ty ?? "")
                }
            },
            else => {},
        }
    }
    for part in parts {
        match part {
            Pattern::Guard { cond, .. } => {
                let holds = claim_term(cond, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                if holds != null {
                    scope.facts.push(holds ?? 0)
                }
            },
            else => {},
        }
    }
    prover_block(walk, action, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// A whole number the action reads, of type `ty`.
fn prover_action_number(mut walk: ProverWalk, mut scope: ProverScope, name: ref String, ty: ref String) {
    scope.ints.insert(name.clone())
    if ty.starts_with("u") {
        scope.not_negative(walk.arena, name)
    }
}

/// Every name a pattern binds, at any depth: a local of the action.
fn prover_action_locals(pattern: ref Pattern, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) {
    match pattern {
        Pattern::Bind { name, pat } => {
            scope.locals.insert(words.resolve(name).clone())
            prover_action_locals(pat.node, scope, words)
        },
        Pattern::Seq(items) => {
            for item in items {
                prover_action_locals(item.node, scope, words)
            }
        },
        Pattern::Choice(items) => {
            for item in items {
                prover_action_locals(item.node, scope, words)
            }
        },
        Pattern::Ref { args, .. } => {
            for arg in args {
                prover_action_locals(arg.node, scope, words)
            }
        },
        Pattern::Repeat { pat, .. } => prover_action_locals(pat.node, scope, words),
        Pattern::Counted { pat, .. } => prover_action_locals(pat.node, scope, words),
        Pattern::Group(pat) => prover_action_locals(pat.node, scope, words),
        else => {},
    }
}

/// The whole-number type a bound pattern yields, if it yields one: a rule of
/// the grammar declared so, `count(p)` (an `i64`), `here` (a `u32`) or
/// `dec[T]` of a whole-number `T` (ADR-grammar-syntax-v1 D15, ADR-grammar-syntax-v1 D16).
fn prover_bound_number(def: ref GrammarDef, pattern: ref Pattern, words: ref winnow_grammar::InternerContext) -> String? sync {
    let (called, generics, args) = match pattern {
        Pattern::Ref { name, generics, args } => (words.resolve(name).clone(), generics.clone(), args.len()),
        Pattern::Call { name, .. } => (words.resolve(name).clone(), [], 0),
        else => return null,
    }
    for rule in def.rules {
        if words.resolve(rule.name) == called {
            let ret = rule.ret_type ?? return null
            let ty = words.resolve(ret.name).clone()
            if ret.generics.is_empty() && is_whole_number(ty) {
                return ty
            }
            return null
        }
    }
    if called == "count" && args == 1 {
        return "i64"
    }
    if called == "here" && args == 0 {
        return "u32"
    }
    if called == "dec" && generics.len() == 1 && generics[0].generics.is_empty() {
        let ty = words.resolve(generics[0].name).clone()
        if is_whole_number(ty) {
            return ty
        }
    }
    return null
}

/// A test's or a bench's body: every claim in it is the test's verdict (D11).
fn prover_test(mut walk: ProverWalk, body: ref Block, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    walk.state.in_test = true
    let at = ProverWhere { function: null, params: collections::BTreeSet(), no_precondition: "a test has no callers", top: true, free: false, posts: false, lambda: false, throws_out: true }
    let mut scope = ProverScope::unknown()
    prover_block(walk, body, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    walk.state.in_test = false
}

/// One function, or a method of `owner` - in a trait's implementation where
/// `of_a_trait` says so.
fn prover_function(mut walk: ProverWalk, item: ref Spanned[Item], owner: String?, of_a_trait: bool, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    match item.node {
        Item::Fn { name, receiver, args, config, body, can_throw, is_public, .. } => {
            let has_owner = owner != null
            // The ledger's key: `f`, or `Type::m` for a method.
            let mut key: String? = null
            let plain = prover_symbol_text(name, words)
            if plain != null {
                let n = plain ?? ""
                if has_owner {
                    key = f"{owner ?? ""}::{n}"
                } else {
                    key = n
                }
            }
            // A `test` block `nikaia test` has already turned into a function
            // is still a test (D11).
            let was_a_test = key != null && prover_a_test_function(key)
            let mut scope = ProverScope::at_the_entry()
            let mut params: collections::BTreeSet[String] = collections::BTreeSet()
            if receiver != null {
                scope.locals.insert("self")
                // **A path of fields from a `self` the method does not
                // change is a name of its own** (ADR-306 D17), as one from a
                // borrowed parameter is: `self.other.len()` under `if
                // self.other.len() == 0` (#1476). A claim on one is a
                // precondition (ADR-269 D15), since every call hands its
                // receiver in for `self`; not on a private field of a `pub`
                // method, which its callers cannot see (D16).
                let lent = receiver ?? Receiver { is_ref: true, is_mut: true, is_keep: false }
                if !lent.is_mut && has_owner {
                    let mut fields: collections::BTreeSet[String] = collections::BTreeSet()
                    prover_parameter_fields(walk, scope, fields, "self", owner ?? "", true, program, words)
                    let hidden = if is_public { prover_private_fields(program, words, owner ?? "") } else { collections::BTreeSet() }
                    for path in fields {
                        let field = path.strip_prefix("self.") ?? ""
                        if !hidden.contains(field) {
                            params.insert(path.clone())
                        }
                    }
                }
            }
            for arg in args {
                let arg_name = words.resolve(arg.name).clone()
                scope.locals.insert(arg_name.clone())
                scope.carry(arg_name, arg_name.clone())
                let ty = words.resolve(arg.ty.name)
                if !arg.mutable && arg.ty.generics.is_empty() && is_whole_number(ty) {
                    scope.ints.insert(arg_name.clone())
                    scope.loose.insert(arg_name.clone())
                    params.insert(arg_name.clone())
                    let at_entry = walk.arena.var(arg_name)
                    scope.entry.insert(arg_name.clone(), at_entry)
                    if ty.starts_with("u") {
                        scope.not_negative(walk.arena, arg_name)
                    }
                }
                // **A `mut` list's length is a name too where the body
                // keeps it** (ADR-269 D9, #1375): element writes, `swap`,
                // `sort` keep it; binding the list again, a method that
                // grows or shrinks it, or a call that may change it, does not.
                let kept = !arg.mutable || (!changes_length_in(body, arg_name, walk.state.readers, words) && !rebinds(body, arg_name, words))
                if a_map_type(ty) {
                    scope.maps.insert(arg_name.clone())
                }
                if kept && has_a_length(ty) {
                    scope.has_length(walk.arena, arg_name, null)
                    params.insert(arg_name.clone())
                    let length = length_of(arg_name)
                    let at_entry = walk.arena.var(length)
                    scope.entry.insert(length, at_entry)
                }
                // **A path of fields from a borrowed parameter is a name of
                // its own** (ADR-306 D17, ADR-269 D9): `p.end` of `p: Piece`.
                if !arg.mutable && arg.ty.generics.is_empty() {
                    prover_parameter_fields(walk, scope, params, arg_name, ty, true, program, words)
                }
            }
            let mut unchanged: collections::BTreeSet[String] = collections::BTreeSet()
            for arg in args {
                if !arg.mutable {
                    unchanged.insert(words.resolve(arg.name).clone())
                }
            }
            prover_entry_properties(walk, scope, params, unchanged, body, program, words)
            // **An option is a parameter** (Part I 5.1): a claim about it is
            // a precondition as one about a subject parameter is (#651).
            for option in config {
                let option_name = words.resolve(option.name).clone()
                scope.locals.insert(option_name.clone())
                scope.carry(option_name, option_name.clone())
                let ty = words.resolve(option.ty.name)
                if option.ty.generics.is_empty() && is_whole_number(ty) {
                    scope.ints.insert(option_name.clone())
                    scope.loose.insert(option_name.clone())
                    params.insert(option_name.clone())
                    let at_entry = walk.arena.var(option_name)
                    scope.entry.insert(option_name.clone(), at_entry)
                    if ty.starts_with("u") {
                        scope.not_negative(walk.arena, option_name)
                    }
                }
                if has_a_length(ty) {
                    scope.has_length(walk.arena, option_name, null)
                    params.insert(option_name.clone())
                    let length = length_of(option_name)
                    let at_entry = walk.arena.var(length)
                    scope.entry.insert(length, at_entry)
                }
            }
            // **`main`'s preconditions are derived as every function's are**
            // (ADR-360 D3): its caller is the command line, and the words are
            // checked where they arrive (D4).
            let mut no_precondition: String? = null
            if of_a_trait {
                no_precondition = "A method of a trait's implementation can't have a precondition: a call through the trait doesn't know it, and there is no second entry to check it."
            }
            let free = !has_owner && !was_a_test
            let at = ProverWhere { function: claim_text_of(key), params: params, no_precondition: no_precondition, top: true, free: free, posts: !was_a_test && !of_a_trait, lambda: false, throws_out: can_throw }
            walk.state.in_test = was_a_test
            // **A result summary** (ADR-359 D1, D14): every exit of the body
            // of a free function, or of a method no trait's call can reach,
            // that the walk reads in full.
            walk.state.summing = []
            walk.state.unsummed = was_a_test || of_a_trait || key == null || !prover_summable(body)
            let leaves = prover_block(walk, body, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            walk.state.in_test = false
            let summed_key = key?.clone() ?? ""
            if !summed_key.is_empty() {
                if leaves && !walk.state.unsummed && !walk.state.summing.is_empty() {
                    walk.state.summaries.insert(summed_key, walk.state.summing.clone())
                } else {
                    walk.state.summaries.remove(summed_key)
                }
            }
            // A body that can end without a `return` has an exit no candidate
            // was shown at.
            if !leaves && !walk.state.collecting && key != null {
                let function = key ?? ""
                let posts = standing_posts(walk.state.postconditions, function) ?? []
                for index in 0..<posts.len() {
                    walk.state.broken.insert((function.clone(), index))
                }
            }
        },
        else => {},
    }
}

/// A block; whether it always leaves.
fn prover_block(mut walk: ProverWalk, block: ref Block, mut scope: ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> bool {
    // **The names of this block the walk may not follow as mutable whole
    // numbers** (ADR-361 D1), asked only where it binds one.
    let mut untracked: collections::BTreeSet[String] = collections::BTreeSet()
    let mut pinned: collections::BTreeSet[String] = collections::BTreeSet()
    if prover_binds_mutable(block) {
        untracked = untracked_in(block, walk.state.value_readers, words)
        pinned = pinned_in(block, words)
    }
    for index in 0..<block.stmts.len() {
        let stmt = block.stmts[index]
        if walk.state.collecting && index + 1 < block.stmts.len() {
            // **Past the claims after it**: a type's rule the compiler checks
            // before a method's exit stands between them (#776).
            let mut next = index + 1
            while next + 1 < block.stmts.len() && prover_a_claim_stmt(block.stmts[next].node, words) {
                next += 1
            }
            let returned = prover_returned_name(block.stmts[next].node, words)
            if returned != null {
                walk.state.before_return.insert(stmt.span.start as i64, returned ?? "")
            }
        }
        // **A name a block inside fills from outside is outside past it**
        // (#2371): the walk reads that block in a scope of its own, and a
        // loop's turn reads before its head what a later turn filled (a
        // name the loop assigns is unknown at its head, so only a changing
        // call's receiver stays outside there).
        let looped = match stmt.node {
            Stmt::For { .. } => true,
            Stmt::While { .. } => true,
            else => false,
        }
        if looped {
            prover_filled(scope, outside_fills(stmt.node, scope.tainted, scope.sources, words, library, walk.state, holes_of))
        }
        if prover_stmt(walk, stmt, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition) {
            return true
        }
        let changes = match stmt.node {
            Stmt::Expr(_) => true,
            Stmt::For { .. } => true,
            Stmt::While { .. } => true,
            Stmt::Let { .. } => !check_visit_stmt_blocks(stmt.node).is_empty(),
            Stmt::Assign { .. } => !check_visit_stmt_blocks(stmt.node).is_empty(),
            else => false,
        }
        if changes {
            prover_filled(scope, outside_fills(stmt.node, scope.tainted, scope.sources, words, library, walk.state, holes_of))
        }
        prover_follow_mutables(walk, stmt.node, stmt.span, scope, untracked, pinned, program, words)
        // A statement that may leave for some states and not for others
        // narrows what goes on past it, and only an `if` or a `match` the
        // prover reads says how (`prover_expr_stmt`).
        if !prover_a_branch(stmt.node) && leaves_stmt(stmt.node, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true) {
            scope.exact = false
        }
    }
    return false
}

/// **The head of a turn of each loop in `records`** (ADR-361 D2, D3): each
/// state name is its value there, `loop_turn_name`, so a claim in the body
/// can be asked with the invariant at that head (`ProverState::through_loops`).
/// An assignment since moves the tie among the earlier values (D9); a name
/// bound again drops it.
fn prover_turn_ties(mut walk: ProverWalk, mut inner: ProverScope, records: ref Vec[LoopRecord]) {
    for record in records {
        for name in record.problem.state {
            let here = walk.arena.var(name)
            let head = walk.arena.var(loop_turn_name(name, record.start))
            let tie = walk.arena.equal(here, head)
            inner.facts.push(tie)
        }
        inner.around.push(record.clone())
    }
}

/// One statement; whether control never goes past it.
fn prover_stmt(mut walk: ProverWalk, stmt: ref Spanned[Stmt], mut scope: ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> bool {
    let span = stmt.span
    let nested = at.inside(false)
    return match stmt.node {
        Stmt::Let { names, mutable, ty, value, .. } => {
            prover_let(walk, names, mutable, ty, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            false
        },
        Stmt::Comptime { name, value, .. } => {
            prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            let bound = words.resolve(name).clone()
            scope.rebind(walk.arena, bound)
            scope.maps.remove(bound)
            // **An integer `comptime` is its value** (ADR-359 D7): the one
            // the build computed, which every state that reaches here has.
            let computed = walk.state.comptime_at[span.start as i64]
            if computed != null {
                scope.ints.insert(bound.clone())
                let named = walk.arena.var(bound)
                let value = walk.arena.int(computed ?? 0)
                let fact = walk.arena.equal(named, value)
                scope.facts.push(fact)
                scope.entry.insert(bound.clone(), value)
            }
            false
        },
        Stmt::Assign { target, op, value } => {
            prover_expr(walk, target, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            // **`x op= k` is `x = x op k`** (ADR-395, #1586): its overflow
            // and divisor goals, asked before the name takes the new value,
            // the operation keyed by the statement's start as the checker's.
            if op != null {
                let given: BinaryOp = op?.clone() ?? BinaryOp::Add
                if given == BinaryOp::Add || given == BinaryOp::Sub || given == BinaryOp::Mul || given == BinaryOp::Div || given == BinaryOp::Rem {
                    let written_out = Expr::Binary { op: given, lhs: target.clone(), rhs: value.clone(), span: span, grouped: false, id: fresh_id() }
                    prover_unwritten_check(walk, written_out, span, scope, nested, words, library, holes_of, ask, model, written_of)
                }
            }
            match target {
                Expr::Variable(name, _) => {
                    let n = words.resolve(name).clone()
                    let tainted = from_outside(value, scope.tainted, words, library, walk.state, holes_of) || (op != null && scope.tainted.contains(n))
                    let mut carried = carried_param(value, scope, words, library, walk.state, holes_of)
                    if carried == null && op != null {
                        carried = scope.carried_from[n]?.clone()
                    }
                    if !prover_assigned(walk, n, op, value, span, scope, words) {
                        // **An unreadable value of a followed whole number is
                        // a fresh loose name** (ADR-361 D9, #2108).
                        let followed = scope.mutables.contains(n) && scope.ints.contains(n)
                        scope.rebind(walk.arena, n)
                        if followed {
                            scope.ints.insert(n.clone())
                            scope.loose.insert(n.clone())
                        }
                        if op == null && !tainted {
                            let bits = prover_bit_range(walk, value, scope, words)
                            if bits != null {
                                scope.bounded_bits(walk.arena, n, bits ?? return false)
                            }
                        }
                    }
                    if tainted {
                        let source = outside_source(value, scope.tainted, scope.sources, words, library, walk.state, holes_of)
                        if source != null {
                            scope.sources.insert(n.clone(), source ?? "")
                        }
                        scope.tainted.insert(n.clone())
                    }
                    scope.carry(n, carried)
                },
                else => {},
            }
            false
        },
        Stmt::For { bindings, mutable, iter, body, .. } => {
            prover_for(walk, bindings, mutable, iter, body, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            false
        },
        Stmt::While { cond, body } => {
            prover_expr(walk, cond, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            // **What the turn changes** (ADR-361 D1): unknown at the head of
            // a turn and past the loop; a whole number the walk follows is
            // read past it through the loop's invariant (D2).
            let mut changed = assigned_in(body, words)
            prover_lengths_changed(changed, body, scope, walk.state.readers, words)
            prover_loop_elements(walk, body, [], scope, words)
            let mut state: Vec[String] = []
            for n in changed {
                if scope.mutables.contains(n) && scope.ints.contains(n) && prover_length_follows(n, cond, body, walk.state.readers, words) {
                    state.push(n.clone())
                }
            }
            let mut records: Vec[LoopRecord] = []
            if !state.is_empty() {
                // What the earlier values make known says where the loop
                // starts (D9).
                let at_loop = scope.with_history()
                let record = loop_record(walk.arena, span.start as i64, state, at_loop, scope.ints, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, cond, body, words, walk.claims, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of)
                if record != null {
                    records.push(record ?? return false)
                }
            }
            let kept_bits = prover_loop_bits(walk, scope, changed, body, words)
            let mut inner = scope.clone()
            for n in changed {
                if prover_loop_keeps(n, changed, body, scope, words) {
                    continue
                }
                inner.rebind(walk.arena, n)
                scope.rebind(walk.arena, n)
                prover_relength(walk, n, inner)
                prover_relength(walk, n, scope)
            }
            for n in state {
                inner.ints.insert(n.clone())
                inner.loose.insert(n.clone())
                scope.ints.insert(n.clone())
                scope.loose.insert(n.clone())
            }
            for (n, bits) in kept_bits {
                inner.bounded_bits(walk.arena, n, bits)
                scope.bounded_bits(walk.arena, n, bits)
            }
            if !changed.is_empty() {
                scope.exact = false
            }
            prover_turn_ties(walk, inner, records)
            scope.loops.extend(records)
            inner.path = null
            // Which turns there are depends on what the loop changes.
            inner.exact = false
            scope.path = null
            let holds = claim_term(cond, words, fn(name) { inner.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, inner, name) }, walk.arena.nodes)
            if holds != null {
                inner.facts.push(holds ?? 0)
            }
            prover_block(walk, body, inner, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            if leaves_block(body, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, false) {
                scope.exact = false
            }
            false
        },
        Stmt::Return(value) => {
            prover_return(walk, value, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            true
        },
        Stmt::Break => true,
        Stmt::Continue => true,
        Stmt::Expr(expr) => prover_expr_stmt(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Stmt::Emit(expr) => prover_expr_stmt(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
    }
}

/// The names of the fields the struct `ty` declares without `pub`.
fn prover_private_fields(program: ref Program, words: ref winnow_grammar::InternerContext, ty: ref String) -> collections::BTreeSet[String] {
    let mut hidden: collections::BTreeSet[String] = collections::BTreeSet()
    for item in program.items {
        match item.node {
            Item::Struct { name: declared, fields, .. } => {
                if words.resolve(declared) == ty {
                    for field in fields {
                        if !field.is_public {
                            hidden.insert(words.resolve(field.name).clone())
                        }
                    }
                }
            },
            else => {},
        }
    }
    return hidden
}

/// The fields of the struct `ty` declares, as names of the parameter `name`:
/// each whole number `name.f` and each length `name.f.len()`, read at the
/// entry as a parameter is; `name` is a parameter a claim may read through.
/// Not `entered`, they are a `let`'s of a call's result (supervisor decision,
/// 2026-11-12, for ADR-396 D4): names of their own, with no value at the
/// entry.
fn prover_parameter_fields(mut walk: ProverWalk, mut scope: ProverScope, mut params: collections::BTreeSet[String], name: ref String, ty: ref String, entered: bool, program: ref Program, words: ref winnow_grammar::InternerContext) {
    for item in program.items {
        match item.node {
            Item::Struct { name: declared, generics, fields, .. } => {
                if words.resolve(declared) == ty && generics.is_empty() {
                    for field in fields {
                        let path = f"{name}.{words.resolve(field.name)}"
                        let field_ty = words.resolve(field.ty.name)
                        if field.ty.generics.is_empty() && is_whole_number(field_ty) {
                            scope.ints.insert(path.clone())
                            scope.loose.insert(path.clone())
                            params.insert(path.clone())
                            params.insert(name.clone())
                            if entered {
                                let at_entry = walk.arena.var(path)
                                scope.entry.insert(path.clone(), at_entry)
                            }
                            if field_ty.starts_with("u") {
                                scope.not_negative(walk.arena, path)
                            }
                        }
                        if has_a_length(field_ty) {
                            scope.has_length(walk.arena, path, null)
                            params.insert(path.clone())
                            params.insert(name.clone())
                            if entered {
                                let length = length_of(path)
                                let at_entry = walk.arena.var(length)
                                scope.entry.insert(length, at_entry)
                            }
                        }
                    }
                }
            },
            else => {},
        }
    }
}

/// **A literal's fields are names of the binding** (ADR-306 D17): `let p =
/// Piece { end: n }` knows `p.end == n`, and `p.items.len()` is the length
/// of the list it was given by name.
fn prover_literal_fields(mut walk: ProverWalk, mut scope: ProverScope, name: ref String, fields: ref Vec[FieldInit], words: ref winnow_grammar::InternerContext) {
    for field in fields {
        let field_name = words.resolve(field.name)
        let path = f"{name}.{field_name}"
        let term = prover_field_value(walk, scope, field.value, field_name, words)
        if term != null {
            scope.ints.insert(path.clone())
            let named = walk.arena.var(path)
            let fact = walk.arena.equal(named, term ?? 0)
            scope.facts.push(fact)
            let at_entry = scope.at_entry(walk.arena, term ?? 0)
            if at_entry != null {
                scope.entry.insert(path.clone(), at_entry ?? 0)
            }
        }
        let list = prover_field_list(field.value, field_name, words)
        if list != null {
            let given = length_of(list ?? "")
            if scope.ints.contains(given) {
                let length = length_of(path)
                scope.ints.insert(length.clone())
                let named = walk.arena.var(length)
                let known = walk.arena.var(given)
                let fact = walk.arena.equal(named, known)
                scope.facts.push(fact)
            }
        } else {
            // **A list written in the literal counts its items** (ADR-306
            // D17): `Tree { nodes: [n], root: 0 }`.
            let written = field.value ?? continue
            let counted = match written {
                Expr::ListLit { .. } => length_given(walk.arena, words, written, scope, walk.state.pinned),
                Expr::ListRepeat { .. } => length_given(walk.arena, words, written, scope, walk.state.pinned),
                else => null,
            }
            if counted != null {
                let length = length_of(path)
                scope.ints.insert(length.clone())
                let named = walk.arena.var(length)
                let fact = walk.arena.equal(named, counted ?? 0)
                scope.facts.push(fact)
            }
        }
    }
}

/// A field's value as a term: what is written, or the name of the same
/// name where nothing is (`Piece { end }`).
fn prover_field_value(mut walk: ProverWalk, scope: ref ProverScope, value: ref Expr?, field_name: ref String, words: ref winnow_grammar::InternerContext) -> i64? {
    if value == null {
        if !scope.ints.contains(field_name) {
            return null
        }
        return walk.arena.var(field_name)
    }
    let written = value ?? return null
    return lin_term(written, words, fn(n) { scope.ints.contains(n) }, fn(n) { prover_pinned(walk.state.pinned, scope, n) }, walk.arena.nodes)
}

/// The list a field is given by name, or by the same name.
fn prover_field_list(value: ref Expr?, field_name: ref String, words: ref winnow_grammar::InternerContext) -> String? {
    if value == null {
        return field_name.clone()
    }
    let written = value ?? return null
    return path_of(written, words)
}

/// A `let`: what its value makes known of the names it binds.
fn prover_let(mut walk: ProverWalk, names: ref Vec[winnow_grammar::Symbol], mutable: bool, ty: ref Type?, value: ref Expr, span: Span, mut scope: ProverScope, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    let tainted = from_outside(value, scope.tainted, words, library, walk.state, holes_of)
    // **The calls with known arguments the value reads** (ADR-359 D11), kept
    // with the name it binds, so a claim over it can have them run.
    let mut known_calls: collections::BTreeSet[String] = collections::BTreeSet()
    if names.len() == 1 && !mutable {
        known_calls = prover_known_calls(walk, value, scope, program, words, own, holes_of, unaliased, condition)
    }
    // **A call inside the value is a whole number of its own** (ADR-314 D3):
    // what its callee ensures holds of it, so `let e = 10 + f(2)` reads as
    // `10 + r` with `f`'s postconditions about `r`. The value's own call, `let
    // r = f(x)`, is the case below.
    if names.len() == 1 && !mutable {
        prover_call_results(walk, value, true, scope, program, words, own, unaliased, condition, written_of)
    }
    let leaned = prover_pin_divisors(walk, value, scope, words, ask, model)
    let value_lin = lin_term(value, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
    let mut value_at_entry: i64? = null
    if value_lin != null {
        value_at_entry = scope.at_entry(walk.arena, value_lin ?? 0)
    }
    // **A call's postconditions are facts about its result** (D17): `let r =
    // f(x)` knows what `f` ensures.
    let mut called = false
    let mut called_whole = false
    let mut called_facts: Vec[i64] = []
    let mut called_summed: Vec[SummaryAlt]? = null
    if names.len() == 1 {
        match value {
            Expr::Call { func, args, config, .. } => {
                let callee = prover_bound_callee(func, scope, words, unaliased)
                if callee != null {
                    let c = callee ?? ""
                    let bound = words.resolve(names[0]).clone()
                    called_facts = prover_postconditions_of(walk, c, args, config, bound, scope, program, words, own, condition)
                    called_whole = prover_returns_whole(walk, c, program, words, own, condition)
                    called_summed = prover_summed(walk, c, args, config, bound, scope, program, words, written_of(value))
                    called = true
                }
            },
            // **A call `self.m(…)` to the type's own method has its summary**
            // (ADR-359 D14), as a call by name has: the method is resolved
            // statically (ADR-269 D5).
            Expr::MethodCall { receiver, method, args, config, .. } => {
                let callee = prover_own_method_callee(receiver, method, nested, words)
                if callee != null {
                    let c = callee ?? ""
                    let target = prover_summed_function(program, words, c)
                    if target != null {
                        let bound = words.resolve(names[0]).clone()
                        called_whole = target?.whole_result ?? false
                        called_summed = prover_summed(walk, c, args, config, bound, scope, program, words, written_of(value))
                        called = true
                    }
                }
            },
            else => {},
        }
    }
    let mut source: String = ""
    if tainted {
        source = outside_source(value, scope.tainted, scope.sources, words, library, walk.state, holes_of) ?? ""
    }
    let carried = carried_param(value, scope, words, library, walk.state, holes_of)
    // D14: a guarded name joined after a clean part carries its proof to
    // the binding, asked before the binding drops what the name knew.
    let proved = tainted && !mutable && names.len() == 1 && raw_sink_proved_join(walk, value, scope, words, library, holes_of, ask)
    // D11: a root bound to a name is judged where a call opens a path under
    // the name, as written there (#2440).
    let root = raw_sink_root(value, scope, words)
    let rooted = !mutable && names.len() == 1 && (raw_sink_anywhere(root, words, written_of) || raw_sink_dir(root, words) != null)
    for name in names {
        let n = words.resolve(name).clone()
        scope.rebind(walk.arena, n)
        scope.maps.remove(n)
        scope.carry(n, carried)
        if tainted {
            scope.tainted.insert(n.clone())
            scope.loose.insert(n.clone())
            if source != "" {
                scope.sources.insert(n.clone(), source.clone())
            }
        }
        if proved {
            scope.joined.insert(n.clone())
        }
        if rooted {
            scope.roots.insert(n.clone(), root.clone())
        }
    }
    // **A map's index reads a key** (ADR-396 D4), a `let mut`'s too.
    if names.len() == 1 && prover_let_typed(walk, ty, span, words, 3) {
        scope.maps.insert(words.resolve(names[0]).clone())
    }
    // **A mask's or a shift's value is bounded** (#776), a `let mut`'s too.
    if names.len() == 1 && value_lin == null && !tainted {
        let bits = prover_bit_range(walk, value, scope, words)
        if bits != null {
            let bound = words.resolve(names[0]).clone()
            scope.bounded_bits(walk.arena, bound, bits ?? return)
        }
    }
    // **A `let mut` of a call knows what the call ensures** (#1009), as a
    // `let` does; `prover_follow_mutables` follows it from there, or drops
    // it where the block may change it unseen.
    if names.len() == 1 && mutable && called && called_whole {
        let bound = words.resolve(names[0]).clone()
        scope.ints.insert(bound.clone())
        scope.loose.insert(bound.clone())
        for fact in called_facts {
            scope.facts.push(fact)
        }
        if called_summed != null {
            scope.summed.insert(bound, called_summed ?? [])
        }
        return
    }
    if names.len() != 1 || mutable {
        return
    }
    let name = words.resolve(names[0]).clone()
    prover_bind_condition(walk, name, value, scope, words)
    match value {
        Expr::StructLit { fields, .. } => prover_literal_fields(walk, scope, name, fields, words),
        // **A call's result is read through its fields** (supervisor
        // decision, 2026-11-12, for ADR-396 D4), as a parameter is (ADR-306
        // D17): `shape.code.len()` of `let shape = where_shape(lines)`.
        Expr::Call { .. } => prover_result_fields(walk, scope, name, ty, span, program, words),
        Expr::MethodCall { .. } => prover_result_fields(walk, scope, name, ty, span, program, words),
        else => {},
    }
    if !leaned.is_empty() {
        scope.leaned.insert(name.clone(), leaned)
    }
    if !known_calls.is_empty() {
        scope.calls_of.insert(name.clone(), known_calls)
    }
    if value_lin != null {
        let v = value_lin ?? 0
        scope.ints.insert(name.clone())
        // **A value that reads the name it shadows** - `let x = x + 1` - is
        // about the old binding, which a fact names the same way: `x = x + 1`
        // would be a contradiction, and from it everything follows. The name
        // is a whole number; nothing more is known.
        if !walk.arena.mentions(v, name) {
            let named = walk.arena.var(name)
            let fact = walk.arena.equal(named, v)
            scope.facts.push(fact)
        } else {
            scope.loose.insert(name.clone())
        }
        // At the entry the value is what it read there, so a shadowing `let`
        // is no trouble here.
        if value_at_entry != null {
            scope.entry.insert(name.clone(), value_at_entry ?? 0)
        }
    } else if prover_let_typed(walk, ty, span, words, 0) || (called && called_whole) {
        scope.ints.insert(name.clone())
        scope.loose.insert(name.clone())
        prover_chosen_value(walk, name, value, scope, words)
        prover_found_value(walk, name, value, scope, words, library, condition)
    }
    // **What a call ensures of its result's named properties** holds of the
    // name it binds (ADR-381 D2), whatever the result's type.
    if called && !called_whole {
        prover_property_facts(walk, scope, name, called_facts, written_of(value))
    }
    if called && called_whole {
        for fact in called_facts {
            scope.facts.push(fact)
        }
        if called_summed != null {
            scope.summed.insert(name.clone(), called_summed ?? [])
        }
    }
    if prover_let_typed(walk, ty, span, words, 1) && scope.ints.contains(name) {
        scope.not_negative(walk.arena, name)
    }
    match value {
        Expr::ListLit { items, .. } => {
            let known: i64? = items.len()
            scope.has_length(walk.arena, name, known)
        },
        Expr::LitStr { .. } => scope.has_length(walk.arena, name, null),
        else => {
            if prover_list_length(walk, name, value, scope, words) {
                return
            }
            if prover_let_typed(walk, ty, span, words, 2) {
                scope.has_length(walk.arena, name, null)
                prover_collected_parts(walk, name, value, scope, words, library, condition)
            }
        },
    }
}

/// The fields of a call's result bound by an immutable `let`, of the type
/// written or the one the checker gave it.
fn prover_result_fields(mut walk: ProverWalk, mut scope: ProverScope, name: ref String, ty: ref Type?, span: Span, program: ref Program, words: ref winnow_grammar::InternerContext) {
    let mut declared: String = ""
    if ty != null {
        let t = ty ?? return
        if !t.generics.is_empty() {
            return
        }
        declared = words.resolve(t.name).clone()
    } else {
        declared = walk.state.whole_lets.get(span.start as i64)?.clone() ?? return
    }
    let mut not_params: collections::BTreeSet[String] = collections::BTreeSet()
    prover_parameter_fields(walk, scope, not_params, name, declared, false, program, words)
}

/// **What the ledger ensures of an optional result, where `??` takes it**
/// (supervisor decision, 2026-11-12, for ADR-396 D4): `str::find` ensures
/// `result == null || (0 <= result && result + needle.len() <= self.len())`,
/// so `let at = s.find(n) ?? return` knows the rest of `at`, and `let at =
/// s.find(n) ?? d` knows it or `at == d`. A fallback that may hand back
/// another value, `a ?? b ?? continue`, knows nothing.
fn prover_found_value(mut walk: ProverWalk, name: ref String, value: ref Expr, mut scope: ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    match value {
        Expr::Coalesce { value: found, fallback, .. } => {
            let facts = prover_found_facts(walk, name, found, scope, words, library, condition)
            if facts.is_empty() {
                return
            }
            let held = walk.arena.and(facts)
            let mut leaves = false
            match fallback {
                Expr::Coalesce { .. } => {},
                else => {
                    leaves = jumps_at_the_end(fallback)
                },
            }
            if leaves {
                scope.facts.push(held)
                return
            }
            let other = lin_term(fallback, words, fn(n) { scope.ints.contains(n) }, fn(n) { prover_pinned(walk.state.pinned, scope, n) }, walk.arena.nodes) ?? return
            if walk.arena.mentions(other, name) {
                return
            }
            let named = walk.arena.var(name)
            let is_other = walk.arena.equal(named, other)
            let fact = walk.arena.or([held, is_other])
            scope.facts.push(fact)
        },
        else => {},
    }
}

/// What a method's ledger entry ensures of its result where there is one,
/// `P` of each `result == null || P`, said of `name`: `self.len()` the
/// receiver's length, each `p` and `p.len()` the argument's. A condition
/// that reads what the call does not give is left out.
fn prover_found_facts(mut walk: ProverWalk, name: ref String, found: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> Vec[i64] {
    let mut facts: Vec[i64] = []
    match found {
        Expr::MethodCall { receiver, args, .. } => {
            let key = walk.state.method_callees.get(id_of(receiver) as i64) ?? return facts
            let contract = library.functions.get(key) ?? return facts
            let signature = contract.signature ?? return facts
            let mut names: collections::BTreeSet[String] = collections::BTreeSet()
            let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
            names.insert(result_name())
            given.insert(result_name(), walk.arena.var(name))
            names.insert(length_of("self"))
            let own = prover_length_of(walk, receiver, scope, words)
            if own != null {
                given.insert(length_of("self"), own ?? 0)
            }
            let mut k = 0
            for (param, _) in signature.params {
                if param == "self" {
                    continue
                }
                names.insert(param.clone())
                names.insert(length_of(param))
                if k < args.len() {
                    let arg = args[k]
                    let term = lin_term(arg, words, fn(n) { scope.ints.contains(n) }, fn(n) { prover_pinned(walk.state.pinned, scope, n) }, walk.arena.nodes)
                    if term != null {
                        given.insert(param.clone(), term ?? 0)
                    }
                    let length = prover_length_of(walk, arg, scope, words)
                    if length != null {
                        given.insert(length_of(param), length ?? 0)
                    }
                }
                k += 1
            }
            for text in contract.ensures {
                let claim = text.strip_prefix("result == null || ") ?? continue
                let term = prover_condition_term(walk.arena, claim, names, condition)
                if term < 0 {
                    continue
                }
                let mut read: collections::BTreeSet[String] = collections::BTreeSet()
                walk.arena.variables(term, read)
                let mut whole = true
                for n in read {
                    if !given.contains_key(n) {
                        whole = false
                    }
                }
                if whole {
                    facts.push(walk.arena.substitute(term, given))
                }
            }
        },
        else => {},
    }
    return facts
}

/// **A whole number chosen by an `if`** (ADR-396 D4): `let n = if c { x }
/// else { y }` is `x` where `c` holds and `y` where it does not, so `n`
/// of `if a.len() < b.len() { a.len() } else { b.len() }` is below both.
fn prover_chosen_value(mut walk: ProverWalk, name: ref String, value: ref Expr, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) {
    match value {
        Expr::If { cond, then_branch, else_branch, .. } => {
            let other = else_branch ?? return
            if then_branch.stmts.len() != 1 || other.stmts.len() != 1 {
                return
            }
            match then_branch.stmts[0].node {
                Stmt::Expr(yes) => {
                    match other.stmts[0].node {
                        Stmt::Expr(no) => {
                            let c = claim_term(cond, words, fn(n) { scope.ints.contains(n) }, fn(n) { prover_pinned(walk.state.pinned, scope, n) }, walk.arena.nodes) ?? return
                            let x = lin_term(yes, words, fn(n) { scope.ints.contains(n) }, fn(n) { prover_pinned(walk.state.pinned, scope, n) }, walk.arena.nodes) ?? return
                            let y = lin_term(no, words, fn(n) { scope.ints.contains(n) }, fn(n) { prover_pinned(walk.state.pinned, scope, n) }, walk.arena.nodes) ?? return
                            if walk.arena.mentions(c, name) || walk.arena.mentions(x, name) || walk.arena.mentions(y, name) {
                                return
                            }
                            let named = walk.arena.var(name)
                            let is_x = walk.arena.equal(named, x)
                            let is_y = walk.arena.equal(named, y)
                            let first = walk.arena.and([c, is_x])
                            let not_c = walk.arena.not(c)
                            let second = walk.arena.and([not_c, is_y])
                            let fact = walk.arena.or([first, second])
                            scope.facts.push(fact)
                        },
                        else => {},
                    }
                },
                else => {},
            }
        },
        else => {},
    }
}

/// **What the ledger ensures of a collected list's length** (ADR-396 D4):
/// `let parts = s.split("/").collect()` has the parts `str::split` ensures,
/// `result.len() >= 1`, so `parts[parts.len() - 1]` is in bounds.
fn prover_collected_parts(mut walk: ProverWalk, name: ref String, value: ref Expr, mut scope: ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    match value {
        Expr::MethodCall { receiver, method, args, .. } => {
            if words.resolve(method) != "collect" || !args.is_empty() {
                return
            }
            match receiver {
                Expr::MethodCall { receiver: from, .. } => {
                    let key = walk.state.method_callees.get(id_of(from) as i64) ?? return
                    let contract = library.functions.get(key) ?? return
                    let counted = length_of(result_name())
                    let mut names: collections::BTreeSet[String] = collections::BTreeSet()
                    names.insert(counted.clone())
                    let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
                    given.insert(counted.clone(), walk.arena.var(length_of(name)))
                    for text in contract.ensures {
                        if !text.contains(counted) {
                            continue
                        }
                        let term = prover_condition_term(walk.arena, text, names, condition)
                        if term >= 0 {
                            let fact = walk.arena.substitute(term, given)
                            scope.facts.push(fact)
                        }
                    }
                },
                else => {},
            }
        },
        else => {},
    }
}

/// **Each call in a `let`'s value that hands back a whole number**, made a
/// name of the proof under `call_result_name` (ADR-314 D3): only what its
/// callee ensures is known of it, so it is loose. A call's arguments first, so
/// `f(g(2))` reads `g`'s result in `f`'s. `top` is the value itself, whose
/// call `prover_let` binds to the name it gives.
fn prover_call_results(mut walk: ProverWalk, expr: ref Expr, top: bool, mut scope: ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, unaliased: fn(ref String) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync, written_of: fn(ref Expr) -> String sync) {
    match expr {
        Expr::Binary { lhs, rhs, .. } => {
            prover_call_results(walk, lhs, false, scope, program, words, own, unaliased, condition, written_of)
            prover_call_results(walk, rhs, false, scope, program, words, own, unaliased, condition, written_of)
        },
        Expr::Unary { expr, .. } => prover_call_results(walk, expr, false, scope, program, words, own, unaliased, condition, written_of),
        Expr::Cast { expr, .. } => prover_call_results(walk, expr, false, scope, program, words, own, unaliased, condition, written_of),
        Expr::Call { func, args, config, .. } => {
            for arg in args {
                prover_call_results(walk, arg, false, scope, program, words, own, unaliased, condition, written_of)
            }
            if top {
                return
            }
            let callee = prover_bound_callee(func, scope, words, unaliased) ?? return
            if !prover_returns_whole(walk, callee, program, words, own, condition) {
                return
            }
            let name = call_result_name(expr)
            scope.rebind(walk.arena, name)
            let facts = prover_postconditions_of(walk, callee, args, config, name, scope, program, words, own, condition)
            scope.ints.insert(name.clone())
            scope.loose.insert(name.clone())
            for fact in facts {
                scope.facts.push(fact)
            }
            let alts = prover_summed(walk, callee, args, config, name, scope, program, words, written_of(expr))
            if alts != null {
                scope.summed.insert(name.clone(), alts ?? [])
            }
        },
        else => {},
    }
}

/// **Each divisor in `expr` that what is known pins to one value** (ADR-359
/// D6), recorded under `divisor_name` for the terms built next: a model gives
/// its value and a proof shows it is the only one - with what is known, and
/// where that leaves it open, with the summaries of the calls it reads (D2).
/// The notes say where a value that leaned on a summary came from (D8).
fn prover_pin_divisors(mut walk: ProverWalk, expr: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) -> Vec[String] {
    let mut notes: Vec[String] = []
    match expr {
        Expr::Binary { op, lhs, rhs, .. } => {
            notes.extend(prover_pin_divisors(walk, lhs, scope, words, ask, model))
            notes.extend(prover_pin_divisors(walk, rhs, scope, words, ask, model))
            if op != BinaryOp::Div && op != BinaryOp::Rem {
                return notes
            }
            let key = divisor_name(rhs)
            if walk.state.pinned.contains_key(key) {
                let said = walk.state.divisor_notes[key]?.clone() ?? []
                notes.extend(said)
                return notes
            }
            let d = lin_term(rhs, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return notes
            if walk.arena.constant(d) != null {
                return notes
            }
            walk.state.divisor_queries += 1
            let mut facts = scope.facts.clone()
            let mut pinned = prover_pinned_value(walk.arena, facts, d, ask, model)
            if pinned == null && !scope.summed.is_empty() {
                let here = walk.arena.equal(d, d)
                let read = summed_read(walk.arena, scope, here)
                if !read.is_empty() {
                    facts = summed_facts(walk.arena, scope, read)
                    walk.state.second_queries += 1
                    pinned = prover_pinned_value(walk.arena, facts, d, ask, model)
                    if pinned != null {
                        let mut said: Vec[String] = []
                        for bound in read {
                            let alts = scope.summed[bound] ?? continue
                            if alts.is_empty() {
                                continue
                            }
                            let mut whys: Vec[String] = []
                            for alt in alts {
                                whys.push(alt.why.clone())
                            }
                            said.push(f"`{alts[0].call}` is {pinned ?? 0}: {whys.join("; ")}.")
                        }
                        notes.extend(said.clone())
                        walk.state.divisor_notes.insert(key.clone(), said)
                    }
                }
            }
            if pinned != null {
                walk.state.pinned.insert(key, pinned ?? 0)
            }
        },
        Expr::Unary { expr, .. } => notes.extend(prover_pin_divisors(walk, expr, scope, words, ask, model)),
        Expr::Cast { expr, .. } => notes.extend(prover_pin_divisors(walk, expr, scope, words, ask, model)),
        else => {},
    }
    return notes
}

/// The one value `d` has where `facts` hold: a model's, proved the only one.
fn prover_pinned_value(mut arena: logic::TermArena, facts: ref Vec[i64], d: i64, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) -> i64? {
    let falsum = arena.boolean(false)
    let values = model(arena, facts, falsum) ?? return null
    let v = arena.int_value(d, values) ?? return null
    let constant = arena.int(v)
    let same = arena.equal(d, constant)
    return match ask(arena, facts, same) {
        SolverAnswer::Proved => v,
        else => null,
    }
}

/// **A call's summary at this call** (ADR-359 D2, D14): each exit of the
/// callee's result summary with the call's arguments in place of its
/// parameters, and a list parameter's length with the argument's. An exit
/// that reads a parameter whose argument the prover does not read (or that
/// reads the name the result is bound to) gives no fact; the others keep
/// theirs. Nothing where the callee has no summary.
fn prover_summed(mut walk: ProverWalk, callee: ref String, written: ref Vec[Expr], config: ref Vec[ConfigArg], bound: ref String, scope: ref ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext, call: String) -> Vec[SummaryAlt]? {
    let exits = walk.state.summaries[callee] ?? return null
    let function = prover_summed_function(program, words, callee) ?? return null
    let args = arguments_in_order(function, written, config, words)
    if function.params.len() != args.len() {
        return null
    }
    let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
    for k in 0..<args.len() {
        let term = lin_term(args[k], words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
        if term != null && !walk.arena.mentions(term ?? 0, bound) {
            given.insert(function.params[k].clone(), term ?? 0)
        }
        let length = length_given(walk.arena, words, args[k], scope, walk.state.pinned)
        if length != null && !walk.arena.mentions(length ?? 0, bound) {
            given.insert(length_of(function.params[k]), length ?? 0)
        }
    }
    let mut alts: Vec[SummaryAlt] = []
    for exit in exits {
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(exit.guard, read)
        walk.arena.variables(exit.value, read)
        let mut readable = true
        for name in read {
            if !given.contains_key(name) {
                readable = false
            }
        }
        if !readable {
            continue
        }
        let guard = walk.arena.substitute(exit.guard, given)
        let value = walk.arena.substitute(exit.value, given)
        alts.push(SummaryAlt { guard: guard, value: value, callee: callee.clone(), call: call.clone(), why: exit.written.clone() })
    }
    if alts.is_empty() {
        return null
    }
    return alts
}

/// **The function a summary's key names**: a free function, or `T::m`, the
/// method `m` of `T`'s own `impl` (ADR-359 D14).
fn prover_summed_function(program: ref Program, words: ref winnow_grammar::InternerContext, callee: ref String) -> FreeFunction? {
    let free = free_function(program, words, callee)
    if free != null {
        return free
    }
    let cut = callee.rfind("::") ?? return null
    let owner = callee[0..<cut].clone()
    let name = callee[cut + 2..<callee.len()].clone()
    return own_method(program, words, owner, name)
}

/// **`T::m` for a call `self.m(…)` in a method of `T`** (ADR-269 D5, #776),
/// the key of `T`'s own method; null for any other receiver.
fn prover_own_method_callee(receiver: ref Expr, method: winnow_grammar::Symbol, at: ref ProverWhere, words: ref winnow_grammar::InternerContext) -> String? {
    if (prover_variable_named(receiver, words) ?? "") != "self" {
        return null
    }
    let function = carrying_function(at.function) ?? return null
    let cut = function.rfind("::") ?? return null
    let owner = function[0..<cut].clone()
    return f"{owner}::{words.resolve(method)}"
}

/// **An exit of the function walked, as a summary's exit** (ADR-359 D1,
/// D14): the value handed back, each call in it read by its callee's
/// summary, carried to the entry with the path to it. Where that cannot be
/// done - a call without a summary or one that can come back here, a name
/// whose value at the entry is not known, more than the fixed term bound -
/// this exit gives no fact, and the function's other exits keep theirs:
/// each exit is a fact on its own path.
fn prover_sum_exit(mut walk: ProverWalk, value: ref Expr, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, unaliased: fn(ref String) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync, written_of: fn(ref Expr) -> String sync) {
    if walk.state.unsummed {
        return
    }
    let made = prover_summary_exits(walk, value, scope, at, program, words, own, unaliased, condition, written_of)
    for exit in made ?? [] {
        walk.state.summing.push(exit.clone())
    }
}

fn prover_summary_exits(mut walk: ProverWalk, value: ref Expr, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, unaliased: fn(ref String) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync, written_of: fn(ref Expr) -> String sync) -> Vec[SummaryExit]? {
    let function = carrying_function(at.function) ?? return null
    let path = copied_path(scope.path) ?? return null
    let mut here = scope.clone()
    prover_call_results(walk, value, false, here, program, words, own, unaliased, condition, written_of)
    let returned = lin_term(value, words, fn(name) { here.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, here, name) }, walk.arena.nodes) ?? return null
    let truth = walk.arena.boolean(true)
    let mut alts: Vec[SummaryAlt] = [SummaryAlt { guard: truth, value: returned, callee: "", call: "", why: f"`{function}` returns `{written_of(value)}`" }]
    // Each call's result replaced by what its callee's exits hand back - a
    // value may read a further call, `f(g(x))`, so a few rounds.
    for _ in 0..<4 {
        let mut next: Vec[SummaryAlt] = []
        let mut grew = false
        for alt in alts {
            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
            walk.arena.variables(alt.guard, read)
            walk.arena.variables(alt.value, read)
            let mut named: String? = null
            for name in read {
                if named == null && here.summed.contains_key(name) {
                    named = name.clone()
                }
            }
            if named == null {
                next.push(alt.clone())
                continue
            }
            grew = true
            let name = named ?? ""
            let inner = here.summed[name] ?? return null
            for c in inner {
                if c.callee == function || walk.state.reaches(c.callee, function) {
                    return null
                }
                let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
                given.insert(name.clone(), c.value)
                let v = walk.arena.substitute(alt.value, given)
                let g0 = walk.arena.substitute(alt.guard, given)
                let g = walk.arena.and([g0, c.guard])
                next.push(SummaryAlt { guard: g, value: v, callee: "", call: "", why: f"{alt.why}, {c.why}" })
            }
        }
        if next.len() > 8 {
            return null
        }
        alts = next
        if !grew {
            break
        }
    }
    let mut params = at.params.clone()
    params.insert(result_name())
    let mut out: Vec[SummaryExit] = []
    for alt in alts {
        let g = here.at_entry(walk.arena, alt.guard) ?? return null
        let v = here.at_entry(walk.arena, alt.value) ?? return null
        let mut parts = path.clone()
        prover_conjuncts(walk.arena, g, parts)
        let result = walk.arena.var(result_name())
        let equal = walk.arena.equal(result, v)
        let mut guard = walk.arena.boolean(true)
        let mut term = equal
        let guarded = !parts.is_empty()
        if parts.len() == 1 {
            guard = parts[0]
        } else if parts.len() > 1 {
            guard = walk.arena.and(parts)
        }
        if guarded {
            let not_taken = walk.arena.not(guard)
            term = walk.arena.or([not_taken, equal])
        }
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(term, read)
        for name in read {
            // Not a field of the receiver (#2231): a claim on one is a
            // precondition (ADR-269 D15), but a summary of it would stand
            // at a call `self.m()` past a change of the field.
            if !is_a_parameter(name, params) || name == "self" || name.starts_with("self.") {
                return null
            }
        }
        if walk.arena.size(term) > precondition_terms() {
            return null
        }
        out.push(SummaryExit { guard: guard, value: v, term: term, written: alt.why.clone() })
    }
    return out
}

/// The parts of a conjunction, each `true` left out, added to `parts`.
fn prover_conjuncts(arena: ref logic::TermArena, id: i64, mut parts: Vec[i64]) {
    match arena.at(id) {
        logic::SolverTerm::Bool(b) => {
            if !b {
                parts.push(id)
            }
        },
        logic::SolverTerm::And(inner) => {
            for part in inner {
                prover_conjuncts(arena, part, parts)
            }
        },
        else => parts.push(id),
    }
}

/// **Whether a body is one a summary reads every exit of** (ADR-359 D1):
/// `let`s, `comptime`s, `return`s and `if`s around them, with no loop, no
/// assignment, no `match`, no block or lambda inside an expression - so
/// every `return` is one the walk reaches with the path to it.
fn prover_summable(block: ref Block) -> bool {
    for stmt in block.stmts {
        let fine = match stmt.node {
            Stmt::Let { value, .. } => prover_plain(value),
            Stmt::Comptime { .. } => true,
            Stmt::Return(value) => prover_plain_maybe(value),
            Stmt::Expr(expr) => match expr {
                Expr::If { cond, then_branch, else_branch, .. } => prover_plain(cond) && prover_summable(then_branch) && prover_summable_maybe(else_branch),
                else => prover_plain(expr),
            },
            else => false,
        }
        if !fine {
            return false
        }
    }
    return true
}

fn prover_summable_maybe(block: ref Block?) -> bool {
    let b = block ?? return true
    return prover_summable(b)
}

fn prover_plain_maybe(expr: ref Expr?) -> bool {
    let e = expr ?? return true
    return prover_plain(e)
}

/// An expression with no block, lambda, `match`, jump or `?` inside. A
/// field or an element read is plain: an exit whose value or path reads one
/// gives no fact, and the other exits keep theirs (ADR-359 D14, #1904).
fn prover_plain(expr: ref Expr) -> bool {
    return match expr {
        Expr::LitInt { .. } => true,
        Expr::LitBool(_, _) => true,
        Expr::LitStr { .. } => true,
        Expr::Variable(_, _) => true,
        Expr::Path(_, _) => true,
        Expr::Unary { expr, .. } => prover_plain(expr),
        Expr::Cast { expr, .. } => prover_plain(expr),
        Expr::Binary { lhs, rhs, .. } => prover_plain(lhs) && prover_plain(rhs),
        Expr::Field { base, .. } => prover_plain(base),
        Expr::Index { base, index, .. } => prover_plain(base) && prover_plain(index),
        Expr::Call { func, args, config, .. } => config.is_empty() && prover_plain(func) && prover_all_plain(args),
        Expr::MethodCall { receiver, args, config, .. } => config.is_empty() && prover_plain(receiver) && prover_all_plain(args),
        else => false,
    }
}

fn prover_all_plain(exprs: ref Vec[Expr]) -> bool {
    for e in exprs {
        if !prover_plain(e) {
            return false
        }
    }
    return true
}

/// **Each name of `fills` is outside from here** (#2371), with the source
/// it names.
fn prover_filled(mut scope: ProverScope, fills: ref collections::BTreeMap[String, String]) {
    for (n, source) in fills {
        scope.tainted.insert(n.clone())
        scope.joined.remove(n)
        if !source.is_empty() {
            scope.sources.insert(n.clone(), source.clone())
        }
    }
}

/// A `for`: a range's binding is bounded by its ends, every other binding is
/// a name nothing pins. A `for` over a range whose turn changes whole numbers
/// the walk follows is the `while` it means (ADR-361 D1): read past it
/// through its invariant; over anything else what it changes is unknown.
fn prover_for(mut walk: ProverWalk, bindings: ref Vec[winnow_grammar::Symbol], mutable: bool, iter: ref Expr, body: ref Block, span: Span, mut scope: ProverScope, at: ref ProverWhere, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    prover_expr(walk, iter, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    let tainted = from_outside(iter, scope.tainted, words, library, walk.state, holes_of)
    // What a turn changes is unknown at its head and past the loop.
    let mut changed = assigned_in(body, words)
    prover_lengths_changed(changed, body, scope, walk.state.readers, words)
    prover_loop_elements(walk, body, bindings, scope, words)
    let mut state: Vec[String] = []
    let mut records: Vec[LoopRecord] = []
    if bindings.len() == 1 {
        let counter = words.resolve(bindings[0]).clone()
        match iter {
            Expr::Range { start, end, inclusive, .. } => {
                for n in changed {
                    if scope.mutables.contains(n) && scope.ints.contains(n) && prover_length_follows(n, iter, body, walk.state.readers, words) {
                        state.push(n.clone())
                    }
                }
                let low = lin_term(start, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                let high = lin_term(end, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                // The end is reached once, before the first turn: a bound
                // that reads what a turn changes is not the `while`'s, and a
                // binding that shadows a whole number is not stated.
                let mut fits = !state.is_empty() && low != null && high != null && !scope.ints.contains(counter) && !changed.contains(counter)
                if fits {
                    for n in changed {
                        if walk.arena.mentions(high ?? 0, n) {
                            fits = false
                        }
                    }
                }
                if fits {
                    let mut ints = scope.ints.clone()
                    ints.insert(counter.clone())
                    let record = loop_record_range(walk.arena, span.start as i64, state, scope.facts, ints, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, counter, low ?? 0, high ?? 0, inclusive, body, words, walk.claims, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of)
                    if record != null {
                        records.push(record ?? return)
                    }
                }
            },
            else => {},
        }
    }
    let kept_bits = prover_loop_bits(walk, scope, changed, body, words)
    let mut inner = scope.clone()
    for n in changed {
        if prover_loop_keeps(n, changed, body, scope, words) {
            continue
        }
        inner.rebind(walk.arena, n)
        scope.rebind(walk.arena, n)
        prover_relength(walk, n, inner)
        prover_relength(walk, n, scope)
    }
    for n in state {
        inner.ints.insert(n.clone())
        inner.loose.insert(n.clone())
        scope.ints.insert(n.clone())
        scope.loose.insert(n.clone())
    }
    for (n, bits) in kept_bits {
        inner.bounded_bits(walk.arena, n, bits)
        scope.bounded_bits(walk.arena, n, bits)
    }
    scope.loops.extend(records.clone())
    if !changed.is_empty() {
        scope.exact = false
    }
    let carried = carried_param(iter, scope, words, library, walk.state, holes_of)
    for binding in bindings {
        let n = words.resolve(binding).clone()
        inner.rebind(walk.arena, n)
        inner.maps.remove(n)
        inner.carry(n, carried)
        if tainted {
            let source = outside_source(iter, scope.tainted, scope.sources, words, library, walk.state, holes_of)
            if source != null {
                inner.sources.insert(n.clone(), source ?? "")
            }
            inner.tainted.insert(n)
        }
    }
    // **An element with a length has one** (ADR-396 D4): `for line in
    // s.split("\n")` knows `line.len()`, of which nothing more is known.
    // Not a `for mut` element: the walk does not follow what its body
    // changes in it, as a `mut` parameter's fields (#1624).
    if bindings.len() == 1 && !mutable {
        match walk.state.whole_lets.get(span.start as i64) {
            null => {},
            element => {
                if has_a_length(element) {
                    inner.has_length(walk.arena, words.resolve(bindings[0]), null)
                } else {
                    // **A struct element has its fields' names** (ADR-396
                    // D4), as a call's result has.
                    let kind = element.clone()
                    let mut not_params: collections::BTreeSet[String] = collections::BTreeSet()
                    prover_parameter_fields(walk, inner, not_params, words.resolve(bindings[0]), kind, false, program, words)
                }
            },
        }
    }
    let mut ranged = false
    if bindings.len() == 1 {
        match iter {
            Expr::Range { start, end, inclusive, .. } => {
                let low = lin_term(start, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                let high = lin_term(end, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                if low != null && high != null {
                    ranged = true
                    let name = words.resolve(bindings[0]).clone()
                    inner.ints.insert(name.clone())
                    let lo = low ?? 0
                    let hi = high ?? 0
                    // low <= n, and n <= high (inclusive) or n < high - unless
                    // a bound reads the name it shadows, as `let` above.
                    if !walk.arena.mentions(lo, name) && !walk.arena.mentions(hi, name) {
                        let n = walk.arena.var(name)
                        let above = walk.arena.le(lo, n)
                        inner.facts.push(above)
                        if inclusive {
                            let below = walk.arena.le(n, hi)
                            inner.facts.push(below)
                        } else {
                            let below = walk.arena.lt(n, hi)
                            inner.facts.push(below)
                        }
                    } else {
                        inner.loose.insert(name.clone())
                    }
                    // **Every value of the range reaches the body** only where
                    // no turn can end the loop early: after a `break` the
                    // values left are never reached.
                    if leaves_block(body, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, false) {
                        inner.loose.insert(name)
                    }
                }
            },
            else => {},
        }
    }
    // **An `enumerate`'s index counts from zero** (ADR-396 D2, #2371):
    // `for (k, x) in xs.iter().enumerate()` knows `0 <= k`, so a guard
    // `k < other.len()` proves `other[k]`; nothing pins `k` more.
    if bindings.len() >= 2 {
        match iter {
            Expr::MethodCall { method, args, .. } => {
                if words.resolve(method) == "enumerate" && args.is_empty() {
                    let name = words.resolve(bindings[0]).clone()
                    inner.ints.insert(name.clone())
                    let n = walk.arena.var(name)
                    let zero = walk.arena.int(0)
                    let above = walk.arena.le(zero, n)
                    inner.facts.push(above)
                }
            },
            else => {},
        }
    }
    if !ranged {
        for binding in bindings {
            inner.loose.insert(words.resolve(binding).clone())
        }
    }
    prover_turn_ties(walk, inner, records)
    // A claim in a loop, or after one, is not carried back to the entry
    // (D16): that needs an invariant.
    inner.path = null
    prover_block(walk, body, inner, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    scope.path = null
    if leaves_block(body, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, false) {
        scope.exact = false
    }
}

/// A `return`: an exit of the function, where its postconditions are asked.
fn prover_return(mut walk: ProverWalk, value: ref Expr?, span: Span, scope: ref ProverScope, at: ref ProverWhere, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    let returned = value ?? return
    prover_expr(walk, returned, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    walk.state.exit(walk.arena, returned, words, scope, at.function, !at.lambda && at.posts, at.params, ask)
    // `walk.state.unsummed` says which bodies are summed (ADR-359 D14): a
    // method's too, unless a trait's call can reach it.
    if !at.lambda {
        prover_sum_exit(walk, returned, scope, at, program, words, own, unaliased, condition, written_of)
    }
}

/// An expression standing as a statement: an `assert`, an `if` whose
/// branches teach the rest of the block something, or anything else.
fn prover_expr_stmt(mut walk: ProverWalk, expr: ref Expr, span: Span, mut scope: ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> bool {
    let nested = at.inside(false)
    match expr {
        Expr::Call { func, args, config, .. } => {
            if prover_an_assert_call(func, args, span, walk.claims) {
                let cond = args[0]
                // **A type's rule holds where a value of it is read** (ADR-369
                // D3): a fact, never a claim to prove or check.
                prover_read_properties(cond, scope, walk.state, program, words)
                if prover_a_given_rule(config, words) {
                    let given = claim_term(cond, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                    if given != null {
                        scope.facts.push(given ?? 0)
                        prover_properties_from(cond, f"the rule of `{prover_rule_type(config, words)}`", scope, walk.state, program, words)
                    }
                    walk.held.insert((span.start as i64, node_key(cond)), ClaimHeld::Proved)
                    return false
                }
                // **An `assume` is a fact from where it stands** (ADR-376 D1),
                // as a proved `assert` is, and never a goal.
                if prover_an_assume(func, words) {
                    prover_expr(walk, cond, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                    let vouched = claim_term(cond, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                    if vouched != null {
                        scope.facts.push(vouched ?? 0)
                    }
                    walk.held.insert((span.start as i64, node_key(cond)), ClaimHeld::Proved)
                    return false
                }
                prover_expr(walk, cond, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                // The `message:` a failure says, where it is text as written:
                // a precondition checked elsewhere says it too.
                let message = prover_message(config, words)
                let names = prover_without_callees(claim_names_in(cond, words, holes_of), cond, scope, walk.state, program, words)
                let mut leaned: Vec[String] = []
                if !walk.state.in_test {
                    // **A call inside the claim is a whole number of its own**,
                    // as inside a `let`'s value (ADR-314 D3): its callee's
                    // postconditions hold of it, and its summary answers a
                    // claim what is known leaves open (ADR-359 D2).
                    prover_call_results(walk, cond, false, scope, program, words, own, unaliased, condition, written_of)
                    leaned = prover_pin_divisors(walk, cond, scope, words, ask, model)
                    leaned.extend(leaned_notes(walk.arena, scope, names))
                }
                let outcome = walk.state.an_assert(walk.arena, words, cond, written_of(cond), names, message, span, scope, at, ask, model)
                let mut held = outcome.held.clone()
                // **A claim proved by a named property says where it is known
                // from** (ADR-381 D2); from here the claim is a source itself.
                let from = prover_known_from(cond, scope, walk.state, program, words)
                let plain = match held {
                    ClaimHeld::Proved => true,
                    else => false,
                }
                if from != null && plain {
                    held = ClaimHeld::ProvedThrough(f"proved: known from {from ?? ""}")
                }
                prover_properties_from(cond, f"`assert({written_of(cond)})`", scope, walk.state, program, words)
                let mut findings: Vec[Finding] = []
                for found in outcome.findings {
                    let mut one = found.clone()
                    if one.code == "NK1207" {
                        for note in leaned {
                            if !one.notes.contains(note) {
                                one.notes.push(note.clone())
                            }
                        }
                    }
                    findings.push(one)
                }
                if !walk.state.in_test {
                    let read = prover_known_calls(walk, cond, scope, program, words, own, holes_of, unaliased, condition)
                    if !read.is_empty() {
                        let ran = prover_claim_ran(walk, read, held, findings, written_of(cond), span, written_of)
                        held = ran.held
                        findings = ran.findings
                    }
                }
                walk.held.insert((span.start as i64, node_key(cond)), held)
                for found in findings {
                    walk.findings.push(found.clone())
                }
                return false
            }
            // **`panic(…)` does not come back** (#776): a body that ends in
            // one has no exit there.
            let panics = match func {
                Expr::Variable(name, _) => words.resolve(name) == "panic" && !scope.locals.contains("panic"),
                else => false,
            }
            if panics {
                prover_expr(walk, expr, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                return true
            }
        },
        Expr::If { cond, then_branch, else_branch, .. } => {
            return prover_if(walk, cond, then_branch, else_branch, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Match { value, arms, .. } => {
            return prover_match(walk, value, arms, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Throw(value, _) => {
            prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            return true
        },
        Expr::Return(value, _) => {
            prover_return(walk, value, span, scope, at, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            return true
        },
        Expr::Break(_) => return true,
        Expr::Continue(_) => return true,
        // **An `assume` holds past the `unsafe` around it** (ADR-376 D1):
        // the block's own walk is blind, and what it vouches for is the
        // function's from here on.
        Expr::Unsafe(block, _) => {
            prover_expr(walk, expr, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for cond in prover_assumed_in_unsafe(block, words) {
                // **A named property it vouches for is known** (ADR-381
                // D2): a name of the proof, as after an `assert`.
                prover_read_properties(cond, scope, walk.state, program, words)
                let vouched = claim_term(cond, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                if vouched != null {
                    scope.facts.push(vouched ?? 0)
                    prover_properties_from(cond, f"`assume({written_of(cond)})`", scope, walk.state, program, words)
                }
            }
            return false
        },
        else => {},
    }
    prover_expr(walk, expr, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    return false
}

/// An `if` as a statement: each branch knows its condition, and what a
/// branch that always leaves rules out holds after it.
fn prover_if(mut walk: ProverWalk, cond: ref Expr, then_branch: ref Block, else_branch: ref Block?, span: Span, mut scope: ProverScope, at: ref ProverWhere, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> bool {
    prover_expr(walk, cond, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    prover_condition_lengths(walk, cond, scope, words)
    // **A guard on a named property makes it known** (ADR-381 D2): `return
    // if !p(xs)` leaves `p(xs)` after it, as a comparison's guard does.
    prover_read_properties(cond, scope, walk.state, program, words)
    let holds = claim_term(cond, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
    let mut fails: i64? = null
    if holds != null {
        fails = walk.arena.not(holds ?? 0)
    }
    let then_facts = prover_branch_facts(walk, cond, scope, words, true, holds)
    let else_facts = prover_branch_facts(walk, cond, scope, words, false, fails)
    let mut then_scope = scope.clone()
    then_scope.facts.extend(then_facts.clone())
    if holds != null {
        then_scope.guards.insert(holds ?? 0, (span.start as i64, written_of(cond)))
    }
    // A branch on a condition the prover cannot read is reached by some
    // states and not others, and no fact says which.
    then_scope.exact = then_scope.exact && holds != null
    let cond_leaves = leaves_expr(cond, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true)
    then_scope.on_the_path(walk.arena, holds)
    let then_leaves = prover_block(walk, then_branch, then_scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    let mut else_scope = scope.clone()
    let else_leaves = prover_else(walk, else_branch, else_scope, fails, else_facts, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    if !(then_leaves && else_leaves) {
        prover_join(walk, scope, then_scope, then_leaves, then_branch, else_scope, else_leaves, else_branch, span, words)
    }
    // **What a branch that always leaves rules out** holds after it: `return
    // 250 if speed > 250` leaves `speed <= 250`.
    if then_leaves && else_leaves {
        return true
    }
    if then_leaves {
        scope.facts.extend(else_facts)
        if fails != null {
            scope.guards.insert(fails ?? 0, (span.start as i64, written_of(cond)))
            prover_properties_from(cond, f"the guard `if {written_of(cond)}`", scope, walk.state, program, words)
        }
        scope.on_the_path(walk.arena, fails)
        scope.exact = scope.exact && fails != null && !prover_else_leaves(else_branch, at, program, words, own, library, holes_of, unaliased)
    } else if else_leaves {
        scope.facts.extend(then_facts)
        if holds != null {
            scope.guards.insert(holds ?? 0, (span.start as i64, written_of(cond)))
            prover_properties_from(cond, f"the guard `if {written_of(cond)}`", scope, walk.state, program, words)
        }
        scope.on_the_path(walk.arena, holds)
        scope.exact = scope.exact && holds != null && !leaves_block(then_branch, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true)
    } else if leaves_block(then_branch, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true) || prover_else_leaves(else_branch, at, program, words, own, library, holes_of, unaliased) {
        scope.exact = false
    }
    if cond_leaves {
        scope.exact = false
    }
    return false
}

/// **The facts a branch on `cond` knows**: `whole`, the condition (or its
/// negation, `holds` false) where the prover reads it, else what it reads of
/// its parts (`claim_parts`, #1576).
fn prover_branch_facts(mut walk: ProverWalk, cond: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, holds: bool, whole: i64?) -> Vec[i64] {
    if whole != null {
        return [whole ?? 0]
    }
    return prover_condition_parts(walk, cond, holds, scope, words)
}

/// **What the prover reads of a condition's parts** (`claim_parts`, #1576),
/// where it holds (`holds`) or fails: a name a `let` bound to a condition
/// stands for what that condition made known (#1664).
fn prover_condition_parts(mut walk: ProverWalk, cond: ref Expr, holds: bool, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> Vec[i64] {
    match cond {
        Expr::Unary { op, expr, .. } => {
            if op == UnaryOp::Not {
                return prover_condition_parts(walk, expr, !holds, scope, words)
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            if (op == BinaryOp::And && holds) || (op == BinaryOp::Or && !holds) {
                let mut parts = prover_condition_parts(walk, lhs, holds, scope, words)
                parts.extend(prover_condition_parts(walk, rhs, holds, scope, words))
                return parts
            }
        },
        Expr::Variable(name, _) => {
            let n = words.resolve(name)
            if holds {
                return scope.held[n]?.clone() ?? []
            }
            return scope.failed[n]?.clone() ?? []
        },
        else => {},
    }
    return claim_parts(cond, holds, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
}

/// **A condition bound by a `let`** (#1664): `let ok = xs.len() == 1 &&
/// f(x)` keeps what `ok` makes known where it holds and where it fails, so
/// that `if ok` knows `xs.len() == 1`. Only over names no assignment changes
/// (not the walk's mutable whole numbers), so the facts stay true while the
/// name stands; one the facts read bound again drops them (`rebind`).
fn prover_bind_condition(mut walk: ProverWalk, n: ref String, value: ref Expr, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) {
    let a_condition = match value {
        Expr::Unary { op, .. } => op == UnaryOp::Not,
        Expr::Binary { op, .. } => op == BinaryOp::And || op == BinaryOp::Or || op == BinaryOp::Eq || op == BinaryOp::Ne || op == BinaryOp::Lt || op == BinaryOp::Le || op == BinaryOp::Gt || op == BinaryOp::Ge,
        else => false,
    }
    if !a_condition {
        return
    }
    let held = prover_condition_parts(walk, value, true, scope, words)
    let failed = prover_condition_parts(walk, value, false, scope, words)
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    for fact in held {
        walk.arena.variables(fact, read)
    }
    for fact in failed {
        walk.arena.variables(fact, read)
    }
    let length = length_of(n)
    for name in read {
        if scope.mutables.contains(name) || name == n || name == length {
            return
        }
    }
    if !held.is_empty() {
        scope.held.insert(n.clone(), held)
    }
    if !failed.is_empty() {
        scope.failed.insert(n.clone(), failed)
    }
}

/// An `else` branch, walked knowing its condition failed (`known`, what the
/// prover reads of that); whether it always leaves. No branch never leaves.
fn prover_else(mut walk: ProverWalk, else_branch: ref Block?, mut else_scope: ProverScope, fails: i64?, known: ref Vec[i64], nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> bool {
    else_scope.facts.extend(known.clone())
    let block = else_branch ?? return false
    else_scope.exact = else_scope.exact && fails != null
    else_scope.on_the_path(walk.arena, fails)
    return prover_block(walk, block, else_scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// **The mutable whole numbers after an `if` that changes them** (ADR-361
/// D9): each is one side's value or the other's, as the condition says - an
/// `if` without `else` keeping the old value on the other side. What was
/// known of the old value is kept under a name of its own (`x#12`, the
/// `if`'s byte), and each side that goes on past the `if` adds what it made
/// known over the names that live past it. One the walk stops following on
/// either side is bound again.
fn prover_join(mut walk: ProverWalk, mut scope: ProverScope, then_scope: ref ProverScope, then_leaves: bool, then_branch: ref Block, else_scope: ref ProverScope, else_leaves: bool, else_branch: ref Block?, span: Span, words: ref winnow_grammar::InternerContext) sync {
    if scope.mutables.is_empty() {
        return
    }
    let mut then_assigns = assigned_in(then_branch, words)
    prover_lengths_changed(then_assigns, then_branch, scope, walk.state.readers, words)
    let mut else_assigns = prover_else_assigns(else_branch, words)
    prover_else_lengths_changed(else_assigns, else_branch, scope, walk.state.readers, words)
    if !prover_changes_followed(scope, then_assigns) && !prover_changes_followed(scope, else_assigns) {
        return
    }
    let sides = [
        ProverArm { scope: then_scope.clone(), leaves: then_leaves, assigns: then_assigns, own: prover_own_names(then_branch, words), tag: f"{span.start}t" },
        ProverArm { scope: else_scope.clone(), leaves: else_leaves, assigns: else_assigns, own: prover_else_own_names(else_branch, words), tag: f"{span.start}e" },
    ]
    prover_join_arms(walk, scope, sides, span)
}

/// One side of a branch, as the join reads it: the scope it ends with,
/// whether it always leaves, the names it assigns, the names its own block
/// binds, and the tag its own names are renamed apart with.
struct ProverArm {
    scope: ProverScope,
    leaves: bool,
    assigns: collections::BTreeSet[String],
    own: collections::BTreeSet[String],
    tag: String,
}

/// Whether `assigns` holds a mutable whole number the walk follows.
fn prover_changes_followed(scope: ref ProverScope, assigns: ref collections::BTreeSet[String]) -> bool sync {
    for n in assigns {
        if scope.mutables.contains(n) {
            return true
        }
    }
    return false
}

/// **The mutable whole numbers after a branch of any number of sides** - an
/// `if`'s two, a `match`'s arms (ADR-361 D9, #1021): each is one side's value
/// or another's. A side that always leaves drops out.
fn prover_join_arms(mut walk: ProverWalk, mut scope: ProverScope, sides: ref Vec[ProverArm], span: Span) sync {
    let mut changed: Vec[String] = []
    for side in sides {
        for n in side.assigns {
            if scope.mutables.contains(n) && !changed.contains(n) {
                changed.push(n.clone())
            }
        }
    }
    if changed.is_empty() {
        return
    }
    // Which of them every side that goes on still follows.
    let mut followed: Vec[String] = []
    let mut dropped: collections::BTreeSet[String] = collections::BTreeSet()
    for n in changed {
        let mut on_all = true
        for side in sides {
            if !side.leaves && !side.scope.ints.contains(n) {
                on_all = false
            }
        }
        if on_all {
            followed.push(n.clone())
        } else {
            dropped.insert(n.clone())
        }
    }
    // What the walk knew before the `if`, which each side's own additions
    // are told apart from.
    let mut before: collections::BTreeSet[i64] = collections::BTreeSet()
    before.extend(scope.facts.clone())
    before.extend(scope.history.clone())
    let outer = scope.ints.clone()
    for n in dropped {
        scope.rebind(walk.arena, n)
    }
    let mut earlier: collections::BTreeMap[String, String] = collections::BTreeMap()
    for n in followed {
        let old = f"{n}#{span.start}"
        scope.renamed(walk.arena, n, old)
        earlier.insert(n.clone(), old)
    }
    let mut terms: Vec[i64] = []
    for side in sides {
        if !side.leaves {
            terms.push(prover_side(walk.arena, side.scope, side.own, before, outer, dropped, earlier, side.assigns, side.tag))
        }
    }
    if !followed.is_empty() && !terms.is_empty() {
        if terms.len() == 1 {
            scope.history.push(terms[0])
        } else {
            scope.history.push(walk.arena.or(terms))
        }
    }
    for n in followed {
        scope.ints.insert(n.clone())
        for side in sides {
            if !side.leaves && side.scope.loose.contains(n) {
                scope.loose.insert(n.clone())
            }
            if !side.leaves && side.scope.tainted.contains(n) {
                scope.tainted.insert(n.clone())
                let source = side.scope.sources[n]?.clone()
                if source != null {
                    scope.sources.insert(n.clone(), source ?? "")
                }
            }
        }
    }
    scope.exact = false
}

/// **A `match` as a statement** (ADR-361 D9, #1021), walked as an `if` of
/// many sides: each arm knows what its pattern says of the matched value -
/// `true` or `false` of a condition the prover reads, a whole-number literal
/// or range of a whole number it reads, nothing else - and the arms that go
/// on are joined. A guard is walked for its calls and gives no fact. Whether
/// control never goes past it.
fn prover_match(mut walk: ProverWalk, value: ref Expr, arms: ref Vec[MatchArm], span: Span, mut scope: ProverScope, at: ref ProverWhere, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> bool sync {
    prover_expr(walk, value, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    prover_condition_lengths(walk, value, scope, words)
    let cond_leaves = leaves_expr(value, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true)
    let truth = claim_term(value, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
    let number = lin_term(value, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
    let mut sides: Vec[ProverArm] = []
    let mut going = 0
    let mut lone: i64? = null
    let mut lone_exact = false
    let mut partly_leaves = false
    let mut seen_true = false
    let mut seen_false = false
    for arm in arms {
        let mut fact = prover_pattern_fact(walk.arena, arm.pattern, truth, number, words)
        let literal = prover_bool_literal(arm.pattern)
        // A catch-all arm of a `bool` match is the value the arms above it
        // without a guard left.
        if fact == null && truth != null && literal == null && prover_catch_all(arm.pattern) {
            if seen_true && !seen_false {
                fact = walk.arena.not(truth ?? 0)
            } else if seen_false && !seen_true {
                fact = truth
            }
        }
        if arm.guard == null && literal != null {
            if literal ?? false {
                seen_true = true
            } else {
                seen_false = true
            }
        }
        let mut arm_scope = scope.clone()
        let mut bound: collections::BTreeSet[String] = collections::BTreeSet()
        prover_pattern_names(arm.pattern, words, bound)
        for name in bound {
            arm_scope.rebind(walk.arena, name)
            arm_scope.maps.remove(name)
        }
        if fact != null {
            arm_scope.facts.push(fact ?? 0)
        }
        arm_scope.exact = arm_scope.exact && fact != null && arm.guard == null
        if arm.guard == null {
            arm_scope.on_the_path(walk.arena, fact)
        } else {
            arm_scope.on_the_path(walk.arena, null)
        }
        prover_arm_guard(walk, arm.guard, span, arm_scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        let leaves = prover_arm_body(walk, arm.body, span, arm_scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        let may_leave = leaves_expr(arm.body, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true)
        if !leaves {
            going += 1
            lone = fact
            lone_exact = fact != null && arm.guard == null && !may_leave
            if may_leave {
                partly_leaves = true
            }
        }
        let mut assigns = prover_arm_assigns(arm.body, words)
        prover_arm_lengths_changed(assigns, arm.body, scope, walk.state.readers, words)
        let mut own_names = prover_arm_own_names(arm.body, words)
        own_names.extend(bound)
        sides.push(ProverArm { scope: arm_scope, leaves: leaves, assigns: assigns, own: own_names, tag: f"{span.start}a{sides.len()}" })
    }
    if going == 0 && !arms.is_empty() {
        return true
    }
    if !scope.mutables.is_empty() {
        prover_join_arms(walk, scope, sides, span)
    }
    // **What the arms that always leave rule out** holds after the `match`,
    // where one arm alone goes on: its pattern's fact.
    if going == 1 && going < arms.len() {
        if lone != null {
            scope.facts.push(lone ?? 0)
        }
        scope.on_the_path(walk.arena, lone)
        scope.exact = scope.exact && lone_exact
    } else if going < arms.len() || partly_leaves {
        scope.exact = false
    }
    if cond_leaves {
        scope.exact = false
    }
    return false
}

/// A guard, if the arm has one, walked for what it calls.
fn prover_arm_guard(mut walk: ProverWalk, guard: ref Expr?, span: Span, scope: ref ProverScope, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) sync {
    let present = guard ?? return
    prover_expr(walk, present, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// An arm's body: a block walked as a branch is, any other expression as a
/// statement; whether it always leaves.
fn prover_arm_body(mut walk: ProverWalk, body: ref Expr, span: Span, mut scope: ProverScope, nested: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> bool sync {
    return match body {
        Expr::Block(block, _) => prover_block(walk, block, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::AsyncGroup(block, _, _, _, _) => prover_block(walk, block, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        else => prover_expr_stmt(walk, body, span, scope, nested, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
    }
}

/// Every name an arm's body assigns.
fn prover_arm_assigns(body: ref Expr, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] sync {
    return match body {
        Expr::Block(block, _) => assigned_in(block, words),
        Expr::AsyncGroup(block, _, _, _, _) => assigned_in(block, words),
        else => assigned_in_expr(body, words),
    }
}

/// The followed list lengths an arm's body may change.
fn prover_arm_lengths_changed(mut changed: collections::BTreeSet[String], body: ref Expr, scope: ref ProverScope, readers: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) sync {
    match body {
        Expr::Block(block, _) => prover_lengths_changed(changed, block, scope, readers, words),
        Expr::AsyncGroup(block, _, _, _, _) => prover_lengths_changed(changed, block, scope, readers, words),
        else => {
            for m in scope.mutables {
                if m.ends_with(".len()") && changes_length_in_expr(body, (m.strip_suffix(".len()") ?? "").clone(), readers, words) {
                    changed.insert(m.clone())
                }
            }
        },
    }
}

/// The names an arm's block binds, if its body is one.
fn prover_arm_own_names(body: ref Expr, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] sync {
    return match body {
        Expr::Block(block, _) => prover_own_names(block, words),
        Expr::AsyncGroup(block, _, _, _, _) => prover_own_names(block, words),
        else => collections::BTreeSet(),
    }
}

/// **What a pattern says of the matched value**: `true` or `false` of a
/// condition the prover reads (`truth`), a whole-number literal or an
/// inclusive range of a whole number it reads (`number`), an or-pattern of
/// such; else nothing.
fn prover_pattern_fact(mut arena: logic::TermArena, pattern: ref MatchPattern, truth: i64?, number: i64?, words: ref winnow_grammar::InternerContext) -> i64? sync {
    return match pattern {
        MatchPattern::Literal(lit) => {
            let literal = prover_bool_literal(pattern)
            if literal != null {
                let t = truth ?? return null
                if literal ?? false {
                    return t
                }
                return arena.not(t)
            }
            let v = number ?? return null
            let l = lin_term(lit, words, fn(name) { false }, fn(name) { null }, arena.nodes) ?? return null
            arena.equal(v, l)
        },
        MatchPattern::Range { start, end } => {
            let v = number ?? return null
            let low = lin_term(start, words, fn(name) { false }, fn(name) { null }, arena.nodes) ?? return null
            let high = lin_term(end, words, fn(name) { false }, fn(name) { null }, arena.nodes) ?? return null
            let above = arena.le(low, v)
            let below = arena.le(v, high)
            arena.and([above, below])
        },
        MatchPattern::Or(alternatives) => {
            let mut parts: Vec[i64] = []
            for alternative in alternatives {
                parts.push(prover_pattern_fact(arena, alternative, truth, number, words) ?? return null)
            }
            arena.or(parts)
        },
        else => null,
    }
}

/// The `true` or `false` a pattern is, if it is one.
fn prover_bool_literal(pattern: ref MatchPattern) -> bool? sync {
    return match pattern {
        MatchPattern::Literal(lit) => match lit {
            Expr::LitBool(value, _) => value,
            else => null,
        },
        else => null,
    }
}

/// Whether a pattern takes every value: `else`, or a bare name.
fn prover_catch_all(pattern: ref MatchPattern) -> bool sync {
    return match pattern {
        MatchPattern::Otherwise => true,
        MatchPattern::Path(segments) => segments.len() == 1,
        else => false,
    }
}

/// Every name a pattern may bind: a bare name counts, which binds again
/// at worst a name the walk did not need.
fn prover_pattern_names(pattern: ref MatchPattern, words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[String]) sync {
    match pattern {
        MatchPattern::Path(segments) => {
            if segments.len() == 1 {
                out.insert(words.resolve(segments[0]).clone())
            }
        },
        MatchPattern::RestNamed(name) => {
            out.insert(words.resolve(name).clone())
        },
        MatchPattern::Tuple { parts, .. } => {
            for p in parts {
                prover_pattern_names(p, words, out)
            }
        },
        MatchPattern::List(parts) => {
            for p in parts {
                prover_pattern_names(p, words, out)
            }
        },
        MatchPattern::Named { fields, .. } => {
            for field in fields {
                prover_pattern_names(field.pat, words, out)
            }
        },
        MatchPattern::Or(alternatives) => {
            for p in alternatives {
                prover_pattern_names(p, words, out)
            }
        },
        else => {},
    }
}

/// **What one side of an `if` adds**, as one term: the facts it made known,
/// but none that reads a name the walk stops following, and, for each
/// followed name the side does not assign, that it is still its old value. A
/// name that does not live past the `if` - one its own block binds - is
/// renamed apart (`low#12t`, `tag` naming the side): what it bounds of the
/// names that live on is kept (ADR-361 D9, #1009).
fn prover_side(mut arena: logic::TermArena, side: ref ProverScope, own: ref collections::BTreeSet[String], before: ref collections::BTreeSet[i64], outer: ref collections::BTreeSet[String], dropped: ref collections::BTreeSet[String], earlier: ref collections::BTreeMap[String, String], assigns: ref collections::BTreeSet[String], tag: ref String) -> i64 sync {
    let mut parts: Vec[i64] = []
    for fact in side.with_history() {
        if before.contains(fact) {
            continue
        }
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        arena.variables(fact, read)
        let mut lives = true
        let mut apart: collections::BTreeMap[String, i64] = collections::BTreeMap()
        for name in read {
            if name.contains("#") {
                continue
            }
            if dropped.contains(name) {
                lives = false
            } else if !outer.contains(name) || own.contains(name) {
                apart.insert(name.clone(), arena.var(f"{name}#{tag}"))
            }
        }
        if lives && apart.is_empty() {
            parts.push(fact)
        } else if lives {
            parts.push(arena.substitute(fact, apart))
        }
    }
    for (n, old) in earlier {
        if !assigns.contains(n) {
            let now = arena.var(n)
            let then = arena.var(old)
            parts.push(arena.equal(now, then))
        }
    }
    if parts.is_empty() {
        return arena.boolean(true)
    }
    return arena.and(parts)
}

/// Every name an `else` branch assigns, if there is one.
fn prover_else_assigns(else_branch: ref Block?, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let block = else_branch ?? return collections::BTreeSet()
    return assigned_in(block, words)
}

/// The names an `else` branch's own statements bind, if there is one.
fn prover_else_own_names(else_branch: ref Block?, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let block = else_branch ?? return collections::BTreeSet()
    return prover_own_names(block, words)
}

/// The names a block's own statements bind.
fn prover_own_names(block: ref Block, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut own: collections::BTreeSet[String] = collections::BTreeSet()
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, .. } => {
                for name in names {
                    own.insert(words.resolve(name).clone())
                }
            },
            Stmt::Comptime { name, .. } => {
                own.insert(words.resolve(name).clone())
            },
            else => {},
        }
    }
    return own
}

/// Whether an `else` branch may leave the block it stands in.
fn prover_else_leaves(else_branch: ref Block?, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync) -> bool {
    let block = else_branch ?? return false
    return leaves_block(block, fn(e) { prover_throws(e, at, program, words, own, library, unaliased) }, holes_of, true)
}

/// **An expression, for what it calls**: a call to a function with a
/// precondition proves it here (D5), and a nested block is walked with what
/// it may know - a lambda's body with the bindings around it, which a binding
/// the prover reads never changes; any other blind (D3).
fn prover_expr(mut walk: ProverWalk, expr: ref Expr, span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    prover_calls_in(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    prover_blocks_in(walk, expr, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// Every call inside `expr`, as `contracts::sync`'s walk reaches them: not
/// into nested blocks, the holes of literals included.
fn prover_calls_in(mut walk: ProverWalk, expr: ref Expr, span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    prover_unwritten_check(walk, expr, span, scope, at, words, library, holes_of, ask, model, written_of)
    match expr {
        Expr::Call { func, args, config, .. } => {
            let callee = prover_called(func, words, unaliased)
            if callee != null {
                prover_a_call(walk, callee ?? "", node_key(expr), args, config, span, scope, at, program, words, own, library, ask, model, escape, unaliased, written_of, condition)
                prover_raw_sink(walk, callee ?? "", args, config, span, scope, at, program, words, library, holes_of, ask, written_of)
            }
        },
        else => {},
    }
    for hole in holes_of(expr) {
        prover_calls_in(walk, hole, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    }
    match expr {
        Expr::Call { func, args, config, .. } => {
            prover_calls_in(walk, func, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_calls_in(walk, arg, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_calls_in(walk, c.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::MethodCall { receiver, method, args, config, .. } => {
            prover_a_method_call(walk, receiver, method, node_key(expr), args, config, span, scope, at, program, words, library, ask, model, escape, written_of, condition)
            prover_calls_in(walk, receiver, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_calls_in(walk, arg, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_calls_in(walk, c.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            prover_calls_in(walk, receiver, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_calls_in(walk, arg, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_calls_in(walk, c.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            prover_calls_in(walk, lhs, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            if op != BinaryOp::And && op != BinaryOp::Or {
                prover_calls_in(walk, rhs, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                return
            }
            // **The right side of `&&` is reached only where the left holds**,
            // of `||` only where it fails, as an `if`'s branch is: a check
            // there is asked under it (`i < 0 || xs[i] == 10`).
            let mut side = scope.clone()
            let mut reached = claim_term(lhs, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
            if reached != null && op == BinaryOp::Or {
                reached = walk.arena.not(reached ?? 0)
            }
            side.facts.extend(prover_branch_facts(walk, lhs, scope, words, op == BinaryOp::And, reached))
            side.exact = side.exact && reached != null
            side.on_the_path(walk.arena, reached)
            prover_calls_in(walk, rhs, span, side, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Unary { expr, .. } => prover_calls_in(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Try(inner, _) => prover_calls_in(walk, inner, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Async(inner, _, _, _) => prover_calls_in(walk, inner, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Throw(inner, _) => prover_calls_in(walk, inner, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Cast { expr, .. } => prover_calls_in(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Field { base, .. } => prover_calls_in(walk, base, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::SafeField { base, .. } => prover_calls_in(walk, base, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Index { base, index, .. } => {
            prover_calls_in(walk, base, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, index, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Range { start, end, .. } => {
            prover_calls_in(walk, start, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, end, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Tuple(parts, _) => {
            for part in parts {
                prover_calls_in(walk, part, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Coalesce { value, fallback, .. } => {
            prover_calls_in(walk, value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, fallback, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::TryCatch { expr, .. } => prover_calls_in(walk, expr, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::If { cond, .. } => prover_calls_in(walk, cond, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Match { value, arms, .. } => {
            prover_calls_in(walk, value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arm in arms {
                prover_calls_in_maybe(walk, arm.guard, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
                prover_calls_in(walk, arm.body, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::StructLit { fields, .. } => {
            for field in fields {
                prover_calls_in_maybe(walk, field.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::ListRepeat { value, count, .. } => {
            prover_calls_in(walk, value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_calls_in(walk, count, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::ListLit { items, .. } => {
            for item in items {
                prover_calls_in(walk, item, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::With { base, fields, .. } => {
            prover_calls_in(walk, base, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for field in fields {
                prover_calls_in_maybe(walk, field.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Return(value, _) => prover_calls_in_maybe(walk, value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Select(arms, _) => {
            for arm in arms {
                prover_calls_in(walk, arm.value, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        else => {},
    }
}

/// **A check nobody writes, shown to fail** (ADR-306 D15, ADR-269 D8): an
/// index's bound, `0 <= i < xs.len()`, as the goal of the walk where both are
/// whole numbers the prover reads. Where what is known rules it out every
/// time the read is reached, or a state pinned by what reaches it breaks it,
/// the program is refused with `NK1207` and the values, as a refuted `assert`
/// is; a divisor's `d != 0` likewise. Never on *unknown*: the check stays
/// in the machine code in every case. Not in a test (D11). Pass 1 carries
/// one the body leaves open over its parameters back to the entry, for its
/// callers (`ProverState::an_unwritten_check`).
fn prover_unwritten_check(mut walk: ProverWalk, expr: ref Expr, span: Span, scope: ref ProverScope, at: ref ProverWhere, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, written_of: fn(ref Expr) -> String sync) {
    if walk.state.in_test {
        return
    }
    match expr {
        Expr::Index { base, index, .. } => {
            // **A map's index reads a key** (ADR-396 D4): it has no bound,
            // a field's or a call's as a name's (#2371).
            if walk.state.map_indices.contains(id_of(base) as i64) {
                return
            }
            match base {
                Expr::Variable(name, _) => {
                    if scope.maps.contains(words.resolve(name)) {
                        return
                    }
                },
                else => {},
            }
            if from_outside(index, scope.tainted, words, library, walk.state, holes_of) {
                if !walk.state.collecting {
                    prover_outside_index(walk, expr, base, index, span, scope, words, library, holes_of, ask, model, written_of)
                }
                return
            }
            match index {
                Expr::Range { .. } => return,
                else => {},
            }
            let i = lin_term(index, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return
            let n = prover_length_of(walk, base, scope, words) ?? return
            let zero = walk.arena.int(0)
            let from = walk.arena.le(zero, i)
            let below = walk.arena.lt(i, n)
            let goal = walk.arena.and([from, below])
            if walk.state.collecting {
                let check = UnwrittenCheck { term: goal, written: written_of(expr), fails: "is out of bounds", holds: f"0 <= {written_of(index)} < {written_of(base)}.len()", index: true, within: "", site: span }
                walk.state.an_unwritten_check(walk.arena, check, scope, at, ask, model)
                return
            }
            prover_refuted_check(walk, goal, written_of(expr), "is out of bounds", "An index is in `0..<len()`: if the read is right, the code before it is wrong.", span, scope, ask, model)
        },
        // **A divisor is not zero** (ADR-395 D1, D2): `d != 0` for every `/`
        // and `%` on whole numbers whose divisor is not a literal. A constant
        // zero is `NK1118`'s. The check stays in the machine code (D3).
        Expr::Binary { op, lhs, rhs, span: op_at, .. } => {
            if op == BinaryOp::Add || op == BinaryOp::Sub || op == BinaryOp::Mul {
                // **Data from outside reaches the operation** (ADR-396 D7):
                // recorded for `--bounds`, not refused yet (D8).
                if !walk.state.collecting && walk.state.arithmetic.contains_key(op_at.start as i64) {
                    let left = from_outside(lhs, scope.tainted, words, library, walk.state, holes_of)
                    if left || from_outside(rhs, scope.tainted, words, library, walk.state, holes_of) {
                        let goal = prover_overflow_goal(walk, expr, op_at.start as i64, scope, words)
                        if left {
                            prover_outside_operation(walk, expr, lhs, goal, op_at.start as i64, span, scope, words, library, holes_of, ask, written_of)
                        } else {
                            prover_outside_operation(walk, expr, rhs, goal, op_at.start as i64, span, scope, words, library, holes_of, ask, written_of)
                        }
                    }
                }
                prover_overflow_check(walk, expr, op_at.start as i64, span, scope, at, words, ask, model, written_of)
                return
            }
            if op != BinaryOp::Div && op != BinaryOp::Rem {
                return
            }
            match rhs {
                Expr::LitInt { .. } => return,
                else => {},
            }
            // **Data from outside reaches the divisor** (ADR-396 D7).
            if !walk.state.collecting && from_outside(rhs, scope.tainted, words, library, walk.state, holes_of) {
                let goal = prover_division_goal(walk, lhs, rhs, op_at.start as i64, scope, words)
                prover_outside_operation(walk, expr, rhs, goal, op_at.start as i64, span, scope, words, library, holes_of, ask, written_of)
            }
            let d = lin_term(rhs, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return
            if walk.arena.constant(d) != null {
                return
            }
            // **What the checker folds is `NK1118`'s** (#1566): a divisor
            // its `constant_of` shows zero, also through a `let mut`.
            if walk.state.zero_divisors.contains(node_key(rhs)) {
                return
            }
            let zero = walk.arena.int(0)
            let goal = walk.arena.unequal(d, zero)
            if walk.state.collecting {
                let check = UnwrittenCheck { term: goal, written: written_of(expr), fails: "divides by zero", holds: f"{written_of(rhs)} != 0", index: false, within: "", site: span }
                walk.state.an_unwritten_check(walk.arena, check, scope, at, ask, model)
                return
            }
            prover_refuted_check(walk, goal, written_of(expr), "divides by zero", "If the divisor can really be zero, check it before dividing.", span, scope, ask, model)
        },
        else => {},
    }
}

/// **An index that data from outside the program reaches is proved, or the
/// program is refused** (ADR-396 D1, D2, `NK1302`): the index's bound - a
/// cut's `0 <= a <= b <= len` - asked of what is known where it stands,
/// with what the earlier values make known (ADR-361 D9). Where it is not
/// proved, a stranger may choose the value that stops the program, and the
/// way out is a guard where the value arrives. `unproved-claims = "warn"`
/// lowers it to a warning (D3); the index keeps its check either way.
fn prover_outside_index(mut walk: ProverWalk, expr: ref Expr, base: ref Expr, index: ref Expr, span: Span, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, written_of: fn(ref Expr) -> String sync) {
    let n = prover_length_of(walk, base, scope, words)
    let zero = walk.arena.int(0)
    let mut goal: i64? = null
    let mut holds = f"0 <= {written_of(index)} < {written_of(base)}.len()"
    let mut guard = f"0 <= {written_of(index)} && {written_of(index)} < {written_of(base)}.len()"
    match index {
        Expr::Range { start, end, inclusive, .. } => {
            let below = if inclusive { "<" } else { "<=" }
            holds = f"0 <= {written_of(start)} <= {written_of(end)} {below} {written_of(base)}.len()"
            guard = f"0 <= {written_of(start)} && {written_of(start)} <= {written_of(end)} && {written_of(end)} {below} {written_of(base)}.len()"
            let a = lin_term(start, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
            let b = lin_term(end, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
            if a != null && n != null {
                let from = a ?? 0
                let len = n ?? 0
                let low = walk.arena.le(zero, from)
                if b != null {
                    let to = b ?? 0
                    let ordered = walk.arena.le(from, to)
                    let mut high = walk.arena.le(to, len)
                    if inclusive {
                        high = walk.arena.lt(to, len)
                    }
                    goal = walk.arena.and([low, ordered, high])
                } else if !from_outside(end, scope.tainted, words, library, walk.state, holes_of) {
                    // An open end: the cut runs to the length.
                    let inside = walk.arena.le(from, len)
                    goal = walk.arena.and([low, inside])
                }
            }
        },
        else => {
            let i = lin_term(index, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
            if i != null && n != null {
                let from = walk.arena.le(zero, i ?? 0)
                let below = walk.arena.lt(i ?? 0, n ?? 0)
                goal = walk.arena.and([from, below])
            }
        },
    }
    let first = prover_outside_name(walk, goal, index, scope, words, written_of)
    let source = outside_source(index, scope.tainted, scope.sources, words, library, walk.state, holes_of)
    if goal != null && prover_proves_here(walk, goal ?? 0, scope, ask) {
        prover_outside_record(walk, span, f"`{written_of(expr)}`", first, source, scope.guard_of(walk.arena, goal ?? 0), true, false, true, "", -1)
        return
    }
    prover_outside_record(walk, span, f"`{written_of(expr)}`", first, source, null, false, false, goal != null, "", -1)
    let mut notes: Vec[String] = [outside_note(first, source)]
    if goal != null {
        let found = model(walk.arena, scope.facts, goal ?? 0)
        if found != null {
            let values = found ?? collections::BTreeMap()
            let mut read: collections::BTreeSet[String] = collections::BTreeSet()
            walk.arena.variables(goal ?? 0, read)
            let mut shown_values: collections::BTreeMap[String, i64] = collections::BTreeMap()
            for name in read {
                let value = values[name] ?? continue
                shown_values.insert(name.clone(), value)
            }
            if !shown_values.is_empty() {
                notes.push(f"What is known here does not exclude {can_be(shown_values)}, for which `{holds}` fails.")
            }
        }
    } else {
        notes.push(f"The prover cannot state `{holds}` here: a part of it is not a whole number it reads.")
    }
    walk.findings.push(Finding { code: "NK1302", span: span, message: f"`{written_of(expr)}` is not proved in bounds, and `{first}` comes from outside the program.", notes: notes, help: outside_help(first, guard), warning: false, labels: [] })
}

/// **Data from outside at a raw sink** (ADR-raw-sinks-1 D2, D3, D10, D11,
/// D14, D15): each part of the markup of `html::Raw` and of the program
/// `process::run` runs, and each part of a path under a root that may name
/// any file (`fs::Root::Anywhere`, `Dir("/")`, or a `Dir` whose directory
/// comes from outside, D11) that comes from outside, is not a whole number
/// the walk follows, and is not proved to meet the sink's precondition, is
/// `NK1308`: markup after the guard `html::is_plain`, a path after the guard
/// `path::is_component` or `path::is_below` where it is joined to a part
/// that is not outside (D14) and the root is not outside. A path under a
/// clean `Dir` is not a sink: `Dir` keeps it inside (ADR-108 D3). Its help
/// names the `[allow]` key of the operation and the source
/// (`untrusted-paths-read = ["args"]`, D15), by which the build lets it
/// through (`project_check_let_raw_sinks_through`).
fn prover_raw_sink(mut walk: ProverWalk, callee: ref String, args: ref Vec[Expr], config: ref Vec[ConfigArg], span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, written_of: fn(ref Expr) -> String sync) {
    if walk.state.in_test {
        return
    }
    if callee == "html::Raw" {
        let mut parts: Vec[Expr] = []
        for arg in args {
            raw_sink_parts(arg, holes_of, parts)
        }
        let sink = ParamSink { index: -1, kind: "markup", sink: "the markup of `html::Raw`, written to the page as it is", operation: "", root_part: false, guard: "html::is_plain" }
        for part in parts {
            raw_sink_part(walk, sink, sink.sink, part, span, scope, at, program, words, library, holes_of, ask, written_of)
        }
    } else if callee == "process::run" && !args.is_empty() {
        let mut parts: Vec[Expr] = []
        raw_sink_parts(args[0], holes_of, parts)
        // D14: a guarded name joined after a clean part names a file inside
        // a directory the program chose; a whole name, or one the text
        // starts with, is looked up on `PATH` or relative to where it runs.
        let mut guard = String()
        if raw_sink_clean_lead(args[0], scope, words, library, walk.state, holes_of) {
            guard.push_str("path")
        }
        let sink = ParamSink { index: -1, kind: "program", sink: "the program `process::run` runs", operation: "", root_part: false, guard: guard }
        for part in parts {
            raw_sink_part(walk, sink, sink.sink, part, span, scope, at, program, words, library, holes_of, ask, written_of)
        }
    } else if callee.starts_with("fs::") && library.functions.contains_key(callee) {
        for (i, written) in args.iter().enumerate() {
            let arg = raw_sink_root(written, scope, words)
            let anywhere = raw_sink_anywhere(arg, words, written_of)
            let mut root_parts: Vec[Expr] = []
            if !anywhere {
                match raw_sink_dir(arg, words) {
                    dir => raw_sink_parts(dir, holes_of, root_parts),
                    null => continue,
                }
            }
            let mut root_outside = false
            for part in root_parts {
                if raw_sink_outside(part, scope, words, library, walk.state, holes_of) {
                    root_outside = true
                }
            }
            let root = written_of(arg)
            // D11: the root's own parts, under the call's one operation, or
            // under all three where it has two (`copy`, `rename`).
            let mut whole = raw_sink_operation(callee, 0, config, words, written_of)
            if i > 1 && raw_sink_operation(callee, 1, config, words, written_of) != whole {
                whole = "anywhere"
            }
            let root_sink = ParamSink { index: -1, kind: "path", sink: f"the root `{root}` of `{callee}`, a directory a stranger may have chosen", operation: whole, root_part: true, guard: "" }
            for part in root_parts {
                raw_sink_part(walk, root_sink, root_sink.sink, part, span, scope, at, program, words, library, holes_of, ask, written_of)
            }
            if !anywhere && !root_outside {
                continue
            }
            for j in 0..<i {
                let mut parts: Vec[Expr] = []
                raw_sink_parts(args[j], holes_of, parts)
                // D14: a guarded name is admitted joined after a part that
                // is not outside, under a root that is not; alone under
                // `Anywhere`, or leading the text (`f"{key}/x"`), it is
                // relative to the working directory, which no guard proves.
                let joined = raw_sink_clean_lead(args[j], scope, words, library, walk.state, holes_of)
                let mut guard = String()
                if joined && !root_outside {
                    guard.push_str("path")
                }
                let operation = raw_sink_operation(callee, j, config, words, written_of)
                let sink = ParamSink { index: -1, kind: "path", sink: f"the path `{callee}` opens under `{root}`, which may name any file", operation: operation, root_part: false, guard: guard }
                for part in parts {
                    raw_sink_part(walk, sink, sink.sink, part, span, scope, at, program, words, library, holes_of, ask, written_of)
                }
            }
        }
    } else {
        raw_sink_through(walk, callee, args, config, span, scope, at, program, words, library, holes_of, ask, written_of)
    }
}

/// **A call of a function whose parameters reach a raw sink** (ADR-raw-sinks-1
/// D2, ADR-396 D1, #2354): each argument at such a parameter is a part of
/// that sink here, asked as at the sink itself, and the message names the
/// function called.
fn raw_sink_through(mut walk: ProverWalk, callee: ref String, args: ref Vec[Expr], config: ref Vec[ConfigArg], span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, written_of: fn(ref Expr) -> String sync) {
    if scope.locals.contains(callee) {
        return
    }
    let sinks = walk.state.known_sinks[callee]?.clone() ?? return
    let function = free_function(program, words, callee) ?? return
    let all = arguments_in_order(function, args, config, words)
    for sink in sinks {
        if sink.index < 0 || sink.index >= all.len() {
            continue
        }
        let mut parts: Vec[Expr] = []
        raw_sink_parts(all[sink.index], holes_of, parts)
        let shown = f"{sink.sink}, through `{callee}`"
        for part in parts {
            raw_sink_part(walk, sink, shown, part, span, scope, at, program, words, library, holes_of, ask, written_of)
        }
    }
}

/// **One part of a raw sink's text** (ADR-raw-sinks-1 D2): from outside and
/// not passed by the sink's guard, reported in pass 2 (`NK1308`, the sink
/// named as `shown`); read from a parameter of the free function it stands
/// in, carried to that function's callers in pass 1 (#2354).
fn raw_sink_part(mut walk: ProverWalk, sink: ref ParamSink, shown: ref String, part: ref Expr, span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, written_of: fn(ref Expr) -> String sync) {
    if raw_sink_outside(part, scope, words, library, walk.state, holes_of) {
        if walk.state.collecting || raw_sink_passes(walk, sink.guard, part, scope, words, ask) {
            return
        }
        raw_sink_finding(walk, sink, shown, part, span, scope, words, library, holes_of, written_of)
        return
    }
    if !walk.state.collecting || !at.free {
        return
    }
    match part {
        Expr::Variable(name, _) => {
            if scope.ints.contains(words.resolve(name)) {
                return
            }
        },
        else => {},
    }
    let from = carried_param(part, scope, words, library, walk.state, holes_of) ?? return
    if raw_sink_passes(walk, sink.guard, part, scope, words, ask) {
        return
    }
    let owner = carrying_function(at.function) ?? return
    let function = free_function(program, words, owner) ?? return
    let mut index = -1
    for (k, name) in function.params.iter().enumerate() {
        if name == from && index < 0 {
            index = k
        }
    }
    if index < 0 {
        return
    }
    let carried = ParamSink { index: index, kind: sink.kind.clone(), sink: sink.sink.clone(), operation: sink.operation.clone(), root_part: sink.root_part, guard: sink.guard.clone() }
    let mut found = walk.state.sinks.remove(owner) ?? []
    let mut known = false
    for one in found {
        if one.same(carried) {
            known = true
        }
    }
    if !known {
        found.push(carried)
    }
    walk.state.sinks.insert(owner, found)
}

/// The parameter `expr` reads, by `scope.carried` (#2354), as
/// `outside_source` names the source of outside data.
fn carried_param(expr: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> String? {
    if scope.carried.is_empty() || !from_outside(expr, scope.carried, words, library, state, holes_of) {
        return null
    }
    return outside_source(expr, scope.carried, scope.carried_from, words, library, state, holes_of)
}

/// Whether the guard a sink admits (`html::is_plain`, or `path` for
/// `path::is_component` or `path::is_below`) proves `part` here.
fn raw_sink_passes(mut walk: ProverWalk, guard: ref String, part: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync) -> bool {
    if guard == "" {
        return false
    }
    if guard == "path" {
        if raw_sink_joined_name(part, scope, words) {
            return true
        }
        return raw_sink_guarded(walk, part, "path::is_component", scope, words, ask) || raw_sink_guarded(walk, part, "path::is_below", scope, words, ask)
    }
    return raw_sink_guarded(walk, part, guard, scope, words, ask)
}

/// **Data from outside at a raw sink, reported** (`NK1308`): the sink named
/// as `shown`, the notes and the help by its kind.
fn raw_sink_finding(mut walk: ProverWalk, sink: ref ParamSink, shown: ref String, part: ref Expr, span: Span, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, written_of: fn(ref Expr) -> String sync) {
    if sink.kind == "path" {
        raw_sink_path_finding(walk, part, shown, sink.operation, sink.root_part, span, scope, words, library, holes_of, written_of)
        return
    }
    let first = written_of(part)
    let source = outside_source(part, scope.tainted, scope.sources, words, library, walk.state, holes_of)
    let mut notes: Vec[String] = [outside_note(first, source)]
    let mut help: String = ""
    if sink.kind == "markup" {
        notes.push("Markup from outside can carry a script that runs in the page of whoever opens it.")
        help = f"Check it where it arrives: `throw BadInput({first}) if !html::is_plain({first})`, after which it is proved; or write it as text, which `html` escapes. If the program means to write markup from outside, `untrusted-markup = true` under `[allow]` in the manifest builds it."
    } else {
        notes.push("No check makes a stranger's choice of program safe: a name is looked up on `PATH`, a path runs that file.")
        help = "Name the program with a literal, or choose it with a `match` whose arms are literals. If the program means to run a program from outside, `untrusted-program = true` under `[allow]` in the manifest builds it."
    }
    walk.findings.push(Finding { code: "NK1308", span: span, message: f"`{first}` reaches {shown}, and it comes from outside the program.", notes: notes, help: help, warning: false, labels: [] })
}

/// Whether a part of a raw sink's text comes from outside the program and is
/// not a whole number the walk follows (ADR-raw-sinks-1 D2).
fn raw_sink_outside(part: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    if !from_outside(part, scope.tainted, words, library, state, holes_of) {
        return false
    }
    return match part {
        Expr::Variable(name, _) => !scope.ints.contains(words.resolve(name)),
        else => true,
    }
}

/// Whether a guard where `part` arrives proves the `std` predicate
/// `predicate` of it here (`html::is_plain`, `path::is_component`): a named
/// property after its guard is a fact (ADR-381 D5, ADR-raw-sinks-1 D14).
fn raw_sink_guarded(mut walk: ProverWalk, part: ref Expr, predicate: ref String, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync) -> bool {
    let on = raw_sink_name(part, words) ?? return false
    let name = f"{on}.{property_mark()}{predicate}()"
    if !scope.ints.contains(name) {
        return false
    }
    let named = walk.arena.var(name)
    let one = walk.arena.int(1)
    let goal = walk.arena.equal(named, one)
    return prover_proves_here(walk, goal, scope, ask)
}

/// **A path from outside at its operation's sink** (ADR-raw-sinks-1 D11,
/// D15): `NK1308`, whose help names the three ways through, a root the
/// program chose, a guard where the name arrives (not for a root, which no
/// check makes one the program chose) and the `[allow]` key of the
/// operation with the source, `untrusted-paths-read = ["args"]`.
fn raw_sink_path_finding(mut walk: ProverWalk, part: ref Expr, sink: ref String, operation: ref String, root_part: bool, span: Span, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, written_of: fn(ref Expr) -> String sync) {
    let first = written_of(part)
    let source = outside_source(part, scope.tainted, scope.sources, words, library, walk.state, holes_of)
    let key = f"untrusted-paths-{operation}"
    let class = raw_sink_source_class(source ?? "")
    let allowed = if class.is_empty() { f"`{key} = true`" } else { f"`{key} = [\"{class}\"]`" }
    let verb = match operation {
        "read" => "read",
        "write" => "write",
        "remove" => "remove",
        else => "reach",
    }
    let from = if class.is_empty() { "outside" } else { f"`{class}`" }
    let manifest = f"If the program means to {verb} paths from {from}, {allowed} under `[allow]` in the manifest builds it."
    let mut notes: Vec[String] = [outside_note(first, source)]
    let mut help: String = ""
    if root_part {
        notes.push("A root from outside keeps a path inside a directory a stranger chose, which may be `/`.")
        help = f"Build the root from a literal, `fs::scratch()` or `root.join(...)` of such a root: no check makes a directory from outside one the program chose. {manifest}"
    } else {
        notes.push("A path from outside may name any file the program can reach: `../`, or one that starts at `/`.")
        help = f"Open it under a root the program chose, where it cannot leave the directory: `fs::Root::Dir(\".\")`, `fs::scratch()` or `root.join(...)` of one. Or check it where it arrives, `throw BadInput({first}) if !path::is_component({first})` (or `path::is_below`), and open it under such a root or joined to a part that is not outside. {manifest}"
    }
    walk.findings.push(Finding { code: "NK1308", span: span, message: f"`{first}` reaches {sink}, and it comes from outside the program.", notes: notes, help: help, warning: false, labels: [] })
}

/// **The source a `[allow]` list names** (ADR-raw-sinks-1 D15, ADR-010 D7):
/// `args`, `stdin`, `env`, `request`, `file`, `process` or `network`, by the
/// module of the `std` call the value came from; empty where the walk does
/// not know it, which only `true` admits.
fn raw_sink_source_class(source: ref String) -> String {
    if source.starts_with("cli::") {
        return "args"
    }
    if source.starts_with("io::") {
        return "stdin"
    }
    if source.starts_with("env::") {
        return "env"
    }
    if source.starts_with("http") {
        return "request"
    }
    if source.starts_with("fs::") {
        return "file"
    }
    if source.starts_with("process::") {
        return "process"
    }
    if source.starts_with("net::") {
        return "network"
    }
    return ""
}

/// **The operation a path of an `fs` call is opened for** (ADR-raw-sinks-1
/// D15), the `j`th argument of `callee`: `read`, `write` or `remove`.
fn raw_sink_operation(callee: ref String, j: i64, config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext, written_of: fn(ref Expr) -> String sync) -> String {
    if callee == "fs::write" || callee == "fs::create" || callee == "fs::create_dir" {
        return "write"
    }
    if callee == "fs::remove" {
        return "remove"
    }
    if callee == "fs::rename" {
        return if j == 0 { "remove" } else { "write" }
    }
    if callee == "fs::copy" {
        return if j == 0 { "read" } else { "write" }
    }
    if callee == "fs::open" {
        for option in config {
            let named = words.resolve(option.name)
            if (named == "write" || named == "append" || named == "create" || named == "truncate") && written_of(option.value) != "false" {
                return "write"
            }
        }
    }
    return "read"
}

/// **The root an argument names** (ADR-raw-sinks-1 D11, #2440): the value
/// of a name bound to a root (`ProverScope::roots`), else the argument.
fn raw_sink_root(arg: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> Expr {
    let name = raw_sink_name(arg, words) ?? return arg.clone()
    return scope.roots[name]?.clone() ?? arg.clone()
}

/// The directory of `fs::Root::Dir(dir)`, or nothing for any other root
/// (ADR-raw-sinks-1 D11).
fn raw_sink_dir(arg: ref Expr, words: ref winnow_grammar::InternerContext) -> Expr? {
    return match arg {
        Expr::Call { func, args, .. } => {
            let named = match func {
                Expr::Path(segments, _) => path_text(segments, words),
                else => "",
            }
            if named.ends_with("Root::Dir") && args.len() == 1 { args[0].clone() } else { null }
        },
        else => null,
    }
}

/// Whether a path is written joined of parts, an f-string or a `+`, or is
/// a name bound to such a text whose proof it carries (ADR-raw-sinks-1 D14).
fn raw_sink_joined(arg: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    return match arg {
        Expr::LitInterpolated { .. } => true,
        Expr::Binary { op, .. } => op == BinaryOp::Add,
        else => raw_sink_joined_name(arg, scope, words),
    }
}

/// The name or field path a sink part reads, through a `.clone()`
/// (ADR-raw-sinks-1 D14): `key` of `key` and of `key.clone()`.
fn raw_sink_name(part: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match part {
        Expr::MethodCall { receiver, method, args, .. } => {
            if words.resolve(method) == "clone" && args.is_empty() { path_of(receiver, words) } else { null }
        },
        else => path_of(part, words),
    }
}

/// Whether a sink part reads a name bound to a guarded name joined after a
/// clean part (`ProverScope::joined`, ADR-raw-sinks-1 D14).
fn raw_sink_joined_name(part: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    let name = raw_sink_name(part, words) ?? return false
    return scope.joined.contains(name)
}

/// Whether `value` is a guarded name joined after a clean part, whose proof a
/// binding of it carries (ADR-raw-sinks-1 D14): a joined text that starts
/// with a part that is not outside, each of whose parts from outside passes
/// `path::is_component` or `path::is_below` here.
fn raw_sink_proved_join(mut walk: ProverWalk, value: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync) -> bool {
    if !raw_sink_joined(value, scope, words) {
        return false
    }
    if !raw_sink_joined_name(value, scope, words) && !raw_sink_clean_lead(value, scope, words, library, walk.state, holes_of) {
        return false
    }
    let mut parts: Vec[Expr] = []
    raw_sink_parts(value, holes_of, parts)
    for part in parts {
        if raw_sink_outside(part, scope, words, library, walk.state, holes_of) && !raw_sink_passes(walk, "path", part, scope, words, ask) {
            return false
        }
    }
    return true
}

/// Whether a joined text starts with a part that is not outside, a literal
/// piece or a clean value (ADR-raw-sinks-1 D14, the program of
/// `process::run`): `f"/r/{key}/x"` does, `f"{key}/x"` and `key` do not.
fn raw_sink_clean_lead(arg: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, state: ref ProverState, holes_of: fn(ref Expr) -> Vec[Expr] sync) -> bool {
    return match arg {
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Text(text) => {
                        if !text.is_empty() {
                            return true
                        }
                    },
                    FPart::Hole { expr, .. } => {
                        return raw_sink_clean_lead(expr, scope, words, library, state, holes_of) || (!raw_sink_joined(expr, scope, words) && !raw_sink_outside(expr, scope, words, library, state, holes_of))
                    },
                }
            }
            false
        },
        Expr::Binary { op, lhs, .. } => op == BinaryOp::Add && (raw_sink_clean_lead(lhs, scope, words, library, state, holes_of) || (!raw_sink_joined(lhs, scope, words) && !raw_sink_outside(lhs, scope, words, library, state, holes_of))),
        else => raw_sink_joined_name(arg, scope, words),
    }
}

/// **The parts of a raw sink's text** (ADR-raw-sinks-1 D2): each hole of an
/// f-string and each operand of `+`, judged on its own; anything else is one
/// part.
fn raw_sink_parts(expr: ref Expr, holes_of: fn(ref Expr) -> Vec[Expr] sync, mut out: Vec[Expr]) {
    match expr {
        Expr::LitInterpolated { .. } => {
            for hole in holes_of(expr) {
                raw_sink_parts(hole, holes_of, out)
            }
        },
        Expr::Binary { op, lhs, rhs, .. } => {
            if op == BinaryOp::Add {
                raw_sink_parts(lhs, holes_of, out)
                raw_sink_parts(rhs, holes_of, out)
            } else {
                out.push(expr.clone())
            }
        },
        else => out.push(expr.clone()),
    }
}

/// Whether an argument is the root that reaches any path
/// (ADR-raw-sinks-1 D2): `fs::Root::Anywhere`, or `fs::Root::Dir("/")`.
fn raw_sink_anywhere(arg: ref Expr, words: ref winnow_grammar::InternerContext, written_of: fn(ref Expr) -> String sync) -> bool {
    return match arg {
        Expr::Path(segments, _) => path_text(segments, words).ends_with("Root::Anywhere"),
        Expr::Call { func, args, .. } => {
            let named = match func {
                Expr::Path(segments, _) => path_text(segments, words),
                else => "",
            }
            named.ends_with("Root::Dir") && args.len() == 1 && written_of(args[0]) == "\"/\""
        },
        else => false,
    }
}

/// **An index data from outside reaches, recorded for `--bounds`**
/// (ADR-396 D5): where it stands, the name and its source, and whether it
/// is proved, by the guard `guard` where one proves it; an `operation` (a
/// `/`, `%`, `+`, `-` or `*`, D7) likewise, and whether its goal was
/// `stated` at all.
fn prover_outside_record(mut walk: ProverWalk, span: Span, written: String, name: ref String, source: ref String?, guard: (i64, String)?, proved: bool, operation: bool, stated: bool, within: String, site: i64) {
    let mut guard_at: i64 = -1
    let mut condition: String = ""
    match guard {
        null => {},
        found => {
            guard_at = found.0
            condition = found.1.clone()
        },
    }
    let at = span.start as i64
    walk.outside.insert((at, written.clone()), OutsideIndex { at: at, written: written, name: name.clone(), source: source?.clone() ?? "", proved: proved, guard_at: guard_at, guard: condition, operation: operation, stated: stated, within: within.clone(), site: site })
}

/// **An operation that data from outside reaches, recorded for `--bounds`**
/// (ADR-396 D7, #1660): `goal`, a divisor not zero or a result inside its
/// type, proved here or not, with the guard that proves it; the name from
/// outside is the one `reached` reads. Nothing is refused yet (D8 step 3):
/// the check stays where it is either way.
fn prover_outside_operation(mut walk: ProverWalk, expr: ref Expr, reached: ref Expr, goal: i64?, site: i64, span: Span, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, library: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, written_of: fn(ref Expr) -> String sync) {
    let first = prover_outside_name(walk, goal, reached, scope, words, written_of)
    let source = outside_source(reached, scope.tainted, scope.sources, words, library, walk.state, holes_of)
    if goal != null && prover_proves_here(walk, goal ?? 0, scope, ask) {
        prover_outside_record(walk, span, f"`{written_of(expr)}`", first, source, scope.guard_of(walk.arena, goal ?? 0), true, true, true, "", site)
        return
    }
    let mut within = String()
    if goal != null {
        within = prover_proof_window(walk.state.arithmetic[site]?.clone() ?? "").clone()
    }
    prover_outside_record(walk, span, f"`{written_of(expr)}`", first, source, null, false, true, goal != null, within, site)
}

/// **A division's goal on data from outside** (ADR-396 D7): `d != 0`, and on
/// a signed type not the least value by `-1`, the dividend above the least
/// value the solver states (`2^62` below zero for an `i64`, as the bounds
/// walk's `solvable`). Null where the divisor is no whole number it reads.
fn prover_division_goal(mut walk: ProverWalk, lhs: ref Expr, rhs: ref Expr, op_at: i64, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> i64? {
    let d = lin_term(rhs, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return null
    let zero = walk.arena.int(0)
    let mut goal = walk.arena.unequal(d, zero)
    let ty = walk.state.divisions[op_at]?.clone() ?? ""
    let least = match ty {
        "u8" => 0,
        "u32" => 0,
        "u64" => 0,
        "i32" => -2147483648,
        else => -4611686018427387904,
    }
    if least < 0 {
        let minus_one = walk.arena.int(-1)
        let mut apart = walk.arena.unequal(d, minus_one)
        let dividend = lin_term(lhs, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
        if dividend != null {
            let low = walk.arena.int(least)
            let higher = walk.arena.lt(low, dividend ?? 0)
            apart = walk.arena.or([apart, higher])
        }
        goal = walk.arena.and([goal, apart])
    }
    return goal
}

/// **An operation's goal**, `lo <= a + b <= hi` for the type the checker
/// gave it (`prover_overflow_check`'s; an `i64`'s and a `u64`'s within the
/// window of `prover_stated_range`), null where it reads no whole number.
fn prover_overflow_goal(mut walk: ProverWalk, expr: ref Expr, op_at: i64, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> i64? {
    let ty = walk.state.arithmetic[op_at]?.clone() ?? return null
    let (lo, hi) = prover_stated_range(ty) ?? return null
    if walk.state.unfit_numbers.len() > 0 {
        return null
    }
    let mut calls: Vec[i64] = []
    let term = goal_term(expr, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes, calls) ?? return null
    let low = walk.arena.int(lo)
    let mut goal = walk.arena.le(low, term)
    if hi != null {
        let high = walk.arena.int(hi ?? 0)
        let below = walk.arena.le(term, high)
        goal = walk.arena.and([goal, below])
    }
    // **A method result is a fresh variable inside its type** (ADR-270
    // D29): the goal holds for every result the type has, so it is asked
    // as "outside the type, or the goal". An `i64`'s ends bound nothing
    // the window does not.
    if calls.is_empty() || ty == "i64" {
        return goal
    }
    let (least, most) = prover_type_range(ty) ?? return null
    let mut either: Vec[i64] = []
    let bottom = walk.arena.int(least)
    for result in calls {
        either.push(walk.arena.lt(result, bottom))
        if most != null {
            let top = walk.arena.int(most ?? 0)
            either.push(walk.arena.lt(top, result))
        }
    }
    either.push(goal)
    return walk.arena.or(either)
}

/// Whether `goal` holds of what is known here, or of that with what the
/// earlier values of the followed mutable whole numbers make known
/// (ADR-361 D9).
fn prover_proves_here(mut walk: ProverWalk, goal: i64, scope: ref ProverScope, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync) -> bool {
    if is_proved(ask(walk.arena, scope.facts, goal)) {
        return true
    }
    if scope.history_reads(walk.arena, goal) {
        walk.state.second_queries += 1
        return is_proved(ask(walk.arena, scope.with_history(), goal))
    }
    return false
}

/// The first name from outside an index reads: of its bound where the
/// prover states one, else as written.
fn prover_outside_name(walk: ref ProverWalk, goal: i64?, index: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, written_of: fn(ref Expr) -> String sync) -> String {
    if goal != null {
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(goal ?? 0, read)
        for name in read {
            if scope.tainted.contains(name) {
                return name.clone()
            }
        }
    }
    let named = prover_variable_named(index, words)
    if named != null {
        return named ?? ""
    }
    return written_of(index)
}

/// **An operation stays inside its type** (ADR-306 D15, D6): `lo <= a + b
/// <= hi` for a `+`, `-` or `*` of the type the checker gave it, by the byte
/// its operator starts at. A refutation is `NK1207`, as an index's is; the
/// check stays in the machine code. Asked of the type's true ends
/// (`prover_type_range`), not of the window an `i64`'s and a `u64`'s proof
/// is stated within (ADR-396 D8 step 2, #1810): leaving the window is no
/// overflow. An `i64`'s refutation is `prover_i64_refuted_check`'s, and
/// carried to no caller: its ends leave the solver no room to combine them.
/// Not once the checker folded a number and refused it with `NK1116`: that
/// refusal is the cause, and a number it folded reaches the walk through a
/// `let`, where no span names it.
fn prover_overflow_check(mut walk: ProverWalk, expr: ref Expr, op_at: i64, span: Span, scope: ref ProverScope, at: ref ProverWhere, words: ref winnow_grammar::InternerContext, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, written_of: fn(ref Expr) -> String sync) {
    let ty = walk.state.arithmetic[op_at]?.clone() ?? return
    let (lo, hi) = prover_type_range(ty) ?? return
    if walk.state.unfit_numbers.len() > 0 {
        return
    }
    let term = lin_term(expr, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return
    if walk.arena.constant(term) != null {
        return
    }
    let low = walk.arena.int(lo)
    let mut goal = walk.arena.le(low, term)
    let mut holds = f"{lo} <= {written_of(expr)}"
    if hi != null {
        let high = walk.arena.int(hi ?? 0)
        let below = walk.arena.le(term, high)
        goal = walk.arena.and([goal, below])
        holds = f"{lo} <= {written_of(expr)} <= {hi ?? 0}"
    }
    let fails = f"goes past what {an_or_a(ty)} `{ty}` holds"
    let help = "Use a wider type where the number needs more room, or check the operands before the operation."
    if ty == "i64" {
        if !walk.state.collecting {
            prover_i64_refuted_check(walk, goal, term, written_of(expr), fails, help, span, scope, ask, model)
        }
        return
    }
    if walk.state.collecting {
        let check = UnwrittenCheck { term: goal, written: written_of(expr), fails: fails, holds: holds, index: false, within: "", site: span }
        walk.state.an_unwritten_check(walk.arena, check, scope, at, ask, model)
        return
    }
    prover_refuted_check(walk, goal, written_of(expr), fails, help, span, scope, ask, model)
}

/// **An `i64` operation refuted only past the type** (ADR-396 D8 step 2,
/// ADR-270 D11, #1810): `goal`, of the type's true ends, refuted as
/// `prover_refuted_check` does, and then only where the operation `term`
/// on the values that break it overflows in checked `i64` arithmetic. The
/// solver, which counts in `i64` and never wraps, may answer nothing near
/// those ends; it is never the reason for an `NK1207` alone. `let x: i64 =
/// 3000000000000000000` then `x + 1` is none; at `9223372036854775807` it
/// is one.
fn prover_i64_refuted_check(mut walk: ProverWalk, goal: i64, term: i64, written: String, fails: String, help: String, span: Span, scope: ref ProverScope, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    walk.arena.variables(goal, read)
    for name in read {
        if scope.tainted.contains(name) {
            return
        }
    }
    let always = refuting_values(walk.arena, scope.facts, goal, ask, model)
    let values = always?.clone() ?? breaking_values(walk.arena, scope, goal, model) ?? return
    for name in read {
        if !values.contains_key(name) {
            return
        }
    }
    if walk.arena.int_value(term, values) != null {
        return
    }
    if always != null {
        walk.findings.push(Finding { code: "NK1207", span: span, message: f"`{written}` {fails} every time it is reached.", notes: [f"What is known before it rules the check out: {shown(values)}."], help: help, warning: false, labels: [] })
        return
    }
    walk.findings.push(Finding { code: "NK1207", span: span, message: f"`{written}` {fails} when {shown(values)}.", notes: ["That state reaches it: what is known here pins every name the check depends on."], help: help, warning: false, labels: [] })
}

/// **A whole-number type's true ends**, for a refutation (#1810): an
/// `i64`'s both, a `u64`'s only its low end, which the solver, counting in
/// `i64`, can state; every other type's as `prover_stated_range` has them.
fn prover_type_range(ty: ref String) -> (i64, i64?)? sync {
    return match ty {
        "i64" => (-9223372036854775807 - 1, 9223372036854775807),
        "u64" => (0, null),
        else => prover_stated_range(ty),
    }
}

/// The range of a whole-number type as the solver can state it, which counts
/// in `i64`: an `i64`'s and a `u64`'s upper end it cannot, so those two get
/// the window `±2^62` and `0..2^62`, the bounds walk's `solvable` (#444,
/// ADR-396 D8 step 2, #1810) - a goal within it implies the type's, and
/// its constants leave the solver room. `prover_proof_window` names which
/// ranges are such a window.
fn prover_stated_range(ty: ref String) -> (i64, i64?)? sync {
    return match ty {
        "i32" => (-2147483648, 2147483647),
        "u8" => (0, 255),
        "u32" => (0, 4294967295),
        "u64" => (0, solvable()),
        "i64" => (0 - solvable(), solvable()),
        else => null,
    }
}

/// **The window `prover_stated_range` gives `ty`, written**, where its range
/// is one and not the type's true ends (#1810): `±2^62` for an `i64`,
/// `0..2^62` for a `u64`, "" for every other type.
fn prover_proof_window(ty: ref String) -> String sync {
    return match ty {
        "i64" => "±2^62",
        "u64" => "0..2^62",
        else => "",
    }
}

/// The length of the list `base` names, as a term: a literal's, or that of a
/// name or a path of fields the walk follows, a text's for its `.bytes`.
/// Null where none is known.
fn prover_length_of(mut walk: ProverWalk, base: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> i64? {
    let given = length_given(walk.arena, words, base, scope, walk.state.pinned)
    if given != null {
        return given
    }
    let counted = text_literal_length(base)
    if counted != null {
        return walk.arena.int(counted ?? 0)
    }
    let length = length_path(base, words, fn(name) { scope.ints.contains(name) }) ?? return null
    return walk.arena.var(length)
}

/// `goal`, a check the program does not write, asked as an `assert` is for
/// a refutation only (ADR-269 D8): `NK1207` where what is known rules it out
/// every time, or where exactly what reaches it breaks it. Nothing on a
/// claim about data from outside (D6) or one left open.
fn prover_refuted_check(mut walk: ProverWalk, goal: i64, written: String, fails: String, help: String, span: Span, scope: ref ProverScope, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) {
    let mut read: collections::BTreeSet[String] = collections::BTreeSet()
    walk.arena.variables(goal, read)
    for name in read {
        if scope.tainted.contains(name) {
            return
        }
    }
    let always = refuting_values(walk.arena, scope.facts, goal, ask, model)
    if always != null {
        let values = always ?? collections::BTreeMap()
        walk.findings.push(Finding { code: "NK1207", span: span, message: f"`{written}` {fails} every time it is reached.", notes: [f"What is known before it rules the check out: {shown(values)}."], help: help, warning: false, labels: [] })
        return
    }
    let sometimes = breaking_values(walk.arena, scope, goal, model) ?? return
    walk.findings.push(Finding { code: "NK1207", span: span, message: f"`{written}` {fails} when {shown(sometimes)}.", notes: ["That state reaches it: what is known here pins every name the check depends on."], help: help, warning: false, labels: [] })
}

fn prover_calls_in_maybe(mut walk: ProverWalk, expr: ref Expr?, span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    let present = expr ?? return
    prover_calls_in(walk, present, span, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
}

/// Every block `expr` holds, as `contracts::sync`'s walk reaches them: a
/// lambda's body - which runs during the call it is given to - included.
fn prover_blocks_in(mut walk: ProverWalk, expr: ref Expr, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    match expr {
        // **A call checked against a type's rule first** (ADR-369 D3): the
        // block of `assert`s and the call changes no name, so it reads what
        // is known where it stands (#776).
        Expr::Block(block, _) => {
            if prover_claims_then_value(block, words) {
                prover_block(walk, block, scope.clone(), at.inside(false), program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            } else {
                prover_nested(walk, block, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::AsyncGroup(block, _, _, _, _) => {
            if prover_claims_then_value(block, words) {
                prover_block(walk, block, scope.clone(), at.inside(false), program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            } else {
                prover_nested(walk, block, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Unsafe(block, _) => prover_nested(walk, block, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Overlap(block, _) => prover_nested(walk, block, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition),
        Expr::Closure { params, mutable, body, .. } => {
            let mut names: Vec[String] = []
            for p in params {
                names.push(words.resolve(p).clone())
            }
            for p in mutable {
                names.push(words.resolve(p).clone())
            }
            prover_nested(walk, body, names, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Call { func, args, config, .. } => {
            prover_blocks_in(walk, func, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_blocks_in(walk, arg, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_blocks_in(walk, c.value, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::MethodCall { receiver, args, config, .. } => {
            prover_blocks_in(walk, receiver, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_blocks_in(walk, arg, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_blocks_in(walk, c.value, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            prover_blocks_in(walk, receiver, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            for arg in args {
                prover_blocks_in(walk, arg, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
            for c in config {
                prover_blocks_in(walk, c.value, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        // **An `if` inside an expression runs where the expression does**
        // (ADR-396 D4): each branch knows the bindings around it and its
        // condition, as a statement's does; `let c = if nl < s.len() {
        // s[nl + 1..] } else { "" }` reads `nl` as the `let` before set it.
        Expr::If { cond, then_branch, else_branch, .. } => {
            let holds = claim_term(cond, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
            let mut fails: i64? = null
            if holds != null {
                fails = walk.arena.not(holds ?? 0)
            }
            let else_facts = prover_branch_facts(walk, cond, scope, words, false, fails)
            let mut then_scope = scope.clone()
            then_scope.facts.extend(prover_branch_facts(walk, cond, scope, words, true, holds))
            then_scope.exact = then_scope.exact && holds != null
            then_scope.on_the_path(walk.arena, holds)
            prover_block(walk, then_branch, then_scope, at.inside(false), program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            let mut else_scope = scope.clone()
            prover_else(walk, else_branch, else_scope, fails, else_facts, at.inside(false), program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::TryCatch { expr, handler, .. } => {
            prover_blocks_in(walk, expr, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            prover_nested(walk, handler, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
        },
        Expr::Match { arms, .. } => {
            for arm in arms {
                prover_blocks_in(walk, arm.body, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        Expr::Select(arms, _) => {
            for arm in arms {
                prover_nested(walk, arm.body, null, scope, at, program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
            }
        },
        else => {},
    }
}

/// A nested block: a lambda's body, `lambda` its parameters, knows what the
/// bindings around it hold - called as often as the callee likes, or never;
/// any other block's bindings this walk cannot see, so it starts blind.
fn prover_nested(mut walk: ProverWalk, block: ref Block, lambda: Vec[String]?, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    let is_lambda = lambda != null
    if is_lambda {
        let mut inner = scope.clone()
        for param in lambda ?? [] {
            inner.rebind(walk.arena, param)
            inner.maps.remove(param)
            inner.loose.insert(param.clone())
        }
        inner.path = null
        inner.exact = false
        prover_block(walk, block, inner, at.inside(true), program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    } else {
        let mut inner = scope.blind()
        prover_block(walk, block, inner, at.inside(false), program, words, own, library, ask, model, escape, holes_of, unaliased, written_of, condition)
    }
}

/// **A call by name**: an edge of the call graph, what the call shows of
/// the callee's precondition, and where that shows nothing broken, of the
/// checks nobody writes in its body (ADR-395 D1): one diagnostic per call.
fn prover_a_call(mut walk: ProverWalk, callee: ref String, call: i64, args: ref Vec[Expr], config: ref Vec[ConfigArg], span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, unaliased: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    if scope.locals.contains(callee) {
        return
    }
    let caller = carrying_function(at.function)
    if caller != null {
        walk.state.edges.insert((caller ?? "", callee.clone()))
    }
    let told = walk.findings.len()
    // **A call inside an argument is a whole number of its own**, as inside
    // an `assert` (ADR-314 D3): what its callee ensures holds of it, and its
    // summary answers a precondition what is known leaves open (ADR-359 D2,
    // D14) - `need(kind(m) + 1)`.
    if !walk.state.in_test && prover_an_argument_calls(args) {
        let mut here = scope.clone()
        for arg in args {
            prover_call_results(walk, arg, false, here, program, words, own, unaliased, condition, written_of)
        }
        prover_call_precondition(walk, callee, call, args, config, span, here, at, program, words, own, library, ask, model, escape, written_of, condition)
    } else {
        prover_call_precondition(walk, callee, call, args, config, span, scope, at, program, words, own, library, ask, model, escape, written_of, condition)
    }
    if walk.state.collecting && walk.state.known_unwritten.contains_key(callee) {
        let function = free_function(program, words, callee) ?? return
        let all = arguments_in_order(function, args, config, words)
        walk.state.carry_unwritten(walk.arena, words, callee, function.params, all, span, scope, at, ask, model)
        return
    }
    if walk.findings.len() == told && !walk.state.collecting && walk.state.unwritten.contains_key(callee) {
        let function = free_function(program, words, callee) ?? return
        let all = arguments_in_order(function, args, config, words)
        prover_unwritten_call(walk, callee, function.params, all, span, scope, words, ask, model)
    }
}

/// Whether an argument holds a call, in the arithmetic the prover reads.
fn prover_an_argument_calls(args: ref Vec[Expr]) -> bool {
    for arg in args {
        if prover_reads_a_call(arg) {
            return true
        }
    }
    return false
}

fn prover_reads_a_call(expr: ref Expr) -> bool {
    return match expr {
        Expr::Call { .. } => true,
        Expr::Binary { lhs, rhs, .. } => prover_reads_a_call(lhs) || prover_reads_a_call(rhs),
        Expr::Unary { expr, .. } => prover_reads_a_call(expr),
        Expr::Cast { expr, .. } => prover_reads_a_call(expr),
        else => false,
    }
}

/// Where the callee of a call by name has a precondition - its own, as the
/// walk before found it in the first pass, or another package's ledger's -
/// what the call shows of it.
fn prover_call_precondition(mut walk: ProverWalk, callee: ref String, call: i64, args: ref Vec[Expr], config: ref Vec[ConfigArg], span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    // The first pass reads the walk before's preconditions: its own are still
    // being found.
    let pre = if walk.state.collecting { prover_precondition_in(walk.state.known, callee) } else { prover_precondition_in(walk.state.preconditions, callee) }
    if pre != null {
        let function = free_function(program, words, callee) ?? return
        let found = pre ?? Precondition::none()
        let all = arguments_in_order(function, args, config, words)
        prover_record_call(walk, callee, function.params, found.claims, all, null, span, scope, at, words, ask, model, escape, written_of)
        return
    }
    // **`std`'s ledger is read where the program's is silent** (ADR-269
    // D5, #1003): `scalar::from` publishes its precondition there, and a
    // call by name is held to it as to another package's - and the
    // precondition at the call is a claim of the program, as an `assert`
    // standing there would be (ADR-380 D1): `call` keys it.
    if !own.functions.contains_key(callee) {
        let std = prover_std_requires(walk, callee, library, condition) ?? return
        prover_record_call(walk, callee, std.params, std.requires, args, call, span, scope, at, words, ask, model, escape, written_of)
        return
    }
    let foreign = prover_foreign_contract(walk, callee, own, condition) ?? return
    if !foreign.requires.is_empty() {
        prover_record_call(walk, callee, foreign.params, foreign.requires, args, null, span, scope, at, words, ask, model, escape, written_of)
    }
}

/// **A call `self.m(…)` in a method of a type to that type's own method**
/// (ADR-269 D5, #776): `m`'s precondition is proved here as a free
/// function's is at a call by name, or carried back to the caller's entry.
/// **A call on any other receiver** reaches the method its type resolves
/// to (ADR-269 D20, #2225).
fn prover_a_method_call(mut walk: ProverWalk, receiver: ref Expr, method: winnow_grammar::Symbol, call: i64, args: ref Vec[Expr], config: ref Vec[ConfigArg], span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    if (prover_variable_named(receiver, words) ?? "") != "self" {
        prover_a_call_on(walk, receiver, method, call, args, config, span, scope, at, program, words, library, ask, model, escape, written_of, condition)
        return
    }
    let function = carrying_function(at.function) ?? return
    let cut = function.rfind("::") ?? return
    let owner = function[0..<cut].clone()
    let name = words.resolve(method).clone()
    let callee = f"{owner}::{name}"
    walk.state.edges.insert((function.clone(), callee.clone()))
    let target = own_method(program, words, owner, name) ?? return
    // The receiver is put in for `self`, as on any other receiver: a
    // claim on `self.k` (D15) reads the caller's `self.k`.
    let mut params: Vec[String] = ["self"]
    params.extend(target.params.clone())
    let mut all: Vec[Expr] = [receiver.clone()]
    all.extend(arguments_in_order(target, args, config, words))
    let told = walk.findings.len()
    let pre = if walk.state.collecting { prover_precondition_in(walk.state.known, callee) } else { prover_precondition_in(walk.state.preconditions, callee) }
    if pre != null {
        let found = pre ?? return
        prover_record_call(walk, callee, params, found.claims, all, null, span, scope, at, words, ask, model, escape, written_of)
    }
    if walk.state.collecting {
        walk.state.carry_unwritten(walk.arena, words, callee, params, all, span, scope, at, ask, model)
    } else if walk.findings.len() == told {
        prover_unwritten_call(walk, callee, params, all, span, scope, words, ask, model)
    }
}

/// **A call `x.m(…)` to a method of this program on a receiver other than
/// `self`** (ADR-269 D20): called through its type's ledger entry the way a
/// free function is, the checker's `method_callees` naming the entry. The
/// receiver is put in for `self`, so a claim on `self.k` reads `x.k`.
fn prover_a_call_on(mut walk: ProverWalk, receiver: ref Expr, method: winnow_grammar::Symbol, call: i64, args: ref Vec[Expr], config: ref Vec[ConfigArg], span: Span, scope: ref ProverScope, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    let callee: String = walk.state.method_callees.get(id_of(receiver) as i64)?.clone() ?? return
    let cut = callee.rfind("::") ?? return
    let owner = callee[0..<cut].clone()
    let name = words.resolve(method).clone()
    let mine = own_method(program, words, owner, name)
    if mine == null {
        prover_std_method_call(walk, callee, call, receiver, args, span, scope, at, words, library, ask, model, escape, written_of, condition)
        return
    }
    let target = mine ?? return
    let caller = carrying_function(at.function)
    if caller != null {
        walk.state.edges.insert((caller ?? "", callee.clone()))
    }
    let mut params: Vec[String] = ["self"]
    params.extend(target.params.clone())
    let mut all: Vec[Expr] = [receiver.clone()]
    all.extend(arguments_in_order(target, args, config, words))
    let told = walk.findings.len()
    let pre = if walk.state.collecting { prover_precondition_in(walk.state.known, callee) } else { prover_precondition_in(walk.state.preconditions, callee) }
    if pre != null {
        let found = pre ?? return
        prover_record_call(walk, callee, params, found.claims, all, null, span, scope, at, words, ask, model, escape, written_of)
    }
    if walk.state.collecting {
        walk.state.carry_unwritten(walk.arena, words, callee, params, all, span, scope, at, ask, model)
    } else if walk.findings.len() == told {
        prover_unwritten_call(walk, callee, params, all, span, scope, words, ask, model)
    }
}

/// **A call `x.m(…)` to a `std` method with a precondition** (ADR-269 D5,
/// ADR-381 D5): held to `std`'s ledger as a call by name is, the receiver
/// put in for `self` - `xs.binary_search(v)` asks `xs.is_sorted()` - and,
/// as there, a claim of the program at the call, keyed by `call`.
fn prover_std_method_call(mut walk: ProverWalk, callee: ref String, call: i64, receiver: ref Expr, args: ref Vec[Expr], span: Span, scope: ref ProverScope, at: ref ProverWhere, words: ref winnow_grammar::InternerContext, library: ref Ledger, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) {
    let std = prover_std_requires(walk, callee, library, condition) ?? return
    let mut all: Vec[Expr] = [receiver.clone()]
    all.extend(args.clone())
    prover_record_call(walk, callee, std.params, std.requires, all, call, span, scope, at, words, ask, model, escape, written_of)
}

/// **What a call's arguments show of the checks nobody writes in its
/// callee** (ADR-306 D15, ADR-395 D1): a refutation only, as `NK1207` at the
/// call.
fn prover_unwritten_call(mut walk: ProverWalk, callee: ref String, params: ref Vec[String], args: ref Vec[Expr], span: Span, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync) {
    let checks = walk.state.unwritten[callee]?.clone() ?? return
    let found = walk.state.unwritten_call(walk.arena, words, callee, params, checks, args, span, scope, ask, model, walk.outside)
    walk.findings.extend(found)
}

/// What a call shows of its callee's precondition, recorded: its findings,
/// and how it reaches the callee, joined with any call that reads the same.
/// `std_call`, the call's id where the precondition is `std`'s: then it is
/// also a claim of its own, held and listed as an `assert` is (#1003).
fn prover_record_call(mut walk: ProverWalk, callee: ref String, params: ref Vec[String], claims: ref Vec[PreClaim], args: ref Vec[Expr], std_call: i64?, span: Span, scope: ref ProverScope, at: ref ProverWhere, words: ref winnow_grammar::InternerContext, ask: fn(ref logic::TermArena, ref Vec[i64], i64) -> SolverAnswer sync, model: fn(ref logic::TermArena, ref Vec[i64], i64) -> collections::BTreeMap[String, i64]? sync, escape: fn(ref String) -> String sync, written_of: fn(ref Expr) -> String sync) {
    let outcome = walk.state.precondition_call(walk.arena, words, callee, params, claims, args, std_call != null, span, scope, at, ask, model, escape)
    for found in outcome.findings {
        walk.findings.push(found.clone())
    }
    if std_call != null && !outcome.held.is_empty() {
        let key = (span.start as i64, std_call ?? 0)
        let mut conditions: Vec[String] = []
        for pre in claims {
            conditions.push(claim_text_of(pre.computed) ?? pre.written.clone())
        }
        walk.std_claims.insert(key, f"{callee}: {conditions.join(" && ")}")
        walk.held.insert(key, prover_std_held(outcome.held))
    }
    let mut written: String = ""
    for arg in args {
        if !written.is_empty() {
            written.push_str(", ")
        }
        written.push_str(written_of(arg))
    }
    let key = (callee.clone(), written)
    let before = walk.reaches.remove(key)
    if before != null {
        walk.reaches.insert(key, joined_reach(before ?? CallReach::Proved, outcome.reach))
    } else {
        walk.reaches.insert(key, outcome.reach)
    }
}

/// **Another package's contract, read back into terms** (ADR-269 D18), once
/// per function: each `requires` and `ensures` the ledger states, parsed as
/// the language's own syntax over the parameters' names. Nothing where the
/// ledger has no such function; a condition that does not read back is left
/// out, which only ever proves less.
fn prover_foreign_contract(mut walk: ProverWalk, key: ref String, own: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> Foreign? {
    let cached = prover_cached_foreign(walk.state.foreign, key)
    if cached != null {
        return cached
    }
    let contract = own.functions[key] ?? return null
    let shape = foreign_shape(contract)
    let mut requires: Vec[i64] = []
    for text in contract.requires {
        requires.push(prover_condition_term(walk.arena, text, shape.names, condition))
    }
    let mut ensures: Vec[i64] = []
    for text in contract.ensures {
        ensures.push(prover_condition_term(walk.arena, text, shape.names, condition))
    }
    let foreign = foreign_from(contract, shape, requires, ensures)
    walk.state.foreign.insert(key.clone(), foreign.clone())
    return foreign
}

/// **A `std` function's contract, where it has a precondition** (ADR-269
/// D5): only then, and kept out of the cache of other packages' contracts,
/// so that what a call to `std` is known to give stays what the bounds walk
/// reads of it.
fn prover_std_requires(mut walk: ProverWalk, key: ref String, library: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> Foreign? {
    let contract = library.functions[key] ?? return null
    if contract.requires.is_empty() {
        return null
    }
    let mut shape = foreign_shape(contract)
    let owner = key[0..<(key.rfind("::") ?? 0)].clone()
    let mut requires: Vec[i64] = []
    for text in contract.requires {
        let property = prover_std_property_named(text, owner, walk.state.std_properties)
        if property != null {
            shape.names.insert(property ?? "")
        }
        requires.push(prover_condition_term(walk.arena, text, shape.names, condition))
    }
    return foreign_from(contract, shape, requires, [])
}

/// **The named property a `std` precondition asks of its receiver**
/// (ADR-381 D1, D5): `self.prop@.is_sorted()` of `self.is_sorted()`, where
/// `owner`'s method is one of `std`'s properties; else `null`.
fn prover_std_property_named(text: ref String, owner: ref String, properties: ref collections::BTreeSet[String]) -> String? {
    let called = text.strip_prefix("self.") ?? return null
    let open = called.find("(") ?? return null
    if !called.ends_with(")") || !properties.contains(f"{owner}::{called[0..<open]}") {
        return null
    }
    return f"self.{property_mark()}.{called}"
}

/// **How a `std` precondition at one call is held**, from how each of its
/// conditions is: the least proved of them - checked at run time before a
/// precondition of the caller, before proved.
fn prover_std_held(helds: ref Vec[ClaimHeld]) -> ClaimHeld {
    let mut worst = ClaimHeld::Proved
    for held in helds {
        match held {
            ClaimHeld::AtRunTime(_) => return held.clone(),
            ClaimHeld::Proved => {},
            else => {
                worst = held.clone()
            },
        }
    }
    return worst
}

/// A condition read back into the arena: its term, or `-1` where it does not
/// read back.
fn prover_condition_term(mut arena: logic::TermArena, text: ref String, names: ref collections::BTreeSet[String], condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> i64 {
    let nodes = condition(text, names)
    if nodes.is_empty() {
        return -1
    }
    return arena.adopt(nodes)
}

/// What a call's postconditions say of the name its result is bound to: the
/// callee's own, or another package's ledger's.
fn prover_postconditions_of(mut walk: ProverWalk, callee: ref String, args: ref Vec[Expr], config: ref Vec[ConfigArg], bound: ref String, scope: ref ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> Vec[i64] {
    let posts = standing_posts(walk.state.postconditions, callee)
    if posts != null {
        let function = free_function(program, words, callee) ?? return []
        let all = arguments_in_order(function, args, config, words)
        return postconditions_for(walk.arena, posts ?? [], function.params, all, bound, scope, words, walk.state.pinned)
    }
    let foreign = prover_foreign_contract(walk, callee, own, condition) ?? return []
    return postconditions_for(walk.arena, foreign.ensures, foreign.params, args, bound, scope, words, walk.state.pinned)
}

/// Whether a function hands back a whole number.
fn prover_returns_whole(mut walk: ProverWalk, callee: ref String, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> bool {
    let function = free_function(program, words, callee)
    if function != null {
        let found = function ?? return false
        return found.whole_result
    }
    let foreign = prover_foreign_contract(walk, callee, own, condition) ?? return false
    return foreign.whole_result
}

/// Whether a call may throw out of the function `at` is.
fn prover_throws(call: ref Expr, at: ref ProverWhere, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, library: ref Ledger, unaliased: fn(ref String) -> String sync) -> bool {
    return may_throw(call, at.throws_out, program, words, own, library, unaliased)
}

/// The callee a call names, where it is a function by name: a bare name, or
/// a path as the ledger keys it.
fn prover_called(func: ref Expr, words: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync) -> String? {
    return match func {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        Expr::Path(segments, _) => prover_qualified(segments, words, unaliased),
        else => null,
    }
}

/// The callee a `let`'s value calls, where no local shadows it.
fn prover_bound_callee(func: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync) -> String? {
    return match func {
        Expr::Variable(name, _) => {
            let text = words.resolve(name)
            if scope.locals.contains(text) {
                return null
            }
            text.clone()
        },
        Expr::Path(segments, _) => prover_qualified(segments, words, unaliased),
        else => null,
    }
}

/// A path callee as the ledger keys it: `mathx::percent`, unaliased.
fn prover_qualified(segments: ref Vec[winnow_grammar::Symbol], words: ref winnow_grammar::InternerContext, unaliased: fn(ref String) -> String sync) -> String {
    let mut joined: String = ""
    for segment in segments {
        if !joined.is_empty() {
            joined.push_str("::")
        }
        joined.push_str(words.resolve(segment))
    }
    return unaliased(joined)
}

/// Whether a call is one of the checker's `assert`s.
fn prover_an_assert_call(func: ref Expr, args: ref Vec[Expr], span: Span, claims: ref collections::BTreeSet[(i64, i64)]) -> bool {
    let named = match func {
        Expr::Variable(_, _) => true,
        else => false,
    }
    if !named || args.len() != 1 {
        return false
    }
    return claims.contains((span.start as i64, node_key(args[0])))
}

/// **The claims of an `unsafe` block of nothing but `assume`s** (ADR-376
/// D1), which hold after it: a block that does anything else may change what
/// they speak of, and keeps them to itself.
fn prover_assumed_in_unsafe(block: ref Block, words: ref winnow_grammar::InternerContext) -> Vec[Expr] {
    let mut out: Vec[Expr] = []
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Expr(inner) => {
                match inner {
                    Expr::Call { func, args, .. } => {
                        if !prover_an_assume(func, words) || args.len() != 1 {
                            return []
                        }
                        out.push(args[0].clone())
                    },
                    else => return [],
                }
            },
            else => return [],
        }
    }
    return out
}

/// Whether a claim the checker kept is an `assume` (ADR-376 D1).
fn prover_an_assume(func: ref Expr, words: ref winnow_grammar::InternerContext) -> bool {
    return match func {
        Expr::Variable(name, _) => words.resolve(name) == "assume",
        else => false,
    }
}

/// Whether an `assert` is a type's rule the compiler gives at an entry
/// (ADR-369 D3): marked by an option no program can write.
fn prover_a_given_rule(config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext) -> bool {
    for option in config {
        if words.resolve(option.name) == "rule of the type" {
            return true
        }
    }
    return false
}

/// The `message:` an `assert` gives, where it is text as written.
fn prover_message(config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext) -> String? {
    for c in config {
        if words.resolve(c.name) == "message" {
            match c.value {
                Expr::LitStr { text, .. } => return text.clone(),
                else => {},
            }
        }
    }
    return null
}

/// Whether a statement is an `assert` and nothing else: it changes no value.
fn prover_a_claim_stmt(stmt: ref Stmt, words: ref winnow_grammar::InternerContext) -> bool {
    return match stmt {
        Stmt::Expr(inner) => match inner {
            Expr::Call { func, args, .. } => args.len() == 1 && (prover_variable_named(func, words) ?? "") == "assert",
            else => false,
        },
        else => false,
    }
}

/// **The named properties a claim reads** (ADR-381 D1): each call
/// `p(x, …)` of a `sync` function of the program that hands back a `bool`,
/// changes none of its arguments, has no options and does not throw, or
/// `x.m(…)` of such a method, each argument a path; with the prover's name
/// for it (`prove_terms.nika`, `property_name`) and its first path.
fn prover_properties_in(expr: ref Expr, scope: ref ProverScope, state: ref ProverState, program: ref Program, words: ref winnow_grammar::InternerContext, mut out: Vec[(String, String)]) {
    match expr {
        Expr::Binary { lhs, rhs, .. } => {
            prover_properties_in(lhs, scope, state, program, words, out)
            prover_properties_in(rhs, scope, state, program, words, out)
        },
        Expr::Unary { expr, .. } => prover_properties_in(expr, scope, state, program, words, out),
        Expr::Call { func, args, .. } => {
            if !prover_a_property_callee(func, scope, state, program, words) {
                return
            }
            let name = property_name(expr, words) ?? return
            let on = path_of(args[0], words) ?? return
            out.push((name, on))
        },
        Expr::MethodCall { receiver, method, .. } => {
            let callee = state.method_callees.get(id_of(receiver) as i64) ?? ""
            if !state.std_properties.contains(callee) && !prover_a_method_property(program, words, words.resolve(method)) {
                return
            }
            let name = property_name(expr, words) ?? return
            let on = path_of(receiver, words) ?? return
            out.push((name, on))
        },
        else => {},
    }
}

/// The facts of `facts` that read only named properties of `bound`, which
/// become names of the proof (ADR-381 D2).
fn prover_property_facts(mut walk: ProverWalk, mut scope: ProverScope, bound: ref String, facts: ref Vec[i64], call: String) {
    for fact in facts {
        let mut read: collections::BTreeSet[String] = collections::BTreeSet()
        walk.arena.variables(fact, read)
        let mut only = !read.is_empty()
        for n in read {
            if (property_base(n) ?? "") != bound {
                only = false
            }
        }
        if only {
            scope.ints.extend(read.clone())
            scope.loose.extend(read.clone())
            scope.facts.push(fact)
            for n in read {
                scope.known_from.insert(n.clone(), f"what `{call}` ensures")
            }
        }
    }
}

/// Each named property of `cond` not known yet is known from `source`.
fn prover_properties_from(cond: ref Expr, source: String, mut scope: ProverScope, state: ref ProverState, program: ref Program, words: ref winnow_grammar::InternerContext) {
    let mut found: Vec[(String, String)] = []
    prover_properties_in(cond, scope, state, program, words, found)
    for (name, _) in found {
        if !scope.known_from.contains_key(name) {
            scope.known_from.insert(name.clone(), source.clone())
        }
    }
}

/// Where the named properties `cond` reads are known from, where each is.
fn prover_known_from(cond: ref Expr, scope: ref ProverScope, state: ref ProverState, program: ref Program, words: ref winnow_grammar::InternerContext) -> String? {
    let mut found: Vec[(String, String)] = []
    prover_properties_in(cond, scope, state, program, words, found)
    let mut sources: Vec[String] = []
    for (name, _) in found {
        let source = scope.known_from[name] ?? return null
        if !sources.contains(source) {
            sources.push(source.clone())
        }
    }
    if sources.is_empty() {
        return null
    }
    return sources.join(" and ")
}

/// The type a given rule's `assert` is of (`tr_given`).
fn prover_rule_type(config: ref Vec[ConfigArg], words: ref winnow_grammar::InternerContext) -> String {
    for c in config {
        if words.resolve(c.name) == "rule of the type" {
            match c.value {
                Expr::LitStr { text, .. } => return text.clone(),
                else => {},
            }
        }
    }
    return ""
}

/// **Whether a call's callee makes a named property** (ADR-381 D1, D5): a
/// function of the program no local hides, or a free function of `std`'s
/// ledger that is one by `prover_std_properties`, by its path:
/// `html::is_plain(name)` after its guard is a fact (ADR-raw-sinks-1 D2).
fn prover_a_property_callee(func: ref Expr, scope: ref ProverScope, state: ref ProverState, program: ref Program, words: ref winnow_grammar::InternerContext) -> bool {
    return match func {
        Expr::Variable(name, _) => {
            let callee = words.resolve(name)
            !scope.locals.contains(callee) && prover_a_property(program, words, callee)
        },
        Expr::Path(segments, _) => state.std_properties.contains(path_text(segments, words)),
        else => false,
    }
}

/// Whether `wanted` is a function a named property calls (ADR-381 D1).
fn prover_a_property(program: ref Program, words: ref winnow_grammar::InternerContext, wanted: ref String) -> bool {
    for item in program.items {
        match item.node {
            Item::Fn { name, receiver, args, config, ret_type, can_throw, is_sync, .. } => {
                if receiver == null && named_as(name, words, wanted) {
                    let ty = ret_type ?? return false
                    return is_sync && !args.is_empty() && args.iter().all(fn(arg) { !arg.mutable }) && config.is_empty() && !can_throw && words.resolve(ty.name) == "bool" && ty.generics.is_empty()
                }
            },
            else => {},
        }
    }
    return false
}

/// **The `std` methods a named property may call** (ADR-381 D1, D5), by
/// their ledger keys: each that takes a receiver and hands back a `bool`,
/// is `sync` (or as `sync` as the function it is handed), changes neither
/// its receiver nor an argument, takes no options, touches nothing and
/// fails with nothing, as the ledger writes it: `Vec::is_sorted`,
/// `Vec::is_sorted_by_key`.
fn prover_std_properties(library: ref Ledger) -> collections::BTreeSet[String] {
    let mut found: collections::BTreeSet[String] = collections::BTreeSet()
    for (key, contract) in library.functions {
        let signature = contract.signature ?? continue
        if (!signature.takes_a_receiver() && signature.params.is_empty()) || !signature.mutable.is_empty() || !signature.config.is_empty() || contract.mutates || !contract.fails_with.is_empty() || !contract.touches_known || !contract.touches.is_empty() {
            continue
        }
        let pure = match contract.sync_claim {
            Sync::No => false,
            Sync::Unpromised => false,
            else => true,
        }
        let result = signature.result ?? continue
        let answers_bool = match result {
            Ty::Named { name, args, view } => name == "bool" && args.is_empty() && !view,
            else => false,
        }
        if pure && answers_bool {
            found.insert(key.clone())
        }
    }
    return found
}

/// **What each `std` method ensures of its receiver's named properties**
/// (ADR-381 D2, D5), by its ledger key: the parameters' names and each
/// `ensures` that is one of `properties` on `self`, as its name follows the
/// receiver's path: `Vec::sort` ensures `prop@.is_sorted()`,
/// `Vec::sort_by_key` `prop@.is_sorted_by_key(f)`.
fn prover_std_ensured(library: ref Ledger, properties: ref collections::BTreeSet[String]) -> collections::BTreeMap[String, (Vec[String], Vec[String])] {
    let mut found: collections::BTreeMap[String, (Vec[String], Vec[String])] = collections::BTreeMap()
    for (key, contract) in library.functions {
        if contract.ensures.is_empty() {
            continue
        }
        let signature = contract.signature ?? continue
        if !signature.takes_a_receiver() {
            continue
        }
        let owner = key[0..<(key.rfind("::") ?? 0)].clone()
        let mut rests: Vec[String] = []
        for text in contract.ensures {
            let named = prover_std_property_named(text, owner, properties) ?? continue
            rests.push((named.strip_prefix("self.") ?? continue).clone())
        }
        if rests.is_empty() {
            continue
        }
        let params: Vec[String] = signature.params.iter().map(fn(param) { param.0.clone() }).collect()
        found.insert(key.clone(), (params, rests))
    }
    return found
}

/// **What a `std` method ensures of its receiver holds after the call**
/// (ADR-381 D2, D5): `xs.sort()` makes `xs.is_sorted()` known, and
/// `xs.sort_by_key(by_id)` `xs.is_sorted_by_key(by_id)`, from here until
/// the list may change (`prover_follow_elements` drops it there). A
/// function handed as a closure is no path, so nothing is known of it.
fn prover_std_ensures_after(mut walk: ProverWalk, stmt: ref Stmt, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) {
    let expr = match stmt {
        Stmt::Expr(e) => e,
        else => return,
    }
    match expr {
        Expr::MethodCall { receiver, args, .. } => {
            let callee: String = walk.state.method_callees.get(id_of(receiver) as i64)?.clone() ?? return
            let ensured = walk.state.std_ensured.get(callee)?.clone() ?? return
            let on = path_of(receiver, words) ?? return
            let mut all: Vec[Expr] = [receiver.clone()]
            all.extend(args.clone())
            for rest in ensured.1 {
                let given = property_given(rest, ensured.0, all, words) ?? continue
                let name = f"{on}.{given}"
                scope.ints.insert(name.clone())
                scope.loose.insert(name.clone())
                let named = walk.arena.var(name)
                let one = walk.arena.int(1)
                scope.facts.push(walk.arena.equal(named, one))
                scope.known_from.insert(name.clone(), f"what `{callee}` ensures")
            }
        },
        else => {},
    }
}

/// **Whether `wanted` is a method a named property calls** (ADR-381 D1):
/// every method of that name the program's types have is `sync`, hands
/// back a `bool`, changes neither its receiver nor an argument, has no
/// options and does not throw; and there is one.
fn prover_a_method_property(program: ref Program, words: ref winnow_grammar::InternerContext, wanted: ref String) -> bool {
    let mut found = false
    for item in program.items {
        match item.node {
            Item::Impl { methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { name, receiver, args, config, ret_type, can_throw, is_sync, .. } => {
                            if !named_as(name, words, wanted) {
                                continue
                            }
                            let lent = receiver ?? return false
                            let ty = ret_type ?? return false
                            if lent.is_mut || lent.is_keep || !is_sync || !args.iter().all(fn(arg) { !arg.mutable }) || !config.is_empty() || can_throw || words.resolve(ty.name) != "bool" || !ty.generics.is_empty() {
                                return false
                            }
                            found = true
                        },
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    return found
}

/// **Whether `stmt` may change the argument `base` of a named property**
/// (ADR-381 D1, D2): `elements_change`, but the condition of an `if` that
/// hands `base` only to named properties changes nothing, since a property
/// changes nothing, so a guard `return if !p(xs)` keeps what it made known,
/// and so does an `unsafe` block of `assume`s.
fn prover_property_changed(stmt: ref Stmt, base: ref String, scope: ref ProverScope, state: ref ProverState, program: ref Program, words: ref winnow_grammar::InternerContext) -> bool {
    let expr = match stmt {
        Stmt::Expr(e) => e,
        else => return elements_change(stmt, base, words),
    }
    return match expr {
        Expr::If { cond, then_branch, else_branch, .. } => {
            if prover_condition_changes(cond, base, scope, state, program, words) || !elements_stay(then_branch, base, words) {
                return true
            }
            let other = else_branch ?? return false
            !elements_stay(other, base, words)
        },
        // **Nor does an `assume` of one** (ADR-376 D1): `unsafe {
        // assume(xs.is_sorted()) }` keeps what it vouches for.
        Expr::Unsafe(block, _) => {
            let assumed = prover_assumed_in_unsafe(block, words)
            if assumed.is_empty() {
                return elements_change(stmt, base, words)
            }
            for cond in assumed {
                if prover_condition_changes(cond, base, scope, state, program, words) {
                    return true
                }
            }
            false
        },
        else => elements_change(stmt, base, words),
    }
}

/// Whether the condition `cond` may change `base`: a named property of it
/// does not (ADR-381 D1), in either form, anything else as `seek_expr`
/// says.
fn prover_condition_changes(cond: ref Expr, base: ref String, scope: ref ProverScope, state: ref ProverState, program: ref Program, words: ref winnow_grammar::InternerContext) -> bool {
    match cond {
        Expr::Unary { expr, .. } => return prover_condition_changes(expr, base, scope, state, program, words),
        Expr::Binary { lhs, rhs, .. } => return prover_condition_changes(lhs, base, scope, state, program, words) || prover_condition_changes(rhs, base, scope, state, program, words),
        Expr::Call { func, .. } => {
            if prover_a_property_callee(func, scope, state, program, words) && property_name(cond, words) != null {
                return false
            }
        },
        // **A property in method form changes nothing either** (ADR-381
        // D1): `return if !xs.is_sorted()` keeps `xs.is_sorted()` known.
        Expr::MethodCall { receiver, method, .. } => {
            let callee = state.method_callees.get(id_of(receiver) as i64) ?? ""
            if (state.std_properties.contains(callee) || prover_a_method_property(program, words, words.resolve(method))) && property_name(cond, words) != null {
                return false
            }
        },
        else => {},
    }
    return seek_expr(cond, Seek::ElementsChanged(base.clone()), words)
}

/// **A claim's named properties are names of the proof from here**
/// (ADR-381 D1): known where a fact says them, open where none does.
fn prover_read_properties(cond: ref Expr, mut scope: ProverScope, state: ref ProverState, program: ref Program, words: ref winnow_grammar::InternerContext) {
    let mut found: Vec[(String, String)] = []
    prover_properties_in(cond, scope, state, program, words, found)
    for (name, _) in found {
        scope.ints.insert(name.clone())
        scope.loose.insert(name.clone())
    }
}

/// The names a claim reads without the functions its named properties
/// call, which are no values (ADR-381 D1).
fn prover_without_callees(names: collections::BTreeSet[String], cond: ref Expr, scope: ref ProverScope, state: ref ProverState, program: ref Program, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut found: Vec[(String, String)] = []
    prover_properties_in(cond, scope, state, program, words, found)
    if found.is_empty() {
        return names
    }
    let mut kept: collections::BTreeSet[String] = collections::BTreeSet()
    for n in names {
        if scope.locals.contains(n) || !prover_a_property(program, words, n) {
            kept.insert(n.clone())
        }
    }
    return kept
}

/// **A named property of a parameter is known at the entry** (ADR-381 D2,
/// ADR-269 D15): the claims at the top of the body that read one of a
/// parameter the body does not change make it a name with its value at
/// the entry, so a claim over it is a precondition.
fn prover_entry_properties(mut walk: ProverWalk, mut scope: ProverScope, mut params: collections::BTreeSet[String], kept: ref collections::BTreeSet[String], body: ref Block, program: ref Program, words: ref winnow_grammar::InternerContext) {
    for stmt in body.stmts {
        if !prover_a_claim_stmt(stmt.node, words) {
            return
        }
        let cond = match stmt.node {
            Stmt::Expr(inner) => match inner {
                Expr::Call { args, .. } => args[0].clone(),
                else => continue,
            },
            else => continue,
        }
        let mut found: Vec[(String, String)] = []
        prover_properties_in(cond, scope, walk.state, program, words, found)
        for (name, on) in found {
            if !kept.contains(on) || !property_carried(name) {
                continue
            }
            scope.ints.insert(name.clone())
            scope.loose.insert(name.clone())
            params.insert(on.clone())
            let at_entry = walk.arena.var(name)
            scope.entry.insert(name.clone(), at_entry)
        }
    }
}

/// Whether a block is `assert`s and then one expression, which binds and
/// changes nothing.
fn prover_claims_then_value(block: ref Block, words: ref winnow_grammar::InternerContext) -> bool {
    let last = block.stmts.len() - 1
    if last < 0 {
        return false
    }
    for k in 0..<last {
        if !prover_a_claim_stmt(block.stmts[k].node, words) {
            return false
        }
    }
    return match block.stmts[last].node {
        Stmt::Expr(_) => true,
        else => false,
    }
}

/// The name a `return name` hands back.
fn prover_returned_name(stmt: ref Stmt, words: ref winnow_grammar::InternerContext) -> String? {
    return match stmt {
        Stmt::Return(value) => prover_variable_named(value, words),
        else => null,
    }
}

fn prover_variable_named(value: ref Expr?, words: ref winnow_grammar::InternerContext) -> String? {
    let present = value ?? return null
    return match present {
        Expr::Variable(name, _) => words.resolve(name).clone(),
        else => null,
    }
}

/// **An assignment to a mutable whole number the walk follows** (ADR-361
/// D9): `x = e`, `x += e`, `x -= e` and `x *= k` give `x` the value over the
/// old one, which keeps what was known of it under a name of its own
/// (`x#12`, the statement's byte). False where the walk does not follow `x`
/// or cannot read the value, which then binds `x` again.
fn prover_assigned(mut walk: ProverWalk, n: ref String, op: ref BinaryOp?, value: ref Expr, span: Span, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    if !scope.mutables.contains(n) {
        return false
    }
    let read = value_term(value, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return false
    let mut term = read
    if op != null {
        if !scope.ints.contains(n) {
            return false
        }
        let old = walk.arena.var(n)
        let written = op ?? return false
        term = match written {
            BinaryOp::Add => walk.arena.add(old, read),
            BinaryOp::Sub => walk.arena.sub(old, read),
            BinaryOp::Mul => {
                if walk.arena.constant(read) == null {
                    return false
                }
                walk.arena.mul(old, read)
            },
            else => return false,
        }
    }
    // **An old value what is known pins to a number is that number**: the
    // new one then needs no earlier name, and a loop after it starts there.
    if walk.arena.mentions(term, n) {
        let known = prover_known_value(walk.arena, scope.facts, n)
        if known != null {
            let mut pinned: collections::BTreeMap[String, i64] = collections::BTreeMap()
            pinned.insert(n.clone(), walk.arena.int(known ?? 0))
            term = walk.arena.substitute(term, pinned)
            let folded = walk.arena.constant(term)
            if folded != null {
                term = walk.arena.int(folded ?? 0)
            }
        }
    }
    prover_assign_term(walk, n, term, span, scope)
    return true
}

/// **`n` takes the value `term`** (ADR-361 D9), which may read `n`'s old
/// value: the old one becomes a name of the history.
fn prover_assign_term(mut walk: ProverWalk, n: ref String, term: i64, span: Span, mut scope: ProverScope) {
    let at_entry = scope.at_entry(walk.arena, term)
    let mut read_names: collections::BTreeSet[String] = collections::BTreeSet()
    walk.arena.variables(term, read_names)
    let mut loose = false
    for name in read_names {
        if scope.loose.contains(name) {
            loose = true
        }
    }
    let earlier = f"{n}#{span.start}"
    scope.renamed(walk.arena, n, earlier)
    let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
    given.insert(n.clone(), walk.arena.var(earlier))
    let over = walk.arena.substitute(term, given)
    let named = walk.arena.var(n)
    let fact = walk.arena.equal(named, over)
    // A value that reads an earlier one is known only through the history.
    let mut over_names: collections::BTreeSet[String] = collections::BTreeSet()
    walk.arena.variables(over, over_names)
    let mut earlier_read = false
    for name in over_names {
        if name.contains("#") {
            earlier_read = true
        }
    }
    if earlier_read {
        scope.history.push(fact)
    } else {
        scope.facts.push(fact)
    }
    scope.ints.insert(n.clone())
    if loose {
        scope.loose.insert(n.clone())
    }
    if at_entry != null {
        scope.entry.insert(n.clone(), at_entry ?? 0)
    }
}

/// The number a fact `n == k` pins `n` to.
fn prover_known_value(arena: ref logic::TermArena, facts: ref Vec[i64], n: ref String) -> i64? {
    for fact in facts {
        match arena.at(fact) {
            logic::SolverTerm::Eq(a, b) => {
                if arena.is_the_variable(a, n) {
                    let value = arena.constant(b)
                    if value != null {
                        return value
                    }
                }
            },
            else => {},
        }
    }
    return null
}

/// Whether a block binds one name with `let mut`.
fn prover_binds_mutable(block: ref Block) -> bool {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, mutable, .. } => {
                if mutable && names.len() == 1 {
                    return true
                }
            },
            else => {},
        }
    }
    return false
}

/// **The mutable whole numbers, after a statement** (ADR-361 D1): `let mut`
/// binds one the walk follows where its value is a term and nothing in
/// the block hands it on; a statement that changes one inside it - a branch,
/// a block - leaves it unknown. A `while`, a `for`, an `if` and an
/// assignment see to their own (ADR-361 D9).
fn prover_follow_mutables(mut walk: ProverWalk, stmt: ref Stmt, span: Span, mut scope: ProverScope, untracked: ref collections::BTreeSet[String], pinned: ref collections::BTreeSet[String], program: ref Program, words: ref winnow_grammar::InternerContext) {
    prover_follow_lengths(walk, stmt, span, scope, words)
    prover_follow_elements(walk, stmt, scope, program, words)
    match stmt {
        Stmt::Let { names, mutable, ty, value, .. } => {
            if mutable && names.len() == 1 {
                let n = words.resolve(names[0]).clone()
                if !pinned.contains(n) {
                    prover_mutable_list(walk, n, ty, value, scope, words)
                }
                // A call's result `prover_let` read (#1009): followed from
                // what the callee ensures, or dropped if not followed.
                let term = value_term(value, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes)
                let of_call = term == null && match value {
                    Expr::Call { .. } => scope.ints.contains(n),
                    else => false,
                }
                if of_call && untracked.contains(n) {
                    scope.rebind(walk.arena, n)
                } else if of_call {
                    scope.mutables.insert(n.clone())
                } else if !untracked.contains(n) && term != null && !walk.arena.mentions(term ?? 0, n) {
                    let v = term ?? 0
                    let at_entry = scope.at_entry(walk.arena, v)
                    scope.ints.insert(n.clone())
                    scope.mutables.insert(n.clone())
                    let named = walk.arena.var(n)
                    scope.facts.push(walk.arena.equal(named, v))
                    if at_entry != null {
                        scope.entry.insert(n.clone(), at_entry ?? 0)
                    }
                } else if !untracked.contains(n) && prover_let_typed(walk, ty, span, words, 0) {
                    // **A value the walk cannot read is a loose name** (ADR-361
                    // D9, #2108), as a `let`'s is (`prover_let`).
                    scope.ints.insert(n.clone())
                    scope.loose.insert(n.clone())
                    scope.mutables.insert(n.clone())
                }
            }
        },
        Stmt::While { .. } => {},
        Stmt::For { .. } => {},
        // An assignment, an `if` and a `match` see to their own (D9).
        Stmt::Assign { .. } => {},
        else => {
            if !scope.mutables.is_empty() && !prover_a_branch(stmt) {
                for n in assigned_in_statement(stmt, words) {
                    if scope.mutables.contains(n) {
                        scope.rebind(walk.arena, n)
                    }
                }
            }
        },
    }
}

/// **What is known of a list's elements is followed** (ADR-306 D33): an
/// element `xs[c]` (`c` a name or a literal) is a name while nothing may
/// have changed it: a write through any index of the list, a method that
/// may change its items, the list handed on or bound again (D20, D17), or
/// `c` bound again drop it. A `let` of a list literal then learns
/// `xs[i] == v` of each item whose value is a term.
fn prover_follow_elements(mut walk: ProverWalk, stmt: ref Stmt, mut scope: ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext) {
    let mut gone: Vec[String] = []
    // **A named property goes where its argument may change** (ADR-381 D1):
    // a call that holds it, a write, binding it again. A claim changes
    // nothing (ADR-269 D3); a `let` bound the name again itself, before
    // what its call ensures (`prover_let`).
    let bound: Vec[String] = match stmt {
        Stmt::Let { names, .. } => names.iter().map(fn(name) { words.resolve(name).clone() }).collect(),
        else => [],
    }
    if !prover_a_claim_stmt(stmt, words) {
        for n in scope.ints {
            // Each argument: `p(xs, n)` goes where `xs` or `n` may change.
            for base in property_args(n) {
                if bound.contains(path_root(base)) {
                    continue
                }
                // A function of the program handed to it, `by_id` of
                // `xs.is_sorted_by_key(by_id)`, is no value and never
                // changes (ADR-381 D1).
                if !scope.locals.contains(base) && free_function(program, words, base) != null {
                    continue
                }
                if prover_property_changed(stmt, base, scope, walk.state, program, words) || rebinds_in_statement(stmt, path_root(base), words) {
                    gone.push(n.clone())
                    break
                }
            }
        }
    }
    for n in scope.ints {
        let inner = n.strip_suffix("]") ?? continue
        let parts: Vec[ref String] = inner.split("[").collect()
        if parts.len() != 2 {
            continue
        }
        if elements_change(stmt, parts[0], words) || rebinds_in_statement(stmt, parts[1], words) {
            gone.push(n.clone())
        }
    }
    for n in gone {
        scope.rebind(walk.arena, n)
    }
    prover_std_ensures_after(walk, stmt, scope, words)
    match stmt {
        Stmt::Let { names, value, .. } => {
            if names.len() != 1 {
                return
            }
            // Not `untracked`: a write through an index, the list handed
            // on, are the drops above, statement by statement.
            let list = words.resolve(names[0]).clone()
            match value {
                Expr::ListLit { items, .. } => {
                    for (i, item) in items.iter().enumerate() {
                        let term = lin_term(item, words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? continue
                        let element = f"{list}[{i}]"
                        if walk.arena.mentions(term, list) {
                            continue
                        }
                        let at_entry = scope.at_entry(walk.arena, term)
                        scope.ints.insert(element.clone())
                        let named = walk.arena.var(element)
                        scope.facts.push(walk.arena.equal(named, term))
                        if at_entry != null {
                            scope.entry.insert(element.clone(), at_entry ?? 0)
                        }
                    }
                },
                else => {},
            }
        },
        else => {},
    }
}

/// **An element a loop may change is unknown at the head of a turn**
/// (ADR-306 D33), and past the loop: one whose list the body may change, or
/// whose index the body or the loop binds again. The list itself may be kept
/// (`prover_loop_keeps`); its elements are not.
fn prover_loop_elements(mut walk: ProverWalk, body: ref Block, counters: ref Vec[winnow_grammar::Symbol], mut scope: ProverScope, words: ref winnow_grammar::InternerContext) {
    let mut gone: Vec[String] = []
    // A named property a loop's body may change goes before it (ADR-381
    // D1), whichever of its arguments the body may change.
    for n in scope.ints {
        for base in property_args(n) {
            if !elements_stay(body, base, words) || rebinds(body, path_root(base), words) {
                gone.push(n.clone())
                break
            }
        }
    }
    for n in scope.ints {
        let inner = n.strip_suffix("]") ?? continue
        let parts: Vec[ref String] = inner.split("[").collect()
        if parts.len() != 2 {
            continue
        }
        if !elements_stay(body, parts[0], words) || rebinds(body, parts[1], words) || any_symbol(counters, parts[1], words) {
            gone.push(n.clone())
        }
    }
    for n in gone {
        scope.rebind(walk.arena, n)
    }
}

/// **A `let mut` list's length is followed** (#782) as a mutable whole
/// number (ADR-361 D1) under `length_of`: a list literal's is its items', a
/// repeated one's its count, a written `Vec`'s is unknown but not negative.
fn prover_mutable_list(mut walk: ProverWalk, n: ref String, ty: ref Type?, value: ref Expr, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) {
    let length = length_of(n)
    match value {
        Expr::ListLit { items, .. } => {
            let known: i64? = items.len()
            scope.has_length(walk.arena, n, known)
        },
        else => {
            if !prover_list_length(walk, n, value, scope, words) {
                let t = ty ?? return
                if words.resolve(t.name) != "Vec" {
                    return
                }
                scope.has_length(walk.arena, n, null)
            }
        },
    }
    scope.mutables.insert(length)
}

/// **A repeated list's or `Bytes(x)`'s length, where it is bound** (#782,
/// #1084): `length_given`'s term, unless it reads the name bound or its
/// length, as `let v = Bytes(v)` does: that is about the old binding.
/// False where the value gives no length (a name too: the caller's rule).
fn prover_list_length(mut walk: ProverWalk, n: ref String, value: ref Expr, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    match value {
        Expr::ListRepeat { .. } => {},
        Expr::Call { .. } => {},
        else => return false,
    }
    let term = length_given(walk.arena, words, value, scope, walk.state.pinned)
    match value {
        Expr::Call { .. } => {
            if term == null {
                return false
            }
        },
        else => {},
    }
    let length = length_of(n)
    scope.has_length(walk.arena, n, null)
    if term != null && !walk.arena.mentions(term ?? 0, n) && !walk.arena.mentions(term ?? 0, length) {
        let named = walk.arena.var(length)
        scope.facts.push(walk.arena.equal(named, term ?? 0))
        scope.loose.remove(length)
    }
    return true
}

/// **The lengths of the followed lists, after a statement** (#782): `push`,
/// `clear`, `resize` and `truncate` on the list as a statement of its own say
/// what it becomes; anything else that may change it - another method, the
/// list handed to a call - leaves it unknown. An `if` and a loop see to
/// their own (`prover_join`, `prover_lengths_changed`).
fn prover_follow_lengths(mut walk: ProverWalk, stmt: ref Stmt, span: Span, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) {
    match stmt {
        Stmt::While { .. } => return,
        Stmt::For { .. } => return,
        else => {},
    }
    if prover_a_branch(stmt) {
        return
    }
    let mut lists: Vec[String] = []
    for m in scope.mutables {
        if m.ends_with(".len()") {
            lists.push((m.strip_suffix(".len()") ?? "").clone())
        }
    }
    for list in lists {
        if prover_list_given(walk, stmt, list, scope, words) {
            continue
        }
        if !changes_length_in_statement(stmt, list, walk.state.readers, words) {
            continue
        }
        if !prover_length_set(walk, stmt, list, span, scope, words) {
            prover_forget_length(walk, list, scope)
        }
    }
}

/// **A followed list given a new value, `list = value`** (#1664), is
/// followed on: its length is the new value's, as `let mut` gives it
/// (`prover_mutable_list`), or unknown but not negative. The assignment
/// bound the name again (`rebind`), which dropped what was known of the old
/// length, and an `if` around it joins the two (`prover_join`). False for
/// any other statement.
fn prover_list_given(mut walk: ProverWalk, stmt: ref Stmt, list: ref String, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    let value = match stmt {
        Stmt::Assign { target, op, value } => {
            if op != null {
                return false
            }
            match target {
                Expr::Variable(name, _) => {
                    if words.resolve(name) != list {
                        return false
                    }
                },
                else => return false,
            }
            value
        },
        else => return false,
    }
    let length = length_of(list)
    scope.rebind(walk.arena, length)
    match value {
        Expr::ListLit { items, .. } => {
            let known: i64? = items.len()
            scope.has_length(walk.arena, list, known)
        },
        else => {
            if !prover_list_length(walk, list, value, scope, words) {
                scope.has_length(walk.arena, list, null)
            }
        },
    }
    return true
}

/// **The followed lists an `if`'s condition or a `match`'s value may
/// change** (#782, #1476): `if !fill(units) { return }` hands `units` to a
/// call, so its length is unknown on both sides and after.
fn prover_condition_lengths(mut walk: ProverWalk, cond: ref Expr, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) sync {
    let mut lists: Vec[String] = []
    for m in scope.mutables {
        if m.ends_with(".len()") {
            lists.push((m.strip_suffix(".len()") ?? "").clone())
        }
    }
    for list in lists {
        if changes_length_in_expr(cond, list, walk.state.readers, words) {
            let length = length_of(list)
            scope.rebind(walk.arena, length)
            scope.has_length(walk.arena, list, null)
        }
    }
}

/// `list`'s length unknown again, but not negative.
fn prover_forget_length(mut walk: ProverWalk, list: ref String, mut scope: ProverScope) {
    let length = length_of(list)
    scope.rebind(walk.arena, length)
    scope.has_length(walk.arena, list, null)
}

/// **What a statement `list.push(x)`, `list.clear()`, `list.resize(n, x)` or
/// `list.truncate(n)` makes `list`'s length**; false for any other.
fn prover_length_set(mut walk: ProverWalk, stmt: ref Stmt, list: ref String, span: Span, mut scope: ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    let expr = match stmt {
        Stmt::Expr(e) => e,
        else => return false,
    }
    let length = length_of(list)
    if !scope.ints.contains(length) {
        scope.has_length(walk.arena, list, null)
    }
    return match expr {
        Expr::MethodCall { receiver, method, args, .. } => {
            let on = match receiver {
                Expr::Variable(name, _) => words.resolve(name) == list,
                else => false,
            }
            if !on {
                return false
            }
            let m = words.resolve(method).clone()
            if m == "push" && args.len() == 1 {
                let old = walk.arena.var(length)
                let one = walk.arena.int(1)
                let term = walk.arena.add(old, one)
                prover_assign_term(walk, length, prover_pinned_old(walk, length, term, scope), span, scope)
                return true
            }
            if m == "clear" && args.is_empty() {
                let zero = walk.arena.int(0)
                prover_assign_term(walk, length, zero, span, scope)
                return true
            }
            if (m == "resize" && args.len() == 2) || (m == "truncate" && args.len() == 1) {
                let n = lin_term(args[0], words, fn(name) { scope.ints.contains(name) }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return false
                if m == "resize" {
                    prover_assign_term(walk, length, n, span, scope)
                    return true
                }
                // `truncate(n)` leaves the smaller of the old length and `n`.
                let earlier = f"{length}#{span.start}"
                scope.renamed(walk.arena, length, earlier)
                let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
                given.insert(length.clone(), walk.arena.var(earlier))
                let bound = walk.arena.substitute(n, given)
                let old = walk.arena.var(earlier)
                let named = walk.arena.var(length)
                let cut = walk.arena.equal(named, bound)
                let shorter = walk.arena.le(bound, old)
                let kept = walk.arena.equal(named, old)
                let longer = walk.arena.le(old, bound)
                let first = walk.arena.and([cut, shorter])
                let second = walk.arena.and([kept, longer])
                scope.history.push(walk.arena.or([first, second]))
                scope.ints.insert(length.clone())
                scope.not_negative(walk.arena, length)
                scope.loose.insert(length.clone())
                return true
            }
            false
        },
        else => false,
    }
}

/// `term` with the old value of `n` replaced by the number the facts pin it
/// to, as `prover_assigned` does: the new one then needs no earlier name.
fn prover_pinned_old(mut walk: ProverWalk, n: ref String, term: i64, scope: ref ProverScope) -> i64 {
    let known = prover_known_value(walk.arena, scope.facts, n) ?? return term
    let mut pinned: collections::BTreeMap[String, i64] = collections::BTreeMap()
    pinned.insert(n.clone(), walk.arena.int(known))
    let replaced = walk.arena.substitute(term, pinned)
    let folded = walk.arena.constant(replaced) ?? return replaced
    return walk.arena.int(folded)
}

/// **The followed list lengths `body` may change** (#782), added to
/// `changed`: a loop forgets them, a join tells its sides apart by them.
fn prover_lengths_changed(mut changed: collections::BTreeSet[String], body: ref Block, scope: ref ProverScope, readers: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    for m in scope.mutables {
        if m.ends_with(".len()") {
            let list = (m.strip_suffix(".len()") ?? "").clone()
            // **Bound again on one side** (`list = other`), its length is
            // the new list's: not what it was (#1476).
            if changes_length_in(body, list, readers, words) || rebinds(body, list, words) {
                changed.insert(m.clone())
            }
        }
    }
}

fn prover_else_lengths_changed(mut changed: collections::BTreeSet[String], else_branch: ref Block?, scope: ref ProverScope, readers: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    let block = else_branch ?? return
    prover_lengths_changed(changed, block, scope, readers, words)
}

/// **A name of a loop's state** (ADR-361 D1, D15): a whole number, or a
/// followed list's length the turn changes only in statements the loop's
/// problem reads (`loop_block`): not in the condition, and the list never
/// bound again.
fn prover_length_follows(n: ref String, cond: ref Expr, body: ref Block, readers: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) -> bool {
    if !n.ends_with(".len()") {
        return true
    }
    let list = (n.strip_suffix(".len()") ?? "").clone()
    return !changes_length_in_expr(cond, list, readers, words) && !rebinds(body, list, words)
}

/// **A followed list a loop changes only through an index** (#782) keeps
/// its length: nothing binds it again, and nothing changes the length. So
/// does a `mut` list parameter whose length is a name of the proof (#1375,
/// #1385): the whole body keeps it, so the loop's element writes do too.
fn prover_loop_keeps(n: ref String, changed: ref collections::BTreeSet[String], body: ref Block, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    let length = length_of(n)
    return scope.ints.contains(length) && !changed.contains(length) && !rebinds(body, n, words)
}

/// **A followed list's length a loop forgets** (#782) is still a length:
/// never negative.
fn prover_relength(mut walk: ProverWalk, n: ref String, mut scope: ProverScope) {
    if n.ends_with(".len()") && scope.mutables.contains(n) {
        scope.has_length(walk.arena, (n.strip_suffix(".len()") ?? "").clone(), null)
    }
}

/// Whether a statement is an `if` or a `match` standing as one: its walk
/// joins what its sides change (ADR-361 D9).
fn prover_a_branch(stmt: ref Stmt) -> bool {
    return match stmt {
        Stmt::Expr(expr) => match expr {
            Expr::If { .. } => true,
            Expr::Match { .. } => true,
            else => false,
        },
        else => false,
    }
}

fn prover_symbol_text(symbol: ref winnow_grammar::Symbol?, words: ref winnow_grammar::InternerContext) -> String? {
    let present = symbol ?? return null
    return words.resolve(present).clone()
}

/// `prover_typed` of a `let`'s type, where a `let` written without one has
/// the type the checker gave it: a whole number (#1358), a list, a text or
/// a map (ADR-396 D4).
fn prover_let_typed(walk: ref ProverWalk, ty: ref Type?, span: Span, words: ref winnow_grammar::InternerContext, asked: i64) -> bool {
    if ty != null {
        return prover_typed(ty, words, asked)
    }
    let inferred = walk.state.whole_lets.get(span.start as i64) ?? return false
    if asked == 0 {
        return is_whole_number(inferred)
    }
    if asked == 1 {
        return is_whole_number(inferred) && inferred.starts_with("u")
    }
    if asked == 2 {
        return has_a_length(inferred)
    }
    return a_map_type(inferred)
}

/// What a `let`'s written type says: `0` a whole number, `1` an unsigned
/// one, `2` a list or text, which has a length, `3` a map.
fn prover_typed(ty: ref Type?, words: ref winnow_grammar::InternerContext, asked: i64) -> bool {
    let t = ty ?? return false
    let name = words.resolve(t.name)
    if asked == 0 {
        return t.generics.is_empty() && is_whole_number(name)
    }
    if asked == 1 {
        return name.starts_with("u")
    }
    if asked == 2 {
        return has_a_length(name)
    }
    return a_map_type(name)
}

/// A function's name as `nikaia test` makes it from a `test` block:
/// `__nikaia_test_` and a number.
fn prover_a_test_function(name: ref String?) -> bool {
    let text = name ?? return false
    let prefix = "__nikaia_test_"
    if !text.starts_with(prefix) || text.len() == prefix.len() {
        return false
    }
    let c: Vec[scalar] = text.scalars.collect()
    for k in 14..<c.len() {
        if c[k] < '0' || c[k] > '9' {
            return false
        }
    }
    return true
}

fn prover_precondition_in(map: ref collections::BTreeMap[String, Precondition], callee: ref String) -> Precondition? {
    let found = map[callee] ?? return null
    return found.clone()
}

fn prover_cached_foreign(map: ref collections::BTreeMap[String, Foreign?], key: ref String) -> Foreign? {
    let found = map[key] ?? return null
    return found.clone()
}

/// **The calls with arguments the build knows that `expr` reads** (ADR-359
/// D11): each call in it whose callee is a function by name that hands back
/// a whole number and whose arguments [`folded_whole`] gives, and the calls
/// the bindings it reads hold. Each is kept in the walk's state by
/// `call_result_name`, with its callee and its arguments' values.
fn prover_known_calls(mut walk: ProverWalk, expr: ref Expr, scope: ref ProverScope, program: ref Program, words: ref winnow_grammar::InternerContext, own: ref Ledger, holes_of: fn(ref Expr) -> Vec[Expr] sync, unaliased: fn(ref String) -> String sync, condition: fn(ref String, ref collections::BTreeSet[String]) -> Vec[logic::SolverTerm] sync) -> collections::BTreeSet[String] {
    let mut found: collections::BTreeSet[String] = collections::BTreeSet()
    for one in visited_in_expr(expr) {
        match one {
            Expr::Call { func, args, config, .. } => {
                let callee = prover_bound_callee(func, scope, words, unaliased)
                if callee != null && config.is_empty() {
                    let c = callee ?? ""
                    let mut values: Vec[i64] = []
                    let mut all = true
                    for arg in args {
                        let v = folded_whole(arg, words, fn(n) { prover_pinned(walk.state.pinned, scope, n) })
                        if v == null {
                            all = false
                        } else {
                            values.push(v ?? 0)
                        }
                    }
                    if all && prover_returns_whole(walk, c, program, words, own, condition) {
                        let name = call_result_name(one)
                        walk.state.call_sites.insert(name.clone(), one.clone())
                        walk.state.call_args.insert(name.clone(), (c.clone(), values))
                        found.insert(name)
                    }
                }
            },
            else => {},
        }
    }
    if scope.calls_of.is_empty() {
        return found
    }
    let read = claim_names_in(expr, words, holes_of)
    for (bound, calls) in scope.calls_of {
        if read.contains(bound) {
            found.extend(calls.clone())
        }
    }
    return found
}

/// What a claim comes to once the calls it reads were asked of the build.
struct ProverRan {
    held: ClaimHeld,
    findings: Vec[Finding],
}

/// **A claim and the calls with known arguments it reads** (ADR-359 D11-D13):
/// where it is still checked at run time, a call not run yet is wanted - the
/// compiler runs it and walks again -, a call that could not run says why
/// (D12), and one whose run stopped is a check the compiler shows fails
/// (`NK1207`). A refusal names the value of each call it read.
fn prover_claim_ran(mut walk: ProverWalk, read: ref collections::BTreeSet[String], held: ClaimHeld, findings: Vec[Finding], written: String, span: Span, written_of: fn(ref Expr) -> String sync) -> ProverRan {
    let mut out = ProverRan { held: held.clone(), findings: [] }
    let mut values: Vec[String] = []
    for call in read {
        let text = written_of(walk.state.call_sites[call] ?? continue)
        let value = walk.state.pinned[call]
        if value != null {
            values.push(f"`{text}` is {value ?? 0}, run while the program was built")
        }
    }
    let joined = values.join("; ")
    for found in findings {
        let mut one = found.clone()
        if one.code == "NK1207" && !values.is_empty() {
            one.notes.push(f"{joined}.")
        }
        out.findings.push(one)
    }
    let open = prover_open_reason(held) ?? return out
    // A claim what is known already rules out needs no run.
    if open.starts_with("it is false") {
        return out
    }
    let mut why = open.clone()
    for call in read {
        if walk.state.pinned[call] != null {
            continue
        }
        let text = written_of(walk.state.call_sites[call] ?? continue)
        let stop = walk.state.stopped[call]
        if stop != null {
            let words_said = (stop ?? "").clone()
            if !walk.state.collecting {
                out.findings.push(Finding {
                    code: "NK1207",
                    span: span,
                    message: f"`{text}` stops the program every time it is reached, before `{written}` is checked.",
                    notes: [f"The compiler ran `{text}` while the program was built, as the program runs it, and it stopped: {words_said}."],
                    help: "Fix the call, or the function it calls, as you would fix the program stopping there.",
                    warning: false,
                    labels: [],
                })
            }
            why = f"{why}; `{text}` stops the program: {words_said}"
            continue
        }
        let not = walk.state.not_run[call]
        if not != null {
            let because = (not ?? "").clone()
            why = f"{why}; `{text}` was not run while the program was built: {lowered_first(without_full_stops(because))}"
            continue
        }
        walk.state.wanted.insert(call.clone())
    }
    out.held = ClaimHeld::AtRunTime(why)
    return out
}

/// Why a claim is checked at run time, where it is.
fn prover_open_reason(held: ref ClaimHeld) -> String? {
    return match held {
        ClaimHeld::AtRunTime(why) => why.clone(),
        else => null,
    }
}

/// **The bounds a mask or a shift gives a whole number** (#776): `e & c` or
/// `c & e`, with a constant `c >= 0`, is in `0..=c`; `(e >> k).bits_as_i64()`
/// - only an unsigned value has `bits_as_i64` - shifted right by a constant
/// `2 <= k < 64` is in `0..<2^(64 - k)`. Nothing for any other value.
fn prover_bit_range(mut walk: ProverWalk, expr: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> ProverBits? {
    match expr {
        Expr::Binary { op, lhs, rhs, .. } => {
            if op != BinaryOp::BitAnd {
                return null
            }
            let mut mask = prover_constant_of(walk, rhs, scope, words) ?? -1
            if mask < 0 {
                mask = prover_constant_of(walk, lhs, scope, words) ?? -1
            }
            if mask < 0 {
                return null
            }
            return ProverBits { lo: 0, hi: mask }
        },
        Expr::MethodCall { receiver, method, args, .. } => {
            if !args.is_empty() || words.resolve(method) != "bits_as_i64" {
                return null
            }
            match receiver {
                Expr::Binary { op, rhs, .. } => {
                    if op != BinaryOp::Shr {
                        return null
                    }
                    let k = prover_constant_of(walk, rhs, scope, words) ?? return null
                    if k < 2 || k > 63 {
                        return null
                    }
                    let by = 64 - k
                    let top: i64 = 1 << by
                    return ProverBits { lo: 0, hi: top - 1 }
                },
                else => {},
            }
        },
        else => {},
    }
    return null
}

/// The value of `expr` where it reads only numbers the build knows.
fn prover_constant_of(mut walk: ProverWalk, expr: ref Expr, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> i64? {
    let term = lin_term(expr, words, fn(name) { false }, fn(name) { prover_pinned(walk.state.pinned, scope, name) }, walk.arena.nodes) ?? return null
    return walk.arena.constant(term)
}

/// **The bounded names a loop keeps bounded** (#776): of the names it
/// changes that a mask or a shift bounds before it, those every assignment in
/// `body` gives, with `=`, a value inside the same bounds.
fn prover_loop_bits(mut walk: ProverWalk, scope: ref ProverScope, changed: ref collections::BTreeSet[String], body: ref Block, words: ref winnow_grammar::InternerContext) -> collections::BTreeMap[String, ProverBits] {
    let mut out: collections::BTreeMap[String, ProverBits] = collections::BTreeMap()
    for n in changed {
        if !scope.bits.contains_key(n) {
            continue
        }
        let before = scope.bits[n] ?? continue
        if prover_assigns_inside(walk, body, n, before, scope, words) {
            out.insert(n.clone(), ProverBits { lo: before.lo, hi: before.hi })
        }
    }
    return out
}

/// Whether every assignment to `name` in `block`, at any depth, is an `=` of
/// a value inside `bounds`.
fn prover_assigns_inside(mut walk: ProverWalk, block: ref Block, name: ref String, bounds: ref ProverBits, scope: ref ProverScope, words: ref winnow_grammar::InternerContext) -> bool {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Assign { target, op, value } => {
                match target {
                    Expr::Variable(assigned, _) => {
                        if words.resolve(assigned) == name {
                            if op != null {
                                return false
                            }
                            let bits = prover_bit_range(walk, value, scope, words) ?? return false
                            if bits.lo < bounds.lo || bits.hi > bounds.hi {
                                return false
                            }
                        }
                    },
                    else => {},
                }
            },
            Stmt::While { cond, .. } => {
                for inner in blocks_of_expr(cond) {
                    if !prover_assigns_inside(walk, inner, name, bounds, scope, words) {
                        return false
                    }
                }
            },
            Stmt::For { iter, .. } => {
                for inner in blocks_of_expr(iter) {
                    if !prover_assigns_inside(walk, inner, name, bounds, scope, words) {
                        return false
                    }
                }
            },
            else => {},
        }
        for inner in blocks_of_stmt(stmt.node) {
            if !prover_assigns_inside(walk, inner, name, bounds, scope, words) {
                return false
            }
        }
    }
    return true
}

/// **The free functions of `program` with no `mut` parameter** (#782): a
/// list handed to one of them keeps its length.
/// **The functions a whole number handed to keeps its value**: the
/// program's free functions without a `mut` parameter, and each free function
/// of the ledgers whose signature has none.
fn prover_value_readers(readers: ref collections::BTreeSet[String], own: ref Ledger, library: ref Ledger) -> collections::BTreeSet[String] sync {
    let mut all = readers.clone()
    for (key, contract) in library.functions {
        if prover_reads_only(contract) {
            all.insert(key.clone())
        }
    }
    for (key, contract) in own.functions {
        if prover_reads_only(contract) {
            all.insert(key.clone())
        }
    }
    return all
}

/// A ledger's free function with no `mut` parameter.
fn prover_reads_only(contract: ref FnContract) -> bool sync {
    return match contract.signature {
        null => false,
        sig => !sig.takes_a_receiver() && sig.mutable.is_empty(),
    }
}

/// **The free functions a list handed to keeps its length** (#782, #1385):
/// the readers, and each free function whose `mut` parameters are all lists
/// (or text) its body neither binds again nor grows or shrinks, handing them
/// only to such functions. Derived as the other callee facts are (ADR-269
/// D17): every candidate is assumed to keep them, and one whose body does
/// not under that assumption is struck, until none falls, so a recursive
/// call keeps them where the rest of the body does.
fn prover_length_keepers(program: ref Program, readers: ref collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut keepers = readers.clone()
    let mut candidates: Vec[String] = []
    for item in program.items {
        match item.node {
            Item::Fn { name, receiver, args, .. } => {
                if receiver == null && name != null {
                    let mut lists = true
                    for arg in args {
                        if arg.mutable && !has_a_length(words.resolve(arg.ty.name)) {
                            lists = false
                        }
                    }
                    let n = words.resolve(name ?? continue).clone()
                    if lists && !readers.contains(n) {
                        keepers.insert(n.clone())
                        candidates.push(n)
                    }
                }
            },
            else => {},
        }
    }
    let mut falling = true
    while falling {
        falling = false
        for item in program.items {
            match item.node {
                Item::Fn { name, receiver, args, body, .. } => {
                    if receiver != null || name == null {
                        continue
                    }
                    let n = words.resolve(name ?? continue).clone()
                    if !candidates.contains(n) || !keepers.contains(n) {
                        continue
                    }
                    for arg in args {
                        let arg_name = words.resolve(arg.name).clone()
                        if arg.mutable && (changes_length_in(body, arg_name, keepers, words) || rebinds(body, arg_name, words)) {
                            keepers.remove(n)
                            falling = true
                            break
                        }
                    }
                },
                else => {},
            }
        }
    }
    return keepers
}

fn prover_readers(program: ref Program, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut readers: collections::BTreeSet[String] = collections::BTreeSet()
    for item in program.items {
        match item.node {
            Item::Fn { name, receiver, args, .. } => {
                if receiver == null {
                    let mut reads = true
                    for arg in args {
                        if arg.mutable {
                            reads = false
                        }
                    }
                    if reads && name != null {
                        readers.insert(words.resolve(name ?? return readers).clone())
                    }
                }
            },
            else => {},
        }
    }
    return readers
}
