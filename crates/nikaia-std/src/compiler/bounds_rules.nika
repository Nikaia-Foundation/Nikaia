// crates/nikaia-std/src/compiler/bounds_rules.nika
//
// **Rules the walk finds between a struct's private list fields** (ADR-369
// D4, #1330): two lists pushed together are as long as each other, and a list
// of positions only ever takes a position of another list. Neither is
// written; the walk reads them off the source as candidates, checks each
// against every method that writes the fields, and uses those that hold as
// facts at the start of every method of the type and at reads through a
// value of the type.
//
// Three kinds, of a type `owner` and its fields `a` and `b`:
//
// * `length`: `a.len() == b.len()`. A candidate where every method that
//   writes either length writes both, and every literal of the type builds
//   them equal; it holds where every method that writes the fields keeps it,
//   given it at its start.
// * `index`: every element of `a` lies in `0..b.len()`. A candidate where `a`
//   holds whole numbers and every literal builds it empty; it holds where
//   each push to `a` and each element written by `=` is proved to put a
//   position of `b`, nothing else adds to or writes into `a`, and nothing
//   takes from `b`. `b` may be `a` itself (ADR-306 D22, union-find's
//   `parent`): a push then puts at most the length before it.
// * `result`: the method `a` hands back a position of `b`: what a push to
//   `a` may put. It holds where each `return` of the method is proved to.
// * `ascending`: `a[i] <= a[i + 1]` of a list of whole numbers `a` (ADR-306
//   D21, #1688; `b` empty). A candidate where every literal builds `a` empty
//   or of one item; it holds where each push puts at least every element,
//   and nothing but `pop`, `truncate` and `clear` changes `a`. A read of the
//   last element, a `pop` and a `last()` bound every element left.
//
// **A candidate that fails is dropped; nothing is refused** (ADR-369 D4): a
// rule is never published, and a site it does not prove keeps its check.
// What the candidates read is the source and the frames (`bounds_frame.nika`,
// ADR-391 D2); a write the walk cannot follow drops the candidate before any
// proof is asked.

use std::collections
use std::text

/// **A rule between two list fields of `owner`**: `kind` is `length`,
/// `index` or `result` (above); for `result`, `a` is the method.
pub struct BoundsRule {
    pub owner: String,
    pub kind: String,
    pub a: String,
    pub b: String,
    /// Of a `length` rule, `len(a) == times * len(b)` (ADR-306 D25); 1 else.
    pub times: i64,
}

/// The last segment of a type's name: `BTreeMap` of `collections::BTreeMap`.
fn rules_last_name(name: ref String) -> String {
    return (name.split("::").last() ?? "").clone()
}

/// A field a file beside changes (`BoundsBeside.changed`), with a local
/// bound to a call `f().field` named by the type `f` returns, or by the
/// field alone where `returns` does not know `f` (#1930).
fn rules_changed_name(name: ref String, returns: ref collections::BTreeMap[String, String]) -> String {
    let parts: Vec[ref String] = name.split("().").collect()
    if parts.len() != 2 {
        return name.clone()
    }
    let ty = returns.get(parts[0]) ?? return parts[1].clone()
    return f"{ty}.{parts[1]}"
}

/// The most rounds a type's candidates are checked: each drops at least
/// one, so this bounds only a type with many.
fn rules_rounds() -> i64 {
    return 8
}

// --- The candidates, read off the source -------------------------------------

/// **Every candidate of the program**, read with the frames `context`
/// holds.
fn rules_candidates(
    program: ref Program,
    beside: ref Vec[ref BoundsBeside],
    context: ref BoundsContext,
    words: ref winnow_grammar::InternerContext,
) -> Vec[BoundsRule] {
    // **A `pub` field is a candidate where every write to it is in the
    // build** (ADR-306 D22): its type is not `pub`, or the package is a
    // program no other package imports. A field, `pub` or not, is a
    // candidate only where no file beside writes, empties or reorders it, or
    // hands it on (`BoundsBeside.changed`, #1755).
    let mut a_program = false
    for item in program.items {
        match item.node {
            Item::Fn { name, .. } => {
                let named = name ?? continue
                a_program = a_program || words.resolve(named) == "main"
            },
            else => {},
        }
    }
    // A field written through a local bound to a call (`f().field`) is
    // named with the type `f` declares as its result, in whichever file of
    // the package `f` is; bare where none is known (#1930).
    let mut returns = fields_returns(program, words)
    for other in beside {
        for (f, ty) in other.returns {
            returns.insert(f.clone(), ty.clone())
        }
    }
    let mut lost: collections::BTreeSet[String] = collections::BTreeSet()
    for other in beside {
        a_program = a_program || other.has_main
        for name in other.changed {
            lost.insert(rules_changed_name(name, returns))
        }
    }
    // The private list fields of each struct that is not generic, and of
    // those, the lists of whole numbers (`T.f`) and what a literal leaving
    // a field out builds.
    let mut lists: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    let mut whole: collections::BTreeSet[String] = collections::BTreeSet()
    // Lists of lists of whole numbers (`T.f`, ADR-306 D28).
    let mut nested: collections::BTreeSet[String] = collections::BTreeSet()
    let mut defaults: collections::BTreeMap[String, String] = collections::BTreeMap()
    // The private whole-number fields of each such struct, the candidates
    // of `cap` and `floor` (#1642).
    let mut scalars: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    // The type of each field of each such struct, by its last name: what a
    // `mut` parameter of a method may be handed out of another value.
    let mut held: collections::BTreeMap[String, collections::BTreeSet[String]] = collections::BTreeMap()
    for item in program.items {
        match item.node {
            Item::Struct { name, generics, fields, is_extern, is_public, .. } => {
                if !generics.is_empty() || is_extern {
                    continue
                }
                let owner = words.resolve(name).clone()
                let mut found: Vec[String] = []
                let mut numbers: Vec[String] = []
                let mut types: collections::BTreeSet[String] = collections::BTreeSet()
                for field in fields {
                    types.insert(rules_last_name(words.resolve(field.ty.name)))
                }
                held.insert(owner.clone(), types)
                for field in fields {
                    let ty = words.resolve(field.ty.name)
                    let seen = !lost.contains(words.resolve(field.name)) && !lost.contains(f"{owner}.{words.resolve(field.name)}") && (!field.is_public || !is_public || a_program)
                    if seen && field.ty.generics.is_empty() && is_whole_number(ty) {
                        let f = words.resolve(field.name).clone()
                        if field.default != null {
                            defaults.insert(f"{owner}.{f}", rules_scalar_shape(field.default?.value))
                        }
                        numbers.push(f)
                        continue
                    }
                    if !seen || field.ty.generics.len() != 1 || (ty != "Vec" && ty != "List") {
                        continue
                    }
                    let f = words.resolve(field.name).clone()
                    let element = field.ty.generics[0]
                    if element.generics.is_empty() && is_whole_number(words.resolve(element.name)) {
                        whole.insert(f"{owner}.{f}")
                    }
                    let inner_ty = words.resolve(element.name)
                    if element.generics.len() == 1 && (inner_ty == "Vec" || inner_ty == "List") && element.generics[0].generics.is_empty() && is_whole_number(words.resolve(element.generics[0].name)) {
                        nested.insert(f"{owner}.{f}")
                    }
                    if field.default != null {
                        defaults.insert(f"{owner}.{f}", rules_shape(field.default?.value))
                        defaults.insert(f"{owner}.{f}[]", rules_inner_shape(field.default?.value))
                    }
                    found.push(f)
                }
                // One list may be a list of its own positions (ADR-306 D22);
                // two whole-number fields may bound one another (`atmost`,
                // #1681), in a type without list fields too.
                if !found.is_empty() || numbers.len() >= 2 {
                    if !numbers.is_empty() {
                        scalars.insert(owner.clone(), numbers)
                    }
                    lists.insert(owner, found)
                }
            },
            else => {},
        }
    }
    if lists.is_empty() {
        return []
    }
    // **What a method of such a type writes, its own type's methods aside**:
    // they are checked themselves, so a call to one writes nothing here.
    let mut owners: collections::BTreeSet[String] = collections::BTreeSet()
    for (owner, _) in lists {
        owners.insert(owner.clone())
    }
    // A write of a whole-number field outside the type's methods drops it
    // as a list field's write does (`rules_outside`).
    let mut every_field = lists.clone()
    for (owner, numbers) in scalars {
        let mut all = every_field.get(owner)?.clone() ?? []
        all.extend(numbers.clone())
        every_field.insert(owner.clone(), all)
    }
    let mut quiet = frame_context(context.around.clone(), context.std_receivers, context.simd_loads)
    let mut dropped: collections::BTreeSet[String] = collections::BTreeSet()
    let mut results: Vec[(String, String)] = []
    for item in program.items {
        match item.node {
            Item::Impl { target, methods, .. } => {
                let owner = words.resolve(target.name)
                if !lists.contains_key(owner) {
                    continue
                }
                for method in methods {
                    match method.node {
                        Item::Fn { name, generics, receiver, args, ret_type, .. } => {
                            let written = name ?? continue
                            let m = words.resolve(written).clone()
                            quiet.around.frames.insert(f"{owner}::{m}", nothing_changed())
                            // A method that takes a parameter `mut` may be
                            // handed a field of another value of the type:
                            // one of a field's type, the type itself or a
                            // type parameter.
                            let types = held.get(owner)?.clone() ?? collections::BTreeSet()
                            for a in args {
                                let last = rules_last_name(words.resolve(a.ty.name))
                                if a.mutable && (!generics.is_empty() || last == owner || types.contains(last)) {
                                    dropped.insert(f"{owner}.")
                                }
                            }
                            let ty = ret_type ?? continue
                            if receiver != null && ty.generics.is_empty() && is_whole_number(words.resolve(ty.name)) {
                                results.push((owner.clone(), m))
                            }
                        },
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    // Each method of such a type that writes through `mut self`, by its
    // type: the lengths of its fields it writes.
    let mut writers: collections::BTreeMap[String, Vec[collections::BTreeSet[String]]] = collections::BTreeMap()
    for item in program.items {
        match item.node {
            Item::Fn { args, body, .. } => {
                // What a builder changes of the lengths of the value it
                // builds is asked for where it hands it back.
                let made = rules_builder(body, owners, program, words)
                let mut changed = bounding_changed(body, quiet, words)
                if !made.0.is_empty() {
                    let mut kept: collections::BTreeSet[String] = collections::BTreeSet()
                    for p in changed.lengths {
                        if path_root(p) != made.0 {
                            kept.insert(p.clone())
                        }
                    }
                    changed.lengths = kept
                }
                rules_outside(changed, rules_typed(args, body, "", quiet, words), every_field, dropped)
            },
            Item::Impl { target, methods, .. } => {
                let owner = words.resolve(target.name).clone()
                for method in methods {
                    match method.node {
                        Item::Fn { receiver, args, body, .. } => {
                            let changed = bounding_changed(body, quiet, words)
                            let types = rules_typed(args, body, owner, quiet, words)
                            if (receiver?.is_mut ?? false) && lists.contains_key(owner) {
                                let lengths = rules_inside(owner, changed, types, lists, every_field, dropped)
                                let mut known = writers.get(owner)?.clone() ?? []
                                known.push(lengths)
                                writers.insert(owner.clone(), known)
                            } else {
                                rules_outside(changed, types, every_field, dropped)
                            }
                        },
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    // What every literal of each type builds each field as, in the order
    // the literals are written; a `with` that sets a field drops it.
    let mut built: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    for item in program.items {
        match item.node {
            Item::Fn { body, .. } => {
                // A builder's literal says nothing of the lengths it hands
                // back (`#len`).
                let made = rules_builder(body, owners, program, words)
                for (at, stmt) in body.stmts.iter().enumerate() {
                    if made.0.is_empty() || at != made.2 {
                        rules_built_stmt(stmt, "", every_field, defaults, built, dropped, words)
                        continue
                    }
                    match stmt.node {
                        Stmt::Let { value, .. } => match value {
                            Expr::StructLit { name, fields, .. } => {
                                rules_literal(words.resolve(name), fields, every_field, defaults, built, true, false, words)
                                rules_built_fields(fields, "", every_field, defaults, built, dropped, words)
                            },
                            else => {},
                        },
                        else => {},
                    }
                }
            },
            Item::Impl { target, methods, .. } => {
                let owner = words.resolve(target.name)
                for method in methods {
                    match method.node {
                        Item::Fn { body, .. } => rules_built_block(body, owner, every_field, defaults, built, dropped, words),
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    let mut out: Vec[BoundsRule] = []
    for (owner, fields) in lists {
        if dropped.contains(f"{owner}.") {
            continue
        }
        let methods = writers.get(owner)?.clone() ?? []
        // **`floor` and `cap` of each whole-number field** (#1642): `0 <=
        // a`, and `a <= len(b)` of each list field `b` a statement of the
        // type's methods names beside it; every literal builds them so,
        // and every method that writes the fields keeps them at its exits.
        let paired = rules_paired(program, owner, words)
        let literals = built.get(f"{owner}#lit")?.clone() ?? []
        for a in scalars.get(owner)?.clone() ?? [] {
            if dropped.contains(f"{owner}.{a}") {
                continue
            }
            let values = rules_scalar_values(literals, a, defaults.get(f"{owner}.{a}")?.clone() ?? "other")
            // `a <= b` of two whole-number fields a statement names beside
            // each other (#1681, ADR-369 D4): a budget counter and its
            // limit. Each literal builds them so, or gives a value the
            // walk asks of where it stands (`ask`, `rules_literal_holds`).
            for b in scalars.get(owner)?.clone() ?? [] {
                if a == b || dropped.contains(f"{owner}.{b}") || !paired.contains(f"{a}|{b}") {
                    continue
                }
                let limits = rules_scalar_values(literals, b, defaults.get(f"{owner}.{b}")?.clone() ?? "other")
                if rules_built_at_most(values, limits) {
                    out.push(BoundsRule { owner: owner.clone(), kind: "atmost", a: a.clone(), b: b.clone(), times: 1 })
                }
            }
            // A type without list fields gets only `atmost`: the walk
            // looked at none of its fields before (#1681).
            if fields.is_empty() {
                continue
            }
            if values.iter().all(fn(v) { v == "any" || rules_shape_length(v) >= 0 }) {
                out.push(BoundsRule { owner: owner.clone(), kind: "floor", a: a.clone(), b: "", times: 1 })
            }
            for b in fields {
                if dropped.contains(f"{owner}.{b}") || !paired.contains(f"{a}|{b}") {
                    continue
                }
                let lengths = built.get(f"{owner}.{b}#len")?.clone() ?? []
                if rules_built_within(values, lengths) {
                    out.push(BoundsRule { owner: owner.clone(), kind: "cap", a: a.clone(), b: b.clone(), times: 1 })
                }
            }
        }
        for a in fields {
            if dropped.contains(f"{owner}.{a}") {
                continue
            }
            // `ascending`: `a[i] <= a[i + 1]` of a list of whole numbers
            // every literal builds empty or of one item (ADR-306 D21, #1688).
            let built_a = built.get(f"{owner}.{a}")?.clone() ?? []
            if whole.contains(f"{owner}.{a}") && !dropped.contains(f"{owner}.{a}[]") && built_a.iter().all(fn(s) { s == "n:0" || s == "n:1" }) {
                out.push(BoundsRule { owner: owner.clone(), kind: "ascending", a: a.clone(), b: "", times: 1 })
            }
            for b in fields {
                if dropped.contains(f"{owner}.{b}") {
                    continue
                }
                // `length`, of each list with the first by name it may be
                // as long as, so that `n` lists of one length make `n - 1`
                // rules, not one for each pair; not of a list whose length a
                // body outside the type's methods changes.
                if a < b && rules_length_may(owner, a, b, 1, fields, methods, built, dropped) && !fields.iter().any(fn(c) { c < a && rules_length_may(owner, c, b, 1, fields, methods, built, dropped) }) {
                    out.push(BoundsRule { owner: owner.clone(), kind: "length", a: a.clone(), b: b.clone(), times: 1 })
                }
                // `len(a) == 2 * len(b)`: a fixed multiple, where every
                // literal builds `a` twice as long (ADR-306 D25); of the
                // first list by name of `b`'s length.
                if a != b && rules_length_may(owner, a, b, 2, fields, methods, built, dropped) && !fields.iter().any(fn(c) { c < b && rules_length_may(owner, c, b, 1, fields, methods, built, dropped) }) {
                    out.push(BoundsRule { owner: owner.clone(), kind: "length", a: a.clone(), b: b.clone(), times: 2 })
                }
                let elements_a = built.get(f"{owner}.{a}")?.clone() ?? []
                if whole.contains(f"{owner}.{a}") && !dropped.contains(f"{owner}.{a}[]") && elements_a.iter().all(fn(s) { s == "n:0" }) {
                    out.push(BoundsRule { owner: owner.clone(), kind: "index", a: a.clone(), b: b.clone(), times: 1 })
                    for (of, m) in results {
                        if of == owner && !rules_has(out, owner, "result", m, b) {
                            out.push(BoundsRule { owner: owner.clone(), kind: "result", a: m.clone(), b: b.clone(), times: 1 })
                        }
                    }
                    // `capped`: `0 <= a[i] <= len(b)` of a list a statement
                    // names beside `b`, where `b` may shrink: each shrink
                    // keeps it where every element is proved within the new
                    // length (ADR-306 D21, #1785).
                    if a != b && paired.contains(f"{a}|{b}") {
                        out.push(BoundsRule { owner: owner.clone(), kind: "capped", a: a.clone(), b: b.clone(), times: 1 })
                    }
                }
                // `inner`: every value of every inner list of `a` lies in
                // `0..b.len()`, where every literal builds `a` of empty
                // inner lists (ADR-306 D28).
                let inner_shapes = built.get(f"{owner}.{a}[]")?.clone() ?? []
                if a != b && nested.contains(f"{owner}.{a}") && !dropped.contains(f"{owner}.{a}[]") && inner_shapes.iter().all(fn(s) { s == "empty" }) {
                    out.push(BoundsRule { owner: owner.clone(), kind: "inner", a: a.clone(), b: b.clone(), times: 1 })
                }
            }
        }
    }
    return out
}

fn rules_has(rules: ref Vec[BoundsRule], owner: ref String, kind: ref String, a: ref String, b: ref String) -> bool {
    for rule in rules {
        if rule.owner == owner && rule.kind == kind && rule.a == a && rule.b == b {
            return true
        }
    }
    return false
}

/// Whether every method writes `a`'s length exactly where it writes `b`'s.
fn rules_together(methods: ref Vec[collections::BTreeSet[String]], a: ref String, b: ref String) -> bool {
    for lengths in methods {
        if lengths.contains(a) != lengths.contains(b) {
            return false
        }
    }
    return true
}

/// Whether `len(a) == times * len(b)` is a candidate of `owner`: neither
/// list dropped, nor its length changed outside the type's methods, every
/// method that writes the length of one writing the other's, and every
/// literal building them so.
fn rules_length_may(owner: ref String, a: ref String, b: ref String, times: i64, fields: ref Vec[String], methods: ref Vec[collections::BTreeSet[String]], built: ref collections::BTreeMap[String, Vec[String]], dropped: ref collections::BTreeSet[String]) -> bool {
    if a == b || !fields.contains(a) || dropped.contains(f"{owner}.{a}") || dropped.contains(f"{owner}.{b}") || dropped.contains(f"{owner}.{a}#len") || dropped.contains(f"{owner}.{b}#len") || !rules_together(methods, a, b) {
        return false
    }
    let shapes_a = built.get(f"{owner}.{a}#len")?.clone() ?? []
    let shapes_b = built.get(f"{owner}.{b}#len")?.clone() ?? []
    if times == 1 {
        return rules_built_equal(shapes_a, shapes_b)
    }
    return rules_built_times(shapes_a, shapes_b, times)
}

/// Whether every literal builds both lists as one known length.
fn rules_built_equal(a: ref Vec[String], b: ref Vec[String]) -> bool {
    if a.len() != b.len() {
        return false
    }
    for at in 0..<a.len() {
        if a[at] == "any" || b[at] == "any" {
            continue
        }
        if a[at] != b[at] || a[at] == "other" {
            return false
        }
    }
    return true
}

/// Whether every literal builds `a` as `times` the known length of `b`.
fn rules_built_times(a: ref Vec[String], b: ref Vec[String], times: i64) -> bool {
    if a.len() != b.len() {
        return false
    }
    for at in 0..<a.len() {
        if a[at] == "any" || b[at] == "any" {
            continue
        }
        if a[at] == "other" || b[at] == "other" || a[at] != f"n:{times * rules_shape_length(b[at])}" {
            return false
        }
    }
    return true
}

/// The `k` of a shape `n:k`.
fn rules_shape_length(shape: ref String) -> i64 {
    return text::parse_i64(shape.strip_prefix("n:") ?? "") ?? -1
}

/// **What a literal builds a list field as**: `n:k` for a list literal of
/// `k` items, `other` for anything else.
/// What a literal builds a list of lists as, inside: `empty` where each
/// inner list it holds is `[]` (ADR-306 D28), else `other`.
fn rules_inner_shape(value: ref Expr?) -> String {
    let given = value ?? return "other"
    match given {
        Expr::ListLit { items, .. } => {
            for item in items {
                match item {
                    Expr::ListLit { items: inside, .. } => {
                        if !inside.is_empty() {
                            return "other"
                        }
                    },
                    else => return "other",
                }
            }
            return "empty"
        },
        else => return "other",
    }
}

/// What a literal gives a whole-number field: `n:k` for a literal `k` not
/// negative, `other` for anything else (#1642).
fn rules_scalar_shape(value: ref Expr?) -> String {
    let given = value ?? return "other"
    return match given {
        Expr::LitInt { value: digits, negative, .. } => {
            let n = integer_as_count(integer(digits, negative)) ?? -1
            if n >= 0 { f"n:{n}" } else { "other" }
        },
        else => "other",
    }
}

/// **What each literal gives the field `a`**, in the order of the
/// literals (`rules_literal`): its shape where the literal names it, the
/// default where it leaves it out, `any` for a builder's.
fn rules_scalar_values(literals: ref Vec[String], a: ref String, default: ref String) -> Vec[String] {
    let mut out: Vec[String] = []
    let key = f"{a}="
    for given in literals {
        if given == "any" {
            out.push("any")
            continue
        }
        let mut shape = default.clone()
        for part in given.split(";") {
            let value = part.strip_prefix(key) ?? continue
            shape = value.clone()
        }
        out.push(shape)
    }
    return out
}

/// Whether every literal gives the field a value at most the length it
/// builds the list as.
fn rules_built_within(values: ref Vec[String], lengths: ref Vec[String]) -> bool {
    if values.len() != lengths.len() {
        return false
    }
    for at in 0..<values.len() {
        if values[at] == "any" && lengths[at] == "any" {
            continue
        }
        let v = rules_shape_length(values[at])
        let n = rules_shape_length(lengths[at])
        if v < 0 || n < 0 || v > n {
            return false
        }
    }
    return true
}

/// **Whether every literal gives `a` at most what it gives `b`** (#1681):
/// both numbers, `a`'s the smaller; or a builder's, or a value one of them
/// gives by a name or an expression, asked where the literal stands.
fn rules_built_at_most(values: ref Vec[String], limits: ref Vec[String]) -> bool {
    if values.len() != limits.len() {
        return false
    }
    for at in 0..<values.len() {
        if values[at] == "any" || limits[at] == "any" {
            continue
        }
        if values[at] == "other" || limits[at] == "other" {
            return false
        }
        let v = rules_shape_length(values[at])
        let n = rules_shape_length(limits[at])
        if v >= 0 && n >= 0 && v > n {
            return false
        }
    }
    return true
}

/// **The pairs `a|b` of fields of `owner` one statement of its methods
/// names both of on `self`** (#1642): a `cap` of `a` against `b` is a
/// candidate only there, so that a type of many fields does not ask of
/// every pair at every exit.
fn rules_paired(program: ref Program, owner: ref String, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    for item in program.items {
        match item.node {
            Item::Impl { target, methods, .. } => {
                if words.resolve(target.name) != owner {
                    continue
                }
                for method in methods {
                    match method.node {
                        Item::Fn { body, .. } => rules_paired_block(body, words, out),
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    return out
}

fn rules_paired_block(block: ref Block, words: ref winnow_grammar::InternerContext, mut out: collections::BTreeSet[String]) {
    for stmt in block.stmts {
        let mut named: collections::BTreeSet[String] = collections::BTreeSet()
        for e in check_visit_stmt(stmt.node) {
            match e {
                Expr::Field { base, name, .. } => {
                    if rules_is_self(base, words) {
                        named.insert(words.resolve(name).clone())
                    }
                },
                else => {},
            }
            for inner in check_visit_expr_blocks(e) {
                rules_paired_block(inner, words, out)
            }
        }
        match stmt.node {
            Stmt::For { body, .. } => rules_paired_block(body, words, out),
            Stmt::While { body, .. } => rules_paired_block(body, words, out),
            else => {},
        }
        for a in named {
            for b in named {
                if a != b {
                    out.insert(f"{a}|{b}")
                }
            }
        }
    }
}

fn rules_is_self(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> bool {
    return match expr {
        Expr::Variable(name, _) => words.resolve(name) == "self",
        else => false,
    }
}

fn rules_shape(value: ref Expr?) -> String {
    let given = value ?? return "other"
    return match given {
        Expr::ListLit { items, .. } => f"n:{items.len()}",
        else => "other",
    }
}

/// The field a path of fields names below its root, without what follows
/// an element: `cols` of `r.cols` and of `t.rows[i].cols`, each.
fn rules_fields_of(path: ref String) -> Vec[String] {
    let mut out: Vec[String] = []
    for (at, piece) in path.split(".").enumerate() {
        if at == 0 {
            continue
        }
        let parts: Vec[ref String] = piece.split("[").collect()
        out.push(parts[0].clone())
    }
    return out
}

/// **A write outside the methods that keep a rule**: any path it changes
/// that names a field of a candidate type's, by that name, drops the field.
fn rules_outside(changed: ref BoundsChanged, types: ref collections::BTreeMap[String, String], lists: ref collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String]) {
    let mut paths: Vec[String] = []
    for p in changed.values {
        paths.push(p.clone())
    }
    for p in changed.lengths {
        // **A length a body changes of a value whose type it knows**: a
        // push, a pop or one into an inner list is checked where it stands
        // (`rules_at_call`, ADR-306 D22, D28); only a `length` rule of the
        // list, which no exit of such a body is asked for, goes.
        let of = types.get(path_root(p))?.clone() ?? ""
        let fields = rules_fields_of(p)
        if !of.is_empty() && fields.len() == 1 && (lists.get(of)?.contains(fields[0]) ?? false) && !p.contains("].") {
            dropped.insert(f"{of}.{fields[0]}#len")
            continue
        }
        paths.push(p.clone())
    }
    for p in changed.parts {
        // Its paths of fields, by a method on such a list: checked at the
        // call (`rules_at_call`).
        let of = types.get(path_root(p))?.clone() ?? ""
        let fields = rules_fields_of(p)
        if !of.is_empty() && fields.len() == 1 && (lists.get(of)?.contains(fields[0]) ?? false) && !p.contains("].") {
            continue
        }
        paths.push(p.clone())
    }
    for place in changed.elements {
        // One element written of such a value's list, or of one of its
        // inner lists: checked where it stands (`rules_element_write`).
        let list = frame_list(place)
        let of = types.get(path_root(list))?.clone() ?? ""
        let fields = rules_fields_of(list)
        if !of.is_empty() && fields.len() == 1 && (lists.get(of)?.contains(fields[0]) ?? false) && place.ends_with("|") {
            continue
        }
        paths.push(list)
    }
    for path in paths {
        // The first field is of the root's type where that is known.
        let typed = types.get(path_root(path))
        for (at, field) in rules_fields_of(path).iter().enumerate() {
            if at == 0 && typed != null {
                let of = typed ?? continue
                if lists.get(of)?.contains(field) ?? false {
                    dropped.insert(f"{of}.{field}")
                }
                continue
            }
            for (owner, fields) in lists {
                if fields.contains(field) {
                    dropped.insert(f"{owner}.{field}")
                }
            }
        }
    }
}

/// **The type of each value a body names by one name**: `self` within an
/// `impl` of `owner`, each parameter, each name a `let` binds once to a
/// literal of a type or with a type written; a name bound twice has none.
/// **A builder** (ADR-306 D25): a free function that binds one name, by a
/// statement of its own body, to a literal of one of `owners`, hands it
/// back only by a `return` or its tail, and uses it otherwise only through
/// its fields and as the receiver of a method of its type, with no lambda
/// and no task in it. It may be handed back as a field of the literal a
/// `return` or the tail hands back (#1653), itself a field of one, and so
/// on. The `length` rules of that value are asked for where
/// it is handed back and before each such method (`rules_exit`,
/// `rules_at_call`), so neither its literal nor what it changes of its
/// lengths counts against them. The name, its type and the statement that
/// binds it; an empty name where the function is none.
fn rules_builder(body: ref Block, owners: ref collections::BTreeSet[String], program: ref Program, words: ref winnow_grammar::InternerContext) -> (String, String, i64) {
    let mut found: (String, String, i64) = ("", "", -1)
    for (at, stmt) in body.stmts.iter().enumerate() {
        match stmt.node {
            Stmt::Let { names, value, .. } => match value {
                Expr::StructLit { name: of, .. } => {
                    let written = words.resolve(of)
                    if names.len() == 1 && owners.contains(written) {
                        if !found.0.is_empty() {
                            return ("", "", -1)
                        }
                        found = (words.resolve(names[0]).clone(), written.clone(), at)
                    }
                },
                else => {},
            },
            else => {},
        }
    }
    if found.0.is_empty() || rules_escapes(body, found.0, rules_methods(program, found.1, words), true, words) {
        return ("", "", -1)
    }
    return found
}

/// The names of the methods of `owner`.
fn rules_methods(program: ref Program, owner: ref String, words: ref winnow_grammar::InternerContext) -> collections::BTreeSet[String] {
    let mut out: collections::BTreeSet[String] = collections::BTreeSet()
    for item in program.items {
        match item.node {
            Item::Impl { target, methods, .. } => {
                if words.resolve(target.name) != owner {
                    continue
                }
                for method in methods {
                    match method.node {
                        Item::Fn { name, .. } => {
                            let written = name ?? continue
                            out.insert(words.resolve(written).clone())
                        },
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    return out
}

/// Whether `block` uses `name` otherwise than a builder may
/// (`rules_builder`); `top` for the function's own body, whose tail may
/// hand it back.
fn rules_escapes(block: ref Block, name: ref String, methods: ref collections::BTreeSet[String], top: bool, words: ref winnow_grammar::InternerContext) -> bool {
    for (at, stmt) in block.stmts.iter().enumerate() {
        let mut allowed = 0
        match stmt.node {
            Stmt::Return(value) => {
                allowed += rules_handed_back(value, name, words)
            },
            Stmt::Expr(value) => {
                if top && at + 1 == block.stmts.len() {
                    allowed += rules_handed_back(value, name, words)
                }
            },
            else => {},
        }
        let mut bare = 0
        for e in check_visit_stmt(stmt.node) {
            match e {
                Expr::Variable(n, _) => {
                    if words.resolve(n) == name {
                        bare += 1
                    }
                },
                Expr::Field { base, .. } => {
                    if rules_is_name(base, name, words) {
                        allowed += 1
                    }
                },
                Expr::MethodCall { receiver, method, .. } => {
                    if rules_is_name(receiver, name, words) && methods.contains(words.resolve(method)) {
                        allowed += 1
                    }
                },
                Expr::Return(value, _) => {
                    allowed += rules_handed_back(value, name, words)
                },
                // A field written by its name alone uses the value as a
                // whole, though no `Variable` stands for it.
                Expr::StructLit { fields, .. } => {
                    for field in fields {
                        if field.value == null && words.resolve(field.name) == name {
                            bare += 1
                        }
                    }
                },
                Expr::Closure { .. } => return true,
                Expr::Spawn { .. } => return true,
                else => {},
            }
        }
        if bare > allowed {
            return true
        }
        for inner in check_visit_stmt_blocks(stmt.node) {
            if rules_escapes(inner, name, methods, false, words) {
                return true
            }
        }
    }
    return false
}

/// **How often `expr` hands back `name` as a whole**: once where it is the
/// name alone; of a struct literal, each field that is the name (by its
/// name alone too) or a literal that hands it back (#1653).
fn rules_handed_back(expr: ref Expr?, name: ref String, words: ref winnow_grammar::InternerContext) -> i64 {
    let e = expr ?? return 0
    return match e {
        Expr::Variable(n, _) => if words.resolve(n) == name { 1 } else { 0 },
        Expr::StructLit { fields, .. } => {
            let mut count = 0
            for field in fields {
                if field.value == null {
                    if words.resolve(field.name) == name {
                        count += 1
                    }
                } else {
                    count += rules_handed_back(field.value, name, words)
                }
            }
            count
        },
        else => 0,
    }
}

/// Whether `expr` is the name `name` alone.
fn rules_is_name(expr: ref Expr?, name: ref String, words: ref winnow_grammar::InternerContext) -> bool {
    let e = expr ?? return false
    return match e {
        Expr::Variable(n, _) => words.resolve(n) == name,
        else => false,
    }
}

fn rules_typed(args: ref Vec[FnArg], body: ref Block, owner: ref String, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) -> collections::BTreeMap[String, String] {
    let shape = shape_of(args, body, pinned_in(body, words), context.around, words)
    let mut out: collections::BTreeMap[String, String] = collections::BTreeMap()
    if !owner.is_empty() {
        out.insert("self", owner.clone())
    }
    for arg in args {
        let name = words.resolve(arg.name)
        if arg.ty.generics.is_empty() && !shape.twice.contains(name) {
            out.insert(name.clone(), words.resolve(arg.ty.name).clone())
        }
    }
    rules_typed_lets(body, shape.twice, out, words)
    // `Self` within an `impl` is its type.
    if !owner.is_empty() {
        let mut named: Vec[String] = []
        for (name, of) in out {
            if of == "Self" {
                named.push(name.clone())
            }
        }
        for name in named {
            out.insert(name.clone(), owner.clone())
        }
    }
    return out
}

fn rules_typed_lets(block: ref Block, twice: ref collections::BTreeSet[String], mut out: collections::BTreeMap[String, String], words: ref winnow_grammar::InternerContext) {
    for stmt in block.stmts {
        match stmt.node {
            Stmt::Let { names, ty, value, .. } => {
                if names.len() != 1 || twice.contains(words.resolve(names[0])) {
                    continue
                }
                let name = words.resolve(names[0]).clone()
                if ty != null {
                    let written = ty ?? continue
                    if written.generics.is_empty() {
                        out.insert(name, words.resolve(written.name).clone())
                    }
                    continue
                }
                match value {
                    Expr::StructLit { name: of, .. } => {
                        out.insert(name, words.resolve(of).clone())
                    },
                    else => {},
                }
            },
            Stmt::For { body, .. } => rules_typed_lets(body, twice, out, words),
            Stmt::While { body, .. } => rules_typed_lets(body, twice, out, words),
            else => {},
        }
    }
}

fn rules_inside(owner: ref String, changed: ref BoundsChanged, types: ref collections::BTreeMap[String, String], lists: ref collections::BTreeMap[String, Vec[String]], every_field: ref collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String]) -> collections::BTreeSet[String] {
    let mut lengths: collections::BTreeSet[String] = collections::BTreeSet()
    let mut away = nothing_changed()
    for path in changed.values {
        if !rules_from_self(owner, path, 0, lists, dropped, lengths) {
            away.values.insert(path.clone())
        }
    }
    for path in changed.lengths {
        if !rules_from_self(owner, path, 1, lists, dropped, lengths) {
            away.lengths.insert(path.clone())
        }
    }
    for path in changed.parts {
        if !rules_from_self(owner, path, 2, lists, dropped, lengths) {
            away.parts.insert(path.clone())
        }
    }
    for place in changed.elements {
        let list = frame_list(place)
        if path_root(list) != "self" {
            away.elements.insert(place.clone())
        } else if list == "self" {
            dropped.insert(f"{owner}.")
        } else {
            let fields = rules_fields_of(list)
            if fields.len() == 1 {
                // A write of one element is checked where it stands
                // (`rules_element_write`, ADR-306 D22): a direct `=` keeps
                // a list of positions where its value is one; anything
                // else drops it there.
            } else {
                rules_from_self(owner, list, 0, lists, dropped, lengths)
            }
        }
    }
    rules_outside(away, types, every_field, dropped)
    return lengths
}

/// A path from `self` that a method changes as `kind` says (0 its value, 1
/// its length, 2 its parts); `false` for a path from elsewhere.
fn rules_from_self(owner: ref String, path: ref String, kind: i64, lists: ref collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String], mut lengths: collections::BTreeSet[String]) -> bool {
    if path_root(path) != "self" {
        return false
    }
    let fields = rules_fields_of(path)
    if fields.is_empty() {
        if kind != 1 {
            dropped.insert(f"{owner}.")
        }
        return true
    }
    let own = lists.get(owner)?.contains(fields[0]) ?? false
    if !own {
        // Another field of `self`: a list of the same name in another type
        // is written through it only below it.
        if fields.len() > 1 {
            let mut away = nothing_changed()
            away.values.insert(path.clone())
            rules_outside(away, collections::BTreeMap(), lists, dropped)
        }
        return true
    }
    if fields.len() == 1 && kind == 1 {
        lengths.insert(fields[0].clone())
    } else if fields.len() == 1 && kind == 2 {
        // The parts of a list are its elements: a write of one is in
        // `elements`, and a method that writes them all is `rules_fills`'.
    } else {
        dropped.insert(f"{owner}.{fields[0]}")
    }
    return true
}

// --- What every literal builds ------------------------------------------------

/// **A method that writes every element of a list and keeps its length**
/// (`fill`): no frame names it, so a list field of that name anywhere is
/// no longer a list of positions.
fn rules_fills(receiver: ref Expr, method: ref String, lists: ref collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    if method != "fill" {
        return
    }
    match receiver {
        Expr::Field { name, .. } => {
            let field = words.resolve(name)
            for (owner, fields) in lists {
                if fields.contains(field) {
                    dropped.insert(f"{owner}.{field}[]")
                }
            }
        },
        else => {},
    }
}

fn rules_built_block(block: ref Block, owner: ref String, lists: ref collections::BTreeMap[String, Vec[String]], defaults: ref collections::BTreeMap[String, String], mut built: collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    for stmt in block.stmts {
        rules_built_stmt(stmt, owner, lists, defaults, built, dropped, words)
    }
}

fn rules_built_stmt(stmt: ref Spanned[Stmt], owner: ref String, lists: ref collections::BTreeMap[String, Vec[String]], defaults: ref collections::BTreeMap[String, String], mut built: collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    match stmt.node {
        Stmt::Let { value, .. } => rules_built(value, owner, lists, defaults, built, dropped, words),
        Stmt::Comptime { value, .. } => rules_built(value, owner, lists, defaults, built, dropped, words),
        Stmt::Assign { target, value, .. } => {
            rules_built(target, owner, lists, defaults, built, dropped, words)
            rules_built(value, owner, lists, defaults, built, dropped, words)
        },
        Stmt::For { iter, body, .. } => {
            rules_built(iter, owner, lists, defaults, built, dropped, words)
            rules_built_block(body, owner, lists, defaults, built, dropped, words)
        },
        Stmt::While { cond, body } => {
            rules_built(cond, owner, lists, defaults, built, dropped, words)
            rules_built_block(body, owner, lists, defaults, built, dropped, words)
        },
        Stmt::Return(value) => rules_built_maybe(value, owner, lists, defaults, built, dropped, words),
        Stmt::Expr(value) => rules_built(value, owner, lists, defaults, built, dropped, words),
        else => {},
    }
}

fn rules_built_maybe(expr: ref Expr?, owner: ref String, lists: ref collections::BTreeMap[String, Vec[String]], defaults: ref collections::BTreeMap[String, String], mut built: collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    let e = expr ?? return
    rules_built(e, owner, lists, defaults, built, dropped, words)
}

fn rules_built_all(exprs: ref Vec[Expr], owner: ref String, lists: ref collections::BTreeMap[String, Vec[String]], defaults: ref collections::BTreeMap[String, String], mut built: collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    for e in exprs {
        rules_built(e, owner, lists, defaults, built, dropped, words)
    }
}

fn rules_built_fields(fields: ref Vec[FieldInit], owner: ref String, lists: ref collections::BTreeMap[String, Vec[String]], defaults: ref collections::BTreeMap[String, String], mut built: collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    for field in fields {
        rules_built_maybe(field.value, owner, lists, defaults, built, dropped, words)
    }
}

/// **A literal of a candidate type** (`Self` within its own `impl`): what
/// it builds each list field as, a field it leaves out as its default.
///
/// A list field given by a name (`Row { cols: cols }`, `Row { cols }`) is
/// `any` to the `length` rules too, where `named`: the walk asks them of
/// the names where the literal stands (`rules_literal_holds`, #1652). Not
/// of `Self`, which the walk does not resolve.
fn rules_literal(name: ref String, fields: ref Vec[FieldInit], lists: ref collections::BTreeMap[String, Vec[String]], defaults: ref collections::BTreeMap[String, String], mut built: collections::BTreeMap[String, Vec[String]], loose: bool, named: bool, words: ref winnow_grammar::InternerContext) {
    let own = lists.get(name) ?? return
    // What it gives each field it names, for `floor` and `cap` (#1642):
    // `f=shape;` each, `any` for the literal of a builder, whose rules are
    // asked where it is handed back.
    let mut given = ""
    if loose {
        given = "any"
    } else {
        for field in fields {
            // A value other than a number is asked where a literal the
            // walk resolves stands (`ask`, #1681): not of `Self`.
            let mut shape = rules_scalar_shape(field.value)
            if shape == "other" && named {
                shape = "ask"
            }
            given = f"{given}{words.resolve(field.name)}={shape};"
        }
    }
    let lit_key = f"{name}#lit"
    let mut known_given = built.get(lit_key)?.clone() ?? []
    known_given.push(given)
    built.insert(lit_key, known_given)
    for f in own {
        let key = f"{name}.{f}"
        let inner_key = f"{key}[]"
        let mut shape = defaults.get(key)?.clone() ?? "other"
        let mut inside = defaults.get(inner_key)?.clone() ?? "other"
        let mut by_name = false
        for field in fields {
            if words.resolve(field.name) == f {
                shape = rules_shape(field.value)
                inside = rules_inner_shape(field.value)
                by_name = named && rules_named_list(field.value, f, words) != null
            }
        }
        // The shape the `length` rules compare (`#len`): any for the
        // literal of a builder (`rules_builder`) and for a list given by a
        // name.
        let length_key = f"{key}#len"
        let mut known_length = built.get(length_key)?.clone() ?? []
        known_length.push(if loose || by_name { "any" } else { shape.clone() })
        built.insert(length_key, known_length)
        let mut known = built.get(key)?.clone() ?? []
        known.push(shape)
        built.insert(key, known)
        let mut known_inside = built.get(inner_key)?.clone() ?? []
        known_inside.push(inside)
        built.insert(inner_key, known_inside)
    }
}

/// **The name a literal gives a list field by** (#1652): the local or
/// parameter of `Row { cols: cols }` and of `Row { cols }`, the field path
/// of `Row { cols: r.cols }`, each also through a `.clone()`, which keeps
/// its length (`Row { cols: r.cols.clone() }`, #1888); null for any other
/// value, a path from `self` too.
fn rules_named_list(value: ref Expr?, field: ref String, words: ref winnow_grammar::InternerContext) -> String? {
    let given = value ?? return field.clone()
    return rules_list_path(given, words)
}

/// The written path of a local, a parameter or a field of one, seen
/// through `.clone()`; null for any other value and for `self`.
fn rules_list_path(given: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    match given {
        Expr::Variable(name, _) => {
            let written = words.resolve(name)
            if written != "self" {
                return written.clone()
            }
        },
        Expr::Field { base, .. } => {
            if rules_list_path(base, words) != null {
                return written_expression(words, given)
            }
        },
        Expr::MethodCall { receiver, method, args, .. } => {
            if words.resolve(method) == "clone" && args.is_empty() {
                return rules_list_path(receiver, words)
            }
        },
        else => {},
    }
    return null
}

/// **Whether `body` holds a literal of `owner` that gives one of the lists
/// of a `length` rule by a name** (`rules_literal`): its walk asks the rule
/// there (`rules_literal_holds`).
fn rules_names_lists(body: ref Block, owner: ref String, of_impl: ref String, held: ref Vec[BoundsRule], words: ref winnow_grammar::InternerContext) -> bool {
    let mut fields: Vec[String] = []
    let mut asked: Vec[String] = []
    for rule in held {
        if rule.kind == "length" && rule.owner == owner {
            fields.push(rule.a.clone())
            fields.push(rule.b.clone())
        }
        if rule.kind == "atmost" && rule.owner == owner {
            asked.push(f"{rule.a}=ask")
            asked.push(f"{rule.b}=ask")
        }
    }
    if fields.is_empty() && asked.is_empty() {
        return false
    }
    let mut lists: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    lists.insert(owner.clone(), fields.clone())
    let mut built: collections::BTreeMap[String, Vec[String]] = collections::BTreeMap()
    let mut dropped: collections::BTreeSet[String] = collections::BTreeSet()
    rules_built_block(body, of_impl, lists, collections::BTreeMap(), built, dropped, words)
    // A literal that gives a field of an `atmost` rule by a name or an
    // expression (#1681).
    for given in built.get(f"{owner}#lit")?.clone() ?? [] {
        for part in given.split(";") {
            if asked.iter().any(fn(x) { x == part }) {
                return true
            }
        }
    }
    for f in fields {
        let shapes = built.get(f"{owner}.{f}#len")?.clone() ?? []
        if shapes.contains("any") {
            return true
        }
    }
    return false
}

/// **A literal that gives a list of a `length` rule by a name** (#1652):
/// `Row { cols: cols, ks: ks }` builds its lists as long as the names are
/// where it stands, so each `length` rule of its type is asked of them
/// there (`rules_literal` counts the literal as `any`). The other list
/// given by a list literal is its count; given otherwise, or left out, the
/// rule fails. Not of a builder's own literal, whose rules are asked where
/// it is handed back (`rule_built_literal`).
fn rules_literal_holds(mut walk: BoundsWalk, name: ref String, fields: ref Vec[FieldInit], facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if !walk.checking || name == "Self" {
        return
    }
    for (at, rule) in walk.rules.clone().iter().enumerate() {
        if rule.kind == "atmost" && rule.owner == name && !walk.rule_failed.contains(at) {
            // `a <= b` of what the literal gives the two fields (#1681).
            let a = rules_literal_value(walk, fields, rule.a, facts, context, program, words)
            let b = rules_literal_value(walk, fields, rule.b, facts, context, program, words)
            if a == null || b == null {
                walk.rule_failed.insert(at)
                continue
            }
            let goal = walk.arena.le(a ?? continue, b ?? continue)
            let proved = bounding_proves(walk, facts, goal, ask)
            bounding_traced(walk, facts, goal, proved)
            if !proved {
                walk.rule_failed.insert(at)
            }
            continue
        }
        if rule.kind != "length" || rule.owner != name || walk.rule_failed.contains(at) {
            continue
        }
        let (named_a, a) = rules_literal_side(walk, fields, rule.a, words)
        let (named_b, b) = rules_literal_side(walk, fields, rule.b, words)
        if !named_a && !named_b {
            continue
        }
        if a < 0 || b < 0 {
            walk.rule_failed.insert(at)
            continue
        }
        let multiple = rules_times(walk, rule.times, b)
        let goal = walk.arena.equal(a, multiple)
        let proved = bounding_proves(walk, facts, goal, ask)
        bounding_traced(walk, facts, goal, proved)
        if !proved {
            walk.rule_failed.insert(at)
        }
    }
}

/// **What a literal gives the whole-number field `f`, as a term** (#1681):
/// its value where that is linear, the name of a shorthand field; null
/// where it is neither or the literal leaves the field out (its default is
/// a number `rules_built_at_most` compared already, and asks nothing).
fn rules_literal_value(mut walk: BoundsWalk, fields: ref Vec[FieldInit], f: ref String, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) -> i64? {
    for field in fields {
        if words.resolve(field.name) != f {
            continue
        }
        if field.value == null && facts.ints.contains(f) {
            return walk.arena.var(f)
        }
        let given = field.value ?? return null
        return bounding_lin(walk, given, facts, context, program, words)
    }
    return null
}

/// The length a literal gives the list field `f`, as a term, and whether
/// by a name: the name's length, or a list literal's count; -1 for any
/// other value and for a field left out.
fn rules_literal_side(mut walk: BoundsWalk, fields: ref Vec[FieldInit], f: ref String, words: ref winnow_grammar::InternerContext) -> (bool, i64) {
    for field in fields {
        if words.resolve(field.name) != f {
            continue
        }
        let named = rules_named_list(field.value, f, words)
        if named != null {
            return (true, walk.arena.var(length_of(named ?? "")))
        }
        let given = field.value ?? return (false, -1)
        return match given {
            Expr::ListLit { items, .. } => (false, walk.arena.int(items.len() as i64)),
            else => (false, -1),
        }
    }
    return (false, -1)
}

fn rules_built(expr: ref Expr, owner: ref String, lists: ref collections::BTreeMap[String, Vec[String]], defaults: ref collections::BTreeMap[String, String], mut built: collections::BTreeMap[String, Vec[String]], mut dropped: collections::BTreeSet[String], words: ref winnow_grammar::InternerContext) {
    match expr {
        Expr::StructLit { name, fields, .. } => {
            let mut written = words.resolve(name).clone()
            if written == "Self" {
                written = owner.clone()
            }
            rules_literal(written, fields, lists, defaults, built, false, words.resolve(name) != "Self", words)
            rules_built_fields(fields, owner, lists, defaults, built, dropped, words)
        },
        Expr::With { base, fields, .. } => {
            for field in fields {
                let set = words.resolve(field.name)
                for (of, own) in lists {
                    if own.contains(set) {
                        dropped.insert(f"{of}.{set}")
                    }
                }
            }
            rules_built(base, owner, lists, defaults, built, dropped, words)
            rules_built_fields(fields, owner, lists, defaults, built, dropped, words)
        },
        Expr::Match { value, arms, .. } => {
            rules_built(value, owner, lists, defaults, built, dropped, words)
            for arm in arms {
                rules_built_maybe(arm.guard, owner, lists, defaults, built, dropped, words)
                rules_built(arm.body, owner, lists, defaults, built, dropped, words)
            }
        },
        Expr::Range { start, end, .. } => {
            rules_built(start, owner, lists, defaults, built, dropped, words)
            rules_built(end, owner, lists, defaults, built, dropped, words)
        },
        Expr::Tuple(items, _) => rules_built_all(items, owner, lists, defaults, built, dropped, words),
        Expr::ListRepeat { value, count, .. } => {
            rules_built(value, owner, lists, defaults, built, dropped, words)
            rules_built(count, owner, lists, defaults, built, dropped, words)
        },
        Expr::ListLit { items, .. } => rules_built_all(items, owner, lists, defaults, built, dropped, words),
        Expr::LitInterpolated { parts, .. } => {
            for part in parts {
                match part {
                    FPart::Hole { expr, .. } => rules_built(expr, owner, lists, defaults, built, dropped, words),
                    else => {},
                }
            }
        },
        Expr::If { cond, then_branch, else_branch, .. } => {
            rules_built(cond, owner, lists, defaults, built, dropped, words)
            rules_built_block(then_branch, owner, lists, defaults, built, dropped, words)
            let otherwise = else_branch ?? return
            rules_built_block(otherwise, owner, lists, defaults, built, dropped, words)
        },
        Expr::Call { func, args, config, .. } => {
            rules_built(func, owner, lists, defaults, built, dropped, words)
            rules_built_all(args, owner, lists, defaults, built, dropped, words)
            for c in config {
                rules_built(c.value, owner, lists, defaults, built, dropped, words)
            }
        },
        Expr::MethodCall { receiver, method, args, config, .. } => {
            rules_fills(receiver, words.resolve(method), lists, dropped, words)
            rules_built(receiver, owner, lists, defaults, built, dropped, words)
            rules_built_all(args, owner, lists, defaults, built, dropped, words)
            for c in config {
                rules_built(c.value, owner, lists, defaults, built, dropped, words)
            }
        },
        Expr::SafeMethod { receiver, args, config, .. } => {
            rules_built(receiver, owner, lists, defaults, built, dropped, words)
            rules_built_all(args, owner, lists, defaults, built, dropped, words)
            for c in config {
                rules_built(c.value, owner, lists, defaults, built, dropped, words)
            }
        },
        Expr::Spawn { body, .. } => rules_built(body, owner, lists, defaults, built, dropped, words),
        Expr::Field { base, .. } => rules_built(base, owner, lists, defaults, built, dropped, words),
        Expr::SafeField { base, .. } => rules_built(base, owner, lists, defaults, built, dropped, words),
        Expr::Unary { expr: inner, .. } => rules_built(inner, owner, lists, defaults, built, dropped, words),
        Expr::Try(inner, _) => rules_built(inner, owner, lists, defaults, built, dropped, words),
        Expr::Async(inner, _, _, _) => rules_built(inner, owner, lists, defaults, built, dropped, words),
        Expr::Throw(inner, _) => rules_built(inner, owner, lists, defaults, built, dropped, words),
        Expr::Cast { expr: inner, .. } => rules_built(inner, owner, lists, defaults, built, dropped, words),
        Expr::TryCatch { expr: inner, handler, .. } => {
            rules_built(inner, owner, lists, defaults, built, dropped, words)
            rules_built_block(handler, owner, lists, defaults, built, dropped, words)
        },
        Expr::Binary { lhs, rhs, .. } => {
            rules_built(lhs, owner, lists, defaults, built, dropped, words)
            rules_built(rhs, owner, lists, defaults, built, dropped, words)
        },
        Expr::Return(value, _) => rules_built_maybe(value, owner, lists, defaults, built, dropped, words),
        Expr::Index { base, index, .. } => {
            rules_built(base, owner, lists, defaults, built, dropped, words)
            rules_built(index, owner, lists, defaults, built, dropped, words)
        },
        Expr::Coalesce { value, fallback, .. } => {
            rules_built(value, owner, lists, defaults, built, dropped, words)
            rules_built(fallback, owner, lists, defaults, built, dropped, words)
        },
        Expr::Select(arms, _) => {
            for arm in arms {
                rules_built(arm.value, owner, lists, defaults, built, dropped, words)
                rules_built_block(arm.body, owner, lists, defaults, built, dropped, words)
            }
        },
        Expr::Block(b, _) => rules_built_block(b, owner, lists, defaults, built, dropped, words),
        Expr::AsyncGroup(b, _, _, _, _) => rules_built_block(b, owner, lists, defaults, built, dropped, words),
        Expr::Overlap(b, _) => rules_built_block(b, owner, lists, defaults, built, dropped, words),
        Expr::Unsafe(b, _) => rules_built_block(b, owner, lists, defaults, built, dropped, words),
        Expr::Closure { body, .. } => rules_built_block(body, owner, lists, defaults, built, dropped, words),
        else => {},
    }
}

// --- The check -----------------------------------------------------------------

/// **The rules the walk of one body uses** (ADR-369 D4): where the body is
/// a method of a type with candidates, or takes a value of one, those of
/// the type's candidates that every method writing its fields keeps, each
/// at the start of the body for `self` and for each such parameter.
///
/// What it finds itself, not given in `context.around.held`, it hands back,
/// for the bodies after it (#1581).
fn rules_settle(mut walk: BoundsWalk, args: ref Vec[FnArg], body: ref Block, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> collections::BTreeMap[String, Vec[BoundsRule]] {
    let mut found: collections::BTreeMap[String, Vec[BoundsRule]] = collections::BTreeMap()
    if context.around.rules.is_empty() {
        return found
    }
    let owner = rules_owner_of(program, body, words)
    let roots = rules_roots(owner, args, walk.shape, context.around.rules, words)
    if roots.is_empty() {
        return found
    }
    let mut owners: collections::BTreeSet[String] = collections::BTreeSet()
    for (_, of) in roots {
        owners.insert(of.clone())
    }
    let mut held: Vec[BoundsRule] = []
    for of in owners {
        let given = context.around.held.get(of)
        if given != null {
            held.extend(given?.clone() ?? [])
            continue
        }
        let holding = rules_holding(of, context, program, words, ask)
        found.insert(of.clone(), holding.clone())
        held.extend(holding)
    }
    walk.rules = held
    walk.rule_roots = roots
    return found
}

/// The type whose method `body` is, where it takes `self`; empty for any
/// other body.
fn rules_owner_of(program: ref Program, body: ref Block, words: ref winnow_grammar::InternerContext) -> String {
    let first = body.stmts.first() ?? return ""
    for item in program.items {
        match item.node {
            Item::Impl { target, methods, .. } => {
                for method in methods {
                    match method.node {
                        Item::Fn { receiver, body: own, .. } => {
                            let start = own.stmts.first() ?? continue
                            if start.span.start == first.span.start && start.span.end == first.span.end && receiver != null {
                                return words.resolve(target.name).clone()
                            }
                        },
                        else => {},
                    }
                }
            },
            else => {},
        }
    }
    return ""
}

/// **The values a body holds whose type has candidates**, each with its
/// type: `self` of a method of one, and each parameter of one the body
/// never binds again (a parameter is bound once, by the call).
fn rules_roots(owner: ref String, args: ref Vec[FnArg], shape: ref BodyShape, rules: ref Vec[BoundsRule], words: ref winnow_grammar::InternerContext) -> collections::BTreeMap[String, String] {
    let mut roots: collections::BTreeMap[String, String] = collections::BTreeMap()
    let mut owners: collections::BTreeSet[String] = collections::BTreeSet()
    for rule in rules {
        owners.insert(rule.owner.clone())
    }
    if owners.contains(owner) && !shape.bound.contains("self") {
        roots.insert("self", owner.clone())
    }
    for arg in args {
        let name = words.resolve(arg.name)
        let ty = words.resolve(arg.ty.name)
        if arg.ty.generics.is_empty() && owners.contains(ty) && !shape.twice.contains(name) {
            roots.insert(name.clone(), ty.clone())
        }
    }
    return roots
}

/// **The candidates of `owner` that hold**: each method that writes its
/// fields through `mut self`, and each method a `result` candidate names,
/// is walked with every candidate left given at its start; a candidate one
/// of them does not keep is dropped, and the rest are checked again.
fn rules_holding(owner: ref String, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> Vec[BoundsRule] {
    let mut held: Vec[BoundsRule] = []
    for rule in context.around.rules {
        if rule.owner == owner {
            held.push(rule.clone())
        }
    }
    let mut round = 0
    while !held.is_empty() && round < rules_rounds() {
        let mut failed: collections::BTreeSet[i64] = collections::BTreeSet()
        for item in program.items {
            match item.node {
                // **A body outside the type's methods that holds a value of
                // it by a name whose type it knows**: each write it makes is
                // checked where it stands (ADR-306 D22, D28).
                Item::Fn { args, body, .. } => {
                    let locals = rules_locals(owner, args, body, "", context, words)
                    if !locals.is_empty() || rules_names_lists(body, owner, "", held, words) {
                        let mut owners: collections::BTreeSet[String] = collections::BTreeSet()
                        owners.insert(owner.clone())
                        let made = rules_builder(body, owners, program, words)
                        rules_check(held, owner, "", made.0, args, body, locals, context, program, words, ask, failed)
                    }
                },
                Item::Impl { target, methods, .. } => {
                    let impl_of = words.resolve(target.name)
                    let own = impl_of == owner
                    for method in methods {
                        match method.node {
                            Item::Fn { name, receiver, args, body, .. } => {
                                let written = name ?? continue
                                let m = words.resolve(written)
                                let changing = receiver?.is_mut ?? false
                                if own && receiver != null && (changing || rules_has_result(held, m)) {
                                    let locals = rules_locals(owner, args, body, impl_of, context, words)
                                    rules_check(held, owner, m, "", args, body, locals, context, program, words, ask, failed)
                                    continue
                                }
                                let locals = rules_locals(owner, args, body, impl_of, context, words)
                                if !locals.is_empty() || rules_names_lists(body, owner, impl_of, held, words) {
                                    rules_check(held, owner, "", "", args, body, locals, context, program, words, ask, failed)
                                }
                            },
                            else => {},
                        }
                    }
                },
                else => {},
            }
        }
        if failed.is_empty() {
            return held
        }
        let mut kept: Vec[BoundsRule] = []
        for (at, rule) in held.iter().enumerate() {
            if !failed.contains(at) {
                kept.push(rule.clone())
            }
        }
        held = kept
        round += 1
    }
    if round >= rules_rounds() {
        return []
    }
    return held
}

/// **The values of `owner` a body names by one name of known type**, `self`
/// aside: its parameters and the names it binds once to a literal of the
/// type or with the type written (`rules_typed`).
fn rules_locals(owner: ref String, args: ref Vec[FnArg], body: ref Block, self_of: ref String, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) -> collections::BTreeMap[String, String] {
    let mut out: collections::BTreeMap[String, String] = collections::BTreeMap()
    for (name, of) in rules_typed(args, body, self_of, context, words) {
        if of == owner && name != "self" {
            out.insert(name.clone(), of.clone())
        }
    }
    return out
}

fn rules_has_result(rules: ref Vec[BoundsRule], method: ref String) -> bool {
    for rule in rules {
        if rule.kind == "result" && rule.a == method {
            return true
        }
    }
    return false
}

/// **One method walked to check `held`**: the indexes of those it does not
/// keep go into `failed`.
fn rules_check(held: ref Vec[BoundsRule], owner: ref String, method: ref String, built: ref String, args: ref Vec[FnArg], body: ref Block, locals: ref collections::BTreeMap[String, String], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync, mut failed: collections::BTreeSet[i64]) {
    let mut walk = bounding_new(args, body, collections::BTreeSet(), context, program, words)
    let self_owner = if method.is_empty() { "" } else { owner }
    walk.rule_roots = rules_roots(self_owner, args, walk.shape, held, words)
    for (name, of) in locals {
        walk.rule_roots.insert(name.clone(), of.clone())
    }
    walk.rules = held.clone()
    walk.checking = true
    if !built.is_empty() {
        walk.rule_built.insert(built.clone())
        walk.rule_built_literal = rules_built_literal(body, built, owner, words)
    }
    for (at, rule) in held.iter().enumerate() {
        if rule.kind == "result" && rule.a == method {
            walk.checked_results.insert(at)
        }
    }
    bounding_pass(walk, args, body, context, program, words, ask)
    for at in walk.rule_failed {
        failed.insert(at)
    }
}

/// The `node_key` of the literal a builder binds `built` to (`rules_builder`:
/// a statement of its body, of the type `owner`); -1 where none.
fn rules_built_literal(body: ref Block, built: ref String, owner: ref String, words: ref winnow_grammar::InternerContext) -> i64 {
    for stmt in body.stmts {
        match stmt.node {
            Stmt::Let { names, value, .. } => match value {
                Expr::StructLit { name, .. } => {
                    if names.len() == 1 && words.resolve(names[0]) == built && words.resolve(name) == owner {
                        return node_key(value)
                    }
                },
                else => {},
            },
            else => {},
        }
    }
    return -1
}

// --- The rules in the walk -----------------------------------------------------

/// **What the rules give at the start of a body**: of each value it holds of
/// a type with rules, `len(a) == len(b)` and every element of a list of
/// positions inside the other list. A body checked with a lambda or a task
/// that changes `self` keeps none.
fn rules_given(mut walk: BoundsWalk, mut facts: BoundsFacts, args: ref Vec[FnArg], words: ref winnow_grammar::InternerContext) {
    if walk.checking && walk.pinned.contains("self") {
        for at in 0..<walk.rules.len() {
            walk.rule_failed.insert(at)
        }
        return
    }
    for (root, owner) in walk.rule_roots.clone() {
        // A value the body binds itself has no lengths before it is built;
        // what holds of its elements holds from its literal on, each write
        // checked where it stands (ADR-306 D22).
        if walk.shape.bound.contains(root) && !args.iter().any(fn(arg) { words.resolve(arg.name) == root }) {
            rules_give(walk, BoundsFacts { ints: collections::BTreeSet(), facts: [], evicted: 0 }, root, owner, true, true, nothing_changed(), [])
            continue
        }
        rules_give(walk, facts, root, owner, true, true, nothing_changed(), [])
    }
}

/// The rules of `owner`, given of the value `root`.
///
/// Where `every` is false, only the rules of a field `written` names: what
/// the walk knew of the others still holds, and the cap of facts keeps it.
/// Where `only` is not empty, only the rules at those indexes.
fn rules_give(mut walk: BoundsWalk, mut facts: BoundsFacts, root: ref String, owner: ref String, elements: bool, every: bool, written: ref BoundsChanged, only: ref Vec[i64]) {
    // Each length's floor once.
    let mut floored: collections::BTreeSet[String] = collections::BTreeSet()
    for (at, rule) in walk.rules.clone().iter().enumerate() {
        if rule.owner != owner {
            continue
        }
        if !only.is_empty() && !only.iter().any(fn(k) { k == at }) {
            continue
        }
        if !every && !rules_writes(written, f"{root}.{rule.a}") && (rule.b.is_empty() || !rules_writes(written, f"{root}.{rule.b}")) {
            continue
        }
        // An order gives nothing at the start: it is read where an element
        // is (`rules_ascending_facts`, #1688).
        if rule.kind == "ascending" {
            continue
        }
        let zero = walk.arena.int(0)
        // `0 <= a` of a whole-number field (#1642).
        if rule.kind == "floor" {
            let a = walk.arena.var(f"{root}.{rule.a}")
            let low = walk.arena.ge(a, zero)
            bounding_push(walk, facts, low)
            continue
        }
        // `a <= b` of two whole-number fields (#1681).
        if rule.kind == "atmost" {
            let a = walk.arena.var(f"{root}.{rule.a}")
            let b = walk.arena.var(f"{root}.{rule.b}")
            let capped = walk.arena.le(a, b)
            bounding_push(walk, facts, capped)
            continue
        }
        let b = walk.arena.var(length_of(f"{root}.{rule.b}"))
        let b_floor = walk.arena.ge(b, zero)
        if rule.kind == "length" {
            let a = walk.arena.var(length_of(f"{root}.{rule.a}"))
            let multiple = rules_times(walk, rule.times, b)
            let same = walk.arena.equal(a, multiple)
            let a_floor = walk.arena.ge(a, zero)
            bounding_push(walk, facts, same)
            if floored.insert(rule.a.clone()) {
                bounding_push(walk, facts, a_floor)
            }
            if floored.insert(rule.b.clone()) {
                bounding_push(walk, facts, b_floor)
            }
        } else if rule.kind == "index" || rule.kind == "inner" {
            // Of every value of `a`, or of every inner list of it (`a[]`,
            // ADR-306 D28): nothing where it is empty (#1483). They stand
            // beside the facts (`rule_facts`), made once.
            let name = bounding_element_of(rules_values_of(f"{root}.{rule.a}", rule.kind))
            if elements && !walk.pinned.contains(root) {
                let each = walk.arena.var(name)
                let low_each = walk.arena.ge(each, zero)
                let high_each = walk.arena.lt(each, b)
                let low = bounding_each_guarded(walk, low_each)
                let high = bounding_each_guarded(walk, high_each)
                walk.rule_facts.push((name.clone(), low))
                walk.rule_facts.push((name, high))
            }
            if floored.insert(rule.b.clone()) {
                bounding_push(walk, facts, b_floor)
            }
        } else if rule.kind == "capped" {
            // Of every value of `a`: `0 <=` it beside the facts, made once,
            // and `<= len(b)` standing while `b`'s length does
            // (`rules_capped_stand`, ADR-306 D21, #1785).
            if !walk.pinned.contains(root) {
                let name = bounding_element_of(f"{root}.{rule.a}")
                let each = walk.arena.var(name)
                if elements {
                    let low_each = walk.arena.ge(each, zero)
                    let low = bounding_each_guarded(walk, low_each)
                    walk.rule_facts.push((name.clone(), low))
                }
                rules_capped_stand(walk, facts, name, each, b, length_of(f"{root}.{rule.b}"))
            }
            if floored.insert(rule.b.clone()) {
                bounding_push(walk, facts, b_floor)
            }
        } else if rule.kind == "cap" {
            // `a <= len(b)` of a whole-number field `a` (#1642).
            let a = walk.arena.var(f"{root}.{rule.a}")
            let capped = walk.arena.le(a, b)
            bounding_push(walk, facts, capped)
            if floored.insert(rule.b.clone()) {
                bounding_push(walk, facts, b_floor)
            }
        } else if floored.insert(rule.b.clone()) {
            bounding_push(walk, facts, b_floor)
        }
    }
}

/// **`each(a) <= len(b)` of a `capped` rule stands while `b`'s length
/// does** (ADR-306 D21, #1785): beside the facts, as an `index` rule's
/// bound, with a fresh name `cap#k` at most the length among the facts.
/// A change of the length forgets that fact, a growth carries it
/// (`bounding_shift`, and a loop that only grows the list keeps it as
/// its invariant), and `rules_standing` asks for it at each use; a
/// shrink by one position takes it away (`rules_capped_call`). A marker
/// given before stays known beside it: the walk state is one for every
/// branch, and a branch that gives the rule again (after a call on
/// `self`) must not take the bound from the facts of one that did not.
fn rules_capped_stand(mut walk: BoundsWalk, mut facts: BoundsFacts, element: ref String, each: i64, len: i64, length: ref String) {
    let marker = f"cap#{walk.codes}"
    walk.codes += 1
    let m = walk.arena.var(marker)
    let below = walk.arena.le(m, len)
    bounding_push(walk, facts, below)
    let high_each = walk.arena.le(each, len)
    let high = bounding_each_guarded(walk, high_each)
    if !walk.rule_facts.iter().any(fn(known) { known.1 == high }) {
        walk.rule_facts.push((element.clone(), high))
    }
    walk.capped.push((marker, length.clone(), element.clone(), high))
}

/// The standing bound of `element` against `length` taken away: of the
/// length named, or of every length where `element` is empty.
fn rules_capped_drop(mut walk: BoundsWalk, element: ref String, length: ref String) {
    let mut kept: Vec[(String, String, String, i64)] = []
    let mut gone: collections::BTreeSet[i64] = collections::BTreeSet()
    for entry in walk.capped {
        if entry.1 == length && (element.is_empty() || entry.2 == element) {
            gone.insert(entry.3)
        } else {
            kept.push(entry.clone())
        }
    }
    if gone.is_empty() {
        return
    }
    walk.capped = kept
    let mut left: Vec[(String, i64)] = []
    for (each, fact) in walk.rule_facts {
        if !gone.contains(fact) {
            left.push((each.clone(), fact))
        }
    }
    walk.rule_facts = left
}

/// **Whether a fact beside the facts holds here** (#1785): each does, but
/// a `capped` bound only while its `cap#k` stands among `facts` beside the
/// length it names.
fn rules_standing(walk: ref BoundsWalk, facts: ref BoundsFacts, fact: i64) -> bool {
    let mut marked = false
    for (marker, length, _, high) in walk.capped {
        if high == fact {
            if rules_marker_stands(walk, facts, marker, length) {
                return true
            }
            marked = true
        }
    }
    return !marked
}

/// Whether the marker `cap#k` of a `capped` bound stands among `facts`
/// beside the length it names (`rules_capped_stand`).
fn rules_marker_stands(walk: ref BoundsWalk, facts: ref BoundsFacts, marker: ref String, length: ref String) -> bool {
    return facts.facts.iter().any(fn(f) { walk.arena.mentions(f, marker) && walk.arena.mentions(f, length) })
}

/// **The markers of `capped` bounds against `name`'s length that a loop or
/// a branch keeps** (#1785): `cap#k <= len` stays true where `changed`
/// only adds to the list, or shortens it only through methods of its own
/// value, each of which keeps the rule (no `bare_falls`, #1808), so the
/// bound stands past it, even where a counted loop named the length it was
/// reached with instead.
fn rules_capped_grown(mut walk: BoundsWalk, facts: ref BoundsFacts, name: ref String, changed: ref BoundsChanged) -> Vec[i64] {
    let mut out: Vec[i64] = []
    if changed.bare_falls.contains(name) || changed.values.contains(name) {
        return out
    }
    let length = length_of(name)
    // The names a counted loop gave the length it was reached with
    // (`#k:` of `bounding_turn_bounds`), each still tied to the length: one
    // a shrink since forgot the tie of names no length.
    let mut names = [length.clone()]
    for k in 0..<walk.entries {
        let entry = f"#{k}:{length}"
        if facts.facts.iter().any(fn(f) { walk.arena.mentions(f, entry) && walk.arena.mentions(f, length) }) {
            names.push(entry)
        }
    }
    for (marker, of, _, _) in walk.capped.clone() {
        if of != length || !facts.facts.iter().any(fn(f) { walk.arena.mentions(f, marker) && names.iter().any(fn(n) { walk.arena.mentions(f, n) }) }) {
            continue
        }
        let m = walk.arena.var(marker)
        let len = walk.arena.var(length)
        out.push(walk.arena.le(m, len))
    }
    return out
}

/// **A method called on the list `name`** (#1785): `remove` and
/// `swap_remove` shorten it by one, which `bounding_shift` carries, so a
/// `capped` bound against its length stands no more.
fn rules_capped_call(mut walk: BoundsWalk, name: ref String, method: ref String) {
    if method == "remove" || method == "swap_remove" {
        rules_capped_drop(walk, "", length_of(name))
    }
}

/// **Whether a `capped` rule holds of `root` here** (ADR-306 D21, #1785):
/// standing, or `each(root.a) <= len(root.b)` proved of every element.
fn rules_capped_holds(mut walk: BoundsWalk, facts: ref BoundsFacts, rule: ref BoundsRule, root: ref String, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let element = bounding_element_of(f"{root}.{rule.a}")
    let length = length_of(f"{root}.{rule.b}")
    // Each entry's bound is its own term, so it stands where its marker
    // does (`rules_standing`); the newest, the likeliest to, is asked
    // first (#2052).
    for entry in walk.capped.iter().rev() {
        if entry.1 == length && entry.2 == element && rules_marker_stands(walk, facts, entry.0, length) {
            return true
        }
    }
    let each = walk.arena.var(element)
    let len = walk.arena.var(length)
    let high_each = walk.arena.le(each, len)
    let goal = bounding_each_guarded(walk, high_each)
    let proved = bounding_proves(walk, facts, goal, ask)
    bounding_traced(walk, facts, goal, proved)
    return proved
}

/// Whether `kind` is a bound of one whole-number field (#1642): `floor`,
/// `cap` or `atmost` (#1681), held at every exit as a `length` rule is.
fn rules_of_a_field(kind: ref String) -> bool {
    return kind == "floor" || kind == "cap" || kind == "atmost"
}

/// **Whether a `floor` or `cap` rule holds of `root` here** (#1642): `0 <=
/// root.a`, or `root.a <= len(root.b)`. A rule standing among the facts as
/// given holds with no question asked.
fn rules_field_holds(mut walk: BoundsWalk, facts: ref BoundsFacts, rule: ref BoundsRule, root: ref String, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let name = f"{root}.{rule.a}"
    let length = if rule.kind == "atmost" { f"{root}.{rule.b}" } else { length_of(f"{root}.{rule.b}") }
    for fact in facts.facts {
        match walk.arena.at(fact) {
            SolverTerm::Le(x, y) => {
                if (rule.kind == "cap" || rule.kind == "atmost") && rules_term_is(walk, x, 1, name) && rules_term_is(walk, y, 1, length) {
                    return true
                }
            },
            SolverTerm::Ge(x, y) => {
                let at_zero = match walk.arena.at(y) {
                    SolverTerm::Int(n) => n == 0,
                    else => false,
                }
                if rule.kind == "floor" && at_zero && rules_term_is(walk, x, 1, name) {
                    return true
                }
            },
            else => {},
        }
    }
    let a = walk.arena.var(name)
    let goal = if rule.kind == "cap" || rule.kind == "atmost" {
        let b = walk.arena.var(length)
        walk.arena.le(a, b)
    } else {
        let zero = walk.arena.int(0)
        walk.arena.ge(a, zero)
    }
    let proved = bounding_proves(walk, facts, goal, ask)
    bounding_traced(walk, facts, goal, proved)
    return proved
}

/// `times * b`, or `b` itself where `times` is 1.
fn rules_times(mut walk: BoundsWalk, times: i64, b: i64) -> i64 {
    if times == 1 {
        return b
    }
    let k = walk.arena.int(times)
    return walk.arena.mul(k, b)
}

/// The list whose element names every value a rule of `kind` bounds:
/// `list` itself, or `list[]` for the values of its inner lists.
fn rules_values_of(list: ref String, kind: ref String) -> String {
    if kind == "inner" {
        return f"{list}[]"
    }
    return list.clone()
}

/// **The list an element is read out of**, as the facts of every element
/// name it: `xs` of `xs[i]`, `t.col[]` of `t.col[c][i]` (ADR-306 D28).
fn rules_list_named(base: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    let named = path_of(base, words)
    if named != null {
        return named
    }
    let outer = rules_inner_of(base, words) ?? return null
    return f"{outer}[]"
}

/// `t.col` of an inner list `t.col[c]`, or of its `.clone()`.
fn rules_inner_of(expr: ref Expr, words: ref winnow_grammar::InternerContext) -> String? {
    return match expr {
        Expr::Index { base, index, .. } => match index {
            Expr::Range { .. } => null,
            else => path_of(base, words),
        },
        Expr::MethodCall { receiver, method, args, .. } => {
            if args.is_empty() && words.resolve(method) == "clone" {
                return rules_inner_of(receiver, words)
            }
            return null
        },
        else => null,
    }
}

/// **`let name = r.m(…)`**, `m` a method a `result` rule holds of: `0 <=
/// name < len(r.b)`.
fn rules_result_facts(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, value: ref Expr, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) {
    let (root, owner, method) = rules_called(walk, value, context, words) ?? return
    for rule in walk.rules.clone() {
        if rule.owner == owner && rule.kind == "result" && rule.a == method {
            let n = walk.arena.var(name)
            let zero = walk.arena.int(0)
            let b = walk.arena.var(length_of(f"{root}.{rule.b}"))
            let low = walk.arena.ge(n, zero)
            let high = walk.arena.lt(n, b)
            facts.ints.insert(name.clone())
            bounding_push(walk, facts, low)
            bounding_push(walk, facts, high)
        }
    }
}

/// A call of a method of a value with rules: the value, its type and the
/// method.
fn rules_called(walk: ref BoundsWalk, call: ref Expr, context: ref BoundsContext, words: ref winnow_grammar::InternerContext) -> (String, String, String)? {
    match call {
        Expr::MethodCall { receiver, method, .. } => {
            let root = path_of(receiver, words) ?? return null
            let owner = walk.rule_roots.get(root) ?? return null
            let typed = context.std_receivers.get(node_key(call)) ?? return null
            if typed != owner {
                return null
            }
            return (root.clone(), owner.clone(), words.resolve(method).clone())
        },
        else => return null,
    }
}

/// **`let name = list[i]`** where facts hold of every element of `list`
/// (ADR-375 D5, #1330): they hold of `name`.
fn rules_element_facts(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, value: ref Expr, words: ref winnow_grammar::InternerContext) {
    let base = match value {
        Expr::Index { base, index, .. } => match index {
            // A cut is no element, and an empty one reads none.
            Expr::Range { .. } => return,
            else => base,
        },
        else => return,
    }
    let list = rules_list_named(base, words) ?? return
    let element = bounding_element_of(list)
    let n = walk.arena.var(name)
    let mut given: collections::BTreeMap[String, i64] = collections::BTreeMap()
    given.insert(element.clone(), n)
    let mut stated: Vec[i64] = []
    for fact in facts.facts {
        if walk.arena.mentions(fact, element) {
            stated.push(walk.arena.substitute(fact, given))
        }
    }
    for (each, fact) in walk.rule_facts.clone() {
        if each == element && rules_standing(walk, facts, fact) {
            stated.push(walk.arena.substitute(fact, given))
        }
    }
    if stated.is_empty() {
        return
    }
    facts.ints.insert(name.clone())
    // The read stopped the program where `list` is empty, so the facts of
    // every element, guarded by its emptiness, hold of `name` (#1483).
    let present = bounding_each_present(walk, list)
    bounding_push(walk, facts, present)
    for fact in stated {
        bounding_push(walk, facts, fact)
    }
}

/// **An index read out of a list whose every element facts bound**:
/// `0 <= list.each() < len` proves `list[i]` inside.
fn rules_element_inside(mut walk: BoundsWalk, len: i64, index: ref Expr, facts: ref BoundsFacts, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let base = match index {
        Expr::Index { base, .. } => base,
        else => return false,
    }
    let list = rules_list_named(base, words) ?? return false
    let element = bounding_element_of(list)
    if !facts.facts.iter().any(fn(f) { walk.arena.mentions(f, element) }) && !walk.rule_facts.iter().any(fn(r) { r.0 == element }) {
        return false
    }
    let each = walk.arena.var(element)
    let zero = walk.arena.int(0)
    let low = walk.arena.ge(each, zero)
    let high = walk.arena.lt(each, len)
    let inside = walk.arena.and([low, high])
    // The inner read stops the program where `list` is empty, so the outer
    // one needs its position only where it is not (#1483).
    let goal = bounding_each_guarded(walk, inside)
    let proved = bounding_proves(walk, facts, goal, ask)
    bounding_traced(walk, facts, goal, proved)
    return proved
}

/// **Where control leaves a checked body**: by its end, a `return`, a
/// `throw` or an error passed on. Every `length` rule must hold of `self`
/// again; a `result` rule of the method checked must hold of what a
/// `return` hands back.
fn rules_exit(mut walk: BoundsWalk, facts: ref BoundsFacts, returned: ref Expr?, throwing: bool, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    // What the function is found to return (ADR-306 D23).
    bounding_returned(walk, facts, returned, throwing, context, program, words, ask)
    // What a builder hands back (`rules_builder`).
    for built in walk.rule_built.clone() {
        if walk.checking && rules_handed_back(returned, built, words) > 0 {
            rules_lengths_hold(walk, facts, built, ask)
        }
    }
    if !walk.checking || !walk.rule_roots.contains_key("self") {
        return
    }
    let self_owner = walk.rule_roots.get("self")?.clone() ?? ""
    for (at, rule) in walk.rules.clone().iter().enumerate() {
        if rule.kind == "length" {
            if !walk.rule_failed.contains(at) && !rules_same_length(walk, facts, rule, "self", ask) {
                walk.rule_failed.insert(at)
            }
        } else if rules_of_a_field(rule.kind) {
            if rule.owner == self_owner && !walk.rule_failed.contains(at) && !rules_field_holds(walk, facts, rule, "self", ask) {
                walk.rule_failed.insert(at)
            }
        } else if rule.kind == "capped" {
            if rule.owner == self_owner && !walk.rule_failed.contains(at) && !rules_capped_holds(walk, facts, rule, "self", ask) {
                walk.rule_failed.insert(at)
            }
        } else if walk.checked_results.contains(at) && !throwing {
            // A `return` with no value hands back no position of `self.b`.
            if returned == null {
                walk.rule_failed.insert(at)
                continue
            }
            if !rules_position(walk, facts, returned ?? continue, "self", rule.b, context, program, words, ask) {
                walk.rule_failed.insert(at)
            }
        }
    }
}

/// Every `length` rule of the type of `root` asked for of it; one not
/// proved goes into `rule_failed`.
fn rules_lengths_hold(mut walk: BoundsWalk, facts: ref BoundsFacts, root: ref String, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    let owner = walk.rule_roots.get(root)?.clone() ?? return
    for (at, rule) in walk.rules.clone().iter().enumerate() {
        // One found failing stays failed: not asked again.
        if rule.kind == "length" && rule.owner == owner && !walk.rule_failed.contains(at) && !rules_same_length(walk, facts, rule, root, ask) {
            walk.rule_failed.insert(at)
        }
        if rules_of_a_field(rule.kind) && rule.owner == owner && !walk.rule_failed.contains(at) && !rules_field_holds(walk, facts, rule, root, ask) {
            walk.rule_failed.insert(at)
        }
        if rule.kind == "capped" && rule.owner == owner && !walk.rule_failed.contains(at) && !rules_capped_holds(walk, facts, rule, root, ask) {
            walk.rule_failed.insert(at)
        }
    }
}

fn rules_same_length(mut walk: BoundsWalk, facts: ref BoundsFacts, rule: ref BoundsRule, root: ref String, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let a = walk.arena.var(length_of(f"{root}.{rule.a}"))
    let b = walk.arena.var(length_of(f"{root}.{rule.b}"))
    let multiple = rules_times(walk, rule.times, b)
    let goal = walk.arena.equal(a, multiple)
    let proved = rules_length_known(walk, facts, rule, root) || bounding_proves(walk, facts, goal, ask)
    bounding_traced(walk, facts, goal, proved)
    return proved
}

/// **Whether the rule stands among the facts as given** (`rules_give`):
/// `len(root.a) == times * len(root.b)` itself. What the walk holds is true
/// where it stands, and a change of either length forgets it, so it holds
/// with no question asked: a method that changes neither length asks none.
fn rules_length_known(walk: ref BoundsWalk, facts: ref BoundsFacts, rule: ref BoundsRule, root: ref String) -> bool {
    let a = length_of(f"{root}.{rule.a}")
    let b = length_of(f"{root}.{rule.b}")
    for fact in facts.facts {
        match walk.arena.at(fact) {
            SolverTerm::Eq(x, y) => {
                if rules_term_is(walk, x, 1, a) && rules_term_is(walk, y, rule.times, b) {
                    return true
                }
            },
            else => {},
        }
    }
    return false
}

/// Whether `term` is `times * name` as `rules_times` builds it: the
/// variable alone where `times` is 1.
fn rules_term_is(walk: ref BoundsWalk, term: i64, times: i64, name: ref String) -> bool {
    if times == 1 {
        return match walk.arena.at(term) {
            SolverTerm::Var(n) => n == name,
            else => false,
        }
    }
    return match walk.arena.at(term) {
        SolverTerm::Mul(k, v) => match walk.arena.at(k) {
            SolverTerm::Int(n) => n == times && rules_term_is(walk, v, 1, name),
            else => false,
        },
        else => false,
    }
}

/// Whether `value` is a position of `self.b`: `0 <= value < len(self.b)`,
/// or the result of a method a `result` rule of `b` holds of.
fn rules_position(mut walk: BoundsWalk, facts: ref BoundsFacts, value: ref Expr, of: ref String, b: ref String, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let called = rules_called(walk, value, context, words)
    if called != null {
        let (root, owner, method) = called ?? return false
        if root == of && rules_has(walk.rules, owner, "result", method, b) {
            return true
        }
    }
    // An element read out of a list whose every element facts bound: what
    // holds of each element holds of it (ADR-306 D22).
    let read = rules_element_read(walk, value, facts, words)
    let v = read ?? bounding_lin(walk, value, facts, context, program, words) ?? return false
    let zero = walk.arena.int(0)
    let len = walk.arena.var(length_of(f"{of}.{b}"))
    let low = walk.arena.ge(v, zero)
    let high = walk.arena.lt(v, len)
    let inside = walk.arena.and([low, high])
    // An element read stops the program where its list is empty (#1483).
    let goal = if read != null { bounding_each_guarded(walk, inside) } else { inside }
    let proved = bounding_proves(walk, facts, goal, ask)
    bounding_traced(walk, facts, goal, proved)
    return proved
}

/// **`list[i]` where facts hold of every element of `list`**: the term of
/// its elements, of which those facts speak.
fn rules_element_read(mut walk: BoundsWalk, value: ref Expr, facts: ref BoundsFacts, words: ref winnow_grammar::InternerContext) -> i64? {
    let base = match value {
        Expr::Index { base, .. } => base,
        else => return null,
    }
    let list = rules_list_named(base, words) ?? return null
    let element = bounding_element_of(list)
    if !facts.facts.iter().any(fn(f) { walk.arena.mentions(f, element) }) && !walk.rule_facts.iter().any(fn(r) { r.0 == element }) {
        return null
    }
    return walk.arena.var(element)
}

/// Whether `value` is at most `len(self.b)`: what a push onto `b` itself
/// may put, the list one longer after it (ADR-306 D22).
fn rules_up_to(mut walk: BoundsWalk, facts: ref BoundsFacts, value: ref Expr, of: ref String, b: ref String, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let v = bounding_lin(walk, value, facts, context, program, words) ?? return false
    let zero = walk.arena.int(0)
    let len = walk.arena.var(length_of(f"{of}.{b}"))
    let low = walk.arena.ge(v, zero)
    let high = walk.arena.le(v, len)
    let goal = walk.arena.and([low, high])
    let proved = bounding_proves(walk, facts, goal, ask)
    bounding_traced(walk, facts, goal, proved)
    return proved
}

/// **Whether `value` is at least every element of `list`** (#1688): what a
/// push onto an `ascending` list may put. Nothing is asked of an empty one.
fn rules_at_least_each(mut walk: BoundsWalk, facts: ref BoundsFacts, value: ref Expr, list: ref String, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let v = bounding_lin(walk, value, facts, context, program, words) ?? return false
    let each = walk.arena.var(bounding_element_of(list))
    let above = walk.arena.ge(v, each)
    let goal = bounding_each_guarded(walk, above)
    let proved = bounding_proves(walk, facts, goal, ask)
    bounding_traced(walk, facts, goal, proved)
    return proved
}

/// **`let name = r.a[k]`, `r.a.pop() ?? …` or `r.a.last() ?? …` of an
/// `ascending` list** (ADR-306 D21, #1688): the last element, or the one
/// a `pop` took, is at least every element left; `k` is the last position
/// where `k + 1 >= len(r.a)` is proved. A list found empty is no element,
/// so the fact is guarded by its emptiness.
fn rules_ascending_facts(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, value: ref Expr, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if !walk.rules.iter().any(fn(r) { r.kind == "ascending" }) {
        return
    }
    let mut list: String? = null
    let mut last_at: Expr? = null
    match value {
        Expr::Index { base, index, .. } => match index {
            Expr::Range { .. } => return,
            else => {
                list = path_of(base, words)
                last_at = index.clone()
            },
        },
        Expr::Coalesce { value: left, .. } => match left {
            Expr::MethodCall { receiver, method, args, .. } => {
                let m = words.resolve(method)
                if args.is_empty() && (m == "pop" || m == "last") {
                    list = path_of(receiver, words)
                }
            },
            else => return,
        },
        else => return,
    }
    let path = list ?? return
    if !rules_ordered(walk, path) {
        return
    }
    if last_at != null {
        let k = bounding_lin(walk, last_at ?? return, facts, context, program, words) ?? return
        rules_order_read(walk, facts, name, path, k)
        let one = walk.arena.int(1)
        let next = walk.arena.add(k, one)
        let len = walk.arena.var(length_of(path))
        let last = walk.arena.ge(next, len)
        if !bounding_proves(walk, facts, last, ask) {
            return
        }
    }
    let n = walk.arena.var(name)
    let each = walk.arena.var(bounding_element_of(path))
    let below = walk.arena.le(each, n)
    let fact = bounding_each_guarded(walk, below)
    facts.ints.insert(name.clone())
    bounding_push(walk, facts, fact)
}

/// Whether the list `path` is of an `ascending` rule that holds here.
fn rules_ordered(walk: ref BoundsWalk, path: ref String) -> bool {
    for (root, owner) in walk.rule_roots {
        for (at, rule) in walk.rules.iter().enumerate() {
            if rule.kind == "ascending" && rule.owner == owner && path == f"{root}.{rule.a}" && !(walk.checking && walk.rule_failed.contains(at)) {
                return true
            }
        }
    }
    return false
}

/// **`let name = path[at]` of an `ascending` list** (ADR-306 D21, #1785):
/// every element before `at` is at most `name`, while neither the length,
/// `name` nor `at` changes. A fresh `ord#k` equal to their sum stands among
/// the facts for as long; `rules_truncated` reads it.
fn rules_order_read(mut walk: BoundsWalk, mut facts: BoundsFacts, name: ref String, path: ref String, at: i64) {
    let marker = f"ord#{walk.codes}"
    walk.codes += 1
    let m = walk.arena.var(marker)
    let v = walk.arena.var(name)
    let len = walk.arena.var(length_of(path))
    let both = walk.arena.add(v, at)
    let sum = walk.arena.add(both, len)
    let fact = walk.arena.equal(m, sum)
    facts.ints.insert(name.clone())
    bounding_push(walk, facts, fact)
    walk.ordered.push((marker, path.clone(), at, name.clone()))
}

/// **`path.truncate(to)` of an `ascending` list after `let v = path[at]`
/// with `to <= at`** (ADR-306 D21, #1785): every element left is at most
/// `v`. The facts that holds, read before the call, to state after it.
fn rules_truncated(mut walk: BoundsWalk, facts: ref BoundsFacts, name: ref String, method: ref String, args: ref Vec[Expr], context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> Vec[i64] {
    let mut out: Vec[i64] = []
    if method != "truncate" || args.len() != 1 || walk.ordered.is_empty() || !rules_ordered(walk, name) {
        return out
    }
    let to = bounding_lin(walk, args[0], facts, context, program, words) ?? return out
    let length = length_of(name)
    for (marker, path, at, v) in walk.ordered.clone() {
        if path != name || !facts.facts.iter().any(fn(f) { walk.arena.mentions(f, marker) && walk.arena.mentions(f, v) && walk.arena.mentions(f, length) }) {
            continue
        }
        let goal = walk.arena.le(to, at)
        if !bounding_proves(walk, facts, goal, ask) {
            continue
        }
        let each = walk.arena.var(bounding_element_of(name))
        let n = walk.arena.var(v)
        let below = walk.arena.le(each, n)
        out.push(bounding_each_guarded(walk, below))
    }
    return out
}

/// **An element of a list of `self` written in a checked body**
/// (`self.a[i] = value`, ADR-306 D22): an `index` rule of `a` holds on
/// where the value is a position of its `b`; a compound write drops it.
fn rules_element_write(mut walk: BoundsWalk, facts: ref BoundsFacts, target: ref Expr, op: ref BinaryOp?, value: ref Expr, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if !walk.checking {
        return
    }
    let base = match target {
        Expr::Index { base, .. } => base,
        else => return,
    }
    // `r.a[i] = v` writes an element of `r.a`; `r.a[c][i] = v` one of an
    // inner list of `r.a` (ADR-306 D28).
    let list = path_of(base, words)
    let inner = if list == null { rules_inner_of(base, words) } else { null }
    for (root, owner) in walk.rule_roots.clone() {
        for (at, rule) in walk.rules.clone().iter().enumerate() {
            let a = f"{root}.{rule.a}"
            if rule.owner != owner || walk.rule_failed.contains(at) {
                continue
            }
            // An element written breaks an order (#1688).
            if rule.kind == "ascending" && (list ?? "") == a {
                walk.rule_failed.insert(at)
                continue
            }
            // A value of `a` up to `b`'s length (#1785).
            if rule.kind == "capped" && (list ?? "") == a {
                if op != null || !rules_up_to(walk, facts, value, root, rule.b, context, program, words, ask) {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            // A value of `a`, or of an inner list of it (ADR-306 D28).
            if (rule.kind == "index" && (list ?? "") == a) || (rule.kind == "inner" && (inner ?? "") == a) {
                if op != null || !rules_position(walk, facts, value, root, rule.b, context, program, words, ask) {
                    walk.rule_failed.insert(at)
                }
            } else if rule.kind == "inner" && (list ?? "") == a {
                // A whole inner list: each value it holds must be one.
                if op != null || !rules_positions(walk, facts, value, root, rule.b, context, program, words, ask) {
                    walk.rule_failed.insert(at)
                }
            }
        }
    }
}

/// Whether `value` is a list literal each item of which is a position of
/// `of.b`: what an inner list of an `inner` rule may take (ADR-306 D28).
fn rules_positions(mut walk: BoundsWalk, facts: ref BoundsFacts, value: ref Expr, of: ref String, b: ref String, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    let items = match value {
        Expr::ListLit { items, .. } => items,
        else => return false,
    }
    for item in items {
        if !rules_position(walk, facts, item, of, b, context, program, words, ask) {
            return false
        }
    }
    return true
}

/// **Past a read of a list**: the read stops the program where its
/// position lies outside, so past it `0 <= i < len` holds, as what an
/// `assert` claims does (ADR-269 D4). Only a list known to be one - a rule
/// speaks of it, the body built it, its type says so, or it is a list field
/// the walks see (D21), or the checker typed it a std list (#1431) - for a
/// map's key may lie past its length.
fn rules_read_inside(mut walk: BoundsWalk, base: ref Expr, index: ref Expr, mut facts: BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext) {
    let list = path_of(base, words) ?? return
    let mut known = walk.shape.roots.contains(list) || walk.lists.contains(list)
    if context.list_indices.contains(node_key(base)) && !walk.shape.twice.contains(path_root(list)) {
        known = true
    }
    match base {
        Expr::Field { name, .. } => {
            if walk.shape.fields.contains(f".{words.resolve(name)}") {
                known = true
            }
        },
        else => {},
    }
    for (root, owner) in walk.rule_roots.clone() {
        for rule in walk.rules {
            if rule.owner == owner && (list == f"{root}.{rule.b}" || (rule.kind != "result" && list == f"{root}.{rule.a}")) {
                known = true
            }
        }
    }
    if !known || walk.collecting || walk.pinned.contains(path_root(list)) {
        return
    }
    let at = bounding_lin(walk, index, facts, context, program, words) ?? return
    let len = bounding_list_length(walk, list, node_key(base), context)
    let zero = walk.arena.int(0)
    let low = walk.arena.ge(at, zero)
    let high = walk.arena.lt(at, len)
    bounding_push(walk, facts, low)
    bounding_push(walk, facts, high)
}

/// **The rules of `self` across a loop of a checked body** (#1925): the
/// head forgets the lengths the loop changes, so a call of a method of the
/// type in its body found the `length` rules broken. Each rule of a field
/// the loop changes (`changed`) that holds where the loop is entered is
/// given again at the head and past the loop (`rules_loop_give`) and asked
/// for at each end of a turn and each `break` (`rules_turn_end`): it holds
/// at every head, by induction. Asked before the head forgets; the indexes
/// of the rules kept.
fn rules_loop_entry(mut walk: BoundsWalk, facts: ref BoundsFacts, changed: ref BoundsChanged, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> Vec[i64] {
    let mut kept: Vec[i64] = []
    if !walk.checking {
        return kept
    }
    let owner = walk.rule_roots.get("self")?.clone() ?? return kept
    for (at, rule) in walk.rules.clone().iter().enumerate() {
        if rule.owner != owner || walk.rule_failed.contains(at) || !rules_kept_at_turns(rule.kind) {
            continue
        }
        if !rules_writes(changed, f"self.{rule.a}") && (rule.b.is_empty() || !rules_writes(changed, f"self.{rule.b}")) {
            continue
        }
        if rules_holds_here(walk, facts, rule, ask) {
            kept.push(at)
        }
    }
    return kept
}

/// The rules `kept` (`rules_loop_entry`) given of `self` after a loop's
/// head forgot what `changed` changes.
fn rules_loop_give(mut walk: BoundsWalk, mut facts: BoundsFacts, kept: ref Vec[i64], changed: ref BoundsChanged) {
    if kept.is_empty() {
        return
    }
    let owner = walk.rule_roots.get("self")?.clone() ?? return
    rules_give(walk, facts, "self", owner, false, false, changed, kept)
}

/// **At the end of a turn or a `break`** of the innermost loop: each rule
/// its head was given (`rule_loops`) must hold, or it fails.
fn rules_turn_end(mut walk: BoundsWalk, facts: ref BoundsFacts, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if !walk.checking || walk.rule_loops.is_empty() {
        return
    }
    let kept = walk.rule_loops[walk.rule_loops.len() - 1].clone()
    for at in kept {
        let rule = walk.rules[at].clone()
        if !walk.rule_failed.contains(at) && !rules_holds_here(walk, facts, rule, ask) {
            walk.rule_failed.insert(at)
        }
    }
}

/// The kinds of rule a loop's head is given again (`rules_loop_entry`).
fn rules_kept_at_turns(kind: ref String) -> bool {
    return kind == "length" || kind == "capped" || rules_of_a_field(kind)
}

/// Whether a rule of a kind `rules_kept_at_turns` names holds of `self` here.
fn rules_holds_here(mut walk: BoundsWalk, facts: ref BoundsFacts, rule: ref BoundsRule, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) -> bool {
    if rule.kind == "length" {
        return rules_same_length(walk, facts, rule, "self", ask)
    }
    if rule.kind == "capped" {
        return rules_capped_holds(walk, facts, rule, "self", ask)
    }
    return rules_field_holds(walk, facts, rule, "self", ask)
}

/// **A call in a checked body** (`receiver` a path, or nothing for a free
/// function), before it runs: a method of the type on `self` must find
/// every `length` rule holding; a `std` method on a field must keep the
/// rules of it; any other call that writes a field of `self` (`changed`, by
/// its frame, or what it is handed where it has none) drops the rules of
/// that field.
fn rules_at_call(mut walk: BoundsWalk, call: ref Expr, receiver: ref String?, method: ref String, args: ref Vec[Expr], changed: ref BoundsChanged, facts: ref BoundsFacts, context: ref BoundsContext, program: ref Program, words: ref winnow_grammar::InternerContext, ask: fn(ref TermArena, ref Vec[i64], i64) -> bool sync) {
    if !walk.checking {
        return
    }
    let on = receiver ?? ""
    let typed = context.std_receivers.get(node_key(call))?.clone() ?? ""
    if on == "self" && walk.rule_roots.contains_key("self") && typed == (walk.rule_roots.get("self")?.clone() ?? "") {
        let self_owner = walk.rule_roots.get("self")?.clone() ?? ""
        for (at, rule) in walk.rules.clone().iter().enumerate() {
            if rule.kind == "length" && !walk.rule_failed.contains(at) && !rules_same_length(walk, facts, rule, "self", ask) {
                walk.rule_failed.insert(at)
            }
            if rules_of_a_field(rule.kind) && rule.owner == self_owner && !walk.rule_failed.contains(at) && !rules_field_holds(walk, facts, rule, "self", ask) {
                walk.rule_failed.insert(at)
            }
            if rule.kind == "capped" && rule.owner == self_owner && !walk.rule_failed.contains(at) && !rules_capped_holds(walk, facts, rule, "self", ask) {
                walk.rule_failed.insert(at)
            }
        }
        return
    }
    // A method of the type on another value of it keeps its rules: it is
    // checked itself. The value a builder builds must find them holding
    // (`rules_builder`).
    if !on.is_empty() && on != "self" && walk.rule_roots.contains_key(on) && typed == (walk.rule_roots.get(on)?.clone() ?? "") {
        if walk.rule_built.contains(on) {
            rules_lengths_hold(walk, facts, on, ask)
        }
        return
    }
    // A method on an inner list (`r.a[c].push(x)`, ADR-306 D28).
    let inner = match call {
        Expr::MethodCall { receiver: called_on, .. } => if receiver == null { rules_inner_of(called_on, words) } else { null },
        else => null,
    }
    for (root, owner) in walk.rule_roots.clone() {
        for (at, rule) in walk.rules.clone().iter().enumerate() {
            if rule.owner != owner || walk.rule_failed.contains(at) {
                continue
            }
            let a = f"{root}.{rule.a}"
            let b = f"{root}.{rule.b}"
            if rule.kind == "ascending" {
                // A push puts at least every element; only a shortening
                // keeps the order else (#1688).
                let kept = if on != a {
                    !rules_writes(changed, a)
                } else if method == "push" && args.len() == 1 {
                    rules_at_least_each(walk, facts, args[0], a, context, program, words, ask)
                } else {
                    method == "pop" || method == "truncate" || method == "clear" || (keeps_length(method) && keeps_items(method))
                }
                if !kept {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            if rule.kind == "index" && on == a && rule.a == rule.b {
                // A list of its own positions: a push puts at most the length
                // before it, and nothing may take from it.
                let kept = if method == "push" && args.len() == 1 {
                    rules_up_to(walk, facts, args[0], root, rule.b, context, program, words, ask)
                } else {
                    keeps_length(method) && method != "fill"
                }
                if !kept {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            if rule.kind == "index" && on == a {
                let kept = if method == "push" && args.len() == 1 {
                    rules_position(walk, facts, args[0], root, rule.b, context, program, words, ask)
                } else {
                    rules_takes_away(method) || (keeps_length(method) && method != "fill")
                }
                if !kept {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            if rule.kind == "inner" && (inner ?? "") == a {
                let kept = if method == "push" && args.len() == 1 {
                    rules_position(walk, facts, args[0], root, rule.b, context, program, words, ask)
                } else {
                    rules_takes_away(method) || (keeps_length(method) && method != "fill")
                }
                if !kept {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            if rule.kind == "inner" && on == a {
                // A whole inner list pushed: each value it holds a position.
                let kept = if method == "push" && args.len() == 1 {
                    rules_positions(walk, facts, args[0], root, rule.b, context, program, words, ask)
                } else {
                    rules_takes_away(method) || (keeps_length(method) && method != "fill")
                }
                if !kept {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            if (rule.kind == "index" || rule.kind == "inner") && on == b {
                if !rules_adds(method) && !keeps_length(method) {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            if rule.kind == "capped" {
                // A push puts at most `b`'s length; a shrink of `b` of
                // `self`, or of the value a builder builds, the exits ask
                // for; of any other value, only a growth keeps it (#1785).
                let open = root == "self" || walk.rule_built.contains(root)
                let kept = if on == a {
                    if method == "push" && args.len() == 1 {
                        rules_up_to(walk, facts, args[0], root, rule.b, context, program, words, ask)
                    } else {
                        rules_takes_away(method) || (keeps_length(method) && method != "fill")
                    }
                } else if on == b {
                    open || rules_adds(method) || keeps_length(method)
                } else {
                    !rules_writes(changed, a) && (open || !rules_writes(changed, b))
                }
                if !kept {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            if rule.kind == "length" && (on == a || on == b) {
                // The walk follows the length; the exits ask for it.
                continue
            }
            if rule.kind == "result" {
                continue
            }
            if rules_of_a_field(rule.kind) {
                // Of `self`, or of the value a builder builds, the exits ask
                // for it; of any other value, a call may not take from `b`
                // nor write `a` (#1642).
                if root == "self" || walk.rule_built.contains(root) {
                    continue
                }
                if rule.kind == "cap" && on == b && !rules_adds(method) && !keeps_length(method) {
                    walk.rule_failed.insert(at)
                    continue
                }
                if rules_writes(changed, a) || (rule.kind == "atmost" && rules_writes(changed, b)) {
                    walk.rule_failed.insert(at)
                }
                continue
            }
            // A write of the root as a whole lies around `a` and `b` both.
            if rules_writes(changed, a) || rules_writes(changed, b) {
                walk.rule_failed.insert(at)
            }
        }
    }
}

/// What a call writes: by its frame, or where it has none, every path in
/// `fallback` (what it is handed `mut`) as a whole.
fn rules_changed_by(frame: ref BoundsChanged?, receiver: ref String?, handed: ref Vec[String?], fallback: ref Vec[String]) -> BoundsChanged {
    let known = frame ?? return rules_handed(fallback)
    return frame_at_call(known, receiver, handed)
}

/// What a body ends with, where that is a value: what it hands back.
fn rules_tail(body: ref Block) -> Expr? {
    let last = body.stmts.last() ?? return null
    return match last.node {
        Stmt::Expr(value) => value.clone(),
        else => null,
    }
}

/// What a call without a frame writes: every path it hands on, as a whole.
fn rules_handed(paths: ref Vec[String]) -> BoundsChanged {
    let mut out = nothing_changed()
    for p in paths {
        out.values.insert(p.clone())
    }
    return out
}

/// Whether `changed` writes `path` or a part of it, or a whole it is part
/// of.
fn rules_writes(changed: ref BoundsChanged, path: ref String) -> bool {
    let mut all: Vec[String] = []
    for p in changed.values {
        all.push(p.clone())
    }
    for p in changed.lengths {
        all.push(p.clone())
    }
    for p in changed.parts {
        all.push(p.clone())
    }
    for place in changed.elements {
        all.push(frame_list(place))
    }
    for p in all {
        if path_within(p, path) || (path_within(path, p) && path != p) {
            return true
        }
    }
    return false
}

fn rules_takes_away(method: ref String) -> bool {
    return method == "pop" || method == "clear" || method == "truncate" || method == "remove" || method == "swap_remove"
}

fn rules_adds(method: ref String) -> bool {
    return method == "push" || method == "insert" || method == "extend"
}

/// **After a call of a method of the type on a value with rules**: the
/// method keeps them, so they hold of the value again: all of them, or
/// where its frame is known (`every` false), those of what it `written`.
fn rules_after_call(mut walk: BoundsWalk, mut facts: BoundsFacts, call: ref Expr, receiver: ref String?, context: ref BoundsContext, every: bool, written: ref BoundsChanged) {
    let on = receiver ?? return
    let owner = walk.rule_roots.get(on)?.clone() ?? return
    if (context.std_receivers.get(node_key(call)) ?? "") != owner {
        return
    }
    rules_give(walk, facts, on, owner, false, every, written, [])
}
