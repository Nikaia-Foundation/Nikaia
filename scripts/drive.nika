// One driver for a whole batch: builders and the architect, until an escalation.
//
//     nikaia run scripts/drive.nika -- DIR [--max N] [--no-bump] [--ignore-ci-red] [--dry-run] [--lines FILE]
//
// Loops on `cycle.nika -- DIR` and acts on its lines, one agent at a time:
//
//     NEXT <brief> ...            agent.nika -- <brief> --dir DIR, then the
//                                 run's files are committed (locally); no
//                                 suite until the batch ends
//     BUMP pending, CI green      cycle.nika -- DIR --apply
//     CUT, RED, BATCH DONE        the batch's suite starts in the background,
//                                 and the architect beside it: agent.nika --
//                                 DIR/architect-task.md, the stop line (and
//                                 failing jobs) in DIR/architect-input.txt
//
// Output: one line per agent run (`builder done ...`, `architect done ...`).
// Escalation: one final line, exit 2, on an OWNER line, an ESCALATE of
// agent.nika, an architect report whose `Owner:` is not `none` or whose
// `Result:` is not `done`, the same stop line after an architect run, a RED sha
// seen before with no builder to run, `--max` agent runs (default 8), a push
// rejected after one rebase, a suite still red after 2 QA rounds.
//
// `--ignore-ci-red`: a RED line of the cycle (CI red on develop) is not handed
// to the architect; NEXT and BATCH DONE go on as if CI were green, and a BUMP
// still waits for green CI (a lane whose pushes its own suite gates does not
// fix other lanes' reds; the main lane runs without it).
//
// **Builders commit, the driver tests and pushes** (owner, 2026-10-31: once
// per batch). After each builder or architect run and its report commit, the
// run's brief is appended to DIR/unpushed.txt (one brief path a line). The
// builders of a batch run one after the other with no suite between them. When
// the batch ends (CUT, RED or BATCH DONE, right before the architect starts)
// the suite starts on HEAD in the background (`drive_suite`) and the architect
// runs beside it; before the next batch's first builder, a bump, or the end of
// the run (an escalation and a RESTART too) the driver waits for it
// (`drive_settle`: one line `SUITE <sha8> waiting`, a poll every 10 s) and
// handles its result. When `git rev-list --count origin/develop..HEAD` is 0
// after a fetch, there is nothing to test (unpushed.txt is emptied). When every
// path those commits touch (`git log --format= --name-only origin/develop..HEAD`)
// is documentation by the rule of scripts/ci-changes.sh (`drive_docs_path`: CI
// skips its build and test jobs for them too), HEAD is pushed as on green
// without a suite, `SUITE <sha8> docs-only, pushed without the suite`, and
// unpushed.txt is emptied. `--docs-only FILE` prints `docs`/`code` for each
// path in FILE and `docs-only` or `suite` (for tests). Else the driver
// takes the checkout's suite lock, `mkdir target/suite.lock` with
// `<pid> <DIR>` in target/suite.lock/owner: two drivers (the main lane and the
// bug lane) share this checkout, so one waits in 60 s steps while the owner's
// pid lives; a dead owner's lock is taken over. Once it has the lock, and
// before each suite run, it fetches and counts again: the other lane's push
// often already holds these commits, and then it prints `SUITE nothing new
// after the lock`, empties unpushed.txt and releases the lock. The lock is held
// through the whole red -> QA -> suite loop (one QA at a time in the
// checkout) and released on every path, an escalation
// too. It notes the tested sha and runs the suite in a worktree of its own
// (owner, 2026-10-31): the shared checkout holds the other lane's and other
// sessions' unfinished files, which a suite run there would test although they
// are not in the tested commit (a false red, or a green owed to a file never
// pushed). The suite worktree is /home/user/nikaia-suite, or $NIKAIA_SUITE_DIR;
// it is only the driver's. Not yet a worktree of this repository: `git worktree
// add --detach <path> <sha>`; else `git -C <path> checkout --detach --force
// <sha>` and `git -C <path> clean -fdx -e target` (force and clean there only,
// never in the shared checkout; it never checks out `develop`). Its target/ is
// kept between runs: it is the suite's build cache. Before that, the disk
// guard: `df -Pk` of the path (or its parent), one line `SUITE disk <N> GB
// free`; under 8 GB it deletes the worktree's target/fast/incremental and
// target/debug and reads again; still under, it prints (and writes into
// DIR/suite.log) `ESCALATE drive: disk: <N> GB free, the suite needs 8`, the
// lock released and the commits left local. Then, detached from the driver
// (`sh -c '( ... ) &'`) with the worktree as working directory, the suite
// builds its own interpreter from the tested sha, `cargo build --profile fast
// -p nikaia` (never the shared target/fast/nikaia, which builders rebuild from a
// dirty tree: on 2026-10-31 it held half of #920 and turned the suite at
// 444d6d31 falsely red); a failed build is a red suite with the step `build`
// (`Gate: red build`, QA gets it like any red). That <path>/target/fast/nikaia
// runs the tested sha's `scripts/gate.nika -- --all`, so its crates/ and tests/
// are the worktree's (gate's own `build` step then finds the binary up to
// date). A stale target/suite-nikaia of older drivers is deleted. The driver's
// own binary still runs cycle.nika, agent.nika and the rest. Both run with
// CARGO_INCREMENTAL=0 (incremental data costs about 10 GB a tree and a suite
// build gains nothing from it) and NIKAIA_CACHE_LIMIT=4G. Its output goes to
// DIR/suite.log of the shared checkout (overwritten), its exit status to
// target/suite.lock/exit-<sha>, and target/suite.lock/testing notes `<sha> <N>`,
// N the lines of unpushed.txt the tested sha covers; the driver prints
// `SUITE <sha8> started in the background`, and when it has waited,
// `SUITE <sha8> green|red <steps>`. `--df FILE` reads a `df -Pk` output from
// FILE and prints the disk line and `ok` or the escalation (for tests).
// Green: `git push origin <sha>:develop`, exactly the tested commit; when
// rejected (other sessions push too), `git pull --rebase --autostash` and push
// HEAD: the rebased commits are CI's to judge. Still rejected: escalate. A
// conflicted rebase is never left open in the shared checkout (2026-10-31: both
// lanes write docs/briefs/, and the checkout stayed mid-rebase until fixed by
// hand): the conflicted paths are noted, `git rebase --abort` (HEAD and the
// autostash restored), and `ESCALATE drive: push rejected, rebase conflicted in
// <paths>, rebase aborted`; an abort that fails, or leaves a rebase or an
// unmerged path, escalates with `rebase left open: ...`. Then it prints
// `PUSHED <sha8>` and drops the N tested lines from unpushed.txt (the
// architect's commit made beside the suite waits for the next batch's suite;
// after a rebased push of HEAD it empties the file). Red: DIR/qa-input.txt gets the
// suite's step lines, the last 200 lines of suite.log, the failed tests and
// last 200 lines of each target/gate-tests-*.log of the suite worktree, `git log
// origin/develop..HEAD`, and the brief and report of each brief in
// unpushed.txt; the QA agent runs (role `qa`) on DIR/qa/qa-task.md, a copy of
// the template docs/briefs/qa-task.md made before each run (its report path
// made the copy's), in the shared checkout; the copy, its report and run files
// are committed by name, as the others, and the suite runs
// again on the new HEAD, in the worktree the same way, and is waited for at
// once (the next batch starts only on green). At most 2 QA
// rounds: a third red prints `ESCALATE drive: suite red after 2 QA rounds:
// <steps>` and leaves the commits local. Nothing else pushes.
// `--no-bump` leaves the version raise to another driver: a second lane in the
// same session (`docs/briefs/bugs`) runs with it, so only the main lane's
// driver raises the version and two raises never meet in `CHANGELOG.md`.
// `--dry-run` runs one step of the loop and prints the commands it would run
// and the final line `DRY-RUN <action>`; `--lines FILE` takes the cycle's
// output from FILE instead of running `cycle.nika` (for tests).
// A builder's `Pushed: rejected` (or `none`) is rewritten when its commit is found in the log.
// `--rewrite REPORT LOGFILE` prints the rewritten report (for tests).
// **A move that kept under 60% of the converter's draft calls for a converter
// repair** (owner, 2026-10-27): a builder report whose `Rs2nika:` reads `kept N
// of M lines` with N < 0.6 M prints `CONVERT drive: ...`, and the main session
// repairs the converter beside the next move, which the driver starts at once
// (owner, 2026-10-28: the pipeline no longer waits for the repair).
// `--kept REPORT` prints `ok` or that line (for tests).
// `nikaia run` compiles this script once, so a commit to it does nothing until a
// restart: at the top of each round of a real run the driver reads
// scripts/drive.nika again, and if it changed since the start it prints the one
// final line `RESTART drive: scripts/drive.nika changed` and exits 3 (the main
// session starts it again at once). `--changed OLDFILE` prints that line or
// `same` (for tests).
// The scripts are run as programs: a script cannot `use` another.

use std::cli
use std::env
use std::fs
use std::process
use std::text

fn drive_exe() -> String throws {
    for exe in ["target/fast/nikaia", "target/release/nikaia"] {
        if fs::exists(exe, fs::Root::Anywhere) { return exe.to_string() }
    }
    return ""
}

// Ends the run with exit 2; a suite still running is waited for and handled
// first (drive_settle), with one line naming the escalation it delays.
fn drive_escalate(why: String) throws {
    let lane = drive_lock_lane()
    if lane != "" && drive_testing() != "" {
        println(f"SUITE before escalating: {why}")
        let exe = drive_exe()
        drive_settle(exe.clone(), lane)
    }
    drive_unlock()
    println(f"ESCALATE drive: {why}")
    process::exit(2)
}

// The suite lock of this checkout (drive_suite).
fn drive_lock_dir() -> String {
    return "target/suite.lock"
}

// This driver's pid: the parent of the shell it starts.
fn drive_pid() -> String throws {
    return process::run("sh", ["-c", "echo $PPID"]).stdout.trim().clone()
}

// Releases the suite lock if this driver holds it; every exit path calls it.
fn drive_unlock() throws {
    let owner = drive_read(drive_lock_dir() + "/owner")
    if owner == "" { return }
    if owner.split(" ").collect()[0].trim() == drive_pid() { process::run("rm", ["-rf", drive_lock_dir()]) }
}

// Takes the suite lock: waits in 60 s steps while another live driver holds
// it, takes over a dead one's. An owner file not yet written counts as live
// for two steps.
fn drive_lock(dir: String) throws {
    let me = drive_pid()
    let mut blank: i64 = 0
    let mut said = false
    while true {
        process::run("mkdir", ["-p", "target"])
        if process::run("mkdir", [drive_lock_dir()]).ok {
            fs::write(drive_lock_dir() + "/owner", fs::Root::Anywhere, f"{me} {dir}\n")
            return
        }
        let owner = drive_read(drive_lock_dir() + "/owner").trim().clone()
        let pid = owner.split(" ").collect()[0].clone()
        let mut live = false
        if pid == "" {
            blank += 1
            live = blank <= 2
        } else {
            live = process::run("kill", ["-0", pid.clone()]).ok
        }
        if !live {
            process::run("rm", ["-rf", drive_lock_dir()])
            continue
        }
        if !said {
            println(f"SUITE waiting for target/suite.lock: {owner}")
            said = true
        }
        process::run("sleep", ["60"])
    }
}

// The brief's name: the last path component without `.md`.
fn drive_stem(path: String) -> String throws {
    let parts = path.split("/").collect()
    let last = parts[parts.len() - 1].clone()
    return last.replace(".md", "")
}

// The first word of the value after `key:` in a report, "" if absent.
fn drive_field(body: String, key: String) -> String {
    let prefix = key.clone() + ":"
    for line in body.split("\n") {
        let t = line.trim()
        if t.starts_with(prefix.clone()) { return (t.strip_prefix(prefix.clone()) ?? "").trim().clone() }
    }
    return ""
}

fn drive_word(value: String) -> String {
    return value.split(" ").collect()[0].replace(".", "").clone()
}

// The stop line for a report whose `Rs2nika:` kept under 60% of the draft,
// "" for any other report.
fn drive_kept(report: String) -> String {
    let field = drive_field(report, "Rs2nika")
    let at = field.find("kept ") ?? return ""
    let rest = field[at + "kept ".len()..<field.len()].clone()
    let words = rest.split(" ").collect()
    if words.len() < 3 || words[1] != "of" { return "" }
    let kept = text::parse_i64(words[0].clone()) ?? return ""
    let all = text::parse_i64(words[2].clone()) ?? return ""
    if all <= 0 || kept * 100 >= all * 60 { return "" }
    return f"rs2nika kept {kept} of {all} lines, under 60%: repair the converter beside the next move"
}

// Which action a cycle's output leads to, as one line:
//   ESCALATE <why> | RED <line> | BUMP | NEXT <abs brief> | ARCHITECT <stop line>
// `red_seen`: " sha " for each RED already handed to the architect;
// `last_stop`: the stop line of the last architect run.
// `ignore_red` (--ignore-ci-red): a RED line leads nowhere; NEXT and BATCH DONE
// go on as if CI were green, and BUMP still waits for a green CI line.
fn drive_action(lines: Vec[String], red_seen: String, last_stop: String, ignore_red: bool) -> String {
    let mut ci: String = ""
    let mut red: String = ""
    let mut batch: String = ""
    let mut bump: String = ""
    for i in 0..<lines.len() {
        let l = lines[i].trim().clone()
        if l.starts_with("OWNER ") { return f"ESCALATE {l}" }
        if l.starts_with("CI ") { ci = l.clone() }
        if l.starts_with("RED ") { red = l.clone() }
        if l.starts_with("NEXT ") || l.starts_with("CUT") || l.starts_with("BATCH") { batch = l.clone() }
        if l.starts_with("BUMP pending") { bump = l.clone() }
    }
    if red != "" && !ignore_red {
        let sha = red.split(" ").collect()[1].clone()
        if !red_seen.contains(f" {sha} ") { return f"RED {red}" }
        if !batch.starts_with("NEXT ") { return f"ESCALATE second RED on {sha}" }
    }
    if bump != "" && ci.ends_with("green") && !batch.starts_with("NEXT ") { return "BUMP" }
    if batch.starts_with("NEXT ") { return f"NEXT {batch.split(" ").collect()[1]}" }
    if batch.starts_with("CUT") || batch.starts_with("BATCH DONE") {
        if batch == last_stop { return f"ESCALATE architect left the same stop line: {batch}" }
        return f"ARCHITECT {batch}"
    }
    return f"ESCALATE no action for: {batch}"
}

// The files of the main session's commit for one run, those that exist.
fn drive_paths(dir: String, brief: String) -> Vec[String] throws {
    let stem = (brief.strip_suffix(".md") ?? "").clone()
    let mut out: Vec[String] = []
    let mut all: Vec[String] = []
    all.push(f"{brief}.report.md")
    if stem != "" { all.push(f"{stem}.report.md") }
    all.push(f"{brief}.run.json")
    // What agent.nika keeps of the run (owner, 2026-10-28: keep the history).
    all.push(f"{brief}.debrief.md")
    if stem != "" {
        all.push(f"{stem}.debrief.md")
        all.push(f"{stem}.draft.nika")
        all.push(f"{stem}.draft.nika.notes")
        all.push(f"{stem}.draft.nika.rs")
    }
    all.push(f"{dir}/cost.txt")
    all.push(f"{dir}/tokens.txt")
    all.push("docs/tokenspeed.md")
    for i in 0..<all.len() {
        if fs::exists(all[i].clone(), fs::Root::Anywhere) { out.push(all[i].clone()) }
    }
    return out
}

// The report with `Pushed:` rewritten when `Result: done`, `Pushed:` is
// `rejected` or `none`, and a log line `<sha>\t<subject>` has the report's
// `Commit:` as its subject; else the report as it is. The log is the last 40
// commits of both `HEAD` and `origin/develop` (drive_commit), so a commit
// already on `origin/develop` is found too.
fn drive_rewrite(report: String, log: String) -> String {
    if drive_word(drive_field(report.clone(), "Result")) != "done" { return report }
    let pushed = drive_word(drive_field(report.clone(), "Pushed"))
    if pushed != "rejected" && pushed != "none" { return report }
    let subject = drive_field(report.clone(), "Commit")
    if subject == "" { return report }
    let mut sha: String = ""
    for l in log.split("\n") {
        let parts = l.split("\t").collect()
        if sha == "" && parts.len() == 2 && parts[1].trim() == subject { sha = parts[0].trim().clone() }
    }
    if sha == "" { return report }
    let mut out: Vec[String] = []
    let mut done = false
    for l in report.split("\n") {
        if !done && l.trim().starts_with("Pushed:") {
            out.push(f"Pushed: {sha} (pushed by drive.nika)")
            done = true
        } else {
            out.push(l.clone())
        }
    }
    return out.join("\n")
}

fn drive_say(dry: bool, line: String) {
    if dry { println(f"would run: {line}") }
}

// Pushes the tested commit; rejected, rebases once and pushes HEAD (the
// rebased commits are CI's to judge). Prints `PUSHED <sha8>`. True when HEAD
// was pushed (after the rebase), false when exactly `sha`.
fn drive_push(sha: String) -> bool throws {
    let first = process::run("git", ["push", "origin", f"{sha}:develop"])
    let mut pushed = sha.clone()
    let mut head = false
    if !first.ok {
        // The shared checkout holds other agents' unfinished files and build locks:
        // they are stashed around the rebase, not a reason to stop (2026-10-28).
        let pulled = process::run("git", ["pull", "--rebase", "--autostash", "origin", "develop"])
        if !pulled.ok { drive_rebase_abort() }
        let second = process::run("git", ["push", "origin", "HEAD:develop"])
        if !second.ok { drive_escalate("push rejected after one rebase") }
        pushed = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
        head = true
    }
    println(f"PUSHED {drive_short(pushed)}")
    return head
}

// A failed `git pull --rebase` must not leave the shared checkout mid-rebase:
// the conflicted paths are noted, `git rebase --abort` restores HEAD and applies
// the autostash back, and the check that no rebase is left open and no path is
// unmerged precedes the escalation. Always escalates.
fn drive_rebase_abort() throws {
    let unmerged = process::run("git", ["diff", "--name-only", "--diff-filter=U"]).stdout.trim().split("\n").collect().join(" ")
    let paths = if unmerged == "" { "no unmerged path" } else { unmerged.clone() }
    let aborted = process::run("git", ["rebase", "--abort"])
    let git_dir = process::run("git", ["rev-parse", "--git-dir"]).stdout.trim().clone()
    let open = fs::exists(f"{git_dir}/rebase-merge", fs::Root::Anywhere) || fs::exists(f"{git_dir}/rebase-apply", fs::Root::Anywhere)
    let left = process::run("git", ["diff", "--name-only", "--diff-filter=U"]).stdout.trim().clone()
    if !aborted.ok || open || left != "" {
        let why = (aborted.stderr + aborted.stdout).trim().split("\n").collect()[0].clone()
        drive_escalate(f"rebase left open: push rejected, rebase conflicted in {paths}, and git rebase --abort did not finish ({why}); the shared checkout needs a hand now")
    }
    drive_escalate(f"push rejected, rebase conflicted in {paths}, rebase aborted")
}

fn drive_short(sha: String) -> String throws {
    if sha.len() <= 8 { return sha }
    return sha.bytes[0..<8].text().clone()
}

fn drive_append(path: String, line: String) throws {
    let old = drive_read(path.clone())
    let mut text = old.clone()
    if text != "" && !text.ends_with("\n") { text = text + "\n" }
    fs::write(path, fs::Root::Anywhere, text + line + "\n")
}

// The last `n` lines of a text.
fn drive_tail(body: String, n: i64) -> String throws {
    let lines = body.trim_end().split("\n").collect()
    let mut from: i64 = 0
    if lines.len() > n { from = lines.len() - n }
    let mut out: Vec[String] = []
    for i in from..<lines.len() { out.push(lines[i].clone()) }
    return out.join("\n")
}

// What the QA agent reads: the suite's step lines and log tail, the failed
// tests and the tail of each target/gate-tests-*.log in the suite worktree, the
// unpushed commits, and the briefs and reports they came from.
fn drive_qa_input(dir: String, out: String, steps: String) throws {
    let mut lines: Vec[String] = []
    lines.push(f"The suite (scripts/gate.nika -- --all) is red: {steps}")
    lines.push("")
    lines.push("Step lines:")
    for l in out.split("\n") {
        for step in ["build ", "lower-std ", "fmt ", "clippy ", "pre-push ", "test ", "guards ", "Gate: "] {
            if l.starts_with(step) { lines.push(l.clone()) }
        }
    }
    lines.push("")
    lines.push(f"Last 200 lines of {dir}/suite.log:")
    lines.push(drive_tail(out, 200))
    for name in ["compiler", "rs2nika-facts", "rs2nika-convert"] {
        let log = f"{drive_suite_dir()}/target/gate-tests-{name}.log"
        if !fs::exists(log.clone(), fs::Root::Anywhere) { continue }
        let body = drive_read(log.clone())
        lines.push("")
        lines.push(f"Failed tests in {log}:")
        for l in body.split("\n") {
            if l.contains(" ... FAILED") { lines.push(l.clone()) }
        }
        lines.push(f"Last 200 lines of {log}:")
        lines.push(drive_tail(body, 200))
    }
    lines.push("")
    lines.push("Unpushed commits (origin/develop..HEAD):")
    lines.push(process::run("git", ["log", "--format=%h %s", "origin/develop..HEAD"]).stdout.trim().clone())
    lines.push("")
    lines.push("Briefs and reports of the unpushed commits:")
    for b in drive_read(f"{dir}/unpushed.txt").split("\n") {
        let brief = b.trim().clone()
        if brief == "" { continue }
        lines.push(brief.clone())
        let stem = (brief.strip_suffix(".md") ?? "").clone()
        for r in [f"{brief}.report.md", f"{stem}.report.md"] {
            if r != ".report.md" && fs::exists(r.clone(), fs::Root::Anywhere) { lines.push(r.clone()) }
        }
    }
    fs::write(f"{dir}/qa-input.txt", fs::Root::Anywhere, lines.join("\n") + "\n")
}

// The red steps of a gate run, "" when green.
fn drive_red_steps(out: String) -> String throws {
    for l in out.split("\n") {
        if l.starts_with("Gate: green") { return "" }
        if l.starts_with("Gate: red") { return (l.strip_prefix("Gate: red") ?? "").trim().clone() }
    }
    return "gate-error"
}

// The suite's own worktree (header comment): NIKAIA_SUITE_DIR, else
// /home/user/nikaia-suite.
fn drive_suite_dir() -> String {
    let set = env::var("NIKAIA_SUITE_DIR") ?? ""
    if set != "" { return set.clone() }
    return "/home/user/nikaia-suite"
}

// The free KiB in the 4th field of `df -Pk`'s second line, -1 when unread.
fn drive_df_kib(out: String) -> i64 throws {
    let lines = out.trim().split("\n").collect()
    if lines.len() < 2 { return -1 }
    let mut fields: Vec[String] = []
    for f in lines[1].split(" ") {
        if f.trim() != "" { fields.push(f.trim().clone()) }
    }
    if fields.len() < 4 { return -1 }
    return text::parse_i64(fields[3].clone()) ?? -1
}

// The free KiB of the filesystem holding `path` (its parent while it does not exist).
fn drive_free_kib(path: String) -> i64 throws {
    let mut at = path.clone()
    if !fs::exists(at.clone(), fs::Root::Anywhere) { at = process::run("dirname", [path]).stdout.trim().clone() }
    return drive_df_kib(process::run("df", ["-Pk", at]).stdout)
}

// The suite needs 8 GB: below, the worktree's incremental data and debug build
// go first; still below, the driver escalates (header comment).
fn drive_disk(wt: String, dir: String) throws {
    let need: i64 = 8 * 1048576
    let mut free = drive_free_kib(wt.clone())
    if free >= 0 && free < need {
        process::run("rm", ["-rf", f"{wt}/target/fast/incremental", f"{wt}/target/debug"])
        free = drive_free_kib(wt.clone())
    }
    if free >= 0 && free < need {
        // Still below: the shared checkout's debug build (clippy rebuilds it)
        // and the two build caches pruned by their own LRU pass.
        process::run("rm", ["-rf", "target/debug"])
        process::run("target/fast/nikaia", ["cache", "prune"]; env: [("NIKAIA_CACHE_LIMIT", "1G")])
        let tests = process::run("realpath", ["target/nikaia-project-tests"]).stdout.trim().clone()
        process::run("target/fast/nikaia", ["cache", "prune"]; env: [("NIKAIA_CACHE_DIR", tests), ("NIKAIA_CACHE_LIMIT", "3G")])
        free = drive_free_kib(wt.clone())
    }
    println(drive_disk_line(free))
    let why = drive_disk_short(free)
    if why != "" {
        fs::write(f"{dir}/suite.log", fs::Root::Anywhere, f"ESCALATE drive: {why}\n")
        drive_escalate(why)
    }
}

// The run's disk line; a `df` that could not be read does not stop the suite.
fn drive_disk_line(free: i64) -> String {
    if free < 0 { return "SUITE disk unread (df -Pk printed no free space)" }
    return f"SUITE disk {free / 1048576} GB free"
}

// Why `free` KiB are too few for the suite, "" when enough (or unread).
fn drive_disk_short(free: i64) -> String {
    if free < 0 || free >= 8 * 1048576 { return "" }
    return f"disk: {free / 1048576} GB free, the suite needs 8"
}

// Puts the suite worktree at `sha`, detached: added the first time, else
// checked out with force and cleaned of everything but its target/ (the build
// cache). Force and clean happen only there, never in the shared checkout.
fn drive_worktree(wt: String, sha: String) throws {
    let listed = process::run("git", ["worktree", "list", "--porcelain"]).stdout
    let mut known = false
    for l in listed.split("\n") {
        if l.trim() == f"worktree {wt}" { known = true }
    }
    if !known {
        process::run("git", ["worktree", "prune"])
        let added = process::run("git", ["worktree", "add", "--detach", wt.clone(), sha.clone()])
        if !added.ok { drive_escalate(f"git worktree add {wt} failed: {added.stderr.trim()}") }
        return
    }
    let moved = process::run("git", ["-C", wt.clone(), "checkout", "--detach", "--force", sha.clone()])
    if !moved.ok { drive_escalate(f"git -C {wt} checkout {drive_short(sha)} failed: {moved.stderr.trim()}") }
    process::run("git", ["-C", wt.clone(), "clean", "-fdx", "-e", "target"])
}

// Starts one suite run in the worktree, in the background: the tested sha's own
// interpreter is built there first (the shared target/fast/nikaia is rebuilt by
// builders from a dirty tree), a failed build being a red suite with the step
// `build`; then that binary runs the tested sha's scripts/gate.nika, with the
// worktree as working directory. The output goes to DIR/suite.log, its exit status to
// target/suite.lock/exit-<sha>, and target/suite.lock/testing notes
// `<sha> <lines of unpushed.txt it covers>` (drive_settle reads both).
fn drive_launch(dir: String, wt: String) throws {
    let sha = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
    drive_disk(wt.clone(), dir.clone())
    drive_worktree(wt.clone(), sha.clone())
    process::run("rm", ["-f", f"{wt}/target/suite-nikaia"])
    let log = process::run("realpath", [dir.clone()]).stdout.trim().clone() + "/suite.log"
    let exit = process::run("realpath", [drive_lock_dir()]).stdout.trim().clone() + f"/exit-{sha}"
    process::run("rm", ["-f", exit.clone(), log.clone()])
    let mut covered: i64 = 0
    for l in drive_read(f"{dir}/unpushed.txt").split("\n") {
        if l.trim() != "" { covered += 1 }
    }
    let build = f"echo 'suite build: cargo build --profile fast -p nikaia' > '{log}' && CARGO_INCREMENTAL=0 cargo build --profile fast -p nikaia --message-format short >> '{log}' 2>&1"
    let run = f"CARGO_INCREMENTAL=0 NIKAIA_CACHE_LIMIT=4G '{wt}/target/fast/nikaia' run scripts/gate.nika -- --all >> '{log}' 2>&1"
    let red = f"{{ echo 'build red'; echo 'Gate: red build'; }} >> '{log}'; false"
    let gate = f"cd '{wt}' && if {build}; then {run}; else {red}; fi; echo $? > '{exit}.tmp'; mv '{exit}.tmp' '{exit}'"
    let started = process::run("sh", ["-c", f"( {gate} ) < /dev/null > /dev/null 2>&1 &"])
    if !started.ok { drive_escalate(f"the suite did not start in {wt}: {started.stderr.trim()}") }
    fs::write(drive_lock_dir() + "/testing", fs::Root::Anywhere, f"{sha} {covered}\n")
    println(f"SUITE {drive_short(sha)} started in the background")
}

// The suite this driver started and has not handled yet: `<sha> <covered>`
// from target/suite.lock/testing while it holds the lock, else "".
fn drive_testing() -> String throws {
    let owner = drive_read(drive_lock_dir() + "/owner")
    if owner == "" || owner.split(" ").collect()[0].trim() != drive_pid() { return "" }
    return drive_read(drive_lock_dir() + "/testing").trim().clone()
}

// The lane directory of the lock this driver holds, "" when it holds none.
fn drive_lock_lane() -> String throws {
    let owner = drive_read(drive_lock_dir() + "/owner").trim().clone()
    let words = owner.split(" ").collect()
    if words.len() < 2 || words[0].trim() != drive_pid() { return "" }
    return words[1].trim().clone()
}

// The QA task's one text; each lane's QA runs on a copy of it (drive_qa_copy).
fn drive_qa_template() -> String {
    return "docs/briefs/qa-task.md"
}

// The brief lane DIR's QA runs on: DIR/qa/qa-task.md, so each lane's QA
// writes its report and run files into its own directory and two drivers'
// commits of them never conflict (2026-10-31: `rebase conflicted in
// docs/briefs/qa-task.md.report.md`).
fn drive_qa_brief(dir: String) -> String {
    return f"{dir}/qa/qa-task.md"
}

// Copies the template to drive_qa_brief(dir), creating DIR/qa/; the one
// change is the report path the template names, made the copy's own.
fn drive_qa_copy(dir: String) throws {
    let qa = drive_qa_brief(dir.clone())
    process::run("mkdir", ["-p", f"{dir}/qa"])
    let text = drive_read(drive_qa_template())
    fs::write(qa.clone(), fs::Root::Anywhere, text.replace(f"{drive_qa_template()}.report.md", f"{qa}.report.md"))
}

// Waits for the background suite, if one runs, and handles its result: green
// pushes the tested sha and drops the briefs it covered from unpushed.txt; red
// starts the QA agent, and QA's commit gets its suite at once, waited for, at
// most 2 QA rounds. Releases the lock on every path. One `SUITE <sha8> waiting`
// line, polls every 10 s.
fn drive_settle(exe: String, dir: String) throws {
    let qa = drive_qa_brief(dir.clone())
    let wt = drive_suite_dir()
    let mut rounds: i64 = 0
    while true {
        let testing = drive_testing()
        if testing == "" { return }
        let parts = testing.split(" ").collect()
        let sha = parts[0].clone()
        let mut covered: i64 = 0
        if parts.len() > 1 { covered = text::parse_i64(parts[1].clone()) ?? 0 }
        let exit = f"{drive_lock_dir()}/exit-{sha}"
        if !fs::exists(exit.clone(), fs::Root::Anywhere) {
            println(f"SUITE {drive_short(sha.clone())} waiting")
            while !fs::exists(exit.clone(), fs::Root::Anywhere) { process::run("sleep", ["10"]) }
        }
        process::run("rm", ["-f", exit, drive_lock_dir() + "/testing"])
        let out = drive_read(f"{dir}/suite.log")
        let steps = drive_red_steps(out.clone())
        if steps == "" {
            println(f"SUITE {drive_short(sha.clone())} green")
            let all = drive_push(sha)
            let mut left: Vec[String] = []
            let mut seen: i64 = 0
            for l in drive_read(f"{dir}/unpushed.txt").split("\n") {
                if l.trim() == "" { continue }
                seen += 1
                if seen > covered && !all { left.push(l.trim().clone()) }
            }
            let mut body: String = ""
            if left.len() > 0 { body = left.join("\n") + "\n" }
            fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, body)
            drive_unlock()
            return
        }
        println(f"SUITE {drive_short(sha)} red {steps}")
        if rounds >= 2 { drive_escalate(f"suite red after 2 QA rounds: {steps}") }
        drive_qa_input(dir.clone(), out, steps)
        drive_qa_copy(dir.clone())
        process::run("rm", ["-f", f"{qa}.report.md"])
        drive_agent(exe.clone(), false, dir.clone(), qa.clone(), "qa")
        rounds += 1
        drive_commit(false, dir.clone(), qa.clone(), [qa.clone()])
        drive_tidy(false, dir.clone())
        drive_append(f"{dir}/unpushed.txt", qa.clone())
        if drive_nothing_new(dir.clone()) { return }
        drive_launch(dir.clone(), wt.clone())
    }
}

// The path rule of scripts/ci-changes.sh (its `docs` output), kept alike with
// it: a path is documentation when it is under guide/ or website/, or ends in
// `.md` and is neither CHANGELOG.md nor under crates/, packages/, examples/,
// benches/, tools/, scripts/, tests/ or docs/specification/. A change of
// .github/workflows/ or of ci-changes.sh itself runs everything.
fn drive_docs_path(path: String) -> bool {
    if path.starts_with("guide/") || path.starts_with("website/") { return true }
    if !path.ends_with(".md") || path == "CHANGELOG.md" { return false }
    for tree in ["crates/", "packages/", "examples/", "benches/", "tools/", "scripts/", "tests/", "docs/specification/"] {
        if path.starts_with(tree) { return false }
    }
    return true
}

// True when every path is documentation (drive_docs_path) and there is one.
fn drive_docs_only(paths: Vec[String]) -> bool {
    let mut any = false
    for p in paths {
        if p == "" { continue }
        if p.starts_with(".github/workflows/") || p == "scripts/ci-changes.sh" { return false }
        if !drive_docs_path(p.clone()) { return false }
        any = true
    }
    return any
}

// The paths the unpushed commits touch, each commit's own.
fn drive_unpushed_paths() -> Vec[String] throws {
    let log = process::run("git", ["log", "--format=", "--name-only", "origin/develop..HEAD"]).stdout
    let mut out: Vec[String] = []
    for line in log.split("\n") {
        let p = line.trim().clone()
        if p != "" { out.push(p) }
    }
    return out
}

// After the lock and before each suite: another lane may have pushed these
// commits meanwhile. Nothing left to push: unpushed.txt emptied, the lock
// released, true.
fn drive_nothing_new(dir: String) -> bool throws {
    process::run("git", ["fetch", "--quiet", "origin", "develop"])
    let count = process::run("git", ["rev-list", "--count", "origin/develop..HEAD"]).stdout.trim().clone()
    if count != "0" { return false }
    fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, "")
    drive_unlock()
    println("SUITE nothing new after the lock")
    return true
}

// At the end of a batch: waits for a suite still running (drive_settle), then
// starts the complete suite on HEAD in the background and returns at once; the
// architect runs beside it (header comment).
fn drive_suite(exe: String, dry: bool, dir: String) throws {
    let qa = drive_qa_brief(dir.clone())
    let wt = drive_suite_dir()
    drive_say(dry, "a suite still running (target/suite.lock/testing): wait for it first (SUITE <sha8> waiting)")
    drive_say(dry, "git fetch origin develop; git rev-list --count origin/develop..HEAD (0: nothing to test)")
    drive_say(dry, "git log --format= --name-only origin/develop..HEAD: all documentation by scripts/ci-changes.sh's rule, push HEAD without the suite (SUITE <sha8> docs-only, pushed without the suite), empty " + f"{dir}/unpushed.txt")
    drive_say(dry, "mkdir target/suite.lock (wait while its owner's pid lives)")
    drive_say(dry, "after the lock and before each suite: git fetch origin develop; git rev-list --count origin/develop..HEAD (0: SUITE nothing new after the lock, " + f"empty {dir}/unpushed.txt, rm -rf target/suite.lock)")
    drive_say(dry, f"df -Pk {wt} (or its parent): under 8 GB free, rm -rf {wt}/target/fast/incremental {wt}/target/debug; still under, ESCALATE drive: disk")
    drive_say(dry, f"not yet a worktree: git worktree add --detach {wt} <sha>; else git -C {wt} checkout --detach --force <sha>; git -C {wt} clean -fdx -e target")
    drive_say(dry, f"rm -f {wt}/target/suite-nikaia; in the background, in {wt}, CARGO_INCREMENTAL=0: cargo build --profile fast -p nikaia > {dir}/suite.log (failed: Gate: red build)")
    drive_say(dry, f"then, CARGO_INCREMENTAL=0 NIKAIA_CACHE_LIMIT=4G: {wt}/target/fast/nikaia run scripts/gate.nika -- --all >> {dir}/suite.log; exit status to target/suite.lock/exit-<sha>; the architect starts at once")
    drive_say(dry, f"before the next batch's first builder (or a bump, or the end): wait for it; green: git push origin <sha>:develop, drop the tested briefs from {dir}/unpushed.txt, rm -rf target/suite.lock")
    drive_say(dry, f"red: write {dir}/qa-input.txt, mkdir -p {dir}/qa, copy {drive_qa_template()} to {qa} (its report path made {qa}.report.md), rm -f {qa}.report.md, {exe} run scripts/agent.nika -- {qa} --dir {dir}, commit {qa} with its report and run files, the suite again and waited for (at most 2 QA rounds)")
    if dry { return }
    drive_settle(exe.clone(), dir.clone())
    process::run("git", ["fetch", "--quiet", "origin", "develop"])
    let count = process::run("git", ["rev-list", "--count", "origin/develop..HEAD"]).stdout.trim().clone()
    if count == "0" {
        fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, "")
        return
    }
    if drive_docs_only(drive_unpushed_paths()) {
        let head = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
        println(f"SUITE {drive_short(head.clone())} docs-only, pushed without the suite")
        drive_push(head)
        fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, "")
        return
    }
    drive_lock(dir.clone())
    if drive_nothing_new(dir.clone()) { return }
    drive_launch(dir, wt)
}

fn drive_commit(dry: bool, dir: String, brief: String, extra: Vec[String]) throws {
    let mut paths = drive_paths(dir, brief.clone())
    for i in 0..<extra.len() {
        if fs::exists(extra[i].clone(), fs::Root::Anywhere) { paths.push(extra[i].clone()) }
    }
    if paths.len() == 0 { return }
    let report_path = f"{brief}.report.md"
    if fs::exists(report_path.clone(), fs::Root::Anywhere) {
        let old = drive_read(report_path.clone())
        process::run("git", ["fetch", "--quiet", "origin", "develop"])
        let log = process::run("git", ["log", "-40", "--format=%h%x09%s", "HEAD", "origin/develop"]).stdout.clone()
        let fresh = drive_rewrite(old.clone(), log)
        if fresh != old {
            drive_say(dry, f"rewrite Pushed: in {report_path}")
            if !dry { fs::write(report_path.clone(), fs::Root::Anywhere, fresh) }
        }
    }
    let name = drive_stem(brief)
    let msg = f"briefs: {name} report"
    drive_say(dry, "git add " + paths.join(" "))
    drive_say(dry, f"git commit -m '{msg}' -- " + paths.join(" "))
    if dry { return }
    let mut add: Vec[String] = ["add"]
    for i in 0..<paths.len() { add.push(paths[i].clone()) }
    process::run("git", add)
    let mut status: Vec[String] = ["status", "--porcelain", "--"]
    for i in 0..<paths.len() { status.push(paths[i].clone()) }
    let changed = process::run("git", status).stdout.trim().clone()
    if changed == "" { return }
    let mut commit: Vec[String] = ["commit", "-m", msg, "--"]
    for i in 0..<paths.len() { commit.push(paths[i].clone()) }
    let made = process::run("git", commit)
    if !made.ok {
        let why = (made.stderr + made.stdout).trim().split("\n").collect()[0].clone()
        drive_escalate(f"git commit failed for {name}: {why}")
    }
}

// What a run leaves behind that no commit takes: the converter's lock file a
// build rewrote, and untracked step reports (`*.step<N>.report.md`) beside the
// briefs. Runs after the run's own commit, so nothing it commits is lost.
fn drive_tidy(dry: bool, dir: String) throws {
    drive_say(dry, "git checkout -- crates/rs2nika/convert/nikaia.lock")
    let left = process::run("git", ["ls-files", "--others", "--exclude-standard", "--", dir])
    let mut stray: Vec[String] = []
    for l in left.stdout.trim().split("\n") {
        if l.contains(".step") && l.ends_with(".report.md") { stray.push(l.clone()) }
    }
    if stray.len() > 0 { drive_say(dry, "rm -f " + stray.join(" ")) }
    if dry { return }
    process::run("git", ["checkout", "--", "crates/rs2nika/convert/nikaia.lock"])
    for i in 0..<stray.len() { process::run("rm", ["-f", stray[i].clone()]) }
}

// Runs one agent; prints `<role> done ...`; escalates on anything else.
fn drive_agent(exe: String, dry: bool, dir: String, brief: String, role: String) throws {
    drive_say(dry, f"{exe} run scripts/agent.nika -- {brief} --dir {dir}")
    if dry { return }
    let out = process::run(exe, ["run", "scripts/agent.nika", "--", brief.clone(), "--dir", dir.clone()])
    let mut done: String = ""
    let mut first: String = ""
    for l in out.stdout.trim().split("\n") {
        if first == "" { first = l.clone() }
        if l.starts_with("done ") { done = l.clone() }
    }
    if done == "" || !out.ok {
        if first == "" { first = f"agent.nika exited with code {out.code}" }
        drive_escalate(first)
    }
    println(f"{role} {done}")
}

fn drive_read(path: String) -> String throws {
    if !fs::exists(path.clone(), fs::Root::Anywhere) { return "" }
    return fs::read_to_string(path, fs::Root::Anywhere)
}

fn drive_cycle(exe: String, dir: String, lines_file: String) -> String throws {
    if lines_file != "" { return drive_read(lines_file) }
    let c = process::run(exe, ["run", "scripts/cycle.nika", "--", dir])
    if !c.ok { drive_escalate("cycle.nika failed") }
    return c.stdout.clone()
}

fn main() throws {
    let mut dir: String = ""
    let mut max: i64 = 8
    let mut dry = false
    let mut no_bump = false
    let mut ignore_red = false
    let mut lines_file: String = ""
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    let mut i = 1
    while i < args.len() {
        if args[i] == "--dry-run" {
            dry = true
        } else if args[i] == "--ignore-ci-red" {
            ignore_red = true
        } else if args[i] == "--no-bump" {
            no_bump = true
        } else if args[i] == "--max" && i + 1 < args.len() {
            max = text::parse_i64(args[i + 1].clone()) ?? 8
            i += 1
        } else if args[i] == "--lines" && i + 1 < args.len() {
            lines_file = args[i + 1].clone()
            dry = true
            i += 1
        } else {
            dir = args[i].clone()
        }
        i += 1
    }
    if dir == "" {
        println("usage: nikaia run scripts/drive.nika -- DIR [--max N] [--no-bump] [--ignore-ci-red] [--dry-run] [--lines FILE]")
        process::exit(2)
    }
    if args.len() == 4 && args[1] == "--rewrite" {
        println(drive_rewrite(drive_read(args[2].clone()), drive_read(args[3].clone())))
        return
    }
    if args.len() == 3 && args[1] == "--kept" {
        let why = drive_kept(drive_read(args[2].clone()))
        if why == "" { println("ok") } else { println(f"CONVERT drive: {why}") }
        return
    }
    if args.len() == 3 && args[1] == "--df" {
        let free = drive_df_kib(drive_read(args[2].clone()))
        println(drive_disk_line(free))
        let why = drive_disk_short(free)
        if why == "" { println("ok") } else { println(f"ESCALATE drive: {why}") }
        return
    }
    if args.len() == 3 && args[1] == "--docs-only" {
        let mut paths: Vec[String] = []
        for line in drive_read(args[2].clone()).split("\n") {
            let p = line.trim().clone()
            if p == "" { continue }
            if drive_docs_path(p.clone()) { println(f"docs {p}") } else { println(f"code {p}") }
            paths.push(p)
        }
        if drive_docs_only(paths) { println("docs-only") } else { println("suite") }
        return
    }
    if args.len() == 3 && args[1] == "--changed" {
        if drive_read(args[2].clone()) != drive_read("scripts/drive.nika") {
            println("RESTART drive: scripts/drive.nika changed")
        } else {
            println("same")
        }
        return
    }
    let exe = drive_exe()
    if exe == "" {
        println("BUILD cargo build --profile fast -p nikaia")
        process::exit(1)
    }
    let task = f"{dir}/architect-task.md"
    let mut runs: i64 = 0
    let mut bumps: i64 = 0
    let mut red_seen: String = ""
    let mut last_stop: String = ""
    let own = drive_read("scripts/drive.nika")
    while runs <= max {
        if !dry && drive_read("scripts/drive.nika") != own {
            drive_settle(exe.clone(), dir.clone())
            println("RESTART drive: scripts/drive.nika changed")
            process::exit(3)
        }
        let cyc = drive_cycle(exe.clone(), dir.clone(), lines_file.clone())
        let mut lines: Vec[String] = []
        for l in cyc.trim().split("\n") {
            if l.trim() != "" && !(no_bump && l.trim().starts_with("BUMP")) { lines.push(l.trim().clone()) }
        }
        if lines.len() == 0 { drive_escalate("cycle.nika printed nothing") }
        let action = drive_action(lines.clone(), red_seen.clone(), last_stop.clone(), ignore_red)
        if action.starts_with("ESCALATE ") {
            drive_settle(exe.clone(), dir.clone())
            drive_unlock()
            println(action)
            process::exit(2)
        }
        // Only the architect runs beside the batch's suite: a builder of the
        // next batch and a bump wait for it, and the cycle is read again (QA may
        // have committed, a push moved CI).
        if !dry && (action.starts_with("NEXT ") || action == "BUMP") && drive_testing() != "" {
            drive_settle(exe.clone(), dir.clone())
            continue
        }
        // A bump pushes HEAD: commits not yet through the suite (a restart
        // between a batch and its suite leaves them) are tested first.
        if !dry && action == "BUMP" && drive_read(f"{dir}/unpushed.txt").trim() != "" {
            drive_suite(exe.clone(), dry, dir.clone())
            drive_settle(exe.clone(), dir.clone())
            continue
        }
        if action == "BUMP" {
            bumps += 1
            if bumps > 3 { drive_escalate("BUMP pending persists after --apply") }
            drive_say(dry, f"{exe} run scripts/cycle.nika -- {dir} --apply")
            if dry {
                println("DRY-RUN BUMP")
                return
            }
            let rel = process::run(exe.clone(), ["run", "scripts/cycle.nika", "--", dir.clone(), "--apply"])
            if rel.stdout.contains("PUSH REJECTED") { drive_escalate("bump push rejected") }
            continue
        }
        if runs >= max { drive_escalate(f"--max {max} agent runs reached") }
        if action.starts_with("NEXT ") {
            let brief = (action.strip_prefix("NEXT ") ?? "").clone()
            drive_say(dry, "a batch's suite still running (target/suite.lock/testing): wait for it and handle it (drive_settle) first")
            drive_agent(exe.clone(), dry, dir.clone(), brief.clone(), "builder")
            runs += 1
            drive_commit(dry, dir.clone(), brief.clone(), [])
            drive_tidy(dry, dir.clone())
            drive_say(dry, f"append {brief} to {dir}/unpushed.txt (no suite until the batch ends)")
            if !dry { drive_append(f"{dir}/unpushed.txt", brief.clone()) }
            if !dry {
                let why = drive_kept(drive_read(f"{brief}.report.md"))
                if why != "" { println(f"CONVERT drive: {drive_stem(brief.clone())}: {why}") }
            }
            if dry {
                println(f"DRY-RUN NEXT {drive_stem(action.clone())}")
                return
            }
            continue
        }
        // RED or ARCHITECT: the stop line goes to the architect.
        let mut stop = (action.strip_prefix("ARCHITECT ") ?? "").clone()
        let mut input: String = stop.clone() + "\n"
        if action.starts_with("RED ") {
            stop = (action.strip_prefix("RED ") ?? "").clone()
            let sha = stop.split(" ").collect()[1].clone()
            red_seen = red_seen + f" {sha} "
            input = f"{stop}\nThe failing jobs are named in the line above; fix forward or revert.\n"
        }
        // The batch ends: its suite starts in the background, beside the architect.
        drive_suite(exe.clone(), dry, dir.clone())
        drive_say(dry, f"write {dir}/architect-input.txt: {stop}")
        drive_say(dry, f"rm -f {task}.report.md")
        if !dry {
            fs::write(f"{dir}/architect-input.txt", fs::Root::Anywhere, input)
            process::run("rm", ["-f", f"{task}.report.md"])
        }
        drive_agent(exe.clone(), dry, dir.clone(), task.clone(), "architect")
        runs += 1
        // architect-input.txt is session state (.gitignore), never committed.
        let extra: Vec[String] = []
        drive_commit(dry, dir.clone(), task.clone(), extra)
        drive_tidy(dry, dir.clone())
        drive_say(dry, f"append {task} to {dir}/unpushed.txt (tested with the next batch)")
        if !dry { drive_append(f"{dir}/unpushed.txt", task.clone()) }
        if dry {
            println(f"DRY-RUN ARCHITECT {stop}")
            return
        }
        let report = drive_read(f"{task}.report.md")
        if report == "" { drive_escalate("the architect wrote no report") }
        let result = drive_word(drive_field(report.clone(), "Result"))
        let owner = drive_field(report.clone(), "Owner")
        if result != "done" { drive_escalate(f"architect Result: {result}") }
        if owner != "none" && owner != "" { drive_escalate(f"architect Owner: {owner}") }
        last_stop = stop
    }
    drive_settle(exe.clone(), dir)
}
