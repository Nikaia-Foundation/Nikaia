// One driver for a whole batch: builders and the architect, until an escalation.
//
//     nikaia run scripts/drive.nika -- DIR [--max N] [--no-bump] [--dry-run] [--lines FILE]
//
// Loops on `cycle.nika -- DIR` and acts on its lines, one agent at a time:
//
//     NEXT <brief> ...            agent.nika -- <brief> --dir DIR, then the
//                                 run's files are committed (locally) and
//                                 the suite runs
//     BUMP pending, CI green      cycle.nika -- DIR --apply
//     CUT, RED, BATCH DONE        the architect: agent.nika -- DIR/architect-task.md,
//                                 the stop line (and failing jobs) in
//                                 DIR/architect-input.txt
//
// Output: one line per agent run (`builder done ...`, `architect done ...`).
// Escalation: one final line, exit 2, on an OWNER line, an ESCALATE of
// agent.nika, an architect report whose `Owner:` is not `none` or whose
// `Result:` is not `done`, the same stop line after an architect run, a RED sha
// seen before with no builder to run, `--max` agent runs (default 8), a push
// rejected after one rebase, a suite still red after 2 QA rounds.
//
// **Builders commit, the driver tests and pushes** (owner, 2026-10-31). After
// each builder or architect run and its report commit, the run's brief is
// appended to DIR/unpushed.txt (one brief path a line) and the suite runs
// (`drive_suite`): when `git rev-list --count origin/develop..HEAD` is 0 after a
// fetch, there is nothing to test (unpushed.txt is emptied). Else the driver
// takes the checkout's suite lock, `mkdir target/suite.lock` with
// `<pid> <DIR>` in target/suite.lock/owner: two drivers (the main lane and the
// bug lane) share this checkout, so one waits in 60 s steps while the owner's
// pid lives; a dead owner's lock is taken over. The lock is held through the
// whole red -> QA -> suite loop (both lanes' QA writes
// docs/briefs/qa-task.md.report.md) and released on every path, an escalation
// too. It notes the tested sha, runs `gate.nika -- --all` (its output in
// DIR/suite.log, overwritten) and prints `SUITE <sha8> green|red <steps>`.
// Green: `git push origin <sha>:develop`, exactly the tested commit; when
// rejected (other sessions push too), `git pull --rebase` and push HEAD: the
// rebased commits are CI's to judge. Still rejected: escalate. Then it prints
// `PUSHED <sha8>` and empties unpushed.txt. Red: DIR/qa-input.txt gets the
// suite's step lines, the last 200 lines of suite.log, `git log
// origin/develop..HEAD`, and the brief and report of each brief in
// unpushed.txt; the QA agent runs (docs/briefs/qa-task.md, role `qa`), its
// report is committed as the others, and the suite runs again. At most 2 QA
// rounds: a third red prints `ESCALATE drive: suite red after 2 QA rounds:
// <steps>` and leaves the commits local. Nothing else pushes.
// `--no-bump` leaves the version raise to another driver: a second lane in the
// same session (`docs/briefs/bugs`) runs with it, so only the main lane's
// driver raises the version and two raises never meet in `CHANGELOG.md`.
// `--dry-run` runs one step of the loop and prints the commands it would run
// and the final line `DRY-RUN <action>`; `--lines FILE` takes the cycle's
// output from FILE instead of running `cycle.nika` (for tests).
// A builder's `Pushed: rejected` (or `none`) is rewritten when its commit is found in the log.
// `--rewrite REPORT LOGFILE` prints the rewritten report (for tests).
// **A move that kept under 60% of the converter's draft calls for a converter
// repair** (owner, 2026-10-27): a builder report whose `Rs2nika:` reads `kept N
// of M lines` with N < 0.6 M prints `CONVERT drive: ...`, and the main session
// repairs the converter beside the next move, which the driver starts at once
// (owner, 2026-10-28: the pipeline no longer waits for the repair).
// `--kept REPORT` prints `ok` or that line (for tests).
// `nikaia run` compiles this script once, so a commit to it does nothing until a
// restart: at the top of each round of a real run the driver reads
// scripts/drive.nika again, and if it changed since the start it prints the one
// final line `RESTART drive: scripts/drive.nika changed` and exits 3 (the main
// session starts it again at once). `--changed OLDFILE` prints that line or
// `same` (for tests).
// The scripts are run as programs: a script cannot `use` another.

use std::cli
use std::fs
use std::process
use std::text

fn drive_exe() -> String throws {
    for exe in ["target/fast/nikaia", "target/release/nikaia"] {
        if fs::exists(exe, fs::Root::Anywhere) { return exe.to_string() }
    }
    return ""
}

fn drive_escalate(why: String) throws {
    drive_unlock()
    println(f"ESCALATE drive: {why}")
    process::exit(2)
}

// The suite lock of this checkout (drive_suite).
fn drive_lock_dir() -> String {
    return "target/suite.lock"
}

// This driver's pid: the parent of the shell it starts.
fn drive_pid() -> String throws {
    return process::run("sh", ["-c", "echo $PPID"]).stdout.trim().clone()
}

// Releases the suite lock if this driver holds it; every exit path calls it.
fn drive_unlock() throws {
    let owner = drive_read(drive_lock_dir() + "/owner")
    if owner == "" { return }
    if owner.split(" ").collect()[0].trim() == drive_pid() { process::run("rm", ["-rf", drive_lock_dir()]) }
}

// Takes the suite lock: waits in 60 s steps while another live driver holds
// it, takes over a dead one's. An owner file not yet written counts as live
// for two steps.
fn drive_lock(dir: String) throws {
    let me = drive_pid()
    let mut blank: i64 = 0
    let mut said = false
    while true {
        process::run("mkdir", ["-p", "target"])
        if process::run("mkdir", [drive_lock_dir()]).ok {
            fs::write(drive_lock_dir() + "/owner", fs::Root::Anywhere, f"{me} {dir}\n")
            return
        }
        let owner = drive_read(drive_lock_dir() + "/owner").trim().clone()
        let pid = owner.split(" ").collect()[0].clone()
        let mut live = false
        if pid == "" {
            blank += 1
            live = blank <= 2
        } else {
            live = process::run("kill", ["-0", pid.clone()]).ok
        }
        if !live {
            process::run("rm", ["-rf", drive_lock_dir()])
            continue
        }
        if !said {
            println(f"SUITE waiting for target/suite.lock: {owner}")
            said = true
        }
        process::run("sleep", ["60"])
    }
}

// The brief's name: the last path component without `.md`.
fn drive_stem(path: String) -> String throws {
    let parts = path.split("/").collect()
    let last = parts[parts.len() - 1].clone()
    return last.replace(".md", "")
}

// The first word of the value after `key:` in a report, "" if absent.
fn drive_field(body: String, key: String) -> String {
    let prefix = key.clone() + ":"
    for line in body.split("\n") {
        let t = line.trim()
        if t.starts_with(prefix.clone()) { return (t.strip_prefix(prefix.clone()) ?? "").trim().clone() }
    }
    return ""
}

fn drive_word(value: String) -> String {
    return value.split(" ").collect()[0].replace(".", "").clone()
}

// The stop line for a report whose `Rs2nika:` kept under 60% of the draft,
// "" for any other report.
fn drive_kept(report: String) -> String {
    let field = drive_field(report, "Rs2nika")
    let at = field.find("kept ") ?? return ""
    let rest = field[at + "kept ".len()..<field.len()].clone()
    let words = rest.split(" ").collect()
    if words.len() < 3 || words[1] != "of" { return "" }
    let kept = text::parse_i64(words[0].clone()) ?? return ""
    let all = text::parse_i64(words[2].clone()) ?? return ""
    if all <= 0 || kept * 100 >= all * 60 { return "" }
    return f"rs2nika kept {kept} of {all} lines, under 60%: repair the converter beside the next move"
}

// Which action a cycle's output leads to, as one line:
//   ESCALATE <why> | RED <line> | BUMP | NEXT <abs brief> | ARCHITECT <stop line>
// `red_seen`: " sha " for each RED already handed to the architect;
// `last_stop`: the stop line of the last architect run.
fn drive_action(lines: Vec[String], red_seen: String, last_stop: String) -> String {
    let mut ci: String = ""
    let mut red: String = ""
    let mut batch: String = ""
    let mut bump: String = ""
    for i in 0..<lines.len() {
        let l = lines[i].trim().clone()
        if l.starts_with("OWNER ") { return f"ESCALATE {l}" }
        if l.starts_with("CI ") { ci = l.clone() }
        if l.starts_with("RED ") { red = l.clone() }
        if l.starts_with("NEXT ") || l.starts_with("CUT") || l.starts_with("BATCH") { batch = l.clone() }
        if l.starts_with("BUMP pending") { bump = l.clone() }
    }
    if red != "" {
        let sha = red.split(" ").collect()[1].clone()
        if !red_seen.contains(f" {sha} ") { return f"RED {red}" }
        if !batch.starts_with("NEXT ") { return f"ESCALATE second RED on {sha}" }
    }
    if bump != "" && ci.ends_with("green") && !batch.starts_with("NEXT ") { return "BUMP" }
    if batch.starts_with("NEXT ") { return f"NEXT {batch.split(" ").collect()[1]}" }
    if batch.starts_with("CUT") || batch.starts_with("BATCH DONE") {
        if batch == last_stop { return f"ESCALATE architect left the same stop line: {batch}" }
        return f"ARCHITECT {batch}"
    }
    return f"ESCALATE no action for: {batch}"
}

// The files of the main session's commit for one run, those that exist.
fn drive_paths(dir: String, brief: String) -> Vec[String] throws {
    let stem = (brief.strip_suffix(".md") ?? "").clone()
    let mut out: Vec[String] = []
    let mut all: Vec[String] = []
    all.push(f"{brief}.report.md")
    if stem != "" { all.push(f"{stem}.report.md") }
    all.push(f"{brief}.run.json")
    // What agent.nika keeps of the run (owner, 2026-10-28: keep the history).
    all.push(f"{brief}.debrief.md")
    if stem != "" {
        all.push(f"{stem}.debrief.md")
        all.push(f"{stem}.draft.nika")
        all.push(f"{stem}.draft.nika.notes")
        all.push(f"{stem}.draft.nika.rs")
    }
    all.push(f"{dir}/cost.txt")
    all.push(f"{dir}/tokens.txt")
    all.push("docs/tokenspeed.md")
    for i in 0..<all.len() {
        if fs::exists(all[i].clone(), fs::Root::Anywhere) { out.push(all[i].clone()) }
    }
    return out
}

// The report with `Pushed:` rewritten when `Result: done`, `Pushed:` is
// `rejected` or `none`, and a log line `<sha>\t<subject>` has the report's
// `Commit:` as its subject; else the report as it is. The log is the last 40
// commits of both `HEAD` and `origin/develop` (drive_commit), so a commit
// already on `origin/develop` is found too.
fn drive_rewrite(report: String, log: String) -> String {
    if drive_word(drive_field(report.clone(), "Result")) != "done" { return report }
    let pushed = drive_word(drive_field(report.clone(), "Pushed"))
    if pushed != "rejected" && pushed != "none" { return report }
    let subject = drive_field(report.clone(), "Commit")
    if subject == "" { return report }
    let mut sha: String = ""
    for l in log.split("\n") {
        let parts = l.split("\t").collect()
        if sha == "" && parts.len() == 2 && parts[1].trim() == subject { sha = parts[0].trim().clone() }
    }
    if sha == "" { return report }
    let mut out: Vec[String] = []
    let mut done = false
    for l in report.split("\n") {
        if !done && l.trim().starts_with("Pushed:") {
            out.push(f"Pushed: {sha} (pushed by drive.nika)")
            done = true
        } else {
            out.push(l.clone())
        }
    }
    return out.join("\n")
}

fn drive_say(dry: bool, line: String) {
    if dry { println(f"would run: {line}") }
}

// Pushes the tested commit; rejected, rebases once and pushes HEAD (the
// rebased commits are CI's to judge). Prints `PUSHED <sha8>`.
fn drive_push(sha: String) throws {
    let first = process::run("git", ["push", "origin", f"{sha}:develop"])
    let mut pushed = sha.clone()
    if !first.ok {
        // The shared checkout holds other agents' unfinished files and build locks:
        // they are stashed around the rebase, not a reason to stop (2026-10-28).
        let pulled = process::run("git", ["pull", "--rebase", "--autostash", "origin", "develop"])
        if !pulled.ok { drive_escalate("push rejected, and git pull --rebase failed") }
        let second = process::run("git", ["push", "origin", "HEAD:develop"])
        if !second.ok { drive_escalate("push rejected after one rebase") }
        pushed = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
    }
    println(f"PUSHED {drive_short(pushed)}")
}

fn drive_short(sha: String) -> String throws {
    if sha.len() <= 8 { return sha }
    return sha.bytes[0..<8].text().clone()
}

fn drive_append(path: String, line: String) throws {
    let old = drive_read(path.clone())
    let mut text = old.clone()
    if text != "" && !text.ends_with("\n") { text = text + "\n" }
    fs::write(path, fs::Root::Anywhere, text + line + "\n")
}

// The last `n` lines of a text.
fn drive_tail(body: String, n: i64) -> String throws {
    let lines = body.trim_end().split("\n").collect()
    let mut from: i64 = 0
    if lines.len() > n { from = lines.len() - n }
    let mut out: Vec[String] = []
    for i in from..<lines.len() { out.push(lines[i].clone()) }
    return out.join("\n")
}

// What the QA agent reads: the suite's step lines and log tail, the unpushed
// commits, and the briefs and reports they came from.
fn drive_qa_input(dir: String, out: String, steps: String) throws {
    let mut lines: Vec[String] = []
    lines.push(f"The suite (scripts/gate.nika -- --all) is red: {steps}")
    lines.push("")
    lines.push("Step lines:")
    for l in out.split("\n") {
        for step in ["build ", "lower-std ", "fmt ", "clippy ", "pre-push ", "test ", "guards ", "Gate: "] {
            if l.starts_with(step) { lines.push(l.clone()) }
        }
    }
    lines.push("")
    lines.push(f"Last 200 lines of {dir}/suite.log:")
    lines.push(drive_tail(out, 200))
    lines.push("")
    lines.push("Unpushed commits (origin/develop..HEAD):")
    lines.push(process::run("git", ["log", "--format=%h %s", "origin/develop..HEAD"]).stdout.trim().clone())
    lines.push("")
    lines.push("Briefs and reports of the unpushed commits:")
    for b in drive_read(f"{dir}/unpushed.txt").split("\n") {
        let brief = b.trim().clone()
        if brief == "" { continue }
        lines.push(brief.clone())
        let stem = (brief.strip_suffix(".md") ?? "").clone()
        for r in [f"{brief}.report.md", f"{stem}.report.md"] {
            if r != ".report.md" && fs::exists(r.clone(), fs::Root::Anywhere) { lines.push(r.clone()) }
        }
    }
    fs::write(f"{dir}/qa-input.txt", fs::Root::Anywhere, lines.join("\n") + "\n")
}

// The red steps of a gate run, "" when green.
fn drive_red_steps(out: String) -> String throws {
    for l in out.split("\n") {
        if l.starts_with("Gate: green") { return "" }
        if l.starts_with("Gate: red") { return (l.strip_prefix("Gate: red") ?? "").trim().clone() }
    }
    return "gate-error"
}

// After a run's commit: test the unpushed commits with the complete suite, push
// them when green, else let the QA agent fix forward (header comment).
fn drive_suite(exe: String, dry: bool, dir: String, brief: String) throws {
    let qa = "docs/briefs/qa-task.md"
    drive_say(dry, f"append {brief} to {dir}/unpushed.txt")
    drive_say(dry, "git fetch origin develop; git rev-list --count origin/develop..HEAD (0: nothing to test)")
    drive_say(dry, "mkdir target/suite.lock (wait while its owner's pid lives)")
    drive_say(dry, f"{exe} run scripts/gate.nika -- --all > {dir}/suite.log")
    drive_say(dry, f"green: git push origin <sha>:develop, empty {dir}/unpushed.txt")
    drive_say(dry, f"red: write {dir}/qa-input.txt, rm -f {qa}.report.md, {exe} run scripts/agent.nika -- {qa} --dir {dir}, commit its report, the suite again (at most 2 QA rounds)")
    drive_say(dry, "rm -rf target/suite.lock")
    if dry { return }
    drive_append(f"{dir}/unpushed.txt", brief.clone())
    process::run("git", ["fetch", "--quiet", "origin", "develop"])
    let count = process::run("git", ["rev-list", "--count", "origin/develop..HEAD"]).stdout.trim().clone()
    if count == "0" {
        fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, "")
        return
    }
    drive_lock(dir.clone())
    let mut rounds: i64 = 0
    while true {
        let sha = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
        let run = process::run(exe.clone(), ["run", "scripts/gate.nika", "--", "--all"])
        let out = run.stdout + run.stderr
        fs::write(f"{dir}/suite.log", fs::Root::Anywhere, out.clone())
        let steps = drive_red_steps(out.clone())
        if steps == "" {
            println(f"SUITE {drive_short(sha.clone())} green")
            drive_push(sha)
            fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, "")
            drive_unlock()
            return
        }
        println(f"SUITE {drive_short(sha)} red {steps}")
        if rounds >= 2 { drive_escalate(f"suite red after 2 QA rounds: {steps}") }
        drive_qa_input(dir.clone(), out, steps)
        process::run("rm", ["-f", f"{qa}.report.md"])
        drive_agent(exe.clone(), false, dir.clone(), qa.to_string(), "qa")
        rounds += 1
        drive_commit(false, dir.clone(), qa.to_string(), [])
        drive_tidy(false, dir.clone())
        drive_append(f"{dir}/unpushed.txt", qa.to_string())
    }
}

fn drive_commit(dry: bool, dir: String, brief: String, extra: Vec[String]) throws {
    let mut paths = drive_paths(dir, brief.clone())
    for i in 0..<extra.len() {
        if fs::exists(extra[i].clone(), fs::Root::Anywhere) { paths.push(extra[i].clone()) }
    }
    if paths.len() == 0 { return }
    let report_path = f"{brief}.report.md"
    if fs::exists(report_path.clone(), fs::Root::Anywhere) {
        let old = drive_read(report_path.clone())
        process::run("git", ["fetch", "--quiet", "origin", "develop"])
        let log = process::run("git", ["log", "-40", "--format=%h%x09%s", "HEAD", "origin/develop"]).stdout.clone()
        let fresh = drive_rewrite(old.clone(), log)
        if fresh != old {
            drive_say(dry, f"rewrite Pushed: in {report_path}")
            if !dry { fs::write(report_path.clone(), fs::Root::Anywhere, fresh) }
        }
    }
    let name = drive_stem(brief)
    let msg = f"briefs: {name} report"
    let trailer = "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01UVxJDveRM5qKZKyCqq6Y24"
    drive_say(dry, "git add " + paths.join(" "))
    drive_say(dry, f"git commit -m '{msg}' -m <Attribution> -- " + paths.join(" "))
    if dry { return }
    let mut add: Vec[String] = ["add"]
    for i in 0..<paths.len() { add.push(paths[i].clone()) }
    process::run("git", add)
    let mut status: Vec[String] = ["status", "--porcelain", "--"]
    for i in 0..<paths.len() { status.push(paths[i].clone()) }
    let changed = process::run("git", status).stdout.trim().clone()
    if changed == "" { return }
    let mut commit: Vec[String] = ["commit", "-m", msg, "-m", trailer, "--"]
    for i in 0..<paths.len() { commit.push(paths[i].clone()) }
    let made = process::run("git", commit)
    if !made.ok {
        let why = (made.stderr + made.stdout).trim().split("\n").collect()[0].clone()
        drive_escalate(f"git commit failed for {name}: {why}")
    }
}

// What a run leaves behind that no commit takes: the converter's lock file a
// build rewrote, and untracked step reports (`*.step<N>.report.md`) beside the
// briefs. Runs after the run's own commit, so nothing it commits is lost.
fn drive_tidy(dry: bool, dir: String) throws {
    drive_say(dry, "git checkout -- crates/rs2nika/convert/nikaia.lock")
    let left = process::run("git", ["ls-files", "--others", "--exclude-standard", "--", dir])
    let mut stray: Vec[String] = []
    for l in left.stdout.trim().split("\n") {
        if l.contains(".step") && l.ends_with(".report.md") { stray.push(l.clone()) }
    }
    if stray.len() > 0 { drive_say(dry, "rm -f " + stray.join(" ")) }
    if dry { return }
    process::run("git", ["checkout", "--", "crates/rs2nika/convert/nikaia.lock"])
    for i in 0..<stray.len() { process::run("rm", ["-f", stray[i].clone()]) }
}

// Runs one agent; prints `<role> done ...`; escalates on anything else.
fn drive_agent(exe: String, dry: bool, dir: String, brief: String, role: String) throws {
    drive_say(dry, f"{exe} run scripts/agent.nika -- {brief} --dir {dir}")
    if dry { return }
    let out = process::run(exe, ["run", "scripts/agent.nika", "--", brief.clone(), "--dir", dir.clone()])
    let mut done: String = ""
    let mut first: String = ""
    for l in out.stdout.trim().split("\n") {
        if first == "" { first = l.clone() }
        if l.starts_with("done ") { done = l.clone() }
    }
    if done == "" || !out.ok {
        if first == "" { first = f"agent.nika exited with code {out.code}" }
        drive_escalate(first)
    }
    println(f"{role} {done}")
}

fn drive_read(path: String) -> String throws {
    if !fs::exists(path.clone(), fs::Root::Anywhere) { return "" }
    return fs::read_to_string(path, fs::Root::Anywhere)
}

fn drive_cycle(exe: String, dir: String, lines_file: String) -> String throws {
    if lines_file != "" { return drive_read(lines_file) }
    let c = process::run(exe, ["run", "scripts/cycle.nika", "--", dir])
    if !c.ok { drive_escalate("cycle.nika failed") }
    return c.stdout.clone()
}

fn main() throws {
    let mut dir: String = ""
    let mut max: i64 = 8
    let mut dry = false
    let mut no_bump = false
    let mut lines_file: String = ""
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    let mut i = 1
    while i < args.len() {
        if args[i] == "--dry-run" {
            dry = true
        } else if args[i] == "--no-bump" {
            no_bump = true
        } else if args[i] == "--max" && i + 1 < args.len() {
            max = text::parse_i64(args[i + 1].clone()) ?? 8
            i += 1
        } else if args[i] == "--lines" && i + 1 < args.len() {
            lines_file = args[i + 1].clone()
            dry = true
            i += 1
        } else {
            dir = args[i].clone()
        }
        i += 1
    }
    if dir == "" {
        println("usage: nikaia run scripts/drive.nika -- DIR [--max N] [--no-bump] [--dry-run] [--lines FILE]")
        process::exit(2)
    }
    if args.len() == 4 && args[1] == "--rewrite" {
        println(drive_rewrite(drive_read(args[2].clone()), drive_read(args[3].clone())))
        return
    }
    if args.len() == 3 && args[1] == "--kept" {
        let why = drive_kept(drive_read(args[2].clone()))
        if why == "" { println("ok") } else { println(f"CONVERT drive: {why}") }
        return
    }
    if args.len() == 3 && args[1] == "--changed" {
        if drive_read(args[2].clone()) != drive_read("scripts/drive.nika") {
            println("RESTART drive: scripts/drive.nika changed")
        } else {
            println("same")
        }
        return
    }
    let exe = drive_exe()
    if exe == "" {
        println("BUILD cargo build --profile fast -p nikaia")
        process::exit(1)
    }
    let task = f"{dir}/architect-task.md"
    let mut runs: i64 = 0
    let mut bumps: i64 = 0
    let mut red_seen: String = ""
    let mut last_stop: String = ""
    let own = drive_read("scripts/drive.nika")
    while runs <= max {
        if !dry && drive_read("scripts/drive.nika") != own {
            println("RESTART drive: scripts/drive.nika changed")
            process::exit(3)
        }
        let cyc = drive_cycle(exe.clone(), dir.clone(), lines_file.clone())
        let mut lines: Vec[String] = []
        for l in cyc.trim().split("\n") {
            if l.trim() != "" && !(no_bump && l.trim().starts_with("BUMP")) { lines.push(l.trim().clone()) }
        }
        if lines.len() == 0 { drive_escalate("cycle.nika printed nothing") }
        let action = drive_action(lines.clone(), red_seen.clone(), last_stop.clone())
        if action.starts_with("ESCALATE ") {
            println(f"ESCALATE {(action.strip_prefix("ESCALATE ") ?? "").clone()}")
            process::exit(2)
        }
        if action == "BUMP" {
            bumps += 1
            if bumps > 3 { drive_escalate("BUMP pending persists after --apply") }
            drive_say(dry, f"{exe} run scripts/cycle.nika -- {dir} --apply")
            if dry {
                println("DRY-RUN BUMP")
                return
            }
            let rel = process::run(exe.clone(), ["run", "scripts/cycle.nika", "--", dir.clone(), "--apply"])
            if rel.stdout.contains("PUSH REJECTED") { drive_escalate("bump push rejected") }
            continue
        }
        if runs >= max { drive_escalate(f"--max {max} agent runs reached") }
        if action.starts_with("NEXT ") {
            let brief = (action.strip_prefix("NEXT ") ?? "").clone()
            drive_agent(exe.clone(), dry, dir.clone(), brief.clone(), "builder")
            runs += 1
            drive_commit(dry, dir.clone(), brief.clone(), [])
            drive_tidy(dry, dir.clone())
            drive_suite(exe.clone(), dry, dir.clone(), brief.clone())
            if !dry {
                let why = drive_kept(drive_read(f"{brief}.report.md"))
                if why != "" { println(f"CONVERT drive: {drive_stem(brief.clone())}: {why}") }
            }
            if dry {
                println(f"DRY-RUN NEXT {drive_stem(action.clone())}")
                return
            }
            continue
        }
        // RED or ARCHITECT: the stop line goes to the architect.
        let mut stop = (action.strip_prefix("ARCHITECT ") ?? "").clone()
        let mut input: String = stop.clone() + "\n"
        if action.starts_with("RED ") {
            stop = (action.strip_prefix("RED ") ?? "").clone()
            let sha = stop.split(" ").collect()[1].clone()
            red_seen = red_seen + f" {sha} "
            input = f"{stop}\nThe failing jobs are named in the line above; fix forward or revert.\n"
        }
        drive_say(dry, f"write {dir}/architect-input.txt: {stop}")
        drive_say(dry, f"rm -f {task}.report.md")
        if !dry {
            fs::write(f"{dir}/architect-input.txt", fs::Root::Anywhere, input)
            process::run("rm", ["-f", f"{task}.report.md"])
        }
        drive_agent(exe.clone(), dry, dir.clone(), task.clone(), "architect")
        runs += 1
        // architect-input.txt is session state (.gitignore), never committed.
        let extra: Vec[String] = []
        drive_commit(dry, dir.clone(), task.clone(), extra)
        drive_tidy(dry, dir.clone())
        drive_suite(exe.clone(), dry, dir.clone(), task.clone())
        if dry {
            println(f"DRY-RUN ARCHITECT {stop}")
            return
        }
        let report = drive_read(f"{task}.report.md")
        if report == "" { drive_escalate("the architect wrote no report") }
        let result = drive_word(drive_field(report.clone(), "Result"))
        let owner = drive_field(report.clone(), "Owner")
        if result != "done" { drive_escalate(f"architect Result: {result}") }
        if owner != "none" && owner != "" { drive_escalate(f"architect Owner: {owner}") }
        last_stop = stop
    }
}
