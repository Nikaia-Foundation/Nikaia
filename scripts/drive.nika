// One driver for a whole batch: the builders of the briefs the supervisor
// writes, until an escalation.
//
//     nikaia run scripts/drive.nika -- DIR [--max N] [--no-bump] [--ignore-ci-red] [--dry-run] [--lines FILE]
//     nikaia run scripts/drive.nika -- --focus [--max N] [--ignore-ci-red] [--dry-run]
//
// `--focus` (owner, 2026-11-01) rotates through the areas of
// docs/briefs/focus.txt (`block N`, `area NAME DIR [ISSUE]` lines, ISSUE the
// lane's issue, `current NAME COUNT`): up to `block` builder briefs of the
// current area, then the block ends (also on BATCH DONE): the suite, the
// block's line (`drive_focus_line`) as a comment on the lane issue (#1252;
// without one only in the output), a pending bump of each area's DIR while CI is green,
// the next area, focus.txt written (not committed). CUT and RED stop for the supervisor as
// in single-DIR mode (a report's `Found:` does not cut: it goes to DIR/found.txt,
// `drive_found`); an area entered with an empty queue is skipped (`FOCUS
// <area> empty, skipped`); every area empty escalates. Before each cycle the open
// issues labelled `ready` and the area's name, without `wip`, are appended to
// DIR/batch.txt as `#N` (`QUEUED #N <area>`, drive_queue). A run on issue N
// sets `wip` on it first and, by its report, keeps it (done, `Fixes:` names
// #N; promote closes the issue), swaps `ready` for `blocked` (blocked), or
// removes it (anything else), drive_wip_after; an escalation mid-run leaves
// `wip` for the supervisor to clear. At a block's end the debriefs'
// `Fact:` lines go into the facts files (`facts-collect.nika -- --apply`,
// committed as docs, `FACTS <n> entered`). Before a block, the first unrun
// docs/briefs/bugs brief with a `Blocks:` line runs first. Test flags:
// `--focus-next FILE [SKIPPED...]`, `--focus-log DIR AREA BRIEF...` (the
// block's comment), `--focus-issue FILE NAME|DIR...`, `--blocks DIR`,
// `--found DIR BRIEF` (drive_found), `--queue-add BATCH N...` (drive_queue_add),
// `--wip-after RESULT FIXES N`, `--found-issue NAME N FOUND NEEDS`.
//
// Loops on `cycle.nika -- DIR` and acts on its lines, one agent at a time;
// before each cycle the area's ready issues (the area being DIR's last name)
// are queued as in --focus (drive_queue):
//
//     NEXT <brief> ...            the brief posted on its issue (once, the
//                                 marker <brief>.posted), agent.nika --
//                                 <brief> --dir DIR; the run's files stay
//                                 untracked; the run posted on its issue
//                                 (drive_post_run: result, tokens, cost,
//                                 time, turns, report, debrief; a brief
//                                 without an issue on its area's lane
//                                 issue); no suite until the batch ends;
//                                 a report's `Found:` appended to
//                                 DIR/found.txt and printed as `FOUND
//                                 <brief>: Found: ...`, then filed as an
//                                 issue (`ready` or `decision`, the area;
//                                 `FILED #N <brief>`, drive_found_file),
//                                 the batch goes on
//     BUMP pending, CI green      cycle.nika -- DIR --apply
//     CUT, RED, BATCH DONE        the batch's suite runs and is waited for,
//                                 then the driver stops for the supervisor
//                                 (`ESCALATE <stop line>: the supervisor
//                                 writes the next briefs`, exit 2); the
//                                 supervisor writes the briefs (a fix-forward
//                                 for RED) and starts the driver again
//
// Output: one line per agent run (`builder done ...`).
// Escalation: one final line, exit 2, on an OWNER line, an ESCALATE of
// agent.nika, a stop line (above), `--max` agent runs (default 8), a merge
// conflict on a rejected push, a suite still red after 2 QA rounds. A RED line
// with a builder queued goes on with it (the supervisor's fix-forward brief).
//
// `--ignore-ci-red`: a RED line of the cycle (CI red on develop) does not
// stop the driver; NEXT and BATCH DONE go on as if CI were green, and a BUMP
// still waits for green CI (a lane whose pushes its own suite gates does not
// fix other lanes' reds; the main lane runs without it).
//
// **Builders commit, the driver tests and pushes** (owner, 2026-10-31: once
// per batch). The driver commits nothing under docs/briefs/ (#1252): briefs,
// reports, run files and focus.txt stay untracked working
// files beside the tree. After each builder run, the
// run's brief is appended to DIR/unpushed.txt (one brief path a line). The
// builders of a batch run one after the other with no suite between them. When
// the batch ends (CUT, RED or BATCH DONE) the suite starts on HEAD in the
// background (`drive_suite`) and the next builders go on meanwhile (owner,
// 2026-11-06); a suite that has finished is handled before the next builder
// (`drive_suite_done`). Before a bump, the next suite, or the end of the run
// (an escalation and a RESTART too) the driver waits for it (`drive_settle`:
// one line `SUITE <sha8> waiting`, a poll every 10 s) and handles its result.
// Green pushes the tested sha; when that push is rejected and HEAD has moved
// on, nothing is pushed and the next suite, on HEAD, pushes all. When `git rev-list --count origin/develop..HEAD` is 0
// after a fetch, there is nothing to test (unpushed.txt is emptied). When every
// path those commits touch (`git log --format= --name-only origin/develop..HEAD`)
// is documentation by the rule of scripts/ci-changes.sh (`drive_docs_path`: CI
// skips its build and test jobs for them too), HEAD is pushed as on green
// without a suite, `SUITE <sha8> docs-only, pushed without the suite`, and
// unpushed.txt is emptied. `--docs-only FILE` prints `docs`/`code` for each
// path in FILE and `docs-only` or `suite` (for tests).
// Before a suite is pushed to its `ci/` branch, the tests named after the
// changed scripts run here (owner, 2026-11-06; drive_named_filters,
// `LOCAL tests ...`): red writes `Gate: red local-tests` and their output to
// the suite log and goes to QA without a CI round; `--named-filters FILE`
// prints the filters for the paths in FILE (for tests). Else the driver
// takes the checkout's suite lock, `mkdir target/suite.lock` with
// `<pid> <DIR>` in target/suite.lock/owner: two drivers (the main lane and the
// bug lane) share this checkout, so one waits in 60 s steps while the owner's
// pid lives; a dead owner's lock is taken over. Once it has the lock, and
// before each suite run, it fetches and counts again: the other lane's push
// often already holds these commits, and then it prints `SUITE nothing new
// after the lock`, empties unpushed.txt and releases the lock. The lock is held
// through the whole red -> QA -> suite loop (one QA at a time in the
// checkout) and released on every path, an escalation
// too. It notes the tested sha and has CI run the suite (owner, 2026-11-01):
// `git push --force origin <sha>:refs/heads/ci/<lane>`, the last part of the
// lane's DIR (ci/briefs for docs/briefs/), runs the whole workflow nikaia.yml
// on exactly the tested commit, never the shared checkout's unfinished files,
// and nothing of it on this machine's small disk. A rejected push escalates,
// the lock released and the commits left local. Then, detached from the driver
// (`sh -c '( ... ) &'`), `<exe> run scripts/drive.nika -- --ci-wait <sha>
// DIR/suite.log target/suite.lock/exit-<sha>` waits for that run: `gh api
// repos/.../actions/runs?head_sha=<sha>` every 30 s, the workflow Nikaia on a
// ci/ branch; success writes `Gate: green`, any other conclusion `Gate: red
// <failed jobs>` (spaces as `_`) and each failed job's last 200 log lines, at
// the first failed job already (the run then cancelled: owner, 2026-11-06); no
// run after 15 minutes is `Gate: red ci-no-run`, none finished after 3 hours
// `Gate: red ci-timeout`. Its output goes to DIR/suite.log of the shared
// checkout (overwritten), its exit status to target/suite.lock/exit-<sha>, and
// target/suite.lock/testing notes `<sha> <N>`, N the lines of unpushed.txt the
// tested sha covers; the driver prints `SUITE <sha8> started on CI (<branch>)`,
// and when it has waited, `SUITE <sha8> green|red <steps>`. A develop push of a
// sha CI already passed on a ci/ branch skips the heavy jobs (nikaia.yml).
// Green: `git push origin <sha>:develop`, exactly the tested commit; when
// rejected (other sessions push too), `git merge --autostash` of
// `origin/develop`, the short checks on the merge (`MERGE <sha8> short checks`:
// the compiler built, the tests named after the changed scripts and the changed
// tests) and push exactly the merge commit (a merge, not a rebase, 2026-11-05: a
// rebase replays the tested commits). Short checks red, or rejected again:
// nothing pushed, the merge stays in HEAD and the next suite tests it. A conflicted merge is never left open in the shared checkout (2026-10-31: both
// lanes write docs/briefs/, and the checkout stayed mid-rebase until fixed by
// hand): the conflicted paths are noted, `git merge --abort` (HEAD and the
// autostash restored), and `ESCALATE drive: push rejected, merge conflicted in
// <paths>, merge aborted`; an abort that fails, or leaves a merge or an
// unmerged path, escalates with `merge left open: ...`. A conflict only in the
// generated `crates/nikaia-std/src/tools/lowered/*.rs` is resolved by
// re-lowering instead (#1430, drive_merge_relower: their side, `lower-std` and
// the build until the lowered files settle, `MERGE <sha8> re-lowered <paths>`),
// then the short checks as for a clean merge. Then it prints
// `PUSHED <sha8>` and drops the N tested lines from unpushed.txt (after a
// merged push of HEAD it empties the file). Red: DIR/qa-input.txt gets the
// suite's step lines, the whole suite.log (the failed jobs' log tails), `git log
// origin/develop..HEAD`, and the brief and report of each brief in
// unpushed.txt; the QA agent runs (role `qa`) on DIR/qa/qa-task.md, a copy of
// the template docs/qa-task.md made before each run (its report path
// made the copy's), in the shared checkout; the copy, its report and run files
// stay untracked, and the suite runs
// again on the new HEAD, on CI the same way, and is waited for at
// once (the next batch starts only on green). At most 2 QA
// rounds: a third red prints `ESCALATE drive: suite red after 2 QA rounds:
// <steps>` and leaves the commits local. Nothing else pushes.
// `--no-bump` leaves the version raise to another driver: a second lane in the
// same session (`docs/briefs/bugs`) runs with it, so only the main lane's
// driver raises the version and two raises never meet in `CHANGELOG.md`.
// `--dry-run` runs one step of the loop and prints the commands it would run
// and the final line `DRY-RUN <action>`; `--lines FILE` takes the cycle's
// output from FILE instead of running `cycle.nika` (for tests).
// A builder's `Pushed: rejected` (or `none`) is rewritten when its commit is found in the log.
// `--rewrite REPORT LOGFILE` prints the rewritten report (for tests).
// `--issue NAME...` prints each brief's issue number (drive_issue) or `none`;
// `--post-body BRIEF` prints the comment that posts BRIEF, `--run-body DIR
// BRIEF` the comment of BRIEF's run from its files in DIR (for tests).
// `nikaia run` compiles this script once, so a commit to it does nothing until a
// restart: at the top of each round of a real run the driver reads
// scripts/drive.nika again, and if it changed since the start it prints the one
// line `RESTART drive: scripts/drive.nika changed`, releases the suite lock and
// runs itself again with the same arguments, its output going where this run's
// goes, and ends with that run's exit code (drive_restart); exit 3 is left only
// where the new run cannot be started. `--changed OLDFILE` prints that line or
// `same` (for tests).
// The scripts are run as programs: a script cannot `use` another.

use std::cli
use std::env
use std::fs
use std::process
use std::text

fn drive_exe() -> String throws {
	for exe in ["target/fast/nikaia", "target/release/nikaia"] {
		if fs::exists(exe, fs::Root::Anywhere) { return exe.clone() }
	}
	return ""
}

// Ends the run with exit 2; a suite still running is waited for and handled
// first (drive_settle), with one line naming the escalation it delays.
fn drive_escalate(why: String) throws {
	let lane = drive_lock_lane()
	if lane != "" && drive_testing() != "" {
		println(f"SUITE before escalating: {why}")
		let exe = drive_exe()
		drive_settle(exe.clone(), lane)
	}
	drive_unlock()
	println(f"ESCALATE drive: {why}")
	process::exit(2)
}

// After a change to scripts/drive.nika: compiles and runs the new script with
// the same arguments, its output inherited, and ends with its exit code. The lock is released first,
// or the new run would wait on this one. Exit 3 where it cannot be started.
fn drive_restart(exe: String) throws {
	println("RESTART drive: scripts/drive.nika changed")
	drive_unlock()
	let mut args: Vec[String] = []
	for a in cli::args() { args.push(a) }
	let mut again: Vec[String] = ["run", "scripts/drive.nika", "--"]
	let mut i = 1
	while i < args.len() {
		again.push(args[i].clone())
		i += 1
	}
	let ran = process::run(exe, again; stdout: process::Stream::Inherited, stderr: process::Stream::Inherited)
	if ran.code < 0 { process::exit(3) }
	process::exit(ran.code)
}

// The suite lock of this checkout (drive_suite).
fn drive_lock_dir() -> String {
	return "target/suite.lock"
}

// This driver's pid: the parent of the shell it starts.
fn drive_pid() -> String throws {
	return process::run("sh", ["-c", "echo $PPID"]).stdout.trim().clone()
}

// Releases the suite lock if this driver holds it; every exit path calls it.
fn drive_unlock() throws {
	let owner = drive_read(drive_lock_dir() + "/owner")
	if owner == "" { return }
	if owner.split(" ").collect()[0].trim()
		== drive_pid() { process::run("rm", ["-rf", drive_lock_dir()]) }
}
fn drive_silence_stop_hook() throws {
	let home = env::var("HOME") ?? ""
	if home == "" { return }
	let hook = f"{home}/.claude/stop-hook-git-check.sh"
	if drive_read(hook) != "" { fs::write(hook, fs::Root::Anywhere, "") }
}
// Takes the suite lock: waits in 60 s steps while another live driver holds
// it, takes over a dead one's. An owner file not yet written counts as live
// for two steps.
fn drive_lock(dir: String) throws {
	let me = drive_pid()
	let mut blank: i64 = 0
	let mut said = false
	while true {
		process::run("mkdir", ["-p", "target"])
		if process::run("mkdir", [drive_lock_dir()]).ok {
			fs::write(drive_lock_dir() + "/owner", fs::Root::Anywhere, f"{me} {dir}\n")
			return
		}
		let owner = drive_read(drive_lock_dir() + "/owner").trim()
		let pid = owner.split(" ").collect()[0]
		if pid == "" { blank += 1 }
		let live = if pid == "" { blank <= 2 } else { process::run("kill", ["-0", pid.clone()]).ok }
		if !live {
			process::run("rm", ["-rf", drive_lock_dir()])
			continue
		}
		if !said {
			println(f"SUITE waiting for target/suite.lock: {owner}")
			said = true
		}
		process::run("sleep", ["60"])
	}
}

// The brief's name: the last path component without `.md`.
fn drive_stem(path: String) -> String throws {
	let parts = path.split("/").collect()
	let last = parts[parts.len() - 1]
	return last.replace(".md", "")
}

// The first word of the value after `key:` in a report, "" if absent.
fn drive_field(body: String, key: String) -> String {
	let prefix = key + ":"
	for line in body.split("\n") {
		let t = line.trim()
		if t.starts_with(prefix) { return (t.strip_prefix(prefix) ?? "").trim().clone() }
	}
	return ""
}

fn drive_word(value: String) -> String {
	return value.split(" ").collect()[0].replace(".", "")
}

// Which action a cycle's output leads to, as one line:
//   ESCALATE <why> | STOP <line> | BUMP | NEXT <abs brief>
// STOP (CUT, BATCH DONE, or RED with no builder queued): the driver stops for
// the supervisor, who writes the next briefs. A RED with a builder queued goes
// on with it (the supervisor's fix-forward brief).
// `ignore_red` (--ignore-ci-red): a RED line leads nowhere; NEXT and BATCH DONE
// go on as if CI were green, and BUMP still waits for a green CI line.
fn drive_action(lines: Vec[String], ignore_red: bool) -> String {
	let mut ci: String = ""
	let mut red: String = ""
	let mut batch: String = ""
	let mut bump: String = ""
	for i in 0..<lines.len() {
		let l = lines[i].trim()
		if l.starts_with("OWNER ") { return f"ESCALATE {l}" }
		if l.starts_with("CI ") { ci = l }
		if l.starts_with("RED ") { red = l }
		if l.starts_with("NEXT ") || l.starts_with("CUT") || l.starts_with("BATCH") { batch = l }
		if l.starts_with("BUMP pending") { bump = l }
	}
	if red != "" && !ignore_red && !batch.starts_with("NEXT ") { return f"STOP {red}" }
	if bump != "" && ci.ends_with("green") && !batch.starts_with("NEXT ") { return "BUMP" }
	if batch.starts_with("NEXT ") { return f"NEXT {batch.split(" ").collect()[1]}" }
	if batch.starts_with("CUT") || batch.starts_with("BATCH DONE") { return f"STOP {batch}" }
	return f"ESCALATE no action for: {batch}"
}

// The report with `Pushed:` rewritten when `Result: done`, `Pushed:` is
// `rejected` or `none`, and a log line `<sha>\t<subject>` has the report's
// `Commit:` as its subject; else the report as it is. The log is the last 40
// commits of both `HEAD` and `origin/develop` (drive_report_pushed), so a commit
// already on `origin/develop` is found too.
fn drive_rewrite(report: String, log: String) -> String {
	if drive_word(drive_field(report, "Result")) != "done" { return report }
	let pushed = drive_word(drive_field(report, "Pushed"))
	if pushed != "rejected" && pushed != "none" { return report }
	let subject = drive_field(report, "Commit")
	if subject == "" { return report }
	let mut sha: String = ""
	for l in log.split("\n") {
		let parts = l.split("\t").collect()
		if sha == "" && parts.len() == 2 && parts[1].trim() == subject { sha = parts[0].trim() }
	}
	if sha == "" { return report }
	let mut out: Vec[String] = []
	let mut done = false
	for l in report.split("\n") {
		if !done && l.trim().starts_with("Pushed:") {
			out.push(f"Pushed: {sha} (pushed by drive.nika)")
			done = true
		} else {
			out.push(l)
		}
	}
	return out.join("\n")
}

fn drive_say(dry: bool, line: String) throws {
	if dry { println(f"would run: {line}") }
}

// Pushes the tested commit; rejected, merges `origin/develop` once, runs the
// short checks on the merge (drive_merge_check: two lanes each green alone can
// be red together, and develop went red for hours that way on 2026-11-08) and
// pushes exactly the merge commit only when they pass (a merge, not a rebase: a
// rebase replays the tested commits and, on 2026-11-05, deleted every brief a
// replayed commit had untracked). Red, or rejected again: nothing is pushed,
// the merge stays in HEAD and the next suite tests it on CI ("none"). Prints
// `PUSHED <sha8>`. "head" when the merge was pushed, "sha" when exactly `sha`. When HEAD has moved past `sha` (builders
// went on while CI ran, owner 2026-11-06), a rejected push merges nothing: a
// merge would push HEAD's untested commits; "none", and the next suite, on
// HEAD, pushes them all.
fn drive_push(sha: String) -> String throws {
	let first = process::run("git", ["push", "origin", f"{sha}:develop"])
	let mut pushed = sha.clone()
	let mut head = "sha"
	if !first.ok {
		let now = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
		if now != sha {
			println(f"SUITE {drive_short(sha)} green, push rejected and HEAD moved on: the next suite pushes")
			return "none"
		}
		// The shared checkout holds other agents' unfinished files and build locks:
		// they are stashed around the merge, not a reason to stop (2026-10-28).
		let fetched = process::run("git", ["fetch", "-q", "origin", "develop"])
		if !fetched.ok { drive_escalate("push rejected, and git fetch origin develop failed") }
		let base = process::run("git", ["merge-base", sha.clone(), "FETCH_HEAD"]).stdout.trim().clone()
		let exe = process::run("realpath", [drive_exe()]).stdout.trim().clone()
		drive_merge_fetched(f"'{exe}' lower-std", "cargo build -q --profile fast -p nikaia")
		let merge = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
		let failed = drive_merge_check(base, merge.clone())
		if failed != "" {
			println(f"SUITE {drive_short(sha)} green, merged with origin/develop red in the short checks: not pushed, the next suite tests the merge")
			println(drive_tail(failed, 40))
			return "none"
		}
		let second = process::run("git", ["push", "origin", f"{merge}:develop"])
		if !second.ok {
			println(f"SUITE {drive_short(sha)} green, push rejected again after the merge: the next suite pushes")
			return "none"
		}
		pushed = merge.clone()
		// Builders went on during the checks: their commits stay in unpushed.txt.
		let now = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
		head = if now == merge { "head" } else { "sha" }
	}
	println(f"PUSHED {drive_short(pushed)}")
	return head
}

// The short checks on a merge of `origin/develop` before it is pushed (owner,
// 2026-11-08): the compiler built from the merged tree (the lowered `.rs` of
// both sides meet rustc here), then the tests named after the scripts changed
// on either side since BASE and the tests changed themselves. Red: the output,
// else "".
fn drive_merge_check(base: String, merge: String) -> String throws {
	println(f"MERGE {drive_short(merge.clone())} short checks")
	let built = process::run("sh", ["-c", "cargo build -q --profile fast -p nikaia 2>&1"])
	if !built.ok { return "cargo build --profile fast -p nikaia\n" + built.stdout + built.stderr }
	let mut paths: Vec[String] = []
	let diff = process::run("git", ["diff", "--name-only", base, merge.clone()]).stdout
	for line in diff.split("\n") {
		let p = line.trim().clone()
		if p != "" { paths.push(p) }
	}
	let failed = drive_local_tests(paths.clone())
	if failed != "" { return failed }
	let mut names: Vec[String] = []
	for p in paths {
		if !p.starts_with("tests/compiler/tests/") { continue }
		let file = p.split("/").collect()[3].clone()
		let name = file.split(".").collect()[0].clone()
		if name != "" && !names.contains(name.clone()) { names.push(name) }
	}
	if names.len() == 0 { return "" }
	let exe = process::run("realpath", [drive_exe()]).stdout.trim().clone()
	let mut args: String = ""
	for n in names.clone() { args = args + f" --filter '{n}'" }
	println(f"LOCAL tests {names.join(" ")}")
	let out = process::run(
		"sh",
		["-c", f"cd tests/compiler && NIKAIA_CACHE_LIMIT=2G '{exe}' test{args} 2>&1"],
	)
	if out.ok { return "" }
	return out.stdout + out.stderr
}

// True when this driver's background suite has finished (its exit file is
// there): drive_settle then handles it without waiting.
fn drive_suite_done() -> bool throws {
	let testing = drive_testing()
	if testing == "" { return false }
	let sha = testing.split(" ").collect()[0].clone()
	return fs::exists(f"{drive_lock_dir()}/exit-{sha}", fs::Root::Anywhere)
}

// Merges FETCH_HEAD into HEAD (`--autostash`: the other agents' unfinished
// files are stashed around it). A conflict only in the generated lowered
// files is resolved by drive_merge_relower with the commands LOWER and BUILD;
// any other conflict, or a failed resolution, aborts and escalates.
fn drive_merge_fetched(lower: String, build: String) throws {
	let merged = process::run("git", ["merge", "-q", "--no-edit", "--autostash", "FETCH_HEAD"])
	if merged.ok { return }
	let unmerged = process::run(
		"git",
		["diff", "--name-only", "--diff-filter=U"],
	).stdout.trim().split("\n").collect().join(" ")
	if unmerged == "" { drive_merge_abort() }
	for p in unmerged.split(" ") {
		if !p.starts_with(drive_lowered_dir() + "/") { drive_merge_abort() }
	}
	drive_merge_relower(unmerged, lower, build)
}

fn drive_lowered_dir() -> String {
	return "crates/nikaia-std/src/tools/lowered"
}

// The lowered files the lowering writes: the directory and its index.
fn drive_lowered_paths() -> Vec[String] {
	return [drive_lowered_dir(), drive_lowered_dir() + ".rs"]
}

// The paths under the lowered files that differ from the index or are new,
// one per line (`git status --porcelain`, the path after the status).
fn drive_lowered_status() -> String throws {
	let mut args: Vec[String] = ["status", "--porcelain", "--untracked-files=all", "--"]
	for p in drive_lowered_paths() { args.push(p) }
	return process::run("git", args).stdout
}

// A fingerprint of the lowered files' contents, to see the lowering settle.
fn drive_lowered_print() -> String throws {
	let dirs = drive_lowered_paths().join(" ")
	return process::run(
		"sh",
		["-c", f"find {dirs} -type f | sort | xargs sha256sum | sha256sum"],
	).stdout.trim().clone()
}

// A merge that conflicted only in the generated lowered files (#1430): they
// are output of `lower-std`, so the conflict has one mechanical resolution.
// Takes their side of each conflicted file, runs LOWER (the driver's binary
// from before the merge first: the side taken never has to pass rustc; when
// it cannot lower the merged sources, BUILD and LOWER again), then BUILD and
// LOWER until the lowered files stop changing (the old binary emits with the
// old emitter, 2026-11-08: one round reverted unrelated files), adds the
// changed lowered paths and nothing else, and commits the merge (the autostash
// is applied after that commit). Prints `MERGE <sha8> re-lowered <paths>`. Any
// failure aborts the merge and escalates (drive_merge_abort_paths): a partly
// resolved merge is never left behind.
fn drive_merge_relower(unmerged: String, lower: String, build: String) throws {
	// Lowered files already untracked before the merge are not ours to add.
	let mut before: Vec[String] = []
	for line in drive_lowered_status().split("\n") {
		if line.starts_with("?? ") { before.push(line.trim().clone()) }
	}
	let mut failed: String = ""
	for p in unmerged.split(" ") {
		if failed != "" { break }
		let took = process::run("git", ["checkout", "--theirs", "--", p.clone()])
		if !took.ok { failed = f"git checkout --theirs {p}" }
	}
	if failed == "" {
		let first = process::run("sh", ["-c", f"{lower} 2>&1"])
		if !first.ok {
			let built = process::run("sh", ["-c", f"{build} 2>&1"])
			if !built.ok { failed = "the build before lowering" } else {
				let again = process::run("sh", ["-c", f"{lower} 2>&1"])
				if !again.ok { failed = "lower-std" }
			}
		}
	}
	let mut rounds = 0
	let mut settled = false
	while failed == "" && !settled {
		if rounds == 5 {
			failed = "lower-std did not settle after 5 rounds"
			break
		}
		rounds += 1
		let built = process::run("sh", ["-c", f"{build} 2>&1"])
		if !built.ok {
			failed = "the build of the re-lowered files"
			break
		}
		let old = drive_lowered_print()
		let lowered = process::run("sh", ["-c", f"{lower} 2>&1"])
		if !lowered.ok {
			failed = "lower-std"
			break
		}
		settled = drive_lowered_print() == old
	}
	// Every changed lowered path is staged, also on failure: `git merge
	// --abort` then resets them with the merge.
	let mut add: Vec[String] = ["add", "--"]
	for line in drive_lowered_status().split("\n") {
		let l = line.trim()
		if l == "" || before.contains(l.clone()) { continue }
		let words = l.split(" ").collect()
		add.push(words[words.len() - 1].clone())
	}
	for p in unmerged.split(" ") { add.push(p.clone()) }
	let added = process::run("git", add)
	if failed == "" && !added.ok { failed = "git add of the lowered files" }
	if failed != "" { drive_merge_abort_paths(unmerged, f"re-lowering failed ({failed})") }
	let done = process::run("git", ["commit", "-q", "--no-edit"])
	if !done.ok { drive_merge_abort_paths(unmerged, "the merge commit failed") }
	let merge = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
	println(f"MERGE {drive_short(merge)} re-lowered {unmerged}")
}

// A failed merge must not leave the shared checkout mid-merge: the conflicted
// paths are noted, `git merge --abort` restores HEAD and applies the autostash
// back, and the check that no merge is left open and no path is unmerged
// precedes the escalation. Always escalates.
fn drive_merge_abort() throws {
	let unmerged = process::run(
		"git",
		["diff", "--name-only", "--diff-filter=U"],
	).stdout.trim().split("\n").collect().join(" ")
	let paths = if unmerged == "" { "no unmerged path" } else { unmerged }
	drive_merge_abort_paths(paths, "")
}

// drive_merge_abort for PATHS noted before; WHY, when not "", says what
// failed after the conflict (a re-lowering, #1430).
fn drive_merge_abort_paths(paths: String, why_failed: String) throws {
	let failed = if why_failed == "" { "" } else { f", {why_failed}" }
	let git_dir = process::run("git", ["rev-parse", "--git-dir"]).stdout.trim().clone()
	let mut why: String = ""
	let mut aborted = true
	if fs::exists(f"{git_dir}/MERGE_HEAD", fs::Root::Anywhere) {
		let abort = process::run("git", ["merge", "--abort"])
		aborted = abort.ok
		why = (abort.stderr + abort.stdout).trim().split("\n").collect()[0].clone()
	}
	let open = fs::exists(f"{git_dir}/MERGE_HEAD", fs::Root::Anywhere)
	let left = process::run("git", ["diff", "--name-only", "--diff-filter=U"]).stdout.trim().clone()
	if !aborted || open || left != "" {
		drive_escalate(f"merge left open: push rejected, merge conflicted in {paths}{failed}, and git merge --abort did not finish ({why}); the shared checkout needs a hand now")
	}
	drive_escalate(f"push rejected, merge conflicted in {paths}{failed}, merge aborted")
}

fn drive_short(sha: String) -> String throws {
	if sha.len() <= 8 { return sha }
	return sha.bytes[0..<8].text().clone()
}

fn drive_append(path: String, line: String) throws {
	let old = drive_read(path)
	let mut text = old
	if text != "" && !text.ends_with("\n") { text = text + "\n" }
	fs::write(path, fs::Root::Anywhere, text + line + "\n")
}

// The last `n` lines of a text.
fn drive_tail(body: String, n: i64) -> String throws {
	let lines = body.trim_end().split("\n").collect()
	let mut from: i64 = 0
	if lines.len() > n { from = lines.len() - n }
	let mut out: Vec[String] = []
	for i in from..<lines.len() { out.push(lines[i]) }
	return out.join("\n")
}

// The lines of a job log that say what failed, wherever they stand: a long
// test step writes its failures in the middle, and the tail does not hold
// them. At most `n` lines.
fn drive_failures(body: String, n: i64) -> String throws {
	let mut out: Vec[String] = []
	for raw in body.split("\n") {
		if out.len() >= n { break }
		let l = raw.trim_end()
		if l.contains(" FAILED")
			|| l.contains("panicked at")
			|| l.contains("error[")
			|| l.contains("error: ")
			|| l.contains("fails its own tests")
			|| l.contains(" type error")
			|| l.contains(" ---- ") {
				out.push(l)
			}
	}
	return out.join("\n")
}

// What the QA agent reads: the CI run's step lines and suite.log (the failed
// jobs' log tails), the unpushed commits, and the briefs and reports of the
// batch, found from DIR/unpushed.txt among the working files (they are never committed).
fn drive_qa_input(dir: String, out: String, steps: String) throws {
	let mut lines: Vec[String] = []
	lines.push(f"The suite (the CI run on {drive_ci_branch(dir)}, the whole workflow) is red: {steps}")
	lines.push("")
	lines.push("Step lines:")
	for l in out.split("\n") {
		for step in ["CI run ", "no CI run ", "the CI run ", "Gate: "] {
			if l.starts_with(step) { lines.push(l) }
		}
	}
	lines.push("")
	lines.push(f"{dir}/suite.log (what failed in each failed job, then its last 200 lines):")
	lines.push(out.trim())
	lines.push("")
	lines.push("Unpushed commits (origin/develop..HEAD; briefs and reports are never among them):")
	lines.push(process::run(
		"git",
		["log", "--format=%h %s", "origin/develop..HEAD"],
	).stdout.trim().clone())
	lines.push("")
	lines.push(f"Briefs and reports of this batch ({dir}/unpushed.txt, untracked working files):")
	for b in drive_read(f"{dir}/unpushed.txt").split("\n") {
		let brief = b.trim()
		if brief == "" { continue }
		lines.push(brief.clone())
		let stem = (brief.strip_suffix(".md") ?? "")
		for r in [f"{brief}.report.md", f"{stem}.report.md"] {
			if r != ".report.md" && fs::exists(r, fs::Root::Anywhere) { lines.push(r) }
		}
	}
	fs::write(f"{dir}/qa-input.txt", fs::Root::Anywhere, lines.join("\n") + "\n")
}

// The red steps of a gate run, "" when green.
fn drive_red_steps(out: String) -> String throws {
	for l in out.split("\n") {
		if l.starts_with("Gate: green") { return "" }
		if l.starts_with("Gate: red") { return (l.strip_prefix("Gate: red") ?? "").trim() }
	}
	return "gate-error"
}

// The repository CI runs on (the `gh api` paths of drive_ci_wait).
fn drive_repo() -> String {
	return "Nikaia-Foundation/Nikaia"
}

// The branch lane DIR's suite runs on: `ci/` and the last part of DIR
// (docs/briefs -> ci/briefs), so the two lanes never cancel each other's run.
fn drive_ci_branch(dir: String) -> String {
	let parts = dir.trim_end_matches("/").split("/").collect()
	return "ci/" + parts[parts.len() - 1]
}

// Starts one suite run on CI (owner, 2026-11-01): the tested sha is pushed with
// force to the lane's branch `ci/<lane>` (drive_ci_branch), whose push runs the
// whole workflow .github/workflows/nikaia.yml; a waiter detached from the driver
// (`--ci-wait`) follows that run and writes `Gate: green` or `Gate: red <jobs>`
// with the failed jobs' log tails to DIR/suite.log, then the exit status to
// target/suite.lock/exit-<sha>; target/suite.lock/testing notes `<sha> <lines
// of unpushed.txt it covers>` (drive_settle reads both). Nothing builds or tests
// in this checkout.
// The badges follow the tree they describe (the self-hosted share moves with
// every move into Nikaia); a builder does not touch them, so the driver
// regenerates them before each suite and commits only `assets/badges/`.
// They are measured on an export of HEAD (`git archive`), not on the shared
// working tree (#1348): another lane's unstaged deletion of a `.rs` moved the
// self-hosted share there, so the committed badge did not match the committed
// tree and CI's `badges.py --check` was red on it.
fn drive_badges() throws {
	let copy = process::run("mktemp", ["-d"]).stdout.trim().clone()
	let made = process::run(
		"sh",
		["-c", f"git archive HEAD | tar -x -C '{copy}' && cd '{copy}' && python3 scripts/badges.py"],
	)
	if made.ok {
		process::run("sh", ["-c", f"cp '{copy}'/assets/badges/*.svg assets/badges/"])
	}
	process::run("rm", ["-rf", copy])
	if !made.ok { drive_escalate(f"scripts/badges.py failed: {made.stderr.trim()}") }
	let changed = process::run("git", ["status", "--porcelain", "assets/badges/"])
	if changed.stdout.trim() == "" { return }
	process::run("git", ["add", "assets/badges/"])
	let done = process::run(
		"git",
		[
			"commit",
			"-q",
			"-m",
			"badges: regenerate for the tree under test",
			"--",
			"assets/badges/",
		],
	)
	if !done.ok { drive_escalate(f"committing the badges failed: {done.stderr.trim()}") }
	println("BADGES regenerated and committed")
}

fn drive_launch(dir: String) throws {
	drive_badges()
	let sha = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
	let branch = drive_ci_branch(dir)
	let log = process::run("realpath", [dir.clone()]).stdout.trim() + "/suite.log"
	let exit = process::run("realpath", [drive_lock_dir()]).stdout.trim() + f"/exit-{sha}"
	process::run("rm", ["-f", exit.clone(), log.clone()])
	let mut covered: i64 = 0
	for l in drive_read(f"{dir}/unpushed.txt").split("\n") {
		if l.trim() != "" { covered += 1 }
	}
	let failed = drive_local_tests(drive_unpushed_paths())
	if failed != "" {
		fs::write(
			log.clone(),
			fs::Root::Anywhere,
			"Gate: red local-tests\n" + drive_tail(failed, 200) + "\n",
		)
		fs::write(exit.clone(), fs::Root::Anywhere, "1\n")
		fs::write(drive_lock_dir() + "/testing", fs::Root::Anywhere, f"{sha} {covered}\n")
		println(f"SUITE {drive_short(sha)} red locally (tests named after the changed scripts), not sent to CI")
		return
	}
	// The branch is the driver's, but someone else may have pushed to it (the
	// owner did, 2026-11-06): its tip is overwritten only when it is already in
	// HEAD's history; anything else stops the driver instead of being lost.
	let mut lease = f"--force-with-lease=refs/heads/{branch}:"
	let remote = process::run("git", ["ls-remote", "origin", f"refs/heads/{branch}"])
	let tip = remote.stdout.trim().split("\t").collect()[0].trim().clone()
	if tip != "" {
		process::run("git", ["fetch", "-q", "origin", f"refs/heads/{branch}"])
		let ours = process::run("git", ["merge-base", "--is-ancestor", tip.clone(), sha.clone()])
		if !ours.ok {
			drive_escalate(f"{branch} holds {drive_short(tip)}, which is not in HEAD's history (someone else's commit?); not overwritten")
		}
		lease = lease + tip
	}
	let pushed = process::run(
		"git",
		["push", lease, "--quiet", "origin", f"{sha}:refs/heads/{branch}"],
	)
	if !pushed.ok {
		drive_escalate(f"git push origin {drive_short(sha)}:{branch} failed: {pushed.stderr.trim()}")
	}
	let bin = drive_exe()
	let exe = process::run("realpath", [bin]).stdout.trim().clone()
	let script = process::run("realpath", ["scripts/drive.nika"]).stdout.trim().clone()
	let wait = f"'{exe}' run '{script}' -- --ci-wait {sha} '{log}' '{exit}'"
	let started = process::run("sh", ["-c", f"( {wait} ) < /dev/null > /dev/null 2>&1 &"])
	if !started.ok { drive_escalate(f"the CI waiter did not start: {started.stderr.trim()}") }
	fs::write(drive_lock_dir() + "/testing", fs::Root::Anywhere, f"{sha} {covered}\n")
	println(f"SUITE {drive_short(sha)} started on CI ({branch})")
}

// `--ci-wait SHA LOG EXIT`: follows the CI run of the push of SHA to a `ci/`
// branch, polling `gh api` every 30 s. Green writes `Gate: green` to LOG; red
// (failure, timed out, or cancelled three times: a cancel is started again)
// writes `Gate: red <job names>` and the last
// 200 lines of each failed job's log; the first failed or timed-out job of a
// running run cancels it and is red at once (owner, 2026-11-06); no run after 15 minutes is `Gate: red
// ci-no-run`, none finished after 3 hours `Gate: red ci-timeout`. Then the exit
// status (0 green, 1 red) to EXIT, through EXIT.tmp.
fn drive_ci_wait(sha: String, log: String, exit: String) throws {
	let (body, green) = drive_ci_poll(sha)
	fs::write(log, fs::Root::Anywhere, body)
	let code = if green { "0" } else { "1" }
	fs::write(exit.clone() + ".tmp", fs::Root::Anywhere, code + "\n")
	process::run("mv", [exit.clone() + ".tmp", exit])
}

// The red log text of CI run ID: per job matching the jq condition FILTER
// what failed and its last 200 lines, then `Gate: red <job names>`.
fn drive_ci_red(
	repo: String,
	id: String,
	url: String,
	conclusion: String,
	filter: String,
) -> String throws {
	let jobs = process::run(
		"gh",
		[
			"api",
			f"repos/{repo}/actions/runs/{id}/jobs?per_page=100",
			"--jq",
			f".jobs[] | select({filter}) | \"\\(.id) \\(.name)\"",
		],
	)
	let mut names: Vec[String] = []
	let mut tails: Vec[String] = []
	for j in jobs.stdout.trim().split("\n") {
		let line = j.trim()
		if line == "" { continue }
		let jid = line.split(" ").collect()[0]
		let name = (line.strip_prefix(jid) ?? "").trim()
		names.push(name.replace(" ", "_"))
		let text = process::run("gh", ["api", f"repos/{repo}/actions/jobs/{jid}/logs"]).stdout
		let failures = drive_failures(text.clone(), 80)
		let tail = drive_tail(text, 200)
		tails.push(f"\nWhat failed in the job {name}, from anywhere in its log:\n{failures}\n\nLast 200 lines of the job {name} ({url}/job/{jid}):\n{tail}\n")
	}
	if names.len() == 0 { names.push(conclusion.replace(" ", "_")) }
	let body = tails.join("")
	let gate = names.join(" ")
	return f"CI run {url}: {conclusion}\n{body}\nGate: red {gate}\n"
}

// One CI verdict for SHA: the log text and whether it is green.
fn drive_ci_poll(sha: String) -> (String, bool) throws {
	let repo = drive_repo()
	let query = ".workflow_runs[] | select(.name == \"Nikaia\" and (.head_branch | startswith(\"ci/\"))) | \"\\(.id) \\(.status) \\(.conclusion)\""
	let mut polls: i64 = 0
	let mut reruns: i64 = 0
	while true {
		let runs = process::run(
			"gh",
			[
				"api",
				f"repos/{repo}/actions/runs?head_sha={sha}&event=push&per_page=20",
				"--jq",
				query.clone(),
			],
		)
		let first = runs.stdout.trim().split("\n").collect()[0].trim()
		let words = first.split(" ").collect()
		if runs.ok && words.len() >= 3 && words[1] == "completed" {
			let id = words[0]
			let url = f"https://github.com/{repo}/actions/runs/{id}"
			if words[2] == "cancelled" && reruns < 3 {
				// A newer push to the same `ci/` branch cancels the run
				// (nikaia.yml concurrency); that is no verdict on SHA, so the
				// run is started again on SHA and followed further.
				process::run("gh", ["api", "-X", "POST", f"repos/{repo}/actions/runs/{id}/rerun"])
				reruns += 1
				polls += 1
				process::run("sleep", ["30"])
				continue
			}
			if words[2] == "success" {
				return (f"CI run {url}: success\nGate: green\n", true)
			} else {
				let all = ".conclusion == \"failure\" or .conclusion == \"cancelled\" or .conclusion == \"timed_out\""
				return (drive_ci_red(repo, id, url, words[2], all), false)
			}
		}
		if runs.ok && words.len() >= 3 {
			// A failed job decides the run (owner, 2026-11-06): the run is
			// cancelled and red at once, not waited for to its end.
			let id = words[0]
			let failed = ".conclusion == \"failure\" or .conclusion == \"timed_out\""
			let count = process::run(
				"gh",
				[
					"api",
					f"repos/{repo}/actions/runs/{id}/jobs?per_page=100",
					"--jq",
					f"[.jobs[] | select({failed})] | length",
				],
			)
			if count.ok && count.stdout.trim() != "" && count.stdout.trim() != "0" {
				process::run("gh", ["api", "-X", "POST", f"repos/{repo}/actions/runs/{id}/cancel"])
				let url = f"https://github.com/{repo}/actions/runs/{id}"
				return (
					drive_ci_red(
						repo,
						id,
						url,
						"failure (cancelled at the first failed job)",
						failed,
					),
					false,
				)
			}
		}
		if polls >= 30 && first == "" {
			return (f"no CI run for {sha} after 15 minutes\nGate: red ci-no-run\n", false)
		}
		if polls >= 360 {
			return (
				f"the CI run for {sha} did not finish in 3 hours: {first}\nGate: red ci-timeout\n",
				false,
			)
		}
		polls += 1
		process::run("sleep", ["30"])
	}
}

// The suite this driver started and has not handled yet: `<sha> <covered>`
// from target/suite.lock/testing while it holds the lock, else "".
fn drive_testing() -> String throws {
	let owner = drive_read(drive_lock_dir() + "/owner")
	if owner == "" || owner.split(" ").collect()[0].trim() != drive_pid() { return "" }
	return drive_read(drive_lock_dir() + "/testing").trim().clone()
}

// The lane directory of the lock this driver holds, "" when it holds none.
fn drive_lock_lane() -> String throws {
	let owner = drive_read(drive_lock_dir() + "/owner").trim()
	let words = owner.split(" ").collect()
	if words.len() < 2 || words[0].trim() != drive_pid() { return "" }
	return words[1].trim().clone()
}

// The QA task's one text; each lane's QA runs on a copy of it (drive_qa_copy).
// Tracked in git: docs/briefs/ is ignored, so a template there was missing in
// a fresh container and QA ran on an empty copy (2026-11-07).
fn drive_qa_template() -> String {
	return "docs/qa-task.md"
}

// The QA input path the template names, made the lane's own by drive_qa_copy.
fn drive_qa_template_input() -> String {
	return "docs/briefs/qa-input.txt"
}

// The brief lane DIR's QA runs on: DIR/qa/qa-task.md, so each lane's QA
// writes its report and run files into its own directory and two drivers'
// commits of them never conflict (2026-10-31: `rebase conflicted in
// docs/briefs/qa-task.md.report.md`).
fn drive_qa_brief(dir: String) -> String {
	return f"{dir}/qa/qa-task.md"
}

// Copies the template to drive_qa_brief(dir), creating DIR/qa/; the report
// path and the input path the template names are made the copy's own. A
// missing or empty template escalates: QA on an empty brief does nothing.
fn drive_qa_copy(dir: String) throws {
	let qa = drive_qa_brief(dir)
	process::run("mkdir", ["-p", f"{dir}/qa"])
	let text = drive_read(drive_qa_template())
	if text.trim() == "" { drive_escalate(f"QA template {drive_qa_template()} missing or empty") }
	let reported = text.replace(f"{drive_qa_template()}.report.md", f"{qa}.report.md")
	let own = reported.replace(drive_qa_template_input(), f"{dir}/qa-input.txt")
	fs::write(qa, fs::Root::Anywhere, own)
}

// Waits for the background suite, if one runs, and handles its result: green
// pushes the tested sha and drops the briefs it covered from unpushed.txt; red
// starts the QA agent, and QA's commit gets its suite at once, waited for, at
// most 2 QA rounds. Releases the lock on every path. One `SUITE <sha8> waiting`
// line, polls every 10 s.
fn drive_settle(exe: String, dir: String) throws {
	let qa = drive_qa_brief(dir)
	let mut rounds: i64 = 0
	while true {
		let testing = drive_testing()
		if testing == "" { return }
		let parts = testing.split(" ").collect()
		let sha = parts[0].clone()
		let mut covered: i64 = 0
		if parts.len() > 1 { covered = text::parse_i64(parts[1]) ?? 0 }
		let exit = f"{drive_lock_dir()}/exit-{sha}"
		if !fs::exists(exit, fs::Root::Anywhere) {
			println(f"SUITE {drive_short(sha)} waiting")
			while !fs::exists(exit, fs::Root::Anywhere) { process::run("sleep", ["10"]) }
		}
		process::run("rm", ["-f", exit, drive_lock_dir() + "/testing"])
		let out = drive_read(f"{dir}/suite.log")
		let steps = drive_red_steps(out)
		if steps == "" {
			println(f"SUITE {drive_short(sha)} green")
			let how = drive_push(sha)
			let mut left: Vec[String] = []
			let mut seen: i64 = 0
			for l in drive_read(f"{dir}/unpushed.txt").split("\n") {
				if l.trim() == "" { continue }
				seen += 1
				if how == "none" || (seen > covered && how == "sha") { left.push(l.trim().clone()) }
			}
			let mut body: String = ""
			if left.len() > 0 { body = left.join("\n") + "\n" }
			fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, body)
			drive_unlock()
			return
		}
		println(f"SUITE {drive_short(sha)} red {steps}")
		if rounds >= 2 { drive_escalate(f"suite red after 2 QA rounds: {steps}") }
		drive_qa_input(dir, out, steps)
		drive_qa_copy(dir)
		process::run("rm", ["-f", f"{qa}.report.md"])
		drive_agent(exe, false, dir, qa, "qa")
		rounds += 1
		drive_report_pushed(false, qa)
		drive_tidy(false, dir.clone())
		drive_append(f"{dir}/unpushed.txt", qa)
		if drive_nothing_new(dir) { return }
		drive_launch(dir)
	}
}

// The path rule of scripts/ci-changes.sh (its `docs` output), kept alike with
// it: a path is documentation when it is under guide/ or website/, or ends in
// `.md` and is neither CHANGELOG.md nor under crates/, packages/, examples/,
// benches/, tools/, scripts/, tests/ or docs/specification/. A change of
// .github/workflows/ or of ci-changes.sh itself runs everything.
fn drive_docs_path(path: String) -> bool {
	if path.starts_with("guide/") || path.starts_with("website/") { return true }
	if !path.ends_with(".md") || path == "CHANGELOG.md" { return false }
	for tree in ["crates/", "packages/", "examples/", "benches/", "tools/", "scripts/", "tests/", "docs/specification/"] {
		if path.starts_with(tree) { return false }
	}
	return true
}

// True when every path is documentation (drive_docs_path) and there is one.
fn drive_docs_only(paths: Vec[String]) -> bool {
	let mut any = false
	for p in paths {
		if p == "" { continue }
		if p.starts_with(".github/workflows/") || p == "scripts/ci-changes.sh" { return false }
		if !drive_docs_path(p) { return false }
		any = true
	}
	return any
}

// The paths the unpushed commits touch, each commit's own.
fn drive_unpushed_paths() -> Vec[String] throws {
	let log = process::run(
		"git",
		["log", "--format=", "--name-only", "origin/develop..HEAD"],
	).stdout
	let mut out: Vec[String] = []
	for line in log.split("\n") {
		let p = line.trim().clone()
		if p != "" { out.push(p) }
	}
	return out
}

// The `--filter`s of the tests named after the changed scripts (owner,
// 2026-11-06): for each `scripts/X.nika` or `tools/X.nika`, X with `-` as `_`
// and its first `_` word when that has five letters or more
// (`facts-collect` gives `facts_collect` and `facts`), each kept only when a
// test in tests/compiler/tests holds it in its name, each once.
fn drive_named_filters(paths: Vec[String]) -> Vec[String] throws {
	let mut keys: Vec[String] = []
	for p in paths {
		let parts: Vec[String] = p.split("/").collect()
		if parts.len() != 2 || !parts[1].ends_with(".nika") { continue }
		if parts[0] != "scripts" && parts[0] != "tools" { continue }
		let key = parts[1].replace(".nika", "").replace("-", "_")
		if !keys.contains(key.clone()) { keys.push(key.clone()) }
		let first = key.split("_").collect()[0].clone()
		if first != key && first.len() >= 5 && !keys.contains(first.clone()) { keys.push(first) }
	}
	let mut tests: Vec[String] = []
	for entry in fs::read_dir("tests/compiler/tests", fs::Root::Anywhere) {
		let n = entry.to_text()
		if n.ends_with(".nika") { tests.push(n) }
	}
	let mut out: Vec[String] = []
	for k in keys {
		for t in tests.clone() {
			if t.contains(k.clone()) {
				out.push(k.clone())
				break
			}
		}
	}
	return out
}

// Before a suite goes to CI: the tests named after the changed scripts, run
// here (a minute instead of a CI round). Red: their output, else "".
fn drive_local_tests(paths: Vec[String]) -> String throws {
	let filters = drive_named_filters(paths)
	if filters.len() == 0 { return "" }
	let bin = drive_exe()
	let exe = process::run("realpath", [bin]).stdout.trim().clone()
	let mut args: String = ""
	for f in filters.clone() { args = args + f" --filter '{f}'" }
	println(f"LOCAL tests {filters.join(" ")}")
	let out = process::run(
		"sh",
		["-c", f"cd tests/compiler && NIKAIA_CACHE_LIMIT=2G '{exe}' test{args} 2>&1"],
	)
	if out.ok { return "" }
	return out.stdout + out.stderr
}

// After the lock and before each suite: another lane may have pushed these
// commits meanwhile. Nothing left to push: unpushed.txt emptied, the lock
// released, true.
fn drive_nothing_new(dir: String) -> bool throws {
	process::run("git", ["fetch", "--quiet", "origin", "develop"])
	let count = process::run(
		"git",
		["rev-list", "--count", "origin/develop..HEAD"],
	).stdout.trim().clone()
	if count != "0" { return false }
	fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, "")
	drive_unlock()
	println("SUITE nothing new after the lock")
	return true
}

// At the end of a batch: waits for a suite still running (drive_settle), then
// starts the complete suite on HEAD in the background and returns at once
// (header comment).
fn drive_suite(exe: String, dry: bool, dir: String) throws {
	let qa = drive_qa_brief(dir)
	drive_say(
		dry,
		"a suite still running (target/suite.lock/testing): wait for it first (SUITE <sha8> waiting)",
	)
	drive_say(
		dry,
		"git fetch origin develop; git rev-list --count origin/develop..HEAD (0: nothing to test)",
	)
	drive_say(
		dry,
		"git log --format= --name-only origin/develop..HEAD: all documentation by scripts/ci-changes.sh's rule, push HEAD without the suite (SUITE <sha8> docs-only, pushed without the suite), empty "
			+ f"{dir}/unpushed.txt",
	)
	drive_say(dry, "mkdir target/suite.lock (wait while its owner's pid lives)")
	drive_say(
		dry,
		"after the lock and before each suite: git fetch origin develop; git rev-list --count origin/develop..HEAD (0: SUITE nothing new after the lock, "
			+ f"empty {dir}/unpushed.txt, rm -rf target/suite.lock)",
	)
	drive_say(
		dry,
		f"git push --force origin <sha>:refs/heads/ci/<last part of DIR> (the whole CI workflow runs on that push); in the background: {exe} run scripts/drive.nika -- --ci-wait <sha> {dir}/suite.log target/suite.lock/exit-<sha> (gh api every 30 s; Gate: green, or Gate: red <failed jobs> with their log tails)",
	)
	drive_say(
		dry,
		f"builders go on meanwhile; once it has finished (or before a bump, the next suite, the end): handle it; green: git push origin <sha>:develop, drop the tested briefs from {dir}/unpushed.txt, rm -rf target/suite.lock",
	)
	drive_say(
		dry,
		f"red: write {dir}/qa-input.txt, mkdir -p {dir}/qa, copy {drive_qa_template()} to {qa} (its report path made {qa}.report.md), rm -f {qa}.report.md, {exe} run scripts/agent.nika -- {qa} --dir {dir}, its report and run files stay untracked, the suite again and waited for (at most 2 QA rounds)",
	)
	if dry { return }
	drive_settle(exe, dir)
	process::run("git", ["fetch", "--quiet", "origin", "develop"])
	let count = process::run(
		"git",
		["rev-list", "--count", "origin/develop..HEAD"],
	).stdout.trim().clone()
	if count == "0" {
		fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, "")
		return
	}
	if drive_docs_only(drive_unpushed_paths()) {
		let head = process::run("git", ["rev-parse", "HEAD"]).stdout.trim().clone()
		println(f"SUITE {drive_short(head)} docs-only, pushed without the suite")
		drive_push(head)
		fs::write(f"{dir}/unpushed.txt", fs::Root::Anywhere, "")
		return
	}
	drive_lock(dir)
	if drive_nothing_new(dir) { return }
	drive_launch(dir)
}

// After a run: a builder's `Pushed: rejected` (or `none`) is rewritten when
// its commit is found in the log (drive_rewrite). Nothing is committed: the
// brief, its report and run files stay untracked working files beside the
// tree (#1252; owner, 2026-11-05: each such commit started a CI run for nothing).
fn drive_report_pushed(dry: bool, brief: String) throws {
	let report_path = f"{brief}.report.md"
	if !fs::exists(report_path, fs::Root::Anywhere) { return }
	let old = drive_read(report_path)
	if dry {
		drive_say(
			dry,
			f"rewrite Pushed: in {report_path} when its Commit: is in the log (nothing committed)",
		)
		return
	}
	process::run("git", ["fetch", "--quiet", "origin", "develop"])
	let log = process::run(
		"git",
		["log", "-40", "--format=%h%x09%s", "HEAD", "origin/develop"],
	).stdout
	let fresh = drive_rewrite(old.clone(), log)
	if fresh != old { fs::write(report_path, fs::Root::Anywhere, fresh) }
}

// The issue a brief belongs to: the first part of four digits of its name
// after the prefix (`d1-1252-briefs` -> 1252, `b44-1206-x` -> 1206), "" when
// it has none.
fn drive_issue(brief: String) -> String throws {
	let parts = drive_stem(brief).split("-").collect()
	for i in 1..<parts.len() {
		let part = parts[i].clone()
		let mut digits = part.len() == 4
		for c in part.scalars { if !c.is_ascii_digit() { digits = false } }
		if digits { return part }
	}
	return ""
}

// The comment that puts a queued brief on its issue: `Brief queued: <name>`,
// a blank line, the brief, then the generated-by footer.
fn drive_post_body(name: String, text: String) -> String {
	return f"Brief queued: {name}\n\n" + text.trim_end() + drive_footer()
}

// Before a brief runs: its text goes as a comment on its issue (drive_issue),
// once; the marker `<brief>.posted` beside it says it did, so a crashed
// session gets the brief back from the issue. No issue, or a failed post, is
// logged (`no issue for <brief>`, `post failed for <brief>`) and the batch goes on.
fn drive_post_brief(dry: bool, brief: String) throws {
	let marker = f"{brief}.posted"
	let name = drive_stem(brief)
	if fs::exists(marker, fs::Root::Anywhere) { return }
	let issue = drive_issue(brief)
	if issue == "" {
		println(f"no issue for {name}")
		return
	}
	drive_say(
		dry,
		f"gh api {drive_comments_api(issue)} -F body=@<Brief queued: {name}, the brief, the footer>; write {marker}",
	)
	if dry { return }
	if !drive_comment(issue, drive_post_body(name, drive_read(brief))) {
		println(f"post failed for {name}")
		return
	}
	fs::write(marker, fs::Root::Anywhere, f"{issue}\n")
}

// The `gh api` path of issue N's comments.
fn drive_comments_api(issue: String) -> String {
	return f"repos/{drive_repo()}/issues/{issue}/comments"
}

// Posts `body` as a comment on issue N (`gh api ... -F body=@FILE`, the file
// a temporary one); true when it went through.
fn drive_comment(issue: String, body: String) -> bool throws {
	let file = process::run("mktemp", []).stdout.trim().clone()
	fs::write(file, fs::Root::Anywhere, body)
	let posted = process::run("gh", ["api", drive_comments_api(issue), "-F", f"body=@{file}"])
	process::run("rm", ["-f", file])
	return posted.ok
}

// The generated-by footer of every comment the driver posts.
fn drive_footer() -> String {
	return "\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_\n"
}

// Dollars with cents of a sum of micro-dollars, rounded: `1.76`.
fn drive_dollars(micro: i64) -> String {
	let cents = (micro + 5000) / 10000
	let rest = cents % 100
	let pad = if rest < 10 { "0" } else { "" }
	return f"{cents / 100}.{pad}{rest}"
}

// The micro-dollars of the cost.txt lines (`DATE USD`) from line `from` on.
fn drive_cost_since(text: String, from: i64) -> i64 throws {
	let lines = text.trim_end().split("\n").collect()
	let mut micro = 0
	for i in 0..<lines.len() {
		let words = lines[i].trim().split(" ").collect()
		if i >= from && words.len() == 2 { micro += drive_micro(words[1]) }
	}
	return micro
}

// The comment of one run (#1252): `Run: <name>, <result line>`, its tokens
// (`row`: the run's tokens.txt row, `BRIEF TOKENS CALLS READ WRITE OUT`, input
// being TOKENS less the other three), the cost (micro-dollars), the time (ms)
// and the turns, the report under `### Report`, the debrief under `###
// Debrief` when there is one, then the footer.
fn drive_run_body(
	name: String,
	result: String,
	row: String,
	micro: i64,
	ms: i64,
	turns: String,
	report: String,
	debrief: String,
) -> String throws {
	let words = row.trim().split(" ").collect()
	let mut n: Vec[i64] = []
	for k in 1..<words.len() { n.push(text::parse_i64(words[k]) ?? 0) }
	while n.len() < 5 { n.push(0) }
	let input = n[0] - n[2] - n[3] - n[4]
	let mut out = f"Run: {name}, {result}\n\n"
	out = out + f"Tokens: input {input}, cache read {n[2]}, cache write {n[3]}, output {n[4]}\n"
	out = out
		+ f"Cost: {drive_dollars(micro)} USD, time {ms / 60000} min {(ms / 1000) % 60} s, turns {turns}\n\n"
	out = out + "### Report\n\n" + (if report.trim() == "" { "(none)" } else { report.trim_end() })
	if debrief.trim() != "" { out = out + "\n\n### Debrief\n\n" + debrief.trim_end() }
	return out + drive_footer()
}

// The comment of BRIEF's run, from the files the run left in DIR: the report's
// `Result:` line (else `fallback`, an escalation), the brief's last row of
// DIR/tokens.txt, DIR/cost.txt from line `cost_from` on (the run and its
// debrief), BRIEF.run.json's `duration_ms` (and `num_turns` without a tokens
// row), the debrief.
fn drive_run_comment(
	dir: String,
	brief: String,
	cost_from: i64,
	fallback: String,
) -> String throws {
	let abs = process::run("realpath", [brief]).stdout.trim().clone()
	let report_path = drive_report_of(abs)
	let report = if report_path == "" { "" } else { drive_read(report_path) }
	let field = drive_field(report, "Result")
	let result = if field == "" { fallback.clone() } else { f"Result: {field}" }
	let mut row: String = ""
	for line in drive_read(f"{dir}/tokens.txt").split("\n") {
		if line.trim().split(" ").collect()[0] == abs { row = line.clone() }
	}
	let json = drive_read(f"{abs}.run.json")
	let ms = text::parse_i64(drive_json_field(json, "duration_ms")) ?? 0
	let mut turns = drive_json_field(json, "num_turns")
	let cells = row.trim().split(" ").collect()
	if cells.len() > 2 { turns = cells[2].clone() }
	if turns == "" { turns = "0" }
	let stem = (abs.strip_suffix(".md") ?? "")
	let mut debrief = drive_read(f"{abs}.debrief.md")
	if stem != "" { debrief = drive_read(f"{stem}.debrief.md") }
	let micro = drive_cost_since(drive_read(f"{dir}/cost.txt"), cost_from)
	return drive_run_body(drive_stem(abs), result, row, micro, ms, turns, report, debrief)
}

// The raw value after `"key":` in claude's JSON (first occurrence), "" if absent.
fn drive_json_field(body: String, key: String) -> String {
	let parts = body.split("\"" + key + "\":").collect()
	if parts.len() < 2 { return "" }
	let first = parts[1].split(",").collect()[0]
	return first.split("}").collect()[0].trim().replace("\"", "")
}

// The issue a run or a block is posted on: the brief's own (drive_issue), else
// the lane issue of DIR's area in docs/briefs/focus.txt; "" when neither.
fn drive_run_issue(brief: String, dir: String) -> String throws {
	let own = drive_issue(brief)
	if own != "" { return own }
	return drive_focus_issue(drive_read("docs/briefs/focus.txt"), "", dir)
}

// After a run: its comment on its issue (drive_run_comment). No issue, or a
// failed post, is logged (`no issue for <brief>`, `post failed for <brief>`)
// and stops nothing; the files stay for the driver and the supervisor.
fn drive_post_run(dir: String, brief: String, cost_from: i64, fallback: String) throws {
	let name = drive_stem(brief)
	let issue = drive_run_issue(brief, dir)
	if issue == "" {
		println(f"no issue for {name}")
		return
	}
	if !drive_comment(issue, drive_run_comment(dir, brief, cost_from, fallback)) {
		println(f"post failed for {name}")
	}
}

// What a run leaves behind that no commit takes: untracked step reports
// (`*.step<N>.report.md`) beside the briefs.
fn drive_tidy(dry: bool, dir: String) throws {
	let left = process::run("git", ["ls-files", "--others", "--exclude-standard", "--", dir])
	let mut stray: Vec[String] = []
	for l in left.stdout.trim().split("\n") {
		if l.contains(".step") && l.ends_with(".report.md") { stray.push(l) }
	}
	if stray.len() > 0 { drive_say(dry, "rm -f " + stray.join(" ")) }
	if dry { return }
	for i in 0..<stray.len() { process::run("rm", ["-f", stray[i].clone()]) }
}

// Runs one agent; prints `<role> done ...`; escalates on anything else.
fn drive_agent(exe: String, dry: bool, dir: String, brief: String, role: String) throws {
	drive_say(dry, f"{exe} run scripts/agent.nika -- {brief} --dir {dir}")
	drive_say(
		dry,
		f"gh api {drive_comments_api("<issue of " + drive_stem(brief) + ">")} -F body=@<Run: the result, tokens, cost, time, turns, report, debrief, the footer>",
	)
	if dry { return }
	let cost_from = drive_line_count(drive_read(f"{dir}/cost.txt"))
	let out = process::run(
		exe,
		["run", "scripts/agent.nika", "--", brief.clone(), "--dir", dir.clone()],
	)
	let mut done: String = ""
	let mut first: String = ""
	for l in out.stdout.trim().split("\n") {
		if first == "" { first = l }
		if l.starts_with("done ") { done = l }
	}
	if done == "" || !out.ok {
		if first == "" { first = f"agent.nika exited with code {out.code}" }
		drive_post_run(dir, brief.clone(), cost_from, first)
		drive_escalate(first)
	}
	drive_post_run(dir, brief.clone(), cost_from, "no report")
	println(f"{role} {done}")
}

fn drive_read(path: String) -> String throws {
	if !fs::exists(path, fs::Root::Anywhere) { return "" }
	return fs::read_to_string(path, fs::Root::Anywhere)
}

fn drive_cycle(exe: String, dir: String, lines_file: String) -> String throws {
	if lines_file != "" { return drive_read(lines_file) }
	let c = process::run(exe, ["run", "scripts/cycle.nika", "--", dir])
	if !c.ok { drive_escalate("cycle.nika failed") }
	return c.stdout
}

// One builder run of DIR's brief: the brief posted on its issue (once), the
// agent, its report's `Pushed:` checked, the tidy, the brief appended to
// DIR/unpushed.txt. Nothing under docs/briefs/ is committed.
fn drive_builder(exe: String, dry: bool, dir: String, brief: String) throws {
	drive_say(
		dry,
		"a batch's suite that has finished (target/suite.lock/exit-<sha>): handle it (drive_settle) first; one still running: go on, CI runs it",
	)
	drive_post_brief(dry, brief)
	drive_wip_start(dry, brief)
	drive_agent(exe, dry, dir, brief, "builder")
	drive_report_pushed(dry, brief)
	drive_wip_end(dry, brief)
	drive_tidy(dry, dir.clone())
	drive_say(dry, f"append {brief} to {dir}/unpushed.txt (no suite until the batch ends)")
	if dry { return }
	drive_append(f"{dir}/unpushed.txt", brief.clone())
	let found = drive_found(dir, brief)
	if found != "" {
		println(found)
		drive_found_file(dir, brief)
	}
}

// Adds LABEL to issue N (`gh api -X POST .../labels`); true when it went through.
fn drive_label_add(issue: String, label: String) -> bool throws {
	let repo = drive_repo()
	return process::run(
		"gh",
		["api", "-X", "POST", f"repos/{repo}/issues/{issue}/labels", "-f", f"labels[]={label}"],
	).ok
}

// Removes LABEL from issue N (`gh api -X DELETE .../labels/LABEL`).
fn drive_label_remove(issue: String, label: String) throws {
	let repo = drive_repo()
	process::run("gh", ["api", "-X", "DELETE", f"repos/{repo}/issues/{issue}/labels/{label}"])
}

// Before a run on issue N (owner, 2026-11-06): the issue gets the label
// `wip`, so drive_queue does not queue it again while it is worked on. No
// issue, or a failed call, is logged (`wip failed for <brief>`) and stops nothing.
fn drive_wip_start(dry: bool, brief: String) throws {
	let issue = drive_issue(brief)
	if issue == "" { return }
	drive_say(dry, f"gh api -X POST repos/{drive_repo()}/issues/{issue}/labels -f labels[]=wip")
	if dry { return }
	if !drive_label_add(issue, "wip") { println(f"wip failed for {drive_stem(brief)}") }
}

// What a run's end does to the labels of its issue N, by the report's
// `Result:` and `Fixes:`: `keep` (done and `Fixes:` names #N: `wip` stays
// until promote closes the issue, so it is not queued again), `block`
// (blocked: `wip` and `ready` go, `blocked` comes, the supervisor decides),
// `remove` (anything else, partial or no report: `wip` goes, `ready` stays,
// the next queue picks it up again).
fn drive_wip_after(result: String, fixes: String, issue: String) -> String {
	let word = drive_word(result)
	if word == "done" {
		for w in fixes.replace(",", " ").split(" ") {
			if w.trim() == f"#{issue}" { return "keep" }
		}
	}
	if word == "blocked" { return "block" }
	return "remove"
}

// After a run on issue N: its labels by drive_wip_after.
fn drive_wip_end(dry: bool, brief: String) throws {
	let issue = drive_issue(brief)
	if issue == "" { return }
	drive_say(
		dry,
		f"by the report's Result and Fixes: keep wip, or remove it (blocked: ready -> blocked) on #{issue}",
	)
	if dry { return }
	let report = drive_report_of(brief.clone())
	let body = if report == "" { "" } else { drive_read(report) }
	let what = drive_wip_after(
		drive_field(body.clone(), "Result"),
		drive_field(body, "Fixes"),
		issue.clone(),
	)
	if what == "keep" { return }
	drive_label_remove(issue.clone(), "wip")
	if what == "block" {
		drive_label_remove(issue.clone(), "ready")
		drive_label_add(issue, "blocked")
	}
}

// The labels of an issue filed from a report's `Found:` in AREA: `ready`
// and AREA, `decision` instead of `ready` when `Needs:` asks for something.
fn drive_found_labels(needs: String, area: String) -> Vec[String] {
	let mut status: String = "decision"
	if needs == "" || drive_word(needs) == "none" { status = "ready" }
	return [status, area]
}

// The title of an issue filed from FOUND: its first 80 characters, cut at a
// word, `...` when cut.
fn drive_found_title(found: String) -> String {
	let chars: Vec[scalar] = found.trim().chars().collect()
	if chars.len() <= 80 { return found.trim().clone() }
	let mut out: String = ""
	let mut word: String = ""
	for i in 0..<77 {
		let c = chars[i]
		if c == ' ' {
			out = out + word
			word = " "
		} else {
			word = f"{word}{c}"
		}
	}
	return out.trim().clone() + "..."
}

// The body of an issue filed from a report's `Found:`: where it came from (the
// brief, its issue), the Found, `Needs:` when it asks for something, a *To
// build* and a *Done when* for the builder that takes it (docs/issues.md),
// then the footer.
fn drive_found_body(name: String, issue: String, found: String, needs: String) -> String {
	let from = if issue == "" { f"the run of `{name}`" } else { f"the run of `{name}` (#{issue})" }
	let mut body = f"Filed by the driver from the `Found:` of {from} (owner, 2026-11-06).\n\n## Found\n\n{found.trim()}\n"
	if needs != ""
		&& drive_word(needs) != "none" { body = body + f"\n## Needs\n\n{needs.trim()}\n" }
	body = body
		+ "\n## To build\n\n- [ ] Reproduce the Found with a probe (`nikaia run scripts/probe.nika -- SNIPPET`).\n- [ ] Fix it where it lives, with a test in `tests/compiler/`.\n"
	body = body + "\n## Done when\n\nThe probe gives the specified result and its test is green.\n"
	return body + drive_footer()
}

// Files a report's `Found:` as an issue (owner, 2026-11-06): labels
// drive_found_labels (AREA: the last part of DIR), title drive_found_title,
// body drive_found_body; `<brief>: filed #N` goes into DIR/found.txt and
// `FILED #N <brief>` is printed. A failed call is logged (`file failed for
// <brief>`), the Found stays in found.txt for the supervisor.
fn drive_found_file(dir: String, brief: String) throws {
	let report = drive_report_of(brief.clone())
	if report == "" { return }
	let text = drive_read(report)
	let found = drive_field(text.clone(), "Found")
	if found == "" || drive_word(found.clone()) == "none" { return }
	let needs = drive_field(text, "Needs")
	let name = drive_stem(brief.clone())
	let area = drive_stem(dir.clone())
	let body = drive_found_body(name.clone(), drive_issue(brief), found.clone(), needs.clone())
	let file = process::run("mktemp", []).stdout.trim().clone()
	fs::write(file.clone(), fs::Root::Anywhere, body)
	let mut call: Vec[String] = [
		"api",
		f"repos/{drive_repo()}/issues",
		"-f",
		f"title={drive_found_title(found)}",
		"-F",
		f"body=@{file}",
	]
	for l in drive_found_labels(needs, area) { call.push(f"labels[]={l}") }
	let mut args: Vec[String] = []
	for a in call {
		if a.starts_with("labels[]=") { args.push("-f") }
		args.push(a.clone())
	}
	args.push("--jq")
	args.push(".number")
	let made = process::run("gh", args)
	process::run("rm", ["-f", file])
	let number = made.stdout.trim().clone()
	if !made.ok || number == "" {
		println(f"file failed for {name}")
		return
	}
	drive_append(f"{dir}/found.txt", f"{name}: filed #{number}")
	println(f"FILED #{number} {name}")
}

// A report's `Found:` (a defect outside the builder's step) does not stop the
// batch (supervisor, 2026-11-06): `<brief>: Found: <text>` is appended to
// DIR/found.txt (created when missing) for the supervisor to file, and the
// line to print, `FOUND <brief>: Found: <text>` (at most 160 characters), is
// returned; "" when the report has none (`none` or no line).
fn drive_found(dir: String, brief: String) -> String throws {
	let report = drive_report_of(brief.clone())
	if report == "" { return "" }
	let found = drive_field(drive_read(report), "Found")
	if found == "" || found == "none" { return "" }
	let line = f"{drive_stem(brief)}: Found: {found}"
	drive_append(f"{dir}/found.txt", line.clone())
	let out = f"FOUND {line}"
	if out.len() <= 160 { return out }
	return out.bytes[0..157].text() + "..."
}

// The batch ends at a stop line: its suite runs and is waited for (pushed when
// green), then the driver stops for the supervisor, who writes the next briefs
// (a fix-forward for RED). A dry run prints `DRY-RUN STOP <stop>`.
fn drive_stop(exe: String, dry: bool, dir: String, stop: String) throws {
	drive_suite(exe, dry, dir)
	drive_say(dry, "wait for the suite (drive_settle), then stop for the supervisor (exit 2)")
	if dry {
		println(f"DRY-RUN STOP {stop}")
		return
	}
	drive_settle(exe, dir)
	drive_unlock()
	println(f"ESCALATE {stop}: the supervisor writes the next briefs")
	process::exit(2)
}

// The words of the first line of a focus file that starts with `key`, empty
// without one. The file (docs/briefs/focus.txt):
//     block 3
//     area bugs docs/briefs/bugs
//     current bugs 0
fn drive_focus_words(text: String, key: String) -> Vec[String] {
	for line in text.split("\n") {
		let words = line.trim().split(" ").collect()
		if words.len() > 1 && words[0] == key { return words }
	}
	let none: Vec[String] = []
	return none
}

// The block length (builder briefs an area runs before the focus moves on), 3
// when the file names none.
fn drive_focus_block(text: String) -> i64 {
	let words = drive_focus_words(text, "block")
	if words.len() < 2 { return 3 }
	return text::parse_i64(words[1]) ?? 3
}

// The areas in order, each `NAME DIR`. An area line may name the lane's
// issue as a fourth word (`area views docs/briefs/views 1213`).
fn drive_focus_areas(text: String) -> Vec[String] {
	let mut out: Vec[String] = []
	for line in text.split("\n") {
		let words = line.trim().split(" ").collect()
		if (words.len() == 3 || words.len() == 4)
			&& words[0] == "area" { out.push(words[1] + " " + words[2]) }
	}
	return out
}

// True when `dir` (relative, or absolute under the checkout) is the area
// directory `area`; "" is no directory.
fn drive_same_dir(dir: String, area: String) -> bool {
	let a = area.trim_end_matches("/")
	if dir == "" || a == "" { return false }
	return dir == a || dir.ends_with("/" + a)
}

// The lane issue of the area named `name`, or of the area whose DIR is `dir`
// (the fourth word of its line), "" when its line names none.
fn drive_focus_issue(text: String, name: String, dir: String) -> String {
	let want = dir.trim_end_matches("/")
	for line in text.split("\n") {
		let words = line.trim().split(" ").collect()
		if words.len() == 4
			&& words[0] == "area"
			&& (words[1] == name || drive_same_dir(want, words[2])) { return words[3] }
	}
	return ""
}

// The current area's name: the `current` line's, else the first area's.
fn drive_focus_current(text: String) -> String {
	let words = drive_focus_words(text, "current")
	if words.len() > 1 { return words[1].clone() }
	let areas = drive_focus_areas(text)
	if areas.len() == 0 { return "" }
	return areas[0].split(" ").collect()[0].clone()
}

// The builder runs the current area has had in its block.
fn drive_focus_count(text: String) -> i64 {
	let words = drive_focus_words(text, "current")
	if words.len() < 3 { return 0 }
	return text::parse_i64(words[2]) ?? 0
}

// The directory of area NAME, "" when the file has no such area.
fn drive_focus_dir(text: String, name: String) -> String {
	for area in drive_focus_areas(text) {
		let words = area.split(" ").collect()
		if words[0] == name { return words[1].clone() }
	}
	return ""
}

// `text` with its `current` line set to `NAME COUNT` (appended when absent).
fn drive_focus_set(text: String, name: String, count: i64) -> String {
	let mut out: Vec[String] = []
	let mut set = false
	for line in text.trim_end().split("\n") {
		if line.trim().starts_with("current ") || line.trim() == "current" {
			out.push(f"current {name} {count}")
			set = true
		} else {
			out.push(line)
		}
	}
	if !set { out.push(f"current {name} {count}") }
	return out.join("\n") + "\n"
}

// The area after the current one, wrapping, whose name is not in `skipped`
// (` a b `, the areas found empty in this rotation); the current one itself
// comes last. "" when every area is skipped.
fn drive_focus_next(text: String, skipped: String) -> String {
	let areas = drive_focus_areas(text)
	let current = drive_focus_current(text)
	let n = areas.len()
	let mut at: i64 = 0
	for i in 0..<n {
		if areas[i].split(" ").collect()[0] == current { at = i }
	}
	for k in 0..<n {
		let name = areas[(at + 1 + k) % n].split(" ").collect()[0].clone()
		if !skipped.contains(f" {name} ") { return name }
	}
	return ""
}

// Micro-dollars of "12.34": whole * 1_000_000 + the first six decimals.
fn drive_micro(cost: String) -> i64 throws {
	let parts = cost.trim().split(".").collect()
	let whole = text::parse_i64(parts[0]) ?? 0
	if parts.len() < 2 { return whole * 1000000 }
	let padded = parts[1] + "000000"
	let frac = text::parse_i64(padded.bytes[0..<6].text()) ?? 0
	return whole * 1000000 + frac
}

// The focus line of one block: `<stamp> <area> briefs <n> done <d>
// partial <p> blocked <b> noop <o> tokens <t> cost <c> queue <q>`. `tokens`: the rows (`BRIEF TOKENS CALLS`) of the block's
// briefs from tokens.txt; `costs`: the cost.txt lines (`DATE USD`) the block
// added.
fn drive_focus_line(
	stamp: String,
	area: String,
	reports: Vec[String],
	tokens: Vec[String],
	costs: Vec[String],
	queue: i64,
) -> String throws {
	let mut done = 0
	let mut partial = 0
	let mut blocked = 0
	let mut noop = 0
	for report in reports {
		let result = drive_word(drive_field(report, "Result"))
		if result == "done" { done += 1 }
		if result == "partial" { partial += 1 }
		if result == "blocked" { blocked += 1 }
		if result == "noop" { noop += 1 }
	}
	let mut sum = 0
	for row in tokens {
		let words = row.trim().split(" ").collect()
		if words.len() > 1 { sum += text::parse_i64(words[1]) ?? 0 }
	}
	let mut micro = 0
	for row in costs {
		let words = row.trim().split(" ").collect()
		if words.len() == 2 { micro += drive_micro(words[1]) }
	}
	return f"{stamp} {area} briefs {reports.len()} done {done} partial {partial} blocked {blocked} noop {noop} tokens {sum} cost {drive_dollars(micro)} queue {queue}"
}

// The report of a brief that exists (`BRIEF.report.md`, else the stem's), or "".
fn drive_report_of(brief: String) -> String throws {
	let report = f"{brief}.report.md"
	if fs::exists(report, fs::Root::Anywhere) { return report }
	let stem = (brief.strip_suffix(".md") ?? "")
	if stem != ""
		&& fs::exists(f"{stem}.report.md", fs::Root::Anywhere) { return f"{stem}.report.md" }
	return ""
}

// The briefs of DIR/batch.txt that exist and have no report yet, as paths
// under DIR.
fn drive_unrun(dir: String) -> Vec[String] throws {
	let mut out: Vec[String] = []
	for raw in drive_read(f"{dir}/batch.txt").split("\n") {
		let name = raw.trim()
		if name == "" { continue }
		let brief = f"{dir}/{name}"
		if fs::exists(brief, fs::Root::Anywhere) && drive_report_of(brief) == "" { out.push(brief) }
	}
	return out
}

// The first unrun brief of DIR/batch.txt with a `Blocks:` line (a defect that
// holds up a move), as its absolute path; "" when none.
fn drive_focus_blocking(dir: String) -> String throws {
	for brief in drive_unrun(dir) {
		for line in drive_read(brief).split("\n") {
			if line.trim().starts_with("Blocks:") {
				return process::run("realpath", [brief]).stdout.trim().clone()
			}
		}
	}
	return ""
}

// The lines of a text, a trailing newline not counted.
fn drive_line_count(body: String) -> i64 {
	if body.trim() == "" { return 0 }
	return body.trim_end().split("\n").collect().len()
}

// The focus line of a block of AREA (DIR) that ran `briefs`: their
// reports, their rows of tokens.txt beside each brief, the lines of
// DIR/cost.txt from line `cost_from` on, the unrun briefs left in DIR.
fn drive_focus_record(
	stamp: String,
	area: String,
	dir: String,
	briefs: Vec[String],
	cost_from: i64,
) -> String throws {
	let mut reports: Vec[String] = []
	let mut tokens: Vec[String] = []
	for brief in briefs {
		let report = drive_report_of(brief)
		if report != "" { reports.push(drive_read(report)) }
		let cut = brief.rfind("/") ?? 0
		let home = if cut > 0 { brief[0..<cut] } else { "." }
		for row in drive_read(f"{home}/tokens.txt").split("\n") {
			if row.trim().split(" ").collect()[0] == brief { tokens.push(row.clone()) }
		}
	}
	let mut costs: Vec[String] = []
	let lines = drive_read(f"{dir}/cost.txt").trim_end().split("\n").collect()
	for i in 0..<lines.len() {
		if i >= cost_from && lines[i].trim() != "" { costs.push(lines[i]) }
	}
	return drive_focus_line(stamp, area, reports, tokens, costs, drive_unrun(dir).len())
}

// The comment of a block's focus line (drive_focus_record): the line, then
// the footer.
fn drive_focus_body(line: String) -> String {
	return line + drive_footer()
}

// A block's line goes to the driver's output (`FOCUS <line>`) and as a comment
// on the lane issue of AREA in the focus text (#1252: no focus-log.md); with
// none, only to the output (`no lane issue for <area>`). A failed post is
// logged (`post failed for <area>`) and stops nothing.
fn drive_post_focus(file: String, area: String, line: String) throws {
	println(f"FOCUS {line}")
	let issue = drive_focus_issue(file, area, "")
	if issue == "" {
		println(f"no lane issue for {area}")
		return
	}
	if !drive_comment(issue, drive_focus_body(line)) { println(f"post failed for {area}") }
}

// The debriefs' facts into the facts files (owner, 2026-11-06): runs
// `facts-collect.nika -- --apply` and commits what it entered, docs only.
fn drive_facts(exe: String) throws {
	let out = process::run(exe, ["run", "scripts/facts-collect.nika", "--", "--apply"])
	let mut n: i64 = 0
	for l in out.stdout.split("\n") {
		if l.starts_with("FACT ") { n += 1 }
		if l.starts_with("UNPLACED ") { println(l) }
	}
	if n == 0 { return }
	let commit = process::run(
		"git",
		[
			"commit",
			"-q",
			"-m",
			"docs: builder facts from the debriefs",
			"--",
			"docs/builder-facts.md",
			"docs/builder-facts-lookup.md",
		],
	)
	if !commit.ok { println(f"facts commit failed: {commit.stderr.trim()}") }
	println(f"FACTS {n} entered")
}

// The end of a block: the suite (started, then waited for: pushed on green,
// QA on red), the block's line on the lane issue, the bump of each area's DIR with one pending
// while CI is green, the focus moved to the next area (focus.txt is a
// working file, not committed: #1252). `file`: the focus file as read at the block's start.
fn drive_focus_end(
	exe: String,
	dry: bool,
	file: String,
	area: String,
	dir: String,
	briefs: Vec[String],
	cost_from: i64,
) throws {
	let path = "docs/briefs/focus.txt"
	drive_suite(exe, dry, dir)
	drive_say(
		dry,
		f"gh api {drive_comments_api("<lane issue of " + area + ">")} -F body=@<the block's line, the footer>",
	)
	if !dry {
		let stamp = process::run("date", ["+%F %H:%M"]).stdout.trim().clone()
		let line = drive_focus_record(stamp, area, dir, briefs, cost_from)
		drive_post_focus(file, area, line)
	}
	for each in drive_focus_areas(file) {
		let other = each.split(" ").collect()[1]
		drive_say(
			dry,
			f"{exe} run scripts/cycle.nika -- {other}: BUMP pending and CI green: {exe} run scripts/cycle.nika -- {other} --apply",
		)
		if dry { continue }
		let cyc = drive_cycle(exe, other.clone(), "")
		let green = cyc.contains(" green\n") || cyc.trim().ends_with(" green")
		if green && cyc.contains("BUMP pending") {
			drive_settle(exe, dir)
			let rel = process::run(
				exe,
				["run", "scripts/cycle.nika", "--", other.clone(), "--apply"],
			)
			if rel.stdout.contains("PUSH REJECTED") { drive_escalate("bump push rejected") }
		}
	}
	drive_say(dry, f"{exe} run scripts/facts-collect.nika -- --apply, committed as docs")
	if !dry { drive_facts(exe) }
	let next = drive_focus_next(file, " ")
	drive_say(dry, f"set {path} to current {next} 0 (not committed)")
	if dry { return }
	fs::write(path, fs::Root::Anywhere, drive_focus_set(drive_read(path), next, 0))
}

// BATCH with each of NUMBERS not yet in it (as the first word of a line)
// appended as a `#N` line, in order.
fn drive_queue_add(batch: String, numbers: Vec[String]) -> String {
	let mut have: Vec[String] = []
	let mut out: Vec[String] = []
	for l in batch.split("\n") {
		let w = l.trim().clone()
		if w == "" { continue }
		out.push(l.clone())
		let first: Vec[String] = w.split(" ").collect()
		have.push(first[0].clone())
	}
	for n in numbers {
		let tag = f"#{n.trim()}"
		if n.trim() == "" || have.contains(tag.clone()) { continue }
		have.push(tag.clone())
		out.push(tag)
	}
	if out.len() == 0 { return "" }
	let text = out.join("\n")
	return f"{text}\n"
}

// Queues the lane's ready issues (owner, 2026-11-06): the open issues
// labelled `ready` and AREA, without `wip` (one being worked on), go into DIR/batch.txt as `#N` lines, oldest
// first (drive_queue_add); prints `QUEUED #N AREA` for each new one.
fn drive_queue(dir: String, area: String) throws {
	let repo = drive_repo()
	let got = process::run(
		"gh",
		[
			"api",
			f"repos/{repo}/issues?state=open&labels=ready,{area}&per_page=100&sort=created&direction=asc",
			"--jq",
			".[] | select(.pull_request == null and ([.labels[].name] | index(\"wip\") | not)) | .number",
		],
	)
	if !got.ok { return }
	let mut numbers: Vec[String] = []
	for n in got.stdout.trim().split("\n") {
		if n.trim() != "" { numbers.push(n.trim().clone()) }
	}
	if numbers.len() == 0 { return }
	let path = f"{dir}/batch.txt"
	let old = drive_read(path.clone())
	let new = drive_queue_add(old.clone(), numbers)
	if new == old || new == "" { return }
	fs::write(path, fs::Root::Anywhere, new.clone())
	let before = drive_queue_add(old, [])
	let had: Vec[String] = before.split("\n").collect()
	for l in new.split("\n") {
		if l.trim() != "" && !had.contains(l.clone()) { println(f"QUEUED {l.trim()} {area}") }
	}
}

// `--focus` (owner, 2026-11-01): one driver, one area at a time. Drives the
// current area of docs/briefs/focus.txt as the single-DIR loop does, counting
// its builder runs; the block ends at `block` runs or on BATCH DONE
// (drive_focus_end), and the focus moves to the next area. Before each block
// an unrun bug brief with a `Blocks:` line runs first (it counts for the bugs
// area). An area entered with nothing to run is skipped for this rotation
// (`FOCUS <area> empty, skipped`), and every area empty escalates. RED and CUT
// stop for the supervisor as in the single-DIR loop; a report's `Found:` is no
// CUT (batch.nika), it is collected in DIR/found.txt (drive_builder).
fn drive_focus(exe: String, dry: bool, max: i64, ignore_red: bool, lines_file: String) throws {
	let path = "docs/briefs/focus.txt"
	let bugs = "docs/briefs/bugs"
	let own = drive_read("scripts/drive.nika")
	let mut runs: i64 = 0
	let mut skipped: String = " "
	let mut briefs: Vec[String] = []
	let mut cost_from: i64 = -1
	while true {
		let file = drive_read(path)
		let area = drive_focus_current(file)
		let dir = drive_focus_dir(file, area)
		if dir == "" { drive_escalate(f"focus: {path} names no area {area}") }
		if !dry && drive_read("scripts/drive.nika") != own {
			drive_settle(exe, dir)
			drive_restart(exe.clone())
		}
		let block = drive_focus_block(file)
		let count = drive_focus_count(file)
		if cost_from < 0 { cost_from = drive_line_count(drive_read(f"{dir}/cost.txt")) }
		if dry { println(f"FOCUS {area} {dir} {count} of {block}") }
		// A bug brief that holds up a move goes first, before each block.
		if count == 0 && briefs.len() == 0 {
			let urgent = drive_focus_blocking(bugs)
			if urgent != "" {
				if runs >= max { drive_escalate(f"--max {max} agent runs reached") }
				if !dry && drive_suite_done() { drive_settle(exe, dir) }
				let bugs_from = drive_line_count(drive_read(f"{bugs}/cost.txt"))
				drive_builder(exe, dry, bugs, urgent)
				runs += 1
				if dry {
					println(f"DRY-RUN NEXT {drive_stem(urgent)} (Blocks:)")
					return
				}
				if area == "bugs" {
					briefs.push(urgent)
					fs::write(path, fs::Root::Anywhere, drive_focus_set(file, area, 1))
				} else {
					let stamp = process::run("date", ["+%F %H:%M"]).stdout.trim().clone()
					let line = drive_focus_record(stamp, "bugs", bugs, [urgent], bugs_from)
					drive_post_focus(file, "bugs", line)
				}
				continue
			}
		}
		if !dry && lines_file == "" { drive_queue(dir.clone(), area.clone()) }
		let cyc = drive_cycle(exe, dir.clone(), lines_file)
		let mut lines: Vec[String] = []
		// A bump waits for the end of a block (drive_focus_end).
		for l in cyc.trim().split("\n") {
			if l.trim() != "" && !l.trim().starts_with("BUMP") { lines.push(l.trim().clone()) }
		}
		if lines.len() == 0 { drive_escalate("cycle.nika printed nothing") }
		let action = drive_action(lines, ignore_red)
		if action.starts_with("ESCALATE ") {
			drive_settle(exe, dir)
			drive_unlock()
			println(action)
			process::exit(2)
		}
		// Builders go on while CI runs the suite (owner, 2026-11-06); a
		// finished suite is handled before the next builder.
		if !dry && action.starts_with("NEXT ") && drive_suite_done() {
			drive_settle(exe, dir)
			continue
		}
		if runs >= max { drive_escalate(f"--max {max} agent runs reached") }
		if action.starts_with("NEXT ") {
			let brief = (action.strip_prefix("NEXT ") ?? "").clone()
			drive_builder(exe, dry, dir, brief)
			runs += 1
			if dry {
				println(f"DRY-RUN NEXT {drive_stem(brief)}")
				return
			}
			briefs.push(brief)
			fs::write(path, fs::Root::Anywhere, drive_focus_set(file, area, count + 1))
			if count + 1 < block { continue }
			drive_focus_end(exe, dry, file, area, dir, briefs, cost_from)
			briefs = []
			cost_from = -1
			skipped = " "
			continue
		}
		let stop = (action.strip_prefix("STOP ") ?? "")
		if !stop.starts_with("BATCH DONE") {
			drive_stop(exe, dry, dir, stop)
			return
		}
		// BATCH DONE: a block that ran briefs ends here.
		if briefs.len() > 0 {
			if dry { println("DRY-RUN BLOCK END") }
			drive_focus_end(exe, dry, file, area, dir, briefs, cost_from)
			if dry { return }
			briefs = []
			cost_from = -1
			skipped = " "
			continue
		}
		// Entered with nothing to run: skipped; the supervisor fills the queue.
		println(f"FOCUS {area} empty, skipped")
		skipped = skipped + area + " "
		let next = drive_focus_next(file, skipped)
		if next == "" {
			drive_settle(exe, dir)
			drive_unlock()
			println("ESCALATE focus: every area empty")
			process::exit(2)
		}
		fs::write(path, fs::Root::Anywhere, drive_focus_set(file, next, 0))
		cost_from = -1
	}
}

fn main() throws {
	let mut dir: String = ""
	let mut max: i64 = 8
	let mut dry = false
	let mut no_bump = false
	let mut ignore_red = false
	let mut lines_file: String = ""
	let mut focus = false
	let mut args: Vec[String] = []
	for a in cli::args() { args.push(a) }
	let mut i = 1
	if !dry { drive_silence_stop_hook() }
	while i < args.len() {
		if args[i] == "--dry-run" {
			dry = true
		} else if args[i] == "--ignore-ci-red" {
			ignore_red = true
		} else if args[i] == "--focus" {
			focus = true
		} else if args[i] == "--no-bump" {
			no_bump = true
		} else if args[i] == "--max" && i + 1 < args.len() {
			max = text::parse_i64(args[i + 1]) ?? 8
			i += 1
		} else if args[i] == "--lines" && i + 1 < args.len() {
			lines_file = args[i + 1].clone()
			dry = true
			i += 1
		} else {
			dir = args[i].clone()
		}
		i += 1
	}
	if args.len() >= 3 && args[1] == "--focus-next" {
		let text = drive_read(args[2])
		let mut skipped: String = " "
		for k in 3..<args.len() { skipped = skipped + args[k] + " " }
		let next = drive_focus_next(text, skipped)
		if next
			== "" { println("ESCALATE focus: every area empty") } else {
				print(drive_focus_set(text, next, 0))
			}
		return
	}
	if args.len() >= 4 && args[1] == "--focus-log" {
		let mut briefs: Vec[String] = []
		for k in 4..<args.len() { briefs.push(args[k].clone()) }
		print(drive_focus_body(drive_focus_record("2026-11-01 12:00", args[3], args[2], briefs, 0)))
		return
	}
	if args.len() >= 3 && args[1] == "--focus-issue" {
		let text = drive_read(args[2])
		for k in 3..<args.len() {
			let issue = drive_focus_issue(text, args[k], args[k])
			let name = args[k]
			if issue == "" { println(f"{name} none") } else { println(f"{name} {issue}") }
		}
		return
	}
	if args.len() == 4 && args[1] == "--run-body" {
		print(drive_run_comment(args[2], args[3].clone(), 0, "no report"))
		return
	}
	if args.len() >= 2 && args[1] == "--issue" {
		for k in 2..<args.len() {
			let issue = drive_issue(args[k])
			let name = args[k]
			if issue == "" { println(f"{name} none") } else { println(f"{name} {issue}") }
		}
		return
	}
	if args.len() == 3 && args[1] == "--post-body" {
		print(drive_post_body(drive_stem(args[2]), drive_read(args[2])))
		return
	}
	// The merge of a rejected push, without its checks and push (#1430): run
	// in a repository with FETCH_HEAD fetched, LOWER and BUILD the commands.
	if args.len() == 4 && args[1] == "--merge-fetched" {
		drive_merge_fetched(args[2], args[3])
		return
	}
	if args.len() == 4 && args[1] == "--found" {
		let found = drive_found(args[2], args[3].clone())
		if found == "" { println("none") } else { println(found) }
		return
	}
	if args.len() >= 3 && args[1] == "--queue-add" {
		let mut numbers: Vec[String] = []
		let mut i = 3
		while i < args.len() {
			numbers.push(args[i].clone())
			i += 1
		}
		print(drive_queue_add(drive_read(args[2]), numbers))
		return
	}
	if args.len() == 5 && args[1] == "--wip-after" {
		println(drive_wip_after(args[2].clone(), args[3].clone(), args[4].clone()))
		return
	}
	if args.len() == 6 && args[1] == "--found-issue" {
		println(drive_found_title(args[4].clone()))
		println(drive_found_labels(args[5].clone(), "views").join(","))
		print(drive_found_body(args[2].clone(), args[3].clone(), args[4].clone(), args[5].clone()))
		return
	}
	// The badges step alone (#1348), in the repository it runs in.
	if args.len() == 2 && args[1] == "--badges" {
		drive_badges()
		return
	}
	if args.len() == 3 && args[1] == "--blocks" {
		let urgent = drive_focus_blocking(args[2])
		if urgent == "" { println("none") } else { println(drive_stem(urgent)) }
		return
	}
	if focus {
		let exe = drive_exe()
		if exe == "" {
			println("BUILD cargo build --profile fast -p nikaia")
			process::exit(1)
		}
		drive_focus(exe, dry, max, ignore_red, lines_file)
		return
	}
	if dir == "" {
		println("usage: nikaia run scripts/drive.nika -- DIR [--max N] [--no-bump] [--ignore-ci-red] [--dry-run] [--lines FILE]")
		println("       nikaia run scripts/drive.nika -- --focus [--max N] [--dry-run]")
		process::exit(2)
	}
	if args.len() == 4 && args[1] == "--rewrite" {
		println(drive_rewrite(drive_read(args[2]), drive_read(args[3])))
		return
	}
	if args.len() == 5 && args[1] == "--ci-wait" {
		drive_ci_wait(args[2], args[3], args[4].clone())
		return
	}
	if args.len() == 3 && args[1] == "--docs-only" {
		let mut paths: Vec[String] = []
		for line in drive_read(args[2]).split("\n") {
			let p = line.trim().clone()
			if p == "" { continue }
			if drive_docs_path(p) { println(f"docs {p}") } else { println(f"code {p}") }
			paths.push(p)
		}
		if drive_docs_only(paths) { println("docs-only") } else { println("suite") }
		return
	}
	if args.len() == 3 && args[1] == "--named-filters" {
		let mut paths: Vec[String] = []
		for line in drive_read(args[2]).split("\n") {
			if line.trim() != "" { paths.push(line.trim().clone()) }
		}
		println(drive_named_filters(paths).join(" "))
		return
	}
	if args.len() == 3 && args[1] == "--changed" {
		if drive_read(args[2]) != drive_read("scripts/drive.nika") {
			println("RESTART drive: scripts/drive.nika changed")
		} else {
			println("same")
		}
		return
	}
	let exe = drive_exe()
	if exe == "" {
		println("BUILD cargo build --profile fast -p nikaia")
		process::exit(1)
	}
	let mut runs: i64 = 0
	let mut bumps: i64 = 0
	let own = drive_read("scripts/drive.nika")
	while runs <= max {
		if !dry && drive_read("scripts/drive.nika") != own {
			drive_settle(exe.clone(), dir)
			drive_restart(exe.clone())
		}
		// The lane's ready issues are queued here too, the area being DIR's
		// last name (docs/briefs/yaml: yaml), as in --focus.
		if !dry && lines_file == "" {
			let parts: Vec[String] = dir.trim_end_matches("/").split("/").collect()
			drive_queue(dir.clone(), parts[parts.len() - 1].clone())
		}
		let cyc = drive_cycle(exe.clone(), dir.clone(), lines_file)
		let mut lines: Vec[String] = []
		for l in cyc.trim().split("\n") {
			if l.trim() != ""
				&& !(no_bump && l.trim().starts_with("BUMP")) { lines.push(l.trim().clone()) }
		}
		if lines.len() == 0 { drive_escalate("cycle.nika printed nothing") }
		let action = drive_action(lines, ignore_red)
		if action.starts_with("ESCALATE ") {
			drive_settle(exe.clone(), dir)
			drive_unlock()
			println(action)
			process::exit(2)
		}
		// A builder of the next batch and a bump wait for the batch's suite, and the cycle is read again (QA may
		// have committed, a push moved CI).
		if !dry && (action.starts_with("NEXT ") || action == "BUMP") && drive_testing() != "" {
			drive_settle(exe.clone(), dir)
			continue
		}
		// A bump pushes HEAD: commits not yet through the suite (a restart
		// between a batch and its suite leaves them) are tested first.
		if !dry && action == "BUMP" && drive_read(f"{dir}/unpushed.txt").trim() != "" {
			drive_suite(exe.clone(), dry, dir)
			drive_settle(exe.clone(), dir)
			continue
		}
		if action == "BUMP" {
			bumps += 1
			if bumps > 3 { drive_escalate("BUMP pending persists after --apply") }
			drive_say(dry, f"{exe} run scripts/cycle.nika -- {dir} --apply")
			if dry {
				println("DRY-RUN BUMP")
				return
			}
			let rel = process::run(exe, ["run", "scripts/cycle.nika", "--", dir.clone(), "--apply"])
			if rel.stdout.contains("PUSH REJECTED") { drive_escalate("bump push rejected") }
			continue
		}
		if runs >= max { drive_escalate(f"--max {max} agent runs reached") }
		if action.starts_with("NEXT ") {
			let brief = (action.strip_prefix("NEXT ") ?? "")
			drive_builder(exe.clone(), dry, dir, brief)
			runs += 1
			if dry {
				println(f"DRY-RUN NEXT {drive_stem(action)}")
				return
			}
			continue
		}
		// CUT, BATCH DONE or RED: stop for the supervisor.
		drive_stop(exe.clone(), dry, dir, (action.strip_prefix("STOP ") ?? ""))
		return
	}
	drive_settle(exe.clone(), dir)
}
