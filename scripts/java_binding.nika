// `nikaia bind java` against the C library's own example (ADR-284 D34, #1337).
//
//     nikaia run scripts/java_binding.nika
//
// Copies `examples/c-library` into a slot of target/java-binding, emptied
// first (scripts/slot.nika: a fixed place, so its build hits ADR-021 D14's
// rustc store, #2015), writes its Java binding
// there with `nikaia bind java` (the compiler `target/release/nikaia`, else
// `target/fast/nikaia`: a literal path, ADR-raw-sinks-1 D11), runs `use.c` against
// the library, compiles the binding and `java/Use.java` with
// `javac --release 22 -Xlint:all -Werror`, runs `Use` and checks that it
// prints what `use.c` prints. The binding is written against Java 22's
// `java.lang.foreign` (JEP 454): without a `javac` of 22 or later the script
// says `skipped:` and why, and exits 0; it never runs the binding on an older
// Java. CI runs it with JDK 22 (`.github/workflows/suite.yml`, shard `ledgers`).

use std::cli
use std::env
use std::fs
use std::path
use std::process
use std::text

fn java_binding_fail(what: String, out: process::Output) throws {
	println(f"java binding: {what} failed ({out.code})")
	println(out.stdout)
	println(out.stderr)
	process::exit(1)
}

// What a tool wrote on stderr, without the JVM's `Picked up
// JAVA_TOOL_OPTIONS` notice, which is not a warning of the compile.
fn java_binding_said(text: String) -> String {
	let mut kept = ""
	for line in text.lines() {
		if !line.starts_with("Picked up ") {
			kept = f"{kept}{line}\n"
		}
	}
	return kept.trim().clone()
}

// The major version `javac -version` names (`javac 22.0.2`), or 0.
fn java_binding_major(said: String) -> i64 {
	for word in said.split(" ") {
		let digits = word.trim().split(".").next() ?? continue
		let major = text::parse_i64(digits) ?? continue
		return major
	}
	return 0
}

// Runs this script again in a slot of target/java-binding (scripts/slot.nika,
// ADR-021 D14), with `--in <slot>`, and ends with its exit code.
fn java_binding_in_slot(exe: String) throws {
	let runs = env::current_exe()?.display() ?? exe.clone()
	let main = env::current_main()?.display() ?? "scripts/java_binding.nika"
	let ran = process::run(
		runs.clone(),
		["run", "scripts/slot.nika", "--", "target/java-binding", runs, "run", main, "--", "--in", "{slot}"]; stdout: process::Stream::Inherited,
		stderr: process::Stream::Inherited,
	)
	process::exit(ran.code)
}

// The part of NAMED below the working directory HERE: the slot
// scripts/slot.nika handed over, absolute. Refused where it lies elsewhere or
// reads as an option (ADR-raw-sinks-1 D14, D18); joined under a root of HERE
// again, it is a path the program made.
fn java_binding_below(here: String, named: String) -> String throws {
	let rel = named.strip_prefix(here + "/") ?? ""
	if !path::is_below(rel) || !process::is_operand(rel) {
		eprintln(f"refused: {named} is not a slot below {here}")
		process::exit(2)
	}
	return rel
}

fn main() throws {
	// The compiler is the checkout's own build, named by a literal path below
	// the working directory, which every run below keeps.
	let release = fs::exists("target/release/nikaia", fs::Root::Anywhere)
	let exe = match release {
		true => "target/release/nikaia",
		false => "target/fast/nikaia",
	}
	let mut slot: String = ""
	let mut named: String = ""
	for arg in cli::args() {
		if named == "--in" {
			slot = arg.clone()
		}
		named = arg
	}
	if slot == "" {
		java_binding_in_slot(exe)
		return
	}
	let here = fs::canonical(".", fs::Root::Dir(".")).display()
	let copy = fs::Root::Dir(here.clone()).join(java_binding_below(here, slot)).join("c-library").path().to_text()
	process::run("cp", ["-r", "examples/c-library", copy.clone()])
	process::run("rm", ["-rf", f"{copy}/target"])
	let bound = process::run(exe, ["bind", "java", "--project", copy.clone()])
	if bound.code != 0 {
		java_binding_fail("nikaia bind java", bound)
	}
	let made = f"{copy}/target/nikaia/c-library"
	let cc = process::run(
		"cc",
		[
			"-I",
			made.clone(),
			"use.c",
			"-L",
			made.clone(),
			"-lwordtally",
			"-o",
			"use",
		]; dir: copy.clone(),
	)
	if cc.code != 0 {
		java_binding_fail("cc use.c", cc)
	}
	// `./use` is started in `copy`, the child's directory.
	let c_ran = process::run(
		"./use",
		[]; dir: copy.clone(),
		env: [("LD_LIBRARY_PATH", made.clone())],
	)
	if c_ran.code != 0 {
		java_binding_fail("use.c", c_ran)
	}
	let version = process::run("javac", ["-version"])
	let major = java_binding_major(f"{version.stdout} {version.stderr}")
	if version.code != 0 || major < 22 {
		println(f"skipped: the Java binding needs javac 22 or later (java.lang.foreign, JEP 454); this host has `{java_binding_said(f"{version.stdout}\n{version.stderr}")}`")
		return
	}
	let binding = f"{made}/java/wordtally/Wordtally.java"
	let compiled = process::run(
		"javac",
		[
			"--release",
			"22",
			"-Xlint:all",
			"-Werror",
			"-d",
			f"{copy}/classes",
			binding,
			f"{copy}/java/Use.java",
		],
	)
	if compiled.code != 0 || java_binding_said(compiled.stderr) != "" {
		java_binding_fail("javac --release 22 -Xlint:all -Werror", compiled)
	}
	let java_ran = process::run(
		"java",
		["--enable-native-access=ALL-UNNAMED", "-cp", f"{copy}/classes", "Use"]; dir: copy,
		env: [("LD_LIBRARY_PATH", made)],
	)
	if java_ran.code != 0 {
		java_binding_fail("java Use", java_ran)
	}
	if java_ran.stdout != c_ran.stdout {
		println("java binding: Use.java does not print what use.c prints")
		println(f"use.c:\n{c_ran.stdout}")
		println(f"Use.java:\n{java_ran.stdout}")
		process::exit(1)
	}
	println(f"Use.java prints what use.c prints (javac {major})")
}
