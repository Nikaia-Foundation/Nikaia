// The committed ledgers of the examples and packages, built on a clean target
// (#1591, ADR-270 D4 and D22).
//
//     nikaia run scripts/ledgers.nika -- --check   [--tree TREE] [--exe NIKAIA]
//     nikaia run scripts/ledgers.nika -- --refresh [--tree TREE] [--exe NIKAIA]
//     nikaia run scripts/ledgers.nika -- --list    [--tree TREE]
//
// A ledger directory is `examples/*`, `packages/*` or `tests/page-examples`
// with a committed `nikaia.contracts`, `nikaia.derived` or `nikaia.proofs`.
// `tests/compiler` is left out: CI builds it `--locked` in place, and it
// builds every test program.
//
// Each run copies those directories into a temporary directory, from the git
// tree TREE (`git archive`) or, without `--tree`, from the working tree's
// tracked and unignored files, with no `target/` and its own
// `NIKAIA_CACHE_DIR`: a warm cache hides the questions a new bounds walk asks
// (docs/builder-facts.md). `crates` there links to this checkout's, so a path
// dependency on `../../crates/unsafe/...` resolves as it does here. Every
// directory is built with `build`: a library names its `artifact` in the
// manifest (Part III 13.3); one with neither `fn main` nor `artifact` is
// refused by `build` (NK1351), as by `check --rustc`, and reported as failed.
//
// `--check` builds each `--locked`, prints `DIR: ledger current` or `DIR:
// ledger stale` with the start of the difference, and exits 1 when one is
// stale or failed to build: CI's guard. `--refresh` builds each without
// `--locked` and copies every ledger file that changed and is not ignored
// back into this checkout, printing `refreshed PATH` for each, `failed DIR`
// for a build that failed (exit 1); it stages and commits nothing (the
// driver does, drive_ledgers). `nikaia.lock` is neither checked nor copied:
// it records the hash of the compiler binary, which differs with every build.
// `--list` prints each directory and the command it is built with. NIKAIA is
// the compiler (default `target/fast/nikaia`).

use std::cli
use std::fs
use std::process

fn ledgers_names() -> Vec[String] {
    return ["nikaia.contracts", "nikaia.derived", "nikaia.proofs"]
}

// The flags a directory needs that its manifest cannot say: `--cpu` has no
// key in `nikaia.toml` (ADR-002 D6), and crate-ledger's two functions exist
// only from `x86-64-v3` on (#788).
fn ledgers_flags(dir: String) -> Vec[String] {
    if dir == "examples/crate-ledger" { return ["--cpu=x86-64-v3"] }
    return []
}

// The ledger directories of the copy at TMP, sorted, so `examples/http` is
// built after `examples/hello-http`, which writes the dependency's ledger too.
fn ledgers_dirs(tmp: String) -> Vec[String] throws {
    let found = process::run(
        "sh",
        [
            "-c",
            f"cd '{tmp}' && ls -d examples/*/nikaia.contracts examples/*/nikaia.derived examples/*/nikaia.proofs packages/*/nikaia.contracts packages/*/nikaia.derived packages/*/nikaia.proofs tests/page-examples/nikaia.contracts tests/page-examples/nikaia.derived tests/page-examples/nikaia.proofs 2>/dev/null | xargs -n1 dirname | sort -u",
        ],
    ).stdout
    let mut dirs: Vec[String] = []
    for line in found.split("\n") {
        let d = line.trim().clone()
        if d != "" { dirs.push(d) }
    }
    return dirs
}

// The command line of DIR, `--locked` when LOCKED.
fn ledgers_command(dir: String, locked: bool) -> Vec[String] throws {
    let mut args: Vec[String] = ["build"]
    for f in ledgers_flags(dir) { args.push(f) }
    if locked { args.push("--locked") }
    return args
}

// Copies the ledger directories of TREE ("" for the working tree) into a new
// temporary directory and returns it.
fn ledgers_copy(tree: String) -> String throws {
    let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
    let roots = "examples packages tests/page-examples"
    let copied = if tree == "" {
        process::run(
            "sh",
            [
                "-c",
                f"git ls-files -co --exclude-standard -- {roots} | tar --ignore-failed-read -T - -cf - 2>/dev/null | tar -xf - -C '{tmp}'",
            ],
        )
    } else {
        process::run("sh", ["-c", f"git archive '{tree}' -- {roots} | tar -xf - -C '{tmp}'"])
    }
    if !copied.ok {
        eprintln(f"copying the ledger directories failed: {copied.stderr.trim()}")
        process::exit(2)
    }
    let here = process::run("pwd", []).stdout.trim().clone()
    process::run("ln", ["-s", f"{here}/crates", f"{tmp}/crates"])
    return tmp
}

// Runs NIKAIA with ARGS in TMP/DIR; the output, and whether it succeeded.
fn ledgers_build(
    nikaia: String,
    tmp: String,
    dir: String,
    args: Vec[String],
) -> (String, bool) throws {
    let mut line = f"cd '{tmp}/{dir}' && env -u CARGO_TARGET_DIR RUST_BACKTRACE=0 NIKAIA_CACHE_DIR='{tmp}/cache' '{nikaia}'"
    for a in args { line = line + f" '{a}'" }
    let out = process::run("sh", ["-c", line + " 2>&1"])
    return (out.stdout, out.ok)
}

fn ledgers_head(body: String, n: i64) -> String {
    let mut out: Vec[String] = []
    for line in body.split("\n") {
        if out.len() == n { break }
        out.push(line.clone())
    }
    return out.join("\n")
}

fn ledgers_check(nikaia: String, tmp: String) -> bool throws {
    let mut green = true
    for dir in ledgers_dirs(tmp.clone()) {
        let (out, ok) = ledgers_build(
            nikaia.clone(),
            tmp.clone(),
            dir.clone(),
            ledgers_command(dir.clone(), true),
        )
        if ok {
            println(f"{dir}: ledger current")
            continue
        }
        green = false
        if out.contains("--locked") {
            println(f"{dir}: ledger stale")
        } else {
            println(f"{dir}: build failed")
        }
        println(ledgers_head(out, 40))
    }
    return green
}

fn ledgers_refresh(nikaia: String, tmp: String) -> bool throws {
    let mut green = true
    for dir in ledgers_dirs(tmp.clone()) {
        let (out, ok) = ledgers_build(
            nikaia.clone(),
            tmp.clone(),
            dir.clone(),
            ledgers_command(dir.clone(), false),
        )
        if !ok {
            green = false
            println(f"failed {dir}")
            println(ledgers_head(out, 40))
        }
    }
    for dir in ledgers_dirs(tmp.clone()) {
        for name in ledgers_names() {
            let path = f"{dir}/{name}"
            let built = f"{tmp}/{path}"
            if !fs::exists(built.clone(), fs::Root::Anywhere) { continue }
            if process::run("git", ["check-ignore", "-q", path.clone()]).ok { continue }
            if process::run("cmp", ["-s", built.clone(), path.clone()]).ok { continue }
            process::run("cp", [built, path.clone()])
            println(f"refreshed {path}")
        }
    }
    return green
}

fn main() throws {
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    let mut mode: String = ""
    let mut tree: String = ""
    let mut nikaia: String = "target/fast/nikaia"
    let mut i = 1
    while i < args.len() {
        if args[i] == "--tree" && i + 1 < args.len() {
            tree = args[i + 1].clone()
            i += 1
        } else if args[i] == "--exe" && i + 1 < args.len() {
            nikaia = args[i + 1].clone()
            i += 1
        } else {
            mode = args[i].clone()
        }
        i += 1
    }
    if mode != "--check" && mode != "--refresh" && mode != "--list" {
        println("usage: nikaia run scripts/ledgers.nika -- --check|--refresh|--list [--tree TREE] [--exe NIKAIA]")
        process::exit(2)
    }
    let exe = process::run("realpath", [nikaia]).stdout.trim().clone()
    let tmp = ledgers_copy(tree)
    let mut green = true
    if mode == "--list" {
        for dir in ledgers_dirs(tmp.clone()) {
            let line = ledgers_command(dir.clone(), true).join(" ")
            println(f"{dir}: nikaia {line}")
        }
    } else if mode == "--check" {
        green = ledgers_check(exe, tmp.clone())
    } else {
        green = ledgers_refresh(exe, tmp.clone())
    }
    process::run("rm", ["-rf", tmp])
    if !green { process::exit(1) }
}
