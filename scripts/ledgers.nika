// The committed ledgers of the examples and packages, built on a clean target
// (#1591, ADR-270 D4 and D22).
//
//     nikaia run scripts/ledgers.nika -- --check   [--tree TREE] [--exe NIKAIA]
//     nikaia run scripts/ledgers.nika -- --refresh [--tree TREE] [--exe NIKAIA]
//     nikaia run scripts/ledgers.nika -- --list    [--tree TREE]
//
// A ledger directory is every project built in place outside `crates/`
// (#2797): `examples/*`, `examples/foreign-runtime/serve`, `packages/*`,
// `packages/logic/rod`, `tests/page-examples`, `tests/language`,
// `tests/build-time` and `tests/compiler`, each found by its `nikaia.toml`.
// Each commits its `nikaia.lock` and the ledgers its build writes
// (`nikaia.contracts`, `nikaia.derived`, `nikaia.proofs`). Of
// `tests/compiler` only the manifest, the ledgers and `src/` are copied, not
// its test programs; CI also builds it `--locked` in place. A cold build
// resolves the newest crate versions, which the in-place build's `target/`
// keeps from before, so only this one checks and refreshes its lock. Left
// out:
//
// * `examples/foreign-runtime/{crossing,smuggled}`: they must not build, and
//   who refuses them is the finding (their README).
// * `examples/fortunes`: it uses `postgres` and a handler without a request,
//   which the compiler cannot type yet (NK1245, #105); it is checked by hand
//   until that is built, and joins the sweep then.
// * `benches/yaml/*`: `bench.nika` builds each program from a copy with its
//   own manifest, never in place, and the checked-in package has no
//   `src/main.nika`.
// * The fixtures under `tests/compiler/*/` and `tests/accepted/`: a test's
//   input, built by that test (some are refused on purpose).
// * The toolchain's packages in `crates/nikaia-std/src/`: `lower-std` lowers
//   them, never a build in place.
//
// Each run copies those directories into a temporary directory, from the git
// tree TREE (`git archive`) or, without `--tree`, from the working tree's
// tracked and unignored files, with no `target/` and its own
// `NIKAIA_CACHE_DIR`: a warm cache hides the questions a new bounds walk asks
// (docs/builder-facts.md). `crates` there links to this checkout's, so a path
// dependency on `../../crates/unsafe/...` resolves as it does here. Every
// directory is built with `build`: a library names its `artifact` in the
// manifest (Part III 13.3); one with neither `fn main` nor `artifact` is
// refused by `build` (NK1351), as by `check --rustc`, and reported as failed.
//
// `--check` builds each `--locked`, prints `DIR: ledger current` or `DIR:
// ledger stale` with the start of the difference, and exits 1 when one is
// stale or failed to build: CI's guard. `--refresh` builds each without
// `--locked` and copies every ledger file that changed and is not ignored
// back into this checkout, printing `refreshed PATH` for each, `failed DIR`
// for a build that failed (exit 1); it stages and commits nothing (the
// driver does, drive_ledgers). A tracked `nikaia.lock` is a ledger too: it
// records the toolchain, the units' source hashes and the resolved
// dependencies, never the compiler's identity (ADR-021 D2, D3, #1945), so it
// changes only when those do. `--check` compares the lock the build wrote
// with the one copied in (stale when they differ, the toolchain line apart), and `--refresh` copies it
// back; a git-ignored lock is never copied in, so it is neither checked nor
// refreshed. A directory without a lock gets one from its first build, which
// `--refresh` copies back.
// `--check` and `--refresh` say on standard error how many seconds each
// directory's build took (#2804).
// `--list` prints each directory and the command it is built with. NIKAIA is
// the compiler (default `target/fast/nikaia`).

use std::cli
use std::fs
use std::process
use std::time

fn ledgers_names() -> Vec[String] {
	return ["nikaia.contracts", "nikaia.derived", "nikaia.proofs", "nikaia.lock"]
}

// Keeps the `nikaia.lock` of COPY/DIR as it was copied in, under
// COPY/committed, before a build rewrites it; a directory without one (its
// lock is git-ignored, or there is none) keeps nothing.
fn ledgers_keep_lock(copy: ref fs::Root, dir: String) throws {
	if !fs::exists(f"{dir}/nikaia.lock", copy) { return }
	let tmp = copy.path().to_text()
	let lock = f"{tmp}/{dir}/nikaia.lock"
	process::run("mkdir", ["-p", f"{tmp}/committed/{dir}"])
	process::run("cp", [lock, f"{tmp}/committed/{dir}/nikaia.lock"])
}

// Whether the build left the kept `nikaia.lock` of COPY/DIR as it was: true
// for a directory that kept none. The difference, when there is one. The
// `toolchain` line is left out of the comparison: `rust-toolchain.toml` names
// the floating `stable` (ADR-001 D1), so the runner's rustc moves without any
// change of ours; the line is rewritten with the next real change.
fn ledgers_lock_current(copy: ref fs::Root, dir: String) -> (bool, String) throws {
	if !fs::exists(f"committed/{dir}/nikaia.lock", copy) { return (true, "") }
	let tmp = copy.path().to_text()
	let kept = f"{tmp}/committed/{dir}/nikaia.lock"
	let diff = process::run("diff", ["-u", "-I", "^toolchain = ", kept, f"{tmp}/{dir}/nikaia.lock"])
	return (diff.ok, diff.stdout)
}

// The flags a directory needs that its manifest cannot say: `--cpu` has no
// key in `nikaia.toml` (ADR-002 D6), and crate-ledger's two functions exist
// only from `x86-64-v3` on (#788).
fn ledgers_flags(dir: String) -> Vec[String] {
	if dir == "examples/crate-ledger" { return ["--cpu=x86-64-v3"] }
	return []
}

// The ledger directories of the copy at TMP, sorted, so `examples/http` is
// built after `examples/hello-http`, which writes the dependency's ledger too.
fn ledgers_dirs(tmp: String) -> Vec[String] throws {
	let found = process::run(
		"sh",
		[
			"-c",
			f"cd '{tmp}' && ls -d examples/*/nikaia.toml examples/foreign-runtime/serve/nikaia.toml packages/*/nikaia.toml packages/logic/rod/nikaia.toml tests/page-examples/nikaia.toml tests/language/nikaia.toml tests/build-time/nikaia.toml tests/compiler/nikaia.toml 2>/dev/null | grep -v '^examples/fortunes/' | xargs -n1 dirname | sort -u",
		],
	).stdout
	let mut dirs: Vec[String] = []
	for line in found.split("\n") {
		let d = line.trim().clone()
		if d != "" { dirs.push(d) }
	}
	return dirs
}

// The command line of DIR, `--locked` when LOCKED.
fn ledgers_command(dir: String, locked: bool) -> Vec[String] throws {
	let mut args: Vec[String] = ["build"]
	for f in ledgers_flags(dir) { args.push(f) }
	if locked { args.push("--locked") }
	return args
}

// Copies the ledger directories of TREE ("" for the working tree) into a new
// fresh directory of `fs::scratch()` and returns it (ADR-raw-sinks-1 D12).
fn ledgers_copy(tree: String) -> fs::Root throws {
	let copy = fs::scratch()
	let tmp = copy.path().to_text()
	let roots = "examples packages tests/page-examples tests/language tests/build-time 'tests/compiler/nikaia.*' tests/compiler/src"
	let copied = if tree == "" {
		process::run(
			"sh",
			[
				"-c",
				f"git ls-files -co --exclude-standard -- {roots} | tar --ignore-failed-read -T - -cf - 2>/dev/null | tar -xf - -C '{tmp}'",
			],
		)
	} else {
		process::run("sh", ["-c", f"git archive '{tree}' -- {roots} | tar -xf - -C '{tmp}'"])
	}
	if !copied.ok {
		eprintln(f"copying the ledger directories failed: {copied.stderr.trim()}")
		process::exit(2)
	}
	let here = process::run("pwd", []).stdout.trim().clone()
	process::run("ln", ["-s", f"{here}/crates", f"{tmp}/crates"])
	return copy
}

// Runs NIKAIA with ARGS in TMP/DIR; the output, and whether it succeeded.
fn ledgers_build(
	nikaia: String,
	tmp: String,
	dir: String,
	args: Vec[String],
) -> (String, bool) throws {
	let mut line = f"cd '{tmp}/{dir}' && env -u CARGO_TARGET_DIR RUST_BACKTRACE=0 NIKAIA_CACHE_DIR='{tmp}/cache' '{nikaia}'"
	for a in args { line = line + f" '{a}'" }
	let out = process::run("sh", ["-c", line + " 2>&1"])
	return (out.stdout, out.ok)
}

// Says on standard error how long the build of DIR took since BEGAN, so a
// slower shard names its directory (#2804); standard output stays the
// verdicts, which do not change from run to run.
fn ledgers_took(dir: String, began: time::Instant) throws {
	let ms = began.elapsed().in_millis()
	eprintln(f"{dir}: built in {ms / 1000} s")
}

fn ledgers_head(body: String, n: i64) -> String {
	let mut out: Vec[String] = []
	for line in body.split("\n") {
		if out.len() == n { break }
		out.push(line.clone())
	}
	return out.join("\n")
}

fn ledgers_check(nikaia: String, copy: ref fs::Root) -> bool throws {
	let tmp = copy.path().to_text()
	let mut green = true
	let dirs = ledgers_dirs(tmp.clone())
	for dir in dirs { ledgers_keep_lock(copy, dir.clone()) }
	for dir in dirs {
		let began = time::now()
		let (out, ok) = ledgers_build(
			nikaia.clone(),
			tmp.clone(),
			dir.clone(),
			ledgers_command(dir.clone(), true),
		)
		ledgers_took(dir.clone(), began)
		let (lock_current, lock_diff) = ledgers_lock_current(copy, dir.clone())
		if ok && lock_current {
			println(f"{dir}: ledger current")
			continue
		}
		green = false
		if ok {
			println(f"{dir}: ledger stale")
			println(ledgers_head(lock_diff, 40))
			continue
		}
		if out.contains("--locked") {
			println(f"{dir}: ledger stale")
		} else {
			println(f"{dir}: build failed")
		}
		println(ledgers_head(out, 40))
	}
	return green
}

fn ledgers_refresh(nikaia: String, copy: ref fs::Root) -> bool throws {
	let tmp = copy.path().to_text()
	let here = fs::Root::Dir(".")
	let mut green = true
	for dir in ledgers_dirs(tmp.clone()) {
		let began = time::now()
		let (out, ok) = ledgers_build(
			nikaia.clone(),
			tmp.clone(),
			dir.clone(),
			ledgers_command(dir.clone(), false),
		)
		ledgers_took(dir.clone(), began)
		if !ok {
			green = false
			println(f"failed {dir}")
			println(ledgers_head(out, 40))
		}
	}
	for dir in ledgers_dirs(tmp.clone()) {
		for name in ledgers_names() {
			let path = f"{dir}/{name}"
			let built = f"{tmp}/{path}"
			if !fs::exists(path.clone(), copy) { continue }
			if process::run("git", ["check-ignore", "-q", path.clone()]).ok { continue }
			if process::run("cmp", ["-s", built.clone(), path.clone()]).ok { continue }
			process::run("cp", [built, path.clone()])
			println(f"refreshed {path}")
		}
		// The long certificates go with `nikaia.proofs`, a removed one too:
		// one no entry points at fails a `--locked` build.
		let path = f"{dir}/nikaia.proofs.d"
		let built = f"{tmp}/{path}"
		let has_built = fs::exists(path.clone(), copy)
		let has_path = fs::exists(path.clone(), here)
		if !has_built && !has_path { continue }
		if has_built
			&& has_path
			&& process::run("diff", ["-rq", built.clone(), path.clone()]).ok { continue }
		process::run("rm", ["-rf", path.clone()])
		if has_built { process::run("cp", ["-r", built, path.clone()]) }
		println(f"refreshed {path}")
	}
	return green
}

fn main() throws {
	let mut args: Vec[String] = []
	for a in cli::args() { args.push(a) }
	let mut mode: String = ""
	let mut tree: String = ""
	let mut nikaia: String = "target/fast/nikaia"
	let mut i = 1
	while i < args.len() {
		if args[i] == "--tree" && i + 1 < args.len() {
			tree = args[i + 1].clone()
			i += 1
		} else if args[i] == "--exe" && i + 1 < args.len() {
			nikaia = args[i + 1].clone()
			i += 1
		} else {
			mode = args[i].clone()
		}
		i += 1
	}
	if mode != "--check" && mode != "--refresh" && mode != "--list" {
		println("usage: nikaia run scripts/ledgers.nika -- --check|--refresh|--list [--tree TREE] [--exe NIKAIA]")
		process::exit(2)
	}
	let exe = process::run("realpath", [nikaia]).stdout.trim().clone()
	let copy = ledgers_copy(tree)
	let tmp = copy.path().to_text()
	let mut green = true
	if mode == "--list" {
		for dir in ledgers_dirs(tmp.clone()) {
			let line = ledgers_command(dir.clone(), true).join(" ")
			println(f"{dir}: nikaia {line}")
		}
	} else if mode == "--check" {
		green = ledgers_check(exe, copy)
	} else {
		green = ledgers_refresh(exe, copy)
	}
	process::run("rm", ["-rf", tmp])
	if !green { process::exit(1) }
}
