// The release job as a program: reads the builders' reports, looks at CI on
// `develop`, and raises the version once for every finished report that has a
// changelog line (`scripts/bump.py new`), so the main session does not.
//
//     nikaia run scripts/release.nika -- [--dry-run] [--loop MINUTES] REPORTS_DIR
//
// A report is `REPORTS_DIR/*.report.md` with the lines `Result:`, `Pushed:`
// and `Changelog:` (`none` for no entry); the ones already released are named
// in `REPORTS_DIR/released.txt`, one per line. A report is released when its
// `Result:` is `done`, or `partial` with a line `Supervisor: <date>: accepted
// ...` or `auto-accepted ...` (batch.nika, #1694): its `Changelog:` line goes
// into the entry, and the issues its commit fixes do not go into the heading
// (the issue stays open). Without that file nothing is
// guessed (#1111: an mtime guess lost a lane's entries): it prints `STOP
// REPORTS_DIR/released.txt missing` and raises nothing; `cycle.nika` writes it
// empty on a lane's first run. The architect's and QA's reports
// (`architect-*`, `qa-*`) are not builder reports and are not read. Prints at
// most five lines:
//
//     CI <sha8> <state> [failed jobs]   (CI unknown when `gh` fails)
//     STOP <report>: <Result or Deviation line> | STOP <dir>/released.txt missing
//     RED <sha8> <jobs>                 (the tip of develop is red: no bump)
//     BUMP 0.0.X <titles> | NO BUMP: <why> | PUSH REJECTED
//
// The heading of the entry is the one released report's commit subject (with
// the issues it fixes), or `Builders' changes (#a, #b)` for several; equal
// `Changelog:` lines (after trimming whitespace and a trailing `.`) give one
// bullet. Rows the agents added to the Runs table of `docs/tokenspeed.md` go
// into the version's commit, when nothing else in that file changed (#1886).
// Test flags: `--heading TITLE... [--fixes #N...]`, `--entries LINE...`,
// `--rows-added OLD NEW` (prints whether NEW only adds Runs rows to OLD),
// `--stage-version FILE` (stages HEAD's FILE with the working file's version
// and date lines, in the current directory's repository).
//
// `--dry-run` prints what it would do and changes nothing. `--loop M` runs
// again every M minutes, prints only lines that changed, and ends on RED or
// when the file `REPORTS_DIR/STOP` exists.

use std::cli
use std::fs
use std::process
use std::text
use std::time

struct ReleaseReport {
    name: String,
    result: String,
    pushed: String,
    deviation: String,
    changelog: String,
    accepted: bool,
}

// A line of output is at most 160 characters.
fn release_cap(line: String) -> String throws {
    if line.len() <= 160 { return line }
    return line.bytes[0..157].text() + "..."
}

// `#a #b ...` of the titles, `n entries`.
fn release_summary(titles: Vec[String]) -> String {
    let mut issues: Vec[String] = []
    for t in titles {
        for word in t.split(" ") {
            let w = word.trim().trim_end_matches(",").trim_end_matches(";").trim_end_matches(")").trim_start_matches("(")
            if w.starts_with("#") && w.len() > 1 && !issues.contains(w.clone()) { issues.push(w.clone()) }
        }
    }
    return f"{titles.len()} entries, " + issues.join(" ")
}

fn release_field(text: String, key: String) -> String {
    for line in text.split("\n") {
        if line.starts_with(key.clone()) {
            return (line.strip_prefix(key.clone()) ?? "").trim().clone()
        }
    }
    return ""
}

// A `Supervisor:` line that accepts the report as written (`accepted ...`, or
// batch.nika's `auto-accepted ...`), as batch.nika reads it.
fn release_accepted(text: String) -> bool {
    for line in text.split("\n") {
        if line.starts_with("Supervisor:") && (line.contains(": accepted") || line.contains(": auto-accepted")) { return true }
    }
    return false
}

// The first word of `Result:`, without a trailing `.` or `,`.
fn release_word(result: String) -> String {
    return result.split(" ").collect()[0].trim_end_matches(".").trim_end_matches(",").clone()
}

fn release_git(args: Vec[String]) -> String throws {
    let out = process::run("git", args)
    if !out.ok { return "" }
    return out.stdout.trim().clone()
}

fn release_sha(pushed: String) -> String {
    return (pushed.strip_prefix("local ") ?? pushed).trim().clone()
}

// The issues the pushed commit's message fixes (`Fixes #N`), each once.
fn release_fixes(pushed: String) -> Vec[String] throws {
    let body = release_git(["log", "-1", "--format=%B", release_sha(pushed)])
    let mut fixes: Vec[String] = []
    for line in body.split("\n") {
        for word in line.split(" ") {
            let w = word.trim().trim_end_matches(",").trim_end_matches(";").trim_end_matches(".")
            if w.starts_with("#") && body.contains(f"Fixes {w}") && !fixes.contains(w.clone()) { fixes.push(w.clone()) }
        }
    }
    return fixes
}

// The subject of the pushed commit, with the issues its message fixes. A
// driver's builder reports `Pushed: local <sha>` (the driver pushes later).
fn release_title(pushed: String) -> String throws {
    let subject = release_git(["log", "-1", "--format=%s", release_sha(pushed.clone())])
    let mut fixes: Vec[String] = []
    for w in release_fixes(pushed) {
        if !subject.contains(w.clone()) { fixes.push(w) }
    }
    if fixes.len() == 0 { return subject }
    return subject + " (" + fixes.join(", ") + ")"
}

// The bold heading of the entry (supervisor, 2026-11-06): one released report
// gives its title; several give `Builders' changes (#a, #b)` with the issues
// they fix, or `Builders' changes` when none is fixed; subjects are not chained.
fn release_heading(titles: Vec[String], fixes: Vec[String]) -> String {
    if titles.len() == 1 { return titles[0].clone() }
    if fixes.len() == 0 { return "Builders' changes" }
    return "Builders' changes (" + fixes.join(", ") + ")"
}

// The changelog lines, each once: two lines equal after trimming whitespace
// and a trailing `.` give one bullet (the first one's spelling).
fn release_entries(lines: Vec[String]) -> Vec[String] {
    let mut keys: Vec[String] = []
    let mut out: Vec[String] = []
    for line in lines {
        let t = line.trim()
        let key = (t.strip_suffix(".") ?? t).trim().clone()
        if keys.contains(key.clone()) { continue }
        keys.push(key)
        out.push(line.clone())
    }
    return out
}

// `CI <sha8> <state>`, with the failed jobs' names when the tip failed.
fn release_ci() -> String throws {
    let runs = process::run("gh", ["api", "repos/:owner/:repo/actions/runs?branch=develop&per_page=10", "--jq", ".workflow_runs[] | [.head_sha[0:8], .status, (.conclusion // \"none\"), (.id|tostring)] | join(\" \")"])
    if !runs.ok { return "CI unknown" }
    let lines = runs.stdout.trim().split("\n").collect()
    if lines.len() == 0 || lines[0] == "" { return "CI unknown" }
    let parts = lines[0].split(" ").collect()
    if parts.len() < 4 { return "CI unknown" }
    let sha = parts[0].clone()
    let mut state = parts[1].clone()
    if state == "completed" { state = parts[2].clone() }
    if state != "failure" { return f"CI {sha} {state}" }
    let jobs = process::run("gh", ["api", f"repos/:owner/:repo/actions/runs/{parts[3]}/jobs", "--jq", ".jobs[] | select(.conclusion == \"failure\") | .name"])
    let names = jobs.stdout.trim().split("\n").collect().join(",")
    return f"CI {sha} failure {names}"
}

// Whether a report is a builder's: the architect's and QA's are not (#1111).
fn release_builder_report(name: String) -> bool {
    return name.ends_with(".report.md") && !name.starts_with("architect-") && !name.starts_with("qa-")
}

// The reports of `dir` that `released.txt` does not name; the caller has
// checked that the file exists.
fn release_reports(dir: String) -> Vec[ReleaseReport] throws {
    let mut released: Vec[String] = []
    for line in fs::read_to_string(f"{dir}/released.txt", fs::Root::Anywhere).split("\n") {
        let parts = line.trim().split("/").collect()
        if parts.len() > 0 { released.push(parts[parts.len() - 1].clone()) }
    }
    let mut found: Vec[ReleaseReport] = []
    for entry in fs::read_dir(dir.clone(), fs::Root::Anywhere) {
        let name = entry.to_text()
        if !release_builder_report(name.clone()) || released.contains(name.clone()) { continue }
        let text = fs::read_to_string(f"{dir}/{name}", fs::Root::Anywhere)
        found.push(ReleaseReport {
            name: name,
            result: release_field(text.clone(), "Result:"),
            pushed: release_field(text.clone(), "Pushed:"),
            deviation: release_field(text.clone(), "Deviation:"),
            changelog: release_field(text.clone(), "Changelog:"),
            accepted: release_accepted(text),
        })
    }
    return found
}

fn release_changed() -> Vec[String] throws {
    let mut files: Vec[String] = []
    let listed = release_git(["diff", "--name-only", "HEAD"]) + "\n" + release_git(["ls-files", "--others", "--exclude-standard"])
    for line in listed.split("\n") {
        if line != "" { files.push(line.clone()) }
    }
    return files
}

fn release_version() -> String throws {
    for line in fs::read_to_string("CHANGELOG.md", fs::Root::Anywhere).split("\n") {
        if line.starts_with("## [") { return (line.strip_prefix("## [") ?? "").split("]").collect()[0].clone() }
    }
    return "?"
}

// Whether `new` is `old` with only rows added to its Runs table (#1886): each
// line `old` lacks starts with `| ` and stands below `## Runs`, and no line of
// `old` is gone or changed. The agents append these rows (`agent.nika`) and
// the release commits them.
fn release_rows_added(old: String, new: String) -> bool {
    let was = old.split("\n").collect()
    let now = new.split("\n").collect()
    let mut j = 0
    let mut in_runs = false
    for line in now {
        if j < was.len() && line == was[j] {
            if line.starts_with("## ") { in_runs = line.starts_with("## Runs") }
            j += 1
        } else if !(in_runs && line.starts_with("| ")) {
            return false
        }
    }
    return j == was.len()
}

// The specification parts whose `**Version:**` and `**Date:**` lines bump.py rewrites.
fn release_parts() -> Vec[String] {
    return ["docs/specification/10-nikaia-light.md", "docs/specification/20-nikaia-advance.md", "docs/specification/30-nikaia-tooling.md"]
}

// `head` with its first `**Version:**` and `**Date:**` lines replaced by the
// first such lines of `now`, the rest of `head` as it is (#1896).
fn release_version_lines(head: String, now: String) -> String {
    let mut version = String()
    let mut date = String()
    for line in now.split("\n") {
        if version == "" && line.starts_with("**Version:**") { version = line.to_string().clone() }
        if date == "" && line.starts_with("**Date:**") { date = line.to_string().clone() }
    }
    let mut out: Vec[String] = []
    let mut put_version = false
    let mut put_date = false
    for line in head.split("\n") {
        if !put_version && version != "" && line.starts_with("**Version:**") {
            out.push(version.clone())
            put_version = true
        } else if !put_date && date != "" && line.starts_with("**Date:**") {
            out.push(date.clone())
            put_date = true
        } else {
            out.push(line.clone())
        }
    }
    return out.join("\n")
}

// Stages only the release's own lines of a file another lane has changed too
// (#1896): HEAD's text with the working file's version and date lines goes
// into the index; the working file keeps both, and the other hunks stay
// unstaged. Whether it worked.
fn release_stage_own(file: String) -> bool throws {
    let head = process::run("git", ["show", f"HEAD:{file}"])
    if !head.ok { return false }
    let blob = release_version_lines(head.stdout, fs::read_to_string(file.clone(), fs::Root::Anywhere))
    let sha = process::run("git", ["hash-object", "-w", "--stdin"]; stdin: process::Input::Text(blob))
    if !sha.ok { return false }
    return process::run("git", ["update-index", "--cacheinfo", f"100644,{sha.stdout.trim()},{file}"]).ok
}

// Raises the version, commits the files bump.py changed and pushes; the line to print.
// A specification part another lane has changed is not added whole: only the
// version and date lines are staged (`release_stage_own`, #1896), so that
// lane's paragraph stays in the working file, uncommitted. A dirty
// `CHANGELOG.md` or badge is no lane's to have, and stops the bump.
// It also commits the rows the agents added to `docs/tokenspeed.md`, when the
// file changed by nothing else (#1886).
fn release_bump(title: String, entries: Vec[String]) -> String throws {
    release_git(["fetch", "origin", "develop"])
    let before = release_changed()
    for f in before {
        if f == "CHANGELOG.md" || f.starts_with("assets/badges/") {
            return f"NO BUMP: {f} has changes no release made"
        }
    }
    let mut args: Vec[String] = ["scripts/bump.py", "new", "--title", title.clone()]
    for e in entries {
        args.push("--entry")
        args.push(e.clone())
    }
    let bumped = process::run("python3", args)
    if !bumped.ok { return "NO BUMP: bump.py new failed" }
    if !process::run("python3", ["scripts/bump.py", "check"]).ok { return "NO BUMP: bump.py check failed" }
    let mut add: Vec[String] = ["add"]
    for f in release_changed() {
        if !before.contains(f.clone()) { add.push(f) }
    }
    let rows = "docs/tokenspeed.md"
    if before.contains(rows) {
        let old = process::run("git", ["show", f"HEAD:{rows}"])
        if old.ok && release_rows_added(old.stdout, fs::read_to_string(rows, fs::Root::Anywhere)) { add.push(rows) }
    }
    release_git(add)
    for f in before {
        if release_parts().contains(f.clone()) && !release_stage_own(f.clone()) { return f"NO BUMP: staging {f} failed" }
    }
    let version = release_version()
    let mut message = f"{version}: {title}\n"
    for line in release_git(["log", "-1", "--format=%B"]).split("\n") {
        if line.starts_with("Co-Authored-By:") || line.starts_with("Claude-Session:") { message = message + "\n" + line }
    }
    if !process::run("git", ["commit", "-m", message]).ok { return "NO BUMP: commit failed" }
    if !process::run("git", ["push", "origin", "HEAD:develop"]).ok {
        process::run("git", ["pull", "--rebase", "origin", "develop"])
        process::run("python3", ["scripts/bump.py", "rebase-fix"])
        if !process::run("git", ["push", "origin", "HEAD:develop"]).ok { return "PUSH REJECTED" }
    }
    return f"BUMP {release_version()}"
}

fn release_once(dir: String, dry: bool) -> Vec[String] throws {
    let mut lines: Vec[String] = []
    let ci = release_ci()
    let mut red: String = ""
    if ci.contains(" failure") { red = "RED " + (ci.replace(" failure", "").strip_prefix("CI ") ?? "") }
    lines.push(ci)
    let mut titles: Vec[String] = []
    let mut entries: Vec[String] = []
    let mut fixes: Vec[String] = []
    let mut names: Vec[String] = []
    if !fs::exists(f"{dir}/released.txt", fs::Root::Anywhere) {
        lines.push(release_cap(f"STOP {dir}/released.txt missing"))
        return lines
    }
    for r in release_reports(dir.clone()) {
        let word = release_word(r.result.clone())
        let partial = word == "partial" && r.accepted
        if (word != "done" && !partial) || r.pushed == "rejected" || r.pushed == "none" || r.pushed == "" {
            let mut why = f"Result: {r.result}"
            if word == "done" { why = f"Deviation: {r.deviation}" }
            if lines.len() < 4 { lines.push(release_cap(f"STOP {r.name}: {why}")) }
            continue
        }
        if r.changelog == "none" || r.changelog == "" { continue }
        titles.push(release_title(r.pushed.clone()))
        if !partial {
            for w in release_fixes(r.pushed.clone()) {
                if !fixes.contains(w.clone()) { fixes.push(w) }
            }
        }
        entries.push(r.changelog.clone())
        names.push(r.name.clone())
    }
    if red != "" {
        lines.push(red)
        return lines
    }
    if entries.len() == 0 {
        lines.push("NO BUMP: no changelog line")
        return lines
    }
    let heading = release_heading(titles.clone(), fixes)
    let bullets = release_entries(entries)
    if dry {
        lines.push(release_cap(f"BUMP (dry run) {heading}: {bullets.len()} entries"))
        return lines
    }
    let summary = release_summary(titles)
    let done = release_bump(heading, bullets)
    if done.starts_with("BUMP") {
        let list = f"{dir}/released.txt"
        let mut old = fs::read_to_string(list.clone(), fs::Root::Anywhere)
        if old != "" && !old.ends_with("\n") { old = old + "\n" }
        fs::write(list, fs::Root::Anywhere, old + names.join("\n") + "\n")
    }
    if done.starts_with("BUMP") {
        lines.push(release_cap(f"{done}: {summary}"))
    } else {
        lines.push(release_cap(done))
    }
    return lines
}

// The test flags: `--heading TITLE... [--fixes #N...]` prints the heading,
// `--entries LINE...` the bullets, one per line, `--rows-added OLD NEW` whether
// NEW only adds Runs rows to OLD, `--stage-version FILE` whether staging
// FILE's own version lines worked.
fn release_test(args: Vec[String]) throws {
    let mut words: Vec[String] = []
    let mut fixes: Vec[String] = []
    let mut into_fixes = false
    for k in 2..<args.len() {
        if args[k] == "--fixes" {
            into_fixes = true
        } else if into_fixes {
            fixes.push(args[k].clone())
        } else {
            words.push(args[k].clone())
        }
    }
    if args[1] == "--heading" {
        println(release_heading(words, fixes))
        return
    }
    if args[1] == "--stage-version" && words.len() == 1 {
        println(release_stage_own(words[0].clone()))
        return
    }
    if args[1] == "--rows-added" && words.len() == 2 {
        println(release_rows_added(words[0].clone(), words[1].clone()))
        return
    }
    for e in release_entries(words) { println(f"- {e}") }
}

fn main() throws {
    let mut dry = false
    let mut every: i64 = 0
    let mut dir: String = ""
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    if args.len() >= 2 && (args[1] == "--heading" || args[1] == "--entries" || args[1] == "--rows-added" || args[1] == "--stage-version") {
        release_test(args)
        return
    }
    let mut i = 1
    while i < args.len() {
        if args[i] == "--dry-run" {
            dry = true
        } else if args[i] == "--loop" && i + 1 < args.len() {
            every = text::parse_i64(args[i + 1].clone()) ?? 0
            i += 1
        } else {
            dir = args[i].clone()
        }
        i += 1
    }
    if dir == "" {
        println("usage: nikaia run scripts/release.nika -- [--dry-run] [--loop MINUTES] REPORTS_DIR")
        process::exit(2)
    }
    let mut shown: Vec[String] = []
    while true {
        let lines = release_once(dir.clone(), dry)
        let mut stop = false
        for line in lines {
            if !shown.contains(line.clone()) { println(line.clone()) }
            if line.starts_with("RED") { stop = true }
        }
        shown = lines
        if every == 0 || stop || fs::exists(f"{dir}/STOP", fs::Root::Anywhere) { break }
        time::sleep(every.minutes())
    }
}
