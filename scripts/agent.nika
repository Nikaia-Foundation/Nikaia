// Start one headless agent from a brief (#847 step 2).
//
//     nikaia run scripts/agent.nika -- BRIEF [--dir DIR] [--dry-run] [--claude CMD]
//     nikaia run scripts/agent.nika -- --info BRIEF
//     nikaia run scripts/agent.nika -- --commits N
//
// `--commits N` prints the section of the prompt that lists the commits on
// HEAD naming issue #N (agent_commits, #1682), or an empty line.
//
// `--info` prints `agent model turns budget effort` (the frontmatter, defaults
// filled in) on one line; `batch.nika` reads it for its `NEXT` line.
//
// Reads BRIEF's frontmatter (agent, model, max_turns, budget_usd, effort), runs
// `claude -p` within 150 minutes (larger steps, owner 2026-10-28; with NIKAIA_OLD, the
// driver's before-binary of HEAD, agent_old_env, #2459), writes BRIEF.run.json, appends the
// session's token counts, summed over its transcript (`tokenspeed.nika --usage`),
// to DIR/tokens.txt (through `batch.nika --tokens`) and the cost to DIR/cost.txt, and prints
// `done <sha8> report <path> cost <usd> turns <api calls>`. A failed run writes
// DIR/ESCALATE (one line) and exits 2. A report with `Gate: red ...` writes
// DIR/RED (empty again after a green one); a second red in a row escalates. After
// the gate step it appends the run's row (`tokenspeed.nika --short`, read from the
// run's transcript under ~/.claude/projects) to the Runs table of
// docs/tokenspeed.md, once per agent id; it does not commit the file: the
// release after the driver's push does, or under `--no-bump` the driver's
// `release.nika --rows`. Before any escalation it resumes the run's
// session once and writes its answer to what held it up to BRIEF.debrief.md
// (the cost goes to DIR/cost.txt). `--dry-run` prints the command only.
// These files are untracked working files (#1252); scripts/drive.nika, which
// starts this script, reads them after the run and posts the run's result,
// tokens, cost, time, turns, report and debrief as one comment on the brief's
// issue (`drive_post_run`; a script cannot `use` another, and the issue lookup
// is the driver's).
//
// A run that was cut off (timeout, a killed driver) is resumed in its own
// session: BRIEF.session holds `<session id> <cksum of BRIEF>`, written before
// claude starts and removed once a report exists. The next start of the same,
// unchanged brief without a report resumes that session once (`resumed` is
// appended to the record), with the same model and tools, if its transcript is
// still there; a resume that fails at once (no JSON) falls back to a fresh run.
// While a process still runs the record's session (a killed driver's claude),
// a start of the brief is refused (`refused: BRIEF is still running`, exit 2)
// rather than run a second builder beside it (#1796).
//
// `effort: low|medium|high` (owner, 2026-11-01; missing: `medium`) goes to
// claude as `--effort`, the debrief too; `low` for an easy step (one step of a
// *To build* list, a known pattern, a bug with a probe and a known place),
// `medium` for a hard one. Another value escalates (`--info` prints it as is).

use std::cli
use std::env
use std::fs
use std::path
use std::process
use std::text

fn agent_front(body: String, key: String, default: String) -> String {
    let lines = body.split("\n").collect()
    let mut found: String = default.clone()
    if lines.len() == 0 || lines[0].trim() != "---" { return found }
    let prefix = key.clone() + ":"
    for i in 1..<lines.len() {
        let line = lines[i].trim()
        if line == "---" { return found }
        if line.starts_with(prefix.clone()) {
            found = (line.strip_prefix(prefix.clone()) ?? "").trim().clone()
            return found
        }
    }
    return found
}

// The brief's `effort:` (default `medium`).
fn agent_effort(body: String) -> String {
    return agent_front(body, "effort", "medium")
}

// True for an effort claude is started with here (`low`, `medium`, `high`).
fn agent_effort_ok(effort: String) -> bool {
    return effort == "low" || effort == "medium" || effort == "high"
}

// The tools every agent gets, whatever its kind.
fn agent_tools() -> String {
    return "Bash Read Edit Write Grep Glob"
}

// The argument list of `claude`, in the order the brief names.
fn agent_args(brief: String, body: String, session: String) -> Vec[String] {
    let agent = agent_front(body.clone(), "agent", "builder")
    let mut v: Vec[String] = []
    v.push("-p")
    v.push(f"Read your brief at {brief}")
    v.push("--agent")
    v.push(agent)
    v.push("--model")
    v.push(agent_front(body.clone(), "model", "sonnet"))
    v.push("--max-turns")
    v.push(agent_front(body.clone(), "max_turns", "120"))
    v.push("--max-budget-usd")
    v.push(agent_front(body.clone(), "budget_usd", "20"))
    v.push("--effort")
    v.push(agent_effort(body))
    v.push("--output-format")
    v.push("json")
    v.push("--session-id")
    v.push(session.clone())
    v.push("--allowedTools")
    v.push(agent_tools())
    return v
}

// The arguments of a resumed run: those of a fresh one, with `--resume` for
// `--session-id` and a prompt that says the run was interrupted.
fn agent_resume_args(brief: String, body: String, session: String) -> Vec[String] {
    let mut v = agent_args(brief.clone(), body, session)
    v[1] = f"Your run of the brief at {brief} was interrupted (a timeout or a killed driver). Check `git log` and `git status` for your own work (commits, changed files), then continue the brief to its report."
    for i in 0..<v.len() { if v[i] == "--session-id" { v[i] = "--resume" } }
    return v
}

// Where claude keeps the transcripts of sessions started in this directory:
// `$CLAUDE_CONFIG_DIR` (else `$HOME/.claude`), `projects/`, and the working
// directory with each scalar but an ASCII letter or digit as `-`. The
// operator's environment chooses it (ADR-397 D1).
fn agent_projects() -> String throws {
    let conf = env::var("CLAUDE_CONFIG_DIR") ?? f"{env::var("HOME") ?? ""}/.claude"
    let cwd = fs::canonical(".", fs::Root::Dir(".")).display()
    let mut munged = ""
    for c in cwd.scalars {
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') { munged = munged + f"{c}" } else { munged = munged + "-" }
    }
    return f"{conf}/projects/{munged}"
}

// Where claude keeps the transcript of a session started in this directory;
// "" for a session id that is no single path component.
fn agent_transcript(session: String) -> String throws {
    if !path::is_component(session) { return "" }
    let projects = agent_projects()
    return f"{projects}/{session}.jsonl"
}

// The environment claude runs with (#2459): NIKAIA_OLD, the absolute path of
// HEAD's before-binary target/bins/<sha12>/nikaia, which the driver made
// (drive_bins); none where it is missing. Looked up under Anywhere: `target` may be a
// symlink out of the working directory (the agent_script test), which a Dir root refuses.
fn agent_old_env() -> Vec[(String, String)] throws {
    let mut env: Vec[(String, String)] = []
    let sha = process::run("git", ["rev-parse", "--short=12", "HEAD"]).stdout.trim().clone()
    let bin = f"target/bins/{sha}/nikaia"
    if sha != "" && fs::exists(bin.clone(), fs::Root::Anywhere) {
        env.push(("NIKAIA_OLD", process::run("realpath", [bin]).stdout.trim().clone()))
    }
    return env
}

// The report of BRIEF that exists (`BRIEF.report.md`, else the stem's), or the
// first of the two.
fn agent_report(abs: String) -> String throws {
    let report = f"{abs}.report.md"
    let stem = (abs.strip_suffix(".md") ?? "").clone()
    if !fs::exists(report.clone(), fs::Root::Dir(".")) && stem != "" { return f"{stem}.report.md" }
    return report
}

// The session to resume: the record's id when the brief is unchanged (`sum`),
// has no report, was not resumed yet and its transcript is still there; else "".
fn agent_resumable(abs: String, record: String, sum: String) -> String throws {
    let words = record.trim().split(" ").collect()
    if words.len() != 2 || words[1] != sum || words[0] == "" { return "" }
    if fs::exists(agent_report(abs), fs::Root::Dir(".")) { return "" }
    if !fs::exists(agent_transcript(words[0].clone()), fs::Root::Anywhere) { return "" }
    return words[0].clone()
}

// The pid of a process still running the record's session (its `claude`,
// started with `--session-id` or `--resume` and the id), else "". A driver
// killed or restarted mid-run leaves that claude alive; resuming or restarting
// the brief beside it puts two builders in one session, scratchpad and files
// (#1796).
fn agent_live(record: String) -> String throws {
    let id = record.trim().split(" ").collect()[0].clone()
    if id == "" { return "" }
    let ps = process::run("ps", ["-eww", "-o", "pid=,args="]).stdout.clone()
    for l in ps.split("\n") {
        if l.contains(id.clone()) { return l.trim().split(" ").collect()[0].clone() }
    }
    return ""
}

// The debrief's question, asked in the run's own session without tools.
fn agent_debrief_args(session: String, model: String, effort: String) -> Vec[String] {
    let mut v: Vec[String] = []
    v.push("-p")
    v.push("Your run is over. Without using any tool, answer in at most 18 lines of Markdown: (1) what cost you the most turns or time; (2) what you had to look up (ADRs, the language, file locations) that the brief could have handed you; (3) which checks you ran and which were wasted; (4) one change to the brief or builder.md that would have saved the most; (5) what the issue lacked that would have helped (a fact, a probe, a file, an ADR, a ruled-out path), each item judged by docs/issues.md as `broke I<n>` (a rule asks for it, the issue lacks it), `rules-gap` (no rule asks for it), `wrong I<n>` (the issue has it, but false) or `knowledge: <section of docs/builder-facts-lookup.md, or Core> | <the fact, one sentence>` (something you had to find out that no rule asks an issue to hold; it becomes a facts line, not an issue); `complete` if nothing; (6) a trap the next builder will meet too, one line each as `Fact: <section of docs/builder-facts-lookup.md, or Core for a trap of every run> | <the line, one sentence>`, or `Fact: none`; (7) what the next builder in the same work area needs first, if your brief named a topic section (`Facts:`) or you worked in one (CI and caches, Ledger and bounds proofs, or a new one): key files, the measure command, a figure you measured, one line each as `Fact: <topic section> | <the line>`, every figure with its date and commit or run, or `Fact: none`.")
    v.push("--resume")
    v.push(session)
    v.push("--max-turns")
    v.push("2")
    v.push("--model")
    v.push(model)
    v.push("--effort")
    v.push(effort)
    v.push("--output-format")
    v.push("json")
    return v
}

// The `result` string of claude's JSON, unescaped; "" if absent.
fn agent_result(body: String) -> String {
    let parts = body.split("\"result\":\"").collect()
    if parts.len() < 2 { return "" }
    let mut out: Vec[String] = []
    let chars = parts[1].split("").collect()
    let mut i = 0
    while i < chars.len() {
        let c = chars[i].clone()
        if c == "\"" { return out.join("") }
        if c == "\\" && i + 1 < chars.len() {
            let next = chars[i + 1].clone()
            if next == "n" { out.push("\n") } else if next == "t" { out.push("  ") } else { out.push(next) }
            i += 2
        } else {
            out.push(c)
            i += 1
        }
    }
    return out.join("")
}

// The raw value after `"key":` (first occurrence), quotes removed; "" if absent.
fn agent_json(body: String, key: String) -> String {
    let marker = "\"" + key + "\":"
    let parts = body.split(marker).collect()
    if parts.len() < 2 { return "" }
    let first = parts[1].split(",").collect()[0].clone()
    let value = first.split("}").collect()[0].clone()
    return value.trim().replace("\"", "")
}

fn agent_int(body: String, key: String) -> i64 {
    return text::parse_i64(agent_json(body, key)) ?? 0
}

// Micro-dollars of "12.34": whole * 1_000_000 + the first six decimals.
fn agent_micro(cost: String) -> i64 throws {
    let parts = cost.trim().split(".").collect()
    let whole = text::parse_i64(parts[0].clone()) ?? 0
    if parts.len() < 2 { return whole * 1000000 }
    let padded = parts[1].clone() + "000000"
    let frac = text::parse_i64(padded.bytes[0..<6].text()) ?? 0
    return whole * 1000000 + frac
}

// "12.345678" of micro-dollars, the inverse of agent_micro; below zero is 0.
fn agent_usd(micro: i64) -> String throws {
    if micro <= 0 { return "0.000000" }
    let frac = f"{1000000 + micro % 1000000}"
    return f"{micro / 1000000}." + frac.bytes[1..<7].text()
}

fn agent_escalate(dir: String, why: String) throws {
    fs::write(f"{dir}/ESCALATE", fs::Root::Dir("."), why.clone() + "\n")
    println(f"ESCALATE {why}")
    process::exit(2)
}

// The report's `Gate: red ...` line, or "" (green, or no Gate line).
fn agent_gate(report: String) -> String throws {
    for line in agent_read(report).split("\n") {
        if line.trim().starts_with("Gate: red") { return line.trim().clone() }
    }
    return ""
}

// `doc` with `row` added after the last row of the Runs table; unchanged when a
// row of the same agent id (the second field) is already there.
fn agent_runs_insert(doc: String, row: String) -> String {
    let id = row.split("|").collect()[2].trim().clone()
    let lines = doc.split("\n").collect()
    for line in lines {
        let fields = line.split("|").collect()
        if line.starts_with("| ") && fields.len() > 2 && fields[2].trim() == id { return doc.clone() }
    }
    let mut out: Vec[String] = []
    let mut in_runs = false
    let mut added = false
    for i in 0..<lines.len() {
        out.push(lines[i].clone())
        if lines[i].starts_with("## Runs") { in_runs = true }
        else if in_runs && !added && lines[i].starts_with("|") && !(i + 1 < lines.len() && lines[i + 1].starts_with("|")) {
            out.push(row.clone())
            added = true
        }
    }
    return out.join("\n")
}

// The headings a brief names for its facts: `facts:` in its frontmatter, or a
// line `Facts: A, B`; empty without one.
fn agent_fact_names(body: String) -> Vec[String] {
    let mut wanted = agent_front(body.clone(), "facts", "")
    if wanted == "" {
        for line in body.split("\n") {
            let t = line.trim()
            if t.starts_with("Facts:") {
                wanted = (t.strip_prefix("Facts:") ?? "").trim().clone()
                break
            }
        }
    }
    let mut out: Vec[String] = []
    for name in wanted.split(",") { if name.trim() != "" { out.push(name.trim().clone()) } }
    return out
}

// The level (2 or 3) of `line` as a `## ` / `### ` heading named `name`, else 0.
// A heading ending in a parenthetical, `Moving Rust into Nikaia (self-hosting,
// ADR-294, #125)`, is also named without it (a name holds no comma).
fn agent_fact_level(line: String, name: String) -> i64 {
    let mut level = 0
    let mut t: String = ""
    if line.starts_with("## ") {
        level = 2
        t = (line.strip_prefix("## ") ?? "").trim().clone()
    } else if line.starts_with("### ") {
        level = 3
        t = (line.strip_prefix("### ") ?? "").trim().clone()
    }
    if level == 0 { return 0 }
    if t == name || t.split(" (").collect()[0].trim() == name { return level }
    return 0
}

// The first heading of the brief that the facts (`facts`: builder-facts.md and its lookup) lack, or "".
fn agent_facts_unknown(body: String, facts: String) -> String {
    let lines = facts.split("\n").collect()
    for name in agent_fact_names(body) {
        let mut found = false
        for line in lines { if agent_fact_level(line, name.clone()) > 0 { found = true } }
        if !found { return name }
    }
    return ""
}

// The `###` sections of `facts` whose `Paths:` line (the first line under the
// heading that starts with it: fragments and words, comma-separated, in
// backticks or bare) has a fragment occurring in `text`, in any case: at most
// three, those with the most fragments found first, then in file order
// (#2002: briefs rendered from issues name no `Facts:` line).
fn agent_fact_matches(text: String, facts: String) -> Vec[String] {
    let low = text.to_lowercase()
    let mut names: Vec[String] = []
    let mut hits: Vec[i64] = []
    let mut heading: String = ""
    for line in facts.split("\n") {
        if line.starts_with("#") {
            heading = ""
            if line.starts_with("### ") { heading = (line.strip_prefix("### ") ?? "").trim().split(" (").collect()[0].trim().clone() }
        } else if heading != "" && line.trim().starts_with("Paths:") {
            let mut n = 0
            for raw in (line.trim().strip_prefix("Paths:") ?? "").split(",") {
                let frag = raw.replace("`", "").trim().to_lowercase()
                if frag != "" && low.contains(frag) { n += 1 }
            }
            if n > 0 {
                names.push(heading.clone())
                hits.push(n)
            }
            heading = ""
        }
    }
    let mut out: Vec[String] = []
    while out.len() < 3 {
        let mut best = -1
        for i in 0..<names.len() {
            if hits[i] > 0 && (best < 0 || hits[i] > hits[best]) { best = i }
        }
        if best < 0 { break }
        out.push(names[best].clone())
        hits[best] = 0
    }
    return out
}

// The text of the sections the brief names, each down to the next heading of
// its level or above, under one heading for the prompt. The section `Core`,
// when the file has one, comes first for every brief; "" without either. A
// brief that names none gets the sections agent_fact_matches finds in its
// text and `issues` (the issues inlined into its prompt).
fn agent_facts(body: String, facts: String, issues: String) -> String {
    let lines = facts.split("\n").collect()
    let mut names: Vec[String] = []
    for line in lines { if agent_fact_level(line, "Core") == 2 { names.push("Core") } }
    let mut named = agent_fact_names(body.clone())
    if named.len() == 0 { named = agent_fact_matches(body + "\n" + issues, facts.clone()) }
    for name in named { if name != "Core" { names.push(name.clone()) } }
    if names.len() == 0 { return "" }
    let mut out: Vec[String] = ["", "", "# Facts for this brief (Core and the named sections of docs/builder-facts-lookup.md; more on a topic: `nikaia run scripts/syntax.nika -- KEYWORD`)"]
    for name in names {
        let mut level = 0
        for line in lines {
            if level > 0 {
                if line.starts_with("# ") || line.starts_with("## ") || (level == 3 && line.starts_with("### ")) { break }
                out.push(line.clone())
            } else {
                level = agent_fact_level(line, name.clone())
                if level > 0 {
                    if out[out.len() - 1] != "" { out.push("") }
                    out.push(line.clone())
                }
            }
        }
    }
    return out.join("\n")
}

// The issues a brief is about: `issues: 1213, 1238` in its frontmatter, else
// every `#N` in its title (the first `# ` line).
fn agent_issue_numbers(body: String) -> Vec[String] {
    let listed = agent_front(body.clone(), "issues", "")
    let mut source = listed.clone()
    if source == "" {
        for line in body.split("\n") {
            if line.starts_with("# ") {
                source = line.clone()
                break
            }
        }
    }
    let mut out: Vec[String] = []
    let mut digits: String = ""
    let mut after_hash = listed != ""
    for c in (source + " ").scalars {
        if c.is_ascii_digit() && after_hash {
            digits = digits + c.to_string()
        } else {
            if digits != "" && !out.contains(digits.clone()) { out.push(digits.clone()) }
            digits = ""
            after_hash = c == '#' || listed != ""
        }
    }
    return out
}

// The text of the issues the brief names, with their comments, under one
// heading for the prompt (#1238's third gap: builders have no GitHub access);
// "" when the brief names none or `gh` cannot read them.
fn agent_issues(body: String, repo: String) -> String throws {
    let numbers = agent_issue_numbers(body)
    if numbers.len() == 0 { return "" }
    let mut out: Vec[String] = ["", "", "# The issues this brief names (as GitHub has them now; you need no GitHub access)"]
    for n in numbers {
        let issue = process::run("gh", ["api", f"repos/{repo}/issues/{n}", "--jq", "\"## #\\(.number) \\(.title) [\\(.state)]\\n\\n\\(.body // \"\")\""])
        if issue.code != 0 { continue }
        out.push("")
        out.push(issue.stdout.trim().clone())
        // The driver's own posts (the queued brief, each run's result) stay out: the brief is
        // the prompt already, and with them a long issue passes the 128 KB limit of one argument.
        let comments = process::run("gh", ["api", f"repos/{repo}/issues/{n}/comments?per_page=100", "--jq", ".[] | select((.body | startswith(\"Brief queued:\") or startswith(\"Run:\")) | not) | \"### Comment by \\(.user.login), \\(.created_at[0:10])\\n\\n\\(.body)\\n\""])
        if comments.code == 0 && comments.stdout.trim() != "" {
            out.push("")
            out.push(comments.stdout.trim().clone())
        }
        let commits = agent_commits(n.clone())
        if commits != "" {
            out.push("")
            out.push(commits)
        }
    }
    if out.len() == 3 { return "" }
    return out.join("\n")
}

// The commits among the last 400 on HEAD whose message names #N, as a section
// for the prompt under the issue; "" when none. A commit with a `Fixes #N[, #M]`
// line is called out first: such an issue stays open until `promote`, and a
// fix landed without a comment on the issue (I13) was briefed as work to do
// (#1682: #1665's item 1 was committed before its run, seen only with `git log`).
fn agent_commits(n: String) -> String throws {
    let named = process::run("git", ["log", "-400", "--format=- %h %s", "-E", f"--grep=#{n}([^0-9]|$)"])
    if !named.ok || named.stdout.trim() == "" { return "" }
    let mut out: Vec[String] = [f"### Commits on develop that name #{n} (the last 400; read them before planning)", ""]
    let fixed = process::run("git", ["log", "-400", "--format=%h", "-E", f"--grep=^Fixes .*#{n}([^0-9]|$)"])
    if fixed.ok && fixed.stdout.trim() != "" {
        let shas = fixed.stdout.trim().split("\n").collect().join(", ")
        out.push(f"**Already fixed: {shas} says `Fixes #{n}`.** Check what of the issue is left before building; nothing left is `Result: done` naming that commit, with no commit of your own.")
        out.push("")
    }
    out.push(named.stdout.trim().clone())
    return out.join("\n")
}

fn agent_exe() -> String throws {
    for exe in ["target/fast/nikaia", "target/release/nikaia"] {
        if fs::exists(exe, fs::Root::Anywhere) { return exe }
    }
    return ""
}

fn agent_read(path: String) -> String throws {
    if !fs::exists(path.clone(), fs::Root::Dir(".")) { return "" }
    return fs::read_to_string(path, fs::Root::Dir("."))
}

fn main() throws {
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    let mut dry = false
    let mut info = false
    let mut brief: String = ""
    let mut dir: String = ""
    let mut claude: String = "claude"
    let mut i = 1
    while i < args.len() {
        if args[i] == "--dry-run" { dry = true }
        else if args[i] == "--info" { info = true }
        else if args[i] == "--commits" && i + 1 < args.len() {
            println(agent_commits(args[i + 1].clone()))
            return
        }
        else if args[i] == "--dir" && i + 1 < args.len() { dir = args[i + 1].clone(); i += 1 }
        else if args[i] == "--claude" && i + 1 < args.len() { claude = args[i + 1].clone(); i += 1 }
        else { brief = args[i].clone() }
        i += 1
    }
    if brief == "" {
        println("usage: nikaia run scripts/agent.nika -- BRIEF [--dir DIR] [--dry-run] [--claude CMD]")
        process::exit(2)
    }
    // DIR, the brief and the files beside it lie below the working directory;
    // without --dir it is the brief's own directory, as given.
    if dir == "" { dir = process::run("dirname", [brief.clone()]).stdout.trim().clone() }
    if !path::is_below(dir) {
        println(f"refused: --dir {dir} is not a relative path below the working directory")
        process::exit(2)
    }
    let here = fs::Root::Dir(".")
    let abs = process::run("realpath", [brief]).stdout.trim().clone()
    let text = fs::read_to_string(abs.clone(), here)
    if info {
        println(agent_front(text.clone(), "agent", "builder") + " " + agent_front(text.clone(), "model", "sonnet") + " " + agent_front(text.clone(), "max_turns", "120") + " " + agent_front(text.clone(), "budget_usd", "20") + " " + agent_effort(text))
        return
    }
    let effort = agent_effort(text.clone())
    if !agent_effort_ok(effort.clone()) {
        if dry {
            println(f"ESCALATE effort {effort} is not low, medium or high")
            process::exit(2)
        }
        agent_escalate(dir.clone(), f"effort {effort} in {abs} is not low, medium or high")
    }
    let mut wanted: String = ""
    if fs::exists("/proc/sys/kernel/random/uuid", fs::Root::Anywhere) { wanted = fs::read_to_string("/proc/sys/kernel/random/uuid", fs::Root::Anywhere).trim().clone() }
    let mut claude_args = agent_args(abs.clone(), text.clone(), wanted.clone())
    // Core and the sections of docs/builder-facts-lookup.md the brief names go into its prompt.
    let facts = agent_read("docs/builder-facts.md") + "\n" + agent_read("docs/builder-facts-lookup.md")
    let unknown = agent_facts_unknown(text.clone(), facts.clone())
    if unknown != "" {
        if dry {
            println(f"unknown Facts heading: {unknown}")
            process::exit(2)
        }
        agent_escalate(dir.clone(), f"unknown Facts heading in {abs}: {unknown}")
    }
    // The issues the brief names go into its prompt too, after the facts, which
    // are chosen from them where the brief names no `Facts:` sections.
    let issues = agent_issues(text.clone(), "Nikaia-Foundation/Nikaia")
    claude_args[1] = claude_args[1].clone() + agent_facts(text.clone(), facts, issues.clone()) + issues
    let record = f"{abs}.session"
    let sum = process::run("cksum", [abs.clone()]).stdout.trim().split(" ").collect()[0].clone()
    let mut resumed = agent_resumable(abs.clone(), agent_read(record.clone()), sum.clone())
    let live = agent_live(agent_read(record.clone()))
    if live != "" {
        println(f"refused: {abs} is still running (pid {live}, its session in {record}); wait for it to end or kill it")
        process::exit(2)
    }
    if dry {
        if resumed != "" { claude_args = agent_resume_args(abs.clone(), text.clone(), resumed.clone()) }
        println(claude + " " + claude_args.join(" "))
        return
    }
    if fs::exists(f"{dir}/ESCALATE", here) {
        println(f"refused: {dir}/ESCALATE exists")
        process::exit(2)
    }
    let free = text::parse_i64(process::run("sh", ["-c", "df -m --output=avail / | tail -1"]).stdout.trim()) ?? 0
    if free < 3072 { agent_escalate(dir.clone(), f"less than 3 GB free ({free} MB)") }
    let today = process::run("date", ["+%F"]).stdout.trim().clone()
    let mut spent = 0
    for line in agent_read(f"{dir}/cost.txt").split("\n") {
        let parts = line.split(" ").collect()
        if parts.len() == 2 && parts[0] == today { spent += agent_micro(parts[1].clone()) }
    }
    if spent > 1000 * 1000000 { agent_escalate(dir.clone(), f"cost today {spent / 1000000} USD above 1000") }

    let mut out = process::run("true", [])
    let old_env = agent_old_env()
    if resumed != "" {
        fs::write(record.clone(), here, f"{resumed} {sum} resumed\n")
        out = process::run(claude.clone(), agent_resume_args(abs.clone(), text.clone(), resumed.clone()); env: old_env.clone(), within: 150.minutes())
        if !out.timed_out && agent_json(out.stdout.clone(), "session_id") == "" {
            println(f"resume of {resumed} failed at once (code {out.code}), starting fresh")
            resumed = ""
        } else {
            wanted = resumed.clone()
        }
    }
    if resumed == "" {
        fs::write(record.clone(), here, f"{wanted} {sum}\n")
        out = process::run(claude.clone(), claude_args; env: old_env, within: 150.minutes())
    }
    let json = out.stdout
    fs::write(f"{abs}.run.json", here, json.clone())
    let cost = agent_json(json.clone(), "total_cost_usd")
    let session = agent_json(json.clone(), "session_id")
    let exe = agent_exe()
    // The JSON's `usage` and `num_turns` cover only the last turn (a run woken
    // by a background task has several): the transcript has every API call.
    let transcript = agent_transcript(session.clone())
    let mut usage: Vec[String] = []
    if exe != "" && session != "" && fs::exists(transcript.clone(), fs::Root::Anywhere) {
        for w in process::run(exe.clone(), ["run", "scripts/tokenspeed.nika", "--", "--usage", transcript.clone()]).stdout.trim().split(" ") { usage.push(w.clone()) }
    }
    if usage.len() != 5 {
        let t = agent_int(json.clone(), "input_tokens") + agent_int(json.clone(), "output_tokens") + agent_int(json.clone(), "cache_creation_input_tokens") + agent_int(json.clone(), "cache_read_input_tokens")
        usage = [f"{t}", f"{agent_int(json.clone(), "num_turns")}", f"{agent_int(json.clone(), "cache_read_input_tokens")}", f"{agent_int(json.clone(), "cache_creation_input_tokens")}", f"{agent_int(json.clone(), "output_tokens")}"]
    }
    let turns = usage[1]
    let reason = agent_json(json.clone(), "terminal_reason")
    let stem = (abs.strip_suffix(".md") ?? "").clone()
    let report = agent_report(abs.clone())
    // A report ends the run: nothing left to resume.
    if fs::exists(report.clone(), here) { fs::remove(record, here) }
    // A run cut off by the time limit prints no JSON: no empty cost line.
    if cost != "" {
        let old_cost = agent_read(f"{dir}/cost.txt")
        fs::write(f"{dir}/cost.txt", here, old_cost + f"{today} {cost}\n")
    }
    // A run cut off by the time limit writes no row: its resume reads the same
    // transcript and writes the whole session's.
    if exe != "" && !out.timed_out {
        process::run(exe.clone(), ["run", "scripts/batch.nika", "--", dir.clone(), "--tokens", abs.clone(), usage[0].clone(), usage[1].clone(), usage[2].clone(), usage[3].clone(), usage[4].clone()])
    }
    // The debrief: the same session, resumed while its cache is warm, answers
    // what held it up, before any escalation stops this script.
    if !out.timed_out && session == wanted {
        let asked = process::run(claude, agent_debrief_args(session.clone(), agent_front(text, "model", "sonnet"), effort); within: 10.minutes())
        let mut debrief = f"{abs}.debrief.md"
        if stem != "" { debrief = f"{stem}.debrief.md" }
        fs::write(debrief, here, agent_result(asked.stdout.clone()) + "\n")
        // A resumed session's `total_cost_usd` counts the whole session: the
        // debrief costs what it adds to the run's.
        let more = agent_json(asked.stdout.clone(), "total_cost_usd")
        if more != "" {
            let with_run = agent_read(f"{dir}/cost.txt")
            let added = agent_usd(agent_micro(more) - agent_micro(cost.clone()))
            fs::write(f"{dir}/cost.txt", here, with_run + f"{today} {added}\n")
        }
    }
    if out.timed_out { agent_escalate(dir.clone(), "timed out after 150 minutes") }
    if !out.ok { agent_escalate(dir.clone(), f"claude exited with code {out.code}") }
    if agent_json(json, "is_error") != "false" { agent_escalate(dir.clone(), "is_error") }
    if reason != "completed" { agent_escalate(dir.clone(), f"terminal_reason {reason}") }
    if !fs::exists(report.clone(), here) { agent_escalate(dir.clone(), f"no report {report}") }
    if session != wanted { agent_escalate(dir.clone(), f"session_id {session} differs from {wanted}") }
    let gate = agent_gate(report.clone())
    let before = agent_read(f"{dir}/RED").trim().clone()
    if gate == "" {
        fs::write(f"{dir}/RED", here, "")
    } else {
        fs::write(f"{dir}/RED", here, f"{abs}: {gate}\n")
        if before != "" { agent_escalate(dir, f"two red gates in a row: {before} / {abs}: {gate}") }
    }
    // The run's row for the Runs table of docs/tokenspeed.md (#858), once per agent
    // id. This only writes the file; the release commit after the driver's push
    // takes it (`release_bump` in scripts/release.nika, #1886), under
    // `--no-bump` a commit of the rows alone (`release.nika --rows`).
    if exe != "" && fs::exists(transcript.clone(), fs::Root::Anywhere) && fs::exists("docs/tokenspeed.md", fs::Root::Anywhere) {
        let row = process::run(exe, ["run", "scripts/tokenspeed.nika", "--", "--short", transcript]).stdout.trim().clone()
        if row.starts_with("| ") {
            let doc = fs::read_to_string("docs/tokenspeed.md", fs::Root::Anywhere)
            fs::write("docs/tokenspeed.md", fs::Root::Anywhere, agent_runs_insert(doc, row))
        }
    }
    let sha = process::run("git", ["rev-parse", "--short=8", "HEAD"]).stdout.trim().clone()
    println(f"done {sha} report {report} cost {cost} turns {turns}")
}
