// Start one headless agent from a brief (#847 step 2).
//
//     nikaia run scripts/agent.nika -- BRIEF [--dir DIR] [--dry-run] [--claude CMD]
//     nikaia run scripts/agent.nika -- --info BRIEF
//
// `--info` prints `agent model turns budget` (the frontmatter, defaults filled
// in) on one line; `batch.nika` reads it for its `NEXT` line.
//
// Reads BRIEF's frontmatter (agent, model, max_turns, budget_usd), runs
// `claude -p` within 150 minutes (larger steps, owner 2026-10-28), writes BRIEF.run.json, appends the cost to
// DIR/tokens.txt (through `batch.nika --tokens`) and DIR/cost.txt, and prints
// `done <sha8> report <path> cost <usd> turns <n>`. A failed run writes
// DIR/ESCALATE (one line) and exits 2. A report with `Gate: red ...` writes
// DIR/RED (empty again after a green one); a second red in a row escalates. After
// the gate step it appends the run's row (`tokenspeed.nika --short`, read from the
// run's transcript under ~/.claude/projects) to the Runs table of
// docs/tokenspeed.md, once per agent id; it does not commit the file, the
// supervisor's commit takes it. A brief's `Cut: PATH:A-B` lines are converted
// first (`agent_draft`) and the draft named in the prompt. Before any escalation it resumes the run's
// session once and writes its answer to what held it up to BRIEF.debrief.md
// (the cost goes to DIR/cost.txt). `--dry-run` prints the command only.
//
// A run that was cut off (timeout, a killed driver) is resumed in its own
// session: BRIEF.session holds `<session id> <cksum of BRIEF>`, written before
// claude starts and removed once a report exists. The next start of the same,
// unchanged brief without a report resumes that session once (`resumed` is
// appended to the record), with the same model and tools, if its transcript is
// still there; a resume that fails at once (no JSON) falls back to a fresh run.

use std::cli
use std::fs
use std::process
use std::text

fn agent_front(body: String, key: String, default: String) -> String {
    let lines = body.split("\n").collect()
    let mut found: String = default.clone()
    if lines.len() == 0 || lines[0].trim() != "---" { return found }
    let prefix = key.clone() + ":"
    for i in 1..<lines.len() {
        let line = lines[i].trim()
        if line == "---" { return found }
        if line.starts_with(prefix.clone()) {
            found = (line.strip_prefix(prefix.clone()) ?? "").trim().clone()
            return found
        }
    }
    return found
}

fn agent_tools(agent: String) -> String {
    if agent == "architect" {
        return "Read Grep Glob Bash Edit Write mcp__github__issue_read mcp__github__issue_write mcp__github__add_issue_comment mcp__github__list_issues mcp__github__search_issues mcp__github__sub_issue_write mcp__github__get_label"
    }
    return "Bash Read Edit Write Grep Glob"
}

// The argument list of `claude`, in the order the brief names.
fn agent_args(brief: String, body: String, session: String) -> Vec[String] {
    let agent = agent_front(body.clone(), "agent", "builder")
    let mut v: Vec[String] = []
    v.push("-p")
    v.push(f"Read your brief at {brief}")
    v.push("--agent")
    v.push(agent.clone())
    v.push("--model")
    v.push(agent_front(body.clone(), "model", "sonnet"))
    v.push("--max-turns")
    v.push(agent_front(body.clone(), "max_turns", "120"))
    v.push("--max-budget-usd")
    v.push(agent_front(body, "budget_usd", "20"))
    v.push("--output-format")
    v.push("json")
    v.push("--session-id")
    v.push(session.clone())
    v.push("--allowedTools")
    v.push(agent_tools(agent))
    return v
}

// The arguments of a resumed run: those of a fresh one, with `--resume` for
// `--session-id` and a prompt that says the run was interrupted.
fn agent_resume_args(brief: String, body: String, session: String) -> Vec[String] {
    let mut v = agent_args(brief.clone(), body, session)
    v[1] = f"Your run of the brief at {brief} was interrupted (a timeout or a killed driver). Check `git log` and `git status` for your own work (commits, changed files), then continue the brief to its report."
    v[12] = "--resume"
    return v
}

// Where claude keeps the transcript of a session started in this directory.
fn agent_transcript(session: String) -> String throws {
    let path = "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(pwd | sed 's/[^a-zA-Z0-9]/-/g')/" + session + ".jsonl"
    return process::run("sh", ["-c", "echo " + path]).stdout.trim().clone()
}

// The report of BRIEF that exists (`BRIEF.report.md`, else the stem's), or the
// first of the two.
fn agent_report(abs: String) -> String throws {
    let report = f"{abs}.report.md"
    let stem = (abs.strip_suffix(".md") ?? "").clone()
    if !fs::exists(report.clone(), fs::Root::Anywhere) && stem != "" { return f"{stem}.report.md" }
    return report
}

// The session to resume: the record's id when the brief is unchanged (`sum`),
// has no report, was not resumed yet and its transcript is still there; else "".
fn agent_resumable(abs: String, record: String, sum: String) -> String throws {
    let words = record.trim().split(" ").collect()
    if words.len() != 2 || words[1] != sum || words[0] == "" { return "" }
    if fs::exists(agent_report(abs), fs::Root::Anywhere) { return "" }
    if !fs::exists(agent_transcript(words[0].clone()), fs::Root::Anywhere) { return "" }
    return words[0].clone()
}

// The converter's draft of the brief's `Cut: PATH:A-B` lines (L2, 2026-10-28),
// converted in one run with the options of its `Convert:` line: BRIEF's stem
// `.draft.nika`, `.draft.nika.notes` (stderr) and `.draft.nika.rs` (the Rust
// read). Returns the draft's path, or "" without Cut: lines or converter.
fn agent_draft(abs: String, body: String) -> String throws {
    let converter = "crates/rs2nika/convert/target/nikaia/bin/rs2nika"
    let mut cuts: Vec[String] = []
    let mut rust: Vec[String] = []
    let mut options: Vec[String] = []
    for line in body.split("\n") {
        let t = line.trim()
        if t.starts_with("Cut: ") {
            let cut = (t.strip_prefix("Cut: ") ?? "").trim().clone()
            let at = cut.split(":").collect()
            if at.len() == 2 {
                let span = at[1].replace("-", ",")
                rust.push(process::run("sed", ["-n", f"{span}p", at[0].clone()]).stdout.clone())
                cuts.push("--cut")
                cuts.push(cut.clone())
            }
        } else if t.starts_with("Convert: ") {
            for word in (t.strip_prefix("Convert: ") ?? "").trim().split(" ") { if word != "" { options.push(word.clone()) } }
        }
    }
    if rust.len() == 0 || !fs::exists(converter, fs::Root::Anywhere) { return "" }
    let mut stem = abs.clone()
    if abs.ends_with(".md") { stem = (abs.strip_suffix(".md") ?? "").clone() }
    let draft = f"{stem}.draft.nika"
    // the converter cuts whole items (a method inside its `impl`); the bare
    // lines only when it cannot parse the file
    let whole = process::run(converter, cuts).stdout.clone()
    let given = if whole.trim() != "" { whole } else { rust.join("") }
    fs::write(f"{draft}.rs", fs::Root::Anywhere, given)
    options.push("--file")
    options.push(f"{draft}.rs")
    let out = process::run(converter, options)
    fs::write(draft.clone(), fs::Root::Anywhere, out.stdout.clone())
    fs::write(f"{draft}.notes", fs::Root::Anywhere, out.stderr.clone())
    return draft
}

// The debrief's question, asked in the run's own session without tools.
fn agent_debrief_args(session: String, model: String) -> Vec[String] {
    let mut v: Vec[String] = []
    v.push("-p")
    v.push("Your run is over. Without using any tool, answer in at most 15 lines of Markdown: (1) what cost you the most turns or time; (2) what you had to look up (ADRs, the language, file locations, the converter) that the brief could have handed you; (3) which checks you ran and which were wasted; (4) one change to the brief or builder.md that would have saved the most.")
    v.push("--resume")
    v.push(session)
    v.push("--max-turns")
    v.push("2")
    v.push("--model")
    v.push(model)
    v.push("--output-format")
    v.push("json")
    return v
}

// The `result` string of claude's JSON, unescaped; "" if absent.
fn agent_result(body: String) -> String {
    let parts = body.split("\"result\":\"").collect()
    if parts.len() < 2 { return "" }
    let mut out: Vec[String] = []
    let chars = parts[1].split("").collect()
    let mut i = 0
    while i < chars.len() {
        let c = chars[i].clone()
        if c == "\"" { return out.join("") }
        if c == "\\" && i + 1 < chars.len() {
            let next = chars[i + 1].clone()
            if next == "n" { out.push("\n") } else if next == "t" { out.push("  ") } else { out.push(next) }
            i += 2
        } else {
            out.push(c)
            i += 1
        }
    }
    return out.join("")
}

// The raw value after `"key":` (first occurrence), quotes removed; "" if absent.
fn agent_json(body: String, key: String) -> String {
    let marker = "\"" + key + "\":"
    let parts = body.split(marker).collect()
    if parts.len() < 2 { return "" }
    let first = parts[1].split(",").collect()[0].clone()
    let value = first.split("}").collect()[0].clone()
    return value.trim().replace("\"", "")
}

fn agent_int(body: String, key: String) -> i64 {
    return text::parse_i64(agent_json(body, key)) ?? 0
}

// Micro-dollars of "12.34": whole * 1_000_000 + the first six decimals.
fn agent_micro(cost: String) -> i64 throws {
    let parts = cost.trim().split(".").collect()
    let whole = text::parse_i64(parts[0].clone()) ?? 0
    if parts.len() < 2 { return whole * 1000000 }
    let padded = parts[1].clone() + "000000"
    let frac = text::parse_i64(padded.bytes[0..6].text()) ?? 0
    return whole * 1000000 + frac
}

fn agent_escalate(dir: String, why: String) throws {
    fs::write(f"{dir}/ESCALATE", fs::Root::Anywhere, why.clone() + "\n")
    println(f"ESCALATE {why}")
    process::exit(2)
}

// The report's `Gate: red ...` line, or "" (green, or no Gate line).
fn agent_gate(report: String) -> String throws {
    for line in agent_read(report).split("\n") {
        if line.trim().starts_with("Gate: red") { return line.trim().clone() }
    }
    return ""
}

// `doc` with `row` added after the last row of the Runs table; unchanged when a
// row of the same agent id (the second field) is already there.
fn agent_runs_insert(doc: String, row: String) -> String {
    let id = row.split("|").collect()[2].trim().clone()
    let lines = doc.split("\n").collect()
    for line in lines {
        let fields = line.split("|").collect()
        if line.starts_with("| ") && fields.len() > 2 && fields[2].trim() == id { return doc.clone() }
    }
    let mut out: Vec[String] = []
    let mut in_runs = false
    let mut added = false
    for i in 0..<lines.len() {
        out.push(lines[i].clone())
        if lines[i].starts_with("## Runs") { in_runs = true }
        else if in_runs && !added && lines[i].starts_with("|") && !(i + 1 < lines.len() && lines[i + 1].starts_with("|")) {
            out.push(row.clone())
            added = true
        }
    }
    return out.join("\n")
}

// The headings a brief names for its facts: `facts:` in its frontmatter, or a
// line `Facts: A, B`; empty without one.
fn agent_fact_names(body: String) -> Vec[String] {
    let mut wanted = agent_front(body.clone(), "facts", "")
    if wanted == "" {
        for line in body.split("\n") {
            let t = line.trim()
            if t.starts_with("Facts:") {
                wanted = (t.strip_prefix("Facts:") ?? "").trim().clone()
                break
            }
        }
    }
    let mut out: Vec[String] = []
    for name in wanted.split(",") { if name.trim() != "" { out.push(name.trim().clone()) } }
    return out
}

// The level (2 or 3) of `line` as a `## ` / `### ` heading named `name`, else 0.
// A heading ending in a parenthetical, `Moving Rust into Nikaia (self-hosting,
// ADR-294, #125)`, is also named without it (a name holds no comma).
fn agent_fact_level(line: String, name: String) -> i64 {
    let mut level = 0
    let mut t: String = ""
    if line.starts_with("## ") {
        level = 2
        t = (line.strip_prefix("## ") ?? "").trim().clone()
    } else if line.starts_with("### ") {
        level = 3
        t = (line.strip_prefix("### ") ?? "").trim().clone()
    }
    if level == 0 { return 0 }
    if t == name || t.split(" (").collect()[0].trim() == name { return level }
    return 0
}

// The first heading of the brief that docs/builder-facts.md (`facts`) lacks, or "".
fn agent_facts_unknown(body: String, facts: String) -> String {
    let lines = facts.split("\n").collect()
    for name in agent_fact_names(body) {
        let mut found = false
        for line in lines { if agent_fact_level(line, name.clone()) > 0 { found = true } }
        if !found { return name }
    }
    return ""
}

// The text of the sections the brief names, each down to the next heading of
// its level or above, under one heading for the prompt; "" without Facts.
fn agent_facts(body: String, facts: String) -> String {
    let names = agent_fact_names(body)
    if names.len() == 0 { return "" }
    let lines = facts.split("\n").collect()
    let mut out: Vec[String] = ["", "", "# Facts for this brief (sections of docs/builder-facts.md; read the rest of it only when needed)"]
    for name in names {
        let mut level = 0
        for line in lines {
            if level > 0 {
                if line.starts_with("# ") || line.starts_with("## ") || (level == 3 && line.starts_with("### ")) { break }
                out.push(line.clone())
            } else {
                level = agent_fact_level(line, name.clone())
                if level > 0 {
                    if out[out.len() - 1] != "" { out.push("") }
                    out.push(line.clone())
                }
            }
        }
    }
    return out.join("\n")
}

fn agent_exe() -> String throws {
    for exe in ["target/fast/nikaia", "target/release/nikaia"] {
        if fs::exists(exe, fs::Root::Anywhere) { return exe.to_string() }
    }
    return ""
}

fn agent_read(path: String) -> String throws {
    if !fs::exists(path.clone(), fs::Root::Anywhere) { return "" }
    return fs::read_to_string(path, fs::Root::Anywhere)
}

fn main() throws {
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    let mut dry = false
    let mut info = false
    let mut brief: String = ""
    let mut dir: String = ""
    let mut claude: String = "claude"
    let mut i = 1
    while i < args.len() {
        if args[i] == "--dry-run" { dry = true }
        else if args[i] == "--info" { info = true }
        else if args[i] == "--dir" && i + 1 < args.len() { dir = args[i + 1].clone(); i += 1 }
        else if args[i] == "--claude" && i + 1 < args.len() { claude = args[i + 1].clone(); i += 1 }
        else { brief = args[i].clone() }
        i += 1
    }
    if brief == "" {
        println("usage: nikaia run scripts/agent.nika -- BRIEF [--dir DIR] [--dry-run] [--claude CMD]")
        process::exit(2)
    }
    let abs = process::run("realpath", [brief.clone()]).stdout.trim().clone()
    if dir == "" { dir = process::run("dirname", [abs.clone()]).stdout.trim().clone() }
    let text = fs::read_to_string(abs.clone(), fs::Root::Anywhere)
    if info {
        println(agent_front(text.clone(), "agent", "builder") + " " + agent_front(text.clone(), "model", "sonnet") + " " + agent_front(text.clone(), "max_turns", "120") + " " + agent_front(text, "budget_usd", "20"))
        return
    }
    let mut wanted = agent_read("/proc/sys/kernel/random/uuid").trim().clone()
    let mut claude_args = agent_args(abs.clone(), text.clone(), wanted.clone())
    // The sections of docs/builder-facts.md the brief names go into its prompt.
    let facts = agent_read("docs/builder-facts.md")
    let unknown = agent_facts_unknown(text.clone(), facts.clone())
    if unknown != "" {
        if dry {
            println(f"unknown Facts heading: {unknown}")
            process::exit(2)
        }
        agent_escalate(dir.clone(), f"unknown Facts heading in {abs}: {unknown}")
    }
    claude_args[1] = claude_args[1].clone() + agent_facts(text.clone(), facts)
    let record = f"{abs}.session"
    let sum = process::run("cksum", [abs.clone()]).stdout.trim().split(" ").collect()[0].clone()
    let mut resumed = agent_resumable(abs.clone(), agent_read(record.clone()), sum.clone())
    if dry {
        if resumed != "" { claude_args = agent_resume_args(abs.clone(), text.clone(), resumed.clone()) }
        println(claude + " " + claude_args.join(" "))
        return
    }
    if fs::exists(f"{dir}/ESCALATE", fs::Root::Anywhere) {
        println(f"refused: {dir}/ESCALATE exists")
        process::exit(2)
    }
    let free = text::parse_i64(process::run("sh", ["-c", "df -m --output=avail / | tail -1"]).stdout.trim()) ?? 0
    if free < 3072 { agent_escalate(dir.clone(), f"less than 3 GB free ({free} MB)") }
    let today = process::run("date", ["+%F"]).stdout.trim().clone()
    let mut spent = 0
    for line in agent_read(f"{dir}/cost.txt").split("\n") {
        let parts = line.split(" ").collect()
        if parts.len() == 2 && parts[0] == today { spent += agent_micro(parts[1].clone()) }
    }
    if spent > 1000 * 1000000 { agent_escalate(dir.clone(), f"cost today {spent / 1000000} USD above 1000") }

    let mut out = process::run("true", [])
    if resumed != "" {
        fs::write(record.clone(), fs::Root::Anywhere, f"{resumed} {sum} resumed\n")
        out = process::run(claude.clone(), agent_resume_args(abs.clone(), text.clone(), resumed.clone()); within: 150.minutes())
        if !out.timed_out && agent_json(out.stdout.clone(), "session_id") == "" {
            println(f"resume of {resumed} failed at once (code {out.code}), starting fresh")
            resumed = ""
        } else {
            wanted = resumed.clone()
        }
    }
    if resumed == "" {
        fs::write(record.clone(), fs::Root::Anywhere, f"{wanted} {sum}\n")
        let draft = agent_draft(abs.clone(), text.clone())
        if draft != "" { claude_args[1] = claude_args[1].clone() + f". The converter's draft of its Cut: lines is {draft}, its notes {draft}.notes, the Rust it read {draft}.rs" }
        out = process::run(claude.clone(), claude_args; within: 150.minutes())
    }
    let json = out.stdout.clone()
    fs::write(f"{abs}.run.json", fs::Root::Anywhere, json.clone())
    let cost = agent_json(json.clone(), "total_cost_usd")
    let turns = agent_int(json.clone(), "num_turns")
    let tokens = agent_int(json.clone(), "input_tokens") + agent_int(json.clone(), "output_tokens") + agent_int(json.clone(), "cache_creation_input_tokens") + agent_int(json.clone(), "cache_read_input_tokens")
    let session = agent_json(json.clone(), "session_id")
    let reason = agent_json(json.clone(), "terminal_reason")
    let stem = (abs.strip_suffix(".md") ?? "").clone()
    let report = agent_report(abs.clone())
    // A report ends the run: nothing left to resume.
    if fs::exists(report.clone(), fs::Root::Anywhere) { fs::remove(record.clone(), fs::Root::Anywhere) }
    // A run cut off by the time limit prints no JSON: no empty cost line.
    if cost != "" {
        let old_cost = agent_read(f"{dir}/cost.txt")
        fs::write(f"{dir}/cost.txt", fs::Root::Anywhere, old_cost + f"{today} {cost}\n")
    }
    let exe = agent_exe()
    if exe != "" {
        process::run(exe, ["run", "scripts/batch.nika", "--", dir.clone(), "--tokens", abs.clone(), f"{tokens}", f"{turns}"])
    }
    // The debrief: the same session, resumed while its cache is warm, answers
    // what held it up, before any escalation stops this script.
    if !out.timed_out && session == wanted {
        let asked = process::run(claude.clone(), agent_debrief_args(session.clone(), agent_front(text.clone(), "model", "sonnet")); within: 10.minutes())
        let mut debrief = f"{abs}.debrief.md"
        if stem != "" { debrief = f"{stem}.debrief.md" }
        fs::write(debrief, fs::Root::Anywhere, agent_result(asked.stdout.clone()) + "\n")
        let more = agent_json(asked.stdout.clone(), "total_cost_usd")
        if more != "" {
            let with_run = agent_read(f"{dir}/cost.txt")
            fs::write(f"{dir}/cost.txt", fs::Root::Anywhere, with_run + f"{today} {more}\n")
        }
    }
    if out.timed_out { agent_escalate(dir.clone(), "timed out after 150 minutes") }
    if !out.ok { agent_escalate(dir.clone(), f"claude exited with code {out.code}") }
    if agent_json(json.clone(), "is_error") != "false" { agent_escalate(dir.clone(), "is_error") }
    if reason != "completed" { agent_escalate(dir.clone(), f"terminal_reason {reason}") }
    if !fs::exists(report.clone(), fs::Root::Anywhere) { agent_escalate(dir.clone(), f"no report {report}") }
    if session != wanted { agent_escalate(dir.clone(), f"session_id {session} differs from {wanted}") }
    let gate = agent_gate(report.clone())
    let before = agent_read(f"{dir}/RED").trim().clone()
    if gate == "" {
        fs::write(f"{dir}/RED", fs::Root::Anywhere, "")
    } else {
        fs::write(f"{dir}/RED", fs::Root::Anywhere, f"{abs}: {gate}\n")
        if before != "" { agent_escalate(dir.clone(), f"two red gates in a row: {before} / {abs}: {gate}") }
    }
    // The run's row for the Runs table of docs/tokenspeed.md (#858), once per agent
    // id. This only writes the file; the supervisor's commit takes it.
    let transcript = process::run("sh", ["-c", f"echo $HOME/.claude/projects/$(pwd | tr / -)/{session}.jsonl"]).stdout.trim().clone()
    if exe != "" && fs::exists(transcript.clone(), fs::Root::Anywhere) && fs::exists("docs/tokenspeed.md", fs::Root::Anywhere) {
        let row = process::run(exe, ["run", "scripts/tokenspeed.nika", "--", "--short", transcript.clone()]).stdout.trim().clone()
        if row.starts_with("| ") {
            let doc = fs::read_to_string("docs/tokenspeed.md", fs::Root::Anywhere)
            fs::write("docs/tokenspeed.md", fs::Root::Anywhere, agent_runs_insert(doc, row))
        }
    }
    let sha = process::run("git", ["rev-parse", "--short=8", "HEAD"]).stdout.trim().clone()
    println(f"done {sha} report {report} cost {cost} turns {turns}")
}
