// Start one headless agent from a brief (#847 step 2).
//
//     nikaia run scripts/agent.nika -- BRIEF [--dir DIR] [--dry-run] [--claude CMD]
//     nikaia run scripts/agent.nika -- --info BRIEF
//
// `--info` prints `agent model turns budget` (the frontmatter, defaults filled
// in) on one line; `batch.nika` reads it for its `NEXT` line.
//
// Reads BRIEF's frontmatter (agent, model, max_turns, budget_usd), runs
// `claude -p` within 90 minutes, writes BRIEF.run.json, appends the cost to
// DIR/tokens.txt (through `batch.nika --tokens`) and DIR/cost.txt, and prints
// `done <sha8> report <path> cost <usd> turns <n>`. A failed run writes
// DIR/ESCALATE (one line) and exits 2. A report with `Gate: red ...` writes
// DIR/RED (empty again after a green one); a second red in a row escalates. After
// the gate step it appends the run's row (`tokenspeed.nika --short`, read from the
// run's transcript under ~/.claude/projects) to the Runs table of
// docs/tokenspeed.md, once per agent id; it does not commit the file, the
// supervisor's commit takes it. `--dry-run` prints the command only.

use std::cli
use std::fs
use std::process
use std::text

fn agent_front(body: String, key: String, default: String) -> String {
    let lines = body.split("\n").collect()
    let mut found: String = default.clone()
    if lines.len() == 0 || lines[0].trim() != "---" { return found }
    let prefix = key.clone() + ":"
    for i in 1..<lines.len() {
        let line = lines[i].trim()
        if line == "---" { return found }
        if line.starts_with(prefix.clone()) {
            found = (line.strip_prefix(prefix.clone()) ?? "").trim().clone()
            return found
        }
    }
    return found
}

fn agent_tools(agent: String) -> String {
    if agent == "architect" {
        return "Read Grep Glob Bash Edit Write mcp__github__issue_read mcp__github__issue_write mcp__github__add_issue_comment mcp__github__list_issues mcp__github__search_issues mcp__github__sub_issue_write mcp__github__get_label"
    }
    return "Bash Read Edit Write Grep Glob"
}

// The argument list of `claude`, in the order the brief names.
fn agent_args(brief: String, body: String, session: String) -> Vec[String] {
    let agent = agent_front(body.clone(), "agent", "builder")
    let mut v: Vec[String] = []
    v.push("-p")
    v.push(f"Read your brief at {brief}")
    v.push("--agent")
    v.push(agent.clone())
    v.push("--model")
    v.push(agent_front(body.clone(), "model", "sonnet"))
    v.push("--max-turns")
    v.push(agent_front(body.clone(), "max_turns", "120"))
    v.push("--max-budget-usd")
    v.push(agent_front(body, "budget_usd", "20"))
    v.push("--output-format")
    v.push("json")
    v.push("--no-session-persistence")
    v.push("--session-id")
    v.push(session.clone())
    v.push("--allowedTools")
    v.push(agent_tools(agent))
    return v
}

// The raw value after `"key":` (first occurrence), quotes removed; "" if absent.
fn agent_json(body: String, key: String) -> String {
    let marker = "\"" + key + "\":"
    let parts = body.split(marker).collect()
    if parts.len() < 2 { return "" }
    let first = parts[1].split(",").collect()[0].clone()
    let value = first.split("}").collect()[0].clone()
    return value.trim().replace("\"", "")
}

fn agent_int(body: String, key: String) -> i64 {
    return text::parse_i64(agent_json(body, key)) ?? 0
}

// Micro-dollars of "12.34": whole * 1_000_000 + the first six decimals.
fn agent_micro(cost: String) -> i64 throws {
    let parts = cost.trim().split(".").collect()
    let whole = text::parse_i64(parts[0].clone()) ?? 0
    if parts.len() < 2 { return whole * 1000000 }
    let padded = parts[1].clone() + "000000"
    let frac = text::parse_i64(padded.bytes[0..6].text()) ?? 0
    return whole * 1000000 + frac
}

fn agent_escalate(dir: String, why: String) throws {
    fs::write(f"{dir}/ESCALATE", fs::Root::Anywhere, why.clone() + "\n")
    println(f"ESCALATE {why}")
    process::exit(2)
}

// The report's `Gate: red ...` line, or "" (green, or no Gate line).
fn agent_gate(report: String) -> String throws {
    for line in agent_read(report).split("\n") {
        if line.trim().starts_with("Gate: red") { return line.trim().clone() }
    }
    return ""
}

// `doc` with `row` added after the last row of the Runs table; unchanged when a
// row of the same agent id (the second field) is already there.
fn agent_runs_insert(doc: String, row: String) -> String {
    let id = row.split("|").collect()[2].trim().clone()
    let lines = doc.split("\n").collect()
    for line in lines {
        let fields = line.split("|").collect()
        if line.starts_with("| ") && fields.len() > 2 && fields[2].trim() == id { return doc.clone() }
    }
    let mut out: Vec[String] = []
    let mut in_runs = false
    let mut added = false
    for i in 0..<lines.len() {
        out.push(lines[i].clone())
        if lines[i].starts_with("## Runs") { in_runs = true }
        else if in_runs && !added && lines[i].starts_with("|") && !(i + 1 < lines.len() && lines[i + 1].starts_with("|")) {
            out.push(row.clone())
            added = true
        }
    }
    return out.join("\n")
}

fn agent_exe() -> String throws {
    for exe in ["target/fast/nikaia", "target/release/nikaia"] {
        if fs::exists(exe, fs::Root::Anywhere) { return exe.to_string() }
    }
    return ""
}

fn agent_read(path: String) -> String throws {
    if !fs::exists(path.clone(), fs::Root::Anywhere) { return "" }
    return fs::read_to_string(path, fs::Root::Anywhere)
}

fn main() throws {
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    let mut dry = false
    let mut info = false
    let mut brief: String = ""
    let mut dir: String = ""
    let mut claude: String = "claude"
    let mut i = 1
    while i < args.len() {
        if args[i] == "--dry-run" { dry = true }
        else if args[i] == "--info" { info = true }
        else if args[i] == "--dir" && i + 1 < args.len() { dir = args[i + 1].clone(); i += 1 }
        else if args[i] == "--claude" && i + 1 < args.len() { claude = args[i + 1].clone(); i += 1 }
        else { brief = args[i].clone() }
        i += 1
    }
    if brief == "" {
        println("usage: nikaia run scripts/agent.nika -- BRIEF [--dir DIR] [--dry-run] [--claude CMD]")
        process::exit(2)
    }
    let abs = process::run("realpath", [brief.clone()]).stdout.trim().clone()
    if dir == "" { dir = process::run("dirname", [abs.clone()]).stdout.trim().clone() }
    let text = fs::read_to_string(abs.clone(), fs::Root::Anywhere)
    if info {
        println(agent_front(text.clone(), "agent", "builder") + " " + agent_front(text.clone(), "model", "sonnet") + " " + agent_front(text.clone(), "max_turns", "120") + " " + agent_front(text, "budget_usd", "20"))
        return
    }
    let wanted = agent_read("/proc/sys/kernel/random/uuid").trim().clone()
    let claude_args = agent_args(abs.clone(), text, wanted.clone())
    if dry {
        println(claude + " " + claude_args.join(" "))
        return
    }
    if fs::exists(f"{dir}/ESCALATE", fs::Root::Anywhere) {
        println(f"refused: {dir}/ESCALATE exists")
        process::exit(2)
    }
    let free = text::parse_i64(process::run("sh", ["-c", "df -m --output=avail / | tail -1"]).stdout.trim()) ?? 0
    if free < 3072 { agent_escalate(dir.clone(), f"less than 3 GB free ({free} MB)") }
    let today = process::run("date", ["+%F"]).stdout.trim().clone()
    let mut spent = 0
    for line in agent_read(f"{dir}/cost.txt").split("\n") {
        let parts = line.split(" ").collect()
        if parts.len() == 2 && parts[0] == today { spent += agent_micro(parts[1].clone()) }
    }
    if spent > 200 * 1000000 { agent_escalate(dir.clone(), f"cost today {spent / 1000000} USD above 200") }

    let out = process::run(claude, claude_args; within: 90.minutes())
    let json = out.stdout.clone()
    fs::write(f"{abs}.run.json", fs::Root::Anywhere, json.clone())
    let cost = agent_json(json.clone(), "total_cost_usd")
    let turns = agent_int(json.clone(), "num_turns")
    let tokens = agent_int(json.clone(), "input_tokens") + agent_int(json.clone(), "output_tokens") + agent_int(json.clone(), "cache_creation_input_tokens") + agent_int(json.clone(), "cache_read_input_tokens")
    let session = agent_json(json.clone(), "session_id")
    let reason = agent_json(json.clone(), "terminal_reason")
    let stem = (abs.strip_suffix(".md") ?? "").clone()
    let mut report = f"{abs}.report.md"
    if !fs::exists(report.clone(), fs::Root::Anywhere) && stem != "" { report = f"{stem}.report.md" }
    let old_cost = agent_read(f"{dir}/cost.txt")
    fs::write(f"{dir}/cost.txt", fs::Root::Anywhere, old_cost + f"{today} {cost}\n")
    let exe = agent_exe()
    if exe != "" {
        process::run(exe, ["run", "scripts/batch.nika", "--", dir.clone(), "--tokens", abs.clone(), f"{tokens}", f"{turns}"])
    }
    if out.timed_out { agent_escalate(dir.clone(), "timed out after 90 minutes") }
    if !out.ok { agent_escalate(dir.clone(), f"claude exited with code {out.code}") }
    if agent_json(json.clone(), "is_error") != "false" { agent_escalate(dir.clone(), "is_error") }
    if reason != "completed" { agent_escalate(dir.clone(), f"terminal_reason {reason}") }
    if !fs::exists(report.clone(), fs::Root::Anywhere) { agent_escalate(dir.clone(), f"no report {report}") }
    if session != wanted { agent_escalate(dir.clone(), f"session_id {session} differs from {wanted}") }
    let gate = agent_gate(report.clone())
    let before = agent_read(f"{dir}/RED").trim().clone()
    if gate == "" {
        fs::write(f"{dir}/RED", fs::Root::Anywhere, "")
    } else {
        fs::write(f"{dir}/RED", fs::Root::Anywhere, f"{abs}: {gate}\n")
        if before != "" { agent_escalate(dir.clone(), f"two red gates in a row: {before} / {abs}: {gate}") }
    }
    // The run's row for the Runs table of docs/tokenspeed.md (#858), once per agent
    // id. This only writes the file; the supervisor's commit takes it.
    let transcript = process::run("sh", ["-c", f"echo $HOME/.claude/projects/$(pwd | tr / -)/{session}.jsonl"]).stdout.trim().clone()
    if exe != "" && fs::exists(transcript.clone(), fs::Root::Anywhere) && fs::exists("docs/tokenspeed.md", fs::Root::Anywhere) {
        let row = process::run(exe, ["run", "scripts/tokenspeed.nika", "--", "--short", transcript.clone()]).stdout.trim().clone()
        if row.starts_with("| ") {
            let doc = fs::read_to_string("docs/tokenspeed.md", fs::Root::Anywhere)
            fs::write("docs/tokenspeed.md", fs::Root::Anywhere, agent_runs_insert(doc, row))
        }
    }
    let sha = process::run("git", ["rev-parse", "--short=8", "HEAD"]).stdout.trim().clone()
    println(f"done {sha} report {report} cost {cost} turns {turns}")
}
