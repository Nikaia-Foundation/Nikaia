// The solver's measuring rod (ADR-270 D17, #1281), run standalone against the
// toolchain of the day: no compiler change, no `lower-std`, no rebuild.
//
//   nikaia run scripts/solver.nika -- run [--engine new|fm|new-fm|new-simplex] [--summary] [--stats] [--timeout S] DIR|FILE...
//   nikaia run scripts/solver.nika -- gen [DIR]
//   nikaia run scripts/solver.nika -- oracle [--write] FILE...
//   nikaia run scripts/solver.nika -- fuzz N SEED
//   nikaia run scripts/solver.nika -- fuzz --self-test
//   nikaia run scripts/solver.nika -- tune [--timeout S] [DIR]
//   nikaia run scripts/solver.nika -- fetch [DIR]
//   nikaia run scripts/solver.nika -- sample DIR OUT [N]
//   nikaia run scripts/solver.nika -- compare [--timeout S] [--instructions] --files DIR|FILE...
//
// `fetch` (#1338 item 2) builds the SMT-LIB set: it clones each source of
// `solver_sources` at its fixed commit into `DIR/.sources/` (default DIR
// `target/smtlib`) and copies its single-query QF_LIA and QF_LRA files with a
// status, at most 1 MiB each, into `DIR/qflia/FAMILY/` and `DIR/qflra/FAMILY/`
// (`tests/solver/SOURCES.md`). `sample` takes N files per logic (default 25)
// of at most 64 KiB, at even steps of the sorted list, into OUT: the CI
// sample `tests/solver/sample`.
//
// `compare` (#1338 items 3-4) answers each file with ours (the rod), z3 and
// cvc5 (`$Z3`, `$CVC5` or `PATH`), all under the same wall-clock limit
// (default 10 s): one line per file (a disagreement marked `DISAGREE`), then
// per directory and solver: solved, wrong (against the status), PAR-2 in
// seconds (an unsolved file counts twice the limit), peak and median memory
// (never below the runner's own, which the header names). `--instructions`
// runs each solver under callgrind and adds the mean instructions per solved
// file; time is then not the figure, and the limit is a hundred times wider.
//
// `tune` (ADR-270 D14, #1284 item 5) splits the `.smt2` files of DIR
// (default `tests/solver/qflia`), sorted by name, into two fixed halves: the
// files at even places tune, the files at odd places are held out. It walks
// the parameters of `sv_params` (`tools/sv_strategy.nika`) one by one, tries
// each of its candidate values on the tuning half with the engine
// `new:name=value,...`, and keeps a value only where it lowers the half's
// PAR-2 with no wrong answer. Then it reports the defaults and the tuned set
// on the held-out half, which the tuning never saw.
//
// `run` puts the logic layer's files of `crates/nikaia-std/src/compiler/` (read,
// never copied), the new engine's files there too (moved in #1285),
// and the driver `crates/nikaia-std/src/solver/sv_rod.nika` into
// one package in a temporary directory, each its own file, builds it with the `nikaia` that runs
// this script (the binary kept in `target/solver-rod/`, see `solver_build`),
// and answers every `.smt2` file: one line per file (`name answer work`),
// then a row per directory: solved, unknown (overflow and files the reader
// refuses among them), malformed (a script that is not well-formed
// SMT-LIB, its reason on its line, ADR-270 D28), wrong, PAR-2 over the work budget, certificates
// checked, models evaluated. `--stats` adds below each file's line the new
// engine's counters (#1312 item 2): the SAT core's conflicts, the theory's,
// theory lemmas and those repeating an earlier one, decisions, restarts.
// The query is the conjunction of a file's assertions with the goal `false`:
// *proved* is `unsat`, *refuted* is `sat`. A *proved* whose certificate
// `lg_verify` rejects, a *refuted* whose model `lg_verify_model` rejects, and
// any answer against the file's status count as wrong.
use std::cli
use std::env
use std::fs
use std::process
use std::text

// The logic layer's files, in the order the program takes them.
fn solver_logic_files() -> Vec[String] {
	return ["prover_arena", "solver_terms", "prove_text", "logic_lia", "logic_horn", "logic_normal", "logic_search", "logic_smtlib", "logic_alethe"]
}

// The new engine's files of `crates/nikaia-std/src/compiler/` (#1282, #1283, #1285), in the
// order the program takes them, before the driver.
fn solver_engine_files() -> Vec[String] {
	return ["sv_num", "sv_row", "sv_proof", "sv_check", "sv_sat", "sv_cnf", "sv_theory", "sv_elim", "sv_simplex", "sv_fast", "sv_pre", "sv_walk", "sv_strategy", "sv_smt", "sv_smtlib", "sv_lemma", "sv_nl", "sv_rod_line"]
}

// The work budget PAR-2 doubles: `lg_budget().cases`, the branches
// Fourier-Motzkin's search may look at.
fn solver_budget() -> i64 {
	return 1024
}

fn solver_toolchain(repo: String) -> String throws {
	let exe = process::run(
		"sh",
		[
			"-c",
			"p=$PPID; while [ \"$p\" -gt 1 ]; do e=$(readlink /proc/$p/exe); if [ \"$(basename \"$e\")\" = nikaia ]; then echo \"$e\"; exit 0; fi; p=$(cut -d' ' -f4 /proc/$p/stat); done",
		],
	).stdout.trim().clone()
	if exe.len() == 0 {
		// Run by hand from a shell (`nikaia run` replaced itself with this
		// program): the repository's own build, only where it exists (#1305).
		for built in [f"{repo}/target/fast/nikaia", f"{repo}/target/release/nikaia"] {
			if fs::exists(built.clone(), fs::Root::Anywhere) { return built }
		}
		eprintln(f"no nikaia found: none among this program's ancestors, none in {repo}/target/fast or target/release (#1305)")
		process::exit(2)
	}
	return exe
}

fn solver_root() -> String throws {
	let here = process::run("git", ["rev-parse", "--show-toplevel"]).stdout.trim().clone()
	if fs::exists(f"{here}/scripts/gate.nika", fs::Root::Anywhere) { return here }
	return process::run("pwd", []).stdout.trim().clone()
}

// --- Assembling and building the program ---

// The program's files: the logic layer's, the engine's and the driver's, each
// kept a file of its own in the package (Part I 9.1: one namespace), beside
// a `main.nika` that calls `sv_rod_main`.
//
// **Files, not one concatenated text** (#1949): the build's ledger proves its
// panics unit by unit, and the 17,800 lines as one unit took a cold build
// about a minute longer than the same lines as 28 files.
fn solver_program_files(repo: String) -> Vec[String] {
	let mut paths: Vec[String] = []
	for name in solver_logic_files() {
		paths.push(f"{repo}/crates/nikaia-std/src/compiler/{name}.nika")
	}
	for name in solver_engine_files() {
		paths.push(f"{repo}/crates/nikaia-std/src/compiler/{name}.nika")
	}
	paths.push(f"{repo}/crates/nikaia-std/src/solver/sv_rod.nika")
	return paths
}

// Writes the program's package into `tmp`: its manifest, each file of
// `solver_program_files` under `src/`, and `src/main.nika`.
fn solver_program(repo: String, tmp: String) throws {
	process::run("mkdir", ["-p", f"{tmp}/src"])
	fs::write(
		f"{tmp}/nikaia.toml",
		fs::Root::Anywhere,
		"[package]\nname = \"solver_rod\"\nversion = \"0.1.0\"\n",
	)
	let mut args: Vec[String] = solver_program_files(repo)
	args.push(f"{tmp}/src/")
	process::run("cp", args)
	fs::write(f"{tmp}/src/main.nika", fs::Root::Anywhere, "fn main() throws {\n    sv_rod_main()\n}\n")
}

// The environment the program builds in: the program's lints capped (#1949),
// and only the program's (`NIKAIA_CAP_LINTS`, read by the build's `rustc`
// wrapper in `project_drive.nika`). The program leaves out the files'
// `*_test_*` functions and more, so rustc warns of a hundred and forty
// functions never used; a build the backend said anything about lowers the
// whole program a second time to place what it said (`report` in
// `crates/nikaia/src/project.rs`, ADR-300), about 70 s of a cold build, for
// warnings `solver_build` never shows. **Not `RUSTFLAGS=--cap-lints=allow`**,
// as it was: the flags are part of every dependency's fingerprint, so Cargo
// built all of them again (`std` and about 70 crates) beside the tree CI
// restores (#1956), which pushed `solver_fuzz` past its 300 s.
fn solver_build_env() -> Vec[(String, String)] {
	return [("NIKAIA_CAP_LINTS", "allow")]
}

// Builds the program and gives the binary's path, or an empty text after
// printing why it did not build. The binary is kept in
// `target/solver-rod/<key>/`, the key a hash of the program's files and of the
// `nikaia` that builds it: a second run of the same program with the same
// toolchain (the tests run it eight times) builds nothing.
//
// **One build per key at a time** (#1915): `solver_run` and `solver_fuzz`,
// each at both settings, start cold on the same key, and every one of them
// built the whole program (about a minute of one core each) beside the
// others, which pushed `solver_run` past its 300 s on a loaded runner. The
// build and the copy into the kept place run under a lock of the key's
// directory; a run that waited finds the binary there and builds nothing.
fn solver_build(repo: String, nikaia: String) -> String throws {
	let tmp = process::run("mktemp", ["-d"]).stdout.trim().clone()
	solver_program(repo, tmp.clone())
	let key = process::run(
		"sh",
		[
			"-c",
			"{ (cd \"$1/src\" && for f in *.nika; do echo \"== $f\"; cat \"$f\"; done); stat -L -c '%s %Y %n' \"$2\"; } | sha256sum | cut -c1-16",
			"sh",
			tmp.clone(),
			nikaia.clone(),
		],
	).stdout.trim().clone()
	let bin = f"{tmp}/target/nikaia/bin/solver_rod"
	if key == "" {
		let built = process::run(nikaia, ["build"]; dir: tmp.clone(), env: solver_build_env())
		if built.ok && fs::exists(bin.clone(), fs::Root::Anywhere) { return bin }
		solver_build_failed(built.stderr, tmp)
		return ""
	}
	let kept = f"{repo}/target/solver-rod/{key}/solver_rod"
	if fs::exists(kept.clone(), fs::Root::Anywhere) {
		process::run("rm", ["-rf", tmp])
		return kept
	}
	process::run("mkdir", ["-p", f"{repo}/target/solver-rod/{key}"])
	// Under the lock: built only where no run before this one kept it, then
	// copied under a name of its own and renamed, so the kept place never
	// holds half a binary.
	let built = process::run(
		"flock",
		[
			f"{repo}/target/solver-rod/{key}/lock",
			"sh",
			"-c",
			"[ -e \"$1\" ] && exit 0; \"$2\" build || exit 1; [ -e \"$3\" ] || exit 1; cp \"$3\" \"$1.$$\" && mv -f \"$1.$$\" \"$1\"",
			"sh",
			kept.clone(),
			nikaia,
			bin,
		];
		dir: tmp.clone(),
		env: solver_build_env(),
	)
	if !built.ok || !fs::exists(kept.clone(), fs::Root::Anywhere) {
		solver_build_failed(built.stderr, tmp)
		return ""
	}
	process::run("rm", ["-rf", tmp])
	return kept
}

// Says why the program did not build, from the build's `stderr`, and removes
// its directory `tmp`.
fn solver_build_failed(stderr: String, tmp: String) throws {
	println("the solver program did not build:")
	for line in stderr.lines() {
		if line.starts_with("error") || line.contains("-->") { println(line) }
	}
	process::run("rm", ["-rf", tmp])
}

// --- run ---

// One answered file.
struct SolverRow {
	group: String,
	name: String,
	answer: String,
	work: i64,
	// The work as the engine wrote it, with the fast path that answered
	// (`3/difference`).
	shown: String,
}

// The `.smt2` files of an argument, each with the directory it is counted
// under: its path below the argument's parent.
fn solver_files(arg: String) -> Vec[(String, String)] throws {
	let mut out: Vec[(String, String)] = []
	let trimmed = arg.trim_end_matches("/").to_string()
	let base = trimmed.split("/").last() ?? trimmed
	if trimmed.ends_with(".smt2") {
		let parts: Vec[String] = trimmed.split("/").collect()
		let group = if parts.len() >= 2 { parts[parts.len() - 2].clone() } else { "." }
		out.push((group, trimmed.clone()))
		return out
	}
	let mut rels: Vec[String] = []
	for p in fs::walk(trimmed.clone(), fs::Root::Anywhere) {
		let rel = p.to_text()
		if rel.ends_with(".smt2") { rels.push(rel) }
	}
	rels.sort()
	for rel in rels {
		let at = rel.rfind("/")
		// `f"{base}"`, not `base.to_string()`: the latter makes the
		// returned tuples `EitherText` and a caller's `Vec[(String,
		// String)]` fails in rustc (#1311).
		let group = match at {
			null => f"{base}",
			else => f"{base}/{rel[0..<(at ?? 0)]}",
		}
		out.push((group, f"{trimmed}/{rel}"))
	}
	return out
}

// The engine's answer to one file: `answer work`, from the built binary.
// The work is a count, after a fast path's answer followed by `/` and the
// path's name; the third part is the work as written.
fn solver_answer(
	bin: String,
	engine: String,
	path: String,
	timeout: i64,
) -> (String, i64, String) throws {
	let (answer, work, shown, _) = solver_answer_stats(bin, engine, path, timeout, false)
	return (answer, work, shown)
}

// `solver_answer` and, where `stats`, the counters' line the binary wrote
// below it (`stats: ...`; `""` without one).
fn solver_answer_stats(
	bin: String,
	engine: String,
	path: String,
	timeout: i64,
	stats: bool,
) -> (String, i64, String, String) throws {
	let args: Vec[String] = if stats { ["--stats", engine, path] } else { [engine, path] }
	let out = process::run(bin, args; within: timeout.seconds())
	if out.timed_out { return ("unknown (timeout)", -1, "-1", "") }
	if !out.ok { return ("unknown (crashed)", -1, "-1", "") }
	// Each text of the returned tuple made with `f"..."`: a `.to_string()`
	// of a view makes the tuple `EitherText` and the callers fail in rustc
	// (#1311).
	let all = out.stdout.trim().to_string()
	let nl = all.find("\n") ?? all.len()
	let line = f"{all[0..<nl]}"
	let counted = if nl < all.len() { f"{all[nl + "\n".len()..]}" } else { "" }
	let at = line.rfind(" ") ?? return ("unknown (no answer)", -1, "-1", "")
	let shown = f"{line[at + 1..]}"
	let slash = shown.find("/") ?? shown.len()
	let work = text::parse_i64(shown[0..<slash].to_string()) ?? -1
	return (f"{line[0..<at]}", work, shown, counted)
}

fn solver_solved(answer: String) -> bool {
	return answer == "proved" || answer == "refuted"
}

// `n` tenths as `a.b`.
fn solver_tenths(n: i64) -> String {
	return f"{n / 10}.{n % 10}"
}

// The summary row of `rows`.
fn solver_summary(label: String, rows: Vec[SolverRow]) -> String {
	let mut solved = 0
	let mut proved = 0
	let mut refuted = 0
	let mut unknown = 0
	let mut overflow = 0
	let mut unreadable = 0
	let mut malformed = 0
	let mut wrong = 0
	let mut checked = 0
	let mut evaluated = 0
	let mut par2 = 0
	for r in rows {
		if solver_solved(r.answer.clone()) {
			solved += 1
			par2 += r.work
		} else {
			par2 += 2 * solver_budget()
		}
		if r.answer == "proved" { proved += 1 }
		if r.answer == "refuted" { refuted += 1 }
		if r.answer.starts_with("unknown") { unknown += 1 }
		if r.answer == "unknown (overflow)" { overflow += 1 }
		if r.answer == "unknown (unreadable)" { unreadable += 1 }
		if r.answer.starts_with("malformed") { malformed += 1 }
		if r.answer.starts_with("wrong") { wrong += 1 }
		if r.answer == "proved"
			|| r.answer == "wrong (certificate rejected)"
			|| r.answer == "wrong (lemma rejected)"
			|| r.answer == "wrong (proved, status sat)" { checked += 1 }
		if r.answer == "refuted"
			|| r.answer == "wrong (model rejected)"
			|| r.answer == "wrong (refuted, status unsat)" { evaluated += 1 }
	}
	let n = rows.len()
	let mean = if n > 0 { par2 * 10 / n } else { 0 }
	return f"{label}: {n} files, solved {solved} (proved {proved}, refuted {refuted}), unknown {unknown} (overflow {overflow}, unreadable {unreadable}), malformed {malformed}, wrong {wrong}, PAR-2 {solver_tenths(mean)}, certificates checked {checked}, models evaluated {evaluated}"
}

fn solver_run(repo: String, nikaia: String, args: Vec[String]) throws {
	// The CDCL(T) engine by default (#1283); `fm` stays as the cross-check.
	let mut engine: String = "new"
	let mut summary_only = false
	let mut stats = false
	let mut timeout = 60
	let mut targets: Vec[String] = []
	let mut i = 0
	while i < args.len() {
		let a = args[i].clone()
		if a == "--engine" && i + 1 < args.len() {
			engine = args[i + 1].clone()
			i += 2
			continue
		}
		if a == "--timeout" && i + 1 < args.len() {
			timeout = text::parse_i64(args[i + 1].clone()) ?? 60
			i += 2
			continue
		}
		if a == "--summary" {
			summary_only = true
		} else if a == "--stats" {
			stats = true
		} else {
			targets.push(a)
		}
		i += 1
	}
	if engine != "fm" && engine != "new" && engine != "new-fm" && engine != "new-simplex" {
		println(f"unknown engine {engine}: fm, new, new-fm or new-simplex")
		process::exit(2)
	}
	let mut files: Vec[(String, String)] = []
	for t in targets { files.extend(solver_files(t)) }
	if files.len() == 0 {
		println("no .smt2 files")
		return
	}
	let bin = solver_build(repo, nikaia)
	if bin == "" { process::exit(1) }
	let mut rows: Vec[SolverRow] = []
	for (group, path) in files {
		let (answer, work, shown, counted) = solver_answer_stats(
			bin.clone(),
			engine.clone(),
			path.clone(),
			timeout,
			stats,
		)
		let file = path.split("/").last() ?? path
		let row = SolverRow {
			group: group.clone(),
			name: f"{group}/{file}",
			answer: answer,
			work: work,
			shown: shown,
		}
		if !summary_only {
			println(f"{row.name} {row.answer} {row.shown}")
			if counted != "" { println(f"  {counted}") }
		}
		rows.push(row)
	}
	let mut groups: Vec[String] = []
	for r in rows {
		if !groups.contains(r.group.clone()) { groups.push(r.group.clone()) }
	}
	for g in groups {
		let mut part: Vec[SolverRow] = []
		for r in rows {
			if r.group == g { part.push(r.clone()) }
		}
		println(solver_summary(g, part))
	}
	if groups.len() > 1 { println(solver_summary("all", rows)) }
}

// --- oracle ---

fn solver_has_z3() -> bool throws {
	return process::run("sh", ["-c", "command -v z3"]).ok
}

// z3's answer to a file: `sat`, `unsat` or `unknown`.
fn solver_z3(path: String) -> String throws {
	let out = process::run("z3", ["-smt2", "-T:30", path])
	for line in out.stdout.lines() {
		let w = line.trim()
		if w == "sat" || w == "unsat" || w == "unknown" { return w.to_string() }
	}
	return "unknown"
}

// The status a file states, as the driver reads it.
fn solver_status(source: String) -> String {
	for raw in source.lines() {
		let line = raw.trim()
		if line.starts_with("(set-info :status ") {
			let rest = line["(set-info :status ".len()..].replace(")", "").trim().clone()
			if rest == "sat" || rest == "unsat" { return rest }
		}
		if line.starts_with("; EXPECT: ") {
			let rest = line["; EXPECT: ".len()..].trim().clone()
			if rest == "sat" || rest == "unsat" { return rest }
		}
	}
	return ""
}

// The source with its `:status` set to `status`: the line replaced where there
// is one, else written after `set-logic` (or first). An `unknown` status is
// not written.
fn solver_with_status(source: String, status: String) -> String {
	if status != "sat" && status != "unsat" { return source }
	let wanted = f"(set-info :status {status})"
	let mut out: Vec[String] = []
	let mut done = false
	for line in source.lines() {
		if line.trim().starts_with("(set-info :status ") {
			if !done { out.push(wanted.clone()) }
			done = true
			continue
		}
		out.push(line.to_string())
		if !done && line.trim().starts_with("(set-logic ") {
			out.push(wanted.clone())
			done = true
		}
	}
	if !done { out.insert(0, wanted) }
	return out.join("\n") + "\n"
}

fn solver_oracle(args: Vec[String]) throws {
	if !solver_has_z3() {
		println("z3 is not on the path: no oracle")
		return
	}
	let mut write = false
	let mut paths: Vec[String] = []
	for a in args {
		if a == "--write" {
			write = true
		} else {
			for (_, p) in solver_files(a) { paths.push(p) }
		}
	}
	let mut disagree = 0
	for p in paths {
		let source = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		let said = solver_status(source.clone())
		let z3 = solver_z3(p.clone())
		if write && z3 != "unknown" && said == "" {
			fs::write(p.clone(), fs::Root::Anywhere, solver_with_status(source, z3.clone()))
			println(f"{p} {z3} written")
		} else if said != "" && z3 != "unknown" && said != z3 {
			disagree += 1
			println(f"{p} status {said}, z3 {z3}")
		} else {
			println(f"{p} {z3}")
		}
	}
	println(f"{paths.len()} files, {disagree} disagree with z3")
}

// --- gen: the stress families of D9 ---

fn solver_declare(names: Vec[String]) -> String {
	let mut out = ""
	for n in names { out = out + f"(declare-const {n} Int)\n" }
	return out
}

fn solver_names(prefix: String, from: i64, to: i64) -> Vec[String] {
	let mut out: Vec[String] = []
	for i in from..<(to + 1) { out.push(f"{prefix}{i}") }
	return out
}

fn solver_script(declared: Vec[String], asserts: Vec[String]) -> String {
	let mut out = "(set-logic QF_LIA)\n" + solver_declare(declared)
	for a in asserts { out = out + f"(assert {a})\n" }
	return out + "(check-sat)\n(exit)\n"
}

// Guards: `y` counts the steps where `x` rises, as an `if x[i-1] < x[i]`
// chain. Even `n` asks for more steps than there are (unsat), odd `n` for
// every one (sat).
fn solver_guards(n: i64) -> String {
	let mut names = solver_names("x", 0, n)
	names.extend(solver_names("y", 0, n))
	let mut asserts: Vec[String] = ["(= y0 0)"]
	for i in 1..<(n + 1) {
		asserts.push(f"(or (and (< x{i - 1} x{i}) (= y{i} (+ y{i - 1} 1))) (and (>= x{i - 1} x{i}) (= y{i} y{i - 1})))")
	}
	if n % 2 == 0 { asserts.push(f"(> y{n} {n})") } else { asserts.push(f"(= y{n} {n})") }
	return solver_script(names, asserts)
}

// Unrelated disjunctions: `x = 0 || x = 1` for each of `n` variables beside a
// core about `i` and `k` that does not mention them. Even `n` holds the
// bounds-check contradiction (unsat), odd `n` only its consistent half (sat).
fn solver_disjunctions(n: i64) -> String {
	let mut names = solver_names("x", 1, n)
	names.push("i")
	names.push("k")
	let mut asserts: Vec[String] = []
	for name in solver_names("x", 1, n) { asserts.push(f"(or (= {name} 0) (= {name} 1))") }
	asserts.push("(<= 0 i)")
	asserts.push("(< i k)")
	if n % 2 == 0 { asserts.push("(not (< i (+ k 1)))") }
	return solver_script(names, asserts)
}

// `+1 or +2` paths: a counter stepping by one or two over `n` steps. Even `n`
// asks for more than `2n` (unsat), odd `n` for exactly `n + 1` (sat).
fn solver_steps(n: i64) -> String {
	let names = solver_names("c", 0, n)
	let mut asserts: Vec[String] = ["(= c0 0)"]
	for i in 1..<(n + 1) {
		asserts.push(f"(or (= c{i} (+ c{i - 1} 1)) (= c{i} (+ c{i - 1} 2)))")
	}
	if n % 2 == 0 { asserts.push(f"(> c{n} {2 * n})") } else { asserts.push(f"(= c{n} {n + 1})") }
	return solver_script(names, asserts)
}

// Parity: `x1 + ... + xn = 2m + 1` with each `xi` in `{-1, 1}`; unsat for even
// `n`, sat for odd.
fn solver_parity(n: i64) -> String {
	let mut names = solver_names("x", 1, n)
	names.push("m")
	let mut asserts: Vec[String] = []
	for name in solver_names("x", 1, n) { asserts.push(f"(or (= {name} (- 1)) (= {name} 1))") }
	asserts.push(f"(= (+ {solver_names("x", 1, n).join(" ")} 0) (+ (* 2 m) 1))")
	return solver_script(names, asserts)
}

// `blank = 2·n`, the shape of D9's 92 unknown queries: `n` values each twice
// some integer, summed. Even `n` asks for an odd sum (unsat), odd `n` for an
// even one (sat).
fn solver_blank(n: i64) -> String {
	let mut names = solver_names("b", 1, n)
	names.extend(solver_names("k", 1, n))
	names.push("m")
	let mut asserts: Vec[String] = []
	for i in 1..<(n + 1) { asserts.push(f"(= b{i} (* 2 k{i}))") }
	let total = f"(+ {solver_names("b", 1, n).join(" ")} 0)"
	if n % 2
		== 0 { asserts.push(f"(= {total} (+ (* 2 m) 1))") } else {
			asserts.push(f"(= {total} (+ (* 2 m) 2))")
		}
	return solver_script(names, asserts)
}

fn solver_two(n: i64) -> String {
	return if n < 10 { f"0{n}" } else { f"{n}" }
}

fn solver_gen(args: Vec[String]) throws {
	let dir = if args.len() > 0 { args[0].clone() } else { "tests/solver/stress" }
	let oracle = solver_has_z3()
	let mut written = 0
	for family in ["guards", "disjunctions", "steps", "parity", "blank"] {
		process::run("mkdir", ["-p", f"{dir}/{family}"])
		let first = if family == "parity" { 2 } else { 1 }
		for n in first..<13 {
			let source = match family {
				"guards" => solver_guards(n),
				"disjunctions" => solver_disjunctions(n),
				"steps" => solver_steps(n),
				"parity" => solver_parity(n),
				else => solver_blank(n),
			}
			let path = f"{dir}/{family}/{family}-{solver_two(n)}.smt2"
			fs::write(path.clone(), fs::Root::Anywhere, source.clone())
			if oracle {
				let z3 = solver_z3(path.clone())
				if z3
					!= "unknown" {
						fs::write(path.clone(), fs::Root::Anywhere, solver_with_status(source, z3))
					}
			}
			written += 1
		}
	}
	let note = if oracle { "status from z3" } else { "no z3 on the path: no status written" }
	println(f"{written} files in {dir}, {note}")
}

// --- fuzz ---

// A linear congruential generator: the same seed, the same queries.
struct SolverRandom {
	state: i64,
}

impl SolverRandom {
	fn below(mut self, n: i64) -> i64 {
		self.state = (self.state * 1103515245 + 12345) % 2147483648
		return (self.state / 65536) % n
	}
}

fn solver_atom(mut r: SolverRandom, vars: i64) -> String {
	let mut terms: Vec[String] = []
	for v in 0..<vars {
		let c = r.below(7) - 3
		if c == 0 || r.below(2) == 0 { continue }
		if c
			== 1 { terms.push(f"x{v}") } else if c
			< 0 { terms.push(f"(* (- {-c}) x{v})") } else { terms.push(f"(* {c} x{v})") }
	}
	if terms.len() == 0 { terms.push(f"x{r.below(vars)}") }
	let lhs = if terms.len() == 1 { terms[0].clone() } else { f"(+ {terms.join(" ")})" }
	let d = r.below(21) - 10
	let rhs = if d < 0 { f"(- {-d})" } else { f"{d}" }
	let ops: Vec[String] = ["<=", "<", "=", ">=", ">", "distinct"]
	let op = ops[r.below(6)].clone()
	return f"({op} {lhs} {rhs})"
}

// A random query over 1-8 variables: atoms, and disjunctions of two or three.
fn solver_query(mut r: SolverRandom) -> String {
	let vars = 1 + r.below(8)
	let names = solver_names("x", 0, vars - 1)
	let mut asserts: Vec[String] = []
	let count = 1 + r.below(6)
	for _ in 0..<count {
		if r.below(3) == 0 {
			let width = 2 + r.below(2)
			let mut parts: Vec[String] = []
			for _ in 0..<width { parts.push(solver_atom(r, vars)) }
			asserts.push(f"(or {parts.join(" ")})")
		} else {
			asserts.push(solver_atom(r, vars))
		}
	}
	return solver_script(names, asserts)
}

// z3's status of the `i`th query, or the self-test's stub: `unsat` for every
// third query, `sat` otherwise; it exercises the comparison, not the queries.
fn solver_fuzz_oracle(stub: bool, i: i64, path: String) -> String throws {
	if !stub { return solver_z3(path) }
	if i % 3 == 0 { return "unsat" }
	return "sat"
}

fn solver_fuzz(repo: String, nikaia: String, args: Vec[String]) throws {
	let self_test = args.contains("--self-test")
	if !self_test && args.len() < 2 {
		println("fuzz N SEED, or fuzz --self-test")
		process::exit(2)
	}
	if !self_test && !solver_has_z3() {
		println("z3 is not on the path: no oracle, no fuzzing")
		return
	}
	let n = if self_test { 8 } else { text::parse_i64(args[0].clone()) ?? 0 }
	let seed = if self_test { 7 } else { text::parse_i64(args[1].clone()) ?? 0 }
	let bugs: String = if self_test { process::run("mktemp", ["-d"]).stdout.trim().clone() } else {
		f"{repo}/tests/solver/bugs"
	}
	let work: String = process::run("mktemp", ["-d"]).stdout.trim().clone()
	process::run("mkdir", ["-p", bugs.clone()])
	let bin = solver_build(repo, nikaia)
	if bin == "" { process::exit(1) }
	let mut r = SolverRandom { state: seed }
	let mut proved = 0
	let mut refuted = 0
	let mut unknown = 0
	let mut found = 0
	for i in 0..<n {
		let source = solver_query(r)
		let name = f"fuzz-{seed}-{i}.smt2"
		let path = f"{work}/{name}"
		fs::write(path.clone(), fs::Root::Anywhere, source.clone())
		let z3 = solver_fuzz_oracle(self_test, i, path.clone())
		let (answer, _, _) = solver_answer(bin.clone(), "new", path.clone(), 60)
		if answer == "proved" { proved += 1 }
		if answer == "refuted" { refuted += 1 }
		if answer.starts_with("unknown") { unknown += 1 }
		let against = (answer == "proved" && z3 == "sat") || (answer == "refuted" && z3 == "unsat")
		if against || answer.starts_with("wrong") {
			found += 1
			fs::write(
				f"{bugs}/{name}",
				fs::Root::Anywhere,
				solver_with_status(source.clone(), z3.clone()),
			)
			println(f"{name}: engine {answer}, z3 {z3}")
		}
		if self_test && i == 0 { print(source) }
	}
	println(f"{n} queries (seed {seed}): proved {proved}, refuted {refuted}, unknown {unknown}, disagreements {found}")
	if self_test { process::run("rm", ["-rf", bugs]) }
	process::run("rm", ["-rf", work])
}

// --- tune: the parameters on one half, the report on the other ---

// The candidate values of each tuned parameter of `sv_params`, the default
// first.
fn solver_tune_candidates() -> Vec[String] {
	return [
		"walk_first=250|0|100|500",
		"moves_per_unit=100|50|400",
		"noise=100|30|300",
		"tenure=3|1|10",
		"walk_after=true|false",
		"dense_width=4|2|8",
		"theory=both|simplex|fm",
		"cut_kind=gmi|cg",
		"cut_rounds=8|2|32",
		"bland_after=64|8",
	]
}

// The engine for the settings `name=value`: `new` where there are none.
fn solver_tune_engine(settings: Vec[String]) -> String {
	if settings.len() == 0 { return "new" }
	return f"new:{settings.join(",")}"
}

// The rows of `files` answered by `engine`.
fn solver_tune_rows(
	bin: String,
	engine: String,
	files: Vec[(String, String)],
	timeout: i64,
) -> Vec[SolverRow] throws {
	let mut rows: Vec[SolverRow] = []
	for (group, path) in files {
		let (answer, work, shown) = solver_answer(
			bin.clone(),
			engine.clone(),
			path.clone(),
			timeout,
		)
		let file = path.split("/").last() ?? path
		rows.push(SolverRow {
			group: group.clone(),
			name: f"{group}/{file}",
			answer: answer,
			work: work,
			shown: shown,
		})
	}
	return rows
}

// The PAR-2 sum of `rows`, or -1 where one of them is wrong.
fn solver_tune_cost(rows: Vec[SolverRow]) -> i64 {
	let mut cost = 0
	for r in rows {
		if r.answer.starts_with("wrong") { return -1 }
		if solver_solved(r.answer.clone()) {
			cost += r.work
		} else {
			cost += 2 * solver_budget()
		}
	}
	return cost
}

fn solver_tune(repo: String, nikaia: String, args: Vec[String]) throws {
	let mut timeout = 30
	let mut dir = f"{repo}/tests/solver/qflia"
	let mut i = 0
	while i < args.len() {
		if args[i] == "--timeout" && i + 1 < args.len() {
			timeout = text::parse_i64(args[i + 1].clone()) ?? 30
			i += 2
			continue
		}
		dir = args[i].clone()
		i += 1
	}
	let files = solver_files(dir)
	let mut tuning: Vec[(String, String)] = []
	let mut held: Vec[(String, String)] = []
	for k in 0..<files.len() {
		if k % 2 == 0 { tuning.push(files[k].clone()) } else { held.push(files[k].clone()) }
	}
	if tuning.len() == 0 || held.len() == 0 {
		println("tune needs two .smt2 files at least")
		process::exit(2)
	}
	let bin = solver_build(repo, nikaia)
	if bin == "" { process::exit(1) }
	println(f"tuning on {tuning.len()} files, holding out {held.len()}")
	let mut settings: Vec[String] = []
	let mut best = solver_tune_cost(solver_tune_rows(bin.clone(), "new", tuning, timeout))
	println(f"defaults: PAR-2 sum {best}")
	for line in solver_tune_candidates() {
		let (name, values) = line.split_once("=") ?? continue
		let mut chosen: Vec[String] = settings.clone()
		for value in values.split("|") {
			let mut trial: Vec[String] = []
			for s in settings {
				if !s.starts_with(f"{name}=") { trial.push(s.clone()) }
			}
			trial.push(f"{name}={value}")
			let engine = solver_tune_engine(trial)
			let cost = solver_tune_cost(solver_tune_rows(
				bin.clone(),
				engine.clone(),
				tuning,
				timeout,
			))
			println(f"  {engine}: PAR-2 sum {cost}")
			if cost >= 0 && cost < best {
				best = cost
				chosen = trial
			}
		}
		settings = chosen
	}
	let tuned = solver_tune_engine(settings)
	println(f"tuned: {tuned}, PAR-2 sum {best}")
	println(solver_summary(
		"held out, defaults",
		solver_tune_rows(bin.clone(), "new", held, timeout),
	))
	println(solver_summary(
		f"held out, {tuned}",
		solver_tune_rows(bin, tuned, held, timeout),
	))
}

// --- fetch: the SMT-LIB set of #1338, by commit ---

// One Git repository the set is taken from: its URL, the commit it is read
// at, and the paths (sparse-checkout patterns) read there.
struct SolverSource {
	name: String,
	url: String,
	commit: String,
	paths: Vec[String],
}

// The sources of the set (#1338 item 2; origin and licence of each family in
// `tests/solver/SOURCES.md`). Only GitHub reaches this environment, so the
// SMT-LIB library comes from SMT-LIB's own staging repositories (the files of
// each release's new families), the semantic-fusion seeds (SMT-LIB files
// sorted by status) and z3test's unchanged SMT-LIB 2025 sample.
fn solver_sources() -> Vec[SolverSource] {
	return [
		SolverSource {
			name: "seeds",
			url: "https://github.com/testsmt/semantic-fusion-seeds",
			commit: "93029d5e832fbba80dcda7e6032e60fbc861ed39",
			paths: ["QF_LIA/*", "QF_LRA/*"],
		},
		SolverSource {
			name: "smtlib-2022",
			url: "https://github.com/SMT-LIB/benchmark-submission-2022",
			commit: "81a39628827f61fbd74c6f3e67feb5c1b740d2f0",
			paths: [
				"non-incremental/QF_LIA/20220307-SMPT/*/RC-00.smt2",
				"non-incremental/QF_LIA/20220307-SMPT/*/RF-00.smt2",
			],
		},
		SolverSource {
			name: "smtlib-2023",
			url: "https://github.com/SMT-LIB/benchmark-submission-2023",
			commit: "7f993a017850ba547c6ea19a1bf3b54adf54a449",
			paths: ["non-incremental/QF_LIA/*", "non-incremental/QF_LRA/*"],
		},
		SolverSource {
			name: "smtlib-2024",
			url: "https://github.com/SMT-LIB/benchmark-submission-2024",
			commit: "02e00a1ad661405c438059820d82a5cf5ef11569",
			paths: ["non-incremental/QF_LIA/*", "non-incremental/QF_LRA/*"],
		},
		SolverSource {
			name: "z3test",
			url: "https://github.com/Z3Prover/z3test",
			commit: "b09a2011aabe656b4a4f22c3bf13c883563fa8e1",
			paths: ["regressions/smtlib-sample/QF_LIA/*", "regressions/smtlib-sample/QF_LRA/*"],
		},
	]
}

// The largest file taken: 1 MiB.
fn solver_fetch_limit() -> i64 {
	return 1048576
}

// Runs `git ARGS` in `dir`, and stops the script where it fails.
fn solver_git(dir: String, args: Vec[String]) -> String throws {
	let out = process::run("git", args.clone(); dir: dir)
	if !out.ok {
		println(f"git {args.join(" ")} failed: {out.stderr.trim()}")
		process::exit(1)
	}
	return out.stdout.trim().clone()
}

// The source's files checked out at its commit in `clone`: a clone that is
// already there at that commit is read again, anything else made anew, with
// only the source's paths' blobs fetched.
fn solver_checkout(s: SolverSource, clone: String) throws {
	if fs::exists(f"{clone}/.git", fs::Root::Anywhere) {
		let head = process::run(
			"git",
			["rev-parse", "HEAD"]; dir: clone.clone(),
		).stdout.trim().clone()
		if head == s.commit { return }
		fs::remove(clone.clone(), fs::Root::Anywhere; recursive: true)
	}
	fs::create_dir(clone.clone(), fs::Root::Anywhere; recursive: true)
	solver_git(clone.clone(), ["init", "-q"])
	solver_git(clone.clone(), ["remote", "add", "origin", s.url.clone()])
	solver_git(
		clone.clone(),
		["fetch", "-q", "--depth", "1", "--filter=blob:none", "origin", s.commit.clone()],
	)
	let mut sparse: Vec[String] = ["sparse-checkout", "set", "--no-cone"]
	for p in s.paths { sparse.push(p.clone()) }
	solver_git(clone.clone(), sparse)
	solver_git(clone.clone(), ["checkout", "-q", s.commit.clone()])
}

// Why a file is not taken, or `""` where it is: its logic must be QF_LIA or
// QF_LRA, it must ask one `check-sat` and nothing incremental, state its
// status (the size is judged before the file is read).
fn solver_refusal(source: String) -> String {
	if source.contains("(push")
		|| source.contains("(pop")
		|| source.contains("check-sat-assuming") { return "incremental" }
	if source.split("(check-sat)").count() != 2 { return "not one check-sat" }
	if solver_status(source) == "" { return "no status" }
	return ""
}

// The set's directory a file goes into: `qflia` or `qflra`, `""` for any other
// logic.
fn solver_logic_dir(source: String) -> String {
	if source.contains("(set-logic QF_LIA)") { return "qflia" }
	if source.contains("(set-logic QF_LRA)") { return "qflra" }
	return ""
}

// The family and the file name a path of `source` is filed under: below
// `non-incremental/LOGIC/` the family is SMT-LIB's own and the name the rest
// of the path; elsewhere the family is the source and the name the path
// below its first directory, each `/` written `-`.
fn solver_family(source: String, path: String) -> (String, String) {
	let at = path.find("non-incremental/") ?? {
		let slash = path.find("/") ?? return (f"{source}", f"{path}")
		return (f"{source}", f"{path[slash + "/".len()..].replace("/", "-")}")
	}
	let below = path[at + "non-incremental/".len()..]
	let logic = below.find("/") ?? return (f"{source}", f"{below}")
	let family = below[logic + "/".len()..]
	let end = family.find("/") ?? return (f"{source}", f"{family}")
	return (f"{family[0..<end]}", f"{family[end + "/".len()..].replace("/", "-")}")
}

fn solver_fetch(args: Vec[String]) throws {
	let dir = if args.len()
		> 0 { args[0].trim_end_matches("/").to_string() } else { "target/smtlib" }
	for logic in ["qflia", "qflra"] {
		if fs::exists(f"{dir}/{logic}", fs::Root::Anywhere) {
			fs::remove(f"{dir}/{logic}", fs::Root::Anywhere; recursive: true)
		}
	}
	let mut seen: Vec[String] = []
	let mut lia = 0
	let mut lra = 0
	for s in solver_sources() {
		let clone = f"{dir}/.sources/{s.name}"
		solver_checkout(s.clone(), clone.clone())
		let mut taken = 0
		let mut reasons: Vec[String] = []
		let listed = solver_git(clone.clone(), ["ls-files", "-s"])
		let mut entries: Vec[String] = []
		for line in listed.lines() { entries.push(line.to_string()) }
		entries.sort()
		for line in entries {
			let tab = line.find("\t") ?? continue
			let path = f"{line[tab + "\t".len()..]}"
			let blob = f"{line.split(" ").nth(1) ?? ""}"
			if !path.ends_with(".smt2") { continue }
			let full = f"{clone}/{path}"
			if !fs::exists(full.clone(), fs::Root::Anywhere) { continue }
			let size = fs::metadata(full.clone(), fs::Root::Anywhere).len() as i64
			let text = if size
				> solver_fetch_limit() { "" } else {
					fs::read_to_string(full.clone(), fs::Root::Anywhere)
				}
			let logic = solver_logic_dir(text.clone())
			let why = if size
				> solver_fetch_limit() { "over 1 MiB" } else if logic
				== "" {
					"another logic"
				} else if seen.contains(blob.clone()) { "taken from an earlier source" } else {
					solver_refusal(text.clone())
				}
			if why != "" {
				reasons.push(why)
				continue
			}
			seen.push(blob)
			let (family, name) = solver_family(s.name.clone(), path)
			fs::create_dir(f"{dir}/{logic}/{family}", fs::Root::Anywhere; recursive: true)
			fs::copy(full, f"{dir}/{logic}/{family}/{name}", fs::Root::Anywhere)
			taken += 1
			if logic == "qflia" { lia += 1 } else { lra += 1 }
		}
		let mut kinds: Vec[String] = []
		for r in reasons {
			if !kinds.contains(r.clone()) { kinds.push(r.clone()) }
		}
		let mut skipped: Vec[String] = []
		for k in kinds {
			let mut n = 0
			for r in reasons {
				if r == k { n += 1 }
			}
			skipped.push(f"{n} {k}")
		}
		let note = if skipped.len() > 0 { f", left out: {skipped.join(", ")}" } else { "" }
		println(f"{s.name} at {s.commit}: {taken} taken{note}")
	}
	println(f"{dir}: qflia {lia} files, qflra {lra} files")
}

// The fixed sample CI runs (#1338): `n` files of each logic of the fetched
// set `dir`, at most 64 KiB each, taken at even steps through the sorted
// list, copied into `out` with their family directories.
fn solver_sample(args: Vec[String]) throws {
	if args.len() < 2 {
		println("usage: solver.nika sample DIR OUT [N]")
		process::exit(2)
	}
	let dir = args[0].trim_end_matches("/").to_string()
	let out = args[1].trim_end_matches("/").to_string()
	let n = if args.len() > 2 { text::parse_i64(args[2].clone()) ?? 25 } else { 25 }
	for logic in ["qflia", "qflra"] {
		let mut small: Vec[(String, String)] = []
		for (group, path) in solver_files(f"{dir}/{logic}") {
			if fs::metadata(path.clone(), fs::Root::Anywhere).len() as i64
				<= 65536 { small.push((group, path)) }
		}
		if fs::exists(f"{out}/{logic}", fs::Root::Anywhere) {
			fs::remove(f"{out}/{logic}", fs::Root::Anywhere; recursive: true)
		}
		let mut taken = 0
		for i in 0..<n {
			if small.len() == 0 { break }
			let (group, path) = small[i * small.len() / n].clone()
			let file = f"{path.split("/").last() ?? ""}"
			fs::create_dir(f"{out}/{group}", fs::Root::Anywhere; recursive: true)
			fs::copy(path.clone(), f"{out}/{group}/{file}", fs::Root::Anywhere)
			taken += 1
		}
		println(f"{out}/{logic}: {taken} of {small.len()} files")
	}
}

// --- compare: ours, z3 and cvc5 on the same files (#1338 item 3, 4) ---

// One solver's run on one file: its answer (`sat`, `unsat`, `unknown`,
// `malformed`, `error` or `rejected`, an answer of ours its checker refused),
// the wall time in milliseconds, the peak resident memory in KiB (-1 where
// the platform gives none) and, under `--instructions`, the instructions
// callgrind counted (-1 without).
struct SolverRun {
	answer: String,
	millis: i64,
	kib: i64,
	instructions: i64,
}

// The command of a solver and its arguments for `path`: ours is the rod's
// binary, z3 and cvc5 their CLIs, each told the same time limit.
fn solver_command(
	solver: String,
	bin: String,
	exe: String,
	path: String,
	timeout: i64,
) -> (String, Vec[String]) {
	if solver == "ours" { return (f"{bin}", ["new", path]) }
	if solver == "z3" { return (f"{exe}", ["-smt2", f"-T:{timeout}", path]) }
	return (f"{exe}", [f"--tlimit={timeout * 1000}", path])
}

// The first `sat`, `unsat` or `unknown` line of a CLI's output; `error` where
// it wrote an `(error ...)` before any.
fn solver_cli_answer(stdout: String) -> String {
	for raw in stdout.lines() {
		let line = raw.trim()
		if line == "sat" || line == "unsat" || line == "unknown" { return f"{line}" }
		if line.starts_with("(error") { return "error" }
	}
	return "unknown"
}

// The rod's answer as an SMT-LIB answer: *proved* is `unsat`, *refuted*
// `sat`; an answer against the status is still the answer given, one whose
// certificate, model or lemma the checker rejected is `rejected`.
fn solver_rod_answer(answer: String) -> String {
	if answer == "proved" || answer == "wrong (proved, status sat)" { return "unsat" }
	if answer == "refuted" || answer == "wrong (refuted, status unsat)" { return "sat" }
	if answer.starts_with("wrong") { return "rejected" }
	if answer.starts_with("malformed") { return "malformed" }
	return "unknown"
}

// callgrind's `Collected : N` from a run's standard error, -1 without one.
fn solver_collected(stderr: String) -> i64 {
	for line in stderr.lines() {
		let at = line.find("Collected : ") ?? continue
		return text::parse_i64(line[at + "Collected : ".len()..].trim().to_string()) ?? -1
	}
	return -1
}

// One solver on one file. A run past its limit is `unknown`; under
// `instructions` the run goes through callgrind, with a hundred times the
// limit, the CLIs' own included, for valgrind's slowdown.
fn solver_one(
	solver: String,
	bin: String,
	exe: String,
	path: String,
	timeout: i64,
	instructions: bool,
) -> SolverRun throws {
	// The CLIs' own limit is widened with the runner's: under callgrind they
	// would give up after a tenth of their work.
	let own = if instructions { timeout * 100 } else { timeout }
	let (cmd, args) = solver_command(solver.clone(), bin, exe, path, own)
	let mut run_cmd = cmd.clone()
	let mut run_args: Vec[String] = []
	let mut limit = timeout + 5
	if instructions {
		run_cmd = "valgrind"
		run_args = ["--tool=callgrind", "--callgrind-out-file=/dev/null", cmd.clone()]
		limit = own + 5
	}
	for a in args { run_args.push(a.clone()) }
	let out = process::run(run_cmd, run_args; within: limit.seconds())
	let millis = out.elapsed.in_millis() as i64
	let kib = out.max_rss_kib ?? -1
	let counted = if instructions { solver_collected(out.stderr.to_string()) } else { -1 }
	if out.timed_out || (!instructions && millis > timeout * 1000) {
		return SolverRun { answer: "unknown", millis: millis, kib: kib, instructions: counted }
	}
	let mut answer: String = "unknown"
	if solver == "ours" {
		if out.ok {
			let line = out.stdout.trim().lines().nth(0) ?? ""
			let at = line.rfind(" ") ?? line.len()
			answer = solver_rod_answer(f"{line[0..<at]}")
		}
	} else {
		answer = solver_cli_answer(out.stdout.to_string())
	}
	return SolverRun { answer: answer, millis: millis, kib: kib, instructions: counted }
}

// Where a solver's CLI is: `$VAR` where it is set, else `name` on the path;
// `""` where neither runs.
fn solver_exe(var: String, name: String) -> String throws {
	let exe = env::var(var) ?? name
	return if process::run("sh", ["-c", f"command -v '{exe}'"]).ok { exe } else { "" }
}

// The middle of `xs` (the lower one of two), 0 for none.
fn solver_median(xs: Vec[i64]) -> i64 {
	if xs.len() == 0 { return 0 }
	let mut s = xs.clone()
	s.sort()
	return s[(s.len() - 1) / 2]
}

// One solver's row over the files `at` of `runs`: solved, wrong against the
// status, PAR-2 in seconds (the wall time of a solved file, twice the limit
// otherwise), peak memory (the most and the median) and, where counted, the
// instructions of the solved files.
fn solver_compare_row(
	solver: String,
	runs: Vec[Vec[SolverRun]],
	statuses: Vec[String],
	at: Vec[i64],
	k: i64,
	timeout: i64,
) -> String {
	let mut solved = 0
	let mut wrong = 0
	let mut par2 = 0
	let mut kibs: Vec[i64] = []
	let mut instructions = 0
	let mut counted = 0
	for i in at {
		let r = runs[i][k]
		let status = statuses[i]
		let answered = r.answer == "sat" || r.answer == "unsat"
		if answered && status != "" && r.answer != status { wrong += 1 }
		if r.answer == "rejected" { wrong += 1 }
		if answered && (status == "" || r.answer == status) {
			solved += 1
			par2 += r.millis
			if r.instructions >= 0 {
				instructions += r.instructions
				counted += 1
			}
		} else {
			par2 += 2 * timeout * 1000
		}
		if r.kib >= 0 { kibs.push(r.kib) }
	}
	let mut most = 0
	for x in kibs {
		if x > most { most = x }
	}
	let n = at.len()
	let mean = if n > 0 { par2 / n / 100 } else { 0 }
	let shown = if counted > 0 { f", {instructions / counted} instructions per solved" } else { "" }
	return f"{solver} solved {solved} wrong {wrong} PAR-2 {solver_tenths(mean)} s, peak {most / 1024} MiB (median {solver_median(kibs) / 1024}){shown}"
}

fn solver_compare(repo: String, nikaia: String, args: Vec[String]) throws {
	let mut timeout = 10
	let mut instructions = false
	let mut per_file = false
	let mut targets: Vec[String] = []
	let mut i = 0
	while i < args.len() {
		let a = args[i].clone()
		if a == "--timeout" && i + 1 < args.len() {
			timeout = text::parse_i64(args[i + 1].clone()) ?? 10
			i += 2
			continue
		}
		if a == "--instructions" {
			instructions = true
		} else if a == "--files" {
			per_file = true
		} else {
			targets.push(a)
		}
		i += 1
	}
	let mut files: Vec[(String, String)] = []
	for t in targets { files.extend(solver_files(t)) }
	if files.len() == 0 {
		println("no .smt2 files")
		return
	}
	let bin = solver_build(repo, nikaia)
	if bin == "" { process::exit(1) }
	let mut solvers: Vec[String] = ["ours"]
	let mut exes: Vec[String] = [""]
	for (name, var) in [("z3", "Z3"), ("cvc5", "CVC5")] {
		let exe = solver_exe(var.to_string(), name.to_string())
		if exe == "" {
			println(f"{name} is not on the path (nor ${var}): left out")
		} else {
			solvers.push(name.to_string())
			exes.push(exe)
		}
	}
	// The runner's own high-water mark, below which no child's peak is
	// reported on Linux (ADR-368 D3): a peak at it means at most it.
	let floor = process::run("true", []).max_rss_kib ?? -1
	println(f"limit {timeout} s per file and solver, memory floor {floor / 1024} MiB (the runner's own)")
	let mut statuses: Vec[String] = []
	let mut groups: Vec[String] = []
	let mut runs: Vec[Vec[SolverRun]] = []
	let mut disagree: Vec[bool] = []
	for (group, path) in files {
		let status = solver_status(fs::read_to_string(path.clone(), fs::Root::Anywhere))
		let mut row: Vec[SolverRun] = []
		for k in 0..<solvers.len() {
			row.push(solver_one(
				solvers[k].clone(),
				bin.clone(),
				exes[k].clone(),
				path.clone(),
				timeout,
				instructions,
			))
		}
		let mut sats = false
		let mut unsats = false
		for r in row {
			if r.answer == "sat" { sats = true }
			if r.answer == "unsat" { unsats = true }
		}
		if per_file {
			let file = path.split("/").last() ?? path
			let mut shown: Vec[String] = []
			for k in 0..<solvers.len() {
				let r = row[k]
				let counted = if r.instructions >= 0 { f" {r.instructions}i" } else { "" }
				shown.push(f"{solvers[k]} {r.answer} {r.millis}ms {r.kib}KiB{counted}")
			}
			let mark = if sats && unsats { " DISAGREE" } else { "" }
			println(f"{group}/{file} [{status}] {shown.join(" | ")}{mark}")
		}
		statuses.push(status)
		groups.push(group.clone())
		runs.push(row)
		disagree.push(sats && unsats)
	}
	let mut names: Vec[String] = []
	for g in groups {
		if !names.contains(g.clone()) { names.push(g.clone()) }
	}
	let mut every: Vec[i64] = []
	for j in 0..<groups.len() { every.push(j) }
	if names.len() > 1 { names.push("all") }
	for g in names {
		let mut at: Vec[i64] = []
		for j in 0..<groups.len() {
			if g == "all" || groups[j] == g { at.push(j) }
		}
		let mut split = 0
		for j in at {
			if disagree[j] { split += 1 }
		}
		println(f"{g}: {at.len()} files, disagree {split}")
		for k in 0..<solvers.len() {
			println(f"  {solver_compare_row(solvers[k].clone(), runs.clone(), statuses.clone(), at.clone(), k, timeout)}")
		}
	}
}

fn main() throws {
	// The program's name, the command, and what the command reads.
	let mut command: String = ""
	let mut rest: Vec[String] = []
	let mut at = 0
	for a in cli::args() {
		if at == 1 { command = a } else if at > 1 { rest.push(a) }
		at += 1
	}
	let repo = solver_root()
	let nikaia = solver_toolchain(repo.clone())
	if command == "run" {
		solver_run(repo, nikaia, rest)
	} else if command == "gen" {
		solver_gen(rest)
	} else if command == "oracle" {
		solver_oracle(rest)
	} else if command == "fuzz" {
		solver_fuzz(repo, nikaia, rest)
	} else if command == "tune" {
		solver_tune(repo, nikaia, rest)
	} else if command == "fetch" {
		solver_fetch(rest)
	} else if command == "sample" {
		solver_sample(rest)
	} else if command == "compare" {
		solver_compare(repo, nikaia, rest)
	} else {
		println("usage: solver.nika run|gen|oracle|fuzz|tune|fetch|sample|compare ... (see the head of scripts/solver.nika)")
		process::exit(2)
	}
}
