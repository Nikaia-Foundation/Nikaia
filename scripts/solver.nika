// The solver's measuring rod (ADR-270 D17, #1281), run standalone against the
// toolchain of the day: no compiler change, no `lower-std`, no rebuild.
//
//   nikaia run scripts/solver.nika -- run [--engine new|fm|new-fm|new-simplex] [--summary] [--stats] [--timeout S] [--budget N] [--cases N] DIR|FILE...
//   nikaia run scripts/solver.nika -- gen [DIR]
//   nikaia run scripts/solver.nika -- oracle [--write] [--rlimit R] DIR|FILE...
//   nikaia run scripts/solver.nika -- fuzz N SEED [--size S] [--rlimit R]
//   nikaia run scripts/solver.nika -- fuzz --self-test
//   nikaia run scripts/solver.nika -- tune [--timeout S] [DIR]
//   nikaia run scripts/solver.nika -- fetch [DIR]
//   nikaia run scripts/solver.nika -- sample DIR OUT [N]
//   nikaia run scripts/solver.nika -- compare [--timeout S] [--instructions] --files DIR|FILE...
//   nikaia run scripts/solver.nika -- build
//
// A target of `run`, `compare` or `oracle` is a whole path: one that does
// not exist stops the script at once, before any build (#2006). The names
// `run` prints are below the parent of the directory it was given, so
// `run target/smtlib/qflra` prints `qflra/sal/F.smt2`, and one file of it is
// `compare --files target/smtlib/qflra/sal/F.smt2`. Run by hand outside the
// repository's own build (a `git archive` copy), the script takes its
// `nikaia` from `$NIKAIA`.
//
// `build` builds the program `run` answers with (see `solver_build`) and
// prints the kept binary's path: CI runs it before the tests (#2023), so the
// tests that run this script find the binary built and spend their time
// limit on the answers, not on a cold build of the program.
//
// `fetch` (#1338 item 2) builds the SMT-LIB set: it clones each source of
// `solver_sources` at its fixed commit into `DIR/.sources/` (default DIR
// `target/smtlib`) and copies its single-query QF_LIA and QF_LRA files with a
// status, at most 1 MiB each, into `DIR/qflia/FAMILY/` and `DIR/qflra/FAMILY/`
// (`tests/solver/SOURCES.md`). `sample` takes N files per logic (default 25)
// of at most 64 KiB, at even steps of the sorted list, into OUT: the CI
// sample `tests/solver/sample`.
//
// `oracle` and `fuzz` check our solver against z3 (`$Z3` or `PATH`) under
// its deterministic resource limit, and exit 1 on a disagreement: the nightly
// `.github/workflows/z3.yml` (#1989, `tests/solver/SOURCES.md`).
//
// `compare` (#1338 items 3-4) answers each file with ours (the rod), z3 and
// cvc5 (`$Z3`, `$CVC5` or `PATH`), all under the same wall-clock limit
// (default 10 s), and ours under nothing else (ADR-270 D17, #2090): its case
// budget is `solver_rod_cases()`, which the limit reaches first, not the
// build-time one (D25), so a file ours would prove past 1024 cases is not
// scored `unknown (cases)`. One line per file (a disagreement marked
// `DISAGREE`), then per directory and solver: solved, wrong (against the
// status), the files left by reason (`overflow`, ours' `unknown (overflow)`:
// the file leaves `i64`, ADR-270 D11, also where ours ran past the limit
// and the rod at the build-time budget answers so; `timeout`, past the
// limit otherwise; `unknown`,
// any other, the case budget among them; #2259), PAR-2 in seconds (an unsolved file counts twice the limit), peak
// and median memory (never below the runner's own, which the header names). `--instructions`
// runs each solver under callgrind and adds the mean instructions per solved
// file; time is then not the figure, and the limit is a hundred times wider.
//
// `tune` (ADR-270 D14, #1284 item 5) splits the `.smt2` files of DIR
// (default `tests/solver/qflia`), sorted by name, into two fixed halves: the
// files at even places tune, the files at odd places are held out. It walks
// the parameters of `sv_params` (`packages/logic/src/sv_strategy.nika`) one by one, tries
// each of its candidate values on the tuning half with the engine
// `new:name=value,...`, and keeps a value only where it lowers the half's
// PAR-2 with no wrong answer. Then it reports the defaults and the tuned set
// on the held-out half, which the tuning never saw.
//
// `run` builds the rod `packages/logic/rod` (its driver copied into a
// package that depends on `packages/logic` by its path, ADR-270 D1, D26,
// #2020) in a fixed slot of the user's cache with the `nikaia` that runs
// this script (the binary kept in `target/solver-rod/`, see `solver_build`),
// and answers every `.smt2` file: one line per file (`name answer work`),
// then a row per directory: solved, unknown (overflow and files the reader
// refuses among them), malformed (a script that is not well-formed
// SMT-LIB, its reason on its line, ADR-270 D28), wrong, PAR-2 over the work budget, certificates
// checked, models evaluated. `--budget N` gives a new engine a work budget
// of N steps of its proof log (the parameter `steps` of `sv_params`,
// `packages/logic/src/sv_strategy.nika`): the equality elimination's steps,
// which no case counts, with the search's, so a file past it answers
// `unknown (steps)` on every machine alike (#2107). With `--budget` and no
// `--timeout` a file has no wall-clock limit; without either, 60 s.
// `--cases N` gives a new engine a case budget of N (the parameter `cases`
// of `sv_params`) in place of the build-time one, for a file a fix brought
// within reach only past `lg_budget()` (#1962); PAR-2 still doubles the
// build-time budget.
// `--stats` adds below each file's line the new
// engine's counters (#1312 item 2): the SAT core's conflicts, the theory's,
// theory lemmas and those repeating an earlier one, decisions, restarts.
// The query is the conjunction of a file's assertions with the goal `false`:
// *proved* is `unsat`, *refuted* is `sat`. A *proved* whose certificate
// `lg_verify` rejects, a *refuted* whose model `lg_verify_model` rejects, and
// any answer against the file's status count as wrong. A file that must be
// refused (`; EXPECT: error`, `tests/solver/malformed/`, #2258) is solved,
// `refused (REASON)`, where the engine answers it malformed, else wrong.
use std::cli
use std::env
use std::fs
use std::path
use std::process
use std::text

// The work budget PAR-2 doubles in `run` and `tune`, which measure the
// answers asked while a program is built: `lg_budget().cases`, the build-time
// budget (ADR-270 D25), the branches the search may look at.
fn solver_budget() -> i64 {
	return 1024
}

// The case budget of ours in `compare`, which scores every solver under the
// same time limit and nothing else (ADR-270 D17, #2090): 2^40 cases, which
// no limit `compare` sets reaches (a million take ours tens of seconds), and
// small enough that the walk after the search counts its moves without
// overflow (`sv_strategy_run`); the walk first keeps its share of
// `lg_budget()`.
fn solver_rod_cases() -> i64 {
	return 1099511627776
}

// The `nikaia` this program runs under (`env::current_exe`, set by `nikaia
// run`, ADR-program-path-1 D3), which the compiler trusts as no outside value
// does (ADR-397): a path out of `/proc` or a shell would come from outside
// and reach `process::run` (ADR-raw-sinks-1, #2364).
fn solver_toolchain(repo: String) -> String throws {
	let exe = env::current_exe()?.display() ?? ""
	if exe.len() == 0 {
		// `$NIKAIA` first: a copy of the repository (a `git archive` tree for
		// an instrumented solver) has no build of its own (#2006).
		let named = env::var("NIKAIA") ?? ""
		if named != "" { return named }
		// Run as a built program, not by `nikaia run`: the repository's own
		// build, only where it exists (#1305).
		for built in [f"{repo}/target/fast/nikaia", f"{repo}/target/release/nikaia"] {
			if fs::exists(built.clone(), fs::Root::Anywhere) { return built }
		}
		eprintln(f"no nikaia found: not run by `nikaia run`, no `$NIKAIA`, none in {repo}/target/fast or target/release (#1305)")
		process::exit(2)
	}
	return exe.clone()
}

// The repository this program stands in: the directory above the
// `scripts/solver.nika` that `nikaia run` names in `env::current_main`
// (ADR-program-path-1 D3), an absolute path the compiler trusts; a path out
// of `git` or `pwd` would come from outside (ADR-raw-sinks-1, #2364). Run
// otherwise, the working directory.
fn solver_root() -> String throws {
	let main = env::current_main()?.display() ?? ""
	let repo = main.strip_suffix("/scripts/solver.nika") ?? "."
	return repo.clone()
}

// --- Assembling and building the program ---

// The files the kept binary is built from, for its key: the package
// `logic`'s manifest and sources (ADR-270 D26, #2020), sorted by name, and
// the rod's driver `packages/logic/rod/src/main.nika`. Empty where the
// package cannot be listed.
fn solver_program_files(repo: String) -> Vec[String] throws {
	let listed = process::run(
		"sh",
		["-c", "ls \"$1\"/packages/logic/src/*.nika | LC_ALL=C sort", "sh", repo.clone()],
	)
	let mut paths: Vec[String] = []
	if !listed.ok { return paths }
	paths.push(f"{repo}/packages/logic/nikaia.toml")
	for line in listed.stdout.lines() {
		if line != "" { paths.push(line) }
	}
	paths.push(f"{solver_rod_dir(repo)}/src/main.nika")
	return paths
}

// The rod's package, `packages/logic/rod`: its `main.nika` depends on the
// package `logic`, which holds the logic layer and the engine.
fn solver_rod_dir(repo: String) -> String {
	return f"{repo}/packages/logic/rod"
}

// The program's manifest, naming `logic` where it stands in `repo`. **Built
// at `opt-level = 3`** (#2004): without a `[build.<target>]` table the build
// takes Cargo's `dev` profile at opt-level 0, and every figure of the rod was
// one of an unoptimised binary (`Diffusion2D-PT-D05N100-RC-00`: 157.2 M
// instructions at 0, 30.9 M at 3, z3 26 M).
fn solver_manifest(repo: String) -> String {
	return f"[package]\nname = \"solver_rod\"\nversion = \"0.1.0\"\n\n[dependencies]\nlogic = {{ path = \"{repo}/packages/logic\" }}\n\n[build.x86_64-linux]\nopt-level = 3\n"
}

// Writes the program's package into `tmp`: its manifest and the rod's
// `src/main.nika`.
fn solver_program(repo: String, tmp: String) throws {
	process::run("mkdir", ["-p", f"{tmp}/src"])
	fs::write(f"{tmp}/nikaia.toml", fs::Root::Anywhere, solver_manifest(repo.clone()))
	process::run("cp", [f"{solver_rod_dir(repo)}/src/main.nika", f"{tmp}/src/"])
}

// The environment the program builds in: the program's lints capped (#1949),
// and only the program's (`NIKAIA_CAP_LINTS`, read by the build's `rustc`
// wrapper in `project_drive.nika`). The program leaves out the files'
// `*_test_*` functions and more, so rustc warns of a hundred and forty
// functions never used; a build the backend said anything about lowers the
// whole program a second time to place what it said (`report` in
// `crates/nikaia/src/project.rs`, ADR-300), about 70 s of a cold build, for
// warnings `solver_build` never shows. **Not `RUSTFLAGS=--cap-lints=allow`**,
// as it was: the flags are part of every dependency's fingerprint, so Cargo
// built all of them again (`std` and about 70 crates) beside the tree CI
// restores (#1956), which pushed `solver_fuzz` past its 300 s.
fn solver_build_env() -> Vec[(String, String)] {
	return [("NIKAIA_CAP_LINTS", "allow")]
}

// The key of the kept binary: a hash of the program's files and manifest, as
// `solver_program` writes them, and of the `nikaia` that builds it (its size
// and age). "" where it cannot be taken.
fn solver_key(repo: String, nikaia: String) -> String throws {
	let mut args: Vec[String] = [
		"-c",
		"n=$1; m=$2; shift 2; { for f in \"$@\"; do echo \"== ${f##*/}\"; cat \"$f\" || exit 1; done; echo '== nikaia.toml'; printf '%s' \"$m\"; stat -L -c '%s %Y %n' \"$n\" || exit 1; } | sha256sum | cut -c1-16",
		"sh",
		nikaia,
		solver_manifest(repo.clone()),
	]
	let files = solver_program_files(repo)
	if files.len() == 0 { return "" }
	for f in files { args.push(f.clone()) }
	let out = process::run("sh", args)
	if !out.ok { return "" }
	return out.stdout.trim().clone()
}

// The user's cache directory, where the build's stores live (ADR-021 D12):
// `$NIKAIA_CACHE_DIR`, else `$XDG_CACHE_HOME/nikaia`, else
// `$HOME/.cache/nikaia`.
fn solver_cache_dir() -> String {
	let set = env::var("NIKAIA_CACHE_DIR") ?? ""
	if set != "" { return set.clone() }
	let xdg = env::var("XDG_CACHE_HOME") ?? ""
	if xdg != "" { return f"{xdg}/nikaia" }
	let home = env::var("HOME") ?? "/tmp"
	return f"{home}/.cache/nikaia"
}

// Builds the program and gives the binary's path, or an empty text after
// printing why it did not build. The binary is kept in
// `target/solver-rod/<key>/`, the key `solver_key`: a second run of the same
// program with the same toolchain (the tests run it eight times) builds
// nothing.
//
// **One build per key at a time** (#1915): `solver_run` and `solver_fuzz`,
// each at both settings, start cold on the same key, and every one of them
// built the whole program (about a minute of one core each) beside the
// others, which pushed `solver_run` past its 300 s on a loaded runner. The
// build and the copy into the kept place run under a lock of the key's
// directory; a run that waited finds the binary there and builds nothing.
//
// **Built in a fixed place** (ADR-021 D14, #2015): the program is written
// into a slot of `<user cache>/solver/` (scripts/slot.nika), not a fresh
// temporary directory, so a new `nikaia` whose emitted Rust is the same hits
// the rustc store and skips rustc. This script, run again as
// `--build-in <slot> REPO NIKAIA KEPT`, writes and builds it there.
fn solver_build(repo: String, nikaia: String) -> String throws {
	let key = solver_key(repo.clone(), nikaia.clone())
	// The key is a hash `sha256sum` printed, one component by this guard
	// (ADR-raw-sinks-1 D14), so the paths built from it are not outside.
	if key == "" || !path::is_component(key) {
		println("the solver program did not build: its files could not be read")
		return ""
	}
	let kept = f"{repo}/target/solver-rod/{key}/solver_rod"
	// Looked up under the store's own root, where the guarded key is one
	// component (ADR-raw-sinks-1 D11, D14).
	let store = fs::Root::Dir(f"{repo}/target/solver-rod")
	if fs::exists(f"{key}/solver_rod", store) { return kept }
	process::run("mkdir", ["-p", f"{repo}/target/solver-rod/{key}"])
	let main = env::current_main()?.display() ?? f"{repo}/scripts/solver.nika"
	// Under the lock: built only where no run before this one kept it.
	let built = process::run(
		"flock",
		[
			f"{repo}/target/solver-rod/{key}/lock",
			"sh",
			"-c",
			"[ -e \"$1\" ] && exit 0; shift; exec \"$@\"",
			"sh",
			kept.clone(),
			nikaia.clone(),
			"run",
			f"{repo}/scripts/slot.nika",
			"--",
			f"{solver_cache_dir()}/solver",
			nikaia.clone(),
			"run",
			main,
			"--",
			"--build-in",
			"{slot}",
			repo,
			nikaia,
			kept.clone(),
		]; stdout: process::Stream::Inherited,
	)
	if !built.ok || !fs::exists(f"{key}/solver_rod", store) {
		if built.ok { println("the solver program did not build") }
		return ""
	}
	return kept
}

// `--build-in DIR REPO NIKAIA KEPT`: writes the program into DIR, an empty
// slot, builds it with NIKAIA and copies the binary to KEPT, under a name of
// its own first and then renamed, so KEPT never holds half a binary. Exit 1,
// after saying why, where it did not build.
fn solver_build_in(dir: String, repo: String, nikaia: String, kept: String) throws {
	solver_program(repo, dir.clone())
	let built = process::run(nikaia, ["build"]; dir: dir.clone(), env: solver_build_env())
	let bin = f"{dir}/target/nikaia/bin/solver_rod"
	if !built.ok || !fs::exists(bin.clone(), fs::Root::Anywhere) {
		println("the solver program did not build:")
		for line in built.stderr.lines() {
			if line.starts_with("error") || line.contains("-->") { println(line) }
		}
		process::exit(1)
	}
	let copied = process::run(
		"sh",
		["-c", "cp \"$1\" \"$2.$$\" && mv -f \"$2.$$\" \"$2\"", "sh", bin, kept],
	)
	if !copied.ok {
		println(f"the solver program was built but not kept: {copied.stderr.trim()}")
		process::exit(1)
	}
}

// --- run ---

// One answered file.
struct SolverRow {
	group: String,
	name: String,
	answer: String,
	work: i64,
	// The work as the engine wrote it, with the fast path that answered
	// (`3/difference`).
	shown: String,
}

// The `.smt2` files of an argument, each with the directory it is counted
// under: its path below the argument's parent.
fn solver_files(arg: String) -> Vec[(String, String)] throws {
	let mut out: Vec[(String, String)] = []
	let trimmed = arg.trim_end_matches("/")
	let base = trimmed.split("/").last() ?? trimmed
	if trimmed.ends_with(".smt2") {
		let parts: Vec[String] = trimmed.split("/").collect()
		let group = if parts.len() >= 2 { parts[parts.len() - 2].clone() } else { "." }
		out.push((group, trimmed.clone()))
		return out
	}
	let mut rels: Vec[String] = []
	for p in fs::walk(trimmed.clone(), fs::Root::Anywhere) {
		let rel = p.to_text()
		if rel.ends_with(".smt2") { rels.push(rel) }
	}
	rels.sort()
	for rel in rels {
		let at = rel.rfind("/")
		// `rels` is read from the disk (ADR-396 D2, #2371).
		let cut = at ?? 0
		if cut < 0 || cut > rel.len() { continue }
		// `f"{base}"`, not `base.to_string()`: the latter makes the
		// returned tuples `EitherText` and a caller's `Vec[(String,
		// String)]` fails in rustc (#1311).
		let group = match at {
			null => f"{base}",
			else => f"{base}/{rel[0..<cut]}",
		}
		out.push((group, f"{trimmed}/{rel}"))
	}
	return out
}

// The `.smt2` files of the targets of `run`, `compare` and `oracle`, after a
// check that each target exists. A target that does not stops the script
// before the rod is built or any file answered (#2006): written
// `target/smtlib/ qflra/sal/F.smt2`, the directory alone was a target of
// its own and answered the whole fetched set past twenty minutes, while the
// path meant was the two joined.
fn solver_targets(targets: Vec[String]) -> Vec[(String, String)] throws {
	let mut missing = false
	for k in 0..<targets.len() {
		let t = targets[k]
		if fs::exists(t.clone(), fs::Root::Anywhere) { continue }
		missing = true
		eprintln(f"no such file or directory: {t}")
		if k > 0 {
			let joined = f"{targets[k - 1].trim_end_matches("/")}/{t}"
			if fs::exists(joined.clone(), fs::Root::Anywhere) {
				eprintln(f"  did you mean `{joined}`, one argument? `{targets[k - 1]}` alone is a target of its own: every file below it")
			}
		}
	}
	if missing { process::exit(2) }
	let mut files: Vec[(String, String)] = []
	for t in targets { files.extend(solver_files(t)) }
	return files
}

// The engine's answer to one file: `answer work`, from the built binary.
// The work is a count, after a fast path's answer followed by `/` and the
// path's name; the third part is the work as written.
fn solver_answer(
	bin: String,
	engine: String,
	path: String,
	timeout: i64,
) -> (String, i64, String) throws {
	let (answer, work, shown, _) = solver_answer_stats(bin, engine, path, timeout, false)
	return (answer, work, shown)
}

// `solver_answer` and, where `stats`, the counters' line the binary wrote
// below it (`stats: ...`; `""` without one).
fn solver_answer_stats(
	bin: String,
	engine: String,
	path: String,
	timeout: i64,
	stats: bool,
) -> (String, i64, String, String) throws {
	let args: Vec[String] = if stats { ["--stats", engine, path] } else { [engine, path] }
	// A `timeout` of 0 is no wall-clock limit (`--budget`, #2107).
	let out = if timeout > 0 {
		process::run(bin, args; within: timeout.seconds())
	} else {
		process::run(bin, args)
	}
	if out.timed_out { return ("unknown (timeout)", -1, "-1", "") }
	if !out.ok { return ("unknown (crashed)", -1, "-1", "") }
	// Each text of the returned tuple made with `f"..."`: a `.to_string()`
	// of a view makes the tuple `EitherText` and the callers fail in rustc
	// (#1311).
	let all = out.stdout.trim()
	let nl = all.find("\n") ?? all.len()
	let line = f"{all[0..<nl]}"
	let counted = if nl < all.len() { f"{all[nl + "\n".len()..]}" } else { "" }
	let at = line.rfind(" ") ?? return ("unknown (no answer)", -1, "-1", "")
	let shown = f"{line[at + 1..]}"
	let slash = shown.find("/") ?? shown.len()
	let work = text::parse_i64(shown[0..<slash]) ?? -1
	return (f"{line[0..<at]}", work, shown, counted)
}

fn solver_solved(answer: String) -> bool {
	return answer == "proved" || answer == "refuted" || answer.starts_with("refused")
}

// `n` tenths as `a.b`.
fn solver_tenths(n: i64) -> String {
	return f"{n / 10}.{n % 10}"
}

// The summary row of `rows`.
fn solver_summary(label: String, rows: Vec[SolverRow]) -> String {
	let mut solved = 0
	let mut proved = 0
	let mut refuted = 0
	let mut refused = 0
	let mut unknown = 0
	let mut overflow = 0
	let mut unreadable = 0
	let mut malformed = 0
	let mut wrong = 0
	let mut checked = 0
	let mut evaluated = 0
	let mut par2 = 0
	for r in rows {
		if solver_solved(r.answer.clone()) {
			solved += 1
			par2 += r.work
		} else {
			par2 += 2 * solver_budget()
		}
		if r.answer == "proved" { proved += 1 }
		if r.answer == "refuted" { refuted += 1 }
		if r.answer.starts_with("refused") { refused += 1 }
		if r.answer.starts_with("unknown") { unknown += 1 }
		if r.answer == "unknown (overflow)" { overflow += 1 }
		if r.answer == "unknown (unreadable)" { unreadable += 1 }
		if r.answer.starts_with("malformed") { malformed += 1 }
		if r.answer.starts_with("wrong") { wrong += 1 }
		if r.answer == "proved"
			|| r.answer == "wrong (certificate rejected)"
			|| r.answer == "wrong (lemma rejected)"
			|| r.answer == "wrong (proved, status sat)" { checked += 1 }
		if r.answer == "refuted"
			|| r.answer == "wrong (model rejected)"
			|| r.answer == "wrong (refuted, status unsat)" { evaluated += 1 }
	}
	let n = rows.len()
	let mean = if n > 0 { par2 * 10 / n } else { 0 }
	// Files that must be refused (#2258) are named only where there are some.
	let refusing = if refused > 0 { f", refused {refused}" } else { "" }
	return f"{label}: {n} files, solved {solved} (proved {proved}, refuted {refuted}{refusing}), unknown {unknown} (overflow {overflow}, unreadable {unreadable}), malformed {malformed}, wrong {wrong}, PAR-2 {solver_tenths(mean)}, certificates checked {checked}, models evaluated {evaluated}"
}

fn solver_run(repo: String, nikaia: String, args: Vec[String]) throws {
	// The CDCL(T) engine by default (#1283); `fm` stays as the cross-check.
	let mut engine: String = "new"
	let mut summary_only = false
	let mut stats = false
	let mut timeout = -1
	let mut budget = 0
	let mut cases = 0
	let mut targets: Vec[String] = []
	let mut i = 0
	while i < args.len() {
		let a = args[i].clone()
		if a == "--engine" && i + 1 < args.len() {
			engine = args[i + 1].clone()
			i += 2
			continue
		}
		if a == "--timeout" && i + 1 < args.len() {
			timeout = text::parse_i64(args[i + 1].clone()) ?? 60
			i += 2
			continue
		}
		if a == "--budget" && i + 1 < args.len() {
			budget = text::parse_i64(args[i + 1].clone()) ?? 0
			if budget <= 0 {
				println(f"--budget takes a positive number of steps, not {args[i + 1]}")
				process::exit(2)
			}
			i += 2
			continue
		}
		if a == "--cases" && i + 1 < args.len() {
			cases = text::parse_i64(args[i + 1].clone()) ?? 0
			if cases <= 0 {
				println(f"--cases takes a positive number of cases, not {args[i + 1]}")
				process::exit(2)
			}
			i += 2
			continue
		}
		if a == "--summary" {
			summary_only = true
		} else if a == "--stats" {
			stats = true
		} else {
			targets.push(a)
		}
		i += 1
	}
	if engine != "fm" && engine != "new" && engine != "new-fm" && engine != "new-simplex" {
		println(f"unknown engine {engine}: fm, new, new-fm or new-simplex")
		process::exit(2)
	}
	if timeout < 0 { timeout = if budget > 0 { 0 } else { 60 } }
	let mut answering = engine.clone()
	if budget > 0 {
		if engine == "fm" {
			println("--budget counts the new engine's steps: not with --engine fm")
			process::exit(2)
		}
		answering = f"{engine}:steps={budget}"
	}
	if cases > 0 {
		if engine == "fm" {
			println("--cases sets the new engine's case budget: not with --engine fm")
			process::exit(2)
		}
		let head = if budget > 0 { f"{answering}," } else { f"{engine}:" }
		answering = f"{head}cases={cases}"
	}
	let files = solver_targets(targets)
	if files.len() == 0 {
		println("no .smt2 files")
		return
	}
	let bin = solver_build(repo, nikaia)
	if bin == "" { process::exit(1) }
	let mut rows: Vec[SolverRow] = []
	for (group, path) in files {
		let (answer, work, shown, counted) = solver_answer_stats(
			bin.clone(),
			answering.clone(),
			path.clone(),
			timeout,
			stats,
		)
		let file = path.split("/").last() ?? path
		let status = solver_status(fs::read_to_string(path.clone(), fs::Root::Anywhere))
		let row = SolverRow {
			group: group.clone(),
			name: f"{group}/{file}",
			answer: solver_scored(answer, status),
			work: work,
			shown: shown,
		}
		if !summary_only {
			println(f"{row.name} {row.answer} {row.shown}")
			if counted != "" { println(f"  {counted}") }
		}
		rows.push(row)
	}
	let mut groups: Vec[String] = []
	for r in rows {
		if !groups.contains(r.group.clone()) { groups.push(r.group.clone()) }
	}
	for g in groups {
		let mut part: Vec[SolverRow] = []
		for r in rows {
			if r.group == g { part.push(r.clone()) }
		}
		println(solver_summary(g, part))
	}
	if groups.len() > 1 { println(solver_summary("all", rows)) }
}

// --- oracle ---

// z3's deterministic resource limit (`rlimit=N`), the budget of the oracle
// and the fuzzer (#1989): it counts z3's own steps, so a query past it is
// `unknown` on every runner, unlike a time limit. The largest file under
// `tests/solver/` takes z3 4.15.4 6.7 million (`regress3-arith_prp-13-24`).
fn solver_rlimit() -> i64 {
	return 50000000
}

// The z3 to ask: `$Z3` where it is set, else `z3` on the path; `""` where
// neither runs.
fn solver_z3_exe() -> String throws {
	return solver_exe(env::var("Z3") ?? "z3")
}

// z3's answer to a file under `rlimit`: `sat`, `unsat`, `unknown`, or `error`
// where it wrote an `(error ...)` before any (its answer is then to another
// query than the file's). The wall clock `-T:30` stays an outer guard.
fn solver_z3(exe: String, path: String, rlimit: i64) -> String throws {
	let out = process::run(exe, solver_z3_args(path, rlimit))
	return solver_cli_answer(out.stdout)
}

// The arguments of `solver_z3`'s z3 run.
fn solver_z3_args(path: String, rlimit: i64) -> Vec[String] {
	return ["-smt2", "-T:30", f"rlimit={rlimit}", path]
}

// The value after a flag such as `--rlimit`, `fallback` without the flag;
// a value that is no number stops the run.
fn solver_flag(args: Vec[String], flag: String, fallback: i64) -> i64 throws {
	for k in 0..<args.len() {
		if args[k] != flag { continue }
		if k + 1 < args.len() {
			let n = text::parse_i64(args[k + 1].clone()) ?? -1
			if n > 0 { return n }
		}
		println(f"{flag} needs a positive number")
		process::exit(2)
	}
	return fallback
}

// The arguments without the flags that take a value (`--rlimit N`, `--size N`).
fn solver_plain(args: Vec[String]) -> Vec[String] {
	let mut out: Vec[String] = []
	let mut skip = false
	for a in args {
		if skip {
			skip = false
		} else if a == "--rlimit" || a == "--size" {
			skip = true
		} else {
			out.push(a.clone())
		}
	}
	return out
}

// The status a file states, as the driver reads it: `sat`, `unsat`, `error`
// for a file that must be refused (`; EXPECT: error`, #2258), else `""`.
fn solver_status(source: String) -> String {
	for raw in source.lines() {
		let line = raw.trim()
		if line.starts_with("(set-info :status ") {
			let rest = line["(set-info :status ".len()..].replace(")", "").trim().clone()
			if rest == "sat" || rest == "unsat" { return rest }
		}
		if line.starts_with("; EXPECT: ") {
			let rest = line["; EXPECT: ".len()..].trim().clone()
			if rest == "sat" || rest == "unsat" || rest == "error" { return rest }
		}
	}
	return ""
}

// The answer `run` scores for a file of status `status`: the engine's, but
// for a file that must be refused (`error`) `refused (REASON)` where the
// engine found it malformed, else wrong.
fn solver_scored(answer: String, status: String) -> String {
	if status != "error" { return answer }
	if answer.starts_with("malformed") { return f"refused{answer.strip_prefix("malformed") ?? ""}" }
	return f"wrong ({answer}, status error)"
}

// The source with its `:status` set to `status`: the line replaced where there
// is one, else written after `set-logic` (or first). An `unknown` status is
// not written.
fn solver_with_status(source: String, status: String) -> String {
	if status != "sat" && status != "unsat" { return source }
	let wanted = f"(set-info :status {status})"
	let mut out: Vec[String] = []
	let mut done = false
	for line in source.lines() {
		if line.trim().starts_with("(set-info :status ") {
			if !done { out.push(wanted.clone()) }
			done = true
			continue
		}
		out.push(line)
		if !done && line.trim().starts_with("(set-logic ") {
			out.push(wanted.clone())
			done = true
		}
	}
	if !done { out.insert(0, wanted) }
	return out.join("\n") + "\n"
}

// Every file of PATHS that states a status (`--write`: every file without
// one, which gets z3's answer written), checked against z3 under the rlimit
// (#1989 item 1). A disagreement is printed and makes the run exit 1; z3's
// `unknown` and `error` are none, and only counted. A file z3 refuses (an
// `(error ...)` before its answer) is printed with z3's reason and our
// engine's answer (#2258), and the closing line splits them into ours
// agreeing with the status, refusing too, and otherwise. A file that must be
// refused (`; EXPECT: error`, `tests/solver/malformed/`) is skipped.
fn solver_oracle(repo: String, nikaia: String, args: Vec[String]) throws {
	let z3_exe = solver_z3_exe()
	if z3_exe == "" {
		println("z3 is not on the path (nor `$Z3`): no oracle")
		process::exit(2)
	}
	let rlimit = solver_flag(args.clone(), "--rlimit", solver_rlimit())
	let mut write = false
	let mut targets: Vec[String] = []
	for a in solver_plain(args) {
		if a == "--write" { write = true } else { targets.push(a) }
	}
	let mut paths: Vec[String] = []
	for (_, p) in solver_targets(targets) { paths.push(p) }
	let mut checked = 0
	let mut disagree = 0
	let mut unknown = 0
	let mut errors = 0
	let mut ours_agrees = 0
	let mut ours_refuses = 0
	let mut ours_otherwise = 0
	// Our engine, built at the first file z3 refuses.
	let mut bin: String = ""
	for p in paths {
		let source = fs::read_to_string(p.clone(), fs::Root::Anywhere)
		let said = solver_status(source.clone())
		// A file that must be refused (`; EXPECT: error`) is `run`'s, not z3's.
		if said == "error" { continue }
		if said == "" && !write { continue }
		let out = process::run(z3_exe.clone(), solver_z3_args(p.clone(), rlimit))
		let z3 = solver_cli_answer(out.stdout.clone())
		if said == "" {
			if z3 == "sat" || z3 == "unsat" {
				fs::write(p.clone(), fs::Root::Anywhere, solver_with_status(source, z3.clone()))
				println(f"{p} {z3} written")
			}
			continue
		}
		checked += 1
		if z3 == "unknown" {
			unknown += 1
		} else if z3 == "error" {
			errors += 1
			if bin == "" {
				bin = solver_build(repo.clone(), nikaia.clone())
				if bin == "" { process::exit(1) }
			}
			let ours = solver_one("ours", bin.clone(), "", p.clone(), 60, false).answer
			if ours == said {
				ours_agrees += 1
			} else if ours == "malformed" {
				ours_refuses += 1
			} else {
				ours_otherwise += 1
			}
			println(f"{p} z3 refuses: {solver_cli_error(out.stdout)}; ours: {ours}")
		} else if said != z3 {
			disagree += 1
			println(f"{p} status {said}, z3 {z3}")
		}
	}
	println(f"{checked} files with a status, {disagree} disagree with z3, {unknown} unknown to z3 (rlimit {rlimit}), {errors} refused by z3 (ours agrees with the status {ours_agrees}, ours refuses too {ours_refuses}, ours otherwise {ours_otherwise})")
	if disagree > 0 { process::exit(1) }
}

// --- gen: the stress families of D9 ---

fn solver_declare(names: Vec[String]) -> String {
	let mut out = ""
	for n in names { out = out + f"(declare-const {n} Int)\n" }
	return out
}

fn solver_names(prefix: String, from: i64, to: i64) -> Vec[String] {
	let mut out: Vec[String] = []
	for i in from..<(to + 1) { out.push(f"{prefix}{i}") }
	return out
}

fn solver_script(declared: Vec[String], asserts: Vec[String]) -> String {
	let mut out = "(set-logic QF_LIA)\n" + solver_declare(declared)
	for a in asserts { out = out + f"(assert {a})\n" }
	return out + "(check-sat)\n(exit)\n"
}

// Guards: `y` counts the steps where `x` rises, as an `if x[i-1] < x[i]`
// chain. Even `n` asks for more steps than there are (unsat), odd `n` for
// every one (sat).
fn solver_guards(n: i64) -> String {
	let mut names = solver_names("x", 0, n)
	names.extend(solver_names("y", 0, n))
	let mut asserts: Vec[String] = ["(= y0 0)"]
	for i in 1..<(n + 1) {
		asserts.push(f"(or (and (< x{i - 1} x{i}) (= y{i} (+ y{i - 1} 1))) (and (>= x{i - 1} x{i}) (= y{i} y{i - 1})))")
	}
	if n % 2 == 0 { asserts.push(f"(> y{n} {n})") } else { asserts.push(f"(= y{n} {n})") }
	return solver_script(names, asserts)
}

// Unrelated disjunctions: `x = 0 || x = 1` for each of `n` variables beside a
// core about `i` and `k` that does not mention them. Even `n` holds the
// bounds-check contradiction (unsat), odd `n` only its consistent half (sat).
fn solver_disjunctions(n: i64) -> String {
	let mut names = solver_names("x", 1, n)
	names.push("i")
	names.push("k")
	let mut asserts: Vec[String] = []
	for name in solver_names("x", 1, n) { asserts.push(f"(or (= {name} 0) (= {name} 1))") }
	asserts.push("(<= 0 i)")
	asserts.push("(< i k)")
	if n % 2 == 0 { asserts.push("(not (< i (+ k 1)))") }
	return solver_script(names, asserts)
}

// `+1 or +2` paths: a counter stepping by one or two over `n` steps. Even `n`
// asks for more than `2n` (unsat), odd `n` for exactly `n + 1` (sat).
fn solver_steps(n: i64) -> String {
	let names = solver_names("c", 0, n)
	let mut asserts: Vec[String] = ["(= c0 0)"]
	for i in 1..<(n + 1) {
		asserts.push(f"(or (= c{i} (+ c{i - 1} 1)) (= c{i} (+ c{i - 1} 2)))")
	}
	if n % 2 == 0 { asserts.push(f"(> c{n} {2 * n})") } else { asserts.push(f"(= c{n} {n + 1})") }
	return solver_script(names, asserts)
}

// Parity: `x1 + ... + xn = 2m + 1` with each `xi` in `{-1, 1}`; unsat for even
// `n`, sat for odd.
fn solver_parity(n: i64) -> String {
	let mut names = solver_names("x", 1, n)
	names.push("m")
	let mut asserts: Vec[String] = []
	for name in solver_names("x", 1, n) { asserts.push(f"(or (= {name} (- 1)) (= {name} 1))") }
	asserts.push(f"(= (+ {solver_names("x", 1, n).join(" ")} 0) (+ (* 2 m) 1))")
	return solver_script(names, asserts)
}

// `blank = 2·n`, the shape of D9's 92 unknown queries: `n` values each twice
// some integer, summed. Even `n` asks for an odd sum (unsat), odd `n` for an
// even one (sat).
fn solver_blank(n: i64) -> String {
	let mut names = solver_names("b", 1, n)
	names.extend(solver_names("k", 1, n))
	names.push("m")
	let mut asserts: Vec[String] = []
	for i in 1..<(n + 1) { asserts.push(f"(= b{i} (* 2 k{i}))") }
	let total = f"(+ {solver_names("b", 1, n).join(" ")} 0)"
	if n % 2
		== 0 { asserts.push(f"(= {total} (+ (* 2 m) 1))") } else {
			asserts.push(f"(= {total} (+ (* 2 m) 2))")
		}
	return solver_script(names, asserts)
}

fn solver_two(n: i64) -> String {
	return if n < 10 { f"0{n}" } else { f"{n}" }
}

fn solver_gen(args: Vec[String]) throws {
	let dir = if args.len() > 0 { args[0].clone() } else { "tests/solver/stress" }
	let oracle = solver_z3_exe()
	let mut written = 0
	for family in ["guards", "disjunctions", "steps", "parity", "blank"] {
		process::run("mkdir", ["-p", f"{dir}/{family}"])
		let first = if family == "parity" { 2 } else { 1 }
		for n in first..<13 {
			let source = match family {
				"guards" => solver_guards(n),
				"disjunctions" => solver_disjunctions(n),
				"steps" => solver_steps(n),
				"parity" => solver_parity(n),
				else => solver_blank(n),
			}
			let path = f"{dir}/{family}/{family}-{solver_two(n)}.smt2"
			fs::write(path.clone(), fs::Root::Anywhere, source.clone())
			if oracle != "" {
				let z3 = solver_z3(oracle.clone(), path.clone(), solver_rlimit())
				if z3 == "sat"
					|| z3
					== "unsat" {
						fs::write(path, fs::Root::Anywhere, solver_with_status(source, z3))
					}
			}
			written += 1
		}
	}
	let note = if oracle != "" { "status from z3" } else { "no z3 on the path: no status written" }
	println(f"{written} files in {dir}, {note}")
}

// --- fuzz ---
// A linear congruential generator: the same seed, the same queries.
struct SolverRandom {
	state: i64,
}

impl SolverRandom {
	fn below(mut self, n: i64) -> i64 {
		self.state = (self.state * 1103515245 + 12345) % 2147483648
		return (self.state / 65536) % n
	}
}

// One atom of a generated query: `coeffs[v]·x{v}` summed, `op`, `rhs`.
struct SolverAtom {
	coeffs: Vec[i64],
	op: String,
	rhs: i64,
}

// A generated query over `x0 .. x{vars - 1}`: the conjunction of its
// clauses, each the disjunction of its atoms (one atom: a plain assertion).
struct SolverQuery {
	vars: i64,
	clauses: Vec[Vec[SolverAtom]],
}

// The size budget of the `size`th step (#1989): at most `size` variables and
// `size` assertions, coefficients within ±(1 + size / 2), right-hand sides
// within ±(10 + size). The fuzzer grows `size` from 1 to its `--size`.
fn solver_atom(mut r: SolverRandom, vars: i64, size: i64) -> SolverAtom {
	let bound = 1 + size / 2
	let mut coeffs: Vec[i64] = []
	let mut any = false
	for _ in 0..<vars {
		let c = r.below(2 * bound + 1) - bound
		if c == 0 || r.below(2) == 0 {
			coeffs.push(0)
		} else {
			coeffs.push(c)
			any = true
		}
	}
	if !any { coeffs[r.below(vars)] = 1 }
	let reach = 10 + size
	let rhs = r.below(2 * reach + 1) - reach
	let ops: Vec[String] = ["<=", "<", "=", ">=", ">", "distinct"]
	return SolverAtom { coeffs: coeffs, op: ops[r.below(6)].clone(), rhs: rhs }
}

// A random query within the budget of `size`: atoms, and disjunctions of two
// or three.
fn solver_query(mut r: SolverRandom, size: i64) -> SolverQuery {
	let vars = 1 + r.below(size)
	let mut clauses: Vec[Vec[SolverAtom]] = []
	let count = 1 + r.below(size)
	for _ in 0..<count {
		let mut parts: Vec[SolverAtom] = []
		if r.below(3) == 0 {
			let width = 2 + r.below(2)
			for _ in 0..<width { parts.push(solver_atom(r, vars, size)) }
		} else {
			parts.push(solver_atom(r, vars, size))
		}
		clauses.push(parts)
	}
	return SolverQuery { vars: vars, clauses: clauses }
}

fn solver_number(n: i64) -> String {
	return if n < 0 { f"(- {-n})" } else { f"{n}" }
}

fn solver_atom_text(a: SolverAtom) -> String {
	let mut terms: Vec[String] = []
	for v in 0..<a.coeffs.len() {
		let c = a.coeffs[v]
		if c == 0 { continue }
		if c == 1 { terms.push(f"x{v}") } else { terms.push(f"(* {solver_number(c)} x{v})") }
	}
	if terms.len() == 0 { terms.push("0") }
	let lhs = if terms.len() == 1 { terms[0].clone() } else { f"(+ {terms.join(" ")})" }
	return f"({a.op} {lhs} {solver_number(a.rhs)})"
}

fn solver_query_text(q: SolverQuery) -> String {
	let mut asserts: Vec[String] = []
	for clause in q.clauses {
		let mut parts: Vec[String] = []
		for a in clause { parts.push(solver_atom_text(a)) }
		asserts.push(if parts.len() == 1 { parts[0].clone() } else { f"(or {parts.join(" ")})" })
	}
	return solver_script(solver_names("x", 0, q.vars - 1), asserts)
}

// A random order of `0 ..< n` (Fisher-Yates).
fn solver_permutation(mut r: SolverRandom, n: i64) -> Vec[i64] {
	let mut out: Vec[i64] = []
	for k in 0..<n { out.push(k) }
	let mut k = n - 1
	while k > 0 {
		let j = r.below(k + 1)
		let held = out[k]
		out[k] = out[j]
		out[j] = held
		k -= 1
	}
	return out
}

// The atom that holds exactly where `a` does not.
fn solver_negated(a: SolverAtom) -> SolverAtom {
	let op = match a.op {
		"<=" => ">",
		"<" => ">=",
		"=" => "distinct",
		">=" => "<",
		">" => "<=",
		else => "=",
	}
	return SolverAtom { coeffs: a.coeffs.clone(), op: op, rhs: a.rhs }
}

// The mutations of a query (#1989 item 2), each `(kind, query, same)`:
// `same` where the mutant has the original's status. `shuffle` permutes the
// clauses and the atoms in each, `rename` the variables; `scale` multiplies
// one atom by 2-5 on both sides (an integer `k·a op k·b` holds exactly where
// `a op b` does, k > 0); `redundant` adds a clause one of the query's own
// clauses implies (that clause and one atom more); `negate` replaces one
// clause by its negation, the conjunction of its atoms negated, whose status
// is z3's to say.
fn solver_mutants(mut r: SolverRandom, q: SolverQuery) -> Vec[(String, SolverQuery, bool)] {
	let mut out: Vec[(String, SolverQuery, bool)] = []
	let n = q.clauses.len()

	let mut shuffled: Vec[Vec[SolverAtom]] = []
	for k in solver_permutation(r, n) {
		let clause = q.clauses[k].clone()
		let mut atoms: Vec[SolverAtom] = []
		for j in solver_permutation(r, clause.len()) { atoms.push(clause[j].clone()) }
		shuffled.push(atoms)
	}
	out.push(("shuffle", SolverQuery { vars: q.vars, clauses: shuffled }, true))

	let names = solver_permutation(r, q.vars)
	let mut renamed: Vec[Vec[SolverAtom]] = []
	for clause in q.clauses {
		let mut atoms: Vec[SolverAtom] = []
		for a in clause {
			let mut coeffs: Vec[i64] = []
			for _ in 0..<q.vars { coeffs.push(0) }
			for v in 0..<q.vars { coeffs[names[v]] = a.coeffs[v] }
			atoms.push(SolverAtom { coeffs: coeffs, op: a.op.clone(), rhs: a.rhs })
		}
		renamed.push(atoms)
	}
	out.push(("rename", SolverQuery { vars: q.vars, clauses: renamed }, true))

	let at = r.below(n)
	let within = r.below(q.clauses[at].len())
	let k = 2 + r.below(4)
	let mut scaled = q.clauses.clone()
	let old = scaled[at][within].clone()
	let mut coeffs: Vec[i64] = []
	for c in old.coeffs { coeffs.push(c * k) }
	scaled[at][within] = SolverAtom { coeffs: coeffs, op: old.op.clone(), rhs: old.rhs * k }
	out.push(("scale", SolverQuery { vars: q.vars, clauses: scaled }, true))

	let mut wider = q.clauses[r.below(n)].clone()
	wider.push(solver_atom(r, q.vars, q.vars))
	let mut redundant = q.clauses.clone()
	redundant.push(wider)
	out.push(("redundant", SolverQuery { vars: q.vars, clauses: redundant }, true))

	let gone = r.below(n)
	let mut negated: Vec[Vec[SolverAtom]] = []
	for j in 0..<n {
		if j != gone {
			negated.push(q.clauses[j].clone())
			continue
		}
		for a in q.clauses[j].clone() { negated.push([solver_negated(a)]) }
	}
	out.push(("negate", SolverQuery { vars: q.vars, clauses: negated }, false))
	return out
}

// z3's status of the `i`th question, or the self-test's stub: `unsat` for
// every third question, `sat` otherwise; it exercises the comparison, not the
// queries.
fn solver_fuzz_oracle(z3: String, i: i64, path: String, rlimit: i64) -> String throws {
	if z3 != "" { return solver_z3(z3, path, rlimit) }
	if i % 3 == 0 { return "unsat" }
	return "sat"
}

// The engine's answer as a status: `unsat` for *proved*, `sat` for
// *refuted*, `""` for any other.
fn solver_engine_status(answer: String) -> String {
	if answer == "proved" { return "unsat" }
	if answer == "refuted" { return "sat" }
	return ""
}

// The differential fuzzer (#1989 item 2): N random queries, their size grown
// from 1 to `--size` (default 8), each with its five mutants; z3 (under the
// rlimit) and the engine answer each. A disagreement is an engine answer
// against z3's, or a status-keeping mutant answered against the original's
// status (z3's where it decided, else the engine's own on the original); it
// is written to `tests/solver/bugs/` with the expected status, printed, and
// the run exits 1 with the command that reproduces it. `unknown` on either
// side is none. Per size, the closing lines count what z3 decided within its
// budget.
fn solver_fuzz(repo: String, nikaia: String, args: Vec[String]) throws {
	let self_test = args.contains("--self-test")
	let plain = solver_plain(args.clone())
	if !self_test && plain.len() < 2 {
		println("fuzz N SEED [--size S] [--rlimit R], or fuzz --self-test")
		process::exit(2)
	}
	let z3_exe = if self_test { "" } else { solver_z3_exe() }
	if !self_test && z3_exe == "" {
		println("z3 is not on the path (nor `$Z3`): no oracle, no fuzzing")
		process::exit(2)
	}
	let n = if self_test { 8 } else { text::parse_i64(plain[0].clone()) ?? 0 }
	let seed = if self_test { 7 } else { text::parse_i64(plain[1].clone()) ?? 0 }
	let max = solver_flag(args.clone(), "--size", 8)
	let rlimit = solver_flag(args.clone(), "--rlimit", solver_rlimit())
	// The queries and, under `--self-test`, the disagreements are written
	// into directories `std` made (ADR-raw-sinks-1 D12).
	let bugs: fs::Root = if self_test { fs::scratch() } else {
		let kept = f"{repo}/tests/solver/bugs"
		fs::create_dir(kept.clone(), fs::Root::Anywhere; recursive: true)
		fs::Root::Dir(kept)
	}
	let work = fs::scratch()
	let bin = solver_build(repo, nikaia)
	if bin == "" { process::exit(1) }
	println(f"fuzz: {n} queries, seed {seed}, size 1 to {max}, z3 rlimit {rlimit}")
	let mut r = SolverRandom { state: seed }
	let mut proved = 0
	let mut refuted = 0
	let mut unknown = 0
	let mut found = 0
	let mut asked = 0
	let mut decided: Vec[i64] = []
	let mut undecided: Vec[i64] = []
	for _ in 0..<(max + 1) {
		decided.push(0)
		undecided.push(0)
	}
	for i in 0..<n {
		let size = 1 + i * max / (if n > 0 { n } else { 1 })
		let q = solver_query(r, size)
		let mut questions: Vec[(String, SolverQuery, bool)] = [("", q.clone(), false)]
		for m in solver_mutants(r, q) { questions.push(m) }
		let mut original: String = ""
		for (kind, query, same) in questions {
			let source = solver_query_text(query)
			let name = if kind
				== "" { f"fuzz-{seed}-{i}.smt2" } else { f"fuzz-{seed}-{i}-{kind}.smt2" }
			let path = f"{work.path().display()}/{name}"
			fs::write(name.clone(), work, source.clone())
			let (answer, _, _) = solver_answer(bin.clone(), "new", path.clone(), 60)
			if answer == "proved" { proved += 1 }
			if answer == "refuted" { refuted += 1 }
			if answer.starts_with("unknown") { unknown += 1 }
			let mut expected: String = original.clone()
			let mut by = "the original's status"
			if !same {
				expected = solver_fuzz_oracle(z3_exe.clone(), asked, path, rlimit)
				asked += 1
				by = "z3"
				if expected == "sat"
					|| expected == "unsat" { decided[size] += 1 } else { undecided[size] += 1 }
				if kind == "" {
					original = if expected == "sat"
						|| expected == "unsat" { expected.clone() } else {
							solver_engine_status(answer.clone())
						}
				}
			}
			let got = solver_engine_status(answer.clone())
			let against = got != "" && (expected == "sat" || expected == "unsat") && got != expected
			if against || answer.starts_with("wrong") {
				found += 1
				fs::write(name.clone(), bugs, solver_with_status(source.clone(), expected.clone()))
				println(f"{name}: engine {answer}, {by} {expected}")
			}
			if self_test && i == 0 {
				println(f"-- {name}")
				print(source)
			}
		}
	}
	println(f"{n} queries and {n * 5} mutants (seed {seed}): proved {proved}, refuted {refuted}, unknown {unknown}, disagreements {found}")
	for s in 1..<(max + 1) {
		if decided[s] + undecided[s] > 0 {
			println(f"size {s}: z3 decided {decided[s]}, undecided {undecided[s]}")
		}
	}
	if self_test { process::run("rm", ["-rf", bugs.path().display()]) }
	process::run("rm", ["-rf", work.path().display()])
	if found > 0 {
		println(f"reproduce: nikaia run scripts/solver.nika -- fuzz {n} {seed} --size {max} --rlimit {rlimit}")
		process::exit(1)
	}
}

// --- tune: the parameters on one half, the report on the other ---

// The candidate values of each tuned parameter of `sv_params`, the default
// first.
fn solver_tune_candidates() -> Vec[String] {
	return [
		"walk_first=250|0|100|500",
		"moves_per_unit=100|50|400",
		"noise=100|30|300",
		"tenure=3|1|10",
		"walk_after=true|false",
		"dense_width=4|2|8",
		"theory=both|simplex|fm",
		"cut_kind=gmi|cg",
		"cut_rounds=8|2|32",
		"bland_after=64|8",
	]
}

// The engine for the settings `name=value`: `new` where there are none.
fn solver_tune_engine(settings: Vec[String]) -> String {
	if settings.len() == 0 { return "new" }
	return f"new:{settings.join(",")}"
}

// The rows of `files` answered by `engine`.
fn solver_tune_rows(
	bin: String,
	engine: String,
	files: Vec[(String, String)],
	timeout: i64,
) -> Vec[SolverRow] throws {
	let mut rows: Vec[SolverRow] = []
	for (group, path) in files {
		let (answer, work, shown) = solver_answer(
			bin.clone(),
			engine.clone(),
			path.clone(),
			timeout,
		)
		let file = path.split("/").last() ?? path
		rows.push(SolverRow {
			group: group.clone(),
			name: f"{group}/{file}",
			answer: answer,
			work: work,
			shown: shown,
		})
	}
	return rows
}

// The PAR-2 sum of `rows`, or -1 where one of them is wrong.
fn solver_tune_cost(rows: Vec[SolverRow]) -> i64 {
	let mut cost = 0
	for r in rows {
		if r.answer.starts_with("wrong") { return -1 }
		if solver_solved(r.answer.clone()) {
			cost += r.work
		} else {
			cost += 2 * solver_budget()
		}
	}
	return cost
}

fn solver_tune(repo: String, nikaia: String, args: Vec[String]) throws {
	let mut timeout = 30
	let mut dir = f"{repo}/tests/solver/qflia"
	let mut i = 0
	while i < args.len() {
		if args[i] == "--timeout" && i + 1 < args.len() {
			timeout = text::parse_i64(args[i + 1].clone()) ?? 30
			i += 2
			continue
		}
		dir = args[i].clone()
		i += 1
	}
	let files = solver_files(dir)
	let mut tuning: Vec[(String, String)] = []
	let mut held: Vec[(String, String)] = []
	for k in 0..<files.len() {
		if k % 2 == 0 { tuning.push(files[k].clone()) } else { held.push(files[k].clone()) }
	}
	if tuning.len() == 0 || held.len() == 0 {
		println("tune needs two .smt2 files at least")
		process::exit(2)
	}
	let bin = solver_build(repo, nikaia)
	if bin == "" { process::exit(1) }
	println(f"tuning on {tuning.len()} files, holding out {held.len()}")
	let mut settings: Vec[String] = []
	let mut best = solver_tune_cost(solver_tune_rows(bin.clone(), "new", tuning, timeout))
	println(f"defaults: PAR-2 sum {best}")
	for line in solver_tune_candidates() {
		let (name, values) = line.split_once("=") ?? continue
		let mut chosen: Vec[String] = settings.clone()
		for value in values.split("|") {
			let mut trial: Vec[String] = []
			for s in settings {
				if !s.starts_with(f"{name}=") { trial.push(s.clone()) }
			}
			trial.push(f"{name}={value}")
			let engine = solver_tune_engine(trial)
			let cost = solver_tune_cost(solver_tune_rows(
				bin.clone(),
				engine.clone(),
				tuning,
				timeout,
			))
			println(f"  {engine}: PAR-2 sum {cost}")
			if cost >= 0 && cost < best {
				best = cost
				chosen = trial
			}
		}
		settings = chosen
	}
	let tuned = solver_tune_engine(settings)
	println(f"tuned: {tuned}, PAR-2 sum {best}")
	println(solver_summary(
		"held out, defaults",
		solver_tune_rows(bin.clone(), "new", held, timeout),
	))
	println(solver_summary(
		f"held out, {tuned}",
		solver_tune_rows(bin, tuned, held, timeout),
	))
}

// --- fetch: the SMT-LIB set of #1338, by commit ---

// One Git repository the set is taken from: its URL, the commit it is read
// at, and the paths (sparse-checkout patterns) read there.
struct SolverSource {
	name: String,
	url: String,
	commit: String,
	paths: Vec[String],
}

// The sources of the set (#1338 item 2; origin and licence of each family in
// `tests/solver/SOURCES.md`). Only GitHub reaches this environment, so the
// SMT-LIB library comes from SMT-LIB's own staging repositories (the files of
// each release's new families), the semantic-fusion seeds (SMT-LIB files
// sorted by status) and z3test's unchanged SMT-LIB 2025 sample.
fn solver_sources() -> Vec[SolverSource] {
	return [
		SolverSource {
			name: "seeds",
			url: "https://github.com/testsmt/semantic-fusion-seeds",
			commit: "93029d5e832fbba80dcda7e6032e60fbc861ed39",
			paths: ["QF_LIA/*", "QF_LRA/*"],
		},
		SolverSource {
			name: "smtlib-2022",
			url: "https://github.com/SMT-LIB/benchmark-submission-2022",
			commit: "81a39628827f61fbd74c6f3e67feb5c1b740d2f0",
			paths: [
				"non-incremental/QF_LIA/20220307-SMPT/*/RC-00.smt2",
				"non-incremental/QF_LIA/20220307-SMPT/*/RF-00.smt2",
			],
		},
		SolverSource {
			name: "smtlib-2023",
			url: "https://github.com/SMT-LIB/benchmark-submission-2023",
			commit: "7f993a017850ba547c6ea19a1bf3b54adf54a449",
			paths: ["non-incremental/QF_LIA/*", "non-incremental/QF_LRA/*"],
		},
		SolverSource {
			name: "smtlib-2024",
			url: "https://github.com/SMT-LIB/benchmark-submission-2024",
			commit: "02e00a1ad661405c438059820d82a5cf5ef11569",
			paths: ["non-incremental/QF_LIA/*", "non-incremental/QF_LRA/*"],
		},
		SolverSource {
			name: "z3test",
			url: "https://github.com/Z3Prover/z3test",
			commit: "b09a2011aabe656b4a4f22c3bf13c883563fa8e1",
			paths: ["regressions/smtlib-sample/QF_LIA/*", "regressions/smtlib-sample/QF_LRA/*"],
		},
	]
}

// The largest file taken: 1 MiB.
fn solver_fetch_limit() -> i64 {
	return 1048576
}

// Runs `git ARGS` in `dir`, and stops the script where it fails.
fn solver_git(dir: String, args: Vec[String]) -> String throws {
	let out = process::run("git", args.clone(); dir: dir)
	if !out.ok {
		println(f"git {args.join(" ")} failed: {out.stderr.trim()}")
		process::exit(1)
	}
	return out.stdout.trim().clone()
}

// The source's files checked out at its commit in `clone`: a clone that is
// already there at that commit is read again, anything else made anew, with
// only the source's paths' blobs fetched.
fn solver_checkout(s: SolverSource, clone: String) throws {
	if fs::exists(f"{clone}/.git", fs::Root::Anywhere) {
		let head = process::run(
			"git",
			["rev-parse", "HEAD"]; dir: clone.clone(),
		).stdout.trim().clone()
		if head == s.commit { return }
		fs::remove(clone.clone(), fs::Root::Anywhere; recursive: true)
	}
	fs::create_dir(clone.clone(), fs::Root::Anywhere; recursive: true)
	solver_git(clone.clone(), ["init", "-q"])
	solver_git(clone.clone(), ["remote", "add", "origin", s.url.clone()])
	solver_git(
		clone.clone(),
		["fetch", "-q", "--depth", "1", "--filter=blob:none", "origin", s.commit.clone()],
	)
	let mut sparse: Vec[String] = ["sparse-checkout", "set", "--no-cone"]
	for p in s.paths { sparse.push(p.clone()) }
	solver_git(clone.clone(), sparse)
	solver_git(clone.clone(), ["checkout", "-q", s.commit.clone()])
}

// Why a file is not taken, or `""` where it is: its logic must be QF_LIA or
// QF_LRA, it must ask one `check-sat` and nothing incremental, state its
// status (the size is judged before the file is read).
fn solver_refusal(source: String) -> String {
	if source.contains("(push")
		|| source.contains("(pop")
		|| source.contains("check-sat-assuming") { return "incremental" }
	if source.split("(check-sat)").count() != 2 { return "not one check-sat" }
	let status = solver_status(source)
	if status != "sat" && status != "unsat" { return "no status" }
	return ""
}

// The set's directory a file goes into: `qflia` or `qflra`, `""` for any other
// logic.
fn solver_logic_dir(source: String) -> String {
	if source.contains("(set-logic QF_LIA)") { return "qflia" }
	if source.contains("(set-logic QF_LRA)") { return "qflra" }
	return ""
}

// The family and the file name a path of `source` is filed under: below
// `non-incremental/LOGIC/` the family is SMT-LIB's own and the name the rest
// of the path; elsewhere the family is the source and the name the path
// below its first directory, each `/` written `-`.
fn solver_family(source: String, path: String) -> (String, String) {
	let at = path.find("non-incremental/") ?? {
		let slash = path.find("/") ?? return (f"{source}", f"{path}")
		return (f"{source}", f"{path[slash + "/".len()..].replace("/", "-")}")
	}
	let below = path[at + "non-incremental/".len()..]
	let logic = below.find("/") ?? return (f"{source}", f"{below}")
	let family = below[logic + "/".len()..]
	let end = family.find("/") ?? return (f"{source}", f"{family}")
	return (f"{family[0..<end]}", f"{family[end + "/".len()..].replace("/", "-")}")
}

fn solver_fetch(args: Vec[String]) throws {
	let dir = if args.len()
		> 0 { args[0].trim_end_matches("/") } else { "target/smtlib" }
	for logic in ["qflia", "qflra"] {
		if fs::exists(f"{dir}/{logic}", fs::Root::Anywhere) {
			fs::remove(f"{dir}/{logic}", fs::Root::Anywhere; recursive: true)
		}
	}
	let mut seen: Vec[String] = []
	let mut lia = 0
	let mut lra = 0
	for s in solver_sources() {
		let clone = f"{dir}/.sources/{s.name}"
		solver_checkout(s.clone(), clone.clone())
		let mut taken = 0
		let mut reasons: Vec[String] = []
		let listed = solver_git(clone.clone(), ["ls-files", "-s"])
		let mut entries: Vec[String] = []
		for line in listed.lines() { entries.push(line) }
		entries.sort()
		for line in entries {
			let tab = line.find("\t") ?? continue
			let path = f"{line[tab + "\t".len()..]}"
			let blob = f"{line.split(" ").nth(1) ?? ""}"
			if !path.ends_with(".smt2") { continue }
			let full = f"{clone}/{path}"
			if !fs::exists(full.clone(), fs::Root::Anywhere) { continue }
			let size = fs::metadata(full.clone(), fs::Root::Anywhere).len() as i64
			let text = if size
				> solver_fetch_limit() { "" } else {
					fs::read_to_string(full.clone(), fs::Root::Anywhere)
				}
			let logic = solver_logic_dir(text.clone())
			let why = if size
				> solver_fetch_limit() { "over 1 MiB" } else if logic
				== "" {
					"another logic"
				} else if seen.contains(blob.clone()) { "taken from an earlier source" } else {
					solver_refusal(text.clone())
				}
			if why != "" {
				reasons.push(why)
				continue
			}
			seen.push(blob)
			let (family, name) = solver_family(s.name.clone(), path)
			fs::create_dir(f"{dir}/{logic}/{family}", fs::Root::Anywhere; recursive: true)
			fs::copy(full, f"{dir}/{logic}/{family}/{name}", fs::Root::Anywhere)
			taken += 1
			if logic == "qflia" { lia += 1 } else { lra += 1 }
		}
		let mut kinds: Vec[String] = []
		for r in reasons {
			if !kinds.contains(r.clone()) { kinds.push(r.clone()) }
		}
		let mut skipped: Vec[String] = []
		for k in kinds {
			let mut n = 0
			for r in reasons {
				if r == k { n += 1 }
			}
			skipped.push(f"{n} {k}")
		}
		let note = if skipped.len() > 0 { f", left out: {skipped.join(", ")}" } else { "" }
		println(f"{s.name} at {s.commit}: {taken} taken{note}")
	}
	println(f"{dir}: qflia {lia} files, qflra {lra} files")
}

// The fixed sample CI runs (#1338): `n` files of each logic of the fetched
// set `dir`, at most 64 KiB each, taken at even steps through the sorted
// list, copied into `out` with their family directories.
fn solver_sample(args: Vec[String]) throws {
	if args.len() < 2 {
		println("usage: solver.nika sample DIR OUT [N]")
		process::exit(2)
	}
	let dir = args[0].trim_end_matches("/")
	let out = args[1].trim_end_matches("/")
	let n = if args.len() > 2 { text::parse_i64(args[2].clone()) ?? 25 } else { 25 }
	for logic in ["qflia", "qflra"] {
		let mut small: Vec[(String, String)] = []
		for (group, path) in solver_files(f"{dir}/{logic}") {
			if fs::metadata(path.clone(), fs::Root::Anywhere).len() as i64
				<= 65536 { small.push((group, path)) }
		}
		if fs::exists(f"{out}/{logic}", fs::Root::Anywhere) {
			fs::remove(f"{out}/{logic}", fs::Root::Anywhere; recursive: true)
		}
		let mut taken = 0
		for i in 0..<n {
			if small.len() == 0 { break }
			// `small` is read from the disk (ADR-396 D2, #2371).
			let at = i * small.len() / n
			if at < 0 || at >= small.len() { break }
			let (group, path) = small[at].clone()
			let file = f"{path.split("/").last() ?? ""}"
			fs::create_dir(f"{out}/{group}", fs::Root::Anywhere; recursive: true)
			fs::copy(path.clone(), f"{out}/{group}/{file}", fs::Root::Anywhere)
			taken += 1
		}
		println(f"{out}/{logic}: {taken} of {small.len()} files")
	}
}

// --- compare: ours, z3 and cvc5 on the same files (#1338 item 3, 4) ---

// One solver's run on one file: its answer (`sat`, `unsat`, `unknown`,
// `malformed`, `error` or `rejected`, an answer of ours its checker refused),
// the wall time in milliseconds, the peak resident memory in KiB (-1 where
// the platform gives none) and, under `--instructions`, the instructions
// callgrind counted (-1 without).
struct SolverRun {
	answer: String,
	millis: i64,
	kib: i64,
	instructions: i64,
}

// The command of a solver and its arguments for `path`: ours is the rod's
// binary, z3 and cvc5 their CLIs, each told the same time limit.
fn solver_command(
	solver: String,
	bin: String,
	exe: String,
	path: String,
	timeout: i64,
) -> (String, Vec[String]) {
	if solver == "ours" { return (f"{bin}", [f"new:cases={solver_rod_cases()}", path]) }
	if solver == "z3" { return (f"{exe}", ["-smt2", f"-T:{timeout}", path]) }
	return (f"{exe}", [f"--tlimit={timeout * 1000}", path])
}

// The first `sat`, `unsat` or `unknown` line of a CLI's output; `error` where
// it wrote an `(error ...)` before any.
fn solver_cli_answer(stdout: String) -> String {
	for raw in stdout.lines() {
		let line = raw.trim()
		if line == "sat" || line == "unsat" || line == "unknown" { return f"{line}" }
		if line.starts_with("(error") { return "error" }
	}
	return "unknown"
}

// The text of a CLI's first `(error "...")` line, the line itself where it
// quotes none, `""` without one.
fn solver_cli_error(stdout: String) -> String {
	for raw in stdout.lines() {
		let line = raw.trim()
		if !line.starts_with("(error") { continue }
		let open = line.find("\"") ?? return f"{line}"
		let rest = line[open + "\"".len()..]
		let close = rest.rfind("\"") ?? return f"{rest}"
		return f"{rest[0..<close]}"
	}
	return ""
}

// The rod's answer as an SMT-LIB answer: *proved* is `unsat`, *refuted*
// `sat`; an answer against the status is still the answer given, one whose
// certificate, model or lemma the checker rejected is `rejected`.
fn solver_rod_answer(answer: String) -> String {
	if answer == "proved" || answer == "wrong (proved, status sat)" { return "unsat" }
	if answer == "refuted" || answer == "wrong (refuted, status unsat)" { return "sat" }
	if answer.starts_with("wrong") { return "rejected" }
	if answer.starts_with("malformed") { return "malformed" }
	return "unknown"
}

// callgrind's `Collected : N` from a run's standard error, -1 without one.
fn solver_collected(stderr: String) -> i64 {
	for line in stderr.lines() {
		let at = line.find("Collected : ") ?? continue
		return text::parse_i64(line[at + "Collected : ".len()..].trim()) ?? -1
	}
	return -1
}

// Whether the rod at the build-time case budget answers `path` with
// `unknown (overflow)` within `timeout` seconds.
fn solver_rod_overflows(bin: String, path: String, timeout: i64) -> bool throws {
	let out = process::run(bin, ["new", path]; within: timeout.seconds())
	if out.timed_out || !out.ok { return false }
	let line = out.stdout.trim().lines().nth(0) ?? ""
	return line.starts_with("unknown (overflow) ")
}

// One solver on one file. A run past its limit is `timeout`, ours' file
// that leaves `i64` `overflow`, any other answer but `sat` and `unsat`
// `unknown`; under
// `instructions` the run goes through callgrind, with a hundred times the
// limit, the CLIs' own included, for valgrind's slowdown.
fn solver_one(
	solver: String,
	bin: String,
	exe: String,
	path: String,
	timeout: i64,
	instructions: bool,
) -> SolverRun throws {
	// The CLIs' own limit is widened with the runner's: under callgrind they
	// would give up after a tenth of their work.
	let own = if instructions { timeout * 100 } else { timeout }
	let (cmd, args) = solver_command(solver.clone(), bin.clone(), exe, path.clone(), own)
	let mut run_cmd = cmd.clone()
	let mut run_args: Vec[String] = []
	let mut limit = timeout + 5
	if instructions {
		run_cmd = "valgrind"
		run_args = ["--tool=callgrind", "--callgrind-out-file=/dev/null", cmd.clone()]
		limit = own + 5
	}
	for a in args { run_args.push(a.clone()) }
	let out = process::run(run_cmd, run_args; within: limit.seconds())
	let millis = out.elapsed.in_millis() as i64
	let kib = out.max_rss_kib ?? -1
	let counted = if instructions { solver_collected(out.stderr) } else { -1 }
	if out.timed_out || (!instructions && millis > timeout * 1000) {
		// Ours past the limit: a search that left `i64` hands over to the
		// walk, which the case budget of `compare` lets run until it is
		// killed, so the killed run names no overflow. The search is the
		// same at the build-time budget up to that point, and there it ends
		// in a few hundred cases with `unknown (overflow)`: asked so,
		// untimed by the row, the file counts as `overflow` (#2259).
		let mut answer: String = "timeout"
		if solver == "ours" && solver_rod_overflows(bin, path, timeout) { answer = "overflow" }
		return SolverRun { answer: answer, millis: millis, kib: kib, instructions: counted }
	}
	let mut answer: String = "unknown"
	if solver == "ours" {
		if out.ok {
			let line = out.stdout.trim().lines().nth(0) ?? ""
			let at = line.rfind(" ") ?? line.len()
			// The rod's `unknown (overflow)`: the file leaves `i64` (ADR-270
			// D11), counted apart from a miss (#2259).
			let said = f"{line[0..<at]}"
			answer = if said == "unknown (overflow)" { "overflow" } else { solver_rod_answer(said) }
		}
	} else {
		answer = solver_cli_answer(out.stdout)
	}
	return SolverRun { answer: answer, millis: millis, kib: kib, instructions: counted }
}

// `exe` where it runs (the operator's `$VAR`, else the solver's name on the
// path), `""` where it does not. The caller reads the variable by its literal
// name: a name the compiler does not know while building is untrusted
// (ADR-397 D2), and the program run is a raw sink (ADR-raw-sinks-1 D10).
fn solver_exe(exe: String) -> String throws {
	return if process::run("sh", ["-c", f"command -v '{exe}'"]).ok { exe } else { "" }
}

// The middle of `xs` (the lower one of two), 0 for none.
fn solver_median(xs: Vec[i64]) -> i64 {
	if xs.len() == 0 { return 0 }
	let mut s = xs.clone()
	s.sort()
	return s[(s.len() - 1) / 2]
}

// One solver's row over the files `at` of `runs`: solved, wrong against the
// status, the rest by reason (ours' overflow, a timeout, any other unknown;
// the CLIs never overflow, so their row leaves that count out), PAR-2 in
// seconds (the wall time of a solved file, twice the limit otherwise), peak memory (the most and the median) and, where counted, the
// instructions of the solved files.
fn solver_compare_row(
	solver: String,
	runs: Vec[Vec[SolverRun]],
	statuses: Vec[String],
	at: Vec[i64],
	k: i64,
	timeout: i64,
) -> String {
	let mut solved = 0
	let mut wrong = 0
	let mut par2 = 0
	let mut kibs: Vec[i64] = []
	let mut instructions = 0
	let mut counted = 0
	let mut overflow = 0
	let mut timeouts = 0
	let mut unknown = 0
	for i in at {
		let r = runs[i][k]
		let status = statuses[i]
		let answered = r.answer == "sat" || r.answer == "unsat"
		if answered && status != "" && r.answer != status { wrong += 1 }
		if r.answer == "rejected" { wrong += 1 }
		if r.answer == "overflow" {
			overflow += 1
		} else if r.answer == "timeout" {
			timeouts += 1
		} else if !answered && r.answer != "rejected" {
			unknown += 1
		}
		if answered && (status == "" || r.answer == status) {
			solved += 1
			par2 += r.millis
			if r.instructions >= 0 {
				instructions += r.instructions
				counted += 1
			}
		} else {
			par2 += 2 * timeout * 1000
		}
		if r.kib >= 0 { kibs.push(r.kib) }
	}
	let mut most = 0
	for x in kibs {
		if x > most { most = x }
	}
	let n = at.len()
	let mean = if n > 0 { par2 / n / 100 } else { 0 }
	let shown = if counted > 0 { f", {instructions / counted} instructions per solved" } else { "" }
	let over = if solver == "ours" { f" overflow {overflow}" } else { "" }
	return f"{solver} solved {solved} wrong {wrong}{over} timeout {timeouts} unknown {unknown} PAR-2 {solver_tenths(mean)} s, peak {most / 1024} MiB (median {solver_median(kibs) / 1024}){shown}"
}

fn solver_compare(repo: String, nikaia: String, args: Vec[String]) throws {
	let mut timeout = 10
	let mut instructions = false
	let mut per_file = false
	let mut targets: Vec[String] = []
	let mut i = 0
	while i < args.len() {
		let a = args[i].clone()
		if a == "--timeout" && i + 1 < args.len() {
			timeout = text::parse_i64(args[i + 1].clone()) ?? 10
			i += 2
			continue
		}
		if a == "--instructions" {
			instructions = true
		} else if a == "--files" {
			per_file = true
		} else {
			targets.push(a)
		}
		i += 1
	}
	let files = solver_targets(targets)
	if files.len() == 0 {
		println("no .smt2 files")
		return
	}
	let bin = solver_build(repo, nikaia)
	if bin == "" { process::exit(1) }
	let mut solvers: Vec[String] = ["ours"]
	let mut exes: Vec[String] = [""]
	for (name, var, chosen) in [("z3", "Z3", env::var("Z3") ?? "z3"), ("cvc5", "CVC5", env::var("CVC5") ?? "cvc5")] {
		let exe = solver_exe(chosen)
		if exe == "" {
			println(f"{name} is not on the path (nor ${var}): left out")
		} else {
			solvers.push(name.clone())
			exes.push(exe)
		}
	}
	// The runner's own high-water mark, below which no child's peak is
	// reported on Linux (ADR-368 D3): a peak at it means at most it.
	let floor = process::run("true", []).max_rss_kib ?? -1
	println(f"limit {timeout} s per file and solver, memory floor {floor / 1024} MiB (the runner's own)")
	let mut statuses: Vec[String] = []
	let mut groups: Vec[String] = []
	let mut runs: Vec[Vec[SolverRun]] = []
	let mut disagree: Vec[bool] = []
	for (group, path) in files {
		let status = solver_status(fs::read_to_string(path.clone(), fs::Root::Anywhere))
		let mut row: Vec[SolverRun] = []
		for k in 0..<solvers.len() {
			row.push(solver_one(
				solvers[k].clone(),
				bin.clone(),
				exes[k].clone(),
				path.clone(),
				timeout,
				instructions,
			))
		}
		let mut sats = false
		let mut unsats = false
		for r in row {
			if r.answer == "sat" { sats = true }
			if r.answer == "unsat" { unsats = true }
		}
		if per_file {
			let file = path.split("/").last() ?? path
			let mut shown: Vec[String] = []
			for k in 0..<solvers.len() {
				let r = row[k]
				let counted = if r.instructions >= 0 { f" {r.instructions}i" } else { "" }
				shown.push(f"{solvers[k]} {r.answer} {r.millis}ms {r.kib}KiB{counted}")
			}
			let mark = if sats && unsats { " DISAGREE" } else { "" }
			println(f"{group}/{file} [{status}] {shown.join(" | ")}{mark}")
		}
		statuses.push(status)
		groups.push(group.clone())
		runs.push(row)
		disagree.push(sats && unsats)
	}
	let mut names: Vec[String] = []
	for g in groups {
		if !names.contains(g.clone()) { names.push(g.clone()) }
	}
	let mut every: Vec[i64] = []
	for j in 0..<groups.len() { every.push(j) }
	if names.len() > 1 { names.push("all") }
	for g in names {
		let mut at: Vec[i64] = []
		let mut split = 0
		for j in 0..<groups.len() {
			if g == "all" || groups[j] == g {
				at.push(j)
				// `disagree` is filled from the solvers' answers (ADR-396
				// D2, #2371).
				if j < disagree.len() && disagree[j] { split += 1 }
			}
		}
		println(f"{g}: {at.len()} files, disagree {split}")
		for k in 0..<solvers.len() {
			println(f"  {solver_compare_row(solvers[k].clone(), runs.clone(), statuses.clone(), at.clone(), k, timeout)}")
		}
	}
}

fn main() throws {
	// The program's name, the command, and what the command reads.
	let mut command: String = ""
	let mut rest: Vec[String] = []
	let mut at = 0
	for a in cli::args() {
		if at == 1 { command = a } else if at > 1 { rest.push(a) }
		at += 1
	}
	let repo = solver_root()
	let nikaia = solver_toolchain(repo.clone())
	if command == "--build-in" && rest.len() == 4 {
		solver_build_in(rest[0].clone(), rest[1].clone(), rest[2].clone(), rest[3].clone())
	} else if command == "run" {
		solver_run(repo, nikaia, rest)
	} else if command == "gen" {
		solver_gen(rest)
	} else if command == "oracle" {
		solver_oracle(repo, nikaia, rest)
	} else if command == "fuzz" {
		solver_fuzz(repo, nikaia, rest)
	} else if command == "tune" {
		solver_tune(repo, nikaia, rest)
	} else if command == "fetch" {
		solver_fetch(rest)
	} else if command == "sample" {
		solver_sample(rest)
	} else if command == "compare" {
		solver_compare(repo, nikaia, rest)
	} else if command == "build" {
		let bin = solver_build(repo, nikaia)
		if bin == "" { process::exit(1) }
		println(bin)
	} else {
		println("usage: solver.nika run|gen|oracle|fuzz|tune|fetch|sample|compare|build ... (see the head of scripts/solver.nika)")
		process::exit(2)
	}
}
