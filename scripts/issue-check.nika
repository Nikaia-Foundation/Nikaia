// Checks an issue's form before a run is spent on it (#2003, docs/issues.md).
//
//     nikaia run scripts/issue-check.nika -- N
//     nikaia run scripts/issue-check.nika -- --body FILE [--open M...]
//     nikaia run scripts/issue-check.nika -- --body - [--open M...] < FILE
//
// prints one line per missing requirement and exits 1 when any is missing
// (nothing and exit 0 when the form holds). It checks:
//
// * a *To build* list (I9): a heading (`## To build`, `**To build**`) with
//   at least one line under it;
// * a *Done when* (I8): a heading or a line starting `Done when`;
// * every `#M` in the *To build* list, outside brackets, that is open and not named by a line
//   of the body that says `Needs`, `After`, `Blocked by`, `Waits for`,
//   `Depends on`, `Part of` or `Found while` (I4): `possible missing Needs
//   #M`, since the driver queues an issue whose dependency it cannot see
//   (#1336 needed #478, #1913 said "the key decided in #1909").
//
// Quoted text (a fenced block, a backtick span holding a `#`) names nothing.
// With `-- N` the body and the state of each `#M` are read from GitHub; with
// `--body FILE` (`--body -`: the body on standard input, the driver's form,
// #2466) the state too, unless `--open` lists the open ones (then
// every other `#M` counts as closed: the tests' form). The driver runs it
// on each issue before queuing it (drive_queue in scripts/drive.nika); the
// issues the driver files itself (drive_found_body, drive_improve_body) hold
// both sections and cite in their *To build* only closed issues.

use std::cli
use std::fs
use std::io
use std::process

fn check_repo() -> String {
    return "Nikaia-Foundation/Nikaia"
}

// LINE without what it quotes: a backtick span holding a `#` (an unclosed
// last one is kept).
fn check_unquoted_line(line: String) -> String {
    let pieces: Vec[String] = line.split("`").collect()
    let mut out = String()
    for i in 0..<pieces.len() {
        let piece = pieces[i]
        if i % 2 == 1 && i + 1 < pieces.len() && piece.contains("#") { continue }
        out.push_str(piece)
    }
    return out
}

// The lines of BODY outside fenced blocks, each without its quoted spans.
fn check_lines(body: String) -> Vec[String] {
    let mut out: Vec[String] = []
    let mut fenced = false
    for raw in body.split("\n") {
        if raw.trim().starts_with("```") {
            fenced = !fenced
            continue
        }
        if !fenced { out.push(check_unquoted_line(raw.clone())) }
    }
    return out
}

// The words of a LINE after its marks (`#`, `*`, `_`, `-`, list numbers and
// spaces) at the start, lowercased: `## To build` gives `to build`.
fn check_words(line: String) -> String {
    let mut t = line.trim().to_lowercase()
    let mut stripping = true
    while stripping {
        stripping = false
        for mark in ["#", "*", "_", "- ", "> ", "[ ] ", "[x] ", " "] {
            if t.starts_with(mark) {
                t = (t.strip_prefix(mark) ?? "").clone()
                stripping = true
            }
        }
    }
    return t
}

// Whether LINE is a heading: `#` marks followed by a space, or a line in
// bold alone (`**To build**`, `**Done when:**`).
fn check_is_heading(line: String) -> bool {
    let t = line.trim()
    if t.starts_with("#") {
        let rest = t.replace("#", " ")
        return rest.starts_with(" ")
    }
    return t.starts_with("**") && (t.ends_with("**") || t.ends_with("**:")) && t.len() > 4
}

// TEXT without its bracketed spans (each line on its own): `(#1991)` cites a source, it names no
// dependency (the issue's own form, #2003's item 6), while prose such as
// "the key decided in #1909" does.
fn check_unbracketed(text: String) -> String {
    let mut out = String(capacity: text.len())
    let mut depth = 0
    for c in text.scalars {
        if c == '\n' {
            depth = 0
            out.push(c)
        } else if c == '(' {
            depth += 1
        } else if c == ')' && depth > 0 {
            depth -= 1
        } else if depth == 0 {
            out.push(c)
        }
    }
    return out
}

// The issue numbers a TEXT names as `#N` (digits right after the `#`).
fn check_numbers(text: String) -> Vec[String] {
    let mut out: Vec[String] = []
    let pieces: Vec[String] = text.split("#").collect()
    for i in 1..<pieces.len() {
        let mut n = String()
        for c in pieces[i].scalars {
            if c < '0' || c > '9' { break }
            n.push(c)
        }
        if n != "" && !out.contains(n.clone()) { out.push(n) }
    }
    return out
}

// The lines of BODY's *To build* section (after its heading, up to the next
// heading), or none when it has no such heading.
fn check_to_build(lines: Vec[String]) -> (bool, Vec[String]) {
    let mut found = false
    let mut inside = false
    let mut out: Vec[String] = []
    for line in lines {
        if check_is_heading(line.clone()) {
            inside = check_words(line.clone()).starts_with("to build")
            if inside { found = true }
            continue
        }
        if inside && line.trim() != "" { out.push(line.clone()) }
    }
    return (found, out)
}

// Whether BODY has a *Done when*: a heading or a line starting so.
fn check_done_when(lines: Vec[String]) -> bool {
    for line in lines {
        if check_words(line.clone()).starts_with("done when") { return true }
    }
    return false
}

// The issues the lines of a body name as where it belongs or what it waits
// for (I4): every `#M` of a line that starts with, or says, one of the words.
fn check_named(lines: Vec[String]) -> Vec[String] {
    let words = ["needs", "after", "blocked by", "waits for", "waiting for", "depends on", "part of", "found while"]
    let mut out: Vec[String] = []
    for line in lines {
        let low = line.to_lowercase()
        let start = check_words(line.clone())
        let mut named = false
        for w in words {
            if start.starts_with(w) || (w != "after" && w != "needs" && low.contains(w)) || low.contains(f"{w} #") {
                named = true
            }
        }
        if !named { continue }
        for n in check_numbers(line.clone()) {
            if !out.contains(n.clone()) { out.push(n) }
        }
    }
    return out
}

// Whether issue N is open on GitHub (a failed call counts as not open).
fn check_open(n: String) -> bool throws {
    let got = process::run("gh", ["api", f"repos/{check_repo()}/issues/{n}", "--jq", ".state"])
    return got.ok && got.stdout.trim() == "open"
}

// The findings for issue BODY (SELF its own number, "" when unknown): one
// line per missing requirement. KNOWN says OPEN lists the open issues; else
// each `#M` is asked of GitHub.
fn check_body(body: String, own: String, known: bool, open: Vec[String]) -> Vec[String] throws {
    let lines = check_lines(body)
    let mut out: Vec[String] = []
    let (has_build, build) = check_to_build(lines.clone())
    if !has_build || build.len() == 0 { out.push("no *To build* list (docs/issues.md I9)") }
    if !check_done_when(lines.clone()) { out.push("no *Done when* (docs/issues.md I8)") }
    let named = check_named(lines)
    for m in check_numbers(check_unbracketed(build.join("\n"))) {
        if m == own || named.contains(m.clone()) { continue }
        let is_open = if known { open.contains(m.clone()) } else { check_open(m.clone()) }
        if is_open {
            out.push(f"possible missing Needs #{m}: #{m} is open and named in *To build*, but no `Needs`, `Part of` or `Found while` line names it (docs/issues.md I4)")
        }
    }
    return out
}

fn main() throws {
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    let mut body = String()
    let mut own = String()
    let mut known = false
    let mut open: Vec[String] = []
    if args.len() >= 3 && args[1] == "--body" {
        body = if args[2] == "-" { io::read_to_string() } else { fs::read_to_string(args[2].clone(), fs::Root::Anywhere) }
        if args.len() >= 4 && args[3] == "--open" {
            known = true
            for k in 4..<args.len() { open.push(args[k].clone()) }
        }
    } else if args.len() == 2 && !args[1].starts_with("-") {
        own = args[1].clone()
        let got = process::run("gh", ["api", f"repos/{check_repo()}/issues/{own}", "--jq", ".body // \"\""])
        if !got.ok {
            println(f"issue-check: cannot read issue #{own}: {got.stderr.trim()}")
            process::exit(2)
        }
        body = got.stdout
    } else {
        println("usage: nikaia run scripts/issue-check.nika -- N | --body FILE|- [--open M...]")
        process::exit(2)
    }
    let findings = check_body(body, own, known, open)
    for f in findings { println(f) }
    if findings.len() > 0 { process::exit(1) }
}
