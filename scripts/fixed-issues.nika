// The issues the commits in a range say they fix (#440).
//
// `promote` moves `main` with the workflow's own token, and a push made with it
// closes no issue: GitHub's closing keywords act on a push to the default branch,
// but not on one a workflow makes. So the job asks this program which issues the
// commits it brought to `main` close, and closes them itself.
//
//     nikaia run scripts/fixed-issues.nika -- OLD NEW
//
// prints one line per issue, `NUMBER SHA`, the first commit that names it. A
// commit names an issue with `Fixes`, `Closes` or `Resolves` (any tense, any
// case), followed by one or more `#N` joined by commas or `and`:
// `Fixes #375, #376`. `Part of #N` closes nothing.

use std::cli
use std::process
use std::text

fn fixed_is_word(b: String) -> bool {
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(b)
}

fn fixed_keyword_len(rest: String) -> i64 throws {
    let low = rest.to_lowercase()
    for kw in ["fixes", "fixed", "fix", "closes", "closed", "close", "resolves", "resolved", "resolve"] {
        if low.starts_with(kw) { return kw.len() }
    }
    return 0
}

fn fixed_skip_space(s: String, from: i64) -> i64 throws {
    let mut at = from
    while at < s.len() && " \t\n\r".contains(s.bytes[at..<at + 1].text()) { at += 1 }
    return at
}

// The issue numbers one commit message closes, in the order written.
fn fixed_in(message: String) -> Vec[i64] throws {
    let mut found: Vec[i64] = []
    for at in 0..<message.len() {
        if at > 0 && fixed_is_word(message.bytes[at - 1..<at].text()) { continue }
        let rest = message.bytes[at..<message.len()].text()
        let k = fixed_keyword_len(rest.clone())
        if k == 0 { continue }
        let mut p = at + k
        if p < message.len() && fixed_is_word(message.bytes[p..<p + 1].text()) { continue }
        if p < message.len() && message.bytes[p..<p + 1].text() == ":" { p += 1 }
        let q = fixed_skip_space(message.clone(), p)
        if q == p { continue }
        p = q
        // `#N` (`,` | `and`) `#N` ...
        while p < message.len() && message.bytes[p..<p + 1].text() == "#" {
            let mut e = p + 1
            while e < message.len() && "0123456789".contains(message.bytes[e..<e + 1].text()) { e += 1 }
            if e == p + 1 { break }
            let n = text::parse_i64(message.bytes[p + 1..<e].text()) ?? 0
            if !found.contains(n) { found.push(n) }
            let s = fixed_skip_space(message.clone(), e)
            let tail = message.bytes[s..<message.len()].text()
            if tail.starts_with(",") {
                p = fixed_skip_space(message.clone(), s + 1)
            } else if tail.to_lowercase().starts_with("and") {
                p = fixed_skip_space(message.clone(), s + 3)
            } else {
                break
            }
        }
    }
    return found
}

fn main() throws {
    let mut args: Vec[String] = []
    for a in cli::args() { args.push(a) }
    if args.len() < 3 {
        println("usage: nikaia run scripts/fixed-issues.nika -- OLD NEW")
        process::exit(2)
    }
    let range = f"{args[1]}..{args[2]}"
    let log = process::run("git", ["log", "--reverse", "--format=%H%x00%B%x01", range])
    if !log.ok { process::exit(1) }
    let mut seen: Vec[i64] = []
    for entry in log.stdout.split("\x01") {
        let parts: Vec[String] = entry.trim().split("\x00").collect()
        if parts.len() < 2 { continue }
        for n in fixed_in(parts[1].clone()) {
            if seen.contains(n) { continue }
            seen.push(n)
            println(f"{n} {parts[0]}")
        }
    }
}
