// How long a program is, in tokens, counted the same way for Rust and Nikaia.
//
// A token is an identifier or keyword, a number, a literal (a string is one, an
// `f"..."` too; a character is one), or an operator, where `::`, `->`, `==`,
// `..<`, `??`, `?.` and the like are one each. Comments and whitespace are not
// tokens; everything else is - `use` lines, attributes, a `main` that reads its
// argument. Lines are not counted: they measure the formatter as much as the
// program.
//
//     nikaia run scripts/tokens.nika -- FILE...     print each file's count

use std::cli
use std::fs

// Longest first, so `..<` is taken before `..`.
fn operators() -> Vec[String] {
    return ["..=", "..<", "::", "->", "=>", "==", "!=", "<=", ">=", "&&", "||", "..",
            "+=", "-=", "*=", "/=", "%=", "<<", ">>", "??", "?.", "|>"]
}

fn ascii_letter(c: scalar) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn word(c: scalar) -> bool {
    return c.is_alphanumeric() || c == '_'
}

fn at(c: ref Vec[scalar], i: i64) -> scalar {
    if i < c.len() { return c[i] }
    return '\0'
}

fn starts(c: ref Vec[scalar], i: i64, text: String) -> bool {
    let mut j = i
    for t in text.chars() {
        if at(c, j) != t { return false }
        j += 1
    }
    return true
}

// Where a string literal that starts at `i` ends, or -1 where none starts there:
// `"…"`, `f"…"`, `b"…"`, `r"…"` and `r#"…"#`.
fn string_end(c: ref Vec[scalar], i: i64) -> i64 {
    let mut j = i
    let mut hashes = 0
    let first = at(c, j)
    if first == 'f' || first == 'b' {
        j += 1
    } else if first == 'r' {
        j += 1
        while at(c, j) == '#' {
            hashes += 1
            j += 1
        }
    }
    if at(c, j) != '"' { return -1 }
    j += 1
    while j < c.len() {
        if c[j] == '\\' && hashes == 0 {
            j += 2
            continue
        }
        if c[j] == '"' {
            let mut k = 0
            while k < hashes && at(c, j + 1 + k) == '#' { k += 1 }
            if k == hashes { return j + 1 + hashes }
        }
        j += 1
    }
    return c.len()
}

// Where a character literal that starts at `i` ends, or -1: `'x'`, `'\n'`, `b'x'`.
fn char_end(c: ref Vec[scalar], i: i64) -> i64 {
    let mut j = i
    if at(c, j) == 'b' { j += 1 }
    if at(c, j) != '\'' { return -1 }
    j += 1
    if at(c, j) == '\\' {
        if j + 1 >= c.len() || c[j + 1] == '\n' { return -1 }
        j += 2
    } else if j < c.len() && c[j] != '\'' {
        j += 1
    } else {
        return -1
    }
    if at(c, j) != '\'' { return -1 }
    return j + 1
}

// A number: digits and `_`, a fraction, an exponent, then a suffix such as `u8`.
fn number_end(c: ref Vec[scalar], i: i64) -> i64 {
    let mut j = i + 1
    while j < c.len() && (c[j].is_ascii_digit() || c[j] == '_') { j += 1 }
    if at(c, j) == '.' && at(c, j + 1).is_ascii_digit() {
        j += 2
        while j < c.len() && (c[j].is_ascii_digit() || c[j] == '_') { j += 1 }
    }
    if at(c, j) == 'e' || at(c, j) == 'E' {
        let mut k = j + 1
        if at(c, k) == '+' || at(c, k) == '-' { k += 1 }
        if at(c, k).is_ascii_digit() {
            while k < c.len() && c[k].is_ascii_digit() { k += 1 }
            j = k
        }
    }
    while j < c.len() && word(c[j]) { j += 1 }
    return j
}

fn count_tokens(source: String) -> i64 {
    let c: Vec[scalar] = source.chars().collect()
    let ops = operators()
    let mut count = 0
    let mut i = 0
    while i < c.len() {
        let x = c[i]
        if x.is_whitespace() {
            i += 1
            continue
        }
        if starts(c, i, "//") {
            while i < c.len() && c[i] != '\n' { i += 1 }
            continue
        }
        if starts(c, i, "/*") {
            i += 2
            while i < c.len() && !starts(c, i, "*/") { i += 1 }
            i = if i < c.len() { i + 2 } else { c.len() }
            continue
        }
        count += 1
        let text = string_end(c, i)
        if text >= 0 {
            i = text
            continue
        }
        let quoted = char_end(c, i)
        if quoted >= 0 {
            i = quoted
            continue
        }
        if x == '\'' && ascii_letter(at(c, i + 1)) {
            i += 2
            while i < c.len() && word(c[i]) { i += 1 }
            continue
        }
        if ascii_letter(x) {
            i += 1
            while i < c.len() && word(c[i]) { i += 1 }
            continue
        }
        if x.is_ascii_digit() {
            i = number_end(c, i)
            continue
        }
        let mut step = 1
        for op in ops {
            if step == 1 && starts(c, i, op) { step = op.len() }
        }
        i += step
    }
    return count
}

fn main() throws {
    let mut first = true
    for path in cli::args() {
        if first {
            first = false
            continue
        }
        let source = fs::read_to_string(path, fs::Root::Anywhere)
        let n = count_tokens(source)
        let shown = f"{n}"
        println(f"{" ".repeat(6 - shown.len())}{shown}  {path}")
    }
}
