index 00000000..5a8eec69
--- /dev/null
+++ b/crates/nikaia-std/src/tools/grammar_run.nika
@@ -0,0 +1,105 @@
+// crates/nikaia-std/src/tools/grammar_run.nika
+//
+// **A grammar run's parser, built and run** (issue #178, ADR-294, #125, GR):
+// the sub-project a `comptime` grammar run compiles is written, built with
+// Cargo and run over the input, moved from `crates/nikaia/src/grammar_run.rs`.
+// What it needs from the compiler - the driver text, the manifest, the shared
+// target directory and where tools start - comes from `GrammarRunHost`; the
+// Rust `Workshop` keeps the lock that refuses a run inside a run.
+
+use std::env
+use std::fs
+use std::hash
+use std::process
+
+/// What the compiler hands a grammar run.
+pub trait GrammarRunHost {
+    /// The parser's `main.rs`: the grammar's lowering, the types it uses and
+    /// the dump. A refusal is kept by the host and handed back after the run.
+    fn driver(ref self) -> String sync throws
+    /// The sub-project's `Cargo.toml`, for the crate `p<key>`.
+    fn manifest(ref self, key: ref String, program: ref String) -> String sync
+    /// Where every grammar run's parser is compiled.
+    fn shared_target(ref self) -> fs::Path sync
+    /// The directory Cargo starts in.
+    fn where_tools_start(ref self) -> fs::Path sync
+}
+
+impl Error for CheckWall {
+    fn message(ref self) -> String {
+        return match self {
+            CheckWall::Refused { detail } => f"the parser refused the input: {detail}",
+            CheckWall::NoCrossedForm { ty, .. } => f"`{ty}` has no form to build into the program",
+            CheckWall::InsideAnother { outer } => f"a grammar run inside the run of `{outer}`",
+            CheckWall::NowhereToBuild => "no directory to compile the parser in",
+            CheckWall::DidNotBuild { detail } => f"the parser did not build: {detail}",
+            CheckWall::Unreadable { detail } => f"the parser's result could not be read: {detail}",
+        }
+    }
+}
+
+/// Compile the parser the host's driver describes under `at`, run it over
+/// `input`, and hand back what it printed, trimmed.
+pub fn grammar_run_compile_and_run[H: GrammarRunHost](host: ref H, at: ref fs::Path, input: String) -> String throws {
+    let program = host.driver() catch { throw CheckWall::NowhereToBuild }
+    // **Keyed on what went into it** — the driver text carries the
+    // grammar's lowering, the types it uses and the dump, so a digest of it
+    // is a digest of everything this sub-project is.
+    let bytes: Vec[u8] = program.bytes().collect()
+    let key = hash::sha256_hex(bytes)
+    let dir = at.join(key)
+    let source = dir.join("src").join("main.rs")
+    grammar_run_write_if_changed(source, program)
+    let manifest_path = dir.join("Cargo.toml")
+    grammar_run_write_if_changed(manifest_path, host.manifest(key, program))
+
+    // **One target directory for every parser on the machine**: what a
+    // parser depends on - `std`, `winnow`, the grammar runtime - is the
+    // same for all of them, and under each project's workshop it was
+    // compiled again for every new project (half a minute before the
+    // first grammar could run). Each parser is a crate of its own name
+    // (`p<key>`), so they share the directory without meeting.
+    let target = host.shared_target()
+    let cargo = env::var("CARGO") ?? "cargo"
+    let built = process::run(cargo, ["build", "--quiet", "--manifest-path", manifest_path.display(), "--target-dir", target.display()]; dir: host.where_tools_start().display()) catch {
+        throw CheckWall::DidNotBuild { detail: f"running cargo: {error}" }
+    }
+    if !built.ok {
+        throw CheckWall::DidNotBuild { detail: built.stderr }
+    }
+
+    // **The bytes go in a file**, because that is what a parser is pointed
+    // at and what the diagnostic's line and column are counted against.
+    let input_path = dir.join("input")
+    grammar_run_write_if_changed(input_path, input)
+
+    let binary = target.join("debug").join(f"p{key}")
+    let ran = process::run(binary.display(), [input_path.display()]) catch {
+        throw CheckWall::DidNotBuild { detail: f"running {binary.display()}: {error}" }
+    }
+    if !ran.ok {
+        throw CheckWall::Refused { detail: ran.stderr }
+    }
+    return ran.stdout.trim().clone()
+}
+
+/// **Written only when it changed**, which is what keeps Cargo's own freshness
+/// working: a file rewritten with identical bytes is newer than the fingerprint
+/// and rebuilds for ever. The build cache learned this the same way
+/// ([ADR-021](../../../docs/specification/adr/adr-021.md)).
+fn grammar_run_write_if_changed(path: ref fs::Path, text: String) throws {
+    match path.parent() {
+        null => {},
+        parent => {
+            fs::create_dir(parent, fs::Root::Anywhere; recursive: true) catch {
+                throw CheckWall::DidNotBuild { detail: f"creating {parent.display()}: {error}" }
+            }
+        },
+    }
+    if sysroot_holds(path, text) {
+        return
+    }
+    fs::write(path, fs::Root::Anywhere, text) catch {
+        throw CheckWall::DidNotBuild { detail: f"writing {path.display()}: {error}" }
+    }
+}
