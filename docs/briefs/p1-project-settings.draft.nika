use std::collections

/// `error` or `warn`, what `--refuted-claims` and `[build] refuted-claims`
/// may say ([ADR-269](../../docs/specification/adr/adr-269.md) D8).
pub fn refuted_claims(word: String) -> String throws {
    return match word {
        "error" | "warn" => word,
        other => throw anyhow!("`refuted-claims` is `error` or `warn`, not `{other}`. `error` refuses a program with_ a claim the compiler shows false with_ values; `warn` builds it and checks the claim when it runs."),
    }
}

/// `error` or `warn`, what `--unproved-claims` and `[build] unproved-claims`
/// may say ([ADR-380](../../docs/specification/adr/adr-380.md) D2).
pub fn unproved_claims(word: String) -> String throws {
    return match word {
        "error" | "warn" => word,
        other => throw anyhow!("`unproved-claims` is `error` or `warn`, not `{other}`. `error` refuses a program with_ a claim the compiler did not prove; `warn` builds it and checks the claim when it runs."),
    }
}

/// **`name:on` or `name:off` words, comma-separated**, to what they decide
/// ([ADR-306](../../docs/specification/adr/adr-306.md) D14). The names are
/// `remove-bounds-checks` and `remove-overflow-checks`
/// ([ADR-306](../../docs/specification/adr/adr-306.md) D6); a later word for
/// a name wins over an earlier one.
pub fn optimizations(words: String) -> (BoundsChecks, OverflowChecks) throws {
    let mut bounds = BoundsChecks::Kept
    let mut overflow = OverflowChecks::Kept
    for word in words.split(',').map(str::trim).filter(fn(w) { !w.is_empty() }) {
        let Some((name, level)) = word.split_once(':') else { throw anyhow!("`--optimization={word}` needs `on` or `off`: write `--optimization=remove-bounds-checks:on` or `--optimization=remove-overflow-checks:on`"); }
        match name {
            "remove-bounds-checks" => {
                bounds = BoundsChecks::parse(level) ?? throw anyhow!("`remove-bounds-checks` is `on` or `off`, not `{level}`{}", renamed(level))
            },
            // Read by `skip_free_at_exit` and `prove_through_loops`; checked
            // here with the rest.
            "skip-free-at-exit" | "prove-through-loops" => {
                if !(match level { "on" | "off" => true, else => false }) {
                    throw anyhow!("`{name}` is `on` or `off`, not `{level}`")
                }
            },
            "remove-overflow-checks" => {
                overflow = OverflowChecks::parse(level) ?? throw anyhow!("`remove-overflow-checks` is `on` or `off`, not `{level}`{}", renamed(level))
            },
            else => throw anyhow!("there is no optimization called `{name}`: the ones there are, are `remove-bounds-checks`, `remove-overflow-checks`, `prove-through-loops` and `skip-free-at-exit`"),
        }
    }
    return (bounds, overflow)
}

/// **`prove-through-loops:on`**
/// ([ADR-361](../../docs/specification/adr/adr-361.md) D10): an index's, an
/// overflow's or a shift's check a loop leaves open is asked once more through
/// the loop's invariant. The last word for the name wins; [`optimizations`]
/// has already refused a word that is not `on` or `off`.
pub fn prove_through_loops(words: String) -> bool {
    return (match words.split(',').map(str::trim).filter_map(fn(w) { w.strip_prefix("prove-through-loops:") }).next_back() { level => level == "on", null => false })
}

/// **`skip-free-at-exit:on`**
/// ([ADR-348](../../docs/specification/adr/adr-348.md) D1): what `main` still
/// holds at its end dies, and every cleanup runs, but its memory is left to the
/// operating system. The last word for the name wins; [`optimizations`] has
/// already refused a word that is not `on` or `off`.
pub fn skip_free_at_exit(words: String) -> bool {
    return (match words.split(',').map(str::trim).filter_map(fn(w) { w.strip_prefix("skip-free-at-exit:") }).next_back() { level => level == "on", null => false })
}

/// **The words before ADR-306 D14**: `basic` and `aggressive` were levels of
/// how hard the compiler proved and whether it dropped what it proved, in one
/// word. What is proved no longer depends on the option, so the old words name
/// the one thing they still mean.
fn renamed(level: String) -> String {
    return match level {
        "aggressive" | "basic" => ". The compiler now proves the same at every build, and the option only says whether a proved check is written without it: `aggressive` and `basic` are `on`",
        else => "",
    }
}

/// `[build] artifact` (ADR-284 D4): a program, or a library C calls.
pub fn artifact(word: String) -> String throws {
    return match word {
        "program" | "c-library" => word,
        other => throw anyhow!("`artifact` is `program` or `c-library`, not `{other}`. `c-library` makes a shared and a static library of the package, and its header, from every `pub extern fn` with_ a body."),
    }
}

/// What Cargo is told for the CPU level: `-C target-cpu` for every crate
/// built for the target, the program's and `std`'s, through Cargo's own
/// configuration rather than the user's `RUSTFLAGS` (ADR-002 D6, ADR-325).
pub fn cpu_config(state: ref CheckState) -> Vec[String] sync {
    let given = state.cpu ?? return []
    return match given {
        level => [f"target.\"{state.build.target.triple()}\".rustflags=[\"-C\", \"target-cpu={level}\"]"],
    }
}

/// The cache's view of this build (ADR-021 D5).
///
/// The backend is `"rust"` because it names **the lowering that produced the
/// artifact**, not the flag the user typed, and a bare invocation *is*
/// `--backend rust` ([ADR-004](../../docs/specification/adr/adr-004.md) D1),
/// so the two spellings share one entry - which is correct, because it is
/// one lowering. The dimension itself stays in
/// [`orchestrator::cache::Key::build`] (D5, D7) so that the day a second
/// backend caches, the literal here becomes that backend's name and the two
/// cannot collide.
pub fn choices(state: ref CheckState) -> Choices sync {
            // A build that lets a refuted claim through must not hand its
            // lowering to one that refuses it.
            // The same for a claim not proved (ADR-380 D2).
            // A library's lowering carries its entry points' wrappers,
            // named by the prefix.
    // TODO(rs2nika): `format!` with fewer arguments than holes: `{?}` is a missing one
    let hole_106 = if state.tests { "/tests" } else { "" }
    let hole_107 = if state.refuted_claims == "warn" { "/refuted-claims:warn" } else { "" }
    let hole_108 = if state.unproved_claims == "warn" { "/unproved-claims:warn" } else { "" }
    let hole_109 = match state.build.bounds { BoundsChecks::Kept => "", level => f"/remove-bounds-checks:{level.name()}" }
    let hole_110 = match state.build.overflow { OverflowChecks::Kept => "", level => f"/remove-overflow-checks:{level.name()}" }
    let hole_111 = match state.build.skip_free_at_exit { true => "/skip-free-at-exit:on", false => "" }
    let hole_112 = match state.build.prove_through_loops { true => "/prove-through-loops:on", false => "" }
    let hole_113 = match state.library() { true => f"/c-library:{state.symbol_prefix}", false => ""
    Choices::new(f"{state.target}/{state.user_parallelism}/{state.reentrancy_check}{hole_106}{hole_107}{hole_108}{hole_109}{hole_110}{hole_111}{hole_112}{hole_113}{?}"
            },
            // A `comptime` that reads `target::has` answers for the level
            // (ADR-371 D6), so the lowering is kept per level.
            if state.cpu != null {
                f"/cpu:{state.cpu_key().unwrap_or_default()}"
            } else {
                ""
            }
        ),
        "rust",
    return )
}

/// What a panic does on this machine (ADR-037 D1), in Cargo's vocabulary.
///
/// Not a choice, which is why it is not in the codegen table: WebAssembly
/// traps and has no stack to unwind, and a build that asked for `unwind`
/// there would be asking for something the machine does not have.
fn panic_strategy(state: ref CheckState) -> String sync {
    return match state.build.target {
        Target::X86_64Linux | Target::Aarch64Linux => "unwind",
        Target::Wasm32Unknown => "abort",
        target @ Target::Rust(_) => {
            if target.is_bare_metal() || target.triple().starts_with("wasm") {
                "abort"
            } else {
                "unwind"
            }
        },
    }
}

