 use winnow_grammar::testing::WinnowTestExt;
+use winnow_grammar::{grammar, ParseContext};
 
 grammar! {
     grammar Cut {
@@ -135,3 +137,47 @@ fn a_cut_reaches_past_the_rule_it_is_written_in() {
     // second alternative is never tried.
     Reach::parse_caller().parse_test("k?").assert_failure();
 }
+
+// -----------------------------------------------------------------------------
+// A cut leaving the element of a repetition is numbered as a backtrack leaving
+// it is: the `item N` frame says which element failed either way.
+// -----------------------------------------------------------------------------
+
+grammar! {
+    grammar Numbered {
+        pub list -> () = "[" item ("," item)* "]" -> { () }
+        rule item -> () = "{" => digit+ "}" -> { () }
+
+        pub pairs -> usize = xs:("a" => "b")* "c" -> { xs.len() }
+    }
+}
+
+macro_rules! rule_stack {
+    ($parser:expr, $src:expr) => {{
+        let mut s = Stateful {
+            state: ParseContext::<()>::default(),
+            input: LocatingSlice::new($src),
+        };
+        $parser.parse_next(&mut s).unwrap_err().rule_stack.clone()
+    }};
+}
+
+#[test]
+fn a_cut_leaving_a_repetition_element_keeps_its_number() {
+    // The third `item` is the second element of `("," item)*`.
+    let stack = rule_stack!(Numbered::parse_list(), "[{1},{2},{x}]");
+    let at = stack.iter().position(|r| r == "item");
+    assert_eq!(
+        at.map(|i| stack[i + 1].as_str()),
+        Some("item 2"),
+        "{stack:?}"
+    );
+
+    // The first `item` stands outside the repetition: no frame from it
+    // between `item` and `list` (the `item 1` below `item` is `digit+`'s).
+    let stack = rule_stack!(Numbered::parse_list(), "[{x}]");
+    assert_eq!(stack, vec!["item 1", "item", "list"]);
+
+    let stack = rule_stack!(Numbered::parse_pairs(), "ababac");
+    assert!(stack.iter().any(|r| r == "item 3"), "{stack:?}");
+}
