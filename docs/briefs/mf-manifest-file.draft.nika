use std::collections
use std::fs

/// Where a `nikaia.toml` was found, and what it said.
///
/// Absent outside a project, which is not an error: a single `.nika` file
/// compiles with the built-in defaults and the flags, and littering a manifest
/// into someone's directory to make that work would be the wrong trade.
pub struct Manifest {
    build: collections::BTreeMap[String, String],
    package: collections::BTreeMap[String, toml::Value],
    dependencies: collections::BTreeMap[String, ManifestDependency],
    /// `[build.<target>]` - `opt-level` and `lto`, per machine (Part III 13.3).
    codegen: collections::BTreeMap[String, collections::BTreeMap[String, toml::Value]],
    /// `[library.<name>]`: each system library an `extern(library: …)` block
    /// names, with the `pkg-config` name it is found by (Part III 13.4,
    /// [ADR-324](../../../docs/specification/adr/adr-324.md) D2, D3).
    libraries: collections::BTreeMap[String, String],
    /// What this manifest carries that the compiler no longer reads, and where
    /// it went. Printed once per build rather than returned as an error:
    /// failing a manifest somebody already wrote to the specification would
    /// punish them for the move ([ADR-303](../../../docs/specification/adr/adr-303.md) D5).
    notes: Vec[String],
    /// The directory the manifest was found in, and therefore the project root.
    /// `None` when there was no manifest at all.
    root: fs::Path?,
}

/// One entry of `[dependencies]`, and which of the three shapes it is.
///
/// The distinction is the whole of the translation: a native Rust crate is
/// passed to Cargo exactly as written (ADR-002 D1), a Nikaia package **by path**
/// is read as part of this program
/// ([ADR-286](../../../docs/specification/adr/adr-286.md) D15), and a Nikaia
/// package named any other way is something nothing has decided yet.
pub enum ManifestDependency {
    /// `regex = { type = "rust", version = "1.5" }` - the value with `type`
    /// removed, which is what Cargo is handed.
    Rust(toml::Value),
    /// `http = { path = "../http" }` - a Nikaia package, where it is.
    ///
    /// **The key is the name** a `use` writes, and the path says only where it
    /// comes from (ADR-286 D15 rule 1): two libraries that both want to be `http`
    /// are the consumer's to name apart, which is the authority
    /// [ADR-286](../../../docs/specification/adr/adr-286.md) D12 gives them anyway.
    /// Relative to the manifest's own directory, because that is the only
    /// interpretation that survives the project being checked out somewhere else.
    Path(fs::Path),
    /// `http-server = "1.2"`. Carried rather than resolved: a registry, a version
    /// grammar and a distribution format are the three things ADR-002 D1 §5
    /// refuses to guess at, and ADR-286 D15 keeps refusing.
    Nikaia(toml::Value),
}

/// A refusal from `tools/manifest.nika`, in the words it gave.
pub fn manifest_refusal(thrown: nikaia_std::error::Thrown[Refused]) -> anyhow::Error {
    return Refused::Because(f"{thrown}")
}

impl Manifest {
    /// Read the manifest governing `input`, if there is one.
    ///
    /// The search is the one the build cache already does - `Layout::resolve`
    /// walks to the nearest `nikaia.toml` at or above the input's directory -
    /// so a file cannot be cached as part of one project and compiled with
    /// another's switches. One root-finder, deliberately.
    pub fn find(input: ref fs::Path) -> Manifest throws {
        let layout = orchestrator::cache::Layout::resolve(input)
        if !layout.in_project {
            return Manifest { build: collections::BTreeMap(), package: collections::BTreeMap(), dependencies: collections::BTreeMap(), codegen: collections::BTreeMap(), libraries: collections::BTreeMap(), notes: [], root: null }
        }
        return Manifest::read(layout.root.join("nikaia.toml"))
    }

    /// Read a manifest at a known path. The project build already knows where
    /// the root is, and searching again from there could only find a different
    /// answer.
    pub fn read(path: ref fs::Path) -> Manifest throws {
        let text = fs::read_to_string(path, fs::Root::Anywhere)
        let mut manifest = Manifest::parse(text).with_context(fn() { f"in {path.display()}" }).map_err(fn(e) { Refused::Because(f"{e:#}") })
        manifest.root = path.parent().map(Path::to_path_buf)
        return manifest
    }

    /// Whether this manifest says anything about how to build.
    ///
    /// What it is for is a **dependency's** `[build]`, which is ignored:
    /// a package is built with the settings of the program that uses it
    /// ([ADR-286](../../../docs/specification/adr/adr-286.md) D15 rule 4), and
    /// anything else would put two answers to the parallelism question in one
    /// build. Ignored **and said**, which is why there is a question to ask.
    pub fn has_build_section(ref self) -> bool {
        return !self.build.is_empty() || !self.codegen.is_empty()
    }

    /// `[package]`, `[dependencies]`, `[build]` and the `[build.<target>]`
    /// codegen tables.
    pub fn parse(text: String) -> Manifest throws {
        let document: toml::Value = toml::from_str(text).context("this is not valid TOML")

        let mut manifest = Manifest { build: collections::BTreeMap(), package: collections::BTreeMap(), dependencies: collections::BTreeMap(), codegen: collections::BTreeMap(), libraries: collections::BTreeMap(), notes: [], root: null } with {
            package: manifest_table_of(document, "package"),
            dependencies: manifest_dependencies(document),
            libraries: manifest_libraries(document),
        }

        let table = document.get("build").and_then(toml::Value::as_table) ?? return manifest

        let mut build = collections::BTreeMap()
        for (key, value) in table {
            match value.as_table() {
                sub => {
                    manifest.codegen.insert(key.clone(), manifest_codegen(key, sub))
                    continue
                },
                null => {}
            }
            match decide::build_key(key).map_err(manifest_refusal) {
                decide::Switch::Moved(note) => {
                    manifest.notes.push(note)
                    // Not carried into `build`: a key nothing reads must not be
                    // reachable through `setting`, or a later reader would resolve
                    // it from the wrong file.
                    continue
                },
                else => {},
            }
            // Every switch is a word, so a bare `no` (TOML's boolean) or a
            // count is the plausible mistake. Reporting the type here would
            // hide the *reason* - `Build::parse` explains why a count is not a
            // count - so the value is stringified and passed on to the
            // parser that owns the setting.
            let word = match value {
                toml::Value::String(word) => word.clone(),
                other => other.to_string(),
            }
            build.insert(key.clone(), word)
        }
        manifest.build = build
        return manifest
    }

    /// The project root - the directory the manifest sits in.
    pub fn root(root: fs::Path?) -> fs::Path? {
        return root
    }

    /// What this manifest says that the compiler no longer reads, and where it
    /// went. One line each, for a build to print once.
    pub fn notes(notes: ref Vec[String]) -> Vec[String] {
        return notes
    }

    /// `[package] name`, which becomes the Cargo package and the binary's name.
    pub fn package_name(package: ref collections::BTreeMap[String, toml::Value]) -> String? {
        return package.get("name").and_then(toml::Value::as_str)
    }

    /// `[package] version`. Cargo requires one, so a project that does not say
    /// gets `0.0.0` - a version nobody typed, rather than a guess at one they
    /// meant.
    pub fn package_version(package: ref collections::BTreeMap[String, toml::Value]) -> String {
        return (package.get("version").and_then(toml::Value::as_str) ?? "0.0.0")
    }

    /// Everything `[dependencies]` declared, in the order Cargo will see it.
    pub fn dependencies(dependencies: ref collections::BTreeMap[String, ManifestDependency]) -> collections::BTreeMap[String, ManifestDependency] {
        return dependencies
    }

    /// **The Rust crates this build declares**, under the name a program writes
    /// ([ADR-290](../../../docs/specification/adr/adr-290.md) D1).
    ///
    /// `hyper-shim = { type = "rust", … }` is written `hyper_shim::serve_once`
    /// in a program, because that is the crate name Cargo makes of the key and
    /// the name the generated Rust carries. The manifest key is what a person
    /// types and the underscore form is what a call names, so the translation
    /// belongs here rather than at every reader.
    ///
    /// **Only `type = "rust"`.** A Nikaia package by path is read as part of
    /// this program and has a ledger of its own; what this names is the set at
    /// whose edge D1's question is asked.
    pub fn foreign_crates(dependencies: ref collections::BTreeMap[String, ManifestDependency]) -> collections::BTreeSet[String] {
        return dependencies.iter().filter(fn((_, declared)) { match declared { ManifestDependency::Rust(_) => true, else => false } }).map(fn((name, _)) { decide::crate_name(name) }).collect()
    }

    /// `[library.<name>]`: each library's name and its `pkg-config` name
    /// (ADR-324 D2).
    pub fn libraries(libraries: ref collections::BTreeMap[String, String]) -> collections::BTreeMap[String, String] {
        return libraries
    }

    /// The codegen table for one machine, empty where the manifest is silent.
    pub fn codegen_for(codegen: ref collections::BTreeMap[String, collections::BTreeMap[String, toml::Value]], target: String) -> collections::BTreeMap[String, toml::Value] {
        return codegen.get(target)?.clone().unwrap_or_default() /* TODO(rs2nika): `unwrap_or_default` (write the default: `?? 0`, `?? ""`, `?? []`) */
    }

    /// The effective value: the flag if one was given, else the manifest, else
    /// the built-in default.
    ///
    /// The order is the whole of D5. A flag that the manifest could override
    /// would make `--target` useless for the one build it exists for, and a
    /// manifest that the built-in default could override would make a
    /// committed switch a suggestion.
    pub fn setting(ref self, key: String, flag: String?, default: String) -> String {
        return ((flag ?? self.build.get(key).map(String::as_str)) ?? default)
    }
}

/// A top-level table of the manifest, as a map. Absent is empty, because a
/// manifest without `[package]` is a manifest that only set switches.
fn manifest_table_of(document: ref toml::Value, name: String) -> collections::BTreeMap[String, toml::Value] {
    return (match document.get(name).and_then(toml::Value::as_table) { table => table.iter().map(fn((k, v)) { (k.clone(), v.clone()) }).collect(), null => null }).unwrap_or_default() /* TODO(rs2nika): `unwrap_or_default` (write the default: `?? 0`, `?? ""`, `?? []`) */
}

/// `[library.<name>]`, checked: a table per library with `pkg-config` and
/// nothing else, because the compiler forms every argument itself (ADR-324 D3,
/// D4) and a key it does not read would be one somebody thought it did.
fn manifest_libraries(document: ref toml::Value) -> collections::BTreeMap[String, String] throws {
    let mut out: collections::BTreeMap[String, String] = collections::BTreeMap()
    let section = document.get("library") ?? return out
    let table = section.as_table() ?? throw Refused::Because("`library` is a table of libraries: `[library.<name>]` with `pkg-config = \"<name>\"`.")
    for (name, entry) in table {
        let entry = entry.as_table() ?? throw Refused::Because(f"`library.{name}` is a table: `[library.{name}]` with `pkg-config = \"{name}\"`.")
        for key in entry.keys() {
            if key != "pkg-config" {
                throw Refused::Because(f"`[library.{name}]` takes `pkg-config` and nothing else, not `{key}`: the compiler forms the linker's arguments itself (Part III 13.4).")
            }
        }
        let found_by = entry.get("pkg-config").and_then(toml::Value::as_str) ?? throw Refused::Because(f"`[library.{name}]` needs `pkg-config = \"<name>\"`: a library is found only through `pkg-config` (Part III 13.4).")
        out.insert(name.clone(), found_by.to_string())
    }
    return out
}

/// `[build.<target>]`, checked.
fn manifest_codegen(target: String, table: ref toml::Table) -> collections::BTreeMap[String, toml::Value] throws {
    // Any target `--target` takes may have a table (ADR-037 D9); the refusal
    // for one that is none of them is `std`'s.
    if Target::parse(target).is_err() {
        decide::codegen_table(target).map_err(manifest_refusal)
    }
    let mut out: collections::BTreeMap[String, toml::Value] = collections::BTreeMap()
    for (key, value) in table {
        decide::codegen_key(target, key).map_err(manifest_refusal)
        if key == "codegen-units" {
            decide::codegen_units(target, value.as_integer(), value.to_string()).map_err(manifest_refusal)
        }
        out.insert(key.clone(), value.clone())
    }
    return out
}

/// `[dependencies]`, split into the two shapes 13.3 shows.
///
/// `type = "rust"` is the marker, and it is removed on the way through: it is
/// Nikaia's word about which ecosystem the name belongs to, and Cargo would
/// reject it as an unknown key.
fn manifest_dependencies(document: ref toml::Value) -> collections::BTreeMap[String, ManifestDependency] throws {
    let mut out: collections::BTreeMap[String, ManifestDependency] = collections::BTreeMap()
    for (name, value) in manifest_table_of(document, "dependencies") {
        let kind = (match value.get("type") { kind => match kind {
            toml::Value::String(word) => word.clone(),
            other => other.to_string(),
        }, null => null })
        let path = value.get("path").and_then(toml::Value::as_str)
        let shape = decide::dependency(name, kind != null, (kind ?? ""), path != null).map_err(manifest_refusal)
        let declared = match (shape, path) {
            (decide::DependencyShape::Rust, _) => {
                let mut table = (value.as_table()?.clone() ?? panic("a value with a `type` key is a table"))
                table.remove("type")
                ManifestDependency::Rust(toml::Value::Table(table))
            },
            (decide::DependencyShape::Path, path) => ManifestDependency::Path(PathBuf::from(path)),
            else => ManifestDependency::Nikaia(value.clone()),
        }
        out.insert(name, declared)
    }
    return out
}
