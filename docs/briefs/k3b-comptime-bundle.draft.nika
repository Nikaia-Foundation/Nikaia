use std::collections
use std::fs

/// **The dynamic library build-time code links against** (D3): one crate that
/// names `std` and the grammar runtime a program's `grammar` lowers to, built
/// by Cargo from the same compiled dependencies as anything else in the
/// workshop.
pub struct Bundle {
    /// The library itself.
    pub dylib: fs::Path,
    /// Each crate it names, as Cargo compiled it, which `rustc` is pointed at
    /// so that a path `nikaia_std::…` resolves in every module; the code is
    /// the library's.
    pub rlibs: Vec[(String, fs::Path)],
    /// Where the libraries it was built from are.
    pub deps: fs::Path,
    /// What changes when the library is rebuilt: part of every key.
    pub stamp: String,
    /// Where the toolchain's own `std` is, which a program linked with
    /// `prefer-dynamic` loads - and beside which the toolchain's `rustc` is.
    pub libdir: fs::Path,
}

/// **What a bundle is built for.** Build-time code counts what it allocates
/// against its bound (D10); a program `nikaia run` compiles against the
/// bundle ([`crate::run_fast`]) means what its Cargo build means, so its
/// bundle has no counting allocator and the profile the generated workspace
/// gives a dependency: no overflow checks, no debug assertions, no debug
/// information, unwinding.
pub enum Flavour {
    BuildTime,
    Run,
}

/// The run bundle's one file: the crates, named, and nothing else.
comptime COMPTIME_BUNDLE_RUN_SOURCE: ref String = "// GENERATED: the library `nikaia run` links a program against.
pub extern crate nikaia_std;
pub extern crate winnow;
pub extern crate winnow_grammar;
"

/// The run bundle's profile: what `[profile.dev]` of a generated workspace
/// says about a crate that is not the program's.
comptime COMPTIME_BUNDLE_RUN_PROFILE: ref String = "
[profile.dev]
overflow-checks = false
debug-assertions = false
debug = 0
panic = \"unwind\"
"

/// The crates the bundle names: `std`, and what a `grammar` lowers to.
comptime COMPTIME_BUNDLE_NAMED: Array[String, 3 /* TODO(rs2nika): an expression */] = ["nikaia_std", "winnow", "winnow_grammar"]

/// Build the bundle, or say why it could not be built.
///
/// **Once per machine, not per project**: what it is depends on its manifest
/// (where `std` comes from), its one file and the toolchain, never on the
/// program - so it lives under the user cache, keyed by the first two, as the
/// compiled `std` of ADR-002 D4 does. Under each project's own workshop it was
/// built again for every new project, some forty crates (half a minute) before
/// the first `comptime` could run. Cargo's lock on the target directory is what
/// makes two builds at once wait for one another rather than collide.
pub fn comptime_bundle_bundle[H: ComptimeBundleHost](_workshop: ref fs::Path, host: ref H) -> Bundle throws {
    return comptime_bundle_bundle_of(Flavour::BuildTime, host)
}

/// **The bundle `nikaia run` links a program against**, built once and then
/// found from its record without starting Cargo: Cargo's start and freshness
/// check is most of what a fast run saves. The record is trusted while this
/// compiler, the toolchain and `std`'s sources are what they were when it was
/// written, and every file it names is still there.
pub fn comptime_bundle_run_bundle[H: ComptimeBundleHost](host: ref H) -> Bundle throws {
    let (manifest, source) = comptime_bundle_bundle_text(Flavour::Run)
    let at = comptime_bundle_bundle_dir(Flavour::Run, manifest, source)
    let record = at.join("built")
    let fingerprint = comptime_bundle_run_fingerprint(host)
    match fs::read_to_string(record, fs::Root::Anywhere).ok().and_then(fn(text) { comptime_bundle_read_record(text, fingerprint) }) {
        bundle => {
            return bundle
        },
        null => {}
    }
    let bundle = comptime_bundle_bundle_of(Flavour::Run, host)
    let mut text = f"{fingerprint}\n{comptime_bundle_bundle.dylib.display()}\n{comptime_bundle_bundle.deps.display()}\n{comptime_bundle_bundle.libdir.display()}\n"
    for (name, rlib) in bundle.rlibs {
        text.push_str(f"{name}={rlib.display()}\n")
    }
    comptime_bundle_write_if_changed(record, text)
    return bundle
}

/// What the run bundle's record is valid for: this compiler, the toolchain
/// and the newest of `std`'s sources (a `std` edited under a development
/// checkout is built again, as Cargo would).
fn comptime_bundle_run_fingerprint[H: ComptimeBundleHost](host: ref H) -> String {
    let mut newest = (0 as u128)
    let mut count = 0
    let mut pending = [Sysroot::resolve().std_dir()]
    while true {
        let dir = pending.pop() ?? break
        let entries = fs::read_dir(dir) catch { continue }
        for entry in entries.flatten() {
            let path = entry.path()
            if (match path.file_name() { null => false, n => n == "target" || n == "tests" }) {
                continue
            }
            let meta = entry.metadata() catch { continue }
            if modules_is_dir(meta) {
                pending.push(path)
                continue
            }
            count += 1
            let modified = meta.modified().ok().and_then(fn(t) { t.duration_since(time::UNIX_EPOCH).ok() }).map(fn(d) { d.as_nanos() }).unwrap_or_default() /* TODO(rs2nika): `unwrap_or_default` (write the default: `?? 0`, `?? ""`, `?? []`) */
            newest = newest.max(modified)
        }
    }
    let hole_1 = rs2nika_env("NIKAIA_COMPILER") /* TODO(rs2nika): the macro `env!`: `env!("NIKAIA_COMPILER")` */
    return digest(f"{hole_1}\n{orchestrator::project::rustc_version()}\n{comptime_bundle_rustc(host)}\n{newest}:{count}".bytes)
}

/// The bundle a record names, where it is still the one it names.
fn comptime_bundle_read_record(text: String, fingerprint: String) -> Bundle? {
    let mut lines = text.lines()
    if (lines.next() ?? return null) != fingerprint {
        return null
    }
    let dylib = PathBuf::from((lines.next() ?? return null))
    let deps = PathBuf::from((lines.next() ?? return null))
    let libdir = PathBuf::from((lines.next() ?? return null))
    let rlibs: Vec[(String, fs::Path)] = lines.filter_map(fn(line) { line.split_once("=") }).map(fn((name, rlib)) { (name.to_string(), PathBuf::from(rlib)) }).collect()
    if rlibs.len() != COMPTIME_BUNDLE_NAMED.len() {
        return null
    }
    let stamp = (comptime_bundle_stamp_of(dylib, rlibs).ok() ?? return null)
    return Bundle { dylib: dylib, rlibs: rlibs, deps: deps, stamp: stamp, libdir: libdir }
}

/// A bundle's manifest and its one file.
fn comptime_bundle_bundle_text(flavour: Flavour) -> (String, String) {
    let mut manifest = cr_bundle_manifest(runtime_dependencies_for(COMPTIME_BUNDLE_NAMED.join(" ")))
    let source = match flavour {
        Flavour::BuildTime => cr_bundle_source(),
        Flavour::Run => {
            manifest.push_str(COMPTIME_BUNDLE_RUN_PROFILE)
            COMPTIME_BUNDLE_RUN_SOURCE.to_string()
        },
    }
    return (manifest, source)
}

/// Where a bundle lives: the user cache, keyed by its manifest and its file.
fn comptime_bundle_bundle_dir(flavour: Flavour, manifest: String, source: String) -> fs::Path {
    let key = orchestrator::cache::sha256_hex(f"{manifest}\n{source}".bytes)
    return orchestrator::cache::Layout::user_cache_dir().join(match flavour {
        Flavour::BuildTime => "build-time-bundle",
        Flavour::Run => "run-bundle",
    }).join(key[..<16])
}

/// The library and the crates it names, and when each was last built.
fn comptime_bundle_stamp_of(dylib: ref fs::Path, rlibs: ref Vec[(String, fs::Path)]) -> String throws {
    return once(dylib).chain(rlibs.iter().map(fn(pair) { pair.1 })).map(fn(file) {
        let meta = fs::metadata(file, fs::Root::Anywhere).map_err(fn(e) { f"{file.display()}: {e}" })
        let modified = meta.modified().ok().and_then(fn(t) { t.duration_since(time::UNIX_EPOCH).ok() }).map(fn(d) { d.as_nanos() }).unwrap_or_default() /* TODO(rs2nika): `unwrap_or_default` (write the default: `?? 0`, `?? ""`, `?? []`) */
        return f"{file.display()}:{meta.len()}:{modified}"
    }).collect().join("\n")
}

fn comptime_bundle_bundle_of[H: ComptimeBundleHost](flavour: Flavour, host: ref H) -> Bundle throws {
    let (manifest, bundle_source) = comptime_bundle_bundle_text(flavour)
    let at = comptime_bundle_bundle_dir(flavour, manifest, bundle_source)
    orchestrator::cache::use_entry(at)
    let dir = at.join("bundle")
    fs::create_dir(dir.join("src"), fs::Root::Anywhere; recursive: true).map_err(fn(e) { f"{dir.display()}: {e}" })
    comptime_bundle_write_if_changed(dir.join("Cargo.toml"), manifest)
    comptime_bundle_write_if_changed(dir.join("src").join("lib.rs"), bundle_source)
    let built = Command::new(comptime_bundle_cargo(host)).current_dir(orchestrator::cache::Layout::where_tools_start()).args(["rustc", "--quiet", "--lib", "--crate-type", "dylib"]).arg("--message-format=json").arg("--manifest-path").arg(dir.join("Cargo.toml")).arg("--target-dir").arg(at.join("target")).args(["--", "-C", "prefer-dynamic"]).output().map_err(fn(e) { f"running cargo: {e}" })
    if !built.status.success() {
        throw (built.stderr.text() catch { "" }).to_string()
    }
    let mut dylib = null
    let mut rlibs: Vec[(String, fs::Path)] = []
    for line in (built.stdout.text() catch { "" }).lines() {
        let message = serde_json::from_str(line) catch { continue }
        if message["reason"] != "compiler-artifact" {
            continue
        }
        let files = message["filenames"].as_array()?.clone().unwrap_or_default() /* TODO(rs2nika): `unwrap_or_default` (write the default: `?? 0`, `?? ""`, `?? []`) */
        let files = files.iter().filter_map(fn(f) { f }).map(PathBuf::from)
        match message["target"]["name"] {
            name if COMPTIME_BUNDLE_NAMED.contains(name) => {
                match files.clone().find(fn(f) { match f.extension() { null => false, e => e == "rlib" } }) {
                    rlib => {
                        rlibs.push((name.to_string(), rlib))
                    },
                    null => {}
                }
            },
            "nikaia_bundle" => {
                dylib = files.clone().find(fn(f) {
                    return (match f.extension() { null => false, e => e == env::consts::DLL_EXTENSION })
                })
            },
            null => {}
            else => {},
        }
    }
    let dylib = match (dylib, rlibs.len() == COMPTIME_BUNDLE_NAMED.len()) {
        (dylib, true) => dylib
        else => throw "cargo built the bundle and named no library",
    }
    let deps = (rlibs[0].1.parent().map(Path::to_path_buf) ?? throw "no directory for std")
    let stamp = comptime_bundle_stamp_of(dylib, rlibs)
    return Bundle { dylib: dylib, rlibs: rlibs, deps: deps, stamp: stamp, libdir: PathBuf::from(target_libdir()) }
}

/// **The CPU level this process builds for** (ADR-371 D6), as
/// `Settings::cpu_key` resolves it: empty for the baseline, `native=...` for
/// this machine. Set by the lowering before it checks a program.
// TODO(rs2nika): a `static` (a `comptime` if it is constant; Nikaia has no global state)
// /// **The CPU level this process builds for** (ADR-371 D6), as
// /// `Settings::cpu_key` resolves it: empty for the baseline, `native=...` for
// /// this machine. Set by the lowering before it checks a program.
// static COMPTIME_BUNDLE_CPU_LEVEL: std::sync::Mutex<String> = std::sync::Mutex::new(String::new());

/// The lowering that follows builds for the CPU level `key`.
pub fn comptime_bundle_build_for_cpu(key: String) {
    match COMPTIME_BUNDLE_CPU_LEVEL.lock() catch { null } {
        held => {
            // TODO(rs2nika): a write through a match binding (ADR-094 D7, #576): rebuild the value and put it back (R262)
            held = key
        },
        null => {},
    }
}

/// **Compile and run one build-time program**, or hand back what it said when
/// it ran before: its standard output, or `Wall::Refused` with what it wrote
/// where it stopped. Keyed on the program, the toolchain and the bundle (D4).
pub fn comptime_bundle_run[H: ComptimeBundleHost](at: ref fs::Path, bundle: ref Bundle, program: String, name: String, host: ref H) -> String throws {
    // **A program that asks `target::has` answers for the build's level**
    // (ADR-371 D6): the level is in its key and handed to it; one that does
    // not keeps one answer for every level.
    let level = match program.contains("target::has") {
        true => COMPTIME_BUNDLE_CPU_LEVEL.lock().map(fn(held) { held.clone() }).unwrap_or_default() /* TODO(rs2nika): `unwrap_or_default` (write the default: `?? 0`, `?? ""`, `?? []`) */,
        false => "",
    }
    let key = digest(f"{program}\n{toolchain()}\n{comptime_bundle_bundle.stamp}\n{level}".bytes)
    // What the run reads: the level's name, `native` for this machine's.
    let named = match level.starts_with("native=") {
        true => "native",
        false => level,
    }
    let dir = at.join("comptime").join(key)
    let answered = dir.join("answer")
    let stopped = dir.join("stopped")
    match fs::read_to_string(answered, fs::Root::Anywhere) catch { null } {
        answer => {
            return answer
        },
        null => {},
    }
    match fs::read_to_string(stopped, fs::Root::Anywhere) catch { null } {
        said => throw Wall::Refused { detail: said },
        null => {},
    }
    let did_not = fn(detail) { Wall::DidNotBuild { detail } }
    // **A program that did not compile is not compiled again** in this
    // process: the same text fails the same way, and a check asks for one
    // value many times over (each test, each variant).
    match COMPTIME_BUNDLE_NOT_BUILT.lock().ok().and_then(fn(held) { held.get(key)?.clone() }) {
        detail => throw did_not(detail),
        null => {}
    }
    let source = dir.join("main.rs")
    comptime_bundle_write_if_changed(source, program).map_err(did_not)
    // **Each build compiles and runs its own binary, in a directory of its
    // own**, moved into place after: `rustc` names its object files after the
    // crate, so two builds of the same program side by side wrote, linked and
    // deleted each other's.
    let scratch = unique_beside(dir.join("build"))
    fs::create_dir(scratch, fs::Root::Anywhere; recursive: true).map_err(fn(e) { did_not(f"{scratch.display()}: {e}") })
    let binary = scratch.join("run")
    let compiled = Command::new(comptime_bundle_rustc(host)).current_dir(orchestrator::cache::Layout::where_tools_start()).args(["--edition=2024", "--crate-name", "comptime", "--crate-type", "bin"]).args(["-C", "opt-level=0", "-C", "overflow-checks=on"]).args(["-C", "debug-assertions=off", "-C", "prefer-dynamic", "-A", "warnings"]).arg("--extern").arg(f"nikaia_bundle={comptime_bundle_bundle.dylib.display()}").args(bundle.rlibs.iter().flat_map(fn((name, rlib)) {
        return ["--extern", f"{name}={rlib.display()}"]
    })).arg("-L").arg(f"dependency={comptime_bundle_bundle.deps.display()}").arg("-o").arg(binary).arg(source).output().map_err(fn(e) { did_not(f"running rustc: {e}") })
    if !compiled.status.success() {
        fs::remove(scratch, fs::Root::Anywhere; recursive: true) catch {}
        let detail = (compiled.stderr.text() catch { "" }).to_string()
        match COMPTIME_BUNDLE_NOT_BUILT.lock() catch { null } {
            held => {
                held.insert(key, detail.clone())
            },
            null => {},
        }
        throw did_not(detail)
    }
    let mut libraries: Vec[fs::Path] = []
    match bundle.dylib.parent() {
        dir => {
            libraries.push(dir.clone())
        },
        null => {}
    }
    libraries.push(bundle.deps.clone())
    libraries.push(PathBuf::from(target_libdir()))
    match host.env_var(COMPTIME_BUNDLE_LIBRARY_PATH) {
        held => {
            libraries.extend(env::split_paths(held))
        },
        null => {}
    }
    let child = Command::new(binary).env("RUST_BACKTRACE", "0").env(nikaia_std::target::LEVEL_VAR, named).env(COMPTIME_BUNDLE_LIBRARY_PATH, env::join_paths(libraries).map_err(fn(e) { did_not(e.to_string()) })).stdout(process::Stdio::piped()).stderr(process::Stdio::piped()).spawn().map_err(fn(e) { did_not(f"running {binary.display()}: {e}") })
    let ran = comptime_bundle_waited(child, name).map_err(fn(e) { did_not(f"running {binary.display()}: {e}") })
    fs::rename(binary, dir.join("run"), fs::Root::Anywhere) catch {}
    fs::remove(scratch, fs::Root::Anywhere; recursive: true) catch {}
    let ran = ran
    if ran.status.success() {
        let answer = (ran.stdout.text() catch { "" }).trim().to_string()
        comptime_bundle_write_if_changed(answered, answer).map_err(did_not)
        return answer
    }
    let mut said = (ran.stderr.text() catch { "" }).trim().to_string()
    // **A run that ended without a word** - killed by the system, most often
    // for its memory - says how it ended instead.
    if said.is_empty() {
        said = f"it ended without saying why ({ran.status})"
    }
    // **A stop the program reported is an answer**, and kept as one: the same
    // code stops the same way. A run that died without a word is not, and is
    // tried again next time.
    if said.contains("the program stopped") || said.contains("nikaia-build-time:") {
        comptime_bundle_write_if_changed(stopped, said).map_err(did_not)
    }
    throw Wall::Refused { detail: said }
}

/// The programs this process could not compile, by their key, with what
/// `rustc` said.
// TODO(rs2nika): a `static` (a `comptime` if it is constant; Nikaia has no global state)
// /// The programs this process could not compile, by their key, with what
// /// `rustc` said.
// static COMPTIME_BUNDLE_NOT_BUILT: std::sync::Mutex<BTreeMap<String, String>> =
//     std::sync::Mutex::new(BTreeMap::new());

/// **The run, waited for, and named while it takes long**
/// ([ADR-321](../../../docs/specification/adr/adr-321.md) D12): after a few
/// seconds the build says which `comptime` is still running and for how long.
/// A message, never a bound.
fn comptime_bundle_waited(mut child: Child, name: String) -> Output throws {
    let mut stdout = child.stdout.take()
    let mut stderr = child.stderr.take()
    let out = thread::spawn(fn() {
        let mut held = []
        match stdout {
            pipe => {
                pipe.read_to_end(held) catch {}
            },
            null => {}
        }
        return held
    })
    let err = thread::spawn(fn() {
        let mut held = []
        match stderr {
            pipe => {
                pipe.read_to_end(held) catch {}
            },
            null => {}
        }
        return held
    })
    let began = time::Instant::now()
    let mut next = time::Duration::from_secs(5)
    let status = while true {
        match child.try_wait() {
            status => {
                break status /* TODO(rs2nika): `break` with a value or a label */
            },
            null => {}
        }
        if began.elapsed() >= next {
            eprintln(f"note: `{name}` is still being computed while the program is built ({began.elapsed().as_secs()} s)")
            next += time::Duration::from_secs(10)
        }
        thread::sleep(time::Duration::from_millis(20))
    }
    return process::Output {
        status,
        stdout: out.join().unwrap_or_default() /* TODO(rs2nika): `unwrap_or_default` (write the default: `?? 0`, `?? ""`, `?? []`) */,
        stderr: err.join().unwrap_or_default() /* TODO(rs2nika): `unwrap_or_default` (write the default: `?? 0`, `?? ""`, `?? []`) */,
    }
}

/// The variable the loader reads for where libraries are.
comptime COMPTIME_BUNDLE_LIBRARY_PATH: ref String = "DYLD_LIBRARY_PATH"

comptime COMPTIME_BUNDLE_LIBRARY_PATH: ref String = "PATH"

comptime COMPTIME_BUNDLE_LIBRARY_PATH: ref String = "LD_LIBRARY_PATH"

fn comptime_bundle_cargo[H: ComptimeBundleHost](host: ref H) -> String {
    return (host.env_var("CARGO") ?? "cargo")
}

pub fn comptime_bundle_rustc[H: ComptimeBundleHost](host: ref H) -> String {
    return (host.env_var("RUSTC") ?? "rustc")
}

/// `rustc -vV`, once: the toolchain a key is about.
// ADAPTER: bleibt in Rust (`pub(crate) fn toolchain() -> &'static str`: process-wide state)

/// Where the toolchain's own `std` is, which a program linked with
/// `prefer-dynamic` loads.
// ADAPTER: bleibt in Rust (`pub(crate) fn target_libdir() -> &'static str`: process-wide state)

/// Written only when it changed, so that Cargo's freshness keeps working.
pub fn comptime_bundle_write_if_changed(path: ref fs::Path, text: String) throws {
    match path.parent() {
        parent => {
            fs::create_dir(parent, fs::Root::Anywhere; recursive: true).map_err(fn(e) { f"{parent.display()}: {e}" })
        },
        null => {}
    }
    if fs::read_to_string(path, fs::Root::Anywhere).is_ok_and(fn(held) { held == text }) {
        return
    }
    // **Written whole or not at all**: builds side by side share the
    // workshop, and one that read a file another was still writing compiled
    // half a program or read half an answer.
    let partial = unique_beside(path)
    fs::write(partial, fs::Root::Anywhere, text).map_err(fn(e) { f"{partial.display()}: {e}" })
    fs::rename(partial, path, fs::Root::Anywhere).map_err(fn(e) {
        fs::remove(partial, fs::Root::Anywhere) catch {}
        return f"{path.display()}: {e}"
    })
}

/// A path beside `path` that no other build writes at the same time.
// ADAPTER: bleibt in Rust (`pub(crate) fn unique_beside(path: &Path) -> PathBuf`: process-wide state)
