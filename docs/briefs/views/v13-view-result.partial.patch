+/// The result is a view of a type parameter: `ref T`, as a parameter handed
+/// back is written (`text_tiers.nika`, `tier_hand_back`).
+fn check_core_call_hands_back_a_variable(contract: ref FnContract) -> bool {
+    let signature = contract.signature ?? return false
+    let ty = signature.result ?? return false
+    return match ty {
+        Ty::Var { view, .. } => view,
+        else => false,
+    }
+}
