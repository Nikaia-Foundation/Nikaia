use std::collections
use std::fs

/// A refusal, in the words the compiler reports.
pub enum ProjectSettingsRefusal {
    Refused(String),
}

impl Error for ProjectSettingsRefusal {
    fn message(ref self) -> String {
        return match self {
            ProjectSettingsRefusal::Refused(why) => why.clone(),
        }
    }
}

impl Project {
    /// The program's name for Cargo: in the shared directory its package's
    /// name and [`Self::root_tag`], elsewhere the package's name (#495).
    fn program_name[H: ProjectSettingsHost](ref self, package: String, host: ref H) -> String {
        return match host.env_var("CARGO_TARGET_DIR") {
            null => f"{package}-{self.root_tag()}",
            else => package,
        }
    }
    /// What sets this project's program apart in the shared directory: the
    /// start of the hash of where the project is (#495).
    fn root_tag(ref self) -> String {
        let mut named = self.root.display()
        if self.variant != null {
            let variant = self.variant.clone()
            named.push('\u{1f}')
            named.push_str(variant)
        }
        return orchestrator::cache::sha256_hex(named.bytes)[..<16].to_string()
    }
    /// The program a build in the shared directory produced, under the
    /// project's own name in its own `target/nikaia/bin/` (#495): a hard link
    /// where the file system allows one, a copy where not.
    fn own_copy(ref self, built: ref fs::Path) -> fs::Path throws {
        let dir = self.root.join("target").join("nikaia").join("bin")
        fs::create_dir(dir, fs::Root::Anywhere; recursive: true)
        let name = (built.file_name() ?? throw ProjectSettingsRefusal::Refused("a program has a file name")).display().replacen(f"-{self.root_tag()}", "", 1)
        let own = dir.join(name)
        fs::remove(own, fs::Root::Anywhere) catch {}
        if fs::hard_link(built, own).is_err() {
            fs::copy(built, own, fs::Root::Anywhere)
        }
        return own
    }
}

/// Record one invocation, if anybody asked. A trace that cannot be written is
/// silent: this is a debugging facility, and a build must not fail because the
/// place it was told to write a note to is unwritable.
pub fn project_settings_trace[H: ProjectSettingsHost](invocation: ref Invocation, verdict: String, host: ref H) {
    let path = host.env_var(TRACE_VAR) ?? return
    let crate_name = (invocation.crate_name ?? "-")
    // **And whether this one is Cargo's target-info probe**
    // ([ADR-166](../../docs/specification/adr/adr-166.md) D1), because that is
    // the invocation whose standard input decides whether a build starts at all
    // — and a trace that cannot say so cannot answer the question the trace
    // exists for.
    let verdict = match invocation.is_a_probe() {
        true => f"{verdict} (target-info probe)",
        false => verdict,
    }
    match fs::OpenOptions::new().create(true).append(true).open(path) catch { null } {
        file => {
            file.push_str(f"{crate_name} {verdict}\n").ok()
        },
        null => {},
    }
}
