use std::collections

fn note(mut seen: collections::BTreeSet[String], k: i64) sync {
    match k {
        0 => seen.insert("zero"),
        else => seen.insert("other"),
    }
}

fn main() {
    let mut seen: collections::BTreeSet[String] = collections::BTreeSet()
    note(seen, 0)
    println(f"{seen.len()}")
}
