enum K { A(i64), B }

fn f(k: ref K, n: i64) -> bool sync {
    return match k {
        K::A(x) if (match n { 1 | 2 => true, else => false }) && x > 0 => true,
        else => false,
    }
}

fn h(xs: ref Vec[i64]) -> i64 sync {
    let first = fn { 3 }
    match xs.len() {
        0 => 1,
        else => first(),
    }
}

fn main() {
    println(f"{f(K::A(1), 2)} {h([1])}")
}
