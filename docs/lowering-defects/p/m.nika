struct Book { titles: Vec[String] }
impl Book {
    fn find(ref self, name: ref String) -> ref String sync {
        for t in self.titles {
            if t.starts_with(name) {
                return t
            }
        }
        return self.titles[0]
    }
}
fn main() {
    let b = Book { titles: ["ab", "cd"] }
    println(b.find("c"))
}
