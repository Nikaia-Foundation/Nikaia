enum Shape { Named { id: i64, size: i64 }, Other }

fn small(n: i64) -> bool sync {
    return n < 3
}

fn test_it(s: ref Shape, wanted: ref Shape) -> bool sync {
    return match s {
        Shape::Named { id, .. } if (match wanted { Shape::Named { size: other, .. } if small(other) => true, else => false }) => small(id),
        else => false,
    }
}

fn main() {
    println(f"{test_it(Shape::Named { id: 1, size: 2 }, Shape::Named { id: 5, size: 1 })}")
}
