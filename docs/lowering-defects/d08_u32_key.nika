use std::collections

struct Span { start: u32, end: u32 }
struct Node { span: Span }

fn at(m: ref collections::BTreeMap[i64, String], x: ref Node) -> String sync {
    return m.get(x.span.start as i64)?.clone() ?? "none"
}

fn main() {
    let mut m: collections::BTreeMap[i64, String] = collections::BTreeMap()
    m[3] = "three"
    println(at(m, Node { span: Span { start: 3, end: 4 } }))
}
