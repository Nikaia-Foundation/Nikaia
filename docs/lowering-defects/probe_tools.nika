use std::collections

pub struct ProbeNames {
    pub seen: collections::HashSet[String],
}

fn probe_syms(world: ref CheckWorld, names: ref Vec[winnow_grammar::Symbol]) -> Vec[String] sync {
    let mut out: Vec[String] = []
    for n in names {
        out.push(world.words.resolve(n).clone())
    }
    return out
}

fn probe_integer(v: Integer?) -> i64 sync {
    let n = v ?? 0
    return 1
}

fn probe_opt_param(t: Ty?) -> String sync {
    let shown = t?.text() ?? "none"
    return shown.clone()
}

fn probe_with(f: EmitFlow) -> EmitFlow sync {
    return f with { statement: 1 }
}
