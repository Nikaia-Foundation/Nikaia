use std::collections

struct Names { seen: collections::HashSet[String], ids: collections::HashMap[String, i64] }

fn main() {
    let mut n = Names { seen: collections::HashSet(), ids: collections::HashMap() }
    n.seen.insert("a")
    n.ids["a"] = 1
    println(f"{n.seen.len()} {n.ids.len()}")
}
