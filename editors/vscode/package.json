{
  "name": "nikaia",
  "displayName": "Nikaia",
  "description": "Syntax highlighting and the language server (nikaia lsp) for the Nikaia programming language.",
  "version": "0.0.7",
  "publisher": "nikaia",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikaia-Foundation/Nikaia.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nikaia"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nikaia",
        "aliases": [
          "Nikaia",
          "nikaia"
        ],
        "extensions": [
          ".nika"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nikaia",
        "scopeName": "source.nika",
        "path": "./syntaxes/nikaia.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.sql.nika": "sql"
        }
      }
    ],
    "configuration": {
      "title": "Nikaia",
      "properties": {
        "nikaia.server.path": {
          "type": "string",
          "default": "nikaia",
          "description": "The nikaia binary the editor starts as `nikaia lsp`. A name is looked up on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
